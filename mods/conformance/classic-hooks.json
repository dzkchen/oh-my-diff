{
  "note": "Every classic hook name `api.hook` accepts, the native event or interceptor it maps to and the owner of that seam.",
  "hooks": [
    {
      "hook": "PreToolUse",
      "native": "tool",
      "owner": "tool continuation"
    },
    {
      "hook": "PostToolUse",
      "native": "tool_result",
      "owner": "lifecycle"
    },
    {
      "hook": "PostToolUseFailure",
      "native": "tool_result",
      "owner": "lifecycle"
    },
    {
      "hook": "PostToolBatch",
      "native": "tool_batch_end",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "PermissionRequest",
      "native": "approval",
      "owner": "approval middleware"
    },
    {
      "hook": "PermissionDenied",
      "native": "approval_result",
      "owner": "approval middleware"
    },
    {
      "hook": "UserPromptSubmit",
      "native": "input",
      "owner": "input interception"
    },
    {
      "hook": "UserPromptExpansion",
      "native": "prompt_expanded",
      "owner": "composer_v2"
    },
    {
      "hook": "SessionStart",
      "native": "session",
      "owner": "lifecycle middleware"
    },
    {
      "hook": "SessionEnd",
      "native": "session",
      "owner": "lifecycle middleware"
    },
    {
      "hook": "Setup",
      "native": "start",
      "owner": "lifecycle"
    },
    {
      "hook": "Stop",
      "native": "turn_stop",
      "owner": "autonomous_turns_v1"
    },
    {
      "hook": "StopFailure",
      "native": "turn_stop",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "SubagentStart",
      "native": "agent",
      "owner": "agent_lifecycle_v1"
    },
    {
      "hook": "SubagentStop",
      "native": "agent",
      "owner": "agent_lifecycle_v1"
    },
    {
      "hook": "TaskCreated",
      "native": "agent",
      "owner": "agent_lifecycle_v1"
    },
    {
      "hook": "TaskCompleted",
      "native": "agent",
      "owner": "agent_lifecycle_v1"
    },
    {
      "hook": "TeammateIdle",
      "native": "idle",
      "owner": "lifecycle"
    },
    {
      "hook": "PreCompact",
      "native": "compaction",
      "owner": "compaction_intercept_v1"
    },
    {
      "hook": "PostCompact",
      "native": "compaction_end",
      "owner": "compaction_intercept_v1"
    },
    {
      "hook": "PreModelSwitch",
      "native": "model_request",
      "owner": "model interception"
    },
    {
      "hook": "PostModelSwitch",
      "native": "thread_settings",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "CwdChanged",
      "native": "thread_settings",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "DirectoryAdded",
      "native": "thread_settings",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "ConfigChange",
      "native": "config_change",
      "owner": "command and config middleware"
    },
    {
      "hook": "InstructionsLoaded",
      "native": "instructions_loaded",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "FileChanged",
      "native": "workspace_change",
      "owner": "events_v1 watches"
    },
    {
      "hook": "WorktreeCreate",
      "native": "worktree",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "WorktreeRemove",
      "native": "worktree",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "Elicitation",
      "native": "elicitation",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "ElicitationResult",
      "native": "elicitation_result",
      "owner": "lifecycle_events_v1"
    },
    {
      "hook": "MessageDisplay",
      "native": "model_response",
      "owner": "model interception"
    },
    {
      "hook": "Notification",
      "native": "app_notification",
      "owner": "app_v1"
    }
  ]
}
