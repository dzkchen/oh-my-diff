{
  "schema": 1,
  "id": "omd_update",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "description": "Tells you when a newer Oh My Diff release is out and controls update checks, channel, cadence, version pin and automatic updates",
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party/omd_update"
  },
  "capabilities": [
    "commands",
    "exec",
    "lifecycle",
    "store",
    "terminal"
  ],
  "exec_environment": ["OH_MY_DIFF_UPDATE"],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "checks": {"type": "string", "enum": ["on", "off"], "default": "on", "title": "Check for updates", "description": "Look for new Oh My Diff releases"},
      "auto": {"type": "string", "enum": ["off", "on"], "default": "off", "title": "Install automatically", "description": "Install new releases without asking"},
      "channel": {"type": "string", "enum": ["stable", "prerelease", "nightly"], "default": "stable", "title": "Release channel", "description": "stable, prerelease or nightly builds"},
      "cadence": {"type": "string", "enum": ["daily", "weekly"], "default": "daily", "title": "How often", "description": "Check daily or weekly"},
      "pin": {"type": "string", "default": "", "title": "Pinned version", "description": "Stay on this exact version; leave empty to follow the channel"}
    }
  },
  "compatibility": {
    "required_features": [
      "exec_v1",
      "store_v1",
      "terminal_render_sites_v1",
      "terminal_welcome_v1"
    ]
  }
}
