{
  "schema": 1,
  "id": "omd_workspace",
  "version": "0.2.0-preview.5",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Session status and activity sidebar, state and shortcut header, review draft key and sidebar settings",
  "license": "MIT",
  "provenance": { "maintainer": "Oh My Diff", "source": "mods/first-party/omd_workspace" },
  "capabilities": [
    "terminal",
    "commands",
    "lifecycle",
    "store",
    "threads",
    "config"
  ],
  "subscriptions": {"app": ["thread/settings/updated", "thread/tokenUsage/updated"]},
  "compatibility": {
    "required_features": ["terminal_lists_v1", "terminal_rich_line_v1", "store_v1", "app_v1"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "density": {
        "type": "string",
        "enum": ["full", "compact"],
        "default": "full"
      },
      "side": {
        "type": "string",
        "enum": ["left", "right"],
        "default": "left"
      },
      "review_prompt": {
        "type": "string",
        "default": "Review the current candidate and list the remaining risks."
      }
    },
    "additionalProperties": false
  }
}
