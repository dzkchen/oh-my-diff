{
  "schema": 1,
  "id": "omd_preview",
  "version": "0.1.0-preview.3",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "description": "/preview renders a response or a Markdown, code or diff file as HTML in the browser or inline, or opens the session's dev server",
  "license": "MIT",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_preview"},
  "capabilities": ["commands", "terminal", "store", "sessions", "exec", "fs.read", "fs.write", "events", "lifecycle"],
  "assets": ["render.mjs"],
  "subscriptions": {"channels": ["omd_preview/*"]},
  "compatibility": {"required_features": ["app_v1", "session_ports_v1", "events_v1", "exec_v1", "package_text_assets_v1", "store_v1", "terminal_media_v1", "terminal_render_sites_v1", "timers_v1"]}
}
