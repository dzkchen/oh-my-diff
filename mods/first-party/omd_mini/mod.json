{
  "schema": 1,
  "id": "omd_mini",
  "version": "0.1.0-preview.3",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Scrollback-first mini presentation for sessions started with `omd mini`: compact tool summaries, a simple prompt, one status line and switching to the full UI",
  "license": "Apache-2.0",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_mini"},
  "capabilities": ["terminal", "commands", "lifecycle", "store", "exec", "threads"],
  "exec_environment": ["OH_MY_DIFF_PRESENTATION", "OH_MY_DIFF_LAUNCH"],
  "subscriptions": {"app": ["thread/tokenUsage/updated", "account/rateLimits/updated"]},
  "compatibility": {"required_features": ["app_v1", "exec_v1", "store_v1", "store_thread_v1", "state_scopes_v1", "terminal_lists_v1", "terminal_inline_sites_v1", "render_hooks_v1"]}
}
