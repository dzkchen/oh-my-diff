{
  "schema": 1,
  "id": "omd_model_picker",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Compact /model and reasoning effort picker",
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "terminal",
    "events",
    "store"
  ],
  "subscriptions": {"channels": ["omd_profiles/routes"]},
  "compatibility": {
    "required_features": ["terminal_lists_v1", "store_thread_v1", "state_scopes_v1", "events_v1", "render_hooks_v1"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "layout": {
        "title": "Picker style",
        "description": "compact redraws the model and effort pickers; native leaves them as Codex draws them",
        "type": "string",
        "enum": ["compact", "native"],
        "default": "compact"
      },
      "brand": {
        "title": "Picker label",
        "description": "Text shown before the picker title; leave empty to hide it",
        "type": "string",
        "default": "oh my diff"
      }
    },
    "additionalProperties": false
  }
}
