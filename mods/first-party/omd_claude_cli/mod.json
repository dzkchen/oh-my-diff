{
  "schema": 1,
  "id": "omd_claude_cli",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "description": "Claude models through your official Claude CLI login as a Codex provider, with /claude login in the session",
  "license": "MIT",
  "subscriptions": { "channels": ["omd_claude_cli/login", "omd_claude_cli/code", "omd_claude_cli/remove"] },
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "commands",
    "lifecycle",
    "model",
    "exec",
    "os",
    "terminal",
    "events",
    "packages",
    "inventory",
    "store"
  ],
  "os_access": {
    "programs": [
      "claude",
      "node"
    ],
    "network": true
  },
  "assets": [
    "handoff.mjs",
    "setup.mjs",
    "transport.mjs"
  ],
  "compatibility": {
    "required_features": [
      "package_text_assets_v1",
      "unrestricted_process_v1",
      "framed_process_v1",
      "process_streams_v1",
      "ui_controls_v1",
      "events_v1",
      "package_controls_v1"
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "extra_usage": {
        "title": "Use extra usage",
        "description": "Keep working on paid extra usage when your plan limit is reached, if your account allows it; off stops at the first extra-usage response",
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  }
}
