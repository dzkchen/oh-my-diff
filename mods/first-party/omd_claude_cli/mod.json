{
  "schema": 1,
  "id": "omd_claude_cli",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "description": "Claude models through your official Claude CLI login as a Codex provider, with /claude login in the session and an ask_claude delegation tool",
  "license": "MIT",
  "subscriptions": { "channels": ["omd_claude_cli/login"] },
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "commands",
    "lifecycle",
    "model",
    "exec",
    "os",
    "pty",
    "terminal",
    "events",
    "packages",
    "inventory",
    "tools",
    "agents",
    "sessions",
    "sessions_tools",
    "store"
  ],
  "os_access": {
    "programs": [
      "claude",
      "node"
    ],
    "network": true
  },
  "assets": [
    "setup.mjs",
    "transport.mjs"
  ],
  "compatibility": {
    "required_features": [
      "package_text_assets_v1",
      "unrestricted_process_v1",
      "terminal_pty_v1",
      "terminal_surface_v1",
      "pty_programs_v1",
      "ui_controls_v1",
      "events_v1",
      "timers_v1",
      "package_controls_v1"
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "ask_claude": {
        "type": "boolean",
        "default": false
      },
      "extra_usage": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  }
}
