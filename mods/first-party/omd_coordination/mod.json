{
  "schema": 1,
  "id": "omd_coordination",
  "version": "0.1.0-preview.4",
  "api": "0.1.0-experimental.8",
  "state_version": 1,
  "capabilities": [
    "agents",
    "commands",
    "context",
    "lifecycle",
    "recovery",
    "routing",
    "services",
    "state",
    "task",
    "tools"
  ],
  "services": {
    "exports": [
      {
        "name": "omd.coordination",
        "version": "1.0.0",
        "methods": {
          "prepare_delegation": {
            "input": "object",
            "output": "object"
          }
        }
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "lead_policy": {
        "type": "string",
        "enum": ["sol", "astra", "task_entry"],
        "default": "task_entry"
      },
      "worker_context": {
        "type": "string",
        "enum": ["focused", "focused_brief", "shared", "shared_task_packet", "inherit", "parent_history"],
        "default": "focused_brief"
      },
      "evidence": {
        "type": "array",
        "default": []
      }
    },
    "additionalProperties": false
  }
}
