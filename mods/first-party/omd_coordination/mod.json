{
  "schema": 1,
  "id": "omd_coordination",
  "version": "0.2.0-preview.1",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "description": "Routes delegated work and selects each worker's context under the workflow contract",
  "license": "MIT",
  "provenance": { "maintainer": "Oh My Diff", "source": "mods/first-party/omd_coordination" },
  "capabilities": [
    "agents",
    "commands",
    "context",
    "fs.read",
    "lifecycle",
    "model",
    "services",
    "store",
    "tools"
  ],
  "services": {
    "exports": [
      {
        "name": "omd.coordination",
        "version": "1.0.0",
        "methods": {
          "prepare_delegation": {
            "input": "object",
            "output": "object"
          }
        }
      }
    ],
    "imports": [
      {
        "name": "omd.workflow",
        "version": "1.0.0"
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "lead_policy": {
        "type": "string",
        "enum": [
          "sol",
          "astra",
          "task_entry"
        ],
        "default": "task_entry"
      },
      "worker_context": {
        "type": "string",
        "enum": [
          "focused",
          "focused_brief",
          "shared",
          "shared_task_packet",
          "inherit",
          "parent_history"
        ],
        "default": "focused_brief"
      },
      "worker_context_max_bytes": {
        "type": "number",
        "default": 6000
      },
      "evidence": {
        "type": "array",
        "default": []
      },
      "investigation_route": {
        "type": "string",
        "default": "reviewer"
      }
    },
    "additionalProperties": false
  },
  "compatibility": {
    "required_features": [
      "service_dispatch_v1"
    ]
  }
}
