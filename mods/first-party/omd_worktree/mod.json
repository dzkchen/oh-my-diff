{
  "schema": 1,
  "id": "omd_worktree",
  "version": "0.1.0-preview.1",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Task worktrees: create from a base ref with opt-in setup and a session, switch, integrate after review and remove safely",
  "license": "Apache-2.0",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_worktree"},
  "capabilities": ["commands", "terminal", "lifecycle", "store", "exec", "fs.write", "threads", "sessions", "builtins", "services"],
  "exec_environment": ["GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL"],
  "services": {"exports": [{"name": "omd.worktrees", "version": "1.0.0", "methods": {"list": {"input": "null", "output": "object"}}}]},
  "compatibility": {"required_features": ["app_v1", "exec_v1", "guarded_exec_v1", "terminal_surface_v1", "terminal_prompt_v1", "service_dispatch_v1"]},
  "settings_schema": {
    "type": "object",
    "properties": {
      "root": {"type": "string", "default": ""},
      "branch_prefix": {"type": "string", "default": "omd/"},
      "shared": {"type": "array", "default": []},
      "copy": {"type": "array", "default": []}
    },
    "additionalProperties": false
  }
}
