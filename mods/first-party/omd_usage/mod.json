{
  "schema": 1,
  "id": "omd_usage",
  "version": "0.1.0-preview.1",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Provider usage HUD: per-request ledger with context, cache, cost, quota windows, workers and an allowance bar",
  "license": "MIT",
  "provenance": { "maintainer": "Oh My Diff", "source": "mods/first-party/omd_usage" },
  "capabilities": ["agents", "commands", "store", "terminal", "events", "model", "lifecycle", "middleware", "threads", "config", "account", "inventory"],
  "subscriptions": {
    "channels": ["omd_usage/refresh"],
    "app": ["account/rateLimits/updated", "thread/settings/updated", "thread/tokenUsage/updated", "thread/reverted", "turn/plan/updated"]
  },
  "compatibility": { "required_features": ["terminal_lists_v1", "store_v1", "store_thread_v1", "state_scopes_v1", "events_v1", "app_v1", "model_turn_interception_v1"] },
  "settings_schema": {
    "type": "object",
    "properties": {
      "categories": { "type": "boolean", "default": false },
      "budget_usd": { "type": "number", "default": 0 }
    },
    "additionalProperties": false
  }
}
