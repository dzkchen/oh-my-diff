{
  "schema": 1,
  "id": "omd_usage",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Provider usage dialog: per-request ledger with context, cache, cost, quota windows, workers and an allowance bar",
  "license": "MIT",
  "provenance": { "maintainer": "Oh My Diff", "source": "mods/first-party/omd_usage" },
  "capabilities": ["agents", "commands", "store", "terminal", "events", "model", "lifecycle", "middleware", "threads", "config", "account", "inventory"],
  "subscriptions": {
    "channels": ["omd_usage/refresh"],
    "app": ["account/updated", "account/rateLimits/updated", "thread/settings/updated", "thread/tokenUsage/updated", "thread/reverted", "turn/plan/updated"]
  },
  "compatibility": { "required_features": ["terminal_lists_v1", "store_v1", "store_thread_v1", "state_scopes_v1", "events_v1", "app_v1", "model_turn_interception_v1", "ui_controls_v1"] },
  "settings_schema": {
    "type": "object",
    "properties": {
      "categories": { "type": "boolean", "default": false, "title": "Usage by role", "description": "Break requests down by role; it runs on every request, so it's off by default"},
      "budget_usd": { "type": "number", "default": 0, "title": "Budget (USD)", "description": "A soft spending budget in US dollars; 0 means none"}
    },
    "additionalProperties": false
  }
}
