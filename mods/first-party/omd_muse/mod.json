{
  "schema": 1,
  "id": "omd_muse",
  "version": "0.1.0-preview.2",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Experimental: a low-cost Muse research subagent and optional lead over muse serve",
  "license": "Apache-2.0",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_muse"},
  "capabilities": ["commands", "lifecycle", "model", "exec", "tools", "agents", "terminal", "builtins", "config", "store"],
  "exec_environment": ["MUSE_EXPERIMENTAL_SDK_ENABLED", "XDG_DATA_HOME"],
  "assets": ["models.json", "setup.mjs", "transport.mjs"],
  "settings_schema": {
    "type": "object",
    "properties": {
      "auto_approve": {"type": "boolean", "default": false},
      "route": {"type": "string", "default": ""}
    },
    "additionalProperties": false
  }
}
