{
  "schema": 1,
  "id": "omd_git",
  "version": "0.2.0-preview.4",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "description": "Git sidebar with commit graph, changed files, confirmed Git actions and read-only GitHub pull request and CI status",
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "commands",
    "exec",
    "fs.read",
    "fs.write",
    "store",
    "lifecycle",
    "terminal",
    "events",
    "credentials",
    "http"
  ],
  "assets": ["fingerprint.mjs"],
  "exec_environment": ["GIT_OPTIONAL_LOCKS"],
  "http_access": {"origins": ["https://api.github.com"], "credentials": ["owned"]},
  "subscriptions": {"channels": ["omd_git/github"]},
  "compatibility": {
    "required_features": ["exec_v1", "guarded_exec_v1", "workspace_access_v1", "workspace_fs_v1", "terminal_lists_v1", "store_v1", "package_text_assets_v1", "events_v1", "timers_v1", "credentials_v1", "secrets_v1", "structured_access_v1"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "side": {
        "type": "string",
        "enum": ["left", "right"],
        "default": "left"
      },
      "width": {
        "type": "number",
        "default": 40
      },
      "icons": {
        "type": "string",
        "enum": ["unicode", "ascii"],
        "default": "unicode"
      },
      "commits": {
        "type": "number",
        "default": 6
      },
      "notices": {
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  }
}
