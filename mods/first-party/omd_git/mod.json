{
  "schema": 1,
  "id": "omd_git",
  "version": "0.2.0-preview.3",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "description": "Git sidebar with commit graph, changed files and confirmed Git actions inside the terminal",
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "commands",
    "exec",
    "fs.read",
    "fs.write",
    "store",
    "lifecycle",
    "terminal"
  ],
  "assets": ["fingerprint.mjs"],
  "exec_environment": ["GIT_OPTIONAL_LOCKS"],
  "compatibility": {
    "required_features": ["exec_v1", "guarded_exec_v1", "workspace_access_v1", "workspace_fs_v1", "terminal_lists_v1", "store_v1", "package_text_assets_v1"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "side": {
        "type": "string",
        "enum": ["left", "right"],
        "default": "left"
      },
      "width": {
        "type": "number",
        "default": 40
      },
      "icons": {
        "type": "string",
        "enum": ["unicode", "ascii"],
        "default": "unicode"
      },
      "commits": {
        "type": "number",
        "default": 6
      }
    },
    "additionalProperties": false
  }
}
