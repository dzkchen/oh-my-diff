{
  "schema": 1,
  "id": "omd_lazygit",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Runs lazygit inside the session, full screen or as an omd_workspace panel; its edits open in your editor or become @path mentions. Experimental",
  "license": "MIT",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_lazygit"},
  "capabilities": ["commands", "terminal", "store", "exec", "os", "pty", "composer", "inventory", "services"],
  "os_access": {"programs": ["lazygit"], "network": true},
  "exec_environment": ["EDITOR", "VISUAL", "GIT_EDITOR", "XDG_CONFIG_HOME", "CONFIG_DIR"],
  "services": {"imports": [{"name": "omd.workspace", "version": "1.0.0", "optional": true}]},
  "compatibility": {"required_features": ["store_v1", "exec_v1", "unrestricted_process_v1", "state_scopes_v1", "service_dispatch_v1", "terminal_surface_v1", "terminal_layout_title_v1", "terminal_pty_v1", "pty_programs_v1", "terminal_pty_v2", "terminal_editor_v1", "composer_v2", "ui_composition_v1"]},
  "settings_schema": {
    "type": "object",
    "properties": {
      "placement": {"type": "string", "enum": ["full", "panel"], "default": "panel", "title": "Placement", "description": "full: lazygit takes the screen above a compact chat; panel: a tab of the omd_workspace dock, falling back to full without it"},
      "edit": {"type": "string", "enum": ["editor", "composer"], "default": "editor", "title": "Edit a file", "description": "editor: open it in your editor (host.json); composer: add an @path mention to the prompt"}
    },
    "additionalProperties": false
  }
}
