{
  "schema": 1,
  "id": "omd_advisor",
  "version": "0.1.0-preview.1",
  "api": "0.1.0-experimental.9",
  "state_version": 1,
  "license": "Apache-2.0",
  "capabilities": ["tools", "lifecycle", "state", "turn_evidence", "review", "context", "terminal"],
  "environment": ["crypto"],
  "compatibility": { "required_features": ["turn_evidence_v1", "accounted_review_v1"] },
  "settings_schema": {
    "type": "object",
    "properties": {
      "every_turn": { "type": "boolean", "default": false },
      "route": { "type": "string", "default": "astra" },
      "mode": { "type": "string", "enum": ["advisory", "blocking"], "default": "advisory" }
    },
    "additionalProperties": false
  }
}
