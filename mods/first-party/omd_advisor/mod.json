{
  "schema": 1,
  "id": "omd_advisor",
  "version": "0.2.0-preview.1",
  "api": "0.2.0-experimental.3",
  "state_version": 1,
  "license": "Apache-2.0",
  "capabilities": [
    "tools",
    "lifecycle",
    "store",
    "sessions",
    "agents",
    "contracts",
    "fs.read",
    "context",
    "terminal"
  ],
  "environment": [
    "crypto"
  ],
  "compatibility": {
    "required_features": [
      "turn_evidence_v1",
      "workspace_snapshots_v1",
      "workspace_fingerprint_v1",
      "contracts_v2"
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "every_turn": {
        "type": "boolean",
        "default": false
      },
      "route": {
        "type": "string",
        "default": "astra"
      },
      "mode": {
        "type": "string",
        "enum": [
          "advisory",
          "blocking"
        ],
        "default": "advisory"
      }
    },
    "additionalProperties": false
  }
}
