{
  "schema": 1,
  "id": "omd_editor",
  "version": "0.1.0-preview.1",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Edit workspace files in buffers with syntax colors, Git gutter markers, find, undo and fingerprint-checked saves",
  "license": "Apache-2.0",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_editor"},
  "capabilities": ["commands", "terminal", "store", "lifecycle", "events", "exec", "fs.read", "fs.write", "composer"],
  "subscriptions": {"channels": ["omd_editor/*"]},
  "compatibility": {"required_features": ["state_scopes_v1", "store_thread_v1", "events_v1", "timers_v1", "exec_v1", "terminal_surface_v1", "terminal_input_v1", "terminal_style_v1", "terminal_prompt_v1", "workspace_fs_v1"]},
  "settings_schema": {
    "type": "object",
    "properties": {
      "git": {"type": "boolean", "default": false},
      "lsp": {"type": "boolean", "default": false}
    },
    "additionalProperties": false
  }
}
