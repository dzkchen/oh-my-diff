    ]
  },
  "compatibility": {
    "required_features": [
      "app_v1",
      "builtins_v1",
      "credentials_v1",
      "events_v1",
      "package_imports_v1",
      "package_text_assets_v1",
      "route_reload_v1",
      "route_write_v1",
      "state_scopes_v1",
      "store_v1",
      "terminal_panel_v1",
      "terminal_render_sites_v1",
      "terminal_rich_line_v1",
      "timers_v1",
      "unrestricted_process_v1"
    ]
  },
  "assets": [
    "profiles.ts",
    "router.mjs",
    "setup.mjs"
  ]
}
