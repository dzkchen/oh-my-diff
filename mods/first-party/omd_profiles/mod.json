{
  "schema": 1,
  "id": "omd_profiles",
  "version": "1.0.0",
  "api": "1.0.0",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Add and switch ChatGPT, Claude and Cursor accounts, API keys and compatible providers at the next request, with a usage meter and Alt+s",
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party"
  },
  "capabilities": [
    "commands",
    "lifecycle",
    "model",
    "threads",
    "middleware",
    "exec",
    "credentials",
    "events",
    "terminal",
    "store",
    "inventory",
    "packages",
    "os",
    "builtins"
  ],
  "os_access": {
    "programs": [
      "node"
    ],
    "network": true
  },
