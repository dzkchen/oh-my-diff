{
  "schema": 1,
  "id": "omd_profiles",
  "version": "1.0.2",
  "api": "1.0.0",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Manage ChatGPT, Claude, Cursor and API accounts; select an account for /new, with usage limits and Alt+s",
  "contributes": {
    "commands": [{ "name": "profile", "description": "Manage ChatGPT, Claude, Cursor and API accounts and pick one for /new" }],
    "keys": [{ "key": "Alt+s", "description": "Switch to the next account" }]
  },
  "license": "MIT",
  "provenance": {
    "maintainer": "Oh My Diff",
    "source": "mods/first-party/omd_profiles"
  },
  "capabilities": [
    "commands",
    "lifecycle",
    "model",
    "threads",
    "exec",
    "credentials",
    "events",
    "terminal",
    "store",
    "inventory",
    "packages",
    "os",
    "builtins"
  ],
  "os_access": {
    "programs": [
      "node"
    ],
    "network": true
  },
  "subscriptions": {
    "channels": [
      "omd_profiles/added"
    ],
    "app": [
      "account/rateLimits/updated"
    ]
  },
  "compatibility": {
    "required_features": [
      "app_v1",
      "builtins_v1",
      "credentials_v1",
      "events_v1",
      "model_context_window_v1",
      "package_imports_v1",
      "package_text_assets_v1",
      "route_new_threads_v1",
      "route_write_v1",
      "state_scopes_v1",
      "store_v1",
      "terminal_panel_v1",
      "terminal_render_sites_v1",
      "terminal_rich_line_v1",
      "timers_v1",
      "unrestricted_process_v1",
      "package_contributes_v1"
    ]
  },
  "assets": [
    "handoff.mjs",
    "profiles.ts",
    "router.mjs",
    "setup.mjs"
  ]
}
