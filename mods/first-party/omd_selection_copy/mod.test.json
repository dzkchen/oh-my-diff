{
  "schema": 1,
  "steps": [
    {
      "type": "event",
      "event": "selection",
      "payload": { "source": "transcript", "chars": 5, "lines": 1 },
      "expect": [{ "mod": "omd_selection_copy", "value": { "copy": true } }]
    },
    {
      "type": "event",
      "event": "selection_result",
      "payload": { "source": "transcript", "chars": 5, "lines": 1, "copied": true },
      "expect": [{ "mod": "omd_selection_copy", "value": null }]
    },
    {
      "type": "invoke",
      "mod": "omd_selection_copy",
      "event": "command",
      "name": "policy",
      "payload": "off",
      "expect": { "display": "copy-on-highlight off\nlast release: copied 5 characters from the transcript" }
    }
  ]
}
