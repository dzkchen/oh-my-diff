{
  "schema": 1,
  "id": "omd_layout",
  "version": "0.1.0-preview.1",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "state_scope": "thread",
  "description": "Workspace layout: project-grouped session list, find, quick open, jump and command palettes over panes, Git and worktrees",
  "license": "Apache-2.0",
  "provenance": {"maintainer": "Oh My Diff", "source": "mods/first-party/omd_layout"},
  "capabilities": ["commands", "terminal", "lifecycle", "store", "sessions", "threads", "model", "inventory", "builtins", "composer", "exec", "fs.read", "events", "services"],
  "subscriptions": {"app": ["thread/status/changed", "thread/name/updated", "thread/tokenUsage/updated", "turn/completed", "error"]},
  "services": {"imports": [{"name": "omd.panes", "version": "1.0.0", "optional": true}, {"name": "omd.worktrees", "version": "1.0.0", "optional": true}, {"name": "omd.frecency", "version": "1.0.0", "optional": true}]},
  "compatibility": {"required_features": ["app_v1", "exec_v1", "service_dispatch_v1", "terminal_surface_v1", "session_ports_v1", "command_config_middleware_v1", "terminal_lists_v1", "store_v1", "timers_v1"]},
  "settings_schema": {
    "type": "object",
    "properties": {
      "icons": {"type": "string", "enum": ["unicode", "ascii"], "default": "unicode"},
      "sidebar": {"type": "boolean", "default": true},
      "keys": {"type": "object", "default": {}}
    },
    "additionalProperties": false
  }
}
