{
  "name": "@oh-my-diff/mod-api",
  "version": "0.2.0-experimental.5",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.14.0"
  },
  "types": "api.d.ts",
  "exports": {
    ".": {
      "types": "./api.d.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./author/client.mjs"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./author/testing.mjs"
    }
  },
  "bin": {
    "omd-mod-author": "author/cli.mjs"
  },
  "files": [
    "api.d.ts",
    "jsx-runtime.d.ts",
    "client.d.ts",
    "testing.d.ts",
    "author",
    "examples/coordination",
    "examples/kernel",
    "examples/recovery",
    "examples/routing",
    "examples/terminal",
    "examples/workspace",
    "examples/workflow",
    "extension-types.json",
    "REFERENCE.md",
    "reference",
    "README.md",
    "examples/virtual_reader",
    "examples/scoped_data",
    "examples/review_probe",
    "examples/service_request",
    "examples/release_check",
    "examples/snapshot_review",
    "examples/render_hooks",
    "examples/reactive_dashboard"
  ],
  "scripts": {
    "test": "node ../scripts/mod_test_suite.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.author.json && node ../scripts/mod_typecheck_inventory.mjs && node ../scripts/mod_operation_schema.mjs --check",
    "package": "pnpm pack --pack-destination dist"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  }
}
