{
  "schema": 1,
  "id": "frame_stream",
  "version": "1.0.0",
  "api": "0.2.0-experimental.5",
  "state_version": 1,
  "license": "Apache-2.0",
  "description": "A process-owned full-pane frame producer for raw pixel transport and presentation measurements.",
  "capabilities": ["terminal", "lifecycle", "events", "store", "exec", "os"],
  "os_access": {"programs": ["node"], "network": false},
  "settings_schema": {"type": "object", "properties": {
    "producer": {"type": "string", "default": ""},
    "mouse_helper": {"type": "string", "default": ""},
    "transport": {"type": "string", "enum": ["raw", "png"], "default": "raw"}
  }},
  "compatibility": {"required_features": ["terminal_raster_v1", "process_raster_v1", "timers_v1"]}
}
