{
  "schema": 1,
  "virtual_time_ms": 2000,
  "host_operations": {
    "routes.list": [{ "result": [
      { "name": "sol", "model": "sol-model", "provider": "fixture", "reasoning": "high" },
      { "name": "astra", "model": "astra-model", "provider": "fixture", "reasoning": "xhigh" }
    ] }],
    "agents.spawn": [
      { "result": { "handle": "one", "route": "sol", "permissions": "read_only" } },
      { "result": { "handle": "two", "route": "astra", "permissions": "read_only" } }
    ],
    "agents.wait": [
      { "result": { "status": "completed", "text": "sol inspected", "consumed": true } },
      { "result": { "status": "completed", "text": "astra inspected", "consumed": true } }
    ],
    "delegation.contribute": [{ "result": { "status": "completed" } }],
    "task.status": [
      { "result": { "settings": { "delegation": true } } },
      { "result": { "settings": { "delegation": true } } }
    ]
  },
  "steps": [
    { "type": "event", "event": "turn_start", "payload": { "turn_id": "turn-1" } },
    {
      "type": "event",
      "event": "routing",
      "payload": {
        "routes": [
          { "name": "sol", "model": "sol-model", "provider": "fixture", "reasoning": "high" },
          { "name": "astra", "model": "astra-model", "provider": "fixture", "reasoning": "xhigh" }
        ],
        "model": "astra-model",
        "provider": "fixture",
        "reasoning": null
      },
      "expect": [{ "mod": "atlas_policy", "value": "sol" }]
    },
    {
      "type": "event",
      "event": "context",
      "payload": { "thread_id": "thread-1", "turn_id": "turn-1", "checkpoint": { "remaining_work": ["make add return the sum"] } },
      "expect": [{ "mod": "atlas_policy", "value": { "text": "atlas_policy 2.0.0 (solo) assembled turn turn-1. Only these paths are in scope: solution.py. Remaining acceptance work: make add return the sum. Native permissions, limits, review, accounting and evidence stay authoritative." } }]
    },
    {
      "type": "event",
      "event": "tool_before",
      "payload": { "tool": "omd_contribute", "arguments": { "brief": "fix add" }, "call_id": "call-1" },
      "expect": [{ "mod": "atlas_policy", "value": { "tool": "mod_atlas_policy_delegate", "arguments": { "brief": "fix add" } } }]
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "tool",
      "name": "delegate",
      "payload": { "brief": "fix add", "selected_evidence": ["solution.py", "notes.txt"] },
      "expect": { "status": "completed" }
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "tool",
      "name": "survey",
      "payload": {},
      "expect": {
        "surveyed": ["sol", "astra"],
        "results": [
          { "status": "completed", "text": "sol inspected", "consumed": true },
          { "status": "completed", "text": "astra inspected", "consumed": true }
        ]
      }
    },
    { "type": "event", "event": "turn_end", "payload": { "turn_id": "turn-1", "outcome": "completed" } },
    {
      "type": "terminal_mount",
      "mod": "atlas_console",
      "payload": { "event": "draw", "checkpoint": null },
      "expect": {
        "title": "Atlas console 2.0.0",
        "sidebar_side": "right",
        "sidebar_width": 28,
        "panels": [
          { "title": "Scope", "lines": ["density compact", "latest draw"] },
          { "title": "Activity", "lines": ["draw", "draw", "▸ turn turn-1", "■ turn turn-1 completed"] }
        ],
        "header": { "title": "Atlas", "lines": ["outside-author console"] },
        "footer": { "title": "Keys", "lines": ["F6 draft · Alt+r review · Alt+x reset counter · Alt+p policy"] },
        "status": ["atlas:compact"],
        "theme": { "accent": 111, "user_message_background": "#1b2430", "success": 78, "attention": 214, "failure": "#ff5f5f" },
        "keybindings": {
          "F6": "Summarize the remaining acceptance work.",
          "Alt+r": { "submit": "Review the current changes and list remaining risks." },
          "Alt+x": { "command": "counter:reset" },
          "Alt+p": { "command": "atlas_policy:atlas" }
        },
        "message_template": "│ {text}",
        "tool_template": "› {text}"
      }
    },
    {
      "type": "terminal_interact",
      "mod": "atlas_console",
      "key": "Alt+p",
      "payload": { "event": "draw", "checkpoint": null },
      "expect": {
        "action": { "command": "atlas_policy:atlas", "args": "" },
        "result": { "display": "atlas_policy 2.0.0 (solo) · scope solution.py · host settings read" }
      }
    },
    {
      "type": "terminal_interact",
      "mod": "atlas_console",
      "key": "Alt+x",
      "payload": { "event": "draw", "checkpoint": null },
      "expect": { "action": { "command": "counter:reset", "args": "" }, "result": { "display": "Counter reset to 0" } }
    },
    { "type": "status" }
  ]
}
