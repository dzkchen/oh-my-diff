{
  "schema": 1,
  "virtual_time_ms": 1000,
  "steps": [
    {
      "type": "event",
      "event": "routing",
      "payload": {
        "routes": [
          { "name": "sol", "model": "sol-model", "provider": "fixture", "reasoning": "high" },
          { "name": "astra", "model": "astra-model", "provider": "fixture", "reasoning": "xhigh" }
        ],
        "model": "astra-model",
        "provider": "fixture",
        "reasoning": null
      },
      "expect": [{ "mod": "atlas_policy", "value": "sol" }]
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "command",
      "name": "atlas",
      "payload": null,
      "expect": { "display": "atlas_policy 1.0.0 routes every turn to sol." }
    },
    {
      "type": "terminal_mount",
      "mod": "atlas_console",
      "payload": { "event": "draw", "checkpoint": null },
      "expect": {
        "title": "Atlas console",
        "sidebar_width": 28,
        "panels": [{ "title": "Events", "lines": ["draw"] }],
        "keybindings": { "Alt+x": { "command": "counter:reset" } }
      }
    },
    {
      "type": "invoke",
      "mod": "counter",
      "event": "tool",
      "name": "count",
      "payload": {},
      "expect": { "count": 1 }
    },
    {
      "type": "terminal_interact",
      "mod": "atlas_console",
      "key": "Alt+x",
      "payload": { "event": "draw", "checkpoint": null },
      "expect": { "action": { "command": "counter:reset", "args": "" }, "result": { "display": "Counter reset to 0" } }
    },
    { "type": "status" }
  ]
}
