{
  "schema": 1,
  "virtual_time_ms": 1000,
  "packages": [
    "../service_provider"
  ],
  "settings": {
    "atlas_policy": {
      "mode": "paired",
      "focus": [
        "solution.py"
      ]
    }
  },
  "host_operations": {
    "routes.list": [
      {
        "result": [
          {
            "name": "sol",
            "model": "sol-model",
            "provider": "fixture",
            "reasoning": "high"
          },
          {
            "name": "astra",
            "model": "astra-model",
            "provider": "fixture",
            "reasoning": "xhigh"
          }
        ]
      }
    ],
    "agents.spawn": [
      {
        "result": {
          "handle": "one",
          "route": "sol",
          "permissions": "read_only"
        }
      },
      {
        "result": {
          "handle": "two",
          "route": "astra",
          "permissions": "read_only"
        }
      }
    ],
    "agents.wait": [
      {
        "result": {
          "status": "completed",
          "text": "sol inspected",
          "consumed": true
        }
      },
      {
        "result": {
          "status": "completed",
          "text": "astra inspected",
          "consumed": true
        }
      }
    ],
    "delegation.contribute": [
      {
        "result": {
          "status": "completed"
        }
      }
    ],
    "task.status": [
      {
        "result": {
          "settings": {
            "delegation": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "type": "event",
      "event": "turn_start",
      "payload": {
        "turn_id": "turn-1"
      }
    },
    {
      "type": "event",
      "event": "routing",
      "payload": {
        "routes": [
          {
            "name": "sol",
            "model": "sol-model",
            "provider": "fixture",
            "reasoning": "high"
          },
          {
            "name": "astra",
            "model": "astra-model",
            "provider": "fixture",
            "reasoning": "xhigh"
          }
        ],
        "model": "sol-model",
        "provider": "fixture",
        "reasoning": null
      },
      "expect": [
        {
          "mod": "atlas_policy",
          "value": "astra"
        }
      ]
    },
    {
      "type": "event",
      "event": "context",
      "payload": {
        "thread_id": "thread-1",
        "turn_id": "turn-1",
        "checkpoint": {
          "remaining_work": [
            "make add return the sum"
          ]
        }
      },
      "expect": [
        {
          "mod": "atlas_policy",
          "value": {
            "text": "atlas_policy 2.0.0 (paired) assembled turn turn-1. Only these paths are in scope: solution.py. Remaining acceptance work: make add return the sum. Native permissions, limits, review, accounting and evidence stay authoritative."
          }
        }
      ]
    },
    {
      "type": "event",
      "event": "tool_before",
      "payload": {
        "tool": "omd_contribute",
        "arguments": {
          "brief": "fix add"
        },
        "call_id": "call-1"
      },
      "expect": [
        {
          "mod": "atlas_policy",
          "value": {
            "tool": "mod_atlas_policy_delegate",
            "arguments": {
              "brief": "fix add"
            }
          }
        }
      ]
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "tool",
      "name": "delegate",
      "payload": {
        "brief": "fix add",
        "selected_evidence": [
          "solution.py",
          "notes.txt"
        ]
      },
      "expect": {
        "status": "completed"
      }
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "tool",
      "name": "survey",
      "payload": {},
      "expect": {
        "surveyed": [
          "sol",
          "astra"
        ],
        "results": [
          {
            "status": "completed",
            "text": "sol inspected",
            "consumed": true
          },
          {
            "status": "completed",
            "text": "astra inspected",
            "consumed": true
          }
        ]
      }
    },
    {
      "type": "event",
      "event": "agent_end",
      "payload": {
        "handle": "one",
        "role": "atlas_surveyor",
        "status": "completed"
      }
    },
    {
      "type": "invoke",
      "mod": "atlas_policy",
      "event": "command",
      "name": "atlas",
      "payload": null,
      "expect": {
        "display": "atlas_policy 2.0.0 (paired) \u00b7 scope solution.py \u00b7 host settings read"
      }
    }
  ]
}
