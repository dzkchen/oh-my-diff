{
  "schema": 1,
  "virtual_time_ms": 1000,
  "packages": ["../session_anchor"],
  "host_operations": {
    "tools.exec": [
      {"result": {"exit_code": 0, "stdout": "Python syntax passed"}},
      {"result": {"exit_code": 0, "stdout": "TypeScript check passed"}}
    ]
  },
  "steps": [
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {"remaining_work": ["fix scripts/mod_conformance.py"]},
      "expect": ["mod_task_scope_check_python"]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "tool",
      "name": "check_python",
      "payload": {},
      "expect": {"exit_code": 0, "stdout": "Python syntax passed"}
    },
    {
      "type": "event",
      "event": "context",
      "payload": {"thread_id": "author-task", "turn_id": "one", "checkpoint": {"remaining_work": ["fix scripts/mod_conformance.py"]}},
      "expect": [
        {"mod": "session_anchor", "value": {"text": "Host checkpoint anchor after 0 local compactions. Remaining: fix scripts/mod_conformance.py. Completed steering: none recorded. Recheck evidence before completion."}},
        {"mod": "task_scope", "value": {"text": "Optional task checks available: check_python. Native tool authorization still applies."}}
      ]
    },
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {"remaining_work": ["fix mods/api.d.ts"]},
      "expect": ["mod_task_scope_check_typescript"]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "tool",
      "name": "check_typescript",
      "payload": {},
      "expect": {"exit_code": 0, "stdout": "TypeScript check passed"}
    },
    {
      "type": "event",
      "event": "compaction",
      "payload": {"token_limit": 20000, "context_window": 30000},
      "expect": [{"mod": "session_anchor", "value": {"threshold": 16000, "prompt": "Summarize the current task from verified host checkpoints. Preserve exact remaining acceptance work and evidence references. Mark uncertain or stale facts explicitly."}}]
    },
    {
      "type": "event",
      "event": "compaction_end",
      "payload": {"turn_id": "one", "trigger": "auto"}
    },
    {
      "type": "event",
      "event": "context",
      "payload": {"thread_id": "author-task", "turn_id": "two", "checkpoint": {"remaining_work": ["fix mods/api.d.ts"], "completed_steering": ["Python syntax passed"]}},
      "expect": [
        {"mod": "session_anchor", "value": {"text": "Host checkpoint anchor after 1 local compaction. Remaining: fix mods/api.d.ts. Completed steering: Python syntax passed. Recheck evidence before completion."}},
        {"mod": "task_scope", "value": {"text": "Optional task checks available: check_typescript. Native tool authorization still applies."}}
      ]
    },
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {"remaining_work": ["update README.md"]},
      "expect": []
    },
    {
      "type": "event",
      "event": "compaction_end",
      "payload": {"turn_id": "two", "trigger": "auto"}
    },
    {
      "type": "event",
      "event": "context",
      "payload": {"thread_id": "author-task", "turn_id": "three", "checkpoint": {"remaining_work": ["update README.md"], "completed_steering": ["Python syntax passed"]}},
      "expect": [
        {"mod": "session_anchor", "value": {"text": "Host checkpoint anchor after 2 local compactions. Remaining: update README.md. Completed steering: Python syntax passed. Recheck evidence before completion."}},
        {"mod": "task_scope", "value": null}
      ]
    },
    {"type": "status"},
    {"type": "reload"},
    {
      "type": "event",
      "event": "context",
      "payload": {"thread_id": "author-task", "turn_id": "four", "checkpoint": {"remaining_work": ["update README.md"], "completed_steering": ["Python syntax passed"]}},
      "expect": [
        {"mod": "session_anchor", "value": {"text": "Host checkpoint anchor after 2 local compactions. Remaining: update README.md. Completed steering: Python syntax passed. Recheck evidence before completion."}},
        {"mod": "task_scope", "value": null}
