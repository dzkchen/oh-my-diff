{
  "schema": 1,
  "virtual_time_ms": 1000,
  "packages": [
    "../session_anchor"
  ],
  "host_operations": {
    "exec.run": [
      {
        "result": {
          "exit_code": 0,
          "stdout": "Python syntax passed",
          "stderr": ""
        }
      },
      {
        "result": {
          "exit_code": 0,
          "stdout": "TypeScript check passed",
          "stderr": ""
        }
      }
    ]
  },
  "steps": [
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "command",
      "name": "scope",
      "payload": "scripts/mod_conformance.py",
      "expect": {
        "display": "Task scope: scripts/mod_conformance.py"
      }
    },
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {
        "thread_id": "author-task",
        "cwd": "/repo",
        "cost": null
      },
      "expect": [
        "mod_task_scope_check_python"
      ]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "tool",
      "name": "check_python",
      "payload": {},
      "expect": {
        "exit_code": 0,
        "stdout": "Python syntax passed",
        "stderr": ""
      }
    },
    {
      "type": "invoke",
      "mod": "session_anchor",
      "event": "command",
      "name": "anchor",
      "payload": "remaining fix scripts/mod_conformance.py",
      "expect": {
        "display": "Anchored remaining: fix scripts/mod_conformance.py"
      }
    },
    {
      "type": "event",
      "event": "context",
      "payload": {
        "thread_id": "author-task",
        "turn_id": "one",
        "ledger": {
          "thread_id": "author-task",
          "cwd": "/repo",
          "cost": null
        }
      },
      "expect": [
        {
          "mod": "session_anchor",
          "value": {
            "text": "Session anchor after 0 local compactions. Remaining: fix scripts/mod_conformance.py. Completed: none recorded. Recheck evidence before completion."
          }
        },
        {
          "mod": "task_scope",
          "value": {
            "text": "Optional task checks available: check_python. Native tool authorization still applies."
          }
        }
      ]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "command",
      "name": "scope",
      "payload": "mods/api.d.ts",
      "expect": {
        "display": "Task scope: mods/api.d.ts"
      }
    },
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {
        "thread_id": "author-task",
        "cwd": "/repo",
        "cost": null
      },
      "expect": [
        "mod_task_scope_check_typescript"
      ]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "tool",
      "name": "check_typescript",
      "payload": {},
      "expect": {
        "exit_code": 0,
        "stdout": "TypeScript check passed",
        "stderr": ""
      }
    },
    {
      "type": "event",
      "event": "compaction",
      "payload": {
        "token_limit": 20000,
        "context_window": 30000
      },
      "expect": [
        {
          "mod": "session_anchor",
          "value": {
            "threshold": 16000,
            "prompt": "Summarize the current task from the session anchor. Preserve exact remaining acceptance work and evidence references. Mark uncertain or stale facts explicitly."
          }
        }
      ]
    },
    {
      "type": "event",
      "event": "compaction_end",
      "payload": {
        "turn_id": "one",
        "trigger": "auto"
      }
    },
    {
      "type": "invoke",
      "mod": "session_anchor",
      "event": "command",
      "name": "anchor",
      "payload": "done fix scripts/mod_conformance.py",
      "expect": {
        "display": "Anchored done: fix scripts/mod_conformance.py"
      }
    },
    {
      "type": "invoke",
      "mod": "session_anchor",
      "event": "command",
      "name": "anchor",
      "payload": "remaining fix mods/api.d.ts",
      "expect": {
        "display": "Anchored remaining: fix mods/api.d.ts"
      }
    },
    {
      "type": "event",
      "event": "context",
      "payload": {
        "thread_id": "author-task",
        "turn_id": "two",
        "ledger": {
          "thread_id": "author-task",
          "cwd": "/repo",
          "cost": null
        }
      },
      "expect": [
        {
          "mod": "session_anchor",
          "value": {
            "text": "Session anchor after 1 local compaction. Remaining: fix mods/api.d.ts. Completed: fix scripts/mod_conformance.py. Recheck evidence before completion."
          }
        },
        {
          "mod": "task_scope",
          "value": {
            "text": "Optional task checks available: check_typescript. Native tool authorization still applies."
          }
        }
      ]
    },
    {
      "type": "invoke",
      "mod": "task_scope",
      "event": "command",
      "name": "scope",
      "payload": "README.md",
      "expect": {
        "display": "Task scope: README.md"
      }
    },
    {
      "type": "tool_exposure",
      "thread_id": "author-task",
      "payload": {
        "thread_id": "author-task",
        "cwd": "/repo",
        "cost": null
      },
      "expect": []
    },
    {
      "type": "event",
      "event": "compaction_end",
      "payload": {
        "turn_id": "two",
        "trigger": "auto"
      }
    },
    {
      "type": "event",
      "event": "context",
      "payload": {
        "thread_id": "author-task",
        "turn_id": "three",
        "ledger": {
          "thread_id": "author-task",
          "cwd": "/repo",
          "cost": null
        }
      },
      "expect": [
        {
          "mod": "session_anchor",
          "value": {
            "text": "Session anchor after 2 local compactions. Remaining: fix mods/api.d.ts. Completed: fix scripts/mod_conformance.py. Recheck evidence before completion."
          }
        },
        {
          "mod": "task_scope",
          "value": null
        }
      ]
    },
    {
      "type": "status"
    },
    {
      "type": "reload"
    },
    {
      "type": "event",
      "event": "context",
      "payload": {
        "thread_id": "author-task",
        "turn_id": "four",
        "ledger": {
          "thread_id": "author-task",
          "cwd": "/repo",
          "cost": null
        }
      },
      "expect": [
        {
          "mod": "session_anchor",
          "value": {
            "text": "Session anchor after 2 local compactions. Remaining: fix mods/api.d.ts. Completed: fix scripts/mod_conformance.py. Recheck evidence before completion."
          }
        },
        {
          "mod": "task_scope",
          "value": null
        }
      ]
    }
  ]
}
