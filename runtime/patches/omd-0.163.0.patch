+#[derive(Default)]
+struct InventoryObserver(std::sync::Mutex<Vec<codex_extension_api::ToolInventoryEntry>>);
+
+impl codex_extension_api::ToolSpecContributor for InventoryObserver {
+    fn adjust_tool_specs(
+        &self,
+        _thread_store: &codex_extension_api::ExtensionData,
+        _specs: &[codex_extension_api::ToolSpecView],
+    ) -> Option<codex_extension_api::ToolSpecAdjustment> {
+        Some(codex_extension_api::ToolSpecAdjustment {
+            hide: vec!["mcp__srv__hidden".into()],
+            defer: vec!["mcp__srv__lookup".into()],
+            describe: [(
+                "mcp__srv__lookup".to_owned(),
+                (Some("changed".to_owned()), None),
+            )]
+            .into(),
+        })
+    }
+
+    fn observing(&self, _thread_store: &codex_extension_api::ExtensionData) -> bool {
+        true
+    }
+
+    fn observe_tool_inventory(
+        &self,
+        _thread_store: &codex_extension_api::ExtensionData,
+        inventory: &[codex_extension_api::ToolInventoryEntry],
+    ) {
+        *self.0.lock().unwrap() = inventory.to_vec();
+    }
+}
