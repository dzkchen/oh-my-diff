+    assert!(
+        page_edits(&unchanged, &page, &json!({"a": "a😀b secret"}))
+            .unwrap()
+            .is_empty()
+    );
+    let mut applied = BTreeMap::new();
+    applied.insert("/a".to_owned(), vec![(7, 13, "[x]".to_owned())]);
