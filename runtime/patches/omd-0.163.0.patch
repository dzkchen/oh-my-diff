+#[test]
+#[serial_test::serial]
+fn pixel_reports_convert_to_cells_with_the_half_row() {
+    *FACTS.lock().unwrap() = Some(Facts {
+        pixel_pointer: true,
+        cell: Some((10, 20)),
+        ..Facts::default()
+    });
+    assert!(enable_pixel_pointer());
+    let event = |column, row| MouseEvent {
