+use super::*;
+
+#[test]
+fn failed_replacement_preserves_the_previous_consent_document() {
+    use std::os::unix::fs::PermissionsExt;
+    let root = tempfile::tempdir().unwrap();
+    grant(root.path(), "thread", "owner", "digest", "id").unwrap();
+    let directory = root.path().join("consents");
+    let path = directory.join("thread.json");
+    let original = fs::read(&path).unwrap();
+    let result = with(root.path(), "thread", |consents| {
+        consents.clear();
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o500))
+    });
+    fs::set_permissions(&directory, fs::Permissions::from_mode(0o700)).unwrap();
+    assert!(result.is_err());
+    assert_eq!(fs::read(path).unwrap(), original);
+    assert!(
+        status(root.path(), "thread", "owner", "id")
+            .unwrap()
+            .is_some()
+    );
+}
+
+#[test]
+fn consents_are_single_use_content_bound_and_reconciled_by_client_id() {
+    let root = tempfile::tempdir().unwrap();
+    let root = root.path();
+    let sha = digest("ship it", &[]);
+    grant(root, "t1", "queue", &sha, "c1").unwrap();
+    let spend = |sha: &str, client: &str| consume(root, "t1", "queue", "c1", sha, client);
+    assert_eq!(
+        spend(&digest("ship it now", &[]), "m1")
+            .unwrap_err()
+            .to_string(),
+        "consent_content_changed"
+    );
+    assert!(
+        consume(root, "t1", "other", "c1", &sha, "m1").is_err(),
+        "consents bind their owner"
+    );
+    spend(&sha, "m1").unwrap();
+    assert_eq!(spend(&sha, "m2").unwrap_err().to_string(), "consent_spent");
+    assert_eq!(
+        status(root, "t2", "queue", "c1").unwrap(),
+        None,
+        "consents stay on their thread"
+    );
+    delivered(root, "t1", "m1", "turn-9").unwrap();
+    let consent = status(root, "t1", "queue", "c1").unwrap().unwrap();
+    assert_eq!(
+        (consent.client_id.as_deref(), consent.turn_id.as_deref()),
+        (Some("m1"), Some("turn-9"))
+    );
+    grant(root, "t1", "queue", &sha, "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m3").unwrap();
+    restore(root, "t1", "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m4").unwrap();
+    assert_eq!(retain(root, "t1", |consent| consent.id != "c1").unwrap(), 1);
+    assert_eq!(
+        retain(root, "t1", |consent| consent.owner != "queue").unwrap(),
+        1
+    );
+    assert!(grant(root, "../escape", "queue", &sha, "c3").is_err());
+}
diff --git a/codex-rs/omd/src/contract_cli.rs b/codex-rs/omd/src/contract_cli.rs
new file mode 100644
index 0000000000000000000000000000000000000000..948462abeb7aec19933caac69dd71734c763da32
--- /dev/null
+++ b/codex-rs/omd/src/contract_cli.rs
@@ -0,0 +1,143 @@
+use crate::ContractDocument;
+use crate::ContractResolution;
+use crate::ContractSelection;
+use crate::ModHost;
+use crate::PolicyOwner;
+use serde_json::Value;
+use serde_json::json;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub fn documents(store: &Path) -> io::Result<Vec<(ContractDocument, PolicyOwner)>> {
+    let root = store.canonicalize()?;
+    Ok(ModHost::open(root)?.contract_documents())
+}
+
+pub fn user_path(store: &Path) -> io::Result<PathBuf> {
+    let config = store.join("host.json");
+    let configured = match std::fs::read(&config) {
+        Ok(bytes) => serde_json::from_slice::<Value>(&bytes)?["contract"]["user"]
+            .as_str()
+            .map(PathBuf::from),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error),
+    };
+    Ok(configured.unwrap_or_else(|| store.join(crate::USER_CONTRACT_SELECTION)))
+}
+
+pub fn project_path(repository: &Path) -> PathBuf {
+    repository.join(crate::PROJECT_CONTRACT_SELECTION)
+}
+
+pub fn read(path: &Path) -> io::Result<Option<ContractSelection>> {
+    ContractSelection::read(path).map_err(io::Error::other)
+}
+
+pub fn summary(document: &ContractDocument, owner: &PolicyOwner) -> Value {
+    json!({"key": document.key(), "description": document.description, "assurance": document.assurance,
+        "gates": document.gates, "restrict": document.restrict, "digest": document.digest(), "owner": owner})
+}
+
+pub fn effective(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+) -> io::Result<ContractResolution> {
+    let user = read(&user_path(store)?)?;
+    let project = read(&project_path(repository))?;
+    Ok(crate::resolve_contract(
+        documents,
+        user.as_ref(),
+        project.as_ref(),
+    ))
+}
+
+pub fn describe(resolution: &ContractResolution) -> Value {
+    match resolution {
+        ContractResolution::None => {
+            json!({"status": "none", "note": "no contract is selected; completion and integration are not gated"})
+        }
+        ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode,
+        } => json!({"status": "active", "contract": summary(document, owner), "source": source,
+            "overrode": overrode}),
+        ContractResolution::Unavailable(error) => json!({"status": "unavailable", "error": error,
+            "note": "completion and integration fail closed until the selection is fixed"}),
+    }
+}
+
+pub fn find(
+    documents: &[(ContractDocument, PolicyOwner)],
+    key: &str,
+) -> io::Result<(ContractDocument, PolicyOwner)> {
+    documents
+        .iter()
+        .find(|(document, _)| document.key() == key)
+        .cloned()
+        .ok_or_else(|| io::Error::other(format!("no active mod registers contract {key}")))
+}
+
+pub fn current(resolution: &ContractResolution) -> Option<&ContractDocument> {
+    match resolution {
+        ContractResolution::Active { document, .. } => Some(document),
+        _ => None,
+    }
+}
+
+pub fn plan(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+    key: &str,
+) -> io::Result<Value> {
+    let (next, owner) = find(documents, key)?;
+    let resolution = effective(documents, store, repository)?;
+    let before = current(&resolution);
+    let weakens = before.is_some_and(|before| next.weaker_than(before));
+    Ok(
+        json!({"schema": 2, "before": describe(&resolution), "after": summary(&next, &owner),
+        "weakens": weakens,
+        "confirmation": weakens.then(|| crate::contract_confirmation(before, &next)),
+        "note": if weakens {
+            "this selection reduces assurance; pass the confirmation to omd-contract select"
+        } else {
+            "this selection does not reduce assurance"
+        }}),
+    )
+}
+
+pub fn select(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+    key: &str,
+    confirmation: Option<String>,
+) -> io::Result<Value> {
+    let (next, owner) = find(documents, key)?;
+    let resolution = effective(documents, store, repository)?;
+    let before = current(&resolution);
+    if before.is_some_and(|before| next.weaker_than(before))
+        && confirmation.as_deref() != Some(crate::contract_confirmation(before, &next).as_str())
+    {
+        return Err(io::Error::other(
+            "this selection reduces assurance; run omd-contract plan and pass its confirmation",
+        ));
+    }
+    let path = user_path(store)?;
+    ContractSelection {
+        schema: 2,
+        contract: Some(next.key()),
+        contract_digest: Some(next.digest()),
+        confirmation,
+        ..ContractSelection::default()
+    }
+    .write(&path)?;
+    Ok(
+        json!({"schema": 2, "selected": summary(&next, &owner), "path": path,
+        "note": "the selection applies to the next session"}),
+    )
+}
diff --git a/codex-rs/omd/src/contract_document.rs b/codex-rs/omd/src/contract_document.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1d73fbb2a027b866880496fcc83570b5f7d3f889
--- /dev/null
+++ b/codex-rs/omd/src/contract_document.rs
@@ -0,0 +1,627 @@
+use crate::resource_data::ResourceRef;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const CONTRACT_DOCUMENT_SCHEMA: u32 = 2;
+const REQUIREMENT_LIMIT: usize = 16;
+const FINDING_LIMIT: usize = 32;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, Eq, PartialEq, Ord, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum Producer {
+    #[default]
+    Any,
+    Lead,
+    SeparateAgent,
+    Host,
+    Integration,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq, Ord, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum Binding {
+    Candidate,
+    Acceptance,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum BlockingFindings {
+    #[default]
+    Reject,
+    Allow,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractRequirement {
+    pub receipt: String,
+    #[serde(default)]
+    pub producer: Producer,
+    #[serde(default)]
+    pub bind: Vec<Binding>,
+    #[serde(default)]
+    pub blocking_findings: BlockingFindings,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractGates {
+    #[serde(default)]
+    pub complete: Vec<ContractRequirement>,
+    #[serde(default)]
+    pub integrate: Vec<ContractRequirement>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Gate {
+    Complete,
+    Integrate,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractDocument {
+    pub schema: u32,
+    pub id: String,
+    pub version: u32,
+    pub description: String,
+    pub assurance: String,
+    #[serde(default)]
+    pub gates: ContractGates,
+    #[serde(default)]
+    pub restrict: Vec<String>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ReceiptOutcome {
+    Pass,
+    Fail,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum FindingSeverity {
+    Advice,
+    Warning,
+    Blocking,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReceiptFinding {
+    pub fingerprint: String,
+    pub severity: FindingSeverity,
+    pub summary: String,
+    #[serde(default)]
+    pub paths: Vec<String>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ProducerKind {
+    Lead,
+    Agent,
+    Host,
+    Integration,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReceiptProducer {
+    pub kind: ProducerKind,
+    pub handle: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Receipt {
+    pub kind: String,
+    pub candidate_sha256: String,
+    #[serde(default)]
+    pub acceptance_sha256: Option<String>,
+    pub outcome: ReceiptOutcome,
+    pub evidence: ResourceRef,
+    pub producer: ReceiptProducer,
+    #[serde(default)]
+    pub findings: Vec<ReceiptFinding>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub resolves: Vec<String>,
+    pub submitted_by: String,
+    pub at: u128,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct FindingResolution {
+    pub candidate_sha256: String,
+    pub producer: ReceiptProducer,
+    pub receipt_index: usize,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct FindingLedgerEntry {
+    pub finding: ReceiptFinding,
+    pub reported_candidate_sha256: String,
+    pub acceptance_sha256: String,
+    pub reported_producer: ReceiptProducer,
+    pub report_receipt_index: usize,
+    pub resolution: Option<FindingResolution>,
+}
+
+pub type FindingLedger = BTreeMap<String, FindingLedgerEntry>;
+
+pub fn token(value: &str, limit: usize) -> bool {
+    !value.is_empty()
+        && value.len() <= limit
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'_' | b'-' | b'.')
+        })
+}
+
+pub fn sha256_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
+
+impl ContractDocument {
+    pub fn parse(value: &Value) -> Result<Self, String> {
+        let document: Self =
+            serde_json::from_value(value.clone()).map_err(|error| error.to_string())?;
+        document.validate()?;
+        Ok(document)
+    }
+
+    pub fn key(&self) -> String {
+        format!("{}@{}", self.id, self.version)
+    }
+
+    pub fn digest(&self) -> String {
+        let value = crate::broker::canonical(&serde_json::to_value(self).unwrap_or(Value::Null));
+        format!("{:x}", Sha256::digest(value))
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        if self.schema != CONTRACT_DOCUMENT_SCHEMA
+            || !token(&self.id, 64)
+            || self.version == 0
+            || self.description.trim().is_empty()
+            || self.description.len() > 512
+            || self.description.chars().any(char::is_control)
+            || !token(&self.assurance, 64)
+            || self.restrict.len() > 16
+            || self.restrict.iter().collect::<BTreeSet<_>>().len() != self.restrict.len()
+            || self
+                .restrict
+                .iter()
+                .any(|operation| !crate::MOD_HOST_OPERATIONS.contains(&operation.as_str()))
+        {
+            return Err("invalid_contract_document".into());
+        }
+        for requirements in [&self.gates.complete, &self.gates.integrate] {
+            if requirements.len() > REQUIREMENT_LIMIT
+                || requirements
+                    .iter()
+                    .map(|r| &r.receipt)
+                    .collect::<BTreeSet<_>>()
+                    .len()
+                    != requirements.len()
+                || requirements.iter().any(|requirement| {
+                    !token(&requirement.receipt, 64)
+                        || requirement.bind.len() > 2
+                        || requirement.bind.iter().collect::<BTreeSet<_>>().len()
+                            != requirement.bind.len()
+                })
+            {
+                return Err("invalid_contract_requirements".into());
+            }
+        }
+        Ok(())
+    }
+
+    pub fn requirements(&self, gate: Gate) -> &[ContractRequirement] {
+        match gate {
+            Gate::Complete => &self.gates.complete,
+            Gate::Integrate => &self.gates.integrate,
+        }
+    }
+
+    pub fn weaker_than(&self, other: &ContractDocument) -> bool {
+        let covers = |mine: &[ContractRequirement], theirs: &[ContractRequirement]| {
+            theirs.iter().all(|required| {
+                mine.iter().any(|candidate| {
+                    candidate.receipt == required.receipt
+                        && (candidate.producer == required.producer
+                            || required.producer == Producer::Any)
+                        && required
+                            .bind
+                            .iter()
+                            .all(|bind| candidate.bind.contains(bind))
+                        && (candidate.blocking_findings == BlockingFindings::Reject
+                            || required.blocking_findings == BlockingFindings::Allow)
+                })
+            })
+        };
+        !covers(&self.gates.complete, &other.gates.complete)
+            || !covers(&self.gates.integrate, &other.gates.integrate)
+            || other
+                .restrict
+                .iter()
+                .any(|operation| !self.restrict.contains(operation))
+    }
+
+    pub fn missing(
+        &self,
+        gate: Gate,
+        receipts: &[Receipt],
+        candidate_sha256: &str,
+        acceptance_sha256: Option<&str>,
+    ) -> Vec<ContractRequirement> {
+        self.requirements(gate)
+            .iter()
+            .filter(|requirement| {
+                !receipts
+                    .iter()
+                    .rev()
+                    .find(|receipt| {
+                        receipt.kind == requirement.receipt
+                            && (!requirement.bind.contains(&Binding::Candidate)
+                                || receipt.candidate_sha256 == candidate_sha256)
+                            && (!requirement.bind.contains(&Binding::Acceptance)
+                                || acceptance_sha256.is_some()
+                                    && receipt.acceptance_sha256.as_deref() == acceptance_sha256)
+                            && match requirement.producer {
+                                Producer::Any => true,
+                                Producer::Lead => receipt.producer.kind == ProducerKind::Lead,
+                                Producer::SeparateAgent => {
+                                    receipt.producer.kind == ProducerKind::Agent
+                                }
+                                Producer::Host => receipt.producer.kind == ProducerKind::Host,
+                                Producer::Integration => {
+                                    receipt.producer.kind == ProducerKind::Integration
+                                }
+                            }
+                    })
+                    .is_some_and(|receipt| {
+                        receipt.outcome == ReceiptOutcome::Pass
+                            && (requirement.blocking_findings == BlockingFindings::Allow
+                                || !receipt
+                                    .findings
+                                    .iter()
+                                    .any(|finding| finding.severity == FindingSeverity::Blocking))
+                    })
+            })
+            .cloned()
+            .collect()
+    }
+}
+
+impl Receipt {
+    pub fn validate(&self) -> Result<(), String> {
+        if !token(&self.kind, 64)
+            || !sha256_hex(&self.candidate_sha256)
+            || self
+                .acceptance_sha256
+                .as_deref()
+                .is_some_and(|value| !sha256_hex(value))
+            || !sha256_hex(&self.evidence.sha256)
+            || self.findings.len() > FINDING_LIMIT
+            || self.resolves.len() > FINDING_LIMIT
+            || self
+                .findings
+                .iter()
+                .map(|finding| &finding.fingerprint)
+                .collect::<BTreeSet<_>>()
+                .len()
+                != self.findings.len()
+            || self.resolves.iter().collect::<BTreeSet<_>>().len() != self.resolves.len()
+            || self.findings.iter().any(|finding| {
+                !token(&finding.fingerprint, 128)
+                    || finding.summary.is_empty()
+                    || finding.summary.len() > 512
+                    || finding.paths.len() > 32
+                    || finding
+                        .paths
+                        .iter()
+                        .any(|path| path.is_empty() || path.len() > 1024)
+            })
+            || self.resolves.iter().any(|fingerprint| {
+                !token(fingerprint, 128)
+                    || self
+                        .findings
+                        .iter()
+                        .any(|finding| &finding.fingerprint == fingerprint)
+            })
+            || self
+                .findings
+                .iter()
+                .any(|finding| finding.severity == FindingSeverity::Blocking)
+                && self.acceptance_sha256.is_none()
+            || !self.resolves.is_empty()
+                && (self.outcome != ReceiptOutcome::Pass
+                    || self.producer.kind != ProducerKind::Agent
+                    || self.acceptance_sha256.is_none())
+            || (self.producer.kind == ProducerKind::Agent) != self.producer.handle.is_some()
+        {
+            return Err("invalid_receipt".into());
+        }
+        Ok(())
+    }
+}
+
+pub fn apply_finding_receipt(
+    ledger: &mut FindingLedger,
+    receipt: &Receipt,
+    receipt_index: usize,
+) -> Result<(), String> {
+    receipt.validate()?;
+    for fingerprint in &receipt.resolves {
+        let entry = ledger
+            .get(fingerprint)
+            .ok_or("finding_resolution_unknown")?;
+        if entry.resolution.is_some() {
+            return Err("finding_already_resolved".into());
+        }
+        if entry.reported_candidate_sha256 == receipt.candidate_sha256 {
+            return Err("finding_resolution_candidate_unchanged".into());
+        }
+        if receipt.acceptance_sha256.as_deref() != Some(entry.acceptance_sha256.as_str()) {
+            return Err("finding_resolution_acceptance_changed".into());
+        }
+        if entry.reported_producer.kind == ProducerKind::Agent
+            && entry.reported_producer.handle == receipt.producer.handle
+        {
+            return Err("finding_resolution_agent_not_separate".into());
+        }
+    }
+    for fingerprint in &receipt.resolves {
+        ledger
+            .get_mut(fingerprint)
+            .ok_or("finding_resolution_unknown")?
+            .resolution = Some(FindingResolution {
+            candidate_sha256: receipt.candidate_sha256.clone(),
+            producer: receipt.producer.clone(),
+            receipt_index,
+        });
+    }
+    for finding in &receipt.findings {
+        if finding.severity == FindingSeverity::Blocking {
+            if ledger
+                .get(&finding.fingerprint)
+                .is_some_and(|entry| entry.resolution.is_none())
+            {
+                continue;
+            }
+            ledger.insert(
+                finding.fingerprint.clone(),
+                FindingLedgerEntry {
+                    finding: finding.clone(),
+                    reported_candidate_sha256: receipt.candidate_sha256.clone(),
+                    acceptance_sha256: receipt
+                        .acceptance_sha256
+                        .clone()
+                        .ok_or("finding_acceptance_required")?,
+                    reported_producer: receipt.producer.clone(),
+                    report_receipt_index: receipt_index,
+                    resolution: None,
+                },
+            );
+        }
+    }
+    Ok(())
+}
+
+pub fn replay_finding_receipts(receipts: &[Receipt]) -> Result<FindingLedger, String> {
+    let mut ledger = FindingLedger::new();
+    for (index, receipt) in receipts.iter().enumerate() {
+        apply_finding_receipt(&mut ledger, receipt, index)?;
+    }
+    Ok(ledger)
+}
+
+pub const USER_CONTRACT_SELECTION: &str = "contract-selection.json";
+pub const PROJECT_CONTRACT_SELECTION: &str = ".omd/contract-selection.json";
+const SELECTION_BYTES: u64 = 16_384;
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractSelection {
+    pub schema: u32,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub contract: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub contract_digest: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub floor: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub floor_digest: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub confirmation: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+#[allow(clippy::large_enum_variant)]
+pub enum ContractResolution {
+    None,
+    Active {
+        document: ContractDocument,
+        owner: crate::PolicyOwner,
+        source: &'static str,
+        overrode: Option<String>,
+    },
+    Unavailable(String),
+}
+
+impl ContractSelection {
+    fn validate(&self) -> Result<(), String> {
+        let key = |value: &Option<String>| {
+            value.as_deref().is_none_or(|key| {
+                key.split_once('@').is_some_and(|(id, version)| {
+                    token(id, 64) && version.parse::<u32>().is_ok_and(|version| version > 0)
+                })
+            })
+        };
+        let digest = |value: &Option<String>| value.as_deref().is_none_or(sha256_hex);
+        if self.schema != CONTRACT_DOCUMENT_SCHEMA
+            || !key(&self.contract)
+            || !key(&self.floor)
+            || !digest(&self.contract_digest)
+            || !digest(&self.floor_digest)
+            || self.contract.is_none() && self.contract_digest.is_some()
+            || self.floor.is_none() && self.floor_digest.is_some()
+            || self.confirmation.as_deref().is_some_and(|value| {
+                value.len() != 16 || !value.bytes().all(|b| b.is_ascii_hexdigit())
+            })
+        {
+            return Err("invalid_contract_selection".into());
+        }
+        Ok(())
+    }
+
+    pub fn read(path: &std::path::Path) -> Result<Option<Self>, String> {
+        match std::fs::symlink_metadata(path) {
+            Ok(metadata) if metadata.is_file() && metadata.len() <= SELECTION_BYTES => {
+                let selection: Self = serde_json::from_slice(
+                    &std::fs::read(path).map_err(|error| error.to_string())?,
+                )
+                .map_err(|error| format!("invalid contract selection: {error}"))?;
+                selection.validate()?;
+                Ok(Some(selection))
+            }
+            Ok(_) => Err("contract selection must be a bounded regular file".into()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error.to_string()),
+        }
+    }
+
+    pub fn write(&self, path: &std::path::Path) -> std::io::Result<()> {
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+        self.validate().map_err(std::io::Error::other)?;
+        let bytes = serde_json::to_vec_pretty(self)?;
+        let parent = path
+            .parent()
+            .ok_or_else(|| std::io::Error::other("contract selection needs a parent directory"))?;
+        std::fs::create_dir_all(parent)?;
+        let temporary = parent.join(format!(
+            ".contract-selection.{}.{:x}.tmp",
+            std::process::id(),
+            Sha256::digest(&bytes)
+        ));
+        let result = (|| {
+            let mut file = std::fs::OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .mode(0o600)
+                .open(&temporary)?;
+            file.write_all(&bytes)?;
+            file.sync_all()?;
+            std::fs::rename(&temporary, path)?;
+            std::fs::File::open(parent)?.sync_all()
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        result
+    }
+}
+
+pub fn contract_confirmation(from: Option<&ContractDocument>, to: &ContractDocument) -> String {
+    format!(
+        "{:x}",
+        Sha256::digest(
+            format!(
+                "{}\0{}",
+                from.map(ContractDocument::digest).unwrap_or_default(),
+                to.digest()
+            )
+            .as_bytes()
+        )
+    )[..16]
+        .to_owned()
+}
+
+pub fn resolve_contract(
+    documents: &[(ContractDocument, crate::PolicyOwner)],
+    user: Option<&ContractSelection>,
+    project: Option<&ContractSelection>,
+) -> ContractResolution {
+    let find = |key: &str, digest: Option<&String>| {
+        let (document, owner) = documents
+            .iter()
+            .find(|(document, _)| document.key() == key)?;
+        digest
+            .is_none_or(|digest| *digest == document.digest())
+            .then(|| (document.clone(), owner.clone()))
+    };
+    let unavailable = |key: &str| {
+        ContractResolution::Unavailable(format!(
+            "selected contract {key} is not registered by an active mod or its document changed since selection"
+        ))
+    };
+    let floor = project.and_then(|selection| {
+        selection
+            .floor
+            .clone()
+            .map(|key| (key, selection.floor_digest.clone()))
+    });
+    let choice = user
+        .and_then(|selection| {
+            selection
+                .contract
+                .clone()
+                .map(|key| (key, selection.contract_digest.clone(), "user"))
+        })
+        .or_else(|| {
+            project.and_then(|selection| {
+                selection
+                    .contract
+                    .clone()
+                    .map(|key| (key, selection.contract_digest.clone(), "project"))
+            })
+        });
+    let minimum = match &floor {
+        Some((key, digest)) => match find(key, digest.as_ref()) {
+            Some(found) => Some(found),
+            None => return unavailable(key),
+        },
+        None => None,
+    };
+    let Some((key, digest, source)) = choice else {
+        return match minimum {
+            Some((document, owner)) => ContractResolution::Active {
+                document,
+                owner,
+                source: "project_floor",
+                overrode: None,
+            },
+            None => ContractResolution::None,
+        };
+    };
+    let Some((document, owner)) = find(&key, digest.as_ref()) else {
+        return unavailable(&key);
+    };
+    match minimum {
+        Some((floor, floor_owner)) if document.weaker_than(&floor) => ContractResolution::Active {
+            document: floor,
+            owner: floor_owner,
+            source: "project_floor",
+            overrode: Some(key),
+        },
+        _ => ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode: None,
+        },
+    }
+}
diff --git a/codex-rs/omd/src/credentials.rs b/codex-rs/omd/src/credentials.rs
new file mode 100644
index 0000000000000000000000000000000000000000..21b6babe600191ba1ce9fc229fd9d6915a53f67d
--- /dev/null
+++ b/codex-rs/omd/src/credentials.rs
@@ -0,0 +1,570 @@
+use serde::{Deserialize, Serialize};
+use std::fs;
+use std::io::{self, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+
+pub const PROFILE_LIMIT: usize = 32;
+const KINDS: &[&str] = &["chatgpt", "api_key", "provider"];
+pub const SECRET_BYTES: usize = 4096;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct CredentialProfile {
+    pub id: String,
+    pub label: String,
+    pub kind: String,
+    pub provider: Option<String>,
+    pub default: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub origin: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub owner: Option<String>,
+}
+
+impl CredentialProfile {
+    /// The only origin this profile's token is ever sent to.
+    pub fn destination(&self) -> Option<&str> {
+        match self.kind.as_str() {
+            "chatgpt" => Some("https://chatgpt.com"),
+            "api_key" => Some("https://api.openai.com"),
+            _ => self.origin.as_deref(),
+        }
+    }
+}
+
+#[derive(Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Index {
+    schema: u32,
+    next: u64,
+    profiles: Vec<CredentialProfile>,
+}
+
+impl Index {
+    fn profile(&self, id: &str) -> io::Result<&CredentialProfile> {
+        self.profiles
+            .iter()
+            .find(|p| p.id == id)
+            .ok_or_else(|| failure(format!("credential_profile_unknown: {id}")))
+    }
+}
+
+pub struct CredentialProfiles {
+    root: PathBuf,
+    broker: Option<(PathBuf, PathBuf)>,
+}
+
+pub struct CredentialSecret {
+    pub token: String,
+    pub account_id: Option<String>,
+}
+
+impl std::fmt::Debug for CredentialSecret {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("CredentialSecret")
+            .field("account_id", &self.account_id)
+            .finish_non_exhaustive()
+    }
+}
+
+fn expired(token: &str, now: u64) -> bool {
+    use base64::Engine;
+    let Some(payload) = token.split('.').nth(1) else {
+        return false;
+    };
+    base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(payload.trim_end_matches('='))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<serde_json::Value>(&bytes).ok())
+        .and_then(|claims| claims["exp"].as_u64())
+        .is_some_and(|exp| exp <= now + 60)
+}
+
+fn failure(message: impl Into<String>) -> io::Error {
+    io::Error::other(message.into())
+}
+
+fn text(value: &str, limit: usize) -> bool {
+    !value.is_empty() && value.len() <= limit && !value.chars().any(char::is_control)
+}
+
+pub fn url_origin(url: &str) -> Option<String> {
+    let (scheme, rest) = url.split_once("://")?;
+    let authority = rest.split(['/', '?', '#']).next()?.to_ascii_lowercase();
+    let scheme = scheme.to_ascii_lowercase();
+    let authority = match (scheme.as_str(), authority.rsplit_once(':')) {
+        ("https", Some((host, "443"))) | ("http", Some((host, "80"))) => host.to_owned(),
+        _ => authority,
+    };
+    let value = format!("{scheme}://{authority}");
+    origin(&value).then_some(value)
+}
+
+pub fn origin(value: &str) -> bool {
+    let Some((scheme, rest)) = value.split_once("://") else {
+        return false;
+    };
+    let host = rest.rsplit_once(':').map_or(rest, |(host, port)| {
+        if port.parse::<u16>().is_ok() {
+            host
+        } else {
+            ""
+        }
+    });
+    matches!(scheme, "https" | "http")
+        && value.len() <= 256
+        && !host.is_empty()
+        && host
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'.' | b'-'))
+}
+
+impl CredentialProfiles {
+    pub fn open(store: &Path) -> io::Result<Self> {
+        if !crate::broker::deployed() {
+            return Self::local(store);
+        }
+        if store.canonicalize()? != store {
+            return Err(failure("credential_root_invalid"));
+        }
+        Ok(Self::brokered(store, Path::new(crate::broker::SOCKET)))
+    }
+
+    pub fn brokered(store: &Path, socket: &Path) -> Self {
+        Self {
+            root: store.join("credentials"),
+            broker: Some((store.to_path_buf(), socket.to_path_buf())),
+        }
+    }
+
+    pub fn local(store: &Path) -> io::Result<Self> {
+        if store.canonicalize()? != store {
+            return Err(failure("credential_root_invalid"));
+        }
+        let root =
+            crate::workspace::private_path(store, &["credentials"], "credential_root_invalid")?;
+        Ok(Self { root, broker: None })
+    }
+
+    fn remote(
+        &self,
+        op: &str,
+        mut arguments: serde_json::Value,
+        authorized: bool,
+    ) -> Option<io::Result<serde_json::Value>> {
+        let (store, socket) = self.broker.as_ref()?;
+        arguments["store"] = serde_json::json!(store);
+        let op = format!("credentials.{op}");
+        Some(crate::broker::Client::at(socket).and_then(|mut client| {
+            if authorized {
+                client.authorized(&op, arguments)
+            } else {
+                client.call(&op, arguments)
+            }
+        }))
+    }
+
+    fn with_index<T>(
+        &self,
+        write: bool,
+        change: impl FnOnce(&mut Index) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(self.root.join(".profiles.lock"))?;
+        lock.lock()?;
+        let path = self.root.join("profiles.json");
+        let mut index = match fs::read(&path) {
+            Ok(bytes) => serde_json::from_slice::<Index>(&bytes)?,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Index {
+                schema: 1,
+                next: 1,
+                profiles: Vec::new(),
+            },
+            Err(error) => return Err(error),
+        };
+        if index.schema != 1 {
+            return Err(failure("credential_index_unsupported"));
+        }
+        let value = change(&mut index)?;
+        if write {
+            let temporary = self
+                .root
+                .join(format!(".profiles.json.{}", std::process::id()));
+            let mut file = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&temporary)?;
+            let written = file
+                .write_all(&serde_json::to_vec_pretty(&index)?)
+                .and_then(|()| file.sync_all());
+            if let Err(error) = written.and_then(|()| fs::rename(&temporary, &path)) {
+                let _ = fs::remove_file(&temporary);
+                return Err(error);
+            }
+        }
+        Ok(value)
+    }
+
+    pub fn list(&self) -> io::Result<Vec<CredentialProfile>> {
+        if let Some(value) = self.remote("list", serde_json::json!({}), false) {
+            return Ok(serde_json::from_value(value?)?);
+        }
+        self.with_index(false, |index| Ok(index.profiles.clone()))
+    }
+
+    pub fn visible(&self, caller: &str) -> io::Result<Vec<serde_json::Value>> {
+        if let Some(value) = self.remote("visible", serde_json::json!({"caller": caller}), false) {
+            return Ok(serde_json::from_value(value?)?);
+        }
+        self.list()?
+            .iter()
+            .filter(|profile| profile.kind != "secret" || profile.owner.as_deref() == Some(caller))
+            .map(|profile| self.public(profile))
+            .collect()
+    }
+
+    pub fn public(&self, profile: &CredentialProfile) -> io::Result<serde_json::Value> {
+        if let Some(value) = self.remote("public", serde_json::json!({"id": profile.id}), false) {
+            return value;
+        }
+        let ready = self.enrolled(&profile.id)?;
+        Ok(
+            serde_json::json!({"id": profile.id, "label": profile.label, "kind": profile.kind,
+            "provider": profile.provider, "origin": profile.destination(),
+            "status": if ready { "ready" } else { "not_enrolled" }, "default": profile.default}),
+        )
+    }
+
+    pub(crate) fn enrolled(&self, id: &str) -> io::Result<bool> {
+        let file = if self.profile(id)?.kind == "secret" {
+            "secret"
+        } else {
+            "auth.json"
+        };
+        Ok(fs::symlink_metadata(self.root.join(id).join(file))
+            .is_ok_and(|metadata| metadata.is_file()))
+    }
+
+    fn home(&self, id: &str) -> io::Result<PathBuf> {
+        self.with_index(false, |index| self.indexed_home(index, id))
+    }
+
+    fn indexed_home(&self, index: &Index, id: &str) -> io::Result<PathBuf> {
+        index.profile(id)?;
+        crate::workspace::private_path(&self.root, &[id], "credential_home_invalid")
+    }
+
+    /// A `provider` profile is bound to an `https` origin; the other kinds have a fixed destination.
+    pub fn create(
+        &self,
+        label: &str,
+        kind: &str,
+        provider: Option<&str>,
+        origin: Option<&str>,
+    ) -> io::Result<CredentialProfile> {
+        if let Some(value) = self.remote(
+            "create",
+            serde_json::json!({"label": label, "kind": kind, "provider": provider, "origin": origin}),
+            false,
+        ) {
+            return Ok(serde_json::from_value(value?)?);
+        }
+        let invalid = || failure("credential_profile_invalid");
+        let origin = match (kind, origin) {
+            ("provider", Some(origin)) => Some(
+                url_origin(origin)
+                    .filter(|origin| origin.starts_with("https://"))
+                    .ok_or_else(invalid)?,
+            ),
+            ("provider", None) | (_, Some(_)) => return Err(invalid()),
+            _ => None,
+        };
+        if !text(label, 64) || !KINDS.contains(&kind) || provider.is_some_and(|p| !text(p, 64)) {
+            return Err(invalid());
+        }
+        self.insert(label, kind, provider, origin.as_deref(), None)
+    }
+
+    pub fn create_secret(
+        &self,
+        label: &str,
+        origin_url: &str,
+        owner: &str,
+    ) -> io::Result<CredentialProfile> {
+        if let Some(value) = self.remote(
+            "create_secret",
+            serde_json::json!({"label": label, "origin": origin_url, "owner": owner}),
+            false,
+        ) {
+            return Ok(serde_json::from_value(value?)?);
+        }
+        if !text(label, 64) || !origin(origin_url) || !text(owner, 128) {
+            return Err(failure("credential_profile_invalid"));
+        }
+        self.insert(label, "secret", None, Some(origin_url), Some(owner))
+    }
+
+    fn insert(
+        &self,
+        label: &str,
+        kind: &str,
+        provider: Option<&str>,
+        origin: Option<&str>,
+        owner: Option<&str>,
+    ) -> io::Result<CredentialProfile> {
+        let profile = self.with_index(true, |index| {
+            if index.profiles.len() >= PROFILE_LIMIT {
+                return Err(failure("credential_profile_limit"));
+            }
+            if index.profiles.iter().any(|p| p.label == label) {
+                return Err(failure("credential_profile_label_exists"));
+            }
+            let profile = CredentialProfile {
+                id: format!("p{}", index.next),
+                label: label.to_owned(),
+                kind: kind.to_owned(),
+                provider: provider.map(str::to_owned),
+                default: index.profiles.is_empty() && kind != "secret",
+                origin: origin.map(str::to_owned),
+                owner: owner.map(str::to_owned),
+            };
+            index.next += 1;
+            index.profiles.push(profile.clone());
+            Ok(profile)
+        })?;
+        self.home(&profile.id)?;
+        Ok(profile)
+    }
+
+    /// Asks for authorization only when the broker says the profile holds a secret.
+    pub fn remove(&self, id: &str) -> io::Result<bool> {
+        if let Some(value) = self.remote("remove", serde_json::json!({"id": id}), false) {
+            let value = match value {
+                Err(error) if error.to_string() == "authority_challenge_invalid" => self
+                    .remote("remove", serde_json::json!({"id": id}), true)
+                    .unwrap_or_else(|| Err(failure("authority_broker_unavailable"))),
+                value => value,
+            };
+            return Ok(value?.as_bool().unwrap_or_default());
+        }
+        let removed = self.with_index(true, |index| {
+            let before = index.profiles.len();
+            let was_default = index.profiles.iter().any(|p| p.id == id && p.default);
+            index.profiles.retain(|p| p.id != id);
+            if was_default
+                && let Some(next) = index.profiles.iter_mut().find(|p| p.kind != "secret")
+            {
+                next.default = true;
+            }
+            Ok(index.profiles.len() != before)
+        })?;
+        if removed {
+            match fs::remove_dir_all(self.root.join(id)) {
+                Err(error) if error.kind() != io::ErrorKind::NotFound => return Err(error),
+                _ => (),
+            }
+        }
+        Ok(removed)
+    }
+
+    pub fn profile(&self, id: &str) -> io::Result<CredentialProfile> {
+        if let Some(value) = self.remote("profile", serde_json::json!({"id": id}), false) {
+            return Ok(serde_json::from_value(value?)?);
+        }
+        self.list()?
+            .into_iter()
+            .find(|profile| profile.id == id)
+            .ok_or_else(|| failure(format!("credential_profile_unknown: {id}")))
+    }
+
+    pub fn store_secret(&self, id: &str, value: &str) -> io::Result<()> {
+        if let Some(result) = self.remote(
+            "store_secret",
+            serde_json::json!({"id": id, "value": value}),
+            true,
+        ) {
+            return result.map(drop);
+        }
+        if value.is_empty() || value.len() > SECRET_BYTES {
+            return Err(failure("credential_secret_invalid"));
+        }
+        self.replace(
+            id,
+            "secret",
+            value,
+            |kind| kind == "secret",
+            "credential_secret_invalid",
+        )
+    }
+
+    /// Publishes a profile's credential file whole, with private permissions, under the profile lock.
+    fn replace(
+        &self,
+        id: &str,
+        name: &str,
+        value: &str,
+        kind: impl FnOnce(&str) -> bool,
+        refusal: &str,
+    ) -> io::Result<()> {
+        self.with_index(false, |index| {
+            if !kind(&index.profile(id)?.kind) {
+                return Err(failure(refusal));
+            }
+            let home = self.indexed_home(index, id)?;
+            let path = home.join(name);
+            if fs::symlink_metadata(&path).is_ok_and(|metadata| !metadata.is_file()) {
+                return Err(failure("credential_store_invalid"));
+            }
+            let mut staged = tempfile::NamedTempFile::new_in(&home)?;
+            staged.write_all(value.as_bytes())?;
+            staged.as_file().sync_all()?;
+            staged.persist(&path).map_err(|error| error.error)?;
+            fs::File::open(&home)?.sync_all()
+        })
+    }
+
+    pub fn store_auth(&self, id: &str, auth: &str) -> io::Result<()> {
+        if let Some(result) = self.remote(
+            "store_auth",
+            serde_json::json!({"id": id, "auth": auth}),
+            true,
+        ) {
+            return result.map(drop);
+        }
+        if auth.len() > 65_536 || serde_json::from_str::<serde_json::Value>(auth).is_err() {
+            return Err(failure("credential_auth_invalid"));
+        }
+        self.replace(
+            id,
+            "auth.json",
+            auth,
+            |kind| kind != "secret",
+            "credential_auth_invalid",
+        )
+    }
+
+    pub fn owned_secret(&self, id: &str, owner: &str) -> io::Result<serde_json::Value> {
+        if let Some(value) = self.remote(
+            "owned_secret",
+            serde_json::json!({"id": id, "owner": owner}),
+            false,
+        ) {
+            return value;
+        }
+        let profile = self.profile(id)?;
+        if profile.kind != "secret" || profile.owner.as_deref() != Some(owner) {
+            return Err(failure(format!("credential_secret_not_owned: {id}")));
+        }
+        Ok(serde_json::json!({"id": profile.id, "label": profile.label,
+            "origin": profile.origin, "value": self.read_secret(id)?}))
+    }
+
+    fn read_secret(&self, id: &str) -> io::Result<String> {
+        let path = self.home(id)?.join("secret");
+        let metadata = fs::symlink_metadata(&path)
+            .map_err(|_| failure(format!("credential_not_enrolled: {id}")))?;
+        if !metadata.is_file() || metadata.len() > SECRET_BYTES as u64 {
+            return Err(failure("credential_store_invalid"));
+        }
+        fs::read_to_string(path)
+    }
+
+    /// Refuses unless `origin` is the profile's enrolled destination and, for a `secret` profile asked by a mod (`owner`), that mod owns it.
+    pub fn secret(
+        &self,
+        id: &str,
+        origin: &str,
+        owner: Option<&str>,
+    ) -> io::Result<CredentialSecret> {
+        if let Some(value) = self.remote(
+            "secret",
+            serde_json::json!({"id": id, "origin": origin, "owner": owner}),
+            false,
+        ) {
+            let value = value?;
+            return Ok(CredentialSecret {
+                token: value["token"]
+                    .as_str()
+                    .filter(|token| !token.is_empty())
+                    .ok_or_else(|| failure("credential_store_invalid"))?
+                    .to_owned(),
+                account_id: value["account_id"].as_str().map(str::to_owned),
+            });
+        }
+        let profile = self.profile(id)?;
+        if profile.kind == "secret"
+            && owner.is_some_and(|owner| profile.owner.as_deref() != Some(owner))
+        {
+            return Err(failure(format!("credential_secret_not_owned: {id}")));
+        }
+        if profile.destination() != Some(origin) {
+            return Err(failure(format!("credential_origin_mismatch: {id}")));
+        }
+        if profile.kind == "secret" {
+            return Ok(CredentialSecret {
+                token: self.read_secret(id)?,
+                account_id: None,
+            });
+        }
+        let path = self.home(id)?.join("auth.json");
+        let metadata = fs::symlink_metadata(&path)
+            .map_err(|_| failure(format!("credential_not_enrolled: {id}")))?;
+        if !metadata.is_file() || metadata.len() > 65_536 {
+            return Err(failure("credential_store_invalid"));
+        }
+        let auth: serde_json::Value = serde_json::from_slice(&fs::read(&path)?)
+            .map_err(|_| failure("credential_store_invalid"))?;
+        if let Some(key) = auth["OPENAI_API_KEY"]
+            .as_str()
+            .filter(|key| !key.is_empty())
+        {
+            return Ok(CredentialSecret {
+                token: key.to_owned(),
+                account_id: None,
+            });
+        }
+        let token = auth["tokens"]["access_token"]
+            .as_str()
+            .filter(|token| !token.is_empty())
+            .ok_or_else(|| failure(format!("credential_not_enrolled: {id}")))?;
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|elapsed| elapsed.as_secs())
+            .unwrap_or_default();
+        if profile.kind == "chatgpt" && expired(token, now) {
+            return Err(failure(format!(
+                "credential_expired: refresh profile {id} before using it"
+            )));
+        }
+        Ok(CredentialSecret {
+            token: token.to_owned(),
+            account_id: auth["tokens"]["account_id"].as_str().map(str::to_owned),
+        })
+    }
+
+    pub fn set_default(&self, id: &str) -> io::Result<()> {
+        if let Some(result) = self.remote("set_default", serde_json::json!({"id": id}), true) {
+            return result.map(drop);
+        }
+        self.with_index(true, |index| {
+            index.profile(id)?;
+            for profile in &mut index.profiles {
+                profile.default = profile.id == id;
+            }
+            Ok(())
+        })
+    }
+}
