+                .as_str()
+                .unwrap()
+                .contains(&session.thread_id.to_string())
+        );
+        assert!(result.as_str().unwrap().contains(&turn.sub_id));
+        assert!(result.as_str().unwrap().contains("kernel-cell"));
+    }
