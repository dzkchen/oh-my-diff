+    /// The draft at its current revision; `path` is replaced by a resource before it reaches a mod.
+    pub(crate) fn mod_composer_read(&mut self) -> serde_json::Value {
+        let composer = self.bottom_pane.composer_mut();
+        let revision = composer.mod_draft_sync();
+        let attachments = composer
+            .local_images()
+            .into_iter()
+            .map(|image| {
+                let owner = composer
+                    .mod_draft_owner(&image.path)
+                    .map(|(owner, _)| owner);
+                serde_json::json!({"kind": "image", "label": image.placeholder,
+                    "owner": owner.as_deref().unwrap_or("user"), "path": image.path})
+            })
+            .collect::<Vec<_>>();
+        let selection = composer
+            .mod_selection()
+            .map(|range| serde_json::json!({"start": range.start, "end": range.end}));
+        let suggestion = composer
+            .mod_suggestion_owner()
+            .map(|(owner, id)| serde_json::json!({"owner": owner, "id": id}));
+        serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor(), "selection": selection,
+            "revision": revision, "attachments": attachments, "suggestion": suggestion})
+    }
+
+    pub(crate) fn mod_composer_write(
+        &mut self,
+        caller: &str,
+        source: &str,
+        arguments: &serde_json::Value,
+        attachments: Vec<std::path::PathBuf>,
+    ) -> Result<serde_json::Value, String> {
+        let object = arguments
+            .as_object()
+            .filter(|object| {
+                object.keys().all(|key| {
+                    matches!(
+                        key.as_str(),
+                        "revision" | "edit" | "cursor" | "selection" | "detach"
+                    )
+                })
+            })
+            .ok_or("composer_write_arguments_invalid")?;
+        let revision = object
+            .get("revision")
+            .and_then(serde_json::Value::as_u64)
+            .ok_or("composer_revision_required")?;
+        let composer = self.bottom_pane.composer_mut();
+        if revision != composer.mod_draft_sync() {
+            return Err("stale_revision".into());
+        }
+        let index = |value: &serde_json::Value| value.as_u64().map(|at| at as usize);
+        let selection = match object.get("selection") {
+            None | Some(serde_json::Value::Null) => None,
+            Some(range) => Some(
+                index(&range["start"])
+                    .zip(index(&range["end"]))
+                    .map(|(start, end)| start..end)
+                    .ok_or("composer_selection_invalid")?,
+            ),
+        };
+        let cursor = object
+            .get("cursor")
+            .map(|at| index(at).ok_or("composer_cursor_invalid"))
+            .transpose()?;
+        let edit = if let Some(edit) = object.get("edit") {
+            if edit["text"].as_str().is_none_or(|text| text.len() > 65_536) {
+                return Err("composer_edit_invalid".into());
+            }
+            crate::mod_runtime::composer_edit("mod", caller, revision, edit.clone())?
+        } else {
+            serde_json::json!({"kind": "insert", "text": ""})
+        };
+        let detach = match object.get("detach") {
+            None => Vec::new(),
+            Some(value) => value
+                .as_array()
+                .ok_or("composer_detach_invalid")?
+                .iter()
+                .map(|value| value.as_str().ok_or("composer_detach_invalid"))
+                .collect::<Result<Vec<_>, _>>()?,
+        };
+        let current = self
+            .bottom_pane
+            .composer_mut()
+            .mod_edit_detach(caller, revision, &edit, cursor, selection, &detach)?;
+        for path in attachments {
+            self.bottom_pane
+                .composer_mut()
+                .mod_draft_owned(path.clone(), caller, source);
+            self.attach_image(path);
+        }
+        let composer = self.bottom_pane.composer_mut();
+        composer.mod_draft_origin(caller);
+        let revision = composer.mod_draft_sync().max(current);
+        self.request_redraw();
+        Ok(serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor(), "revision": revision}))
+    }
+
+    pub(crate) fn mod_composer_suggest(
+        &mut self,
+        caller: &str,
+        source: &str,
+        arguments: &serde_json::Value,
+    ) -> Result<serde_json::Value, String> {
+        let composer = self.bottom_pane.composer_mut();
+        if arguments.get("clear") == Some(&serde_json::Value::Bool(true)) {
+            if composer
+                .mod_suggestion_owner()
+                .is_some_and(|(owner, _)| owner == caller)
+            {
+                composer.mod_suggestion_clear("owner");
+            }
+            self.request_redraw();
+            return Ok(serde_json::json!({"cleared": true}));
+        }
+        let (Some(revision), Some(id), Some(text)) = (
+            arguments["revision"].as_u64(),
+            arguments["id"].as_str(),
+            arguments["text"].as_str(),
+        ) else {
+            return Err("composer_suggest_arguments_invalid".into());
+        };
+        if id.is_empty() || id.len() > 128 || text.is_empty() || text.len() > 4096 {
+            return Err("composer_suggest_arguments_invalid".into());
+        }
+        if self.bottom_pane.has_active_view() {
+            return Err("composer_unavailable: a dialog is open".into());
+        }
+        self.bottom_pane.composer_mut().mod_suggest(
+            caller,
+            source,
+            revision,
+            id.to_owned(),
+            text.to_owned(),
+        )?;
+        self.request_redraw();
+        Ok(serde_json::json!({"shown": true}))
+    }
+
+    pub(crate) fn mod_draft_tick(&mut self) {
+        if !crate::omd::terminal_active() {
+            return;
+        }
+        if self.bottom_pane.has_active_view() {
+            self.bottom_pane
+                .composer_mut()
+                .mod_suggestion_clear("dialog");
+        }
+        let composer = self.bottom_pane.composer_mut();
+        composer.mod_draft_sync();
+        if composer.mod_draft_holds_mods() {
+            let status = crate::omd::mod_status();
+            composer.mod_draft_revoke(|owner, source| {
+                status.as_ref().is_some_and(|status| {
+                    status["mods"].as_array().into_iter().flatten().any(|item| {
+                        item["id"] == owner && (source.is_empty() || item["sha256"] == source)
+                    })
+                })
+            });
+        }
+        let mut due = Vec::new();
+        for (owner, payload) in self.bottom_pane.composer_mut().mod_draft_take_events() {
+            match owner {
+                Some(owner) => due.push((Some(owner), payload)),
+                None => self.mod_draft_change = Some((payload, std::time::Instant::now())),
+            }
+        }
+        if let Some((payload, at)) = self.mod_draft_change.take() {
+            let delay = std::time::Duration::from_millis(250);
+            if at.elapsed() >= delay {
+                due.push((None, payload));
+            } else {
+                self.frame_requester
+                    .schedule_frame_in(delay.saturating_sub(at.elapsed()));
+                self.mod_draft_change = Some((payload, at));
+            }
+        }
+        // Handlers may call terminal operations, which this thread serves, so deliver elsewhere.
+        if !due.is_empty() {
+            std::thread::spawn(move || {
+                for (owner, payload) in due {
+                    match owner {
+                        Some(owner) => {
+                            let _ = crate::mod_runtime::invoke_event(&owner, "composer", payload);
+                        }
+                        None => crate::mod_runtime::broadcast_event("composer", payload),
+                    }
+                }
+            });
+        }
+    }
+
+    pub(super) fn command_intercepted(command: crate::slash_command::SlashCommand) -> bool {
+        !codex_omd::PROTECTED_COMMANDS.contains(&command.command())
+            && crate::mod_runtime::intercepts("command")
+    }
+
+    pub(crate) fn intercept_builtin(
+        &mut self,
+        command: crate::slash_command::SlashCommand,
+        args: String,
+        text_elements: Vec<TextElement>,
+    ) -> bool {
+        if !Self::command_intercepted(command) {
+            return false;
+        }
+        let prepared = if command.supports_inline_args()
+            && !args.trim().is_empty()
+            && command != crate::slash_command::SlashCommand::Goal
+        {
+            self.prepare_live_inline_args(args, text_elements)
+        } else {
+            Some((args, text_elements))
+        };
+        if let Some((args, text_elements)) = prepared {
+            self.intercept_command(
+                command,
+                PreparedSlashCommandArgs::new(
+                    args,
+                    text_elements,
+                    SlashCommandDispatchSource::Live,
+                ),
+            );
+        }
+        self.bottom_pane.record_pending_slash_command_history();
+        true
+    }
+
+    /// Dispatches what the `command` interceptor chain lets through, never superseding the running command.
+    pub(super) fn intercept_command(
+        &mut self,
+        command: crate::slash_command::SlashCommand,
+        prepared: PreparedSlashCommandArgs,
+    ) {
+        let tx = self.app_event_tx.clone();
+        let token = self.mod_invocation(crate::mod_runtime::join);
+        let running = self.turn_lifecycle.agent_turn_running;
+        std::thread::spawn(move || {
+            let dispatch = tx.clone();
+            let result = crate::mod_runtime::run_command(
+                command.command(),
+                &prepared.args,
+                None,
+                command.available_during_task(),
+                running,
+                "user",
+                &token,
+                |effective| {
+                    let mut prepared = prepared.clone();
+                    if effective != prepared.args {
+                        prepared.args = effective;
+                        prepared.text_elements = Vec::new();
+                    }
+                    dispatch.send(AppEvent::OmdDispatchCommand(Box::new(InterceptedCommand {
+                        command,
+                        prepared,
+                        token: token.clone(),
+                        surface: None,
+                    })));
+                    Ok(serde_json::json!({"invoked": true}))
+                },
+            );
+            if let Err(error) = result {
+                tx.send(AppEvent::ModCommandFinished {
+                    invocation: command.command().to_owned(),
+                    token,
+                    result: Err(error),
+                    quiet: false,
+                });
+            }
+        });
+    }
+
+    pub(crate) fn mod_invoke_command(&mut self, call: codex_omd::client_surface::SurfaceCall) {
+        use crate::slash_command::SlashCommand;
+        use std::sync::atomic::Ordering;
+        let name = call.arguments["command"]
+            .as_str()
+            .unwrap_or_default()
+            .trim_start_matches('/')
+            .to_owned();
+        let args = call.arguments["args"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        let rows = self.mod_command_rows();
+        let Some(row) = rows.iter().find(|row| row["command"] == name.as_str()) else {
+            let _ = call.reply.send(Err(format!("command_unknown: {name}")));
+            return;
+        };
+        let target = crate::mod_runtime::find(&name);
+        let builtin = <SlashCommand as std::str::FromStr>::from_str(&name).ok();
+        if builtin.is_some_and(|command| {
+            matches!(
+                command,
+                SlashCommand::Permissions
+                    | SlashCommand::ElevateSandbox
+                    | SlashCommand::Logout
+                    | SlashCommand::Quit
+                    | SlashCommand::Exit
+                    | SlashCommand::TestApproval
+                    | SlashCommand::Feedback
+            )
+        }) || target.is_none() && builtin.is_none()
+        {
+            let _ = call
+                .reply
+                .send(Err(format!("command_invoke_refused: {name}")));
+            return;
+        }
+        if call.depth >= 4 {
+            let _ = call.reply.send(Err(
+                "command_recursion_limit: at most 4 nested commands".into()
+            ));
+            return;
+        }
+        let immediate = row["immediate"] != false;
+        let running = self.turn_lifecycle.agent_turn_running;
+        let token = self.mod_invocation(crate::mod_runtime::join);
+        let tx = self.app_event_tx.clone();
+        std::thread::spawn(move || {
+            if let Err(error) = crate::mod_surface::validate_call(&call) {
+                let _ = call.reply.send(Err(error));
+                return;
+            }
+            let _nested = codex_omd::client_surface::nest(call.depth + 1);
+            let dispatch = tx.clone();
+            let queued = std::sync::atomic::AtomicBool::new(false);
+            let result = crate::mod_runtime::run_command(
+                &name,
+                &args,
+                target.as_ref().map(|command| &command.target),
+                immediate,
+                running,
+                &call.caller,
+                &token,
+                |args| match builtin.filter(|_| crate::mod_surface::validate_call(&call).is_ok()) {
+                    Some(command) => {
+                        queued.store(true, Ordering::Release);
+                        dispatch.send(AppEvent::OmdDispatchCommand(Box::new(InterceptedCommand {
+                            command,
+                            prepared: PreparedSlashCommandArgs::new(
+                                args,
+                                Vec::new(),
+                                SlashCommandDispatchSource::Queued,
+                            ),
+                            token: token.clone(),
+                            surface: Some(call.clone()),
+                        })));
+                        Ok(serde_json::json!({"invoked": true}))
+                    }
+                    None => Err(format!("command_invoke_refused: {name}")),
+                },
+            );
+            match result {
+                Ok(result) => {
+                    if target.is_some() || !queued.load(Ordering::Acquire) {
+                        let _ = call.reply.send(Ok(
+                            serde_json::json!({"command": name, "result": result.value}),
+                        ));
+                    }
+                    if target.is_some() {
+                        tx.send(AppEvent::ModCommandFinished {
+                            invocation: name,
+                            token,
+                            result: Ok(result),
+                            quiet: true,
+                        });
+                    }
+                }
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+        });
+    }
+
+    pub(crate) fn add_mod_activity(&mut self, activity: codex_omd::ModActivity) {
+        let line = match activity.status.as_str() {
+            "completed" => format!("• Ran {} ({})", activity.label, activity.tool),
+            status => format!("• {} {status} ({})", activity.label, activity.tool),
+        };
+        let row = format!("mod:{}:{}", activity.mod_id, activity.sequence);
+        let props = serde_json::json!({"call_id": row, "kind": "dynamic", "tool": activity.tool,
+            "arguments": null, "status": if activity.status == "completed" { "completed" } else { "failed" },
+            "duration_ms": null, "output_lines": null});
+        self.add_to_history(history_cell::ToolCallCell::new(
+            PlainHistoryCell::new(vec![Line::from(line).dim()]),
+            row,
+            props,
+        ));
+        self.request_redraw();
+    }
+
+    pub(crate) fn apply_mod_placeholder(&mut self, placeholder: Option<String>) {
+        self.normal_placeholder_text = placeholder.unwrap_or_else(|| {
+            if crate::omd::is_active() {
+                "Ask Oh My Diff to do anything".to_string()
+            } else {
+                super::PLACEHOLDER.to_string()
+            }
+        });
+        if !self.active_side_conversation && !self.blocks_direct_input {
+            self.bottom_pane
+                .set_placeholder_text(self.normal_placeholder_text.clone());
+        }
+    }
+
+    pub(crate) fn mod_prompt_blocked(&self, steer: bool) -> Option<&'static str> {
+        if !self.is_session_configured() {
+            return Some("session_starting");
+        }
+        if self.queued_input_held() {
+            return Some("input_held");
+        }
+        match steer {
+            false if self.is_user_turn_pending_or_running() => Some("busy"),
+            true if !self.turn_lifecycle.agent_turn_running => Some("no_active_turn"),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn mod_submit_prompt(
+        &mut self,
+        text: String,
+        images: Vec<std::path::PathBuf>,
+        client_id: String,
+        steer: bool,
+    ) -> Result<&'static str, String> {
+        if let Some(reason) = self.mod_prompt_blocked(steer) {
+            return Err(reason.into());
+        }
+        let mut user_message = UserMessage::from(text);
+        user_message.local_images = images
+            .into_iter()
+            .enumerate()
+            .map(|(index, path)| crate::bottom_pane::LocalImageAttachment {
+                placeholder: format!("[Image #{}]", index + 1),
+                path,
+            })
+            .collect();
+        self.mod_client_id = Some(client_id);
+        let (accepted, _) = self.submit_user_message_with_history_and_shell_escape_policy(
+            user_message,
+            UserMessageHistoryRecord::UserMessageText,
+            ShellEscapePolicy::Disallow,
+            UserMessageSource::Prompt,
+        );
+        self.mod_client_id = None;
+        match (accepted, steer) {
+            (false, _) => Err("refused".into()),
+            (true, true) => Ok("steered"),
+            (true, false) => Ok("started"),
+        }
+    }
+
+    pub(crate) fn submit_mod_text(&mut self, text: String) {
+        let user_message = UserMessage::from(text);
+        if self.is_session_configured() && !self.turn_lifecycle.agent_turn_running {
+            let _ = self.submit_user_message_with_shell_escape_policy(
+                user_message,
+                ShellEscapePolicy::Disallow,
+            );
+        } else {
+            self.queue_user_message(user_message);
+        }
+    }
+}
