+fn plugin_cache_skill_equivalent(left: &PathUri, right: &PathUri) -> bool {
+    let (Ok(left), Ok(right)) = (left.to_abs_path(), right.to_abs_path()) else {
+        return false;
+    };
+    let left = left.as_path().components().collect::<Vec<_>>();
+    let right = right.as_path().components().collect::<Vec<_>>();
+    let Some(index) = left
+        .windows(2)
+        .position(|pair| pair[0].as_os_str() == "plugins" && pair[1].as_os_str() == "cache")
+    else {
+        return false;
+    };
+    let version = index + 4;
+    left.len() == right.len()
+        && left.len() > version + 1
+        && left[version + 1].as_os_str() == "skills"
+        && left[..version] == right[..version]
+        && left[version + 1..] == right[version + 1..]
+}
