+fn locale_supports_unicode() -> bool {
+    ["LC_ALL", "LC_CTYPE", "LANG"]
+        .into_iter()
+        .filter_map(|name| std::env::var(name).ok())
+        .find(|value| !value.is_empty())
+        .is_none_or(|value| {
+            let normalized = value.to_ascii_lowercase();
+            normalized.contains("utf-8") || normalized.contains("utf8")
+        })
+}
+
+pub(crate) fn visual_input(text: &str) -> Cow<'_, str> {
+    let glyphs = crate::mod_ui::glyphs();
+    mod_glyphs(text, &glyphs)
+}
+
+fn mod_glyphs<'a>(
+    text: &'a str,
+    glyphs: &std::collections::BTreeMap<String, String>,
+) -> Cow<'a, str> {
+    if !glyphs.keys().any(|source| text.contains(source.as_str())) {
+        return Cow::Borrowed(text);
+    }
+    let mut ordered = glyphs.iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(source, _)| std::cmp::Reverse(source.len()));
+    let mut rendered = String::with_capacity(text.len());
+    let mut remaining = text;
+    'outer: while !remaining.is_empty() {
+        for (source, display) in &ordered {
+            if let Some(rest) = remaining.strip_prefix(source.as_str()) {
+                rendered.push_str(display);
+                remaining = rest;
+                continue 'outer;
+            }
+        }
+        if let Some(character) = remaining.chars().next() {
+            rendered.push(character);
+            remaining = &remaining[character.len_utf8()..];
+        }
+    }
+    Cow::Owned(rendered)
+}
+
+fn latest_session(root: &Path) -> Option<PathBuf> {
+    std::fs::read_dir(root.join("sessions"))
+        .ok()?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path)
+}
+
+fn snapshot_with_status(status: &Value, accounting: bool) -> Result<Snapshot, String> {
+    let paths = mod_paths().ok_or_else(|| "Oh My Diff mod host is not active".to_string())?;
+    let count = |key: &str| status[key].as_array().map_or(0, Vec::len);
+    let (active_mods, failed_mods) = codex_omd::mod_counts(status);
+    let mut snapshot = Snapshot {
+        active_mods,
+        failed_mods,
+        rejected_selections: count("rejected"),
+        contract: "none".to_string(),
+        ..Snapshot::default()
+    };
+    let Some(session) = latest_session(&paths.evidence) else {
+        return Ok(snapshot);
+    };
+    let read = |name: &str, limit: usize| {
+        bounded_read(&session.join(name), limit)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+            .unwrap_or(Value::Null)
+    };
+    if accounting {
+        let cost = read("task-cost.json", 8_388_608);
+        let number = |key: &str| cost[key].as_u64().unwrap_or_default();
+        snapshot.observed_requests = cost["observed"].as_array().map_or(0, Vec::len);
+        snapshot.raw_usage_attempts = number("raw_usage_attempts");
+        snapshot.settled_task_charge_microusd = number("settled_task_charge_microusd");
+        snapshot.retained_exposure_upper_bound_microusd =
+            number("retained_exposure_upper_bound_microusd");
+    }
+    let contract = read("contract.json", 262_144);
+    snapshot.contract = match (contract["status"].as_str(), contract["active"].as_object()) {
+        (Some("active"), Some(active)) => format!(
+            "{}@{} ({})",
+            active
+                .get("id")
+                .and_then(Value::as_str)
+                .unwrap_or("unknown"),
+            active
+                .get("version")
+                .and_then(Value::as_u64)
+                .unwrap_or_default(),
+            active
+                .get("assurance")
+                .and_then(Value::as_str)
+                .unwrap_or("unlabelled")
+        ),
+        (Some(status), _) => status.to_string(),
+        _ => "none".to_string(),
+    };
+    snapshot.evidence = Some(session);
+    Ok(snapshot)
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, String> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if metadata.file_type().is_symlink() || metadata.len() > limit as u64 {
+        return Err(format!(
+            "unsafe or oversized Oh My Diff file: {}",
+            path.display()
+        ));
+    }
+    std::fs::read(path).map_err(|error| error.to_string())
+}
+
+pub(crate) fn compact_status() -> Option<String> {
+    Some(match effective_mode() {
+        Ok(codex_omd::RuntimeMode::UpstreamDirect) => return None,
+        Ok(_) => {
+            let status = mod_status();
+            match snapshot_with_status(status.as_deref().unwrap_or(&Value::Null), false) {
+                _ if status
+                    .as_ref()
+                    .is_some_and(|status| status["activation_error"].is_string()) =>
+                {
+                    "Oh My Diff · mods inactive · see /omd".to_string()
+                }
+                Err(_) if store_root().is_some() => {
+                    "Oh My Diff · mods off in this directory · see /omd".to_string()
+                }
+                Ok(snapshot) if status.is_some() => format!(
+                    "Oh My Diff · {} mod{} on{}{}",
+                    snapshot.active_mods,
+                    if snapshot.active_mods == 1 { "" } else { "s" },
+                    if snapshot.failed_mods == 0 {
+                        String::new()
+                    } else {
+                        format!(" · {} failed", snapshot.failed_mods)
+                    },
+                    if snapshot.contract == "none" {
+                        String::new()
+                    } else {
+                        format!(" · contract {}", snapshot.contract)
+                    }
+                ),
+                _ => "Oh My Diff · mod status unavailable".to_string(),
+            }
+        }
+        Err(error) => format!("Oh My Diff · invalid mode · {error}"),
+    })
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use serial_test::serial;
+    use tempfile::TempDir;
+
+    pub(crate) struct EnvGuard {
+        name: &'static str,
+        original: Option<std::ffi::OsString>,
+    }
+
+    impl EnvGuard {
+        pub(crate) fn set(name: &'static str, value: Option<&str>) -> Self {
+            let original = std::env::var_os(name);
+            match value {
+                Some(value) => unsafe { std::env::set_var(name, value) },
+                None => unsafe { std::env::remove_var(name) },
+            }
+            Self { name, original }
+        }
+    }
+
+    impl Drop for EnvGuard {
+        fn drop(&mut self) {
+            match &self.original {
+                Some(value) => unsafe { std::env::set_var(self.name, value) },
+                None => unsafe { std::env::remove_var(self.name) },
+            }
+        }
+    }
+
+    fn store_fixture(root: &TempDir) -> PathBuf {
+        let store = root.path().canonicalize().unwrap();
+        std::fs::write(
+            store.join("mod-status.json"),
+            serde_json::json!({"mods":[{"id":"fixture"}],"rejected":[]}).to_string(),
+        )
+        .unwrap();
+        let session = store.join("sessions").join("thread-1");
+        std::fs::create_dir_all(&session).unwrap();
+        std::fs::write(
+            session.join("task-cost.json"),
+            serde_json::json!({"settled_task_charge_microusd":7,
+                "retained_exposure_upper_bound_microusd":10,"raw_usage_attempts":2,
+                "observed":[{"model":"a"},{"model":"b"},{"model":"c"}]})
+            .to_string(),
+        )
+        .unwrap();
+        std::fs::write(
+            session.join("contract.json"),
+            serde_json::json!({"status":"active","active":{"id":"reviewed","version":1,
+                "assurance":"separately_reviewed"}})
+            .to_string(),
+        )
+        .unwrap();
+        store
+    }
+
+    pub(crate) fn omd_environment(store: &Path) -> (EnvGuard, EnvGuard) {
+        crate::mod_runtime::synchronize_context(crate::mod_runtime::ModContext {
+            thread_id: None,
+            repository: store.to_path_buf(),
+            policy: codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted(),
+        });
+        (
+            EnvGuard::set(MODE_ENV, Some("omd")),
+            EnvGuard::set(codex_omd::MOD_STORE_ENV, store.to_str()),
+        )
+    }
+
+    #[cfg(unix)]
+    #[test]
+    #[serial]
+    fn mod_snapshot_reloads_same_length_replacements_and_status_errors() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _environment = omd_environment(&store);
+        let view = store.join("mod-view.json");
+        std::fs::write(&view, br#"{"revision":1}"#).unwrap();
+        assert_eq!(mod_snapshot().1.revision, 1);
+        let modified = std::fs::metadata(&view).unwrap().modified().unwrap();
+        let replacement = store.join("replacement.json");
+        std::fs::write(&replacement, br#"{"revision":2}"#).unwrap();
+        std::fs::File::open(&replacement)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        std::fs::rename(&replacement, &view).unwrap();
+        assert_eq!(mod_snapshot().1.revision, 2);
+        // An in-place rewrite of the same length with the old mtime keeps the inode too.
+        std::fs::write(&view, br#"{"revision":3}"#).unwrap();
+        std::fs::File::options()
+            .write(true)
+            .open(&view)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        assert_eq!(mod_snapshot().1.revision, 3);
+        std::fs::write(
+            &replacement,
+            br#"{"mods":[{"id":"fixture","error":"failed"}]}"#,
+        )
+        .unwrap();
+        std::fs::rename(&replacement, store.join("mod-status.json")).unwrap();
+        assert_eq!(mod_snapshot().1.view.panels[0].lines, ["fixture: failed"]);
+    }
+
+    #[test]
+    #[serial]
+    fn builtin_controls_hide_commands_and_disable_modes_but_never_recovery() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let launch = std::env::current_dir().unwrap();
+        std::fs::write(
+            store.join(codex_omd::builtins_snapshot(&launch)),
+            serde_json::json!({"schema":1,"hidden_commands":{"plan":["fixture"]},
+                "disabled_modes":{"plan":["fixture"]},
+                "disabled_surfaces":{"status_line":["fixture"]},
+                "replaced_commands":{"review":["fixture","review"]}})
+            .to_string(),
+        )
+        .unwrap();
+        let _omd = omd_environment(&store);
+        assert!(
+            builtins().command_hidden("plan"),
+            "a thread in another checkout reads the launch directory's built-ins, as the host writes them"
+        );
+        assert!(!builtins().command_hidden("omd"));
+        assert!(!builtins().command_hidden("model"));
+        assert!(mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+        assert!(!mode_disabled(
+            codex_protocol::config_types::ModeKind::Default
+        ));
+        assert!(command_replacement(&builtins(), "review").is_some());
+        assert!(
+            crate::bottom_pane::slash_commands::commands_for_input(Default::default(), &[])
+                .iter()
+                .any(|command| matches!(
+                    command,
+                    crate::bottom_pane::slash_commands::SlashCommandItem::Mod(item)
+                        if item.invocation == "review"
+                ))
+        );
+        assert!(status_line_disabled());
+        assert_eq!(
+            codex_omd::BuiltinSnapshot::read(&store, &store.join("sessions")),
+            codex_omd::BuiltinSnapshot::default(),
+            "sessions in another repository keep their built-ins"
+        );
+        {
+            let _home = EnvGuard::set("HOME", launch.to_str());
+            assert!(!status_line_disabled());
+            assert!(!builtins().command_hidden("plan"));
+            assert!(!mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+            assert!(command_replacement(&builtins(), "review").is_none());
+        }
+        assert!(builtins().command_hidden("plan"));
+        let _direct = EnvGuard::set(MODE_ENV, Some("upstream_direct"));
+        assert!(!builtins().command_hidden("plan"));
+        assert!(!mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+    }
+
+    #[test]
+    #[serial]
+    fn mods_stay_off_in_the_home_directory_with_a_notice() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _omd = omd_environment(&store);
+        assert!(mod_paths().is_some());
+        let _home = EnvGuard::set("HOME", store.to_str());
+        assert!(mod_paths().is_none());
+        assert!(!terminal_active());
+        assert!(mod_status().is_some());
+        assert_eq!(
+            compact_status().as_deref(),
+            Some("Oh My Diff · mods off in this directory · see /omd")
+        );
+    }
+}
