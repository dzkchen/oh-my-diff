+                        "cancel" => active.set(false),
+                        _ => unreachable!(),
+                    }
+                    Ok(Value::Null)
+                },
+            );
+            assert!(result.is_err(), "{lane} {change}");
+            assert_eq!(std::fs::read(&state).ok(), before, "{lane} {change}");
