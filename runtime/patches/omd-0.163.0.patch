+#[test]
+#[serial_test::serial]
+fn composer_key_waits_for_a_busy_runtime_only_within_the_keystroke_budget() {
+    struct Restore(Option<Arc<Mutex<ModHost>>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            *HOST.lock().unwrap() = self.0.take();
+        }
+    }
+    let _restore = Restore(HOST.lock().unwrap().take());
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let store_path = root.join("store");
+    let store = codex_omd::ModStore::create(
+        store_path.clone(),
+        std::env::var_os("OMD_TEST_NODE").unwrap().into(),
+    )
+    .unwrap();
+    let package = root.join("guard");
+    std::fs::create_dir(&package).unwrap();
+    std::fs::write(
+        package.join("mod.json"),
+        serde_json::json!({"schema": 1, "id": "guard", "version": "1.0.0",
+            "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": ["composer"]})
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        package.join("index.ts"),
+        "export default api => api.intercept('composer_key', {match: {key: 'q'}}, () => ({deny: 'no'}));",
+    )
+    .unwrap();
+    let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+    store
+        .trust(
+            package.clone(),
+            inspected["sha256"].as_str().unwrap(),
+            vec!["composer".into()],
+            "user",
+        )
+        .unwrap();
+    let _environment = crate::omd::tests::omd_environment(&store_path);
+    store.enable(&package, true).unwrap();
+    let runtime = shared_host().unwrap();
+    runtime.lock().unwrap().reload().unwrap();
+    let press = || {
+        composer_key(
+            "q",
+            || serde_json::json!({"key": "q", "text": "q", "revision": 0, "cursor": 0}),
+        )
+    };
+    let hold = |held: std::time::Duration| {
+        let runtime = runtime.clone();
+        let (locked, wait) = std::sync::mpsc::channel();
+        let holder = std::thread::spawn(move || {
+            let _held = runtime.lock().unwrap();
+            locked.send(()).unwrap();
+            std::thread::sleep(held);
+        });
+        wait.recv().unwrap();
+        holder
+    };
+    let _ = press();
+    let holder = hold(std::time::Duration::from_millis(5));
+    assert_eq!(press(), Ok(None));
+    holder.join().unwrap();
+    let holder = hold(std::time::Duration::from_millis(400));
+    let started = Instant::now();
+    assert!(press().unwrap_err().starts_with("mod_runtime_busy"));
+    assert!(started.elapsed() < std::time::Duration::from_millis(200));
+    holder.join().unwrap();
+}
