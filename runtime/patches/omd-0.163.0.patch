+        input: codex_extension_api::ApprovalGateInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ApprovalGate> {
+        self.0.lock().unwrap().push((
+            input.kind.to_owned(),
+            input.host_decision.to_owned(),
+            "gate".to_owned(),
+        ));
+        Box::pin(std::future::ready(ApprovalGate::Deny("mod: no MCP".into())))
+    }
+
+    fn on_approval_result<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalResultInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        self.0.lock().unwrap().push((
+            input.kind.to_owned(),
+            input.decision.to_owned(),
+            input.source.to_owned(),
+        ));
+        Box::pin(std::future::ready(()))
+    }
