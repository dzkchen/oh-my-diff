+/// `end` is `(outcome, by, provider_call)`; `None` announces the start.
+pub(crate) async fn notify_compaction_lifecycle(
+    sess: &Session,
+    turn_context: &TurnContext,
+    trigger: CompactionTrigger,
+    end: Option<(&str, Option<&str>, bool)>,
+) {
+    for contributor in sess.services.extensions.turn_lifecycle_contributors() {
+        let input = codex_extension_api::CompactionLifecycleInput {
+            turn_id: turn_context.sub_id.as_str(),
+            trigger: compaction_trigger_label(trigger),
+            outcome: end.map(|end| end.0),
+            by: end.and_then(|end| end.1),
+            provider_call: end.is_some_and(|end| end.2),
+            session_store: &sess.services.session_extension_data,
+            thread_store: &sess.services.thread_extension_data,
+            turn_store: turn_context.extension_data.as_ref(),
+        };
+        if end.is_none() {
+            contributor.on_compaction_start(input).await;
+        } else {
+            contributor.on_compaction_end(input).await;
+        }
+    }
+}
