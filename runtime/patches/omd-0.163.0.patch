+async fn listening_ports(roots: Vec<u32>) -> Result<Value, String> {
+    if roots.is_empty() {
+        return Ok(json!({"ports": []}));
+    }
+    let run = |program: &'static str, args: Vec<String>| async move {
+        tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            tokio::process::Command::new(program)
+                .args(args)
+                .kill_on_drop(true)
+                .output(),
+        )
+        .await
+        .map_err(|_| format!("session_ports_timeout: {program}"))?
+        .map_err(|error| format!("session_ports_unavailable: {program}: {error}"))
+    };
+    let table = run("/bin/ps", vec!["-axo".into(), "pid=,ppid=".into()]).await?;
+    let pids = descendants(&String::from_utf8_lossy(&table.stdout), &roots);
+    let lsof = ["/usr/sbin/lsof", "/usr/bin/lsof"]
+        .into_iter()
+        .find(|path| std::path::Path::new(path).exists())
+        .ok_or("session_ports_unavailable: lsof")?;
+    let pids = pids
+        .iter()
+        .map(u32::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    let output = run(
+        lsof,
+        [
+            "-nP",
+            "-w",
+            "-a",
+            "-iTCP",
+            "-sTCP:LISTEN",
+            "-Fpn",
+            "-p",
+            &pids,
+        ]
+        .map(str::to_owned)
+        .to_vec(),
+    )
+    .await?;
+    Ok(json!({"ports": parse_listeners(&String::from_utf8_lossy(&output.stdout))}))
+}
+
+fn descendants(table: &str, roots: &[u32]) -> Vec<u32> {
+    let pairs = table
+        .lines()
+        .filter_map(|line| {
+            let mut fields = line.split_whitespace().map(str::parse::<u32>);
+            Some((fields.next()?.ok()?, fields.next()?.ok()?))
+        })
+        .collect::<Vec<_>>();
+    let mut found = roots.to_vec();
+    let mut index = 0;
+    while index < found.len() && found.len() < 256 {
+        let parent = found[index];
+        let children = pairs
+            .iter()
+            .filter(|(pid, ppid)| *ppid == parent && !found.contains(pid))
+            .map(|(pid, _)| *pid)
+            .collect::<Vec<_>>();
+        found.extend(children);
+        index += 1;
+    }
+    found.truncate(256);
+    found
+}
+
+fn parse_listeners(output: &str) -> Vec<Value> {
+    let mut pid = 0;
+    let mut ports = std::collections::BTreeMap::new();
+    for line in output.lines() {
+        if let Some(value) = line.strip_prefix('p') {
+            pid = value.parse().unwrap_or(0);
+        } else if let Some(address) = line.strip_prefix('n')
+            && let Some(port) = address
+                .rsplit(':')
+                .next()
+                .and_then(|port| port.parse::<u16>().ok())
+        {
+            ports
+                .entry(port)
+                .or_insert_with(|| json!({"port": port, "pid": pid, "address": address}));
+        }
+    }
+    ports.into_values().take(32).collect()
+}
