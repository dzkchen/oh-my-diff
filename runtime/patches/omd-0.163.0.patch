+                .any(|id| interceptor.after.contains(id))
+            || !ordered.into_iter().all(|id| identifier(id))
+            || interceptor.location.len() > 256
+        {
+            return Err(failure("invalid_interceptor_registration"));
+        }
+    }
+    Ok(())
