+pub(crate) fn is_active() -> bool {
+    effective_mode().is_ok_and(codex_omd::RuntimeMode::mod_host_enabled)
+}
+
+/// Every frame asks for this, so the parsed view is reused until `mod-view.json` or `mod-status.json` changes.
+pub(crate) fn mod_snapshot() -> (bool, codex_omd::ModViewSnapshot) {
+    type Cached = (PathBuf, [Option<FileStamp>; 2], codex_omd::ModViewSnapshot);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let Some(root) = store_root() else {
+        return (false, codex_omd::ModViewSnapshot::default());
+    };
+    let (view, status) = (root.join("mod-view.json"), root.join("mod-status.json"));
+    let stamps = [file_stamp(&view), file_stamp(&status)];
+    let mut cache = CACHE.locked();
+    if let Some((cached_root, cached, snapshot)) = cache.as_ref()
+        && *cached_root == root
+        && *cached == stamps
+    {
+        return (true, snapshot.clone());
+    }
+    let snapshot = read_mod_snapshot(&view);
+    *cache = Some((root, stamps, snapshot.clone()));
+    (true, snapshot)
+}
+
+/// The parsed `mod-view.json` at `path`, re-read only when its stamp changes.
+pub(crate) fn view_snapshot(path: &Path) -> Option<codex_omd::ModViewSnapshot> {
+    type Cached = (PathBuf, FileStamp, codex_omd::ModViewSnapshot);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let stamp = file_stamp(path);
+    let mut cache = CACHE.locked();
+    if let (Some(stamp), Some((cached_path, cached, snapshot))) = (stamp, cache.as_ref())
+        && cached_path == path
+        && *cached == stamp
+    {
+        return Some(snapshot.clone());
+    }
+    let snapshot = codex_omd::ModViewSnapshot::read(path).ok();
+    *cache = stamp
+        .zip(snapshot.clone())
+        .map(|(stamp, snapshot)| (path.to_owned(), stamp, snapshot));
+    snapshot
+}
+
+/// The host's identity stamp (device, inode, length, mtime and ctime in ns): a same-length rewrite
+/// still changes the ctime the writer cannot set.
+pub(crate) fn file_stamp(path: &Path) -> Option<FileStamp> {
+    std::fs::symlink_metadata(path)
+        .ok()
+        .map(|metadata| codex_omd::file_stamp(&metadata))
+}
+
+fn read_mod_snapshot(view: &Path) -> codex_omd::ModViewSnapshot {
+    let mut snapshot = view_snapshot(view).unwrap_or_default();
+    if let Some(status) = mod_status() {
+        let errors = status["mods"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|item| {
+                item["error"].as_str().map(|error| {
+                    format!("{}: {error}", item["id"].as_str().unwrap_or("mod"))
+                        .chars()
+                        .filter(|character| !character.is_control())
+                        .take(180)
+                        .collect::<String>()
+                })
+            })
+            .take(16)
+            .collect::<Vec<_>>();
+        if !errors.is_empty()
+            && !snapshot
+                .view
+                .panels
+                .iter()
+                .any(|panel| panel.title == "Mod errors")
+        {
+            snapshot.view.panels.insert(
+                0,
+                codex_omd::ModPanel {
+                    title: "Mod errors".into(),
+                    lines: errors,
+                },
+            );
+        }
+    }
+    snapshot
+}
+
+pub(crate) fn mod_paths() -> Option<ModPaths> {
+    mod_paths_for(&session_repository()?)
+}
+
+pub(crate) fn mod_paths_for(repository: &Path) -> Option<ModPaths> {
+    let root = store_root()?;
+    let repository = scoped_repository(repository)?;
+    let protected = host_protected_paths(&root);
+    Some(ModPaths {
+        evidence: root.clone(),
+        repository,
+        store: Some(root),
+        protected,
+    })
+}
+
+fn session_repository() -> Option<PathBuf> {
+    crate::mod_runtime::active_repository().or_else(|| std::env::current_dir().ok())
+}
+
+type Memo<K, V> = std::sync::Mutex<std::collections::BTreeMap<K, (std::time::Instant, V)>>;
+
+/// Frames and keystrokes resolve these paths, so each input's canonical result is reused for up to 2 s.
+fn memo<K: Ord, V: Clone>(cache: &Memo<K, V>, key: K, resolve: impl FnOnce() -> V) -> V {
+    let mut cache = cache.locked();
+    if let Some((checked, value)) = cache.get(&key)
+        && checked.elapsed() < std::time::Duration::from_secs(2)
+    {
+        return value.clone();
+    }
+    if cache.len() >= 16 {
+        cache.clear();
+    }
+    let value = resolve();
+    cache.insert(key, (std::time::Instant::now(), value.clone()));
+    value
+}
+
+fn scoped_repository(repository: &Path) -> Option<PathBuf> {
+    static CACHE: Memo<(PathBuf, Option<std::ffi::OsString>), Option<PathBuf>> =
+        std::sync::Mutex::new(std::collections::BTreeMap::new());
+    let key = (repository.to_path_buf(), std::env::var_os("HOME"));
+    memo(&CACHE, key, || {
+        let repository = repository.canonicalize().ok()?;
+        (!codex_omd::app_routes::unscoped_directory(&repository)).then_some(repository)
+    })
+}
+
+pub(crate) fn store_root() -> Option<PathBuf> {
+    static CACHE: Memo<PathBuf, bool> = std::sync::Mutex::new(std::collections::BTreeMap::new());
+    if !is_active() {
+        return None;
+    }
+    let root = PathBuf::from(std::env::var_os(codex_omd::MOD_STORE_ENV)?);
+    memo(&CACHE, root.clone(), || {
+        root.is_absolute() && root.canonicalize().is_ok_and(|canonical| canonical == root)
+    })
+    .then_some(root)
+}
+
+/// The store plus `host.json` protected and secret paths, re-read only when the file changes.
+fn host_protected_paths(root: &Path) -> Vec<PathBuf> {
+    type Cached = (PathBuf, Option<FileStamp>, Vec<PathBuf>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let path = root.join(HOST_CONFIG);
+    let stamp = file_stamp(&path);
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached_root, cached_stamp, protected)) = cache.as_ref()
+        && cached_root == root
+        && *cached_stamp == stamp
+    {
+        return protected.clone();
+    }
+    let config = bounded_read(&path, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or(Value::Null);
+    let paths = |value: &Value| -> Vec<PathBuf> {
+        match value {
+            Value::Array(items) => items
+                .iter()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            Value::Object(items) => items
+                .values()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            _ => Vec::new(),
+        }
+    };
+    let mut protected = vec![root.to_path_buf()];
+    protected.extend(paths(&config["protected"]));
+    protected.extend(paths(&config["secret_refs"]));
+    *cache = Some((root.to_path_buf(), stamp, protected.clone()));
+    protected
+}
+
+pub(crate) fn mod_status() -> Option<std::sync::Arc<Value>> {
+    type Cached = (PathBuf, FileStamp, Option<std::sync::Arc<Value>>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let path = store_root()?.join("mod-status.json");
+    let Some(stamp) = file_stamp(&path) else {
+        return serde_json::from_slice(&bounded_read(&path, 262_144).ok()?)
+            .ok()
+            .map(std::sync::Arc::new);
+    };
+    let mut cache = CACHE.locked();
+    if let Some((cached_path, cached, status)) = cache.as_ref()
+        && *cached_path == path
+        && *cached == stamp
+    {
+        return status.clone();
+    }
+    let status = bounded_read(&path, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+        .map(std::sync::Arc::new);
+    let listing = |status: Option<&std::sync::Arc<Value>>| {
+        codex_omd::package_controls::listing_key(status.map(std::sync::Arc::as_ref))
+    };
+    let previous = cache
+        .as_ref()
+        .filter(|(cached_path, _, _)| *cached_path == path)
+        .and_then(|(_, _, status)| status.clone());
+    *cache = Some((path, stamp, status.clone()));
+    drop(cache);
+    if status.is_some()
+        && listing(status.as_ref()) != listing(previous.as_ref())
+        && let Some(store) = mod_paths().and_then(|paths| paths.store)
+    {
+        crate::mod_runtime::warm_listing(store);
+    }
+    status
+}
+
+pub(crate) fn builtins() -> codex_omd::BuiltinSnapshot {
+    type Cached = (
+        Option<(PathBuf, PathBuf)>,
+        std::time::Instant,
+        codex_omd::BuiltinSnapshot,
+    );
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let root = std::env::current_dir()
+        .ok()
+        .and_then(|launch| Some((store_root()?, scoped_repository(&launch)?)));
+    let mut cache = CACHE.locked();
+    if let Some((cached, loaded, snapshot)) = cache.as_ref()
+        && *cached == root
+        && loaded.elapsed() < std::time::Duration::from_secs(2)
+    {
+        return snapshot.clone();
+    }
+    let snapshot = root
+        .as_ref()
+        .map(|(store, repository)| codex_omd::BuiltinSnapshot::read(store, repository))
+        .unwrap_or_default();
+    *cache = Some((root, std::time::Instant::now(), snapshot.clone()));
+    snapshot
+}
+
+pub(crate) fn command_replacement(
+    builtins: &codex_omd::BuiltinSnapshot,
+    command: &str,
+) -> Option<crate::mod_runtime::ModSlashCommand> {
+    let (id, target) = builtins.command_replacement(command)?.clone();
+    let own = crate::mod_runtime::find(&format!("{id}:{target}"));
+    Some(crate::mod_runtime::ModSlashCommand {
+        invocation: command.to_owned(),
+        description: own.as_ref().map_or_else(
+            || format!("Replaced by {id}:{target}"),
+            |own| {
+                own.description
+                    .split(" · bare /")
+                    .next()
+                    .unwrap_or_default()
+                    .to_owned()
+            },
+        ),
+        args_hint: own.and_then(|own| own.args_hint),
+        immediate: true,
+        target: crate::mod_runtime::ModSlashTarget {
+            id,
+            command: target,
+        },
+    })
+}
