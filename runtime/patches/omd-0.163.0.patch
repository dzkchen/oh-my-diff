+        owner: owner.into(),
+        model: "fixture-model".into(),
+        provider: "fixture".into(),
+        url: "http://localhost/responses".into(),
+        max_request_bytes: 2048,
+        rates: Some(rates()),
+        repository_identity: "fixture".into(),
