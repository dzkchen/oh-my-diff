@@ -0,0 +1,767 @@
+use super::*;
+use crate::workspace_operations::WorkspaceAuthority;
+use codex_omd::data_store::Origin;
+
+#[derive(Clone, Default)]
+pub(crate) struct DataScope(pub(super) Arc<Mutex<Option<codex_omd::scoped_data::ScopedDataHosts>>>);
+
+impl DataScope {
+    async fn call(
+        &self,
+        lead: &Lead,
+        authority: WorkspaceAuthority,
+        caller: &Caller<'_>,
+        request: ModHostCall,
+        cancelled: Arc<AtomicBool>,
+    ) -> Result<Value, String> {
+        let root = lead.host.root.clone();
+        let scope = self.0.clone();
+        let thread = lead.thread.to_string();
+        let (id, source) = (caller.id.to_owned(), caller.source.to_owned());
+        tokio::task::spawn_blocking(move || {
+            let mut scope = scope.lock().map_err(|_| "data_scope_poisoned")?;
+            scope
+                .get_or_insert_with(|| {
+                    codex_omd::scoped_data::ScopedDataHosts::new(
+                        root,
+                        authority.repository.clone(),
+                        authority.session_root.clone(),
+                        authority.session_database.clone(),
+                        thread,
+                    )
+                })
+                .call(&id, &source, &request.operation, request.arguments, || {
+                    !cancelled.load(Ordering::Acquire)
+                })
+                .map_err(|error| error.to_string())
+        })
+        .await
+        .map_err(|error| error.to_string())?
+    }
+}
+
+pub(super) struct Caller<'a> {
+    pub id: &'a str,
+    pub source: &'a str,
+    pub grants: Option<ModGrants>,
+    pub generation: u64,
+    pub origin: Origin,
+    pub record_changes: bool,
+}
+
+pub(super) fn event_allows(event: &str, operation: &str) -> bool {
+    crate::generic_host::event_allows(event, operation)
+        || super::expansion::event_allows(event)
+        || event == "context"
+            && (codex_omd::scoped_data::operation(operation)
+                || matches!(
+                    operation,
+                    "store.get"
+                        | "store.list"
+                        | "routes.list"
+                        | "session.info"
+                        | "tools.list"
+                        | "task.status"
+                        | "contract.status"
+                        | "workspace.fingerprint"
+                ))
+        || matches!(event, "component_event" | "component_post" | "command")
+            && (codex_omd::host::served(operation)
+                || codex_omd::client_surface::SURFACE_OPERATIONS.contains(&operation)
+                || matches!(
+                    operation,
+                    "app.routes"
+                        | "model.complete"
+                        | "model.fork"
+                        | "session.info"
+                        | "tools.list"
+                        | "turns.activity"
+                        | "turns.abort"
+                        | "events.publish"
+                        | "credentials.list"
+                        | "packages.list"
+                        | "packages.preview"
+                ))
+}
+
+pub(super) fn route_info(host: &Host, route: &config::Route) -> Value {
+    let available = route.grant.as_ref().is_none_or(|grant| {
+        accounting::worker_authorized(
+            &grant.path,
+            &grant.sha256,
+            &host.repository_identity,
+            &route.provider,
+            &route.model,
+            &route.responses_url,
+            route.rates.included_subscription,
+        )
+    });
+    json!({"name": route.name, "model": route.model, "provider": route.provider,
+        "reasoning": route.reasoning_effort, "roles": route.roles,
+        "billing": accounting::billing(Some(&route.rates)),
+        "tools": route.tools, "available": available, "credential": route.credential})
+}
+
+async fn authority(lead: &Lead, call: Option<&ToolCall<'_>>) -> Result<WorkspaceAuthority, String> {
+    match call {
+        Some(call) => WorkspaceAuthority::for_call(lead, call).await,
+        None => WorkspaceAuthority::for_lead(lead).await,
+    }
+}
+
+pub(super) fn exclusive(session: &Session) -> Result<OperationGuard, String> {
+    acquire_workspace_operation(&session.repository_identity)
+}
+
+fn needs_exclusive_workspace(operation: &str, arguments: &Value) -> bool {
+    matches!(operation, "workspace.transaction" | "workspace.restore")
+        || operation == "exec.run"
+            && arguments.get("snapshot").is_none()
+            && (arguments.get("write") == Some(&Value::Bool(true))
+                || arguments.get("guards").is_some()
+                || arguments.get("required_access").is_some())
+}
+
+fn workspace_guard(
+    operation: &str,
+    arguments: &Value,
+    repository_identity: &str,
+) -> Result<Option<OperationGuard>, String> {
+    needs_exclusive_workspace(operation, arguments)
+        .then(|| acquire_workspace_operation(repository_identity))
+        .transpose()
+}
+
+fn notify_contract(core: &Core, lead: &Lead, payload: Value) {
+    let runtime = core.runtime.clone();
+    let thread = lead.thread.to_string();
+    tokio::task::spawn_blocking(move || {
+        let _thread = codex_omd::StateThread::enter(Some(thread));
+        if let Ok(mut runtime) = runtime.lock() {
+            let _ = runtime.event("contract", payload);
+        }
+    });
+}
+
+async fn submit_receipt(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        kind: String,
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+        outcome: codex_omd::ReceiptOutcome,
+        evidence: codex_omd::resource_data::ResourceRef,
+        #[serde(default)]
+        agent: Option<String>,
+        #[serde(default)]
+        execution: bool,
+        #[serde(default)]
+        findings: Vec<codex_omd::ReceiptFinding>,
+        #[serde(default)]
+        resolves: Vec<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    if input.execution && input.agent.is_some() {
+        return Err("receipt_producer_conflict".into());
+    }
+    let producer = match input.agent {
+        Some(handle) => {
+            core.agents
+                .attest(
+                    &handle,
+                    caller.id,
+                    caller.generation,
+                    &lead.session.task,
+                    super::agents::AgentClaim {
+                        candidate_sha256: &input.candidate_sha256,
+                        acceptance_sha256: input.acceptance_sha256.as_deref(),
+                        resolves: &input.resolves,
+                        evidence: &input.evidence,
+                    },
+                )
+                .await?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Agent,
+                handle: Some(handle),
+            }
+        }
+        None if input.execution => {
+            core.agents.attest_execution(
+                lead,
+                caller,
+                &input.candidate_sha256,
+                &input.evidence,
+                input.outcome,
+            )?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Host,
+                handle: None,
+            }
+        }
+        None => codex_omd::ReceiptProducer {
+            kind: codex_omd::ProducerKind::Lead,
+            handle: None,
+        },
+    };
+    let receipt = codex_omd::Receipt {
+        kind: input.kind,
+        candidate_sha256: input.candidate_sha256,
+        acceptance_sha256: input.acceptance_sha256,
+        outcome: input.outcome,
+        evidence: input.evidence,
+        producer,
+        findings: input.findings,
+        resolves: input.resolves,
+        submitted_by: caller.id.to_owned(),
+        at: u128::from(codex_omd::peers::now_ms()),
+    };
+    receipt.validate()?;
+    let value = serde_json::to_value(&receipt).map_err(|e| e.to_string())?;
+    let bytes = serde_json::to_vec(&value).map_err(|e| e.to_string())?;
+    let name = format!("receipt-{}.json", execution::hash(&bytes));
+    // Only an accepted receipt leaves evidence; a failed write withdraws it.
+    let submitted = {
+        let mut contract = lead
+            .session
+            .contract
+            .lock()
+            .map_err(|_| "contract_lock_poisoned")?;
+        if lead.session.evidence.join(&name).exists() {
+            return Err("receipt_duplicate".into());
+        }
+        let prior = contract.clone();
+        let submitted = contract.submit(receipt)?;
+        if let Err(error) = lead.session.evidence(&name, &value) {
+            *contract = prior;
+            return Err(error);
+        }
+        submitted
+    };
+    lead.session.persist_contract()?;
+    Ok(submitted)
+}
+
+pub(super) fn gate(
+    core: &Core,
+    lead: &Lead,
+    gate: codex_omd::Gate,
+    candidate_sha256: &str,
+    acceptance_sha256: Option<&str>,
+) -> Result<contract::GateOutcome, String> {
+    let outcome = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .gate(gate, candidate_sha256, acceptance_sha256)?;
+    notify_contract(core, lead, outcome.event(gate, candidate_sha256));
+    Ok(outcome)
+}
+
+async fn complete(core: &Core, lead: &Lead, arguments: Value) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    let _workspace_guard = exclusive(&lead.session)?;
+    let host = lead.host.clone();
+    let current = tokio::task::spawn_blocking(move || contract::current_candidate(&host))
+        .await
+        .map_err(|e| e.to_string())??;
+    if current != input.candidate_sha256 {
+        return Err("candidate_changed: the workspace no longer matches candidate_sha256".into());
+    }
+    let outcome = gate(
+        core,
+        lead,
+        codex_omd::Gate::Complete,
+        &current,
+        input.acceptance_sha256.as_deref(),
+    )?;
+    if let Some(refusal) = outcome.refusal() {
+        return Ok(refusal);
+    }
+    let status = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .status();
+    lead.session.evidence(
+        &format!("completion-{current}-{}.json", codex_omd::peers::now_ms()),
+        &json!({"candidate_sha256": current, "contract": status}),
+    )?;
+    Ok(json!({"status": "completed", "receipts": status["receipts"]}))
+}
+
+pub(super) async fn dispatch(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    dispatch_with_policy(core, lead, caller, call, request, cancelled, None).await
+}
+
+pub(super) async fn dispatch_with_policy(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+    policy: Option<&codex_protocol::models::PermissionProfile>,
+) -> Result<Value, String> {
+    let id = caller.id.to_owned();
+    let audited =
+        codex_omd::access_receipt(&id, &request, Ok(&Value::Null)).map(|_| request.clone());
+    let result = run(core, lead, caller, call, request, cancelled, policy).await;
+    if let Some(request) = audited
+        && let Some(receipt) =
+            codex_omd::access_receipt(&id, &request, result.as_ref().map_err(Clone::clone))
+    {
+        lead.session.record_access(&receipt);
+    }
+    result
+}
+
+async fn run(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+    policy: Option<&codex_protocol::models::PermissionProfile>,
+) -> Result<Value, String> {
+    let host = &lead.host;
+    let operation = request.operation.clone();
+    if operation != "contract.status" {
+        lead.restricted(&operation, &request.arguments)?;
+    }
+    if super::expansion::served(&operation) {
+        return super::expansion::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    let active = {
+        let cancelled = cancelled.clone();
+        move || !cancelled.load(Ordering::Acquire)
+    };
+    if codex_omd::host::served(&operation) {
+        if operation == "exec.run" && request.arguments.get("snapshot").is_some() {
+            if request.arguments.get("guards").is_some()
+                || request.arguments.get("required_access").is_some()
+            {
+                return Err("exec_guards_require_live_workspace".into());
+            }
+            if request.arguments.get("sandbox").is_some() {
+                return Err("exec_snapshot_requires_sandbox".into());
+            }
+            return core
+                .agents
+                .execute_snapshot(
+                    lead,
+                    &caller,
+                    request.arguments,
+                    cancelled,
+                    core.environment.clone(),
+                    authority(lead, call).await?,
+                    policy.cloned(),
+                )
+                .await;
+        }
+        let _guard = workspace_guard(
+            &operation,
+            &request.arguments,
+            &lead.session.repository_identity,
+        )?;
+        let mut authority = authority(lead, call).await?;
+        if operation == "exec.run"
+            && let Some(policy) = policy
+        {
+            let permissions = crate::execution::intersect(
+                &authority.context.permissions,
+                policy,
+                &authority.repository,
+            )?;
+            authority.policy = permissions.file_system_sandbox_policy();
+            authority.context.permissions = permissions;
+        }
+        let (root, protected) = (host.root.clone(), host.protected_paths());
+        let (id, thread) = (caller.id.to_owned(), lead.thread.to_string());
+        let (grants, origin, record) = (caller.grants, caller.origin, caller.record_changes);
+        let environment = core.environment.clone();
+        return tokio::task::spawn_blocking(move || {
+            crate::generic_host::call(
+                grants,
+                &authority,
+                &root,
+                Some(&environment),
+                protected,
+                &id,
+                origin,
+                Some(&thread),
+                request,
+                &active,
+                record,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation == "sessions.snapshot" {
+        if !caller.grants.as_ref().is_some_and(|grants| {
+            grants
+                .capabilities
+                .iter()
+                .any(|cap| cap == "sessions_tools")
+        }) {
+            return Err("capability_denied: sessions_tools".into());
+        }
+        let authority = authority(lead, call).await?;
+        let scoped = Lead {
+            permission_profile: Arc::new(std::sync::Mutex::new(authority.context.permissions)),
+            ..lead.clone()
+        };
+        return core
+            .agents
+            .history_evidence(&scoped, &caller, request.arguments, cancelled)
+            .await;
+    }
+    if codex_omd::scoped_data::operation(&operation) {
+        let authority = authority(lead, call).await?;
+        return lead
+            .session
+            .data
+            .call(lead, authority, &caller, request, cancelled.clone())
+            .await;
+    }
+    if operation == "workspace.request_rename" {
+        if call.is_none() {
+            return Err(
+                "host_operation_unavailable: workspace.request_rename runs in tools".into(),
+            );
+        }
+        let _guard = exclusive(&lead.session)?;
+        let authority = authority(lead, call).await?;
+        let runtime = core.input_runtime.clone();
+        let lead = lead.clone();
+        let generation = caller.generation;
+        let protected = host.protected_paths();
+        let thread = lead.thread.to_string();
+        let environment = core.environment.clone();
+        return tokio::task::spawn_blocking(move || {
+            let mut runtime = runtime.lock().map_err(|_| "pre_rename_runtime_poisoned")?;
+            authority.request_rename(
+                request.arguments,
+                &mut runtime,
+                &lead,
+                &protected,
+                generation,
+                &thread,
+                &environment,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation.starts_with("process.") {
+        let environment = if operation == "process.start" {
+            let grants = caller.grants.as_ref().ok_or("host_caller_inactive")?;
+            core.environment.values(
+                Some(&lead.thread.to_string()),
+                caller.id,
+                caller.source,
+                &grants.exec_environment,
+            )?
+        } else {
+            Default::default()
+        };
+        crate::generic_host::process_request_allowed(caller.grants.as_ref(), &request)?;
+        let authority = authority(lead, call).await?;
+        let processes = lead.session.processes.clone();
+        let (id, generation) = (caller.id.to_owned(), caller.generation);
+        let started = (operation == "process.start").then(|| request.arguments.clone());
+        let protected = host.protected_paths();
+        let os_access = caller
+            .grants
+            .as_ref()
+            .and_then(|grants| grants.os_access.clone());
+        let blit = started
+            .as_ref()
+            .filter(|arguments| arguments.get("raster").is_some())
+            .and_then(|_| super::expansion::blit_sink(core, lead, &caller));
+        let thread = lead.thread.to_string();
+        let result = tokio::task::spawn_blocking(move || {
+            processes.call(
+                crate::managed_process::ProcessOwner {
+                    thread: Some(&thread),
+                    id: &id,
+                    generation,
+                    repository: &authority.repository,
+                    policy: &authority.policy,
+                    protected: &protected,
+                    os_access: os_access.as_ref(),
+                    blit: blit.as_ref(),
+                    environment: Some(&environment),
+                },
+                &request.operation,
+                request.arguments,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+        if let (Some(arguments), Ok(_)) = (started, &result) {
+            super::expansion::process_started(core, lead, caller.id, &arguments);
+        }
+        return result;
+    }
+    if operation.starts_with("agents.")
+        || matches!(
+            operation.as_str(),
+            "workspace.integrate"
+                | "workspace.snapshot"
+                | "workspace.fingerprint"
+                | "model.complete"
+                | "model.fork"
+        )
+    {
+        let scoped = match (operation.as_str(), call) {
+            ("agents.spawn" | "workspace.snapshot" | "workspace.fingerprint", Some(call)) => {
+                let authority = WorkspaceAuthority::for_call(lead, call).await?;
+                Some(Lead {
+                    permission_profile: Arc::new(std::sync::Mutex::new(
+                        authority.context.permissions,
+                    )),
+                    ..lead.clone()
+                })
+            }
+            _ => None,
+        };
+        let lead = scoped.as_ref().unwrap_or(lead);
+        if operation == "workspace.snapshot" {
+            return core
+                .agents
+                .snapshot(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        if operation == "workspace.fingerprint" {
+            return core
+                .agents
+                .fingerprint(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        let repository = host.repository.clone();
+        let before = if operation == "workspace.integrate" && caller.record_changes {
+            tokio::task::spawn_blocking(move || codex_omd::change_baseline(&repository))
+                .await
+                .map_err(|e| e.to_string())?
+        } else {
+            None
+        };
+        let result = core
+            .agents
+            .call(core, lead, &caller, request, cancelled)
+            .await;
+        if let (Some(before), Ok(_)) = (before, &result) {
+            let repository = host.repository.clone();
+            let _ = tokio::task::spawn_blocking(move || {
+                codex_omd::record_workspace_change(&repository, "transaction", before)
+            })
+            .await;
+        }
+        return result;
+    }
+    if operation.starts_with("http.") || operation.starts_with("mcp.") {
+        return super::access::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    if operation.starts_with("providers.") || operation.starts_with("sidecars.") {
+        return core
+            .services
+            .call(&core.runtime, lead, caller.id, caller.generation, request)
+            .await;
+    }
+    match operation.as_str() {
+        "routes.list" => Ok(json!(
+            host.route_config()
+                .0
+                .routes_for(caller.id)
+                .into_iter()
+                .map(|route| route_info(host, route))
+                .collect::<Vec<_>>()
+        )),
+        "ledger.settle" => {
+            let arguments = &request.arguments;
+            let (Some(request_id), Some(microusd), Some(source)) = (
+                arguments["request_id"].as_str(),
+                arguments["microusd"].as_u64(),
+                arguments["source"].as_str(),
+            ) else {
+                return Err("ledger_settle_invalid".into());
+            };
+            let config = host.route_config().0;
+            host.accounts
+                .settle_provider(request_id, microusd, source, |provider| {
+                    config.billed_rates(provider, Some(caller.id)).is_some()
+                })
+        }
+        "session.info" => {
+            let account = host
+                .accounts
+                .by_thread
+                .lock()
+                .map_err(|_| "account lock poisoned")?
+                .get(&lead.thread.to_string())
+                .cloned();
+            let config = super::agents::parent_config(lead).await?;
+            let turns = core
+                .expansion
+                .turns
+                .lock()
+                .map_err(|_| "turn_count_poisoned")?
+                .get(&lead.thread.to_string())
+                .copied()
+                .unwrap_or(0);
+            Ok(
+                json!({"thread_id": lead.thread.to_string(), "root": host.repository,
+                "cwd": config.cwd, "codex_version": env!("CARGO_PKG_VERSION"),
+                "model": account.as_ref().map_or(config.model.clone(), |account| Some(account.model.clone())),
+                "provider": account.as_ref().map_or(config.model_provider_id.clone(), |account| account.provider.clone()),
+                "route": account.and_then(|account| account.route), "turns_started": turns}),
+            )
+        }
+        "task.status" => {
+            host.refresh_session(&lead.session)?;
+            let config = host.route_config().0;
+            Ok(json!({"ledger": lead.ledger(), "limits": config.limits,
+            "worker_limits": config.worker_limits}))
+        }
+        "peers.list" | "peers.send" => {
+            let endpoints = super::peering::current_endpoints(core).await;
+            core.peering.call(lead, &caller, request, endpoints)
+        }
+        "turns.abort" => {
+            #[derive(serde::Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Input {
+                turn_id: String,
+            }
+            if !matches!(caller.origin, Origin::UserCommand | Origin::Event) {
+                return Err("host_operation_user_or_event_only: turns.abort".into());
+            }
+            let input: Input = serde_json::from_value(request.arguments)
+                .map_err(|_| "turn_abort_arguments_invalid")?;
+            if input.turn_id.is_empty() || input.turn_id.len() > 128 {
+                return Err("turn_abort_arguments_invalid".into());
+            }
+            let manager = lead
+                .host
+                .manager
+                .upgrade()
+                .ok_or("native_thread_manager_stopped")?;
+            let thread = manager
+                .get_thread(lead.thread)
+                .await
+                .map_err(|error| error.to_string())?;
+            if cancelled.load(Ordering::Acquire) {
+                return Err("callback_cancelled".into());
+            }
+            let accepted = tokio::select! {
+                biased;
+                result = thread.interrupt_if_no_pending_input(&input.turn_id) => {
+                    result.map_err(|error| error.to_string())?
+                }
+                () = super::agents::until_cancelled(cancelled) => {
+                    return Err("callback_cancelled".into());
+                }
+            };
+            Ok(json!({"accepted": accepted}))
+        }
+        "turns.queue" | "turns.queued" | "turns.dequeue" => {
+            let core = core.this.upgrade().ok_or("native_host_stopped")?;
+            core.autonomy.call(&core, lead, &caller, request)
+        }
+        "receipts.submit" => submit_receipt(core, lead, &caller, request.arguments).await,
+        "task.complete" => complete(core, lead, request.arguments).await,
+        "contract.status" => Ok(lead
+            .session
+            .contract
+            .lock()
+            .map_err(|_| "contract_lock_poisoned")?
+            .status()),
+        "contract.restrict" => {
+            let restricted = lead
+                .session
+                .contract
+                .lock()
+                .map_err(|_| "contract_lock_poisoned")?
+                .restrict(request.arguments)?;
+            lead.session.persist_contract()?;
+            Ok(restricted)
+        }
+        _ => Err(format!("unsupported_host_operation: {operation}")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn live_exec_write_reserves_the_workspace_across_sessions() {
+        let temp = tempfile::tempdir().unwrap();
+        let repository = temp.path().to_str().unwrap();
+        let write = json!({"program":"sh","write":true});
+        assert!(
+            workspace_guard("exec.run", &json!({"program":"sh"}), repository)
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            workspace_guard(
+                "exec.run",
+                &json!({"program":"sh","write":true,"snapshot":{"sha256":"x"}}),
+                repository
+            )
+            .unwrap()
+            .is_none()
+        );
+        let (held_tx, held_rx) = std::sync::mpsc::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        std::thread::scope(|scope| {
+            let write = &write;
+            scope.spawn(move || {
+                let _guard = workspace_guard("exec.run", write, repository)
+                    .unwrap()
+                    .unwrap();
+                held_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+            });
+            held_rx.recv().unwrap();
+            assert!(
+                workspace_guard("workspace.restore", &json!({}), repository)
+                    .err()
+                    .unwrap()
+                    .contains("workspace_operation_active")
+            );
+            release_tx.send(()).unwrap();
+        });
+        let _guard = workspace_guard("exec.run", &write, repository)
+            .unwrap()
+            .unwrap();
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/peering.rs b/codex-rs/ext/omd/src/mods/peering.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fb546f8c6c7f5ca75770139632ff02e25d683b1c
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/peering.rs
@@ -0,0 +1,254 @@
+use super::*;
+use codex_omd::peers::BrokerSeal;
+use codex_omd::peers::Endpoint;
+use codex_omd::peers::Peers;
+use std::time::Duration;
+
+const POLL: Duration = Duration::from_secs(1);
+const DEFAULT_TTL_MS: u64 = 60_000;
+
+#[derive(Default)]
+pub(super) struct Registry {
+    sessions: Mutex<BTreeMap<String, Arc<Peers>>>,
+}
+
+fn endpoints(runtime: &ModHost) -> Vec<Endpoint> {
+    runtime
+        .owners()
+        .into_iter()
+        .filter_map(|(id, _)| {
+            let grants = runtime.grants(&id)?;
+            let access = grants.peer_access?;
+            Some(Endpoint {
+                package: id,
+                sha256: grants.source_sha256,
+                projects: access.projects,
+            })
+        })
+        .collect()
+}
+
+impl Registry {
+    fn session(&self, lead: &Lead, endpoints: &[Endpoint]) -> Result<Arc<Peers>, String> {
+        let thread = lead.thread.to_string();
+        let mut sessions = self.sessions.lock().map_err(|_| "peer_registry_poisoned")?;
+        if let Some(peers) = sessions.get(&thread) {
+            return Ok(peers.clone());
+        }
+        let peers = Arc::new(
+            Peers::open(&lead.host.root, &thread, &lead.host.repository)
+                .map_err(|error| error.to_string())?,
+        );
+        peers
+            .publish(endpoints)
+            .map_err(|error| error.to_string())?;
+        sessions.insert(thread, peers.clone());
+        Ok(peers)
+    }
+
+    fn close(&self, thread: &str) {
+        if let Ok(mut sessions) = self.sessions.lock() {
+            sessions.remove(thread);
+        }
+    }
+
+    pub(super) fn call(
+        &self,
+        lead: &Lead,
+        caller: &operations::Caller<'_>,
+        request: ModHostCall,
+        endpoints: Vec<Endpoint>,
+    ) -> Result<Value, String> {
+        if lead.owner != "lead" {
+            return Err("peers_lead_only: agent threads have no peer session".into());
+        }
+        let endpoint = endpoints
+            .iter()
+            .find(|endpoint| endpoint.package == caller.id)
+            .cloned()
+            .ok_or("grant_expired: peers")?;
+        let peers = self.session(lead, &endpoints)?;
+        let arguments = &request.arguments;
+        let package = arguments
+            .get("package")
+            .and_then(Value::as_str)
+            .unwrap_or(caller.id)
+            .to_owned();
+        match request.operation.as_str() {
+            "peers.list" => peers
+                .list(&endpoint, &package)
+                .map(|sessions| json!({"session": peers.session(), "peers": sessions}))
+                .map_err(|error| error.to_string()),
+            "peers.send" => {
+                let to = arguments["to"].as_str().ok_or("peer_address_invalid")?;
+                peers
+                    .send(
+                        &BrokerSeal,
+                        &endpoint,
+                        to,
+                        &package,
+                        arguments.get("data").cloned().unwrap_or(Value::Null),
+                        arguments["correlation"].as_str().map(str::to_owned),
+                        arguments["ttl_ms"].as_u64().unwrap_or(DEFAULT_TTL_MS),
+                    )
+                    .map_err(|error| error.to_string())
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        }
+    }
+}
+
+pub(super) async fn current_endpoints(core: &Core) -> Vec<Endpoint> {
+    let runtime = core.runtime.clone();
+    tokio::task::spawn_blocking(move || {
+        runtime
+            .lock()
+            .map(|runtime| endpoints(&runtime))
+            .unwrap_or_default()
+    })
+    .await
+    .unwrap_or_default()
+}
+
+pub(super) fn start(core: &Arc<Core>, thread: ThreadId) {
+    let core = core.clone();
+    tokio::spawn(async move {
+        let mut published = Vec::new();
+        loop {
+            tokio::time::sleep(POLL).await;
+            let Some(lead) = core.expansion.lead(thread) else {
+                core.peering.close(&thread.to_string());
+                return;
+            };
+            if !core.expansion.peers.load(Ordering::Acquire) {
+                core.peering.close(&thread.to_string());
+                published.clear();
+                continue;
+            }
+            let endpoints = current_endpoints(&core).await;
+            if endpoints.is_empty() {
+                core.peering.close(&thread.to_string());
+                published.clear();
+                continue;
+            }
+            let peers = match core.peering.session(&lead, &endpoints) {
+                Ok(peers) => peers,
+                Err(error) => {
+                    core.views.diagnostic(&core.host, "peers", Some(error));
+                    continue;
+                }
+            };
+            if published != endpoints {
+                if let Err(error) = peers.publish(&endpoints) {
+                    core.views
+                        .diagnostic(&core.host, "peers", Some(error.to_string()));
+                }
+                published = endpoints.clone();
+            }
+            if let Err(error) = deliver(&core, &lead, &peers, &endpoints).await {
+                core.views.diagnostic(&core.host, "peers", Some(error));
+            }
+        }
+    });
+}
+
+async fn deliver(
+    core: &Arc<Core>,
+    lead: &Lead,
+    peers: &Arc<Peers>,
+    endpoints: &[Endpoint],
+) -> Result<(), String> {
+    let receiving = peers.clone();
+    let inbound = tokio::task::spawn_blocking(move || receiving.receive(&BrokerSeal))
+        .await
+        .map_err(|error| error.to_string())?
+        .map_err(|error| error.to_string())?;
+    for message in inbound.into_iter().map(|inbound| inbound.message) {
+        let package = message["to"]["package"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        let (status, reason) = match endpoints
+            .iter()
+            .find(|endpoint| endpoint.package == package)
+        {
+            None => ("refused", Some("package_unavailable".to_owned())),
+            Some(endpoint) if !peers.admits(endpoint, &message) => {
+                ("refused", Some("peer_scope_denied".to_owned()))
+            }
+            Some(_) => receive(core, lead, &package, &message).await,
+        };
+        let replying = peers.clone();
+        let _ = tokio::task::spawn_blocking(move || {
+            replying.receipt(&BrokerSeal, &message, status, reason)
+        })
+        .await;
+    }
+    let settling = peers.clone();
+    let receipts = tokio::task::spawn_blocking(move || settling.receipts(&BrokerSeal))
+        .await
+        .map_err(|error| error.to_string())?
+        .map_err(|error| error.to_string())?;
+    for (package, receipt) in receipts {
+        expansion::invoke_one(core, lead, package, "peer_receipt", receipt).await;
+    }
+    Ok(())
+}
+
+/// Runs `peer_receive` interceptors, then hands the message to its package as untrusted data.
+pub(super) async fn receive(
+    core: &Arc<Core>,
+    lead: &Lead,
+    package: &str,
+    message: &Value,
+) -> (&'static str, Option<String>) {
+    let mut input = json!({"id": message["id"], "from": message["from"], "to": message["to"],
+        "correlation": message["correlation"], "untrusted": true, "data": message["data"]});
+    let (runtime, id) = (core.runtime.clone(), package.to_owned());
+    let (required, registered) = tokio::task::spawn_blocking(move || {
+        runtime
+            .lock()
+            .map(|runtime| {
+                (
+                    runtime.intercepts("peer_receive"),
+                    runtime.registered(&id, "peer_message"),
+                )
+            })
+            .unwrap_or((None, false))
+    })
+    .await
+    .unwrap_or((None, false));
+    if !registered {
+        return ("refused", Some("no_peer_message_handler".to_owned()));
+    }
+    if let Some(required) = required {
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let _cancellation = Cancellation(cancelled.clone());
+        let chain = intercept::chain(
+            core.clone(),
+            Arc::new(lead.clone()),
+            core.runtime.clone(),
+            "peer_receive",
+            required,
+            input.clone(),
+            json!({"caller": "peer", "thread_id": lead.thread.to_string()}),
+            cancelled,
+            |effective| Ok(json!({"data": effective["data"]})),
+        )
+        .await;
+        match chain {
+            Err(error) => return ("refused", Some(format!("peer_receive_failed: {error}"))),
+            Ok(chain) => {
+                if let Some(reason) = chain.result["deny"].as_str() {
+                    return ("refused", Some(reason.chars().take(512).collect()));
+                }
+                input["data"] = chain.result["data"].clone();
+            }
+        }
+    }
+    input["sent_at_ms"] = message["sent_at_ms"].clone();
+    match expansion::invoke_one(core, lead, package.to_owned(), "peer_message", input).await {
+        Some(Err(error)) => ("failed", Some(error.chars().take(512).collect())),
+        _ => ("delivered", None),
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/persisted.rs b/codex-rs/ext/omd/src/mods/persisted.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3a6ec486cc40c8ce442312d9bb2282303d0631a8
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/persisted.rs
@@ -0,0 +1,41 @@
+use super::*;
+use codex_extension_api::PersistedTextInput;
+use codex_extension_api::PersistedTextRewrite;
+
+/// Runs `history_persist` interceptors off the async runtime; a required one withholds every entry if the persist runtime fails.
+pub(super) async fn rewrite(
+    runtime: Arc<Mutex<ModHost>>,
+    required: Arc<Mutex<Vec<&'static str>>>,
+    input: PersistedTextInput<'_>,
+) -> Option<PersistedTextRewrite> {
+    let thread = input.thread_id.to_owned();
+    let entries = input
+        .entries
+        .iter()
+        .map(|entry| {
+            json!({"kind":entry.kind,"role":entry.role,"call_id":entry.call_id,"text":entry.text})
+        })
+        .collect::<Vec<_>>();
+    let count = entries.len();
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let _cancellation = Cancellation(cancelled.clone());
+    let rewritten = tokio::task::spawn_blocking(move || {
+        codex_omd::persist_texts(&runtime, &thread, &entries, || {
+            !cancelled.load(Ordering::Acquire)
+        })
+    })
+    .await;
+    match rewritten {
+        Ok(Ok(rewrite)) => rewrite.map(|rewrite| PersistedTextRewrite {
+            texts: rewrite.texts,
+            by: rewrite.by,
+        }),
+        _ => required
+            .lock()
+            .is_ok_and(|surfaces| surfaces.contains(&"history_persist"))
+            .then(|| PersistedTextRewrite {
+                texts: vec![codex_omd::PERSIST_WITHHELD.to_owned(); count],
+                by: "host".to_owned(),
+            }),
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/roles.rs b/codex-rs/ext/omd/src/mods/roles.rs
new file mode 100644
index 0000000000000000000000000000000000000000..36f1dc61b510e861afbbed8d636ad300ca372e54
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/roles.rs
@@ -0,0 +1,421 @@
+use super::*;
+use codex_extension_api::AgentRoleContributor;
+use codex_extension_api::ContributedAgentRole;
+use codex_omd::ModAgentDefinition;
+use std::collections::BTreeSet;
+
+const PLAN_PREFIX: &str = "omd-agent-";
+
+pub(super) struct AgentTools(pub(super) BTreeSet<String>);
+
+#[derive(Clone, Deserialize, Serialize)]
+struct Plan {
+    definition: Option<String>,
+    cwd: Option<std::path::PathBuf>,
+    tools: Option<Vec<String>>,
+}
+
+pub(super) fn is_spawn(tool: &ToolName) -> bool {
+    tool.name == "spawn_agent"
+}
+
+fn agents_dir(host: &Host) -> std::path::PathBuf {
+    host.root.join("agents")
+}
+
+fn write_once(path: &std::path::Path, text: &str) -> Result<(), String> {
+    if path.exists() {
+        return Ok(());
+    }
+    let parent = path.parent().ok_or("agent_role_path_invalid")?;
+    std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+    let temporary = parent.join(format!(
+        ".{}.{}.tmp",
+        std::process::id(),
+        execution::hash(text.as_bytes())
+    ));
+    std::fs::write(&temporary, text).map_err(|e| e.to_string())?;
+    std::fs::rename(&temporary, path).map_err(|e| e.to_string())
+}
+
+impl Core {
+    pub(super) fn definition(&self, name: &str) -> Option<ModAgentDefinition> {
+        let (owner, short) = name.split_once('/')?;
+        self.expansion
+            .definitions
+            .lock()
+            .ok()?
+            .iter()
+            .find(|definition| definition.owner == owner && definition.agent.name == short)
+            .cloned()
+    }
+
+    fn role_file(
+        &self,
+        lead: &Lead,
+        name: &str,
+        description: &str,
+        definition: Option<&ModAgentDefinition>,
+    ) -> Result<std::path::PathBuf, String> {
+        let quote = |text: &str| serde_json::to_string(text).unwrap_or_default();
+        let mut lines = vec![
+            format!("name = {}", quote(name)),
+            format!("description = {}", quote(description)),
+        ];
+        if let Some(definition) = definition {
+            lines.push(format!(
+                "developer_instructions = {}",
+                quote(&format!(
+                    "Agent definition {}/{} from mod {}; it is subordinate to current user and project instructions.\n{}",
+                    definition.owner, definition.agent.name, definition.owner, definition.agent.instructions
+                ))
+            ));
+            let mut effort = definition.agent.effort.clone();
+            if let Some(name) = &definition.agent.route {
+                let provider = lead
+                    .host
+                    .accounts
+                    .by_thread
+                    .lock()
+                    .map_err(|_| "account lock poisoned")?
+                    .get(&lead.thread.to_string())
+                    .map(|account| account.provider.clone());
+                let (routing, _) = lead.host.route_config();
+                let route = routing
+                    .route(name, config::RouteRole::Lead, Some(&definition.owner))
+                    .filter(|route| Some(&route.provider) == provider.as_ref())
+                    .ok_or_else(|| format!("agent_definition_route_unavailable: {name}"))?;
+                lines.push(format!("model = {}", quote(&route.model)));
+                effort = effort.or_else(|| {
+                    serde_json::to_value(&route.reasoning_effort)
+                        .ok()
+                        .and_then(|effort| effort.as_str().map(str::to_owned))
+                });
+            }
+            if let Some(effort) = effort {
+                lines.push(format!("model_reasoning_effort = {}", quote(&effort)));
+            }
+        }
+        let text = lines.join("\n") + "\n";
+        let path = agents_dir(&lead.host)
+            .join(format!("{}.toml", &execution::hash(text.as_bytes())[..16]));
+        write_once(&path, &text)?;
+        Ok(path)
+    }
+
+    fn plan(&self, host: &Host, name: &str) -> Option<Plan> {
+        let text =
+            std::fs::read(agents_dir(host).join("plans").join(format!("{name}.json"))).ok()?;
+        serde_json::from_slice(&text).ok()
+    }
+
+    pub(super) fn role_tools(&self, host: &Host, name: &str) -> Option<BTreeSet<String>> {
+        let (definition, planned) = if name.starts_with(PLAN_PREFIX) {
+            let plan = self.plan(host, name)?;
+            (
+                plan.definition.and_then(|name| self.definition(&name)),
+                plan.tools,
+            )
+        } else {
+            (self.definition(name), None)
+        };
+        let defined = definition.and_then(|definition| definition.agent.tools);
+        match (defined, planned) {
+            (Some(defined), Some(planned)) => Some(
+                planned
+                    .into_iter()
+                    .filter(|tool| defined.contains(tool))
+                    .collect(),
+            ),
+            (defined, planned) => defined.or(planned).map(|tools| tools.into_iter().collect()),
+        }
+    }
+
+    pub(super) fn role_definition(&self, host: &Host, name: &str) -> Option<ModAgentDefinition> {
+        if name.starts_with(PLAN_PREFIX) {
+            return self
+                .plan(host, name)?
+                .definition
+                .and_then(|name| self.definition(&name));
+        }
+        self.definition(name)
+    }
+
+    fn resolve(&self, lead: &Lead, name: &str) -> Result<Option<ContributedAgentRole>, String> {
+        let (definition, cwd) = if name.starts_with(PLAN_PREFIX) {
+            let plan = self
+                .plan(&lead.host, name)
+                .ok_or("agent_plan_unavailable")?;
+            let definition = match &plan.definition {
+                Some(name) => Some(
+                    self.definition(name)
+                        .ok_or_else(|| format!("agent_definition_unavailable: {name}"))?,
+                ),
+                None => None,
+            };
+            if let Some(cwd) = &plan.cwd
+                && !std::fs::canonicalize(cwd).is_ok_and(|cwd| {
+                    codex_omd::app_routes::session_roots(&lead.host.repository).contains(&cwd)
+                })
+            {
+                return Err("agent_spawn_cwd_outside_session".into());
+            }
+            (definition, plan.cwd)
+        } else if name.contains('/') {
+            let definition = self
+                .definition(name)
+                .ok_or_else(|| format!("agent_definition_unavailable: {name}"))?;
+            (Some(definition), None)
+        } else {
+            return Ok(None);
+        };
+        let description = definition.as_ref().map_or_else(
+            || "Spawn adjusted by a mod interceptor".to_owned(),
+            |d| d.agent.description.clone(),
+        );
+        let config_file = self.role_file(lead, name, &description, definition.as_ref())?;
+        let cwd = cwd
+            .map(codex_utils_absolute_path::AbsolutePathBuf::try_from)
+            .transpose()
+            .map_err(|e| e.to_string())?;
+        Ok(Some(ContributedAgentRole {
+            name: name.to_owned(),
+            description,
+            config_file,
+            cwd,
+        }))
+    }
+
+    fn offers(&self, lead: &Lead) -> Vec<(String, String)> {
+        let offers = self
+            .expansion
+            .definitions
+            .lock()
+            .map(|definitions| {
+                definitions
+                    .iter()
+                    .filter(|definition| definition.agent.offer)
+                    .map(|definition| {
+                        json!({"name": format!("{}/{}", definition.owner, definition.agent.name),
+                            "description": definition.agent.description, "owner": definition.owner})
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        if offers.is_empty() {
+            return Vec::new();
+        }
+        let required = *self
+            .expansion
+            .agent_offers
+            .lock()
+            .ok()
+            .as_deref()
+            .unwrap_or(&None);
+        let offers = match required {
+            None => Value::Array(offers),
+            Some(required) => {
+                let payload = json!({"thread_id": lead.thread.to_string(), "offers": offers});
+                let origin = json!({"caller": "engine", "thread_id": lead.thread.to_string()});
+                match codex_omd::intercept_shared(
+                    &self.runtime,
+                    "agent_offers",
+                    required,
+                    payload,
+                    origin,
+                    || true,
+                    |_, _| {
+                        Err(std::io::Error::other(
+                            "host_operation_unavailable: agent_offers runs without host operations",
+                        ))
+                    },
+                    |effective| Ok(json!({"offers": effective["offers"]})),
+                ) {
+                    Ok(chain) => {
+                        self.views.diagnostic(&self.host, "agent_offers", None);
+                        chain.result["offers"].clone()
+                    }
+                    Err(error) => {
+                        self.views.diagnostic(
+                            &self.host,
+                            "agent_offers",
+                            Some(format!("{error}; no mod agents offered")),
+                        );
+                        return Vec::new();
+                    }
+                }
+            }
+        };
+        offers
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|offer| {
+                Some((
+                    offer["name"].as_str()?.to_owned(),
+                    format!(
+                        "{} (mod {})",
+                        offer["description"].as_str()?,
+                        offer["owner"].as_str()?
+                    ),
+                ))
+            })
+            .collect()
+    }
+
+    pub(super) fn spawn_payload(
+        &self,
+        lead: &Lead,
+        arguments: &Value,
+        cwd: &std::path::Path,
+    ) -> Value {
+        let prompt = match &arguments["message"] {
+            Value::String(message) => message.clone(),
+            _ => arguments["items"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|item| item["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n"),
+        };
+        json!({"origin": "model", "caller": "model", "thread_id": lead.thread.to_string(),
+            "agent_id": (lead.owner != "lead").then(|| lead.owner.clone()),
+            "definition": arguments["agent_type"], "prompt": prompt, "model": arguments["model"],
+            "effort": arguments["reasoning_effort"], "cwd": cwd.to_string_lossy(),
+            "tools": null})
+    }
+
+    pub(super) fn spawn_arguments(
+        &self,
+        lead: &Lead,
+        original: &Value,
+        before: &Value,
+        effective: &Value,
+    ) -> Result<Value, String> {
+        let mut arguments = original.clone();
+        if effective["prompt"] != before["prompt"] {
+            if let Some(object) = arguments.as_object_mut() {
+                object.remove("items");
+            }
+            arguments["message"] = effective["prompt"].clone();
+        }
+        for (field, key) in [("model", "model"), ("effort", "reasoning_effort")] {
+            match &effective[field] {
+                Value::Null => {
+                    if let Some(object) = arguments.as_object_mut() {
+                        object.remove(key);
+                    }
+                }
+                value => arguments[key] = value.clone(),
+            }
+        }
+        let definition = effective["definition"].as_str();
+        if let Some(name) = definition.filter(|name| name.contains('/'))
+            && self.definition(name).is_none()
+        {
+            return Err(format!("unknown_agent_definition: {name}"));
+        }
+        let cwd = (effective["cwd"] != before["cwd"])
+            .then(|| effective["cwd"].as_str().map(std::path::PathBuf::from))
+            .flatten();
+        if let Some(cwd) = &cwd {
+            let allowed = std::fs::canonicalize(cwd).is_ok_and(|cwd| {
+                codex_omd::app_routes::session_roots(&self.host.repository).contains(&cwd)
+            });
+            if !allowed {
+                return Err("agent_spawn_cwd_outside_session".into());
+            }
+        }
+        let tools = effective["tools"].as_array().map(|tools| {
+            tools
+                .iter()
+                .filter_map(|tool| tool.as_str().map(str::to_owned))
+                .collect::<Vec<_>>()
+        });
+        if cwd.is_none() && tools.is_none() {
+            match definition {
+                Some(name) => arguments["agent_type"] = json!(name),
+                None => {
+                    if let Some(object) = arguments.as_object_mut() {
+                        object.remove("agent_type");
+                    }
+                }
+            }
+            return Ok(arguments);
+        }
+        if definition.is_some_and(|name| !name.contains('/') && name != "default") {
+            return Err("agent_spawn_override_requires_definition: express cwd or tool changes as a mod agent definition".into());
+        }
+        let plan = Plan {
+            definition: definition
+                .filter(|name| name.contains('/'))
+                .map(str::to_owned),
+            cwd,
+            tools,
+        };
+        let text = serde_json::to_string(&plan).map_err(|e| e.to_string())?;
+        let name = format!("{PLAN_PREFIX}{}", &execution::hash(text.as_bytes())[..16]);
+        write_once(
+            &agents_dir(&lead.host)
+                .join("plans")
+                .join(format!("{name}.json")),
+            &text,
+        )?;
+        arguments["agent_type"] = json!(name);
+        Ok(arguments)
+    }
+}
+
+pub(super) fn spawn_result(result: &Value) -> Value {
+    let output = result["output"].as_str().unwrap_or_default();
+    let parsed = serde_json::from_str::<Value>(output).unwrap_or(Value::Null);
+    let agent_id = parsed["agent_id"]
+        .as_str()
+        .or(parsed["task_name"].as_str())
+        .filter(|_| result["success"] == true);
+    json!({"agent_id": agent_id, "output": output, "success": result["success"]})
+}
+
+impl AgentRoleContributor for Mods {
+    fn offered_agent_roles(&self, thread_store: &ExtensionData) -> Vec<ContributedAgentRole> {
+        let Some(lead) = thread_store.get::<Lead>() else {
+            return Vec::new();
+        };
+        self.offers(&lead)
+            .into_iter()
+            .filter_map(|(name, description)| {
+                let definition = self.definition(&name)?;
+                match self.role_file(&lead, &name, &description, Some(&definition)) {
+                    Ok(config_file) => Some(ContributedAgentRole {
+                        name,
+                        description,
+                        config_file,
+                        cwd: None,
+                    }),
+                    Err(error) => {
+                        self.views
+                            .diagnostic(&self.host, &format!("agent:{name}"), Some(error));
+                        None
+                    }
+                }
+            })
+            .collect()
+    }
+
+    fn resolve_agent_role(
+        &self,
+        thread_store: &ExtensionData,
+        name: &str,
+    ) -> Option<ContributedAgentRole> {
+        let lead = thread_store.get::<Lead>()?;
+        match self.resolve(&lead, name) {
+            Ok(role) => role,
+            Err(error) => {
+                self.views
+                    .diagnostic(&self.host, &format!("agent:{name}"), Some(error));
+                None
+            }
+        }
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/services.rs b/codex-rs/ext/omd/src/mods/services.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b831e88d5928b56a29bf2872b822fed6d91750b8
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/services.rs
@@ -0,0 +1,1067 @@
+use super::*;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::PermissionProfileSnapshot;
+use codex_protocol::permissions::FileSystemAccessMode;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use std::collections::BTreeSet;
+use std::path::Path;
+use std::time::Duration;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Grant {
+    id: String,
+    mod_id: String,
+    program: PathBuf,
+    program_sha256: String,
+    #[serde(default)]
+    arguments: Vec<String>,
+    #[serde(default)]
+    secrets: BTreeMap<String, String>,
+    #[serde(default)]
+    route: Option<Route>,
+    #[serde(default)]
+    network: bool,
+    #[serde(default)]
+    read_paths: Vec<PathBuf>,
+    #[serde(default)]
+    requests: bool,
+    #[serde(default)]
+    read_hashes: BTreeMap<PathBuf, String>,
+    #[serde(default)]
+    code_roots: BTreeMap<PathBuf, String>,
+    #[serde(default)]
+    credentials: BTreeSet<String>,
+}
+
+/// Defines the provider of each loopback provider grant of an active mod for this process; configured providers keep precedence.
+pub(crate) fn define_providers(config: &crate::config::HostConfig, active: impl Fn(&str) -> bool) {
+    for grant in &config.services {
+        let Some(route) = grant.route.as_ref().filter(|_| active(&grant.mod_id)) else {
+            continue;
+        };
+        let Some(base_url) = route
+            .responses_url
+            .strip_suffix("/responses")
+            .filter(|url| url.starts_with("http://127.0.0.1:"))
+        else {
+            continue;
+        };
+        let token = grant
+            .secrets
+            .values()
+            .next()
+            .filter(|_| grant.secrets.len() == 1)
+            .and_then(|reference| config.secret_refs.get(reference))
+            .filter(|path| {
+                std::fs::symlink_metadata(path)
+                    .is_ok_and(|metadata| metadata.is_file() && metadata.len() <= 4096)
+            })
+            .and_then(|path| std::fs::read_to_string(path).ok())
+            .map(|token| token.trim().to_string().into());
+        codex_model_provider_info::set_runtime_provider(
+            &route.provider,
+            Some(codex_model_provider_info::ModelProviderInfo {
+                name: route.provider.clone(),
+                base_url: Some(base_url.to_string()),
+                experimental_bearer_token: token,
+                request_max_retries: Some(0),
+                stream_max_retries: Some(0),
+                ..Default::default()
+            }),
+        );
+    }
+}
+
+impl Grant {
+    pub(crate) fn billed_rates(&self, provider: &str) -> Option<&crate::accounting::Rates> {
+        self.route
+            .as_ref()
+            .filter(|route| {
+                route.provider == provider
+                    && route.rates.provider_billed
+                    && !route.rates.included_subscription
+                    && route.rates.reservation_microusd == 0
+            })
+            .map(|route| &route.rates)
+    }
+
+    pub(crate) fn mod_id(&self) -> &str {
+        &self.mod_id
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Services {
+    records: tokio::sync::Mutex<BTreeMap<String, Service>>,
+}
+
+struct Service {
+    mod_id: String,
+    generation: u64,
+    route: Option<Route>,
+    job: Option<tokio::task::JoinHandle<Result<Value, String>>>,
+    task: Arc<Task>,
+    worker: String,
+    _gateway: Option<crate::credential_gateway::Registration>,
+    _snapshot: tempfile::TempDir,
+}
+
+impl Drop for Service {
+    fn drop(&mut self) {
+        if let Some(route) = &self.route {
+            codex_models_manager::runtime_models::set(&route.provider, Vec::new());
+            codex_models_manager::runtime_models::set_name(&route.provider, None);
+        }
+        if let Some(job) = self.job.take() {
+            job.abort();
+        }
+        let _ = self.task.finish_worker(&self.worker);
+    }
+}
+
+impl Service {
+    fn finished(&self) -> bool {
+        self.job
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    async fn stop(mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            let _ = job.await;
+        }
+    }
+}
+
+impl Services {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "Stop stale services before admitting replacements"
+    )]
+    pub(super) async fn cleanup_stale(&self, generation: u64, owners: &BTreeMap<String, String>) {
+        let mut records = self.records.lock().await;
+        let stale = {
+            let keys = records
+                .iter()
+                .filter(|(_, service)| {
+                    service.generation != generation || !owners.contains_key(&service.mod_id)
+                })
