+const SUBSCRIBER_TTL: Duration = Duration::from_secs(2);
+
+struct TuiSurface(AppEventSender);
+
+impl ClientSurface for TuiSurface {
+    fn submit(&self, mut call: SurfaceCall) -> Result<(), String> {
+        call.lifetime.binding = Some(call_binding(&call.caller));
+        let admitted = call.validity.clone();
+        let current = crate::mod_runtime::context_unchanged().1;
+        let thread = call.thread.clone();
+        let host = call.caller == codex_omd::broker::HOST_CALLER;
+        call.validity = codex_omd::client_surface::Validity(std::sync::Arc::new(move || {
+            (admitted.0)() && current() && (host || thread == current_thread())
+        }));
+        if !(call.validity.0)() {
+            call.reply_blit(Err("client_context_changed".into()));
+            return Ok(());
+        }
+        let binding = (call.operation == "terminal.pty")
+            .then(|| {
+                crate::mod_pty::binding(
+                    &call.caller,
+                    call.thread.as_deref(),
+                    call.authority.as_ref().ok_or("pty_authority_missing")?,
+                )
+            })
+            .transpose()?;
+        self.0
+            .send(AppEvent::ModSurfaceCall(Box::new(call), binding));
+        Ok(())
+    }
+
+    fn redraw(&self) {
+        self.0.send(AppEvent::ModViewChanged);
+    }
+
+    fn client(&self) -> Value {
+        crate::mod_client::value()
+    }
+}
