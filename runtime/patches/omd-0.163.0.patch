+/// Runs `cell`'s native drawing through the matching mod `render` hooks, telling tool rows whether the user expanded them; the flag reports whether a hook replaced the native drawing.
+pub(crate) fn hooked_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: bool,
+    draw: impl FnOnce(&C, u16) -> Vec<HyperlinkLine>,
+) -> (Vec<HyperlinkLine>, bool) {
+    let expanded_ids = if expanded {
+        cell.activity_ids().into_iter().collect()
+    } else {
+        Default::default()
+    };
+    if let Some(members) = hooked_member_lines(cell, width, &expanded_ids) {
+        return (
+            members
+                .into_iter()
+                .flat_map(|member| member.lines)
+                .collect(),
+            true,
+        );
+    }
+    match cell.render_target() {
+        Some(mut target) => {
+            if target.component == "tool_call" {
+                target.props["expanded"] = serde_json::Value::Bool(expanded);
+            }
+            let (mut lines, replaced) =
+                crate::mod_render::hyperlink_lines(&target, width, |props, width| {
+                    cell.render_native(props, draw(cell, width))
+                });
+            lines.extend(crate::mod_render::tool_notice_lines(&target));
+            (lines, replaced)
+        }
+        None => (draw(cell, width), false),
+    }
+}
+
+pub(crate) struct RenderMember<'a> {
+    pub(crate) id: String,
+    pub(crate) target: crate::mod_render::RenderTarget,
+    pub(crate) native: Box<dyn Fn(u16, bool) -> Vec<HyperlinkLine> + 'a>,
+}
+
+pub(crate) struct MemberLines {
+    pub(crate) id: String,
+    pub(crate) lines: Vec<HyperlinkLine>,
+}
+
+pub(crate) fn hooked_member_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: &std::collections::HashSet<String>,
+) -> Option<Vec<MemberLines>> {
+    if !crate::mod_render::enabled() {
+        return None;
+    }
+    let mut members = cell.render_members();
+    for member in &mut members {
+        member.target.props["expanded"] = false.into();
+    }
+    // A group stays per-member while any compact row is hooked; expanded rows are probed compact only as a last resort, since their drawn render must be the last one queued.
+    let hooked =
+        |member: &RenderMember| crate::mod_render::resolve(&member.target, width).is_some();
+    let (open, compact): (Vec<_>, Vec<_>) = members
+        .iter()
+        .partition(|member| expanded.contains(&member.id));
+    if !compact.into_iter().any(hooked) && !open.into_iter().any(hooked) {
+        return None;
+    }
+    Some(
+        members
+            .into_iter()
+            .map(|mut member| {
+                let open = expanded.contains(&member.id);
+                member.target.props["expanded"] = open.into();
+                let (mut lines, _) =
+                    crate::mod_render::hyperlink_lines(&member.target, width, |_, width| {
+                        (member.native)(width, open)
+                    });
+                lines.extend(crate::mod_render::tool_notice_lines(&member.target));
+                MemberLines {
+                    id: member.id,
+                    lines,
+                }
+            })
+            .collect(),
+    )
+}
