+        let _ = kill_process_group(self.child.id());
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        *reaped = true;
+        drop(reaped);
+        let _ = fs::remove_dir_all(&self.scratch);
+    }
+}
