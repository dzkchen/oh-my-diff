+fn commands_refuse_during_turns_keep_protected_recovery_and_refuse_stale_settings() {
+    let token = ActiveContext::default().begin(ModContext {
+        thread_id: None,
+        repository: PathBuf::from("/tmp/omd-without-mods"),
+        policy: FileSystemSandboxPolicy::unrestricted(),
+    });
+    let target = mod_target("notes", "sync");
+    let refused = run_command(
+        "notes:sync",
+        "",
+        Some(&target),
+        false,
+        true,
+        "user",
+        &token,
+        |_| unreachable!("a non-immediate mod command never runs during a turn"),
+    );
+    assert_eq!(
+        refused.unwrap_err(),
+        "command_unavailable_during_turn: /notes:sync"
+    );
+    let mut dispatched = Vec::new();
+    let quit = run_command("quit", " now ", None, true, true, "user", &token, |args| {
+        dispatched.push(args);
+        Ok(serde_json::json!({"invoked": true}))
+    })
+    .unwrap();
+    assert_eq!(quit.value, serde_json::json!({"invoked": true}));
+    assert_eq!(dispatched, [" now "]);
+    let row = serde_json::json!({"key": "mods.notes.limit", "value": 3, "editable": true});
+    let stale = set_config(
+        &row,
+        serde_json::json!(4),
+        Some(&serde_json::json!(2)),
+        "user",
+        |_| unreachable!("a stale write is never applied"),
+    );
+    assert!(
+        stale
+            .unwrap_err()
+            .starts_with("config_stale: mods.notes.limit")
+    );
+    let depth = serde_json::json!({"key": "agents.max_depth", "value": 3, "editable": true});
+    let masked = set_config(
+        &depth,
+        serde_json::json!("a\n<redacted>"),
+        None,
+        "user",
+        |_| unreachable!("a masked value is never written"),
+    );
+    assert!(
+        masked
+            .unwrap_err()
+            .starts_with("app_config_value_redacted: agents.max_depth")
+    );
+    let literal = set_config(&row, serde_json::json!("<redacted>"), None, "user", |_| {
+        unreachable!("this session has no mod paths")
+    });
+    assert!(
+        !literal
+            .unwrap_err()
+            .starts_with("app_config_value_redacted")
