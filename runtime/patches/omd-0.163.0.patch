+fn selected_workspace_paths(
+    manager: &EnvironmentManager,
+    selections: &[TurnEnvironmentSelection],
+) -> std::io::Result<std::collections::BTreeSet<std::path::PathBuf>> {
+    let mut paths = std::collections::BTreeSet::new();
+    for selection in selections {
+        let environment = manager
+            .get_environment(&selection.environment_id)
+            .ok_or_else(|| std::io::Error::other("workspace_environment_unavailable"))?;
+        if environment.is_remote() {
+            continue;
+        }
+        for path in std::iter::once(&selection.cwd).chain(&selection.workspace_roots) {
+            if let Ok(local) = path.to_abs_path() {
+                paths.extend(existing_workspace_path(&local)?);
+            }
+        }
+    }
+    Ok(paths)
+}
