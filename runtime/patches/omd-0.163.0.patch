+use crate::mods::intercept::settled_by;
+use codex_api::request_observer::ResponseAttempt;
+use codex_api::request_observer::ResponseObserver;
+use codex_client::EncodedJsonBody;
+use codex_client::Request;
+use codex_client::TransportError;
+use codex_omd::Admission;
+use codex_omd::Task;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Rates {
+    pub input_microusd_per_million: u64,
+    pub cached_microusd_per_million: u64,
+    #[serde(default)]
+    pub cache_write_microusd_per_million: Option<u64>,
+    pub output_microusd_per_million: u64,
+    pub reservation_microusd: u64,
+    pub max_output_tokens: u64,
+    pub input_token_ceiling: u64,
+    pub included_subscription: bool,
+    #[serde(default)]
+    pub external_subscription: bool,
+    #[serde(default)]
+    pub provider_billed: bool,
+}
+
+const COST_SNAPSHOT_INTERVAL: Duration = Duration::from_secs(1);
+
+/// Per snapshot path: when it was last written and whether a later change is still unwritten.
+static COST_SNAPSHOTS: Mutex<BTreeMap<std::path::PathBuf, (Instant, bool)>> =
+    Mutex::new(BTreeMap::new());
+
+/// The append-only task journal is the durable record; this snapshot is rewritten in full, so request-path writes coalesce to one a second and flush at turn end.
+fn persist_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let due = COST_SNAPSHOTS.lock().map_or(true, |mut snapshots| {
+        match snapshots.get_mut(&account.cost_capture) {
+            Some((written, dirty)) if written.elapsed() < COST_SNAPSHOT_INTERVAL => {
+                *dirty = true;
+                false
+            }
+            _ => {
+                snapshots.insert(account.cost_capture.clone(), (Instant::now(), false));
+                true
+            }
+        }
+    });
+    if due {
+        write_cost_capture(account, false)?;
+    }
+    Ok(())
+}
+
+fn flush_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let dirty = COST_SNAPSHOTS
+        .lock()
+        .ok()
+        .and_then(|mut snapshots| snapshots.remove(&account.cost_capture))
+        .is_some_and(|(_, dirty)| dirty);
+    if dirty {
+        write_cost_capture(account, true)?;
+    }
+    Ok(())
+}
+
+fn write_cost_capture(account: &Account, durable: bool) -> Result<(), TransportError> {
+    let bytes =
+        serde_json::to_vec(&account.task.cost_capture().map_err(denied)?).map_err(denied)?;
+    let (directory, name) = account
+        .cost_capture
+        .parent()
+        .zip(
+            account
+                .cost_capture
+                .file_name()
+                .and_then(|name| name.to_str()),
+        )
+        .ok_or_else(|| denied("cost_capture_path_invalid"))?;
+    crate::persist(directory, name, &bytes, durable).map_err(denied)
+}
+
+pub(crate) fn billing(rates: Option<&Rates>) -> &'static str {
+    match rates {
+        Some(rates) if rates.provider_billed => "provider_billed",
+        Some(rates) if !rates.included_subscription => "explicit_paid_api_grant",
+        _ => "included_subscription",
+    }
+}
