+    }
+
+    pub fn event_scoped_with(
+        &mut self,
+        event: &str,
+        mut payload: impl FnMut(&str) -> Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    ) -> Vec<(String, Result<Value>)> {
+        let ids = self.event_ids(event);
+        ids.into_iter()
+            .map(|id| {
+                let result = self.invoke_scoped_with(
+                    &id,
+                    self.generation,
+                    event,
+                    "",
+                    payload(&id),
+                    &active,
+                    &mut host,
+                );
+                (id, result)
+            })
+            .collect()
+    }
