+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+use unicode_segmentation::UnicodeSegmentation;
+use unicode_width::UnicodeWidthStr;
+
+use crate::omd::LockExt;
+pub(crate) use codex_omd::client_surface::BLIT_FRAME as FRAME;
+use codex_omd::client_surface::BLIT_QUEUE_BYTES as QUEUE_BYTES;
+use codex_omd::client_surface::BLIT_QUEUE_UPDATES as QUEUE_UPDATES;
+use codex_omd::client_surface::Blit as Update;
+use codex_omd::client_surface::BlitCell as Cell;
+use codex_omd::client_surface::BlitContent;
+const RASTERS_PER_MOD: usize = 16;
+const HIDDEN_RETRY: Duration = Duration::from_millis(250);
+
+struct Raster {
+    owner: String,
+    binding: Option<u64>,
+    width: u16,
+    height: u16,
+    cells: Vec<Cell>,
+    frame: Option<BlitContent>,
+    drawn: bool,
+    queue: VecDeque<Update>,
+    queued_bytes: usize,
+    applied: Option<Instant>,
+    frames: u64,
+    shown: u64,
+    placed: Option<((u32, u32), (u16, u16))>,
+}
+
+impl Raster {
+    fn new(owner: &str, width: u16, height: u16) -> Self {
+        Self {
+            owner: owner.to_owned(),
+            binding: None,
+            width,
+            height,
+            cells: vec![Cell::default(); usize::from(width) * usize::from(height)],
+            frame: None,
+            drawn: false,
+            queue: VecDeque::new(),
+            queued_bytes: 0,
+            applied: None,
+            frames: 0,
+            shown: 0,
+            placed: None,
+        }
+    }
+
+    fn apply(&mut self, update: Update) {
+        let _stage = codex_omd::frame_metrics::stage("raster_apply");
+        match update.content {
+            BlitContent::Cells { rect, cells } => {
+                self.frame = None;
+                let mut cells = cells.into_iter();
+                for row in rect.y..rect.y + rect.height {
+                    for column in rect.x..rect.x + rect.width {
+                        if let Some(cell) = cells.next() {
+                            self.cells[usize::from(row) * usize::from(self.width)
+                                + usize::from(column)] = cell;
+                        }
+                    }
+                }
+            }
+            frame @ (BlitContent::Image { .. } | BlitContent::Pixels(_)) => {
+                self.cells.fill(Cell::default());
+                self.frame = Some(frame);
+            }
+            BlitContent::Encoded { .. } | BlitContent::Source(_) => {}
+        }
+        self.queued_bytes -= update.bytes;
+        self.frames += 1;
+    }
+
+    /// Applies at most one queued update per frame interval; returns the wait for the next one.
+    fn advance(&mut self, now: Instant) -> Option<Duration> {
+        if self.queue.is_empty() {
+            return None;
+        }
+        let due = self.applied.map_or(Duration::ZERO, |applied| {
+            FRAME.saturating_sub(now - applied)
+        });
+        if !due.is_zero() {
+            return Some(due);
+        }
+        let update = self.queue.pop_front()?;
+        self.apply(update);
+        let applied = self.next_tick(now);
+        self.applied = Some(applied);
+        (!self.queue.is_empty()).then(|| FRAME.saturating_sub(now - applied))
+    }
+
+    fn next_tick(&self, now: Instant) -> Instant {
+        self.applied
+            .filter(|applied| now.saturating_duration_since(*applied) < FRAME * 2)
+            .map_or(now, |applied| applied + FRAME)
+    }
+
+    fn hidden(&self, now: Instant) -> bool {
+        self.frames != self.shown
+            && self
+                .applied
+                .is_some_and(|applied| now.saturating_duration_since(applied) >= FRAME * 4)
+    }
+}
+
+static RASTERS: Mutex<BTreeMap<String, Raster>> = Mutex::new(BTreeMap::new());
+
+fn rasters() -> std::sync::MutexGuard<'static, BTreeMap<String, Raster>> {
+    RASTERS.locked()
+}
