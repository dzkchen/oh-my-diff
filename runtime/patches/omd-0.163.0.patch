+pub(crate) fn resource_binding(
+    caller: &str,
+    thread: Option<&str>,
+) -> Result<(codex_omd::scoped_data::ScopedDataHost, PathBuf), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store.ok_or("mod store is not configured")?;
+    let host = codex_omd::client_surface::resource_host(&store, &paths.repository, caller, thread)?;
+    Ok((host, store))
+}
+
+fn configured_routes(paths: &crate::omd::ModPaths) -> Vec<(String, String)> {
+    let Some(store) = &paths.store else {
+        return Vec::new();
+    };
+    std::fs::read(store.join("host.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .and_then(|config| config["routes"].as_array().cloned())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|route| {
+            route["roles"]
+                .as_array()
+                .is_some_and(|roles| roles.iter().any(|role| role == "lead"))
+        })
+        .filter_map(|route| {
+            Some((
+                route["model"].as_str()?.to_owned(),
+                route["provider"].as_str()?.to_owned(),
+            ))
+        })
+        .collect()
+}
+
+fn store(paths: &crate::omd::ModPaths) -> std::io::Result<PathBuf> {
+    paths
+        .store
+        .clone()
+        .ok_or_else(|| std::io::Error::other("mod store is not configured"))
+}
