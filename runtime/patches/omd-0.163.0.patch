+        receipt(
+            &changed,
+            &acceptance,
+            "first",
+            json!([]),
+            json!(["issue.one"]),
+        ),
+        receipt(
+            &changed,
+            &"e".repeat(64),
+            "second",
+            json!([]),
+            json!(["issue.one"]),
+        ),
+    ] {
+        assert!(codex_omd::replay_finding_receipts(&[blocker.clone(), invalid]).is_err());
+    }
+    let resolved = codex_omd::replay_finding_receipts(&[
+        blocker,
+        receipt(
+            &changed,
+            &acceptance,
+            "second",
+            json!([]),
+            json!(["issue.one"]),
+        ),
+    ])
+    .unwrap();
+    assert_eq!(
+        resolved["issue.one"]
+            .resolution
+            .as_ref()
+            .unwrap()
+            .producer
+            .handle
+            .as_deref(),
+        Some("second")
+    );
+    let reopened = codex_omd::replay_finding_receipts(&[
+        receipt(
+            &candidate,
+            &acceptance,
+            "first",
+            json!([{"fingerprint":"issue.one","severity":"blocking","summary":"Broken"}]),
+            json!([]),
+        ),
+        receipt(
+            &changed,
+            &acceptance,
+            "second",
+            json!([]),
+            json!(["issue.one"]),
