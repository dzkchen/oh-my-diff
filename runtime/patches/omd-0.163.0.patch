+pub(crate) fn current_thread() -> Option<String> {
+    with(|state| state.thread.clone())
+}
+
+fn call_binding(caller: &str) -> Value {
+    let status = crate::omd::mod_status().unwrap_or_default();
+    let source = status["mods"]
+        .as_array()
+        .and_then(|mods| {
+            mods.iter()
+                .find(|item| item["id"] == caller && item["error"].is_null())
+        })
+        .map(|item| item["sha256"].clone());
+    json!({"thread": current_thread(), "repository": crate::omd::mod_paths().map(|paths| paths.repository), "epoch": CONTEXT_EPOCH.load(std::sync::atomic::Ordering::Acquire), "generation": status["generation"], "source": source})
+}
