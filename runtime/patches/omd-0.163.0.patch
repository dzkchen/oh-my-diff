+
+    pub fn event_guarded_with(
+        &mut self,
+        event: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+        host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    ) -> Vec<(String, Result<Value>)> {
