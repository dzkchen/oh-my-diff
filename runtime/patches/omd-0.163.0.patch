+    let writer_capabilities = strings(&["exec", "fs.write", "network"]);
+    let writer = caller(&writer_capabilities, &[], Origin::UserCommand);
+    let written = host
+        .call(&writer, "exec.run", json!({"program":"sh","argv":["-c","printf x > out.txt"],"write":true,"network":"loopback"}))
