+use super::*;
+use crate::keymap::RuntimeKeymap;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::sync::mpsc::UnboundedReceiver;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn request(changed: bool) -> ModPanelRequest {
+    let mut arguments = json!({
+        "title": "Demo",
+        "subtitle": "Preview\nsecond line",
+        "tabs": [{"id": "main", "title": "Main"}, {"id": "more", "title": "More"}],
+        "search": true,
+        "action": {"command": "panel", "args": "set"},
+        "items": [
+            {"id": "alpha", "tab": "main", "label": "Alpha", "kind": "toggle", "value": changed},
+            {"id": "mode", "tab": "main", "label": "Mode", "kind": "choice", "value": "b",
+                "options": [{"value": "a", "label": "A"}, {"value": "b", "label": "B"}]},
+            {"id": "name", "tab": "more", "label": "Name", "kind": "text", "value": "x"},
+            {"id": "reset", "tab": "more", "label": "Reset", "kind": "action"},
+        ],
+    });
+    if changed {
+        arguments["items"].as_array_mut().unwrap().insert(
+            2,
+            json!({"id": "added", "tab": "more", "label": "Added", "kind": "action"}),
+        );
+    }
+    ModPanelRequest::parse("demo", &arguments).expect("valid panel")
+}
+
+fn view() -> (ModPanelView, UnboundedReceiver<AppEvent>) {
+    let (tx, rx) = unbounded_channel();
+    let view = ModPanelView::new(
+        "demo".into(),
+        request(false),
+        AppEventSender::new(tx),
+        RuntimeKeymap::defaults().list,
+    );
+    (view, rx)
+}
+
+fn press(view: &mut ModPanelView, code: KeyCode) {
+    view.handle_key_event(KeyEvent::new(code, KeyModifiers::NONE));
+}
+
+fn sent(rx: &mut UnboundedReceiver<AppEvent>) -> Vec<String> {
+    std::iter::from_fn(|| rx.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::ModPanelCommand { command, args } => Some(format!("{command} {args}")),
+            AppEvent::ModPanelPrompt {
+                title,
+                value,
+                command,
+                args,
+            } => Some(format!("prompt {title}={value} {command} {args}")),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn rejects_panels_that_name_another_mods_command_or_an_unknown_tab() {
+    let mut arguments = json!({"title": "T", "action": {"command": "other:cmd"},
+        "items": [{"id": "a", "label": "A", "kind": "action"}]});
+    assert!(ModPanelRequest::parse("demo", &arguments).is_err());
+    arguments["action"]["command"] = json!("cmd");
+    arguments["items"][0]["tab"] = json!("missing");
+    assert!(ModPanelRequest::parse("demo", &arguments).is_err());
+    arguments["items"][0] = json!({"id": "a", "label": "A", "kind": "choice",
+        "options": [{"value": "x", "label": "X"}, {"value": "x", "label": "Y"}]});
+    assert!(ModPanelRequest::parse("demo", &arguments).is_err());
+    arguments["items"][0]["options"][1]["value"] = json!("y z");
+    assert!(ModPanelRequest::parse("demo", &arguments).is_err());
+}
+
+#[test]
+fn keys_toggle_cycle_prompt_and_run_through_the_mods_command() {
+    let (mut view, mut rx) = view();
+    press(&mut view, KeyCode::Char(' '));
+    press(&mut view, KeyCode::Down);
+    press(&mut view, KeyCode::Enter);
+    press(&mut view, KeyCode::Right);
+    press(&mut view, KeyCode::Enter);
+    press(&mut view, KeyCode::Down);
+    press(&mut view, KeyCode::Char(' '));
+    assert_eq!(
+        sent(&mut rx),
+        [
+            "demo:panel set alpha true",
+            "demo:panel set mode a",
+            "prompt Name=x demo:panel set name",
+            "demo:panel set reset",
+        ]
+    );
+    assert!(!view.is_complete());
+    press(&mut view, KeyCode::Esc);
+    assert!(view.is_complete());
+}
+
+#[test]
+fn replacing_keeps_the_tab_selection_and_search() {
+    let (mut view, _rx) = view();
+    press(&mut view, KeyCode::Right);
+    press(&mut view, KeyCode::Down);
+    view.replace(request(true));
+    assert_eq!(view.active_tab_id(), Some("more"));
+    assert_eq!(view.shown()[view.selected_index().unwrap()].id, "reset");
+    press(&mut view, KeyCode::Char('/'));
+    for c in "mod".chars() {
+        press(&mut view, KeyCode::Char(c));
+    }
+    view.replace(request(true));
+    assert_eq!(view.search_query(), Some("mod"));
+    assert_eq!(view.shown()[view.selected_index().unwrap()].id, "mode");
+    press(&mut view, KeyCode::Char('z'));
+    press(&mut view, KeyCode::Enter);
+    assert!(!view.is_complete());
+    press(&mut view, KeyCode::Esc);
+    view.replace(
+        ModPanelRequest::parse(
+            "demo",
+            &json!({"title": "Demo", "action": {"command": "panel"},
+                "items": [{"id": "apply", "label": "Apply", "kind": "action"}]}),
+        )
+        .expect("valid panel"),
+    );
+    view.replace(request(false));
+    assert_eq!(view.active_tab_id(), Some("more"));
+}
