+                environment_id: "remote".into(),
+                ..local.clone()
+            }],
+            0,
+        ),
+        (
+            "other cwd",
+            vec![TurnInputEnvironment {
+                cwd: PathUri::from_host_native_path(fixture._dir.path()).unwrap(),
+                ..local.clone()
+            }],
+            0,
+        ),
+        ("multiple", vec![local.clone(), local.clone()], 0),
+        (
+            "narrowed turn read",
+            vec![TurnInputEnvironment {
+                fs: &denied_access,
+                ..local.clone()
+            }],
+            0,
+        ),
+        (
+            "missing sandbox context",
+            vec![TurnInputEnvironment {
+                fs: &unavailable_access,
+                ..local
+            }],
+            0,
+        ),
+    ] {
+        let fragments = mods(&fixture.core)
+            .contribute(
+                TurnInputContext {
+                    turn_id: "turn".into(),
+                    user_input: vec![UserInput::Text {
+                        text: "@plain.txt".into(),
+                        text_elements: Vec::new(),
+                    }],
+                    environments,
+                },
+                None,
+                &ExtensionData::new("session"),
+                &thread_store,
+                &ExtensionData::new("turn"),
+            )
+            .await;
+        assert_eq!(fragments.len(), expected, "{label}");
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/intercept.rs b/codex-rs/ext/omd/src/mods/intercept.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2b3fb7621f9736841bb55986115f912f3616bf60
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/intercept.rs
@@ -0,0 +1,260 @@
+use super::*;
+use codex_omd::data_store::Origin;
+use operations::Caller;
+
+/// Runs a continuation chain off the async runtime; each interceptor's host calls run under its own grants.
+#[allow(clippy::too_many_arguments)]
+pub(super) async fn chain(
+    core: Arc<Core>,
+    lead: Arc<Lead>,
+    runtime: Arc<Mutex<ModHost>>,
+    surface: &'static str,
+    required: bool,
+    input: Value,
+    origin: Value,
+    cancelled: Arc<AtomicBool>,
+    executor: impl FnMut(Value) -> std::io::Result<Value> + Send + 'static,
+) -> Result<codex_omd::ModChain, String> {
+    let secondary = !Arc::ptr_eq(&runtime, &core.runtime);
+    let (facts, generation) = {
+        let runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned")?;
+        (facts(&runtime), runtime.generation())
+    };
+    let (requests, mut receiver) = tokio::sync::mpsc::channel::<HostRequest>(1);
+    let (flag, thread) = (cancelled.clone(), lead.thread.to_string());
+    let handle = tokio::task::spawn_blocking(move || {
+        let _thread = codex_omd::StateThread::enter(Some(thread));
+        let active = || !flag.load(Ordering::Acquire);
+        codex_omd::intercept_shared(
+            &runtime,
+            surface,
+            required,
+            input,
+            origin,
+            active,
+            |caller, request| {
+                if !operations::event_allows("intercept", &request.operation) {
+                    return Err(std::io::Error::other(format!(
+                        "host_operation_unavailable: {} is not available to interceptors",
+                        request.operation
+                    )));
+                }
+                forward(&requests, &facts, caller, request, &active)
+            },
+            executor,
+        )
+        .map_err(|error| error.to_string())
+    });
+    while let Some(call) = receiver.recv().await {
+        let generation = if secondary {
+            let authority = core.runtime.clone();
+            let caller = call.caller.clone();
+            let source = call.source.clone();
+            let capabilities = call
+                .grants
+                .as_ref()
+                .map(|grants| grants.capabilities.clone());
+            let flag = cancelled.clone();
+            let current = tokio::task::spawn_blocking(move || {
+                let mut runtime = authority
+                    .lock()
+                    .map_err(|_| "mod_runtime_poisoned".to_owned())?;
+                runtime
+                    .refresh_guarded(&|| !flag.load(Ordering::Acquire))
+                    .map_err(|error| error.to_string())?;
+                let grants = runtime.grants(&caller).ok_or("host_caller_inactive")?;
+                if grants.source_sha256 != source || Some(grants.capabilities) != capabilities {
+                    return Err("callback_authority_changed".into());
+                }
+                Ok(runtime.generation())
+            })
+            .await
+            .map_err(|error| error.to_string())
+            .and_then(|result| result);
+            match current {
+                Ok(generation) => generation,
+                Err(error) => {
+                    let _ = call.reply.send(Err(std::io::Error::other(error)));
+                    continue;
+                }
+            }
+        } else {
+            generation
+        };
+        let value = operations::dispatch(
+            &core,
+            &lead,
+            Caller {
+                id: &call.caller,
+                source: &call.source,
+                grants: call.grants,
+                generation,
+                origin: Origin::Event,
+                record_changes: true,
+            },
+            None,
+            call.request,
+            &cancelled,
+        )
+        .await;
+        let _ = call.reply.send(value.map_err(std::io::Error::other));
+    }
+    let result = handle.await.map_err(|error| error.to_string())?;
+    core.cleanup_failed(Some(&lead)).await;
+    result
+}
+
+pub(crate) fn settled_by(chain: &codex_omd::ModChain) -> String {
+    chain
+        .trace
+        .iter()
+        .rev()
+        .find(|entry| matches!(entry["outcome"].as_str(), Some("returned" | "caught")))
+        .and_then(|entry| entry["mod"].as_str())
+        .unwrap_or("mod")
+        .to_owned()
+}
+
+pub(super) fn install_notifier(core: &Arc<Core>) {
+    let notified = Arc::downgrade(core);
+    core.host.accounts.install_mod_notifier(Arc::new(
+        move |event: &'static str, payload: Value| {
+            if let Some(core) = notified.upgrade() {
+                if event == "model_response" {
+                    core.inventory.usage(&payload);
+                    if let Some(thread) = payload["scope"]["thread_id"].as_str() {
+                        core.autonomy
+                            .charge(&core.inventory.root_thread(thread), &payload);
+                    }
+                }
+                expansion::broadcast(&core.expansion, event, payload);
+            }
+        },
+    ));
+}
+
+pub(super) fn dispatcher(core: &Arc<Core>) -> codex_omd::host::SessionDispatcher {
+    let weak = Arc::downgrade(core);
+    let session = tokio::runtime::Handle::try_current().ok();
+    let dispatcher: codex_omd::host::SessionDispatcher = Arc::new(
+        move |thread: &str,
+              caller: &str,
+              expected_source: Option<&str>,
+              policy: Option<&Value>,
+              request: ModHostCall,
+              active: &dyn Fn() -> bool| {
+            let unavailable = |reason: &str| {
+                std::io::Error::other(format!("host_operation_unavailable: {reason}"))
+            };
+            let core = weak
+                .upgrade()
+                .ok_or_else(|| unavailable("native host stopped"))?;
+            let (handle, worker) = match tokio::runtime::Handle::try_current() {
+                Ok(handle)
+                    if handle.runtime_flavor() == tokio::runtime::RuntimeFlavor::MultiThread =>
+                {
+                    (
+                        session
+                            .clone()
+                            .ok_or_else(|| unavailable("no session runtime"))?,
+                        true,
+                    )
+                }
+                Ok(_) => {
+                    return Err(unavailable(
+                        "host calls from this thread need the multi-threaded session runtime",
+                    ));
+                }
+                Err(_) => (
+                    session
+                        .clone()
+                        .ok_or_else(|| unavailable("no session runtime"))?,
+                    false,
+                ),
+            };
+            if !operations::event_allows("intercept", &request.operation) {
+                return Err(unavailable(&request.operation));
+            }
+            let lead = ThreadId::from_string(thread)
+                .ok()
+                .and_then(|thread| core.expansion.thread(thread))
+                .ok_or_else(|| unavailable("no session for this thread"))?;
+            let ((source, grants), generation) = {
+                let runtime = core
+                    .runtime
+                    .lock()
+                    .map_err(|_| std::io::Error::other("mod_runtime_poisoned"))?;
+                (
+                    facts(&runtime).remove(caller).unwrap_or_default(),
+                    runtime.generation(),
+                )
+            };
+            let cancelled = Arc::new(AtomicBool::new(false));
+            if expected_source.is_some_and(|expected| expected != source) {
+                return Err(std::io::Error::other("host_caller_source_changed"));
+            }
+            let policy: Option<codex_protocol::models::PermissionProfile> =
+                policy.cloned().map(serde_json::from_value).transpose()?;
+            let _cancellation = Cancellation(cancelled.clone());
+            let stopped = AtomicBool::new(false);
+            let operation = || {
+                handle.block_on(async {
+                    tokio::select! {
+                        value = operations::dispatch_with_policy(
+                            &core,
+                            &lead,
+                            Caller {
+                                id: caller,
+                                source: &source,
+                                grants,
+                                generation,
+                                origin: Origin::Event,
+                                record_changes: true,
+                            },
+                            None,
+                            request,
+                            &cancelled,
+                            policy.as_ref(),
+                        ) => value.map_err(std::io::Error::other),
+                        () = async {
+                            while !stopped.load(Ordering::Acquire) {
+                                tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+                            }
+                        } => Err(std::io::Error::other("callback_cancelled")),
+                    }
+                })
+            };
+            // Callers include small-stack callback threads; the future is built and polled on a thread with a Tokio worker's stack.
+            let wait = || {
+                std::thread::scope(|scope| {
+                    let (tx, rx) = std::sync::mpsc::channel();
+                    std::thread::Builder::new()
+                        .name("omd-host-call".into())
+                        .stack_size(codex_async_utils::THREAD_STACK_SIZE_BYTES)
+                        .spawn_scoped(scope, move || {
+                            let _ = tx.send(operation());
+                        })?;
+                    loop {
+                        match rx.recv_timeout(std::time::Duration::from_millis(20)) {
+                            Ok(result) => return result,
+                            Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {
+                                if !active() {
+                                    stopped.store(true, Ordering::Release);
+                                }
+                            }
+                            Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {
+                                return Err(unavailable("host operation thread failed"));
+                            }
+                        }
+                    }
+                })
+            };
+            if worker {
+                tokio::task::block_in_place(wait)
+            } else {
+                wait()
+            }
+        },
+    );
+    dispatcher
+}
diff --git a/codex-rs/ext/omd/src/mods/inventory.rs b/codex-rs/ext/omd/src/mods/inventory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..962833362be4ebb068c8c0cb89f999c700415283
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/inventory.rs
@@ -0,0 +1,194 @@
+use super::*;
+use codex_omd::peers::now_ms;
+use std::collections::BTreeSet;
+
+const ANSWER_CHARS: usize = 4096;
+const FINISHED_LIMIT: usize = 64;
+
+/// Session-wide agent records; observing one grants no control over it.
+#[derive(Default)]
+pub(super) struct Inventory {
+    records: Mutex<BTreeMap<String, Value>>,
+}
+
+impl Inventory {
+    pub(super) fn start(&self, thread: &str, fields: Value) -> Value {
+        let mut record = json!({"agent_id": null, "thread_id": thread,
+            "parent": {"thread_id": null, "agent_id": null}, "origin": "native", "owner": null,
+            "definition": null, "role": null, "status": "running", "started_at_ms": now_ms(),
+            "ended_at_ms": null, "duration_ms": null, "turns": 0, "last_turn": null, "answer": null,
+            "usage": {"requests": 0, "input_tokens": 0, "output_tokens": 0, "cached_tokens": 0,
+                "microusd": 0, "basis": "unknown", "source": null}, "reason": null});
+        if let (Some(record), Some(fields)) = (record.as_object_mut(), fields.as_object()) {
+            record.extend(fields.clone());
+        }
+        if let Ok(mut records) = self.records.lock() {
+            let finished = records
+                .iter()
+                .filter(|(_, record)| record["status"] != "running")
+                .map(|(thread, record)| (record["ended_at_ms"].as_u64(), thread.clone()))
+                .collect::<BTreeSet<_>>();
+            for (_, thread) in finished
+                .iter()
+                .take(finished.len().saturating_sub(FINISHED_LIMIT - 1))
+            {
+                records.remove(thread);
+            }
+            records.insert(thread.to_owned(), record.clone());
+        }
+        record
+    }
+
+    fn update(&self, thread: &str, change: impl FnOnce(&mut Value)) -> Option<Value> {
+        let mut records = self.records.lock().ok()?;
+        let record = records.get_mut(thread)?;
+        change(record);
+        Some(record.clone())
+    }
+
+    pub(super) fn contains(&self, thread: &str) -> bool {
+        self.records
+            .lock()
+            .is_ok_and(|records| records.contains_key(thread))
+    }
+
+    pub(super) fn answer(&self, thread: &str, text: &str) {
+        self.update(thread, |record| {
+            record["answer"] = json!(text.chars().take(ANSWER_CHARS).collect::<String>());
+        });
+    }
+
+    pub(super) fn turn(
+        &self,
+        thread: &str,
+        turn_id: &str,
+        outcome: &str,
+        error: Value,
+    ) -> Option<Value> {
+        self.update(thread, |record| {
+            record["turns"] = json!(record["turns"].as_u64().unwrap_or(0) + 1);
+            record["last_turn"] = json!({"turn_id": turn_id, "outcome": outcome, "at_ms": now_ms(),
+                "answer": record["answer"], "error": error});
+        })
+    }
+
+    /// Adds one `model_response` report to its thread's usage; unpriced spend makes the total partial.
+    pub(super) fn usage(&self, response: &Value) {
+        let Some(thread) = response["scope"]["thread_id"].as_str() else {
+            return;
+        };
+        let tokens = |pointer: &str| response["usage"].pointer(pointer).and_then(Value::as_u64);
+        self.update(thread, |record| {
+            let usage = &mut record["usage"];
+            if usage["source"] != "accounting" {
+                *usage = json!({"requests": 0, "input_tokens": 0, "output_tokens": 0,
+                    "cached_tokens": 0, "microusd": 0, "basis": "unknown", "source": "accounting"});
+            }
+            let add = |usage: &mut Value, key: &str, amount: Option<u64>| {
+                usage[key] = json!(usage[key].as_u64().unwrap_or(0) + amount.unwrap_or(0));
+            };
+            add(usage, "requests", Some(1));
+            add(usage, "input_tokens", tokens("/input_tokens"));
+            add(usage, "output_tokens", tokens("/output_tokens"));
+            add(
+                usage,
+                "cached_tokens",
+                tokens("/input_tokens_details/cached_tokens"),
+            );
+            let priced = response["cost"]["microusd"].as_u64();
+            add(usage, "microusd", priced);
+            let first = usage["requests"] == 1;
+            usage["basis"] = json!(match (usage["basis"].as_str(), priced) {
+                (Some("unknown"), None) => "unknown",
+                (Some("unknown"), Some(_)) if first => "settled",
+                (Some("settled"), Some(_)) => "settled",
+                _ => "partial",
+            });
+        });
+    }
+
+    /// Engine token totals for agents whose requests bypass OMD accounting; cost stays unknown.
+    pub(super) fn tokens(&self, thread: &str, total: &codex_protocol::protocol::TokenUsage) {
+        self.update(thread, |record| {
+            if record["usage"]["source"] == "accounting" {
+                return;
+            }
+            let count = |value: i64| u64::try_from(value).unwrap_or(0);
+            record["usage"] = json!({"requests": null, "input_tokens": count(total.input_tokens),
+                "output_tokens": count(total.output_tokens), "cached_tokens": count(total.cached_input_tokens),
+                "microusd": null, "basis": "unknown", "source": "engine"});
+        });
+    }
+
+    pub(super) fn end(&self, thread: &str, status: &str, reason: Option<String>) -> Option<Value> {
+        self.update(thread, |record| {
+            if record["status"] != "running" {
+                return;
+            }
+            let ended = now_ms();
+            record["status"] = json!(status);
+            record["reason"] = json!(reason);
+            record["ended_at_ms"] = json!(ended);
+            record["duration_ms"] =
+                json!(ended.saturating_sub(record["started_at_ms"].as_u64().unwrap_or(ended)));
+        })
+        .filter(|record| record["reason"] == json!(reason) && record["status"] == status)
+    }
+
+    /// The session thread at the root of `thread`'s parent chain; a thread without an agent record is its own root.
+    pub(super) fn root_thread(&self, thread: &str) -> String {
+        let Ok(records) = self.records.lock() else {
+            return thread.to_owned();
+        };
+        let mut root = thread;
+        for _ in 0..16 {
+            match records
+                .get(root)
+                .and_then(|record| record["parent"]["thread_id"].as_str())
+            {
+                Some(parent) => root = parent,
+                None => break,
+            }
+        }
+        root.to_owned()
+    }
+
+    pub(super) fn list(&self) -> Vec<Value> {
+        self.records
+            .lock()
+            .map(|records| records.values().cloned().collect())
+            .unwrap_or_default()
+    }
+}
+
+/// Publishes an `agent` lifecycle event to every observer, in order, under the session thread's state.
+pub(super) fn notify(
+    runtime: &Arc<Mutex<ModHost>>,
+    inventory: &Inventory,
+    phase: &str,
+    record: Value,
+) {
+    type Delivery = (Arc<Mutex<ModHost>>, Option<String>, Value);
+    static QUEUE: std::sync::OnceLock<std::sync::mpsc::Sender<Delivery>> =
+        std::sync::OnceLock::new();
+    let queue = QUEUE.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<Delivery>();
+        std::thread::spawn(move || {
+            for (runtime, thread, payload) in receiver {
+                let _thread = codex_omd::StateThread::enter(thread);
+                if let Ok(mut runtime) = runtime.lock() {
+                    let _ = runtime.event("agent", payload);
+                }
+            }
+        });
+        sender
+    });
+    let thread = record["parent"]["thread_id"]
+        .as_str()
+        .map(|parent| inventory.root_thread(parent));
+    let _ = queue.send((
+        runtime.clone(),
+        thread,
+        json!({"phase": phase, "agent": record}),
+    ));
+}
diff --git a/codex-rs/ext/omd/src/mods/launch_snapshot.rs b/codex-rs/ext/omd/src/mods/launch_snapshot.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1dbd7f502d56bea9d2e2a5d380624f5be22f93cd
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/launch_snapshot.rs
@@ -0,0 +1,187 @@
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::Read;
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+
+pub(super) struct Tree {
+    pub files: BTreeMap<PathBuf, Vec<u8>>,
+    pub links: BTreeMap<PathBuf, PathBuf>,
+    root: PathBuf,
+}
+
+pub(super) fn capture(root: &Path) -> Result<Tree, String> {
+    let canonical = root.canonicalize().map_err(|error| error.to_string())?;
+    if canonical != root || !root.is_dir() {
+        return Err("service_code_root_invalid".into());
+    }
+    let mut tree = Tree {
+        files: BTreeMap::new(),
+        links: BTreeMap::new(),
+        root: canonical,
+    };
+    let mut pending = vec![root.to_path_buf()];
+    let mut total = 0;
+    let mut entries = 0;
+    while let Some(directory) = pending.pop() {
+        for entry in fs::read_dir(directory).map_err(|error| error.to_string())? {
+            let entry = entry.map_err(|error| error.to_string())?;
+            let path = entry.path();
+            let kind = entry.file_type().map_err(|error| error.to_string())?;
+            entries += 1;
+            if entries > 8192 {
+                return Err("service_source_limit".into());
+            }
+            if kind.is_symlink() {
+                let target = fs::read_link(&path).map_err(|error| error.to_string())?;
+                if target.is_absolute()
+                    || !path
+                        .canonicalize()
+                        .map_err(|error| error.to_string())?
+                        .starts_with(root)
+                {
+                    return Err("service_dependency_escape".into());
+                }
+                tree.links.insert(path, target);
+            } else if kind.is_dir() {
+                pending.push(path);
+            } else if kind.is_file() {
+                let mut bytes = Vec::new();
+                let file = fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+                    .open(&path)
+                    .map_err(|error| error.to_string())?;
+                if !file
+                    .metadata()
+                    .map_err(|error| error.to_string())?
+                    .is_file()
+                {
+                    return Err("service_dependency_type_invalid".into());
+                }
+                file.take(64 * 1024 * 1024 + 1)
+                    .read_to_end(&mut bytes)
+                    .map_err(|error| error.to_string())?;
+                total += bytes.len();
+                if bytes.len() > 64 * 1024 * 1024 || total > 128 * 1024 * 1024 {
+                    return Err("service_source_limit".into());
+                }
+                tree.files.insert(path, bytes);
+            } else {
+                return Err("service_dependency_type_invalid".into());
+            }
+        }
+    }
+    Ok(tree)
+}
+
+pub(super) fn digest(tree: &Tree) -> String {
+    let mut rows = BTreeMap::new();
+    for (path, bytes) in &tree.files {
+        rows.insert(
+            path.strip_prefix(&tree.root)
+                .unwrap()
+                .to_string_lossy()
+                .into_owned(),
+            ("file", super::execution::hash(bytes)),
+        );
+    }
+    for (path, target) in &tree.links {
+        rows.insert(
+            path.strip_prefix(&tree.root)
+                .unwrap()
+                .to_string_lossy()
+                .into_owned(),
+            ("link", target.to_string_lossy().into_owned()),
+        );
+    }
+    let rows = rows
+        .into_iter()
+        .map(|(path, (kind, value))| (path, kind, value))
+        .collect::<Vec<_>>();
+    super::execution::hash(&serde_json::to_vec(&rows).unwrap())
+}
+
+pub(super) fn path(root: &Path, source: &Path) -> Result<PathBuf, String> {
+    if source
+        .components()
+        .any(|part| matches!(part, std::path::Component::ParentDir))
+    {
+        return Err("service_source_path_invalid".into());
+    }
+    Ok(root.join(
+        source
+            .strip_prefix("/")
+            .map_err(|_| "service_source_path_invalid")?,
+    ))
+}
+
+pub(super) fn materialize(
+    root: &Path,
+    files: &BTreeMap<PathBuf, Vec<u8>>,
+    links: &BTreeMap<PathBuf, PathBuf>,
+) -> Result<tempfile::TempDir, String> {
+    use std::io::Write;
+    let snapshot = tempfile::Builder::new()
+        .prefix("service-code-")
+        .tempdir_in(root)
+        .map_err(|error| error.to_string())?;
+    for (source, bytes) in files {
+        let target = path(snapshot.path(), source)?;
+        fs::create_dir_all(target.parent().unwrap()).map_err(|error| error.to_string())?;
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o500)
+            .open(target)
+            .map_err(|error| error.to_string())?;
+        file.write_all(bytes).map_err(|error| error.to_string())?;
+    }
+    for (source, relative) in links {
+        let target = path(snapshot.path(), source)?;
+        fs::create_dir_all(target.parent().unwrap()).map_err(|error| error.to_string())?;
+        std::os::unix::fs::symlink(relative, target).map_err(|error| error.to_string())?;
+    }
+    fs::set_permissions(snapshot.path(), fs::Permissions::from_mode(0o700))
+        .map_err(|error| error.to_string())?;
+    Ok(snapshot)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn captured_dependencies_are_verified_and_materialized_without_reopening() {
+        let root = tempfile::tempdir().unwrap();
+        let code = root.path().join("code");
+        fs::create_dir(&code).unwrap();
+        let code = code.canonicalize().unwrap();
+        fs::write(code.join("helper.mjs"), "admitted helper").unwrap();
+        fs::write(code.join("dependency.mjs"), "admitted dependency").unwrap();
+        fs::write(code.join("executable"), "#!/bin/sh\nexit 0\n").unwrap();
+        std::os::unix::fs::symlink("dependency.mjs", code.join("link.mjs")).unwrap();
+        let captured = capture(&code).unwrap();
+        let expected = digest(&captured);
+        fs::write(code.join("helper.mjs"), "changed helper").unwrap();
+        fs::write(code.join("dependency.mjs"), "changed dependency").unwrap();
+        assert_ne!(digest(&capture(&code).unwrap()), expected);
+        let snapshot = materialize(root.path(), &captured.files, &captured.links).unwrap();
+        assert!(
+            std::process::Command::new(path(snapshot.path(), &code.join("executable")).unwrap())
+                .status()
+                .unwrap()
+                .success()
+        );
+        assert_eq!(
+            fs::read(path(snapshot.path(), &code.join("helper.mjs")).unwrap()).unwrap(),
+            b"admitted helper"
+        );
+        assert_eq!(
+            fs::read(path(snapshot.path(), &code.join("link.mjs")).unwrap()).unwrap(),
+            b"admitted dependency"
+        );
+        std::os::unix::fs::symlink("../escape", code.join("escape")).unwrap();
+        assert!(capture(&code).is_err());
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/mentions.rs b/codex-rs/ext/omd/src/mods/mentions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b7e24384928422189574c85bc45abb29044076f9
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/mentions.rs
@@ -0,0 +1,255 @@
+use super::*;
+use codex_extension_api::ContentItemKind;
+use codex_extension_api::ContextualUserFragment;
+use codex_extension_api::ExtensionMetrics;
+use codex_extension_api::TurnInputContext;
+use codex_extension_api::TurnInputContributor;
+use codex_protocol::user_input::UserInput;
+
+const MENTIONS: usize = 16;
+const MENTION_BYTES: u64 = 256 * 1024;
+
+struct MentionedFile {
+    path: String,
+    contents: String,
+}
+
+impl ContextualUserFragment for MentionedFile {
+    fn role(&self) -> &'static str {
+        "user"
+    }
+
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("mentions.file".to_string())
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<mentioned_file>", "</mentioned_file>")
+    }
+
+    fn body(&self) -> String {
+        format!("\n<path>{}</path>\n{}\n", self.path, self.contents)
+    }
+}
+
+pub(super) fn mentioned(input: &[UserInput], repository: &std::path::Path) -> Vec<String> {
+    let mut names = Vec::new();
+    for item in input {
+        let UserInput::Text { text, .. } = item else {
+            continue;
+        };
+        let mut consumed = 0;
+        for (index, _) in text.match_indices('@') {
+            if index < consumed {
+                continue;
+            }
+            if !text[..index]
+                .chars()
+                .next_back()
+                .is_none_or(char::is_whitespace)
+            {
+                continue;
+            }
+            let rest = &text[index + 1..];
+            let name = if rest.starts_with('"') {
+                let mut quoted = serde_json::Deserializer::from_str(rest).into_iter::<String>();
+                let Some(Ok(name)) = quoted.next() else {
+                    break;
+                };
+                consumed = index + 1 + quoted.byte_offset();
+                name
+            } else {
+                rest.split(char::is_whitespace)
+                    .next()
+                    .unwrap_or_default()
+                    .trim_end_matches(|c: char| ",.;:!?)]}'\"`".contains(c))
+                    .to_owned()
+            };
+            let name = name.trim_start_matches("./");
+            if names.len() < MENTIONS
+                && !names.iter().any(|known| known == name)
+                && codex_omd::workspace_path(repository, name).is_ok_and(|path| path.is_file())
+            {
+                names.push(name.to_owned());
+            }
+        }
+    }
+    names
+}
+
+impl Mods {
+    async fn mention(
+        &self,
+        lead: &Arc<Lead>,
+        required: bool,
+        name: String,
+        cancelled: &Arc<AtomicBool>,
+    ) -> Option<String> {
+        let thread = lead.thread.to_string();
+        let chain = intercept::chain(
+            self.core.clone(),
+            lead.clone(),
+            self.input_runtime.clone(),
+            "mention",
+            required,
+            json!({"thread_id": thread, "path": name}),
+            json!({"caller": "user", "thread_id": thread}),
+            cancelled.clone(),
+            |input| Ok(json!({"path": input["path"]})),
+        )
+        .await
+        .ok()?;
+        chain.result["path"].as_str().map(str::to_owned)
+    }
+}
+
+impl TurnInputContributor for Mods {
+    fn contribute<'a>(
+        &'a self,
+        input: TurnInputContext<'a>,
+        _metrics: Option<Arc<dyn ExtensionMetrics>>,
+        _session_store: &'a ExtensionData,
+        thread_store: &'a ExtensionData,
+        _turn_store: &'a ExtensionData,
+    ) -> ExtensionFuture<'a, Vec<Box<dyn ContextualUserFragment + Send>>> {
+        Box::pin(async move {
+            let Some(lead) = thread_store.get::<Lead>() else {
+                return Vec::new();
+            };
+            let Ok(authority) = crate::workspace_operations::WorkspaceAuthority::for_environments(
+                &lead,
+                &input.environments,
+            )
+            .await
+            else {
+                return Vec::new();
+            };
+            let (user_input, repository, runtime) = (
+                input.user_input,
+                authority.repository.clone(),
+                self.input_runtime.clone(),
+            );
+            let Ok(Some((names, required))) = tokio::task::spawn_blocking(move || {
+                let names = mentioned(&user_input, &repository);
+                if names.is_empty() {
+                    return None;
+                }
+                let required = runtime.lock().ok()?.intercepts("mention");
+                Some((names, required))
+            })
+            .await
+            else {
+                return Vec::new();
+            };
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let mut paths: Vec<String> = Vec::new();
+            for name in names {
+                let path = match required {
+                    Some(required) => self.mention(&lead, required, name, &cancelled).await,
+                    None => Some(name),
+                };
+                if let Some(path) = path.filter(|path| !paths.contains(path)) {
+                    paths.push(path);
+                }
+            }
+            let repository = authority.repository.clone();
+            tokio::task::spawn_blocking(move || {
+                read_mentions(&repository, paths, |path| {
+                    authority
+                        .call("workspace.read", json!({"paths": [path]}), || {
+                            !cancelled.load(Ordering::Acquire)
+                        })
+                        .ok()
+                })
+            })
+            .await
+            .unwrap_or_default()
+        })
+    }
+}
+
+fn read_mentions(
+    repository: &std::path::Path,
+    paths: Vec<String>,
+    mut read: impl FnMut(&str) -> Option<Value>,
+) -> Vec<Box<dyn ContextualUserFragment + Send>> {
+    let mut budget = MENTION_BYTES;
+    let mut fragments: Vec<Box<dyn ContextualUserFragment + Send>> = Vec::new();
+    for path in paths {
+        let fits = codex_omd::workspace_path(repository, &path)
+            .and_then(std::fs::metadata)
+            .is_ok_and(|metadata| metadata.is_file() && metadata.len() <= budget);
+        let result = fits.then(|| read(&path)).flatten();
+        if let Some(contents) = result
+            .as_ref()
+            .and_then(|read| read["files"][&path]["text"].as_str())
+            .filter(|contents| contents.len() as u64 <= budget)
+        {
+            budget -= contents.len() as u64;
+            fragments.push(Box::new(MentionedFile {
+                contents: contents.to_owned(),
+                path,
+            }));
+        }
+    }
+    fragments
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn quoted_mentions_preserve_filenames_and_reject_unsafe_paths() {
+        let directory = tempfile::tempdir().unwrap();
+        for name in [
+            "report!",
+            "notes \"quoted\".txt",
+            "notes\\file.txt",
+            "report",
+        ] {
+            std::fs::write(directory.path().join(name), name).unwrap();
+        }
+        let input = [UserInput::Text {
+            text: r#"@"report!" @"notes \"quoted\".txt" @"notes\\file.txt""#.into(),
+            text_elements: Vec::new(),
+        }];
+        assert_eq!(
+            mentioned(&input, directory.path()),
+            ["report!", "notes \"quoted\".txt"]
+        );
+    }
+
+    #[test]
+    fn mention_budget_checks_contents_when_files_grow_after_metadata() {
+        let directory = tempfile::tempdir().unwrap();
+        for name in ["first.txt", "growing.txt", "last.txt"] {
+            std::fs::write(directory.path().join(name), "small").unwrap();
+        }
+        let fragments = read_mentions(
+            directory.path(),
+            ["first.txt", "growing.txt", "last.txt"]
+                .map(str::to_owned)
+                .to_vec(),
+            |path| {
+                let content = match path {
+                    "first.txt" => "x".repeat(200_000),
+                    "growing.txt" => "é".repeat(40_000),
+                    _ => "last".into(),
+                };
+                std::fs::write(directory.path().join(path), content).unwrap();
+                Some(
+                    json!({"files": {path: {"text": std::fs::read_to_string(directory.path().join(path)).unwrap()}}}),
+                )
+            },
+        );
+        assert_eq!(fragments.len(), 2);
+        assert!(fragments[0].body().starts_with("\n<path>first.txt</path>"));
+        assert_eq!(fragments[1].body(), "\n<path>last.txt</path>\nlast\n");
+    }
+}
