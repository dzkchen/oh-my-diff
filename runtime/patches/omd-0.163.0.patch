+pub(crate) async fn intercept_tool(
+    invocation: &mut ToolInvocation,
+) -> Result<Option<(String, bool)>, codex_tools::FunctionCallError> {
+    let contributors = invocation
+        .session
+        .services
+        .extensions
+        .tool_lifecycle_contributors();
+    if contributors.is_empty() {
+        return Ok(None);
+    }
+    let thread_store = &invocation.session.services.thread_extension_data;
+    let conversation_history = invocation.session.conversation_history_snapshot().await;
+    let root_turn_id = invocation.turn.turn_metadata_state.root_turn_id();
+    let originating_item_id = invocation
+        .originating_call()
+        .await
+        .and_then(|origin| origin.item_id);
+    let facts = invocation
+        .turn
+        .extension_data
+        .get_or_init(codex_extension_api::ToolCallFacts::default);
+    if wants_call_facts(&invocation.session) {
+        let schema = invocation
+            .step_context
+            .tool_router
+            .tool_runtime(&invocation.tool_name)
+            .and_then(|runtime| match runtime.spec() {
+                codex_tools::ToolSpec::Function(tool) => {
+                    serde_json::to_value(&tool.parameters).ok()
+                }
+                _ => None,
+            });
+        if let Ok(mut facts) = facts.0.lock() {
+            facts.entry(invocation.call_id.clone()).or_default().schema = schema;
+        }
+    }
+
+    let mut response = None;
+    for contributor in contributors {
+        let interception = contributor
+            .intercept_tool(ToolStartInput {
+                session_store: &invocation.session.services.session_extension_data,
+                thread_store,
+                turn_store: invocation.turn.extension_data.as_ref(),
+                turn_id: invocation.turn.sub_id.as_str(),
+                root_turn_id: root_turn_id.as_deref(),
+                call_id: invocation.call_id.as_str(),
+                originating_item_id: originating_item_id.as_ref(),
+                tool_name: &invocation.tool_name,
+                mcp_tool: None,
+                permissions: Box::pin(async { tool_permission_context(invocation).await.ok() }),
+                payload: &invocation.payload,
+                conversation_history: Arc::clone(&conversation_history),
+                source: extension_tool_call_source(invocation.source.clone()),
+            })
+            .await
+            .map_err(codex_tools::FunctionCallError::RespondToModel)?;
+        match interception {
+            codex_extension_api::ToolInterception::Continue(Some((name, payload))) => {
+                invocation.tool_name = invocation
+                    .step_context
+                    .tool_router
+                    .resolve_tool_name(name.clone())
+                    .unwrap_or_else(|| name.with_default_namespace());
+                invocation.payload = payload;
+            }
+            codex_extension_api::ToolInterception::Continue(None) => {}
+            codex_extension_api::ToolInterception::Respond { output, success } => {
+                response = Some((output, success));
+                break;
+            }
+        }
+    }
+    if let Ok(mut facts) = facts.0.lock() {
+        facts.remove(&invocation.call_id);
+    }
+    Ok(response)
+}
