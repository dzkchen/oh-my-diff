+            blit(
+                "owner",
+                Some("owner".into()),
+                Some((4, 2)),
+                &arguments,
+                now,
+                |_, _| unreachable!()
+            ),
+            Err("terminal_blit_invalid".into())
+        );
+    }
+    let oversized = json!({"media_type": "image/png", "base64": "A".repeat(QUEUE_BYTES)});
+    assert_eq!(
+        frame_at(key, oversized, now),
+        Err("terminal_blit_too_large".into())
+    );
+    assert!(
+        rasters().get(key).is_none(),
+        "no raster entry is left behind"
+    );
+}
