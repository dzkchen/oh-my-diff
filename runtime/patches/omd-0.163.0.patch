+pub fn titled_protocol(method: NotificationMethod, terminal: &TerminalInfo) -> TitledProtocol {
+    match method {
+        NotificationMethod::Osc9 => TitledProtocol::Osc9,
+        NotificationMethod::Bel => TitledProtocol::Bel,
+        NotificationMethod::Auto => match terminal.name {
+            TerminalName::Kitty => TitledProtocol::Osc99,
+            TerminalName::GnomeTerminal | TerminalName::Vte => TitledProtocol::Osc777,
+            _ if supports_osc9(terminal) => TitledProtocol::Osc9,
+            _ => TitledProtocol::Bel,
+        },
+    }
+}
+
+pub fn notify_titled(
+    method: NotificationMethod,
+    title: &str,
+    body: &str,
+) -> io::Result<TitledProtocol> {
+    let terminal = terminal_info();
+    let protocol = titled_protocol(method, &terminal);
+    execute!(
+        stdout(),
+        PostTitledNotification {
+            protocol,
+            title: title.to_string(),
+            body: body.to_string(),
+            dcs_passthrough: matches!(terminal.multiplexer, Some(Multiplexer::Tmux { .. })),
+        }
+    )?;
+    Ok(protocol)
+}
+
 pub fn detect_backend(method: NotificationMethod) -> DesktopNotificationBackend {
     DesktopNotificationBackend::for_method(method)
 }
