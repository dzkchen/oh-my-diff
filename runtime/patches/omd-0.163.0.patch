+    dialog: None,
+    dismissed: None,
+    dialog_area: None,
+    seeds: BTreeMap::new(),
+    echoes: BTreeMap::new(),
+    checked: BTreeMap::new(),
+    hotkeys: Vec::new(),
+    autofocus: Vec::new(),
+    parked: BTreeSet::new(),
