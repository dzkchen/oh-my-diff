+    notifier: Mutex<Option<ModNotifier>>,
+    requests: Arc<Mutex<RequestState>>,
+}
+
+impl Accounts {
+    #[cfg(test)]
+    pub(crate) fn mod_installation(&self) -> (usize, usize, usize) {
+        let runtime = self.runtime.lock().unwrap();
+        let dispatcher = self.dispatcher.lock().unwrap();
+        let notifier = self.notifier.lock().unwrap();
+        (
+            runtime
+                .as_ref()
+                .map_or(0, |(runtime, _)| Arc::as_ptr(runtime) as usize),
+            dispatcher
+                .as_ref()
+                .map_or(0, |value| Arc::as_ptr(value) as *const () as usize),
+            notifier
+                .as_ref()
+                .map_or(0, |value| Arc::as_ptr(value) as *const () as usize),
+        )
+    }
+
+    pub(crate) fn settle_provider(
+        &self,
+        request_id: &str,
+        microusd: u64,
+        source: &str,
+        owns: impl Fn(&str) -> bool,
+    ) -> Result<Value, String> {
+        let (thread, request, provider) = self
+            .requests
+            .lock()
+            .map_err(|_| "request state poisoned")?
+            .billed
+            .get(request_id)
+            .cloned()
+            .ok_or("ledger_request_not_awaiting_settlement")?;
+        if !owns(&provider) {
+            return Err("ledger_settle_not_route_owner".into());
+        }
+        let account = self
+            .by_thread
+            .lock()
+            .map_err(|_| "account lock poisoned")?
+            .get(&thread)
+            .cloned()
+            .ok_or("ledger_request_not_awaiting_settlement")?;
+        let attempt = account
+            .task
+            .settle_provider(request, microusd, source)
+            .map_err(|error| error.to_string())?;
+        self.requests
+            .lock()
+            .map_err(|_| "request state poisoned")?
+            .billed
+            .remove(request_id);
+        write_cost_capture(&account, true).map_err(|error| error.to_string())?;
+        Ok(
+            json!({"request_id": request_id, "ledger_request": request, "cost": {"microusd": microusd, "basis": "provider_reported", "source": source}, "attempt": attempt}),
+        )
+    }
+}
+
+const MIDDLEWARE_WAIT: Duration = Duration::from_secs(2);
+const SEND_POLICY_WAIT: Duration = Duration::from_secs(5);
+const MIDDLEWARE_LOG_BYTES: u64 = 8 * 1024 * 1024;
+
+enum Hook<T> {
+    Ran(T),
+    Absent,
+    Skipped,
+}
