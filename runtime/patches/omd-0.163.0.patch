+fn error_of(runtime: &ModHost, id: &str) -> String {
+    runtime.status()["mods"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|m| m["id"] == id)
+        .and_then(|m| m["error"].as_str())
