+use super::*;
+use crate::bottom_pane::chat_composer::tests::new_test_composer;
+use crate::render::renderable::Renderable;
+use pretty_assertions::assert_eq;
+use ratatui::Terminal;
+use ratatui::backend::TestBackend;
+use serde_json::json;
+
+fn statuses(composer: &mut ChatComposer) -> Vec<(Option<String>, String)> {
+    composer
+        .mod_draft_take_events()
+        .into_iter()
+        .map(|(owner, event)| {
+            let label = event["status"]
+                .as_str()
+                .or(event["origin"].as_str())
+                .unwrap_or_default()
+                .to_owned();
+            (owner, label)
+        })
+        .collect()
+}
+
+#[test]
+fn edits_compare_revisions_and_keep_cursor_and_selection() {
+    let (mut composer, _rx) = new_test_composer();
+    composer.insert_str("hello world");
+    let revision = composer.mod_draft_sync();
+    let splice = json!({"kind": "splice", "start": 6, "end": 11, "text": "there"});
+    let next = composer
+        .mod_edit("fmt", revision, &splice, None, Some(0..5))
+        .unwrap();
+    assert_eq!(composer.current_text(), "hello there");
+    assert_eq!(composer.mod_selection(), Some(0..5));
+    assert_eq!(next, revision + 1);
+    assert_eq!(
+        composer.mod_edit("fmt", revision, &splice, None, None),
+        Err("stale_revision".to_owned())
+    );
+    let append = json!({"kind": "append", "text": "!"});
+    composer
+        .mod_edit("fmt", next, &append, Some(2), None)
+        .unwrap();
+    assert_eq!(
+        (composer.current_text(), composer.current_cursor()),
+        ("hello there!".to_owned(), 2)
+    );
+    let bad = json!({"kind": "splice", "start": 4, "end": 99, "text": ""});
+    assert_eq!(
+        composer.mod_edit("fmt", composer.mod_revision(), &bad, None, None),
+        Err("composer_range_invalid".to_owned())
+    );
+    assert_eq!(
+        statuses(&mut composer).last(),
+        Some(&(None, "fmt".to_owned()))
+    );
+    assert!(composer.recovery_snapshot().text.ends_with("there!"));
+}
+
+#[test]
+fn invalid_detach_keeps_all_text_elements_and_owned_attachments() {
+    let (mut composer, _rx) = new_test_composer();
+    let path = PathBuf::from("/tmp/preview.png");
+    composer.attach_image(path.clone());
+    composer.mod_draft_owned(path.clone(), "preview", "sha");
+    let revision = composer.mod_draft_sync();
+    let original = composer.current_text();
+    let placeholder = composer.local_images()[0].placeholder.clone();
+    statuses(&mut composer);
+    for detach in [
+        vec![placeholder.as_str(), "missing"],
+        vec![placeholder.as_str(), placeholder.as_str()],
+    ] {
+        assert!(
+            composer
+                .mod_edit_detach(
+                    "preview",
+                    revision,
+                    &json!({"kind":"append","text":"new"}),
+                    None,
+                    None,
+                    &detach
+                )
+                .is_err()
+        );
+        assert_eq!(composer.current_text(), original);
+        assert_eq!(composer.local_images().len(), 1);
+        assert_eq!(
+            composer.mod_draft_owner(&path),
+            Some(("preview".into(), "sha".into()))
+        );
+        assert_eq!(composer.mod_revision(), revision);
+        assert!(statuses(&mut composer).is_empty());
+    }
+    assert!(
+        composer
+            .mod_edit_detach(
+                "preview",
+                revision,
+                &json!({"kind":"fill","text":"new"}),
+                None,
+                None,
+                &[&placeholder]
+            )
+            .is_err()
+    );
+    assert_eq!(composer.current_text(), original);
+}
+
+#[test]
+fn one_suggestion_shows_at_the_end_and_resolves_explicitly() {
+    let (mut composer, _rx) = new_test_composer();
+    composer.insert_str("git sta");
+    let revision = composer.mod_draft_sync();
+    statuses(&mut composer);
+    assert_eq!(
+        composer.mod_suggest("a", "s", revision - 1, "s0".into(), "x".into()),
+        Err("stale_revision".to_owned())
+    );
+    composer
+        .mod_suggest("a", "s", revision, "s1".into(), "tus".into())
+        .unwrap();
+    composer
+        .mod_suggest("b", "s", revision, "s2".into(), "sh".into())
+        .unwrap();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "cleared".into())]
+    );
+    assert_eq!(composer.mod_suggestion_owner(), Some(("b", "s2")));
+
+    let mut terminal = Terminal::new(TestBackend::new(40, 6)).unwrap();
+    terminal
+        .draw(|frame| composer.render(frame.area(), frame.buffer_mut()))
+        .unwrap();
+    let screen = format!("{:?}", terminal.backend().buffer());
+    assert!(screen.contains("git stash"), "the ghost follows the draft");
+
+    composer.handle_key_event(KeyEvent::from(KeyCode::Left));
+    assert!(!composer.mod_suggestion_key(&KeyEvent::from(KeyCode::Right)));
+    composer.handle_key_event(KeyEvent::from(KeyCode::Right));
+    composer.handle_key_event(KeyEvent::from(KeyCode::Right));
+    assert_eq!(composer.current_text(), "git stash");
+    composer.mod_draft_sync();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("b".into()), "accepted".into()), (None, "b".into())]
+    );
+
+    let revision = composer.mod_draft_sync();
+    composer
+        .mod_suggest("a", "s", revision, "s3".into(), " pop".into())
+        .unwrap();
+    composer.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "dismissed".into())]
+    );
+    composer
+        .mod_suggest("a", "s", revision, "s4".into(), " pop".into())
+        .unwrap();
+    composer.insert_str("x");
+    composer.mod_draft_sync();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(None, "user".into()), (Some("a".into()), "cleared".into())]
+    );
+    assert_eq!(composer.current_text(), "git stashx");
+
+    let revision = composer.mod_draft_sync();
+    composer
+        .mod_suggest("a", "s", revision, "s5".into(), "!".into())
+        .unwrap();
+    composer.mod_draft_revoke(|_, source| source == "s");
+    assert_eq!(composer.mod_suggestion_owner(), Some(("a", "s5")));
+    composer.mod_draft_revoke(|_, source| source == "s2");
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "cleared".into())]
+    );
+}
+
+#[test]
+fn mod_attachments_leave_with_their_owner() {
+    let (mut composer, _rx) = new_test_composer();
+    let path = PathBuf::from("/tmp/preview.png");
+    composer.attach_image(path.clone());
+    composer.mod_draft_owned(path.clone(), "preview", "sha-1");
+    composer.mod_draft_sync();
+    assert_eq!(
+        composer.mod_draft_owner(&path),
+        Some(("preview".into(), "sha-1".into()))
+    );
+    composer.mod_draft_revoke(|owner, source| owner == "preview" && source == "sha-1");
+    assert_eq!(
+        composer.local_images().len(),
+        1,
+        "a loaded owner keeps its image"
+    );
+    composer.mod_draft_revoke(|_, _| false);
+    assert!(
+        composer.local_images().is_empty(),
+        "a reloaded owner loses its image"
+    );
+    assert_eq!(composer.mod_draft_owner(&path), None);
+}
diff --git a/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f58dbf131fc5cff28c9379679733a1b51935a875
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
@@ -0,0 +1,99 @@
+use super::*;
+
+pub(crate) struct ModListRequest {
+    pub(crate) view_id: &'static str,
+    pub(crate) title: String,
+    pub(crate) subtitle: Option<String>,
+    /// The last drawing by width, hook epoch, scroll offset and props, shared by `desired_height` and `render`.
+    drawn: std::cell::RefCell<Option<ModListDrawing>>,
+}
+
+type ModListDrawing = (
+    (u16, u64, usize, serde_json::Value),
+    Option<Vec<Line<'static>>>,
+);
+
+impl ModListRequest {
+    pub(crate) fn new(
+        view_id: &'static str,
+        title: &str,
+        subtitle: Option<String>,
+    ) -> Option<Self> {
+        crate::omd::terminal_active().then(|| Self {
+            view_id,
+            title: title.to_owned(),
+            subtitle,
+            drawn: std::cell::RefCell::default(),
+        })
+    }
+}
+
+impl ListSelectionView {
+    pub(super) fn mod_list_lines(
+        &self,
+        request: &ModListRequest,
+        width: u16,
+    ) -> Option<Vec<Line<'static>>> {
+        if self.is_searchable && !self.search_query.is_empty() {
+            return None;
+        }
+        let items = self
+            .active_items()
+            .iter()
+            .enumerate()
+            .map(|(order, item)| {
+                serde_json::json!({"label": item.name, "description": item.description,
+                    "current": item.is_current, "disabled": !Self::item_is_enabled(item), "order": order})
+            })
+            .collect::<Vec<_>>();
+        let props = serde_json::json!({"view_id": request.view_id, "title": request.title,
+            "subtitle": request.subtitle, "items": items, "selected": self.selected_actual_idx()});
+        let key = (
+            width,
+            crate::mod_render::live_epoch(),
+            self.state.scroll_top,
+            props.clone(),
+        );
+        let cached = request
+            .drawn
+            .borrow()
+            .as_ref()
+            .filter(|(drawn, _)| *drawn == key)
+            .map(|(_, lines)| lines.clone());
+        let lines = cached.unwrap_or_else(|| {
+            let lines = self.draw_mod_list(request, width, props);
+            *request.drawn.borrow_mut() = Some((key, lines.clone()));
+            lines
+        })?;
+        self.rendered_item_count
+            .set(lines.len().min(self.filtered_indices.len()).max(1));
+        Some(lines)
+    }
+
+    fn draw_mod_list(
+        &self,
+        request: &ModListRequest,
+        width: u16,
+        props: serde_json::Value,
+    ) -> Option<Vec<Line<'static>>> {
+        let target = crate::mod_render::RenderTarget::new("list", request.view_id, true, props);
+        let rendered = crate::mod_render::resolve(&target, width)?;
+        let inner = crate::mod_render::native_width(&rendered.tree, width);
+        let native =
+            crate::mod_render::widget_lines(inner, self.native_height(inner), |area, cells| {
+                self.render_native(area, cells)
+            });
+        let selected = self.selected_actual_idx().map(|index| index.to_string());
+        Some(
+            crate::mod_render::compose_lines(&rendered.tree, width, selected.as_deref(), native)
+                .into_iter()
+                .map(|line| line.line)
+                .collect(),
+        )
+    }
+
+    pub(super) fn render_mod_list(&self, lines: Vec<Line<'static>>, area: Rect, buf: &mut Buffer) {
+        Self::clear_to_terminal_bg(buf, area);
+        Paragraph::new(lines).render(area, buf);
+    }
+}
diff --git a/codex-rs/tui/src/bottom_pane/mod_panel.rs b/codex-rs/tui/src/bottom_pane/mod_panel.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a5890093d57d345d49be40ec310cfc5ada83c4e2
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/mod_panel.rs
@@ -0,0 +1,635 @@
+use super::BottomPaneView;
+use super::CancellationEvent;
+use super::ListSelectionView;
+use super::SearchMode;
+use super::SelectionDescriptionLayout;
+use super::SelectionItem;
+use super::SelectionRowDisplay;
+use super::SelectionTab;
+use super::SelectionViewParams;
+use super::footer_hint_items_line;
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::key_hint::KeyBindingListExt;
+use crate::key_hint::ShortcutHint;
+use crate::keymap::KeymapContext;
+use crate::keymap::KeymapContextSet;
+use crate::keymap::ListAction;
+use crate::keymap::ListKeymap;
+use crate::render::renderable::Renderable;
+use codex_omd::ModCommandAction;
+use codex_omd::ModSelectOption;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::text::Line;
+use serde::Deserialize;
+use serde_json::Value;
+use std::collections::HashSet;
+
+pub(crate) const MOD_PANEL_VIEW_ID: &str = "mod-panel";
+const MAX_ITEMS: usize = 200;
+const MAX_TABS: usize = 8;
+const MAX_OPTIONS: usize = 32;
+const MAX_ROWS: usize = 14;
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum PanelKind {
+    Toggle,
+    Choice,
+    Action,
+    Text,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PanelTab {
+    id: String,
+    title: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PanelItem {
+    id: String,
+    #[serde(default)]
+    tab: Option<String>,
+    label: String,
+    #[serde(default)]
+    description: Option<String>,
+    kind: PanelKind,
+    #[serde(default)]
+    value: Option<Value>,
+    #[serde(default)]
+    options: Vec<ModSelectOption>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ModPanelRequest {
+    title: String,
+    #[serde(default)]
+    subtitle: Option<String>,
+    #[serde(default)]
+    tabs: Vec<PanelTab>,
+    items: Vec<PanelItem>,
+    #[serde(default)]
+    search: bool,
+    action: ModCommandAction,
+}
+
+fn text(value: &str, limit: usize, empty: bool) -> Result<String, String> {
+    let shown: String = value
+        .chars()
+        .filter(|c| !c.is_control() || *c == '\n')
+        .collect();
+    if value.len() > limit || (!empty && shown.is_empty()) {
+        return Err(format!(
+            "terminal_panel_invalid: text must be 1-{limit} bytes"
+        ));
+    }
+    Ok(shown)
+}
+
+fn line(value: &str, limit: usize, empty: bool) -> Result<String, String> {
+    text(value, limit, empty).map(|value| value.replace('\n', " "))
+}
+
+impl ModPanelRequest {
+    pub(crate) fn parse(caller: &str, arguments: &Value) -> Result<Self, String> {
+        let mut request: Self = serde_json::from_value(arguments.clone())
+            .map_err(|error| format!("terminal_panel_invalid: {error}"))?;
+        request.title = line(&request.title, 128, false)?;
+        request.subtitle = request
+            .subtitle
+            .map(|subtitle| text(&subtitle, 2000, true))
+            .transpose()?;
+        request.action.command = codex_omd::owned_command(caller, &request.action.command)
+            .filter(|command| codex_omd::mod_command_reference(command))
+            .ok_or("terminal_panel_invalid: action must name one of the caller's commands")?;
+        request.action.args = text(&request.action.args, 512, true)?;
+        if request.tabs.len() > MAX_TABS || !(1..=MAX_ITEMS).contains(&request.items.len()) {
+            return Err(format!(
+                "terminal_panel_invalid: at most {MAX_TABS} tabs and 1-{MAX_ITEMS} items"
+            ));
+        }
+        let mut tabs = HashSet::new();
+        for tab in &mut request.tabs {
+            tab.title = line(&tab.title, 32, false)?;
+            tab.id = text(&tab.id, 64, false)?;
+            if !tabs.insert(tab.id.clone()) {
+                return Err("terminal_panel_invalid: duplicate tab id".into());
+            }
+        }
+        let mut ids = HashSet::new();
+        for item in &mut request.items {
+            item.id = text(&item.id, 128, false)?;
+            if item.id.contains(char::is_whitespace) || !ids.insert(item.id.clone()) {
+                return Err("terminal_panel_invalid: item ids must be unique words".into());
+            }
+            item.tab = item
+                .tab
+                .as_deref()
+                .map(|tab| text(tab, 64, false))
+                .transpose()?;
+            if item.tab.as_ref().is_some_and(|tab| !tabs.contains(tab))
+                || item.tab.is_none() != tabs.is_empty()
+            {
+                return Err(format!(
+                    "terminal_panel_invalid: item {} needs one of the panel's tabs",
+                    item.id
+                ));
+            }
+            item.label = line(&item.label, 128, false)?;
+            item.description = item
+                .description
+                .as_deref()
+                .map(|description| line(description, 256, true))
+                .transpose()?;
+            item.value = Some(Self::value(item)?);
+        }
+        Ok(request)
+    }
+
+    fn value(item: &mut PanelItem) -> Result<Value, String> {
+        let invalid = || format!("terminal_panel_invalid: item {} value", item.id);
+        if !item.options.is_empty() && item.kind != PanelKind::Choice {
+            return Err(invalid());
+        }
+        match (item.kind, &item.value) {
+            (PanelKind::Toggle, None) => Ok(Value::Bool(false)),
+            (PanelKind::Toggle, Some(Value::Bool(on))) => Ok(Value::Bool(*on)),
+            (PanelKind::Text, None) => Ok(Value::String(String::new())),
+            (PanelKind::Text, Some(Value::String(value))) => {
+                line(value, 2000, true).map(Value::String)
+            }
+            (PanelKind::Action, None) => Ok(Value::Null),
+            (PanelKind::Choice, value) => {
+                let mut values = HashSet::new();
+                if !(1..=MAX_OPTIONS).contains(&item.options.len())
+                    || item.options.iter().any(|option| {
+                        option.value.is_empty()
+                            || option.value.len() > 128
+                            || option
+                                .value
+                                .contains(|c: char| c.is_whitespace() || c.is_control())
+                            || !values.insert(option.value.as_str())
+                    })
+                {
+                    return Err(invalid());
+                }
+                for option in &mut item.options {
+                    option.label = line(&option.label, 128, false)?;
+                }
+                match value {
+                    None => Ok(Value::String(item.options[0].value.clone())),
+                    Some(Value::String(value))
+                        if item.options.iter().any(|option| &option.value == value) =>
+                    {
+                        Ok(Value::String(value.clone()))
+                    }
+                    Some(_) => Err(invalid()),
+                }
+            }
+            _ => Err(invalid()),
+        }
+    }
+}
+
+#[derive(Default)]
+struct PanelState {
+    tab: Option<String>,
+    selected: Option<String>,
+    query: Option<String>,
+}
+
+pub(crate) struct ModPanelView {
+    caller: String,
+    request: ModPanelRequest,
+    picker: ListSelectionView,
+    tab: Option<String>,
+    keymap: ListKeymap,
+    app_event_tx: AppEventSender,
+}
+
+impl ModPanelView {
+    pub(crate) fn new(
+        caller: String,
+        request: ModPanelRequest,
+        app_event_tx: AppEventSender,
+        keymap: ListKeymap,
+    ) -> Self {
+        let picker = picker(
+            &request,
+            PanelState::default(),
+            app_event_tx.clone(),
+            keymap.clone(),
+        );
+        Self {
+            caller,
+            request,
+            picker,
+            tab: None,
+            keymap,
+            app_event_tx,
+        }
+    }
+
+    pub(crate) fn is_for(&self, caller: &str, request: &ModPanelRequest) -> bool {
+        self.caller == caller && self.request.title == request.title
+    }
+
+    pub(crate) fn action(&self) -> (String, String) {
+        (
+            self.request.action.command.clone(),
+            self.request.action.args.clone(),
+        )
+    }
+
+    pub(crate) fn replace(&mut self, request: ModPanelRequest) {
+        let mut state = self.state();
+        state.tab = state.tab.or(self.tab.take());
+        self.tab = state.tab.clone();
+        self.request = request;
+        self.rebuild(state);
+    }
+
+    fn state(&self) -> PanelState {
+        PanelState {
+            tab: self.picker.active_tab_id().map(str::to_owned),
+            selected: self
+                .picker
+                .selected_index()
+                .and_then(|index| self.shown().get(index).map(|item| item.id.clone())),
+            query: self.picker.search_query().map(str::to_owned),
+        }
+    }
+
+    fn rebuild(&mut self, state: PanelState) {
+        self.picker = picker(
+            &self.request,
+            state,
+            self.app_event_tx.clone(),
+            self.keymap.clone(),
+        );
+    }
+
+    fn shown(&self) -> Vec<&PanelItem> {
+        shown(
+            &self.request,
+            self.picker.active_tab_id(),
+            self.picker.search_query(),
+        )
+    }
+
+    fn activate(&mut self, index: usize) {
+        let Some(id) = self.shown().get(index).map(|item| item.id.clone()) else {
+            return;
+        };
+        let Some(item) = self.request.items.iter_mut().find(|item| item.id == id) else {
+            return;
+        };
+        let value = match item.kind {
+            PanelKind::Toggle => Value::Bool(
+                !item
+                    .value
+                    .as_ref()
+                    .and_then(Value::as_bool)
+                    .unwrap_or(false),
+            ),
+            PanelKind::Choice => {
+                let current = item.value.as_ref().and_then(Value::as_str);
+                let at = item
+                    .options
+                    .iter()
+                    .position(|option| Some(option.value.as_str()) == current)
+                    .map_or(0, |at| (at + 1) % item.options.len());
+                Value::String(item.options[at].value.clone())
+            }
+            PanelKind::Action => Value::Null,
+            PanelKind::Text => {
+                self.app_event_tx.send(AppEvent::ModPanelPrompt {
+                    title: item.label.clone(),
+                    value: item
+                        .value
+                        .as_ref()
+                        .and_then(Value::as_str)
+                        .unwrap_or_default()
+                        .to_owned(),
+                    command: self.request.action.command.clone(),
+                    args: arguments(&self.request.action.args, &id, None),
+                });
+                return;
+            }
+        };
+        let shown = match &value {
+            Value::Bool(on) => Some(on.to_string()),
+            Value::String(value) => Some(value.clone()),
+            _ => None,
+        };
+        if !value.is_null() {
+            item.value = Some(value);
+        }
+        self.app_event_tx.send(AppEvent::ModPanelCommand {
+            command: self.request.action.command.clone(),
+            args: arguments(&self.request.action.args, &id, shown.as_deref()),
+        });
+        self.rebuild(self.state());
+    }
+}
+
+pub(crate) fn arguments(args: &str, id: &str, value: Option<&str>) -> String {
+    [args, id, value.unwrap_or_default()]
+        .into_iter()
+        .filter(|part| !part.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn shown<'a>(
+    request: &'a ModPanelRequest,
+    tab: Option<&str>,
+    query: Option<&str>,
+) -> Vec<&'a PanelItem> {
+    let searching = query.is_some_and(|query| !query.is_empty());
+    let tab = tab.or_else(|| request.tabs.first().map(|tab| tab.id.as_str()));
+    request
+        .items
+        .iter()
+        .filter(|item| searching || request.tabs.is_empty() || item.tab.as_deref() == tab)
+        .collect()
+}
+
+fn value_label(item: &PanelItem) -> Option<String> {
+    let value = item.value.as_ref()?;
+    match item.kind {
+        PanelKind::Toggle => Some(
+            if value == &Value::Bool(true) {
+                "[x] On"
+            } else {
+                "[ ] Off"
+            }
+            .into(),
+        ),
+        PanelKind::Choice => item
+            .options
+            .iter()
+            .find(|option| Some(option.value.as_str()) == value.as_str())
+            .map(|option| format!("{} ›", option.label)),
+        PanelKind::Text => Some(match value.as_str().unwrap_or_default() {
+            "" => "Not set ›".into(),
+            text => format!("{} ›", text.chars().take(24).collect::<String>()),
+        }),
+        PanelKind::Action => None,
+    }
+}
+
+fn hint(keymap: &ListKeymap, tabs: bool, search: bool, accept: Option<&str>) -> Line<'static> {
+    let key = |action| keymap.primary_hint(action).map(ShortcutHint::display_label);
+    let mut items = Vec::new();
+    if tabs {
+        let keys = [ListAction::MoveLeft, ListAction::MoveRight]
+            .into_iter()
+            .filter_map(key)
+            .collect::<Vec<_>>()
+            .join("/");
+        if !keys.is_empty() {
+            items.push((keys, "tab".to_owned()));
+        }
+    }
+    if search {
+        items.push(("/".to_owned(), "search".to_owned()));
+    }
+    if let Some((key, accept)) =
+        accept.and_then(|accept| key(ListAction::Accept).map(|key| (key, accept)))
+    {
+        items.push((format!("space/{key}"), accept.to_owned()));
+    }
+    if let Some(key) = key(ListAction::Cancel) {
+        items.push((
+            key,
+            if search {
+                "clear search/close"
+            } else {
+                "close"
+            }
+            .to_owned(),
+        ));
+    }
+    footer_hint_items_line(&items)
+}
+
+fn item(
+    request: &ModPanelRequest,
+    item: &PanelItem,
+    keymap: &ListKeymap,
+    searching: bool,
+) -> SelectionItem {
+    let accept = match item.kind {
+        PanelKind::Toggle => "toggle",
+        PanelKind::Choice => "change",
+        PanelKind::Action => "run",
+        PanelKind::Text => "edit",
+    };
+    let tab = item
+        .tab
+        .as_ref()
+        .and_then(|id| request.tabs.iter().find(|tab| &tab.id == id))
+        .map(|tab| tab.title.as_str());
+    let description = match (searching, tab, item.description.as_deref()) {
+        (true, Some(tab), Some(description)) => Some(format!("{tab} · {description}")),
+        (true, Some(tab), None) => Some(tab.to_owned()),
+        (_, _, description) => description.map(str::to_owned),
+    };
+    SelectionItem {
+        name: item.label.clone(),
+        category_tag: value_label(item).map(|label| format!("{label:<20}")),
+        search_value: Some(
+            [Some(item.label.as_str()), tab, item.description.as_deref()]
+                .into_iter()
+                .flatten()
+                .collect::<Vec<_>>()
+                .join(" "),
+        ),
+        description,
+        footer_hint: Some(hint(
+            keymap,
+            !request.tabs.is_empty(),
+            request.search,
+            Some(accept),
+        )),
+        dismiss_on_select: false,
+        ..Default::default()
+    }
+}
+
+fn picker(
+    request: &ModPanelRequest,
+    state: PanelState,
+    app_event_tx: AppEventSender,
+    keymap: ListKeymap,
+) -> ListSelectionView {
+    let query = state.query.filter(|_| request.search);
+    let tab = state
+        .tab
+        .filter(|tab| request.tabs.iter().any(|known| &known.id == tab));
+    let selected = state.selected.and_then(|selected| {
+        shown(request, tab.as_deref(), query.as_deref())
+            .iter()
+            .position(|item| item.id == selected)
+    });
+    let rows = if request.tabs.is_empty() {
+        request.items.len()
+    } else {
+        request
+            .tabs
+            .iter()
+            .map(|tab| {
+                request
+                    .items
+                    .iter()
+                    .filter(|item| item.tab.as_ref() == Some(&tab.id))
+                    .count()
+            })
+            .max()
+            .unwrap_or_default()
+    };
+    let items = |filter: &dyn Fn(&PanelItem) -> bool, searching: bool| {
+        request
+            .items
+            .iter()
+            .filter(|candidate| filter(candidate))
+            .map(|candidate| item(request, candidate, &keymap, searching))
+            .collect::<Vec<_>>()
+    };
+    let tabbed = !request.tabs.is_empty();
+    let params = SelectionViewParams {
+        view_id: Some(MOD_PANEL_VIEW_ID),
+        title: Some(request.title.clone()),
+        subtitle: request.subtitle.clone(),
+        max_visible_rows: rows.clamp(1, MAX_ROWS),
+        reserve_result_rows: tabbed,
+        row_display: SelectionRowDisplay::SingleLine,
+        description_layout: SelectionDescriptionLayout::SelectedBelowWhenNarrow {
+            min_description_width: 45,
+        },
+        footer_hint: Some(hint(&keymap, tabbed, request.search, None)),
+        is_searchable: request.search,
+        search_mode: SearchMode::OnDemand(crate::key_hint::plain(KeyCode::Char('/'))),
+        search_placeholder: Some("Type to search".to_owned()),
+        items: if tabbed {
+            Vec::new()
+        } else {
+            items(&|_| true, false)
+        },
+        search_items: if tabbed && request.search {
+            items(&|_| true, true)
+        } else {
+            Vec::new()
+        },
+        tabs: request
+            .tabs
+            .iter()
+            .map(|tab| SelectionTab {
+                id: tab.id.clone(),
+                label: tab.title.clone(),
+                header: Box::new(()),
+                items: items(&|item| item.tab.as_ref() == Some(&tab.id), false),
+            })
+            .collect(),
+        initial_tab_id: tab,
+        initial_selected_idx: selected,
+        initial_search_query: query,
+        ..SelectionViewParams::picker()
+    };
+    ListSelectionView::new(params, app_event_tx, keymap)
+}
+
+impl BottomPaneView for ModPanelView {
+    fn keymap_contexts(&self) -> KeymapContextSet {
+        KeymapContextSet::new(KeymapContext::List)
+    }
+
+    fn handle_key_event(&mut self, key: KeyEvent) {
+        if key.kind == KeyEventKind::Release {
+            return;
+        }
+        let plain = key.modifiers == KeyModifiers::NONE;
+        if self.picker.selected_index().is_none()
+            && (self.keymap.accept.is_pressed(key) || plain && key.code == KeyCode::Enter)
+            || !self.request.search
+                && plain
+                && matches!(key.code, KeyCode::Char(c) if c.is_ascii_digit())
+        {
+            return;
+        }
+        if key.code == KeyCode::Char(' ') && plain && self.picker.search_query().is_none() {
+            if let Some(index) = self.picker.selected_index() {
+                self.activate(index);
+            }
+            return;
+        }
+        self.picker.handle_key_event(key);
+        if let Some(index) = self.picker.take_last_selected_index() {
+            self.activate(index);
+        }
+    }
+
+    fn handle_paste(&mut self, text: String) -> bool {
+        self.picker.handle_paste(text)
+    }
+
+    fn prefer_esc_to_handle_key_event(&self) -> bool {
+        true
+    }
+
+    fn is_complete(&self) -> bool {
+        self.picker.is_complete()
+    }
+
+    fn view_id(&self) -> Option<&'static str> {
+        Some(MOD_PANEL_VIEW_ID)
+    }
+
+    fn selected_index(&self) -> Option<usize> {
+        self.picker.selected_index()
+    }
+
+    fn search_query(&self) -> Option<&str> {
+        self.picker.search_query()
+    }
+
+    fn active_tab_id(&self) -> Option<&str> {
+        self.picker.active_tab_id()
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.picker.on_ctrl_c()
+    }
+
+    fn mod_panel(&mut self) -> Option<&mut ModPanelView> {
+        Some(self)
+    }
+}
+
+impl Renderable for ModPanelView {
+    fn desired_height(&self, width: u16) -> u16 {
+        self.picker.desired_height(width)
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        self.picker.render(area, buf);
+    }
+
+    fn cursor_pos(&self, area: Rect) -> Option<(u16, u16)> {
+        self.picker.cursor_pos(area)
+    }
+}
+
+#[cfg(test)]
+#[path = "mod_panel_tests.rs"]
+mod tests;
