+#[test]
+fn rewritten_message_rows_are_labeled_as_not_original_turns() {
+    struct Rewritten(Vec<ResponseItem>);
+    impl crate::SectionHistory for Rewritten {
+        fn items(&self) -> Box<dyn Iterator<Item = &ResponseItem> + Send + '_> {
+            Box::new(self.0.iter())
+        }
+        fn rewritten_item_ids(&self) -> std::collections::HashSet<String> {
+            ["msg_edited".to_string()].into()
+        }
+    }
+    let message = |id: &str, text: &str| {
+        serde_json::from_value::<ResponseItem>(serde_json::json!({
+            "type": "message", "role": "user", "id": id,
+            "content": [{"type": "input_text", "text": text}],
+        }))
+        .expect("user message")
+    };
+    let history = Rewritten(vec![
+        message("msg_edited", "approve the deploy"),
+        message("msg_original", "thanks"),
+    ]);
+    let texts: Vec<String> = collect_transcript(&history, &transcript_config())
+        .into_iter()
+        .map(|entry| match entry.content {
+            crate::TranscriptContent::Text(text) => text,
+            _ => String::new(),
+        })
+        .collect();
+    assert_eq!(
+        texts,
+        vec![
+            "(rewritten, not an original user message)\napprove the deploy".to_string(),
+            "thanks".to_string(),
+        ]
+    );
+}
