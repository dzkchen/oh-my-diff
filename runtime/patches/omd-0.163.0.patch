+++ b/codex-rs/tui/src/mod_pty.rs
@@ -0,0 +1,610 @@
+use crate::omd::LockExt;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+const PANES: usize = 16;
+const WRITE_BYTES: usize = 4096;
+const SCROLLBACK: usize = 2000;
+
+struct Pane {
+    writer: tokio::sync::mpsc::Sender<Vec<u8>>,
+    handle: codex_utils_pty::ProcessHandle,
+    screen: Arc<Mutex<vt100::Parser>>,
+    exit: Arc<Mutex<Option<i32>>>,
+    size: (u16, u16),
+    unrestricted: bool,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct Scope {
+    epoch: u64,
+    admission: u64,
+    generation: u64,
+    configuration: String,
+    thread: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Binding {
+    owner: String,
+    scope: Scope,
+}
+
+#[derive(Default)]
+struct Sessions {
+    scope: Scope,
+    owners: BTreeMap<String, String>,
+    panes: BTreeMap<(String, String), Pane>,
+}
+
+static SESSIONS: std::sync::LazyLock<Mutex<Sessions>> =
+    std::sync::LazyLock::new(|| Mutex::new(Sessions::default()));
+
+fn sessions() -> std::sync::MutexGuard<'static, Sessions> {
+    SESSIONS.locked()
+}
+
+fn owned<'a>(
+    sessions: &'a mut Sessions,
+    binding: &Binding,
+    session: &str,
+) -> Result<&'a mut Pane, String> {
+    validate(sessions, binding)?;
+    sessions
+        .panes
+        .get_mut(&(binding.owner.clone(), session.to_owned()))
+        .ok_or_else(|| format!("pty_session_unknown: {session}"))
+}
+
+fn validate(sessions: &Sessions, binding: &Binding) -> Result<(), String> {
+    if sessions.scope != binding.scope || !sessions.owners.contains_key(&binding.owner) {
+        return Err("pty_context_changed".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn binding(
+    owner: &str,
+    thread: Option<&str>,
+    authority: &codex_omd::client_surface::Authority,
+) -> Result<Binding, String> {
+    let sessions = sessions();
+    let binding = Binding {
+        owner: owner.to_owned(),
+        scope: sessions.scope.clone(),
+    };
+    validate(&sessions, &binding)?;
+    if thread != binding.scope.thread.as_deref()
+        || authority.epoch != binding.scope.epoch
+        || authority.admission != binding.scope.admission
+        || authority.configuration != binding.scope.configuration
+        || sessions.owners.get(owner) != Some(&authority.source)
+    {
+        return Err("pty_context_changed".into());
+    }
+    Ok(binding)
+}
+
+pub(crate) fn current(binding: &Binding) -> bool {
+    validate(&sessions(), binding).is_ok()
+}
+
+pub(crate) fn view_binding(
+    owner: &str,
+    thread: Option<&str>,
+    epoch: u64,
+    admission: u64,
+    configuration: &str,
+) -> Result<Binding, String> {
+    let source = sessions()
+        .owners
+        .get(owner)
+        .cloned()
+        .ok_or("pty_context_changed")?;
+    binding(
+        owner,
+        thread,
+        &codex_omd::client_surface::Authority {
+            epoch,
+            admission,
+            configuration: configuration.to_owned(),
+            source,
+        },
+    )
+}
+
+fn clear(sessions: &mut Sessions) {
+    for pane in sessions.panes.values() {
+        pane.handle.terminate();
+    }
+    sessions.panes.clear();
+}
+
+pub(crate) fn context(epoch: u64, thread: Option<String>) {
+    let mut sessions = sessions();
+    if sessions.scope.epoch != epoch || sessions.scope.thread != thread {
+        clear(&mut sessions);
+        sessions.scope.epoch = epoch;
+        sessions.scope.thread = thread;
+    }
+}
+
+pub(crate) fn retain(
+    generation: u64,
+    configuration: &str,
+    active: &BTreeMap<String, String>,
+    unrestricted: &std::collections::BTreeSet<String>,
+) {
+    let mut sessions = sessions();
+    if sessions.scope.generation != generation || sessions.scope.configuration != configuration {
+        clear(&mut sessions);
+        sessions.scope.generation = generation;
+        sessions.scope.admission = codex_omd::client_surface::advance_admission();
+        sessions.scope.configuration = configuration.to_owned();
+    }
+    sessions.owners = active.clone();
+    sessions.panes.retain(|(owner, _), pane| {
+        let keep =
+            active.contains_key(owner) && (!pane.unrestricted || unrestricted.contains(owner));
+        if !keep {
+            pane.handle.terminate();
+        }
+        keep
+    });
+}
+
+pub(crate) fn argv(arguments: &Value) -> Result<Vec<String>, String> {
+    let Some(program) = arguments["program"].as_str() else {
+        if !arguments["argv"].is_null() || !arguments["sha256"].is_null() {
+            return Err("pty_program_required".into());
+        }
+        return Ok(vec![
+            std::env::var("SHELL").unwrap_or_else(|_| "/bin/zsh".to_owned()),
+            "-i".to_owned(),
+        ]);
+    };
+    let args = match &arguments["argv"] {
+        Value::Null => Vec::new(),
+        Value::Array(items) => items
+            .iter()
+            .map(|item| item.as_str().map(str::to_owned))
+            .collect::<Option<Vec<_>>>()
+            .ok_or("pty_argv_invalid")?,
+        _ => return Err("pty_argv_invalid".into()),
+    };
+    if program.is_empty()
+        || args.len() > 64
+        || args.iter().map(String::len).sum::<usize>() > 8192
+        || std::iter::once(program)
+            .chain(args.iter().map(String::as_str))
+            .any(|arg| arg.contains('\0'))
+    {
+        return Err("pty_argv_invalid".into());
+    }
+    Ok(std::iter::once(program.to_owned()).chain(args).collect())
+}
+
+fn session_name(value: &Value) -> Result<String, String> {
+    value
+        .as_str()
+        .filter(|name| {
+            !name.is_empty()
+                && name.len() <= 64
+                && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        })
+        .map(str::to_owned)
+        .ok_or_else(|| "pty_session_invalid".to_owned())
+}
+
+pub(crate) fn start_prompt(caller: &str, arguments: &Value) -> Result<String, String> {
+    session_name(&arguments["session"])?;
+    let argv = argv(arguments)?;
+    Ok(format!(
+        "Mod {caller} wants to open a terminal pane running `{}` in {}. It runs in the session sandbox {}, {}. The mod can type into it and read its screen.",
+        argv.join(" "),
+        arguments["cwd"].as_str().unwrap_or("."),
+        if arguments["network"] == "loopback" {
+            "with network limited to this computer (loopback)"
+        } else {
+            "without network"
+        },
+        if arguments["write"] == true {
+            "and can write to the workspace"
+        } else {
+            "read-only"
+        }
+    ))
+}
+
+pub(crate) async fn start(
+    binding: &Binding,
+    arguments: &Value,
+    command: std::process::Command,
+    home: &Path,
+    frames: crate::tui::FrameRequester,
+) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let owner = &binding.owner;
+    let key = (owner.clone(), session.clone());
+    let limit = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .map_or_else(Default::default, |store| {
+            codex_omd::mod_limits::ModLimits::read(&store)
+        })
+        .pty_panes_per_mod;
+    let unavailable = |sessions: &Sessions| {
+        sessions.panes.contains_key(&key)
+            || sessions.panes.len() >= PANES
+            || sessions.panes.keys().filter(|(id, _)| id == owner).count() >= limit
+    };
+    {
+        let sessions = sessions();
+        validate(&sessions, binding)?;
+        if unavailable(&sessions) {
+            return Err("pty_session_exists_or_limit".into());
+        }
+    }
+    let program = command.get_program().to_string_lossy().into_owned();
+    let args = command
+        .get_args()
+        .map(|arg| arg.to_string_lossy().into_owned())
+        .collect::<Vec<_>>();
+    let cwd = command
+        .get_current_dir()
+        .ok_or("pty_cwd_invalid")?
+        .to_path_buf();
+    let mut environment = std::collections::HashMap::from([
+        ("TERM".to_owned(), "xterm-256color".to_owned()),
+        ("HOME".to_owned(), home.to_string_lossy().into_owned()),
+    ]);
+    for name in ["PATH", "LANG", "USER", "SHELL"] {
+        if let Ok(value) = std::env::var(name) {
+            environment.insert(name.to_owned(), value);
+        }
+    }
+    let size = codex_utils_pty::TerminalSize { rows: 24, cols: 80 };
+    let spawned = codex_utils_pty::pty::spawn_process(
+        &program,
+        &args,
+        &cwd,
+        &environment,
+        &None,
+        size,
+        codex_utils_pty::ChildFds::Attached(&[]),
+    )
+    .await
+    .map_err(|error| format!("pty_start_failed: {error}"))?;
+    let screen = Arc::new(Mutex::new(vt100::Parser::new(
+        size.rows, size.cols, SCROLLBACK,
+    )));
+    let exit = Arc::new(Mutex::new(None));
+    let (mut output, exited) = (spawned.stdout_rx, spawned.exit_rx);
+    let (reader, reader_frames) = (screen.clone(), frames.clone());
+    tokio::spawn(async move {
+        while let Some(bytes) = output.recv().await {
+            reader.locked().process(&bytes);
+            reader_frames.schedule_frame();
+        }
+    });
+    let status = exit.clone();
+    tokio::spawn(async move {
+        let code = exited.await.unwrap_or(-1);
+        *status.locked() = Some(code);
+        frames.schedule_frame();
+    });
+    let mut sessions = sessions();
+    if let Err(error) = validate(&sessions, binding) {
+        spawned.session.terminate();
+        return Err(error);
+    }
+    if unavailable(&sessions) {
+        spawned.session.terminate();
+        return Err("pty_session_exists_or_limit".into());
+    }
+    sessions.panes.insert(
+        key,
+        Pane {
+            writer: spawned.session.writer_sender(),
+            handle: spawned.session,
+            screen,
+            exit,
+            size: (size.rows, size.cols),
+            unrestricted: arguments["sandbox"] == "none",
+        },
+    );
+    Ok(json!({"session": session, "running": true}))
+}
+
+pub(crate) fn call(binding: &Binding, arguments: &Value) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let mut sessions = sessions();
+    match arguments["action"].as_str() {
+        Some("write") => {
+            let text = arguments["text"]
+                .as_str()
+                .filter(|text| text.len() <= WRITE_BYTES)
+                .ok_or("pty_write_invalid")?;
+            owned(&mut sessions, binding, &session)?
+                .writer
+                .try_send(text.as_bytes().to_vec())
+                .map_err(|_| "pty_write_unavailable")?;
+            Ok(json!({"written": text.len()}))
+        }
+        Some("read") => {
+            let pane = owned(&mut sessions, binding, &session)?;
+            let text = pane.screen.locked().screen().contents();
+            let exit_code = *pane.exit.locked();
+            Ok(json!({"text": text, "running": exit_code.is_none(), "exit_code": exit_code}))
+        }
+        Some("stop") => {
+            owned(&mut sessions, binding, &session)?.handle.terminate();
+            sessions.panes.remove(&(binding.owner.clone(), session));
+            Ok(json!({"stopped": true}))
+        }
+        _ => Err("pty_action_invalid".into()),
+    }
+}
+
+#[allow(clippy::disallowed_methods)]
+fn color(color: vt100::Color) -> Option<Color> {
+    match color {
+        vt100::Color::Default => None,
+        vt100::Color::Idx(index) => Some(Color::Indexed(index)),
+        vt100::Color::Rgb(r, g, b) => Some(Color::Rgb(r, g, b)),
+    }
+}
+
+pub(crate) fn rows(
+    binding: Option<&Binding>,
+    session: &str,
+    width: u16,
+    height: u16,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return vec![Line::from(format!(
+            "{prefix}[shell {session} is not running]"
+        ))];
+    };
+    let (rows, cols) = (height.max(2), width.max(10));
+    let mut screen = pane.screen.locked();
+    if pane.size != (rows, cols) {
+        pane.size = (rows, cols);
+        screen.screen_mut().set_size(rows, cols);
+        let _ = pane
+            .handle
+            .resize(codex_utils_pty::TerminalSize { rows, cols });
+    }
+    let exited = *pane.exit.locked();
+    let mut lines = (0..rows)
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            for column in 0..cols {
+                let Some(cell) = screen.screen().cell(row, column) else {
+                    continue;
+                };
+                let mut style = Style::default();
+                if let Some(foreground) = color(cell.fgcolor()) {
+                    style = style.fg(foreground);
+                }
+                if let Some(background) = color(cell.bgcolor()) {
+                    style = style.bg(background);
+                }
+                if cell.bold() {
+                    style = style.add_modifier(Modifier::BOLD);
+                }
+                if cell.inverse() {
+                    style = style.add_modifier(Modifier::REVERSED);
+                }
+                let text = if cell.has_contents() {
+                    cell.contents().to_owned()
+                } else {
+                    " ".to_owned()
+                };
+                spans.push(Span::styled(text, style));
+            }
+            Line::from(spans)
+        })
+        .collect::<Vec<_>>();
+    if let Some(code) = exited {
+        lines.push(Line::from(format!("{prefix}[shell exited with {code}]")));
+    }
+    lines
+}
+
+pub(crate) fn key(binding: Option<&Binding>, session: &str, key: KeyEvent) -> bool {
+    let bytes = match (key.code, key.modifiers) {
+        (KeyCode::Char(c), KeyModifiers::CONTROL) if c.is_ascii_alphabetic() => {
+            vec![(c.to_ascii_lowercase() as u8) & 0x1f]
+        }
+        (KeyCode::Char(c), _) => c.to_string().into_bytes(),
+        (KeyCode::Enter, _) => vec![b'\r'],
+        (KeyCode::Backspace, _) => vec![0x7f],
+        (KeyCode::Tab, _) => vec![b'\t'],
+        (KeyCode::Esc, _) => vec![0x1b],
+        (KeyCode::Up, _) => b"\x1b[A".to_vec(),
+        (KeyCode::Down, _) => b"\x1b[B".to_vec(),
+        (KeyCode::Right, _) => b"\x1b[C".to_vec(),
+        (KeyCode::Left, _) => b"\x1b[D".to_vec(),
+        (KeyCode::Home, _) => b"\x1b[H".to_vec(),
+        (KeyCode::End, _) => b"\x1b[F".to_vec(),
+        (KeyCode::Delete, _) => b"\x1b[3~".to_vec(),
+        _ => return false,
+    };
+    let mut sessions = sessions();
+    binding
+        .and_then(|binding| owned(&mut sessions, binding, session).ok())
+        .is_some_and(|pane| pane.writer.try_send(bytes).is_ok())
+}
+
+pub(crate) fn paste(binding: Option<&Binding>, session: &str, text: &str) {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return;
+    };
+    let bracketed = pane.screen.locked().screen().bracketed_paste();
+    let bytes = if bracketed {
+        format!("\x1b[200~{text}\x1b[201~")
+    } else {
+        text.to_owned()
+    };
+    let _ = pane.writer.try_send(bytes.into_bytes());
+}
+
+#[cfg(test)]
+pub(crate) struct TestScope(Option<Sessions>);
+
+#[cfg(test)]
+impl Drop for TestScope {
+    fn drop(&mut self) {
+        let mut state = sessions();
+        clear(&mut state);
+        *state = self.0.take().unwrap();
+        state.scope.admission = codex_omd::client_surface::admission();
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn test_scope() -> TestScope {
+    TestScope(Some(std::mem::take(&mut *sessions())))
+}
