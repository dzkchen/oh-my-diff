+async fn policy_rejected_stdin_never_reaches_approval_gates() -> anyhow::Result<()> {
+    use anyhow::Context;
+    let (mut session, mut turn, _events) = make_session_and_context_with_rx().await;
+    Arc::make_mut(
+        &mut Arc::get_mut(&mut turn)
+            .context("turn is uniquely owned")?
+            .config,
+    )
+    .permissions
+    .approval_policy = codex_config::Constrained::allow_any(AskForApproval::Never);
+    let results = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_gate_contributor(Arc::new(RecordingGate {
+        verdict: codex_extension_api::ApprovalGate::Approve("granted".into()),
+        results: results.clone(),
+    }));
+    Arc::get_mut(&mut session)
+        .context("session is uniquely owned")?
+        .services
+        .extensions = Arc::new(extensions.build());
+    let context = ApprovalContext {
+        review_context: GuardianReviewContext::from(&turn),
+        cancellation_token: None,
+        call_id: "stdin".to_string(),
+        tool_name: ToolName::plain("write_stdin"),
+        strict_auto_review: false,
+        approval_reason: None,
+        retry_reason: None,
+        network_approval_context: None,
+    };
+    let action = ApprovalAction::WriteStdin {
+        id: context.call_id.clone(),
+        approval_id: context.call_id.clone(),
+        environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+        process_id: 1,
+        input: "y\n".to_string(),
+        cwd: PathUri::from_abs_path(&AbsolutePathBuf::try_from(PathBuf::from("/tmp"))?),
+        tty: true,
+        sandbox_permissions: SandboxPermissions::RequireEscalated,
+        additional_permissions: None,
+    };
+    assert!(matches!(
+        session.request_approval(action, context).await,
+        Err(ToolError::Rejected(_))
+    ));
+    assert_eq!(
+        *results
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner),
+        vec![("stdin".to_owned(), "denied".to_owned(), "policy".to_owned())]
+    );
+    Ok(())
+}
