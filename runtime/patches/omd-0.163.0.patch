+static INTERACTION: Mutex<Interaction> = Mutex::new(Interaction {
+    thread: None,
+    focused: None,
+    ids: BTreeSet::new(),
+    targets: BTreeMap::new(),
+    order: Vec::new(),
+    columns: Vec::new(),
