+struct DeferLookup;
+
+impl codex_extension_api::ToolSpecContributor for DeferLookup {
+    fn adjust_tool_specs(
+        &self,
+        _thread_store: &codex_extension_api::ExtensionData,
+        specs: &[codex_extension_api::ToolSpecView],
+    ) -> Option<codex_extension_api::ToolSpecAdjustment> {
+        specs
+            .iter()
+            .any(|spec| spec.name == "mcp__srv__lookup")
+            .then(|| codex_extension_api::ToolSpecAdjustment {
+                defer: vec!["mcp__srv__lookup".into()],
+                ..Default::default()
+            })
+    }
+}
+
+#[tokio::test]
+async fn spec_contributors_defer_direct_tools_behind_tool_search() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).supports_search_tool = true;
+    });
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.tool_spec_contributor(Arc::new(DeferLookup));
+    session.services.extensions = Arc::new(extensions.build());
+    let mcp = codex_mcp::McpBinding::empty(mcp_config_for_test(&turn.config));
+    let mut registry = build_core_tool_registry(
+        &turn,
+        turn.model_info(),
+        &turn.initial_environments,
+        &mcp,
+        /*tool_suggest_candidates*/ None,
+        /*wait_for_environment_tool_config*/ None,
+    );
+    let tool = mcp_runtime("srv", "mcp__srv__", "lookup", ToolExposure::Direct);
+    registry.register_external_with_exposure(tool.runtime, tool.exposure);
+    let mut unsearchable = build_core_tool_registry(
+        &turn,
+        turn.model_info(),
+        &turn.initial_environments,
+        &mcp,
+        /*tool_suggest_candidates*/ None,
+        /*wait_for_environment_tool_config*/ None,
+    );
+    let tool = mcp_runtime("srv", "mcp__srv__", "lookup", ToolExposure::Direct);
+    unsearchable.register_external_with_exposure(tool.runtime, tool.exposure);
+    crate::tools::spec_adjust::plan(&session, &mut unsearchable, /*search_available*/ false);
+    assert_eq!(
+        unsearchable
+            .entries()
+            .find(|tool| tool.runtime.tool_name().name == "lookup")
+            .map(|tool| tool.exposure),
+        Some(ToolExposure::Direct),
+        "without tool search a deferred tool would become unreachable"
+    );
+    let adjustments =
+        crate::tools::spec_adjust::plan(&session, &mut registry, /*search_available*/ true);
+    let mut router = ToolRouter::from_registry(
+        &turn,
+        turn.model_info(),
+        registry,
+        super::hosted_model_tool_specs(&turn, turn.model_info(), &[]),
+        &Default::default(),
+    );
+    crate::tools::spec_adjust::apply(&mut router, &adjustments);
+    let plan = ToolPlanProbe::from_router(router);
+    plan.assert_visible_contains(&["tool_search"]);
+    plan.assert_visible_lacks(&["mcp__srv__"]);
+    assert!(
+        plan.exposures
+            .values()
+            .any(|exposure| *exposure == ToolExposure::Deferred)
+    );
+}
