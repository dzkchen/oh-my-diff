+    async fn remove(&self, handle: &str, slot: &AgentSlot) -> bool {
+        let mut records = self.records.lock().await;
+        if records
+            .get(handle)
+            .is_some_and(|current| Arc::ptr_eq(current, slot))
+        {
+            records.remove(handle);
+            return true;
+        }
+        false
+    }
