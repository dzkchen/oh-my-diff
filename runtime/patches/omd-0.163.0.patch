+                Ok(json!({"text": "x".repeat(70_000)}))
+            },
+        )
+        .unwrap_err();
+    assert_eq!(calls, 2);
+    assert!(
+        error.to_string().starts_with("Error: host_result_limit"),
+        "{error}"
+    );
+    let mut calls = 0;
