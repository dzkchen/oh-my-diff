+            |_| Ok(json!({"text": "x".repeat(140_000)})),
+        )
+        .unwrap_err();
+    assert!(
+        error.to_string().starts_with("Error: host_result_limit"),
+        "{error}"
+    );
+    let mut calls = 0;
+    let error = runtime
+        .invoke_with(
+            "fixture",
+            generation,
+            "command",
+            "run",
+            json!("cumulative"),
+            || true,
