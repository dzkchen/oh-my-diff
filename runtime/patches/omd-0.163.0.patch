+use super::*;
+use pretty_assertions::assert_eq;
+
+fn layout(value: serde_json::Value) -> ModLayout {
+    serde_json::from_value(value).unwrap()
+}
+
+#[test]
+#[serial_test::serial]
+fn splits_tabs_and_chat_union_place_regions() {
+    let layout = layout(serde_json::json!({
+        "split": "horizontal", "ratio": [1, 3],
+        "children": [
+            {"tabs": [{"title": "Files", "node": {"content": "site:files/tree"}},
+                      {"title": "Notes", "node": {"content": "site:notes/pad"}}]},
+            {"split": "vertical", "ratio": [4, 1],
+             "children": [{"content": "transcript"}, {"content": "composer"}]}
+        ]
+    }));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 1, 25, 39))
+    );
+    assert_eq!(placement.area("site:notes/pad"), None);
+    assert_eq!(placement.area("transcript"), Some(Rect::new(25, 0, 75, 32)));
+    assert_eq!(placement.chat(), Some(Rect::new(25, 0, 75, 40)));
+    assert_eq!(
+        placement.tabs[0].titles,
+        vec!["Files".to_owned(), "Notes".to_owned()]
+    );
+
+    let click = |kind, column, row| MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        9,
+        0
+    )));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(
+        placement.area("site:notes/pad"),
+        Some(Rect::new(0, 1, 25, 39))
+    );
+
+    assert!(pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        25,
+        10
+    )));
+    assert!(pointer(click(
+        MouseEventKind::Drag(MouseButton::Left),
+        40,
+        10
+    )));
+    assert!(pointer(click(
+        MouseEventKind::Up(MouseButton::Left),
+        40,
+        10
+    )));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(placement.area("transcript").map(|area| area.x), Some(40));
+    assert!(!pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        70,
+        10
+    )));
+}
+
+#[test]
+#[serial_test::serial]
+fn split_gaps_leave_cells_between_children_and_their_handle() {
+    let layout = layout(
+        serde_json::json!({"split": "horizontal", "gap": 2, "children": [
+        {"content": "site:files/tree", "style": {"border": "thick"}}, {"content": "transcript"}]}),
+    );
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.regions[0],
+        Region {
+            content: "site:files/tree".into(),
+            area: Rect::new(0, 0, 20, 10),
+            style: Some(codex_omd::ModBoxStyle {
+                border: Some(codex_omd::ModBoxBorder::Thick),
+                ..Default::default()
+            }),
+        }
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(22, 0, 20, 10)));
+    let narrow = place(&layout, None, Rect::new(0, 0, 7, 10));
+    assert_eq!(narrow.area("transcript"), Some(Rect::new(4, 0, 3, 10)));
+    place(&layout, None, Rect::new(0, 0, 42, 10));
+    let at = |kind, column| MouseEvent {
+        kind,
+        column,
+        row: 4,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(at(MouseEventKind::Down(MouseButton::Left), 21)));
+    assert!(pointer(at(MouseEventKind::Drag(MouseButton::Left), 30)));
+    assert!(pointer(at(MouseEventKind::Up(MouseButton::Left), 30)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 0, 30, 10))
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+    hide();
+    assert!(!pointer(at(MouseEventKind::Down(MouseButton::Left), 31)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+}
