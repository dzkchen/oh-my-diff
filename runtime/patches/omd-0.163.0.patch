+pub(crate) fn composer_edit(
+    source: &str,
+    caller: &str,
+    revision: u64,
+    edit: Value,
+) -> Result<Value, String> {
+    if !intercepts("composer_edit") {
+        return Ok(edit);
+    }
+    let runtime = shared_host()?;
+    let thread = crate::mod_surface::current_thread();
+    let input =
+        serde_json::json!({"source": source, "caller": caller, "revision": revision, "edit": edit});
+    let result = codex_omd::continue_operation(
+        &runtime,
+        "composer_edit",
+        input,
+        serde_json::json!({"caller": caller, "thread_id": thread}),
+        || true,
+        |_, call| {
+            Err(std::io::Error::other(format!(
+                "host_operation_unavailable: composer_edit interceptors run while the terminal applies the edit ({})",
+                call.operation
+            )))
+        },
+        |effective| Ok(serde_json::json!({"edit": effective["edit"]})),
+    )
+    .map_err(|error| error.to_string())?;
+    match result["deny"].as_str() {
+        Some(reason) => Err(format!("composer_edit_denied: {reason}")),
+        None => Ok(result["edit"].clone()),
+    }
+}
