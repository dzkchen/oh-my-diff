+    assert_eq!(
+        runtime
+            .invoke_with(
+                "fixture",
+                generation,
+                "command",
+                "run",
+                json!("small"),
+                || true,
+                |_| { Ok(Value::Null) }
+            )
+            .unwrap(),
+        json!("ok")
+    );
+}
