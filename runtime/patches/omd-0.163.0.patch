+        store: None,
+        protected: Vec::new(),
+    }
+}
+
+fn scope(context: InvocationContext) -> crate::mod_runtime::CallScope<'static> {
+    fn active() -> bool {
+        true
+    }
+    crate::mod_runtime::CallScope {
+        epoch: codex_omd::client_surface::epoch(),
+        context,
+        thread: None,
+        active: std::sync::Arc::new(active),
+    }
+}
