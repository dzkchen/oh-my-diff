+        return Ok(digest.clone());
+    }
+    let mut hasher = Sha256::new();
+    std::io::copy(&mut File::open(node)?, &mut hasher)?;
+    let digest = format!("{:x}", hasher.finalize());
+    digests.insert(node.to_path_buf(), (stamp, digest.clone()));
