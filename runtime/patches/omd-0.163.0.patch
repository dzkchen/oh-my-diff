+
+fn native_cards(snapshot: &ModViewSnapshot, width: u16) -> Option<ModComponent> {
+    const LINES: usize = 4;
+    let panels = native_panels(snapshot);
+    let count = u16::try_from(panels.len()).unwrap_or(u16::MAX).max(1);
+    let text_width = usize::from(
+        (width.saturating_sub(count - 1) / count)
+            .saturating_sub(4)
+            .max(8),
+    );
+    let cards = panels
+        .into_iter()
+        .enumerate()
+        .map(|(index, panel)| {
+            let mut lines = panel.lines;
+            let more = lines.len().saturating_sub(LINES);
+            lines.truncate(LINES);
+            if more > 0 {
+                lines.push(format!("+{more} more"));
+            }
+            let lines = lines
+                .iter()
+                .flat_map(|line| {
+                    let mut wrapped = textwrap::wrap(line, text_width)
+                        .into_iter()
+                        .map(std::borrow::Cow::into_owned)
+                        .collect::<Vec<_>>();
+                    if wrapped.len() > 6 {
+                        wrapped.truncate(6);
+                        wrapped[5].push('…');
+                    }
+                    wrapped
+                })
+                .collect();
+            ModComponent::Box {
+                id: format!("@native_card_{index}"),
+                label: panel.title.clone(),
+                title: Some(panel.title),
+                children: panel_text(&format!("@native_card_{index}"), lines),
+                min_width: None,
+                max_width: None,
+                pointer: false,
+                style: Some(card(snapshot.view.theme.border)),
+                flex: None,
+            }
+        })
+        .collect::<Vec<_>>();
+    (!cards.is_empty()).then(|| ModComponent::Box {
+        id: "@native_cards".into(),
+        label: "Mod status".into(),
+        title: None,
+        children: cards,
+        min_width: None,
+        max_width: None,
+        pointer: false,
+        style: Some(ModBoxStyle {
+            direction: Some(ModDirection::Row),
+            gap: Some(1),
+            ..ModBoxStyle::default()
+        }),
+        flex: None,
+    })
+}
