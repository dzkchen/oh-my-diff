+    assert_eq!(plan.changes["packages"][0]["renewed_approval"], true);
+    assert_eq!(plan.changes["packages"][0]["activation"]["to"], false);
+    let lock = store
+        .package_apply(request(&package, &["exec"]), &plan.confirmation)
