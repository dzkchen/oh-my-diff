+        ..Facts::default()
+    });
+    assert!(enable_pixel_pointer());
+    let event = |column, row| MouseEvent {
+        kind: MouseEventKind::Moved,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    };
+    let converted = to_cells(event(35, 49)).expect("first motion");
+    assert_eq!(
+        (converted.column, converted.row, last_half()),
+        (3, 2, Some(0))
+    );
+    assert_eq!(to_cells(event(38, 41)), None, "same half cell");
+    let converted = to_cells(event(35, 51)).expect("next half row");
+    assert_eq!(
+        (converted.column, converted.row, last_half()),
+        (3, 2, Some(1))
+    );
+    let press = MouseEvent {
+        kind: MouseEventKind::Down(crossterm::event::MouseButton::Left),
+        ..event(35, 51)
+    };
+    assert!(to_cells(press).is_some(), "presses always pass");
+    assert!(to_cells(event(35, 51)).is_some());
+    assert!(disable_pixel_pointer());
+    assert_eq!(to_cells(event(35, 51)).map(|event| event.column), Some(35));
+    assert_eq!(last_half(), None);
+    let value = facts().value();
+    assert_eq!(value["pointer"], "none");
+    assert_eq!(value["cell_px"], json!({"width": 10, "height": 20}));
+    *FACTS.lock().unwrap() = None;
