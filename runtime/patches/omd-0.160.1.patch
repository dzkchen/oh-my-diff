+        let prompt = |key: &str| {
+            let (reply, _) = std::sync::mpsc::sync_channel(1);
+            confirmation(&SurfaceCall {
+                caller: "curator".into(),
+                operation: "config.set".into(),
+                arguments: json!({"key": key, "value": true}),
+                context: codex_omd::app_routes::InvocationContext::User,
+                thread: None,
+                confirm: None,
+                reply,
+            })
+            .unwrap()
+            .is_some()
+        };
+        assert!(!prompt("mods.curator.hint"));
+        assert!(prompt("mods.other.route") && prompt("mods.curator_x.hint") && prompt("model"));
+    }
+
+    #[test]
+    fn listeners_follow_descendants_and_deduplicate_ports() {
+        assert_eq!(
+            descendants("10 1\n11 10\n12 11\n13 99\n", &[10]),
+            [10, 11, 12]
+        );
+        assert_eq!(
+            parse_listeners("p11\nn*:5173\nn[::1]:5173\np12\nn127.0.0.1:3000\n"),
+            [
+                json!({"port": 3000, "pid": 12, "address": "127.0.0.1:3000"}),
+                json!({"port": 5173, "pid": 11, "address": "*:5173"})
+            ]
+        );
+    }
+
+    #[test]
+    fn open_targets_are_web_urls_or_inert_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let page = dir.path().join("page.html");
+        let script = dir.path().join("run.command");
+        std::fs::write(&page, "<p>hi</p>").unwrap();
+        std::fs::write(&script, "echo hi").unwrap();
+        assert!(open_target(&json!({"url": "https://example.com/a"})).is_ok());
+        assert!(open_target(&json!({"path": page})).is_ok());
+        for refused in [
+            json!({"url": "javascript:alert(1)"}),
+            json!({"url": "https://example.com/a b"}),
+            json!({"path": script}),
+            json!({"path": dir.path()}),
+            json!({"url": "https://example.com", "path": page}),
+        ] {
+            assert!(open_target(&refused).is_err());
+        }
+    }
+    #[test]
+    fn image_samples_reject_unbounded_fractional_or_missing_sizes() {
+        assert_eq!(
+            image_sample_dimensions(&json!({"columns":120,"rows":60})).unwrap(),
+            (120, 60)
+        );
+        for value in [
+            json!({"columns":121,"rows":1}),
+            json!({"columns":1,"rows":61}),
+            json!({"columns":0,"rows":1}),
+            json!({"columns":1.5,"rows":2}),
+            json!({"columns":-1,"rows":2}),
