+#[tokio::test]
+async fn disabled_collaboration_modes_clamp_to_default_at_turn_start() {
+    struct DisablesPlanOnInput(std::sync::atomic::AtomicBool);
+
+    impl codex_extension_api::TurnLifecycleContributor for DisablesPlanOnInput {
+        fn intercept_user_input<'a>(
+            &'a self,
+            _input: codex_extension_api::UserInputInterceptInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, codex_extension_api::UserInputDecision>
+        {
+            self.0.store(true, std::sync::atomic::Ordering::SeqCst);
+            Box::pin(async { codex_extension_api::UserInputDecision::Keep })
+        }
+
+        fn disabled_collaboration_modes(&self) -> Vec<String> {
+            if self.0.load(std::sync::atomic::Ordering::SeqCst) {
+                vec!["plan".to_string()]
+            } else {
+                Vec::new()
+            }
+        }
+    }
+
+    let (mut session, turn_context) = make_session_and_context().await;
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(DisablesPlanOnInput(Default::default())));
+    session.services.extensions = Arc::new(builder.build());
+    let session = Arc::new(session);
+    let requested = |mode| CollaborationMode {
+        mode,
+        settings: Settings {
+            model: turn_context.model_info().slug.clone(),
+            reasoning_effort: None,
+            developer_instructions: Some("plan first".to_string()),
+        },
+    };
+    let request = |mode| {
+        TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "hello".to_string(),
+            text_elements: Vec::new(),
+        }])
+        .with_thread_settings(ThreadSettingsOverrides {
+            collaboration_mode: Some(requested(mode)),
+            ..Default::default()
+        })
+    };
+
+    let clamped = intercept_user_input(&session, request(ModeKind::Plan), "sub-1")
+        .await
+        .expect("intercept");
+    let mode = clamped.thread_settings.collaboration_mode.expect("mode");
+    assert_eq!(mode.mode, ModeKind::Default);
+    assert_eq!(mode.settings.developer_instructions, None);
+    assert_eq!(mode.settings.model, turn_context.model_info().slug);
+
+    let kept = intercept_user_input(&session, request(ModeKind::Default), "sub-2")
+        .await
+        .expect("intercept");
+    assert_eq!(
+        kept.thread_settings.collaboration_mode,
+        Some(requested(ModeKind::Default))
+    );
+}
