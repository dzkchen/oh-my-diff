+use codex_app_server_protocol::ThreadRewriteParams;
+use codex_app_server_protocol::ThreadRewriteResponse;
+use codex_app_server_protocol::ThreadRewrittenNotification;
+use codex_app_server_protocol::ThreadSearchParams;
+use codex_app_server_protocol::ThreadSearchResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadStartResponse;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStartResponse;
+use codex_app_server_protocol::UserInput;
+use codex_protocol::config_types::CollaborationMode;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::config_types::Settings;
+use codex_protocol::openai_models::ReasoningEffort;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+const DEFAULT_READ_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(10);
+
+#[tokio::test]
+async fn thread_rewrite_is_durable_across_restart_search_export_and_undo() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    let mut mcp = start(codex_home.path()).await?;
+    let ThreadStartResponse { thread, .. } = mcp
+        .start_thread(ThreadStartParams {
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            ..Default::default()
+        })
+        .await?;
+    let mut turn_ids = Vec::new();
+    for text in ["deploy with secret-alpha", "second"] {
+        let completed = mcp
+            .start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: thread.id.clone(),
+                input: vec![UserInput::Text {
+                    text: text.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+        turn_ids.push(completed.turn.id);
+    }
+
+    let read = rewrite(&mut mcp, &thread.id, None, Vec::new(), false).await?;
+    assert_eq!(read.previous_revision, None);
+    let prompt = read
+        .rows
+        .iter()
+        .rfind(|row| row.kind == "message.user" && row.turn_id.as_ref() == Some(&turn_ids[0]))
+        .expect("first prompt row")
+        .id
+        .clone();
+    let redact = json!({"op": "replace", "id": prompt, "items": [{
+        "type": "message", "role": "user",
+        "content": [{"type": "input_text", "text": "deploy with [redacted]"}],
+    }]});
+
+    let forged = mcp
+        .send_raw_request(
+            "thread/rewrite",
+            Some(json!({"threadId": thread.id, "expectedRevision": "stale:1", "edits": [redact]})),
+        )
+        .await?;
+    let stale: JSONRPCError = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_error_message(RequestId::Integer(forged)),
+    )
+    .await??;
+    assert!(stale.error.message.contains("history_revision_conflict"));
+
+    let rewritten = rewrite(
+        &mut mcp,
+        &thread.id,
+        Some(read.revision.clone()),
+        vec![redact],
+        false,
+    )
+    .await?;
+    let notification: ThreadRewrittenNotification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_notification("thread/rewritten"),
+    )
+    .await??;
+    assert_eq!(notification.thread_id, thread.id);
+    assert_eq!(notification.revision, rewritten.revision);
+    assert_eq!(rewritten.previous_revision, Some(read.revision));
+    let items = items_text(&mut mcp, &thread.id).await?;
+    assert!(items.contains("[redacted]"));
+    assert!(!items.contains("secret-alpha"));
+
+    mcp.shutdown_gracefully().await?;
+    let mut mcp = start(codex_home.path()).await?;
+    assert!(search(&mut mcp, "secret-alpha").await?.is_empty());
+    assert_eq!(search(&mut mcp, "[redacted]").await?, vec![thread.id.clone()]);
+    let resume_id = mcp
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: thread.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(resume_id)).await??;
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: thread.id.clone(),
+        input: vec![UserInput::Text {
+            text: "third".to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let requests = server.received_requests().await.expect("response requests");
+    let model_input = requests
+        .iter()
+        .rev()
+        .find(|request| request.url.path().ends_with("/responses"))
+        .expect("third turn response request")
+        .body_json::<serde_json::Value>()?["input"]
+        .to_string();
+    assert!(model_input.contains("[redacted]"));
+    assert!(!model_input.contains("secret-alpha"));
+    assert!(model_input.contains("third"));
+
+    let current = rewrite(&mut mcp, &thread.id, None, Vec::new(), false).await?;
+    rewrite(&mut mcp, &thread.id, Some(current.revision), Vec::new(), true).await?;
+    let restored = items_text(&mut mcp, &thread.id).await?;
+    assert!(restored.contains("secret-alpha"));
+    assert!(restored.contains("third"));
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_rewrite_refuses_a_turn_in_progress() -> Result<()> {
+    let home = TempDir::new()?;
+    let server = create_mock_responses_server_sequence(vec![
+        create_final_assistant_message_sse_response("first")?,
+        create_request_user_input_sse_response("call_blocked")?,
+    ])
+    .await;
+    MockResponsesConfig::new(&server.uri()).write(home.path())?;
+    let mut mcp = start(home.path()).await?;
+    let ThreadStartResponse { thread, .. } = mcp
+        .start_thread(ThreadStartParams {
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            ..Default::default()
+        })
+        .await?;
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: thread.id.clone(),
+        input: vec![UserInput::Text {
+            text: "first".to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let read = rewrite(&mut mcp, &thread.id, None, Vec::new(), false).await?;
+    let _: TurnStartResponse = mcp
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: thread.id.clone(),
+                input: vec![UserInput::Text {
+                    text: "wait".to_string(),
+                    text_elements: Vec::new(),
+                }],
+                collaboration_mode: Some(CollaborationMode {
+                    mode: ModeKind::Plan,
+                    settings: Settings {
+                        model: "mock-model".to_string(),
+                        reasoning_effort: Some(ReasoningEffort::Medium),
+                        developer_instructions: None,
+                    },
+                }),
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            },
+        })
+        .await?;
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_request_message(),
+    )
+    .await??;
+    let busy = mcp
+        .send_raw_request(
+            "thread/rewrite",
+            Some(json!({"threadId": thread.id, "expectedRevision": read.revision,
+                "edits": [{"op": "delete", "id": read.rows[0].id}]})),
+        )
+        .await?;
+    let error: JSONRPCError = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_error_message(RequestId::Integer(busy)),
+    )
+    .await??;
+    assert!(error.error.message.contains("history_rewrite_busy"));
+    Ok(())
+}
+
+async fn rewrite(
+    mcp: &mut TestAppServer,
+    thread_id: &str,
+    expected_revision: Option<String>,
+    edits: Vec<serde_json::Value>,
