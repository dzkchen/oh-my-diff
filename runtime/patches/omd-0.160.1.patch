+#[test]
+fn rewritten_tool_rows_are_labeled_as_not_execution_evidence() {
+    struct Rewritten(Vec<ResponseItem>);
+    impl crate::SectionHistory for Rewritten {
+        fn items(&self) -> Box<dyn Iterator<Item = &ResponseItem> + Send + '_> {
+            Box::new(self.0.iter())
+        }
+        fn rewritten_item_ids(&self) -> std::collections::HashSet<String> {
+            ["call-1".to_string()].into()
+        }
+    }
+    let call = |call_id: &str| ResponseItem::FunctionCall {
+        id: None,
+        name: "run_tests".to_string(),
+        namespace: None,
+        arguments: "{}".to_string(),
+        call_id: call_id.to_string(),
+        encrypted_function_args: None,
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let output = |call_id: &str| ResponseItem::FunctionCallOutput {
+        id: None,
+        call_id: Some(call_id.to_string()),
+        name: None,
+        namespace: None,
+        output: FunctionCallOutputPayload::from_text("passed".to_string()),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let history = Rewritten(vec![call("call-1"), output("call-1"), call("call-2"), output("call-2")]);
+    let kinds: Vec<ConversationTranscriptEntryKind> = collect_transcript(&history, &transcript_config())
+        .into_iter()
+        .map(|entry| entry.kind)
+        .collect();
+    assert_eq!(
+        kinds,
+        vec![
+            ConversationTranscriptEntryKind::ToolCall(
+                "tool run_tests call (rewritten, not execution evidence)".to_string()
+            ),
+            ConversationTranscriptEntryKind::ToolOutput(
+                "tool run_tests result (rewritten, not execution evidence)".to_string()
+            ),
+            ConversationTranscriptEntryKind::ToolCall("tool run_tests call".to_string()),
+            ConversationTranscriptEntryKind::ToolOutput("tool run_tests result".to_string()),
+        ]
+    );
+}
