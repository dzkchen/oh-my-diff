+        ))
+        .await
+        .map_err(|e| e.to_string())??;
+        if cancelled.load(Ordering::Acquire) {
+            return Err("history_capture_cancelled".into());
+        }
+        Ok(json!({"evidence":evidence,"provenance":provenance}))
+    }
