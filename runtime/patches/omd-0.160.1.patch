+/// Read, or atomically rewrite, a paginated idle thread's durable transcript rows.
+///
+/// Without `expectedRevision` this only reads. A rewrite writes the edited transcript to a new
+/// rollout; resume, `thread/turns/list`, `thread/items/list`, search and export then read it. The
+/// replaced rollout is kept, and rewritten rows carry provenance and are never execution evidence.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadRewriteParams {
+    pub thread_id: String,
+    /// Revision the edits were made against; a different current revision is a conflict.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub expected_revision: Option<String>,
+    /// Row edits applied in order: `{op: "delete", id}`, `{op: "replace", id, items}`,
+    /// `{op: "insert", before?, after?, items}` and `{op: "move", id, before?, after?}`, where
+    /// `items` is one Responses message or one tool call followed by its output.
+    #[serde(default)]
+    pub edits: Vec<JsonValue>,
+    /// Restore the transcript the latest rewrite replaced, keeping rows added since.
+    #[serde(default)]
+    pub undo: bool,
+    /// Recorded as edit provenance; defaults to the client name.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub author: Option<String>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadRewriteRow {
+    pub id: String,
+    pub turn_id: Option<String>,
+    pub kind: String,
+    /// `edit`, `delete` (delete only) or `frozen`.
+    pub access: String,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadRewriteResponse {
+    pub revision: String,
+    pub previous_revision: Option<String>,
+    pub rows: Vec<ThreadRewriteRow>,
+}
