+#[test]
+#[serial_test::serial]
+fn tool_notices_report_whether_a_drawn_cell_claims_the_call() {
+    clear_tool_notices();
+    let target = |id: &str| RenderTarget::new("tool_call", id, false, json!({}));
+    assert!(!tool_notice("call_unseen", "info", "x", "checks"));
+    assert!(
+        tool_notice_lines(&target("call_unseen")).is_empty(),
+        "a refused notice is not stored for a cell drawn later"
+    );
+    tool_notice_lines(&target("call_seen"));
+    assert!(tool_notice("call_seen", "info", "x", "checks"));
+    let shown = texts(&tool_notice_lines(&target("call_seen")));
+    assert_eq!(shown.len(), 1);
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    assert_eq!(
+        texts(&tool_notice_lines(&target("call_seen"))),
+        shown,
+        "ordinary view updates retain a tool's notice"
+    );
+    crate::mod_ui::invalidate_context();
+    assert!(
+        !tool_notice("call_seen", "info", "old call", "checks"),
+        "the previous thread's drawn call cannot claim a new notice"
+    );
+    assert!(tool_notice_lines(&target("call_seen")).is_empty());
+    assert!(tool_notice("call_seen", "info", "new thread", "checks"));
+    let shown = texts(&tool_notice_lines(&target("call_seen")));
+    assert_eq!(shown.len(), 1);
+    assert!(shown[0].contains("new thread"));
+    clear_tool_notices();
+}
