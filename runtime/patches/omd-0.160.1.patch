+    let items = items();
+    for refused in [
+        json!({"drop": [1]}),
+        json!({"drop": [2]}),
+        json!({"drop": [2, 3]}),
+        json!({"drop": [5]}),
+        json!({"replace": [{"index": 1, "text": "x"}]}),
+        json!({"replace": [{"index": 5, "text": "x"}]}),
+        json!({"insert": [{"before": 0, "role": "assistant", "text": "x"}]}),
+        json!({"insert": [{"before": 2, "role": "developer", "text": "x"}]}),
