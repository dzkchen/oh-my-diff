+        ws_auth: Some(WebsocketAuthCliMode::CapabilityToken),
+        ws_token_sha256: Some("ab".repeat(32)),
+        ws_allowed_origins: vec![origin.to_string(), "vscode-webview://abc".to_string()],
+        ..Default::default()
+    };
+    let settings = args("HTTP://127.0.0.1:5173/")
+        .try_into_settings()
+        .expect("allowed origins should parse");
+    assert_eq!(
+        settings.allowed_origins,
+        vec![
+            "http://127.0.0.1:5173".to_string(),
+            "vscode-webview://abc".to_string()
+        ]
+    );
+    for invalid in [
+        "null",
+        "*",
+        "https://*.example.com",
+        "https://example.com/path",
+    ] {
+        let err = args(invalid)
+            .try_into_settings()
+            .expect_err("invalid origin should be rejected");
+        assert!(err.to_string().contains(invalid), "unexpected error: {err}");
+    }
+
+    let policy = policy_from_settings(&settings).expect("policy should build");
+    let allowed =
+        |origin: &'static str| is_allowed_origin(&HeaderValue::from_static(origin), &policy);
+    assert!(allowed("http://127.0.0.1:5173"));
+    assert!(allowed("vscode-webview://abc"));
+    assert!(!allowed("http://127.0.0.1:5174"));
+    assert!(!allowed("vscode-webview://abcd"));
+    assert!(!allowed("null"));
+
+    let settings = args("HTTPS://Example.com:443")
+        .try_into_settings()
+        .expect("default port should parse");
+    assert_eq!(settings.allowed_origins[0], "https://example.com");
+    let policy = policy_from_settings(&settings).expect("policy should build");
+    for origin in ["https://example.com", "https://example.com:443"] {
+        assert!(is_allowed_origin(
+            &HeaderValue::from_static(origin),
+            &policy
+        ));
+    }
+}
