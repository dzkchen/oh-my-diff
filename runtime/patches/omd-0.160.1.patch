+        self.last_micros = elapsed;
+        self.logs
+            .push(json!({"generation":generation,"event":event,"name":name,
+            "outcome":outcome,"elapsed_micros":elapsed}));
+        if self.logs.len() > 64 {
+            self.logs.remove(0);
