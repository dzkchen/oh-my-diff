new file mode 100644
index 000000000..64442dbd0
--- /dev/null
+++ b/codex-rs/tui/src/mod_client.rs
@@ -0,0 +1,347 @@
+use codex_terminal_detection::TerminalName;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::io::Write;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU8;
+use std::sync::atomic::Ordering;
+
+const PLACEHOLDER: char = '\u{10EEEE}';
+const DIACRITICS: [char; 40] = [
+    '\u{0305}', '\u{030D}', '\u{030E}', '\u{0310}', '\u{0312}', '\u{033D}', '\u{033E}', '\u{033F}',
+    '\u{0346}', '\u{034A}', '\u{034B}', '\u{034C}', '\u{0350}', '\u{0351}', '\u{0352}', '\u{0357}',
+    '\u{035B}', '\u{0363}', '\u{0364}', '\u{0365}', '\u{0366}', '\u{0367}', '\u{0368}', '\u{0369}',
+    '\u{036A}', '\u{036B}', '\u{036C}', '\u{036D}', '\u{036E}', '\u{036F}', '\u{0483}', '\u{0484}',
+    '\u{0485}', '\u{0486}', '\u{0487}', '\u{0592}', '\u{0593}', '\u{0594}', '\u{0595}', '\u{0597}',
+];
+const FIRST_IMAGE_ID: u32 = 0x4f_4d_01;
+pub(crate) const DEFAULT_CELL: (u16, u16) = (8, 16);
+const HALF_UNKNOWN: u8 = 2;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Facts {
+    pub(crate) placeholders: bool,
+    pub(crate) pixel_pointer: bool,
+    pub(crate) no_color: bool,
+    pub(crate) reduced_motion: bool,
+    pub(crate) pointer: bool,
+    pub(crate) cell: Option<(u16, u16)>,
+    size: (u16, u16),
+}
+
+impl Facts {
+    fn detect() -> Self {
+        let terminal = codex_terminal_detection::terminal_info();
+        let local = terminal.multiplexer.is_none()
+            && ["SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY"]
+                .iter()
+                .all(|name| std::env::var_os(name).is_none());
+        let mut facts = Self {
+            placeholders: local
+                && matches!(terminal.name, TerminalName::Kitty | TerminalName::Ghostty),
+            pixel_pointer: terminal.multiplexer.is_none()
+                && matches!(
+                    terminal.name,
+                    TerminalName::Kitty | TerminalName::Ghostty | TerminalName::WezTerm
+                ),
+            no_color: std::env::var_os("NO_COLOR").is_some(),
+            pointer: crate::omd::mouse_enabled() && terminal.multiplexer.is_none(),
+            ..Self::default()
+        };
+        facts.measure();
+        facts
+    }
+
+    fn measure(&mut self) {
+        self.apply(crossterm::terminal::window_size().ok());
+    }
+
+    /// A failed or pixel-less measurement keeps the last cell size: pixel pointer reports can't be converted without one.
+    fn apply(&mut self, size: Option<crossterm::terminal::WindowSize>) {
+        let Some(size) = size else {
+            return;
+        };
+        self.size = (size.columns, size.rows);
+        let measured = (size.columns > 0 && size.rows > 0 && size.width > 0 && size.height > 0)
+            .then(|| (size.width / size.columns, size.height / size.rows))
+            .filter(|(width, height)| *width > 0 && *height > 0);
+        self.cell = measured.or(self.cell);
+    }
+
+    pub(crate) fn graphics(&self) -> &'static str {
+        if self.no_color {
+            "text"
+        } else if self.placeholders {
+            "kitty"
+        } else {
+            "cells"
+        }
+    }
+
+    pub(crate) fn value(&self) -> Value {
+        json!({
+            "kind": "terminal",
+            "graphics": self.graphics(),
+            "pointer": if !self.pointer {
+                "none"
+            } else if PIXEL_MODE.load(Ordering::Relaxed) {
+                "half_cell"
+            } else {
+                "cell"
+            },
+            "reduced_motion": self.reduced_motion,
+            "cell_px": self.cell.map(|(width, height)| json!({"width": width, "height": height})),
+        })
+    }
+}
+
+static FACTS: Mutex<Option<Facts>> = Mutex::new(None);
+static PIXEL_MODE: AtomicBool = AtomicBool::new(false);
+static HALF: AtomicU8 = AtomicU8::new(HALF_UNKNOWN);
+fn with<T>(run: impl FnOnce(&mut Facts) -> T) -> T {
+    let mut facts = FACTS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    run(facts.get_or_insert_with(Facts::detect))
+}
+
+pub(crate) fn facts() -> Facts {
+    with(|facts| *facts)
+}
+
+pub(crate) fn value() -> Value {
+    facts().value()
+}
+
+/// Called before each draw; measures cell pixels again only when the grid size changes.
+pub(crate) fn update(animations: bool, columns: u16, rows: u16, pointer: bool) {
+    let changed = with(|facts| {
+        let pixel = PIXEL_MODE.load(Ordering::Relaxed);
+        let before = *facts;
+        facts.reduced_motion = !animations;
+        facts.pointer = pointer;
+        if facts.size != (columns, rows) {
+            facts.measure();
+            facts.size = (columns, rows);
+        }
+        reports_differ((before, pixel), (*facts, pixel))
+    });
+    if changed {
+        std::thread::spawn(crate::mod_runtime::rerender);
+    }
+}
+
+/// Whether what the mod view reports changed; the grid size alone does not re-render.
+fn reports_differ(before: (Facts, bool), after: (Facts, bool)) -> bool {
+    let after = (
+        Facts {
+            size: before.0.size,
+            ..after.0
+        },
+        after.1,
+    );
+    after != before
+}
+
+/// SGR-pixel reports are requested only where the terminal is known to honor them.
+pub(crate) fn enable_pixel_pointer() -> bool {
+    let enabled = with(|facts| facts.pixel_pointer && facts.cell.is_some());
+    set_pixel_mode(enabled);
+    enabled
+}
+
+pub(crate) fn disable_pixel_pointer() -> bool {
+    set_pixel_mode(false)
+}
+
+/// Returns the previous mode; the pointer fact the mod view reports follows it, so a flip re-renders.
+fn set_pixel_mode(on: bool) -> bool {
+    let was = PIXEL_MODE.swap(on, Ordering::Relaxed);
+    let facts = facts();
+    if reports_differ((facts, was), (facts, on)) {
+        std::thread::spawn(crate::mod_runtime::rerender);
+    }
+    was
+}
+
+/// Pixel reports become cell events; motion that stays in the same half cell is dropped.
+pub(crate) fn to_cells(mut event: MouseEvent) -> Option<MouseEvent> {
+    static LAST_MOTION: Mutex<Option<(u16, u16, u8)>> = Mutex::new(None);
+    let cell = PIXEL_MODE
+        .load(Ordering::Relaxed)
+        .then(|| with(|facts| facts.cell))
+        .flatten();
+    let Some((width, height)) = cell else {
+        HALF.store(HALF_UNKNOWN, Ordering::Relaxed);
+        return Some(event);
+    };
+    let half = u8::from(event.row % height >= height.div_ceil(2));
+    HALF.store(half, Ordering::Relaxed);
+    event.column /= width;
+    event.row /= height;
+    let position = Some((event.column, event.row, half));
+    let mut last = LAST_MOTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if matches!(event.kind, MouseEventKind::Moved | MouseEventKind::Drag(_)) {
+        if *last == position {
+            return None;
+        }
+        *last = position;
+    } else {
+        *last = None;
+    }
+    Some(event)
+}
+
+/// The half-cell row of the pointer event most recently converted by `to_cells`.
+pub(crate) fn last_half() -> Option<u8> {
+    let half = HALF.load(Ordering::Relaxed);
+    (half != HALF_UNKNOWN).then_some(half)
+}
+
+struct Images {
+    placed: BTreeMap<String, (String, u32, u16, u16)>,
+    next: u32,
+    pending: Vec<String>,
+}
+
+static IMAGES: Mutex<Images> = Mutex::new(Images {
+    placed: BTreeMap::new(),
+    next: FIRST_IMAGE_ID,
+    pending: Vec::new(),
+});
+
+fn images() -> std::sync::MutexGuard<'static, Images> {
+    IMAGES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn remove(id: u32) -> String {
+    crate::mod_backdrop::kitty_remove(id)
+}
+
+/// One Kitty image per component: a new key replaces the component's previous image.
+pub(crate) fn kitty_image(
+    component: &str,
+    key: &str,
+    png: impl FnOnce() -> Option<(Vec<u8>, u16, u16)>,
+) -> Option<(u32, u16, u16)> {
+    let mut images = images();
+    if let Some((placed, id, columns, rows)) = images.placed.get(component)
+        && placed == key
+    {
+        return Some((*id, *columns, *rows));
+    }
+    let (png, columns, rows) = png()?;
+    let id = images.next;
+    images.next = if id >= 0xff_ff_ff {
+        FIRST_IMAGE_ID
+    } else {
+        id + 1
+    };
+    if let Some((_, previous, _, _)) = images
+        .placed
+        .insert(component.to_owned(), (key.to_owned(), id, columns, rows))
+    {
+        images.pending.push(remove(previous));
+    }
+    images.pending.push(crate::mod_backdrop::kitty_transmit(
+        &png,
+        &format!("a=T,U=1,t=d,f=100,i={id},c={columns},r={rows},q=2"),
+    ));
+    Some((id, columns, rows))
+}
+
+pub(crate) fn placeholder_rows(
+    id: u32,
+    columns: u16,
+    rows: u16,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let [_, red, green, blue] = id.to_be_bytes();
+    #[allow(clippy::disallowed_methods)]
+    let style = Style::default().fg(Color::Rgb(red, green, blue));
+    DIACRITICS
+        .iter()
+        .take(usize::from(rows))
+        .map(|row| {
+            let cells = DIACRITICS
+                .iter()
+                .take(usize::from(columns))
+                .map(|column| format!("{PLACEHOLDER}{row}{column}"))
+                .collect::<String>();
+            Line::from(vec![
+                Span::raw(prefix.to_owned()),
+                Span::styled(cells, style),
+            ])
+        })
+        .collect()
+}
+
+pub(crate) fn max_placeholder_cells() -> u16 {
+    DIACRITICS.len() as u16
+}
+
+pub(crate) fn retain(components: &BTreeSet<String>) {
+    let mut images = images();
+    let gone = images
+        .placed
+        .keys()
+        .filter(|component| !components.contains(*component))
+        .cloned()
+        .collect::<Vec<_>>();
+    for component in gone {
+        if let Some((_, id, _, _)) = images.placed.remove(&component) {
+            images.pending.push(remove(id));
+        }
+    }
+}
+
+fn write(sequences: Vec<String>) {
+    if sequences.is_empty() {
+        return;
+    }
+    let mut stdout = std::io::stdout();
+    for sequence in sequences {
+        let _ = stdout.write_all(sequence.as_bytes());
+    }
+    let _ = stdout.flush();
+}
+
+/// Writes queued Kitty transmissions and deletions after a frame has been flushed.
+pub(crate) fn flush() {
+    let pending = std::mem::take(&mut images().pending);
+    write(pending);
+}
+
+/// Deletes every image this process placed; used on exit and suspend.
+pub(crate) fn teardown() {
+    crate::mod_backdrop_sync::teardown();
+    let mut images = images();
+    let mut sequences = std::mem::take(&mut images.pending)
+        .into_iter()
+        .filter(|sequence| sequence.starts_with("\x1b_Ga=d"))
+        .collect::<Vec<_>>();
+    sequences.extend(
+        std::mem::take(&mut images.placed)
+            .into_values()
+            .map(|(_, id, _, _)| remove(id)),
+    );
+    drop(images);
+    write(sequences);
+}
+
+#[cfg(test)]
+#[path = "mod_client_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/mod_client_tests.rs b/codex-rs/tui/src/mod_client_tests.rs
