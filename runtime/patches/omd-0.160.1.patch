+impl App {
+    pub(super) fn forward_mod_notification(&self, notification: &ServerNotification) {
+        match notification {
+            ServerNotification::ThreadDeleted(deleted) => {
+                if let Some(store) = crate::omd::store_root() {
+                    let _ = codex_omd::data_store::remove_thread_data(&store, &deleted.thread_id);
+                }
+            }
+            ServerNotification::ServerRequestResolved(resolved) => {
+                if let Ok(request_id) = serde_json::to_value(&resolved.request_id) {
+                    crate::mod_surface::server_request_resolved(request_id);
+                }
+            }
+            _ => {}
+        }
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(notification)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::notification(
+                &method,
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    pub(super) fn forward_mod_server_request(&self, request: &ServerRequest) {
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(request)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::server_request(
+                &method,
+                value.remove("id").unwrap_or(Value::Null),
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    fn mod_shell_command(
+        &self,
+        caller: &str,
+        arguments: &Value,
+    ) -> Result<(std::process::Command, std::path::PathBuf), String> {
+        let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+        if arguments["sandbox"] == "none" {
+            let access = crate::mod_runtime::os_access(caller).ok_or("capability_denied: os")?;
+            if !arguments["network"].is_null() || !arguments["write"].is_null() {
+                return Err("pty_unrestricted_arguments_invalid".into());
+            }
+            let cwd = paths
+                .repository
+                .join(arguments["cwd"].as_str().unwrap_or("."))
+                .canonicalize()
+                .map_err(|_| "pty_cwd_invalid")?;
+            let argv = crate::mod_pty::argv(arguments)?;
+            let program = codex_omd::host::unrestricted_program(&access, &argv[0])?;
+            if let Some(expected) = arguments["sha256"].as_str()
+                && codex_omd::host::program_hash(&program)? != expected
+            {
+                return Err("pty_program_changed".into());
+            }
+            let mut command = codex_omd::host::unrestricted_command(&access, &program, &[]);
+            command.args(&argv[1..]).current_dir(cwd);
+            let home = std::env::var_os("HOME").ok_or("pty_home_unavailable")?;
+            return Ok((command, home.into()));
+        }
+        if !arguments["sandbox"].is_null() {
+            return Err("pty_sandbox_invalid".into());
+        }
+        let policy = self.chat_widget.mod_context().policy;
+        let cwd = paths
+            .repository
+            .join(arguments["cwd"].as_str().unwrap_or("."))
+            .canonicalize()
+            .map_err(|_| "pty_cwd_invalid")?;
+        if !cwd.starts_with(&paths.repository) || !cwd.is_dir() {
+            return Err("pty_cwd_invalid".into());
+        }
+        let scratch = paths
+            .store
+            .clone()
+            .ok_or("mod store is not configured")?
+            .join("pty-scratch");
+        std::fs::create_dir_all(&scratch).map_err(|error| error.to_string())?;
+        let loopback = match arguments["network"].as_str() {
+            None if arguments["network"].is_null() => false,
+            Some("loopback") => true,
+            _ => return Err("pty_network_invalid".into()),
+        };
+        let mut argv = crate::mod_pty::argv(arguments)?;
+        let program = codex_omd::host::resolve_program(&argv[0], &paths.repository)
+            .ok_or("pty_program_unavailable")?;
+        if let Some(expected) = arguments["sha256"].as_str()
+            && codex_omd::host::program_hash(&program)? != expected
+        {
+            return Err("pty_program_changed".into());
+        }
+        argv[0] = program.to_string_lossy().into_owned();
+        let mut command = crate::mod_runtime::sandboxed_command(
+            &paths,
+            &policy,
+            argv,
+            &scratch,
+            arguments["write"] == true,
+            loopback,
+        )?;
+        command.current_dir(cwd);
+        Ok((command, scratch))
+    }
+
+    pub(super) async fn handle_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+    ) {
+        match confirmation(&call) {
+            Ok(Some((title, prompt, held))) => {
+                self.confirm_mod_surface_call(call, title, prompt, held)
+            }
+            Ok(None) => self.run_mod_surface_call(tui, app_server, call, None).await,
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
+    fn confirm_mod_surface_call(
+        &mut self,
+        call: SurfaceCall,
+        title: Option<String>,
+        prompt: String,
+        held: Option<Confirmed>,
+    ) {
+        let caller = call.caller.clone();
+        let id = crate::mod_surface::hold(call);
+        if let Some(held) = held {
+            confirmed().insert(id, held);
+        }
+        let item = |name: &str, approved: bool| SelectionItem {
+            name: name.to_owned(),
+            actions: vec![Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed { id, approved });
+                },
+            )],
+            dismiss_on_select: true,
+            ..Default::default()
+        };
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(title.unwrap_or_else(|| format!("Confirm request from mod {caller}"))),
+            subtitle: Some(prompt),
+            items: vec![item("Allow once", true), item("Decline", false)],
+            view_id: Some(crate::mod_ui::APPROVAL_VIEW_ID),
+            on_cancel: Some(Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed {
+                        id,
+                        approved: false,
+                    });
+                },
+            )),
+            ..SelectionViewParams::picker()
+        });
+    }
+
+    pub(super) async fn handle_mod_surface_confirmed(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        id: u64,
+        approved: bool,
+    ) {
+        let held = confirmed().remove(&id);
+        let Some(call) = crate::mod_surface::release(id) else {
+            return;
+        };
+        if !approved {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return;
+        }
+        self.run_mod_surface_call(tui, app_server, call, held).await;
+    }
+
+    /// A native choice question: the user picks, types an "Other" answer or cancels; the
+    /// caller only receives the answer.
+    fn show_choice_prompt(&mut self, call: SurfaceCall) {
+        let arguments = &call.arguments;
+        let options = arguments["options"]
+            .as_array()
+            .filter(|options| (1..=32).contains(&options.len()))
+            .and_then(|options| {
+                options
+                    .iter()
+                    .map(|option| {
+                        Some((
+                            prompt_text(&option["value"], 128).ok()?,
+                            prompt_text(&option["label"], 128).ok()?,
+                        ))
+                    })
+                    .collect::<Option<Vec<_>>>()
+            });
+        let (Ok(title), Ok(message), Some(options)) = (
+            prompt_text(&arguments["title"], 120),
+            prompt_text(&arguments["message"], 2000),
+            options,
+        ) else {
+            let _ = call.reply.send(Err("terminal_prompt_invalid".into()));
+            return;
+        };
+        let multiple = arguments["multiple"] == true;
+        let other = arguments["other"] == true && !multiple;
+        let title = if call.caller == codex_omd::broker::HOST_CALLER {
+            title
+        } else {
+            format!("Mod {} asks: {title}", call.caller)
+        };
+        let reply = std::sync::Arc::new(std::sync::Mutex::new(Some(call.reply)));
+        let answer = move |value: Value| {
+            if let Some(reply) = reply
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .take()
+            {
+                let _ = reply.send(Ok(value));
+            }
+        };
+        let declined = json!({"status": "declined"});
+        if multiple {
+            let (confirm, cancel) = (answer.clone(), answer);
+            let picker = crate::bottom_pane::MultiSelectPicker::builder(
+                title,
+                Some(message),
+                self.app_event_tx.clone(),
+            )
+            .items(
+                options
+                    .into_iter()
+                    .map(|(value, label)| crate::bottom_pane::MultiSelectItem {
+                        id: value,
+                        name: label,
+                        orderable: false,
+                        ..Default::default()
+                    })
+                    .collect(),
+            )
+            .on_confirm(move |values, _| confirm(json!({"status": "accepted", "values": values})))
+            .on_cancel(move |_| cancel(declined.clone()))
+            .build();
+            self.chat_widget.show_bottom_pane_view(Box::new(picker));
+            return;
+        }
+        let mut items = options
+            .into_iter()
+            .map(|(value, label)| {
+                let answer = answer.clone();
+                SelectionItem {
+                    name: label,
+                    actions: vec![Box::new(
+                        move |_: &crate::app_event_sender::AppEventSender| {
+                            answer(json!({"status": "accepted", "values": [value]}))
+                        },
+                    )],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect::<Vec<_>>();
+        if other {
+            let (answer, caller, context, thread, question) = (
+                answer.clone(),
+                call.caller.clone(),
+                call.context,
+                call.thread.clone(),
+                title.clone(),
+            );
+            items.push(SelectionItem {
+                name: "Other…".into(),
+                actions: vec![Box::new(move |tx: &crate::app_event_sender::AppEventSender| {
+                    let (reply, typed) = std::sync::mpsc::sync_channel::<Result<Value, String>>(1);
+                    let answer = answer.clone();
+                    std::thread::spawn(move || {
+                        answer(match typed.recv() {
+                            Ok(Ok(typed)) if typed["status"] == "accepted" => {
+                                json!({"status": "accepted", "values": [typed["value"]], "other": true})
+                            }
+                            _ => json!({"status": "declined"}),
+                        });
+                    });
+                    tx.send(AppEvent::ModSurfaceCall(Box::new(SurfaceCall {
+                        caller: caller.clone(),
+                        operation: "terminal.prompt".into(),
+                        arguments: json!({"kind": "text", "title": "Other", "message": question}),
+                        context,
+                        thread: thread.clone(),
+                        confirm: None,
+                        reply,
+                    })));
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(title),
+            subtitle: Some(message),
+            items,
+            on_cancel: Some(Box::new(
+                move |_: &crate::app_event_sender::AppEventSender| answer(declined.clone()),
+            )),
+            ..SelectionViewParams::picker()
+        });
+    }
+
+    async fn run_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+        held: Option<Confirmed>,
+    ) {
+        let result = match call.operation.as_str() {
+            "app.request" => {
+                let method = call.arguments["method"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .to_owned();
+                let mut params = call.arguments["params"].clone();
+                if let Err(error) =
+                    translate_images(&call.caller, call.thread.as_deref(), &mut params)
+                {
+                    let _ = call.reply.send(Err(error));
+                    return;
+                }
+                let request =
+                    json!({"method": method, "id": app_server.next_request_id(), "params": params});
+                match serde_json::from_value::<codex_app_server_protocol::ClientRequest>(request) {
+                    Ok(request) => {
+                        let handle = app_server.request_handle();
+                        let reply = call.reply;
+                        tokio::spawn(async move {
+                            let result = handle
+                                .request_typed::<Value>(request)
+                                .await
+                                .map_err(|error| error.to_string());
+                            let _ = reply.send(result);
+                        });
+                        return;
+                    }
+                    Err(error) => Err(format!("app_params_invalid: {error}")),
+                }
+            }
+            "terminal.notify" => Ok(self.mod_notify(tui, &call.arguments)),
+            "terminal.show_thread" => match call.arguments["thread_id"]
+                .as_str()
+                .and_then(|thread| codex_protocol::ThreadId::from_string(thread).ok())
+            {
+                Some(thread) => {
+                    self.app_event_tx.send(AppEvent::SelectAgentThread(thread));
+                    Ok(json!({"shown": true}))
+                }
+                None => Err("thread_id_invalid".into()),
+            },
+            "terminal.import_file" => import_file(&call),
+            "terminal.image_sample" => image_sample(&call),
+            "terminal.open" => open(&call.arguments),
+            "terminal.pty" if call.arguments["action"] == "start" => {
+                let command = (call.context == codex_omd::app_routes::InvocationContext::User)
+                    .then_some(())
+                    .ok_or_else(|| "host_operation_user_only: terminal.pty start".to_owned())
+                    .and_then(|()| self.mod_shell_command(&call.caller, &call.arguments));
+                match command {
+                    Ok((command, home)) => {
+                        crate::mod_pty::start(
+                            &call.caller,
+                            &call.arguments,
+                            command,
+                            &home,
+                            tui.frame_requester(),
+                        )
+                        .await
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            "terminal.pty" => crate::mod_pty::call(&call.caller, &call.arguments),
+            "terminal.prompt" if call.arguments["kind"] == "confirm" => {
+                Ok(json!({"status": "accepted"}))
+            }
+            "terminal.prompt" if call.arguments["kind"] == "choice" => {
+                self.show_choice_prompt(call);
+                return;
+            }
+            "terminal.pane" => {
+                tui.frame_requester().schedule_frame();
+                crate::mod_ui::pane(&call.caller, &call.arguments)
+            }
+            "terminal.panes" => Ok(crate::mod_ui::panes(&call.caller)),
+            "terminal.notice" => self.mod_notice(tui, &call),
+            "terminal.prompt" => {
+                let title = match (
+                    prompt_text(&call.arguments["title"], 120),
+                    prompt_text(&call.arguments["message"], 2000),
+                ) {
+                    (Ok(title), Ok(message)) if call.arguments["kind"] == "text" => {
+                        (title, message)
+                    }
+                    _ => {
+                        let _ = call.reply.send(Err("terminal_prompt_invalid".into()));
+                        return;
+                    }
+                };
+                let reply = call.reply;
+                let view = crate::bottom_pane::SecretPromptView::new(
+                    if call.caller == codex_omd::broker::HOST_CALLER {
+                        title.0
+                    } else {
+                        format!("Mod {} asks: {}", call.caller, title.0)
+                    },
+                    title.1,
+                    Box::new(move |value| {
+                        let _ = reply.send(Ok(match value {
+                            Some(value) => json!({"status": "accepted", "value": value}),
+                            None => json!({"status": "declined"}),
+                        }));
+                    }),
+                );
+                let view = if call.arguments["masked"] == true {
+                    view
+                } else {
+                    view.plain()
+                };
+                self.chat_widget.show_mod_secret_prompt(view);
+                return;
+            }
+            "packages.apply" => {
+                let reply = call.reply;
+                tokio::task::spawn_blocking(move || {
+                    let _ = reply.send(apply_package(held));
+                });
+                return;
+            }
+            "contract.select" => select_contract(&call.arguments, held),
+            "composer.read" => {
+                let mut draft = self.chat_widget.mod_composer_read();
+                draft_resources(&call.caller, call.thread.as_deref(), &mut draft).map(|()| draft)
+            }
+            "composer.suggest" => {
+                let source = caller_source(&call.caller).unwrap_or_default();
+                self.chat_widget
+                    .mod_composer_suggest(&call.caller, &source, &call.arguments)
+            }
+            "prompts.consent" | "prompts.submit" | "prompts.status" | "prompts.revoke" => {
+                self.prompts(&call)
+            }
+            "commands.list" => Ok(json!({"commands": self.chat_widget.mod_command_rows()})),
+            "commands.describe" => {
+                let name = call.arguments["command"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .trim_start_matches('/');
+                self.chat_widget
+                    .mod_command_rows()
+                    .into_iter()
+                    .find(|row| row["command"] == name)
+                    .ok_or_else(|| format!("command_unknown: {name}"))
+            }
+            "commands.invoke" => {
+                self.chat_widget.mod_invoke_command(call);
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            "config.describe" | "config.set" => {
+                let handle = app_server.request_handle();
+                let cwd = self.chat_widget.config_ref().cwd.to_path_buf();
+                let read = json!({"method": "config/read", "id": app_server.next_request_id(), "params": {"cwd": cwd}});
+                let write_id = app_server.next_request_id();
+                let runtime = tokio::runtime::Handle::current();
+                let reply = call.reply.clone();
+                tokio::spawn(async move {
+                    let result = async move {
+                        let read = serde_json::from_value::<codex_app_server_protocol::ClientRequest>(read)
+                            .map_err(|error| error.to_string())?;
+                        let read = handle
+                            .request_typed::<Value>(read)
+                            .await
+                            .map_err(|error| error.to_string())?;
+                        tokio::task::spawn_blocking(move || {
+                            config_call(&call, &read, |key, value, version| {
+                                let request = serde_json::from_value::<codex_app_server_protocol::ClientRequest>(json!({
+                                    "method": "config/value/write", "id": write_id,
+                                    "params": {"keyPath": key, "value": value, "mergeStrategy": "replace", "expectedVersion": version}}))
+                                    .map_err(|error| error.to_string())?;
+                                runtime
+                                    .block_on(handle.request_typed::<Value>(request))
+                                    .map_err(|error| error.to_string())
+                            })
+                        })
+                        .await
+                        .map_err(|error| error.to_string())?
+                    }
+                    .await;
+                    let _ = reply.send(result);
+                });
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            "sessions.ports" => {
+                let Some(thread_id) = call.thread.clone() else {
+                    let _ = call
+                        .reply
+                        .send(Err("session_ports_unavailable: no thread".into()));
+                    return;
+                };
+                let request =
+                    codex_app_server_protocol::ClientRequest::ThreadBackgroundTerminalsList {
+                        request_id: app_server.next_request_id(),
+                        params: codex_app_server_protocol::ThreadBackgroundTerminalsListParams {
+                            thread_id,
+                            cursor: None,
+                            limit: Some(64),
+                        },
+                    };
+                let handle = app_server.request_handle();
+                let reply = call.reply;
+                tokio::spawn(async move {
+                    let result = match handle
+                        .request_typed::<codex_app_server_protocol::ThreadBackgroundTerminalsListResponse>(request)
+                        .await
+                    {
+                        Ok(list) => listening_ports(list.data.iter().filter_map(|terminal| terminal.os_pid).collect()).await,
+                        Err(error) => Err(error.to_string()),
+                    };
+                    let _ = reply.send(result);
+                });
+                return;
+            }
+            "composer.write" => {
+                let attachments =
+                    call.arguments["attach"]
+                        .as_array()
+                        .map(Vec::as_slice)
+                        .unwrap_or_default()
+                        .iter()
+                        .take(8)
+                        .map(|item| {
+                            match item.as_object().map(|item| (item.len(), item.get("image"))) {
+                                Some((1, Some(image))) => {
+                                    materialize(&call.caller, call.thread.as_deref(), image)
+                                }
+                                _ => Err("composer_attach_invalid: attach a resource reference"
+                                    .to_owned()),
+                            }
+                        })
+                        .collect::<Result<Vec<_>, _>>();
+                match attachments {
+                    Ok(attachments) => {
+                        let mut arguments = call.arguments.clone();
+                        if let Some(object) = arguments.as_object_mut() {
+                            object.remove("attach");
+                        }
+                        let source = caller_source(&call.caller).unwrap_or_default();
+                        self.chat_widget.mod_composer_write(
+                            &call.caller,
+                            &source,
+                            &arguments,
+                            attachments,
+                        )
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            "builtins.invoke" => match call.arguments["action"].as_str() {
+                Some(action) => {
+                    let keys = crate::omd::builtin_keys();
+                    let key =
+                        crate::keymap_overlay::overlay(&self.local_settings.tui.keymap, &keys)
+                            .and_then(|(_, runtime)| {
+                                crate::keymap_overlay::action_key(&runtime, action)
+                            });
+                    match key {
+                        Ok(key) => {
+                            let _ = call.reply.send(Ok(json!({"invoked": true})));
+                            self.handle_key_event(tui, app_server, key).await;
+                            tui.frame_requester().schedule_frame();
+                            return;
+                        }
+                        Err(error) => Err(error),
+                    }
+                }
+                None => Err("builtins_action_required".into()),
+            },
+            "credentials.request" => {
+                self.run_mod_credentials(call);
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        };
+        let _ = call.reply.send(result);
+        tui.frame_requester().schedule_frame();
+    }
+
+    fn mod_notice(&mut self, tui: &mut tui::Tui, call: &SurfaceCall) -> Result<Value, String> {
+        match notice_request(&call.arguments)? {
+            NoticeRequest::Clear { id } => {
+                let cleared = crate::mod_ui::clear_notice(&call.caller, id);
+                tui.frame_requester().schedule_frame();
+                Ok(json!({"cleared": cleared}))
+            }
+            NoticeRequest::Transient {
+                id,
+                kind,
+                placement,
+                text,
+                ttl,
+            } => {
+                crate::mod_ui::notice(&call.caller, id, kind, placement, text, ttl);
+                tui.frame_requester().schedule_frame();
+                tui.frame_requester().schedule_frame_in(ttl);
+                Ok(json!({"shown": true}))
+            }
+            NoticeRequest::Transcript {
+                kind,
+                text,
+                model,
+                call_id,
+            } => {
+                if model {
+                    let thread = call
+                        .thread
+                        .as_deref()
+                        .ok_or("terminal_notice_thread_unavailable")?;
+                    codex_omd::model_request::queue_section(thread, &call.caller, text)?;
+                }
+                match call_id {
+                    Some(call_id) if tui.is_owned_screen() => {
+                        crate::mod_render::tool_notice(call_id, kind, text, &call.caller);
+                    }
+                    Some(call_id) => {
+                        self.chat_widget
+                            .add_to_history(crate::history_cell::new_mod_notice(
+                                kind,
+                                text.to_owned(),
+                                &format!("{} · tool {call_id}", call.caller),
+                            ))
+                    }
+                    None => self
+                        .chat_widget
+                        .add_to_history(crate::history_cell::new_mod_notice(
+                            kind,
+                            text.to_owned(),
+                            &call.caller,
+                        )),
+                }
+                Ok(json!({"shown": true, "model": model}))
+            }
+        }
+    }
+
+    fn mod_notify(&mut self, tui: &mut tui::Tui, arguments: &Value) -> Value {
+        let title = arguments["title"].as_str().unwrap_or_default();
+        let body = arguments["body"].as_str().unwrap_or_default();
+        if title.trim().is_empty() {
+            return json!({"delivered": false, "method": "none", "reason": "title_required"});
+        }
+        if !crate::mod_surface::notify_allowed() {
+            return json!({"delivered": false, "method": "none", "reason": "rate_limited"});
+        }
+        match tui.notify_titled(title, body) {
+            Ok(method) => json!({"delivered": true, "method": method}),
+            Err(reason) => json!({"delivered": false, "method": "none", "reason": reason}),
+        }
+    }
+}
+
+#[derive(Debug, PartialEq)]
+enum NoticeRequest<'a> {
+    Clear {
+        id: &'a str,
+    },
+    Transient {
+        id: Option<&'a str>,
+        kind: &'static str,
+        placement: crate::mod_ui::NoticePlacement,
+        text: &'a str,
+        ttl: std::time::Duration,
+    },
+    Transcript {
+        kind: &'static str,
+        text: &'a str,
+        model: bool,
+        call_id: Option<&'a str>,
+    },
+}
+
+fn notice_request(arguments: &Value) -> Result<NoticeRequest<'_>, String> {
+    let invalid = || "terminal_notice_invalid".to_owned();
+    let one_of = |key: &str, values: &[&'static str]| match &arguments[key] {
+        Value::Null => Ok(values[0]),
+        value => values
+            .iter()
+            .find(|known| value == **known)
+            .copied()
+            .ok_or_else(invalid),
+    };
+    let kind = one_of("kind", &["info", "warning", "error"])?;
+    let placement = match one_of("placement", &["toast", "status", "transcript"])? {
+        "toast" => Some(crate::mod_ui::NoticePlacement::Toast),
+        "status" => Some(crate::mod_ui::NoticePlacement::Status),
+        _ => None,
+    };
+    let model = one_of("audience", &["user", "model"])? == "model";
+    let id = match &arguments["id"] {
+        Value::Null => None,
+        Value::String(id) if codex_omd::mod_component_id(id) => Some(id.as_str()),
+        _ => return Err(invalid()),
+    };
+    if arguments["clear"] == true {
+        return match (id, placement) {
+            (Some(id), Some(_)) => Ok(NoticeRequest::Clear { id }),
+            _ => Err(invalid()),
+        };
+    }
+    let text = arguments["text"]
+        .as_str()
+        .filter(|text| {
+            !text.trim().is_empty() && text.len() <= 512 && !text.chars().any(char::is_control)
+        })
+        .ok_or_else(invalid)?;
+    match placement {
+        Some(placement) => {
+            let ttl = match &arguments["ttl_ms"] {
+                Value::Null => 5_000,
+                value => value
+                    .as_u64()
+                    .filter(|ttl| (1_000..=60_000).contains(ttl))
+                    .ok_or_else(invalid)?,
+            };
+            if model || !arguments["tool_call_id"].is_null() {
+                return Err(invalid());
+            }
+            Ok(NoticeRequest::Transient {
+                id,
+                kind,
+                placement,
+                text,
+                ttl: std::time::Duration::from_millis(ttl),
+            })
+        }
+        None if !arguments["ttl_ms"].is_null() || id.is_some() => Err(invalid()),
+        None => {
+            let call_id = match &arguments["tool_call_id"] {
+                Value::Null => None,
+                Value::String(call_id)
+                    if !call_id.is_empty()
+                        && call_id.len() <= 128
+                        && !call_id.chars().any(char::is_control) =>
+                {
+                    Some(call_id.as_str())
+                }
+                _ => return Err(invalid()),
+            };
+            Ok(NoticeRequest::Transcript {
+                kind,
+                text,
+                model,
+                call_id,
+            })
+        }
+    }
+}
+
+async fn listening_ports(roots: Vec<u32>) -> Result<Value, String> {
+    if roots.is_empty() {
+        return Ok(json!({"ports": []}));
+    }
+    let run = |program: &'static str, args: Vec<String>| async move {
+        tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            tokio::process::Command::new(program)
+                .args(args)
+                .kill_on_drop(true)
+                .output(),
+        )
+        .await
+        .map_err(|_| format!("session_ports_timeout: {program}"))?
+        .map_err(|error| format!("session_ports_unavailable: {program}: {error}"))
+    };
+    let table = run("/bin/ps", vec!["-axo".into(), "pid=,ppid=".into()]).await?;
+    let pids = descendants(&String::from_utf8_lossy(&table.stdout), &roots);
+    let lsof = ["/usr/sbin/lsof", "/usr/bin/lsof"]
+        .into_iter()
+        .find(|path| std::path::Path::new(path).exists())
+        .ok_or("session_ports_unavailable: lsof")?;
+    let pids = pids
+        .iter()
+        .map(u32::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    let output = run(
+        lsof,
+        [
+            "-nP",
+            "-w",
+            "-a",
+            "-iTCP",
+            "-sTCP:LISTEN",
+            "-Fpn",
+            "-p",
+            &pids,
+        ]
+        .map(str::to_owned)
+        .to_vec(),
+    )
+    .await?;
+    Ok(json!({"ports": parse_listeners(&String::from_utf8_lossy(&output.stdout))}))
+}
+
+fn descendants(table: &str, roots: &[u32]) -> Vec<u32> {
+    let pairs = table
+        .lines()
+        .filter_map(|line| {
+            let mut fields = line.split_whitespace().map(str::parse::<u32>);
+            Some((fields.next()?.ok()?, fields.next()?.ok()?))
+        })
+        .collect::<Vec<_>>();
+    let mut found = roots.to_vec();
+    let mut index = 0;
+    while index < found.len() && found.len() < 256 {
+        let parent = found[index];
+        let children = pairs
+            .iter()
+            .filter(|(pid, ppid)| *ppid == parent && !found.contains(pid))
+            .map(|(pid, _)| *pid)
+            .collect::<Vec<_>>();
+        found.extend(children);
+        index += 1;
+    }
+    found.truncate(256);
+    found
+}
+
+fn parse_listeners(output: &str) -> Vec<Value> {
+    let mut pid = 0;
+    let mut ports = std::collections::BTreeMap::new();
+    for line in output.lines() {
+        if let Some(value) = line.strip_prefix('p') {
+            pid = value.parse().unwrap_or(0);
+        } else if let Some(address) = line.strip_prefix('n')
+            && let Some(port) = address
+                .rsplit(':')
+                .next()
+                .and_then(|port| port.parse::<u16>().ok())
+        {
+            ports
+                .entry(port)
+                .or_insert_with(|| json!({"port": port, "pid": pid, "address": address}));
+        }
+    }
+    ports.into_values().take(32).collect()
+}
