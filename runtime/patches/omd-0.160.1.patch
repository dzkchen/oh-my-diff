+            _ => unreachable!(),
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        queue,
+        vec![
+            ("a".to_owned(), Some(7)),
+            ("b".to_owned(), Some(1)),
+            ("a".to_owned(), None),
+            ("a".to_owned(), Some(5)),
+        ]
+    );
+}
