+            &writer,
+            "exec.run",
+            json!({"program":"sh","cwd":"locked","write":true})
+        )
+        .unwrap_err(),
+        "exec_cwd_unavailable"
+    );
+
+    let cancelled = std::cell::Cell::new(0);
+    let active = || {
+        cancelled.set(cancelled.get() + 1);
+        cancelled.get() < 20
+    };
+    let host = Host {
+        authority: &authority,
+        data_root: &data,
+        active: &active,
+        record_changes: false,
