+    pub fn tools(&self) -> Vec<(String, u64, ModTool)> {
+        let mut tools: Vec<_> = self
+            .active()
+            .flat_map(|(id, m)| {
+                m.registrations
+                    .tools
+                    .iter()
+                    .chain(self.dynamic_tools.get(id).into_iter().flatten())
+                    .map(|tool| (id.clone(), self.generation, tool.clone()))
+            })
