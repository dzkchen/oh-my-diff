+#[test]
+#[serial_test::serial]
+fn channel_publication_keeps_the_captured_thread_after_ui_switches() {
+    let dir = tempfile::tempdir().unwrap();
+    let paths = paths(dir.path());
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let previous = state().take();
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    attach(&AppEventSender::new(tx), Some("new-ui-thread".into()));
+    let scope = crate::mod_runtime::CallScope {
+        thread: Some("captured-thread"),
+        ..scope(InvocationContext::User)
+    };
+    codex_omd::event_bus::global()
+        .lock()
+        .unwrap()
+        .subscribe("scope_observer", vec!["scope_owner/news".into()]);
+    let call = || codex_omd::ModHostCall {
+        operation: "events.publish".into(),
+        arguments: json!({"channel": "news", "data": 1}),
+    };
+    host_call(
+        &paths,
+        &policy,
+        grants(&["events"]),
+        "scope_owner",
+        call(),
+        &scope,
+    )
+    .unwrap();
+    let events = codex_omd::event_bus::global()
+        .lock()
+        .unwrap()
+        .drain("scope_observer", 1);
+    assert_eq!(events[0].thread, "captured-thread");
+    state().take();
+    let unavailable = host_call(
+        &paths,
+        &policy,
+        grants(&["events"]),
+        "scope_owner",
+        call(),
+        &crate::mod_runtime::CallScope {
+            thread: None,
+            ..scope
+        },
+    );
+    assert_eq!(
+        unavailable.unwrap_err().to_string(),
+        "channel_thread_unavailable"
+    );
+    codex_omd::event_bus::global()
+        .lock()
+        .unwrap()
+        .unsubscribe("scope_observer");
+    *state() = previous;
+}
