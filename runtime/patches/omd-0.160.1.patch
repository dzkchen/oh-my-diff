+    /// Read-only launch identity for `Events.terminal.input.identity`.
+    pub fn identity(
+        &self,
+        codex_version: &str,
+        install_profile: Option<&str>,
+        mode: &str,
+    ) -> Value {
+        let install_profile = match install_profile {
