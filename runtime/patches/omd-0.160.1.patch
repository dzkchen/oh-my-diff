+                .thread_store
+                .get::<Lead>()
+                .filter(|lead| lead.owner == "lead")
+            {
+                self.event(
+                    "session",
+                    json!({"phase":"idle","thread_id":lead.thread.to_string(),"cause":format!("{:?}", input.cause)}),
+                    None,
+                )
+                .await;
+                self.event(
+                    "idle",
