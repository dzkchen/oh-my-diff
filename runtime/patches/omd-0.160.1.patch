+#[tokio::test]
+#[serial_test::serial]
+#[ignore = "needs OMD_MODE=omd and a batch-local OMD_MOD_STORE; run with --ignored"]
+async fn owned_ascii_backdrop_preserves_native_header_and_blank_source_rows() -> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.local_settings.tui.animations = false;
+    app.chat_widget
+        .apply_external_edit("draft   with   spaces".into());
+    app.transcript_cells = vec![
+        Arc::new(crate::history_cell::SessionHeaderHistoryCell::new(
+            "gpt-test".into(),
+            /*reasoning_effort*/ None,
+            PathBuf::from("/tmp/actual project"),
+            crate::version::CODEX_CLI_VERSION,
+        )),
+        Arc::new(crate::history_cell::PlainHistoryCell::new(vec![
+            "  transcript  has  intentional spaces".into(),
+            "".into(),
+            "    + let value = 1;    // diff spacing".into(),
+            "  ERROR: permission denied    Retry?".into(),
+            "  APPROVAL: run command?    (y/n)".into(),
+        ])),
+    ];
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(/*owned*/ true)?;
+    let size = Size::new(/*width*/ 80, /*height*/ 24);
+    tui.screen_size_for_event(&TuiEvent::Resize(size))?;
+    let mut snapshot = codex_omd::ModViewSnapshot {
+        view: codex_omd::ModView::parse(serde_json::json!({
+            "session_title_suffix":" | External profile", "greeting":"Ready to work?"
+        }))?,
+        ..Default::default()
+    };
+    crate::mod_ui::preview(snapshot.clone());
+    let bottom = app.render_owned_transcript(&mut tui, size)?;
+    let empty = app.transcript_view.remaining_area();
+    assert!(empty.height > 0);
+    let before = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal).clone();
+    snapshot.view.surface_styles.insert(
+        "backdrop".into(),
+        serde_json::from_value(serde_json::json!({
+            "top":"#ffffff","bottom":"#eeeeee","foreground":"#1c1c1c","border":"#888888","opacity":0.85
+        }))?,
+    );
+    let mut frames = Vec::new();
+    for art in [None, Some("ART")] {
+        snapshot.view.backdrop = art.map(|text| {
+            serde_json::from_value(serde_json::json!({"ascii":{"text":text,"position":"tile"}}))
+                .unwrap()
+        });
+        crate::mod_ui::preview(snapshot.clone());
+        assert_eq!(app.render_owned_transcript(&mut tui, size)?, bottom);
+        let after =
+            crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal).clone();
+        for y in 0..size.height {
+            if y < empty.y || y >= empty.bottom() {
+                assert_eq!(
+                    (0..size.width)
+                        .map(|x| after[(x, y)].symbol())
+                        .collect::<Vec<_>>(),
+                    (0..size.width)
+                        .map(|x| before[(x, y)].symbol())
+                        .collect::<Vec<_>>()
+                );
+            }
+        }
+        let text = buffer_text(&after);
+        assert!(text.contains(&format!(
+            "OpenAI Codex (v{}) | External profile",
+            crate::version::CODEX_CLI_VERSION
+        )));
+        assert!(text.contains("/tmp/actual project"));
+        assert!(text.contains("Ready to work?"));
+        if art.is_some() {
+            assert!(text.contains("ARTART"));
+        } else {
+            assert_eq!(after[(empty.x, empty.y)].symbol(), "|");
+        }
+        frames.push(format!("border with ASCII {art:?}\n{text}"));
+    }
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    tui.set_owned_screen(/*owned*/ false)?;
+    insta::assert_snapshot!(
+        "owned_ascii_native_whitespace",
+        frames
+            .join("\n\n")
+            .replace(crate::version::CODEX_CLI_VERSION, "<VERSION>")
+    );
+    Ok(())
+}
