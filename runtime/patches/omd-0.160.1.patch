+pub(crate) fn colors(snapshot: &ModViewSnapshot) -> [Option<Color>; 8] {
+    let theme = &snapshot.view.theme;
+    [
+        theme.accent,
+        theme.user_message_background,
+        theme.success,
+        theme.attention,
+        theme.failure,
+        theme.diff_added,
+        theme.diff_removed,
+        theme.muted,
+    ]
+    .map(|slot| slot.map(color))
+}
