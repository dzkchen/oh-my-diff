+                || snapshot
+                    .view
+                    .welcome
+                    .as_ref()
+                    .is_some_and(|welcome| welcome.show_while_composing)
+        })
+}
+
+pub(crate) fn take_new_activity() -> Vec<ModActivity> {
+    let mut cache = CACHE
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let Some(cache) = cache.as_mut() else {
+        return Vec::new();
+    };
+    if !cache.terminal {
+        return Vec::new();
+    }
+    let (epoch, last) = cache.seen.unwrap_or_default();
+    let last = if epoch == cache.snapshot.epoch {
+        last
+    } else {
+        0
+    };
+    let fresh = cache
+        .snapshot
+        .activity
+        .iter()
+        .filter(|activity| activity.sequence > last)
+        .cloned()
+        .collect::<Vec<_>>();
+    let newest = fresh
+        .iter()
+        .map(|activity| activity.sequence)
+        .max()
+        .unwrap_or(last);
+    cache.seen = Some((cache.snapshot.epoch, newest));
+    fresh
+}
