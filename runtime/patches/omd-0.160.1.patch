+        reasoning: serde_json::to_value(&route.reasoning_effort)
+            .ok()
+            .and_then(|value| value.as_str().map(str::to_owned))
+            .unwrap_or_default(),
+        rates: route.rates.clone(),
+        credential: route.credential.clone(),
+        url: route.responses_url.clone(),
+    }
