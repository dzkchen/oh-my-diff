+    pub(super) async fn history_evidence(
+        &self,
+        lead: &Lead,
+        caller: &operations::Caller<'_>,
+        arguments: Value,
+        cancelled: &Arc<AtomicBool>,
+    ) -> Result<Value, String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Input {
+            call_ids: Option<Vec<String>>,
