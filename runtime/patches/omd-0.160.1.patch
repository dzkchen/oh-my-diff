+/// The exec policy requirement and approval request for a command, computed without running it.
+async fn assess_exec_command(
+    invocation: &ToolInvocation,
+) -> Result<crate::tools::registry::ToolAssessment, String> {
+    let ToolPayload::Function { arguments } = &invocation.payload else {
+        return Err("exec_command takes function arguments".into());
+    };
+    let environment_args: ExecCommandEnvironmentArgs =
+        parse_arguments(arguments).map_err(|error| error.to_string())?;
+    let turn_environment = resolve_tool_environment(
+        &invocation.step_context.environments,
+        environment_args.environment_id.as_deref(),
+    )
+    .map_err(|error| error.to_string())?
+    .ok_or("unified exec is unavailable in this session")?;
+    let cwd = environment_args
+        .workdir
+        .as_deref()
+        .filter(|workdir| !workdir.is_empty())
+        .map_or_else(
+            || Ok(turn_environment.cwd().clone()),
+            |workdir| turn_environment.cwd().join(workdir),
+        )
+        .map_err(|error| error.to_string())?;
+    let args: ExecCommandArgs = match cwd.to_abs_path() {
+        Ok(native) => parse_arguments_with_base_path(arguments, &native),
+        Err(_) => parse_arguments(arguments),
+    }
+    .map_err(|error| error.to_string())?;
+    let sandbox_permissions =
+        resolve_sandbox_permissions(args.sandbox_permissions, args.justification.as_deref())
+            .map_err(|error| error.to_string())?;
+    let shell_mode = shell_mode_for_environment(
+        &invocation.turn.unified_exec_shell_mode,
+        turn_environment.environment.as_ref(),
+    );
+    let shell = turn_environment
+        .shell
+        .clone()
+        .map(Arc::new)
+        .unwrap_or_else(|| invocation.session.user_shell());
+    let command = get_command(
+        &args,
+        Arc::clone(&shell),
+        &shell_mode,
+        turn_environment.config().allow_login_shell,
+    )?
+    .command;
+    let command_platform = match turn_environment.executor_platform_os.as_deref() {
+        Some("linux" | "macos") => DangerousCommandPlatform::Posix,
+        Some(_) => DangerousCommandPlatform::Windows,
+        None => DangerousCommandPlatform::host(),
+    };
+    let exec_policy = &invocation.session.services.exec_policy;
+    let environment_policy = turn_environment.config().exec_policy.as_ref();
+    let requirement = exec_policy
+        .create_exec_approval_requirement_for_shell(
+            ExecApprovalRequest {
+                command: &command,
+                approval_policy: invocation.step_context.settings.approval_policy(),
+                permission_profile: turn_environment.permission_profile().clone(),
+                environment_policy,
+                windows_sandbox_level: windows_sandbox_level_for_legacy_checks(
+                    turn_environment.config().windows_sandbox_type,
+                    turn_environment.config().windows_sandbox_level,
+                ),
+                sandbox_permissions,
+                prefix_rule: args.prefix_rule.clone(),
+                allow_prefix_rules: invocation.step_context.turn.allow_prefix_rules(),
+            },
+            shell.as_ref(),
+            &shell_mode,
+            command_platform,
+        )
+        .await;
+    let overridable = matches!(
+        requirement,
+        crate::tools::sandboxing::ExecApprovalRequirement::Forbidden { .. }
+    ) && exec_policy.forbidden_only_by_user_rules(&command, environment_policy);
+    let proposed_execpolicy_amendment = requirement.proposed_execpolicy_amendment().cloned();
+    Ok(crate::tools::registry::ToolAssessment {
+        requirement,
+        action: Some(crate::tools::approvals::ApprovalAction::ExecCommand {
+            id: invocation.call_id.clone(),
+            environment_id: turn_environment.selection.environment_id.clone(),
+            command,
+            hook_command: args.cmd.clone(),
+            cwd,
+            sandbox_permissions,
+            additional_permissions: None,
+            justification: args.justification.clone(),
+            tty: args.tty,
+            proposed_execpolicy_amendment,
+        }),
+        overridable,
+    })
+}
