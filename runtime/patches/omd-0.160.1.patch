+#[tokio::test]
+async fn undo_restores_the_replaced_transcript_and_keeps_later_rows() {
+    let fixture = fixture().await;
+    let revision = fixture.read().await.revision;
+    let rewritten = fixture
+        .rewrite(
+            Some(revision),
+            vec![HistoryRowEdit::Delete {
+                id: "user-1".to_string(),
+            }],
+            false,
+            None,
+        )
+        .await
+        .expect("delete row");
+    let current = fixture.current_path().await;
+    codex_rollout::append_rollout_item_to_path(current.as_path(), &message("msg_u3", "user", "later"))
+        .await
+        .expect("append later row");
+    let later = fixture.read().await;
+    assert_ne!(later.revision, rewritten.revision);
+
+    let restored = fixture
+        .rewrite(Some(later.revision), Vec::new(), true, None)
+        .await
+        .expect("undo");
+    let model = fixture.model_text().await;
+    assert!(model.contains("SECRET-1"));
+    assert!(model.contains("later"));
+    assert_eq!(restored.rows.first().map(|row| row.id.as_str()), Some("user-1"));
+
+    let redo = fixture
+        .rewrite(Some(restored.revision), Vec::new(), true, None)
+        .await
+        .expect("undo the undo");
+    assert!(!redo.rows.iter().any(|row| row.id == "user-1"));
+
+    let log = log_path(&fixture.store, fixture.thread_id);
+    assert!(log.exists());
+    fixture
+        .store
+        .delete_thread(DeleteThreadParams {
+            thread_id: fixture.thread_id,
+        })
+        .await
+        .expect("delete thread");
+    assert!(!fixture.original.exists());
+    assert!(!current.exists());
+    assert!(!log.exists());
+}
+
+#[tokio::test]
+async fn revision_log_recovers_interrupted_writes_and_detects_tampering() {
+    let fixture = fixture().await;
+    let witness: Arc<dyn HistoryWitness> = Arc::new(Chain::default());
+    let revision = fixture.read().await.revision;
+    fixture
+        .rewrite(
+            Some(revision),
+            vec![HistoryRowEdit::Delete {
+                id: "user-2".to_string(),
+            }],
+            false,
+            Some(Arc::clone(&witness)),
+        )
+        .await
+        .expect("rewrite with witness");
+    fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect("intact history verifies");
+
+    let log = log_path(&fixture.store, fixture.thread_id);
+    let orphan = ThreadId::new();
+    append_record(
+        &log,
+        Some(witness.as_ref()),
+        &Record::Begin {
+            revision: orphan,
+            previous: orphan,
+            undo: false,
+            author: "crashed".to_string(),
+            at_ms: 0,
+            sources: Vec::new(),
+            written: 0,
+            source_forked_from_ordinal_exclusive: None,
+            source_subagent_history_start_ordinal: None,
+            edits: Vec::new(),
+        },
+    )
+    .expect("write interrupted begin");
+    fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect("interrupted rewrite is aborted");
+    assert!(std::fs::read_to_string(&log).expect("read log").ends_with(&format!(
+        "{{\"kind\":\"abort\",\"revision\":\"{orphan}\"}}\n"
+    )));
+
+    let tampered = std::fs::read_to_string(&log)
+        .expect("read log")
+        .replace("mod:redactor", "someone-else");
+    std::fs::write(&log, tampered).expect("tamper log");
+    let err = fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect_err("tampered log fails");
+    assert!(err.to_string().contains("history_anchor_mismatch"), "{err}");
+
+    std::fs::write(&log, std::fs::read_to_string(&log).unwrap().replace("someone-else", "mod:redactor"))
+        .expect("restore log");
+    let original = std::fs::read_to_string(&fixture.original).expect("read original");
+    std::fs::write(&fixture.original, original.replace("SECRET-1", "SECRET-2")).expect("forge original");
+    let err = fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(witness))
+        .await
+        .expect_err("forged original fails");
+    assert!(err.to_string().contains("history_original_mismatch"), "{err}");
+}
+
