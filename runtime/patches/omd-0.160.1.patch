+#[test]
+#[serial_test::serial]
+fn kitty_images_transmit_once_replace_per_component_and_tear_down() {
+    let png = || Some((vec![1, 2, 3], 4, 2));
+    let (id, columns, rows) = kitty_image("thumb", "a", png).expect("placed");
+    assert_eq!((columns, rows), (4, 2));
+    assert_eq!(kitty_image("thumb", "a", || None), Some((id, 4, 2)));
+    let pending = std::mem::take(&mut images().pending);
+    assert_eq!(pending.len(), 1);
+    assert!(pending[0].starts_with(&format!("\x1b_Ga=T,U=1,t=d,f=100,i={id},c=4,r=2,q=2,m=0;")));
+    let (next, _, _) = kitty_image("thumb", "b", png).expect("replaced");
+    assert_ne!(next, id);
+    let pending = std::mem::take(&mut images().pending);
+    assert_eq!(pending[0], crate::mod_backdrop::kitty_remove(id));
+    retain(&BTreeSet::new());
+    assert_eq!(
+        std::mem::take(&mut images().pending),
+        vec![crate::mod_backdrop::kitty_remove(next)]
+    );
+    kitty_image("other", "c", png).expect("placed");
+    let removed = images().placed["other"].1;
+    teardown();
+    assert!(images().placed.is_empty() && images().pending.is_empty());
+    assert_eq!(
+        kitty_image("other", "c", png).map(|(id, _, _)| id == removed),
+        Some(false)
+    );
+    retain(&BTreeSet::new());
+    images().pending.clear();
+}
