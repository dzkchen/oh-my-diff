+        agent_id: String,
+    }
+
+    let (mut session, turn) = make_session_and_context().await;
+    let manager = thread_manager();
+    set_agent_control(&mut session, manager.agent_control());
+    tokio::fs::create_dir_all(&turn.config.codex_home)
+        .await
+        .expect("codex home should be created");
+    let role_file = turn.config.codex_home.as_path().join("contributed.toml");
+    tokio::fs::write(
+        &role_file,
+        "name = \"ext/reviewer\"\ndescription = \"Reviews diffs\"\nmodel_reasoning_effort = \"low\"\n",
+    )
+    .await
+    .expect("role file should be written");
+    let workspace = turn.config.codex_home.join("worktree");
+    tokio::fs::create_dir_all(&workspace)
+        .await
+        .expect("worktree should be created");
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.agent_role_contributor(Arc::new(ContributedReviewer(role_file, workspace.clone())));
+    session.services.extensions = Arc::new(extensions.build());
+
+    let output = SpawnAgentHandler::default()
+        .handle(invocation(
