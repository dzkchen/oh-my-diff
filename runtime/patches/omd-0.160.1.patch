+    );
+    let mut dispatched = Vec::new();
+    let quit = run_command("quit", " now ", None, true, true, "user", &token, |args| {
+        dispatched.push(args);
+        Ok(serde_json::json!({"invoked": true}))
+    })
+    .unwrap();
+    assert_eq!(quit.value, serde_json::json!({"invoked": true}));
+    assert_eq!(dispatched, [" now "]);
+    let row = serde_json::json!({"key": "mods.notes.limit", "value": 3, "editable": true});
+    let stale = set_config(
+        &row,
+        serde_json::json!(4),
+        Some(&serde_json::json!(2)),
+        "user",
+        |_| unreachable!("a stale write is never applied"),
+    );
+    assert!(
+        stale
+            .unwrap_err()
+            .starts_with("config_stale: mods.notes.limit")
+    );
+    let managed = serde_json::json!({"key": "model", "value": "m", "editable": false});
+    let refused = set_config(&managed, serde_json::json!("x"), None, "user", |_| {
+        unreachable!("a managed row is never written")
+    });
+    assert_eq!(refused.unwrap_err(), "config_not_editable: model");
+}
+
+#[test]
+fn a_busy_runtime_answers_interception_from_the_last_lookup() {
+    assert!(remembered_intercept("busy_test_never", None));
+    assert!(!remembered_intercept("busy_test_seen", Some(false)));
+    assert!(!remembered_intercept("busy_test_seen", None));
+    assert!(remembered_intercept("busy_test_hooked", Some(true)));
+    assert!(remembered_intercept("busy_test_hooked", None));
+}
