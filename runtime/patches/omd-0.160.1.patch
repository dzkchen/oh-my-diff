index 000000000..874a6b63b
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/inventory.rs
@@ -0,0 +1,200 @@
+use super::*;
+use std::collections::BTreeSet;
+
+const ANSWER_CHARS: usize = 4096;
+const FINISHED_LIMIT: usize = 64;
+
+/// Session-wide agent records; observing one grants no control over it.
+#[derive(Default)]
+pub(super) struct Inventory {
+    records: Mutex<BTreeMap<String, Value>>,
+}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64)
+}
+
+impl Inventory {
+    /// Records a started agent keyed by its thread and returns the record.
+    pub(super) fn start(&self, thread: &str, fields: Value) -> Value {
+        let mut record = json!({"agent_id": null, "thread_id": thread,
+            "parent": {"thread_id": null, "agent_id": null}, "origin": "native", "owner": null,
+            "definition": null, "role": null, "status": "running", "started_at_ms": now_ms(),
+            "ended_at_ms": null, "duration_ms": null, "turns": 0, "last_turn": null, "answer": null,
+            "usage": {"requests": 0, "input_tokens": 0, "output_tokens": 0, "cached_tokens": 0,
+                "microusd": 0, "basis": "unknown", "source": null}, "reason": null});
+        if let (Some(record), Some(fields)) = (record.as_object_mut(), fields.as_object()) {
+            record.extend(fields.clone());
+        }
+        if let Ok(mut records) = self.records.lock() {
+            let finished = records
+                .iter()
+                .filter(|(_, record)| record["status"] != "running")
+                .map(|(thread, record)| (record["ended_at_ms"].as_u64(), thread.clone()))
+                .collect::<BTreeSet<_>>();
+            for (_, thread) in finished
+                .iter()
+                .take(finished.len().saturating_sub(FINISHED_LIMIT - 1))
+            {
+                records.remove(thread);
+            }
+            records.insert(thread.to_owned(), record.clone());
+        }
+        record
+    }
+
+    fn update(&self, thread: &str, change: impl FnOnce(&mut Value)) -> Option<Value> {
+        let mut records = self.records.lock().ok()?;
+        let record = records.get_mut(thread)?;
+        change(record);
+        Some(record.clone())
+    }
+
+    pub(super) fn contains(&self, thread: &str) -> bool {
+        self.records
+            .lock()
+            .is_ok_and(|records| records.contains_key(thread))
+    }
+
+    pub(super) fn answer(&self, thread: &str, text: &str) {
+        self.update(thread, |record| {
+            record["answer"] = json!(text.chars().take(ANSWER_CHARS).collect::<String>());
+        });
+    }
+
+    pub(super) fn turn(
+        &self,
+        thread: &str,
+        turn_id: &str,
+        outcome: &str,
+        error: Value,
+    ) -> Option<Value> {
+        self.update(thread, |record| {
+            record["turns"] = json!(record["turns"].as_u64().unwrap_or(0) + 1);
+            record["last_turn"] = json!({"turn_id": turn_id, "outcome": outcome, "at_ms": now_ms(),
+                "answer": record["answer"], "error": error});
+        })
+    }
+
+    /// Adds one `model_response` report to its thread's usage; unpriced spend makes the total partial.
+    pub(super) fn usage(&self, response: &Value) {
+        let Some(thread) = response["scope"]["thread_id"].as_str() else {
+            return;
+        };
+        let tokens = |pointer: &str| response["usage"].pointer(pointer).and_then(Value::as_u64);
+        self.update(thread, |record| {
+            let usage = &mut record["usage"];
+            if usage["source"] != "accounting" {
+                *usage = json!({"requests": 0, "input_tokens": 0, "output_tokens": 0,
+                    "cached_tokens": 0, "microusd": 0, "basis": "unknown", "source": "accounting"});
+            }
+            let add = |usage: &mut Value, key: &str, amount: Option<u64>| {
+                usage[key] = json!(usage[key].as_u64().unwrap_or(0) + amount.unwrap_or(0));
+            };
+            add(usage, "requests", Some(1));
+            add(usage, "input_tokens", tokens("/input_tokens"));
+            add(usage, "output_tokens", tokens("/output_tokens"));
+            add(
+                usage,
+                "cached_tokens",
+                tokens("/input_tokens_details/cached_tokens"),
+            );
+            let priced = response["cost"]["microusd"].as_u64();
+            add(usage, "microusd", priced);
+            let first = usage["requests"] == 1;
+            usage["basis"] = json!(match (usage["basis"].as_str(), priced) {
+                (Some("unknown"), None) => "unknown",
+                (Some("unknown"), Some(_)) if first => "settled",
+                (Some("settled"), Some(_)) => "settled",
+                _ => "partial",
+            });
+        });
+    }
+
+    /// Engine token totals for agents whose requests bypass OMD accounting; cost stays unknown.
+    pub(super) fn tokens(&self, thread: &str, total: &codex_protocol::protocol::TokenUsage) {
+        self.update(thread, |record| {
+            if record["usage"]["source"] == "accounting" {
+                return;
+            }
+            let count = |value: i64| u64::try_from(value).unwrap_or(0);
+            record["usage"] = json!({"requests": null, "input_tokens": count(total.input_tokens),
+                "output_tokens": count(total.output_tokens), "cached_tokens": count(total.cached_input_tokens),
+                "microusd": null, "basis": "unknown", "source": "engine"});
+        });
+    }
+
+    pub(super) fn end(&self, thread: &str, status: &str, reason: Option<String>) -> Option<Value> {
+        self.update(thread, |record| {
+            if record["status"] != "running" {
+                return;
+            }
+            let ended = now_ms();
+            record["status"] = json!(status);
+            record["reason"] = json!(reason);
+            record["ended_at_ms"] = json!(ended);
+            record["duration_ms"] =
+                json!(ended.saturating_sub(record["started_at_ms"].as_u64().unwrap_or(ended)));
+        })
+        .filter(|record| record["reason"] == json!(reason) && record["status"] == status)
+    }
+
+    /// The session thread at the root of `thread`'s parent chain; a thread without an agent record is its own root.
+    pub(super) fn root_thread(&self, thread: &str) -> String {
+        let Ok(records) = self.records.lock() else {
+            return thread.to_owned();
+        };
+        let mut root = thread;
+        for _ in 0..16 {
+            match records
+                .get(root)
+                .and_then(|record| record["parent"]["thread_id"].as_str())
+            {
+                Some(parent) => root = parent,
+                None => break,
+            }
+        }
+        root.to_owned()
+    }
+
+    pub(super) fn list(&self) -> Vec<Value> {
+        self.records
+            .lock()
+            .map(|records| records.values().cloned().collect())
+            .unwrap_or_default()
+    }
+}
+
+/// Publishes an `agent` lifecycle event to every observer, in order, under the session thread's state.
+pub(super) fn notify(
+    runtime: &Arc<Mutex<ModHost>>,
+    inventory: &Inventory,
+    phase: &str,
+    record: Value,
+) {
+    type Delivery = (Arc<Mutex<ModHost>>, Option<String>, Value);
+    static QUEUE: std::sync::OnceLock<std::sync::mpsc::Sender<Delivery>> =
+        std::sync::OnceLock::new();
+    let queue = QUEUE.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<Delivery>();
+        std::thread::spawn(move || {
+            for (runtime, thread, payload) in receiver {
+                let _thread = codex_omd::StateThread::enter(thread);
+                if let Ok(mut runtime) = runtime.lock() {
+                    let _ = runtime.event("agent", payload);
+                }
+            }
+        });
+        sender
+    });
+    let thread = record["parent"]["thread_id"]
+        .as_str()
+        .map(|parent| inventory.root_thread(parent));
+    let _ = queue.send((
+        runtime.clone(),
+        thread,
+        json!({"phase": phase, "agent": record}),
+    ));
+}
diff --git a/codex-rs/ext/omd/src/mods/launch_snapshot.rs b/codex-rs/ext/omd/src/mods/launch_snapshot.rs
new file mode 100644
index 000000000..1dbd7f502
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/launch_snapshot.rs
@@ -0,0 +1,187 @@
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::Read;
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+
+pub(super) struct Tree {
+    pub files: BTreeMap<PathBuf, Vec<u8>>,
+    pub links: BTreeMap<PathBuf, PathBuf>,
+    root: PathBuf,
+}
+
+pub(super) fn capture(root: &Path) -> Result<Tree, String> {
+    let canonical = root.canonicalize().map_err(|error| error.to_string())?;
+    if canonical != root || !root.is_dir() {
+        return Err("service_code_root_invalid".into());
+    }
+    let mut tree = Tree {
+        files: BTreeMap::new(),
+        links: BTreeMap::new(),
+        root: canonical,
+    };
+    let mut pending = vec![root.to_path_buf()];
+    let mut total = 0;
+    let mut entries = 0;
+    while let Some(directory) = pending.pop() {
+        for entry in fs::read_dir(directory).map_err(|error| error.to_string())? {
+            let entry = entry.map_err(|error| error.to_string())?;
+            let path = entry.path();
+            let kind = entry.file_type().map_err(|error| error.to_string())?;
+            entries += 1;
+            if entries > 8192 {
+                return Err("service_source_limit".into());
+            }
+            if kind.is_symlink() {
+                let target = fs::read_link(&path).map_err(|error| error.to_string())?;
+                if target.is_absolute()
+                    || !path
+                        .canonicalize()
+                        .map_err(|error| error.to_string())?
+                        .starts_with(root)
+                {
+                    return Err("service_dependency_escape".into());
+                }
+                tree.links.insert(path, target);
+            } else if kind.is_dir() {
+                pending.push(path);
+            } else if kind.is_file() {
+                let mut bytes = Vec::new();
+                let file = fs::OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+                    .open(&path)
+                    .map_err(|error| error.to_string())?;
+                if !file
+                    .metadata()
+                    .map_err(|error| error.to_string())?
+                    .is_file()
+                {
+                    return Err("service_dependency_type_invalid".into());
+                }
+                file.take(64 * 1024 * 1024 + 1)
+                    .read_to_end(&mut bytes)
+                    .map_err(|error| error.to_string())?;
+                total += bytes.len();
+                if bytes.len() > 64 * 1024 * 1024 || total > 128 * 1024 * 1024 {
+                    return Err("service_source_limit".into());
+                }
+                tree.files.insert(path, bytes);
+            } else {
+                return Err("service_dependency_type_invalid".into());
+            }
+        }
+    }
+    Ok(tree)
+}
+
+pub(super) fn digest(tree: &Tree) -> String {
+    let mut rows = BTreeMap::new();
+    for (path, bytes) in &tree.files {
+        rows.insert(
+            path.strip_prefix(&tree.root)
+                .unwrap()
+                .to_string_lossy()
+                .into_owned(),
+            ("file", super::execution::hash(bytes)),
+        );
+    }
+    for (path, target) in &tree.links {
+        rows.insert(
+            path.strip_prefix(&tree.root)
+                .unwrap()
+                .to_string_lossy()
+                .into_owned(),
+            ("link", target.to_string_lossy().into_owned()),
+        );
+    }
+    let rows = rows
+        .into_iter()
+        .map(|(path, (kind, value))| (path, kind, value))
+        .collect::<Vec<_>>();
+    super::execution::hash(&serde_json::to_vec(&rows).unwrap())
+}
+
+pub(super) fn path(root: &Path, source: &Path) -> Result<PathBuf, String> {
+    if source
+        .components()
+        .any(|part| matches!(part, std::path::Component::ParentDir))
+    {
+        return Err("service_source_path_invalid".into());
+    }
+    Ok(root.join(
+        source
+            .strip_prefix("/")
+            .map_err(|_| "service_source_path_invalid")?,
+    ))
+}
+
+pub(super) fn materialize(
+    root: &Path,
+    files: &BTreeMap<PathBuf, Vec<u8>>,
+    links: &BTreeMap<PathBuf, PathBuf>,
+) -> Result<tempfile::TempDir, String> {
+    use std::io::Write;
+    let snapshot = tempfile::Builder::new()
+        .prefix("service-code-")
+        .tempdir_in(root)
+        .map_err(|error| error.to_string())?;
+    for (source, bytes) in files {
+        let target = path(snapshot.path(), source)?;
+        fs::create_dir_all(target.parent().unwrap()).map_err(|error| error.to_string())?;
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o500)
+            .open(target)
+            .map_err(|error| error.to_string())?;
+        file.write_all(bytes).map_err(|error| error.to_string())?;
+    }
+    for (source, relative) in links {
+        let target = path(snapshot.path(), source)?;
+        fs::create_dir_all(target.parent().unwrap()).map_err(|error| error.to_string())?;
+        std::os::unix::fs::symlink(relative, target).map_err(|error| error.to_string())?;
+    }
+    fs::set_permissions(snapshot.path(), fs::Permissions::from_mode(0o700))
+        .map_err(|error| error.to_string())?;
+    Ok(snapshot)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn captured_dependencies_are_verified_and_materialized_without_reopening() {
+        let root = tempfile::tempdir().unwrap();
+        let code = root.path().join("code");
+        fs::create_dir(&code).unwrap();
+        let code = code.canonicalize().unwrap();
+        fs::write(code.join("helper.mjs"), "admitted helper").unwrap();
+        fs::write(code.join("dependency.mjs"), "admitted dependency").unwrap();
+        fs::write(code.join("executable"), "#!/bin/sh\nexit 0\n").unwrap();
+        std::os::unix::fs::symlink("dependency.mjs", code.join("link.mjs")).unwrap();
+        let captured = capture(&code).unwrap();
+        let expected = digest(&captured);
+        fs::write(code.join("helper.mjs"), "changed helper").unwrap();
+        fs::write(code.join("dependency.mjs"), "changed dependency").unwrap();
+        assert_ne!(digest(&capture(&code).unwrap()), expected);
+        let snapshot = materialize(root.path(), &captured.files, &captured.links).unwrap();
+        assert!(
+            std::process::Command::new(path(snapshot.path(), &code.join("executable")).unwrap())
+                .status()
+                .unwrap()
+                .success()
+        );
+        assert_eq!(
+            fs::read(path(snapshot.path(), &code.join("helper.mjs")).unwrap()).unwrap(),
+            b"admitted helper"
+        );
+        assert_eq!(
+            fs::read(path(snapshot.path(), &code.join("link.mjs")).unwrap()).unwrap(),
+            b"admitted dependency"
+        );
+        std::os::unix::fs::symlink("../escape", code.join("escape")).unwrap();
+        assert!(capture(&code).is_err());
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/operations.rs b/codex-rs/ext/omd/src/mods/operations.rs
new file mode 100644
index 000000000..1d93c3432
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/operations.rs
@@ -0,0 +1,663 @@
+use super::*;
+use crate::workspace_operations::WorkspaceAuthority;
+use codex_omd::data_store::Origin;
+
+#[derive(Clone, Default)]
+pub(crate) struct DataScope(pub(super) Arc<Mutex<Option<codex_omd::scoped_data::ScopedDataHosts>>>);
+
+impl DataScope {
+    async fn call(
+        &self,
+        lead: &Lead,
+        authority: WorkspaceAuthority,
+        caller: &Caller<'_>,
+        request: ModHostCall,
+        cancelled: Arc<AtomicBool>,
+    ) -> Result<Value, String> {
+        let root = lead.host.root.clone();
+        let scope = self.0.clone();
+        let thread = lead.thread.to_string();
+        let (id, source) = (caller.id.to_owned(), caller.source.to_owned());
+        tokio::task::spawn_blocking(move || {
+            let mut scope = scope.lock().map_err(|_| "data_scope_poisoned")?;
+            scope
+                .get_or_insert_with(|| {
+                    codex_omd::scoped_data::ScopedDataHosts::new(
+                        root,
+                        authority.repository.clone(),
+                        authority.session_root.clone(),
+                        authority.session_database.clone(),
+                        thread,
+                    )
+                })
+                .call(&id, &source, &request.operation, request.arguments, || {
+                    !cancelled.load(Ordering::Acquire)
+                })
+                .map_err(|error| error.to_string())
+        })
+        .await
+        .map_err(|error| error.to_string())?
+    }
+}
+
+pub(super) struct Caller<'a> {
+    pub id: &'a str,
+    pub source: &'a str,
+    pub grants: Option<ModGrants>,
+    pub generation: u64,
+    pub origin: Origin,
+    pub record_changes: bool,
+}
+
+pub(super) fn event_allows(event: &str, operation: &str) -> bool {
+    crate::generic_host::event_allows(event, operation)
+        || super::expansion::event_allows(event)
+        || event == "context"
+            && (codex_omd::scoped_data::operation(operation)
+                || matches!(
+                    operation,
+                    "store.get"
+                        | "store.list"
+                        | "routes.list"
+                        | "session.info"
+                        | "tools.list"
+                        | "task.status"
+                        | "contract.status"
+                        | "workspace.fingerprint"
+                ))
+        || matches!(event, "component_event" | "command")
+            && (codex_omd::host::served(operation)
+                || codex_omd::client_surface::SURFACE_OPERATIONS.contains(&operation)
+                || matches!(
+                    operation,
+                    "app.routes"
+                        | "model.complete"
+                        | "model.fork"
+                        | "session.info"
+                        | "tools.list"
+                        | "turns.activity"
+                        | "events.publish"
+                        | "credentials.list"
+                        | "packages.list"
+                        | "packages.preview"
+                ))
+}
+
+pub(super) fn route_info(host: &Host, route: &config::Route) -> Value {
+    let available = route.grant.as_ref().is_none_or(|grant| {
+        accounting::worker_authorized(
+            &grant.path,
+            &grant.sha256,
+            &host.repository_identity,
+            &route.provider,
+            &route.model,
+            &route.responses_url,
+            route.rates.included_subscription,
+        )
+    });
+    json!({"name": route.name, "model": route.model, "provider": route.provider,
+        "reasoning": route.reasoning_effort, "roles": route.roles,
+        "billing": accounting::billing(Some(&route.rates)),
+        "tools": route.tools, "available": available, "credential": route.credential})
+}
+
+async fn authority(lead: &Lead, call: Option<&ToolCall<'_>>) -> Result<WorkspaceAuthority, String> {
+    match call {
+        Some(call) => WorkspaceAuthority::for_call(lead, call).await,
+        None => WorkspaceAuthority::for_lead(lead).await,
+    }
+}
+
+pub(super) fn exclusive(session: &Session) -> Result<OperationGuard, String> {
+    acquire_workspace_operation(&session.repository_identity)
+}
+
+fn needs_exclusive_workspace(operation: &str, arguments: &Value) -> bool {
+    matches!(operation, "workspace.transaction" | "workspace.restore")
+        || operation == "exec.run"
+            && arguments.get("snapshot").is_none()
+            && (arguments.get("write") == Some(&Value::Bool(true))
+                || arguments.get("guards").is_some()
+                || arguments.get("required_access").is_some())
+}
+
+fn workspace_guard(
+    operation: &str,
+    arguments: &Value,
+    repository_identity: &str,
+) -> Result<Option<OperationGuard>, String> {
+    needs_exclusive_workspace(operation, arguments)
+        .then(|| acquire_workspace_operation(repository_identity))
+        .transpose()
+}
+
+pub(super) fn now() -> u128 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_millis())
+        .unwrap_or_default()
+}
+
+fn notify_contract(core: &Core, payload: Value) {
+    let runtime = core.runtime.clone();
+    tokio::task::spawn_blocking(move || {
+        if let Ok(mut runtime) = runtime.lock() {
+            let _ = runtime.event("contract", payload);
+        }
+    });
+}
+
+async fn submit_receipt(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        kind: String,
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+        outcome: codex_omd::ReceiptOutcome,
+        evidence: codex_omd::resource_data::ResourceRef,
+        #[serde(default)]
+        agent: Option<String>,
+        #[serde(default)]
+        execution: bool,
+        #[serde(default)]
+        findings: Vec<codex_omd::ReceiptFinding>,
+        #[serde(default)]
+        resolves: Vec<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    if input.execution && input.agent.is_some() {
+        return Err("receipt_producer_conflict".into());
+    }
+    let producer = match input.agent {
+        Some(handle) => {
+            core.agents
+                .attest(
+                    &handle,
+                    caller.id,
+                    caller.generation,
+                    &lead.session.task,
+                    super::agents::AgentClaim {
+                        candidate_sha256: &input.candidate_sha256,
+                        acceptance_sha256: input.acceptance_sha256.as_deref(),
+                        resolves: &input.resolves,
+                        evidence: &input.evidence,
+                    },
+                )
+                .await?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Agent,
+                handle: Some(handle),
+            }
+        }
+        None if input.execution => {
+            core.agents.attest_execution(
+                lead,
+                caller,
+                &input.candidate_sha256,
+                &input.evidence,
+                input.outcome,
+            )?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Host,
+                handle: None,
+            }
+        }
+        None => codex_omd::ReceiptProducer {
+            kind: codex_omd::ProducerKind::Lead,
+            handle: None,
+        },
+    };
+    let receipt = codex_omd::Receipt {
+        kind: input.kind,
+        candidate_sha256: input.candidate_sha256,
+        acceptance_sha256: input.acceptance_sha256,
+        outcome: input.outcome,
+        evidence: input.evidence,
+        producer,
+        findings: input.findings,
+        resolves: input.resolves,
+        submitted_by: caller.id.to_owned(),
+        at: now(),
+    };
+    receipt.validate()?;
+    let value = serde_json::to_value(&receipt).map_err(|e| e.to_string())?;
+    let bytes = serde_json::to_vec(&value).map_err(|e| e.to_string())?;
+    lead.session
+        .evidence(&format!("receipt-{}.json", execution::hash(&bytes)), &value)?;
+    let submitted = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .submit(receipt)?;
+    lead.session.persist_contract()?;
+    Ok(submitted)
+}
+
+pub(super) fn gate(
+    core: &Core,
+    lead: &Lead,
+    gate: codex_omd::Gate,
+    candidate_sha256: &str,
+    acceptance_sha256: Option<&str>,
+) -> Result<contract::GateOutcome, String> {
+    let outcome = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .gate(gate, candidate_sha256, acceptance_sha256)?;
+    notify_contract(core, outcome.event(gate, candidate_sha256));
+    Ok(outcome)
+}
+
+async fn complete(core: &Core, lead: &Lead, arguments: Value) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    let _workspace_guard = exclusive(&lead.session)?;
+    let host = lead.host.clone();
+    let current = tokio::task::spawn_blocking(move || contract::current_candidate(&host))
+        .await
+        .map_err(|e| e.to_string())??;
+    if current != input.candidate_sha256 {
+        return Err("candidate_changed: the workspace no longer matches candidate_sha256".into());
+    }
+    let outcome = gate(
+        core,
+        lead,
+        codex_omd::Gate::Complete,
+        &current,
+        input.acceptance_sha256.as_deref(),
+    )?;
+    if let Some(refusal) = outcome.refusal() {
+        return Ok(refusal);
+    }
+    let status = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .status();
+    lead.session.evidence(
+        &format!("completion-{current}-{}.json", now()),
+        &json!({"candidate_sha256": current, "contract": status}),
+    )?;
+    Ok(json!({"status": "completed", "receipts": status["receipts"]}))
+}
+
+pub(super) async fn dispatch(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    let id = caller.id.to_owned();
+    let audited =
+        codex_omd::access_receipt(&id, &request, Ok(&Value::Null)).map(|_| request.clone());
+    let result = run(core, lead, caller, call, request, cancelled).await;
+    if let Some(request) = audited
+        && let Some(receipt) =
+            codex_omd::access_receipt(&id, &request, result.as_ref().map_err(Clone::clone))
+    {
+        lead.session.record_access(&receipt);
+    }
+    result
+}
+
+async fn run(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    let host = &lead.host;
+    let operation = request.operation.clone();
+    if operation != "contract.status" {
+        lead.restricted(&operation, &request.arguments)?;
+    }
+    if super::expansion::served(&operation) {
+        return super::expansion::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    let active = {
+        let cancelled = cancelled.clone();
+        move || !cancelled.load(Ordering::Acquire)
+    };
+    if codex_omd::host::served(&operation) {
+        if operation == "exec.run" && request.arguments.get("snapshot").is_some() {
+            if request.arguments.get("guards").is_some()
+                || request.arguments.get("required_access").is_some()
+            {
+                return Err("exec_guards_require_live_workspace".into());
+            }
+            if request.arguments.get("sandbox").is_some() {
+                return Err("exec_snapshot_requires_sandbox".into());
+            }
+            let authority = authority(lead, call).await?;
+            let scoped = Lead {
+                permission_profile: Arc::new(std::sync::Mutex::new(authority.context.permissions)),
+                ..lead.clone()
+            };
+            return core
+                .agents
+                .execute_snapshot(&scoped, &caller, request.arguments, cancelled)
+                .await;
+        }
+        let _guard = workspace_guard(
+            &operation,
+            &request.arguments,
+            &lead.session.repository_identity,
+        )?;
+        let authority = authority(lead, call).await?;
+        let (root, protected) = (host.root.clone(), host.protected_paths());
+        let (id, thread) = (caller.id.to_owned(), lead.thread.to_string());
+        let (grants, origin, record) = (caller.grants, caller.origin, caller.record_changes);
+        return tokio::task::spawn_blocking(move || {
+            crate::generic_host::call(
+                grants,
+                &authority,
+                &root,
+                protected,
+                &id,
+                origin,
+                Some(&thread),
+                request,
+                &active,
+                record,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation == "sessions.snapshot" {
+        let authority = authority(lead, call).await?;
+        let scoped = Lead {
+            permission_profile: Arc::new(std::sync::Mutex::new(authority.context.permissions)),
+            ..lead.clone()
+        };
+        return core
+            .agents
+            .history_evidence(&scoped, &caller, request.arguments, cancelled)
+            .await;
+    }
+    if codex_omd::scoped_data::operation(&operation) {
+        let authority = authority(lead, call).await?;
+        return lead
+            .session
+            .data
+            .call(lead, authority, &caller, request, cancelled.clone())
+            .await;
+    }
+    if operation == "workspace.request_rename" {
+        if call.is_none() {
+            return Err(
+                "host_operation_unavailable: workspace.request_rename runs in tools".into(),
+            );
+        }
+        let _guard = exclusive(&lead.session)?;
+        let authority = authority(lead, call).await?;
+        let runtime = core.input_runtime.clone();
+        let processes = lead.session.processes.clone();
+        let generation = caller.generation;
+        let protected = host.protected_paths();
+        return tokio::task::spawn_blocking(move || {
+            let mut runtime = runtime.lock().map_err(|_| "pre_rename_runtime_poisoned")?;
+            authority.request_rename(
+                request.arguments,
+                &mut runtime,
+                &processes,
+                &protected,
+                generation,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation.starts_with("process.") {
+        crate::generic_host::process_request_allowed(caller.grants.as_ref(), &request)?;
+        let authority = authority(lead, call).await?;
+        let processes = lead.session.processes.clone();
+        let (id, generation) = (caller.id.to_owned(), caller.generation);
+        let started = (operation == "process.start").then(|| request.arguments.clone());
+        let protected = host.protected_paths();
+        let os_access = caller
+            .grants
+            .as_ref()
+            .and_then(|grants| grants.os_access.clone());
+        let result = tokio::task::spawn_blocking(move || {
+            processes.call(
+                crate::managed_process::ProcessOwner {
+                    id: &id,
+                    generation,
+                    repository: &authority.repository,
+                    policy: &authority.policy,
+                    protected: &protected,
+                    os_access: os_access.as_ref(),
+                },
+                &request.operation,
+                request.arguments,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+        if let (Some(arguments), Ok(_)) = (started, &result) {
+            super::expansion::process_started(core, lead, caller.id, &arguments);
+        }
+        return result;
+    }
+    if operation.starts_with("agents.")
+        || matches!(
+            operation.as_str(),
+            "workspace.integrate"
+                | "workspace.snapshot"
+                | "workspace.fingerprint"
+                | "model.complete"
+                | "model.fork"
+        )
+    {
+        let scoped = match (operation.as_str(), call) {
+            ("agents.spawn" | "workspace.snapshot" | "workspace.fingerprint", Some(call)) => {
+                let authority = WorkspaceAuthority::for_call(lead, call).await?;
+                Some(Lead {
+                    permission_profile: Arc::new(std::sync::Mutex::new(
+                        authority.context.permissions,
+                    )),
+                    ..lead.clone()
+                })
+            }
+            _ => None,
+        };
+        let lead = scoped.as_ref().unwrap_or(lead);
+        if operation == "workspace.snapshot" {
+            return core
+                .agents
+                .snapshot(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        if operation == "workspace.fingerprint" {
+            return core
+                .agents
+                .fingerprint(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        let repository = host.repository.clone();
+        let before = if operation == "workspace.integrate" && caller.record_changes {
+            tokio::task::spawn_blocking(move || codex_omd::change_baseline(&repository))
+                .await
+                .map_err(|e| e.to_string())?
+        } else {
+            None
+        };
+        let result = core
+            .agents
+            .call(core, lead, &caller, request, cancelled)
+            .await;
+        if let (Some(before), Ok(_)) = (before, &result) {
+            let repository = host.repository.clone();
+            let _ = tokio::task::spawn_blocking(move || {
+                codex_omd::record_workspace_change(&repository, "transaction", before)
+            })
+            .await;
+        }
+        return result;
+    }
+    if operation.starts_with("http.") || operation.starts_with("mcp.") {
+        return super::access::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    if operation.starts_with("providers.") || operation.starts_with("sidecars.") {
+        return core
+            .services
+            .call(&core.runtime, lead, caller.id, caller.generation, request)
+            .await;
+    }
+    match operation.as_str() {
+        "routes.list" => Ok(json!(
+            host.route_config()
+                .0
+                .routes_for(caller.id)
+                .into_iter()
+                .map(|route| route_info(host, route))
+                .collect::<Vec<_>>()
+        )),
+        "ledger.settle" => {
+            let arguments = &request.arguments;
+            let (Some(request_id), Some(microusd), Some(source)) = (
+                arguments["request_id"].as_str(),
+                arguments["microusd"].as_u64(),
+                arguments["source"].as_str(),
+            ) else {
+                return Err("ledger_settle_invalid".into());
+            };
+            let config = host.route_config().0;
+            host.accounts
+                .settle_provider(request_id, microusd, source, |provider| {
+                    config.billed_rates(provider, Some(caller.id)).is_some()
+                })
+        }
+        "session.info" => {
+            let account = host
+                .accounts
+                .0
+                .lock()
+                .map_err(|_| "account lock poisoned")?
+                .get(&lead.thread.to_string())
+                .cloned();
+            let config = super::agents::parent_config(lead).await?;
+            let turns = core
+                .expansion
+                .turns
+                .lock()
+                .map_err(|_| "turn_count_poisoned")?
+                .get(&lead.thread.to_string())
+                .copied()
+                .unwrap_or(0);
+            Ok(
+                json!({"thread_id": lead.thread.to_string(), "root": host.repository,
+                "cwd": config.cwd, "codex_version": env!("CARGO_PKG_VERSION"),
+                "model": account.as_ref().map_or(config.model.clone(), |account| Some(account.model.clone())),
+                "provider": account.as_ref().map_or(config.model_provider_id.clone(), |account| account.provider.clone()),
+                "route": account.and_then(|account| account.route), "turns_started": turns}),
+            )
+        }
+        "task.status" => {
+            host.refresh_session(&lead.session)?;
+            let config = host.route_config().0;
+            Ok(json!({"ledger": lead.ledger(), "limits": config.limits,
+            "worker_limits": config.worker_limits}))
+        }
+        "peers.list" | "peers.send" => {
+            let endpoints = super::peering::current_endpoints(core).await;
+            core.peering.call(lead, &caller, request, endpoints)
+        }
+        "turns.queue" | "turns.queued" | "turns.dequeue" => {
+            let core = core.this.upgrade().ok_or("native_host_stopped")?;
+            core.autonomy.call(&core, lead, &caller, request)
+        }
+        "receipts.submit" => submit_receipt(core, lead, &caller, request.arguments).await,
+        "task.complete" => complete(core, lead, request.arguments).await,
+        "contract.status" => Ok(lead
+            .session
+            .contract
+            .lock()
+            .map_err(|_| "contract_lock_poisoned")?
+            .status()),
+        "contract.restrict" => {
+            let restricted = lead
+                .session
+                .contract
+                .lock()
+                .map_err(|_| "contract_lock_poisoned")?
+                .restrict(request.arguments)?;
+            lead.session.persist_contract()?;
+            Ok(restricted)
+        }
+        _ => Err(format!("unsupported_host_operation: {operation}")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn live_exec_write_reserves_the_workspace_across_sessions() {
+        let temp = tempfile::tempdir().unwrap();
+        let repository = temp.path().to_str().unwrap();
+        let write = json!({"program":"sh","write":true});
+        assert!(
+            workspace_guard("exec.run", &json!({"program":"sh"}), repository)
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            workspace_guard(
+                "exec.run",
+                &json!({"program":"sh","write":true,"snapshot":{"sha256":"x"}}),
+                repository
+            )
+            .unwrap()
+            .is_none()
+        );
+        let (held_tx, held_rx) = std::sync::mpsc::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        std::thread::scope(|scope| {
+            let write = &write;
+            scope.spawn(move || {
+                let _guard = workspace_guard("exec.run", write, repository)
+                    .unwrap()
+                    .unwrap();
+                held_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+            });
+            held_rx.recv().unwrap();
+            assert!(
+                workspace_guard("workspace.restore", &json!({}), repository)
+                    .err()
+                    .unwrap()
+                    .contains("workspace_operation_active")
+            );
+            release_tx.send(()).unwrap();
+        });
+        let _guard = workspace_guard("exec.run", &write, repository)
+            .unwrap()
+            .unwrap();
+    }
+}
