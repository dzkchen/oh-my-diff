+impl ResponseObserver for Accounts {
+    fn prepare(
+        &self,
+        request: &mut Request,
+        body: &mut Option<EncodedJsonBody>,
+    ) -> Result<(), TransportError> {
+        let thread = request
+            .headers
+            .get("thread-id")
+            .and_then(|v| v.to_str().ok())
+            .map(str::to_owned)
+            .unwrap_or_default();
