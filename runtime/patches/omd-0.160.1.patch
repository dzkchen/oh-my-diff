+fn host_config_stamp(root: &std::path::Path) -> Option<(u64, std::time::SystemTime)> {
+    let metadata = std::fs::metadata(root.join(config::HOST_CONFIG)).ok()?;
+    Some((metadata.len(), metadata.modified().ok()?))
+}
