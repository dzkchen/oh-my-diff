@@ -0,0 +1,170 @@
+use crate::app_routes::subscribed;
+use serde_json::Value;
+use std::collections::{BTreeMap, VecDeque};
+use std::io;
+use std::sync::{LazyLock, Mutex};
+
+pub const CHANNEL_QUEUE_EVENTS: usize = 256;
+pub const CHANNEL_QUEUE_BYTES: usize = 1 << 20;
+pub const CHANNEL_EVENT_BYTES: usize = 64 * 1024;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChannelEvent {
+    pub publisher: String,
+    pub channel: String,
+    pub data: Value,
+    pub correlation: Option<String>,
+    pub sequence: u64,
+    pub dropped: u64,
+}
+
+#[derive(Debug, Default, PartialEq)]
+pub struct Delivery {
+    pub delivered: usize,
+    pub dropped: usize,
+}
+
+struct Subscriber {
+    patterns: Vec<String>,
+    queue: VecDeque<(ChannelEvent, usize)>,
+    bytes: usize,
+    dropped: u64,
+}
+
+pub struct EventBus {
+    subscribers: BTreeMap<String, Subscriber>,
+    sequences: BTreeMap<String, u64>,
+    max_events: usize,
+    max_bytes: usize,
+}
+
+static GLOBAL: LazyLock<Mutex<EventBus>> = LazyLock::new(|| Mutex::new(EventBus::default()));
+
+pub fn global() -> &'static Mutex<EventBus> {
+    &GLOBAL
+}
+
+impl Default for EventBus {
+    fn default() -> Self {
+        Self::new(CHANNEL_QUEUE_EVENTS, CHANNEL_QUEUE_BYTES)
+    }
+}
+
+fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 64
+        && name.bytes().all(|b| {
+            b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'_' | b'-' | b'.')
+        })
+}
+
+impl EventBus {
+    pub fn new(max_events: usize, max_bytes: usize) -> Self {
+        Self {
+            subscribers: BTreeMap::new(),
+            sequences: BTreeMap::new(),
+            max_events,
+            max_bytes,
+        }
+    }
+
+    pub fn subscribe(&mut self, subscriber: &str, patterns: Vec<String>) {
+        if patterns.is_empty() {
+            self.subscribers.remove(subscriber);
+            return;
+        }
+        let entry = self
+            .subscribers
+            .entry(subscriber.to_owned())
+            .or_insert_with(|| Subscriber {
+                patterns: Vec::new(),
+                queue: VecDeque::new(),
+                bytes: 0,
+                dropped: 0,
+            });
+        entry.patterns = patterns;
+    }
+
+    pub fn unsubscribe(&mut self, subscriber: &str) {
+        self.subscribers.remove(subscriber);
+    }
+
+    pub fn publish(
+        &mut self,
+        publisher: &str,
+        name: &str,
+        data: Value,
+        correlation: Option<String>,
+    ) -> io::Result<Delivery> {
+        if !valid_name(name) {
+            return Err(io::Error::other(format!("channel_name_invalid: {name}")));
+        }
+        let size = data.to_string().len();
+        if size > CHANNEL_EVENT_BYTES {
+            return Err(io::Error::other(format!("channel_event_too_large: {size}")));
+        }
+        if correlation.as_ref().is_some_and(|c| c.len() > 256) {
+            return Err(io::Error::other("channel_correlation_too_large"));
+        }
+        let channel = format!("{publisher}/{name}");
+        let sequence = self.sequences.entry(channel.clone()).or_default();
+        *sequence += 1;
+        let event = ChannelEvent {
+            publisher: publisher.to_owned(),
+            channel: channel.clone(),
+            data,
+            correlation,
+            sequence: *sequence,
+            dropped: 0,
+        };
+        let mut delivery = Delivery::default();
+        for subscriber in self
+            .subscribers
+            .values_mut()
+            .filter(|s| subscribed(&s.patterns, &channel))
+        {
+            subscriber.bytes += size;
+            subscriber.queue.push_back((event.clone(), size));
+            delivery.delivered += 1;
+            while subscriber.queue.len() > self.max_events
+                || (subscriber.bytes > self.max_bytes && subscriber.queue.len() > 1)
+            {
+                if let Some((_, old)) = subscriber.queue.pop_front() {
+                    subscriber.bytes -= old;
+                    subscriber.dropped += 1;
+                    delivery.dropped += 1;
+                }
+            }
+        }
+        Ok(delivery)
+    }
+
+    pub fn drain(&mut self, subscriber: &str, limit: usize) -> Vec<ChannelEvent> {
+        let Some(entry) = self.subscribers.get_mut(subscriber) else {
+            return Vec::new();
+        };
+        let count = limit.min(entry.queue.len());
+        let mut drained: Vec<_> = entry
+            .queue
+            .drain(..count)
+            .map(|(event, bytes)| {
+                entry.bytes -= bytes;
+                event
+            })
+            .collect();
+        if let Some(first) = drained.first_mut() {
+            first.dropped = std::mem::take(&mut entry.dropped);
+        }
+        drained
+    }
+
+    pub fn pending(&self, subscriber: &str) -> usize {
+        self.subscribers
+            .get(subscriber)
+            .map_or(0, |s| s.queue.len())
+    }
+}
+
+#[cfg(test)]
+#[path = "event_bus_tests.rs"]
+mod tests;
diff --git a/codex-rs/omd/src/event_bus_tests.rs b/codex-rs/omd/src/event_bus_tests.rs
new file mode 100644
index 000000000..9be412f12
--- /dev/null
+++ b/codex-rs/omd/src/event_bus_tests.rs
@@ -0,0 +1,106 @@
+use super::*;
+use serde_json::json;
+
+#[test]
+fn publishers_are_namespaced_and_subscribers_filter_by_pattern() {
+    let mut bus = EventBus::default();
+    bus.subscribe("graph", vec!["runner/*".to_owned()]);
+    bus.subscribe("notify", vec!["runner/finished".to_owned()]);
+    bus.subscribe("idle", vec!["other/*".to_owned()]);
+    assert_eq!(
+        bus.publish("runner", "started", json!({"n": 1}), None)
+            .unwrap(),
+        Delivery {
+            delivered: 1,
+            dropped: 0
+        }
+    );
+    assert_eq!(
+        bus.publish(
+            "runner",
+            "finished",
+            json!({"n": 2}),
+            Some("job-7".to_owned())
+        )
+        .unwrap()
+        .delivered,
+        2
+    );
+    let graph = bus.drain("graph", usize::MAX);
+    assert_eq!(
+        graph
+            .iter()
+            .map(|e| (e.channel.as_str(), e.sequence))
+            .collect::<Vec<_>>(),
+        [("runner/started", 1), ("runner/finished", 1)]
+    );
+    let notify = bus.drain("notify", usize::MAX);
+    assert_eq!(
+        (
+            notify[0].publisher.as_str(),
+            notify[0].correlation.as_deref()
+        ),
+        ("runner", Some("job-7"))
+    );
+    assert!(bus.drain("idle", usize::MAX).is_empty());
+    assert!(bus.drain("unknown", usize::MAX).is_empty());
+}
+
+#[test]
+fn names_and_sizes_are_bounded() {
+    let mut bus = EventBus::default();
+    for name in ["", "Upper", "a/b", &"x".repeat(65)] {
+        assert!(bus.publish("m", name, json!(null), None).is_err(), "{name}");
+    }
+    assert!(
+        bus.publish("m", "big", json!("x".repeat(CHANNEL_EVENT_BYTES)), None)
+            .is_err()
+    );
+    assert!(
+        bus.publish("m", "ok", json!(null), Some("c".repeat(257)))
+            .is_err()
+    );
+    assert!(bus.publish("m", "ok.v1-x_2", json!(null), None).is_ok());
+}
+
+#[test]
+fn slow_subscribers_drop_oldest_and_see_the_count() {
+    let mut bus = EventBus::new(2, 1 << 20);
+    bus.subscribe("slow", vec!["p/*".to_owned()]);
+    let mut dropped = 0;
+    for n in 0..5 {
+        dropped += bus.publish("p", "tick", json!(n), None).unwrap().dropped;
+    }
+    assert_eq!((dropped, bus.pending("slow")), (3, 2));
+    let events = bus.drain("slow", usize::MAX);
+    assert_eq!(
+        (
+            events[0].data.clone(),
+            events[0].dropped,
+            events[1].sequence
+        ),
+        (json!(3), 3, 5)
+    );
+    bus.publish("p", "tick", json!(5), None).unwrap();
+    bus.publish("p", "tick", json!(6), None).unwrap();
+    assert_eq!(bus.drain("slow", 1)[0].data, json!(5));
+    assert_eq!(bus.pending("slow"), 1);
+    assert_eq!(bus.drain("slow", usize::MAX)[0].dropped, 0);
+}
+
+#[test]
+fn resubscribing_replaces_patterns_and_empty_unsubscribes() {
+    let mut bus = EventBus::default();
+    bus.subscribe("m", vec!["a/*".to_owned()]);
+    bus.subscribe("m", vec!["b/*".to_owned()]);
+    assert_eq!(bus.publish("a", "x", json!(1), None).unwrap().delivered, 0);
+    assert_eq!(bus.publish("b", "x", json!(1), None).unwrap().delivered, 1);
+    bus.subscribe("m", Vec::new());
+    assert_eq!(
+        (
+            bus.pending("m"),
+            bus.publish("b", "x", json!(1), None).unwrap().delivered
+        ),
+        (0, 0)
+    );
+}
