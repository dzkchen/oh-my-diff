+    assert!(
+        std::fs::read_dir(temp.path().join("store"))
+            .unwrap()
+            .all(|entry| !entry
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .ends_with(".tmp")),
+        "refused archives leave no staging directory"
+    );
