+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Region {
+    pub(crate) content: String,
+    pub(crate) area: Rect,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct TabBar {
+    pub(crate) path: String,
+    pub(crate) area: Rect,
+    pub(crate) titles: Vec<String>,
+    pub(crate) active: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Handle {
+    path: String,
+    index: usize,
+    split: ModSplit,
+    starts: Vec<u16>,
+    sizes: Vec<u16>,
+    span: (u16, u16),
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Placement {
+    pub(crate) regions: Vec<Region>,
+    pub(crate) tabs: Vec<TabBar>,
+    handles: Vec<Handle>,
+}
+
+impl Placement {
+    pub(crate) fn area(&self, content: &str) -> Option<Rect> {
+        self.regions
+            .iter()
+            .find(|region| region.content == content)
+            .map(|region| region.area)
+    }
+
+    pub(crate) fn chat(&self) -> Option<Rect> {
+        let transcript = self.area("transcript")?;
+        Some(match self.area("composer") {
+            Some(composer) => transcript.union(composer),
+            None => transcript,
+        })
+    }
+}
+
+#[derive(Default)]
+struct State {
+    layout: Option<ModLayout>,
+    ratios: BTreeMap<String, Vec<u16>>,
+    active: BTreeMap<String, usize>,
+    drag: Option<(String, usize)>,
+    last: Placement,
+}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+
+fn with<T>(run: impl FnOnce(&mut State) -> T) -> T {
+    let mut guard = STATE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    run(guard.get_or_insert_with(State::default))
+}
+
+fn distribute(total: u16, weights: &[u16]) -> Vec<u16> {
+    let sum = weights
+        .iter()
+        .map(|weight| u32::from(*weight))
+        .sum::<u32>()
+        .max(1);
+    let mut sizes = weights
+        .iter()
+        .map(|weight| u16::try_from(u32::from(total) * u32::from(*weight) / sum).unwrap_or(total))
+        .collect::<Vec<_>>();
+    let used = sizes.iter().sum::<u16>();
+    if let Some(last) = sizes.last_mut() {
+        *last += total.saturating_sub(used);
+    }
+    sizes
+}
+
+fn walk(node: &ModLayout, area: Rect, path: &str, state: &State, out: &mut Placement) {
+    match node {
+        ModLayout::Leaf(leaf) => out.regions.push(Region {
+            content: leaf.content.clone(),
+            area,
+        }),
+        ModLayout::Split(split) => {
+            let count = split.children.len();
+            let weights = state
+                .ratios
+                .get(path)
+                .filter(|ratios| ratios.len() == count)
+                .cloned()
+                .or_else(|| (split.ratio.len() == count).then(|| split.ratio.clone()))
+                .unwrap_or_else(|| vec![1; count]);
+            let (origin, total) = match split.split {
+                ModSplit::Horizontal => (area.x, area.width),
+                ModSplit::Vertical => (area.y, area.height),
+            };
+            let sizes = distribute(total, &weights);
+            let mut starts = Vec::with_capacity(count);
+            let mut cursor = origin;
+            for size in &sizes {
+                starts.push(cursor);
+                cursor = cursor.saturating_add(*size);
+            }
+            for (index, child) in split.children.iter().enumerate() {
+                let rect = match split.split {
+                    ModSplit::Horizontal => {
+                        Rect::new(starts[index], area.y, sizes[index], area.height)
+                    }
+                    ModSplit::Vertical => {
+                        Rect::new(area.x, starts[index], area.width, sizes[index])
+                    }
+                };
+                walk(child, rect, &format!("{path}.{index}"), state, out);
+                if index + 1 < count {
+                    out.handles.push(Handle {
+                        path: path.to_owned(),
+                        index,
+                        split: split.split,
+                        starts: starts.clone(),
+                        sizes: sizes.clone(),
+                        span: match split.split {
+                            ModSplit::Horizontal => (area.y, area.bottom()),
+                            ModSplit::Vertical => (area.x, area.right()),
+                        },
+                    });
+                }
+            }
+        }
+        ModLayout::Tabs(tabs) => {
+            let active = state
+                .active
+                .get(path)
+                .copied()
+                .unwrap_or(tabs.active)
+                .min(tabs.tabs.len().saturating_sub(1));
+            let body = if area.height >= 2 {
+                out.tabs.push(TabBar {
+                    path: path.to_owned(),
+                    area: Rect { height: 1, ..area },
+                    titles: tabs.tabs.iter().map(|tab| tab.title.clone()).collect(),
+                    active,
+                });
+                Rect {
+                    y: area.y + 1,
+                    height: area.height - 1,
+                    ..area
+                }
+            } else {
+                area
+            };
+            if let Some(tab) = tabs.tabs.get(active) {
+                walk(&tab.node, body, &format!("{path}.{active}"), state, out);
+            }
+        }
+    }
+}
+
+pub(crate) fn place(layout: &ModLayout, area: Rect) -> Placement {
+    with(|state| {
+        if state.layout.as_ref() != Some(layout) {
+            *state = State {
+                layout: Some(layout.clone()),
+                ..State::default()
+            };
+        }
+        let mut placement = Placement::default();
+        walk(layout, area, "r", state, &mut placement);
+        state.last = placement.clone();
+        placement
+    })
+}
+
+pub(crate) fn tab_line(bar: &TabBar) -> Vec<(String, bool)> {
+    bar.titles
+        .iter()
+        .enumerate()
+        .map(|(index, title)| (format!(" {title} "), index == bar.active))
+        .collect()
+}
+
+fn tab_at(bar: &TabBar, column: u16) -> Option<usize> {
+    let mut x = bar.area.x;
+    for (index, (title, _)) in tab_line(bar).into_iter().enumerate() {
+        let width = u16::try_from(unicode_width::UnicodeWidthStr::width(title.as_str()))
+            .unwrap_or(u16::MAX);
+        if column >= x && column < x.saturating_add(width) {
+            return Some(index);
+        }
+        x = x.saturating_add(width);
+    }
+    None
+}
+
+fn on_handle(handle: &Handle, column: u16, row: u16) -> bool {
+    let boundary = handle.starts[handle.index + 1];
+    let (along, across) = match handle.split {
+        ModSplit::Horizontal => (row, column),
+        ModSplit::Vertical => (column, row),
+    };
+    along >= handle.span.0 && along < handle.span.1 && across.abs_diff(boundary) <= 1
+}
+
+pub(crate) fn pointer(event: MouseEvent) -> bool {
+    with(|state| match event.kind {
+        MouseEventKind::Down(MouseButton::Left) => {
+            if let Some((path, index)) = state.last.tabs.iter().find_map(|bar| {
+                (event.row == bar.area.y
+                    && event.column >= bar.area.x
+                    && event.column < bar.area.right())
+                .then(|| tab_at(bar, event.column).map(|index| (bar.path.clone(), index)))
+                .flatten()
+            }) {
+                crate::mod_surface::terminal_event(
+                    "component_event",
+                    serde_json::json!({"component": path, "kind": "select", "index": index}),
+                );
+                state.active.insert(path, index);
+                return true;
+            }
+            state.drag = state
+                .last
+                .handles
+                .iter()
+                .find(|handle| on_handle(handle, event.column, event.row))
+                .map(|handle| (handle.path.clone(), handle.index));
+            state.drag.is_some()
+        }
+        MouseEventKind::Drag(MouseButton::Left) => {
+            let Some((path, index)) = state.drag.clone() else {
+                return false;
+            };
+            let Some(handle) = state
+                .last
+                .handles
+                .iter()
+                .find(|handle| handle.path == path && handle.index == index)
+                .cloned()
+            else {
+                return false;
+            };
+            let position = match handle.split {
+                ModSplit::Horizontal => event.column,
+                ModSplit::Vertical => event.row,
+            };
+            let start = handle.starts[index];
+            let end = handle.starts[index + 1] + handle.sizes[index + 1];
+            let boundary = position.clamp(
+                start + MIN_CELLS,
+                end.saturating_sub(MIN_CELLS).max(start + MIN_CELLS),
+            );
+            let mut sizes = handle.sizes;
+            sizes[index] = boundary - start;
+            sizes[index + 1] = end.saturating_sub(boundary);
+            state
+                .ratios
+                .insert(path, sizes.into_iter().map(|size| size.max(1)).collect());
+            true
+        }
+        MouseEventKind::Up(MouseButton::Left) => {
+            let Some((path, _)) = state.drag.take() else {
+                return false;
+            };
+            if let Some(sizes) = state.ratios.get(&path) {
+                let total = sizes
+                    .iter()
+                    .map(|size| u32::from(*size))
+                    .sum::<u32>()
+                    .max(1);
+                let ratio = sizes
+                    .iter()
+                    .map(|size| (u32::from(*size) * 100 / total).clamp(1, 100))
+                    .collect::<Vec<_>>();
+                crate::mod_surface::terminal_event(
+                    "component_event",
+                    serde_json::json!({"component": path, "kind": "resize", "ratio": ratio}),
+                );
+            }
+            true
+        }
+        _ => false,
+    })
+}
+
