+        Box::pin(async move {
+            assert_eq!(
+                (input.call_id, input.text, input.success),
+                ("out-call", "ok", true)
+            );
+            self.replacement.clone()
+        })
+    }
+}
+
+#[tokio::test]
+async fn tool_output_contributor_replaces_model_visible_text_within_limit() {
+    let oversize = "x".repeat(codex_extension_api::tool_output_limit("ok".len()) + 1);
+    for (replacement, expected) in [
+        (Some("short".to_string()), "short"),
+        (Some(oversize), "ok"),
+        (None, "ok"),
+    ] {
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.tool_output_contributor(Arc::new(OutputReplacer { replacement }));
+        session.services.extensions = Arc::new(builder.build());
+        let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
