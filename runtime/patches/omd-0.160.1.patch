+/// A draft edit may change only its text.
+fn composer_edit(edit: &Value, given: &Value) -> bool {
+    edit.as_object()
+        .zip(given.as_object())
+        .is_some_and(|(edit, given)| {
+            edit.len() == given.len()
+                && edit
+                    .iter()
+                    .all(|(key, value)| key == "text" || given.get(key) == Some(value))
+        })
+        && edit["text"]
+            .as_str()
+            .is_some_and(|text| text.len() <= 65_536)
+}
