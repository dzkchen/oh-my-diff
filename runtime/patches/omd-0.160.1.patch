+struct BrokerHistoryWitness;
+
+impl codex_thread_store::HistoryWitness for BrokerHistoryWitness {
+    fn append(&self, stream: &std::path::Path, sha256: &str) -> std::io::Result<()> {
+        codex_omd_extension::anchor_history(stream, sha256)
+    }
+
+    fn verify(&self, stream: &std::path::Path, sha256s: &[String]) -> std::io::Result<()> {
+        codex_omd_extension::verify_history_anchor(stream, sha256s)
+    }
+}
+
+fn history_witness() -> Arc<dyn codex_thread_store::HistoryWitness> {
+    Arc::new(BrokerHistoryWitness)
+}
