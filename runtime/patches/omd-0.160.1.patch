+        "input": [{"type": "message", "role": "user", "content": [{"type": "input_image", "image_url": "data:image/png;base64,AA=="}]}]}))
+    .unwrap();
+    let mut finish = |request_id: &str, usage: Value| {
+        request
+            .headers
+            .insert("x-omd-request-id", request_id.parse().unwrap());
+        let mut attempt = accounts
+            .before_send(&mut request, Some(&body))
+            .unwrap()
+            .unwrap();
+        let mut event = json!({"type": "response.completed", "response": {"usage": usage}});
+        attempt.observe(&mut event, true).unwrap();
+    };
+    finish("req-1", json!({"input_tokens": 10, "output_tokens": 2}));
+    finish(
+        "req-2",
+        json!({"input_tokens": 10, "output_tokens": 2, "cost_microusd": 700}),
+    );
+    let records = task.attempts().unwrap();
+    assert!(records.iter().all(|record| record.provider_billed
+        && record.reserved_microusd == 0
+        && record.model == "served-model"
+        && record.status == "completed"));
+    assert_eq!(
+        records
+            .iter()
+            .map(|record| record.settled_microusd)
+            .collect::<Vec<_>>(),
+        vec![None, Some(700)]
+    );
+    assert_eq!(
+        accounts.settle_provider("req-1", 500, "fixture", |_| false),
+        Err("ledger_settle_not_route_owner".into())
+    );
+    assert_eq!(
+        accounts.settle_provider("req-2", 500, "fixture", |_| true),
+        Err("ledger_request_not_awaiting_settlement".into())
+    );
+    let settled = accounts
+        .settle_provider("req-1", 500, "fixture", |provider| provider == "fixture")
+        .unwrap();
+    assert_eq!(settled["cost"]["basis"], "provider_reported");
+    assert!(
+        accounts
+            .settle_provider("req-1", 500, "fixture", |_| true)
+            .is_err()
+    );
+    let capture: codex_omd::TaskCostCapture = serde_json::from_slice(
+        &std::fs::read(root.path().join("evidence/task-cost.json")).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(capture.settled_task_charge_microusd, 1200);
+    let resumed = Task::open(
+        Limits {
+            requests: 3,
+            exposure_microusd: 20000,
+            seconds: 30,
+            concurrent_workers: 2,
+            max_depth: 2,
+        },
+        root.path().join("evidence"),
+        Some("resume"),
+    )
+    .unwrap();
+    assert_eq!(
+        resumed
+            .attempts()
+            .unwrap()
+            .iter()
+            .map(|record| (record.provider_billed, record.settled_microusd))
+            .collect::<Vec<_>>(),
+        vec![(true, Some(500)), (true, Some(700))]
+    );
+}
+
+#[test]
+fn queued_mod_notices_join_only_the_threads_next_request() {
+    let (_root, accounts, _task, _request, _body) = setup();
+    let body = json!({"model": "fixture-model", "reasoning": {"effort": "high"}, "stream": true,
+        "max_output_tokens": 128, "input": [{"type": "message", "role": "user",
+        "content": [{"type": "input_text", "text": "hi"}]}]});
+    codex_omd::model_request::queue_section("child", "checks", "lint failed").unwrap();
+    let first = prepared(&accounts, "child", &body).unwrap().to_string();
+    assert!(
+        first.contains("Mod-provided context") && first.contains("lint failed"),
+        "{first}"
+    );
+    let next = prepared(&accounts, "child", &body).unwrap().to_string();
+    assert!(!next.contains("lint failed"), "{next}");
+}
diff --git a/codex-rs/ext/omd/src/config.rs b/codex-rs/ext/omd/src/config.rs
new file mode 100644
index 000000000..383e25a92
--- /dev/null
+++ b/codex-rs/ext/omd/src/config.rs
@@ -0,0 +1,249 @@
+use crate::accounting::Rates;
+use codex_omd::Limits;
+use codex_omd::WorkerLimits;
+use codex_protocol::openai_models::ReasoningEffort;
+use serde::Deserialize;
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(crate) const HOST_CONFIG: &str = "host.json";
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Grant {
+    pub path: PathBuf,
+    pub sha256: String,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, serde::Serialize, PartialEq, Eq, PartialOrd, Ord)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum RouteRole {
+    Lead,
+    Worker,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Route {
+    pub name: String,
+    pub provider: String,
+    pub model: String,
+    pub reasoning_effort: ReasoningEffort,
+    pub responses_url: String,
+    pub rates: Rates,
+    #[serde(default)]
+    pub roles: Vec<RouteRole>,
+    #[serde(default)]
+    pub tools: Vec<String>,
+    #[serde(default)]
+    pub mods: Vec<String>,
+    #[serde(default)]
+    pub grant: Option<Grant>,
+    #[serde(default)]
+    pub credential: Option<String>,
+}
+
+#[derive(Clone, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ContractSelectionConfig {
+    #[serde(default)]
+    pub user: Option<PathBuf>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct HostConfig {
+    #[serde(default = "schema")]
+    pub schema: u32,
+    #[serde(default = "agent_limits")]
+    pub limits: Limits,
+    #[serde(default = "worker_limits")]
+    pub worker_limits: WorkerLimits,
+    #[serde(default)]
+    pub routes: Vec<Route>,
+    #[serde(default)]
+    pub services: Vec<crate::mods::services::Grant>,
+    #[serde(default)]
+    pub secret_refs: BTreeMap<String, PathBuf>,
+    #[serde(default)]
+    pub protected: Vec<PathBuf>,
+    #[serde(default)]
+    pub toolchain_reads: Vec<PathBuf>,
+    #[serde(default = "snapshot_bytes")]
+    pub snapshot_bytes: usize,
+    #[serde(default = "max_request_bytes")]
+    pub max_request_bytes: usize,
+    #[serde(default)]
+    pub approved_untracked: Vec<String>,
+    #[serde(default)]
+    pub contract: ContractSelectionConfig,
+    #[serde(default)]
+    pub editor: Vec<String>,
+    #[serde(default)]
+    pub mod_limits: codex_omd::mod_limits::ModLimits,
+}
+
+fn schema() -> u32 {
+    1
+}
+
+fn agent_limits() -> Limits {
+    Limits {
+        requests: 400,
+        exposure_microusd: 0,
+        seconds: 86_400,
+        concurrent_workers: 4,
+        max_depth: 2,
+    }
+}
+
+fn worker_limits() -> WorkerLimits {
+    WorkerLimits {
+        requests: 60,
+        exposure_microusd: 0,
+        seconds: 1_800,
+    }
+}
+
+fn snapshot_bytes() -> usize {
+    8 * 1024 * 1024
+}
+
+fn max_request_bytes() -> usize {
+    1024 * 1024
+}
+
+fn name(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 64
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'_' | b'-')
+        })
+}
+
+impl Default for HostConfig {
+    fn default() -> Self {
+        Self {
+            schema: schema(),
+            limits: agent_limits(),
+            worker_limits: worker_limits(),
+            routes: Vec::new(),
+            services: Vec::new(),
+            secret_refs: BTreeMap::new(),
+            protected: Vec::new(),
+            toolchain_reads: Vec::new(),
+            snapshot_bytes: snapshot_bytes(),
+            max_request_bytes: max_request_bytes(),
+            approved_untracked: Vec::new(),
+            contract: ContractSelectionConfig::default(),
+            editor: Vec::new(),
+            mod_limits: Default::default(),
+        }
+    }
+}
+
+impl HostConfig {
+    pub(crate) fn load(root: &Path, repository: &Path) -> Result<Self, String> {
+        let path = root.join(HOST_CONFIG);
+        let config = match std::fs::symlink_metadata(&path) {
+            Ok(metadata) if metadata.is_file() && metadata.len() <= 262_144 => {
+                serde_json::from_slice::<Self>(&std::fs::read(&path).map_err(|e| e.to_string())?)
+                    .map_err(|error| format!("invalid {}: {error}", path.display()))?
+            }
+            Ok(_) => return Err(format!("{HOST_CONFIG} must be a bounded regular file")),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Self::default(),
+            Err(error) => return Err(error.to_string()),
+        };
+        config.validate(repository)?;
+        Ok(config)
+    }
+
+    pub(crate) fn validate(&self, repository: &Path) -> Result<(), String> {
+        let external = |path: &Path| {
+            path.is_absolute()
+                && path.canonicalize().ok().as_deref() == Some(path)
+                && !path.starts_with(repository)
+        };
+        let mut names = std::collections::BTreeSet::new();
+        if self.schema != 1
+            || self.editor.len() > 16
+            || self
+                .editor
+                .iter()
+                .any(|arg| arg.is_empty() || arg.len() > 1024)
+            || self.routes.len() > 32
+            || self.snapshot_bytes == 0
+            || self.max_request_bytes == 0
+            || self.protected.len() > 32
+            || self.approved_untracked.len() > 256
+            || self.protected.iter().any(|path| !external(path))
+            || self.secret_refs.values().any(|path| !external(path))
+            || self.toolchain_reads.iter().any(|path| !path.is_absolute())
+            || self
+                .contract
+                .user
+                .as_ref()
+                .is_some_and(|path| !path.is_absolute())
+        {
+            return Err(format!("{HOST_CONFIG} limits or paths are invalid"));
+        }
+        for route in &self.routes {
+            if !name(&route.name)
+                || !names.insert(route.name.as_str())
+                || route.roles.is_empty()
+                || route.provider.is_empty()
+                || route.provider.len() > 64
+                || route.model.is_empty()
+                || route.model.len() > 128
+                || route.tools.len() > 16
+                || route.mods.len() > 16
+                || route.mods.iter().any(|id| !name(id))
+                || route
+                    .tools
+                    .iter()
+                    .any(|tool| !crate::mods::read_only_sandbox_tool(tool))
+                || route
+                    .grant
+                    .as_ref()
+                    .is_some_and(|grant| !external(&grant.path) || grant.sha256.len() != 64)
+                || (route.rates.reservation_microusd == 0)
+                    != (route.rates.included_subscription || route.rates.provider_billed)
+                || route.rates.included_subscription && route.rates.provider_billed
+                || route.roles.contains(&RouteRole::Worker) && route.grant.is_none()
+            {
+                return Err(format!("{HOST_CONFIG} route {} is invalid", route.name));
+            }
+        }
+        Ok(())
+    }
+
+    /// The provider-billed service route rates for `provider`, from any grant or only `mod_id`'s.
+    pub(crate) fn billed_rates(&self, provider: &str, mod_id: Option<&str>) -> Option<&Rates> {
+        self.services
+            .iter()
+            .filter(|grant| mod_id.is_none_or(|id| grant.mod_id() == id))
+            .find_map(|grant| grant.billed_rates(provider))
+    }
+
+    pub(crate) fn route(
+        &self,
+        name: &str,
+        role: RouteRole,
+        mod_id: Option<&str>,
+    ) -> Option<&Route> {
+        self.routes.iter().find(|route| {
+            route.name == name
+                && route.roles.contains(&role)
+                && mod_id
+                    .is_none_or(|id| route.mods.is_empty() || route.mods.iter().any(|m| m == id))
+        })
+    }
+
+    pub(crate) fn routes_for(&self, mod_id: &str) -> Vec<&Route> {
+        self.routes
+            .iter()
+            .filter(|route| route.mods.is_empty() || route.mods.iter().any(|m| m == mod_id))
+            .collect()
+    }
+}
diff --git a/codex-rs/ext/omd/src/contract.rs b/codex-rs/ext/omd/src/contract.rs
new file mode 100644
index 000000000..cd27753e8
--- /dev/null
+++ b/codex-rs/ext/omd/src/contract.rs
@@ -0,0 +1,946 @@
+use super::*;
+use codex_omd::ContractDocument;
+use codex_omd::Gate;
+use codex_omd::Receipt;
+use std::collections::BTreeSet;
+
+const RECEIPT_LIMIT: usize = 256;
+pub(crate) const STATE_BYTES: usize = 1024 * 1024;
+
+#[derive(Clone, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+struct Restriction {
+    operation: String,
+    when: std::collections::BTreeMap<String, Value>,
+}
+
+impl Restriction {
+    fn valid(&self) -> bool {
+        codex_omd::MOD_HOST_OPERATIONS.contains(&self.operation.as_str())
+            && !self.when.is_empty()
+            && self.when.len() <= 8
+            && self.when.iter().all(|(path, value)| {
+                path.starts_with('/')
+                    && path.len() <= 128
+                    && !value.is_array()
+                    && !value.is_object()
+                    && value.as_str().is_none_or(|value| value.len() <= 256)
+            })
+    }
+
+    fn matches(&self, operation: &str, arguments: &Value) -> bool {
+        self.operation == operation
+            && self
+                .when
+                .iter()
+                .all(|(path, value)| arguments.pointer(path) == Some(value))
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum ContractStatus {
+    None,
+    Active,
+    #[default]
+    Unavailable,
+}
+
+pub(crate) enum GateOutcome {
+    Missing(Vec<codex_omd::ContractRequirement>),
+    Unresolved(Vec<String>),
+}
+
+impl GateOutcome {
+    pub(crate) fn event(&self, gate: Gate, candidate_sha256: &str) -> Value {
+        match self {
+            Self::Missing(missing) => json!({"gate": gate,
+                "outcome": if missing.is_empty() {"passed"} else {"refused"},
+                "missing": missing, "candidate_sha256": candidate_sha256}),
+            Self::Unresolved(outstanding) => json!({"gate": gate, "outcome": "refused",
+                "reason": "unresolved_blocking_findings", "outstanding_findings": outstanding,
+                "candidate_sha256": candidate_sha256}),
+        }
+    }
+
+    pub(crate) fn refusal(&self) -> Option<Value> {
+        match self {
+            Self::Missing(missing) if missing.is_empty() => None,
+            Self::Missing(missing) => Some(json!({"status": "refused", "missing": missing})),
+            Self::Unresolved(outstanding) => Some(json!({"status": "refused",
+                "reason": "unresolved_blocking_findings", "outstanding_findings": outstanding})),
+        }
+    }
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct SessionContract {
+    active: Option<ContractDocument>,
+    status: ContractStatus,
+    provenance: Value,
+    restrictions: BTreeSet<String>,
+    scoped_restrictions: Vec<Restriction>,
+    receipts: Vec<Receipt>,
+    finding_ledger: codex_omd::FindingLedger,
+}
+
+impl SessionContract {
+    pub(crate) fn invalidate(&mut self, error: String) {
+        self.status = ContractStatus::Unavailable;
+        self.provenance["error"] = json!(error);
+    }
+
+    pub(crate) fn revalidate(
+        &mut self,
+        documents: &[(ContractDocument, codex_omd::PolicyOwner)],
+    ) -> bool {
+        let Some(active) = &self.active else {
+            return false;
+        };
+        let registered = documents
+            .iter()
+            .any(|(document, _)| document.digest() == active.digest());
+        match (self.status, registered) {
+            (ContractStatus::Active, false) => {
+                self.invalidate("contract_withdrawn".into());
+                true
+            }
+            (ContractStatus::Unavailable, true)
+                if self.provenance["error"] == "contract_withdrawn" =>
+            {
+                self.status = ContractStatus::Active;
+                if let Some(provenance) = self.provenance.as_object_mut() {
+                    provenance.remove("error");
+                }
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub(crate) fn restore(&mut self, path: &std::path::Path) -> Result<(), String> {
+        use std::io::Read;
+        use std::os::unix::fs::MetadataExt;
+        let anchor = codex_omd::broker::anchored(path).map_err(|error| error.to_string())?;
+        let metadata = match std::fs::symlink_metadata(path) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return match anchor {
+                    Some(anchor) if anchor.count > 0 => {
+                        Err("contract_state_anchor_mismatch".into())
+                    }
+                    _ => Ok(()),
+                };
+            }
+            Err(error) => return Err(error.to_string()),
+        };
+        if !metadata.is_file() || metadata.nlink() != 1 || metadata.len() > STATE_BYTES as u64 {
+            return Err("contract_state_file_invalid".into());
+        }
+        let file = std::fs::File::open(path).map_err(|error| error.to_string())?;
+        let opened = file.metadata().map_err(|error| error.to_string())?;
+        if opened.dev() != metadata.dev() || opened.ino() != metadata.ino() {
+            return Err("contract_state_file_changed".into());
+        }
+        let mut bytes = Vec::new();
+        file.take(STATE_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|error| error.to_string())?;
+        if bytes.len() > STATE_BYTES {
+            return Err("contract_state_byte_limit".into());
+        }
+        let digest = codex_omd::broker::sha256(&bytes);
+        match anchor {
+            Some(anchor) if anchor.count == 0 => {
+                codex_omd::broker::seed(path, 1, &codex_omd::broker::chain("", &digest), &digest)
+                    .map_err(|error| error.to_string())?;
+            }
+            Some(anchor) if anchor.last != Some(digest) => {
+                return Err("contract_state_anchor_mismatch".into());
+            }
+            _ => {}
+        }
+        self.restore_value(serde_json::from_slice(&bytes).map_err(|error| error.to_string())?)
+    }
+
+    fn restore_value(&mut self, value: Value) -> Result<(), String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Saved {
+            status: ContractStatus,
+            active: Option<ContractDocument>,
+            provenance: Value,
+            restrictions: BTreeSet<String>,
+            #[serde(default)]
+            scoped_restrictions: Vec<Restriction>,
+            receipts: Vec<Receipt>,
+            finding_ledger: codex_omd::FindingLedger,
+        }
+        let saved: Saved = serde_json::from_value(value).map_err(|error| error.to_string())?;
+        if saved.status == ContractStatus::Unavailable
+            || saved.status != self.status
+            || saved.active.as_ref().map(ContractDocument::digest)
+                != self.active.as_ref().map(ContractDocument::digest)
+            || saved.provenance.get("owner") != self.provenance.get("owner")
+            || saved.receipts.len() > RECEIPT_LIMIT
+            || saved
+                .restrictions
+                .iter()
+                .any(|operation| !codex_omd::MOD_HOST_OPERATIONS.contains(&operation.as_str()))
+            || !self.restrictions.is_subset(&saved.restrictions)
+            || saved.scoped_restrictions.len() > 64
+            || saved.scoped_restrictions.iter().any(|rule| !rule.valid())
+            || self
+                .scoped_restrictions
+                .iter()
+                .any(|rule| !saved.scoped_restrictions.contains(rule))
+        {
+            return Err("contract_state_selection_changed_or_invalid".into());
+        }
+        for receipt in &saved.receipts {
+            receipt.validate()?;
+        }
+        let replayed = codex_omd::replay_finding_receipts(&saved.receipts)?;
+        if replayed != saved.finding_ledger {
+            return Err("contract_finding_ledger_mismatch".into());
+        }
+        self.restrictions = saved.restrictions;
+        self.scoped_restrictions = saved.scoped_restrictions;
+        self.receipts = saved.receipts;
+        self.finding_ledger = replayed;
+        Ok(())
+    }
+    pub(crate) fn resolve(
+        host: &Host,
+        documents: &[(ContractDocument, codex_omd::PolicyOwner)],
+    ) -> Self {
+        let user_path = host
+            .config
+            .contract
+            .user
+            .clone()
+            .unwrap_or_else(|| host.root.join(codex_omd::USER_CONTRACT_SELECTION));
+        let selections = codex_omd::ContractSelection::read(&user_path).and_then(|user| {
+            codex_omd::ContractSelection::read(
+                &host.repository.join(codex_omd::PROJECT_CONTRACT_SELECTION),
+            )
+            .map(|project| (user, project))
+        });
+        let (user, project) = match selections {
+            Ok(selections) => selections,
+            Err(error) => {
+                return Self {
+                    status: ContractStatus::Unavailable,
+                    provenance: json!({"error": error}),
+                    ..Self::default()
+                };
+            }
+        };
+        match codex_omd::resolve_contract(documents, user.as_ref(), project.as_ref()) {
+            codex_omd::ContractResolution::None => Self {
+                status: ContractStatus::None,
+                ..Self::default()
+            },
+            codex_omd::ContractResolution::Active {
+                document,
+                owner,
+                source,
+                overrode,
+            } => {
+                let mut contract = Self::activate(document, owner, source);
+                if let Some(overrode) = overrode {
+                    contract.provenance["overrode"] = json!(overrode);
+                }
+                contract
+            }
+            codex_omd::ContractResolution::Unavailable(error) => Self {
+                status: ContractStatus::Unavailable,
+                provenance: json!({"error": error}),
+                ..Self::default()
+            },
+        }
+    }
+
+    fn activate(document: ContractDocument, owner: codex_omd::PolicyOwner, source: &str) -> Self {
+        Self {
+            restrictions: document.restrict.iter().cloned().collect(),
+            scoped_restrictions: Vec::new(),
+            provenance: json!({"source": source, "owner": owner, "digest": document.digest()}),
+            status: ContractStatus::Active,
+            active: Some(document),
+            receipts: Vec::new(),
+            finding_ledger: codex_omd::FindingLedger::new(),
+        }
+    }
+
+    pub(crate) fn restricted(&self, operation: &str, arguments: &Value) -> Result<(), String> {
+        if self.status == ContractStatus::Unavailable {
+            return Err("contract_unavailable".into());
+        }
+        if self.restrictions.contains(operation)
+            || self
+                .scoped_restrictions
+                .iter()
+                .any(|rule| rule.matches(operation, arguments))
+        {
+            return Err(format!("contract_restricted_operation: {operation}"));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn status(&self) -> Value {
+        json!({"status": self.status, "active": self.active, "provenance": self.provenance,
+            "receipts": self.receipts, "finding_ledger": self.finding_ledger,
+            "restrictions": self.restrictions, "scoped_restrictions": self.scoped_restrictions})
+    }
+
+    pub(crate) fn restrict(&mut self, arguments: Value) -> Result<Value, String> {
+        if self.status == ContractStatus::Unavailable {
+            return Err("contract_unavailable".into());
+        }
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Input {
+            #[serde(default)]
+            operations: Vec<String>,
+            #[serde(default)]
+            scoped: Vec<Restriction>,
+            reason: String,
+        }
+        let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+        if input.operations.is_empty() && input.scoped.is_empty()
+            || input.operations.len() > 16
+            || input.scoped.iter().any(|rule| !rule.valid())
+            || input.scoped.len() + self.scoped_restrictions.len() > 64
+            || input.reason.is_empty()
+            || input.reason.len() > 512
+            || input
+                .operations
+                .iter()
+                .any(|operation| !codex_omd::MOD_HOST_OPERATIONS.contains(&operation.as_str()))
+        {
+            return Err("contract_restriction_invalid".into());
+        }
+        self.restrictions.extend(input.operations);
+        for rule in input.scoped {
+            if !self.scoped_restrictions.contains(&rule) {
+                self.scoped_restrictions.push(rule);
+            }
+        }
+        Ok(
+            json!({"restrictions": self.restrictions, "scoped_restrictions": self.scoped_restrictions}),
+        )
+    }
+
+    pub(crate) fn admit(&self, receipt: &Receipt) -> Result<(), String> {
+        self.clone().submit(receipt.clone()).map(|_| ())
+    }
+
+    pub(crate) fn submit(&mut self, receipt: Receipt) -> Result<Value, String> {
+        if self.status == ContractStatus::Unavailable {
+            return Err("contract_unavailable".into());
+        }
+        receipt.validate()?;
+        if self.receipts.len() >= RECEIPT_LIMIT {
+            return Err("receipt_limit".into());
+        }
+        let mut finding_ledger = self.finding_ledger.clone();
+        codex_omd::apply_finding_receipt(&mut finding_ledger, &receipt, self.receipts.len())?;
+        self.receipts.push(receipt.clone());
+        let prior_ledger = std::mem::replace(&mut self.finding_ledger, finding_ledger);
+        if serde_json::to_vec(&self.status())
+            .map_err(|error| error.to_string())?
+            .len()
+            > STATE_BYTES
+        {
+            self.receipts.pop();
+            self.finding_ledger = prior_ledger;
+            return Err("contract_state_byte_limit".into());
+        }
+        serde_json::to_value(receipt).map_err(|error| error.to_string())
+    }
+
+    pub(crate) fn gate(
+        &self,
+        gate: Gate,
+        candidate_sha256: &str,
+        acceptance_sha256: Option<&str>,
+    ) -> Result<GateOutcome, String> {
+        match (self.status, &self.active) {
+            (ContractStatus::None, _) => Ok(GateOutcome::Missing(Vec::new())),
+            (ContractStatus::Active, Some(document)) => {
+                let outstanding = if gate == Gate::Complete {
+                    self.outstanding_findings()
+                } else {
+                    Vec::new()
+                };
+                if !outstanding.is_empty() {
+                    return Ok(GateOutcome::Unresolved(outstanding));
+                }
+                Ok(GateOutcome::Missing(document.missing(
+                    gate,
+                    &self.receipts,
+                    candidate_sha256,
+                    acceptance_sha256,
+                )))
+            }
+            _ => Err(
+                "selected contract is unavailable; completion and integration fail closed".into(),
+            ),
+        }
+    }
+
+    pub(crate) fn outstanding_findings(&self) -> Vec<String> {
+        self.finding_ledger
+            .iter()
+            .filter(|(_, entry)| entry.resolution.is_none())
+            .map(|(fingerprint, _)| fingerprint.clone())
+            .collect()
+    }
+
+    pub(crate) fn resolution_context(
+        &self,
+        candidate_sha256: &str,
+        acceptance_sha256: &str,
+        fingerprints: &[String],
+    ) -> Result<Vec<codex_omd::FindingLedgerEntry>, String> {
+        if self.status != ContractStatus::Active || self.active.is_none() {
+            return Err("finding_resolution_contract_inactive".into());
+        }
+        if fingerprints.is_empty()
+            || fingerprints.len() > 32
+            || fingerprints.iter().collect::<BTreeSet<_>>().len() != fingerprints.len()
+        {
+            return Err("finding_resolution_context_invalid".into());
+        }
+        fingerprints
+            .iter()
+            .map(|fingerprint| {
+                let entry = self
+                    .finding_ledger
+                    .get(fingerprint)
+                    .ok_or("finding_resolution_unknown")?;
+                if entry.resolution.is_some() {
+                    return Err("finding_already_resolved".into());
+                }
+                if entry.reported_candidate_sha256 == candidate_sha256 {
+                    return Err("finding_resolution_candidate_unchanged".into());
+                }
+                if entry.acceptance_sha256 != acceptance_sha256 {
+                    return Err("finding_resolution_acceptance_changed".into());
+                }
+                Ok(entry.clone())
+            })
+            .collect()
+    }
+}
+
+pub(crate) fn current_candidate(host: &Host) -> Result<String, String> {
+    let approved = host.config.approved_untracked.iter().cloned().collect();
+    codex_omd::capture_tracked(&host.repository, &approved, host.config.snapshot_bytes)
+        .and_then(|snapshot| snapshot.hash())
+        .map_err(|error| error.to_string())
+}
