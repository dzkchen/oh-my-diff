+pub(crate) fn owned_chat_area(screen: Rect, snapshot: &ModViewSnapshot, header: u16) -> Rect {
+    placement(screen, snapshot)
+        .and_then(|placement| placement.chat())
+        .unwrap_or_else(|| chat_area(screen, snapshot, header))
+}
