+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "requires installed Python, Bun, and local loopback"]
+async fn code_mode_python_csv_to_bun_chart_stays_in_one_cell() -> Result<()> {
+    let directory = tempdir()?;
+    let csv = directory.path().join("sample.csv");
+    std::fs::write(&csv, "month,total\nJan,2\nFeb,4\nMar,3\n")?;
+    let python = format!(
+        "import csv, io, json\nr = tool('exec_command', {{'cmd': 'head -n 50 {}', 'max_output_tokens': 2000}})\nassert r['exit_code'] == 0\nvalues = [int(row['total']) for row in csv.DictReader(io.StringIO(r['output']))]\nprint(json.dumps(values))",
+        csv.display()
+    );
+    let code = r#"
+const python = await tools.kernel({ kernel: "python", code: __PYTHON_CODE__ });
+if (!python.ok) throw new Error(python.error);
+const values = JSON.parse(python.output);
+const bun = await tools.kernel({ kernel: "bun", code: `globalThis.values=${JSON.stringify(values)}; console.log('<svg>' + values.map(v => '<rect height="' + (v * 10) + '"/>').join('') + '</svg>')` });
+text(JSON.stringify({ python, bun }));
+"#
+    .replace("__PYTHON_CODE__", &serde_json::to_string(&python)?);
+    let server = responses::start_mock_server().await;
+    let (_test, second_mock) = run_code_mode_turn_with_config(
+        &server,
+        "read a bounded CSV in Python and chart it in Bun",
+        &code,
+        |config| {
+            let drivers =
+                std::path::PathBuf::from(std::env::var_os("CODEX_KERNEL_TEST_DRIVERS").expect(
+                    "set CODEX_KERNEL_TEST_DRIVERS to a directory with python.py and bun.mjs",
+                ));
+            config.code_mode.kernels = [
+                ("python", vec!["python3", "-u", "-c"], "python.py"),
+                ("bun", vec!["bun", "-e"], "bun.mjs"),
+            ]
+            .into_iter()
+            .map(|(name, command, file)| {
+                let driver = drivers.join(file);
+                let digest = format!(
+                    "{:x}",
+                    <sha2::Sha256 as sha2::Digest>::digest(std::fs::read(&driver).unwrap())
+                );
+                codex_features::CodeModeKernelToml {
+                    name: name.into(),
+                    command: command.into_iter().map(str::to_owned).collect(),
+                    driver,
+                    driver_sha256: digest,
+                }
+            })
+            .collect();
+            config.features.enable(Feature::CodeModeHost).unwrap();
+            config.code_mode.disable_in_process_fallback = true;
+            config
+                .set_legacy_sandbox_policy(
+                    codex_protocol::protocol::SandboxPolicy::WorkspaceWrite {
+                        writable_roots: Vec::new(),
+                        network_access: false,
+                        exclude_tmpdir_env_var: false,
+                        exclude_slash_tmp: false,
+                    },
+                )
+                .unwrap();
+        },
+    )
+    .await?;
+    let items = custom_tool_output_items(&second_mock.single_request(), "call-1");
+    let result: Value = serde_json::from_str(text_item(&items, 1))?;
+    assert_eq!(result["python"]["output"], "[2, 4, 3]\n");
+    assert_eq!(result["bun"]["ok"], true);
+    assert_eq!(
+        result["bun"]["output"]
+            .as_str()
+            .unwrap()
+            .matches("<rect")
+            .count(),
+        3
+    );
+
+    Ok(())
+}
