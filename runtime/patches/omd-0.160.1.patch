+
+pub(crate) fn command_host_guarded(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+    scope: &CallScope<'_>,
+) -> std::io::Result<Value> {
+    if !codex_omd::host::served(&call.operation) {
+        return Err(std::io::Error::other(format!(
+            "unsupported_host_operation: {}",
+            call.operation
+        )));
+    }
+    let grants = grants.ok_or_else(|| std::io::Error::other("host_caller_inactive"))?;
+    let mut protected = paths.protected.clone();
+    protected.push(paths.evidence.clone());
+    let data_root = paths
+        .store
+        .clone()
+        .ok_or_else(|| std::io::Error::other("mod store is not configured"))?;
+    let authority = CommandAuthority {
+        repository: &paths.repository,
+        protected: &protected,
+        policy,
+    };
+    codex_omd::host::Host {
+        authority: &authority,
+        data_root: &data_root,
+        active: scope.active,
+        record_changes: true,
+    }
+    .call(
+        &codex_omd::host::Caller {
+            id: caller,
+            source_sha256: &grants.source_sha256,
+            capabilities: &grants.capabilities,
+            exec_environment: &grants.exec_environment,
+            os_access: grants.os_access.as_ref(),
+            fs_access: grants.fs_access.as_ref(),
+            origin: match scope.context {
+                codex_omd::app_routes::InvocationContext::User => {
+                    codex_omd::data_store::Origin::UserCommand
+                }
+                codex_omd::app_routes::InvocationContext::Event => {
+                    codex_omd::data_store::Origin::Event
+                }
+            },
+            thread: scope.thread,
+        },
+        &call.operation,
+        call.arguments,
+    )
+    .map_err(std::io::Error::other)
+}
+
+fn preview(
+    runtime: &mut ModHost,
+    paths: &crate::omd::ModPaths,
+    context: &ModContext,
+) -> Option<ModViewSnapshot> {
+    let mut snapshot = ModViewSnapshot::read(&paths.evidence.join("mod-view.json")).ok()?;
+    snapshot.rendered_ms = ModViewSnapshot::clock();
+    reload(runtime);
+    let terminal = runtime.terminal_view(snapshot.input.clone(), || true);
+    snapshot.revision = snapshot.revision.saturating_add(1);
+    snapshot.view = terminal.view;
+    snapshot.conflicts = terminal.conflicts;
+    snapshot.contributors = terminal.contributors;
+    snapshot.component_owners = terminal.component_owners;
+    snapshot.diagnostics.extend(terminal.diagnostics);
+    snapshot.diagnostics.truncate(16);
+    snapshot.input["ledger"] = serde_json::json!({
+        "thread_id": context.thread_id.map(|id| id.to_string()),
+        "cwd": context.repository,
+    });
+    Some(snapshot)
+}
+
+fn shared_host(store: std::path::PathBuf) -> Result<Arc<Mutex<ModHost>>, String> {
+    let mut host = HOST
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if host.is_none() {
+        let paths = crate::omd::mod_paths().ok_or("mods are off in this directory")?;
+        let runtime =
+            ModHost::open_in(store, |_| Ok(()), &paths.repository).map_err(|e| e.to_string())?;
+        *host = Some(Arc::new(Mutex::new(runtime)));
+    }
+    host.clone()
+        .ok_or_else(|| "mod runtime unavailable".to_owned())
+}
