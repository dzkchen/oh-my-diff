+#[test]
+fn input_batches_keep_order_per_component_and_report_drops() {
+    let key = |text: &str| json!({"key": null, "text": text});
+    let mut pending = vec![
+        ("a".to_owned(), key("1")),
+        ("a".to_owned(), key("2")),
+        ("b".to_owned(), json!({"paste": "x"})),
+        ("a".to_owned(), key("3")),
+    ];
+    pending.extend((0..70).map(|_| ("a".to_owned(), key("k"))));
+    let batches = input_batches(pending, 5);
+    assert_eq!(
+        batches[0],
+        json!({"component": "a", "kind": "input", "events": [key("1"), key("2")], "dropped": 5})
+    );
+    assert_eq!(
+        batches[1],
+        json!({"component": "b", "kind": "input", "events": [{"paste": "x"}]})
+    );
+    assert_eq!(batches[2]["events"].as_array().map(Vec::len), Some(64));
+    assert_eq!(batches[2]["events"][0], key("3"));
+    assert_eq!(batches[3]["events"].as_array().map(Vec::len), Some(7));
