+    for source in [&provider, &consumer] {
+        let path = source.join("mod.json");
+        let mut manifest: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+        manifest["api"] = json!(MOD_API_VERSION);
