+    for index in 1..130 {
+        run(index);
+    }
+    let owner = std::fs::read_dir(data.join("exec-output"))
+        .unwrap()
+        .next()
+        .unwrap()
+        .unwrap()
+        .path()
+        .join("spanning");
+    let stored = std::fs::read_dir(&owner)
+        .unwrap()
+        .filter_map(Result::ok)
+        .filter(|entry| entry.path().is_dir())
+        .count();
+    assert_eq!(stored, 128);
+    assert!(!owner.join("thread-0").exists());
+}
