+++ b/codex-rs/thread-store/src/local/rewrite_thread.rs
@@ -0,0 +1,1126 @@
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use codex_protocol::items::TurnItem;
+use codex_protocol::user_input::UserInput;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::ResponseItemId;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ItemCompletedEvent;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::CodexHarnessMetadata;
+use codex_rollout::HistoryRewriteProvenance;
+use codex_rollout::ResponseItemEnvelope;
+use codex_rollout::RolloutItem;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+
+use super::LocalThreadStore;
+use super::revert_thread::create_replacement_recorder;
+use super::revert_thread::thread_store_io_error;
+use super::thread_rollout_resolver;
+use crate::HistoryRow;
+use crate::HistoryRowAccess;
+use crate::HistoryRowEdit;
+use crate::HistoryWitness;
+use crate::RewriteThreadParams;
+use crate::ThreadRewrite;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+const MAX_EDITS: usize = 256;
+const REVISIONS_SUBDIR: &str = "history_revisions";
+const PASSTHROUGH: &str = "internal_chat_message_metadata_passthrough";
+const EDITABLE: &[&str] = &[
+    "message",
+    "function_call",
+    "function_call_output",
+    "custom_tool_call",
+    "custom_tool_call_output",
+    "local_shell_call",
+    "tool_search_call",
+    "tool_search_output",
+];
+const DELETABLE: &[&str] = &[
+    "reasoning",
+    "web_search_call",
+    "image_generation_call",
+    "agent_message",
+];
+
+struct Entry {
+    item: RolloutItem,
+    source: Option<u64>,
+}
+
+struct Row {
+    id: String,
+    alias: Option<String>,
+    turn_id: Option<String>,
+    kind: String,
+    entries: Vec<usize>,
+    access: HistoryRowAccess,
+    model: Option<HistoryRowAccess>,
+    frozen: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+struct Segment {
+    rollout_id: ThreadId,
+    path: PathBuf,
+    end_ordinal_exclusive: Option<u64>,
+    lines: u64,
+    sha256: String,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum Record {
+    Begin {
+        revision: ThreadId,
+        previous: ThreadId,
+        undo: bool,
+        author: String,
+        at_ms: i64,
+        sources: Vec<Segment>,
+        written: u64,
+        source_forked_from_ordinal_exclusive: Option<u64>,
+        source_subagent_history_start_ordinal: Option<u64>,
+        edits: Vec<HistoryRowEdit>,
+    },
+    Commit {
+        revision: ThreadId,
+    },
+    Abort {
+        revision: ThreadId,
+    },
+}
+
+struct Edit<'a> {
+    thread_id: ThreadId,
+    revision: String,
+    author: &'a str,
+}
+
+pub(super) async fn rewrite(
+    store: &LocalThreadStore,
+    params: RewriteThreadParams,
+) -> ThreadStoreResult<ThreadRewrite> {
+    let RewriteThreadParams {
+        thread_id,
+        expected_revision,
+        edits,
+        undo,
+        author,
+        multi_agent_version,
+        witness,
+    } = params;
+    let Some(expected_revision) = expected_revision else {
+        let (rollout_id, _, entries, _) = load_current(store, thread_id).await?;
+        return Ok(ThreadRewrite {
+            revision: revision(rollout_id, &entries),
+            previous_revision: None,
+            rows: public_rows(&entries),
+        });
+    };
+    if edits.is_empty() != undo || edits.len() > MAX_EDITS {
+        return Err(invalid(format!(
+            "history_rewrite_invalid: pass 1 to {MAX_EDITS} edits or undo"
+        )));
+    }
+    let state_db = store
+        .state_db()
+        .await
+        .ok_or(ThreadStoreError::Unsupported {
+            operation: "rewrite_thread",
+        })?;
+    let _lifecycle_guard = store.live_writer_locks.lock_lifecycle(thread_id).await;
+    let _live_writer_guard = store.live_writer_locks.lock(thread_id).await;
+    store.ensure_live_recorder_absent(thread_id).await?;
+    let writer_lock = store.acquire_writer_lock(thread_id)?;
+    let log = log_path(store, thread_id);
+    let records = recover(store, thread_id, &log, witness.as_deref(), true).await?;
+
+    let expected_sqlite_path = state_db
+        .get_thread(thread_id)
+        .await
+        .map_err(|err| internal(format!("failed to read thread metadata for {thread_id}: {err}")))?
+        .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?
+        .rollout_path;
+    let (rollout_id, mut source_meta, entries, sources) = load_current(store, thread_id).await?;
+    let previous_revision = revision(rollout_id, &entries);
+    if previous_revision != expected_revision {
+        return Err(ThreadStoreError::Conflict {
+            message: format!(
+                "history_revision_conflict: thread {thread_id} is at revision {previous_revision}"
+            ),
+        });
+    }
+    let source_forked = codex_rollout::forked_from_ordinal_exclusive(
+        &source_meta,
+        sources.last().map(|source| source.path.as_path()),
+    );
+    let source_subagent = source_meta.subagent_history_start_ordinal;
+    let new_rollout_id = ThreadId::new();
+    let edit = Edit {
+        thread_id,
+        revision: new_rollout_id.to_string(),
+        author: &author,
+    };
+    let (entries, forked, subagent) = if undo {
+        let Some(Record::Begin {
+            sources: restored_sources,
+            written,
+            source_forked_from_ordinal_exclusive,
+            source_subagent_history_start_ordinal,
+            ..
+        }) = records.iter().rev().find(|record| {
+            matches!(record, Record::Begin { revision, .. } if *revision == rollout_id)
+        })
+        else {
+            return Err(invalid(format!(
+                "history_undo_unavailable: thread {thread_id} has no revision to undo"
+            )));
+        };
+        let (mut restored, _) = load_segments(store, restored_sources).await?;
+        let appended = entries.into_iter().skip(*written as usize);
+        restored.extend(appended.map(|entry| Entry {
+            item: entry.item,
+            source: None,
+        }));
+        let forked = map_cutoff(&restored, *source_forked_from_ordinal_exclusive);
+        let subagent = map_cutoff(&restored, *source_subagent_history_start_ordinal);
+        (restored, forked, subagent)
+    } else {
+        let mut entries = entries;
+        for change in &edits {
+            apply(&mut entries, change, &edit)?;
+        }
+        let forked = map_cutoff(&entries, source_forked);
+        let subagent = map_cutoff(&entries, source_subagent);
+        (entries, forked, subagent)
+    };
+
+    append_record(
+        &log,
+        witness.as_deref(),
+        &Record::Begin {
+            revision: new_rollout_id,
+            previous: rollout_id,
+            undo,
+            author: author.clone(),
+            at_ms: chrono::Utc::now().timestamp_millis(),
+            sources,
+            written: entries.len() as u64,
+            source_forked_from_ordinal_exclusive: source_forked,
+            source_subagent_history_start_ordinal: source_subagent,
+            edits,
+        },
+    )?;
+    source_meta.multi_agent_version = multi_agent_version.or(source_meta.multi_agent_version);
+    source_meta.subagent_history_start_ordinal = subagent;
+    let items: Vec<RolloutItem> = entries.iter().map(|entry| entry.item.clone()).collect();
+    let written = async {
+        let recorder = create_replacement_recorder(
+            store,
+            source_meta,
+            new_rollout_id,
+            None,
+            forked,
+            Arc::clone(&writer_lock),
+        )
+        .await?;
+        let path = recorder.rollout_path().to_path_buf();
+        recorder
+            .record_canonical_items(&items)
+            .await
+            .map_err(thread_store_io_error)?;
+        recorder.persist().await.map_err(thread_store_io_error)?;
+        recorder.shutdown().await.map_err(thread_store_io_error)?;
+        super::thread_history_materialization::materialize_to_sqlite(
+            store,
+            new_rollout_id,
+            path.as_path(),
+        )
+        .await?;
+        let replaced = state_db
+            .replace_rollout_path_if_current(
+                thread_id,
+                expected_sqlite_path.as_path(),
+                path.as_path(),
+            )
+            .await
+            .map_err(|err| {
+                internal(format!("failed to switch thread {thread_id} to rewritten rollout: {err}"))
+            })?;
+        if !replaced {
+            return Err(ThreadStoreError::Conflict {
+                message: format!("thread {thread_id} changed while it was being rewritten"),
+            });
+        }
+        Ok(())
+    }
+    .await;
+    if let Err(err) = written {
+        // A failed abort stays a pending record, which the next access resolves.
+        let _ = abort(store, &log, witness.as_deref(), new_rollout_id).await;
+        return Err(err);
+    }
+    append_record(
+        &log,
+        witness.as_deref(),
+        &Record::Commit {
+            revision: new_rollout_id,
+        },
+    )?;
+    Ok(ThreadRewrite {
+        revision: revision(new_rollout_id, &entries),
+        previous_revision: Some(previous_revision),
+        rows: public_rows(&entries),
+    })
+}
+
+pub(super) async fn verify(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    witness: Option<Arc<dyn HistoryWitness>>,
+) -> ThreadStoreResult<()> {
+    let log = log_path(store, thread_id);
+    if !log.exists() && witness.is_none() {
+        return Ok(());
+    }
+    let _lifecycle_guard = store.live_writer_locks.lock_lifecycle(thread_id).await;
+    // A rewrite in another process holds the writer lock until its commit record is written.
+    let writer_lock = store.acquire_writer_lock(thread_id).ok();
+    recover(store, thread_id, &log, witness.as_deref(), writer_lock.is_some())
+        .await
+        .map(drop)
+}
+
+async fn recover(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    log: &Path,
+    witness: Option<&dyn HistoryWitness>,
+    resolve_pending: bool,
+) -> ThreadStoreResult<Vec<Record>> {
+    let (mut records, digests) = read_log(log)?;
+    if let Some(witness) = witness {
+        witness.verify(log, &digests).map_err(|err| {
+            invalid(format!(
+                "history_anchor_mismatch: revision log of thread {thread_id}: {err}"
+            ))
+        })?;
+    }
+    if resolve_pending && let Some(Record::Begin { revision, .. }) = records.last() {
+        let revision = *revision;
+        let current = thread_rollout_resolver::resolve_current(store, thread_id)
+            .await?
+            .map(|current| current.rollout_id);
+        if current == Some(revision) {
+            append_record(log, witness, &Record::Commit { revision })?;
+            records.push(Record::Commit { revision });
+        } else {
+            abort(store, log, witness, revision).await?;
+            records.push(Record::Abort { revision });
+        }
+    }
+    let committed: HashSet<ThreadId> = records
+        .iter()
+        .filter_map(|record| match record {
+            Record::Commit { revision } => Some(*revision),
+            _ => None,
+        })
+        .collect();
+    for record in &records {
+        if let Record::Begin {
+            revision, sources, ..
+        } = record
+            && committed.contains(revision)
+        {
+            load_segments(store, sources).await?;
+        }
+    }
+    Ok(records)
+}
+
+async fn abort(
+    store: &LocalThreadStore,
+    log: &Path,
+    witness: Option<&dyn HistoryWitness>,
+    revision: ThreadId,
+) -> ThreadStoreResult<()> {
+    if let Some(path) =
+        codex_rollout::find_rollout_path_by_rollout_id(store.config.codex_home.as_path(), revision)
+            .await
+            .map_err(thread_store_io_error)?
+    {
+        let _ = tokio::fs::remove_file(path).await;
+    }
+    append_record(log, witness, &Record::Abort { revision })
+}
+
+/// Permanent deletion removes the kept originals with the thread's rollouts, then this log.
+pub(super) fn delete_log(store: &LocalThreadStore, thread_id: ThreadId) -> ThreadStoreResult<()> {
+    match std::fs::remove_file(log_path(store, thread_id)) {
+        Err(err) if err.kind() != std::io::ErrorKind::NotFound => Err(thread_store_io_error(err)),
+        _ => Ok(()),
+    }
+}
+
+async fn load_current(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+) -> ThreadStoreResult<(ThreadId, codex_rollout::SessionMeta, Vec<Entry>, Vec<Segment>)> {
+    let current = thread_rollout_resolver::resolve_current(store, thread_id)
+        .await?
+        .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?;
+    let meta = codex_rollout::read_session_meta_line(current.path.as_path())
+        .await
+        .map_err(|err| {
+            internal(format!(
+                "failed to read current paginated rollout {}: {err}",
+                current.path.display()
+            ))
+        })?
+        .meta;
+    if meta.id != current.thread_id {
+        return Err(invalid(format!(
+            "current rollout for {thread_id} belongs to another thread"
+        )));
+    }
+    if meta.history_mode != ThreadHistoryMode::Paginated {
+        return Err(invalid(format!(
+            "thread {thread_id} does not use paginated history"
+        )));
+    }
+    let lineage = store.resolve_rollout_lineage(thread_id).await?;
+    let segments: Vec<Segment> = lineage
+        .segments
+        .iter()
+        .map(|segment| Segment {
+            rollout_id: segment.rollout_id(),
+            path: segment.rollout_path.clone(),
+            end_ordinal_exclusive: segment.end.map(|end| end.end_ordinal_exclusive),
+            lines: 0,
+            sha256: String::new(),
+        })
+        .collect();
+    let (entries, segments) = read_segments(store, segments).await?;
+    Ok((current.rollout_id, meta, entries, segments))
+}
+
+/// Reads recorded segments and fails unless each is byte-for-byte the recorded original.
+async fn load_segments(
+    store: &LocalThreadStore,
+    recorded: &[Segment],
+) -> ThreadStoreResult<(Vec<Entry>, Vec<Segment>)> {
+    let (entries, segments) = read_segments(store, recorded.to_vec()).await?;
+    for (read, recorded) in segments.iter().zip(recorded) {
+        if read.lines != recorded.lines || read.sha256 != recorded.sha256 {
+            return Err(invalid(format!(
+                "history_original_mismatch: rollout {} changed since it was replaced",
+                recorded.rollout_id
+            )));
+        }
+    }
+    Ok((entries, segments))
+}
+
+async fn read_segments(
+    store: &LocalThreadStore,
+    segments: Vec<Segment>,
+) -> ThreadStoreResult<(Vec<Entry>, Vec<Segment>)> {
+    let mut entries = Vec::new();
+    let mut read = Vec::with_capacity(segments.len());
+    for mut segment in segments {
+        let path = match codex_rollout::existing_rollout_path(segment.path.as_path()).await {
+            Some(path) => path,
+            None => codex_rollout::find_rollout_path_by_rollout_id(
+                store.config.codex_home.as_path(),
+                segment.rollout_id,
+            )
+            .await
+            .map_err(thread_store_io_error)?
+            .ok_or_else(|| {
+                invalid(format!(
+                    "history_original_mismatch: rollout {} is missing",
+                    segment.rollout_id
+                ))
+            })?,
+        };
+        let mut reader = codex_rollout::open_rollout_line_reader(path.as_path())
+            .await
+            .map_err(thread_store_io_error)?;
+        let mut hasher = Sha256::new();
+        segment.lines = 0;
+        while let Some(line) = reader.next_line().await.map_err(thread_store_io_error)? {
+            if line.trim().is_empty() {
+                continue;
+            }
+            let parsed = serde_json::from_str(&line)
+                .and_then(codex_rollout::decode_rollout_line)
+                .map_err(|err| {
+                    invalid(format!(
+                        "history_rewrite_unreadable: {} line {}: {err}",
+                        path.display(),
+                        segment.lines + 1
+                    ))
+                })?;
+            let Some(ordinal) = parsed.ordinal else {
+                return Err(invalid(format!(
+                    "history_rewrite_unreadable: {} has no ordinals",
+                    path.display()
+                )));
+            };
+            if segment
+                .end_ordinal_exclusive
+                .is_some_and(|end| ordinal >= end)
+            {
+                break;
+            }
+            hasher.update(line.as_bytes());
+            hasher.update(b"\n");
+            segment.lines += 1;
+            if !matches!(parsed.item, RolloutItem::SessionMeta(_)) {
+                entries.push(Entry {
+                    item: parsed.item,
+                    source: Some(ordinal),
+                });
+            }
+        }
+        segment.sha256 = format!("{:x}", hasher.finalize());
+        read.push(segment);
+    }
+    Ok((entries, read))
+}
+
+/// Counts transcript records only, so settings and metadata lines written on reload keep it.
+fn revision(rollout_id: ThreadId, entries: &[Entry]) -> String {
+    let records = entries
+        .iter()
+        .filter(|entry| {
+            matches!(
+                entry.item,
+                RolloutItem::ResponseItem(_)
+                    | RolloutItem::Compacted(_)
+                    | RolloutItem::EventMsg(
+                        EventMsg::ItemCompleted(_) | EventMsg::TurnStarted(_)
+                    )
+            )
+        })
+        .count();
+    format!("{rollout_id}:{records}")
+}
+
+fn map_cutoff(entries: &[Entry], cutoff: Option<u64>) -> Option<u64> {
+    cutoff.map(|cutoff| {
+        let kept = entries
+            .iter()
+            .position(|entry| entry.source.is_some_and(|source| source >= cutoff))
+            .unwrap_or(entries.len());
+        kept as u64 + 1
+    })
+}
+
+fn public_rows(entries: &[Entry]) -> Vec<HistoryRow> {
+    rows(entries)
+        .into_iter()
+        .map(|row| HistoryRow {
+            id: row.id,
+            turn_id: row.turn_id,
+            kind: row.kind,
+            access: row.access,
+        })
+        .collect()
+}
+
+fn item_value(item: &ResponseItem) -> Value {
+    serde_json::to_value(item).unwrap_or(Value::Null)
+}
+
+fn rows(entries: &[Entry]) -> Vec<Row> {
+    let compaction = entries.iter().rposition(|entry| match &entry.item {
+        RolloutItem::Compacted(_) => true,
+        RolloutItem::ResponseItem(envelope) => matches!(
+            item_value(&envelope.item)["type"].as_str(),
+            Some("compaction" | "context_compaction")
+        ),
+        _ => false,
+    });
+    let mut rows: Vec<Row> = Vec::new();
+    let mut keys: HashMap<String, usize> = HashMap::new();
+    let mut unpaired_users: Vec<(usize, String)> = Vec::new();
+    let mut turn: Option<String> = None;
+    for (index, entry) in entries.iter().enumerate() {
+        match &entry.item {
+            RolloutItem::EventMsg(EventMsg::TurnStarted(event)) => {
+                turn = Some(event.turn_id.clone());
+                unpaired_users.clear();
+            }
+            RolloutItem::ResponseItem(envelope) => {
+                let value = item_value(&envelope.item);
+                let kind = value["type"].as_str().unwrap_or_default().to_string();
+                let Some(key) = value["call_id"]
+                    .as_str()
+                    .map(str::to_string)
+                    .or_else(|| envelope.item.id().map(ToString::to_string))
+                    .filter(|key| !key.is_empty())
+                    .or_else(|| (kind == "message").then(|| format!("line-{index}")))
+                else {
+                    continue;
+                };
+                let access = if EDITABLE.contains(&kind.as_str()) {
+                    HistoryRowAccess::Edit
+                } else if DELETABLE.contains(&kind.as_str()) {
+                    HistoryRowAccess::Delete
+                } else {
+                    HistoryRowAccess::Frozen
+                };
+                let label = match value["role"].as_str() {
+                    Some(role) if kind == "message" => format!("message.{role}"),
+                    _ => kind.clone(),
+                };
+                let row_index = match keys.get(&key) {
+                    Some(&row_index) => {
+                        let ambiguous = rows[row_index].entries.iter().any(|&other| {
+                            matches!(&entries[other].item, RolloutItem::ResponseItem(other)
+                                if item_value(&other.item)["type"] == value["type"])
+                        });
+                        let row = &mut rows[row_index];
+                        row.frozen |= ambiguous;
+                        if row.model.is_none() {
+                            row.kind = label;
+                        }
+                        row.model = Some(row.model.map_or(access, |model| model.min(access)));
+                        row_index
+                    }
+                    None => {
+                        rows.push(Row {
+                            id: key.clone(),
+                            alias: None,
+                            turn_id: turn.clone(),
+                            kind: label,
+                            entries: Vec::new(),
+                            access,
+                            model: Some(access),
+                            frozen: false,
+                        });
+                        keys.insert(key, rows.len() - 1);
+                        rows.len() - 1
+                    }
+                };
+                rows[row_index].entries.push(index);
+                if kind == "message" && value["role"] == "user" {
+                    let text: String = value["content"]
+                        .as_array()
+                        .into_iter()
+                        .flatten()
+                        .filter_map(|part| part["text"].as_str())
+                        .collect();
+                    unpaired_users.push((row_index, text));
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                let id = event.item.id();
+                let paired = if let TurnItem::UserMessage(message) = &event.item {
+                    let text: String = message
+                        .content
+                        .iter()
+                        .filter_map(|input| match input {
+                            UserInput::Text { text, .. } => Some(text.as_str()),
+                            _ => None,
+                        })
+                        .collect();
+                    let position = unpaired_users
+                        .iter()
+                        .rposition(|(_, model)| *model == text)
+                        .or_else(|| unpaired_users.len().checked_sub(1));
+                    position.map(|position| unpaired_users.remove(position).0)
+                } else {
+                    keys.get(&id).copied()
+                };
+                match paired {
+                    Some(row_index) => {
+                        let displayed = rows[row_index].entries.iter().any(|&other| {
+                            matches!(
+                                entries[other].item,
+                                RolloutItem::EventMsg(EventMsg::ItemCompleted(_))
+                            )
+                        });
+                        let row = &mut rows[row_index];
+                        row.frozen |= displayed;
+                        if row.id != id {
+                            row.alias = Some(std::mem::replace(&mut row.id, id.clone()));
+                            keys.insert(id, row_index);
+                        }
+                        row.entries.push(index);
+                    }
+                    None => {
+                        let kind = serde_json::to_value(&event.item)
+                            .ok()
+                            .and_then(|value| value["type"].as_str().map(str::to_string))
+                            .unwrap_or_default();
+                        rows.push(Row {
+                            id: id.clone(),
+                            alias: None,
+                            turn_id: Some(event.turn_id.clone()),
+                            kind,
+                            entries: vec![index],
+                            access: HistoryRowAccess::Delete,
+                            model: None,
+                            frozen: false,
+                        });
+                        keys.insert(id, rows.len() - 1);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    for row in &mut rows {
+        row.access = if row.frozen || compaction.is_some_and(|compaction| row.entries[0] < compaction)
+        {
+            HistoryRowAccess::Frozen
+        } else {
+            row.model.unwrap_or(HistoryRowAccess::Delete)
+        };
+    }
+    rows
+}
+
+fn find<'a>(rows: &'a [Row], id: &str) -> ThreadStoreResult<&'a Row> {
+    rows.iter()
+        .find(|row| row.id == id)
+        .or_else(|| rows.iter().find(|row| row.alias.as_deref() == Some(id)))
+        .ok_or_else(|| invalid(format!("history_row_unknown: {id}")))
+}
+
+fn require(row: &Row, access: HistoryRowAccess) -> ThreadStoreResult<()> {
+    if row.access < access {
+        return Err(invalid(format!(
+            "history_row_{}: {} ({})",
+            if row.access == HistoryRowAccess::Frozen {
+                "frozen"
+            } else {
+                "delete_only"
+            },
+            row.id,
+            row.kind
+        )));
+    }
+    Ok(())
+}
+
+fn apply(entries: &mut Vec<Entry>, change: &HistoryRowEdit, edit: &Edit<'_>) -> ThreadStoreResult<()> {
+    let rows = rows(entries);
+    match change {
+        HistoryRowEdit::Delete { id } => {
+            let row = find(&rows, id)?;
+            require(row, HistoryRowAccess::Delete)?;
+            let checkpoint = checkpoint(entries, row);
+            let at = remove(entries, &row.entries);
+            if let Some(checkpoint) = checkpoint {
+                let target = entries[..at]
+                    .iter()
+                    .rposition(|entry| matches!(entry.item, RolloutItem::ResponseItem(_)))
+                    .or_else(|| {
+                        entries[at..]
+                            .iter()
+                            .position(|entry| matches!(entry.item, RolloutItem::ResponseItem(_)))
+                            .map(|offset| at + offset)
+                    });
+                if let Some(target) = target
+                    && let RolloutItem::ResponseItem(envelope) = &mut entries[target].item
+                {
+                    envelope
+                        .metadata
+                        .get_or_insert_with(CodexHarnessMetadata::default)
+                        .mcp_attribution = Some(checkpoint);
+                }
+            }
+        }
+        HistoryRowEdit::Replace { id, items } => {
+            let row = find(&rows, id)?;
+            require(row, HistoryRowAccess::Edit)?;
+            let (shape, mut items) = new_items(items, row.turn_id.as_deref())?;
+            let mut original_id = None;
+            let mut completed = None;
+            let mut completed_first = false;
+            for &index in &row.entries {
+                match &entries[index].item {
+                    RolloutItem::ResponseItem(envelope) => {
+                        let value = item_value(&envelope.item);
+                        if original_id.is_none() {
+                            original_id = Some((value.clone(), envelope.item.id().cloned()));
+                        }
+                    }
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                        completed_first = original_id.is_none();
+                        completed = Some(event.clone());
+                    }
+                    _ => {}
+                }
+            }
+            let Some((original, response_id)) = original_id else {
+                return Err(invalid(format!("history_row_frozen: {} ({})", row.id, row.kind)));
+            };
+            match &shape {
+                Shape::Message(role) if original["type"] == "message" => {
+                    if original["role"].as_str() != Some(role.as_str()) {
+                        return Err(invalid(format!(
+                            "history_role_changed: {} stays {}",
+                            row.id, original["role"]
+                        )));
+                    }
+                    items[0].set_id(response_id);
+                }
+                Shape::Tool(call_id) if Some(call_id.as_str()) == original["call_id"].as_str() => {}
+                _ => {
+                    return Err(invalid(format!(
+                        "history_row_shape_changed: {} ({})",
+                        row.id, row.kind
+                    )));
+                }
+            }
+            let mut replacement = model_entries(items.clone(), "replace", Some(&row.id), edit, checkpoint(entries, row));
+            let display = completed.and_then(|mut event| {
+                let item = display_item(&items[0], &row.id, Some(&event.item))?;
+                event.item = item;
+                Some(Entry {
+                    item: RolloutItem::EventMsg(EventMsg::ItemCompleted(event)),
+                    source: None,
+                })
+            });
+            if let Some(display) = display {
+                if completed_first {
+                    replacement.insert(0, display);
+                } else {
+                    replacement.push(display);
+                }
+            }
+            let at = remove(entries, &row.entries);
+            entries.splice(at..at, replacement);
+        }
+        HistoryRowEdit::Insert {
+            before,
+            after,
+            items,
+        } => {
+            let (at, turn_id) = position(entries, &rows, before.as_deref(), after.as_deref())?;
+            let (shape, items) = new_items(items, turn_id.as_deref())?;
+            if let Shape::Tool(call_id) = &shape {
+                let used = rows.iter().any(|row| &row.id == call_id || row.alias.as_ref() == Some(call_id))
+                    || entries.iter().any(|entry| match &entry.item {
+                        RolloutItem::ResponseItem(envelope) => {
+                            item_value(&envelope.item)["call_id"].as_str() == Some(call_id)
+                        }
+                        _ => false,
+                    });
+                if used {
+                    return Err(invalid(format!("history_call_id_reused: {call_id}")));
+                }
+            }
+            let mut inserted = model_entries(items.clone(), "insert", None, edit, None);
+            if let (Some(turn_id), Some(id)) = (turn_id, items[0].id().map(ToString::to_string))
+                && let Some(item) = display_item(&items[0], &id, None)
+            {
+                inserted.push(Entry {
+                    item: RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+                        thread_id: edit.thread_id,
+                        turn_id,
+                        item,
+                        started_at_ms: None,
+                        completed_at_ms: chrono::Utc::now().timestamp_millis(),
+                    })),
+                    source: None,
+                });
+            }
+            entries.splice(at..at, inserted);
+        }
+        HistoryRowEdit::Move { id, before, after } => {
+            let row = find(&rows, id)?;
+            require(row, HistoryRowAccess::Edit)?;
+            if [before, after].into_iter().flatten().any(|anchor| anchor == &row.id || row.alias.as_ref() == Some(anchor)) {
+                return Err(invalid(format!("history_move_invalid: {id} cannot move relative to itself")));
+            }
+            let source = row.id.clone();
+            let mut indices = row.entries.clone();
+            indices.sort_unstable();
+            let mut moved = Vec::with_capacity(indices.len());
+            for index in indices.into_iter().rev() {
+                moved.push(entries.remove(index));
+            }
+            moved.reverse();
+            let rows = self::rows(entries);
+            let (at, turn_id) = position(entries, &rows, before.as_deref(), after.as_deref())?;
+            for entry in &mut moved {
+                match &mut entry.item {
+                    RolloutItem::ResponseItem(envelope) => {
+                        envelope
+                            .metadata
+                            .get_or_insert_with(CodexHarnessMetadata::default)
+                            .rewritten = Some(provenance("move", Some(&source), edit));
+                    }
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                        if let Some(turn_id) = &turn_id {
+                            event.turn_id = turn_id.clone();
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            entries.splice(at..at, moved);
+        }
+    }
+    Ok(())
+}
+
+enum Shape {
+    Message(String),
+    Tool(String),
+}
+
+fn new_items(values: &[Value], turn_id: Option<&str>) -> ThreadStoreResult<(Shape, Vec<ResponseItem>)> {
+    if values.is_empty() || values.len() > 2 {
+        return Err(invalid("history_items_invalid: pass one message or one tool call with its output"));
+    }
+    let mut items = Vec::with_capacity(values.len());
+    let mut kinds = Vec::with_capacity(values.len());
+    for value in values {
+        let mut value = value.clone();
+        let Some(object) = value.as_object_mut() else {
+            return Err(invalid("history_items_invalid: items must be objects"));
+        };
+        object.remove(PASSTHROUGH);
+        object.remove("id");
+        let kind = object.get("type").and_then(Value::as_str).unwrap_or_default().to_string();
+        if !EDITABLE.contains(&kind.as_str()) {
+            return Err(invalid(format!("history_item_refused: {kind}")));
+        }
+        if kind == "message"
+            && !matches!(object.get("role").and_then(Value::as_str), Some("user" | "assistant" | "developer"))
+        {
+            return Err(invalid("history_item_refused: message role must be user, assistant or developer"));
+        }
+        let call_id = object.get("call_id").and_then(Value::as_str).map(str::to_string);
+        let role = object.get("role").and_then(Value::as_str).map(str::to_string);
+        let mut item: ResponseItem = serde_json::from_value(value)
+            .map_err(|err| invalid(format!("history_items_invalid: {err}")))?;
+        if let Some(prefix) = item.id_prefix() {
+            item.set_id(Some(ResponseItemId::new(prefix)));
+        }
+        if let Some(turn_id) = turn_id {
+            item.set_turn_id_if_missing(turn_id);
+        }
+        kinds.push((kind, call_id, role));
+        items.push(item);
+    }
+    let shape = match kinds.as_slice() {
+        [(kind, _, Some(role))] if kind == "message" => Shape::Message(role.clone()),
+        [(call, Some(call_id), _), (output, Some(output_id), _)]
+            if call_id == output_id && !call.ends_with("_output") && output.ends_with("_output") =>
+        {
+            Shape::Tool(call_id.clone())
+        }
+        _ => {
+            return Err(invalid(
+                "history_items_unpaired: a tool row is one call followed by its output",
+            ));
+        }
+    };
+    Ok((shape, items))
+}
+
+fn provenance(op: &str, source: Option<&str>, edit: &Edit<'_>) -> HistoryRewriteProvenance {
+    HistoryRewriteProvenance {
+        revision: edit.revision.clone(),
+        op: op.to_string(),
+        source: source.map(str::to_string),
+        by: edit.author.to_string(),
+    }
+}
+
+fn model_entries(
+    items: Vec<ResponseItem>,
+    op: &str,
+    source: Option<&str>,
+    edit: &Edit<'_>,
+    checkpoint: Option<codex_protocol::mcp::McpAttribution>,
+) -> Vec<Entry> {
+    let mut checkpoint = checkpoint;
+    items
+        .into_iter()
+        .map(|item| Entry {
+            item: RolloutItem::ResponseItem(ResponseItemEnvelope {
+                item,
+                metadata: Some(CodexHarnessMetadata {
+                    rewritten: Some(provenance(op, source, edit)),
+                    mcp_attribution: checkpoint.take(),
+                    ..Default::default()
+                }),
+            }),
+            source: None,
+        })
+        .collect()
+}
+
+fn checkpoint(entries: &[Entry], row: &Row) -> Option<codex_protocol::mcp::McpAttribution> {
+    row.entries.iter().find_map(|&index| match &entries[index].item {
+        RolloutItem::ResponseItem(envelope) => envelope
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.mcp_attribution.clone()),
+        _ => None,
+    })
+}
+
+fn remove(entries: &mut Vec<Entry>, indices: &[usize]) -> usize {
+    let mut indices = indices.to_vec();
+    indices.sort_unstable();
+    for &index in indices.iter().rev() {
+        entries.remove(index);
+    }
+    indices[0]
+}
+
+fn position(
+    entries: &[Entry],
+    rows: &[Row],
+    before: Option<&str>,
+    after: Option<&str>,
+) -> ThreadStoreResult<(usize, Option<String>)> {
+    let (row, after) = match (before, after) {
+        (Some(_), Some(_)) => return Err(invalid("history_position_invalid: pass before or after, not both")),
+        (Some(before), None) => (find(rows, before)?, false),
+        (None, Some(after)) => (find(rows, after)?, true),
+        (None, None) => (
+            rows.last().ok_or_else(|| invalid("history_position_invalid: the thread has no rows"))?,
+            true,
+        ),
+    };
+    let at = if after {
+        row.entries.iter().max().map_or(entries.len(), |index| index + 1)
+    } else {
+        row.entries.iter().min().copied().unwrap_or(0)
+    };
+    Ok((at, row.turn_id.clone()))
+}
+
+fn display_item(item: &ResponseItem, id: &str, existing: Option<&TurnItem>) -> Option<TurnItem> {
+    let value = item_value(item);
+    let parts = value["content"].as_array()?;
+    let (kind, content) = match value["role"].as_str()? {
+        "user" => (
+            "UserMessage",
+            parts
+                .iter()
+                .filter_map(|part| match part["type"].as_str()? {
+                    "input_text" => Some(json!({"type": "text", "text": part["text"], "text_elements": []})),
+                    "input_image" => {
+                        let mut image = part.clone();
+                        image["type"] = json!("image");
+                        Some(image)
+                    }
+                    "input_audio" => Some(json!({"type": "audio", "audio_url": part["audio_url"]})),
+                    _ => None,
+                })
+                .collect::<Vec<_>>(),
+        ),
+        "assistant" => (
+            "AgentMessage",
+            parts
+                .iter()
+                .filter_map(|part| part["text"].as_str())
+                .map(|text| json!({"type": "Text", "text": text}))
+                .collect(),
+        ),
+        _ => return None,
+    };
+    let mut display = existing
+        .and_then(|existing| serde_json::to_value(existing).ok())
+        .filter(|existing| existing["type"] == kind)
+        .unwrap_or_else(|| json!({"type": kind, "id": id}));
+    display["content"] = Value::Array(content);
+    if kind == "AgentMessage" {
+        display["phase"] = value["phase"].clone();
+    }
+    serde_json::from_value(display).ok()
+}
+
+fn log_path(store: &LocalThreadStore, thread_id: ThreadId) -> PathBuf {
+    store
+        .config
+        .codex_home
+        .join(REVISIONS_SUBDIR)
+        .join(format!("{thread_id}.jsonl"))
+}
+
+fn read_log(path: &Path) -> ThreadStoreResult<(Vec<Record>, Vec<String>)> {
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => String::new(),
+        Err(err) => return Err(thread_store_io_error(err)),
+    };
+    let mut records = Vec::new();
+    let mut digests = Vec::new();
+    for line in text.lines().filter(|line| !line.is_empty()) {
+        records.push(serde_json::from_str(line).map_err(|err| {
+            invalid(format!("history_anchor_mismatch: unreadable revision log {}: {err}", path.display()))
+        })?);
+        digests.push(sha256(line));
+    }
+    Ok((records, digests))
+}
+
+fn append_record(path: &Path, witness: Option<&dyn HistoryWitness>, record: &Record) -> ThreadStoreResult<()> {
+    let line = serde_json::to_string(record).map_err(|err| internal(err.to_string()))?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent).map_err(thread_store_io_error)?;
+    }
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(thread_store_io_error)?;
+    let length = file.metadata().map_err(thread_store_io_error)?.len();
+    file.write_all(format!("{line}\n").as_bytes())
+        .and_then(|()| file.sync_all())
+        .map_err(thread_store_io_error)?;
+    if let Some(witness) = witness
+        && let Err(err) = witness.append(path, &sha256(&line))
+    {
+        let _ = file.set_len(length);
+        return Err(internal(format!("failed to anchor revision log {}: {err}", path.display())));
+    }
+    Ok(())
+}
+
+fn sha256(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+
+fn invalid(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+fn internal(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: message.into(),
+    }
+}
