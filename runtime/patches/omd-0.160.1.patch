+pub(super) enum Core<'c> {
+    Call(&'c mut dyn FnMut(Value) -> Result<Value>),
+    Host {
+        caller: String,
+        generation: u64,
+    },
+    Spawn {
+        caller: String,
+        arguments: Value,
+        spawned: Option<Value>,
+    },
+    Peer {
+        caller: String,
+        arguments: Value,
