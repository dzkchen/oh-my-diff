+pub struct CompactionInterceptInput<'a> {
+    pub turn_id: &'a str,
+    pub trigger: &'a str,
+    pub reason: &'a str,
+    pub phase: &'a str,
+    pub implementation: &'a str,
+    pub tokens: i64,
+    pub auto_limit: Option<i64>,
+    pub context_window: Option<i64>,
+    pub hard: bool,
+    /// Current history as serialized response items.
+    pub history: &'a [serde_json::Value],
+    /// The summarization prompt, present only where the host summarizes locally.
+    pub summary_prompt: Option<&'a str>,
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub turn_store: &'a ExtensionData,
+}
+
+/// What replaces the history of one compaction occurrence.
+#[derive(Clone, Debug, PartialEq)]
+pub enum CompactionReplacement {
+    /// The host builds its standard summary history around this text.
+    Summary { by: String, text: String },
+    /// Validated serialized response items installed as the new history.
+    History {
+        by: String,
+        items: Vec<serde_json::Value>,
+    },
+}
+
+/// The host's own compaction result, offered back to the contributor that let it run.
+pub struct CompactionSettled {
+    pub summary: Option<String>,
+    pub history: Vec<serde_json::Value>,
+    pub provider_call: bool,
+    pub usage: Option<TokenUsage>,
+}
+
+pub type CompactionSettle = Box<
+    dyn FnOnce(CompactionSettled) -> crate::ExtensionFuture<'static, Option<CompactionReplacement>>
+        + Send,
+>;
+
+pub enum CompactionPlan {
+    Native {
+        summary_prompt: Option<String>,
+        settle: Option<CompactionSettle>,
+    },
+    Skip {
+        by: String,
+        reason: String,
+    },
+    Defer {
+        by: String,
+        reason: String,
+    },
+    Replace(CompactionReplacement),
+    /// A required contributor failed; the occurrence fails with this reason.
+    Fail(String),
+}
+
+/// Every call a model response dispatched has settled.
+pub struct ToolBatchEndInput<'a> {
+    pub turn_id: &'a str,
+    pub call_ids: &'a [String],
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub turn_store: &'a ExtensionData,
+}
+
+/// Instructions, a skill or an attachment the host loaded into model context.
+pub struct InstructionsLoadedInput<'a> {
+    /// `instructions`, `skill` or `attachment`.
+    pub kind: &'a str,
+    pub source: &'a str,
+    pub sha256: Option<&'a str>,
+    pub bytes: usize,
+    /// Why the host loaded it, such as `session_start`, `refresh` or `explicit`.
+    pub reason: &'a str,
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub turn_store: Option<&'a ExtensionData>,
+}
+
+/// Mentions, skills, pastes and images a submitted prompt expanded to, by source identity only.
+pub struct PromptExpandedInput<'a> {
+    pub turn_id: &'a str,
+    pub items: &'a [serde_json::Value],
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub turn_store: &'a ExtensionData,
+}
+
+/// An MCP server elicitation before the host asks the user.
+pub struct ElicitationInterceptInput<'a> {
+    pub turn_id: &'a str,
+    pub server: &'a str,
+    pub request_id: &'a str,
+    /// The serialized elicitation request.
+    pub request: &'a serde_json::Value,
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ElicitationAnswer {
+    /// `accept`, `decline` or `cancel`.
+    pub action: String,
+    pub content: Option<serde_json::Value>,
+    pub by: String,
+}
+
+/// How an elicitation was resolved, by the user or a contributor.
+pub struct ElicitationResultInput<'a> {
+    pub server: &'a str,
+    pub request_id: &'a str,
+    pub action: &'a str,
+    pub content: Option<&'a serde_json::Value>,
+    pub by: Option<&'a str>,
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+}
