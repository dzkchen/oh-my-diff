+use crate::slash_command::SlashCommand;
+use codex_omd::ModCommandOutcome;
+use codex_omd::ModHost;
+use codex_omd::ModViewSnapshot;
+use codex_protocol::ThreadId;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::str::FromStr;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+
+const CATALOG_TTL: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct ModSlashTarget {
+    pub(crate) id: String,
+    pub(crate) command: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct ModSlashCommand {
+    pub(crate) invocation: String,
+    pub(crate) description: String,
+    pub(crate) args_hint: Option<String>,
+    pub(crate) immediate: bool,
+    pub(crate) target: ModSlashTarget,
+}
+
+#[derive(Debug)]
+pub(crate) struct ModCommandResult {
+    pub(crate) value: Value,
+    pub(crate) outcome: ModCommandOutcome,
+    pub(crate) preview: Option<ModViewSnapshot>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ModContext {
+    pub(crate) thread_id: Option<ThreadId>,
+    pub(crate) repository: PathBuf,
+    pub(crate) policy: FileSystemSandboxPolicy,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct ModInvocation {
+    pub(crate) context: ModContext,
+    epoch: u64,
+    sequence: u64,
+}
+
+#[derive(Default)]
+struct ActiveContext {
+    context: Option<ModContext>,
+    epoch: u64,
+    sequence: u64,
+}
+
+static ACTIVE_CONTEXT: Mutex<ActiveContext> = Mutex::new(ActiveContext {
+    context: None,
+    epoch: 0,
+    sequence: 0,
+});
+
+impl ActiveContext {
+    fn synchronize(&mut self, context: ModContext) -> bool {
+        if self.context.as_ref() == Some(&context) {
+            return false;
+        }
+        self.context = Some(context);
+        self.epoch = self.epoch.saturating_add(1);
+        self.sequence = 0;
+        true
+    }
+
+    fn begin(&mut self, context: ModContext) -> ModInvocation {
+        self.synchronize(context.clone());
+        self.sequence = self.sequence.saturating_add(1);
+        ModInvocation {
+            context,
+            epoch: self.epoch,
+            sequence: self.sequence,
+        }
+    }
+
+    fn join(&mut self, context: ModContext) -> ModInvocation {
+        self.synchronize(context.clone());
+        ModInvocation {
+            context,
+            epoch: self.epoch,
+            sequence: self.sequence,
+        }
+    }
+
+    fn current(&self, invocation: &ModInvocation) -> bool {
+        self.epoch == invocation.epoch
+            && self.sequence == invocation.sequence
+            && self.context.as_ref() == Some(&invocation.context)
+    }
+}
+
+pub(crate) fn synchronize_context(context: ModContext) -> bool {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .synchronize(context)
+}
+
+pub(crate) fn begin(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .begin(context)
+}
+
+/// Shares the current invocation, so a nested or intercepted command never supersedes the command running it.
+pub(crate) fn join(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .join(context)
+}
+
+pub(crate) fn current(invocation: &ModInvocation) -> bool {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .current(invocation)
+}
+
+/// True until the session context (thread, repository or permissions) changes.
+fn context_unchanged() -> impl Fn() -> bool {
+    let epoch = ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .epoch;
+    move || {
+        ACTIVE_CONTEXT
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .epoch
+            == epoch
+    }
+}
+
+pub(crate) fn active_context() -> Option<ModContext> {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .context
+        .clone()
+}
+
+pub(crate) struct Entry {
+    namespaced: String,
+    bare: String,
+    description: String,
+    args_hint: Option<String>,
+    immediate: bool,
+    target: ModSlashTarget,
+}
+
+static CATALOG: Mutex<Option<(Instant, Vec<ModSlashCommand>)>> = Mutex::new(None);
+static HOST: Mutex<Option<Arc<Mutex<ModHost>>>> = Mutex::new(None);
+
+/// Evaluate presentation before the provisional composer has a live thread.
+/// The normal terminal observer path rejects native-task operations at the host boundary.
+pub(crate) fn prepare_startup(repository: &Path, phase: &str) {
+    if !crate::omd::is_active() {
+        return;
+    }
+    if crate::mod_ui::startup_context_matches(repository, phase) {
+        return;
+    }
+    let snapshot = (|| {
+        let paths = crate::omd::mod_paths_for(repository)?;
+        let runtime = shared_host(paths.store?).ok()?;
+        let mut runtime = runtime
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        reload(&mut runtime);
+        let input = serde_json::json!({
+            "event": "startup", "ledger": null,
+            "identity": runtime.identity(crate::version::CODEX_CLI_VERSION,
+                std::env::var(crate::omd::INSTALL_PROFILE_ENV).ok().as_deref(), "omd"),
+            "presentation": {"thread_id": null, "phase": phase},
+        });
+        let terminal = runtime.terminal_view(input.clone(), || true);
+        Some(ModViewSnapshot {
+            view: terminal.view,
+            contributors: terminal.contributors,
+            conflicts: terminal.conflicts,
+            component_owners: terminal.component_owners,
+            diagnostics: terminal.diagnostics,
+            input,
+            ..ModViewSnapshot::default()
+        })
+    })();
+    crate::mod_ui::startup_preview(snapshot, repository);
+}
+
+fn builtin(name: &str) -> bool {
+    SlashCommand::from_str(name).is_ok()
+}
+
+fn protected(path: &Path, roots: &[std::path::PathBuf]) -> bool {
+    roots.iter().any(|root| path.starts_with(root))
+}
+
+#[cfg(target_os = "macos")]
+fn sandboxed_seatbelt(
+    executable: &Path,
+    mut args: Vec<String>,
+    protected: &[std::path::PathBuf],
+    cwd: &Path,
+) -> Result<std::process::Command, String> {
+    if args.first().map(String::as_str) != Some("-p") || args.len() < 2 {
+        return Err("exec_sandbox_unavailable".to_owned());
+    }
+    codex_omd::host::deny_protected(&mut args[1], protected)?;
+    let mut command = std::process::Command::new(executable);
+    command.args(args).current_dir(cwd);
+    Ok(command)
+}
+
+fn entries() -> Vec<Entry> {
+    let Some(paths) = crate::omd::mod_paths() else {
+        return Vec::new();
+    };
+    let mut entries = Vec::new();
+    // The terminal host reloads a changed mods.json at once, so enabled mods' commands appear before the next turn.
+    let status = paths
+        .store
+        .and_then(|store| {
+            let runtime = shared_host(store).ok()?;
+            let mut runtime = lock_within(&runtime)?;
+            reload(&mut runtime);
+            Some(runtime.status())
+        })
+        .or_else(crate::omd::mod_status);
+    if let Some(status) = status {
+        for item in status["mods"].as_array().into_iter().flatten() {
+            let Some(id) = item["id"].as_str() else {
+                continue;
+            };
+            if !item["error"].is_null()
+                || !item["capabilities"]
+                    .as_array()
+                    .is_some_and(|c| c.iter().any(|c| c == "commands"))
+            {
+                continue;
+            }
+            for command in item["registrations"]["commands"]
+                .as_array()
+                .into_iter()
+                .flatten()
+            {
+                let Some(name) = command["name"].as_str() else {
+                    continue;
+                };
+                let description = command["description"]
+                    .as_str()
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| format!("{id} mod command"));
+                entries.push(Entry {
+                    namespaced: format!("{id}:{name}"),
+                    bare: name.to_owned(),
+                    description,
+                    args_hint: command["args_hint"].as_str().map(str::to_owned),
+                    immediate: command["immediate"] != false,
+                    target: ModSlashTarget {
+                        id: id.to_owned(),
+                        command: name.to_owned(),
+                    },
+                });
+            }
+        }
+    }
+    entries
+}
+
+pub(crate) fn build(entries: Vec<Entry>) -> Vec<ModSlashCommand> {
+    let mut counts: BTreeMap<&str, usize> = BTreeMap::new();
+    for entry in &entries {
+        *counts.entry(entry.bare.as_str()).or_default() += 1;
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut commands = Vec::new();
+    for entry in &entries {
+        if !seen.insert(entry.namespaced.clone()) {
+            continue;
+        }
+        let conflict = if builtin(&entry.bare) {
+            Some(format!("conflicts with built-in /{}", entry.bare))
+        } else if counts[entry.bare.as_str()] > 1 {
+            Some("defined by more than one mod".to_owned())
+        } else {
+            None
+        };
+        let description = match &conflict {
+            Some(reason) => format!(
+                "{} · bare /{} unavailable: {reason}",
+                entry.description, entry.bare
+            ),
+            None => entry.description.clone(),
+        };
+        commands.push(ModSlashCommand {
+            invocation: entry.namespaced.clone(),
+            description: description.clone(),
+            args_hint: entry.args_hint.clone(),
+            immediate: entry.immediate,
+            target: entry.target.clone(),
+        });
+        if conflict.is_none() && seen.insert(entry.bare.clone()) {
+            commands.push(ModSlashCommand {
+                invocation: entry.bare.clone(),
+                description: format!("{} (/{})", entry.description, entry.namespaced),
+                args_hint: entry.args_hint.clone(),
+                immediate: entry.immediate,
+                target: entry.target.clone(),
+            });
+        }
+    }
+    commands
+}
+
+pub(crate) fn slash_commands() -> Vec<ModSlashCommand> {
+    let mut cache = CATALOG
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((loaded, commands)) = cache.as_ref()
+        && loaded.elapsed() < CATALOG_TTL
+    {
+        return commands.clone();
+    }
+    let commands = build(entries());
+    *cache = Some((Instant::now(), commands.clone()));
+    commands
+}
+
+pub(crate) fn find(invocation: &str) -> Option<ModSlashCommand> {
+    slash_commands()
+        .into_iter()
+        .find(|command| command.invocation == invocation)
+}
+
+struct CommandAuthority<'a> {
+    repository: &'a Path,
+    protected: &'a [std::path::PathBuf],
+    policy: &'a codex_protocol::permissions::FileSystemSandboxPolicy,
+}
+
+impl codex_omd::host::Authority for CommandAuthority<'_> {
+    fn repository(&self) -> &Path {
+        self.repository
+    }
+
+    fn readable(&self, path: &Path) -> bool {
+        !protected(path, self.protected)
+            && self
+                .policy
+                .can_read_local_path_with_cwd(path, self.repository)
+    }
+
+    fn writable(&self, path: &Path) -> bool {
+        self.readable(path)
+            && self
+                .policy
+                .can_write_local_path_with_cwd(path, self.repository)
+    }
+
+    fn command(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        if access.loopback {
+            return Err("exec_network_unavailable_in_commands".to_owned());
+        }
+        self.seatbelt(argv, access)
+    }
+
+    fn protected(&self) -> &[std::path::PathBuf] {
+        self.protected
+    }
+}
+
+impl CommandAuthority<'_> {
+    fn seatbelt(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        #[cfg(target_os = "macos")]
+        {
+            use codex_protocol::permissions::FileSystemAccessMode;
+            use codex_protocol::permissions::FileSystemPath;
+            use codex_protocol::permissions::FileSystemSandboxEntry;
+            use codex_protocol::permissions::FileSystemSandboxKind;
+            use codex_protocol::permissions::FileSystemSandboxPolicy;
+            use codex_sandboxing::seatbelt::CreateSeatbeltCommandArgsParams;
+            use codex_sandboxing::seatbelt::MACOS_PATH_TO_SEATBELT_EXECUTABLE;
+            use codex_sandboxing::seatbelt::create_seatbelt_command_args;
+            if self.policy.kind == FileSystemSandboxKind::ExternalSandbox {
+                return Err("exec_requires_native_sandbox".to_owned());
+            }
+            let mut scope = if access.write {
+                self.policy.clone()
+            } else if self.policy.kind == FileSystemSandboxKind::Unrestricted {
+                FileSystemSandboxPolicy::read_only()
+            } else {
+                FileSystemSandboxPolicy::restricted(
+                    self.policy
+                        .entries
+                        .iter()
+                        .cloned()
+                        .map(|mut entry| {
+                            if entry.access == FileSystemAccessMode::Write {
+                                entry.access = FileSystemAccessMode::Read;
+                            }
+                            entry
+                        })
+                        .collect(),
+                )
+            };
+            let scratch = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(
+                access.scratch,
+            )
+            .map_err(|error| error.to_string())?;
+            scope.entries.push(FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: scratch.into(),
+                },
+                FileSystemAccessMode::Write,
+            ));
+            let loopback = codex_network_proxy::ManagedNetworkSandboxContext {
+                allow_local_binding: true,
+                ..Default::default()
+            };
+            let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+                command: argv,
+                file_system_sandbox_policy: &scope,
+                network_sandbox_policy:
+                    codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+                sandbox_policy_cwd: self.repository,
+                enforce_managed_network: access.loopback,
+                managed_network: access.loopback.then_some(&loopback),
+                environment_id: None,
+                network: None,
+                extra_allow_unix_sockets: &access
+                    .unix_sockets
+                    .iter()
+                    .map(|path| {
+                        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(path)
+                    })
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|error| error.to_string())?,
+            })?;
+            sandboxed_seatbelt(
+                Path::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE),
+                args,
+                self.protected,
+                self.repository,
+            )
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (argv, access);
+            Err("exec_sandbox_unavailable".to_owned())
+        }
+    }
+}
