+const MAX_CODE_BYTES: usize = 32768;
+const MAX_BRIDGE_CALLS: usize = 32;
+const MAX_BRIDGE_REQUEST_BYTES: u64 = 65536;
+const MAX_BRIDGE_RESPONSE_BYTES: usize = 262144;
+const MAX_CELL_DURATION: Duration = Duration::from_secs(120);
+const RESULT_PREFIX: &str = "CODE_KERNEL_RESULT:";
+const MAX_DRIVER_BYTES: u64 = 262144;
+pub(crate) const TOOL_NAME: &str = "kernel";
+
+fn kernel_name(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 32
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_' || byte == b'-'
+        })
+}
+
+fn shell_word(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn kernel_command(kernel: &codex_features::CodeModeKernelToml) -> Result<String, String> {
+    if !kernel_name(&kernel.name)
+        || kernel.command.is_empty()
+        || kernel.command.len() > 16
+        || kernel
+            .command
+            .iter()
+            .any(|arg| arg.is_empty() || arg.contains('\0'))
+        || !kernel.driver.is_absolute()
+        || kernel.driver_sha256.len() != 64
+    {
+        return Err(format!("kernel {} configuration is invalid", kernel.name));
+    }
+    let metadata = std::fs::symlink_metadata(&kernel.driver)
+        .map_err(|error| format!("kernel {} driver unavailable: {error}", kernel.name))?;
+    if !metadata.is_file() || metadata.len() > MAX_DRIVER_BYTES {
+        return Err(format!(
+            "kernel {} driver is not a bounded regular file",
+            kernel.name
+        ));
+    }
+    let bytes = std::fs::read(&kernel.driver).map_err(|error| error.to_string())?;
+    let digest = format!("{:x}", <sha2::Sha256 as sha2::Digest>::digest(&bytes));
+    if !digest.eq_ignore_ascii_case(&kernel.driver_sha256) {
+        return Err(format!("kernel {} driver changed", kernel.name));
+    }
+    let driver = String::from_utf8(bytes).map_err(|_| "kernel driver must be UTF-8".to_string())?;
+    let words = kernel
+        .command
+        .iter()
+        .map(|arg| shell_word(arg))
+        .chain(std::iter::once(shell_word(&driver)))
+        .collect::<Vec<_>>();
+    Ok(format!("stty raw -echo; {}", words.join(" ")))
+}
