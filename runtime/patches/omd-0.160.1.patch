@@ -0,0 +1,105 @@
+use super::CHANNEL_CAPACITY;
+use super::TransportEvent;
+use super::websocket_router;
+use codex_websocket_auth::WebsocketAuthArgs;
+use codex_websocket_auth::WebsocketAuthCliMode;
+use codex_websocket_auth::policy_from_settings;
+use pretty_assertions::assert_eq;
+use std::net::SocketAddr;
+use tempfile::NamedTempFile;
+use tokio::net::TcpListener;
+use tokio::sync::mpsc;
+use tokio_tungstenite::connect_async;
+use tokio_tungstenite::tungstenite::Error as WebSocketError;
+use tokio_tungstenite::tungstenite::client::IntoClientRequest;
+use tokio_tungstenite::tungstenite::http::HeaderValue;
+use tokio_tungstenite::tungstenite::http::StatusCode;
+use tokio_tungstenite::tungstenite::http::header::ORIGIN;
+use tokio_tungstenite::tungstenite::http::header::SEC_WEBSOCKET_PROTOCOL;
+
+const ALLOWED_ORIGIN: &str = "vscode-webview://renderer";
+
+struct Listener {
+    addr: SocketAddr,
+    _token_file: NamedTempFile,
+    _transport_event_rx: mpsc::Receiver<TransportEvent>,
+}
+
+async fn spawn_listener() -> Listener {
+    let token_file = NamedTempFile::new().expect("token file");
+    std::fs::write(token_file.path(), "secret-token\n").expect("write token");
+    let settings = WebsocketAuthArgs {
+        ws_auth: Some(WebsocketAuthCliMode::CapabilityToken),
+        ws_token_file: Some(token_file.path().to_path_buf()),
+        ws_allowed_origins: vec![ALLOWED_ORIGIN.to_string()],
+        ..Default::default()
+    }
+    .try_into_settings()
+    .expect("websocket auth args should parse");
+    let auth_policy = policy_from_settings(&settings).expect("policy should load");
+    let (transport_event_tx, transport_event_rx) = mpsc::channel(CHANNEL_CAPACITY);
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("local addr");
+    let router = websocket_router(transport_event_tx, auth_policy);
+    tokio::spawn(async move {
+        axum::serve(
+            listener,
+            router.into_make_service_with_connect_info::<SocketAddr>(),
+        )
+        .await
+    });
+    Listener {
+        addr,
+        _token_file: token_file,
+        _transport_event_rx: transport_event_rx,
+    }
+}
+
+async fn connect(
+    listener: &Listener,
+    origin: &'static str,
+    token: &str,
+) -> Result<HeaderValue, StatusCode> {
+    let mut request = format!("ws://{}/", listener.addr)
+        .into_client_request()
+        .expect("client request");
+    let headers = request.headers_mut();
+    headers.insert(ORIGIN, HeaderValue::from_static(origin));
+    headers.insert(
+        SEC_WEBSOCKET_PROTOCOL,
+        HeaderValue::from_str(&format!("codex-app-server, codex.bearer.{token}"))
+            .expect("protocol header"),
+    );
+    match connect_async(request).await {
+        Ok((_, response)) => Ok(response.headers()[SEC_WEBSOCKET_PROTOCOL].clone()),
+        Err(WebSocketError::Http(response)) => Err(response.status()),
+        Err(err) => panic!("unexpected websocket error: {err}"),
+    }
+}
+
+#[tokio::test]
+async fn websocket_listener_rejects_disallowed_origin() {
+    let listener = spawn_listener().await;
+    assert_eq!(
+        connect(&listener, "https://evil.example", "secret-token").await,
+        Err(StatusCode::FORBIDDEN)
+    );
+}
+
+#[tokio::test]
+async fn websocket_listener_upgrades_allowed_origin_with_subprotocol_token() {
+    let listener = spawn_listener().await;
+    assert_eq!(
+        connect(&listener, ALLOWED_ORIGIN, "secret-token").await,
+        Ok(HeaderValue::from_static("codex-app-server"))
+    );
+}
+
+#[tokio::test]
+async fn websocket_listener_rejects_allowed_origin_with_bad_token() {
+    let listener = spawn_listener().await;
+    assert_eq!(
+        connect(&listener, ALLOWED_ORIGIN, "wrong-token").await,
+        Err(StatusCode::UNAUTHORIZED)
+    );
+}
