+        json!({"rect": {"x": 4, "y": 0, "width": 1, "height": 1}, "cells": ["x"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 2, "height": 1}, "cells": ["x"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["xy"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["\u{7}"]}),
+    ] {
+        assert_eq!(
+            blit_at("raster-refuse", "owner", invalid, now),
+            Err("terminal_blit_invalid".into())
+        );
+    }
+    blit_at("raster-refuse", "owner", cell.clone(), now).expect("queued");
+    super::rows(
+        "raster-refuse",
+        Some("owner"),
+        "chart",
+        10,
+        (4, 2),
+        false,
+        "",
+        now,
+    );
+    for _ in 0..QUEUE_UPDATES {
+        blit_at("raster-refuse", "owner", cell.clone(), now).expect("queued");
+    }
+    assert_eq!(
+        blit_at("raster-refuse", "owner", cell, now).expect("reply"),
+        json!({"status": "backpressure", "retry_after_ms": 33})
+    );
+}
+
+#[test]
+#[serial_test::serial]
+fn undrawn_rasters_drain_their_queue_under_the_frame_budget() {
+    let now = Instant::now();
+    let cell = json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]});
+    let status =
+        |at| blit_at("raster-undrawn", "owner", cell.clone(), at).expect("reply")["status"].clone();
+    for _ in 0..QUEUE_UPDATES {
+        assert_eq!(status(now), Value::Null);
+    }
+    assert_eq!(status(now), Value::Null, "the first update is due at once");
+    assert_eq!(status(now), "backpressure");
+    assert_eq!(
+        status(now + FRAME),
+        Value::Null,
+        "one update drains per frame"
+    );
+    retain(&BTreeSet::new());
+}
