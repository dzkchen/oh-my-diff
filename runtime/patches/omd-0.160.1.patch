+#[test]
+fn diagnostic_only_changes_are_pushed() {
+    let snapshot = |diagnostics: &[&str]| ModViewSnapshot {
+        epoch: 1,
+        revision: 1,
+        diagnostics: diagnostics.iter().map(ToString::to_string).collect(),
+        ..ModViewSnapshot::default()
+    };
+    assert_ne!(
+        pushed_key(Some(&snapshot(&[]))),
+        pushed_key(Some(&snapshot(&["terminal: invalid view"])))
+    );
+}
