+            "capture_fixture",
+            &digest,
+            "retry",
+        )
+        .unwrap();
+        codex_omd::consents::consume(
+            &root.join("store"),
+            "thread-b",
+            "capture_fixture",
+            "retry",
+            &digest,
+            "client",
+        )
+        .unwrap();
+        store.enable(&package, false).unwrap();
+        assert!(materialize("capture_fixture", Some("thread-b"), &reference).is_err());
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn revoked_queued_and_confirmed_calls_leave_the_composer_unchanged()
+    -> color_eyre::Result<()> {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        let mut app = crate::app::test_support::make_test_app().await;
+        let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        for confirmed in [false, true] {
+            let before = app.chat_widget.mod_composer_read();
+            let active = std::sync::Arc::new(AtomicBool::new(true));
+            let check = active.clone();
+            let (reply, answer) = std::sync::mpsc::sync_channel(1);
+            let call = SurfaceCall {
+                validity: codex_omd::client_surface::Validity(std::sync::Arc::new(move || {
+                    check.load(Ordering::Acquire)
+                })),
+                caller: "fixture".into(),
+                operation: "composer.write".into(),
+                arguments: json!({"revision": before["revision"], "edit": {"kind":"fill", "text":"foreign draft"}}),
+                context: codex_omd::app_routes::InvocationContext::User,
+                remote: false,
+                thread: None,
+                authority: None,
+                confirm: None,
+                reply,
+                lifetime: Default::default(),
+            };
+            if confirmed {
+                let id = crate::mod_surface::hold(call);
+                active.store(false, Ordering::Release);
+                app.handle_mod_surface_confirmed(&mut tui, &mut server, id, true)
+                    .await;
+            } else {
+                active.store(false, Ordering::Release);
+                app.handle_mod_surface_call(&mut tui, &mut server, call, None)
+                    .await;
+            }
+            assert_eq!(answer.try_recv()?, Err("client_context_changed".into()));
+            assert_eq!(app.chat_widget.mod_composer_read(), before);
+        }
+        Ok(())
+    }
+
