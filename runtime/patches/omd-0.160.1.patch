@@ -0,0 +1,637 @@
+use serde_json::Value;
+use std::borrow::Cow;
+use std::path::Path;
+use std::path::PathBuf;
+
+#[cfg(test)]
+pub(crate) const MODE_ENV: &str = codex_omd::MODE_ENV;
+pub(crate) const INSTALL_PROFILE_ENV: &str = "OMD_INSTALL_PROFILE";
+const HOST_CONFIG: &str = "host.json";
+
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub(crate) struct Snapshot {
+    pub(crate) evidence: Option<PathBuf>,
+    pub(crate) active_mods: usize,
+    pub(crate) failed_mods: usize,
+    pub(crate) rejected_selections: usize,
+    pub(crate) observed_requests: usize,
+    pub(crate) raw_usage_attempts: u64,
+    pub(crate) settled_task_charge_microusd: u64,
+    pub(crate) retained_exposure_upper_bound_microusd: u64,
+    pub(crate) contract: String,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct ModPaths {
+    pub(crate) evidence: PathBuf,
+    pub(crate) repository: PathBuf,
+    pub(crate) store: Option<PathBuf>,
+    pub(crate) protected: Vec<PathBuf>,
+}
+
+pub(crate) fn is_active() -> bool {
+    effective_mode().is_ok_and(|mode| mode.mode.mod_host_enabled())
+}
+
+pub(crate) fn mod_snapshot() -> (bool, codex_omd::ModViewSnapshot) {
+    store_root().map_or_else(
+        || (false, codex_omd::ModViewSnapshot::default()),
+        |root| {
+            let mut snapshot =
+                codex_omd::ModViewSnapshot::read(&root.join("mod-view.json")).unwrap_or_default();
+            if let Some(status) = mod_status() {
+                let errors = status["mods"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter_map(|item| {
+                        item["error"].as_str().map(|error| {
+                            format!("{}: {error}", item["id"].as_str().unwrap_or("mod"))
+                                .chars()
+                                .filter(|character| !character.is_control())
+                                .take(180)
+                                .collect::<String>()
+                        })
+                    })
+                    .take(16)
+                    .collect::<Vec<_>>();
+                if !errors.is_empty()
+                    && !snapshot
+                        .view
+                        .panels
+                        .iter()
+                        .any(|panel| panel.title == "Mod errors")
+                {
+                    snapshot.view.panels.insert(
+                        0,
+                        codex_omd::ModPanel {
+                            title: "Mod errors".into(),
+                            lines: errors,
+                        },
+                    );
+                }
+            }
+            (true, snapshot)
+        },
+    )
+}
+
+pub(crate) fn mod_paths() -> Option<ModPaths> {
+    let repository = crate::mod_runtime::active_context()
+        .map(|context| context.repository)
+        .or_else(|| std::env::current_dir().ok())?;
+    mod_paths_for(&repository)
+}
+
+pub(crate) fn mod_paths_for(repository: &Path) -> Option<ModPaths> {
+    let root = store_root()?;
+    let repository = repository.canonicalize().ok()?;
+    if codex_omd::app_routes::unscoped_directory(&repository) {
+        return None;
+    }
+    let protected = host_protected_paths(&root);
+    Some(ModPaths {
+        evidence: root.clone(),
+        repository,
+        store: Some(root),
+        protected,
+    })
+}
+
+pub(crate) fn store_root() -> Option<PathBuf> {
+    if !is_active() {
+        return None;
+    }
+    let root = PathBuf::from(std::env::var_os(codex_omd::MOD_STORE_ENV)?);
+    (root.is_absolute() && root.canonicalize().ok()? == root).then_some(root)
+}
+
+/// The store plus `host.json` protected and secret paths, re-read only when the file changes.
+fn host_protected_paths(root: &Path) -> Vec<PathBuf> {
+    type Cached = (PathBuf, Option<(std::time::SystemTime, u64)>, Vec<PathBuf>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let path = root.join(HOST_CONFIG);
+    let stamp = std::fs::symlink_metadata(&path)
+        .ok()
+        .and_then(|metadata| Some((metadata.modified().ok()?, metadata.len())));
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached_root, cached_stamp, protected)) = cache.as_ref()
+        && cached_root == root
+        && *cached_stamp == stamp
+    {
+        return protected.clone();
+    }
+    let config = bounded_read(&path, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or(Value::Null);
+    let paths = |value: &Value| -> Vec<PathBuf> {
+        match value {
+            Value::Array(items) => items
+                .iter()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            Value::Object(items) => items
+                .values()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            _ => Vec::new(),
+        }
+    };
+    let mut protected = vec![root.to_path_buf()];
+    protected.extend(paths(&config["protected"]));
+    protected.extend(paths(&config["secret_refs"]));
+    *cache = Some((root.to_path_buf(), stamp, protected.clone()));
+    protected
+}
+
+pub(crate) fn mod_status() -> Option<Value> {
+    serde_json::from_slice(&bounded_read(&store_root()?.join("mod-status.json"), 262_144).ok()?)
+        .ok()
+}
+
+pub(crate) fn builtins() -> codex_omd::BuiltinSnapshot {
+    type Cached = (
+        Option<PathBuf>,
+        std::time::Instant,
+        codex_omd::BuiltinSnapshot,
+    );
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let root = store_root();
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached, loaded, snapshot)) = cache.as_ref()
+        && *cached == root
+        && loaded.elapsed() < std::time::Duration::from_secs(2)
+    {
+        return snapshot.clone();
+    }
+    let snapshot = root
+        .as_deref()
+        .map(codex_omd::BuiltinSnapshot::read)
+        .unwrap_or_default();
+    *cache = Some((root, std::time::Instant::now(), snapshot.clone()));
+    snapshot
+}
+
+pub(crate) fn command_replacement(command: &str) -> Option<crate::mod_runtime::ModSlashCommand> {
+    let (id, target) = builtins().command_replacement(command)?.clone();
+    Some(crate::mod_runtime::ModSlashCommand {
+        invocation: command.to_owned(),
+        description: format!("Replaced by {id}:{target}"),
+        args_hint: None,
+        immediate: true,
+        target: crate::mod_runtime::ModSlashTarget {
+            id,
+            command: target,
+        },
+    })
+}
+
+pub(crate) fn builtin_keys() -> Vec<(String, Option<String>)> {
+    builtins()
+        .keys
+        .into_iter()
+        .map(|(action, (_, key))| (action, key))
+        .collect()
+}
+
+pub(crate) fn command_hidden(command: &str) -> bool {
+    builtins().command_hidden(command)
+}
+
+pub(crate) fn mode_disabled(mode: codex_protocol::config_types::ModeKind) -> bool {
+    serde_json::to_value(mode)
+        .ok()
+        .and_then(|value| value.as_str().map(|name| builtins().mode_disabled(name)))
+        .unwrap_or(false)
+}
+
+pub(crate) fn terminal_active() -> bool {
+    mod_paths().is_some()
+}
+
+pub(crate) fn effective_mode() -> Result<codex_omd::EffectiveMode, String> {
+    codex_omd::effective_mode()
+}
+
+pub(crate) fn daemon_exclusion() -> Option<&'static str> {
+    daemon_exclusion_for(effective_mode())
+}
+
+fn daemon_exclusion_for(mode: Result<codex_omd::EffectiveMode, String>) -> Option<&'static str> {
+    match mode {
+        Ok(mode) if mode.mode == codex_omd::RuntimeMode::UpstreamDirect => None,
+        Ok(_) => Some("Oh My Diff mode"),
+        Err(_) => Some("an invalid Oh My Diff mode"),
+    }
+}
+
+fn profile_selector(value: &str) -> &'static str {
+    match value {
+        "full" => "full",
+        "platform_only" => "platform_only",
+        "private" => "private",
+        _ => "unknown",
+    }
+}
+
+pub(crate) fn install_profile() -> Option<&'static str> {
+    std::env::var(INSTALL_PROFILE_ENV)
+        .ok()
+        .map(|value| profile_selector(&value))
+}
+
+pub(crate) fn ligatures_enabled() -> bool {
+    terminal_active()
+        && std::env::var("OMD_TUI_ASCII").as_deref() != Ok("1")
+        && locale_supports_unicode()
+}
+
+pub(crate) fn mouse_enabled() -> bool {
+    terminal_active() && std::env::var("OMD_TUI_MOUSE").as_deref() != Ok("off")
+}
+
+fn locale_supports_unicode() -> bool {
+    ["LC_ALL", "LC_CTYPE", "LANG"]
+        .into_iter()
+        .filter_map(|name| std::env::var(name).ok())
+        .find(|value| !value.is_empty())
+        .is_none_or(|value| {
+            let normalized = value.to_ascii_lowercase();
+            normalized.contains("utf-8") || normalized.contains("utf8")
+        })
+}
+
+pub(crate) fn visual_input(text: &str) -> Cow<'_, str> {
+    let glyphs = crate::mod_ui::glyphs();
+    mod_glyphs(text, &glyphs)
+}
+
+fn mod_glyphs<'a>(
+    text: &'a str,
+    glyphs: &std::collections::BTreeMap<String, String>,
+) -> Cow<'a, str> {
+    if !glyphs.keys().any(|source| text.contains(source.as_str())) {
+        return Cow::Borrowed(text);
+    }
+    let mut ordered = glyphs.iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(source, _)| std::cmp::Reverse(source.len()));
+    let mut rendered = String::with_capacity(text.len());
+    let mut remaining = text;
+    'outer: while !remaining.is_empty() {
+        for (source, display) in &ordered {
+            if let Some(rest) = remaining.strip_prefix(source.as_str()) {
+                rendered.push_str(display);
+                remaining = rest;
+                continue 'outer;
+            }
+        }
+        if let Some(character) = remaining.chars().next() {
+            rendered.push(character);
+            remaining = &remaining[character.len_utf8()..];
+        }
+    }
+    Cow::Owned(rendered)
+}
+
+fn latest_session(root: &Path) -> Option<PathBuf> {
+    std::fs::read_dir(root.join("sessions"))
+        .ok()?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path)
+}
+
+pub(crate) fn snapshot() -> Result<Snapshot, String> {
+    let paths = mod_paths().ok_or_else(|| "Oh My Diff mod host is not active".to_string())?;
+    let status = mod_status().unwrap_or(Value::Null);
+    let count = |key: &str| status[key].as_array().map_or(0, Vec::len);
+    let (active_mods, failed_mods) = codex_omd::mod_counts(&status);
+    let mut snapshot = Snapshot {
+        active_mods,
+        failed_mods,
+        rejected_selections: count("rejected"),
+        contract: "none".to_string(),
+        ..Snapshot::default()
+    };
+    let Some(session) = latest_session(&paths.evidence) else {
+        return Ok(snapshot);
+    };
+    let read = |name: &str, limit: usize| {
+        bounded_read(&session.join(name), limit)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+            .unwrap_or(Value::Null)
+    };
+    let cost = read("task-cost.json", 8_388_608);
+    let number = |key: &str| cost[key].as_u64().unwrap_or_default();
+    snapshot.observed_requests = cost["observed"].as_array().map_or(0, Vec::len);
+    snapshot.raw_usage_attempts = number("raw_usage_attempts");
+    snapshot.settled_task_charge_microusd = number("settled_task_charge_microusd");
+    snapshot.retained_exposure_upper_bound_microusd =
+        number("retained_exposure_upper_bound_microusd");
+    let contract = read("contract.json", 262_144);
+    snapshot.contract = match (contract["status"].as_str(), contract["active"].as_object()) {
+        (Some("active"), Some(active)) => format!(
+            "{}@{} ({})",
+            active
+                .get("id")
+                .and_then(Value::as_str)
+                .unwrap_or("unknown"),
+            active
+                .get("version")
+                .and_then(Value::as_u64)
+                .unwrap_or_default(),
+            active
+                .get("assurance")
+                .and_then(Value::as_str)
+                .unwrap_or("unlabelled")
+        ),
+        (Some(status), _) => status.to_string(),
+        _ => "none".to_string(),
+    };
+    snapshot.evidence = Some(session);
+    Ok(snapshot)
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, String> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if metadata.file_type().is_symlink() || metadata.len() > limit as u64 {
+        return Err(format!(
+            "unsafe or oversized Oh My Diff file: {}",
+            path.display()
+        ));
+    }
+    std::fs::read(path).map_err(|error| error.to_string())
+}
+
+pub(crate) fn compact_status() -> String {
+    match effective_mode() {
+        Ok(mode) if mode.mode == codex_omd::RuntimeMode::UpstreamDirect => {
+            "Oh My Diff · upstream-style direct · hooks off".to_string()
+        }
+        Ok(_) => match snapshot() {
+            _ if mod_status().is_some_and(|status| status["activation_error"].is_string()) => {
+                "Oh My Diff · mods inactive · see /omd".to_string()
+            }
+            Err(_) if store_root().is_some() => {
+                "Oh My Diff · mods off in this directory · see /omd".to_string()
+            }
+            Ok(snapshot) if mod_status().is_some() => format!(
+                "Oh My Diff · {} mod{} on{}{}",
+                snapshot.active_mods,
+                if snapshot.active_mods == 1 { "" } else { "s" },
+                if snapshot.failed_mods == 0 {
+                    String::new()
+                } else {
+                    format!(" · {} failed", snapshot.failed_mods)
+                },
+                if snapshot.contract == "none" {
+                    String::new()
+                } else {
+                    format!(" · contract {}", snapshot.contract)
+                }
+            ),
+            _ => "Oh My Diff · mod status unavailable".to_string(),
+        },
+        Err(error) => format!("Oh My Diff · invalid mode · {error}"),
+    }
+}
