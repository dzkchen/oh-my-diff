+fn placeholder_rows_encode_the_image_id_row_and_column_in_every_cell() {
+    let rows = placeholder_rows(0x4f_4d_07, 3, 2, " ");
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 6, 2));
+    Paragraph::new(rows).render(buffer.area, &mut buffer);
+    assert_eq!(buffer[(1, 0)].symbol(), "\u{10EEEE}\u{0305}\u{0305}");
+    assert_eq!(buffer[(2, 0)].symbol(), "\u{10EEEE}\u{0305}\u{030D}");
+    assert_eq!(buffer[(3, 0)].symbol(), "\u{10EEEE}\u{0305}\u{030E}");
+    assert_eq!(buffer[(4, 0)].symbol(), " ", "three cells wide");
+    assert_eq!(buffer[(1, 1)].symbol(), "\u{10EEEE}\u{030D}\u{0305}");
