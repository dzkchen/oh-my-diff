+pub(crate) fn paint_surface(
+    area: Rect,
+    buffer: &mut Buffer,
+    paint: &codex_omd::ModSurfacePaint,
+    base: Option<Color>,
+    border_clip: Option<Rect>,
+) {
+    if area.is_empty() || std::env::var_os("NO_COLOR").is_some() {
+        return;
+    }
+    let a = paint.top.or(paint.bottom).map(crate::mod_backdrop::rgb);
+    let b = paint.bottom.or(paint.top).map(crate::mod_backdrop::rgb);
+    let alpha = paint.opacity.unwrap_or(1.0);
+    let fallback = crate::terminal_palette::default_bg()
+        .map(|(r, g, b)| [r, g, b])
+        .unwrap_or([0; 3]);
+    for y in area.top()..area.bottom() {
+        // A clipped backdrop border yields the whole row to native text and its spacing.
+        let border_row = paint.border.is_some()
+            && border_clip.is_none_or(|clip| {
+                y >= clip.top()
+                    && y < clip.bottom()
+                    && !(area.left()..area.right()).any(|x| {
+                        let cell = &buffer[(x, y)];
+                        cell.symbol() != " "
+                            || cell.bg != Color::Reset
+                            || cell.fg != Color::Reset
+                            || !cell.modifier.is_empty()
+                    })
+            });
+        for x in area.left()..area.right() {
+            let cell = &mut buffer[(x, y)];
+            let can_paint_background = cell.bg == Color::Reset || Some(cell.bg) == base;
+            if can_paint_background && let (Some(a), Some(b)) = (a, b) {
+                let ratio = f32::from(y - area.y) / f32::from(area.height.saturating_sub(1).max(1));
+                let underlying = match cell.bg {
+                    Color::Rgb(r, g, b) => [r, g, b],
+                    _ => fallback,
+                };
+                let value: [u8; 3] = std::array::from_fn(|i| {
+                    ((f32::from(a[i]) * (1.0 - ratio) + f32::from(b[i]) * ratio) * alpha
+                        + f32::from(underlying[i]) * (1.0 - alpha))
+                        .round() as u8
+                });
+                cell.set_bg(crate::terminal_palette::best_color((
+                    value[0], value[1], value[2],
+                )));
+            }
+            if cell.fg == Color::Reset
+                && let Some(fg) = paint.foreground
+            {
+                let actual_background = match cell.bg {
+                    Color::Rgb(r, g, b) => [r, g, b],
+                    Color::Indexed(index) => crate::mod_backdrop::rgb(ModColor::Indexed(index)),
+                    _ => fallback,
+                };
+                cell.set_fg(color(readable(fg, actual_background)));
+            }
+            if can_paint_background
+                && alpha > 0.0
+                && border_row
+                && border_clip.is_none_or(|clip| x >= clip.left() && x < clip.right())
+                && let Some(border) = paint.border
+                && cell.symbol() == " "
+                && area.width >= 4
+                && area.height >= 3
+            {
+                let on_top = y == area.top();
+                let on_bottom = y + 1 == area.bottom();
+                if on_top || on_bottom || x == area.left() || x + 1 == area.right() {
+                    cell.set_char(if on_top || on_bottom { '-' } else { '|' })
+                        .set_fg(color(border));
+                }
+            }
+        }
+    }
+}
+
+pub(crate) const APPROVAL_VIEW_ID: &str = "approval";
+
+fn contrast(a: [u8; 3], b: [u8; 3]) -> f32 {
+    let luminance = |rgb: [u8; 3]| -> f32 {
+        rgb.into_iter()
+            .enumerate()
+            .map(|(i, c)| {
+                let value = f32::from(c) / 255.0;
+                let value = if value <= 0.04045 {
+                    value / 12.92
+                } else {
+                    ((value + 0.055) / 1.055).powf(2.4)
+                };
+                value * [0.2126, 0.7152, 0.0722][i]
+            })
+            .sum()
+    };
+    let (a, b) = (luminance(a), luminance(b));
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
+
+/// Keeps the requested colour when it reads against the background, else white or black.
+fn readable(fg: ModColor, background: [u8; 3]) -> ModColor {
+    if contrast(crate::mod_backdrop::rgb(fg), background) >= 4.5 {
+        fg
+    } else if contrast([255; 3], background) >= contrast([0; 3], background) {
+        ModColor::Rgb(255, 255, 255)
+    } else {
+        ModColor::Rgb(0, 0, 0)
+    }
+}
+
+pub(crate) fn paint_named(name: &str, area: Rect, buffer: &mut Buffer, base: Option<Color>) {
+    let Some(paint) = snapshot().view.surface_styles.get(name).cloned() else {
+        return;
+    };
+    paint_surface(area, buffer, &paint, base, /*border_clip*/ None);
+    if name != APPROVAL_VIEW_ID {
+        return;
+    }
+    let rgb = |color: Color, default: Option<(u8, u8, u8)>| match color {
+        Color::Rgb(r, g, b) => Some([r, g, b]),
+        Color::Indexed(index) => Some(crate::mod_backdrop::rgb(ModColor::Indexed(index))),
+        Color::Reset => default.map(|(r, g, b)| [r, g, b]),
+        _ => None,
+    };
+    let (default_fg, default_bg) = (
+        crate::terminal_palette::default_fg(),
+        crate::terminal_palette::default_bg(),
+    );
+    for y in area.top()..area.bottom() {
+        for x in area.left()..area.right() {
+            let cell = &mut buffer[(x, y)];
+            if let (Some(fg), Some(bg)) = (rgb(cell.fg, default_fg), rgb(cell.bg, default_bg)) {
+                cell.set_fg(color(readable(ModColor::Rgb(fg[0], fg[1], fg[2]), bg)));
+            }
+        }
+    }
+}
+
+pub(crate) fn render_backdrop(
+    area: Rect,
+    glyph_area: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+    image_active: bool,
+) {
+    if std::env::var_os("NO_COLOR").is_some() || area.is_empty() {
+        return;
+    }
+    if !image_active
+        && area.width >= crate::mod_backdrop::BACKDROP_MIN_COLUMNS
+        && let Some(ascii) = match snapshot.view.backdrop.as_ref() {
+            Some(codex_omd::ModBackdrop::Ascii { ascii }) => Some(ascii),
+            Some(codex_omd::ModBackdrop::Image { fallback, .. }) => {
+                fallback.as_ref().map(|value| &value.ascii)
+            }
+            None => None,
+        }
+    {
+        crate::mod_backdrop::fill_ascii_configured(buffer, area, glyph_area, ascii);
+    }
+    if let Some(paint) = snapshot.view.surface_styles.get("backdrop") {
+        paint_surface(area, buffer, paint, /*base*/ None, Some(glyph_area));
+    }
+}
+
+/// Components without a height share the rows a layout region leaves after its fixed components.
+fn fill_heights(components: &mut [ModComponent], width: u16, rows: u16) {
+    let fills = |component: &ModComponent| {
+        matches!(
+            component,
+            ModComponent::Terminal { height: None, .. }
+                | ModComponent::Document { height: None, .. }
+                | ModComponent::Diff { height: None, .. }
+                | ModComponent::List { height: None, .. }
+        )
+    };
+    let count = components
+        .iter()
+        .filter(|component| fills(component))
+        .count();
+    if count == 0 {
+        return;
+    }
+    let fixed = components
+        .iter()
+        .filter(|component| !fills(component))
+        .cloned()
+        .collect::<Vec<_>>();
+    let share = rows.saturating_sub(component_height(&fixed, width))
+        / u16::try_from(count).unwrap_or(u16::MAX);
+    for component in components {
+        match component {
+            ModComponent::Terminal { height, .. } if height.is_none() => {
+                *height = Some(share.saturating_sub(1).max(2));
+            }
+            ModComponent::Document { height, .. }
+            | ModComponent::Diff { height, .. }
+            | ModComponent::List { height, .. }
+                if height.is_none() =>
+            {
+                *height = Some(share.max(1));
+            }
+            _ => {}
+        }
+    }
+}
+
+pub(crate) fn render_owned(
+    screen: Rect,
+    chat: Rect,
+    transcript: Rect,
+    empty_transcript: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+) {
+    render_backdrop(
+        transcript,
+        empty_transcript,
+        buffer,
+        snapshot,
+        crate::mod_backdrop_sync::image_active(),
+    );
+    let Some(placement) = placement(screen, snapshot) else {
+        render(screen, chat, buffer, snapshot);
+        return;
+    };
+    let style = panel_style(&snapshot.view);
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction.targets.clear();
+    interaction.key_panes.clear();
+    interaction.order.clear();
+    interaction.hitboxes.clear();
+    interaction.owners = snapshot.contributors.clone();
+    interaction.component_owners = snapshot.component_owners.clone();
+    for region in &placement.regions {
+        let Some(name) = region.content.strip_prefix("site:") else {
+            continue;
+        };
+        let mut components = site(&snapshot.view, name)
+            .map(|site| site.components.clone())
+            .unwrap_or_default();
+        fill_heights(
+            &mut components,
+            region.area.width.saturating_sub(2),
+            region.area.height.saturating_sub(2),
+        );
+        render_site(
+            region.area,
+            &components,
+            style,
+            buffer,
+            &mut interaction,
+            Some(
+                Block::default()
+                    .borders(Borders::ALL)
+                    .border_type(border_type(&snapshot.view.theme))
+                    .title(name.to_owned()),
+            ),
+            false,
+        );
+    }
+    for bar in &placement.tabs {
+        let spans = crate::mod_layout::tab_line(bar)
+            .into_iter()
+            .map(|(title, active)| {
+                if active {
+                    ratatui::text::Span::styled(title, crate::style::accent_style().bold())
+                } else {
+                    ratatui::text::Span::styled(title, style.dim())
+                }
+            })
+            .collect::<Vec<_>>();
+        Paragraph::new(Line::from(spans)).render(bar.area, buffer);
+    }
+    render_dialog(screen, snapshot, style, buffer, &mut interaction);
+    highlight_focus(buffer, &interaction);
+}
+
+pub(crate) fn footer_lines(width: u16) -> Vec<Line<'static>> {
+    let snapshot = snapshot();
+    let style = panel_style(&snapshot.view);
+    let mut lines = if let Some(site) = site(&snapshot.view, "above_composer") {
+        let mut interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        component_rows(&site.components, width, &mut interaction, 0)
+            .into_iter()
+            .map(|row| row.line.patch_style(style))
+            .collect()
+    } else if let Some(footer) = &snapshot.view.footer {
+        panel_lines(footer)
+            .into_iter()
+            .map(|line| line.patch_style(style))
+            .collect()
+    } else {
+        Vec::new()
+    };
+    lines.extend(
+        live_notices(NoticePlacement::Toast)
+            .into_iter()
+            .map(|notice| {
+                let mut spans = crate::history_cell::notice_spans(notice.kind, &notice.text);
+                spans.push(format!(" ({})", notice.owner).dark_gray());
+                Line::from(spans)
+            }),
+    );
+    lines
+}
