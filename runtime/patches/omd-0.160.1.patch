+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum NoticePlacement {
+    Toast,
+    Status,
+}
+
+#[derive(Clone)]
+pub(crate) struct Notice {
+    owner: String,
+    id: Option<String>,
+    kind: &'static str,
+    placement: NoticePlacement,
+    text: String,
+    expires: std::time::Instant,
+}
+
+static NOTICES: Mutex<(Vec<Notice>, u64)> = Mutex::new((Vec::new(), 0));
+static SEEN_NOTICES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Shows a toast or status notice until its lifetime ends; the same owner and id replace it.
+pub(crate) fn notice(
+    owner: &str,
+    id: Option<&str>,
+    kind: &str,
+    placement: NoticePlacement,
+    text: &str,
+    ttl: std::time::Duration,
+) {
+    let mut notices = NOTICES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    notices
+        .0
+        .retain(|notice| id.is_none() || notice.owner != owner || notice.id.as_deref() != id);
+    if notices
+        .0
+        .iter()
+        .filter(|notice| notice.owner == owner)
+        .count()
+        >= 4
+    {
+        let oldest = notices.0.iter().position(|notice| notice.owner == owner);
+        if let Some(oldest) = oldest {
+            notices.0.remove(oldest);
+        }
+    }
+    notices.0.push(Notice {
+        owner: owner.to_owned(),
+        id: id.map(str::to_owned),
+        kind: crate::history_cell::notice_kind(kind),
+        placement,
+        text: text.to_owned(),
+        expires: std::time::Instant::now() + ttl,
+    });
+    notices.1 += 1;
+}
+
+pub(crate) fn clear_notice(owner: &str, id: &str) -> bool {
+    let mut notices = NOTICES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let count = notices.0.len();
+    notices
+        .0
+        .retain(|notice| notice.owner != owner || notice.id.as_deref() != Some(id));
+    let cleared = notices.0.len() != count;
+    if cleared {
+        notices.1 += 1;
+    }
+    cleared
+}
+
+fn live_notices(placement: NoticePlacement) -> Vec<Notice> {
+    let mut notices = NOTICES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let now = std::time::Instant::now();
+    let count = notices.0.len();
+    notices.0.retain(|notice| notice.expires > now);
+    if notices.0.len() != count {
+        notices.1 += 1;
+    }
+    notices
+        .0
+        .iter()
+        .filter(|notice| notice.placement == placement)
+        .rev()
+        .take(3)
+        .cloned()
+        .collect()
+}
+
+/// True once after notices were added, cleared or expired.
+pub(crate) fn notices_changed() -> bool {
+    live_notices(NoticePlacement::Status);
+    let revision = NOTICES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .1;
+    SEEN_NOTICES.swap(revision, std::sync::atomic::Ordering::Relaxed) != revision
+}
+
+pub(crate) fn key_name(key: KeyEvent) -> Option<String> {
+    if key.kind != KeyEventKind::Press {
+        return None;
+    }
+    let mut modifiers = key.modifiers;
+    let base = match key.code {
+        KeyCode::F(number) => format!("F{number}"),
+        KeyCode::Char(' ') => "Space".to_owned(),
+        KeyCode::Char(character) if character.is_ascii_alphanumeric() => {
+            character.to_ascii_lowercase().to_string()
+        }
+        KeyCode::BackTab => {
+            modifiers |= KeyModifiers::SHIFT;
+            "Tab".to_owned()
+        }
+        KeyCode::Up => "Up".to_owned(),
+        KeyCode::Down => "Down".to_owned(),
+        KeyCode::Left => "Left".to_owned(),
+        KeyCode::Right => "Right".to_owned(),
+        KeyCode::Home => "Home".to_owned(),
+        KeyCode::End => "End".to_owned(),
+        KeyCode::PageUp => "PageUp".to_owned(),
+        KeyCode::PageDown => "PageDown".to_owned(),
+        KeyCode::Delete => "Delete".to_owned(),
+        KeyCode::Insert => "Insert".to_owned(),
+        KeyCode::Tab => "Tab".to_owned(),
+        KeyCode::Enter => "Enter".to_owned(),
+        KeyCode::Esc => "Esc".to_owned(),
+        KeyCode::Backspace => "Backspace".to_owned(),
+        _ => return None,
+    };
+    let mut name = String::new();
+    for (modifier, label) in [
+        (KeyModifiers::CONTROL, "Ctrl+"),
+        (KeyModifiers::ALT, "Alt+"),
+        (KeyModifiers::SHIFT, "Shift+"),
+    ] {
+        if modifiers.contains(modifier) {
+            name.push_str(label);
+        }
+    }
+    name.push_str(&base);
+    Some(name)
+}
+
+pub(crate) fn action_for(view: &ModView, key: KeyEvent) -> Option<(String, ModKeyAction)> {
+    let name = key_name(key)?;
+    if !codex_omd::mod_key_name(&name) {
+        return None;
+    }
+    let action = view.keybindings.get(&name).cloned()?;
+    Some((name, action))
+}
+
+fn command_action(action: &ModCommandAction, value: Option<&str>) -> ModKeyAction {
+    let args = match value {
+        Some(value) if action.args.is_empty() => value.to_owned(),
+        Some(value) => format!("{} {value}", action.args),
+        None => action.args.clone(),
+    };
+    ModKeyAction::Command {
+        command: action.command.clone(),
+        args,
+    }
+}
+
+fn activate_target(
+    id: &str,
+    label: &str,
+    target: &ComponentTarget,
+    interaction: &mut Interaction,
+) -> Option<ModInput> {
+    match target {
+        ComponentTarget::Button(action) => Some(ModInput::Interaction(
+            label.to_owned(),
+            component_action(action),
+        )),
+        ComponentTarget::Input(action) => {
+            let value = interaction.input_values.get(id).map(String::as_str);
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                command_action(action, value),
+            ))
+        }
+        ComponentTarget::Select { action, options }
+        | ComponentTarget::ListRow {
+            action, options, ..
+        } => {
+            let selected = *interaction.selected.get(id).unwrap_or(&0);
+            let value = options.get(selected).map(|option| option.0.as_str());
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                command_action(action, value),
+            ))
+        }
+        ComponentTarget::Multiselect {
+            action, options, ..
+        } => {
+            let checked = interaction.checked.get(id);
+            let values = options
+                .iter()
+                .filter(|(value, _)| checked.is_some_and(|checked| checked.contains(value)))
+                .map(|(value, _)| value)
+                .collect::<Vec<_>>();
+            let values = serde_json::to_string(&values).unwrap_or_default();
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                command_action(action, Some(&values)),
+            ))
+        }
+        ComponentTarget::Terminal(_) => Some(ModInput::Consumed),
+        ComponentTarget::Pane => {
+            let collapsed = interaction.collapsed.entry(id.to_owned()).or_default();
+            *collapsed = !*collapsed;
+            Some(ModInput::Consumed)
+        }
+        ComponentTarget::Document(action) => {
+            let argument =
+                crate::mod_components::handle(id, crate::mod_document::DocumentKey::Activate)
+                    .and_then(|(_, argument)| argument);
+            match (action, argument) {
+                (Some(action), Some(argument)) => Some(ModInput::Interaction(
+                    label.to_owned(),
+                    command_action(action, Some(&argument)),
+                )),
+                _ => Some(ModInput::Consumed),
+            }
+        }
+    }
+}
+
+pub(crate) fn focus(id: &str) -> bool {
+    observed(|| focus_unobserved(id))
+}
+
+fn focus_unobserved(id: &str) -> bool {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if !interaction.ids.contains(id) {
+        return false;
+    }
+    interaction.focused = Some(id.to_owned());
+    true
+}
+
+pub(crate) fn input(key: KeyEvent) -> Option<ModInput> {
+    observed(|| handle_input(key))
+}
+
+fn handle_input(key: KeyEvent) -> Option<ModInput> {
+    if key.kind != KeyEventKind::Press {
+        return None;
+    }
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let escape = (key.code, key.modifiers) == (KeyCode::Esc, KeyModifiers::NONE);
+    let in_terminal = interaction.focused.as_ref().is_some_and(|focused| {
+        matches!(
+            interaction.targets.get(focused),
+            Some(ComponentTarget::Terminal(_))
+        )
+    });
+    if (escape && !in_terminal) || crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key) {
+        let dialog = interaction
+            .dialog
+            .clone()
+            .filter(|dialog| interaction.dismissed.as_ref() != Some(dialog));
+        if dialog.is_some() || interaction.focused.is_some() {
+            if let Some(focused) = interaction.focused.take()
+                && escape
+            {
+                crate::mod_surface::input_event(
+                    &focused,
+                    serde_json::json!({"key": "Esc", "text": null}),
+                );
+            }
+            interaction.dismissed = dialog.or(interaction.dismissed.take());
+            return Some(ModInput::Consumed);
+        }
+    }
+    if matches!(
+        (key.code, key.modifiers),
+        (KeyCode::Tab, KeyModifiers::NONE) | (KeyCode::BackTab, KeyModifiers::SHIFT)
+    ) && interaction.focused.is_none()
+        && !interaction.order.is_empty()
+    {
+        interaction.focused = if key.code == KeyCode::BackTab {
+            interaction.order.last().cloned()
+        } else {
+            interaction.order.first().cloned()
+        };
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(ComponentTarget::Terminal(session)) = interaction.targets.get(&focused)
+    {
+        if crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key) {
+            interaction.focused = None;
+        } else {
+            crate::mod_pty::key(&interaction.owners, session, key);
+        }
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && interaction.key_panes.contains(&focused)
+    {
+        if (key.code, key.modifiers) == (KeyCode::Char('c'), KeyModifiers::CONTROL) {
+            interaction.focused = None;
+            return None;
+        }
+        if crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key) {
+            interaction.focused = None;
+        } else {
+            let text = match key.code {
+                KeyCode::Char(character)
+                    if !key
+                        .modifiers
+                        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT) =>
+                {
+                    Some(character.to_string())
+                }
+                _ => None,
+            };
+            let name = key_name(key);
+            if name.is_some() || text.is_some() {
+                crate::mod_surface::input_event(
+                    &focused,
+                    serde_json::json!({"key": name, "text": text}),
+                );
+            }
+        }
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(ComponentTarget::Document(_)) = interaction.targets.get(&focused)
+        && !matches!(key.code, KeyCode::Tab | KeyCode::BackTab | KeyCode::Enter)
+        && let Some(document_key) = crate::mod_components::key(key.code, key.modifiers)
+    {
+        crate::mod_components::handle(&focused, document_key);
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && matches!(
+            interaction.targets.get(&focused),
+            Some(ComponentTarget::Input(_))
+        )
+        && !key
+            .modifiers
+            .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT)
+        && edit_input(&mut interaction, &focused, key.code)
+    {
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(target) = interaction.targets.get(&focused).cloned()
+    {
+        match (key.code, key.modifiers) {
+            (KeyCode::Tab, KeyModifiers::NONE) | (KeyCode::BackTab, KeyModifiers::SHIFT) => {
+                let mut index = interaction
+                    .order
+                    .iter()
+                    .position(|id| id == &focused)
+                    .unwrap_or_default();
+                if key.code == KeyCode::BackTab {
+                    index = index
+                        .checked_sub(1)
+                        .unwrap_or(interaction.order.len().saturating_sub(1));
+                } else if !interaction.order.is_empty() {
+                    index = (index + 1) % interaction.order.len();
+                }
+                interaction.focused = interaction.order.get(index).cloned();
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Char(' '), KeyModifiers::NONE)
+                if matches!(target, ComponentTarget::Multiselect { .. }) =>
+            {
+                toggle(&mut interaction, &focused, &target);
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Enter, KeyModifiers::NONE) | (KeyCode::Char(' '), KeyModifiers::NONE)
+                if key.code == KeyCode::Enter
+                    || matches!(target, ComponentTarget::ListRow { .. }) =>
+            {
+                let label = interaction
+                    .hitboxes
+                    .iter()
+                    .find(|hitbox| hitbox.id == focused)
+                    .map(|hitbox| hitbox.label.clone())
+                    .unwrap_or_else(|| focused.clone());
+                return activate_target(&focused, &label, &target, &mut interaction);
+            }
+            (KeyCode::Left | KeyCode::Up, KeyModifiers::NONE) => match target {
+                ComponentTarget::Select { ref options, .. }
+                | ComponentTarget::ListRow { ref options, .. }
+                | ComponentTarget::Multiselect { ref options, .. } => {
+                    let selected = interaction.selected.entry(focused).or_default();
+                    *selected = selected
+                        .checked_sub(1)
+                        .unwrap_or(options.len().saturating_sub(1));
+                    return Some(ModInput::Consumed);
+                }
+                ComponentTarget::Pane => {
+                    let scroll = interaction.scroll.entry(focused).or_default();
+                    *scroll = scroll.saturating_sub(1);
+                    return Some(ModInput::Consumed);
+                }
+                _ => {}
+            },
+            (KeyCode::Right | KeyCode::Down, KeyModifiers::NONE) => match target {
+                ComponentTarget::Select { ref options, .. }
+                | ComponentTarget::ListRow { ref options, .. }
+                | ComponentTarget::Multiselect { ref options, .. } => {
+                    let selected = interaction.selected.entry(focused).or_default();
+                    if !options.is_empty() {
+                        *selected = (*selected + 1) % options.len();
+                    }
+                    return Some(ModInput::Consumed);
+                }
+                ComponentTarget::Pane => {
+                    let scroll = interaction.scroll.entry(focused).or_default();
+                    *scroll = scroll.saturating_add(1);
+                    return Some(ModInput::Consumed);
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+    }
+    let editing = interaction.focused.as_ref().is_some_and(|focused| {
+        matches!(
+            interaction.targets.get(focused),
+            Some(ComponentTarget::Input(_))
+        )
+    });
+    if !editing
+        && let Some(name) = key_name(key).filter(|name| codex_omd::mod_key_name(name))
+        && let Some((id, target)) = interaction
+            .hotkeys
+            .iter()
+            .find(|(bound, _)| *bound == name)
+            .and_then(|(_, id)| Some((id.clone(), interaction.targets.get(id)?.clone())))
+    {
+        let action = match target {
+            ComponentTarget::Button(action) => component_action(&action),
+            _ => ModKeyAction::Focus { focus: id },
+        };
+        return Some(ModInput::Binding(name, action));
+    }
+    with_cache(|cache| action_for(&cache.snapshot.view, key))
+        .flatten()
+        .map(|(name, action)| ModInput::Binding(name, action))
+}
+
+fn toggle(interaction: &mut Interaction, id: &str, target: &ComponentTarget) {
+    let ComponentTarget::Multiselect { options, .. } = target else {
+        return;
+    };
+    let index = interaction.selected.get(id).copied().unwrap_or_default();
+    let Some((value, _)) = options.get(index) else {
+        return;
+    };
+    let checked = interaction.checked.entry(id.to_owned()).or_default();
+    if !checked.remove(value) {
+        checked.insert(value.clone());
+    }
+}
+
+/// True while a mod component has focus or a mod dialog is on screen.
+pub(crate) fn holds_keys() -> bool {
+    let interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction
+        .focused
+        .as_ref()
+        .is_some_and(|focused| interaction.targets.contains_key(focused))
+        || (interaction.dialog_area.is_some() && interaction.dialog != interaction.dismissed)
+}
+
+/// Lets a mod command reopen and focus a dialog the user dismissed.
+pub(crate) fn reopen_dialogs() {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction.dialog = None;
+    interaction.dismissed = None;
+}
+
+pub(crate) fn component_owner(component: &str) -> Option<String> {
+    INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .component_owners
+        .get(component)
+        .cloned()
+}
+
+/// Edits a focused mod input at its cursor; returns false for keys inputs do not handle.
+fn edit_input(interaction: &mut Interaction, id: &str, code: KeyCode) -> bool {
+    let value = interaction
+        .input_values
+        .get(id)
+        .cloned()
+        .unwrap_or_default();
+    let length = value.chars().count();
+    let cursor = interaction
+        .input_cursor
+        .get(id)
+        .copied()
+        .unwrap_or(length)
+        .min(length);
+    let byte = |index: usize| {
+        value
+            .char_indices()
+            .nth(index)
+            .map_or(value.len(), |(at, _)| at)
+    };
+    let mut next = value.clone();
+    let cursor = match code {
+        KeyCode::Char(character) => {
+            if value.len() + character.len_utf8() > 1024 {
+                return true;
+            }
+            next.insert(byte(cursor), character);
+            cursor + 1
+        }
+        KeyCode::Backspace if cursor > 0 => {
+            next.remove(byte(cursor - 1));
+            cursor - 1
+        }
+        KeyCode::Delete if cursor < length => {
+            next.remove(byte(cursor));
+            cursor
+        }
+        KeyCode::Backspace | KeyCode::Delete => cursor,
+        KeyCode::Left => cursor.saturating_sub(1),
+        KeyCode::Right => (cursor + 1).min(length),
+        KeyCode::Home => 0,
+        KeyCode::End => length,
+        _ => return false,
+    };
+    interaction.input_values.insert(id.to_owned(), next);
+    interaction.input_cursor.insert(id.to_owned(), cursor);
+    true
+}
+
+pub(crate) fn paste(text: &str) -> bool {
+    observed(|| handle_paste(text))
+}
+
+fn handle_paste(text: &str) -> bool {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let Some(focused) = interaction.focused.clone() else {
+        return false;
+    };
+    if matches!(
+        interaction.targets.get(&focused),
+        Some(ComponentTarget::Input(_))
+    ) {
+        for character in text.chars().take(1024) {
+            let character = if character.is_control() {
+                ' '
+            } else {
+                character
+            };
+            edit_input(&mut interaction, &focused, KeyCode::Char(character));
+        }
+        return true;
+    }
+    let bounded = &text[..text.floor_char_boundary(PASTE_BYTES)];
+    if let Some(ComponentTarget::Terminal(session)) = interaction.targets.get(&focused) {
+        crate::mod_pty::paste(&interaction.owners, session, bounded);
+        return true;
+    }
+    if !interaction.key_panes.contains(&focused) {
+        return false;
+    }
+    let mut event = serde_json::json!({"paste": bounded});
+    if bounded.len() < text.len() {
+        event["truncated"] = true.into();
+    }
+    crate::mod_surface::input_event(&focused, event);
+    true
+}
+
+fn contains(area: Rect, column: u16, row: u16) -> bool {
+    column >= area.x && column < area.right() && row >= area.y && row < area.bottom()
+}
+
+pub(crate) fn pointer(event: MouseEvent) -> Option<ModPointer> {
+    if crate::mod_layout::pointer(event) {
+        return Some(ModPointer::Consumed);
+    }
+    observed(|| handle_pointer(event))
+}
+
+fn handle_pointer(event: MouseEvent) -> Option<ModPointer> {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let hit = interaction
+        .hitboxes
+        .iter()
+        .find(|hitbox| contains(hitbox.area, event.column, event.row))
+        .cloned();
+    let action = match event.kind {
+        MouseEventKind::Down(button) => Some(("down", Some(button))),
+        MouseEventKind::Up(button) => Some(("up", Some(button))),
+        MouseEventKind::ScrollUp => Some(("scroll_up", None)),
+        MouseEventKind::ScrollDown => Some(("scroll_down", None)),
+        _ => None,
+    };
+    if let (Some(hit), Some((action, button))) = (&hit, action) {
+        crate::mod_surface::component_event(
+            serde_json::json!({"component": hit.id, "kind": "pointer",
+            "pointer": {"column": event.column.saturating_sub(hit.area.x), "row": event.row.saturating_sub(hit.area.y),
+                "action": action,
+                "button": button.map(|button| match button {
+                    MouseButton::Left => "left",
+                    MouseButton::Right => "right",
+                    MouseButton::Middle => "middle",
+                })}}),
+        );
+    }
+    let Some(hit) = hit else {
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {
+            interaction.focused = None;
+            if interaction
+                .dialog_area
+                .is_some_and(|area| !contains(area, event.column, event.row))
+            {
+                interaction.dismissed = interaction.dialog.clone();
+            }
+        }
+        return None;
+    };
+    match event.kind {
+        MouseEventKind::Down(MouseButton::Left) => {
+            interaction.focused = Some(hit.id);
+            Some(ModPointer::Consumed)
+        }
+        MouseEventKind::Up(MouseButton::Left) => {
+            interaction.focused = Some(hit.id.clone());
+            if let ComponentTarget::Multiselect { index, .. } = hit.target {
+                interaction.selected.insert(hit.id.clone(), index);
+                toggle(&mut interaction, &hit.id, &hit.target);
+                return Some(ModPointer::Consumed);
+            }
+            if let ComponentTarget::ListRow { index, .. } = hit.target {
+                interaction.selected.insert(hit.id.clone(), index);
+            }
+            activate_target(&hit.id, &hit.label, &hit.target, &mut interaction).map(|input| {
+                match input {
+                    ModInput::Consumed => ModPointer::Consumed,
+                    ModInput::Interaction(name, action) | ModInput::Binding(name, action) => {
+                        ModPointer::Action(name, action)
+                    }
+                }
+            })
+        }
+        MouseEventKind::ScrollUp => {
+            match hit.target {
+                ComponentTarget::Select { ref options, .. }
+                | ComponentTarget::ListRow { ref options, .. }
+                | ComponentTarget::Multiselect { ref options, .. } => {
+                    let selected = interaction.selected.entry(hit.id).or_default();
+                    *selected = selected
+                        .checked_sub(1)
+                        .unwrap_or(options.len().saturating_sub(1));
+                }
+                ComponentTarget::Pane => {
+                    let scroll = interaction.scroll.entry(hit.id).or_default();
+                    *scroll = scroll.saturating_sub(1);
+                }
+                _ => {}
+            }
+            Some(ModPointer::Consumed)
+        }
+        MouseEventKind::ScrollDown => {
+            match hit.target {
+                ComponentTarget::Select { ref options, .. }
+                | ComponentTarget::ListRow { ref options, .. }
+                | ComponentTarget::Multiselect { ref options, .. } => {
+                    let selected = interaction.selected.entry(hit.id).or_default();
+                    if !options.is_empty() {
+                        *selected = (*selected + 1) % options.len();
+                    }
+                }
+                ComponentTarget::Pane => {
+                    let scroll = interaction.scroll.entry(hit.id).or_default();
+                    *scroll = scroll.saturating_add(1);
+                }
+                _ => {}
+            }
+            Some(ModPointer::Consumed)
+        }
+        _ => Some(ModPointer::Consumed),
+    }
+}
