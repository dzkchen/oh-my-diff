+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use crate::ExtensionData;
+
+/// Position of one call inside a model response batch.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ToolBatchPosition {
+    pub id: String,
+    pub index: usize,
+    pub size: usize,
+}
+
+/// Host facts about one pending call that the tool payload does not carry.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ToolCallFact {
+    pub schema: Option<serde_json::Value>,
+    pub batch: Option<ToolBatchPosition>,
+}
+
+/// Pending-call facts keyed by call id, kept in the turn store.
+#[derive(Debug, Default)]
+pub struct ToolCallFacts(pub Mutex<HashMap<String, ToolCallFact>>);
+
+impl ToolCallFacts {
+    pub fn get(&self, call_id: &str) -> Option<ToolCallFact> {
+        self.0.lock().ok()?.get(call_id).cloned()
+    }
+}
+
+/// One deferred call offered to a batch contributor.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ToolBatchCall {
+    pub call_id: String,
+    pub tool: String,
+    pub arguments: String,
+    pub parallel_safe: bool,
+}
+
+/// Calls from one model response that the host deferred before dispatch.
+pub struct ToolBatchInput<'a> {
+    pub thread_store: &'a ExtensionData,
+    pub turn_id: &'a str,
+    pub batch_id: &'a str,
+    pub calls: &'a [ToolBatchCall],
+}
+
+/// Calls to run once as a single call to `tool`; the result object is keyed by call id.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ToolBatchMerge {
+    pub call_ids: Vec<String>,
+    pub tool: String,
+    pub arguments: String,
+}
