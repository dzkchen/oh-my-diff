+pub(crate) fn render_inline(
+    area: Rect,
+    chat: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+) {
+    render_backdrop(chat, chat, buffer, snapshot, false);
+    render(area, chat, buffer, snapshot);
