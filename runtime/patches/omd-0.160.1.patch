+use super::*;
+
+#[test]
+fn status_does_not_create_or_rewrite_consent_documents() {
+    let root = tempfile::tempdir().unwrap();
+    assert!(
+        status(root.path(), "empty", "owner", "id")
+            .unwrap()
+            .is_none()
+    );
+    assert!(!root.path().join("consents/empty.json").exists());
+    grant(root.path(), "t1", "owner", "digest", "id").unwrap();
+    let path = root.path().join("consents/t1.json");
+    let original = format!("{}\n", fs::read_to_string(&path).unwrap());
+    fs::write(&path, &original).unwrap();
+    assert!(status(root.path(), "t1", "owner", "id").unwrap().is_some());
+    assert_eq!(fs::read_to_string(&path).unwrap(), original);
+}
+
+#[test]
+fn failed_replacement_preserves_the_previous_consent_document() {
+    use std::os::unix::fs::PermissionsExt;
+    let root = tempfile::tempdir().unwrap();
+    grant(root.path(), "thread", "owner", "digest", "id").unwrap();
+    let directory = root.path().join("consents");
+    let path = directory.join("thread.json");
+    let original = fs::read(&path).unwrap();
+    let result = with(root.path(), "thread", |consents| {
+        consents.clear();
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o500))
+    });
+    fs::set_permissions(&directory, fs::Permissions::from_mode(0o700)).unwrap();
+    assert!(result.is_err());
+    assert_eq!(fs::read(path).unwrap(), original);
+    assert!(
+        status(root.path(), "thread", "owner", "id")
+            .unwrap()
+            .is_some()
+    );
+}
+
+#[test]
+fn concurrent_status_reads_observe_complete_atomic_documents() {
+    let root = tempfile::tempdir().unwrap();
+    std::thread::scope(|scope| {
+        let writers: Vec<_> = (0..2)
+            .map(|writer| {
+                let root = root.path();
+                scope.spawn(move || {
+                    for number in 0..20 {
+                        grant(
+                            root,
+                            "thread",
+                            &format!("owner{writer}"),
+                            "digest",
+                            &format!("{writer}-{number}"),
+                        )
+                        .unwrap();
+                    }
+                })
+            })
+            .collect();
+        while writers.iter().any(|writer| !writer.is_finished()) {
+            status(root.path(), "thread", "owner0", "0-0").unwrap();
+        }
+        for writer in writers {
+            writer.join().unwrap();
+        }
+    });
+    assert_eq!(
+        read(&root.path().join("consents/thread.json"))
+            .unwrap()
+            .len(),
+        40
+    );
+}
+
+#[test]
+fn consent_status_preserves_the_recovery_document() {
+    use std::os::unix::fs::MetadataExt;
+    let root = tempfile::tempdir().unwrap();
+    grant(root.path(), "thread", "owner", "hash", "id").unwrap();
+    let path = root.path().join("consents/thread.json");
+    let bytes = fs::read(&path).unwrap();
+    let before = fs::metadata(&path).unwrap();
+    status(root.path(), "thread", "owner", "id").unwrap();
+    let after = fs::metadata(&path).unwrap();
+    assert_eq!(fs::read(&path).unwrap(), bytes);
+    assert_eq!(
+        (before.ino(), before.mtime_nsec()),
+        (after.ino(), after.mtime_nsec())
+    );
+    consume(root.path(), "thread", "owner", "id", "hash", "client").unwrap();
+    assert_ne!(fs::metadata(&path).unwrap().ino(), before.ino());
+    assert_eq!(
+        serde_json::from_slice::<Vec<Consent>>(&bytes).unwrap()[0].client_id,
+        None
+    );
+}
+
+#[test]
+fn consents_are_single_use_content_bound_and_reconciled_by_client_id() {
+    let root = tempfile::tempdir().unwrap();
+    let root = root.path();
+    let sha = digest("ship it", &[]);
+    grant(root, "t1", "queue", &sha, "c1").unwrap();
+    let spend = |sha: &str, client: &str| consume(root, "t1", "queue", "c1", sha, client);
+    assert_eq!(
+        spend(&digest("ship it now", &[]), "m1")
+            .unwrap_err()
+            .to_string(),
+        "consent_content_changed"
+    );
+    assert!(
+        consume(root, "t1", "other", "c1", &sha, "m1").is_err(),
+        "consents bind their owner"
+    );
+    spend(&sha, "m1").unwrap();
+    assert_eq!(spend(&sha, "m2").unwrap_err().to_string(), "consent_spent");
+    assert_eq!(
+        status(root, "t2", "queue", "c1").unwrap(),
+        None,
+        "consents stay on their thread"
+    );
+    delivered(root, "t1", "m1", "turn-9").unwrap();
+    let consent = status(root, "t1", "queue", "c1").unwrap().unwrap();
+    assert_eq!(
+        (consent.client_id.as_deref(), consent.turn_id.as_deref()),
+        (Some("m1"), Some("turn-9"))
+    );
+    grant(root, "t1", "queue", &sha, "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m3").unwrap();
+    restore(root, "t1", "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m4").unwrap();
+    assert_eq!(retain(root, "t1", |consent| consent.id != "c1").unwrap(), 1);
+    assert_eq!(
+        retain(root, "t1", |consent| consent.owner != "queue").unwrap(),
+        1
+    );
+    assert!(grant(root, "../escape", "queue", &sha, "c3").is_err());
+}
+
+#[test]
+fn reads_and_unmatched_deliveries_leave_the_file_untouched() {
+    let root = tempfile::tempdir().unwrap();
+    let root = root.path();
+    grant(root, "t1", "queue", &digest("ship it", &[]), "c1").unwrap();
+    let path = root.join("consents").join("t1.json");
+    let modified = || fs::metadata(&path).unwrap().modified().unwrap();
+    let before = modified();
+    std::thread::sleep(std::time::Duration::from_millis(20));
+    status(root, "t1", "queue", "c1").unwrap();
+    delivered(root, "t1", "no-such-message", "turn-1").unwrap();
+    assert_eq!(modified(), before);
+    grant(root, "t1", "queue", &digest("again", &[]), "c2").unwrap();
+    assert_ne!(modified(), before, "a real change is still written");
+}
diff --git a/codex-rs/omd/src/contract_cli.rs b/codex-rs/omd/src/contract_cli.rs
new file mode 100644
index 000000000..948462abe
--- /dev/null
+++ b/codex-rs/omd/src/contract_cli.rs
@@ -0,0 +1,143 @@
+use crate::ContractDocument;
+use crate::ContractResolution;
+use crate::ContractSelection;
+use crate::ModHost;
+use crate::PolicyOwner;
+use serde_json::Value;
+use serde_json::json;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub fn documents(store: &Path) -> io::Result<Vec<(ContractDocument, PolicyOwner)>> {
+    let root = store.canonicalize()?;
+    Ok(ModHost::open(root)?.contract_documents())
+}
+
+pub fn user_path(store: &Path) -> io::Result<PathBuf> {
+    let config = store.join("host.json");
+    let configured = match std::fs::read(&config) {
+        Ok(bytes) => serde_json::from_slice::<Value>(&bytes)?["contract"]["user"]
+            .as_str()
+            .map(PathBuf::from),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error),
+    };
+    Ok(configured.unwrap_or_else(|| store.join(crate::USER_CONTRACT_SELECTION)))
+}
+
+pub fn project_path(repository: &Path) -> PathBuf {
+    repository.join(crate::PROJECT_CONTRACT_SELECTION)
+}
+
+pub fn read(path: &Path) -> io::Result<Option<ContractSelection>> {
+    ContractSelection::read(path).map_err(io::Error::other)
+}
+
+pub fn summary(document: &ContractDocument, owner: &PolicyOwner) -> Value {
+    json!({"key": document.key(), "description": document.description, "assurance": document.assurance,
+        "gates": document.gates, "restrict": document.restrict, "digest": document.digest(), "owner": owner})
+}
+
+pub fn effective(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+) -> io::Result<ContractResolution> {
+    let user = read(&user_path(store)?)?;
+    let project = read(&project_path(repository))?;
+    Ok(crate::resolve_contract(
+        documents,
+        user.as_ref(),
+        project.as_ref(),
+    ))
+}
+
+pub fn describe(resolution: &ContractResolution) -> Value {
+    match resolution {
+        ContractResolution::None => {
+            json!({"status": "none", "note": "no contract is selected; completion and integration are not gated"})
+        }
+        ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode,
+        } => json!({"status": "active", "contract": summary(document, owner), "source": source,
+            "overrode": overrode}),
+        ContractResolution::Unavailable(error) => json!({"status": "unavailable", "error": error,
+            "note": "completion and integration fail closed until the selection is fixed"}),
+    }
+}
+
+pub fn find(
+    documents: &[(ContractDocument, PolicyOwner)],
+    key: &str,
+) -> io::Result<(ContractDocument, PolicyOwner)> {
+    documents
+        .iter()
+        .find(|(document, _)| document.key() == key)
+        .cloned()
+        .ok_or_else(|| io::Error::other(format!("no active mod registers contract {key}")))
+}
+
+pub fn current(resolution: &ContractResolution) -> Option<&ContractDocument> {
+    match resolution {
+        ContractResolution::Active { document, .. } => Some(document),
+        _ => None,
+    }
+}
+
+pub fn plan(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+    key: &str,
+) -> io::Result<Value> {
+    let (next, owner) = find(documents, key)?;
+    let resolution = effective(documents, store, repository)?;
+    let before = current(&resolution);
+    let weakens = before.is_some_and(|before| next.weaker_than(before));
+    Ok(
+        json!({"schema": 2, "before": describe(&resolution), "after": summary(&next, &owner),
+        "weakens": weakens,
+        "confirmation": weakens.then(|| crate::contract_confirmation(before, &next)),
+        "note": if weakens {
+            "this selection reduces assurance; pass the confirmation to omd-contract select"
+        } else {
+            "this selection does not reduce assurance"
+        }}),
+    )
+}
+
+pub fn select(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+    key: &str,
+    confirmation: Option<String>,
+) -> io::Result<Value> {
+    let (next, owner) = find(documents, key)?;
+    let resolution = effective(documents, store, repository)?;
+    let before = current(&resolution);
+    if before.is_some_and(|before| next.weaker_than(before))
+        && confirmation.as_deref() != Some(crate::contract_confirmation(before, &next).as_str())
+    {
+        return Err(io::Error::other(
+            "this selection reduces assurance; run omd-contract plan and pass its confirmation",
+        ));
+    }
+    let path = user_path(store)?;
+    ContractSelection {
+        schema: 2,
+        contract: Some(next.key()),
+        contract_digest: Some(next.digest()),
+        confirmation,
+        ..ContractSelection::default()
+    }
+    .write(&path)?;
+    Ok(
+        json!({"schema": 2, "selected": summary(&next, &owner), "path": path,
+        "note": "the selection applies to the next session"}),
+    )
+}
diff --git a/codex-rs/omd/src/contract_document.rs b/codex-rs/omd/src/contract_document.rs
new file mode 100644
index 000000000..2c27d1cd4
--- /dev/null
+++ b/codex-rs/omd/src/contract_document.rs
@@ -0,0 +1,646 @@
+use crate::resource_data::ResourceRef;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const CONTRACT_DOCUMENT_SCHEMA: u32 = 2;
+const REQUIREMENT_LIMIT: usize = 16;
+const FINDING_LIMIT: usize = 32;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, Eq, PartialEq, Ord, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum Producer {
+    #[default]
+    Any,
+    Lead,
+    SeparateAgent,
+    Host,
+    Integration,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq, Ord, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum Binding {
+    Candidate,
+    Acceptance,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum BlockingFindings {
+    #[default]
+    Reject,
+    Allow,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractRequirement {
+    pub receipt: String,
+    #[serde(default)]
+    pub producer: Producer,
+    #[serde(default)]
+    pub bind: Vec<Binding>,
+    #[serde(default)]
+    pub blocking_findings: BlockingFindings,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractGates {
+    #[serde(default)]
+    pub complete: Vec<ContractRequirement>,
+    #[serde(default)]
+    pub integrate: Vec<ContractRequirement>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Gate {
+    Complete,
+    Integrate,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractDocument {
+    pub schema: u32,
+    pub id: String,
+    pub version: u32,
+    pub description: String,
+    pub assurance: String,
+    #[serde(default)]
+    pub gates: ContractGates,
+    #[serde(default)]
+    pub restrict: Vec<String>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ReceiptOutcome {
+    Pass,
+    Fail,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum FindingSeverity {
+    Advice,
+    Warning,
+    Blocking,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReceiptFinding {
+    pub fingerprint: String,
+    pub severity: FindingSeverity,
+    pub summary: String,
+    #[serde(default)]
+    pub paths: Vec<String>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ProducerKind {
+    Lead,
+    Agent,
+    Host,
+    Integration,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReceiptProducer {
+    pub kind: ProducerKind,
+    pub handle: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Receipt {
+    pub kind: String,
+    pub candidate_sha256: String,
+    #[serde(default)]
+    pub acceptance_sha256: Option<String>,
+    pub outcome: ReceiptOutcome,
+    pub evidence: ResourceRef,
+    pub producer: ReceiptProducer,
+    #[serde(default)]
+    pub findings: Vec<ReceiptFinding>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub resolves: Vec<String>,
+    pub submitted_by: String,
+    pub at: u128,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct FindingResolution {
+    pub candidate_sha256: String,
+    pub producer: ReceiptProducer,
+    pub receipt_index: usize,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct FindingLedgerEntry {
+    pub finding: ReceiptFinding,
+    pub reported_candidate_sha256: String,
+    pub acceptance_sha256: String,
+    pub reported_producer: ReceiptProducer,
+    pub report_receipt_index: usize,
+    pub resolution: Option<FindingResolution>,
+}
+
+pub type FindingLedger = BTreeMap<String, FindingLedgerEntry>;
+
+pub fn token(value: &str, limit: usize) -> bool {
+    !value.is_empty()
+        && value.len() <= limit
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'_' | b'-' | b'.')
+        })
+}
+
+pub fn sha256_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
+
+fn canonical(value: &Value) -> Value {
+    match value {
+        Value::Object(object) => {
+            let mut keys = object.keys().collect::<Vec<_>>();
+            keys.sort();
+            Value::Object(
+                keys.into_iter()
+                    .map(|key| (key.clone(), canonical(&object[key])))
+                    .collect(),
+            )
+        }
+        Value::Array(items) => Value::Array(items.iter().map(canonical).collect()),
+        other => other.clone(),
+    }
+}
+
+impl ContractDocument {
+    pub fn parse(value: &Value) -> Result<Self, String> {
+        let document: Self =
+            serde_json::from_value(value.clone()).map_err(|error| error.to_string())?;
+        document.validate()?;
+        Ok(document)
+    }
+
+    pub fn key(&self) -> String {
+        format!("{}@{}", self.id, self.version)
+    }
+
+    pub fn digest(&self) -> String {
+        let value = canonical(&serde_json::to_value(self).unwrap_or(Value::Null));
+        format!(
+            "{:x}",
+            Sha256::digest(serde_json::to_vec(&value).unwrap_or_default())
+        )
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        if self.schema != CONTRACT_DOCUMENT_SCHEMA
+            || !token(&self.id, 64)
+            || self.version == 0
+            || self.description.trim().is_empty()
+            || self.description.len() > 512
+            || self.description.chars().any(char::is_control)
+            || !token(&self.assurance, 64)
+            || self.restrict.len() > 16
+            || self.restrict.iter().collect::<BTreeSet<_>>().len() != self.restrict.len()
+            || self
+                .restrict
+                .iter()
+                .any(|operation| !crate::MOD_HOST_OPERATIONS.contains(&operation.as_str()))
+        {
+            return Err("invalid_contract_document".into());
+        }
+        for requirements in [&self.gates.complete, &self.gates.integrate] {
+            if requirements.len() > REQUIREMENT_LIMIT
+                || requirements
+                    .iter()
+                    .map(|r| &r.receipt)
+                    .collect::<BTreeSet<_>>()
+                    .len()
+                    != requirements.len()
+                || requirements.iter().any(|requirement| {
+                    !token(&requirement.receipt, 64)
+                        || requirement.bind.len() > 2
+                        || requirement.bind.iter().collect::<BTreeSet<_>>().len()
+                            != requirement.bind.len()
+                })
+            {
+                return Err("invalid_contract_requirements".into());
+            }
+        }
+        Ok(())
+    }
+
+    pub fn requirements(&self, gate: Gate) -> &[ContractRequirement] {
+        match gate {
+            Gate::Complete => &self.gates.complete,
+            Gate::Integrate => &self.gates.integrate,
+        }
+    }
+
+    pub fn weaker_than(&self, other: &ContractDocument) -> bool {
+        let covers = |mine: &[ContractRequirement], theirs: &[ContractRequirement]| {
+            theirs.iter().all(|required| {
+                mine.iter().any(|candidate| {
+                    candidate.receipt == required.receipt
+                        && (candidate.producer == required.producer
+                            || required.producer == Producer::Any)
+                        && required
+                            .bind
+                            .iter()
+                            .all(|bind| candidate.bind.contains(bind))
+                        && (candidate.blocking_findings == BlockingFindings::Reject
+                            || required.blocking_findings == BlockingFindings::Allow)
+                })
+            })
+        };
+        !covers(&self.gates.complete, &other.gates.complete)
+            || !covers(&self.gates.integrate, &other.gates.integrate)
+            || other
+                .restrict
+                .iter()
+                .any(|operation| !self.restrict.contains(operation))
+    }
+
+    pub fn missing(
+        &self,
+        gate: Gate,
+        receipts: &[Receipt],
+        candidate_sha256: &str,
+        acceptance_sha256: Option<&str>,
+    ) -> Vec<ContractRequirement> {
+        self.requirements(gate)
+            .iter()
+            .filter(|requirement| {
+                !receipts
+                    .iter()
+                    .rev()
+                    .find(|receipt| {
+                        receipt.kind == requirement.receipt
+                            && (!requirement.bind.contains(&Binding::Candidate)
+                                || receipt.candidate_sha256 == candidate_sha256)
+                            && (!requirement.bind.contains(&Binding::Acceptance)
+                                || acceptance_sha256.is_some()
+                                    && receipt.acceptance_sha256.as_deref() == acceptance_sha256)
+                            && match requirement.producer {
+                                Producer::Any => true,
+                                Producer::Lead => receipt.producer.kind == ProducerKind::Lead,
+                                Producer::SeparateAgent => {
+                                    receipt.producer.kind == ProducerKind::Agent
+                                }
+                                Producer::Host => receipt.producer.kind == ProducerKind::Host,
+                                Producer::Integration => {
+                                    receipt.producer.kind == ProducerKind::Integration
+                                }
+                            }
+                    })
+                    .is_some_and(|receipt| {
+                        receipt.outcome == ReceiptOutcome::Pass
+                            && (requirement.blocking_findings == BlockingFindings::Allow
+                                || !receipt
+                                    .findings
+                                    .iter()
+                                    .any(|finding| finding.severity == FindingSeverity::Blocking))
+                    })
+            })
+            .cloned()
+            .collect()
+    }
+}
+
+impl Receipt {
+    pub fn validate(&self) -> Result<(), String> {
+        if !token(&self.kind, 64)
+            || !sha256_hex(&self.candidate_sha256)
+            || self
+                .acceptance_sha256
+                .as_deref()
+                .is_some_and(|value| !sha256_hex(value))
+            || !sha256_hex(&self.evidence.sha256)
+            || self.findings.len() > FINDING_LIMIT
+            || self.resolves.len() > FINDING_LIMIT
+            || self
+                .findings
+                .iter()
+                .map(|finding| &finding.fingerprint)
+                .collect::<BTreeSet<_>>()
+                .len()
+                != self.findings.len()
+            || self.resolves.iter().collect::<BTreeSet<_>>().len() != self.resolves.len()
+            || self.findings.iter().any(|finding| {
+                !token(&finding.fingerprint, 128)
+                    || finding.summary.is_empty()
+                    || finding.summary.len() > 512
+                    || finding.paths.len() > 32
+                    || finding
+                        .paths
+                        .iter()
+                        .any(|path| path.is_empty() || path.len() > 1024)
+            })
+            || self.resolves.iter().any(|fingerprint| {
+                !token(fingerprint, 128)
+                    || self
+                        .findings
+                        .iter()
+                        .any(|finding| &finding.fingerprint == fingerprint)
+            })
+            || self
+                .findings
+                .iter()
+                .any(|finding| finding.severity == FindingSeverity::Blocking)
+                && self.acceptance_sha256.is_none()
+            || !self.resolves.is_empty()
+                && (self.outcome != ReceiptOutcome::Pass
+                    || self.producer.kind != ProducerKind::Agent
+                    || self.acceptance_sha256.is_none())
+            || (self.producer.kind == ProducerKind::Agent) != self.producer.handle.is_some()
+        {
+            return Err("invalid_receipt".into());
+        }
+        Ok(())
+    }
+}
+
+pub fn apply_finding_receipt(
+    ledger: &mut FindingLedger,
+    receipt: &Receipt,
+    receipt_index: usize,
+) -> Result<(), String> {
+    receipt.validate()?;
+    for fingerprint in &receipt.resolves {
+        let entry = ledger
+            .get(fingerprint)
+            .ok_or("finding_resolution_unknown")?;
+        if entry.resolution.is_some() {
+            return Err("finding_already_resolved".into());
+        }
+        if entry.reported_candidate_sha256 == receipt.candidate_sha256 {
+            return Err("finding_resolution_candidate_unchanged".into());
+        }
+        if receipt.acceptance_sha256.as_deref() != Some(entry.acceptance_sha256.as_str()) {
+            return Err("finding_resolution_acceptance_changed".into());
+        }
+        if entry.reported_producer.kind == ProducerKind::Agent
+            && entry.reported_producer.handle == receipt.producer.handle
+        {
+            return Err("finding_resolution_agent_not_separate".into());
+        }
+    }
+    for fingerprint in &receipt.resolves {
+        ledger
+            .get_mut(fingerprint)
+            .ok_or("finding_resolution_unknown")?
+            .resolution = Some(FindingResolution {
+            candidate_sha256: receipt.candidate_sha256.clone(),
+            producer: receipt.producer.clone(),
+            receipt_index,
+        });
+    }
+    for finding in &receipt.findings {
+        if finding.severity == FindingSeverity::Blocking {
+            if ledger
+                .get(&finding.fingerprint)
+                .is_some_and(|entry| entry.resolution.is_none())
+            {
+                continue;
+            }
+            ledger.insert(
+                finding.fingerprint.clone(),
+                FindingLedgerEntry {
+                    finding: finding.clone(),
+                    reported_candidate_sha256: receipt.candidate_sha256.clone(),
+                    acceptance_sha256: receipt
+                        .acceptance_sha256
+                        .clone()
+                        .ok_or("finding_acceptance_required")?,
+                    reported_producer: receipt.producer.clone(),
+                    report_receipt_index: receipt_index,
+                    resolution: None,
+                },
+            );
+        }
+    }
+    Ok(())
+}
+
+pub fn replay_finding_receipts(receipts: &[Receipt]) -> Result<FindingLedger, String> {
+    let mut ledger = FindingLedger::new();
+    for (index, receipt) in receipts.iter().enumerate() {
+        apply_finding_receipt(&mut ledger, receipt, index)?;
+    }
+    Ok(ledger)
+}
+
+pub const USER_CONTRACT_SELECTION: &str = "contract-selection.json";
+pub const PROJECT_CONTRACT_SELECTION: &str = ".omd/contract-selection.json";
+const SELECTION_BYTES: u64 = 16_384;
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractSelection {
+    pub schema: u32,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub contract: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub contract_digest: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub floor: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub floor_digest: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub confirmation: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+#[allow(clippy::large_enum_variant)]
+pub enum ContractResolution {
+    None,
+    Active {
+        document: ContractDocument,
+        owner: crate::PolicyOwner,
+        source: &'static str,
+        overrode: Option<String>,
+    },
+    Unavailable(String),
+}
+
+impl ContractSelection {
+    fn validate(&self) -> Result<(), String> {
+        let key = |value: &Option<String>| {
+            value.as_deref().is_none_or(|key| {
+                key.split_once('@').is_some_and(|(id, version)| {
+                    token(id, 64) && version.parse::<u32>().is_ok_and(|version| version > 0)
+                })
+            })
+        };
+        let digest = |value: &Option<String>| value.as_deref().is_none_or(sha256_hex);
+        if self.schema != CONTRACT_DOCUMENT_SCHEMA
+            || !key(&self.contract)
+            || !key(&self.floor)
+            || !digest(&self.contract_digest)
+            || !digest(&self.floor_digest)
+            || self.contract.is_none() && self.contract_digest.is_some()
+            || self.floor.is_none() && self.floor_digest.is_some()
+            || self.confirmation.as_deref().is_some_and(|value| {
+                value.len() != 16 || !value.bytes().all(|b| b.is_ascii_hexdigit())
+            })
+        {
+            return Err("invalid_contract_selection".into());
+        }
+        Ok(())
+    }
+
+    pub fn read(path: &std::path::Path) -> Result<Option<Self>, String> {
+        match std::fs::symlink_metadata(path) {
+            Ok(metadata) if metadata.is_file() && metadata.len() <= SELECTION_BYTES => {
+                let selection: Self = serde_json::from_slice(
+                    &std::fs::read(path).map_err(|error| error.to_string())?,
+                )
+                .map_err(|error| format!("invalid contract selection: {error}"))?;
+                selection.validate()?;
+                Ok(Some(selection))
+            }
+            Ok(_) => Err("contract selection must be a bounded regular file".into()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error.to_string()),
+        }
+    }
+
+    pub fn write(&self, path: &std::path::Path) -> std::io::Result<()> {
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+        self.validate().map_err(std::io::Error::other)?;
+        let bytes = serde_json::to_vec_pretty(self)?;
+        let parent = path
+            .parent()
+            .ok_or_else(|| std::io::Error::other("contract selection needs a parent directory"))?;
+        std::fs::create_dir_all(parent)?;
+        let temporary = parent.join(format!(
+            ".contract-selection.{}.{:x}.tmp",
+            std::process::id(),
+            Sha256::digest(&bytes)
+        ));
+        let result = (|| {
+            let mut file = std::fs::OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .mode(0o600)
+                .open(&temporary)?;
+            file.write_all(&bytes)?;
+            file.sync_all()?;
+            std::fs::rename(&temporary, path)?;
+            std::fs::File::open(parent)?.sync_all()
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        result
+    }
+}
+
+pub fn contract_confirmation(from: Option<&ContractDocument>, to: &ContractDocument) -> String {
+    format!(
+        "{:x}",
+        Sha256::digest(
+            format!(
+                "{}\0{}",
+                from.map(ContractDocument::digest).unwrap_or_default(),
+                to.digest()
+            )
+            .as_bytes()
+        )
+    )[..16]
+        .to_owned()
+}
+
+pub fn resolve_contract(
+    documents: &[(ContractDocument, crate::PolicyOwner)],
+    user: Option<&ContractSelection>,
+    project: Option<&ContractSelection>,
+) -> ContractResolution {
+    let find = |key: &str, digest: Option<&String>| {
+        let (document, owner) = documents
+            .iter()
+            .find(|(document, _)| document.key() == key)?;
+        digest
+            .is_none_or(|digest| *digest == document.digest())
+            .then(|| (document.clone(), owner.clone()))
+    };
+    let unavailable = |key: &str| {
+        ContractResolution::Unavailable(format!(
+            "selected contract {key} is not registered by an active mod or its document changed since selection"
+        ))
+    };
+    let floor = project.and_then(|selection| {
+        selection
+            .floor
+            .clone()
+            .map(|key| (key, selection.floor_digest.clone()))
+    });
+    let choice = user
+        .and_then(|selection| {
+            selection
+                .contract
+                .clone()
+                .map(|key| (key, selection.contract_digest.clone(), "user"))
+        })
+        .or_else(|| {
+            project.and_then(|selection| {
+                selection
+                    .contract
+                    .clone()
+                    .map(|key| (key, selection.contract_digest.clone(), "project"))
+            })
+        });
+    let minimum = match &floor {
+        Some((key, digest)) => match find(key, digest.as_ref()) {
+            Some(found) => Some(found),
+            None => return unavailable(key),
+        },
+        None => None,
+    };
+    let Some((key, digest, source)) = choice else {
+        return match minimum {
+            Some((document, owner)) => ContractResolution::Active {
+                document,
+                owner,
+                source: "project_floor",
+                overrode: None,
+            },
+            None => ContractResolution::None,
+        };
+    };
+    let Some((document, owner)) = find(&key, digest.as_ref()) else {
+        return unavailable(&key);
+    };
+    match minimum {
+        Some((floor, floor_owner)) if document.weaker_than(&floor) => ContractResolution::Active {
+            document: floor,
+            owner: floor_owner,
+            source: "project_floor",
+            overrode: Some(key),
+        },
+        _ => ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode: None,
+        },
+    }
+}
