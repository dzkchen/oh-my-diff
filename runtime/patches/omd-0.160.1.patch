+                job: Some(job),
+                consumed: false,
+                task: session.task.clone(),
+                worker: id.clone(),
+                workspace,
+                candidate: request
+                    .snapshot
+                    .as_ref()
+                    .map(|reference| (reference.sha256.clone(), Vec::new())),
+                evidence,
+                resolution: resolution.map(|(binding, _)| binding),
+            })),
+        );
+        admission.transferred = true;
+        Ok(
+            json!({"handle":id,"route":request.route,"permissions":if writable {"isolated_worktree"} else {"read_only"},
+                "parent_history": history.map(|(_, provenance)| provenance)}),
+        )
+    }
+}
+
+async fn until_cancelled(cancelled: &AtomicBool) {
+    while !cancelled.load(Ordering::Acquire) {
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/autonomy.rs b/codex-rs/ext/omd/src/mods/autonomy.rs
new file mode 100644
index 000000000..d21cb4ba8
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/autonomy.rs
@@ -0,0 +1,420 @@
+use super::*;
+use codex_protocol::turn_input::StartIfIdleSubmission;
+use codex_protocol::turn_input::TurnInputRequest;
+use codex_protocol::user_input::UserInput;
+use std::time::Duration;
+
+const PRIORITIES: [&str; 3] = ["high", "normal", "low"];
+const CONTINUATION_LIMIT: u32 = 4;
+const IDLE_GRACE: Duration = Duration::from_secs(1);
+
+#[derive(Clone)]
+pub(super) struct Entry {
+    owner: String,
+    source_sha256: String,
+    event: String,
+    key: String,
+    prompt: String,
+    priority: usize,
+    deadline_ms: Option<u64>,
+    queued_at_ms: u64,
+    sequence: u64,
+}
+
+impl Entry {
+    pub(super) fn view(&self) -> Value {
+        json!({"key": self.key, "priority": PRIORITIES[self.priority], "event": self.event,
+            "queued_at_ms": self.queued_at_ms, "deadline_ms": self.deadline_ms})
+    }
+}
+
+fn message(entry: &Entry) -> String {
+    format!(
+        "[Queued by mod {} on {} (key {}); not typed by the user]\n{}",
+        entry.owner, entry.event, entry.key, entry.prompt
+    )
+}
+
+#[derive(Default)]
+pub(super) struct Queue {
+    entries: Vec<Entry>,
+    paused: bool,
+    sequence: u64,
+    pub(super) started: BTreeMap<String, u32>,
+    spent: BTreeMap<String, u64>,
+    pub(super) running: Option<String>,
+    submitting: Option<(String, Value)>,
+    continued: BTreeMap<(String, String), u32>,
+    dispatching: bool,
+    woken: bool,
+}
+
+impl Queue {
+    /// Drops entries their owner can no longer run and takes the best remaining one.
+    pub(super) fn pick(
+        &mut self,
+        grants: &BTreeMap<String, codex_omd::ModGrants>,
+        now: u64,
+        notices: &mut Vec<(String, Value)>,
+    ) -> Option<Entry> {
+        if self.paused || self.running.is_some() {
+            return None;
+        }
+        let mut kept = Vec::new();
+        for entry in self.entries.drain(..) {
+            let grant = grants
+                .get(&entry.owner)
+                .filter(|grant| grant.source_sha256 == entry.source_sha256);
+            let started = self.started.get(&entry.owner).copied().unwrap_or(0);
+            let spent = self.spent.get(&entry.owner).copied().unwrap_or(0);
+            let reason = match grant.map(|grant| grant.autonomy.as_ref()) {
+                None => Some(("dropped", "stale_generation")),
+                Some(None) => Some(("dropped", "grant_expired")),
+                Some(Some(_)) if entry.deadline_ms.is_some_and(|deadline| deadline < now) => {
+                    Some(("expired", "deadline_passed"))
+                }
+                Some(Some(autonomy)) if started >= autonomy.max_turns => {
+                    Some(("denied", "turn_budget_exhausted"))
+                }
+                Some(Some(autonomy))
+                    if autonomy.spend_microusd.is_some_and(|limit| spent >= limit) =>
+                {
+                    Some(("denied", "spend_budget_exhausted"))
+                }
+                Some(Some(_)) => None,
+            };
+            match reason {
+                Some((status, reason)) => notices.push((
+                    entry.owner.clone(),
+                    json!({"key": entry.key, "status": status, "reason": reason}),
+                )),
+                None => kept.push(entry),
+            }
+        }
+        self.entries = kept;
+        let best = self
+            .entries
+            .iter()
+            .enumerate()
+            .min_by_key(|(_, entry)| (entry.priority, entry.sequence))
+            .map(|(index, _)| index)?;
+        let entry = self.entries.remove(best);
+        self.running = Some(entry.owner.clone());
+        self.dispatching = true;
+        self.woken = false;
+        self.submitting = Some((
+            message(&entry),
+            json!({"kind": "mod", "package": entry.owner, "sha256": entry.source_sha256,
+                "event": entry.event, "key": entry.key}),
+        ));
+        Some(entry)
+    }
+}
+
+/// Per-thread queues of mod prompts that start turns while the user is idle.
+#[derive(Default)]
+pub(super) struct Queues {
+    threads: Mutex<BTreeMap<String, Queue>>,
+}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64)
+}
+
+fn notify(core: &Arc<Core>, lead: &Lead, owner: String, payload: Value) {
+    let (core, lead) = (core.clone(), lead.clone());
+    tokio::spawn(async move {
+        expansion::invoke_one(&core, &lead, owner, "turn_queue", payload).await;
+    });
+}
+
+impl Queues {
+    pub(super) fn with<T>(
+        &self,
+        thread: &str,
+        change: impl FnOnce(&mut Queue) -> T,
+    ) -> Result<T, String> {
+        let mut threads = self.threads.lock().map_err(|_| "turn_queue_poisoned")?;
+        Ok(change(threads.entry(thread.to_owned()).or_default()))
+    }
+
+    pub(super) fn call(
+        &self,
+        core: &Arc<Core>,
+        lead: &Lead,
+        caller: &operations::Caller<'_>,
+        request: ModHostCall,
+    ) -> Result<Value, String> {
+        if lead.owner != "lead" {
+            return Err("turn_queue_lead_only: agent threads cannot queue turns".into());
+        }
+        let autonomy = caller
+            .grants
+            .as_ref()
+            .and_then(|grants| grants.autonomy.clone())
+            .ok_or("grant_expired: autonomous")?;
+        let thread = lead.thread.to_string();
+        let arguments = &request.arguments;
+        match request.operation.as_str() {
+            "turns.queue" => {
+                let prompt = arguments["prompt"]
+                    .as_str()
+                    .filter(|prompt| !prompt.trim().is_empty() && prompt.len() <= 8192)
+                    .ok_or("turn_queue_prompt_limit")?;
+                let key = arguments["key"]
+                    .as_str()
+                    .filter(|key| {
+                        !key.is_empty()
+                            && key.len() <= 64
+                            && key.bytes().all(|byte| byte.is_ascii_alphanumeric() || b"-_.:".contains(&byte))
+                    })
+                    .ok_or("turn_queue_key_invalid")?;
+                let priority = match arguments.get("priority").and_then(Value::as_str) {
+                    None => 1,
+                    Some(name) => PRIORITIES
+                        .iter()
+                        .position(|priority| *priority == name)
+                        .ok_or("turn_queue_priority_invalid")?,
+                };
+                let deadline_ms = match arguments.get("deadline_ms").and_then(Value::as_u64) {
+                    None => None,
+                    Some(ms) if (1_000..=86_400_000).contains(&ms) => Some(now_ms() + ms),
+                    Some(_) => return Err("turn_queue_deadline_invalid".into()),
+                };
+                let event = arguments["event"].as_str().unwrap_or("unknown").to_owned();
+                let queued = self.with(&thread, |queue| {
+                    if queue.entries.iter().any(|entry| entry.owner == caller.id && entry.key == key) {
+                        return Ok(json!({"key": key, "status": "duplicate"}));
+                    }
+                    if queue.entries.iter().filter(|entry| entry.owner == caller.id).count()
+                        >= autonomy.max_queued as usize
+                    {
+                        return Err("turn_queue_full".to_owned());
+                    }
+                    queue.sequence += 1;
+                    queue.entries.push(Entry {
+                        owner: caller.id.to_owned(),
+                        source_sha256: caller.source.to_owned(),
+                        event,
+                        key: key.to_owned(),
+                        prompt: prompt.to_owned(),
+                        priority,
+                        deadline_ms,
+                        queued_at_ms: now_ms(),
+                        sequence: queue.sequence,
+                    });
+                    Ok(json!({"key": key, "status": "queued", "paused": queue.paused}))
+                })??;
+                if queued["status"] == "queued" {
+                    self.schedule(core, lead);
+                }
+                Ok(queued)
+            }
+            "turns.queued" => self.with(&thread, |queue| {
+                json!({"paused": queue.paused, "started": queue.started.get(caller.id).copied().unwrap_or(0),
+                    "spent_microusd": queue.spent.get(caller.id).copied().unwrap_or(0),
+                    "entries": queue.entries.iter().filter(|entry| entry.owner == caller.id).map(Entry::view).collect::<Vec<_>>()})
+            }),
+            "turns.dequeue" => {
+                let key = arguments["key"].as_str().ok_or("turn_queue_key_invalid")?;
+                self.with(&thread, |queue| {
+                    let before = queue.entries.len();
+                    queue
+                        .entries
+                        .retain(|entry| !(entry.owner == caller.id && entry.key == key));
+                    json!({"removed": queue.entries.len() < before})
+                })
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        }
+    }
+
+    /// Tries to start the best queued prompt once the thread has stayed idle briefly.
+    pub(super) fn schedule(&self, core: &Arc<Core>, lead: &Lead) {
+        let (core, lead) = (core.clone(), lead.clone());
+        tokio::spawn(async move {
+            tokio::time::sleep(IDLE_GRACE).await;
+            core.autonomy.dispatch(&core, &lead).await;
+        });
+    }
+
+    pub(super) async fn dispatch(&self, core: &Arc<Core>, lead: &Lead) {
+        let thread = lead.thread.to_string();
+        let grants = {
+            let runtime = core.runtime.clone();
+            tokio::task::spawn_blocking(move || {
+                runtime
+                    .lock()
+                    .map(|runtime| {
+                        runtime
+                            .owners()
+                            .into_iter()
+                            .filter_map(|(id, _)| Some((id.clone(), runtime.grants(&id)?)))
+                            .collect::<BTreeMap<_, _>>()
+                    })
+                    .unwrap_or_default()
+            })
+            .await
+            .unwrap_or_default()
+        };
+        let mut notices = Vec::new();
+        let picked = self.with(&thread, |queue| queue.pick(&grants, now_ms(), &mut notices));
+        for (owner, payload) in notices {
+            notify(core, lead, owner, payload);
+        }
+        let Ok(Some(entry)) = picked else {
+            return;
+        };
+        let started = self.start(lead, &entry).await;
+        let restore = |queue: &mut Queue| {
+            queue.running = None;
+            queue.submitting = None;
+            queue.entries.push(entry.clone());
+        };
+        match started {
+            Ok(Some(turn_id)) => {
+                let _ = self.with(&thread, |queue| {
+                    queue.dispatching = false;
+                    *queue.started.entry(entry.owner.clone()).or_default() += 1;
+                });
+                notify(
+                    core,
+                    lead,
+                    entry.owner.clone(),
+                    json!({"key": entry.key, "status": "started", "turn_id": turn_id}),
+                );
+            }
+            Ok(None) => {
+                // A turn that ended while this dispatch was starting found the entry gone and did not reschedule.
+                let missed = self.with(&thread, |queue| {
+                    restore(queue);
+                    queue.dispatching = false;
+                    std::mem::take(&mut queue.woken) && !queue.paused
+                });
+                if missed == Ok(true) {
+                    self.schedule(core, lead);
+                }
+            }
+            Err(error) => {
+                let _ = self.with(&thread, |queue| {
+                    queue.running = None;
+                    queue.submitting = None;
+                    queue.dispatching = false;
+                });
+                notify(
+                    core,
+                    lead,
+                    entry.owner.clone(),
+                    json!({"key": entry.key, "status": "failed", "reason": error}),
+                );
+            }
+        }
+    }
+
+    async fn start(&self, lead: &Lead, entry: &Entry) -> Result<Option<String>, String> {
+        let manager = lead
+            .host
+            .manager
+            .upgrade()
+            .ok_or("native_thread_manager_stopped")?;
+        let thread = manager
+            .get_thread(lead.thread)
+            .await
+            .map_err(|e| e.to_string())?;
+        let text = message(entry);
+        let mut request = TurnInputRequest::user_input(vec![UserInput::Text {
+            text,
+            text_elements: vec![],
+        }]);
+        request.start.turn_trigger = Some(format!("mod:{}", entry.owner));
+        match thread
+            .start_turn_if_idle(request)
+            .await
+            .map_err(|e| e.to_string())?
+        {
+            StartIfIdleSubmission::Started { turn_id } => Ok(Some(turn_id)),
+            StartIfIdleSubmission::NotSubmitted { .. } => Ok(None),
+        }
+    }
+
+    pub(super) fn running(&self, thread: &str) -> Option<String> {
+        self.with(thread, |queue| queue.running.clone())
+            .ok()
+            .flatten()
+    }
+
+    /// Provenance of the mod prompt being submitted, taken once by the input carrying its text.
+    pub(super) fn take_submitting(&self, thread: &str, text: &str) -> Option<Value> {
+        self.with(thread, |queue| {
+            if queue
+                .submitting
+                .as_ref()
+                .is_some_and(|(expected, _)| expected == text)
+            {
+                queue.submitting.take().map(|(_, provenance)| provenance)
+            } else {
+                None
+            }
+        })
+        .ok()
+        .flatten()
+    }
+
+    /// A user-typed turn resumes queues an interruption paused.
+    pub(super) fn user_turn(&self, thread: &str) {
+        let _ = self.with(thread, |queue| queue.paused = false);
+    }
+
+    pub(super) fn turn_ended(&self, core: &Arc<Core>, lead: &Lead, interrupted: bool) {
+        let resume = self
+            .with(&lead.thread.to_string(), |queue| {
+                queue.continued.clear();
+                if interrupted {
+                    queue.paused = true;
+                }
+                if queue.dispatching {
+                    queue.woken = true;
+                    return false;
+                }
+                queue.running = None;
+                !queue.paused && !queue.entries.is_empty()
+            })
+            .unwrap_or(false);
+        if resume {
+            self.schedule(core, lead);
+        }
+    }
+
+    /// Adds a priced response of `thread`'s session, sub-agents included, to the spend of the mod whose queued turn is running.
+    pub(super) fn charge(&self, thread: &str, response: &Value) {
+        let Some(microusd) = response["cost"]["microusd"].as_u64() else {
+            return;
+        };
+        if let Ok(mut threads) = self.threads.lock()
+            && let Some(queue) = threads.get_mut(thread)
+            && let Some(owner) = queue.running.clone()
+        {
+            *queue.spent.entry(owner).or_default() += microusd;
+        }
+    }
+
+    /// Records one continuation for `owner` in `turn` if its grant still allows another.
+    pub(super) fn continue_turn(&self, thread: &str, turn: &str, owner: &str, limit: u32) -> bool {
+        self.with(thread, |queue| {
+            let used = queue
+                .continued
+                .entry((turn.to_owned(), owner.to_owned()))
+                .or_default();
+            if *used >= limit.min(CONTINUATION_LIMIT) {
+                return false;
+            }
+            *used += 1;
+            true
+        })
+        .unwrap_or(false)
+    }
+}
+
+pub(super) const CONTINUATIONS: u32 = CONTINUATION_LIMIT;
diff --git a/codex-rs/ext/omd/src/mods/compaction.rs b/codex-rs/ext/omd/src/mods/compaction.rs
new file mode 100644
index 000000000..67d413e98
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/compaction.rs
@@ -0,0 +1,177 @@
+use super::*;
+use codex_extension_api::CompactionInterceptInput;
+use codex_extension_api::CompactionPlan;
+use codex_extension_api::CompactionReplacement;
+use codex_extension_api::CompactionSettle;
+use codex_extension_api::CompactionSettled;
+use codex_omd::history;
+use std::sync::mpsc::RecvTimeoutError;
+
+fn native() -> CompactionPlan {
+    CompactionPlan::Native {
+        summary_prompt: None,
+        settle: None,
+    }
+}
+
+/// Maps a settled chain onto a replacement; `items` are what `history.keep` indexes.
+fn replacement(
+    chain: &codex_omd::ModChain,
+    items: &[Value],
+    executed: Option<&Value>,
+) -> Result<Option<CompactionReplacement>, String> {
+    if executed == Some(&chain.result) {
+        return Ok(None);
+    }
+    let by = chain
+        .answered_by
+        .clone()
+        .unwrap_or_else(|| intercept::settled_by(chain));
+    if let Some(text) = chain.result["summary"].as_str() {
+        return Ok(Some(CompactionReplacement::Summary {
+            by,
+            text: text.to_owned(),
+        }));
+    }
+    let edit = serde_json::from_value(chain.result["history"].clone())
+        .map_err(|error| format!("compaction_history_invalid: {by}: {error}"))?;
+    let items = history::compact(items, edit).map_err(|error| format!("{error} ({by})"))?;
+    Ok(Some(CompactionReplacement::History { by, items }))
+}
+
+impl Mods {
+    pub(super) async fn compaction_plan(
+        &self,
+        input: CompactionInterceptInput<'_>,
+    ) -> CompactionPlan {
+        let Some(lead) = input
+            .thread_store
+            .get::<Lead>()
+            .filter(|lead| lead.owner == "lead")
+        else {
+            return native();
+        };
+        let thread = lead.thread.to_string();
+        let (runtime, scope) = (self.runtime.clone(), thread.clone());
+        let required = tokio::task::spawn_blocking(move || {
+            let _thread = codex_omd::StateThread::enter(Some(scope));
+            runtime
+                .lock()
+                .ok()
+                .and_then(|runtime| runtime.intercepts("compaction"))
+        })
+        .await
+        .ok()
+        .flatten();
+        let Some(required) = required else {
+            return native();
+        };
+        let items = input.history.to_vec();
+        let payload = json!({"thread_id": thread, "turn_id": input.turn_id, "trigger": input.trigger,
+            "reason": input.reason, "phase": input.phase, "implementation": input.implementation,
+            "budget": {"tokens": input.tokens, "auto_limit": input.auto_limit,
+                "context_window": input.context_window, "hard": input.hard},
+            "items": items.len(), "history": history::compaction_view(&items),
+            "summary_prompt": input.summary_prompt});
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let (reached, at_executor) = tokio::sync::oneshot::channel::<Value>();
+        let (settled, results) = std::sync::mpsc::channel::<Value>();
+        let (flag, mut reached) = (cancelled.clone(), Some(reached));
+        let executor = move |effective: Value| {
+            let first = reached.take().ok_or_else(|| {
+                std::io::Error::other(
+                    "compaction_retry_unavailable: the host compacts once per occurrence",
+                )
+            })?;
+            first
+                .send(effective)
+                .map_err(|_| std::io::Error::other("compaction_stopped"))?;
+            loop {
+                if flag.load(Ordering::Acquire) {
+                    return Err(std::io::Error::other("callback_cancelled"));
+                }
+                match results.recv_timeout(std::time::Duration::from_millis(20)) {
+                    Ok(result) => return Ok(result),
+                    Err(RecvTimeoutError::Timeout) => {}
+                    Err(RecvTimeoutError::Disconnected) => {
+                        return Err(std::io::Error::other("compaction_result_unavailable"));
+                    }
+                }
+            }
+        };
+        let chain = tokio::spawn(intercept::chain(
+            self.core.clone(),
+            lead,
+            self.runtime.clone(),
+            "compaction",
+            required,
+            payload.clone(),
+            json!({"caller": "engine", "thread_id": thread}),
+            cancelled.clone(),
+            executor,
+        ));
+        if let Ok(effective) = at_executor.await {
+            let summary_prompt = (effective["summary_prompt"] != payload["summary_prompt"])
+                .then(|| effective["summary_prompt"].as_str().map(str::to_owned))
+                .flatten();
+            let (views, host) = (self.views.clone(), self.host.clone());
+            let settle: CompactionSettle = Box::new(move |done: CompactionSettled| {
+                Box::pin(async move {
+                    let _cancel_on_drop = Cancellation(cancelled);
+                    let executed = json!({"summary": done.summary,
+                        "history": history::compaction_view(&done.history),
+                        "usage": done.usage.and_then(|usage| serde_json::to_value(usage).ok()),
+                        "provider_call": done.provider_call});
+                    let _ = settled.send(executed.clone());
+                    let outcome = chain
+                        .await
+                        .map_err(|error| error.to_string())
+                        .and_then(|chain| chain)
+                        .and_then(|chain| replacement(&chain, &done.history, Some(&executed)));
+                    match outcome {
+                        Ok(replacement) => replacement,
+                        Err(error) => {
+                            views.diagnostic(
+                                &host,
+                                "compaction",
+                                Some(format!("{error}; the host's compaction was kept")),
+                            );
+                            None
+                        }
+                    }
+                })
+            });
+            return CompactionPlan::Native {
+                summary_prompt,
+                settle: Some(settle),
+            };
+        }
+        let chain = match chain
+            .await
+            .map_err(|error| error.to_string())
+            .and_then(|c| c)
+        {
+            Ok(chain) => chain,
+            Err(error) => return CompactionPlan::Fail(format!("mod_interception_failed: {error}")),
+        };
+        let by = chain
+            .answered_by
+            .clone()
+            .unwrap_or_else(|| intercept::settled_by(&chain));
+        for (key, plan) in [("skip", true), ("defer", false)] {
+            if let Some(reason) = chain.result[key].as_str() {
+                let (by, reason) = (by, reason.to_owned());
+                return if plan {
+                    CompactionPlan::Skip { by, reason }
+                } else {
+                    CompactionPlan::Defer { by, reason }
+                };
+            }
+        }
+        match replacement(&chain, &items, None) {
+            Ok(Some(replacement)) => CompactionPlan::Replace(replacement),
+            Ok(None) => native(),
+            Err(error) => CompactionPlan::Fail(error),
+        }
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/elicitation.rs b/codex-rs/ext/omd/src/mods/elicitation.rs
new file mode 100644
index 000000000..0366a58dd
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/elicitation.rs
@@ -0,0 +1,164 @@
+use super::*;
+use codex_extension_api::ElicitationAnswer;
+use codex_extension_api::ElicitationInterceptInput;
+use codex_extension_api::ElicitationResultInput;
+
+const FORMS: &[&str] = &["form", "openai/form", "openaiForm"];
+
+/// Properties a user types as secrets; mods never fill them and never see them.
+fn secret_fields(schema: &Value) -> Vec<String> {
+    schema["properties"]
+        .as_object()
+        .into_iter()
+        .flatten()
+        .filter(|(_, property)| property["format"] == "password" || property["writeOnly"] == true)
+        .map(|(name, _)| name.clone())
+        .collect()
+}
+
+pub(super) fn redact(content: Option<&Value>, secrets: &[String]) -> Value {
+    let mut content = content.cloned().unwrap_or(Value::Null);
+    if let Some(object) = content.as_object_mut() {
+        for name in secrets {
+            if let Some(value) = object.get_mut(name) {
+                *value = json!("[redacted]");
+            }
+        }
+    }
+    content
+}
+
+/// An accepted answer must fill every required field with declared fields only.
+fn fills(schema: &Value, content: &Value) -> bool {
+    let (Some(content), Some(properties)) = (content.as_object(), schema["properties"].as_object())
+    else {
+        return false;
+    };
+    content.keys().all(|key| properties.contains_key(key))
+        && schema["required"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(Value::as_str)
+            .all(|key| content.contains_key(key))
+}
+
+impl Mods {
+    pub(super) async fn elicitation_answer(
+        &self,
+        input: ElicitationInterceptInput<'_>,
+    ) -> Option<ElicitationAnswer> {
+        let lead = input
+            .thread_store
+            .get::<Lead>()
+            .filter(|lead| lead.owner == "lead")?;
+        let schema = &input.request["requested_schema"];
+        let secrets = secret_fields(schema);
+        if let Ok(mut pending) = self.elicitations.lock() {
+            if pending.len() >= 64 {
+                pending.clear();
+            }
+            pending.insert(
+                format!("{}\0{}", input.server, input.request_id),
+                secrets.clone(),
+            );
+        }
+        let mode = input.request["mode"].as_str().unwrap_or_default();
+        if !FORMS.contains(&mode) || !secrets.is_empty() {
+            return None;
+        }
+        let (runtime, thread) = (self.runtime.clone(), lead.thread.to_string());
+        let scope = thread.clone();
+        let required = tokio::task::spawn_blocking(move || {
+            let _thread = codex_omd::StateThread::enter(Some(scope));
+            runtime
+                .lock()
+                .ok()
+                .and_then(|runtime| runtime.intercepts("elicitation"))
+        })
+        .await
+        .ok()
+        .flatten()?;
+        let payload = json!({"thread_id": thread, "turn_id": input.turn_id, "server": input.server,
+            "request_id": input.request_id, "mode": mode, "message": input.request["message"],
+            "schema": schema});
+        let chain = intercept::chain(
+            self.core.clone(),
+            lead,
+            self.runtime.clone(),
+            "elicitation",
+            required,
+            payload,
+            json!({"caller": "engine", "thread_id": thread}),
+            Arc::new(AtomicBool::new(false)),
+            |_| Ok(json!({"action": "ask"})),
+        )
+        .await;
+        let chain = match chain {
+            Ok(chain) => chain,
+            Err(error) => {
+                self.views.diagnostic(
+                    &self.host,
+                    "elicitation",
+                    Some(format!("{error}; the user was asked")),
+                );
+                return None;
+            }
+        };
+        let by = chain
+            .answered_by
+            .clone()
+            .unwrap_or_else(|| intercept::settled_by(&chain));
+        let result = &chain.result;
+        if let Some(content) = result.get("accept") {
+            if !fills(schema, content) {
+                self.views.diagnostic(
+                    &self.host,
+                    "elicitation",
+                    Some(format!(
+                        "{by} answered fields the form does not ask for; the user was asked"
+                    )),
+                );
+                return None;
+            }
+            return Some(ElicitationAnswer {
+                action: "accept".into(),
+                content: Some(content.clone()),
+                by,
+            });
+        }
+        ["decline", "cancel"]
+            .into_iter()
+            .find(|action| result.get(*action).is_some())
+            .map(|action| ElicitationAnswer {
+                action: action.into(),
+                content: None,
+                by,
+            })
+    }
+
+    pub(super) async fn elicitation_result(&self, input: ElicitationResultInput<'_>) {
+        let Some(lead) = input
+            .thread_store
+            .get::<Lead>()
+            .filter(|lead| lead.owner == "lead")
+        else {
+            return;
+        };
+        let secrets = self
+            .elicitations
+            .lock()
+            .ok()
+            .and_then(|mut pending| {
+                pending.remove(&format!("{}\0{}", input.server, input.request_id))
+            })
+            .unwrap_or_default();
+        self.event(
+            "elicitation_result",
+            json!({"server": input.server, "request_id": input.request_id, "action": input.action,
+                "content": redact(input.content, &secrets), "by": input.by}),
+            Some(&*lead),
+        )
+        .await;
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/evidence.rs b/codex-rs/ext/omd/src/mods/evidence.rs
new file mode 100644
index 000000000..82e034bef
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/evidence.rs
@@ -0,0 +1,244 @@
+use super::*;
+
+pub(super) struct Cursor {
+    revision: u64,
+    prefix: Option<Value>,
+    paused: bool,
+    invalid: bool,
+    offset: usize,
+    generation: u64,
+    owners: Vec<String>,
+    pub tools: Vec<Value>,
+    usage_start: Value,
+}
+
+fn subscribers(runtime: &ModHost) -> Vec<String> {
+    let mut owners = runtime.subscribers_with_capability("turn_end", "sessions");
+    owners.extend(runtime.subscribers_with_capability("turn_end", "turn_evidence"));
+    owners.sort();
+    owners.dedup();
+    owners
+}
+
+pub(super) async fn begin(core: &Core, lead: &Lead) -> Option<Cursor> {
+    let runtime = core.runtime.clone();
+    let (owners, generation) = tokio::task::spawn_blocking(move || {
+        let runtime = runtime.lock().ok()?;
+        Some((subscribers(&runtime), runtime.generation()))
+    })
+    .await
+    .ok()
+    .flatten()?;
+    if owners.is_empty() {
+        return None;
+    }
+    let thread = lead
+        .host
+        .manager
+        .upgrade()?
+        .get_thread(lead.thread)
+        .await
+        .ok()?;
+    let history = thread.conversation_history_snapshot().await;
+    Some(Cursor {
+        revision: history.review_history_version(),
+        prefix: None,
+        paused: false,
+        invalid: false,
+        offset: history.review_items().count(),
+        generation,
+        owners,
+        tools: Vec::new(),
+        usage_start: json!(lead.session.task.cost_capture().ok()),
+    })
+}
+
+pub(super) async fn compact(
+    lead: &Lead,
+    turns: &Mutex<BTreeMap<String, TurnRecord>>,
+    before: bool,
+) -> Result<(), String> {
+    let key = lead.thread.to_string();
+    if turns
+        .lock()
+        .map_err(|_| "turn_record_poisoned")?
+        .get(&key)
+        .is_none_or(|turn| turn.evidence.is_none())
+    {
+        return Ok(());
+    }
+    let thread = lead
+        .host
+        .manager
+        .upgrade()
+        .ok_or("native_thread_manager_stopped")?
+        .get_thread(lead.thread)
+        .await
+        .map_err(|error| error.to_string())?;
+    let history = thread.conversation_history_snapshot().await;
+    let mut turns = turns.lock().map_err(|_| "turn_record_poisoned")?;
+    let Some(turn) = turns.get_mut(&key) else {
+        return Ok(());
+    };
+    let Some(cursor) = turn.evidence.as_mut() else {
+        return Ok(());
+    };
+    if before {
+        if cursor.paused
+            || history.review_history_version() != cursor.revision
+            || history.review_items().count() < cursor.offset
+        {
+            cursor.invalid = true;
+            return Err("evidence_history_changed".into());
+        }
+        let packet = codex_omd::turn_evidence::project(
+            history
+                .review_items()
+                .skip(cursor.offset)
+                .map(|item| serde_json::to_value(item).unwrap_or(Value::Null)),
+            &turn.turn_id,
+            cursor.revision,
+        )
+        .map_err(|error| error.to_string())?;
+        cursor.prefix = Some(
+            codex_omd::turn_evidence::combine(cursor.prefix.take(), packet)
+                .map_err(|error| error.to_string())?,
+        );
+        cursor.paused = true;
+    } else if cursor.paused {
+        cursor.revision = history.review_history_version();
+        cursor.offset = history.review_items().count();
+        cursor.paused = false;
+    } else {
+        cursor.invalid = true;
+    }
+    Ok(())
+}
+
+pub(super) async fn finish(
+    core: &Core,
+    lead: &Lead,
+    cursor: &Cursor,
+    turn: &str,
+    outcome: &str,
+) -> Result<BTreeMap<String, Value>, String> {
+    let runtime = core.runtime.clone();
+    let (owners, generation, sources) = tokio::task::spawn_blocking(move || {
+        let runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned")?;
+        Ok::<_, String>((
+            subscribers(&runtime),
+            runtime.generation(),
+            runtime
+                .owners()
+                .into_iter()
+                .map(|(id, owner)| (id, owner.sha256))
+                .collect::<BTreeMap<_, _>>(),
+        ))
+    })
+    .await
+    .map_err(|e| e.to_string())??;
+    if generation != cursor.generation {
+        return Err("evidence_generation_changed".into());
+    }
+    let thread = lead
+        .host
+        .manager
+        .upgrade()
+        .ok_or("native_thread_manager_stopped")?
+        .get_thread(lead.thread)
+        .await
+        .map_err(|e| e.to_string())?;
+    let history = thread.conversation_history_snapshot().await;
+    if cursor.paused
+        || cursor.invalid
+        || history.review_history_version() != cursor.revision
+        || history.review_items().count() < cursor.offset
+    {
+        return Err("evidence_history_changed".into());
+    }
+    let mut packet = codex_omd::turn_evidence::project(
+        history
+            .review_items()
+            .skip(cursor.offset)
+            .map(|item| serde_json::to_value(item).unwrap_or(Value::Null)),
+        turn,
+        cursor.revision,
+    )
+    .map_err(|e| e.to_string())?;
+    packet = codex_omd::turn_evidence::combine(cursor.prefix.clone(), packet)
+        .map_err(|error| error.to_string())?;
+    let sha = crate::workspace_operations::workspace_snapshot(lead)
+        .await?
+        .hash()
+        .map_err(|e| e.to_string())?;
+    packet["workspace_sha256"] = json!(sha);
+    packet["thread_id"] = json!(lead.thread.to_string());
+    packet["outcome"] = json!(outcome);
+    packet["tool_outcomes"] = json!(cursor.tools);
+    packet["tool_outcomes_truncated"] = json!(cursor.tools.len() >= 128);
+    packet["usage"] = lead.session.evidence(
+        &format!(
+            "turn-usage-{}.json",
+            crate::execution::hash(format!("{}:{turn}", lead.thread).as_bytes())
+        ),
+        &usage_delta(
+            &cursor.usage_start,
+            &json!(lead.session.task.cost_capture().ok()),
+        ),
+    )?;
+    let root = lead.host.root.clone();
+    let mut results = BTreeMap::new();
+    for owner in owners
+        .into_iter()
+        .filter(|owner| cursor.owners.contains(owner))
+    {
+        let source = sources
+            .get(&owner)
+            .cloned()
+            .ok_or("evidence_owner_unavailable")?;
+        let data = codex_omd::scoped_data::ScopedDataHost::new(
+            root.clone(),
+            lead.host.repository.clone(),
+            None,
+            None,
+            owner.clone(),
+            lead.thread.to_string(),
+            source,
+        )
+        .map_err(|e| e.to_string())?;
+        let reference = data
+            .resources()
+            .save("turn", packet.clone())
+            .map_err(|e| e.to_string())?;
+        results.insert(owner, json!({"evidence":reference}));
+    }
+    Ok(results)
+}
+
+/// This turn's usage: counters minus their turn-start values and only attempts made or changed since.
+fn usage_delta(before: &Value, after: &Value) -> Value {
+    let Some(fields) = after.as_object() else {
+        return json!({"scope": "turn", "usage": after});
+    };
+    let mut delta = serde_json::Map::from_iter([("scope".to_owned(), json!("turn"))]);
+    for (key, value) in fields {
+        let value = match (value, &before[key]) {
+            (Value::Number(after), Value::Number(before)) if key != "schema" => {
+                match (after.as_u64(), before.as_u64()) {
+                    (Some(after), Some(before)) => json!(after.saturating_sub(before)),
+                    _ => value.clone(),
+                }
+            }
+            (Value::Array(after), Value::Array(before)) => Value::Array(
+                after
+                    .iter()
+                    .filter(|item| !before.contains(item))
+                    .cloned()
+                    .collect(),
+            ),
+            _ => value.clone(),
+        };
+        delta.insert(key.clone(), value);
+    }
+    Value::Object(delta)
+}
