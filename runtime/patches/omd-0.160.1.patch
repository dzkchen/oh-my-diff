+    styles.iter().all(|(name, paint)| {
+        matches!(name.as_str(), "composer" | "backdrop" | "approval")
+            && paint
+                .opacity
+                .is_none_or(|value| value.is_finite() && (0.0..=1.0).contains(&value))
+    })
