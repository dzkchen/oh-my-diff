+#[test]
+fn delegated_approvals_stay_inside_the_current_grant() {
+    let grants = |capabilities: &[&str]| codex_omd::ModGrants {
+        api: codex_omd::MOD_API_VERSION.into(),
+        source_sha256: "a".repeat(64),
