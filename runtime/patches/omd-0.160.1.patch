+pub fn denied(message: impl ToString) -> TransportError {
+    TransportError::Http {
+        status: http::StatusCode::BAD_REQUEST,
+        url: None,
+        headers: None,
+        body: Some(format!("local OMD request policy: {}", message.to_string())),
+        retry_after: None,
+    }
+}
