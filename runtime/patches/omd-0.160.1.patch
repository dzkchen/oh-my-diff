+        gate.0
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(decision, _)| decision == "ask")
+    );
+    Ok(())
+}
diff --git a/codex-rs/core/src/tools/spec_adjust.rs b/codex-rs/core/src/tools/spec_adjust.rs
new file mode 100644
index 000000000..6547e8872
--- /dev/null
+++ b/codex-rs/core/src/tools/spec_adjust.rs
@@ -0,0 +1,214 @@
+use codex_extension_api::ToolSpecAdjustment;
+use codex_extension_api::ToolSpecView;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolSpec;
+
+use crate::session::session::Session;
+use crate::tools::registry::ToolRegistry;
+use crate::tools::router::ToolRouter;
+use codex_tools::ToolExposure;
+
+const DESCRIPTION_CHARS: usize = 4096;
+
+fn views(specs: &[ToolSpec]) -> Vec<ToolSpecView> {
+    let function = |name: String, description: &str, parameters: &JsonSchema| ToolSpecView {
+        name,
+        description: description.to_owned(),
+        parameters: serde_json::to_value(parameters).unwrap_or(serde_json::Value::Null),
+    };
+    let mut views = Vec::new();
+    for spec in specs {
+        match spec {
+            ToolSpec::Function(tool) => {
+                views.push(function(
+                    tool.name.clone(),
+                    &tool.description,
+                    &tool.parameters,
+                ));
+            }
+            ToolSpec::Freeform(tool) => views.push(ToolSpecView {
+                name: tool.name.clone(),
+                description: tool.description.clone(),
+                parameters: serde_json::Value::Null,
+            }),
+            ToolSpec::Namespace(namespace) => {
+                for tool in &namespace.tools {
+                    views.push(match tool {
+                        ResponsesApiNamespaceTool::Function(tool) => function(
+                            format!("{}{}", namespace.name, tool.name),
+                            &tool.description,
+                            &tool.parameters,
+                        ),
+                        ResponsesApiNamespaceTool::Custom(tool) => ToolSpecView {
+                            name: format!("{}{}", namespace.name, tool.name),
+                            description: tool.description.clone(),
+                            parameters: serde_json::Value::Null,
+                        },
+                    });
+                }
+            }
+            ToolSpec::ToolSearch { .. } | ToolSpec::WebSearch { .. } => {}
+        }
+    }
+    views
+}
+
+fn describe(
+    adjustment: &ToolSpecAdjustment,
+    name: &str,
+    description: &mut String,
+    parameters: Option<&mut JsonSchema>,
+) {
+    let Some((text, schema)) = adjustment.describe.get(name) else {
+        return;
+    };
+    if let Some(text) = text {
+        *description = text.chars().take(DESCRIPTION_CHARS).collect();
+    }
+    if let (Some(schema), Some(parameters)) = (schema, parameters)
+        && let Ok(parsed) = serde_json::from_value::<JsonSchema>(schema.clone())
+    {
+        *parameters = parsed;
+    }
+}
+
+pub(crate) fn adjust(specs: &[ToolSpec], adjustment: &ToolSpecAdjustment) -> Vec<ToolSpec> {
+    let hidden = |name: &str| adjustment.hide.iter().any(|hidden| hidden == name);
+    let mut adjusted = Vec::with_capacity(specs.len());
+    for spec in specs {
+        match spec.clone() {
+            ToolSpec::Function(mut tool) => {
+                if hidden(&tool.name) {
+                    continue;
+                }
+                let name = tool.name.clone();
+                describe(
+                    adjustment,
+                    &name,
+                    &mut tool.description,
+                    Some(&mut tool.parameters),
+                );
+                adjusted.push(ToolSpec::Function(tool));
+            }
+            ToolSpec::Freeform(mut tool) => {
+                if hidden(&tool.name) {
+                    continue;
+                }
+                let name = tool.name.clone();
+                describe(adjustment, &name, &mut tool.description, None);
+                adjusted.push(ToolSpec::Freeform(tool));
+            }
+            ToolSpec::Namespace(mut namespace) => {
+                let prefix = namespace.name.clone();
+                namespace.tools.retain_mut(|tool| {
+                    let (name, description, parameters) = match tool {
+                        ResponsesApiNamespaceTool::Function(tool) => (
+                            &tool.name,
+                            &mut tool.description,
+                            Some(&mut tool.parameters),
+                        ),
+                        ResponsesApiNamespaceTool::Custom(tool) => {
+                            (&tool.name, &mut tool.description, None)
+                        }
+                    };
+                    let full = format!("{prefix}{name}");
+                    if hidden(&full) {
+                        return false;
+                    }
+                    describe(adjustment, &full, description, parameters);
+                    true
+                });
+                if !namespace.tools.is_empty() {
+                    adjusted.push(ToolSpec::Namespace(namespace));
+                }
+            }
+            other => adjusted.push(other),
+        }
+    }
+    adjusted
+}
+
+/// Asks spec contributors once per request; deferrals change registry exposure before the router is built.
+pub(crate) fn plan(
+    session: &Session,
+    registry: &mut ToolRegistry,
+    search_available: bool,
+) -> Vec<ToolSpecAdjustment> {
+    let thread_store = &session.services.thread_extension_data;
+    let contributors = session
+        .services
+        .extensions
+        .tool_spec_contributors()
+        .iter()
+        .filter(|contributor| contributor.adjusting(thread_store))
+        .collect::<Vec<_>>();
+    if contributors.is_empty() {
+        return Vec::new();
+    }
+    let mut specs = registry
+        .entries()
+        .filter(|tool| {
+            matches!(
+                tool.exposure,
+                ToolExposure::Direct | ToolExposure::DirectModelOnly
+            )
+        })
+        .map(|tool| {
+            tool.runtime
+                .immutable_spec()
+                .map(|spec| spec.as_ref().clone())
+                .unwrap_or_else(|| tool.runtime.spec())
+        })
+        .collect::<Vec<_>>();
+    let mut adjustments = Vec::new();
+    for contributor in contributors {
+        let views = views(&specs);
+        let adjust_specs = || contributor.adjust_tool_specs(thread_store, &views);
+        let multi_thread = tokio::runtime::Handle::try_current().is_ok_and(|handle| {
+            handle.runtime_flavor() == tokio::runtime::RuntimeFlavor::MultiThread
+        });
+        let adjustment = if multi_thread {
+            tokio::task::block_in_place(adjust_specs)
+        } else {
+            adjust_specs()
+        };
+        if let Some(adjustment) = adjustment {
+            specs = adjust(&specs, &adjustment);
+            adjustments.push(adjustment);
+        }
+    }
+    let deferred = adjustments
+        .iter()
+        .flat_map(|adjustment| adjustment.defer.iter().map(String::as_str))
+        .collect::<std::collections::BTreeSet<_>>();
+    for tool in registry.entries_mut() {
+        if !search_available
+            || tool.runtime.search_info().is_none()
+            || !deferred.contains(crate::tools::flat_tool_name(&tool.runtime.tool_name()).as_ref())
+        {
+            continue;
+        }
+        tool.exposure = match tool.exposure {
+            ToolExposure::Direct => ToolExposure::Deferred,
+            ToolExposure::DirectModelOnly => ToolExposure::DeferredModelOnly,
+            exposure => exposure,
+        };
+    }
+    adjustments
+}
+
+pub(crate) fn apply(router: &mut ToolRouter, adjustments: &[ToolSpecAdjustment]) {
+    if adjustments.is_empty() {
+        return;
+    }
+    let mut specs = router.model_visible_specs().to_vec();
+    for adjustment in adjustments {
+        specs = adjust(&specs, adjustment);
+    }
+    router.replace_model_visible_specs(specs);
+}
+
+#[cfg(test)]
+#[path = "spec_adjust_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/tools/spec_adjust_tests.rs b/codex-rs/core/src/tools/spec_adjust_tests.rs
new file mode 100644
index 000000000..aaf3e7942
--- /dev/null
