+        request
+            .headers
+            .insert(REQUEST_HEADER, request_id.parse().map_err(denied)?);
+        let attempt = self
+            .6
+            .lock()
+            .ok()
+            .and_then(|mut state| state.retries.remove(&thread))
+            .unwrap_or(1);
+        request.headers.insert(
+            "x-omd-attempt",
+            attempt.to_string().parse().map_err(denied)?,
+        );
+        if let Some(mods) = &mods {
