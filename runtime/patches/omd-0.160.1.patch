+static CACHE: RwLock<Option<Cache>> = RwLock::new(None);
+static INTERACTION: Mutex<Interaction> = Mutex::new(Interaction {
+    focused: None,
+    ids: BTreeSet::new(),
+    targets: BTreeMap::new(),
+    order: Vec::new(),
+    hitboxes: Vec::new(),
+    input_values: BTreeMap::new(),
+    input_cursor: BTreeMap::new(),
+    selected: BTreeMap::new(),
+    collapsed: BTreeMap::new(),
+    scroll: BTreeMap::new(),
+    owners: Vec::new(),
+    component_owners: BTreeMap::new(),
+    pty_bindings: BTreeMap::new(),
+    key_panes: BTreeSet::new(),
+    dialog: None,
+    dismissed: None,
+    dialog_area: None,
+    seeds: BTreeMap::new(),
+    echoes: BTreeMap::new(),
+    checked: BTreeMap::new(),
+    hotkeys: Vec::new(),
+    autofocus: Vec::new(),
+    parked: BTreeSet::new(),
+    regions: Vec::new(),
+    layers: Vec::new(),
+    layer: 0,
+    anchors: BTreeMap::new(),
+    hovered: BTreeMap::new(),
+    captured: None,
+});
+static APPLIED_SYNTAX: Mutex<Option<String>> = Mutex::new(None);
+static WARNED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+static BLOCKED_SNAPSHOT: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+
+static APPLIED_PLACEHOLDER: Mutex<Option<Option<String>>> = Mutex::new(None);
