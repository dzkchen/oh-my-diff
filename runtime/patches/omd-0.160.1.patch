+                value.get("type").and_then(Value::as_str),
+                Some(
+                    "web_search"
+                        | "web_search_preview"
+                        | "file_search"
+                        | "computer"
+                        | "computer_use_preview"
+                        | "code_interpreter"
+                        | "image_generation"
+                        | "mcp"
+                )
+            )
+        };
