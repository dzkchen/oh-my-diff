+        serde_json::to_vec_pretty(&manifest).unwrap(),
+    )
+    .unwrap();
+    std::fs::write(path.join("main.ts"), "export default () => {}\n").unwrap();
+    path.canonicalize().unwrap()
+}
+
+fn setup() -> (tempfile::TempDir, ModStore, PathBuf) {
