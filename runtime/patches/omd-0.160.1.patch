+struct ModInterceptionFixture {
+    decision: &'static str,
+}
+
+impl codex_extension_api::ToolLifecycleContributor for ModInterceptionFixture {
+    fn intercept_tool<'a>(
+        &'a self,
+        input: codex_extension_api::ToolStartInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<
+        'a,
+        Result<codex_extension_api::ToolInterception, String>,
+    > {
+        Box::pin(async move {
+            assert_eq!(input.tool_name.name, "original");
+            match self.decision {
+                "deny" => Err("mod_fixture_denial".into()),
+                "respond" => Ok(codex_extension_api::ToolInterception::Respond {
+                    output: "cached".into(),
+                    success: true,
+                }),
+                _ => Ok(codex_extension_api::ToolInterception::Continue(Some((
+                    codex_tools::ToolName::plain("replacement"),
+                    ToolPayload::Function {
+                        arguments: "{\"changed\":true}".into(),
+                    },
+                )))),
+            }
+        })
+    }
+}
+
+#[tokio::test]
+async fn mod_interception_denies_answers_or_routes_through_registered_native_handler() {
+    for decision in ["deny", "respond", "route"] {
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let records = Arc::new(std::sync::Mutex::new(Vec::new()));
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.tool_lifecycle_contributor(Arc::new(ModInterceptionFixture { decision }));
+        builder.tool_lifecycle_contributor(Arc::new(ToolLifecycleRecorder {
+            records: records.clone(),
+        }));
+        session.services.extensions = Arc::new(builder.build());
+        let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
+            tool_name: codex_tools::ToolName::plain("replacement"),
+            result: LifecycleTestResult::Ok { success: true },
+        }) as Arc<dyn CoreToolRuntime>]);
+        let result = registry
+            .dispatch_any_with_state(
+                test_invocation(
+                    Arc::new(session),
+                    Arc::new(turn),
+                    "mod-call",
+                    codex_tools::ToolName::plain("original"),
+                ),
+                None,
+            )
+            .await;
+        let records = records.lock().unwrap();
+        if decision == "respond" {
+            let output = result.unwrap();
+            assert_eq!(
+                output.result.to_response_item("mod-call", &output.payload),
+                FunctionToolOutput::from_text("cached".into(), Some(true))
+                    .to_response_item("mod-call", &output.payload)
+            );
+            assert!(matches!(
+                &records[..],
+                [RecordedToolLifecycle::Finish {
+                    outcome: ToolCallOutcome::Completed { success: true },
+                    ..
+                }]
+            ));
+        } else if decision == "deny" {
+            assert_eq!(result.err().unwrap().to_string(), "mod_fixture_denial");
+            assert_eq!(
+                *records,
+                vec![RecordedToolLifecycle::Finish {
+                    call_id: "mod-call".into(),
+                    tool_name: codex_tools::ToolName::plain("original"),
+                    outcome: ToolCallOutcome::Blocked
+                }]
+            );
+        } else {
+            let output = result.unwrap();
+            assert_eq!(
+                output.payload,
+                ToolPayload::Function {
+                    arguments: "{\"changed\":true}".into()
+                }
+            );
+            assert_eq!(records.len(), 2);
+            assert!(
+                matches!(&records[0], RecordedToolLifecycle::Start {tool_name,..} if tool_name.name == "replacement")
+            );
+        }
+    }
+}
+
+struct OutputReplacer {
