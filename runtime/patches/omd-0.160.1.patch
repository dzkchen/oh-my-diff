+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+use unicode_segmentation::UnicodeSegmentation;
+use unicode_width::UnicodeWidthStr;
+
+pub(crate) use codex_omd::client_surface::BLIT_FRAME as FRAME;
+use codex_omd::client_surface::BLIT_QUEUE_BYTES as QUEUE_BYTES;
+use codex_omd::client_surface::BLIT_QUEUE_UPDATES as QUEUE_UPDATES;
+use codex_omd::client_surface::Blit as Update;
+use codex_omd::client_surface::BlitCell as Cell;
+const RASTERS_PER_MOD: usize = 16;
+
+struct Raster {
+    owner: String,
+    width: u16,
+    height: u16,
+    cells: Vec<Cell>,
+    queue: VecDeque<Update>,
+    queued_bytes: usize,
+    applied: Option<Instant>,
+    frames: u64,
+}
+
+impl Raster {
+    fn new(owner: &str, width: u16, height: u16) -> Self {
+        Self {
+            owner: owner.to_owned(),
+            width,
+            height,
+            cells: vec![Cell::default(); usize::from(width) * usize::from(height)],
+            queue: VecDeque::new(),
+            queued_bytes: 0,
+            applied: None,
+            frames: 0,
+        }
+    }
+
+    fn apply(&mut self, update: Update) {
+        let mut cells = update.cells.into_iter();
+        for row in update.rect.y..update.rect.y + update.rect.height {
+            for column in update.rect.x..update.rect.x + update.rect.width {
+                if let Some(cell) = cells.next() {
+                    self.cells[usize::from(row) * usize::from(self.width) + usize::from(column)] =
+                        cell;
+                }
+            }
+        }
+        self.queued_bytes -= update.bytes;
+        self.frames += 1;
+    }
+
+    /// Applies at most one queued update per frame interval; returns the wait for the next one.
+    fn advance(&mut self, now: Instant) -> Option<Duration> {
+        if self.queue.is_empty() {
+            return None;
+        }
+        let due = self.applied.map_or(Duration::ZERO, |applied| {
+            FRAME.saturating_sub(now - applied)
+        });
+        if !due.is_zero() {
+            return Some(due);
+        }
+        let update = self.queue.pop_front()?;
+        self.apply(update);
+        self.applied = Some(now);
+        (!self.queue.is_empty()).then_some(FRAME)
+    }
+}
+
+static RASTERS: Mutex<BTreeMap<String, Raster>> = Mutex::new(BTreeMap::new());
+
+fn rasters() -> std::sync::MutexGuard<'static, BTreeMap<String, Raster>> {
+    RASTERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// `terminal.blit`: queues a partial update of the caller's own raster under the frame budget.
+pub(crate) fn blit(
+    caller: &str,
+    owner: Option<String>,
+    size: Option<(u16, u16)>,
+    arguments: &Value,
+    now: Instant,
+) -> Result<Value, String> {
+    let mut update =
+        codex_omd::client_surface::blit_request(caller, owner.as_deref(), size, arguments)?;
+    if !update
+        .cells
+        .iter()
+        .all(|cell| cell.symbol.graphemes(true).count() == 1 && cell.symbol.width() == 1)
+    {
+        return Err("terminal_blit_invalid".into());
+    }
+    let (width, height) = size.ok_or("terminal_blit_unknown")?;
+    let (key, bytes) = (std::mem::take(&mut update.key), update.bytes);
+    let mut rasters = rasters();
+    if !rasters.contains_key(&key)
+        && rasters
+            .values()
+            .filter(|raster| raster.owner == caller)
+            .count()
+            >= RASTERS_PER_MOD
+    {
+        return Err("terminal_blit_limit".into());
+    }
+    let raster = rasters
+        .entry(key)
+        .and_modify(|raster| {
+            if (raster.width, raster.height) != (width, height) || raster.owner != caller {
+                *raster = Raster::new(caller, width, height);
+            }
+        })
+        .or_insert_with(|| Raster::new(caller, width, height));
+    let full = |raster: &Raster| {
+        raster.queue.len() >= QUEUE_UPDATES || raster.queued_bytes + bytes > QUEUE_BYTES
+    };
+    if full(raster) {
+        raster.advance(now);
+    }
+    if full(raster) {
+        let wait = raster.applied.map_or(FRAME, |applied| {
+            FRAME
+                .saturating_sub(now - applied)
+                .max(Duration::from_millis(1))
+        });
+        return Ok(json!({"status": "backpressure", "retry_after_ms": wait.as_millis() as u64}));
+    }
+    raster.queued_bytes += bytes;
+    raster.queue.push_back(update);
+    Ok(json!({
+        "frame": raster.frames + raster.queue.len() as u64,
+        "queued": raster.queue.len(),
+        "frame_ms": FRAME.as_millis() as u64,
+    }))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rows(
+    id: &str,
+    owner: Option<&str>,
+    alt: &str,
+    width: u16,
+    size: (u16, u16),
+    no_color: bool,
+    prefix: &str,
+    now: Instant,
+) -> (Vec<Line<'static>>, Option<Duration>) {
+    let mut rasters = rasters();
+    if rasters
+        .get(id)
+        .is_some_and(|raster| Some(raster.owner.as_str()) != owner)
+    {
+        rasters.remove(id);
+    }
+    let Some(raster) = rasters.get_mut(id) else {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], None);
+    };
+    let next = raster.advance(now);
+    if raster.frames == 0 {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], next);
+    }
+    let visible = usize::from(width.min(raster.width).min(size.0));
+    let rows = raster
+        .cells
+        .chunks(usize::from(raster.width))
+        .take(usize::from(size.1))
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend(row.iter().take(visible).map(|cell| {
+                let mut style = Style::default();
+                if !no_color {
+                    if let Some(fg) = cell.fg {
+                        style = style.fg(crate::mod_ui::color(fg));
+                    }
+                    if let Some(bg) = cell.bg {
+                        style = style.bg(crate::mod_ui::color(bg));
+                    }
+                }
+                let symbol = if cell.symbol.is_empty() {
+                    " "
+                } else {
+                    &cell.symbol
+                };
+                Span::styled(symbol.to_owned(), style)
+            }));
+            Line::from(spans)
+        })
+        .collect();
+    (rows, next)
+}
+
+pub(crate) fn retain(ids: &BTreeSet<String>) {
+    rasters().retain(|id, _| ids.contains(id));
+}
