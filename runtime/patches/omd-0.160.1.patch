+    }
+    assert!(
+        check(
+            Some(&approver),
+            "network",
+            "ask",
+            json!({"host": "index.crates.io"})
+        )
+        .is_ok()
+    );
+    assert!(
+        check(
+            Some(&approver),
+            "network",
+            "ask",
+            json!({"host": "evil.example"})
+        )
+        .is_err()
+    );
+    assert!(
