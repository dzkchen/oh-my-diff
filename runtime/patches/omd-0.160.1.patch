+    gate.close().await;
+    let params = serde_json::from_value(json!({"name": "late",
+        "renderer": {"kind": "gui", "formats": ["svg"], "pointer": "pixel"}}))
+    .unwrap();
+    let refused = clients
+        .attach(
+            ConnectionRequestId {
+                connection_id: ConnectionId(93),
