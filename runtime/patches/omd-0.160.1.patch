+use codex_utils_output_truncation::approx_token_count;
+
+/// Where one compaction occurrence comes from, as offered to contributors.
+#[derive(Clone, Copy)]
+pub(crate) struct Occurrence {
+    pub(crate) trigger: CompactionTrigger,
+    pub(crate) reason: CompactionReason,
+    pub(crate) phase: CompactionPhase,
+    pub(crate) implementation: &'static str,
+}
+
+impl Occurrence {
+    pub(crate) fn new(
+        trigger: CompactionTrigger,
+        reason: CompactionReason,
+        phase: CompactionPhase,
+        implementation: Option<CompactionImplementation>,
+    ) -> Self {
+        let implementation = match implementation {
+            Some(CompactionImplementation::Responses) => "local",
+            Some(CompactionImplementation::ResponsesCompactionV2) => "remote",
+            None => "budget",
+        };
+        Self {
+            trigger,
+            reason,
+            phase,
+            implementation,
+        }
+    }
+}
+
+pub(crate) struct Native {
+    pub(crate) summary_prompt: Option<String>,
+    settle: Option<CompactionSettle>,
+}
+
+/// A contributor skipped compaction in this turn; later automatic occurrences stay held.
+struct SkippedThisTurn {
+    by: String,
+}
+
+pub(crate) enum Plan {
+    Native(Native),
+    Held,
+    Replace(CompactionReplacement),
+}
+
+fn label<T: serde::Serialize>(value: T) -> String {
+    serde_json::to_value(value)
+        .ok()
+        .and_then(|value| value.as_str().map(str::to_owned))
+        .unwrap_or_default()
+}
+
+fn serialize<'a>(items: impl IntoIterator<Item = &'a ResponseItem>) -> Vec<serde_json::Value> {
+    items
+        .into_iter()
+        .filter_map(|item| serde_json::to_value(item).ok())
+        .collect()
+}
+
+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    use codex_extension_api::{
+        CompactionInterceptInput, CompactionLifecycleInput, ExtensionFuture,
+        TurnLifecycleContributor,
+    };
+
+    struct Skip(std::sync::Mutex<Vec<&'static str>>);
+    impl TurnLifecycleContributor for Skip {
+        fn plan_compaction<'a>(
+            &'a self,
+            _: CompactionInterceptInput<'a>,
+        ) -> ExtensionFuture<'a, CompactionPlan> {
+            Box::pin(async {
+                CompactionPlan::Skip {
+                    by: "fixture".into(),
+                    reason: "hold".into(),
+                }
+            })
+        }
+        fn on_compaction_start<'a>(
+            &'a self,
+            _: CompactionLifecycleInput<'a>,
+        ) -> ExtensionFuture<'a, ()> {
+            self.0.lock().unwrap().push("start");
+            Box::pin(async {})
+        }
+        fn on_compaction_end<'a>(
+            &'a self,
+            input: CompactionLifecycleInput<'a>,
+        ) -> ExtensionFuture<'a, ()> {
+            assert_eq!(input.outcome, Some("skipped"));
+            assert_eq!(input.by, Some("fixture"));
+            self.0.lock().unwrap().push("end");
+            Box::pin(async {})
+        }
+    }
+
+    #[tokio::test]
+    async fn skipped_and_held_compactions_pair_each_started_occurrence() {
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let observer = Arc::new(Skip(std::sync::Mutex::new(Vec::new())));
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.turn_lifecycle_contributor(observer.clone());
+        session.services.extensions = Arc::new(builder.build());
+        let (session, turn) = (Arc::new(session), Arc::new(turn));
+        for _ in 0..2 {
+            crate::hook_runtime::run_pre_compact_hooks(&session, &turn, CompactionTrigger::Auto)
+                .await;
+            let occurrence = Occurrence::new(
+                CompactionTrigger::Auto,
+                CompactionReason::UserRequested,
+                CompactionPhase::PreTurn,
+                None,
+            );
+            assert!(matches!(
+                plan(&session, &turn, occurrence, None).await.unwrap(),
+                Plan::Held
+            ));
+        }
+        assert_eq!(
+            *observer.0.lock().unwrap(),
+            vec!["start", "end", "start", "end"]
+        );
+    }
+}
+
+/// Asks contributors how to handle this occurrence; skips and deferrals at the hard limit fail.
+pub(crate) async fn plan(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    occurrence: Occurrence,
+    summary_prompt: Option<&str>,
+) -> CodexResult<Plan> {
+    let contributors = sess.services.extensions.turn_lifecycle_contributors();
+    if contributors.is_empty() {
+        return Ok(Plan::Native(Native {
+            summary_prompt: None,
+            settle: None,
+        }));
+    }
+    let tokens = sess.get_total_token_usage().await;
+    let context_window = turn_context.model_context_window();
+    let hard = context_window.is_some_and(|window| tokens >= window);
+    if !hard
+        && matches!(occurrence.trigger, CompactionTrigger::Auto)
+        && let Some(skipped) = turn_context.extension_data.get::<SkippedThisTurn>()
+    {
+        crate::hook_runtime::notify_compaction_lifecycle(
+            sess,
+            turn_context,
+            occurrence.trigger,
+            Some(("skipped", Some(&skipped.by), false)),
+        )
+        .await;
+        return Ok(Plan::Held);
+    }
+    let history = serialize(sess.clone_history().await.raw_items());
+    let (trigger, reason, phase) = (
+        label(occurrence.trigger),
+        label(occurrence.reason),
+        label(occurrence.phase),
+    );
+    for contributor in contributors {
+        let plan = contributor
+            .plan_compaction(codex_extension_api::CompactionInterceptInput {
+                turn_id: turn_context.sub_id.as_str(),
+                trigger: &trigger,
+                reason: &reason,
+                phase: &phase,
+                implementation: occurrence.implementation,
+                tokens,
+                auto_limit: turn_context.model_info().auto_compact_token_limit(),
+                context_window,
+                hard,
+                history: &history,
+                summary_prompt,
+                session_store: &sess.services.session_extension_data,
+                thread_store: &sess.services.thread_extension_data,
+                turn_store: turn_context.extension_data.as_ref(),
+            })
+            .await;
+        let (outcome, by, why) = match plan {
+            CompactionPlan::Native {
+                summary_prompt: None,
+                settle: None,
+            } => continue,
+            CompactionPlan::Native {
+                summary_prompt,
+                settle,
+            } => {
+                return Ok(Plan::Native(Native {
+                    summary_prompt,
+                    settle,
+                }));
+            }
+            CompactionPlan::Replace(replacement) => return Ok(Plan::Replace(replacement)),
+            CompactionPlan::Fail(reason) => return Err(CodexErr::InvalidRequest(reason)),
+            CompactionPlan::Skip { by, reason } => ("skipped", by, reason),
+            CompactionPlan::Defer { by, reason } => ("deferred", by, reason),
+        };
+        if outcome == "skipped" {
+            turn_context
+                .extension_data
+                .insert(SkippedThisTurn { by: by.clone() });
+        }
+        if hard {
+            return Err(CodexErr::InvalidRequest(format!(
+                "compaction_required: {by} {outcome} compaction at the context limit ({why}); \
+                 fix or disable that mod, or run /compact"
+            )));
+        }
+        sess.send_event(
+            turn_context,
+            EventMsg::Warning(WarningEvent {
+                message: format!("Compaction {outcome} by {by}: {why}"),
+            }),
+        )
+        .await;
+        crate::hook_runtime::notify_compaction_lifecycle(
+            sess,
+            turn_context,
+            occurrence.trigger,
+            Some((outcome, Some(by.as_str()), false)),
+        )
+        .await;
+        return Ok(Plan::Held);
+    }
+    Ok(Plan::Native(Native {
+        summary_prompt: None,
+        settle: None,
+    }))
+}
+
+impl Native {
+    /// Offers the host's result back to the contributor that let it run.
+    pub(crate) async fn settle(
+        self,
+        history: &[ResponseItemEnvelope],
+        summary: Option<&str>,
+        usage: Option<&TokenUsage>,
+        provider_call: bool,
+    ) -> Option<CompactionReplacement> {
+        let settle = self.settle?;
+        settle(CompactionSettled {
+            summary: summary.map(str::to_owned),
+            history: serialize(history.iter().map(|envelope| &envelope.item)),
+            provider_call,
+            usage: usage.cloned(),
+        })
+        .await
+    }
+}
+
+/// Installs a contributor's summary or validated history in place of the host's own result.
+pub(crate) async fn install(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    initial_context_injection: &InitialContextInjection,
+    replacement: CompactionReplacement,
+    emit_item: bool,
+) -> CodexResult<String> {
+    let (by, history, message) = match replacement {
+        CompactionReplacement::Summary { by, text } => {
+            let summary_text = format!("{SUMMARY_PREFIX}\n{text}");
+            let snapshot = sess.clone_history().await;
+            let user_messages = collect_annotated_user_messages(snapshot.annotated_items());
+            let mut history = build_compacted_history(Vec::new(), &user_messages, &summary_text);
+            if let Some(summary_item) = history.last_mut() {
+                summary_item.set_turn_id_if_missing(&turn_context.sub_id);
+            }
+            (by, history, summary_text)
+        }
+        CompactionReplacement::History { by, items } => {
+            let history = items
+                .into_iter()
+                .map(serde_json::from_value::<ResponseItem>)
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|error| {
+                    CodexErr::InvalidRequest(format!(
+                        "compaction_history_invalid: {by} returned an unreadable item: {error}"
+                    ))
+                })?;
+            let history = history.into_iter().map(ResponseItemEnvelope::new).collect();
+            (by, history, String::new())
+        }
+    };
+    let estimate: usize = history
+        .iter()
+        .map(|envelope| {
+            approx_token_count(&serde_json::to_string(&envelope.item).unwrap_or_default())
+        })
+        .sum();
+    if let Some(window) = turn_context.model_context_window()
+        && i64::try_from(estimate).unwrap_or(i64::MAX) >= window
+    {
+        return Err(CodexErr::InvalidRequest(format!(
+            "compaction_replacement_over_limit: {by} returned about {estimate} tokens for a \
+             {window}-token context window"
+        )));
+    }
+    let compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::new());
+    if emit_item {
+        sess.emit_turn_item_started(turn_context, &compaction_item)
+            .await;
+    }
+    let (initial_context, world_state_baseline) =
+        build_compaction_initial_context(sess.as_ref(), initial_context_injection).await;
+    let history = if initial_context.is_empty() {
+        history
+    } else {
+        insert_initial_context_before_last_real_user_or_summary(history, initial_context)
+    };
+    let reference_context_item = match initial_context_injection {
+        InitialContextInjection::DoNotInject => None,
+        InitialContextInjection::BeforeLastUserMessage { step_context, .. } => {
+            Some(step_context.to_turn_context_item())
+        }
+    };
+    let (window_number, window_ids) = sess.advance_auto_compact_window().await;
+    sess.replace_compacted_history(
+        history,
+        reference_context_item,
+        world_state_baseline,
+        CompactedHistoryMetadata {
+            message,
+            window_number,
+            window_ids,
+            compaction_response_id: None,
+            compaction_model_hash: None,
+            reviewer_compaction_hash: None,
+        },
+    )
+    .await;
+    sess.recompute_token_usage(turn_context).await;
+    if emit_item {
+        sess.emit_turn_item_completed(turn_context, compaction_item)
+            .await;
+    }
+    Ok(by)
+}
