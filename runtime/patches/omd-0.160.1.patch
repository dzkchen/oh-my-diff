+        .into_iter()
+        .collect();
+    crate::mod_raster::blit(
+        "demo",
+        Some("demo".into()),
+        Some((6, 2)),
+        &serde_json::json!({"key":"nested_chart","rect":{"x":0,"y":0,"width":6,"height":2},
+            "cells":["a","b","c","d","e","f","g","h","i","j","k","l"]}),
+        std::time::Instant::now(),
+    )
+    .expect("queued");
+    let area = Rect::new(0, 0, 80, 24);
+    preview(view.clone());
+    render(area, area, &mut Buffer::empty(area), &view);
+    let (left, anchors, region) = {
+        let interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        (
+            interaction.anchors["intro"].x,
+            interaction.anchors.clone(),
+            interaction
+                .regions
+                .iter()
+                .find(|region| region.id == "nested_chart")
+                .cloned()
+                .expect("chart region"),
+        )
+    };
+    assert_eq!(anchors["inner"].x, left + 1);
+    assert_eq!(anchors["frame"].x, left);
+    assert_eq!(
+        anchors["frame"].union(anchors["nested_chart"]),
+        anchors["frame"],
+        "a box anchors all its rows"
+    );
+    assert!(anchors["frame"].y < anchors["inner"].y);
+    assert_eq!((region.area.x, region.area.width), (left + 1, 6));
+    let (x, y) = (region.area.x, region.area.y);
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 2, y + 1),
+        (
