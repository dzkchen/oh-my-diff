+fn caller<'a>(core: &Core, id: &'a str) -> Caller<'a> {
+    Caller {
+        id,
+        source: "",
+        grants: core.runtime.lock().unwrap().grants(id),
+        generation: 0,
+        origin: Origin::Event,
+        record_changes: false,
+    }
+}
