+}
+
+async fn rewrite(
+    mcp: &mut TestAppServer,
+    thread_id: &str,
+    expected_revision: Option<String>,
+    edits: Vec<serde_json::Value>,
+    undo: bool,
+) -> Result<ThreadRewriteResponse> {
+    mcp.request(|request_id| ClientRequest::ThreadRewrite {
+        request_id,
