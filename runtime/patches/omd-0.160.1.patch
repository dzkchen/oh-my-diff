+    assert_eq!(result["timed_out"], false);
+    assert_eq!(result["program"]["sha256"].as_str().unwrap().len(), 64);
+    assert_eq!(authority.sandboxed.borrow().last(), Some(&(false, false)));
+
+    let denied = host
+        .call(
+            &reader,
+            "exec.run",
