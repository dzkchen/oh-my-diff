+struct Paced(Vec<&'static [u8]>, std::sync::mpsc::Receiver<()>);
+
+impl Read for Paced {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        if self.0.len() == 1 {
+            let _ = self.1.recv();
+        }
+        let Some(piece) = self.0.pop() else {
+            return Ok(0);
+        };
+        buffer[..piece.len()].copy_from_slice(piece);
+        Ok(piece.len())
+    }
+}
