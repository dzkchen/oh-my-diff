diff --git a/codex-rs/ext/omd/src/mods/intercept.rs b/codex-rs/ext/omd/src/mods/intercept.rs
new file mode 100644
index 000000000..873f9843e
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/intercept.rs
@@ -0,0 +1,182 @@
+use super::*;
+use codex_omd::data_store::Origin;
+use operations::Caller;
+
+/// Runs a continuation chain off the async runtime; each interceptor's host calls run under its own grants.
+#[allow(clippy::too_many_arguments)]
+pub(super) async fn chain(
+    core: Arc<Core>,
+    lead: Arc<Lead>,
+    runtime: Arc<Mutex<ModHost>>,
+    surface: &'static str,
+    required: bool,
+    input: Value,
+    origin: Value,
+    cancelled: Arc<AtomicBool>,
+    executor: impl FnMut(Value) -> std::io::Result<Value> + Send + 'static,
+) -> Result<codex_omd::ModChain, String> {
+    let (facts, generation) = {
+        let runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned")?;
+        (facts(&runtime), runtime.generation())
+    };
+    let (requests, mut receiver) = tokio::sync::mpsc::channel::<HostRequest>(1);
+    let (flag, thread) = (cancelled.clone(), lead.thread.to_string());
+    let handle = tokio::task::spawn_blocking(move || {
+        let _thread = codex_omd::StateThread::enter(Some(thread));
+        let active = || !flag.load(Ordering::Acquire);
+        codex_omd::intercept_shared(
+            &runtime,
+            surface,
+            required,
+            input,
+            origin,
+            active,
+            |caller, request| {
+                if !operations::event_allows("intercept", &request.operation) {
+                    return Err(std::io::Error::other(format!(
+                        "host_operation_unavailable: {} is not available to interceptors",
+                        request.operation
+                    )));
+                }
+                forward(&requests, &facts, caller, request, &active)
+            },
+            executor,
+        )
+        .map_err(|error| error.to_string())
+    });
+    while let Some(call) = receiver.recv().await {
+        let value = operations::dispatch(
+            &core,
+            &lead,
+            Caller {
+                id: &call.caller,
+                source: &call.source,
+                grants: call.grants,
+                generation,
+                origin: Origin::Event,
+                record_changes: true,
+            },
+            None,
+            call.request,
+            &cancelled,
+        )
+        .await;
+        let _ = call.reply.send(value.map_err(std::io::Error::other));
+    }
+    let result = handle.await.map_err(|error| error.to_string())?;
+    core.cleanup_failed(Some(&lead)).await;
+    result
+}
+
+/// The mod whose result settled last, i.e. the outermost link that answered or transformed it.
+pub(super) fn settled_by(chain: &codex_omd::ModChain) -> String {
+    chain
+        .trace
+        .iter()
+        .rev()
+        .find(|entry| matches!(entry["outcome"].as_str(), Some("returned" | "caught")))
+        .and_then(|entry| entry["mod"].as_str())
+        .unwrap_or("mod")
+        .to_owned()
+}
+
+/// Lets model-request interceptors call host operations from the transport thread.
+pub(super) fn install_dispatcher(core: &Arc<Core>) {
+    let notified = Arc::downgrade(core);
+    core.host.accounts.install_mod_notifier(Arc::new(
+        move |event: &'static str, payload: Value| {
+            if let Some(core) = notified.upgrade() {
+                if event == "model_response" {
+                    core.inventory.usage(&payload);
+                    if let Some(thread) = payload["scope"]["thread_id"].as_str() {
+                        core.autonomy
+                            .charge(&core.inventory.root_thread(thread), &payload);
+                    }
+                }
+                expansion::broadcast(&core.expansion, event, payload);
+            }
+        },
+    ));
+    let weak = Arc::downgrade(core);
+    let session = tokio::runtime::Handle::try_current().ok();
+    let dispatcher: codex_omd::host::SessionDispatcher = Arc::new(
+        move |thread: &str, caller: &str, request: ModHostCall, active: &dyn Fn() -> bool| {
+            let unavailable = |reason: &str| {
+                std::io::Error::other(format!("host_operation_unavailable: {reason}"))
+            };
+            let core = weak
+                .upgrade()
+                .ok_or_else(|| unavailable("native host stopped"))?;
+            let (handle, worker) = match tokio::runtime::Handle::try_current() {
+                Ok(handle)
+                    if handle.runtime_flavor() == tokio::runtime::RuntimeFlavor::MultiThread =>
+                {
+                    (handle, true)
+                }
+                Ok(_) => {
+                    return Err(unavailable(
+                        "host calls from this thread need the multi-threaded session runtime",
+                    ));
+                }
+                Err(_) => (
+                    session
+                        .clone()
+                        .ok_or_else(|| unavailable("no session runtime"))?,
+                    false,
+                ),
+            };
+            if !operations::event_allows("intercept", &request.operation) {
+                return Err(unavailable(&request.operation));
+            }
+            let lead = ThreadId::from_string(thread)
+                .ok()
+                .and_then(|thread| core.expansion.thread(thread))
+                .ok_or_else(|| unavailable("no session for this thread"))?;
+            let ((source, grants), generation) = {
+                let runtime = core
+                    .runtime
+                    .lock()
+                    .map_err(|_| std::io::Error::other("mod_runtime_poisoned"))?;
+                (
+                    facts(&runtime).remove(caller).unwrap_or_default(),
+                    runtime.generation(),
+                )
+            };
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let future = async {
+                tokio::select! {
+                    value = operations::dispatch(
+                        &core,
+                        &lead,
+                        Caller {
+                            id: caller,
+                            source: &source,
+                            grants,
+                            generation,
+                            origin: Origin::Event,
+                            record_changes: true,
+                        },
+                        None,
+                        request,
+                        &cancelled,
+                    ) => value.map_err(std::io::Error::other),
+                    () = async {
+                        while active() {
+                            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+                        }
+                    } => Err(std::io::Error::other("callback_cancelled")),
+                }
+            };
+            if worker {
+                tokio::task::block_in_place(|| handle.block_on(future))
+            } else {
+                handle.block_on(future)
+            }
+        },
+    );
+    core.host
+        .accounts
+        .install_mod_dispatcher(dispatcher.clone());
+    codex_omd::host::install_session_dispatcher(dispatcher);
+}
diff --git a/codex-rs/ext/omd/src/mods/inventory.rs b/codex-rs/ext/omd/src/mods/inventory.rs
new file mode 100644
index 000000000..874a6b63b
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/inventory.rs
@@ -0,0 +1,200 @@
+use super::*;
+use std::collections::BTreeSet;
+
+const ANSWER_CHARS: usize = 4096;
+const FINISHED_LIMIT: usize = 64;
+
+/// Session-wide agent records; observing one grants no control over it.
+#[derive(Default)]
+pub(super) struct Inventory {
+    records: Mutex<BTreeMap<String, Value>>,
+}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64)
+}
+
+impl Inventory {
+    /// Records a started agent keyed by its thread and returns the record.
+    pub(super) fn start(&self, thread: &str, fields: Value) -> Value {
+        let mut record = json!({"agent_id": null, "thread_id": thread,
+            "parent": {"thread_id": null, "agent_id": null}, "origin": "native", "owner": null,
+            "definition": null, "role": null, "status": "running", "started_at_ms": now_ms(),
+            "ended_at_ms": null, "duration_ms": null, "turns": 0, "last_turn": null, "answer": null,
+            "usage": {"requests": 0, "input_tokens": 0, "output_tokens": 0, "cached_tokens": 0,
+                "microusd": 0, "basis": "unknown", "source": null}, "reason": null});
+        if let (Some(record), Some(fields)) = (record.as_object_mut(), fields.as_object()) {
+            record.extend(fields.clone());
+        }
+        if let Ok(mut records) = self.records.lock() {
+            let finished = records
+                .iter()
+                .filter(|(_, record)| record["status"] != "running")
+                .map(|(thread, record)| (record["ended_at_ms"].as_u64(), thread.clone()))
+                .collect::<BTreeSet<_>>();
+            for (_, thread) in finished
+                .iter()
+                .take(finished.len().saturating_sub(FINISHED_LIMIT - 1))
+            {
+                records.remove(thread);
+            }
+            records.insert(thread.to_owned(), record.clone());
+        }
+        record
+    }
+
+    fn update(&self, thread: &str, change: impl FnOnce(&mut Value)) -> Option<Value> {
+        let mut records = self.records.lock().ok()?;
+        let record = records.get_mut(thread)?;
+        change(record);
+        Some(record.clone())
+    }
+
+    pub(super) fn contains(&self, thread: &str) -> bool {
+        self.records
+            .lock()
+            .is_ok_and(|records| records.contains_key(thread))
+    }
+
+    pub(super) fn answer(&self, thread: &str, text: &str) {
+        self.update(thread, |record| {
+            record["answer"] = json!(text.chars().take(ANSWER_CHARS).collect::<String>());
+        });
+    }
+
+    pub(super) fn turn(
+        &self,
+        thread: &str,
+        turn_id: &str,
+        outcome: &str,
+        error: Value,
+    ) -> Option<Value> {
+        self.update(thread, |record| {
+            record["turns"] = json!(record["turns"].as_u64().unwrap_or(0) + 1);
+            record["last_turn"] = json!({"turn_id": turn_id, "outcome": outcome, "at_ms": now_ms(),
+                "answer": record["answer"], "error": error});
+        })
+    }
+
+    /// Adds one `model_response` report to its thread's usage; unpriced spend makes the total partial.
+    pub(super) fn usage(&self, response: &Value) {
+        let Some(thread) = response["scope"]["thread_id"].as_str() else {
+            return;
+        };
+        let tokens = |pointer: &str| response["usage"].pointer(pointer).and_then(Value::as_u64);
+        self.update(thread, |record| {
+            let usage = &mut record["usage"];
+            if usage["source"] != "accounting" {
+                *usage = json!({"requests": 0, "input_tokens": 0, "output_tokens": 0,
+                    "cached_tokens": 0, "microusd": 0, "basis": "unknown", "source": "accounting"});
+            }
+            let add = |usage: &mut Value, key: &str, amount: Option<u64>| {
+                usage[key] = json!(usage[key].as_u64().unwrap_or(0) + amount.unwrap_or(0));
+            };
+            add(usage, "requests", Some(1));
+            add(usage, "input_tokens", tokens("/input_tokens"));
+            add(usage, "output_tokens", tokens("/output_tokens"));
+            add(
+                usage,
+                "cached_tokens",
+                tokens("/input_tokens_details/cached_tokens"),
+            );
+            let priced = response["cost"]["microusd"].as_u64();
+            add(usage, "microusd", priced);
+            let first = usage["requests"] == 1;
+            usage["basis"] = json!(match (usage["basis"].as_str(), priced) {
+                (Some("unknown"), None) => "unknown",
+                (Some("unknown"), Some(_)) if first => "settled",
+                (Some("settled"), Some(_)) => "settled",
+                _ => "partial",
+            });
+        });
+    }
+
+    /// Engine token totals for agents whose requests bypass OMD accounting; cost stays unknown.
+    pub(super) fn tokens(&self, thread: &str, total: &codex_protocol::protocol::TokenUsage) {
+        self.update(thread, |record| {
+            if record["usage"]["source"] == "accounting" {
+                return;
+            }
+            let count = |value: i64| u64::try_from(value).unwrap_or(0);
+            record["usage"] = json!({"requests": null, "input_tokens": count(total.input_tokens),
+                "output_tokens": count(total.output_tokens), "cached_tokens": count(total.cached_input_tokens),
+                "microusd": null, "basis": "unknown", "source": "engine"});
+        });
+    }
+
+    pub(super) fn end(&self, thread: &str, status: &str, reason: Option<String>) -> Option<Value> {
+        self.update(thread, |record| {
+            if record["status"] != "running" {
+                return;
+            }
+            let ended = now_ms();
+            record["status"] = json!(status);
+            record["reason"] = json!(reason);
+            record["ended_at_ms"] = json!(ended);
+            record["duration_ms"] =
+                json!(ended.saturating_sub(record["started_at_ms"].as_u64().unwrap_or(ended)));
+        })
+        .filter(|record| record["reason"] == json!(reason) && record["status"] == status)
+    }
+
+    /// The session thread at the root of `thread`'s parent chain; a thread without an agent record is its own root.
+    pub(super) fn root_thread(&self, thread: &str) -> String {
+        let Ok(records) = self.records.lock() else {
+            return thread.to_owned();
+        };
+        let mut root = thread;
+        for _ in 0..16 {
+            match records
+                .get(root)
+                .and_then(|record| record["parent"]["thread_id"].as_str())
+            {
+                Some(parent) => root = parent,
+                None => break,
+            }
+        }
+        root.to_owned()
+    }
+
+    pub(super) fn list(&self) -> Vec<Value> {
+        self.records
+            .lock()
+            .map(|records| records.values().cloned().collect())
+            .unwrap_or_default()
+    }
+}
+
+/// Publishes an `agent` lifecycle event to every observer, in order, under the session thread's state.
+pub(super) fn notify(
+    runtime: &Arc<Mutex<ModHost>>,
+    inventory: &Inventory,
+    phase: &str,
+    record: Value,
+) {
+    type Delivery = (Arc<Mutex<ModHost>>, Option<String>, Value);
+    static QUEUE: std::sync::OnceLock<std::sync::mpsc::Sender<Delivery>> =
+        std::sync::OnceLock::new();
+    let queue = QUEUE.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel::<Delivery>();
+        std::thread::spawn(move || {
+            for (runtime, thread, payload) in receiver {
+                let _thread = codex_omd::StateThread::enter(thread);
+                if let Ok(mut runtime) = runtime.lock() {
+                    let _ = runtime.event("agent", payload);
+                }
+            }
+        });
+        sender
+    });
+    let thread = record["parent"]["thread_id"]
+        .as_str()
+        .map(|parent| inventory.root_thread(parent));
+    let _ = queue.send((
+        runtime.clone(),
+        thread,
+        json!({"phase": phase, "agent": record}),
+    ));
+}
diff --git a/codex-rs/ext/omd/src/mods/operations.rs b/codex-rs/ext/omd/src/mods/operations.rs
new file mode 100644
index 000000000..a143b5697
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/operations.rs
@@ -0,0 +1,646 @@
+use super::*;
+use crate::workspace_operations::WorkspaceAuthority;
+use codex_omd::data_store::Origin;
+
+#[derive(Clone, Default)]
+pub(crate) struct DataScope(pub(super) Arc<Mutex<Option<codex_omd::scoped_data::ScopedDataHosts>>>);
+
+impl DataScope {
+    async fn call(
+        &self,
+        lead: &Lead,
+        authority: WorkspaceAuthority,
+        caller: &Caller<'_>,
+        request: ModHostCall,
+        cancelled: Arc<AtomicBool>,
+    ) -> Result<Value, String> {
+        let root = lead.host.root.clone();
+        let scope = self.0.clone();
+        let thread = lead.thread.to_string();
+        let (id, source) = (caller.id.to_owned(), caller.source.to_owned());
+        tokio::task::spawn_blocking(move || {
+            let mut scope = scope.lock().map_err(|_| "data_scope_poisoned")?;
+            scope
+                .get_or_insert_with(|| {
+                    codex_omd::scoped_data::ScopedDataHosts::new(
+                        root,
+                        authority.repository.clone(),
+                        authority.session_root.clone(),
+                        authority.session_database.clone(),
+                        thread,
+                    )
+                })
+                .call(&id, &source, &request.operation, request.arguments, || {
+                    !cancelled.load(Ordering::Acquire)
+                })
+                .map_err(|error| error.to_string())
+        })
+        .await
+        .map_err(|error| error.to_string())?
+    }
+}
+
+pub(super) struct Caller<'a> {
+    pub id: &'a str,
+    pub source: &'a str,
+    pub grants: Option<ModGrants>,
+    pub generation: u64,
+    pub origin: Origin,
+    pub record_changes: bool,
+}
+
+pub(super) fn event_allows(event: &str, operation: &str) -> bool {
+    crate::generic_host::event_allows(event, operation)
+        || super::expansion::event_allows(event)
+        || event == "context"
+            && (codex_omd::scoped_data::operation(operation)
+                || matches!(
+                    operation,
+                    "store.get"
+                        | "store.list"
+                        | "routes.list"
+                        | "session.info"
+                        | "task.status"
+                        | "contract.status"
+                        | "workspace.fingerprint"
+                ))
+}
+
+pub(super) fn route_info(host: &Host, route: &config::Route) -> Value {
+    let available = route.grant.as_ref().is_none_or(|grant| {
+        accounting::worker_authorized(
+            &grant.path,
+            &grant.sha256,
+            &host.repository_identity,
+            &route.provider,
+            &route.model,
+            &route.responses_url,
+            route.rates.included_subscription,
+        )
+    });
+    json!({"name": route.name, "model": route.model, "provider": route.provider,
+        "reasoning": route.reasoning_effort, "roles": route.roles,
+        "billing": accounting::billing(Some(&route.rates)),
+        "tools": route.tools, "available": available, "credential": route.credential})
+}
+
+async fn authority(lead: &Lead, call: Option<&ToolCall<'_>>) -> Result<WorkspaceAuthority, String> {
+    match call {
+        Some(call) => WorkspaceAuthority::for_call(lead, call).await,
+        None => WorkspaceAuthority::for_lead(lead).await,
+    }
+}
+
+pub(super) fn exclusive(session: &Session) -> Result<OperationGuard, String> {
+    acquire_workspace_operation(&session.repository_identity)
+}
+
+fn needs_exclusive_workspace(operation: &str, arguments: &Value) -> bool {
+    matches!(operation, "workspace.transaction" | "workspace.restore")
+        || operation == "exec.run"
+            && arguments.get("snapshot").is_none()
+            && (arguments.get("write") == Some(&Value::Bool(true))
+                || arguments.get("guards").is_some()
+                || arguments.get("required_access").is_some())
+}
+
+fn workspace_guard(
+    operation: &str,
+    arguments: &Value,
+    repository_identity: &str,
+) -> Result<Option<OperationGuard>, String> {
+    needs_exclusive_workspace(operation, arguments)
+        .then(|| acquire_workspace_operation(repository_identity))
+        .transpose()
+}
+
+pub(super) fn now() -> u128 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_millis())
+        .unwrap_or_default()
+}
+
+fn notify_contract(core: &Core, payload: Value) {
+    let runtime = core.runtime.clone();
+    tokio::task::spawn_blocking(move || {
+        if let Ok(mut runtime) = runtime.lock() {
+            let _ = runtime.event("contract", payload);
+        }
+    });
+}
+
+async fn submit_receipt(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        kind: String,
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+        outcome: codex_omd::ReceiptOutcome,
+        evidence: codex_omd::resource_data::ResourceRef,
+        #[serde(default)]
+        agent: Option<String>,
+        #[serde(default)]
+        execution: bool,
+        #[serde(default)]
+        findings: Vec<codex_omd::ReceiptFinding>,
+        #[serde(default)]
+        resolves: Vec<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    if input.execution && input.agent.is_some() {
+        return Err("receipt_producer_conflict".into());
+    }
+    let producer = match input.agent {
+        Some(handle) => {
+            core.agents
+                .attest(
+                    &handle,
+                    caller.id,
+                    caller.generation,
+                    &lead.session.task,
+                    super::agents::AgentClaim {
+                        candidate_sha256: &input.candidate_sha256,
+                        acceptance_sha256: input.acceptance_sha256.as_deref(),
+                        resolves: &input.resolves,
+                        evidence: &input.evidence,
+                    },
+                )
+                .await?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Agent,
+                handle: Some(handle),
+            }
+        }
+        None if input.execution => {
+            core.agents.attest_execution(
+                lead,
+                caller,
+                &input.candidate_sha256,
+                &input.evidence,
+                input.outcome,
+            )?;
+            codex_omd::ReceiptProducer {
+                kind: codex_omd::ProducerKind::Host,
+                handle: None,
+            }
+        }
+        None => codex_omd::ReceiptProducer {
+            kind: codex_omd::ProducerKind::Lead,
+            handle: None,
+        },
+    };
+    let receipt = codex_omd::Receipt {
+        kind: input.kind,
+        candidate_sha256: input.candidate_sha256,
+        acceptance_sha256: input.acceptance_sha256,
+        outcome: input.outcome,
+        evidence: input.evidence,
+        producer,
+        findings: input.findings,
+        resolves: input.resolves,
+        submitted_by: caller.id.to_owned(),
+        at: now(),
+    };
+    receipt.validate()?;
+    let value = serde_json::to_value(&receipt).map_err(|e| e.to_string())?;
+    let bytes = serde_json::to_vec(&value).map_err(|e| e.to_string())?;
+    lead.session
+        .evidence(&format!("receipt-{}.json", execution::hash(&bytes)), &value)?;
+    let submitted = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .submit(receipt)?;
+    lead.session.persist_contract()?;
+    Ok(submitted)
+}
+
+pub(super) fn gate(
+    core: &Core,
+    lead: &Lead,
+    gate: codex_omd::Gate,
+    candidate_sha256: &str,
+    acceptance_sha256: Option<&str>,
+) -> Result<contract::GateOutcome, String> {
+    let outcome = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .gate(gate, candidate_sha256, acceptance_sha256)?;
+    notify_contract(core, outcome.event(gate, candidate_sha256));
+    Ok(outcome)
+}
+
+async fn complete(core: &Core, lead: &Lead, arguments: Value) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        candidate_sha256: String,
+        #[serde(default)]
+        acceptance_sha256: Option<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    let _workspace_guard = exclusive(&lead.session)?;
+    let host = lead.host.clone();
+    let current = tokio::task::spawn_blocking(move || contract::current_candidate(&host))
+        .await
+        .map_err(|e| e.to_string())??;
+    if current != input.candidate_sha256 {
+        return Err("candidate_changed: the workspace no longer matches candidate_sha256".into());
+    }
+    let outcome = gate(
+        core,
+        lead,
+        codex_omd::Gate::Complete,
+        &current,
+        input.acceptance_sha256.as_deref(),
+    )?;
+    if let Some(refusal) = outcome.refusal() {
+        return Ok(refusal);
+    }
+    let status = lead
+        .session
+        .contract
+        .lock()
+        .map_err(|_| "contract_lock_poisoned")?
+        .status();
+    lead.session.evidence(
+        &format!("completion-{current}-{}.json", now()),
+        &json!({"candidate_sha256": current, "contract": status}),
+    )?;
+    Ok(json!({"status": "completed", "receipts": status["receipts"]}))
+}
+
+pub(super) async fn dispatch(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    let id = caller.id.to_owned();
+    let audited =
+        codex_omd::access_receipt(&id, &request, Ok(&Value::Null)).map(|_| request.clone());
+    let result = run(core, lead, caller, call, request, cancelled).await;
+    if let Some(request) = audited
+        && let Some(receipt) =
+            codex_omd::access_receipt(&id, &request, result.as_ref().map_err(Clone::clone))
+    {
+        lead.session.record_access(&receipt);
+    }
+    result
+}
+
+async fn run(
+    core: &Core,
+    lead: &Lead,
+    caller: Caller<'_>,
+    call: Option<&ToolCall<'_>>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    let host = &lead.host;
+    let operation = request.operation.clone();
+    if operation != "contract.status" {
+        lead.restricted(&operation, &request.arguments)?;
+    }
+    if super::expansion::served(&operation) {
+        return super::expansion::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    let active = {
+        let cancelled = cancelled.clone();
+        move || !cancelled.load(Ordering::Acquire)
+    };
+    if codex_omd::host::served(&operation) {
+        if operation == "exec.run" && request.arguments.get("snapshot").is_some() {
+            if request.arguments.get("guards").is_some()
+                || request.arguments.get("required_access").is_some()
+            {
+                return Err("exec_guards_require_live_workspace".into());
+            }
+            if request.arguments.get("sandbox").is_some() {
+                return Err("exec_snapshot_requires_sandbox".into());
+            }
+            let authority = authority(lead, call).await?;
+            let scoped = Lead {
+                permission_profile: Arc::new(std::sync::Mutex::new(authority.context.permissions)),
+                ..lead.clone()
+            };
+            return core
+                .agents
+                .execute_snapshot(&scoped, &caller, request.arguments, cancelled)
+                .await;
+        }
+        let _guard = workspace_guard(
+            &operation,
+            &request.arguments,
+            &lead.session.repository_identity,
+        )?;
+        let authority = authority(lead, call).await?;
+        let (root, protected) = (host.root.clone(), host.protected_paths());
+        let (id, thread) = (caller.id.to_owned(), lead.thread.to_string());
+        let (grants, origin, record) = (caller.grants, caller.origin, caller.record_changes);
+        return tokio::task::spawn_blocking(move || {
+            crate::generic_host::call(
+                grants,
+                &authority,
+                &root,
+                protected,
+                &id,
+                origin,
+                Some(&thread),
+                request,
+                &active,
+                record,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation == "sessions.snapshot" {
+        let authority = authority(lead, call).await?;
+        let scoped = Lead {
+            permission_profile: Arc::new(std::sync::Mutex::new(authority.context.permissions)),
+            ..lead.clone()
+        };
+        return core
+            .agents
+            .history_evidence(&scoped, &caller, request.arguments, cancelled)
+            .await;
+    }
+    if codex_omd::scoped_data::operation(&operation) {
+        let authority = authority(lead, call).await?;
+        return lead
+            .session
+            .data
+            .call(lead, authority, &caller, request, cancelled.clone())
+            .await;
+    }
+    if operation == "workspace.request_rename" {
+        if call.is_none() {
+            return Err(
+                "host_operation_unavailable: workspace.request_rename runs in tools".into(),
+            );
+        }
+        let _guard = exclusive(&lead.session)?;
+        let authority = authority(lead, call).await?;
+        let runtime = core.input_runtime.clone();
+        let processes = lead.session.processes.clone();
+        let generation = caller.generation;
+        let protected = host.protected_paths();
+        return tokio::task::spawn_blocking(move || {
+            let mut runtime = runtime.lock().map_err(|_| "pre_rename_runtime_poisoned")?;
+            authority.request_rename(
+                request.arguments,
+                &mut runtime,
+                &processes,
+                &protected,
+                generation,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    }
+    if operation.starts_with("process.") {
+        crate::generic_host::process_request_allowed(caller.grants.as_ref(), &request)?;
+        let authority = authority(lead, call).await?;
+        let processes = lead.session.processes.clone();
+        let (id, generation) = (caller.id.to_owned(), caller.generation);
+        let started = (operation == "process.start").then(|| request.arguments.clone());
+        let protected = host.protected_paths();
+        let os_access = caller
+            .grants
+            .as_ref()
+            .and_then(|grants| grants.os_access.clone());
+        let result = tokio::task::spawn_blocking(move || {
+            processes.call(
+                crate::managed_process::ProcessOwner {
+                    id: &id,
+                    generation,
+                    repository: &authority.repository,
+                    policy: &authority.policy,
+                    protected: &protected,
+                    os_access: os_access.as_ref(),
+                },
+                &request.operation,
+                request.arguments,
+                active,
+            )
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+        if let (Some(arguments), Ok(_)) = (started, &result) {
+            super::expansion::process_started(core, lead, caller.id, &arguments);
+        }
+        return result;
+    }
+    if operation.starts_with("agents.")
+        || matches!(
+            operation.as_str(),
+            "workspace.integrate"
+                | "workspace.snapshot"
+                | "workspace.fingerprint"
+                | "model.complete"
+                | "model.fork"
+        )
+    {
+        let scoped = match (operation.as_str(), call) {
+            ("agents.spawn" | "workspace.snapshot" | "workspace.fingerprint", Some(call)) => {
+                let authority = WorkspaceAuthority::for_call(lead, call).await?;
+                Some(Lead {
+                    permission_profile: Arc::new(std::sync::Mutex::new(
+                        authority.context.permissions,
+                    )),
+                    ..lead.clone()
+                })
+            }
+            _ => None,
+        };
+        let lead = scoped.as_ref().unwrap_or(lead);
+        if operation == "workspace.snapshot" {
+            return core
+                .agents
+                .snapshot(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        if operation == "workspace.fingerprint" {
+            return core
+                .agents
+                .fingerprint(lead, &caller, request.arguments, cancelled)
+                .await;
+        }
+        let repository = host.repository.clone();
+        let before = if operation == "workspace.integrate" && caller.record_changes {
+            tokio::task::spawn_blocking(move || codex_omd::change_baseline(&repository))
+                .await
+                .map_err(|e| e.to_string())?
+        } else {
+            None
+        };
+        let result = core
+            .agents
+            .call(core, lead, &caller, request, cancelled)
+            .await;
+        if let (Some(before), Ok(_)) = (before, &result) {
+            let repository = host.repository.clone();
+            let _ = tokio::task::spawn_blocking(move || {
+                codex_omd::record_workspace_change(&repository, "transaction", before)
+            })
+            .await;
+        }
+        return result;
+    }
+    if operation.starts_with("http.") || operation.starts_with("mcp.") {
+        return super::access::dispatch(core, lead, &caller, request, cancelled).await;
+    }
+    if operation.starts_with("providers.") || operation.starts_with("sidecars.") {
+        return core
+            .services
+            .call(lead, caller.id, caller.generation, request)
+            .await;
+    }
+    match operation.as_str() {
+        "routes.list" => Ok(json!(
+            host.route_config()
+                .0
+                .routes_for(caller.id)
+                .into_iter()
+                .map(|route| route_info(host, route))
+                .collect::<Vec<_>>()
+        )),
+        "ledger.settle" => {
+            let arguments = &request.arguments;
+            let (Some(request_id), Some(microusd), Some(source)) = (
+                arguments["request_id"].as_str(),
+                arguments["microusd"].as_u64(),
+                arguments["source"].as_str(),
+            ) else {
+                return Err("ledger_settle_invalid".into());
+            };
+            let config = host.route_config().0;
+            host.accounts
+                .settle_provider(request_id, microusd, source, |provider| {
+                    config.billed_rates(provider, Some(caller.id)).is_some()
+                })
+        }
+        "session.info" => {
+            let account = host
+                .accounts
+                .0
+                .lock()
+                .map_err(|_| "account lock poisoned")?
+                .get(&lead.thread.to_string())
+                .cloned();
+            let config = super::agents::parent_config(lead).await?;
+            let turns = core
+                .expansion
+                .turns
+                .lock()
+                .map_err(|_| "turn_count_poisoned")?
+                .get(&lead.thread.to_string())
+                .copied()
+                .unwrap_or(0);
+            Ok(
+                json!({"thread_id": lead.thread.to_string(), "root": host.repository,
+                "cwd": config.cwd, "codex_version": env!("CARGO_PKG_VERSION"),
+                "model": account.as_ref().map_or(config.model.clone(), |account| Some(account.model.clone())),
+                "provider": account.as_ref().map_or(config.model_provider_id.clone(), |account| account.provider.clone()),
+                "route": account.and_then(|account| account.route), "turns_started": turns}),
+            )
+        }
+        "task.status" => {
+            host.refresh_session(&lead.session)?;
+            let config = host.route_config().0;
+            Ok(json!({"ledger": lead.ledger(), "limits": config.limits,
+            "worker_limits": config.worker_limits}))
+        }
+        "peers.list" | "peers.send" => {
+            let endpoints = super::peering::current_endpoints(core).await;
+            core.peering.call(lead, &caller, request, endpoints)
+        }
+        "turns.queue" | "turns.queued" | "turns.dequeue" => {
+            let core = core.this.upgrade().ok_or("native_host_stopped")?;
+            core.autonomy.call(&core, lead, &caller, request)
+        }
+        "receipts.submit" => submit_receipt(core, lead, &caller, request.arguments).await,
+        "task.complete" => complete(core, lead, request.arguments).await,
+        "contract.status" => Ok(lead
+            .session
+            .contract
+            .lock()
+            .map_err(|_| "contract_lock_poisoned")?
+            .status()),
+        "contract.restrict" => {
+            let restricted = lead
+                .session
+                .contract
+                .lock()
+                .map_err(|_| "contract_lock_poisoned")?
+                .restrict(request.arguments)?;
+            lead.session.persist_contract()?;
+            Ok(restricted)
+        }
+        _ => Err(format!("unsupported_host_operation: {operation}")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn live_exec_write_reserves_the_workspace_across_sessions() {
+        let temp = tempfile::tempdir().unwrap();
+        let repository = temp.path().to_str().unwrap();
+        let write = json!({"program":"sh","write":true});
+        assert!(
+            workspace_guard("exec.run", &json!({"program":"sh"}), repository)
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            workspace_guard(
+                "exec.run",
+                &json!({"program":"sh","write":true,"snapshot":{"sha256":"x"}}),
+                repository
+            )
+            .unwrap()
+            .is_none()
+        );
+        let (held_tx, held_rx) = std::sync::mpsc::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        std::thread::scope(|scope| {
+            let write = &write;
+            scope.spawn(move || {
+                let _guard = workspace_guard("exec.run", write, repository)
+                    .unwrap()
+                    .unwrap();
+                held_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+            });
+            held_rx.recv().unwrap();
+            assert!(
+                workspace_guard("workspace.restore", &json!({}), repository)
+                    .err()
+                    .unwrap()
+                    .contains("workspace_operation_active")
+            );
+            release_tx.send(()).unwrap();
+        });
+        let _guard = workspace_guard("exec.run", &write, repository)
+            .unwrap()
+            .unwrap();
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/peering.rs b/codex-rs/ext/omd/src/mods/peering.rs
new file mode 100644
index 000000000..89d5c4e69
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/peering.rs
@@ -0,0 +1,254 @@
+use super::*;
+use codex_omd::peers::BrokerSeal;
+use codex_omd::peers::Endpoint;
+use codex_omd::peers::Peers;
+use std::time::Duration;
+
+const POLL: Duration = Duration::from_secs(1);
+const DEFAULT_TTL_MS: u64 = 60_000;
+
+/// Peer registrations by lead thread; a session registers only while a mod holds a peers grant.
+#[derive(Default)]
+pub(super) struct Registry {
+    sessions: Mutex<BTreeMap<String, Arc<Peers>>>,
+}
+
+fn endpoints(runtime: &ModHost) -> Vec<Endpoint> {
+    runtime
+        .owners()
+        .into_iter()
+        .filter_map(|(id, _)| {
+            let grants = runtime.grants(&id)?;
+            let access = grants.peer_access?;
+            Some(Endpoint {
+                package: id,
+                sha256: grants.source_sha256,
+                projects: access.projects,
+            })
+        })
+        .collect()
+}
+
+impl Registry {
+    fn session(&self, lead: &Lead, endpoints: &[Endpoint]) -> Result<Arc<Peers>, String> {
+        let thread = lead.thread.to_string();
+        let mut sessions = self.sessions.lock().map_err(|_| "peer_registry_poisoned")?;
+        if let Some(peers) = sessions.get(&thread) {
+            return Ok(peers.clone());
+        }
+        let peers = Arc::new(
+            Peers::open(&lead.host.root, &thread, &lead.host.repository)
+                .map_err(|error| error.to_string())?,
+        );
+        peers
+            .publish(endpoints)
+            .map_err(|error| error.to_string())?;
+        sessions.insert(thread, peers.clone());
+        Ok(peers)
+    }
+
+    fn close(&self, thread: &str) {
+        if let Ok(mut sessions) = self.sessions.lock() {
+            sessions.remove(thread);
+        }
+    }
+
+    pub(super) fn call(
+        &self,
+        lead: &Lead,
+        caller: &operations::Caller<'_>,
+        request: ModHostCall,
+        endpoints: Vec<Endpoint>,
+    ) -> Result<Value, String> {
+        if lead.owner != "lead" {
+            return Err("peers_lead_only: agent threads have no peer session".into());
+        }
+        let endpoint = endpoints
+            .iter()
+            .find(|endpoint| endpoint.package == caller.id)
+            .cloned()
+            .ok_or("grant_expired: peers")?;
+        let peers = self.session(lead, &endpoints)?;
+        let arguments = &request.arguments;
+        let package = arguments
+            .get("package")
+            .and_then(Value::as_str)
+            .unwrap_or(caller.id)
+            .to_owned();
+        match request.operation.as_str() {
+            "peers.list" => peers
+                .list(&endpoint, &package)
+                .map(|sessions| json!({"session": peers.session(), "peers": sessions}))
+                .map_err(|error| error.to_string()),
+            "peers.send" => {
+                let to = arguments["to"].as_str().ok_or("peer_address_invalid")?;
+                peers
+                    .send(
+                        &BrokerSeal,
+                        &endpoint,
+                        to,
+                        &package,
+                        arguments.get("data").cloned().unwrap_or(Value::Null),
+                        arguments["correlation"].as_str().map(str::to_owned),
+                        arguments["ttl_ms"].as_u64().unwrap_or(DEFAULT_TTL_MS),
+                    )
+                    .map_err(|error| error.to_string())
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        }
+    }
+}
+
+pub(super) async fn current_endpoints(core: &Core) -> Vec<Endpoint> {
+    let runtime = core.runtime.clone();
+    tokio::task::spawn_blocking(move || {
+        runtime
+            .lock()
+            .map(|runtime| endpoints(&runtime))
+            .unwrap_or_default()
+    })
+    .await
+    .unwrap_or_default()
+}
+
+/// Delivers inbox messages and receipts for one lead thread until its session ends.
+pub(super) fn start(core: &Arc<Core>, thread: ThreadId) {
+    let core = core.clone();
+    tokio::spawn(async move {
+        let mut published = Vec::new();
+        loop {
+            tokio::time::sleep(POLL).await;
+            let Some(lead) = core.expansion.lead(thread) else {
+                core.peering.close(&thread.to_string());
+                return;
+            };
+            if !core.expansion.peers.load(Ordering::Acquire) {
+                core.peering.close(&thread.to_string());
+                published.clear();
+                continue;
+            }
+            let endpoints = current_endpoints(&core).await;
+            if endpoints.is_empty() {
+                core.peering.close(&thread.to_string());
+                published.clear();
+                continue;
+            }
+            let peers = match core.peering.session(&lead, &endpoints) {
+                Ok(peers) => peers,
+                Err(error) => {
+                    core.views.diagnostic(&core.host, "peers", Some(error));
+                    continue;
+                }
+            };
+            if published != endpoints {
+                if let Err(error) = peers.publish(&endpoints) {
+                    core.views
+                        .diagnostic(&core.host, "peers", Some(error.to_string()));
+                }
+                published = endpoints.clone();
+            }
+            if let Err(error) = deliver(&core, &lead, &peers, &endpoints).await {
+                core.views.diagnostic(&core.host, "peers", Some(error));
+            }
+        }
+    });
+}
+
+async fn deliver(
+    core: &Arc<Core>,
+    lead: &Lead,
+    peers: &Arc<Peers>,
+    endpoints: &[Endpoint],
+) -> Result<(), String> {
+    let receiving = peers.clone();
+    let inbound = tokio::task::spawn_blocking(move || receiving.receive(&BrokerSeal))
+        .await
+        .map_err(|error| error.to_string())?
+        .map_err(|error| error.to_string())?;
+    for message in inbound.into_iter().map(|inbound| inbound.message) {
+        let package = message["to"]["package"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        let (status, reason) = match endpoints
+            .iter()
+            .find(|endpoint| endpoint.package == package)
+        {
+            None => ("refused", Some("package_unavailable".to_owned())),
+            Some(endpoint) if !peers.admits(endpoint, &message) => {
+                ("refused", Some("peer_scope_denied".to_owned()))
+            }
+            Some(_) => receive(core, lead, &package, &message).await,
+        };
+        let replying = peers.clone();
+        let _ = tokio::task::spawn_blocking(move || {
+            replying.receipt(&BrokerSeal, &message, status, reason)
+        })
+        .await;
+    }
+    let settling = peers.clone();
+    let receipts = tokio::task::spawn_blocking(move || settling.receipts(&BrokerSeal))
+        .await
+        .map_err(|error| error.to_string())?
+        .map_err(|error| error.to_string())?;
+    for (package, receipt) in receipts {
+        expansion::invoke_one(core, lead, package, "peer_receipt", receipt).await;
+    }
+    Ok(())
+}
+
+/// Runs `peer_receive` interceptors, then hands the message to its package as untrusted data.
+pub(super) async fn receive(
+    core: &Arc<Core>,
+    lead: &Lead,
+    package: &str,
+    message: &Value,
+) -> (&'static str, Option<String>) {
+    let mut input = json!({"id": message["id"], "from": message["from"], "to": message["to"],
+        "correlation": message["correlation"], "untrusted": true, "data": message["data"]});
+    let (runtime, id) = (core.runtime.clone(), package.to_owned());
+    let (required, registered) = tokio::task::spawn_blocking(move || {
+        runtime
+            .lock()
+            .map(|runtime| {
+                (
+                    runtime.intercepts("peer_receive"),
+                    runtime.registered(&id, "peer_message"),
+                )
+            })
+            .unwrap_or((None, false))
+    })
+    .await
+    .unwrap_or((None, false));
+    if !registered {
+        return ("refused", Some("no_peer_message_handler".to_owned()));
+    }
+    if let Some(required) = required {
+        let chain = intercept::chain(
+            core.clone(),
+            Arc::new(lead.clone()),
+            core.runtime.clone(),
+            "peer_receive",
+            required,
+            input.clone(),
+            json!({"caller": "peer", "thread_id": lead.thread.to_string()}),
+            Arc::new(AtomicBool::new(false)),
+            |effective| Ok(json!({"data": effective["data"]})),
+        )
+        .await;
+        match chain {
+            Err(error) => return ("refused", Some(format!("peer_receive_failed: {error}"))),
+            Ok(chain) => {
+                if let Some(reason) = chain.result["deny"].as_str() {
+                    return ("refused", Some(reason.chars().take(512).collect()));
+                }
+                input["data"] = chain.result["data"].clone();
+            }
+        }
+    }
+    input["sent_at_ms"] = message["sent_at_ms"].clone();
+    match expansion::invoke_one(core, lead, package.to_owned(), "peer_message", input).await {
+        Some(Err(error)) => ("failed", Some(error.chars().take(512).collect())),
+        _ => ("delivered", None),
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/roles.rs b/codex-rs/ext/omd/src/mods/roles.rs
new file mode 100644
index 000000000..24a4f05ee
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/roles.rs
@@ -0,0 +1,430 @@
+use super::*;
+use codex_extension_api::AgentRoleContributor;
+use codex_extension_api::ContributedAgentRole;
+use codex_omd::ModAgentDefinition;
+use std::collections::BTreeSet;
+
+const PLAN_PREFIX: &str = "omd-agent-";
+
+/// Tools a sub-agent thread may call, from its definition or its spawn request.
+pub(super) struct AgentTools(pub(super) BTreeSet<String>);
+
+/// A spawn whose working directory or tools an `agent_spawn` interceptor changed.
+#[derive(Clone, Deserialize, Serialize)]
+struct Plan {
+    definition: Option<String>,
+    cwd: Option<std::path::PathBuf>,
+    tools: Option<Vec<String>>,
+}
+
+pub(super) fn is_spawn(tool: &ToolName) -> bool {
+    tool.name == "spawn_agent"
+}
+
+fn agents_dir(host: &Host) -> std::path::PathBuf {
+    host.root.join("agents")
+}
+
+fn write_once(path: &std::path::Path, text: &str) -> Result<(), String> {
+    if path.exists() {
+        return Ok(());
+    }
+    let parent = path.parent().ok_or("agent_role_path_invalid")?;
+    std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+    let temporary = parent.join(format!(
+        ".{}.{}.tmp",
+        std::process::id(),
+        execution::hash(text.as_bytes())
+    ));
+    std::fs::write(&temporary, text).map_err(|e| e.to_string())?;
+    std::fs::rename(&temporary, path).map_err(|e| e.to_string())
+}
+
+impl Core {
+    pub(super) fn definition(&self, name: &str) -> Option<ModAgentDefinition> {
+        let (owner, short) = name.split_once('/')?;
+        self.expansion
+            .definitions
+            .lock()
+            .ok()?
+            .iter()
+            .find(|definition| definition.owner == owner && definition.agent.name == short)
+            .cloned()
+    }
+
+    /// Writes the role layer for a definition (or an empty one) and returns its path.
+    fn role_file(
+        &self,
+        lead: &Lead,
+        name: &str,
+        description: &str,
+        definition: Option<&ModAgentDefinition>,
+    ) -> Result<std::path::PathBuf, String> {
+        let quote = |text: &str| serde_json::to_string(text).unwrap_or_default();
+        let mut lines = vec![
+            format!("name = {}", quote(name)),
+            format!("description = {}", quote(description)),
+        ];
+        if let Some(definition) = definition {
+            lines.push(format!(
+                "developer_instructions = {}",
+                quote(&format!(
+                    "Agent definition {}/{} from mod {}; it is subordinate to current user and project instructions.\n{}",
+                    definition.owner, definition.agent.name, definition.owner, definition.agent.instructions
+                ))
+            ));
+            let mut effort = definition.agent.effort.clone();
+            if let Some(name) = &definition.agent.route {
+                let provider = lead
+                    .host
+                    .accounts
+                    .0
+                    .lock()
+                    .map_err(|_| "account lock poisoned")?
+                    .get(&lead.thread.to_string())
+                    .map(|account| account.provider.clone());
+                let (routing, _) = lead.host.route_config();
+                let route = routing
+                    .route(name, config::RouteRole::Lead, Some(&definition.owner))
+                    .filter(|route| Some(&route.provider) == provider.as_ref())
+                    .ok_or_else(|| format!("agent_definition_route_unavailable: {name}"))?;
+                lines.push(format!("model = {}", quote(&route.model)));
+                effort = effort.or_else(|| {
+                    serde_json::to_value(&route.reasoning_effort)
+                        .ok()
+                        .and_then(|effort| effort.as_str().map(str::to_owned))
+                });
+            }
+            if let Some(effort) = effort {
+                lines.push(format!("model_reasoning_effort = {}", quote(&effort)));
+            }
+        }
+        let text = lines.join("\n") + "\n";
+        let path = agents_dir(&lead.host)
+            .join(format!("{}.toml", &execution::hash(text.as_bytes())[..16]));
+        write_once(&path, &text)?;
+        Ok(path)
+    }
+
+    fn plan(&self, host: &Host, name: &str) -> Option<Plan> {
+        let text =
+            std::fs::read(agents_dir(host).join("plans").join(format!("{name}.json"))).ok()?;
+        serde_json::from_slice(&text).ok()
+    }
+
+    /// The tools a child spawned under role `name` may call, if its definition or plan limits them.
+    pub(super) fn role_tools(&self, host: &Host, name: &str) -> Option<BTreeSet<String>> {
+        let (definition, planned) = if name.starts_with(PLAN_PREFIX) {
+            let plan = self.plan(host, name)?;
+            (
+                plan.definition.and_then(|name| self.definition(&name)),
+                plan.tools,
+            )
+        } else {
+            (self.definition(name), None)
+        };
+        let defined = definition.and_then(|definition| definition.agent.tools);
+        match (defined, planned) {
+            (Some(defined), Some(planned)) => Some(
+                planned
+                    .into_iter()
+                    .filter(|tool| defined.contains(tool))
+                    .collect(),
+            ),
+            (defined, planned) => defined.or(planned).map(|tools| tools.into_iter().collect()),
+        }
+    }
+
+    /// The definition a role name or plan names, for inventory records.
+    pub(super) fn role_definition(&self, host: &Host, name: &str) -> Option<ModAgentDefinition> {
+        if name.starts_with(PLAN_PREFIX) {
+            return self
+                .plan(host, name)?
+                .definition
+                .and_then(|name| self.definition(&name));
+        }
+        self.definition(name)
+    }
+
+    fn resolve(&self, lead: &Lead, name: &str) -> Result<Option<ContributedAgentRole>, String> {
+        let (definition, cwd) = if name.starts_with(PLAN_PREFIX) {
+            let plan = self
+                .plan(&lead.host, name)
+                .ok_or("agent_plan_unavailable")?;
+            let definition = match &plan.definition {
+                Some(name) => Some(
+                    self.definition(name)
+                        .ok_or_else(|| format!("agent_definition_unavailable: {name}"))?,
+                ),
+                None => None,
+            };
+            if let Some(cwd) = &plan.cwd
+                && !std::fs::canonicalize(cwd).is_ok_and(|cwd| {
+                    codex_omd::app_routes::session_roots(&lead.host.repository).contains(&cwd)
+                })
+            {
+                return Err("agent_spawn_cwd_outside_session".into());
+            }
+            (definition, plan.cwd)
+        } else if name.contains('/') {
+            let definition = self
+                .definition(name)
+                .ok_or_else(|| format!("agent_definition_unavailable: {name}"))?;
+            (Some(definition), None)
+        } else {
+            return Ok(None);
+        };
+        let description = definition.as_ref().map_or_else(
+            || "Spawn adjusted by a mod interceptor".to_owned(),
+            |d| d.agent.description.clone(),
+        );
+        let config_file = self.role_file(lead, name, &description, definition.as_ref())?;
+        let cwd = cwd
+            .map(codex_utils_absolute_path::AbsolutePathBuf::try_from)
+            .transpose()
+            .map_err(|e| e.to_string())?;
+        Ok(Some(ContributedAgentRole {
+            name: name.to_owned(),
+            description,
+            config_file,
+            cwd,
+        }))
+    }
+
+    /// Offered definitions after any `agent_offers` interceptors.
+    fn offers(&self, lead: &Lead) -> Vec<(String, String)> {
+        let offers = self
+            .expansion
+            .definitions
+            .lock()
+            .map(|definitions| {
+                definitions
+                    .iter()
+                    .filter(|definition| definition.agent.offer)
+                    .map(|definition| {
+                        json!({"name": format!("{}/{}", definition.owner, definition.agent.name),
+                            "description": definition.agent.description, "owner": definition.owner})
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        if offers.is_empty() {
+            return Vec::new();
+        }
+        let required = *self
+            .expansion
+            .agent_offers
+            .lock()
+            .ok()
+            .as_deref()
+            .unwrap_or(&None);
+        let offers = match required {
+            None => Value::Array(offers),
+            Some(required) => {
+                let payload = json!({"thread_id": lead.thread.to_string(), "offers": offers});
+                let origin = json!({"caller": "engine", "thread_id": lead.thread.to_string()});
+                match codex_omd::intercept_shared(
+                    &self.runtime,
+                    "agent_offers",
+                    required,
+                    payload,
+                    origin,
+                    || true,
+                    |_, _| {
+                        Err(std::io::Error::other(
+                            "host_operation_unavailable: agent_offers runs without host operations",
+                        ))
+                    },
+                    |effective| Ok(json!({"offers": effective["offers"]})),
+                ) {
+                    Ok(chain) => {
+                        self.views.diagnostic(&self.host, "agent_offers", None);
+                        chain.result["offers"].clone()
+                    }
+                    Err(error) => {
+                        self.views.diagnostic(
+                            &self.host,
+                            "agent_offers",
+                            Some(format!("{error}; no mod agents offered")),
+                        );
+                        return Vec::new();
+                    }
+                }
+            }
+        };
+        offers
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|offer| {
+                Some((
+                    offer["name"].as_str()?.to_owned(),
+                    format!(
+                        "{} (mod {})",
+                        offer["description"].as_str()?,
+                        offer["owner"].as_str()?
+                    ),
+                ))
+            })
+            .collect()
+    }
+
+    /// Model-visible spawn request for an `agent_spawn` chain.
+    pub(super) fn spawn_payload(
+        &self,
+        lead: &Lead,
+        arguments: &Value,
+        cwd: &std::path::Path,
+    ) -> Value {
+        let prompt = match &arguments["message"] {
+            Value::String(message) => message.clone(),
+            _ => arguments["items"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|item| item["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n"),
+        };
+        json!({"origin": "model", "caller": "model", "thread_id": lead.thread.to_string(),
+            "agent_id": (lead.owner != "lead").then(|| lead.owner.clone()),
+            "definition": arguments["agent_type"], "prompt": prompt, "model": arguments["model"],
+            "effort": arguments["reasoning_effort"], "cwd": cwd.to_string_lossy(),
+            "tools": null})
+    }
+
+    /// Native spawn arguments for the request a chain settled on.
+    pub(super) fn spawn_arguments(
+        &self,
+        lead: &Lead,
+        original: &Value,
+        before: &Value,
+        effective: &Value,
+    ) -> Result<Value, String> {
+        let mut arguments = original.clone();
+        if effective["prompt"] != before["prompt"] {
+            if let Some(object) = arguments.as_object_mut() {
+                object.remove("items");
+            }
+            arguments["message"] = effective["prompt"].clone();
+        }
+        for (field, key) in [("model", "model"), ("effort", "reasoning_effort")] {
+            match &effective[field] {
+                Value::Null => {
+                    if let Some(object) = arguments.as_object_mut() {
+                        object.remove(key);
+                    }
+                }
+                value => arguments[key] = value.clone(),
+            }
+        }
+        let definition = effective["definition"].as_str();
+        if let Some(name) = definition.filter(|name| name.contains('/'))
+            && self.definition(name).is_none()
+        {
+            return Err(format!("unknown_agent_definition: {name}"));
+        }
+        let cwd = (effective["cwd"] != before["cwd"])
+            .then(|| effective["cwd"].as_str().map(std::path::PathBuf::from))
+            .flatten();
+        if let Some(cwd) = &cwd {
+            let allowed = std::fs::canonicalize(cwd).is_ok_and(|cwd| {
+                codex_omd::app_routes::session_roots(&self.host.repository).contains(&cwd)
+            });
+            if !allowed {
+                return Err("agent_spawn_cwd_outside_session".into());
+            }
+        }
+        let tools = effective["tools"].as_array().map(|tools| {
+            tools
+                .iter()
+                .filter_map(|tool| tool.as_str().map(str::to_owned))
+                .collect::<Vec<_>>()
+        });
+        if cwd.is_none() && tools.is_none() {
+            match definition {
+                Some(name) => arguments["agent_type"] = json!(name),
+                None => {
+                    if let Some(object) = arguments.as_object_mut() {
+                        object.remove("agent_type");
+                    }
+                }
+            }
+            return Ok(arguments);
+        }
+        if definition.is_some_and(|name| !name.contains('/') && name != "default") {
+            return Err("agent_spawn_override_requires_definition: express cwd or tool changes as a mod agent definition".into());
+        }
+        let plan = Plan {
+            definition: definition
+                .filter(|name| name.contains('/'))
+                .map(str::to_owned),
+            cwd,
+            tools,
+        };
+        let text = serde_json::to_string(&plan).map_err(|e| e.to_string())?;
+        let name = format!("{PLAN_PREFIX}{}", &execution::hash(text.as_bytes())[..16]);
+        write_once(
+            &agents_dir(&lead.host)
+                .join("plans")
+                .join(format!("{name}.json")),
+            &text,
+        )?;
+        arguments["agent_type"] = json!(name);
+        Ok(arguments)
+    }
+}
+
+/// The spawn tool's result as the `agent_spawn` surface reports it.
+pub(super) fn spawn_result(result: &Value) -> Value {
+    let output = result["output"].as_str().unwrap_or_default();
+    let parsed = serde_json::from_str::<Value>(output).unwrap_or(Value::Null);
+    let agent_id = parsed["agent_id"]
+        .as_str()
+        .or(parsed["task_name"].as_str())
+        .filter(|_| result["success"] == true);
+    json!({"agent_id": agent_id, "output": output, "success": result["success"]})
+}
+
+impl AgentRoleContributor for Mods {
+    fn offered_agent_roles(&self, thread_store: &ExtensionData) -> Vec<ContributedAgentRole> {
+        let Some(lead) = thread_store.get::<Lead>() else {
+            return Vec::new();
+        };
+        self.offers(&lead)
+            .into_iter()
+            .filter_map(|(name, description)| {
+                let definition = self.definition(&name)?;
+                match self.role_file(&lead, &name, &description, Some(&definition)) {
+                    Ok(config_file) => Some(ContributedAgentRole {
+                        name,
+                        description,
+                        config_file,
+                        cwd: None,
+                    }),
+                    Err(error) => {
+                        self.views
+                            .diagnostic(&self.host, &format!("agent:{name}"), Some(error));
+                        None
+                    }
+                }
+            })
+            .collect()
+    }
+
+    fn resolve_agent_role(
+        &self,
+        thread_store: &ExtensionData,
+        name: &str,
+    ) -> Option<ContributedAgentRole> {
+        let lead = thread_store.get::<Lead>()?;
+        match self.resolve(&lead, name) {
+            Ok(role) => role,
+            Err(error) => {
+                self.views
+                    .diagnostic(&self.host, &format!("agent:{name}"), Some(error));
+                None
+            }
+        }
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/services.rs b/codex-rs/ext/omd/src/mods/services.rs
new file mode 100644
index 000000000..4b9707e9f
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/services.rs
@@ -0,0 +1,695 @@
+use super::*;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::PermissionProfileSnapshot;
+use codex_protocol::permissions::FileSystemAccessMode;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use std::collections::BTreeSet;
+use std::path::Path;
+use std::time::Duration;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Grant {
+    id: String,
+    mod_id: String,
+    program: PathBuf,
+    program_sha256: String,
+    #[serde(default)]
+    arguments: Vec<String>,
+    #[serde(default)]
+    secrets: BTreeMap<String, String>,
+    #[serde(default)]
+    route: Option<Route>,
+    #[serde(default)]
+    network: bool,
+    #[serde(default)]
+    read_paths: Vec<PathBuf>,
+    #[serde(default)]
+    requests: bool,
+    #[serde(default)]
+    read_hashes: BTreeMap<PathBuf, String>,
+    #[serde(default)]
+    credentials: BTreeSet<String>,
+}
+
+impl Grant {
+    /// The rates of this grant's provider-billed route for `provider`, when it declares one.
+    pub(crate) fn billed_rates(&self, provider: &str) -> Option<&crate::accounting::Rates> {
+        self.route
+            .as_ref()
+            .filter(|route| {
+                route.provider == provider
+                    && route.rates.provider_billed
+                    && !route.rates.included_subscription
+                    && route.rates.reservation_microusd == 0
+            })
+            .map(|route| &route.rates)
+    }
+
+    pub(crate) fn mod_id(&self) -> &str {
+        &self.mod_id
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Services {
+    records: tokio::sync::Mutex<BTreeMap<String, Service>>,
+}
+
+struct Service {
+    mod_id: String,
+    generation: u64,
+    route: Option<Route>,
+    job: Option<tokio::task::JoinHandle<Result<Value, String>>>,
+    task: Arc<Task>,
+    worker: String,
+    _gateway: Option<crate::credential_gateway::Registration>,
+}
+
+impl Drop for Service {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+        }
+        let _ = self.task.finish_worker(&self.worker);
+    }
+}
+
+impl Service {
+    fn finished(&self) -> bool {
+        self.job
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    async fn stop(mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            let _ = job.await;
+        }
+    }
+}
+
+impl Services {
+    pub(super) async fn cleanup_owned(&self, mod_id: &str, generation: u64) {
+        let owned = {
+            let mut records = self.records.lock().await;
+            let keys = records
+                .iter()
+                .filter(|(_, agent)| agent.mod_id == mod_id && agent.generation == generation)
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>();
+            keys.into_iter()
+                .filter_map(|key| records.remove(&key))
+                .collect::<Vec<_>>()
+        };
+        for agent in owned {
+            agent.stop().await;
+        }
+    }
+
+    pub(super) async fn cleanup_session(&self, session: &Session) {
+        let owned = {
+            let mut records = self.records.lock().await;
+            let keys = records
+                .iter()
+                .filter(|(_, service)| Arc::ptr_eq(&service.task, &session.task))
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>();
+            keys.into_iter()
+                .filter_map(|key| records.remove(&key))
+                .collect::<Vec<_>>()
+        };
+        for service in owned {
+            service.stop().await;
+        }
+    }
+
+    pub(super) async fn route(
+        &self,
+        mod_id: &str,
+        generation: u64,
+        id: &str,
+    ) -> Result<Route, String> {
+        self.records
+            .lock()
+            .await
+            .get(id)
+            .filter(|s| s.mod_id == mod_id && s.generation == generation && !s.finished())
+            .and_then(|s| s.route.clone())
+            .ok_or_else(|| "provider_not_registered_or_stopped".into())
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "Keep service registration atomic with cleanup ownership"
+    )]
+    pub(super) async fn call(
+        &self,
+        lead: &Lead,
+        mod_id: &str,
+        generation: u64,
+        request: codex_omd::ModHostCall,
+    ) -> Result<Value, String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Selection {
+            id: String,
+            #[serde(default)]
+            input: Option<Value>,
+            #[serde(default)]
+            secrets: Vec<String>,
+        }
+        let selection: Selection =
+            serde_json::from_value(request.arguments).map_err(|e| e.to_string())?;
+        if !selection.secrets.is_empty()
+            && !matches!(
+                request.operation.as_str(),
+                "sidecars.start" | "providers.register"
+            )
+            || selection.secrets.len() > 16
+        {
+            return Err("credential_requires_service_start".into());
+        }
+        let invoke = request.operation == "sidecars.invoke";
+        if invoke != selection.input.is_some()
+            || selection.input.as_ref().is_some_and(|input| {
+                serde_json::to_vec(input).map_or(true, |bytes| bytes.len() > 16384)
+            })
+        {
+            return Err("service_request_input_invalid".into());
+        }
+        let mut records = self.records.lock().await;
+        if matches!(
+            request.operation.as_str(),
+            "sidecars.stop" | "providers.unregister"
+        ) {
+            if records
+                .get(&selection.id)
+                .is_none_or(|r| r.mod_id != mod_id || r.generation != generation)
+            {
+                return Err("unknown_or_foreign_sidecar".into());
+            }
+            let service = records.remove(&selection.id);
+            drop(records);
+            if let Some(service) = service {
+                service.stop().await;
+            }
+            return Ok(json!({"stopped":true}));
+        }
+        if request.operation == "sidecars.status" {
+            let record = records
+                .get(&selection.id)
+                .filter(|r| r.mod_id == mod_id && r.generation == generation)
+                .ok_or("unknown_or_foreign_sidecar")?;
+            return Ok(json!({"id":selection.id,"running":!record.finished()}));
+        }
+        if records.contains_key(&selection.id) {
+            return Err("service_already_registered".into());
+        }
+        let host = &lead.host;
+        let grant = host
+            .config
+            .services
+            .iter()
+            .find(|g| g.id == selection.id && g.mod_id == mod_id)
+            .cloned()
+            .ok_or("service_not_host_approved")?;
+        if records.len() >= 8 || grant.id.is_empty() || grant.id.len() > 32 {
+            return Err("service_limit".into());
+        }
+        if request.operation == "providers.register" && grant.route.is_none() {
+            return Err("provider_grant_required".into());
+        }
+        if request.operation == "sidecars.start" && grant.route.is_some() {
+            return Err("provider_registration_required".into());
+        }
+        if invoke && (!grant.requests || grant.route.is_some() || grant.read_hashes.is_empty()) {
+            return Err("service_request_not_host_approved".into());
+        }
+        if grant.read_hashes.len() > 32 {
+            return Err("service_source_limit".into());
+        }
+        for (path, expected) in &grant.read_hashes {
+            if !path.is_absolute()
+                || path
+                    .canonicalize()
+                    .map_err(|_| "service_source_unavailable")?
+                    != *path
+                || std::fs::metadata(path)
+                    .map_err(|_| "service_source_unavailable")?
+                    .len()
+                    > 4 * 1024 * 1024
+                || execution::hash(&std::fs::read(path).map_err(|_| "service_source_unavailable")?)
+                    != *expected
+            {
+                return Err("service_source_changed".into());
+            }
+        }
+        if grant.program.starts_with(&host.repository)
+            || grant.program.canonicalize().map_err(|e| e.to_string())? != grant.program
+        {
+            return Err("service_executable_must_be_canonical_and_outside_repository".into());
+        }
+        let metadata = std::fs::metadata(&grant.program).map_err(|e| e.to_string())?;
+        if !metadata.is_file() || metadata.len() > 134_217_728 {
+            return Err("service_executable_limit".into());
+        }
+        if execution::hash(&std::fs::read(&grant.program).map_err(|e| e.to_string())?)
+            != grant.program_sha256
+        {
+            return Err("service_executable_changed".into());
+        }
+        let manager = host
+            .manager
+            .upgrade()
+            .ok_or("native_thread_manager_stopped")?;
+        let parent = manager
+            .get_thread(lead.thread)
+            .await
+            .map_err(|e| e.to_string())?
+            .config()
+            .await;
+        if grant.read_paths.len() > 16 {
+            return Err("service_read_path_limit".into());
+        }
+        let mut reads = host.config.toolchain_reads.clone();
+        reads.push(grant.program.clone());
+        let supervisor = std::env::current_exe()
+            .map_err(|e| e.to_string())?
+            .canonicalize()
+            .map_err(|e| e.to_string())?;
+        reads.push(supervisor.clone());
+        reads.extend(grant.read_paths.iter().cloned());
+        let mut denied = host
+            .protected_paths()
+            .into_iter()
+            .filter(|path| *path != host.root)
+            .collect::<Vec<_>>();
+        let mut parent = (*parent).clone();
+        let inherited = execution::intersect(
+            &parent.permissions.effective_permission_profile(),
+            &lead
+                .permission_profile
+                .lock()
+                .map_err(|_| "permission_profile_poisoned")?
+                .clone(),
+            parent.cwd.as_path(),
+        )?;
+        let source = Some(host.root.join("sources").join(mod_id));
+        for entry in inherited.file_system_sandbox_policy().entries {
+            if entry.access != FileSystemAccessMode::Deny {
+                continue;
+            }
+            let FileSystemPath::Path { path } = entry.path else {
+                return Err("service_parent_denial_unsupported".into());
+            };
+            let path = path.to_path_buf();
+            if path == Path::new("/")
+                || host.root == path
+                || (source.as_ref() == Some(&path) && grant.read_paths.contains(&path))
+            {
+                continue;
+            }
+            if !denied.contains(&path) {
+                denied.push(path);
+            }
+        }
+        let scope = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::unrestricted(),
+            inherited.network_sandbox_policy(),
+        );
+        parent
+            .permissions
+            .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(scope))
+            .map_err(|e| e.to_string())?;
+        let mut config = execution::isolated(&parent, &host.repository, &reads, &denied, false)?;
+        if grant.network {
+            let service_profile = config.permissions.effective_permission_profile();
+            let profile = codex_protocol::models::PermissionProfile::from_runtime_permissions(
+                &service_profile.file_system_sandbox_policy(),
+                codex_protocol::permissions::NetworkSandboxPolicy::Enabled,
+            );
+            config
+                .permissions
+                .set_permission_profile_from_session_snapshot(
+                    codex_protocol::models::PermissionProfileSnapshot::legacy(profile),
+                )
+                .map_err(|e| e.to_string())?;
+        }
+        config.permissions.shell_environment_policy.r#set.clear();
+        for (environment, reference) in &grant.secrets {
+            if environment == "OMD_READY_TOKEN"
+                || environment.is_empty()
+                || environment.len() > 64
+                || !environment
+                    .bytes()
+                    .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == b'_')
+            {
+                return Err("invalid_secret_environment_key".into());
+            }
+            let path = host
+                .config
+                .secret_refs
+                .get(reference)
+                .ok_or("unknown_secret_reference")?;
+            if path.starts_with(&host.repository)
+                || !path.is_absolute()
+                || std::fs::symlink_metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .file_type()
+                    .is_symlink()
+                || !std::fs::metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .is_file()
+                || std::fs::metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .len()
+                    > 8192
+            {
+                return Err("secret_reference_unavailable".into());
+            }
+            let value =
+                std::fs::read_to_string(path).map_err(|_| "secret_reference_unavailable")?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert(environment.clone(), value.trim_end().to_string());
+        }
+        let gateway = if grant.credentials.is_empty() {
+            None
+        } else if !grant.network || grant.credentials.len() > 32 {
+            return Err("credential_gateway_requires_network".into());
+        } else {
+            let (url, registration) =
+                crate::credential_gateway::register(host.root.clone(), grant.credentials.clone())
+                    .map_err(|error| error.to_string())?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert("OMD_CREDENTIAL_GATEWAY".to_owned(), url);
+            Some(registration)
+        };
+        if !selection.secrets.is_empty() {
+            let profiles = codex_omd::credentials::CredentialProfiles::open(&host.root)
+                .map_err(|error| error.to_string())?;
+            let secrets = selection
+                .secrets
+                .iter()
+                .map(|id| profiles.owned_secret(id, mod_id))
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|error| error.to_string())?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert("OMD_SECRETS".to_owned(), Value::Array(secrets).to_string());
+        }
+        if let Some(route) = &grant.route {
+            if route.model.is_empty() || route.model.len() > 128 {
+                return Err("unsupported_adapter_model".into());
+            }
+            if !config.model_providers.contains_key(&route.provider)
+                || !route.responses_url.starts_with("http://127.0.0.1:")
+            {
+                return Err("configured_loopback_provider_required".into());
+            }
+        }
+        if invoke {
+            let worker = format!(
+                "service-request-{}-{}",
+                grant.id,
+                manager.reserve_thread_id()
+            );
+            lead.session
+                .task
+                .start_worker(
+                    worker.clone(),
+                    lead.owner.clone(),
+                    lead.depth.saturating_add(1),
+                    host.worker_limits(&lead.session)?,
+                )
+                .map_err(|e| e.to_string())?;
+            struct RequestGuard {
+                task: Arc<Task>,
+                worker: String,
+            }
+            impl Drop for RequestGuard {
+                fn drop(&mut self) {
+                    let _ = self.task.finish_worker(&self.worker);
+                }
+            }
+            let _guard = RequestGuard {
+                task: lead.session.task.clone(),
+                worker,
+            };
+            let mut argv = vec![grant.program.to_string_lossy().into_owned()];
+            argv.extend(grant.arguments.clone());
+            argv.push("--omd-request-json".into());
+            argv.push(serde_json::to_string(&selection.input).map_err(|e| e.to_string())?);
+            if argv.len() > 128 || argv.iter().map(String::len).sum::<usize>() > 24576 {
+                return Err("service_argument_limit".into());
+            }
+            let timeout = lead
+                .session
+                .task
+                .remaining()
+                .map_err(|e| e.to_string())?
+                .0
+                .min(Duration::from_secs(30));
+            let mut supervised = vec![
+                supervisor.to_string_lossy().into_owned(),
+                "--omd-managed-request-v1".into(),
+                std::process::id().to_string(),
+                timeout.as_secs().saturating_add(1).to_string(),
+            ];
+            supervised.extend(argv);
+            drop(records);
+            let output = tokio::time::timeout(timeout, request_output(&config, supervised))
+                .await
+                .map_err(|_| "service_request_deadline")??;
+            lead.session
+                .task
+                .check_active()
+                .map_err(|e| e.to_string())?;
+            if output["exit_code"] != 0 {
+                return Err("service_request_failed".into());
+            }
+            let text = output["stdout"]
+                .as_str()
+                .filter(|text| text.len() <= 32768)
+                .ok_or("service_response_limit")?;
+            if config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .values()
+                .filter(|value| value.len() >= 4)
+                .any(|secret| text.contains(secret))
+            {
+                return Err("service_response_secret_excluded".into());
+            }
+            let value: Value =
+                serde_json::from_str(text).map_err(|_| "service_response_not_json")?;
+            return Ok(
+                json!({"provider":grant.id,"program_sha256":grant.program_sha256,"source_hashes":grant.read_hashes,"result":value,"untrusted":true}),
+            );
+        }
+        let nonce = manager.reserve_thread_id().to_string();
+        config
+            .permissions
+            .shell_environment_policy
+            .r#set
+            .insert("OMD_READY_TOKEN".into(), nonce.clone());
+        let port = grant
+            .route
+            .as_ref()
+            .map(|route| {
+                let uri: http::Uri = route
+                    .responses_url
+                    .parse()
+                    .map_err(|_| "invalid_provider_url")?;
+                if uri.scheme_str() != Some("http") || uri.host() != Some("127.0.0.1") {
+                    return Err("configured_loopback_provider_required");
+                }
+                uri.port_u16().ok_or("explicit_provider_port_required")
+            })
+            .transpose()?;
+        let worker = format!("sidecar-{}-{}", grant.id, manager.reserve_thread_id());
+        lead.session
+            .task
+            .start_worker(
+                worker.clone(),
+                lead.owner.clone(),
+                lead.depth.saturating_add(1),
+                host.worker_limits(&lead.session)?,
+            )
+            .map_err(|e| e.to_string())?;
+        let mut argv = vec![grant.program.to_string_lossy().into_owned()];
+        argv.extend(grant.arguments);
+        if argv.len() > 128 || argv.iter().map(String::len).sum::<usize>() > 8192 {
+            let _ = lead.session.task.finish_worker(&worker);
+            return Err("service_argument_limit".into());
+        }
+        let task = lead.session.task.clone();
+        let output_bytes = host.config.snapshot_bytes;
+        let timeout = lead
+            .session
+            .task
+            .remaining()
+            .map_err(|e| e.to_string())?
+            .0
+            .min(Duration::from_secs(
+                host.route_config().0.worker_limits.seconds,
+            ));
+        let mut supervised = vec![
+            supervisor.to_string_lossy().into_owned(),
+            "--omd-managed-service-v1".into(),
+            std::process::id().to_string(),
+            timeout.as_secs().saturating_add(1).min(86400).to_string(),
+        ];
+        supervised.extend(argv);
+        let job = tokio::spawn(async move {
+            let result = tokio::time::timeout(
+                timeout,
+                execution::command(&task, output_bytes, &config, supervised, timeout),
+            )
+            .await
+            .map_err(|_| "sidecar_deadline".to_string())??;
+            Ok(json!({"exit_code":result["exit_code"],"timed_out":result["timed_out"]}))
+        });
+        records.insert(
+            grant.id.clone(),
+            Service {
+                mod_id: mod_id.into(),
+                generation,
+                // A provider becomes routable only after its readiness handshake succeeds.
+                route: None,
+                job: Some(job),
+                task: lead.session.task.clone(),
+                worker: worker.clone(),
+                _gateway: gateway,
+            },
+        );
+        // Every mod shares these records, so wait for readiness without holding the lock.
+        drop(records);
+        if let (Some(port), Some(route)) = (port, grant.route) {
+            let ready = tokio::time::timeout(Duration::from_secs(3), async {
+                loop {
+                    lead.session
+                        .task
+                        .check_active()
+                        .map_err(|e| e.to_string())?;
+                    if self
+                        .records
+                        .lock()
+                        .await
+                        .get(&grant.id)
+                        .is_none_or(|s| s.worker != worker || s.finished())
+                    {
+                        return Err("provider_sidecar_stopped".to_string());
+                    }
+                    if let Ok(mut stream) =
+                        tokio::net::TcpStream::connect((std::net::Ipv4Addr::LOCALHOST, port)).await
+                    {
+                        use tokio::io::AsyncReadExt;
+                        use tokio::io::AsyncWriteExt;
+                        let attempt = async {
+                            stream
+                                .write_all(b"GET /_omd/ready HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n")
+                                .await?;
+                            let mut response = Vec::new();
+                            stream.take(4096).read_to_end(&mut response).await?;
+                            Ok::<_, std::io::Error>(
+                                response.ends_with(format!("OMD_READY:{nonce}").as_bytes()),
+                            )
+                        };
+                        if tokio::time::timeout(Duration::from_millis(200), attempt)
+                            .await
+                            .is_ok_and(|r| r.unwrap_or(false))
+                        {
+                            return Ok(());
+                        }
+                    }
+                    tokio::time::sleep(Duration::from_millis(20)).await;
+                }
+            })
+            .await;
+            let mut records = self.records.lock().await;
+            match records.get_mut(&grant.id) {
+                Some(service) if service.worker == worker && matches!(ready, Ok(Ok(()))) => {
+                    service.route = Some(route);
+                }
+                current => {
+                    let stale = current
+                        .is_some_and(|s| s.worker == worker)
+                        .then(|| records.remove(&grant.id))
+                        .flatten();
+                    drop(records);
+                    if let Some(service) = stale {
+                        service.stop().await;
+                    }
+                    return Err("provider_readiness_failed".into());
+                }
+            }
+        }
+        Ok(
+            json!({"id":grant.id,"status":if port.is_some() {"ready"} else {"starting"},"secret_references":grant.secrets.values().collect::<Vec<_>>(),"credentials":grant.credentials}),
+        )
+    }
+}
+
+async fn request_output(config: &Config, command: Vec<String>) -> Result<Value, String> {
+    use codex_sandboxing::seatbelt::{
+        CreateSeatbeltCommandArgsParams, MACOS_PATH_TO_SEATBELT_EXECUTABLE,
+        create_seatbelt_command_args,
+    };
+    use tokio::io::{AsyncBufReadExt, AsyncReadExt};
+    let profile = config.permissions.effective_permission_profile();
+    let argv = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+        command,
+        file_system_sandbox_policy: &profile.file_system_sandbox_policy(),
+        network_sandbox_policy: profile.network_sandbox_policy(),
+        sandbox_policy_cwd: config.cwd.as_path(),
+        enforce_managed_network: false,
+        managed_network: None,
+        environment_id: None,
+        network: None,
+        extra_allow_unix_sockets: &[],
+    })?;
+    let mut child = tokio::process::Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(argv)
+        .current_dir(&config.cwd)
+        .env_clear()
+        .envs(config.permissions.shell_environment_policy.r#set.iter())
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .process_group(0)
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|error| error.to_string())?;
+    struct Group(u32);
+    impl Drop for Group {
+        fn drop(&mut self) {
+            let _ = codex_utils_pty::process_group::kill_process_group(self.0);
+        }
+    }
+    let group = Group(child.id().ok_or("service_process_id_missing")?);
+    let stdout = child.stdout.take().ok_or("service_stdout_missing")?;
+    let mut line = Vec::new();
+    tokio::io::BufReader::new(stdout)
+        .take(196_609)
+        .read_until(b'\n', &mut line)
+        .await
+        .map_err(|error| error.to_string())?;
+    drop(group);
+    let _ = child.wait().await;
+    if line.len() > 196_608 || line.last() != Some(&b'\n') {
+        return Err("service_response_limit_or_incomplete".into());
+    }
+    serde_json::from_slice(&line).map_err(|_| "service_response_invalid".into())
+}
diff --git a/codex-rs/ext/omd/src/mods/snapshots.rs b/codex-rs/ext/omd/src/mods/snapshots.rs
new file mode 100644
index 000000000..4945b07ef
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/snapshots.rs
@@ -0,0 +1,669 @@
+use super::*;
+use codex_omd::Snapshot;
+use codex_omd::resource_data::ResourceRef;
+use std::collections::BTreeSet;
+
+const SNAPSHOT_LIMIT: usize = 8;
+const SNAPSHOT_BYTES: usize = 64 * 1024 * 1024;
+const SNAPSHOT_TOTAL_LIMIT: usize = 32;
+const SNAPSHOT_TOTAL_BYTES: usize = 256 * 1024 * 1024;
+const EXECUTION_LIMIT: usize = 64;
+const EXECUTION_TOTAL_LIMIT: usize = 256;
+
+#[derive(Clone, PartialEq)]
+struct Scope {
+    owner: String,
+    generation: u64,
+    thread: ThreadId,
+}
+
+impl Scope {
+    fn of(caller: &operations::Caller<'_>, thread: ThreadId) -> Self {
+        Self {
+            owner: caller.id.into(),
+            generation: caller.generation,
+            thread,
+        }
+    }
+}
+
+fn evict_oldest<T>(
+    entries: &mut BTreeMap<String, T>,
+    select: impl Fn(&T) -> bool,
+    sequence: impl Fn(&T) -> u64,
+) {
+    if let Some(oldest) = entries
+        .iter()
+        .filter(|(_, entry)| select(entry))
+        .min_by_key(|(_, entry)| sequence(entry))
+        .map(|(key, _)| key.clone())
+    {
+        entries.remove(&oldest);
+    }
+}
+
+fn heaviest<T>(
+    entries: &BTreeMap<String, T>,
+    scope: impl Fn(&T) -> &Scope,
+    weight: impl Fn(&T) -> usize,
+) -> Option<Scope> {
+    entries
+        .values()
+        .map(|entry| {
+            let owned = scope(entry);
+            let total = entries
+                .values()
+                .filter(|other| scope(other) == owned)
+                .map(&weight)
+                .sum::<usize>();
+            (total, owned)
+        })
+        .max_by_key(|(total, _)| *total)
+        .map(|(_, owned)| owned.clone())
+}
+
+struct Stored {
+    scope: Scope,
+    source: String,
+    snapshot: Arc<Snapshot>,
+    digest: String,
+    bytes: usize,
+    sequence: u64,
+}
+
+#[derive(Default)]
+pub(super) struct Snapshots {
+    entries: BTreeMap<String, Stored>,
+    executions: BTreeMap<String, Execution>,
+    sequence: u64,
+}
+
+struct Execution {
+    scope: Scope,
+    source: String,
+    candidate: String,
+    evidence: ResourceRef,
+    passed: bool,
+    sequence: u64,
+}
+
+impl Snapshots {
+    fn next(&mut self) -> u64 {
+        self.sequence += 1;
+        self.sequence
+    }
+
+    pub(super) fn record_execution(
+        &mut self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        candidate: String,
+        evidence: ResourceRef,
+        result: &Value,
+    ) {
+        let scope = Scope::of(caller, thread);
+        self.executions.remove(&evidence.reference);
+        while self
+            .executions
+            .values()
+            .filter(|entry| entry.scope == scope)
+            .count()
+            >= EXECUTION_LIMIT
+        {
+            evict_oldest(
+                &mut self.executions,
+                |entry| entry.scope == scope,
+                |entry| entry.sequence,
+            );
+        }
+        while self.executions.len() >= EXECUTION_TOTAL_LIMIT {
+            let Some(heaviest) = heaviest(&self.executions, |entry| &entry.scope, |_| 1) else {
+                break;
+            };
+            evict_oldest(
+                &mut self.executions,
+                |entry| entry.scope == heaviest,
+                |entry| entry.sequence,
+            );
+        }
+        let sequence = self.next();
+        self.executions.insert(
+            evidence.reference.clone(),
+            Execution {
+                scope,
+                source: caller.source.into(),
+                candidate,
+                evidence,
+                passed: result["exit_code"] == 0
+                    && result["signal"].is_null()
+                    && result["timed_out"] == false
+                    && result["stdout_truncated"] == false
+                    && result["stderr_truncated"] == false,
+                sequence,
+            },
+        );
+    }
+
+    pub(super) fn attest_execution(
+        &self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        candidate: &str,
+        evidence: &ResourceRef,
+        outcome: codex_omd::ReceiptOutcome,
+    ) -> Result<(), String> {
+        let record = self
+            .executions
+            .get(&evidence.reference)
+            .filter(|record| {
+                record.scope == Scope::of(caller, thread)
+                    && record.source == caller.source
+                    && record.candidate == candidate
+                    && record.evidence.sha256 == evidence.sha256
+            })
+            .ok_or("unknown_or_foreign_execution")?;
+        if outcome == codex_omd::ReceiptOutcome::Pass && !record.passed {
+            return Err("execution_did_not_pass".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn insert(
+        &mut self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        snapshot: Snapshot,
+        digest: String,
+    ) -> Result<Value, String> {
+        let reference = format!(
+            "snapshot:{}",
+            execution::hash(
+                &serde_json::to_vec(&(
+                    caller.id,
+                    caller.generation,
+                    thread,
+                    caller.source,
+                    &digest
+                ))
+                .map_err(|error| error.to_string())?
+            )
+        );
+        if !self.entries.contains_key(&reference) {
+            let bytes = snapshot
+                .files
+                .iter()
+                .try_fold(0usize, |total, (name, file)| {
+                    total
+                        .checked_add(name.len())
+                        .and_then(|n| n.checked_add(file.bytes.len()))
+                })
+                .ok_or("snapshot_byte_limit")?;
+            if bytes > SNAPSHOT_BYTES {
+                return Err("snapshot_limit".into());
+            }
+            let scope = Scope::of(caller, thread);
+            let usage = |entries: &BTreeMap<String, Stored>, select: &dyn Fn(&Stored) -> bool| {
+                entries
+                    .values()
+                    .filter(|entry| select(entry))
+                    .fold((0usize, 0usize), |(count, total), entry| {
+                        (count + 1, total + entry.bytes)
+                    })
+            };
+            loop {
+                let (count, used) = usage(&self.entries, &|entry| entry.scope == scope);
+                if count < SNAPSHOT_LIMIT && used + bytes <= SNAPSHOT_BYTES {
+                    break;
+                }
+                evict_oldest(
+                    &mut self.entries,
+                    |entry| entry.scope == scope,
+                    |entry| entry.sequence,
+                );
+            }
+            loop {
+                let (count, used) = usage(&self.entries, &|_| true);
+                if count < SNAPSHOT_TOTAL_LIMIT && used + bytes <= SNAPSHOT_TOTAL_BYTES {
+                    break;
+                }
+                let Some(heaviest) = heaviest(
+                    &self.entries,
+                    |entry| &entry.scope,
+                    |entry| entry.bytes.max(1),
+                ) else {
+                    break;
+                };
+                evict_oldest(
+                    &mut self.entries,
+                    |entry| entry.scope == heaviest,
+                    |entry| entry.sequence,
+                );
+            }
+            let sequence = self.next();
+            self.entries.insert(
+                reference.clone(),
+                Stored {
+                    scope,
+                    source: caller.source.into(),
+                    snapshot: Arc::new(snapshot),
+                    digest: digest.clone(),
+                    bytes,
+                    sequence,
+                },
+            );
+        }
+        Ok(
+            json!({"snapshot": {"reference": reference, "sha256": digest},
+            "candidate_sha256": digest}),
+        )
+    }
+
+    pub(super) fn get(
+        &self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        reference: &ResourceRef,
+    ) -> Result<Arc<Snapshot>, String> {
+        let stored = self
+            .entries
+            .get(&reference.reference)
+            .filter(|entry| {
+                entry.scope == Scope::of(caller, thread) && entry.source == caller.source
+            })
+            .ok_or("unknown_or_foreign_snapshot")?;
+        if stored.digest != reference.sha256 {
+            return Err("snapshot_digest_mismatch".into());
+        }
+        Ok(stored.snapshot.clone())
+    }
+
+    pub(super) fn remove_owner(&mut self, owner: &str, generation: u64) {
+        let owned = |scope: &Scope| scope.owner == owner && scope.generation == generation;
+        self.entries.retain(|_, entry| !owned(&entry.scope));
+        self.executions.retain(|_, entry| !owned(&entry.scope));
+    }
+
+    pub(super) fn remove_thread(&mut self, thread: ThreadId) {
+        self.entries.retain(|_, entry| entry.scope.thread != thread);
+        self.executions
+            .retain(|_, entry| entry.scope.thread != thread);
+    }
+}
+
+pub(super) fn permitted(
+    snapshot: &Snapshot,
+    authority: &crate::workspace_operations::WorkspaceAuthority,
+    protected: &[PathBuf],
+) -> Result<(), String> {
+    for name in snapshot.files.keys() {
+        let path = codex_omd::workspace_path(&authority.repository, name)
+            .map_err(|error| error.to_string())?;
+        if !authority.readable(&path) || protected.iter().any(|root| path.starts_with(root)) {
+            return Err("snapshot_permission_denied".into());
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn capture(
+    authority: &crate::workspace_operations::WorkspaceAuthority,
+    protected: &[PathBuf],
+    approved: &BTreeSet<String>,
+    limit: usize,
+    active: &dyn Fn() -> bool,
+) -> Result<Snapshot, String> {
+    if !active() {
+        return Err("snapshot_cancelled".into());
+    }
+    let paths = codex_omd::tracked_paths(&authority.repository, approved)
+        .map_err(|error| error.to_string())?;
+    for name in &paths {
+        let path = codex_omd::workspace_path(&authority.repository, name)
+            .map_err(|error| error.to_string())?;
+        if !authority.readable(&path) || protected.iter().any(|root| path.starts_with(root)) {
+            return Err("snapshot_permission_denied".into());
+        }
+    }
+    let snapshot = Snapshot::capture(&authority.repository, &paths, limit)
+        .map_err(|error| error.to_string())?;
+    if !active() {
+        return Err("snapshot_cancelled".into());
+    }
+    if codex_omd::tracked_paths(&authority.repository, approved)
+        .map_err(|error| error.to_string())?
+        != paths
+    {
+        return Err("snapshot_source_changed".into());
+    }
+    permitted(&snapshot, authority, protected)?;
+    Ok(snapshot)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Capture {
+    pub agent: Option<String>,
+    pub expected: Option<String>,
+}
