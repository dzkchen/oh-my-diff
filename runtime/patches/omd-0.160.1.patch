+#[test]
+#[ignore = "explicit bounded appearance timing fixture"]
+#[allow(clippy::print_stdout)]
+fn appearance_render_cost_fixture() {
+    use std::hint::black_box;
+    use std::io::Cursor;
+    use std::time::Instant;
+
+    fn summary(mut samples: Vec<f64>) -> serde_json::Value {
+        samples.sort_by(f64::total_cmp);
+        serde_json::json!({"median_ms":samples[samples.len()/2],
+            "p95_ms":samples[(samples.len()*95).div_ceil(100)-1],"samples_ms":samples})
+    }
+    fn measure(mut operation: impl FnMut(), count: usize) -> serde_json::Value {
+        summary(
+            (0..count)
+                .map(|_| {
+                    let started = Instant::now();
+                    operation();
+                    started.elapsed().as_secs_f64() * 1000.0
+                })
+                .collect(),
+        )
+    }
+    fn rss() -> Option<u64> {
+        let result = std::process::Command::new("ps")
+            .args(["-o", "rss=", "-p", &std::process::id().to_string()])
+            .output()
+            .ok()?;
+        String::from_utf8(result.stdout).ok()?.trim().parse().ok()
+    }
+
+    let before_rss = rss();
+    let colors = crate::terminal_probe::DefaultColors {
+        fg: (240, 240, 240),
+        bg: (0, 0, 0),
+    };
+    let mut cell_results = Vec::new();
+    crate::terminal_palette::with_test_default_colors(colors, || {
+        for (width, height) in [(80, 24), (120, 40)] {
+            let area = Rect::new(0, 0, width, height);
+            let mut base = Buffer::empty(area);
+            base[(1, 1)].set_char('T');
+            let solid = serde_json::from_value(
+                serde_json::json!({"top":"#262626","bottom":"#262626","foreground":"#eeeeee"}),
+            )
+            .unwrap();
+            let glass=serde_json::from_value(serde_json::json!({"top":"#3a3a3a","bottom":"#202020","foreground":"#eeeeee","border":"#aaaaaa","opacity":0.85})).unwrap();
+            let baseline = measure(
+                || {
+                    black_box(base.clone());
+                },
+                20,
+            );
+            let plain = measure(
+                || {
+                    let mut buffer = base.clone();
+                    paint_surface(
+                        area,
+                        &mut buffer,
+                        &solid,
+                        /*base*/ None,
+                        /*border_clip*/ None,
+                    );
+                    assert_eq!(buffer[(1, 1)].symbol(), "T");
+                    black_box(buffer);
+                },
+                20,
+            );
+            let glossy = measure(
+                || {
+                    let mut buffer = base.clone();
+                    paint_surface(
+                        area,
+                        &mut buffer,
+                        &glass,
+                        /*base*/ None,
+                        /*border_clip*/ None,
+                    );
+                    assert_eq!(buffer[(1, 1)].symbol(), "T");
+                    black_box(buffer);
+                },
+                20,
+            );
+            cell_results.push(serde_json::json!({"columns":width,"rows":height,
+                "cell_struct_bytes":base.content.len()*std::mem::size_of::<ratatui::buffer::Cell>(),
+                "buffer_clone":baseline,"solid_paint":plain,"gloss_paint":glossy}));
+        }
+    });
+    let image = image::RgbaImage::from_fn(512, 256, |x, y| {
+        image::Rgba([(x % 256) as u8, (y % 256) as u8, ((x + y) % 256) as u8, 255])
+    });
+    let mut source = Vec::new();
+    image
+        .write_to(&mut Cursor::new(&mut source), image::ImageFormat::Png)
+        .unwrap();
+    let settings = serde_json::from_value::<codex_omd::ModImageBackdrop>(serde_json::json!({
+        "resource":{"reference":"fixture","sha256":"0".repeat(64)},"position":"fill","scale":1.2,
+        "dim":0.75,"tint":"#262626","opacity":0.8,"offset":{"x":2,"y":-1}}))
+    .unwrap();
+    let overlay = serde_json::from_value(
+        serde_json::json!({"top":"#3a3a3a","bottom":"#202020","opacity":0.85}),
+    )
+    .unwrap();
+    let mut image_results = Vec::new();
+    for (width, height, count) in [(80, 24, 3), (120, 40, 3), (256, 128, 2)] {
+        let area = Rect::new(0, 0, width, height);
+        let mut encoded_bytes = 0;
+        let timing = measure(
+            || {
+                let png =
+                    crate::mod_backdrop::transformed_png(&source, &settings, area, Some(&overlay))
+                        .unwrap();
+                encoded_bytes = png.len();
+                black_box(png);
+            },
+            count,
+        );
+        let canvas_width = (u32::from(width) * 8).min(2048);
+        let canvas_height = (u32::from(height) * 16).min(2048);
+        image_results.push(serde_json::json!({"columns":width,"rows":height,"canvas_width":canvas_width,
+            "canvas_height":canvas_height,"source_rgba_bytes":512*256*4,
+            "canvas_rgba_bytes":canvas_width*canvas_height*4,"encoded_bytes":encoded_bytes,"decode_transform_gloss_encode":timing}));
+    }
+    println!(
+        "APPEARANCE_COST {}",
+        serde_json::json!({"profile":"debug test process; cached image hits and terminal graphic transmission excluded",
+        "cells":cell_results,"images":image_results,"process_rss_before_kib":before_rss,"process_rss_after_kib":rss(),
+        "memory_limit":"cell struct bytes exclude heap string capacity; source/canvas RGBA bytes exclude encoder scratch; RSS is a test-process sample, not an allocator or instantaneous peak measurement"})
+    );
