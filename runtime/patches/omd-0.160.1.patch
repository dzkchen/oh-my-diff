+pub fn session_call(
+    thread: &str,
+    caller: &str,
+    call: crate::ModHostCall,
+    active: &dyn Fn() -> bool,
+) -> std::io::Result<Value> {
+    let dispatcher = SESSION_DISPATCHER
+        .lock()
+        .ok()
+        .and_then(|installed| installed.clone())
+        .ok_or_else(|| {
+            std::io::Error::other("host_operation_unavailable: no session in this process")
+        })?;
+    dispatcher(thread, caller, call, active)
+}
