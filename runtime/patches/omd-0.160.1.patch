diff --git a/codex-rs/ext/omd/src/accounting.rs b/codex-rs/ext/omd/src/accounting.rs
new file mode 100644
index 000000000..05178cf82
--- /dev/null
+++ b/codex-rs/ext/omd/src/accounting.rs
@@ -0,0 +1,2253 @@
+use codex_api::request_observer::ResponseAttempt;
+use codex_api::request_observer::ResponseObserver;
+use codex_client::EncodedJsonBody;
+use codex_client::Request;
+use codex_client::TransportError;
+use codex_omd::Admission;
+use codex_omd::Task;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::VecDeque;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Rates {
+    pub input_microusd_per_million: u64,
+    pub cached_microusd_per_million: u64,
+    #[serde(default)]
+    pub cache_write_microusd_per_million: Option<u64>,
+    pub output_microusd_per_million: u64,
+    pub reservation_microusd: u64,
+    pub max_output_tokens: u64,
+    pub input_token_ceiling: u64,
+    pub included_subscription: bool,
+    #[serde(default)]
+    pub external_subscription: bool,
+    #[serde(default)]
+    pub provider_billed: bool,
+}
+
+/// Minimum spacing between `task-cost.json` snapshots written on the request path.
+const COST_SNAPSHOT_INTERVAL: Duration = Duration::from_secs(1);
+
+/// Per snapshot path: when it was last written and whether a later change is still unwritten.
+static COST_SNAPSHOTS: Mutex<BTreeMap<std::path::PathBuf, (Instant, bool)>> =
+    Mutex::new(BTreeMap::new());
+
+/// The append-only task journal is the durable record; this snapshot of it is rewritten in full,
+/// so request-path updates are coalesced to one write a second and flushed at turn end.
+fn persist_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let due = COST_SNAPSHOTS.lock().map_or(true, |mut snapshots| {
+        match snapshots.get_mut(&account.cost_capture) {
+            Some((written, dirty)) if written.elapsed() < COST_SNAPSHOT_INTERVAL => {
+                *dirty = true;
+                false
+            }
+            _ => {
+                snapshots.insert(account.cost_capture.clone(), (Instant::now(), false));
+                true
+            }
+        }
+    });
+    if due {
+        write_cost_capture(account, false)?;
+    }
+    Ok(())
+}
+
+/// Writes a snapshot a coalesced update left behind, durably, and forgets the path.
+fn flush_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let dirty = COST_SNAPSHOTS
+        .lock()
+        .ok()
+        .and_then(|mut snapshots| snapshots.remove(&account.cost_capture))
+        .is_some_and(|(_, dirty)| dirty);
+    if dirty {
+        write_cost_capture(account, true)?;
+    }
+    Ok(())
+}
+
+fn write_cost_capture(account: &Account, durable: bool) -> Result<(), TransportError> {
+    use std::io::Write;
+
+    let bytes =
+        serde_json::to_vec(&account.task.cost_capture().map_err(denied)?).map_err(denied)?;
+    let temporary = account.cost_capture.with_extension(format!(
+        "json.{}.{}.tmp",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_err(denied)?
+            .as_nanos()
+    ));
+    let mut file = std::fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(&temporary)
+        .map_err(denied)?;
+    file.write_all(&bytes)
+        .and_then(|_| if durable { file.sync_all() } else { Ok(()) })
+        .map_err(denied)?;
+    std::fs::rename(&temporary, &account.cost_capture).map_err(denied)?;
+    Ok(())
+}
+
+pub(crate) fn billing(rates: Option<&Rates>) -> &'static str {
+    match rates {
+        Some(rates) if rates.provider_billed => "provider_billed",
+        Some(rates) if !rates.included_subscription => "explicit_paid_api_grant",
+        _ => "included_subscription",
+    }
+}
+
+#[derive(Clone)]
+pub struct Account {
+    pub task: Arc<Task>,
+    pub owner: String,
+    pub model: String,
+    pub provider: String,
+    pub url: String,
+    pub max_request_bytes: usize,
+    pub rates: Option<Rates>,
+    pub repository_identity: String,
+    pub cost_capture: std::path::PathBuf,
+    pub route: Option<String>,
+    pub lead_routes: Vec<RequestRoute>,
+    pub worker_authorization: Option<(std::path::PathBuf, String)>,
+    pub credential: Option<String>,
+    pub context_window: Option<i64>,
+    pub max_output_tokens: Option<u64>,
+    pub capture_tools: bool,
+}
+
+static CREDENTIAL_ROOT: std::sync::OnceLock<std::path::PathBuf> = std::sync::OnceLock::new();
+
+pub fn set_credential_root(root: std::path::PathBuf) {
+    let _ = CREDENTIAL_ROOT.set(root);
+}
+
+const ROUTE_HEADER: &str = "x-omd-route";
+const REQUEST_HEADER: &str = "x-omd-request-id";
+const SYNTHETIC_HEADER: &str = "x-omd-synthetic";
+const SUMMARY_TEXT_BYTES: usize = 4096;
+const COLLECTED_TEXT_BYTES: usize = 32_768;
+
+fn cut(text: &str, limit: usize) -> &str {
+    let mut end = limit.min(text.len());
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    &text[..end]
+}
+
+fn mark_route(request: &mut Request, name: &str) -> Result<(), TransportError> {
+    let value = http::HeaderValue::from_str(name)
+        .map_err(|_| denied("route name is not a valid header"))?;
+    request.headers.insert(ROUTE_HEADER, value);
+    Ok(())
+}
+
+fn inject_credential(
+    request: &mut Request,
+    credential: Option<&str>,
+    url: &str,
+) -> Result<(), TransportError> {
+    let Some(profile) = credential else {
+        return Ok(());
+    };
+    let root = CREDENTIAL_ROOT
+        .get()
+        .ok_or_else(|| denied("credential store unavailable"))?;
+    let origin = codex_omd::credentials::url_origin(url)
+        .ok_or_else(|| denied("request URL has no origin"))?;
+    let secret = codex_omd::credentials::CredentialProfiles::open(root)
+        .and_then(|profiles| profiles.secret(profile, &origin, None))
+        .map_err(|error| denied(error.to_string()))?;
+    let mut value = http::HeaderValue::from_str(&format!("Bearer {}", secret.token))
+        .map_err(|_| denied("credential token is not a valid header"))?;
+    value.set_sensitive(true);
+    request.headers.insert(http::header::AUTHORIZATION, value);
+    match secret.account_id {
+        Some(account) => {
+            let value = http::HeaderValue::from_str(&account)
+                .map_err(|_| denied("credential account is not a valid header"))?;
+            request.headers.insert("chatgpt-account-id", value);
+        }
+        None => {
+            request.headers.remove("chatgpt-account-id");
+        }
+    }
+    Ok(())
+}
