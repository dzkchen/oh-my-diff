+
+    #[test]
+    fn ascii_fills_only_blank_default_rows() {
+        let area = Rect::new(0, 0, 4, 3);
+        let mut buffer = Buffer::empty(area);
+        buffer[(1, 0)].set_char('X');
+        buffer[(2, 1)].set_bg(Color::Blue);
+        fill_ascii(&mut buffer, area, "ab\ncd");
+        let symbols: Vec<String> = (0..3)
+            .map(|y| {
+                (0..4)
+                    .map(|x| buffer[(x, y)].symbol().to_string())
+                    .collect()
+            })
+            .collect();
+        assert_eq!(symbols, [" X  ", "    ", "abab"]);
+        assert!(buffer[(0, 2)].modifier.contains(Modifier::DIM));
+    }
+    #[test]
+    fn transforms_place_tile_tint_and_gloss_without_mutating_source() {
+        let settings = |value| serde_json::from_value::<ModImageBackdrop>(value).unwrap();
+        let reference = serde_json::json!({"reference":"r","sha256":"0".repeat(64)});
+        let area = Rect::new(0, 0, 4, 2);
+        let centered =
+            settings(serde_json::json!({"resource":reference,"position":"center","dim":0}));
+        let image =
+            image::load_from_memory(&transformed_png(&png(), &centered, area, None).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0[3], 0);
+        assert_eq!(image.get_pixel(15, 15).0, [200, 100, 50, 255]);
+        let tile = settings(
+            serde_json::json!({"resource":reference,"position":"tile","dim":0.5,"tint":"#ffffff","opacity":0.5}),
+        );
+        let image = image::load_from_memory(&transformed_png(&png(), &tile, area, None).unwrap())
+            .unwrap()
+            .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0, [228, 178, 153, 128]);
+        let paint = serde_json::from_value::<ModSurfacePaint>(
+            serde_json::json!({"top":"#ffffff","bottom":"#000000","opacity":0.5}),
+        )
+        .unwrap();
+        let gloss =
+            image::load_from_memory(&transformed_png(&png(), &tile, area, Some(&paint)).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert!(gloss.get_pixel(0, 0).0[0] > gloss.get_pixel(0, 31).0[0]);
+        assert_eq!(
+            image::load_from_memory(&png())
+                .unwrap()
+                .to_rgba8()
+                .get_pixel(0, 0)
+                .0,
+            [200, 100, 50, 255]
+        );
+    }
+
+    #[test]
+    fn decoder_rejects_oversized_dimensions_before_pixel_allocation() {
+        let image = image::RgbaImage::new(BACKDROP_IMAGE_PIXELS + 1, 1);
+        let mut bytes = Vec::new();
+        image
+            .write_to(&mut Cursor::new(&mut bytes), ImageFormat::Png)
+            .unwrap();
+        assert!(decode_image(&bytes).is_err());
+        assert!(decode_image(b"GIF89a").is_err());
+        assert!(decode_image(&vec![0; 8 * 1024 * 1024 + 1]).is_err());
+    }
+
+    #[test]
+    fn ascii_positions_scale_and_preserve_styled_rows() {
+        let area = Rect::new(0, 0, 6, 6);
+        let mut buffer = Buffer::empty(area);
+        buffer[(1, 1)].set_char('X');
+        buffer[(2, 2)].set_bg(Color::Blue);
+        let settings = serde_json::from_value(
+            serde_json::json!({"text":"ab\ncd","position":"center","dim":0.2}),
+        )
+        .unwrap();
+        fill_ascii_configured(&mut buffer, area, area, &settings);
+        assert_eq!(buffer[(0, 0)].symbol(), " ");
+        assert_eq!(buffer[(1, 1)].symbol(), "X");
+        assert_eq!(buffer[(2, 1)].symbol(), " ");
+        assert_eq!(buffer[(2, 3)].symbol(), "c");
+        assert_eq!(buffer[(3, 3)].symbol(), "d");
+        assert_eq!(buffer[(2, 2)].symbol(), " ");
+    }
+
+    #[test]
+    fn ascii_clip_preserves_full_area_placement_and_protected_blank_rows() {
+        let area = Rect::new(0, 0, 4, 4);
+        let clip = Rect::new(0, 2, 4, 2);
+        for position in ["tile", "center"] {
+            let mut buffer = Buffer::empty(area);
+            let settings =
+                serde_json::from_value(serde_json::json!({"text":"ab\ncd","position":position}))
+                    .unwrap();
+            fill_ascii_configured(&mut buffer, area, clip, &settings);
+            let rows = (area.top()..area.bottom())
+                .map(|y| {
+                    (area.left()..area.right())
+                        .map(|x| buffer[(x, y)].symbol())
+                        .collect::<String>()
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(
+                rows,
+                if position == "tile" {
+                    ["    ", "    ", "abab", "cdcd"]
+                } else {
+                    ["    ", "    ", " cd ", "    "]
+                }
+            );
+        }
+    }
+}
diff --git a/codex-rs/tui/src/mod_backdrop_sync.rs b/codex-rs/tui/src/mod_backdrop_sync.rs
new file mode 100644
index 000000000..15d84aafe
--- /dev/null
+++ b/codex-rs/tui/src/mod_backdrop_sync.rs
@@ -0,0 +1,165 @@
+use crate::mod_backdrop::BackdropEnvironment;
+use codex_omd::ModBackdrop;
+use codex_omd::ModViewSnapshot;
+use codex_terminal_detection::TerminalName;
+use ratatui::layout::Rect;
+use std::io::Write;
+use std::sync::Mutex;
+
+const IMAGE_ID: u32 = 7_314;
+
+struct Placed {
+    key: Option<(String, Rect)>,
+    decided: Option<(String, Option<Vec<u8>>)>,
+}
+
+static PLACED: Mutex<Placed> = Mutex::new(Placed {
+    key: None,
+    decided: None,
+});
+
+fn placed() -> std::sync::MutexGuard<'static, Placed> {
+    PLACED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+pub(crate) fn image_active() -> bool {
+    placed().key.is_some()
+}
+
+fn environment(columns: u16, animations: bool, owned_viewport: bool) -> BackdropEnvironment {
+    let terminal = codex_terminal_detection::terminal_info();
+    BackdropEnvironment {
+        kitty_graphics: matches!(
+            terminal.name,
+            TerminalName::Kitty | TerminalName::Ghostty | TerminalName::WezTerm
+        ),
+        remote: terminal.multiplexer.is_some()
+            || ["SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY"]
+                .iter()
+                .any(|name| std::env::var_os(name).is_some()),
+        no_color: std::env::var_os("NO_COLOR").is_some(),
+        reduced_motion: !animations,
+        columns,
+        owned_viewport,
+    }
+}
+
+fn load(
+    snapshot: &ModViewSnapshot,
+    reference: &codex_omd::resource_data::ResourceRef,
+) -> Option<Vec<u8>> {
+    let thread = crate::mod_surface::current_thread();
+    snapshot.contributors.iter().find_map(|owner| {
+        let (host, _) = crate::mod_surface::resource_binding(owner, thread.as_deref()).ok()?;
+        let resources = host.resources();
+        let record = resources.load(reference, "evidence").ok()?;
+        resources.blob(record["blob"].as_str()?).ok()
+    })
+}
+
+fn write(sequence: &str) {
+    let mut stdout = std::io::stdout();
+    let _ = stdout.write_all(sequence.as_bytes());
+    let _ = stdout.flush();
+}
+
+pub(crate) fn teardown() {
+    clear(&mut placed());
+}
+
+fn clear(placed: &mut Placed) {
+    if placed.key.take().is_some() {
+        write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    }
+}
+
+pub(crate) fn sync(snapshot: &ModViewSnapshot, area: Rect, animations: bool, owned_viewport: bool) {
+    let mut placed = placed();
+    let Some(ModBackdrop::Image { image, .. }) = snapshot.view.backdrop.as_ref() else {
+        clear(&mut placed);
+        return;
+    };
+    let environment = environment(area.width, animations, owned_viewport);
+    let paint = image.overlay.as_ref();
+    let key = format!(
+        "{}:{}:{area:?}:{environment:?}:{paint:?}",
+        snapshot.epoch,
+        serde_json::to_string(image).unwrap_or_default()
+    );
+    if placed.key.as_ref() == Some(&(key.clone(), area)) {
+        return;
+    }
+    let png = match placed.decided.as_ref() {
+        Some((decided, png)) if *decided == key => png.clone(),
+        _ => {
+            let png = (environment.graphics_eligible() && !area.is_empty())
+                .then(|| load(snapshot, &image.resource))
+                .flatten()
+                .and_then(|bytes| {
+                    crate::mod_backdrop::transformed_png(&bytes, image, area, paint).ok()
+                });
+            placed.decided = Some((key.clone(), png.clone()));
+            png
+        }
+    };
+    let Some(png) = png.filter(|_| area.width >= crate::mod_backdrop::BACKDROP_MIN_COLUMNS) else {
+        clear(&mut placed);
+        return;
+    };
+    let sequence =
+        crate::mod_backdrop::kitty_place_below_text(&png, area.width, area.height, IMAGE_ID)
+            .replacen(
+                "\x1b[1;1H",
+                &format!("\x1b[{};{}H", area.y + 1, area.x + 1),
+                1,
+            );
+    write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    write(&sequence);
+    placed.key = Some((key, area));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn graphics_eligibility_uses_production_protocol_remote_motion_color_and_ownership() {
+        let local = BackdropEnvironment {
+            kitty_graphics: true,
+            columns: 80,
+            owned_viewport: true,
+            ..Default::default()
+        };
+        assert!(local.graphics_eligible());
+        for fallback in [
+            BackdropEnvironment {
+                kitty_graphics: false,
+                ..local
+            },
+            BackdropEnvironment {
+                remote: true,
+                ..local
+            }, // SSH and multiplexers share the remote gate.
+            BackdropEnvironment {
+                no_color: true,
+                ..local
+            },
+            BackdropEnvironment {
+                reduced_motion: true,
+                ..local
+            },
+            BackdropEnvironment {
+                columns: 40,
+                ..local
+            },
+            BackdropEnvironment {
+                owned_viewport: false,
+                ..local
+            },
+        ] {
+            assert!(!fallback.graphics_eligible(), "{fallback:?}");
+        }
+    }
+}
