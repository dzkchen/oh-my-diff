+    let rollback = store.package_rollback_plan("npm_mod").unwrap();
+    let lock = store
+        .package_rollback("npm_mod", &rollback.confirmation)
+        .unwrap();
+    assert_eq!(lock.packages["npm_mod"].version, "1.1.0");
