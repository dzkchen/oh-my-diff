@@ -0,0 +1,83 @@
+use super::*;
+use codex_tools::ResponsesApiNamespace;
+use codex_tools::ResponsesApiTool;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn schema(value: serde_json::Value) -> JsonSchema {
+    serde_json::from_value(value).unwrap()
+}
+
+fn function(name: &str) -> ResponsesApiTool {
+    ResponsesApiTool {
+        name: name.to_owned(),
+        description: format!("{name} tool"),
+        strict: false,
+        defer_loading: None,
+        parameters: schema(json!({"type": "object", "properties": {}})),
+        output_schema: None,
+    }
+}
+
+#[test]
+fn adjustments_hide_and_redescribe_by_model_visible_name() {
+    let specs = vec![
+        ToolSpec::Function(function("read")),
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "mcp__srv__".to_owned(),
+            description: "server".to_owned(),
+            tools: vec![
+                ResponsesApiNamespaceTool::Function(function("search")),
+                ResponsesApiNamespaceTool::Function(function("fetch")),
+            ],
+        }),
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "mcp__gone__".to_owned(),
+            description: "gone".to_owned(),
+            tools: vec![ResponsesApiNamespaceTool::Function(function("only"))],
+        }),
+    ];
+    assert_eq!(
+        views(&specs)
+            .iter()
+            .map(|view| view.name.as_str())
+            .collect::<Vec<_>>(),
+        vec![
+            "read",
+            "mcp__srv__search",
+            "mcp__srv__fetch",
+            "mcp__gone__only"
+        ]
+    );
+    let mut adjustment = ToolSpecAdjustment {
+        hide: vec!["mcp__srv__search".into(), "mcp__gone__only".into()],
+        ..Default::default()
+    };
+    let parameters = json!({"type": "object", "properties": {"path": {"type": "string"}}});
+    adjustment.describe.insert(
+        "read".into(),
+        (Some("x".repeat(DESCRIPTION_CHARS + 10)), Some(parameters)),
+    );
+    adjustment
+        .describe
+        .insert("mcp__srv__fetch".into(), (None, Some(json!({"type": 7}))));
+    let adjusted = adjust(&specs, &adjustment);
+    assert_eq!(adjusted.len(), 2);
+    let ToolSpec::Function(read) = &adjusted[0] else {
+        panic!("read stays a function");
+    };
+    assert_eq!(read.description.len(), DESCRIPTION_CHARS);
+    assert_eq!(
+        serde_json::to_value(&read.parameters).unwrap()["properties"]["path"]["type"],
+        "string"
+    );
+    let ToolSpec::Namespace(namespace) = &adjusted[1] else {
+        panic!("server namespace stays");
+    };
+    assert_eq!(namespace.tools.len(), 1);
+    let ResponsesApiNamespaceTool::Function(fetch) = &namespace.tools[0] else {
+        panic!("fetch stays a function");
+    };
+    assert_eq!(fetch.description, "fetch tool");
+    assert_eq!(fetch.parameters, function("fetch").parameters);
+}
diff --git a/codex-rs/core/tests/suite/compact_intercept.rs b/codex-rs/core/tests/suite/compact_intercept.rs
new file mode 100644
index 000000000..0756cf944
--- /dev/null
+++ b/codex-rs/core/tests/suite/compact_intercept.rs
@@ -0,0 +1,303 @@
+//! Per-occurrence compaction plans from extension contributors.
+
+use codex_core::TurnInputRequest;
+use codex_core::compact::SUMMARY_PREFIX;
+use codex_extension_api::CompactionInterceptInput;
+use codex_extension_api::CompactionLifecycleInput;
+use codex_extension_api::CompactionPlan;
+use codex_extension_api::CompactionReplacement;
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::TurnLifecycleContributor;
+use codex_model_provider_info::ModelProviderInfo;
+use codex_model_provider_info::built_in_model_providers;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::ev_assistant_message;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_completed_with_tokens;
+use core_test_support::responses::mount_sse_sequence;
+use core_test_support::responses::sse;
+use core_test_support::responses::start_mock_server;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::Mutex;
+use wiremock::MockServer;
+
+#[derive(Clone, Copy)]
+enum Mode {
+    Summary,
+    Skip,
+    Settle,
+}
+
+struct Planner {
+    mode: Mode,
+    offers: Mutex<Vec<serde_json::Value>>,
+    ends: Mutex<Vec<(String, Option<String>, bool)>>,
+}
+
+impl Planner {
+    fn new(mode: Mode) -> Arc<Self> {
+        Arc::new(Self {
+            mode,
+            offers: Mutex::default(),
+            ends: Mutex::default(),
+        })
+    }
+}
+
+impl TurnLifecycleContributor for Planner {
+    fn plan_compaction<'a>(
+        &'a self,
+        input: CompactionInterceptInput<'a>,
+    ) -> ExtensionFuture<'a, CompactionPlan> {
+        self.offers.lock().expect("offers lock").push(json!({
+            "trigger": input.trigger, "reason": input.reason, "phase": input.phase,
+            "implementation": input.implementation, "hard": input.hard,
+            "prompt": input.summary_prompt.is_some(), "items": input.history.len()}));
+        let by = "planner".to_string();
+        let plan = match self.mode {
+            Mode::Summary => CompactionPlan::Replace(CompactionReplacement::Summary {
+                by,
+                text: "MOD_SUMMARY".to_string(),
+            }),
+            Mode::Skip => CompactionPlan::Skip {
+                by,
+                reason: "keep going".to_string(),
+            },
+            Mode::Settle => CompactionPlan::Native {
+                summary_prompt: None,
+                settle: Some(Box::new(move |done| {
+                    Box::pin(async move {
+                        assert!(done.provider_call);
+                        let mut items = vec![json!({"type": "message", "role": "developer",
+                            "content": [{"type": "input_text", "text": "MOD_NOTE"}]})];
+                        items.extend(done.history);
+                        Some(CompactionReplacement::History { by, items })
+                    })
+                })),
+            },
+        };
+        Box::pin(std::future::ready(plan))
+    }
+
+    fn on_compaction_end<'a>(
+        &'a self,
+        input: CompactionLifecycleInput<'a>,
+    ) -> ExtensionFuture<'a, ()> {
+        self.ends.lock().expect("ends lock").push((
+            input.outcome.unwrap_or_default().to_string(),
+            input.by.map(str::to_owned),
+            input.provider_call,
+        ));
+        Box::pin(std::future::ready(()))
+    }
+}
+
+fn local_provider(server: &MockServer) -> ModelProviderInfo {
+    let mut provider = built_in_model_providers(/*openai_base_url*/ None)["openai"].clone();
+    provider.name = "OpenAI (test)".into();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    provider
+}
+
+fn text(value: &str) -> TurnInputRequest {
+    TurnInputRequest::user_input(vec![UserInput::Text {
+        text: value.to_string(),
+        text_elements: Vec::new(),
+    }])
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_summary_answer_replaces_manual_compaction_without_a_provider_call() {
+    skip_if_no_network!();
+    let server = start_mock_server().await;
+    let log = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_assistant_message("m0", "FIRST"),
+                ev_completed_with_tokens("r0", /*total_tokens*/ 80),
+            ]),
+            sse(vec![
+                ev_assistant_message("m1", "AFTER"),
+                ev_completed("r1"),
+            ]),
+        ],
+    )
+    .await;
+    let planner = Planner::new(Mode::Summary);
+    let mut extensions = ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(planner.clone());
+    let provider = local_provider(&server);
+    let codex = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .with_config(move |config| config.model_provider = provider)
+        .build(&server)
+        .await
+        .unwrap()
+        .codex;
+    let rollout = codex.rollout_path().expect("rollout path");
+    codex.start_or_steer_turn(text("one")).await.unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+    codex.submit(Op::Compact).await.unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+    codex.start_or_steer_turn(text("two")).await.unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+
+    let requests = log.requests();
+    assert_eq!(requests.len(), 2, "the summary answer sends no request");
+    let body = requests[1].body_json().to_string();
+    assert!(body.contains(&format!("{SUMMARY_PREFIX}\\nMOD_SUMMARY")));
+    assert!(
+        !body.contains("FIRST"),
+        "the replaced history drops the reply"
+    );
+    let offer = planner.offers.lock().unwrap()[0].clone();
+    assert_eq!(offer["trigger"], "manual");
+    assert_eq!(offer["implementation"], "local");
+    assert_eq!(offer["prompt"], true);
+    assert_eq!(
+        *planner.ends.lock().unwrap(),
+        vec![("replaced".to_string(), Some("planner".to_string()), false)]
+    );
+    let checkpoint = std::fs::read_to_string(rollout)
+        .unwrap()
+        .lines()
+        .filter_map(|line| codex_rollout::parse_rollout_line(line.trim()).ok())
+        .find_map(|entry| match entry.item {
+            codex_history::RolloutItem::Compacted(item) => Some(item),
+            _ => None,
+        })
+        .expect("resume reads the replacement from the compaction checkpoint");
+    assert!(checkpoint.message.ends_with("MOD_SUMMARY"));
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_settled_remote_compaction_installs_the_contributor_history() {
+    skip_if_no_network!();
+    let server = start_mock_server().await;
+    let log = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_assistant_message("m0", "before"),
+                ev_completed_with_tokens("r0", /*total_tokens*/ 500),
+            ]),
+            sse(vec![
+                json!({"type": "response.output_item.done",
+                    "item": {"type": "compaction", "encrypted_content": "REMOTE_SUMMARY"}}),
+                ev_completed("rc"),
+            ]),
+            sse(vec![
+                ev_assistant_message("m1", "after"),
+                ev_completed("r1"),
+            ]),
+        ],
+    )
+    .await;
+    let planner = Planner::new(Mode::Settle);
+    let mut extensions = ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(planner.clone());
+    let codex = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .with_config(|config| config.model_auto_compact_token_limit = Some(200))
+        .build(&server)
+        .await
+        .unwrap()
+        .codex;
+    codex.start_or_steer_turn(text("one")).await.unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+    codex.start_or_steer_turn(text("two")).await.unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+
+    let requests = log.requests();
+    assert_eq!(requests.len(), 3);
+    assert_eq!(requests[1].inputs_of_type("compaction_trigger").len(), 1);
+    let input = requests[2].input();
+    assert!(
+        input
+            .iter()
+            .any(|item| item["encrypted_content"] == "REMOTE_SUMMARY")
+    );
+    assert!(
+        input
+            .iter()
+            .any(|item| item["content"][0]["text"] == "MOD_NOTE")
+    );
+    let offer = planner.offers.lock().unwrap()[0].clone();
+    assert_eq!(offer["implementation"], "remote");
+    assert_eq!(offer["phase"], "pre_turn");
+    assert_eq!(offer["prompt"], false);
+    assert_eq!(
+        *planner.ends.lock().unwrap(),
+        vec![("replaced".to_string(), Some("planner".to_string()), true)]
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_skip_holds_below_the_window_and_fails_at_it() {
+    skip_if_no_network!();
+    for (window, reply_tokens) in [(1_000_000, 500), (400, 500)] {
+        let hard = window < reply_tokens;
+        let server = start_mock_server().await;
+        let mut responses = vec![sse(vec![
+            ev_assistant_message("m0", "before"),
+            ev_completed_with_tokens("r0", reply_tokens),
+        ])];
+        if !hard {
+            responses.push(sse(vec![
+                ev_assistant_message("m1", "after"),
+                ev_completed("r1"),
+            ]));
+        }
+        let log = mount_sse_sequence(&server, responses).await;
+        let planner = Planner::new(Mode::Skip);
+        let mut extensions = ExtensionRegistryBuilder::new();
+        extensions.turn_lifecycle_contributor(planner.clone());
+        let provider = local_provider(&server);
+        let codex = test_codex()
+            .with_extensions(Arc::new(extensions.build()))
+            .with_config(move |config| {
+                config.model_provider = provider;
+                config.model_auto_compact_token_limit = Some(200);
+                config.model_context_window = Some(window);
+            })
+            .build(&server)
+            .await
+            .unwrap()
+            .codex;
+        codex.start_or_steer_turn(text("one")).await.unwrap();
+        wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+        codex.start_or_steer_turn(text("two")).await.unwrap();
+        let failed = wait_for_event(&codex, |ev| {
+            matches!(ev, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+        })
+        .await;
+        assert_eq!(planner.offers.lock().unwrap()[0]["hard"], hard);
+        if hard {
+            let EventMsg::Error(error) = failed else {
+                panic!("a skip at the context window fails the turn");
+            };
+            assert!(
+                error
+                    .message
+                    .contains("compaction_required: planner skipped")
+            );
+            assert_eq!(log.requests().len(), 1);
+        } else {
+            assert_eq!(log.requests().len(), 2, "no compaction request was sent");
+            assert_eq!(
+                *planner.ends.lock().unwrap(),
+                vec![("skipped".to_string(), Some("planner".to_string()), false)]
+            );
+        }
+    }
+}
diff --git a/codex-rs/core/tests/suite/lifecycle_seams.rs b/codex-rs/core/tests/suite/lifecycle_seams.rs
new file mode 100644
index 000000000..e2562f30c
--- /dev/null
+++ b/codex-rs/core/tests/suite/lifecycle_seams.rs
@@ -0,0 +1,120 @@
+//! Batch settlement and failure continuation offered to extension contributors.
+
+use codex_core::TurnInputRequest;
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::ToolBatchEndInput;
+use codex_extension_api::TurnContinuation;
+use codex_extension_api::TurnContinueInput;
+use codex_extension_api::TurnLifecycleContributor;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::ev_assistant_message;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_function_call;
+use core_test_support::responses::ev_response_created;
+use core_test_support::responses::mount_sse_sequence;
+use core_test_support::responses::sse;
+use core_test_support::responses::sse_failed;
+use core_test_support::responses::start_mock_server;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+#[derive(Default)]
+struct Recorder {
+    batches: Mutex<Vec<Vec<String>>>,
+    failures: Mutex<Vec<String>>,
+}
+
+impl TurnLifecycleContributor for Recorder {
+    fn on_tool_batch_end<'a>(&'a self, input: ToolBatchEndInput<'a>) -> ExtensionFuture<'a, ()> {
+        self.batches
+            .lock()
+            .expect("batches lock")
+            .push(input.call_ids.to_vec());
+        Box::pin(std::future::ready(()))
+    }
+
+    fn continue_turn<'a>(
+        &'a self,
+        input: TurnContinueInput<'a>,
+    ) -> ExtensionFuture<'a, Option<TurnContinuation>> {
+        let continuation = input.error.map(|error| {
+            self.failures
+                .lock()
+                .expect("failures lock")
+                .push(error.to_owned());
+            TurnContinuation {
+                source: "recorder".into(),
+                prompt: "TRY_AGAIN".into(),
+            }
+        });
+        Box::pin(std::future::ready(
+            continuation.filter(|_| input.continued == 0),
+        ))
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn settled_batches_are_reported_and_failed_turns_may_continue() {
+    skip_if_no_network!();
+    let server = start_mock_server().await;
+    let log = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("r0"),
+                ev_function_call(
+                    "call-1",
+                    "update_plan",
+                    &json!({"plan": [{"step": "one", "status": "pending"}]}).to_string(),
+                ),
+                ev_completed("r0"),
+            ]),
+            sse_failed("r1", "server_error", "provider down"),
+            sse(vec![
+                ev_assistant_message("m2", "RECOVERED"),
+                ev_completed("r2"),
+            ]),
+        ],
+    )
+    .await;
+    let recorder = Arc::new(Recorder::default());
+    let mut extensions = ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(recorder.clone());
+    let codex = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .with_config(|config| {
+            config.update_plan_enabled = true;
+            config.model_provider.stream_max_retries = Some(0);
+            config.model_provider.request_max_retries = Some(0);
+        })
+        .build(&server)
+        .await
+        .unwrap()
+        .codex;
+    codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "plan".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await
+        .unwrap();
+    wait_for_event(&codex, |ev| matches!(ev, EventMsg::TurnComplete(_))).await;
+
+    assert_eq!(
+        *recorder.batches.lock().unwrap(),
+        vec![vec!["call-1".to_string()]]
+    );
+    let failures = recorder.failures.lock().unwrap().clone();
+    assert_eq!(failures.len(), 1);
+    assert!(failures[0].contains("provider down"), "{failures:?}");
+    let requests = log.requests();
+    assert_eq!(requests.len(), 3);
+    assert!(requests[2].body_json().to_string().contains("TRY_AGAIN"));
+}
diff --git a/codex-rs/exec/src/omd_surface.rs b/codex-rs/exec/src/omd_surface.rs
new file mode 100644
index 000000000..ca00d9d08
--- /dev/null
+++ b/codex-rs/exec/src/omd_surface.rs
@@ -0,0 +1,70 @@
+use codex_app_server_client::InProcessAppServerRequestHandle;
+use codex_app_server_protocol::ClientRequest;
+use codex_omd::client_surface::ClientSurface;
+use codex_omd::client_surface::SurfaceCall;
+use serde_json::Value;
+use serde_json::json;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+pub(crate) struct ExecSurface {
+    handle: InProcessAppServerRequestHandle,
+    runtime: tokio::runtime::Handle,
+    next: AtomicU64,
+}
+
+impl ExecSurface {
+    pub(crate) fn new(handle: InProcessAppServerRequestHandle) -> Self {
+        Self {
+            handle,
+            runtime: tokio::runtime::Handle::current(),
+            next: AtomicU64::new(0),
+        }
+    }
+}
+
+pub(crate) fn report_activation_failures() {
+    let Some(root) = std::env::var_os(codex_omd::MOD_STORE_ENV) else {
+        return;
+    };
+    let Some(status) = std::fs::read(std::path::Path::new(&root).join("mod-status.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+    else {
+        return;
+    };
+    #[allow(clippy::print_stderr)]
+    for failure in codex_omd::activation_failures(&status) {
+        eprintln!("Oh My Diff mod failed to activate: {failure}");
+    }
+}
+
+impl ClientSurface for ExecSurface {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        if call.operation != "app.request" {
+            return Err(format!(
+                "client_surface_operation_unavailable: {} needs an interactive terminal",
+                call.operation
+            ));
+        }
+        if call.confirm.is_some() {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return Ok(());
+        }
+        let id = self.next.fetch_add(1, Ordering::Relaxed) + 1;
+        let request = json!({"method": call.arguments["method"], "id": format!("omd-{id}"),
+            "params": call.arguments["params"]});
+        let request = serde_json::from_value::<ClientRequest>(request)
+            .map_err(|error| format!("app_params_invalid: {error}"))?;
+        let handle = self.handle.clone();
+        let reply = call.reply;
+        self.runtime.spawn(async move {
+            let result = handle
+                .request_typed::<Value>(request)
+                .await
+                .map_err(|error| error.to_string());
+            let _ = reply.send(result);
+        });
+        Ok(())
+    }
+}
diff --git a/codex-rs/ext/extension-api/src/capabilities/tool_invoker.rs b/codex-rs/ext/extension-api/src/capabilities/tool_invoker.rs
