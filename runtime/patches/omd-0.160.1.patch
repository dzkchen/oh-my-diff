+    /// Shuts the thread down and waits for it only if no turn is active and no mailbox input is
+    /// pending. Returns whether it shut down; on `false` the thread keeps running untouched.
+    pub async fn shutdown_if_idle(&self) -> CodexResult<bool> {
+        let deadline = tokio::time::Instant::now() + std::time::Duration::from_millis(500);
+        loop {
+            if self.io.shutdown_if_idle_and_wait().await? {
+                return Ok(true);
+            }
+            // A finished turn reports completion before it clears the active turn.
+            let running = self
+                .session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .is_some_and(|turn| turn.task.is_some());
+            if running
+                || self.session.input_queue.has_pending_mailbox_items().await
+                || tokio::time::Instant::now() >= deadline
+            {
+                return Ok(false);
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+    }
