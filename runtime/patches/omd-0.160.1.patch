+fn blit_at(key: &str, caller: &str, value: Value, now: Instant) -> Result<Value, String> {
+    blit(
+        caller,
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key": key, "rect": value["rect"], "cells": value["cells"]}),
+        now,
+    )
+}
