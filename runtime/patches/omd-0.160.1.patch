+    );
+
+    let given_value = Value::Array(given.clone());
+    let mut moved = given.clone();
+    moved.swap(1, 2);
+    assert!(
+        !valid_sections(&Value::Array(moved), &given_value),
+        "an ordinary section crossed a protected one"
+    );
+    let mut policy = given.clone();
