+
+fn broadcast_event_except(event: &str, payload: Value, except: &str) {
+    let Some(ids) = with_host(|runtime, _| {
+        Some(
+            runtime
+                .owners()
+                .into_iter()
+                .map(|(id, _)| id)
+                .filter(|id| id != except && runtime.registered(id, event))
+                .collect::<Vec<_>>(),
+        )
+    }) else {
+        return;
+    };
+    for id in ids {
+        let _ = invoke_event(&id, event, payload.clone());
+    }
+}
