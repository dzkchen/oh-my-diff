@@ -0,0 +1,54 @@
+use crate::ModStore;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+use std::io;
+use std::path::Path;
+
+pub fn inspect(root: &Path) -> io::Result<Value> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Descriptor {
+        schema: u32,
+        component: String,
+        sha256: String,
+    }
+    if root.canonicalize()? != root {
+        return Err(io::Error::other("plugin_root_not_canonical"));
+    }
+    let snapshot = crate::Snapshot::capture(
+        root,
+        &BTreeSet::from([".codex-plugin/omd.json".into()]),
+        8192,
+    )?;
+    let descriptor: Descriptor = serde_json::from_slice(
+        &snapshot
+            .files
+            .get(".codex-plugin/omd.json")
+            .ok_or_else(|| io::Error::other("plugin_component_missing"))?
+            .bytes,
+    )?;
+    if descriptor.schema != 1
+        || descriptor.component.len() > 256
+        || descriptor.component.is_empty()
+        || Path::new(&descriptor.component)
+            .components()
+            .any(|part| !matches!(part, std::path::Component::Normal(_)))
+    {
+        return Err(io::Error::other("plugin_component_invalid"));
+    }
+    let mut path = root.to_owned();
+    for part in Path::new(&descriptor.component).components() {
+        path.push(part);
+        if path.canonicalize()? != path || !std::fs::symlink_metadata(&path)?.is_dir() {
+            return Err(io::Error::other("plugin_component_scope_invalid"));
+        }
+    }
+    let package = ModStore::inspect_package(&path)?;
+    if package["sha256"] != descriptor.sha256 {
+        return Err(io::Error::other("plugin_component_hash_mismatch"));
+    }
+    Ok(
+        json!({"schema":1,"plugin_root":root,"component":path,"package":package,"activation":"requires separate mod-store trust and enable"}),
+    )
+}
diff --git a/codex-rs/omd/src/resource_data.rs b/codex-rs/omd/src/resource_data.rs
new file mode 100644
index 000000000..19b7c69ae
--- /dev/null
+++ b/codex-rs/omd/src/resource_data.rs
@@ -0,0 +1,306 @@
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeSet;
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+
+pub const PAGE_BYTES: usize = 16_384;
+pub const SNAPSHOT_BYTES: usize = 262_144;
+
+pub fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+pub fn token(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+}
+
+pub fn redact(text: &str) -> String {
+    let mut private_key = false;
+    text.lines()
+        .map(|line| {
+            let lower = line.to_ascii_lowercase();
+            let begins_key = lower.contains("-----begin") && lower.contains("private key-----");
+            let ends_key = lower.contains("-----end") && lower.contains("private key-----");
+            private_key |= begins_key;
+            let sensitive = private_key
+                || [
+                    "authorization:",
+                    "authorization=",
+                    "bearer ",
+                    "api_key",
+                    "api-key",
+                    "apikey",
+                    "access_token",
+                    "refresh_token",
+                    "client_secret",
+                    "password=",
+                    "password:",
+                    "password\":",
+                    "secret=",
+                    "secret:",
+                ]
+                .iter()
+                .any(|needle| lower.contains(needle))
+                || ["sk-", "ghp_", "gho_", "github_pat_", "xoxb-", "xoxp-"]
+                    .iter()
+                    .any(|prefix| {
+                        lower.match_indices(prefix).any(|(offset, _)| {
+                            offset == 0 || !lower.as_bytes()[offset - 1].is_ascii_alphanumeric()
+                        })
+                    });
+            if ends_key {
+                private_key = false;
+            }
+            if sensitive {
+                "[redacted]".to_owned()
+            } else {
+                line.to_owned()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+pub fn contains_secret(text: &str) -> bool {
+    redact(text).lines().any(|line| line == "[redacted]")
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ResourceBinding {
+    pub repository: String,
+    pub owner: String,
+    pub thread: String,
+    pub generation: u64,
+    pub source_sha256: String,
+}
+
+impl ResourceBinding {
+    pub fn validate(&self) -> io::Result<()> {
+        if self.source_sha256.len() != 64
+            || !self
+                .source_sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+            || self.repository.len() != 64
+            || !self.repository.bytes().all(|byte| byte.is_ascii_hexdigit())
+            || !token(&self.owner)
+            || !token(&self.thread)
+        {
+            return Err(io::Error::other("resource_binding_invalid"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ResourceRef {
+    pub reference: String,
+    pub sha256: String,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct StoredResource {
+    binding: ResourceBinding,
+    kind: String,
+    payload: Value,
+}
+
+pub struct ResourceStore<'a> {
+    pub root: &'a Path,
+    pub binding: &'a ResourceBinding,
+}
+
+impl ResourceStore<'_> {
+    pub(crate) fn directory(&self) -> io::Result<PathBuf> {
+        self.binding.validate()?;
+        if self.root.canonicalize()? != self.root || !fs::symlink_metadata(self.root)?.is_dir() {
+            return Err(io::Error::other("resource_root_invalid"));
+        }
+        let mut path = self.root.to_owned();
+        for component in ["resources", &self.binding.repository, &self.binding.owner] {
+            path.push(component);
+            match fs::DirBuilder::new().create(&path) {
+                Ok(()) => {
+                    use std::os::unix::fs::PermissionsExt;
+                    fs::set_permissions(&path, fs::Permissions::from_mode(0o700))?;
+                }
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (),
+                Err(error) => return Err(error),
+            }
+            if path.canonicalize()? != path || !fs::symlink_metadata(&path)?.is_dir() {
+                return Err(io::Error::other("resource_directory_invalid"));
+            }
+        }
+        Ok(path)
+    }
+
+    pub fn save(&self, kind: &str, payload: Value) -> io::Result<ResourceRef> {
+        if !token(kind) {
+            return Err(io::Error::other("resource_kind_invalid"));
+        }
+        let value = StoredResource {
+            binding: self.binding.clone(),
+            kind: kind.to_owned(),
+            payload,
+        };
+        let bytes = serde_json::to_vec(&value)?;
+        if bytes.len() > SNAPSHOT_BYTES {
+            return Err(io::Error::other("resource_snapshot_limit"));
+        }
+        let sha256 = hash(&bytes);
+        let name = format!("{sha256}.json");
+        let directory = self.directory()?;
+        let path = directory.join(&name);
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(directory.join(".resources.lock"))?;
+        lock.try_lock()
+            .map_err(|_| io::Error::other("resource_store_busy"))?;
+        if !path.try_exists()? {
+            let mut total = 0u64;
+            let mut entries = 0;
+            for entry in fs::read_dir(&directory)?.take(1025) {
+                let entry = entry?;
+                entries += 1;
+                if entry.file_type()?.is_symlink() {
+                    return Err(io::Error::other("resource_directory_invalid"));
+                }
+                if entry
+                    .path()
+                    .extension()
+                    .is_some_and(|extension| extension == "json")
+                {
+                    total = total.saturating_add(entry.metadata()?.len());
+                }
+            }
+            if entries >= 1024 || total.saturating_add(bytes.len() as u64) > 64 * 1024 * 1024 {
+                return Err(io::Error::other("resource_store_quota"));
+            }
+        }
+        match fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&path)
+        {
+            Ok(mut file) => {
+                if let Err(error) = file.write_all(&bytes).and_then(|()| file.sync_all()) {
+                    drop(file);
+                    let _ = fs::remove_file(&path);
+                    return Err(error);
+                }
+            }
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+                let snapshot = crate::Snapshot::capture(
+                    &directory,
+                    &BTreeSet::from([name.clone()]),
+                    SNAPSHOT_BYTES,
+                )?;
+                if snapshot
+                    .files
+                    .get(&name)
+                    .is_none_or(|file| file.bytes != bytes)
+                {
+                    return Err(io::Error::other("resource_integrity_failed"));
+                }
+            }
+            Err(error) => return Err(error),
+        }
+        Ok(ResourceRef {
+            reference: sha256.clone(),
+            sha256,
+        })
+    }
+
+    pub(crate) fn record(&self, kind: &str, payload: Value) -> io::Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&StoredResource {
+            binding: self.binding.clone(),
+            kind: kind.to_owned(),
+            payload,
+        })?)
+    }
+
+    pub fn load(&self, reference: &ResourceRef, kind: &str) -> io::Result<Value> {
+        if reference.reference != reference.sha256
+            || reference.sha256.len() != 64
+            || !reference
+                .sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+        {
+            return Err(io::Error::other("resource_reference_invalid"));
+        }
+        let name = format!("{}.json", reference.reference);
+        let mut directory = self.directory()?;
+        if !directory.join(&name).try_exists()? {
+            directory = self.rotating_directory()?;
+        }
+        let snapshot =
+            crate::Snapshot::capture(&directory, &BTreeSet::from([name.clone()]), SNAPSHOT_BYTES)?;
+        let bytes = &snapshot
+            .files
+            .get(&name)
+            .ok_or_else(|| io::Error::other("resource_unavailable"))?
+            .bytes;
+        if hash(bytes) != reference.sha256 {
+            return Err(io::Error::other("resource_integrity_failed"));
+        }
+        let value: StoredResource = serde_json::from_slice(bytes)?;
+        let package_asset = value.binding.thread == "package"
+            && value.binding.generation == 0
+            && value.binding.repository == self.binding.repository
+            && value.binding.owner == self.binding.owner
+            && value.binding.source_sha256 == self.binding.source_sha256;
+        if (value.binding != *self.binding && !package_asset) || value.kind != kind {
+            return Err(io::Error::other("resource_scope_mismatch"));
+        }
+        Ok(value.payload)
+    }
+
+    pub fn page(
+        &self,
+        reference: &ResourceRef,
+        kind: &str,
+        cursor: usize,
+        max_bytes: usize,
+    ) -> io::Result<Value> {
+        if !(1..=PAGE_BYTES).contains(&max_bytes) {
+            return Err(io::Error::other("resource_page_limit"));
+        }
+        let loaded = self.load(reference, kind)?;
+        let payload = match self.blob_text(&loaded)? {
+            Some(text) => text,
+            None => serde_json::to_string(&loaded)?,
+        };
+        if cursor > payload.len() || !payload.is_char_boundary(cursor) {
+            return Err(io::Error::other("resource_cursor_invalid"));
+        }
+        let mut end = cursor.saturating_add(max_bytes).min(payload.len());
+        while !payload.is_char_boundary(end) {
+            end -= 1;
+        }
+        if end == cursor && end < payload.len() {
+            return Err(io::Error::other("resource_page_too_small"));
+        }
+        Ok(
+            json!({"reference":reference,"text":&payload[cursor..end],"cursor":(end<payload.len()).then_some(end),"bytes":payload.len()}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/scoped_data.rs b/codex-rs/omd/src/scoped_data.rs
new file mode 100644
index 000000000..f1d9c21fa
--- /dev/null
+++ b/codex-rs/omd/src/scoped_data.rs
@@ -0,0 +1,220 @@
+use crate::resource_data::{ResourceBinding, ResourceStore, hash};
+use crate::sessions::SessionIndex;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::io;
+use std::path::PathBuf;
+
+pub struct ScopedDataHost {
+    pub root: PathBuf,
+    pub repository: PathBuf,
+    pub session_root: Option<PathBuf>,
+    pub session_database: Option<PathBuf>,
+    pub binding: ResourceBinding,
+    pub(crate) session_bytes: usize,
+}
+
+pub fn operation(name: &str) -> bool {
+    matches!(
+        name,
+        "evidence.read" | "evidence.write" | "sessions.list" | "sessions.read"
+    )
+}
+
+impl ScopedDataHost {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        owner: String,
+        thread: String,
+        source_sha256: String,
+    ) -> io::Result<Self> {
+        if repository.canonicalize()? != repository
+            || root.canonicalize()? != root
+            || root.starts_with(&repository)
+        {
+            return Err(io::Error::other("data_scope_invalid"));
+        }
+        let configuration = crate::ModStore::open(root.clone())?.configuration()?;
+        if !configuration
+            .mods
+            .iter()
+            .any(|selection| selection.enabled && selection.sha256 == source_sha256)
+        {
+            return Err(io::Error::other("data_source_not_selected"));
+        }
+        let binding = ResourceBinding {
+            repository: hash(repository.as_os_str().as_encoded_bytes()),
+            owner,
+            thread,
+            generation: configuration.revision,
+            source_sha256,
+        };
+        binding.validate()?;
+        Ok(Self {
+            root,
+            repository,
+            session_root,
+            session_database,
+            binding,
+            session_bytes: 0,
+        })
+    }
+
+    pub fn call(
+        &mut self,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        if !active() {
+            return Err(io::Error::other("data_operation_cancelled"));
+        }
+        let configuration = crate::ModStore::open(self.root.clone())?.configuration()?;
+        let selection = configuration
+            .mods
+            .iter()
+            .find(|selection| selection.enabled && selection.sha256 == self.binding.source_sha256)
+            .ok_or_else(|| io::Error::other("data_source_not_selected"))?;
+        let required = crate::ModHostCall {
+            operation: name.into(),
+            arguments: Value::Null,
+        }
+        .capability()
+        .map_err(|error| io::Error::other(error.to_string()))?;
+        if configuration.revision != self.binding.generation
+            || !selection.capabilities.iter().any(|cap| cap == required)
+        {
+            return Err(io::Error::other("data_selection_changed_or_revoked"));
+        }
+        if name == "evidence.read" {
+            #[derive(serde::Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Input {
+                reference: crate::resource_data::ResourceRef,
+                cursor: Option<usize>,
+                max_bytes: Option<usize>,
+            }
+            let input: Input = serde_json::from_value(arguments)?;
+            let mut last = io::Error::other("resource_unavailable");
+            for kind in ["turn", "evidence"] {
+                match self.resources().page(
+                    &input.reference,
+                    kind,
+                    input.cursor.unwrap_or(0),
+                    input.max_bytes.unwrap_or(crate::resource_data::PAGE_BYTES),
+                ) {
+                    Ok(page) => return Ok(page),
+                    Err(error) => last = error,
+                }
+            }
+            return Err(last);
+        }
+        if name == "evidence.write" {
+            let resources = self.resources();
+            let reference = resources.save("evidence", resources.evidence_record(arguments)?)?;
+            return Ok(serde_json::to_value(reference)?);
+        }
+        if name.starts_with("sessions.") {
+            let root = self
+                .session_root
+                .as_ref()
+                .ok_or_else(|| io::Error::other("session_access_unavailable"))?;
+            let result = SessionIndex {
+                root,
+                database: self.session_database.as_deref(),
+                repository: &self.repository,
+                enabled: true,
+            }
+            .call(name, arguments, active)?;
+            self.session_bytes = self
+                .session_bytes
+                .saturating_add(serde_json::to_vec(&result)?.len());
+            if self.session_bytes > 1_048_576 {
+                return Err(io::Error::other("session_invocation_limit"));
+            }
+            return Ok(result);
+        }
+        Err(io::Error::other("data_operation_unavailable"))
+    }
+
+    pub fn resources(&self) -> ResourceStore<'_> {
+        ResourceStore {
+            root: &self.root,
+            binding: &self.binding,
+        }
+    }
+}
+
+pub struct ScopedDataHosts {
+    root: PathBuf,
+    repository: PathBuf,
+    session_root: Option<PathBuf>,
+    session_database: Option<PathBuf>,
+    thread: String,
+    hosts: BTreeMap<String, ScopedDataHost>,
+}
+
+impl ScopedDataHosts {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        thread: String,
+    ) -> Self {
+        Self {
+            root,
+            repository,
+            session_root,
+            session_database,
+            thread,
+            hosts: BTreeMap::new(),
+        }
+    }
+
+    pub fn call(
+        &mut self,
+        owner: &str,
+        source_sha256: &str,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        self.host(owner, source_sha256)?
+            .call(name, arguments, active)
+    }
+
+    pub fn text_evidence(
+        &mut self,
+        owner: &str,
+        source_sha256: &str,
+        label: &str,
+        text: &str,
+    ) -> io::Result<crate::resource_data::ResourceRef> {
+        self.host(owner, source_sha256)?
+            .resources()
+            .text_evidence(label, text)
+    }
+
+    fn host(&mut self, owner: &str, source_sha256: &str) -> io::Result<&mut ScopedDataHost> {
+        let host = match self.hosts.entry(owner.to_owned()) {
+            std::collections::btree_map::Entry::Occupied(entry) => entry.into_mut(),
+            std::collections::btree_map::Entry::Vacant(entry) => entry.insert(ScopedDataHost::new(
+                self.root.clone(),
+                self.repository.clone(),
+                self.session_root.clone(),
+                self.session_database.clone(),
+                owner.to_owned(),
+                self.thread.clone(),
+                source_sha256.to_owned(),
+            )?),
+        };
+        if host.binding.source_sha256 != source_sha256 {
+            return Err(io::Error::other("data_selection_changed_or_revoked"));
+        }
+        Ok(host)
+    }
+}
diff --git a/codex-rs/omd/src/session_policy.rs b/codex-rs/omd/src/session_policy.rs
new file mode 100644
index 000000000..c0fb9b585
--- /dev/null
+++ b/codex-rs/omd/src/session_policy.rs
@@ -0,0 +1,136 @@
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::io::{self, Read};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+pub(crate) fn permitted(
+    root: &Path,
+    repository: &Path,
+    configured_database: Option<&Path>,
+    active: &dyn Fn() -> bool,
+) -> io::Result<Option<BTreeMap<String, Option<PathBuf>>>> {
+    let database = configured_database.map(Path::to_path_buf).unwrap_or(
+        root.parent()
+            .ok_or_else(|| io::Error::other("session_home_missing"))?
+            .join("state_5.sqlite"),
+    );
+    let home = database
+        .parent()
+        .ok_or_else(|| io::Error::other("session_home_missing"))?;
+    if home.try_exists()? {
+        for (ordinal, entry) in std::fs::read_dir(home)?.enumerate() {
+            if ordinal >= 4096 || !active() {
+                return Err(io::Error::other("session_policy_scan_limit_or_cancelled"));
+            }
+            let name = entry?.file_name().to_string_lossy().into_owned();
+            if let Some(version) = name
+                .strip_prefix("state_")
+                .and_then(|value| value.strip_suffix(".sqlite"))
+                && version.parse::<u32>().map_or(true, |version| version > 5)
+            {
+                return Err(io::Error::other("session_policy_version_unsupported"));
+            }
+        }
+    }
+    if !database.try_exists()? {
+        return Ok(None);
+    }
+    if database.canonicalize()? != database || !std::fs::symlink_metadata(&database)?.is_file() {
+        return Err(io::Error::other("session_policy_scope_invalid"));
+    }
+    if !active() {
+        return Err(io::Error::other("session_read_cancelled"));
+    }
+    let hex: String = repository
+        .as_os_str()
+        .as_encoded_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect();
+    let query = format!(
+        "PRAGMA query_only=ON; PRAGMA trusted_schema=OFF; SELECT id,memory_mode,rollout_path FROM threads WHERE cwd=CAST(X'{hex}' AS TEXT) ORDER BY id LIMIT 4097;"
+    );
+    let mut child = Command::new("/usr/bin/sqlite3")
+        .args([
+            "-batch",
+            "-json",
+            "-init",
+            "/dev/null",
+            "-cmd",
+            ".timeout 100",
+        ])
+        .arg(&database)
+        .arg(query)
+        .env_clear()
+        .env("HOME", "/nonexistent")
+        .current_dir(root)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| io::Error::other("session_policy_backend_unavailable"))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| io::Error::other("session_policy_pipe_unavailable"))?;
+    let reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stdout
+            .take(1_048_577)
+            .read_to_end(&mut bytes)
+            .map(|_| bytes)
+    });
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let result = loop {
+        if !active() || Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            break Err(io::Error::other("session_policy_cancelled_or_timed_out"));
+        }
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                break if status.success() {
+                    Ok(())
+                } else {
+                    Err(io::Error::other("session_policy_unavailable"))
+                };
+            }
+            Ok(None) => std::thread::sleep(Duration::from_millis(10)),
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                break Err(error);
+            }
+        }
+    };
+    let bytes = reader
+        .join()
+        .map_err(|_| io::Error::other("session_policy_reader_failed"))??;
+    result?;
+    if bytes.len() > 1_048_576 {
+        return Err(io::Error::other("session_policy_limit"));
+    }
+    if bytes.is_empty() {
+        return Ok(Some(BTreeMap::new()));
+    }
+    let rows: Vec<Value> = serde_json::from_slice(&bytes)?;
+    if rows.len() > 4096 {
+        return Err(io::Error::other("session_policy_limit"));
+    }
+    let mut allowed = BTreeMap::new();
+    for row in rows {
+        let id = row["id"]
+            .as_str()
+            .filter(|id| crate::resource_data::token(id))
+            .ok_or_else(|| io::Error::other("session_policy_identity_invalid"))?;
+        if row["memory_mode"] == "enabled" {
+            allowed.insert(
+                id.to_owned(),
+                row["rollout_path"].as_str().map(PathBuf::from),
+            );
+        }
+    }
+    Ok(Some(allowed))
+}
diff --git a/codex-rs/omd/src/sessions.rs b/codex-rs/omd/src/sessions.rs
new file mode 100644
index 000000000..bcc07501d
--- /dev/null
+++ b/codex-rs/omd/src/sessions.rs
@@ -0,0 +1,522 @@
+use crate::resource_data::{PAGE_BYTES, hash, redact, token};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+use std::fs;
+use std::io::{self, BufRead, Read};
+use std::path::{Path, PathBuf};
+
+const SOURCE_BYTES: usize = 32 * 1024 * 1024;
+const HEAD_BYTES: u64 = 1024 * 1024;
+const SCAN_FILES: usize = 4096;
+const SCAN_BYTES: u64 = 128 * 1024 * 1024;
+
+pub struct SessionIndex<'a> {
+    pub root: &'a Path,
+    pub database: Option<&'a Path>,
+    pub repository: &'a Path,
+    pub enabled: bool,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct SessionSummary {
+    pub session_id: String,
+    pub task_id: String,
+    pub parent_id: Option<String>,
+    pub timestamp: String,
+    pub revision: String,
+    pub handle: String,
+    pub history_mode: String,
+    pub inherited_history: bool,
+    pub incomplete_tail: bool,
+}
+
+struct Session {
+    summary: SessionSummary,
+    meta: Value,
+    bytes: Vec<u8>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ListRequest {
+    since: Option<String>,
+    until: Option<String>,
+    cursor: Option<String>,
+    limit: Option<usize>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReadRequest {
+    session_id: String,
+    revision: String,
+    handle: String,
+    cursor: Option<usize>,
+    max_bytes: Option<usize>,
+}
+
+fn date(value: &str) -> bool {
+    let b = value.as_bytes();
+    b.len() == 10
+        && b[4] == b'-'
+        && b[7] == b'-'
+        && b.iter()
+            .enumerate()
+            .all(|(i, byte)| matches!(i, 4 | 7) || byte.is_ascii_digit())
+        && value[5..7]
+            .parse::<u32>()
+            .is_ok_and(|month| (1..=12).contains(&month))
+        && value[8..10]
+            .parse::<u32>()
+            .is_ok_and(|day| (1..=31).contains(&day))
+}
+
+fn segment(path: &Path) -> Option<String> {
+    path.file_name()
+        .and_then(|name| name.to_str())
+        .map(|name| name.trim_end_matches(".zst").to_owned())
+}
+
+fn cancelled() -> io::Error {
+    io::Error::other("session_read_cancelled")
+}
+
+fn in_range(timestamp: Option<&str>, since: Option<&String>, until: Option<&String>) -> bool {
+    timestamp
+        .and_then(|value| value.get(..10))
+        .is_some_and(|day| {
+            since.is_none_or(|since| day >= since.as_str())
+                && until.is_none_or(|until| day < until.as_str())
+        })
+}
+
+impl SessionIndex<'_> {
+    fn paths(&self, active: &dyn Fn() -> bool) -> io::Result<(Vec<PathBuf>, bool)> {
+        if !self.enabled {
+            return Err(io::Error::other("session_access_disabled"));
+        }
+        if !active() {
+            return Err(cancelled());
+        }
+        if self.repository.canonicalize()? != self.repository
+            || self.root.canonicalize()? != self.root
+            || !fs::symlink_metadata(self.root)?.is_dir()
+        {
+            return Err(io::Error::other("session_scope_not_canonical"));
+        }
+        let mut pending = vec![(self.root.to_path_buf(), 0)];
+        let mut paths = Vec::new();
+        let mut seen = 0;
+        let mut truncated = false;
+        while let Some((directory, depth)) = pending.pop() {
+            if !active() {
+                return Err(cancelled());
+            }
+            let mut entries = fs::read_dir(directory)?
+                .take(SCAN_FILES + 1 - seen)
+                .collect::<Result<Vec<_>, _>>()?;
+            entries.sort_by_key(|entry| entry.file_name());
+            for entry in entries {
+                seen += 1;
+                if seen > SCAN_FILES {
+                    truncated = true;
+                    pending.clear();
+                    break;
+                }
+                let kind = entry.file_type()?;
+                if kind.is_dir() && depth < 3 {
+                    pending.push((entry.path(), depth + 1));
+                } else if kind.is_file()
+                    && entry
+                        .path()
+                        .extension()
+                        .is_some_and(|extension| extension == "jsonl")
+                {
+                    paths.push(entry.path());
+                }
+            }
+        }
+        paths.sort();
+        Ok((paths, truncated))
+    }
+
+    fn name<'p>(&self, path: &'p Path) -> io::Result<&'p str> {
+        path.strip_prefix(self.root)
+            .map_err(io::Error::other)?
+            .to_str()
+            .ok_or_else(|| io::Error::other("session_path_encoding"))
+    }
+
+    fn scoped(&self, meta: &Value) -> bool {
+        meta["cwd"]
+            .as_str()
+            .and_then(|path| Path::new(path).canonicalize().ok())
+            .as_deref()
+            == Some(self.repository)
+    }
+
+    fn head(&self, path: &Path) -> io::Result<Option<Value>> {
+        let mut line = Vec::new();
+        io::BufReader::new(crate::workspace::open_contained(
+            self.root,
+            self.name(path)?,
+        )?)
+        .take(HEAD_BYTES)
+        .read_until(b'\n', &mut line)?;
+        let first: Value = serde_json::from_slice(&line)?;
+        Ok((first["type"] == "session_meta").then(|| first["payload"].clone()))
+    }
+
+    /// The database's current segment and the segments its `history_base` chain continues.
+    fn lineage(&self, current: &Path, paths: &[PathBuf]) -> BTreeSet<String> {
+        let mut names = BTreeSet::new();
+        let mut next = segment(current);
+        while let Some(name) = next.take()
+            && names.insert(name.clone())
+        {
+            let base = paths
+                .iter()
+                .find(|path| segment(path).as_ref() == Some(&name))
+                .and_then(|path| self.head(path).ok().flatten())
+                .and_then(|head| {
+                    head["history_base"]["thread_id"]
+                        .as_str()
+                        .map(str::to_owned)
+                });
+            next = base.and_then(|base| {
+                paths.iter().filter_map(|path| segment(path)).find(|name| {
+                    let stem = name.trim_end_matches(".jsonl");
+                    stem.ends_with(&format!("-{base}")) || stem.ends_with(&format!("_{base}"))
+                })
+            });
+        }
+        names
+    }
+
+    fn load(&self, path: &Path, active: &dyn Fn() -> bool) -> io::Result<Option<Session>> {
+        if !active() {
+            return Err(cancelled());
+        }
+        let name = self.name(path)?;
+        let snapshot =
+            crate::Snapshot::capture(self.root, &BTreeSet::from([name.to_owned()]), SOURCE_BYTES)?;
+        let mut bytes = snapshot
+            .files
+            .get(name)
+            .ok_or_else(|| io::Error::other("session_missing"))?
+            .bytes
+            .clone();
+        let complete = bytes
+            .iter()
+            .rposition(|byte| *byte == b'\n')
+            .map_or(0, |index| index + 1);
+        let incomplete_tail = complete != bytes.len();
+        bytes.truncate(complete);
+        let mut lines = bytes
+            .split(|byte| *byte == b'\n')
+            .filter(|line| !line.is_empty());
+        let first: Value = serde_json::from_slice(
+            lines
+                .next()
+                .ok_or_else(|| io::Error::other("session_empty"))?,
+        )?;
+        if first["type"] != "session_meta" {
+            return Ok(None);
+        }
+        let initial = &first["payload"];
+        let mut meta = initial.clone();
+        for line in
+            lines.filter(|line| line.windows(14).any(|window| window == b"\"session_meta\""))
+        {
+            if !active() {
+                return Err(cancelled());
+            }
+            let record: Value = serde_json::from_slice(line)?;
+            if record["type"] == "session_meta" {
+                if record["payload"]["id"] != initial["id"]
+                    || record["payload"]["cwd"] != initial["cwd"]
+                {
+                    return Err(io::Error::other("session_metadata_changed_identity"));
+                }
+                meta = record["payload"].clone();
+            }
+        }
+        if !self.scoped(&meta)
+            || meta["memory_mode"]
+                .as_str()
+                .is_some_and(|mode| mode != "enabled")
+            || meta["session_review"] == false
+        {
+            return Ok(None);
+        }
+        let id = meta["id"]
+            .as_str()
+            .filter(|id| token(id))
+            .ok_or_else(|| io::Error::other("session_id_invalid"))?;
+        let timestamp = meta["timestamp"]
+            .as_str()
+            .filter(|value| value.len() <= 40 && value.get(..10).is_some_and(date))
+            .ok_or_else(|| io::Error::other("session_timestamp_invalid"))?;
+        let summary = SessionSummary {
+            session_id: id.to_owned(),
+            task_id: meta["session_id"]
+                .as_str()
+                .filter(|id| token(id))
+                .unwrap_or(id)
+                .to_owned(),
+            parent_id: meta["parent_thread_id"]
+                .as_str()
+                .filter(|id| token(id))
+                .map(str::to_owned),
+            timestamp: timestamp.to_owned(),
+            revision: hash(&bytes),
+            handle: hash(name.as_bytes()),
+            history_mode: meta["history_mode"].as_str().unwrap_or("legacy").to_owned(),
+            inherited_history: !meta["history_base"].is_null() || !meta["forked_from_id"].is_null(),
+            incomplete_tail,
+        };
+        Ok(Some(Session {
+            summary,
+            meta,
+            bytes,
+        }))
+    }
+
+    fn records(
+        &self,
+        session: &Session,
+        active: &dyn Fn() -> bool,
+    ) -> io::Result<(Vec<Value>, bool)> {
+        let id = &session.summary.session_id;
+        let mut records = Vec::new();
+        let mut turn = String::new();
+        let mut in_scope = false;
+        let lines = session
+            .bytes
+            .split(|byte| *byte == b'\n')
+            .filter(|line| !line.is_empty())
+            .skip(1);
+        for (index, line) in lines.enumerate() {
+            if !active() {
+                return Err(cancelled());
+            }
+            let value: Value = serde_json::from_slice(line)?;
+            let payload = &value["payload"];
+            if let Some(start) = session.meta["subagent_history_start_ordinal"].as_u64() {
+                let ordinal = value["ordinal"].as_u64().unwrap_or(index as u64 + 1);
+                if ordinal < start {
+                    continue;
+                }
+            }
+            if value["type"] == "turn_context" {
+                in_scope = self.scoped(payload);
+                turn = payload["turn_id"]
+                    .as_str()
+                    .filter(|id| token(id))
+                    .unwrap_or_default()
+                    .to_owned();
+                continue;
+            }
+            if !in_scope
+                || value["type"] != "response_item"
+                || payload["type"] != "message"
+                || !matches!(payload["role"].as_str(), Some("user" | "assistant"))
+                || payload["channel"] == "analysis"
+            {
+                continue;
+            }
+            let text = payload["content"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter(|item| matches!(item["type"].as_str(), Some("input_text" | "output_text")))
+                .filter_map(|item| item["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n");
+            if text.is_empty() {
+                continue;
+            }
+            let redacted = redact(&text);
+            let limited: String = redacted.chars().take(2048).collect();
+            records.push(json!({"session_id":id,"turn_id":turn,"item":index+1,"role":payload["role"],"text":limited,"truncated":limited.len()<redacted.len(),"redacted":redacted!=text,"timestamp":value["timestamp"],"untrusted":true}));
+            if records.len() >= 4096 {
+                return Ok((records, true));
+            }
+        }
+        Ok((records, false))
+    }
+
+    pub fn call(
+        &self,
+        operation: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        if !self.enabled {
+            return Err(io::Error::other("session_access_disabled"));
+        }
+        let policy =
+            crate::session_policy::permitted(self.root, self.repository, self.database, &active)?;
+        let allowed = |id: &str| policy.as_ref().is_none_or(|ids| ids.contains_key(id));
+        let lineages = std::cell::RefCell::new(std::collections::BTreeMap::new());
+        let current = |id: &str, path: &Path, paths: &[PathBuf]| {
+            policy
+                .as_ref()
+                .and_then(|ids| ids.get(id))
+                .and_then(Option::as_ref)
+                .is_none_or(|current| {
+                    segment(path).is_some_and(|name| {
+                        lineages
+                            .borrow_mut()
+                            .entry(id.to_owned())
+                            .or_insert_with(|| self.lineage(current, paths))
+                            .contains(&name)
+                    })
+                })
+        };
+        let result = match operation {
+            "sessions.list" => {
+                let input: ListRequest = serde_json::from_value(arguments)?;
+                let limit = input.limit.unwrap_or(20);
+                if !(1..=100).contains(&limit)
+                    || input.since.as_ref().is_some_and(|value| !date(value))
+                    || input.until.as_ref().is_some_and(|value| !date(value))
+                    || matches!((&input.since, &input.until), (Some(since), Some(until)) if since >= until)
+                {
+                    return Err(io::Error::other("session_list_bounds"));
+                }
+                let (paths, mut truncated) = self.paths(&active)?;
+                let (since, until) = (input.since.as_ref(), input.until.as_ref());
+                let mut unavailable = 0;
+                let mut scanned = 0u64;
+                let mut rows = Vec::new();
+                let mut ids = BTreeSet::new();
+                for path in paths.iter().rev() {
+                    let head = match self.head(path) {
+                        Ok(Some(head)) => head,
+                        Ok(None) => continue,
+                        Err(_) if !active() => return Err(cancelled()),
+                        Err(_) => {
+                            unavailable += 1;
+                            continue;
+                        }
+                    };
+                    if !self.scoped(&head) || !in_range(head["timestamp"].as_str(), since, until) {
+                        continue;
+                    }
+                    scanned = scanned
+                        .saturating_add(fs::symlink_metadata(path).map_or(0, |meta| meta.len()));
+                    if scanned > SCAN_BYTES {
+                        truncated = true;
+                        break;
+                    }
+                    match self.load(path, &active) {
+                        Ok(Some(session))
+                            if allowed(&session.summary.session_id)
+                                && current(&session.summary.session_id, path, &paths)
+                                && in_range(Some(&session.summary.timestamp), since, until) =>
+                        {
+                            if !ids.insert((
+                                session.summary.session_id.clone(),
+                                session.meta["history_base"].to_string(),
+                            )) {
+                                return Err(io::Error::other("session_identity_ambiguous"));
+                            }
+                            rows.push(session.summary);
+                        }
+                        Ok(_) => (),
+                        Err(error) if !active() => return Err(error),
+                        Err(_) => unavailable += 1,
+                    }
+                }
+                rows.sort_by(|a, b| {
+                    (&b.timestamp, &b.session_id).cmp(&(&a.timestamp, &a.session_id))
+                });
+                let revision = hash(&serde_json::to_vec(&rows)?);
+                let start = match input.cursor {
+                    Some(cursor) => {
+                        let (digest, offset) = cursor
+                            .split_once(':')
+                            .ok_or_else(|| io::Error::other("session_cursor_invalid"))?;
+                        if digest != revision {
+                            return Err(io::Error::other("session_index_changed"));
+                        }
+                        offset.parse::<usize>().map_err(io::Error::other)?
+                    }
+                    None => 0,
+                };
+                if start > rows.len() {
+                    return Err(io::Error::other("session_cursor_invalid"));
+                }
+                let end = start.saturating_add(limit).min(rows.len());
+                Ok(
+                    json!({"sessions":rows[start..end],"cursor":(end<rows.len()).then(||format!("{revision}:{end}")),"revision":revision,"scan_truncated":truncated,"unavailable":unavailable,"projection":"local_visible_message_records"}),
+                )
+            }
+            "sessions.read" => {
+                let input: ReadRequest = serde_json::from_value(arguments)?;
+                let limit = input.max_bytes.unwrap_or(PAGE_BYTES);
+                if !token(&input.session_id)
+                    || input.revision.len() != 64
+                    || input.handle.len() != 64
+                    || !(1024..=PAGE_BYTES).contains(&limit)
+                {
+                    return Err(io::Error::other("session_read_bounds"));
+                }
+                if !allowed(&input.session_id) {
+                    return Err(io::Error::other("session_opted_out_or_unavailable"));
+                }
+                let (paths, _) = self.paths(&active)?;
+                let path = paths
+                    .iter()
+                    .find(|path| {
+                        self.name(path)
+                            .is_ok_and(|name| hash(name.as_bytes()) == input.handle)
+                    })
+                    .ok_or_else(|| io::Error::other("session_unavailable"))?;
+                let session = self
+                    .load(path, &active)?
+                    .filter(|session| {
+                        session.summary.session_id == input.session_id
+                            && current(&input.session_id, path, &paths)
+                    })
+                    .ok_or_else(|| io::Error::other("session_unavailable"))?;
+                if input.revision != session.summary.revision {
+                    return Err(io::Error::other("session_revision_changed"));
+                }
+                let (records, projection_truncated) = self.records(&session, &active)?;
+                let start = input.cursor.unwrap_or(0);
+                if start > records.len() {
+                    return Err(io::Error::other("session_cursor_invalid"));
+                }
+                let mut end = start;
+                let mut bytes = 0;
+                while let Some(record) = records.get(end) {
+                    let size = serde_json::to_vec(record)?.len();
+                    if bytes + size > limit {
+                        break;
+                    }
+                    bytes += size;
+                    end += 1;
+                }
+                if end == start && end < records.len() {
+                    return Err(io::Error::other("session_record_exceeds_page"));
+                }
+                Ok(
+                    json!({"session":session.summary,"records":records[start..end],"cursor":(end<records.len()).then_some(end),"bytes":bytes,"projection":"local_visible_message_records","projection_truncated":projection_truncated}),
+                )
+            }
+            _ => Err(io::Error::other("session_operation_unavailable")),
+        }?;
+        if !active() {
+            return Err(cancelled());
+        }
+        if policy
+            != crate::session_policy::permitted(self.root, self.repository, self.database, &active)?
+        {
+            return Err(io::Error::other("session_policy_changed"));
+        }
+        Ok(result)
+    }
+}
diff --git a/codex-rs/omd/src/tool_schema.rs b/codex-rs/omd/src/tool_schema.rs
new file mode 100644
index 000000000..5926f3682
--- /dev/null
+++ b/codex-rs/omd/src/tool_schema.rs
@@ -0,0 +1,318 @@
+use serde_json::Value;
+use std::io;
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+
+const INVENTORY_FILE: &str = "tool-inventory.json";
+const TYPES_FILE: &str = "tool-types.d.ts";
+
+fn escape(segment: &str) -> String {
+    segment.replace('~', "~0").replace('/', "~1")
+}
+
+fn kind(value: &Value) -> &'static str {
+    match value {
+        Value::Null => "null",
+        Value::Bool(_) => "boolean",
+        Value::Number(_) => "number",
+        Value::String(_) => "string",
+        Value::Array(_) => "array",
+        Value::Object(_) => "object",
+    }
+}
+
+fn is_type(value: &Value, name: &str) -> bool {
+    match name {
+        "integer" => value.as_f64().is_some_and(|number| number.fract() == 0.0),
+        name => kind(value) == name,
+    }
+}
+
+fn check(schema: &Value, value: &Value, pointer: &str) -> Result<(), String> {
+    let Some(schema) = schema.as_object() else {
+        return Ok(());
+    };
+    let at = |reason: String| {
+        let pointer = if pointer.is_empty() { "/" } else { pointer };
+        format!("{pointer}: {reason}")
+    };
+    match schema.get("type") {
+        Some(Value::String(name)) if !is_type(value, name) => {
+            return Err(at(format!("expected {name}, got {}", kind(value))));
+        }
+        Some(Value::Array(names))
+            if !names
+                .iter()
+                .filter_map(Value::as_str)
+                .any(|name| is_type(value, name)) =>
+        {
+            return Err(at(format!(
+                "expected one of {}",
+                Value::Array(names.clone())
+            )));
+        }
+        _ => {}
+    }
+    if let Some(allowed) = schema.get("enum").and_then(Value::as_array)
+        && !allowed.contains(value)
+    {
+        return Err(at(format!(
+            "expected one of {}",
+            Value::Array(allowed.clone())
+        )));
+    }
+    if let Some(variants) = schema.get("anyOf").and_then(Value::as_array)
+        && !variants
+            .iter()
+            .any(|variant| check(variant, value, pointer).is_ok())
+    {
+        return Err(at("matches no anyOf variant".into()));
+    }
+    if let Some(object) = value.as_object() {
+        for name in schema
+            .get("required")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(Value::as_str)
+        {
+            if !object.contains_key(name) {
+                return Err(format!("{pointer}/{}: required", escape(name)));
+            }
+        }
+        let properties = schema.get("properties").and_then(Value::as_object);
+        for (name, member) in object {
+            let child = format!("{pointer}/{}", escape(name));
+            match (
+                properties.and_then(|known| known.get(name)),
+                schema.get("additionalProperties"),
+            ) {
+                (Some(known), _) => check(known, member, &child)?,
+                (None, Some(Value::Bool(false))) => return Err(format!("{child}: not allowed")),
+                (None, Some(extra @ Value::Object(_))) => check(extra, member, &child)?,
+                _ => {}
+            }
+        }
+    }
+    if let (Some(items), Some(values)) = (schema.get("items"), value.as_array()) {
+        for (index, member) in values.iter().enumerate() {
+            check(items, member, &format!("{pointer}/{index}"))?;
+        }
+    }
+    Ok(())
+}
+
+/// Checks `value` against the JSON-schema subset tool parameters use; the error is `<json-pointer>: <reason>`.
+pub fn validate(schema: &Value, value: &Value) -> Result<(), String> {
+    check(schema, value, "")
+}
+
+fn comment(text: &str) -> String {
+    let text = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    format!("/** {} */", text.replace("*/", "*\\/"))
+}
+
+fn documented(text: Option<&str>) -> String {
+    text.filter(|text| !text.trim().is_empty())
+        .map(|text| format!("{} ", comment(text)))
+        .unwrap_or_default()
+}
+
+fn union(members: Vec<String>) -> String {
+    if members.is_empty() {
+        "Json".into()
+    } else {
+        members.join(" | ")
+    }
+}
+
+fn named(name: &str, schema: &Value) -> String {
+    match name {
+        "string" | "boolean" | "null" => name.into(),
+        "number" | "integer" => "number".into(),
+        "array" => format!(
+            "Array<{}>",
+            schema.get("items").map_or("Json".into(), ts_type)
+        ),
+        "object" => object(schema),
+        _ => "Json".into(),
+    }
+}
+
+fn object(schema: &Value) -> String {
+    let Some(properties) = schema
+        .get("properties")
+        .and_then(Value::as_object)
+        .filter(|properties| !properties.is_empty())
+    else {
+        let rest = schema
+            .get("additionalProperties")
+            .filter(|extra| extra.is_object())
+            .map_or("Json".into(), ts_type);
+        return format!("Record<string, {rest}>");
+    };
+    let required = schema
+        .get("required")
+        .and_then(Value::as_array)
+        .map(|names| names.iter().filter_map(Value::as_str).collect::<Vec<_>>())
+        .unwrap_or_default();
+    let members = properties.iter().map(|(name, member)| {
+        let optional = if required.contains(&name.as_str()) {
+            ""
+        } else {
+            "?"
+        };
+        format!(
+            "{}{}{optional}: {};",
+            documented(member["description"].as_str()),
+            Value::from(name.as_str()),
+            ts_type(member)
+        )
+    });
+    format!("{{ {} }}", members.collect::<Vec<_>>().join(" "))
+}
+
+pub fn ts_type(schema: &Value) -> String {
+    if let Some(allowed) = schema.get("enum").and_then(Value::as_array) {
+        let literals = allowed
+            .iter()
+            .map(|value| (!value.is_array() && !value.is_object()).then(|| value.to_string()))
+            .collect::<Option<Vec<_>>>();
+        return literals.map_or("Json".into(), union);
+    }
+    if let Some(variants) = schema.get("anyOf").and_then(Value::as_array) {
+        return union(variants.iter().map(ts_type).collect());
+    }
+    match schema.get("type") {
+        Some(Value::String(name)) => named(name, schema),
+        Some(Value::Array(names)) => union(
+            names
+                .iter()
+                .filter_map(Value::as_str)
+                .map(|name| named(name, schema))
+                .collect(),
+        ),
+        _ => "Json".into(),
+    }
+}
+
+pub fn types(inventory: &Value) -> String {
+    let mut output = String::from(
+        "import type { Json } from '@oh-my-diff/mod-api';\n\ndeclare module '@oh-my-diff/mod-api' {\n  interface ToolArguments {\n",
+    );
+    for tool in inventory["tools"].as_array().into_iter().flatten() {
+        let original = &tool["original"];
+        let Some(name) = tool["name"].as_str() else {
+            continue;
+        };
+        let arguments = if original["freeform"] == true {
+            "string".into()
+        } else {
+            ts_type(&original["parameters"])
+        };
+        output.push_str(&format!(
+            "    {}{}: {arguments};\n",
+            documented(original["description"].as_str()),
+            Value::from(name)
+        ));
+    }
+    output.push_str("  }\n}\n");
+    output
+}
+
+fn write_if_changed(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    if std::fs::read(path).is_ok_and(|existing| existing == bytes) {
+        return Ok(());
+    }
+    let temporary = path.with_extension(format!("{}.tmp", std::process::id()));
+    let mut file = std::fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .mode(0o600)
+        .open(&temporary)?;
+    file.write_all(bytes)
+        .and_then(|()| file.sync_all())
+        .and_then(|()| std::fs::rename(&temporary, path))
+        .inspect_err(|_| {
+            let _ = std::fs::remove_file(&temporary);
+        })
+}
+
+pub fn write_inventory(root: &Path, inventory: &Value) -> io::Result<()> {
+    write_if_changed(&root.join(INVENTORY_FILE), &serde_json::to_vec(inventory)?)
+}
+
+pub fn write_types(root: &Path) -> io::Result<()> {
+    let Ok(bytes) = std::fs::read(root.join(INVENTORY_FILE)) else {
+        return Ok(());
+    };
+    let inventory = serde_json::from_slice(&bytes)?;
+    write_if_changed(&root.join(TYPES_FILE), types(&inventory).as_bytes())
+}
+
+pub fn types_path(root: &Path) -> Option<PathBuf> {
+    Some(root.join(TYPES_FILE)).filter(|path| path.exists())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn schema() -> Value {
+        json!({"type": "object", "properties": {
+            "cmd": {"type": "string", "description": "shell */ command"},
+            "mode": {"enum": ["a", "b"]},
+            "paths": {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "number"}]}},
+            "timeout": {"type": ["integer", "null"]}},
+            "required": ["cmd"], "additionalProperties": false})
+    }
+
+    #[test]
+    fn validation_refuses_with_a_pointer_and_reason() {
+        let schema = schema();
+        assert_eq!(
+            validate(&schema, &json!({"cmd": "ls", "timeout": 3})),
+            Ok(())
+        );
+        let refusals = [
+            (json!({}), "/cmd: required"),
+            (json!({"cmd": 1}), "/cmd: expected string, got number"),
+            (
+                json!({"cmd": "x", "timeout": 1.5}),
+                "/timeout: expected one of [\"integer\",\"null\"]",
+            ),
+            (
+                json!({"cmd": "x", "mode": "c"}),
+                "/mode: expected one of [\"a\",\"b\"]",
+            ),
+            (
+                json!({"cmd": "x", "paths": ["a", null]}),
+                "/paths/1: matches no anyOf variant",
+            ),
+            (json!({"cmd": "x", "extra": 1}), "/extra: not allowed"),
+            (json!("x"), "/: expected object, got string"),
+        ];
+        for (arguments, reason) in refusals {
+            assert_eq!(validate(&schema, &arguments), Err(reason.to_owned()));
+        }
+    }
+
+    #[test]
+    fn types_convert_the_schema_subset_and_default_to_json() {
+        let inventory = json!({"tools": [
+            {"name": "run", "original": {"description": "Run */ it", "freeform": false, "parameters": schema()}},
+            {"name": "patch", "original": {"description": "", "freeform": true, "parameters": null}},
+            {"name": "odd", "original": {"description": "", "freeform": false, "parameters": {"$ref": "#/x"}}}]});
+        let output = types(&inventory);
+        assert!(
+            output.contains("\"run\": { /** shell *\\/ command */ \"cmd\": string; \"mode\"?: \"a\" | \"b\"; \"paths\"?: Array<string | number>; \"timeout\"?: number | null; };"),
+            "{output}"
+        );
+        assert!(output.contains("/** Run *\\/ it */ \"run\""));
+        assert!(output.contains("    \"patch\": string;"));
+        assert!(output.contains("    \"odd\": Json;"));
+    }
+}
diff --git a/codex-rs/omd/src/turn_activity.rs b/codex-rs/omd/src/turn_activity.rs
new file mode 100644
index 000000000..f23078b18
--- /dev/null
+++ b/codex-rs/omd/src/turn_activity.rs
@@ -0,0 +1,365 @@
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::fs::{self, OpenOptions};
+use std::io::{self, Read, Seek, SeekFrom, Write};
+use std::path::{Path, PathBuf};
+
+pub const ACTIVITY_READ_BYTES: u64 = 8 << 20;
+pub const ACTIVITY_TOOL_CALLS: usize = 200;
+pub const ACTIVITY_FILES: usize = 500;
+pub const ACTIVITY_PROCESSES: usize = 100;
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(tag = "record", rename_all = "snake_case")]
+pub enum ActivityRecord {
+    TurnStarted {
+        turn_id: String,
+        at: String,
+    },
+    TurnEnded {
+        turn_id: String,
+        at: String,
+        outcome: String,
+        reason: Option<String>,
+        error: Option<Value>,
+    },
+    ToolStarted {
+        turn_id: String,
+        call_id: String,
+        tool: String,
+        at: String,
+    },
+    ToolFinished {
+        turn_id: String,
+        call_id: String,
+        at: String,
+        outcome: String,
+    },
+    ProcessStarted {
+        turn_id: String,
+        id: String,
+        kind: String,
+        command: String,
+        at: String,
+    },
+    ProcessExited {
+        id: String,
+        exit_code: Option<i32>,
+        at: String,
+    },
+    FileChanged {
+        turn_id: String,
+        path: String,
+        before: Option<String>,
+        after: Option<String>,
+        source: String,
+    },
+    ToolOutputReplaced {
+        turn_id: String,
+        call_id: String,
+        r#mod: String,
+        original_sha256: String,
+        replacement_sha256: String,
+    },
+    Paused {
+        at: String,
+    },
+}
+
+pub struct TurnActivityLog {
+    path: PathBuf,
+}
+
+fn valid_thread(thread: &str) -> bool {
+    !thread.is_empty()
+        && thread.len() <= 128
+        && thread
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
+}
+
+impl TurnActivityLog {
+    pub fn open(root: &Path, thread: &str) -> io::Result<Self> {
+        if !valid_thread(thread) {
+            return Err(io::Error::other("turn_activity_thread_invalid"));
+        }
+        Ok(Self {
+            path: root.join(format!("{thread}.jsonl")),
+        })
+    }
+
+    pub fn remove(&self) -> io::Result<()> {
+        match fs::remove_file(&self.path) {
+            Err(error) if error.kind() != io::ErrorKind::NotFound => Err(error),
+            _ => Ok(()),
+        }
+    }
+
+    pub fn append(&self, record: &ActivityRecord) -> io::Result<()> {
+        if let Some(parent) = self.path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        let mut line = serde_json::to_vec(record).map_err(io::Error::other)?;
+        line.push(b'\n');
+        OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&self.path)?
+            .write_all(&line)
+    }
+
+    fn records(&self) -> io::Result<(Vec<ActivityRecord>, bool)> {
+        let mut file = match fs::File::open(&self.path) {
+            Ok(file) => file,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                return Ok((Vec::new(), false));
+            }
+            Err(error) => return Err(error),
+        };
+        let length = file.metadata()?.len();
+        let clipped = length > ACTIVITY_READ_BYTES;
+        if clipped {
+            file.seek(SeekFrom::Start(length - ACTIVITY_READ_BYTES))?;
+        }
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)?;
+        let text = String::from_utf8_lossy(&bytes);
+        let mut lines = text.lines();
+        if clipped {
+            lines.next();
+        }
+        Ok((
+            lines
+                .filter_map(|line| serde_json::from_str(line).ok())
+                .collect(),
+            clipped,
+        ))
+    }
+
+    pub fn read(
+        &self,
+        turn_id: Option<&str>,
+        last: usize,
+        running_turn: Option<&str>,
+        live: &dyn Fn(&str) -> Option<bool>,
+    ) -> io::Result<Value> {
+        let (records, clipped) = self.records()?;
+        let mut order: Vec<String> = Vec::new();
+        let mut turns: BTreeMap<String, Turn> = BTreeMap::new();
+        let mut process_turn: BTreeMap<String, String> = BTreeMap::new();
+        for record in records {
+            match record {
+                ActivityRecord::TurnStarted { turn_id, at } => {
+                    ensure(&mut turns, &mut order, &turn_id).started_at = Some(at);
+                }
+                ActivityRecord::TurnEnded {
+                    turn_id,
+                    at,
+                    outcome,
+                    reason,
+                    error,
+                } => {
+                    let entry = ensure(&mut turns, &mut order, &turn_id);
+                    (entry.ended_at, entry.outcome, entry.reason, entry.error) =
+                        (Some(at), Some(outcome), reason, error);
+                }
+                ActivityRecord::ToolStarted {
+                    turn_id,
+                    call_id,
+                    tool,
+                    at,
+                } => {
+                    ensure(&mut turns, &mut order, &turn_id).tools.push(json!({"call_id": call_id, "tool": tool, "started_at": at, "finished_at": null, "outcome": null}));
+                }
+                ActivityRecord::ToolFinished {
+                    turn_id,
+                    call_id,
+                    at,
+                    outcome,
+                } => {
+                    if let Some(call) = ensure(&mut turns, &mut order, &turn_id)
+                        .tools
+                        .iter_mut()
+                        .rev()
+                        .find(|c| c["call_id"] == call_id.as_str())
+                    {
+                        (call["finished_at"], call["outcome"]) = (json!(at), json!(outcome));
+                    }
+                }
+                ActivityRecord::ProcessStarted {
+                    turn_id,
+                    id: process,
+                    kind,
+                    command,
+                    at: _,
+                } => {
+                    process_turn.insert(process.clone(), turn_id.clone());
+                    ensure(&mut turns, &mut order, &turn_id).processes.push(json!({"id": process, "kind": kind, "command": command, "running": null, "exit_code": null}));
+                }
+                ActivityRecord::ProcessExited {
+                    id: process,
+                    exit_code,
+                    at: _,
+                } => {
+                    if let Some(entry) = process_turn.get(&process).and_then(|t| turns.get_mut(t))
+                        && let Some(slot) = entry
+                            .processes
+                            .iter_mut()
+                            .rev()
+                            .find(|p| p["id"] == process.as_str())
+                    {
+                        (slot["running"], slot["exit_code"]) = (json!(false), json!(exit_code));
+                    }
+                }
+                ActivityRecord::FileChanged {
+                    turn_id,
+                    path,
+                    before,
+                    after,
+                    source,
+                } => {
+                    ensure(&mut turns, &mut order, &turn_id).files.push(
+                        json!({"path": path, "before": before, "after": after, "source": source}),
+                    );
+                }
+                ActivityRecord::ToolOutputReplaced {
+                    turn_id,
+                    call_id,
+                    r#mod,
+                    original_sha256,
+                    replacement_sha256,
+                } => {
+                    if let Some(call) = ensure(&mut turns, &mut order, &turn_id)
+                        .tools
+                        .iter_mut()
+                        .rev()
+                        .find(|c| c["call_id"] == call_id.as_str())
+                    {
+                        call["output_replaced"] = json!({"mod": r#mod,
+                            "original_sha256": original_sha256, "replacement_sha256": replacement_sha256});
+                    }
+                }
+                ActivityRecord::Paused { .. } => {
+                    for entry in turns.values_mut().filter(|t| t.outcome.is_none()) {
+                        entry.paused = true;
+                    }
+                }
+            }
+        }
+        let selected: Vec<&String> = match turn_id {
+            Some(id) => order.iter().filter(|t| t.as_str() == id).collect(),
+            None => order.iter().rev().take(last.max(1)).rev().collect(),
+        };
+        let first = order.first().cloned();
+        let items = selected
+            .into_iter()
+            .map(|id| {
+                let entry = &turns[id];
+                let (outcome, unrecorded_end) = match (&entry.outcome, entry.paused) {
+                    (Some(outcome), _) => (outcome.clone(), false),
+                    (None, _) if running_turn == Some(id.as_str()) => ("running".to_owned(), false),
+                    (None, true) => ("unknown".to_owned(), false),
+                    (None, false) => ("interrupted".to_owned(), true),
+                };
+                let processes: Vec<Value> = entry
+                    .processes
+                    .iter()
+                    .map(|p| {
+                        let mut p = p.clone();
+                        if p["running"].is_null() {
+                            p["running"] = live(p["id"].as_str().unwrap_or_default())
+                                .map_or(Value::Null, Value::Bool);
+                        }
+                        p
+                    })
+                    .collect();
+                let truncated = (clipped && first.as_deref() == Some(id.as_str()))
+                    || entry.tools.len() > ACTIVITY_TOOL_CALLS
+                    || entry.files.len() > ACTIVITY_FILES
+                    || processes.len() > ACTIVITY_PROCESSES;
+                json!({
+                    "turn_id": id,
+                    "started_at": entry.started_at,
+                    "ended_at": entry.ended_at,
+                    "outcome": outcome,
+                    "reason": entry.reason,
+                    "error": entry.error,
+                    "unrecorded_end": unrecorded_end,
+                    "tool_calls": tail(&entry.tools, ACTIVITY_TOOL_CALLS),
+                    "processes": tail(&processes, ACTIVITY_PROCESSES),
+                    "files": tail(&entry.files, ACTIVITY_FILES),
+                    "truncated": truncated,
+                })
+            })
+            .collect();
+        Ok(json!({ "turns": Value::Array(items) }))
+    }
+}
+
+#[derive(Default)]
+struct Turn {
+    started_at: Option<String>,
+    ended_at: Option<String>,
+    outcome: Option<String>,
+    reason: Option<String>,
+    error: Option<Value>,
+    paused: bool,
+    tools: Vec<Value>,
+    processes: Vec<Value>,
+    files: Vec<Value>,
+}
+
+fn ensure<'a>(
+    turns: &'a mut BTreeMap<String, Turn>,
+    order: &mut Vec<String>,
+    id: &str,
+) -> &'a mut Turn {
+    if !turns.contains_key(id) {
+        order.push(id.to_owned());
+    }
+    turns.entry(id.to_owned()).or_default()
+}
+
+fn tail(values: &[Value], limit: usize) -> Value {
+    Value::Array(values[values.len().saturating_sub(limit)..].to_vec())
+}
+
+pub type Reader = std::sync::Arc<dyn Fn(&str, Value) -> Result<Value, String> + Send + Sync>;
+
+static READER: std::sync::Mutex<(u64, Option<Reader>)> = std::sync::Mutex::new((0, None));
+
+fn reader() -> std::sync::MutexGuard<'static, (u64, Option<Reader>)> {
+    READER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+#[must_use]
+pub struct ReaderRegistration(u64);
+
+impl Drop for ReaderRegistration {
+    fn drop(&mut self) {
+        let mut slot = reader();
+        if slot.0 == self.0 {
+            slot.1 = None;
+        }
+    }
+}
+
+/// Lets in-process clients read the ledger through the session host that records it.
+pub fn register_reader(read: Reader) -> ReaderRegistration {
+    let mut slot = reader();
+    slot.0 += 1;
+    slot.1 = Some(read);
+    ReaderRegistration(slot.0)
+}
+
+pub fn read_registered(thread: &str, arguments: Value) -> Result<Value, String> {
+    let read = reader().1.clone().ok_or("turn_activity_unavailable")?;
+    read(thread, arguments)
+}
