+            Some(_) => "unknown",
+            None => "unreported",
+        };
+        json!({"codex_version": codex_version, "install_profile": install_profile, "mode": mode,
+            "mods": {"installed": self.selections.0, "enabled": self.selections.1, "active": self.active().count(),
