+pub(crate) fn footer_hyperlink_lines(width: u16) -> Vec<HyperlinkLine> {
+    let snapshot = snapshot();
+    let style = panel_style(&snapshot.view);
+    let mut lines = if let Some(site) = site(&snapshot.view, "above_composer") {
+        let mut interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        component_rows(&site.components, width, &mut interaction, 0)
+            .into_iter()
+            .map(|row| HyperlinkLine {
+                hyperlinks: row.links,
+                ..HyperlinkLine::new(row.line.patch_style(style))
+            })
+            .collect()
+    } else if let Some(footer) = &snapshot.view.footer {
+        panel_lines(footer)
+            .into_iter()
+            .map(|line| HyperlinkLine::new(line.patch_style(style)))
+            .collect()
+    } else {
+        Vec::new()
+    };
+    lines.extend(
+        live_notices(NoticePlacement::Toast)
+            .into_iter()
+            .map(|notice| {
+                let mut spans = crate::history_cell::notice_spans(notice.kind, &notice.text);
+                spans.push(format!(" ({})", notice.owner).dark_gray());
+                HyperlinkLine::new(Line::from(spans))
+            }),
+    );
+    lines
+}
