+            &reader,
+            "exec.run",
+            json!({"program":"sh","argv":["-c","sleep 5"]})
+        )
+        .unwrap_err(),
+        "exec_cancelled"
+    );
+    assert!(started.elapsed() < std::time::Duration::from_secs(4));
+}
