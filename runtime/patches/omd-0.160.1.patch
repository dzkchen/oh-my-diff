+    let alt = |character| input(KeyEvent::new(KeyCode::Char(character), KeyModifiers::ALT));
+    assert_eq!(focused().as_deref(), Some("query"));
+    assert!(alt('g').is_none());
+    input(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    match alt('g') {
+        Some(ModInput::Binding(name, ModKeyAction::Command { command, .. })) => {
+            assert_eq!((name.as_str(), command.as_str()), ("Alt+g", "fixture:go"));
+        }
+        _ => panic!("a button hotkey runs its action"),
+    }
+    assert!(matches!(
+        alt('m'),
+        Some(ModInput::Binding(_, ModKeyAction::Focus { focus })) if focus == "mode"
+    ));
+    sync_interaction(&snapshot.view);
+    assert_eq!(focused(), None);
