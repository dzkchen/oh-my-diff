+use super::*;
+use pretty_assertions::assert_eq;
+use ratatui::style::Modifier;
+
+fn texts(lines: &[HyperlinkLine]) -> Vec<String> {
+    lines.iter().map(|line| line.line.to_string()).collect()
+}
+
+fn tree(value: Value) -> Vec<ModComponent> {
+    serde_json::from_value(value).unwrap()
+}
+
+#[test]
+fn trees_wrap_restyle_replace_or_hide_the_native_drawing() {
+    let native = || {
+        crate::terminal_hyperlinks::plain_hyperlink_lines(vec![
+            Line::from("• Ran ls"),
+            Line::from("  └ a"),
+        ])
+    };
+    let wrapped = compose_lines(
+        &tree(json!([
+            {"type":"text","id":"tokens","label":"Tokens","text":"12 tokens"},
+            {"type":"box","id":"frame","label":"Frame","title":"Tool","children":[{"type":"native","style":{"bold":true}}]}
+        ])),
+        40,
+        None,
+        native(),
+    );
+    assert_eq!(
+        texts(&wrapped),
+        vec!["12 tokens", "Tool", " • Ran ls", "   └ a"]
+    );
+    assert!(wrapped[2].line.style.add_modifier.contains(Modifier::BOLD));
+    let replaced = compose_lines(
+        &tree(json!([{"type":"text","id":"own","label":"Own","text":"custom row"}])),
+        40,
+        None,
+        native(),
+    );
+    assert_eq!(texts(&replaced), vec!["custom row"]);
+    assert!(compose_lines(&[], 40, None, native()).is_empty());
+}
+
+#[test]
+fn widget_hooks_place_the_native_widget_and_report_its_offset() {
+    let lines = widget_lines(6, 2, |area, cells| {
+        ratatui::widgets::Widget::render(
+            ratatui::widgets::Paragraph::new(vec![Line::from("ab".bold()), Line::from("cd")]),
+            area,
+            cells,
+        );
+    });
+    assert_eq!(texts(&lines), vec!["ab    ", "cd    "]);
+    let wide = widget_lines(4, 1, |area, cells| {
+        ratatui::widgets::Widget::render(ratatui::widgets::Paragraph::new("中a"), area, cells);
+    });
+    assert_eq!(texts(&wide), vec!["中a "]);
+    assert_eq!(
+        native_width(
+            &tree(
+                json!([{"type":"box","id":"frame","label":"Frame","children":[{"type":"native"}]}])
+            ),
+            20
+        ),
+        19
+    );
+    let (mut slot, mut at, mut composed) = (Some(lines), None, Vec::new());
+    compose(
+        &tree(json!([
+            {"type":"text","id":"title","label":"Title","text":"Question"},
+            {"type":"box","id":"frame","label":"Frame","children":[{"type":"native"}]}
+        ])),
+        20,
+        0,
+        None,
+        &mut slot,
+        &mut at,
+        &mut composed,
+    );
+    assert_eq!(at, Some(1));
+    assert_eq!(
+        native_indent(&tree(
+            json!([{"type":"box","id":"frame","label":"Frame","children":[{"type":"native"}]}])
+        )),
+        Some(1)
+    );
+    assert_eq!(texts(&composed)[1], " ab    ");
+}
