+fn process_output_notices_coalesce_per_session_and_keep_exit_order() {
+    let state = State::default();
+    let thread = ThreadId::new();
+    let output = |session: &str, bytes| delivery::Pending::Process {
+        thread,
+        owner: "m".into(),
+        session: session.into(),
+        bytes,
+    };
+    for pending in [
+        output("a", Some(3)),
+        output("a", Some(4)),
