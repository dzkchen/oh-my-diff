+
+fn component_height(components: &[ModComponent], width: u16) -> u16 {
+    components
+        .iter()
+        .map(|component| match component {
+            ModComponent::Box { .. } if !component.fits(width) => 0,
+            ModComponent::Box {
+                title, children, ..
+            } => u16::from(title.is_some()) + component_height(children, width),
+            ModComponent::Dialog { children, .. } => 1 + component_height(children, width),
+            ModComponent::Pane {
+                collapsed,
+                children,
+                ..
+            } => {
+                if *collapsed {
+                    1
+                } else {
+                    1 + component_height(children, width).min(8)
+                }
+            }
+            ModComponent::Line { .. } => 1,
+            ModComponent::Text { text, .. }
+            | ModComponent::Markdown { text, .. }
+            | ModComponent::Code { text, .. } => {
+                u16::try_from(text.lines().count().max(1)).unwrap_or(u16::MAX)
+            }
+            ModComponent::Button { .. }
+            | ModComponent::Input { .. }
+            | ModComponent::Select { .. } => 1,
+            ModComponent::Multiselect { options, .. } => {
+                u16::try_from(options.len() + 1).unwrap_or(u16::MAX)
+            }
+            ModComponent::List { rows, height, .. } => {
+                u16::try_from(rows.len().clamp(1, usize::from(height.unwrap_or(8))))
+                    .unwrap_or(u16::MAX)
+            }
+            ModComponent::Document {
+                id, lines, height, ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                lines.len().max(12),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Diff {
+                id,
+                unified,
+                height,
+                ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                unified.lines().count(),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Image { height, .. } => height.unwrap_or(12),
+            ModComponent::Terminal { height, .. } => height.unwrap_or(16) + 1,
+            ModComponent::Slot | ModComponent::Native { .. } => 0,
+        })
+        .sum()
+}
+
+/// Leaves only dialogs, progress and diagnostics in the inline viewport once a mod hides its sites.
+pub(crate) fn inline_snapshot(mut snapshot: ModViewSnapshot) -> ModViewSnapshot {
+    if snapshot.view.inline_sites.is_some() {
+        snapshot
+            .view
+            .sites
+            .retain(|name, _| name != "sidebar" && name != "header" && !name.contains('/'));
+        snapshot.view.panels.clear();
+        snapshot.view.header = None;
+    }
+    snapshot
+}
+
+pub(crate) fn header_rows(screen: Rect, snapshot: &ModViewSnapshot) -> u16 {
+    if screen.height < 16 {
+        return 0;
+    }
+    if let Some(header) = site(&snapshot.view, "header") {
+        let width = column(screen, snapshot).width;
+        return component_height(&header.components, width).clamp(1, 4) + 1;
+    }
+    match &snapshot.view.header {
+        Some(header) => u16::try_from(header.lines.len()).unwrap_or(3).min(3) + 2,
+        None => 0,
+    }
+}
+
+fn named_sites(view: &ModView) -> impl Iterator<Item = &ModRenderSite> {
+    view.sites
+        .iter()
+        .filter(|(name, _)| name.contains('/'))
+        .map(|(_, site)| site)
+}
+
+fn has_sidebar(snapshot: &ModViewSnapshot) -> bool {
+    site(&snapshot.view, "sidebar").is_some_and(|site| !site.components.is_empty())
+        || named_sites(&snapshot.view).any(|site| !site.components.is_empty())
+        || !sidebar_panels(snapshot).is_empty()
+}
+
+fn sidebar(area: Rect, snapshot: &ModViewSnapshot) -> Option<Rect> {
+    if area.width < 80 || !has_sidebar(snapshot) {
+        return None;
+    }
+    let width = snapshot
+        .view
+        .sidebar_width
+        .clamp(20, 60)
+        .min(area.width / 3);
+    Some(match snapshot.view.sidebar_side {
+        ModSidebarSide::Left => Rect { width, ..area },
+        ModSidebarSide::Right => Rect {
+            x: area.right() - width,
+            width,
+            ..area
+        },
+    })
+}
+
+fn column(area: Rect, snapshot: &ModViewSnapshot) -> Rect {
+    match sidebar(area, snapshot) {
+        Some(bar) if snapshot.view.sidebar_side == ModSidebarSide::Left => Rect {
+            x: bar.right(),
+            width: area.width - bar.width,
+            ..area
+        },
+        Some(bar) => Rect {
+            width: area.width - bar.width,
+            ..area
+        },
+        None => area,
+    }
+}
+
+pub(crate) fn chat_area(area: Rect, snapshot: &ModViewSnapshot, header: u16) -> Rect {
+    let column = column(area, snapshot);
+    let header = header.min(area.height.saturating_sub(1));
+    Rect {
+        y: column.y + header,
+        height: column.height.saturating_sub(header),
+        ..column
+    }
+}
