+#[derive(Default)]
+struct Chain(Mutex<HashMap<PathBuf, Vec<String>>>);
+
+impl HistoryWitness for Chain {
+    fn append(&self, stream: &Path, sha256: &str) -> std::io::Result<()> {
+        self.0
+            .lock()
+            .unwrap()
+            .entry(stream.to_path_buf())
+            .or_default()
+            .push(sha256.to_string());
+        Ok(())
+    }
+
+    fn verify(&self, stream: &Path, sha256s: &[String]) -> std::io::Result<()> {
+        let anchored = self.0.lock().unwrap().get(stream).cloned().unwrap_or_default();
+        if anchored == sha256s {
+            Ok(())
+        } else {
+            Err(std::io::Error::other("chain differs"))
+        }
+    }
+}
