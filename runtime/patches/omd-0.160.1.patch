+    #[allow(clippy::too_many_arguments)]
+    pub fn invoke_with(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
