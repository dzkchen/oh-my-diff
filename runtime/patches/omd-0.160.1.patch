+            serde_json::json!({"settled_task_charge_microusd":7,
+                "retained_exposure_upper_bound_microusd":10,"raw_usage_attempts":2,
+                "observed":[{"model":"a"},{"model":"b"},{"model":"c"}]})
+            .to_string(),
+        )
+        .unwrap();
+        std::fs::write(
