+fn owner_answers_deny_redirect_within_their_own_components_and_clamp_scroll() {
+    let mut snapshot = snapshot(serde_json::json!({"sites":{"sidebar":{"components":[
+        {"type":"input","id":"name","label":"Name","action":{"command":"wizard:name"}},
+        {"type":"input","id":"other","label":"Other","action":{"command":"wizard:other"}},
+        {"type":"input","id":"next","label":"Next","action":{"command":"wizard:next"}},
+        {"type":"input","id":"skip","label":"Skip","action":{"command":"wizard:skip"}},
+        {"type":"input","id":"foreign","label":"Foreign","action":{"command":"intruder:x"}},
+        {"type":"pane","id":"log","label":"Log","children":[]}
+    ]}},"sidebar_width":30}));
+    snapshot.component_owners = ["name", "other", "next", "skip", "log"]
+        .into_iter()
+        .map(|id| (id.to_owned(), "wizard".to_owned()))
+        .chain([("foreign".to_owned(), "intruder".to_owned())])
+        .collect();
+    let area = Rect::new(0, 0, 80, 24);
+    sync_interaction(&snapshot.view);
+    render(area, area, &mut Buffer::empty(area), &snapshot);
+    let state = |focused: &str, scroll: u16| {
+        let mut interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        interaction.focused = Some(focused.to_owned());
+        interaction.scroll.insert("log".to_owned(), scroll);
+        observe(&interaction)
+    };
+    let focus_asks = std::cell::Cell::new(0);
+    let ask = |owner: &str, change: serde_json::Value| {
+        assert_eq!(owner, "wizard");
+        if change["kind"] == "focus" {
+            focus_asks.set(focus_asks.get() + 1);
+        }
+        match (change["kind"].as_str().unwrap(), change["to"].clone()) {
+            ("focus", to) if to == "other" => Err("component_change_denied: finish".to_owned()),
+            ("focus", to) if to == "skip" => Ok(serde_json::json!({"focus": "name"})),
+            ("focus", to) if to == "next" => Ok(serde_json::json!({"focus": "foreign"})),
+            ("focus", to) => Ok(serde_json::json!({"focus": to})),
+            (_, to) => Ok(serde_json::json!({"scroll": to.as_u64().unwrap().min(5)})),
+        }
+    };
+    let moved = |to: &str, scroll: u16| {
+        let before = state("name", 0);
+        let after = state(to, scroll);
+        intercept_changes(&before, &after, ask);
+        let interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        (
+            interaction.focused.clone().unwrap_or_default(),
+            interaction.scroll["log"],
+        )
+    };
+    assert_eq!(moved("other", 0), ("name".to_owned(), 0));
+    assert_eq!(moved("skip", 0), ("name".to_owned(), 0));
+    assert_eq!(moved("next", 0), ("next".to_owned(), 0));
+    assert_eq!(moved("next", 9), ("next".to_owned(), 5));
+    assert_eq!(
+        focus_asks.get(),
+        4,
+        "an owner of both ends is asked once per focus change"
+    );
+    preview(ModViewSnapshot::default());
+}
+
+fn pointer_events(kind: MouseEventKind, column: u16, row: u16) -> (bool, Vec<(String, String)>) {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let top = interaction
+        .layers
+        .iter()
+        .filter(|(area, _)| contains(*area, column, row))
+        .map(|(_, layer)| *layer)
+        .max()
+        .unwrap_or_default();
+    let event = MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    };
+    let (consumed, events) = region_pointer(&mut interaction, event, top);
+    let events = events
+        .iter()
+        .map(|event| {
+            let pointer = &event["pointer"];
+            (
+                event["component"].as_str().unwrap_or_default().to_owned(),
+                format!(
+                    "{} {} {}",
+                    pointer["action"].as_str().unwrap_or_default(),
+                    pointer["column"],
+                    pointer["row"]
+                ),
+            )
+        })
+        .collect();
+    (consumed, events)
+}
+
+fn events(items: &[(&str, &str)]) -> Vec<(String, String)> {
+    items
+        .iter()
+        .map(|(component, event)| ((*component).to_owned(), (*event).to_owned()))
+        .collect()
+}
+
+#[test]
+#[serial_test::serial]
+fn rasters_overlays_and_pointer_regions_share_layers_capture_and_hover() {
+    let mut view = snapshot(
+        serde_json::json!({"sidebar_width": 30, "theme": {"density": "comfortable"}, "sites": {
+            "sidebar": {"components": [
+                {"type":"text","id":"intro","label":"Intro","text":"hello"},
+                {"type":"raster","id":"chart","label":"Chart","alt":"cpu chart","width":6,"height":3,"pointer":true}
+            ]},
+            "demo/tip": {"overlay": {"anchor": {"component": "chart"}, "offset": {"x": 2, "y": 1}, "width": 8, "height": 1, "z": 1},
+                "components": [{"type":"box","id":"tip","label":"Tip","pointer":true,
+                    "children":[{"type":"text","id":"tip_text","label":"Tip text","text":"peak 92%"}]}]}
+        }}),
+    );
+    view.component_owners = [("chart", "demo"), ("tip", "demo")]
+        .into_iter()
+        .map(|(id, owner)| (id.to_owned(), owner.to_owned()))
+        .collect();
+    crate::mod_raster::blit(
+        "demo",
+        Some("demo".into()),
+        Some((6, 3)),
+        &serde_json::json!({"key":"chart","rect":{"x":0,"y":0,"width":6,"height":3},
+            "cells":["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r"]}),
+        std::time::Instant::now(),
+    )
+    .expect("queued");
+    let area = Rect::new(0, 0, 80, 24);
+    let mut buffer = Buffer::empty(area);
+    preview(view.clone());
+    render(area, area, &mut buffer, &view);
+    let chart = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .regions
+        .iter()
+        .find(|region| region.id == "chart")
+        .cloned()
+        .expect("chart region");
+    let (x, y) = (chart.area.x, chart.area.y);
+    assert_eq!(chart.area.height, 3);
+    let line = |row: u16, width: u16| {
+        (0..width)
+            .map(|column| buffer[(x + column, y + row)].symbol())
+            .collect::<String>()
+    };
+    assert_eq!(line(0, 6), "abcdef");
+    assert_eq!(
+        line(1, 10),
+        "gh peak 92",
+        "the overlay draws over the raster"
+    );
+    assert_eq!(line(2, 6), "mnopqr");
+
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (
+            true,
+            events(&[("chart", "enter 1 2"), ("chart", "move 1 2")])
+        )
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 3, y + 1),
+        (
+            true,
+            events(&[
+                ("chart", "leave 3 1"),
+                ("tip", "enter 1 0"),
+                ("tip", "move 1 0")
+            ])
+        ),
+        "the overlay occludes the raster beneath it"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Down(MouseButton::Left), x + 1, y),
+        (
+            true,
+            events(&[
+                ("tip", "leave -1 -1"),
+                ("chart", "enter 1 0"),
+                ("chart", "down 1 0")
+            ])
+        )
+    );
+    let (consumed, dragged) =
+        pointer_events(MouseEventKind::Drag(MouseButton::Left), x + 40, y + 10);
+    assert!(consumed);
+    assert_eq!(
+        dragged,
+        events(&[("chart", "leave 40 10"), ("chart", "drag 40 10")]),
+        "capture keeps drags with the pressed component outside its rect"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Up(MouseButton::Left), x + 40, y + 10),
+        (true, events(&[("chart", "up 40 10")]))
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Drag(MouseButton::Left), x + 1, y),
+        (false, events(&[("chart", "enter 1 0")])),
+        "released capture forwards no drags"
+    );
+    let click = |kind| MouseEvent {
+        kind,
+        column: x + 1,
+        row: y,
+        modifiers: KeyModifiers::NONE,
+    };
+    INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .focused = Some("intro".to_owned());
+    assert!(matches!(
+        pointer(click(MouseEventKind::Down(MouseButton::Left))),
+        Some(ModPointer::Consumed)
+    ));
+    assert_eq!(
+        INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused,
+        None,
+        "pressing a pointer region takes focus from earlier controls"
+    );
+    pointer(click(MouseEventKind::Up(MouseButton::Left)));
+
+    let plain = snapshot(
+        serde_json::json!({"sidebar_width": 30, "sites": {"sidebar": {"components": [
+        {"type":"raster","id":"chart","label":"Chart","alt":"cpu chart","width":6,"height":3}]}}}),
+    );
+    sync_interaction(&plain.view);
+    render(area, area, &mut buffer, &plain);
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, events(&[("chart", "leave 1 2")])),
+        "a vanished region leaves at its last known cells"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, Vec::new()),
+        "views without pointer components add no pointer work"
+    );
+    crate::mod_raster::retain(&BTreeSet::new());
+    preview(ModViewSnapshot::default());
+}
+
+#[test]
+fn overlays_anchor_to_screen_corners_or_components_and_clip() {
+    let screen = Rect::new(0, 0, 40, 10);
+    let anchors = BTreeMap::from([("cell".to_owned(), Rect::new(10, 4, 6, 2))]);
+    let at = |value: serde_json::Value| {
+        let overlay: codex_omd::ModOverlay = serde_json::from_value(value).unwrap();
+        overlay_area(screen, &overlay, &anchors)
+    };
+    assert_eq!(
+        at(serde_json::json!({"anchor":"bottom_right","width":8,"height":2})),
+        Some(Rect::new(32, 8, 8, 2))
+    );
+    assert_eq!(
+        at(serde_json::json!({"anchor":"center","width":10,"height":4})),
+        Some(Rect::new(15, 3, 10, 4))
+    );
+    assert_eq!(
+        at(
+            serde_json::json!({"anchor":{"component":"cell"},"offset":{"x":-12,"y":5},"width":8,"height":3})
+        ),
+        Some(Rect::new(0, 9, 6, 1)),
+        "screen clipping keeps the visible part"
+    );
+    assert_eq!(
+        at(
+            serde_json::json!({"anchor":{"component":"cell"},"offset":{"x":2,"y":1},"width":8,"height":3,"clip":"anchor"})
+        ),
+        Some(Rect::new(12, 5, 4, 1))
+    );
+    assert_eq!(
+        at(serde_json::json!({"anchor":{"component":"gone"},"width":8,"height":3})),
+        None
+    );
+    assert_eq!(
+        at(serde_json::json!({"anchor":"top_left","offset":{"x":50,"y":0},"width":8,"height":3})),
+        None
+    );
+}
