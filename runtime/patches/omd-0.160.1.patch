+
+struct Policed;
+
+impl ResponseObserver for Policed {
+    fn prepare(
+        &self,
+        _request: &mut Request,
+        _body: &mut Option<EncodedJsonBody>,
+    ) -> Result<(), TransportError> {
+        Ok(())
+    }
+
+    fn before_send(
+        &self,
+        _request: &mut Request,
+        _body: Option<&EncodedJsonBody>,
+    ) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError> {
+        Ok(None)
+    }
+
+    fn requires_observation(&self, _thread: Option<&str>) -> bool {
+        false
+    }
+
+    fn policed(&self) -> bool {
+        true
+    }
+}
+
+#[derive(Clone, Default)]
+struct Counting(Arc<AtomicUsize>);
+
+impl HttpTransport for Counting {
+    async fn execute(&self, _req: Request) -> Result<Response, TransportError> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Err(TransportError::Build("sent".into()))
+    }
+
+    async fn stream(&self, _req: Request) -> Result<StreamResponse, TransportError> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Err(TransportError::Build("sent".into()))
+    }
+}
+
+struct NoAuth;
+
+impl AuthProvider for NoAuth {
+    fn add_auth_headers(&self, _headers: &mut HeaderMap) {}
+}
+
+fn provider(base_url: String) -> Provider {
+    Provider {
+        name: "test".into(),
+        base_url,
+        query_params: Some(HashMap::new()),
+        headers: HeaderMap::new(),
+        retry: RetryConfig {
+            max_attempts: 1,
+            base_delay: Duration::from_millis(1),
+            retry_429: false,
+            retry_5xx: false,
+            retry_transport: false,
+        },
+        stream_idle_timeout: Duration::from_secs(5),
+    }
+}
+
+#[tokio::test]
+async fn an_active_final_request_policy_refuses_transports_that_cannot_pass_it() {
+    codex_api::request_observer::install_response_observer(Arc::new(Policed))
+        .expect("observer installs once");
+    let transport = Counting::default();
+    let search = SearchClient::new(
+        transport.clone(),
+        provider("https://example.com/v1".into()),
+        Arc::new(NoAuth),
+    );
+    let request = SearchRequest {
+        id: "search".into(),
+        model: "model".into(),
+        reasoning: None,
+        input: Some(SearchInput::Text("SECRET-1".into())),
+        commands: None,
+        settings: None,
+        max_output_tokens: None,
+    };
+    let error = search
+        .search(&request, HeaderMap::new())
+        .await
+        .expect_err("search is refused");
+    assert!(
+        error
+            .to_string()
+            .contains("request_policy_unsupported_transport"),
+        "{error}"
+    );
+    assert_eq!(transport.0.load(Ordering::SeqCst), 0);
+
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind listener");
+    let address = listener.local_addr().expect("listener address");
+    let realtime = RealtimeWebsocketClient::new(
+        provider(format!("http://{address}")),
+        HttpClientFactory::new(ReqwestDefault),
+    );
+    let refused = realtime
+        .connect(
+            RealtimeSessionConfig {
+                instructions: "SECRET-2".into(),
+                initial_items: Vec::new(),
+                delegation_ack_filler: None,
+                model: Some("realtime-test-model".into()),
+                session_id: Some("conv".into()),
+                event_parser: RealtimeEventParser::V1,
+                session_mode: RealtimeSessionMode::Conversational,
+                output_modality: RealtimeOutputModality::Audio,
+                voice: RealtimeVoice::Cove,
+            },
+            HeaderMap::new(),
+            HeaderMap::new(),
+        )
+        .await;
+    let Err(error) = refused else {
+        panic!("realtime websocket connected");
+    };
+    assert!(
+        error
+            .to_string()
+            .contains("request_policy_unsupported_transport"),
+        "{error}"
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(100), listener.accept())
+            .await
+            .is_err(),
+        "the realtime websocket reached the provider"
+    );
+}
