+                        &json!({"kind": "history", "owner": owner,
+                        "items_before": items.len(), "items_after": history.len()}),
+                    )?;
+                    value["input"] = Value::Array(history);
+                    edited = true;
+                }
+                Ok(None) => {}
+                Err(error) => {
