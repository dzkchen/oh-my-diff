+        bytes.push(0);
+        bytes.extend_from_slice(event.as_bytes());
+        bytes.push(0);
+        bytes.extend_from_slice(script.as_bytes());
+        bytes.push(0);
+        bytes.extend_from_slice(&read(&path.join(script), 65_536)?);
