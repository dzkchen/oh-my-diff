index 000000000..4119b4ed6
--- /dev/null
+++ b/codex-rs/tui/src/mod_backdrop.rs
@@ -0,0 +1,425 @@
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_omd::ModAsciiBackdrop;
+use codex_omd::ModColor;
+use codex_omd::ModImageBackdrop;
+use codex_omd::ModSurfacePaint;
+use image::ImageFormat;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use std::io::Cursor;
+
+pub(crate) const BACKDROP_MIN_COLUMNS: u16 = 60;
+pub(crate) const BACKDROP_IMAGE_PIXELS: u32 = 4096;
+const KITTY_CHUNK: usize = 4096;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct BackdropEnvironment {
+    pub(crate) kitty_graphics: bool,
+    pub(crate) remote: bool,
+    pub(crate) no_color: bool,
+    pub(crate) reduced_motion: bool,
+    pub(crate) columns: u16,
+    pub(crate) owned_viewport: bool,
+}
+
+impl BackdropEnvironment {
+    pub(crate) fn graphics_eligible(self) -> bool {
+        self.owned_viewport
+            && self.kitty_graphics
+            && !self.remote
+            && !self.no_color
+            && !self.reduced_motion
+            && self.columns >= BACKDROP_MIN_COLUMNS
+    }
+}
+
+pub(crate) fn decode_image(bytes: &[u8]) -> Result<image::DynamicImage, String> {
+    if bytes.len() > 8 * 1024 * 1024 {
+        return Err("backdrop_image_too_large".into());
+    }
+    let format = image::guess_format(bytes).map_err(|_| "backdrop_format_unsupported")?;
+    if !matches!(format, ImageFormat::Png | ImageFormat::Jpeg) {
+        return Err("backdrop_format_unsupported".into());
+    }
+    let mut reader = image::ImageReader::with_format(Cursor::new(bytes), format);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(BACKDROP_IMAGE_PIXELS);
+    limits.max_image_height = Some(BACKDROP_IMAGE_PIXELS);
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    reader.limits(limits);
+    reader
+        .decode()
+        .map_err(|_| "backdrop_image_invalid_or_too_large".into())
+}
+
+pub(crate) fn rgb(color: ModColor) -> [u8; 3] {
+    match color {
+        ModColor::Rgb(r, g, b) => [r, g, b],
+        ModColor::Indexed(index) if index >= 232 => [8 + (index - 232) * 10; 3],
+        ModColor::Indexed(index) if index >= 16 => {
+            let levels = [0, 95, 135, 175, 215, 255];
+            let n = index - 16;
+            [
+                levels[usize::from(n / 36)],
+                levels[usize::from(n / 6 % 6)],
+                levels[usize::from(n % 6)],
+            ]
+        }
+        ModColor::Indexed(index) => [
+            [0, 0, 0],
+            [128, 0, 0],
+            [0, 128, 0],
+            [128, 128, 0],
+            [0, 0, 128],
+            [128, 0, 128],
+            [0, 128, 128],
+            [192, 192, 192],
+            [128, 128, 128],
+            [255, 0, 0],
+            [0, 255, 0],
+            [255, 255, 0],
+            [0, 0, 255],
+            [255, 0, 255],
+            [0, 255, 255],
+            [255, 255, 255],
+        ][usize::from(index)],
+    }
+}
+
+pub(crate) fn transformed_png(
+    bytes: &[u8],
+    settings: &ModImageBackdrop,
+    area: Rect,
+    paint: Option<&ModSurfacePaint>,
+) -> Result<Vec<u8>, String> {
+    let decoded = decode_image(bytes)?;
+    let width = (u32::from(area.width) * 8).clamp(1, 2048);
+    let height = (u32::from(area.height) * 16).clamp(1, 2048);
+    let position = settings.position.as_deref().unwrap_or("fit");
+    let scale = settings.scale.unwrap_or(1.0);
+    let fit = (width as f32 / decoded.width() as f32).min(height as f32 / decoded.height() as f32);
+    let fill = (width as f32 / decoded.width() as f32).max(height as f32 / decoded.height() as f32);
+    let factor = match position {
+        "fit" => fit,
+        "fill" => fill,
+        _ => 1.0,
+    } * scale;
+    // Bound the working bitmap, including user enlargement of a large source.
+    let scaled_width = (decoded.width() as f32 * factor).round().clamp(1.0, 8192.0) as u32;
+    let scaled_height = (decoded.height() as f32 * factor)
+        .round()
+        .clamp(1.0, 8192.0) as u32;
+    let source = decoded.to_rgba8();
+    let mut canvas = image::RgbaImage::new(width, height);
+    let offset = settings.offset.as_ref();
+    let left =
+        (i64::from(width) - i64::from(scaled_width)) / 2 + i64::from(offset.map_or(0, |p| p.x)) * 8;
+    let top = (i64::from(height) - i64::from(scaled_height)) / 2
+        + i64::from(offset.map_or(0, |p| p.y)) * 16;
+    let keep = 1.0 - settings.dim.unwrap_or(0.5);
+    let opacity = settings.opacity.unwrap_or(1.0);
+    let tint = settings.tint.map(rgb);
+    for (x, y, pixel) in canvas.enumerate_pixels_mut() {
+        let (sx, sy) = if position == "tile" {
+            (
+                (i64::from(x) - left).rem_euclid(i64::from(scaled_width)),
+                (i64::from(y) - top).rem_euclid(i64::from(scaled_height)),
+            )
+        } else {
+            (i64::from(x) - left, i64::from(y) - top)
+        };
+        if sx < 0 || sy < 0 || sx >= i64::from(scaled_width) || sy >= i64::from(scaled_height) {
+            continue;
+        }
+        let source_x = ((sx as f64 * f64::from(source.width()) / f64::from(scaled_width)) as u32)
+            .min(source.width() - 1);
+        let source_y = ((sy as f64 * f64::from(source.height()) / f64::from(scaled_height)) as u32)
+            .min(source.height() - 1);
+        *pixel = *source.get_pixel(source_x, source_y);
+        for i in 0..3 {
+            let channel = f32::from(pixel.0[i]) * keep;
+            pixel.0[i] =
+                (channel + tint.map_or(0.0, |t| f32::from(t[i]) * (1.0 - keep))).round() as u8;
+        }
+        pixel.0[3] = (f32::from(pixel.0[3]) * opacity).round() as u8;
+        if let Some(paint) = paint {
+            let a = paint.top.or(paint.bottom).map(rgb);
+            let b = paint.bottom.or(paint.top).map(rgb);
+            if let (Some(a), Some(b)) = (a, b) {
+                let gradient = y as f32 / height.saturating_sub(1).max(1) as f32;
+                let alpha = paint.opacity.unwrap_or(1.0);
+                for i in 0..3 {
+                    let overlay = f32::from(a[i]) * (1.0 - gradient) + f32::from(b[i]) * gradient;
+                    pixel.0[i] =
+                        (f32::from(pixel.0[i]) * (1.0 - alpha) + overlay * alpha).round() as u8;
+                }
+            }
+        }
+    }
+    let mut png = Vec::new();
+    image::DynamicImage::ImageRgba8(canvas)
+        .write_to(&mut Cursor::new(&mut png), ImageFormat::Png)
+        .map_err(|e| e.to_string())?;
+    Ok(png)
+}
+
+pub(crate) fn kitty_place_below_text(png: &[u8], columns: u16, rows: u16, image_id: u32) -> String {
+    let payload = STANDARD.encode(png);
+    let chunks: Vec<&[u8]> = payload.as_bytes().chunks(KITTY_CHUNK).collect();
+    let mut command = String::from("\x1b7\x1b[1;1H");
+    for (index, chunk) in chunks.iter().enumerate() {
+        let more = u8::from(index + 1 < chunks.len());
+        let chunk = std::str::from_utf8(chunk).unwrap_or_default();
+        if index == 0 {
+            command.push_str(&format!("\x1b_Ga=T,t=d,f=100,i={image_id},c={columns},r={rows},z=-1,C=1,q=2,m={more};{chunk}\x1b\\"));
+        } else {
+            command.push_str(&format!("\x1b_Gm={more};{chunk}\x1b\\"));
+        }
+    }
+    command.push_str("\x1b8");
+    command
+}
+
+pub(crate) fn kitty_remove(image_id: u32) -> String {
+    format!("\x1b_Ga=d,d=I,i={image_id},q=2;\x1b\\")
+}
+
+#[cfg(test)]
+pub(crate) fn fill_ascii(buffer: &mut Buffer, area: Rect, art: &str) {
+    let settings: ModAsciiBackdrop =
+        serde_json::from_value(serde_json::json!({"text":art, "position":"tile"}))
+            .expect("static ASCII settings");
+    fill_ascii_configured(buffer, area, area, &settings);
+}
+
+pub(crate) fn fill_ascii_configured(
+    buffer: &mut Buffer,
+    area: Rect,
+    clip: Rect,
+    settings: &ModAsciiBackdrop,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let rows: Vec<Vec<char>> = settings
+        .text
+        .lines()
+        .map(|line| line.chars().filter(|c| !c.is_control()).collect())
+        .collect();
+    let art_width = rows.iter().map(Vec::len).max().unwrap_or(0);
+    if rows.is_empty() || art_width == 0 {
+        return;
+    }
+    let position = settings.position.as_deref().unwrap_or("tile");
+    let fit =
+        (f32::from(area.width) / art_width as f32).min(f32::from(area.height) / rows.len() as f32);
+    let fill =
+        (f32::from(area.width) / art_width as f32).max(f32::from(area.height) / rows.len() as f32);
+    let scale = settings.scale.unwrap_or(1.0)
+        * match position {
+            "fit" => fit,
+            "fill" => fill,
+            _ => 1.0,
+        };
+    let width = (art_width as f32 * scale).round().max(1.0) as i32;
+    let height = (rows.len() as f32 * scale).round().max(1.0) as i32;
+    let offset = settings.offset.as_ref();
+    let left = if position == "tile" {
+        0
+    } else {
+        (i32::from(area.width) - width) / 2
+    } + i32::from(offset.map_or(0, |p| p.x));
+    let top = if position == "tile" {
+        0
+    } else {
+        (i32::from(area.height) - height) / 2
+    } + i32::from(offset.map_or(0, |p| p.y));
+    let channels = settings.tint.map(rgb).unwrap_or([128; 3]);
+    let amount = (1.0 - settings.dim.unwrap_or(0.5)) * settings.opacity.unwrap_or(1.0);
+    let channels = channels.map(|c| (f32::from(c) * amount).round() as u8);
+    let style = Style::default()
+        .fg(crate::terminal_palette::best_color((
+            channels[0],
+            channels[1],
+            channels[2],
+        )))
+        .add_modifier(Modifier::DIM);
+    let clip = area.intersection(clip);
+    for y in clip.top()..clip.bottom() {
+        // Native text owns its entire row, including unstyled spaces and indentation.
+        if (area.left()..area.right()).any(|x| {
+            let cell = &buffer[(x, y)];
+            cell.symbol() != " "
+                || cell.bg != Color::Reset
+                || cell.fg != Color::Reset
+                || !cell.modifier.is_empty()
+        }) {
+            continue;
+        }
+        for x in clip.left()..clip.right() {
+            let cell = &mut buffer[(x, y)];
+            let mut sx = i32::from(x - area.x) - left;
+            let mut sy = i32::from(y - area.y) - top;
+            if position == "tile" {
+                sx = sx.rem_euclid(width);
+                sy = sy.rem_euclid(height);
+            }
+            if sx < 0 || sy < 0 || sx >= width || sy >= height {
+                continue;
+            }
+            let row = &rows[((sy as f32 / scale) as usize).min(rows.len() - 1)];
+            let glyph = row
+                .get((sx as f32 / scale) as usize)
+                .copied()
+                .unwrap_or(' ');
+            if glyph != ' ' && unicode_width::UnicodeWidthChar::width(glyph) == Some(1) {
+                cell.set_char(glyph).set_style(style);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn png() -> Vec<u8> {
+        let image = image::RgbaImage::from_pixel(2, 2, image::Rgba([200, 100, 50, 255]));
+        let mut bytes = Vec::new();
+        image
+            .write_to(&mut Cursor::new(&mut bytes), ImageFormat::Png)
+            .unwrap();
+        bytes
+    }
+
+    #[test]
+    fn kitty_placement_is_below_text_and_restores_the_cursor() {
+        let command = kitty_place_below_text(&png(), 80, 24, 7);
+        assert!(
+            command
+                .starts_with("\x1b7\x1b[1;1H\x1b_Ga=T,t=d,f=100,i=7,c=80,r=24,z=-1,C=1,q=2,m=0;")
+        );
+        assert!(command.ends_with("\x1b\\\x1b8"));
+        assert_eq!(kitty_remove(7), "\x1b_Ga=d,d=I,i=7,q=2;\x1b\\");
+    }
+
+    #[test]
+    fn ascii_fills_only_blank_default_rows() {
+        let area = Rect::new(0, 0, 4, 3);
+        let mut buffer = Buffer::empty(area);
+        buffer[(1, 0)].set_char('X');
+        buffer[(2, 1)].set_bg(Color::Blue);
+        fill_ascii(&mut buffer, area, "ab\ncd");
+        let symbols: Vec<String> = (0..3)
+            .map(|y| {
+                (0..4)
+                    .map(|x| buffer[(x, y)].symbol().to_string())
+                    .collect()
+            })
+            .collect();
+        assert_eq!(symbols, [" X  ", "    ", "abab"]);
+        assert!(buffer[(0, 2)].modifier.contains(Modifier::DIM));
+    }
+    #[test]
+    fn transforms_place_tile_tint_and_gloss_without_mutating_source() {
+        let settings = |value| serde_json::from_value::<ModImageBackdrop>(value).unwrap();
+        let reference = serde_json::json!({"reference":"r","sha256":"0".repeat(64)});
+        let area = Rect::new(0, 0, 4, 2);
+        let centered =
+            settings(serde_json::json!({"resource":reference,"position":"center","dim":0}));
+        let image =
+            image::load_from_memory(&transformed_png(&png(), &centered, area, None).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0[3], 0);
+        assert_eq!(image.get_pixel(15, 15).0, [200, 100, 50, 255]);
+        let tile = settings(
+            serde_json::json!({"resource":reference,"position":"tile","dim":0.5,"tint":"#ffffff","opacity":0.5}),
+        );
+        let image = image::load_from_memory(&transformed_png(&png(), &tile, area, None).unwrap())
+            .unwrap()
+            .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0, [228, 178, 153, 128]);
+        let paint = serde_json::from_value::<ModSurfacePaint>(
+            serde_json::json!({"top":"#ffffff","bottom":"#000000","opacity":0.5}),
+        )
+        .unwrap();
+        let gloss =
+            image::load_from_memory(&transformed_png(&png(), &tile, area, Some(&paint)).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert!(gloss.get_pixel(0, 0).0[0] > gloss.get_pixel(0, 31).0[0]);
+        assert_eq!(
+            image::load_from_memory(&png())
+                .unwrap()
+                .to_rgba8()
+                .get_pixel(0, 0)
+                .0,
+            [200, 100, 50, 255]
+        );
+    }
+
+    #[test]
+    fn decoder_rejects_oversized_dimensions_before_pixel_allocation() {
+        let image = image::RgbaImage::new(BACKDROP_IMAGE_PIXELS + 1, 1);
+        let mut bytes = Vec::new();
+        image
+            .write_to(&mut Cursor::new(&mut bytes), ImageFormat::Png)
+            .unwrap();
+        assert!(decode_image(&bytes).is_err());
+        assert!(decode_image(b"GIF89a").is_err());
+        assert!(decode_image(&vec![0; 8 * 1024 * 1024 + 1]).is_err());
+    }
+
+    #[test]
+    fn ascii_positions_scale_and_preserve_styled_rows() {
+        let area = Rect::new(0, 0, 6, 6);
+        let mut buffer = Buffer::empty(area);
+        buffer[(1, 1)].set_char('X');
+        buffer[(2, 2)].set_bg(Color::Blue);
+        let settings = serde_json::from_value(
+            serde_json::json!({"text":"ab\ncd","position":"center","dim":0.2}),
+        )
+        .unwrap();
+        fill_ascii_configured(&mut buffer, area, area, &settings);
+        assert_eq!(buffer[(0, 0)].symbol(), " ");
+        assert_eq!(buffer[(1, 1)].symbol(), "X");
+        assert_eq!(buffer[(2, 1)].symbol(), " ");
+        assert_eq!(buffer[(2, 3)].symbol(), "c");
+        assert_eq!(buffer[(3, 3)].symbol(), "d");
+        assert_eq!(buffer[(2, 2)].symbol(), " ");
+    }
+
+    #[test]
+    fn ascii_clip_preserves_full_area_placement_and_protected_blank_rows() {
+        let area = Rect::new(0, 0, 4, 4);
+        let clip = Rect::new(0, 2, 4, 2);
+        for position in ["tile", "center"] {
+            let mut buffer = Buffer::empty(area);
+            let settings =
+                serde_json::from_value(serde_json::json!({"text":"ab\ncd","position":position}))
+                    .unwrap();
+            fill_ascii_configured(&mut buffer, area, clip, &settings);
+            let rows = (area.top()..area.bottom())
+                .map(|y| {
+                    (area.left()..area.right())
+                        .map(|x| buffer[(x, y)].symbol())
+                        .collect::<String>()
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(
+                rows,
+                if position == "tile" {
+                    ["    ", "    ", "abab", "cdcd"]
+                } else {
+                    ["    ", "    ", " cd ", "    "]
+                }
+            );
+        }
+    }
+}
diff --git a/codex-rs/tui/src/mod_backdrop_sync.rs b/codex-rs/tui/src/mod_backdrop_sync.rs
new file mode 100644
index 000000000..bc5548f51
--- /dev/null
+++ b/codex-rs/tui/src/mod_backdrop_sync.rs
@@ -0,0 +1,161 @@
+use crate::mod_backdrop::BackdropEnvironment;
+use codex_omd::ModBackdrop;
+use codex_omd::ModViewSnapshot;
+use codex_terminal_detection::TerminalName;
+use ratatui::layout::Rect;
+use std::io::Write;
+use std::sync::Mutex;
+
+const IMAGE_ID: u32 = 7_314;
+
+struct Placed {
+    key: Option<(String, Rect)>,
+    decided: Option<(String, Option<Vec<u8>>)>,
+}
+
+static PLACED: Mutex<Placed> = Mutex::new(Placed {
+    key: None,
+    decided: None,
+});
+
+fn placed() -> std::sync::MutexGuard<'static, Placed> {
+    PLACED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+pub(crate) fn image_active() -> bool {
+    placed().key.is_some()
+}
+
+fn environment(columns: u16, animations: bool, owned_viewport: bool) -> BackdropEnvironment {
+    let terminal = codex_terminal_detection::terminal_info();
+    BackdropEnvironment {
+        kitty_graphics: matches!(
+            terminal.name,
+            TerminalName::Kitty | TerminalName::Ghostty | TerminalName::WezTerm
+        ),
+        remote: terminal.multiplexer.is_some()
+            || ["SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY"]
+                .iter()
+                .any(|name| std::env::var_os(name).is_some()),
+        no_color: std::env::var_os("NO_COLOR").is_some(),
+        reduced_motion: !animations,
+        columns,
+        owned_viewport,
+    }
+}
+
+fn load(
+    snapshot: &ModViewSnapshot,
+    reference: &codex_omd::resource_data::ResourceRef,
+) -> Option<Vec<u8>> {
+    let thread = crate::mod_surface::current_thread();
+    snapshot.contributors.iter().find_map(|owner| {
+        let (host, _) = crate::mod_surface::resource_binding(owner, thread.as_deref()).ok()?;
+        let resources = host.resources();
+        let record = resources.load(reference, "evidence").ok()?;
+        resources.blob(record["blob"].as_str()?).ok()
+    })
+}
+
+fn write(sequence: &str) {
+    let mut stdout = std::io::stdout();
+    let _ = stdout.write_all(sequence.as_bytes());
+    let _ = stdout.flush();
+}
+
+fn clear(placed: &mut Placed) {
+    if placed.key.take().is_some() {
+        write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    }
+}
+
+pub(crate) fn sync(snapshot: &ModViewSnapshot, area: Rect, animations: bool, owned_viewport: bool) {
+    let mut placed = placed();
+    let Some(ModBackdrop::Image { image, .. }) = snapshot.view.backdrop.as_ref() else {
+        clear(&mut placed);
+        return;
+    };
+    let environment = environment(area.width, animations, owned_viewport);
+    let paint = image.overlay.as_ref();
+    let key = format!(
+        "{}:{}:{area:?}:{environment:?}:{paint:?}",
+        snapshot.epoch,
+        serde_json::to_string(image).unwrap_or_default()
+    );
+    if placed.key.as_ref() == Some(&(key.clone(), area)) {
+        return;
+    }
+    let png = match placed.decided.as_ref() {
+        Some((decided, png)) if *decided == key => png.clone(),
+        _ => {
+            let png = (environment.graphics_eligible() && !area.is_empty())
+                .then(|| load(snapshot, &image.resource))
+                .flatten()
+                .and_then(|bytes| {
+                    crate::mod_backdrop::transformed_png(&bytes, image, area, paint).ok()
+                });
+            placed.decided = Some((key.clone(), png.clone()));
+            png
+        }
+    };
+    let Some(png) = png.filter(|_| area.width >= crate::mod_backdrop::BACKDROP_MIN_COLUMNS) else {
+        clear(&mut placed);
+        return;
+    };
+    let sequence =
+        crate::mod_backdrop::kitty_place_below_text(&png, area.width, area.height, IMAGE_ID)
+            .replacen(
+                "\x1b[1;1H",
+                &format!("\x1b[{};{}H", area.y + 1, area.x + 1),
+                1,
+            );
+    write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    write(&sequence);
+    placed.key = Some((key, area));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn graphics_eligibility_uses_production_protocol_remote_motion_color_and_ownership() {
+        let local = BackdropEnvironment {
+            kitty_graphics: true,
+            columns: 80,
+            owned_viewport: true,
+            ..Default::default()
+        };
+        assert!(local.graphics_eligible());
+        for fallback in [
+            BackdropEnvironment {
+                kitty_graphics: false,
+                ..local
+            },
+            BackdropEnvironment {
+                remote: true,
+                ..local
+            }, // SSH and multiplexers share the remote gate.
+            BackdropEnvironment {
+                no_color: true,
+                ..local
+            },
+            BackdropEnvironment {
+                reduced_motion: true,
+                ..local
+            },
+            BackdropEnvironment {
+                columns: 40,
+                ..local
+            },
+            BackdropEnvironment {
+                owned_viewport: false,
+                ..local
+            },
+        ] {
+            assert!(!fallback.graphics_eligible(), "{fallback:?}");
+        }
+    }
+}
