+#[tokio::test]
+async fn stale_task_completion_preserves_replacement_turn() {
+    let (session, old_context, receiver) = make_session_and_context_with_rx().await;
+    let mut replacement = old_context
+        .with_model(
+            old_context.model_info().slug.clone(),
+            &session.services.models_manager,
+        )
+        .await;
+    replacement.sub_id = format!("{}-replacement", old_context.sub_id);
+    let replacement = Arc::new(replacement);
+    session
+        .spawn_task(Arc::clone(&replacement), Vec::new(), PendingTask)
+        .await;
+    let replacement_state = Arc::clone(
+        &session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .turn_state,
+    );
+    session.on_task_finished(old_context, Ok(None)).await;
+    {
+        let active = session.active_turn.lock().await;
+        let turn = active
+            .as_ref()
+            .expect("old completion must not clear the replacement");
+        let task = turn
+            .task
+            .as_ref()
+            .expect("old completion must not take the replacement task");
+        assert_eq!(task.turn_context.sub_id, replacement.sub_id);
+        assert!(Arc::ptr_eq(&turn.turn_state, &replacement_state));
+        assert!(!task.cancellation_token.is_cancelled());
+    }
+    while let Ok(event) = receiver.try_recv() {
+        assert!(
+            !matches!(
+                event.msg,
+                codex_protocol::protocol::EventMsg::TurnComplete(_)
+                    | codex_protocol::protocol::EventMsg::TurnAborted(_)
+            ),
+            "stale completion must not publish a terminal event"
+        );
+    }
+    session
+        .abort_all_tasks(codex_protocol::protocol::TurnAbortReason::Interrupted)
+        .await;
+}
