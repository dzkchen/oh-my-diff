+}
+
+fn parse_interactive_listen_url(
+    listen_url: &str,
+) -> Result<codex_app_server::AppServerTransport, String> {
+    if listen_url == "unix://" {
+        return Err(
+            "bare `unix://` is the shared daemon socket; pass `unix://PATH` instead".to_string(),
+        );
+    }
+    match codex_app_server::AppServerTransport::from_listen_url(listen_url)
+        .map_err(|err| err.to_string())?
+    {
+        codex_app_server::AppServerTransport::WebSocket { bind_address }
+            if bind_address.port() == 0 =>
+        {
+            Err("`ws://IP:0` has no fixed address for clients; pass an explicit port".to_string())
+        }
+        transport @ (codex_app_server::AppServerTransport::UnixSocket { .. }
+        | codex_app_server::AppServerTransport::WebSocket { .. }) => Ok(transport),
+        codex_app_server::AppServerTransport::Stdio | codex_app_server::AppServerTransport::Off => {
+            Err("expected `unix://PATH` or `ws://IP:PORT`".to_string())
+        }
+    }
+}
+
+impl InteractiveListenOptions {
+    fn into_listener(
+        self,
+    ) -> anyhow::Result<Option<codex_app_server::in_process::InProcessListener>> {
+        let auth = self.auth.try_into_settings()?;
+        match self.listen {
+            Some(transport) => Ok(Some(codex_app_server::in_process::InProcessListener {
+                transport,
+                auth,
+            })),
+            None if auth != codex_websocket_auth::WebsocketAuthSettings::default() => {
+                anyhow::bail!("websocket auth flags require `--listen`")
+            }
+            None => Ok(None),
+        }
+    }
+}
