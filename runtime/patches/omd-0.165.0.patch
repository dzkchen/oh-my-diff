+            text: "hello".to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let read = rewrite(&mut mcp, &thread.id, None, Vec::new(), false).await?;
+    while timeout(
+        std::time::Duration::from_millis(500),
+        mcp.read_next_message(),
+    )
+    .await
+    .is_ok()
+    {}
+
+    let request = mcp
+        .send_raw_request(
+            "thread/rewrite",
+            Some(
+                json!({"threadId": thread.id, "expectedRevision": read.revision,
+                "edits": [{"op": "delete", "id": "missing-row"}]}),
+            ),
+        )
+        .await?;
+    let error: JSONRPCError = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("history_row_unknown"));
+    let unloaded = timeout(
+        std::time::Duration::from_millis(500),
+        mcp.read_next_message(),
+    )
+    .await;
+    assert!(
+        unloaded.is_err(),
+        "an invalid rewrite must not touch the loaded thread: {unloaded:?}"
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn thread_rewrite_refuses_a_turn_in_progress() -> Result<()> {
+    let home = TempDir::new()?;
+    let server = create_mock_responses_server_sequence(vec![
+        create_final_assistant_message_sse_response("first")?,
