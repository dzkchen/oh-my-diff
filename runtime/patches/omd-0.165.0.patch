+    pub fn refresh_guarded(&mut self, active: &dyn Fn() -> bool) -> Result<bool> {
+        self.reload_guarded(active)
+    }
+
+    pub fn turn_boundary_guarded(&mut self, active: &dyn Fn() -> bool) {
