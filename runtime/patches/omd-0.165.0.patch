+#[test]
+fn background_work_keeps_serving_requests_after_a_panic() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    static PENDING: Mutex<(bool, Option<bool>)> = Mutex::new((false, None));
+    static RAN: AtomicBool = AtomicBool::new(false);
+    let work = |panics: bool| {
+        assert!(!panics, "background work panicked");
+        RAN.store(true, Ordering::SeqCst);
+    };
+    in_background(&PENDING, true, work);
+    wait_until("the panicking request never ran", || {
+        PENDING.locked().1.is_none()
+    });
+    in_background(&PENDING, false, work);
+    wait_until("a request after the panic never ran", || {
+        RAN.load(Ordering::SeqCst)
+    });
+}
