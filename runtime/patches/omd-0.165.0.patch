+    );
+    render(area, area, &mut Buffer::empty(area), &view);
+    assert!(
+        received
+            .recv_timeout(std::time::Duration::from_secs(1))
+            .unwrap()
+            .get("box")
+            .is_some()
+    );
+    let press = MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: chart.area.x + 1,
+        row: chart.area.y,
+        modifiers: KeyModifiers::NONE,
+    };
+    let pressing = std::thread::spawn(move || pointer(press));
+    let mut actions = Vec::new();
+    while actions.len() < 2 {
+        let message = received
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("the press reaches the bound process without locking up the terminal");
+        actions.push(format!(
+            "{} {}",
+            message["pointer"]["action"], message["pointer"]["button"]
+        ));
+    }
+    assert_eq!(actions, ["\"enter\" null", "\"down\" \"left\""]);
+    pressing.join().expect("press handled");
+    assert_eq!(
+        INTERACTION.lock().unwrap().focused.as_deref(),
+        Some("bound_keys"),
+        "the press focuses the process's keys component"
+    );
+    drop(binding);
+    drop(other);
+    crate::mod_raster::retain(&std::collections::BTreeSet::new());
+    preview(ModViewSnapshot::default());
+}
