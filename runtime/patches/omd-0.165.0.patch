+pub(crate) fn contract_documents()
+-> Option<Vec<(codex_omd::ContractDocument, codex_omd::PolicyOwner)>> {
+    with_host(|runtime, _| Some(runtime.contract_documents()))
+}
+
+pub(crate) fn reloaded() -> bool {
+    static SEEN: Mutex<Option<u64>> = Mutex::new(None);
+    let Ok(runtime) = shared_host() else {
+        return false;
+    };
+    let generation = {
+        let mut runtime = runtime.locked();
+        reload(&mut runtime);
+        runtime.generation()
+    };
+    SEEN.locked()
+        .replace(generation)
+        .is_some_and(|seen| seen != generation)
+}
+
+fn reload(runtime: &mut ModHost) {
+    reload_active(runtime, &|| true);
+}
+
+fn reload_active(runtime: &mut ModHost, active: &dyn Fn() -> bool) {
+    static CHECKOUT: Mutex<Option<std::path::PathBuf>> = Mutex::new(None);
+    if let Some(paths) = crate::omd::mod_paths() {
+        let mut checkout = CHECKOUT.locked();
+        if checkout.as_ref() != Some(&paths.repository) {
+            runtime.set_checkout(&paths.repository);
+            *checkout = Some(paths.repository);
+        }
+    }
+    runtime.turn_boundary_guarded(active);
+    if !active() {
+        return;
+    }
+    let owners = runtime
+        .owners()
+        .into_iter()
+        .map(|(id, owner)| (id, owner.sha256))
+        .collect::<std::collections::BTreeMap<_, _>>();
+    let unrestricted = owners
+        .keys()
+        .filter(|id| {
+            runtime
+                .grants(id)
+                .is_some_and(|grants| grants.os_access.is_some())
+        })
+        .cloned()
+        .collect();
+    crate::mod_pty::retain(
+        runtime.generation(),
+        runtime.configuration_sha256(),
+        &owners,
+        &unrestricted,
+    );
+}
+
+fn with_host<T>(run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let runtime = shared_host().ok()?;
+    let mut runtime = runtime.locked();
+    reload(&mut runtime);
+    run(&mut runtime, &paths)
+}
+
+const LOCK_WAIT: std::time::Duration = std::time::Duration::from_millis(100);
+
+fn lock_within<T>(
+    mutex: &Mutex<T>,
+    wait: std::time::Duration,
+) -> Option<std::sync::MutexGuard<'_, T>> {
+    let deadline = std::time::Instant::now() + wait;
+    try_lock_until(mutex, || std::time::Instant::now() < deadline)
+}
+
+fn try_with_host<T>(
+    run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>,
+) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let opened = lock_within(&HOST, LOCK_WAIT)?.clone();
+    let runtime = match opened {
+        Some(runtime) => runtime,
+        None => shared_host().ok()?,
+    };
+    let mut runtime = lock_within(&runtime, LOCK_WAIT)?;
+    reload(&mut runtime);
+    run(&mut runtime, &paths)
+}
+
+/// A mod's source in the terminal's own host, which admits its client-surface calls; `None` while the host is closed or busy.
+pub(crate) fn terminal_source(id: &str) -> Option<String> {
+    let runtime = lock_within(&HOST, LOCK_WAIT)?.clone()?;
+    let grants = lock_within(&runtime, LOCK_WAIT)?.grants(id)?;
+    Some(grants.source_sha256)
+}
+
+/// Mods the terminal's own host has failed; `mod-status.json` belongs to the session's host and never lists them.
+pub(crate) fn terminal_failures() -> BTreeMap<String, String> {
+    (|| {
+        let runtime = lock_within(&HOST, LOCK_WAIT)?.clone()?;
+        let status = lock_within(&runtime, LOCK_WAIT)?.status();
+        Some(
+            status["mods"]
+                .as_array()?
+                .iter()
+                .filter_map(|item| {
+                    Some((
+                        item["id"].as_str()?.to_owned(),
+                        item["error"].as_str()?.to_owned(),
+                    ))
+                })
+                .collect(),
+        )
+    })()
+    .unwrap_or_default()
+}
