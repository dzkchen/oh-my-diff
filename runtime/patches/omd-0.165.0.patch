+    ) -> std::result::Result<S::Ok, S::Error> {
+        match &self.label {
+            Some(label) => {
+                serde_json::json!({"action": self.action, "label": label}).serialize(serializer)
+            }
+            None => self.action.serialize(serializer),
+        }
+    }
+}
