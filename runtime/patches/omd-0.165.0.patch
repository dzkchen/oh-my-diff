+    render(area, area, &mut buffer, &view);
+    let chart = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .regions
+        .iter()
+        .find(|region| region.id == "chart")
+        .cloned()
+        .expect("chart region");
+    let (x, y) = (chart.area.x, chart.area.y);
+    assert_eq!(chart.area.height, 3);
+    let line = |row: u16, width: u16| {
+        (0..width)
+            .map(|column| buffer[(x + column, y + row)].symbol())
+            .collect::<String>()
+    };
+    assert_eq!(line(0, 6), "abcdef");
+    assert_eq!(
+        line(1, 10),
+        "ghpeak 92%",
+        "the overlay draws over the raster"
+    );
+    assert_eq!(line(2, 6), "mnopqr");
+
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (
+            true,
+            events(&[("chart", "enter 1 2"), ("chart", "move 1 2")])
+        )
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 3, y + 1),
+        (
+            true,
+            events(&[
+                ("chart", "leave 3 1"),
+                ("tip", "enter 1 0"),
+                ("tip", "move 1 0")
+            ])
+        ),
+        "the overlay occludes the raster beneath it"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Down(MouseButton::Left), x + 1, y),
+        (
+            true,
+            events(&[
+                ("tip", "leave -1 -1"),
+                ("chart", "enter 1 0"),
+                ("chart", "down 1 0")
+            ])
+        )
+    );
+    let (consumed, dragged) =
+        pointer_events(MouseEventKind::Drag(MouseButton::Left), x + 40, y + 10);
+    assert!(consumed);
+    assert_eq!(
+        dragged,
+        events(&[("chart", "leave 40 10"), ("chart", "drag 40 10")]),
+        "capture keeps drags with the pressed component outside its rect"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Up(MouseButton::Left), x + 40, y + 10),
+        (true, events(&[("chart", "up 40 10")]))
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Drag(MouseButton::Left), x + 1, y),
+        (false, events(&[("chart", "enter 1 0")])),
+        "released capture forwards no drags"
+    );
+    let click = |kind| MouseEvent {
+        kind,
+        column: x + 1,
+        row: y,
+        modifiers: KeyModifiers::NONE,
+    };
+    INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .focused = Some("intro".to_owned());
+    assert!(matches!(
+        pointer(click(MouseEventKind::Down(MouseButton::Left))),
+        Some(ModPointer::Consumed)
+    ));
+    assert_eq!(
+        INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused,
+        None,
+        "pressing a pointer region takes focus from earlier controls"
+    );
+    pointer(click(MouseEventKind::Up(MouseButton::Left)));
+
+    let plain = snapshot(
+        serde_json::json!({"sidebar_width": 30, "sites": {"sidebar": {"components": [
+        {"type":"raster","id":"chart","label":"Chart","alt":"cpu chart","width":6,"height":3}]}}}),
+    );
+    sync_interaction(&plain.view);
+    render(area, area, &mut buffer, &plain);
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, events(&[("chart", "leave 1 2")])),
+        "a vanished region leaves at its last known cells"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, Vec::new()),
+        "views without pointer components add no pointer work"
+    );
+    crate::mod_raster::retain(&BTreeSet::new());
+    preview(ModViewSnapshot::default());
+}
