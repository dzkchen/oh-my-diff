+/// `None` while the runtime is busy or the context moves on, so the render is asked again.
+pub(crate) fn render(input: Value) -> Option<Option<codex_omd::ModChain>> {
+    let _thread = codex_omd::StateThread::enter(crate::mod_surface::current_thread());
+    let Some(runtime) = lock_within(&HOST, LOCK_WAIT)?.clone() else {
+        return Some(None);
+    };
+    match codex_omd::render_shared(&runtime, input, context_unchanged().1) {
+        Err(error)
+            if ["mod_runtime_busy", "callback_cancelled"]
+                .iter()
+                .any(|retry| error.to_string().starts_with(retry)) =>
+        {
+            None
+        }
+        chain => Some(chain.ok()),
+    }
+}
