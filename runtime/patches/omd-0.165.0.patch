+fn frame(width: u32, height: u32, color: [u8; 3]) -> Value {
+    let mut png = Vec::new();
+    image::RgbImage::from_pixel(width, height, image::Rgb(color))
+        .write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png)
+        .expect("png");
+    json!({"media_type": "image/png", "base64": base64::engine::general_purpose::STANDARD.encode(png)})
