+#[tokio::test]
+#[serial_test::serial]
+async fn toggling_from_all_mods_reopens_all_mods() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let package = root.join("package");
+    std::fs::create_dir(&package).unwrap();
+    std::fs::write(package.join("mod.json"), serde_json::to_vec(&serde_json::json!({"schema": 1, "id": "toggle_fixture", "version": "1.0.0", "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": []})).unwrap()).unwrap();
+    std::fs::write(package.join("index.ts"), "export default () => {};").unwrap();
+    let store = ModStore::create(root.join("store")).unwrap();
+    let source = ModStore::inspect_package(&package).unwrap()["sha256"]
+        .as_str()
+        .unwrap()
+        .to_owned();
+    store
+        .trust(package.clone(), &source, Vec::new(), "user")
+        .unwrap();
+    store.enable(&package, true).unwrap();
+    let _environment = crate::omd::tests::omd_environment(&root.join("store"));
+    let (mut chat, _tx, mut rx, _op_rx) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+
+    chat.open_omd_all_mods();
+    chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    let all_mods = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::OmdModToggle { all_mods, .. } => Some(all_mods),
+            _ => None,
+        })
+        .expect("toggle event");
+    chat.finish_omd_mod_toggle(Ok("Mod toggle_fixture disabled.".into()), all_mods);
+    assert_eq!(chat.bottom_pane.active_view_id(), Some("omd-all-mods"));
+}
