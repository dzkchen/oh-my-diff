+                ResourceStore {
+                    root: store.root,
+                    binding: &other
+                }
+                .load(&reference, "evidence")
+                .is_err()
+            );
+        }
+        let record = imported.load(&reference, "evidence").unwrap();
+        fs::write(
+            imported
+                .blob_path(record["blob"].as_str().unwrap())
+                .unwrap(),
+            b"changed",
+        )
