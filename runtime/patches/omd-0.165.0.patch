+    assert!(store.package_quarantine("hostile", "two\nlines").is_err());
+    let blocked = store.package_lock().unwrap();
+    assert!(!blocked.packages["hostile"].enabled);
+    assert!(
+        root.join("hostile/main.ts").exists(),
