+        .await,
+        ("refused", Some("spam".to_owned()))
+    );
+    assert_eq!(
+        peering::receive(
+            &fixture.core,
+            &fixture.lead,
+            "silent",
+            &message("hi", "silent")
+        )
+        .await,
+        ("refused", Some("no_peer_message_handler".to_owned()))
+    );
+}
