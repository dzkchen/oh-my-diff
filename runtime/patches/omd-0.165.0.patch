+        })
+        .await?;
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_request_message(),
+    )
+    .await??;
+    let busy = mcp
+        .send_raw_request(
+            "thread/rewrite",
+            Some(
+                json!({"threadId": thread.id, "expectedRevision": read.revision,
+                "edits": [{"op": "delete", "id": read.rows[0].id}]}),
