+// Hashes presentation content, not the revision, so ordinary terminal events don't invalidate retained transcript layouts.
+fn presentation(snapshot: &ModViewSnapshot) -> u64 {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let view = &snapshot.view;
+    let mut revision = std::collections::hash_map::DefaultHasher::new();
+    serde_json::to_vec(&(
+        &view.theme,
+        &view.surface_styles,
+        &view.session_title_suffix,
+        &view.greeting,
+        view.foreground,
+        view.background,
+    ))
+    .unwrap_or_default()
+    .hash(&mut revision);
+    revision.finish()
+}
