+    {
+        let continuation = (input.continued == 0).then(|| codex_extension_api::TurnContinuation {
+            source: "extension:test".into(),
+            prompt: "verify once more".into(),
+        });
+        Box::pin(std::future::ready(continuation))
+    }
+}
