+/// One frame step of a component module; `None` while the runtime is busy, so the step is asked again.
+pub(crate) fn component(owner: &str, module: &str, frame: Value) -> Option<Result<Value, String>> {
+    let _thread = codex_omd::StateThread::enter(crate::mod_surface::current_thread());
+    let Some(runtime) = lock_within(&HOST, LOCK_WAIT)?.clone() else {
+        return Some(Err("mods are not running".to_owned()));
+    };
+    match codex_omd::component_shared(&runtime, owner, module, frame, context_unchanged().1) {
+        Err(error) if error.to_string().starts_with("callback_cancelled") => None,
+        result => Some(result.map_err(|error| error.to_string())),
+    }
+}
