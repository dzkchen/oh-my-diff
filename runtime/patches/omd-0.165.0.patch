+pub fn surface_available() -> bool {
+    hub().surface.is_some()
+}
+
+fn notify(observed: Observed) {
+    let observers = hub()
+        .observers
+        .iter()
+        .map(|(_, observer)| observer.clone())
+        .collect::<Vec<_>>();
+    for observer in observers {
+        observer(observed.clone());
+    }
+}
+
+fn roster_changed() {
+    notify(Observed::Roster);
+    wake();
+}
