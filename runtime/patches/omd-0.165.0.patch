+impl App {
+    pub(super) fn forward_mod_notification(&self, notification: &ServerNotification) {
+        match notification {
+            ServerNotification::ThreadDeleted(deleted) => {
+                if let Some(store) = crate::omd::store_root() {
+                    let _ = codex_omd::data_store::remove_thread_data(&store, &deleted.thread_id);
+                }
+            }
+            ServerNotification::ServerRequestResolved(resolved) => {
+                if let Ok(request_id) = serde_json::to_value(&resolved.request_id) {
+                    crate::mod_surface::server_request_resolved(request_id);
+                }
+            }
+            _ => {}
+        }
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(notification)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::notification(
+                &method,
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    pub(super) fn forward_mod_server_request(&self, request: &ServerRequest) {
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(request)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::server_request(
+                &method,
+                value.remove("id").unwrap_or(Value::Null),
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    fn mod_shell_command(
+        &self,
+        caller: &str,
+        arguments: &Value,
+        pin: Option<&Pin>,
+    ) -> Result<
+        (
+            std::process::Command,
+            std::path::PathBuf,
+            Option<crate::mod_pty::SessionDir>,
+        ),
+        String,
+    > {
+        let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+        if arguments["sandbox"] == "none" {
+            let access = crate::mod_runtime::os_access(caller).ok_or("capability_denied: os")?;
+            if !arguments["network"].is_null() || !arguments["write"].is_null() {
+                return Err("pty_unrestricted_arguments_invalid".into());
+            }
+            let cwd = paths
+                .repository
+                .join(arguments["cwd"].as_str().unwrap_or("."))
+                .canonicalize()
+                .map_err(|_| "pty_cwd_invalid")?;
+            let mut argv = crate::mod_pty::argv(arguments)?;
+            let program =
+                codex_omd::host::unrestricted_program(&access, &argv[0], &paths.repository)?;
+            let store = paths.store.ok_or("mod store is not configured")?;
+            let pin = pin
+                .filter(|pin| pin.program == program)
+                .ok_or("pty_program_unpinned")?;
+            let hash = codex_omd::host::program_hash(&program)?;
+            if hash != pin.hash || arguments["sha256"].as_str().is_some_and(|sha| sha != hash) {
+                return Err("pty_program_changed".into());
+            }
+            let environment = crate::mod_runtime::exec_environment(caller);
+            let mut command =
+                codex_omd::host::unrestricted_command(&access, &program, &environment)?;
+            let home = std::env::var_os("HOME").ok_or("pty_home_unavailable")?;
+            let dir = crate::mod_pty::prepare(&store, true, arguments, &mut argv)?;
+            command.args(&argv[1..]).current_dir(cwd);
+            return Ok((command, home.into(), dir));
+        }
+        if !arguments["sandbox"].is_null() {
+            return Err("pty_sandbox_invalid".into());
+        }
+        let policy = self.chat_widget.mod_context().policy;
+        let cwd = paths
+            .repository
+            .join(arguments["cwd"].as_str().unwrap_or("."))
+            .canonicalize()
+            .map_err(|_| "pty_cwd_invalid")?;
+        if !cwd.starts_with(&paths.repository) || !cwd.is_dir() {
+            return Err("pty_cwd_invalid".into());
+        }
+        let store = paths.store.clone().ok_or("mod store is not configured")?;
+        let scratch = store.join("pty-scratch");
+        std::fs::create_dir_all(&scratch).map_err(|error| error.to_string())?;
+        let loopback = match arguments["network"].as_str() {
+            None if arguments["network"].is_null() => false,
+            Some("loopback") => true,
+            _ => return Err("pty_network_invalid".into()),
+        };
+        let mut argv = crate::mod_pty::argv(arguments)?;
+        let program = codex_omd::host::resolve_program(&argv[0], &paths.repository)
+            .ok_or("pty_program_unavailable")?;
+        if let Some(expected) = arguments["sha256"].as_str()
+            && codex_omd::host::program_hash(&program)? != expected
+        {
+            return Err("pty_program_changed".into());
+        }
+        argv[0] = program.to_string_lossy().into_owned();
+        let dir = crate::mod_pty::prepare(&store, false, arguments, &mut argv)?;
+        let mut command = crate::mod_runtime::sandboxed_command(
+            &paths,
+            &policy,
+            argv,
+            &scratch,
+            arguments["write"] == true,
+            loopback,
+        )?;
+        command.current_dir(cwd);
+        Ok((command, scratch, dir))
+    }
+
+    pub(super) async fn handle_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+        binding: Option<crate::mod_pty::Binding>,
+    ) {
+        if let Err(error) = crate::mod_surface::validate_call_classified(&call) {
+            call.reply_blit(Err(error));
+            return;
+        }
+        if call.operation == "terminal.pty"
+            && !binding.as_ref().is_some_and(crate::mod_pty::current)
+        {
+            let _ = call.reply.send(Err("pty_context_changed".into()));
+            return;
+        }
+        if call.operation == "routes.add" {
+            match self.plan_route(&call) {
+                Ok((title, prompt, plan)) => self.confirm_mod_surface_call(
+                    call,
+                    Some(title),
+                    prompt,
+                    Some(Confirmed::Route(Box::new(plan))),
+                ),
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+            return;
+        }
+        if call.operation == "routes.write" {
+            let planned = store_paths().and_then(|(store, repository)| {
+                codex_omd::route_writes::plan(&store, &repository, &call.caller, &call.arguments)
+            });
+            match planned {
+                Ok((_, changes)) if changes.is_empty() => {
+                    let _ = call
+                        .reply
+                        .send(Ok(json!({"routes": [], "services": [], "unchanged": true})));
+                }
+                Ok((write, changes)) => {
+                    let title = format!("Let {} change its model routes?", call.caller);
+                    let prompt = format!(
+                        "{}\n\nIt stays in host.json in your mod store until the mod or you change it.",
+                        changes.join("\n")
+                    );
+                    self.confirm_mod_surface_call(
+                        call,
+                        Some(title),
+                        prompt,
+                        Some(Confirmed::RouteWrite(Box::new(write))),
+                    );
+                }
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+            return;
+        }
+        if let Some(binding) = &binding
+            && call.arguments["action"] == "start"
+            && call.arguments["sandbox"] == "none"
+        {
+            let (program, hash, store) =
+                match unrestricted_pty_program(&call.caller, &call.arguments) {
+                    Ok(found) => found,
+                    Err(error) => {
+                        let _ = call.reply.send(Err(error));
+                        return;
+                    }
+                };
+            let previous = codex_omd::program_trust::pinned(&store, &call.caller, &program);
+            let stored = previous.as_deref() == Some(hash.as_str());
+            let (title, prompt) = codex_omd::program_trust::prompt(
+                &call.caller,
+                &program,
+                &hash,
+                previous.as_deref(),
+            );
+            let held = Some(Confirmed::Pty(
+                binding.clone(),
+                Some(Pin {
+                    program,
+                    hash,
+                    stored,
+                }),
+            ));
+            if stored {
+                self.run_mod_surface_call(tui, app_server, call, held).await;
+            } else {
+                self.confirm_mod_surface_call(call, Some(title), prompt, held);
+            }
+            return;
+        }
+        match confirmation(&call) {
+            Ok(Some((title, prompt, held))) => {
+                let held = match binding {
+                    Some(binding) => Some(Confirmed::Pty(binding, None)),
+                    None => held,
+                };
+                self.confirm_mod_surface_call(call, title, prompt, held)
+            }
+            Ok(None) => {
+                let held = binding.map(|binding| Confirmed::Pty(binding, None));
+                self.run_mod_surface_call(tui, app_server, call, held).await
+            }
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
+    fn plan_route(
+        &self,
+        call: &SurfaceCall,
+    ) -> Result<(String, String, codex_omd::plan_routes::PlanRoute), String> {
+        let mod_id = call.arguments["mod"]
+            .as_str()
+            .filter(|id| {
+                crate::mod_runtime::terminal_source(id).is_some() || caller_source(id).is_some()
+            })
+            .ok_or("routes_add_mod_unknown")?;
+        if !self.chat_widget.has_chatgpt_account() || !self.chat_widget.requires_openai_auth {
+            return Err(
+                "routes_add_needs_chatgpt: sign in to Codex with ChatGPT and chat with a model on your plan".into(),
+            );
+        }
+        let model = self.chat_widget.current_model().to_owned();
+        let effort = self
+            .chat_widget
+            .current_reasoning_effort()
+            .map_or_else(|| "medium".to_owned(), |effort| effort.to_string());
+        let context_window = self
+            .chat_widget
+            .status_line_context_window_size()
+            .and_then(|window| u64::try_from(window).ok())
+            .unwrap_or(STANDARD_CONTEXT_WINDOW);
+        Ok((
+            format!("Let {mod_id} run helper models on your ChatGPT plan?"),
+            format!(
+                "Mod {} asks to add the helper model route {} using {model} ({effort}) with your Codex \
+                 sign-in, for this project. It stays until you remove it from host.json in your mod store; its \
+                 requests count against your ChatGPT plan's limits.",
+                call.caller,
+                codex_omd::plan_routes::route_name(&model, mod_id)
+            ),
+            codex_omd::plan_routes::PlanRoute {
+                model,
+                reasoning_effort: effort,
+                context_window,
+                mod_id: mod_id.to_owned(),
+            },
+        ))
+    }
+
+    fn confirm_mod_surface_call(
+        &mut self,
+        call: SurfaceCall,
+        title: Option<String>,
+        prompt: String,
+        held: Option<Confirmed>,
+    ) {
+        let caller = call.caller.clone();
+        let allow = if matches!(held, Some(Confirmed::Pty(_, Some(_))))
+            || call.operation == codex_omd::program_trust::OPERATION
+        {
+            "Allow and remember"
+        } else {
+            "Allow once"
+        };
+        let id = crate::mod_surface::hold(call);
+        if let Some(held) = held {
+            CONFIRMED.locked().insert(id, held);
+        }
+        let item = |name: &str, approved: bool| SelectionItem {
+            name: name.to_owned(),
+            actions: vec![Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed { id, approved });
+                },
+            )],
+            dismiss_on_select: true,
+            ..Default::default()
+        };
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(title.unwrap_or_else(|| format!("Confirm request from mod {caller}"))),
+            subtitle: Some(prompt),
+            items: vec![item(allow, true), item("Decline", false)],
+            view_id: Some(crate::mod_ui::APPROVAL_VIEW_ID),
+            on_cancel: Some(Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed {
+                        id,
+                        approved: false,
+                    });
+                },
+            )),
+            ..SelectionViewParams::picker()
+        });
+    }
+
+    pub(super) async fn handle_mod_surface_confirmed(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        id: u64,
+        approved: bool,
+    ) {
+        let held = CONFIRMED.locked().remove(&id);
+        let Some(call) = crate::mod_surface::release(id) else {
+            return;
+        };
+        if !approved {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return;
+        }
+        self.run_mod_surface_call(tui, app_server, call, held).await;
+    }
+
+    pub(super) fn handle_mod_pty_clipboard(
+        &mut self,
+        tui: &mut tui::Tui,
+        binding: crate::mod_pty::Binding,
+        session: String,
+        text: String,
+        decision: Option<bool>,
+    ) {
+        match crate::mod_pty::clipboard(&binding, &session, decision) {
+            crate::mod_pty::Clipboard::Allowed => {
+                let _ = tui.clipboard.copy(
+                    text.into(),
+                    crate::clipboard_copy::CopyFormat::PlainText,
+                    tui.frame_requester(),
+                );
+            }
+            crate::mod_pty::Clipboard::Ask => {
+                let preview = text.chars().take(200).collect::<String>();
+                let item = |name: &str, allow: bool| {
+                    let (binding, session, text) = (binding.clone(), session.clone(), text.clone());
+                    SelectionItem {
+                        name: name.to_owned(),
+                        actions: vec![Box::new(
+                            move |tx: &crate::app_event_sender::AppEventSender| {
+                                tx.send(AppEvent::ModPtyClipboard {
+                                    binding: binding.clone(),
+                                    session: session.clone(),
+                                    text: text.clone(),
+                                    decision: Some(allow),
+                                });
+                            },
+                        )],
+                        dismiss_on_select: true,
+                        ..Default::default()
+                    }
+                };
+                let declined = (binding.clone(), session.clone());
+                self.chat_widget.show_selection_view(SelectionViewParams {
+                    title: Some(format!(
+                        "Let the terminal of mod {} copy to your clipboard?",
+                        binding.owner()
+                    )),
+                    subtitle: Some(format!(
+                        "The program in pane {session} wants to copy {} bytes:\n{}",
+                        text.len(),
+                        preview.escape_debug()
+                    )),
+                    items: vec![item("Allow for this pane", true), item("Decline", false)],
+                    view_id: Some(crate::mod_ui::APPROVAL_VIEW_ID),
+                    on_cancel: Some(Box::new(
+                        move |tx: &crate::app_event_sender::AppEventSender| {
+                            tx.send(AppEvent::ModPtyClipboard {
+                                binding: declined.0.clone(),
+                                session: declined.1.clone(),
+                                text: String::new(),
+                                decision: Some(false),
+                            });
+                        },
+                    )),
+                    ..SelectionViewParams::picker()
+                });
+            }
+            crate::mod_pty::Clipboard::Asking | crate::mod_pty::Clipboard::Declined => {}
+        }
+    }
