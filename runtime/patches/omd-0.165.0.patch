+            "payload":{"surface":"render","input":input,"original":input,"origin":{"caller":"engine"}}});
+        let error = evaluate_warm(
+            "registration-mutation",
+            &request,
+            None,
+            BUDGET,
+            &|| true,
+            &mut |_| unreachable!(),
+        )
+        .unwrap_err();
+        assert!(
+            error
+                .to_string()
+                .contains("registration_outside_activation"),
+            "{error}"
+        );
+        assert!(
+            !WARM
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|runner| runner.key == "registration-mutation")
+        );
+    }
+    let input = json!({"component":"tool_call"});
+    let request = json!({"source":"export default api => { const spec = {name:'original'}; api.tool(spec, () => {}); api.intercept('render', () => { spec.name = 'changed'; return {}; }); };",
+        "filename":"/fixture/index.ts", "api":crate::MOD_API_VERSION, "capabilities":["terminal","tools"],
+        "surface":{"events":{},"replacements":[],"middleware":[],"intercept":{"render":"terminal"},"state":"store","contracts":"contracts"},
+        "state":null,"settings":{},"event":"intercept","name":"0","interactive":true,"serve":true,"hook_budget_ms":1000,
+        "payload":{"surface":"render","input":input,"original":input,"origin":{"caller":"engine"}}});
+    let reply = evaluate_warm(
+        "registration-input",
+        &request,
+        None,
+        BUDGET,
+        &|| true,
+        &mut |_| unreachable!(),
+    )
+    .unwrap();
+    assert_eq!(reply["registrations"]["tools"][0]["name"], "original");
+    super::invalidate_warm("registration-input");
+    assert!(
+        !WARM
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|runner| runner.key == "registration-input")
+    );
+    let error = evaluate_warm(
+        "cancelled-render",
+        &request,
+        None,
+        BUDGET,
+        &|| false,
+        &mut |_| unreachable!(),
+    )
+    .unwrap_err();
+    assert!(error.to_string().contains("callback_cancelled"));
+    assert!(
+        !WARM
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|runner| runner.key == "cancelled-render")
+    );
+}
+
+#[test]
+fn os_sandbox_denies_host_files_network_and_children() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let secret = temp.path().join("fixture-secret");
+    std::fs::write(&secret, "synthetic secret\n").unwrap();
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port().to_string();
+    let script = r#"
+        exec 2>&1
+        echo started
+        read -r line < "$1" && echo read=allowed
+        printf bad > "$1" && echo write=allowed
+        : 3<>"/dev/tcp/127.0.0.1/$2" && echo network=allowed
+        /usr/bin/true && echo child=allowed
+    "#;
+    let probe = |mut command: std::process::Command| {
+        let result = command
+            .args(["-c", script, "probe"])
+            .arg(&secret)
+            .arg(&port)
+            .stdin(Stdio::null())
+            .output()
+            .unwrap();
+        String::from_utf8_lossy(&result.stdout).into_owned()
+    };
+    let output = probe(sandboxed(Path::new("/bin/bash")).unwrap());
+    let denied = format!("{}: Operation not permitted", secret.display());
+    assert!(output.starts_with("started\n"), "{output}");
+    assert_eq!(output.matches(&denied).count(), 2, "{output}");
+    assert!(
+        output.contains("connect: Operation not permitted"),
+        "{output}"
+    );
+    assert!(output.contains("fork: Operation not permitted"), "{output}");
+    assert!(!output.contains("allowed"), "{output}");
+    assert_eq!(
+        std::fs::read_to_string(&secret).unwrap(),
+        "synthetic secret\n"
+    );
+    assert_eq!(
+        probe(std::process::Command::new("/bin/bash")),
+        "started\nread=allowed\nwrite=allowed\nnetwork=allowed\nchild=allowed\n"
+    );
+}
diff --git a/codex-rs/omd/src/mods/render.rs b/codex-rs/omd/src/mods/render.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f6d50f9bf363611fa0a53af2d52869d7ef4ad9d3
--- /dev/null
+++ b/codex-rs/omd/src/mods/render.rs
@@ -0,0 +1,287 @@
+use super::*;
+use std::os::unix::fs::MetadataExt;
+
+const CACHE_LIMIT: usize = 512;
+const TREE_BYTES: usize = 262_144;
+
+pub const MOD_RENDER_COMPONENTS: &[(&str, &[&str])] = &[
+    ("user_message", &[]),
+    ("assistant_message", &[]),
+    ("tool_call", &[]),
+    ("tool_result", &[]),
+    ("spinner", &["header"]),
+    ("turn_duration", &[]),
+    ("notice", &["text"]),
+    ("session_mode", &["label"]),
+    ("composer_hint", &["placeholder"]),
+    ("question", &[]),
+    ("list", &[]),
+];
+
+pub(super) fn valid_input(original: &Value, input: &Value) -> bool {
+    let alterable = MOD_RENDER_COMPONENTS
+        .iter()
+        .find(|(name, _)| original["component"] == *name)
+        .map_or(&[][..], |(_, props)| *props);
+    let (Some(before), Some(after)) = (original["props"].as_object(), input["props"].as_object())
+    else {
+        return false;
+    };
+    before.len() == after.len()
+        && before.iter().all(|(key, value)| match after.get(key) {
+            Some(changed) if changed != value && alterable.contains(&key.as_str()) => changed
+                .as_str()
+                .is_some_and(|text| value.is_string() && text.len() <= 1024),
+            changed => changed == Some(value),
+        })
+}
+
+pub(super) fn valid_result(result: &Value) -> bool {
+    result.as_object().is_some_and(|object| object.len() == 1)
+        && serde_json::to_vec(result).is_ok_and(|bytes| bytes.len() <= TREE_BYTES)
+        && serde_json::from_value::<Vec<ModComponent>>(result["tree"].clone())
+            .is_ok_and(|tree| view::invalid_render_tree(&tree).is_none())
+}
+
+pub(super) struct Rendered {
+    generation: u64,
+    reads: BTreeMap<String, BTreeSet<String>>,
+    files: String,
+    deps: String,
+    chain: ModChain,
+}
+
+impl ModHost {
+    fn render_deps(&self, reads: &BTreeMap<String, BTreeSet<String>>, files: bool) -> String {
+        let thread = bound_thread();
+        let values = reads
+            .iter()
+            .map(|(id, keys)| {
+                let Some(loaded) = self.loaded.get(id) else {
+                    return Value::Null;
+                };
+                let location = self.state_location(
+                    &loaded.package,
+                    &loaded.selection.scope,
+                    thread.as_deref(),
+                );
+                let selected = if files {
+                    self.store
+                        .state_file(&location)
+                        .and_then(|path| std::fs::metadata(path).ok())
+                        .map_or(Value::Null, |file| {
+                            json!([file.ino(), file.len(), file.mtime(), file.mtime_nsec()])
+                        })
+                } else {
+                    let state = self
+                        .store
+                        .scoped_state(&location, loaded.package.state_version)
+                        .unwrap_or(Value::Null);
+                    if keys.contains("*") {
+                        state
+                    } else {
+                        Value::Array(keys.iter().map(|key| state[key].clone()).collect())
+                    }
+                };
+                json!([
+                    id,
+                    loaded.selection.sha256,
+                    loaded.selection.settings,
+                    thread,
+                    self.ui_binding(id, thread.as_deref()),
+                    selected
+                ])
+            })
+            .collect::<Vec<_>>();
+        digest(Value::Array(values).to_string().as_bytes())
+    }
+}
+
+/// Runs one frame step of a component module without host authority, answering `{tree, post, next_ms}`; an error stops the instance's runner, unmounting it.
+pub fn component_shared(
+    runtime: &Mutex<ModHost>,
+    id: &str,
+    component: &str,
+    frame: Value,
+    active: impl Fn() -> bool,
+) -> Result<Value> {
+    let generation = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?
+        .generation;
+    let instance = frame["instance"].as_str().unwrap_or(component).to_owned();
+    let owner = frame["client"].as_str().unwrap_or_default().to_owned();
+    let value = invoke_shared(
+        runtime,
+        id,
+        generation,
+        "component",
+        component,
+        frame,
+        &active,
+        |_, call| {
+            Err(failure(format!(
+                "host_operation_unavailable: {} is not available to component modules",
+                call.operation
+            )))
+        },
+        |_| {},
+    )?;
+    if let Err(error) = checked_tree(&value) {
+        if active() {
+            process::unmount(&owner, id, &instance);
+        }
+        return Err(error);
+    }
+    Ok(value)
+}
+
+/// A component module step's tree must parse, pass the render checks, stay under 256 KiB and not draw the native component.
+pub(super) fn checked_tree(step: &Value) -> Result<()> {
+    let tree = serde_json::from_value::<Vec<ModComponent>>(step["tree"].clone())
+        .map_err(|error| failure(format!("invalid_component_tree: {error}")))?;
+    if let Some(reason) = view::invalid_render_tree(&tree).or_else(|| {
+        (tree
+            .iter()
+            .any(|node| node.contains(&|node| matches!(node, ModComponent::Native { .. })))
+            || serde_json::to_vec(&step["tree"]).map_or(true, |bytes| bytes.len() > TREE_BYTES))
+        .then(|| "the tree draws the native component or exceeds 256 KiB".to_owned())
+    }) {
+        return Err(failure(format!("invalid_component_tree: {reason}")));
+    }
+    Ok(())
+}
+
+pub fn component_unmount(id: &str, component: &str) {
+    process::unmount("", id, component);
+}
+
+pub fn client_component_unmount(client: &str, id: &str, instance: &str) {
+    process::unmount(client, id, instance);
+}
+
+pub fn component_detach(client: &str) {
+    process::detach(client);
+}
+
+pub fn component_events(payload: &Value) -> Vec<Value> {
+    match payload["kind"].as_str() {
+        Some("input") => payload["events"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(|event| match event.get("paste") {
+                Some(paste) => json!({"kind": "key", "key": null, "text": paste}),
+                None => json!({"kind": "key", "key": event["key"], "text": event["text"]}),
+            })
+            .collect(),
+        Some("key") => vec![json!({"kind": "key", "key": payload["key"], "text": payload["text"]})],
+        Some("pointer") => {
+            let mut pointer = payload["pointer"].clone();
+            if let Some(object) = pointer.as_object_mut() {
+                object.remove("fraction");
+                object.insert("kind".into(), "pointer".into());
+            }
+            vec![pointer]
+        }
+        _ => Vec::new(),
+    }
+}
+
+/// Runs the `render` chain for one component instance; a cached tree stands while the state keys its hooks read hold.
+pub fn render_shared(
+    runtime: &Mutex<ModHost>,
+    input: Value,
+    active: impl Fn() -> bool,
+) -> Result<ModChain> {
+    let key = digest(json!([bound_thread(), input]).to_string().as_bytes());
+    let cached = {
+        let mut runtime = runtime
+            .lock()
+            .map_err(|_| failure("mod_runtime_poisoned"))?;
+        let hit = runtime
+            .rendered
+            .get(&key)
+            .filter(|entry| entry.generation == runtime.generation)
+            .and_then(|entry| {
+                let files = runtime.render_deps(&entry.reads, true);
+                (files == entry.files || runtime.render_deps(&entry.reads, false) == entry.deps)
+                    .then(|| (files, entry.chain.clone()))
+            });
+        hit.map(|(files, chain)| {
+            if let Some(entry) = runtime.rendered.get_mut(&key) {
+                entry.files = files;
+            }
+            chain
+        })
+    };
+    if let Some(chain) = cached {
+        return Ok(chain);
+    }
+    let (generation, hooked, everyone, before) = {
+        let runtime = runtime
+            .lock()
+            .map_err(|_| failure("mod_runtime_poisoned"))?;
+        let everyone = runtime
+            .loaded
+            .keys()
+            .map(|id| (id.clone(), BTreeSet::from(["*".to_owned()])))
+            .collect::<BTreeMap<_, _>>();
+        let before = runtime.render_deps(&everyone, true);
+        (
+            runtime.generation,
+            runtime.may_intercept("render", &input),
+            everyone,
+            before,
+        )
+    };
+    let chain = intercept_shared(
+        runtime,
+        "render",
+        false,
+        input,
+        json!({"caller": "engine"}),
+        active,
+        |_, call| {
+            Err(failure(format!(
+                "host_operation_unavailable: {} is not available while rendering",
+                call.operation
+            )))
+        },
+        |_| Ok(json!({"tree": [{"type": "native"}]})),
+    )?;
+    // Hooks answer even when unmatched, so no answer at all means the runtime was busy.
+    let busy = (hooked && chain.reads.is_empty())
+        || chain.trace.iter().any(|entry| {
+            entry["reason"]
+                .as_str()
+                .is_some_and(|reason| reason.starts_with("mod_runtime_busy"))
+        });
+    if busy {
+        return Err(failure("mod_runtime_busy"));
+    }
+    // A failed hook, or state written while hooks ran, is drawn again instead of being cached.
+    let settled = chain.trace.iter().all(|entry| entry["reason"].is_null());
+    let mut runtime = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?;
+    if settled && runtime.generation == generation && runtime.render_deps(&everyone, true) == before
+    {
+        if runtime.rendered.len() >= CACHE_LIMIT {
+            runtime.rendered.clear();
+        }
+        let files = runtime.render_deps(&chain.reads, true);
+        let deps = runtime.render_deps(&chain.reads, false);
+        runtime.rendered.insert(
+            key,
+            Rendered {
+                generation,
+                reads: chain.reads.clone(),
+                files,
+                deps,
+                chain: chain.clone(),
+            },
+        );
+    }
+    Ok(chain)
+}
diff --git a/codex-rs/omd/src/mods/resources.rs b/codex-rs/omd/src/mods/resources.rs
new file mode 100644
index 0000000000000000000000000000000000000000..606f8350c621351624959680b283650c6509148a
--- /dev/null
+++ b/codex-rs/omd/src/mods/resources.rs
@@ -0,0 +1,336 @@
+use super::*;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModVirtualReader {
+    pub scheme: String,
+    pub version: String,
+}
+
+pub(super) fn validate_registrations(
+    package: &ModPackage,
+    readers: &[ModVirtualReader],
+) -> Result<()> {
+    if readers.len() > 8
+        || !readers.is_empty()
+            && (!package
+                .capabilities
+                .iter()
+                .any(|cap| cap == "virtual_reads")
+                || !package
+                    .compatibility
+                    .required_features
+                    .iter()
+                    .any(|feature| feature == "virtual_reads_v1"))
+    {
+        return Err(failure("virtual_registration_capability_or_version"));
+    }
+    let mut names = BTreeSet::new();
+    for reader in readers {
+        if !scheme(&reader.scheme) || !names.insert(&reader.scheme) || !version(&reader.version) {
+            return Err(failure("invalid_virtual_registration"));
+        }
+    }
+    Ok(())
+}
+
+fn scheme(value: &str) -> bool {
+    (2..=32).contains(&value.len())
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'+' | b'-')
+        })
+        && value.as_bytes()[0].is_ascii_lowercase()
+        && !matches!(
+            value,
+            "file" | "http" | "https" | "ftp" | "data" | "ssh" | "vscode" | "javascript"
+        )
+}
+
+fn version(value: &str) -> bool {
+    value.len() <= 32
+        && value.split('.').count() == 3
+        && value
+            .split('.')
+            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+}
+
+impl ModHost {
+    pub(super) fn resolve_virtual_readers(
+        next: &mut BTreeMap<String, Loaded>,
+        lenient: &dyn Fn(&str) -> bool,
+    ) -> Result<()> {
+        let mut owners: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, loaded)| loaded.error.is_none()) {
+            for reader in &loaded.registrations.virtual_reads {
+                owners
+                    .entry(reader.scheme.clone())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        for (scheme, ids) in owners.into_iter().filter(|(_, ids)| ids.len() > 1) {
+            for id in ids {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(
+                        lenient(&id),
+                        loaded,
+                        failure(format!("virtual_provider_conflict: {scheme}")),
+                    )?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn virtual_readers(&self) -> Vec<(String, ModVirtualReader)> {
+        self.loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_none())
+            .flat_map(|(id, loaded)| {
+                loaded
+                    .registrations
+                    .virtual_reads
+                    .iter()
+                    .cloned()
+                    .map(|reader| (id.clone(), reader))
+            })
+            .collect()
+    }
+
+    pub fn read_virtual(
+        &mut self,
+        arguments: Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    ) -> Result<Value> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Request {
+            uri: String,
+            #[serde(default)]
+            cursor: Option<String>,
+            #[serde(default)]
+            expected_revision: Option<String>,
+            #[serde(default = "limit")]
+            max_bytes: usize,
+        }
+        fn limit() -> usize {
+            16384
+        }
+        let input: Request = serde_json::from_value(arguments.clone())?;
+        if !active() {
+            return Err(failure("virtual_read_cancelled"));
+        }
+        if input.uri.len() > 4096
+            || input.uri.chars().any(char::is_control)
+            || !(1..=16384).contains(&input.max_bytes)
+            || input
+                .cursor
+                .as_ref()
+                .is_some_and(|value| value.len() > 2048)
+            || input
+                .expected_revision
+                .as_ref()
+                .is_some_and(|value| value.is_empty() || value.len() > 256)
+        {
+            return Err(failure("virtual_read_bounds"));
+        }
+        let (namespace, resource) = input
+            .uri
+            .split_once("://")
+            .ok_or_else(|| failure("virtual_uri_required"))?;
+        if !scheme(namespace) || resource.is_empty() {
+            return Err(failure("invalid_virtual_uri"));
+        }
+        let providers: Vec<_> = self
+            .virtual_readers()
+            .into_iter()
+            .filter(|(_, reader)| reader.scheme == namespace)
+            .collect();
+        if providers.len() != 1 {
+            return Err(failure(if providers.is_empty() {
+                "virtual_provider_unavailable"
+            } else {
+                "virtual_provider_conflict"
+            }));
+        }
+        let (owner, reader) = &providers[0];
+        let value = self.invoke_scoped_with(
+            owner,
+            self.generation,
+            "virtual_read",
+            namespace,
+            arguments,
+            &active,
+            |caller, call| {
+                if !matches!(
+                    call.operation.as_str(),
+                    "workspace.read" | "sidecars.invoke"
+                ) {
+                    return Err(failure("virtual_read_authority_denied"));
+                }
+                host(caller, call)
+            },
+        )?;
+        if !active() {
+            return Err(failure("virtual_read_cancelled"));
+        }
+        #[derive(Deserialize, Serialize)]
+        #[serde(deny_unknown_fields)]
+        struct Response {
+            canonical_uri: String,
+            canonical_url: String,
+            identity: String,
+            revision: String,
+            text: String,
+            anchors: Vec<String>,
+            cursor: Option<String>,
+            truncated: bool,
+        }
+        let reply: Response = serde_json::from_value(value)?;
+        if !reply.canonical_uri.starts_with(&format!("{namespace}://"))
+            || !reply.canonical_url.starts_with("https://")
+            || reply.canonical_url[8..]
+                .split('/')
+                .next()
+                .is_none_or(|authority| authority.is_empty() || authority.contains('@'))
+            || reply.canonical_url.len() > 4096
+            || reply.canonical_url.chars().any(char::is_control)
+            || reply.canonical_uri.len() > 4096
+            || reply.canonical_uri.chars().any(char::is_control)
+            || reply.identity.is_empty()
+            || reply.identity.len() > 512
+            || reply.revision.is_empty()
+            || reply.revision.len() > 256
+            || reply.text.len() > input.max_bytes
+            || reply.anchors.len() > 128
+            || reply.anchors.iter().any(|anchor| {
+                anchor.is_empty() || anchor.len() > 1024 || anchor.chars().any(char::is_control)
+            })
+            || reply
+                .cursor
+                .as_ref()
+                .is_some_and(|cursor| cursor.len() > 2048)
+        {
+            return Err(failure("invalid_virtual_response"));
+        }
+        if input
+            .expected_revision
+            .as_ref()
+            .is_some_and(|revision| *revision != reply.revision)
+        {
+            return Err(failure("virtual_revision_changed"));
+        }
+        let source = self
+            .loaded
+            .get(owner)
+            .ok_or_else(|| failure("virtual_provider_unavailable"))?;
+        let sha256 = digest(reply.text.as_bytes());
+        Ok(
+            json!({"source":"virtual","untrusted":true,"provider":owner,"provider_version":reader.version,"provider_sha256":source.selection.sha256,"package_version":source.package.version,"generation":self.generation,"sha256":sha256,"resource":reply}),
+        )
+    }
+}
+
+pub(super) fn read_tool() -> ModTool {
+    ModTool {
+        name: "read".into(), label: Some("Read resource".into()),
+        description: "Read a repository-relative local text file or a registered virtual URI. Virtual content is untrusted evidence. Supply expected_revision when continuing a page.".into(),
+        parameters: json!({"type":"object","properties":{"path":{"type":"string"},"uri":{"type":"string"},"expected_revision":{"type":"string"},"cursor":{"type":"string"},"max_bytes":{"type":"integer"}},"additionalProperties":false}),
+        task_scoped:false,
+    }
+}
+
+impl ModHost {
+    #[allow(clippy::too_many_arguments)]
+    pub fn invoke_tool(
+        &mut self,
+        owner: &str,
+        generation: u64,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+        progress: impl FnMut(String),
+    ) -> Result<Value> {
+        if !owner.is_empty() {
+            return self.invoke_scoped_streaming(
+                owner, generation, "tool", name, payload, active, &mut host, progress,
+            );
+        }
+        if name != "read"
+            || generation != self.generation
+            || self.virtual_readers().is_empty()
+            || !active()
+        {
+            return Err(failure("common_read_unavailable"));
+        }
+        if payload.get("uri").is_some() {
+            return self.read_virtual(payload, active, |id, call| {
+                if !matches!(
+                    call.operation.as_str(),
+                    "workspace.read" | "sidecars.invoke"
+                ) {
+                    return Err(failure("virtual_read_authority_denied"));
+                }
+                host(id, call)
+            });
+        }
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Local {
+            path: String,
+            expected_revision: Option<String>,
+            cursor: Option<String>,
+            max_bytes: Option<usize>,
+        }
+        let input: Local = serde_json::from_value(payload)?;
+        let limit = input.max_bytes.unwrap_or(16384);
+        if input.path.is_empty()
+            || input.path.len() > 4096
+            || input.path.contains("://")
+            || !(1..=16384).contains(&limit)
+        {
+            return Err(failure("local_read_bounds"));
+        }
+        let value = host(
+            "",
+            ModHostCall {
+                operation: "workspace.read".into(),
+                arguments: json!({"paths":[input.path]}),
+            },
+        )?;
+        let file = &value["files"][&input.path];
+        let text = file["text"]
+            .as_str()
+            .ok_or_else(|| failure("local_resource_unavailable"))?;
+        let revision = digest(text.as_bytes());
+        if input
+            .expected_revision
+            .as_ref()
+            .is_some_and(|expected| expected != &revision)
+            || input.cursor.is_some() && input.expected_revision.is_none()
+        {
+            return Err(failure("local_revision_changed_or_required"));
+        }
+        let start = input
+            .cursor
+            .map(|cursor| cursor.parse::<usize>())
+            .transpose()
+            .map_err(failure)?
+            .unwrap_or(0);
+        if start > text.len() || !text.is_char_boundary(start) {
+            return Err(failure("local_cursor_invalid"));
+        }
+        let end = text.floor_char_boundary(start.saturating_add(limit));
+        if start == end && end < text.len() {
+            return Err(failure("local_page_too_small"));
+        }
+        if !active() {
+            return Err(failure("read_cancelled"));
+        }
+        Ok(
+            json!({"source":"local","path":input.path,"revision":revision,"text":&text[start..end],"cursor":(end<text.len()).then(||end.to_string()),"truncated":end<text.len()}),
+        )
+    }
+}
