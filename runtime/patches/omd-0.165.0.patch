+fn activate_target(
+    id: &str,
+    label: &str,
+    target: &ComponentTarget,
+    interaction: &mut Interaction,
+) -> Option<ModInput> {
+    match target {
+        ComponentTarget::Button(action) => Some(ModInput::Interaction(
+            label.to_owned(),
+            component_action(action),
+        )),
+        ComponentTarget::Input(action) => {
+            let value = interaction.input_values.get(id).map(String::as_str);
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                action.with_value(value),
+            ))
+        }
+        ComponentTarget::Select { action, options }
+        | ComponentTarget::ListRow {
+            action, options, ..
+        } => {
+            let selected = *interaction.selected.get(id).unwrap_or(&0);
+            let value = options.get(selected).map(|option| option.0.as_str());
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                action.with_value(value),
+            ))
+        }
+        ComponentTarget::Multiselect {
+            action, options, ..
+        } => {
+            let checked = interaction.checked.get(id);
+            let values = options
+                .iter()
+                .filter(|(value, _)| checked.is_some_and(|checked| checked.contains(value)))
+                .map(|(value, _)| value)
+                .collect::<Vec<_>>();
+            let values = serde_json::to_string(&values).unwrap_or_default();
+            Some(ModInput::Interaction(
+                label.to_owned(),
+                action.with_value(Some(&values)),
+            ))
+        }
+        ComponentTarget::Terminal(_, _, _) => Some(ModInput::Consumed),
+        ComponentTarget::Pane => {
+            let collapsed = interaction.collapsed.entry(id.to_owned()).or_default();
+            *collapsed = !*collapsed;
+            Some(ModInput::Consumed)
+        }
+        ComponentTarget::Document(action) => {
+            let argument =
+                crate::mod_components::handle(id, crate::mod_document::DocumentKey::Activate)
+                    .and_then(|(_, argument)| argument);
+            match (action, argument) {
+                (Some(action), Some(argument)) => Some(ModInput::Interaction(
+                    label.to_owned(),
+                    action.with_value(Some(&argument)),
+                )),
+                _ => Some(ModInput::Consumed),
+            }
+        }
+    }
+}
