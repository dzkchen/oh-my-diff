+        let store = store_fixture(&root);
+        let _omd = omd_environment(&store);
+        assert!(mod_paths().is_some());
+        let _home = EnvGuard::set("HOME", store.to_str());
+        std::fs::write(
+            store.join("mod-status.json"),
+            serde_json::json!({"activation_error":"home","mods":[],"rejected":[]}).to_string(),
+        )
+        .unwrap();
+        assert!(mod_paths().is_none());
+        assert!(!terminal_active());
+        assert!(mod_status().is_some());
+        assert_eq!(
+            compact_status().as_deref(),
+            Some("Oh My Diff · mods off in this directory · run codex in a project")
+        );
+    }
+}
