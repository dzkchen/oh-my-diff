+            "to": {"session": fixture.lead.thread.to_string(), "package": package},
+            "correlation": "c", "data": data, "sent_at_ms": 1})
+    };
+    assert_eq!(
+        peering::receive(
+            &fixture.core,
+            &fixture.lead,
+            "chat",
+            &message("hello", "chat")
+        )
+        .await,
+        ("delivered", None)
+    );
+    let got = fixture
+        .core
+        .runtime
+        .lock()
+        .unwrap()
+        .state("chat")
+        .cloned()
+        .unwrap()["got"]
+        .clone();
+    assert_eq!(got["data"], "HELLO");
+    assert_eq!(got["untrusted"], true);
+    assert_eq!(got["from"]["session"], "other");
+    assert_eq!(
+        peering::receive(
+            &fixture.core,
+            &fixture.lead,
+            "chat",
+            &message("spam", "chat")
