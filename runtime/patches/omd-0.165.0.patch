+        serde_json::json!("a\n<redacted>"),
+        None,
+        "user",
+        |_| unreachable!("a masked value is never written"),
+    );
+    assert!(
+        masked
+            .unwrap_err()
+            .starts_with("app_config_value_redacted: agents.max_depth")
+    );
+    let literal = set_config(&row, serde_json::json!("<redacted>"), None, "user", |_| {
+        unreachable!("this session has no mod paths")
+    });
+    assert!(
+        !literal
+            .unwrap_err()
+            .starts_with("app_config_value_redacted")
+    );
+    let managed = serde_json::json!({"key": "model", "value": "m", "editable": false});
+    let refused = set_config(&managed, serde_json::json!("x"), None, "user", |_| {
+        unreachable!("a managed row is never written")
+    });
+    assert_eq!(refused.unwrap_err(), "config_not_editable: model");
+}
