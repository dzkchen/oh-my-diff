+    assert!(hosted_search(startup_log.requests()[0].body_json()));
+    assert!(!hosted_search(child[0].body_json()));
+    let input = child[0].input();
+    assert!(mentions(&input, "CHILD_TASK") && mentions(&input, "turn one"));
+    assert_eq!(reasoning_summaries(&input), Vec::<String>::new());
+    assert!(
+        startup_log
+            .requests()
+            .iter()
+            .all(|request| request.body_json()["model"] != "spawn-other-model")
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn spawned_base_model_agent_returns_to_the_configured_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let startup = start_mock_server().await;
+    let other = start_mock_server().await;
+    let _provider = runtime_provider("spawn_home", "spawn-home-model", &other);
+    let test = test_codex()
+        .with_config(|config| {
+            for feature in [Feature::Collab, Feature::MultiAgentV2] {
+                config
+                    .features
+                    .enable(feature)
+                    .expect("test config should allow feature update");
+            }
+        })
+        .build(&startup)
+        .await?;
+    let startup_model = test.session_configured.model.clone();
+    let spawn = sse(vec![
+        ev_function_call_with_namespace(
+            "spawn-1",
+            "collaboration",
+            "spawn_agent",
+            &json!({"task_name": "researcher", "message": "CHILD_TASK", "fork_turns": "all",
+                "model": startup_model})
+            .to_string(),
+        ),
+        ev_completed("b1"),
+    ]);
+    let other_log = mount_sse_sequence(&other, vec![spawn, reply("b2", "SPAWNED")]).await;
+    let startup_log = mount_sse_sequence(&startup, vec![reply("a1", "CHILD_DONE")]).await;
+
+    switch(&test, "spawn_home", "spawn-home-model").await?;
+    turn(&test, "spawn a researcher").await?;
+    for _ in 0..200 {
+        if !startup_log.requests().is_empty() {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+
+    let child = startup_log.requests();
+    assert_eq!(child.len(), 1);
+    assert_eq!(child[0].body_json()["model"], startup_model.as_str());
+    assert!(
+        child[0].body_json()["tools"]
+            .to_string()
+            .contains("\"type\":\"web_search\"")
+    );
+    assert!(mentions(&child[0].input(), "CHILD_TASK"));
+    assert!(
+        other_log
+            .requests()
+            .iter()
+            .all(|request| request.body_json()["model"] == "spawn-home-model")
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn a_thread_started_on_a_runtime_provider_keeps_the_configured_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let _provider = runtime_provider("resume_runtime", "resume-runtime-model", &server);
+    let home = tempfile::TempDir::new()?;
+    let config = codex_core::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .harness_overrides(codex_core::config::ConfigOverrides {
+            model_provider: Some("resume_runtime".to_string()),
+            ..Default::default()
+        })
+        .build()
+        .await?;
+    assert_eq!(
+        (
+            config.model_provider_id.as_str(),
+            config.configured_model_provider_id.as_str()
+        ),
+        ("resume_runtime", "openai")
+    );
+    Ok(())
+}
diff --git a/codex-rs/exec/src/omd_surface.rs b/codex-rs/exec/src/omd_surface.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ca00d9d08164ec02b1db52f4bfc513c24a68332e
--- /dev/null
+++ b/codex-rs/exec/src/omd_surface.rs
@@ -0,0 +1,70 @@
+use codex_app_server_client::InProcessAppServerRequestHandle;
+use codex_app_server_protocol::ClientRequest;
+use codex_omd::client_surface::ClientSurface;
+use codex_omd::client_surface::SurfaceCall;
+use serde_json::Value;
+use serde_json::json;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+pub(crate) struct ExecSurface {
+    handle: InProcessAppServerRequestHandle,
+    runtime: tokio::runtime::Handle,
+    next: AtomicU64,
+}
+
+impl ExecSurface {
+    pub(crate) fn new(handle: InProcessAppServerRequestHandle) -> Self {
+        Self {
+            handle,
+            runtime: tokio::runtime::Handle::current(),
+            next: AtomicU64::new(0),
+        }
+    }
+}
+
+pub(crate) fn report_activation_failures() {
+    let Some(root) = std::env::var_os(codex_omd::MOD_STORE_ENV) else {
+        return;
+    };
+    let Some(status) = std::fs::read(std::path::Path::new(&root).join("mod-status.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+    else {
+        return;
+    };
+    #[allow(clippy::print_stderr)]
+    for failure in codex_omd::activation_failures(&status) {
+        eprintln!("Oh My Diff mod failed to activate: {failure}");
+    }
+}
+
+impl ClientSurface for ExecSurface {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        if call.operation != "app.request" {
+            return Err(format!(
+                "client_surface_operation_unavailable: {} needs an interactive terminal",
+                call.operation
+            ));
+        }
+        if call.confirm.is_some() {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return Ok(());
+        }
+        let id = self.next.fetch_add(1, Ordering::Relaxed) + 1;
+        let request = json!({"method": call.arguments["method"], "id": format!("omd-{id}"),
+            "params": call.arguments["params"]});
+        let request = serde_json::from_value::<ClientRequest>(request)
+            .map_err(|error| format!("app_params_invalid: {error}"))?;
+        let handle = self.handle.clone();
+        let reply = call.reply;
+        self.runtime.spawn(async move {
+            let result = handle
+                .request_typed::<Value>(request)
+                .await
+                .map_err(|error| error.to_string());
+            let _ = reply.send(result);
+        });
+        Ok(())
+    }
+}
