+fn managed_sync_refuses_tampered_unavailable_or_scripted_content_and_keeps_the_generation() {
+    let admin = Admin::new();
+    let (guard, guard_sha) = admin.package("guard", "guard", GUARD, &["interception"]);
+    let (scripted, scripted_sha) = admin.versioned(
+        "scripted",
+        "scripted",
+        "1.0.0",
