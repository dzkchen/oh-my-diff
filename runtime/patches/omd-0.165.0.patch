@@ -0,0 +1,343 @@
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeSet;
+use std::fs;
+use std::io;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+
+pub const PAGE_BYTES: usize = 65_536;
+pub const SNAPSHOT_BYTES: usize = 262_144;
+
+pub fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+pub fn token(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+}
+
+pub fn redact(text: &str) -> String {
+    let mut private_key = false;
+    text.split_inclusive('\n')
+        .map(|segment| {
+            let line = segment.strip_suffix('\n').unwrap_or(segment);
+            let line = line.strip_suffix('\r').unwrap_or(line);
+            let lower = line.to_ascii_lowercase();
+            let begins_key = lower.contains("-----begin") && lower.contains("private key-----");
+            let ends_key = lower.contains("-----end") && lower.contains("private key-----");
+            private_key |= begins_key;
+            let sensitive = private_key
+                || [
+                    "authorization:",
+                    "authorization=",
+                    "bearer ",
+                    "api_key",
+                    "api-key",
+                    "apikey",
+                    "access_token",
+                    "refresh_token",
+                    "client_secret",
+                    "password=",
+                    "password:",
+                    "password\":",
+                    "secret=",
+                    "secret:",
+                ]
+                .iter()
+                .any(|needle| lower.contains(needle))
+                || ["sk-", "ghp_", "gho_", "github_pat_", "xoxb-", "xoxp-"]
+                    .iter()
+                    .any(|prefix| {
+                        lower.match_indices(prefix).any(|(offset, _)| {
+                            offset == 0 || !lower.as_bytes()[offset - 1].is_ascii_alphanumeric()
+                        })
+                    })
+                || assigns_secret(line)
+                || line.match_indices("AKIA").any(|(offset, _)| {
+                    (offset == 0 || !line.as_bytes()[offset - 1].is_ascii_alphanumeric())
+                        && line.as_bytes()[offset + 4..]
+                            .iter()
+                            .take_while(|byte| byte.is_ascii_uppercase() || byte.is_ascii_digit())
+                            .count()
+                            >= 16
+                })
+                || line.match_indices("://").any(|(offset, _)| {
+                    let authority = line[offset + 3..]
+                        .split(|c: char| c == '/' || c.is_whitespace() || c == '"' || c == '\'')
+                        .next()
+                        .unwrap_or_default();
+                    authority
+                        .find('@')
+                        .is_some_and(|at| authority[..at].contains(':'))
+                });
+            if ends_key {
+                private_key = false;
+            }
+            if sensitive {
+                format!("[redacted]{}", &segment[line.len()..])
+            } else {
+                segment.to_owned()
+            }
+        })
+        .collect()
+}
+
+/// `NAME=value`, `NAME: value` or `"name": value` where a segment of the name reads as a secret.
+fn assigns_secret(line: &str) -> bool {
+    line.match_indices(['=', ':']).any(|(offset, _)| {
+        let before = line[..offset].trim_end().trim_end_matches(['"', '\'']);
+        let start = before.len()
+            - before
+                .bytes()
+                .rev()
+                .take_while(|byte| byte.is_ascii_alphanumeric() || b"_-.".contains(byte))
+                .count();
+        let value = line[offset + 1..]
+            .trim_start()
+            .trim_start_matches(['"', '\'', '=']);
+        !value.is_empty() && secret_name(&before[start..])
+    })
+}
+
+/// Whether a `_`, `-`, `.` or camelCase segment of a field or variable name reads as a secret.
+pub fn secret_name(name: &str) -> bool {
+    let mut segments = vec![String::new()];
+    let mut previous_lower = false;
+    for character in name.chars() {
+        if matches!(character, '_' | '-' | '.')
+            || (previous_lower && character.is_ascii_uppercase())
+        {
+            segments.push(String::new());
+        }
+        previous_lower = character.is_ascii_lowercase() || character.is_ascii_digit();
+        if !matches!(character, '_' | '-' | '.') {
+            segments
+                .last_mut()
+                .expect("segments start non-empty")
+                .push(character.to_ascii_lowercase());
+        }
+    }
+    segments.iter().enumerate().any(|(index, segment)| {
+        [
+            "token",
+            "secret",
+            "password",
+            "passwd",
+            "apikey",
+            "authorization",
+        ]
+        .iter()
+        .any(|word| segment.ends_with(word))
+            || segment == "pwd"
+            || segment.starts_with("credential")
+            || (segment == "key"
+                && index > 0
+                && [
+                    "api", "access", "private", "secret", "signing", "client", "master",
+                ]
+                .contains(&segments[index - 1].as_str()))
+    })
+}
+
+pub fn contains_secret(text: &str) -> bool {
+    redact(text).lines().any(|line| line == "[redacted]")
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ResourceBinding {
+    pub repository: String,
+    pub owner: String,
+    pub thread: String,
+    pub generation: u64,
+    pub source_sha256: String,
+}
+
+impl ResourceBinding {
+    pub fn validate(&self) -> io::Result<()> {
+        if self.source_sha256.len() != 64
+            || !self
+                .source_sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+            || self.repository.len() != 64
+            || !self.repository.bytes().all(|byte| byte.is_ascii_hexdigit())
+            || !token(&self.owner)
+            || !token(&self.thread)
+        {
+            return Err(io::Error::other("resource_binding_invalid"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ResourceRef {
+    pub reference: String,
+    pub sha256: String,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct StoredResource {
+    binding: ResourceBinding,
+    kind: String,
+    payload: Value,
+}
+
+pub struct ResourceStore<'a> {
+    pub root: &'a Path,
+    pub binding: &'a ResourceBinding,
+}
+
+impl ResourceStore<'_> {
+    pub(crate) fn directory(&self) -> io::Result<PathBuf> {
+        self.binding.validate()?;
+        if self.root.canonicalize()? != self.root || !fs::symlink_metadata(self.root)?.is_dir() {
+            return Err(io::Error::other("resource_root_invalid"));
+        }
+        let path = crate::workspace::private_path(
+            self.root,
+            &["resources", &self.binding.repository, &self.binding.owner],
+            "resource_directory_invalid",
+        )?;
+        if path.canonicalize()? != path {
+            return Err(io::Error::other("resource_directory_invalid"));
+        }
+        Ok(path)
+    }
+
+    pub fn save(&self, kind: &str, payload: Value) -> io::Result<ResourceRef> {
+        if !token(kind) {
+            return Err(io::Error::other("resource_kind_invalid"));
+        }
+        let value = StoredResource {
+            binding: self.binding.clone(),
+            kind: kind.to_owned(),
+            payload,
+        };
+        let bytes = serde_json::to_vec(&value)?;
+        if bytes.len() > SNAPSHOT_BYTES {
+            return Err(io::Error::other("resource_snapshot_limit"));
+        }
+        let sha256 = hash(&bytes);
+        let name = format!("{sha256}.json");
+        let directory = self.directory()?;
+        let path = directory.join(&name);
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(directory.join(".resources.lock"))?;
+        lock.try_lock()
+            .map_err(|_| io::Error::other("resource_store_busy"))?;
+        if !path.try_exists()? {
+            let mut total = 0u64;
+            let mut entries = 0;
+            for entry in fs::read_dir(&directory)?.take(1025) {
+                let entry = entry?;
+                entries += 1;
+                if entry.file_type()?.is_symlink() {
+                    return Err(io::Error::other("resource_directory_invalid"));
+                }
+                if entry
+                    .path()
+                    .extension()
+                    .is_some_and(|extension| extension == "json")
+                {
+                    total = total.saturating_add(entry.metadata()?.len());
+                }
+            }
+            if entries >= 1024 || total.saturating_add(bytes.len() as u64) > 64 * 1024 * 1024 {
+                return Err(io::Error::other("resource_store_quota"));
+            }
+        }
+        crate::fsio::write_if_changed(&path, &bytes)?;
+        Ok(ResourceRef {
+            reference: sha256.clone(),
+            sha256,
+        })
+    }
+
+    pub(crate) fn record(&self, kind: &str, payload: Value) -> io::Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&StoredResource {
+            binding: self.binding.clone(),
+            kind: kind.to_owned(),
+            payload,
+        })?)
+    }
+
+    pub fn load(&self, reference: &ResourceRef, kind: &str) -> io::Result<Value> {
+        if reference.reference != reference.sha256
+            || reference.sha256.len() != 64
+            || !reference
+                .sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+        {
+            return Err(io::Error::other("resource_reference_invalid"));
+        }
+        let name = format!("{}.json", reference.reference);
+        let mut directory = self.directory()?;
+        if !directory.join(&name).try_exists()? {
+            directory = self.rotating_directory()?;
+        }
+        let snapshot =
+            crate::Snapshot::capture(&directory, &BTreeSet::from([name.clone()]), SNAPSHOT_BYTES)?;
+        let bytes = &snapshot
+            .files
+            .get(&name)
+            .ok_or_else(|| io::Error::other("resource_unavailable"))?
+            .bytes;
+        if hash(bytes) != reference.sha256 {
+            return Err(io::Error::other("resource_integrity_failed"));
+        }
+        let value: StoredResource = serde_json::from_slice(bytes)?;
+        let package_asset = value.binding.thread == "package"
+            && value.binding.generation == 0
+            && value.binding.repository == self.binding.repository
+            && value.binding.owner == self.binding.owner
+            && value.binding.source_sha256 == self.binding.source_sha256;
+        if (value.binding != *self.binding && !package_asset) || value.kind != kind {
+            return Err(io::Error::other("resource_scope_mismatch"));
+        }
+        Ok(value.payload)
+    }
+
+    pub fn page(
+        &self,
+        reference: &ResourceRef,
+        kind: &str,
+        cursor: usize,
+        max_bytes: usize,
+    ) -> io::Result<Value> {
+        if !(1..=PAGE_BYTES).contains(&max_bytes) {
+            return Err(io::Error::other("resource_page_limit"));
+        }
+        let loaded = self.load(reference, kind)?;
+        let payload = match self.blob_text(&loaded)? {
+            Some(text) => text,
+            None => serde_json::to_string(&loaded)?,
+        };
+        if cursor > payload.len() || !payload.is_char_boundary(cursor) {
+            return Err(io::Error::other("resource_cursor_invalid"));
+        }
+        let end = payload.floor_char_boundary(cursor.saturating_add(max_bytes));
+        if end == cursor && end < payload.len() {
+            return Err(io::Error::other("resource_page_too_small"));
+        }
+        Ok(
+            json!({"reference":reference,"text":&payload[cursor..end],"cursor":(end<payload.len()).then_some(end),"bytes":payload.len()}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/route_writes.rs b/codex-rs/omd/src/route_writes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..30b4f0637ed2b4a9c34d2ec720125e062a9077b6
--- /dev/null
+++ b/codex-rs/omd/src/route_writes.rs
@@ -0,0 +1,332 @@
+use serde_json::Value;
+use serde_json::json;
+use std::path::Path;
+use std::sync::OnceLock;
+
+const HOST_CONFIG_BYTES: usize = 262_144;
+
+pub type HostCheck = fn(&Path, &Value) -> Result<(), String>;
+
+static HOST_CHECK: OnceLock<HostCheck> = OnceLock::new();
+
+/// The session host validates a whole `host.json` the way it loads one.
+pub fn set_host_check(check: HostCheck) {
+    let _ = HOST_CHECK.set(check);
+}
+
+pub struct RouteWrite {
+    caller: String,
+    routes: Vec<Value>,
+    services: Option<Vec<Value>>,
+    changes: Vec<String>,
+}
+
+pub fn plan(
+    store: &Path,
+    repository: &Path,
+    caller: &str,
+    arguments: &Value,
+) -> Result<(RouteWrite, Vec<String>), String> {
+    let object = arguments
+        .as_object()
+        .filter(|object| {
+            object
+                .keys()
+                .all(|key| key == "routes" || key == "services")
+        })
+        .ok_or("routes_write_arguments_invalid")?;
+    let list = |key: &str| -> Result<Option<Vec<Value>>, String> {
+        match object.get(key) {
+            None => Ok(None),
+            Some(Value::Array(items)) if items.iter().all(Value::is_object) => {
+                Ok(Some(items.clone()))
+            }
+            Some(_) => Err(format!("routes_write_{key}_invalid")),
+        }
+    };
+    let mut write = RouteWrite {
+        caller: caller.to_owned(),
+        routes: list("routes")?.ok_or("routes_write_routes_invalid")?,
+        services: list("services")?,
+        changes: Vec::new(),
+    };
+    let host = read(store)?;
+    let merged = merged(store, repository, &write, host.clone())?;
+    write.changes = changes(store, caller, &host, &merged);
+    let changes = write.changes.clone();
+    Ok((write, changes))
+}
+
+pub fn apply(store: &Path, repository: &Path, write: &RouteWrite) -> Result<Value, String> {
+    let _lock =
+        crate::mods::store_lock(&store.join("store.lock")).map_err(|error| error.to_string())?;
+    let current = read(store)?;
+    let merged = merged(store, repository, write, current.clone())?;
+    if changes(store, &write.caller, &current, &merged) != write.changes {
+        return Err(
+            "routes_write_changed: host.json changed after the confirmation; try again".into(),
+        );
+    }
+    crate::fsio::write_json(&store.join("host.json"), &merged)
+        .map_err(|error| error.to_string())?;
+    let names = |key: &str, field: &str, owner: &str| {
+        merged[key]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter(|item| item[owner] == write.caller.as_str())
+            .map(|item| item[field].clone())
+            .collect::<Vec<_>>()
+    };
+    Ok(json!({"routes": names("routes", "name", "provider"),
+        "services": names("services", "id", "mod_id")}))
+}
+
+fn read(store: &Path) -> Result<Value, String> {
+    match std::fs::read(store.join("host.json")) {
+        Ok(bytes) => serde_json::from_slice(&bytes).map_err(|error| error.to_string()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(json!({"schema": 1})),
+        Err(error) => Err(error.to_string()),
+    }
+}
+
+fn merged(
+    store: &Path,
+    repository: &Path,
+    write: &RouteWrite,
+    mut host: Value,
+) -> Result<Value, String> {
+    let caller = write.caller.as_str();
+    let object = host.as_object_mut().ok_or("host_config_invalid")?;
+    let credentials = crate::credentials::CredentialProfiles::open(store)
+        .and_then(|profiles| profiles.list())
+        .map_err(|error| error.to_string())?;
+    let usable = |id: &str| {
+        credentials.iter().any(|profile| {
+            profile.id == id
+                && (profile.kind != "secret" || profile.owner.as_deref() == Some(caller))
+        })
+    };
+    let allowance = object
+        .get("limits")
+        .and_then(|limits| limits["exposure_microusd"].as_u64())
+        .is_some_and(|limit| limit > 0);
+    let billed = |route: &Value| -> Result<(), String> {
+        let name = route["name"].as_str().unwrap_or_default();
+        if route["provider"] != caller {
+            return Err(format!("routes_write_provider_mismatch: {name}"));
+        }
+        let rates = &route["rates"];
+        if rates["included_subscription"] != true && rates["provider_billed"] != true && !allowance
+        {
+            return Err(format!("routes_write_allowance_required: {name}"));
+        }
+        Ok(())
+    };
+    for route in &write.routes {
+        let name = route["name"].as_str().unwrap_or_default();
+        if route["roles"] != json!(["lead"]) || route.get("grant").is_some() {
+            return Err(format!("routes_write_lead_only: {name}"));
+        }
+        if route.get("credential").is_some() {
+            return Err(format!("routes_write_credential_field: {name}"));
+        }
+        billed(route)?;
+    }
+    let routes = object
+        .entry("routes")
+        .or_insert_with(|| json!([]))
+        .as_array_mut()
+        .ok_or("host_config_invalid")?;
+    routes.retain(|route| route["provider"] != caller || route.get("grant").is_some());
+    routes.extend(write.routes.iter().cloned());
+    for service in write.services.iter().flatten() {
+        let id = service["id"]
+            .as_str()
+            .ok_or("routes_write_service_id_required")?;
+        let fields = service.as_object().into_iter().flatten();
+        if fields
+            .map(|(key, _)| key.as_str())
+            .any(|key| !matches!(key, "id" | "credentials" | "route"))
+        {
+            return Err(format!("routes_write_service_field: {id}"));
+        }
+        let grant = object
+            .get_mut("services")
+            .and_then(Value::as_array_mut)
+            .into_iter()
+            .flatten()
+            .find(|grant| grant["id"] == id && grant["mod_id"] == caller)
+            .ok_or_else(|| format!("routes_write_service_unknown: {id}"))?;
+        for key in ["credentials", "route"] {
+            if let Some(value) = service.get(key) {
+                grant[key] = value.clone();
+            }
+        }
+        if let Some(route) = grant.get("route") {
+            billed(route)?;
+        }
+        for credential in grant["credentials"].as_array().into_iter().flatten() {
+            if !credential.as_str().is_some_and(usable) {
+                return Err(format!("routes_write_credential_unknown: {id}"));
+            }
+        }
+    }
+    let bytes = serde_json::to_vec(&host).map_err(|error| error.to_string())?;
+    if bytes.len() > HOST_CONFIG_BYTES {
+        return Err("routes_write_host_config_too_large".into());
+    }
+    let check = HOST_CHECK
+        .get()
+        .ok_or("routes_write_unavailable: the session host is not running")?;
+    check(repository, &host).map_err(|error| format!("routes_write_invalid: {error}"))?;
+    Ok(host)
+}
+
+fn changes(store: &Path, caller: &str, before: &Value, after: &Value) -> Vec<String> {
+    let labels = crate::credentials::CredentialProfiles::open(store)
+        .and_then(|profiles| profiles.list())
+        .unwrap_or_default();
+    let label = |id: &Value| {
+        let id = id.as_str().unwrap_or_default();
+        labels.iter().find(|profile| profile.id == id).map_or_else(
+            || id.to_owned(),
+            |profile| format!("{} ({})", profile.label, profile.kind),
+        )
+    };
+    let owned = |host: &Value, key: &str, owner: &str, field: &str| {
+        host[key]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter(|item| item[owner] == caller)
+            .map(|item| {
+                (
+                    item[field].as_str().unwrap_or_default().to_owned(),
+                    item.clone(),
+                )
+            })
+            .collect::<std::collections::BTreeMap<_, _>>()
+    };
+    let billing = |route: &Value| {
+        let rates = &route["rates"];
+        if rates["included_subscription"] == true {
+            "subscription"
+        } else if rates["provider_billed"] == true {
+            "provider-billed"
+        } else {
+            "paid API, per request"
+        }
+    };
+    let text = |value: &Value| {
+        value
+            .as_str()
+            .map_or_else(|| value.to_string(), str::to_owned)
+    };
+    let shown = |key: &str, value: Option<&Value>| match (key, value) {
+        ("route", Some(route)) => format!(
+            "{} ({})",
+            route["name"].as_str().unwrap_or_default(),
+            route["model"].as_str().unwrap_or_default()
+        ),
+        (_, Some(Value::Array(items))) => items.iter().map(text).collect::<Vec<_>>().join(" "),
+        (_, Some(Value::Object(map))) => map
+            .iter()
+            .map(|(key, value)| format!("{key}={}", text(value)))
+            .collect::<Vec<_>>()
+            .join(" "),
+        (_, value) => value.map_or_else(|| "none".to_owned(), text),
+    };
+    let field = |lines: &mut Vec<String>, mut line: String| {
+        if line.len() > 400 {
+            line.truncate(line.floor_char_boundary(399));
+            line.push('…');
+        }
+        lines.push(line);
+    };
+    let mut lines = Vec::new();
+    let (old, new) = (
+        owned(before, "routes", "provider", "name"),
+        owned(after, "routes", "provider", "name"),
+    );
+    for (name, route) in &new {
+        let model = route["model"].as_str().unwrap_or_default();
+        let previous = match old.get(name) {
+            None => {
+                lines.push(format!(
+                    "Add model route {name}: {model}, {}",
+                    billing(route)
+                ));
+                json!({})
+            }
+            Some(previous) if previous != route => {
+                lines.push(format!(
+                    "Change model route {name}: {model}, {}",
+                    billing(route)
+                ));
+                previous.clone()
+            }
+            Some(_) => continue,
+        };
+        let keys = route
+            .as_object()
+            .into_iter()
+            .chain(previous.as_object())
+            .flat_map(|map| map.keys());
+        for key in keys.collect::<std::collections::BTreeSet<_>>() {
+            if !matches!(key.as_str(), "name" | "provider" | "roles" | "model")
+                && previous.get(key) != route.get(key)
+            {
+                let value = match (previous.get(key), route.get(key)) {
+                    (Some(Value::Object(was)), Some(Value::Object(now))) => Some(Value::Object(
+                        now.iter()
+                            .filter(|(inner, value)| was.get(*inner) != Some(*value))
+                            .map(|(inner, value)| (inner.clone(), value.clone()))
+                            .chain(
+                                was.keys()
+                                    .filter(|inner| !now.contains_key(*inner))
+                                    .map(|inner| (inner.clone(), Value::Null)),
+                            )
+                            .collect(),
+                    )),
+                    (_, value) => value.cloned(),
+                };
+                field(
+                    &mut lines,
+                    format!("Route {name} {key}: {}", shown(key, value.as_ref())),
+                );
+            }
+        }
+    }
+    for name in old.keys().filter(|name| !new.contains_key(*name)) {
+        lines.push(format!("Remove model route {name}"));
+    }
+    let (old, new) = (
+        owned(before, "services", "mod_id", "id"),
+        owned(after, "services", "mod_id", "id"),
+    );
+    let list = |grant: &Value, key: &str| -> Vec<Value> {
+        grant[key].as_array().cloned().unwrap_or_default()
+    };
+    for (id, grant) in &new {
+        let before = old.get(id).cloned().unwrap_or_else(|| json!({}));
+        let (was, now) = (list(&before, "credentials"), list(grant, "credentials"));
+        for credential in now.iter().filter(|c| !was.contains(c)) {
+            lines.push(format!("Let service {id} use {}", label(credential)));
+        }
+        for credential in was.iter().filter(|c| !now.contains(c)) {
+            lines.push(format!("Stop service {id} using {}", label(credential)));
+        }
+        if before.get("route") != grant.get("route") {
+            field(
+                &mut lines,
+                format!("Service {id} route: {}", shown("route", grant.get("route"))),
+            );
+        }
+    }
+    lines
+}
+
+#[cfg(test)]
+#[path = "route_writes_tests.rs"]
+mod tests;
diff --git a/codex-rs/omd/src/route_writes_tests.rs b/codex-rs/omd/src/route_writes_tests.rs
