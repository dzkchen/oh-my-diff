+    assert_eq!(requests.len(), 2);
+    let compaction = &requests[1];
+    assert_eq!(compaction.body_json()["model"], "switch-compact-model");
+    let input = compaction.input();
+    assert!(mentions(&input, "turn one") && mentions(&input, "SECOND"));
