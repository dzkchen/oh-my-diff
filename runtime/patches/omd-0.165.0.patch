+impl Service {
+    fn finished(&self) -> bool {
+        self.job
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    async fn stop(mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            let _ = job.await;
+        }
+    }
+}
