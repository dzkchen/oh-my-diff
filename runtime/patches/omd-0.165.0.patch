+    };
+    let first = cells(
+        json!({"x": 1, "y": 0, "width": 2, "height": 1}),
+        json!(["a", "a"]),
+        start,
+    );
+    assert_eq!(first, json!({"frame": 1, "queued": 1, "frame_ms": 16}));
+    let (rows, next) = draw(10, false, start);
+    assert_eq!(
+        (text(&rows), next),
+        (vec![" aa ".into(), "    ".into()], None)
+    );
+    let merged = [
+        cells(
+            json!({"x": 1, "y": 0, "width": 2, "height": 1}),
+            json!(["b", ["b", "#ff0000", null]]),
+            at(1),
+        ),
