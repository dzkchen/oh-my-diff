+impl Drop for Agent {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            execution::stop_dropped(
+                &self.runtime,
+                self.thread.clone(),
+                self.task.clone(),
+                self.worker.clone(),
+                !self.consumed,
+                Some(job),
+                self.workspace.take(),
+            );
+        } else if !self.consumed {
+            let _ = self.task.discard_worker_result(&self.worker);
+        }
+    }
+}
