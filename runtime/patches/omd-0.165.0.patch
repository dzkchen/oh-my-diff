+        agent_path: Some(AgentPath::try_from("/root/worker").expect("valid agent path")),
+        agent_nickname: None,
+        agent_role: None,
+    });
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+    let args: codex_protocol::request_user_input::RequestUserInputArgs =
+        serde_json::from_value(serde_json::json!({
+            "questions": [{"id": "port", "header": "Port", "question": "Which port?"}],
+            "isBlocking": false,
+        }))
+        .expect("valid request_user_input args");
+    let pending = tokio::spawn({
+        let session = Arc::clone(&session);
+        let turn_context = Arc::clone(&turn_context);
+        async move {
+            session
+                .request_user_input(turn_context.as_ref(), "call-1".to_string(), args)
+                .await
+        }
+    });
+    while !matches!(
+        rx.recv().await.map(|event| event.msg),
+        Ok(EventMsg::RequestUserInput(_))
+    ) {}
+    let author = |path: &str| AgentPath::try_from(path).expect("valid agent path");
+
+    session
+        .answer_forwarded_question(&author("/root/other"))
+        .await;
+    assert!(!pending.is_finished());
+    session.answer_forwarded_question(&author("/root")).await;
+    let answered = pending
+        .await
+        .expect("request task")
+        .expect("question answered");
+    assert_eq!(
+        answered.response.answers["port"].answers,
+        vec!["Your parent replied; its message follows.".to_string()]
+    );
+}
