+    record(&sessions.join("c.jsonl"), &repo, "session-c", "disabled");
+    let index = SessionIndex {
+        database: None,
+        root: &sessions,
+        repository: &repo,
+        enabled: true,
+        tools: true,
+    };
+    let list = index
