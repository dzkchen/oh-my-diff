+        crate::omd::tests::omd_environment(&directory.path().canonicalize().unwrap().join("store"));
+    let previous = STATE.locked().take();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let sender = AppEventSender::new(tx);
+    attach(&sender, Some("surface-thread".into()));
+    let binding = call_binding("surface_fixture");
+    assert_eq!(binding["source"], source);
+    let native_generation = binding["generation"].as_u64().unwrap() + 10;
+    let cancelled = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let pending = codex_omd::client_surface::with_admission(
+        &source,
+        native_generation,
+        Some(cancelled.clone()),
+        || {
+            codex_omd::client_surface::submit(
