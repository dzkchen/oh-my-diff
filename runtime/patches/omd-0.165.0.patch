+                        .as_str()
+                        .ok_or_else(|| serde::de::Error::custom("label must be a string"))?
+                        .to_owned(),
+                ),
+            });
+        }
+        Ok(Self {
+            action: ModKeyAction::deserialize(value).map_err(serde::de::Error::custom)?,
+            label: None,
