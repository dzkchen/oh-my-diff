+            self.0.lock().unwrap().push(input.host_decision.to_owned());
+            Box::pin(std::future::ready(match input.host_decision {
+                "skip" => codex_extension_api::ApprovalGate::Deny("gated".to_string()),
+                _ => codex_extension_api::ApprovalGate::Approve("lifted".to_string()),
