+
+    contended(|| store.enable(&provider, false));
+    assert!(
+        runtime
+            .reload()
+            .unwrap_err()
+            .to_string()
+            .contains("service_provider_missing: required requires shared.echo")
+    );
+
+    let mut reopened = host(&temp);
+    assert!(
+        error_of(&reopened, "required")
+            .contains("service_provider_missing: required requires shared.echo"),
