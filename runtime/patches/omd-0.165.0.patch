+pub(crate) fn delegable(operation: &str) -> bool {
+    client_surface::SURFACE_OPERATIONS.contains(&operation)
+        && !client_surface::USER_ONLY_OPERATIONS.contains(&operation)
+        && !NOT_DELEGATED.contains(&operation)
+}
