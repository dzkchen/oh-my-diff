+            "sites":{"welcome":{"components":[{"type":"text","id":"guide",
+                "label":"External guide","text":"EXTERNAL WELCOME PROBE"}]}}
+        }))
+        .unwrap(),
+        ..Default::default()
+    };
+    crate::mod_ui::startup_preview(Some(snapshot), std::path::Path::new("/startup-repository"));
+    let mut pump = crate::startup_draft::tests::quiet_startup_test_pump();
+    let area = Rect::new(0, 0, 80, 28);
+    for (action, draft, pending, raw, show) in [
+        (StartupDraftSessionAction::New, "", false, false, true),
+        (StartupDraftSessionAction::New, "draft", false, false, true),
+        (StartupDraftSessionAction::New, "draft", true, false, true),
+        (StartupDraftSessionAction::New, "", false, true, false),
+        (StartupDraftSessionAction::Resume, "", false, false, false),
+        (StartupDraftSessionAction::Fork, "", false, false, false),
+    ] {
+        pump.session_action = action;
+        pump.submission_pending = pending;
+        pump.raw_output_mode = raw;
+        pump.bottom_pane
+            .set_composer_text(draft.into(), Vec::new(), Vec::new());
+        let mut buffer = Buffer::empty(area);
+        OwnedStartupLayout::new(&pump).render(area, &mut buffer);
+        let text = buffer
+            .content
+            .iter()
+            .map(ratatui::buffer::Cell::symbol)
+            .collect::<String>();
+        assert!(text.contains(&format!(
+            "OpenAI Codex (v{}) | External profile",
+            crate::version::CODEX_CLI_VERSION
+        )));
+        assert!(!text.contains("Pull up a prompt."));
+        assert_eq!(text.contains("EXTERNAL WELCOME PROBE"), show);
+        let mut inline = Buffer::empty(area);
+        crate::startup_draft::startup_draft_renderable(&pump.header, &pump.bottom_pane, action)
+            .render(area, &mut inline);
+        let text = inline
+            .content
+            .iter()
+            .map(ratatui::buffer::Cell::symbol)
+            .collect::<String>();
+        assert!(text.contains("External profile"));
+        assert!(!text.contains("Pull up a prompt."));
+        assert!(!text.contains("EXTERNAL WELCOME PROBE"));
+    }
+    crate::mod_ui::startup_preview(None, std::path::Path::new("/startup-repository"));
