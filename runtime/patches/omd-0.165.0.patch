+}
+
+pub enum BlitContent {
+    Source(crate::process_raster::PixelSource),
+    Pixels(Arc<crate::process_raster::PixelFrame>),
+    Cells {
+        rect: BlitRect,
+        cells: Vec<BlitCell>,
+    },
+    Encoded {
