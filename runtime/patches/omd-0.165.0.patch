+fn pointer_events(kind: MouseEventKind, column: u16, row: u16) -> (bool, Vec<(String, String)>) {
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let top = interaction
+        .layers
+        .iter()
+        .filter(|(area, _)| contains(*area, column, row))
+        .map(|(_, layer)| *layer)
+        .max()
+        .unwrap_or_default();
+    let event = MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    };
+    let (consumed, events) = region_pointer(&mut interaction, event, top);
+    let events = events
+        .iter()
+        .map(|event| {
+            let pointer = &event["pointer"];
+            (
+                event["component"].as_str().unwrap_or_default().to_owned(),
+                format!(
+                    "{} {} {}",
+                    pointer["action"].as_str().unwrap_or_default(),
+                    pointer["column"],
+                    pointer["row"]
+                ),
+            )
+        })
+        .collect();
+    (consumed, events)
+}
+
+fn events(items: &[(&str, &str)]) -> Vec<(String, String)> {
+    items
+        .iter()
+        .map(|(component, event)| ((*component).to_owned(), (*event).to_owned()))
+        .collect()
+}
