+    let sql = format!(
+        "CREATE TABLE threads(id TEXT,cwd TEXT,memory_mode TEXT,rollout_path TEXT); INSERT INTO threads VALUES('session-a','{}','disabled',NULL);",
+        repo.to_str().unwrap().replace('\'', "''")
