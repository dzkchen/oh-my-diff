+    let other_log = mount_sse_sequence(&other, vec![reply("b1", "CHILD_DONE")]).await;
+    let _provider = runtime_provider("spawn_other", "spawn-other-model", &other);
+    let test = test_codex()
+        .with_config(|config| {
+            for feature in [Feature::Collab, Feature::MultiAgentV2] {
