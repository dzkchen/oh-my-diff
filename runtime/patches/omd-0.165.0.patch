@@ -0,0 +1,723 @@
+use super::*;
+use crate::managed_process::ProcessNotice;
+
+const DELIVERIES_PER_ROUND: usize = 64;
+const TIMER_FLOOR_MS: u64 = 16;
+
+pub(in crate::mods) enum Pending {
+    Process {
+        thread: ThreadId,
+        owner: String,
+        session: String,
+        bytes: Option<usize>,
+    },
+    Watch {
+        thread: ThreadId,
+        owner: String,
+        watch: String,
+        paths: Vec<String>,
+        include_ignored: bool,
+    },
+    Broadcast {
+        event: &'static str,
+        payload: Value,
+    },
+    Timer {
+        thread: ThreadId,
+        owner: String,
+        key: String,
+        source: String,
+        incarnation: u64,
+    },
+}
+
+pub(super) fn push(state: &State, pending: Pending) -> bool {
+    let mut admitted = false;
+    if let Ok(mut queue) = state.pending.lock() {
+        if let Pending::Timer {
+            thread, owner, key, ..
+        } = &pending
+        {
+            queue.retain(|item| !matches!(item, Pending::Timer { thread: other_thread, owner: other_owner, key: other_key, .. }
+                if thread == other_thread && owner == other_owner && key == other_key));
+        }
+        if let (
+            Pending::Process {
+                thread,
+                owner,
+                session,
+                bytes: Some(bytes),
+            },
+            Some(Pending::Process {
+                thread: last_thread,
+                owner: last_owner,
+                session: last_session,
+                bytes: Some(total),
+            }),
+        ) = (&pending, queue.back_mut())
+            && thread == last_thread
+            && owner == last_owner
+            && session == last_session
+        {
+            *total = total.saturating_add(*bytes);
+            admitted = true;
+        } else if queue.len() < 1024 {
+            queue.push_back(pending);
+            admitted = true;
+        } else {
+            state.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    state.wake.notify_one();
+    admitted
+}
+
+// The slot lock serializes producers with replacement/cancellation and quota accounting.
+pub(super) fn push_timer(state: &State, pending: Pending) {
+    let Pending::Timer {
+        thread,
+        owner,
+        key,
+        incarnation,
+        ..
+    } = &pending
+    else {
+        return;
+    };
+    let Ok(mut timers) = state.timers.lock() else {
+        return;
+    };
+    let slot = (thread.to_string(), owner.clone(), key.clone());
+    if timers
+        .get(&slot)
+        .is_some_and(|(_, current, _)| current == incarnation)
+        && !push(state, pending)
+    {
+        timers.remove(&slot);
+    }
+}
+
+pub(in crate::mods) fn lead_started(core: &Arc<Core>, lead: &Lead, forked: Option<ThreadId>) {
+    let state = &core.expansion;
+    let _ = state.core.set(Arc::downgrade(core));
+    let thread = lead.thread.to_string();
+    if let Ok(mut restarted) = state.restarted.lock() {
+        let seen = restarted.contains_key(&thread);
+        restarted.insert(thread.clone(), !seen);
+    }
+    if let Ok(mut current) = state.current.lock() {
+        *current = Some(LeadHandle::new(lead));
+    }
+    if let Ok(mut leads) = state.leads.lock() {
+        leads.retain(|_, handle| handle.session.strong_count() > 0);
+        leads.insert(lead.thread, LeadHandle::new(lead));
+    }
+    let weak = Arc::downgrade(core);
+    let handle = LeadHandle::new(lead);
+    lead.session
+        .processes
+        .set_notifier(Arc::new(move |notice: ProcessNotice| {
+            let Some(core) = weak.upgrade() else {
+                return;
+            };
+            if notice.exited
+                && let Some(lead) = handle.upgrade()
+            {
+                super::activity::process_exited(&core, &lead, &notice.owner, &notice.session);
+            }
+            if notice.deliver {
+                push(
+                    &core.expansion,
+                    Pending::Process {
+                        thread: handle.thread,
+                        owner: notice.owner,
+                        session: notice.session,
+                        bytes: notice.output_bytes,
+                    },
+                );
+            }
+        }));
+    if let Some(parent) = forked
+        && let Err(error) =
+            codex_omd::data_store::fork_thread_data(&lead.host.root, &parent.to_string(), &thread)
+        && error.kind() != std::io::ErrorKind::AlreadyExists
+    {
+        core.views.diagnostic(
+            &core.host,
+            "thread_store",
+            Some(format!("fork copy failed: {error}")),
+        );
+    }
+    let runtime = core.runtime.clone();
+    let refresh = Arc::downgrade(core);
+    tokio::spawn(async move {
+        let _ = tokio::task::spawn_blocking(move || {
+            if let (Some(core), Ok(runtime)) = (refresh.upgrade(), runtime.lock()) {
+                core.expansion.refresh(&runtime);
+            }
+        })
+        .await;
+    });
+    ensure_delivery(core);
+}
+
+fn ensure_delivery(core: &Arc<Core>) {
+    let Ok(mut delivery) = core.expansion.delivery.lock() else {
+        return;
+    };
+    if delivery
+        .as_ref()
+        .is_some_and(|current| !current.task.is_finished())
+    {
+        return;
+    }
+    let wake = core.expansion.wake.clone();
+    let signal = wake.clone();
+    let registration =
+        codex_omd::client_surface::register_wake(Arc::new(move || signal.notify_one()));
+    let reader = Arc::downgrade(core);
+    let activity = codex_omd::turn_activity::register_reader(Arc::new(move |thread, arguments| {
+        let core = reader.upgrade().ok_or("turn_activity_unavailable")?;
+        let lead = ThreadId::from_string(thread)
+            .ok()
+            .and_then(|thread| core.expansion.lead(thread))
+            .ok_or("turn_activity_unavailable")?;
+        super::activity::prepare(&core, &lead, arguments)?()
+    }));
+    let weak = Arc::downgrade(core);
+    let task = tokio::spawn(async move {
+        loop {
+            wake.notified().await;
+            let Some(core) = weak.upgrade() else {
+                return;
+            };
+            if deliver(&core).await {
+                tokio::time::sleep(std::time::Duration::from_millis(TIMER_FLOOR_MS)).await;
+                core.expansion.wake.notify_one();
+            }
+        }
+    });
+    *delivery = Some(Delivery {
+        task,
+        _wake: registration,
+        _activity: activity,
+    });
+}
+
+pub(super) async fn deliver(core: &Arc<Core>) -> bool {
+    let dropped = core.expansion.dropped.swap(0, Ordering::Relaxed);
+    if dropped > 0 {
+        core.views.diagnostic(
+            &core.host,
+            "delivery",
+            Some(format!(
+                "{dropped} background events dropped at the queue limit"
+            )),
+        );
+    }
+    let current = core.expansion.current();
+    let cursor = core
+        .expansion
+        .bus_cursor
+        .lock()
+        .map(|cursor| cursor.clone())
+        .unwrap_or_default();
+    let (later, earlier): (Vec<_>, Vec<_>) = sync_bus(&core.expansion)
+        .into_iter()
+        .partition(|id| *id > cursor);
+    let mut subscribers = later.into_iter().chain(earlier).collect();
+    let mut budget = DELIVERIES_PER_ROUND;
+    while budget > 0 {
+        let next = next_pending(&core.expansion, std::time::Instant::now());
+        let channel = next_channel_event(&core.expansion, &mut subscribers);
+        if next.is_none() && channel.is_none() {
+            break;
+        }
+        if let Some(next) = next {
+            budget -= 1;
+            deliver_pending(core, current.as_ref(), next).await;
+        }
+        if let Some((id, event)) = channel {
+            budget = budget.saturating_sub(1);
+            let Some(lead) = ThreadId::from_string(&event.thread)
+                .ok()
+                .and_then(|thread| core.expansion.thread(thread))
+            else {
+                continue;
+            };
+            let payload = json!({"publisher": event.publisher, "channel": event.channel,
+                "data": event.data, "correlation": event.correlation,
+                "sequence": event.sequence, "dropped": event.dropped});
+            invoke_one(core, &lead, id, "channel", payload).await;
+        }
+    }
+    budget == 0
+        || core
+            .expansion
+            .pending
+            .lock()
+            .is_ok_and(|queue| !queue.is_empty())
+}
+
+pub(super) fn next_pending(state: &State, now: std::time::Instant) -> Option<Pending> {
+    let mut rates = state.timer_deliveries.lock().ok()?;
+    let mut queue = state.pending.lock().ok()?;
+    let index = queue.iter().position(|item| match item {
+        Pending::Timer { thread, owner, .. } => {
+            rates.get(&(*thread, owner.clone())).is_none_or(|last| {
+                now.duration_since(*last) >= std::time::Duration::from_millis(TIMER_FLOOR_MS)
+            })
+        }
+        _ => true,
+    })?;
+    let next = queue.remove(index)?;
+    if let Pending::Timer { thread, owner, .. } = &next {
+        rates.insert((*thread, owner.clone()), now);
+    }
+    Some(next)
+}
+
+fn next_channel_event(
+    expansion: &State,
+    subscribers: &mut std::collections::VecDeque<String>,
+) -> Option<(String, codex_omd::event_bus::ChannelEvent)> {
+    let mut bus = codex_omd::event_bus::global().lock().ok()?;
+    while let Some(id) = subscribers.pop_front() {
+        let Some(event) = bus.drain(&id, 1).pop() else {
+            continue;
+        };
+        if bus.pending(&id) > 0 {
+            subscribers.push_back(id.clone());
+        }
+        if let Ok(mut cursor) = expansion.bus_cursor.lock() {
+            cursor.clone_from(&id);
+        }
+        return Some((id, event));
+    }
+    None
+}
+
+async fn deliver_pending(core: &Arc<Core>, current: Option<&Lead>, next: Pending) {
+    match next {
+        Pending::Process {
+            thread,
+            owner,
+            session,
+            bytes,
+        } => {
+            let Some(lead) = core.expansion.thread(thread) else {
+                return;
+            };
+            let payload = match bytes {
+                Some(bytes) => json!({"session": session, "kind": "output", "bytes": bytes}),
+                None => {
+                    json!({"session": session, "kind": "exit"})
+                }
+            };
+            invoke_one(core, &lead, owner, "process_event", payload).await;
+        }
+        Pending::Watch {
+            thread,
+            owner,
+            watch,
+            paths,
+            include_ignored,
+        } => {
+            let Some(lead) = core.expansion.thread(thread) else {
+                return;
+            };
+            let changes =
+                super::activity::external_changes(core, &lead, &paths, include_ignored).await;
+            if changes.is_empty() {
+                return;
+            }
+            let payload = json!({"repository": lead.host.repository, "source": "external",
+                "call_id": null, "watch_id": watch, "changes": changes, "status": "observed", "reason": null});
+            invoke_one(core, &lead, owner, "workspace_change", payload).await;
+        }
+        Pending::Broadcast { event, payload } => {
+            core.event(event, payload, current).await;
+        }
+        Pending::Timer {
+            thread,
+            owner,
+            key,
+            source,
+            incarnation,
+        } => {
+            let Some(lead) = core.expansion.thread(thread) else {
+                if let Ok(mut timers) = core.expansion.timers.lock() {
+                    let slot = (thread.to_string(), owner, key);
+                    if timers
+                        .get(&slot)
+                        .is_some_and(|(_, current, _)| *current == incarnation)
+                    {
+                        timers.remove(&slot);
+                    }
+                }
+                return;
+            };
+            invoke_one_guarded(
+                core,
+                &lead,
+                owner,
+                "timer",
+                json!({"key": key}),
+                Some((key, source, incarnation)),
+            )
+            .await;
+        }
+    }
+}
+
+pub(super) fn sync_bus(expansion: &State) -> Vec<String> {
+    let subscriptions = expansion
+        .subscriptions
+        .lock()
+        .map(|subscriptions| subscriptions.clone())
+        .unwrap_or_default();
+    let current = subscriptions
+        .iter()
+        .filter(|(_, subscriptions)| !subscriptions.channels.is_empty())
+        .map(|(id, _)| id.clone())
+        .collect::<BTreeSet<_>>();
+    let (Ok(mut bus), Ok(mut subscribed)) = (
+        codex_omd::event_bus::global().lock(),
+        expansion.subscribed.lock(),
+    ) else {
+        return Vec::new();
+    };
+    for removed in subscribed.difference(&current) {
+        bus.unsubscribe(removed);
+    }
+    for (id, subscriptions) in &subscriptions {
+        if !subscriptions.channels.is_empty() {
+            bus.subscribe(id, subscriptions.channels.clone());
+        }
+    }
+    *subscribed = current.clone();
+    current
+        .into_iter()
+        .filter(|id| bus.pending(id) > 0)
+        .collect()
+}
+
+pub(in crate::mods) fn publish(
+    core: &Core,
+    lead: &Lead,
+    caller: &str,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        channel: String,
+        data: Value,
+        #[serde(default)]
+        correlation: Option<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+    sync_bus(&core.expansion);
+    let delivery = codex_omd::event_bus::global()
+        .lock()
+        .map_err(|_| "event_bus_poisoned")?
+        .publish(
+            caller,
+            &input.channel,
+            input.data,
+            input.correlation,
+            &lead.thread.to_string(),
+        )
+        .map_err(|error| error.to_string())?;
+    core.expansion.wake.notify_one();
+    Ok(json!({"delivered": delivery.delivered, "dropped": delivery.dropped}))
+}
+
+pub(in crate::mods) fn watch(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        paths: Vec<String>,
+        #[serde(default = "recursive")]
+        recursive: bool,
+        #[serde(default)]
+        debounce_ms: Option<u64>,
+        #[serde(default)]
+        include_ignored: bool,
+        #[serde(default)]
+        key: Option<String>,
+    }
+    fn recursive() -> bool {
+        true
+    }
+    let shape = format!("{}:{arguments}", lead.thread);
+    let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+    if input.key.as_deref().is_some_and(invalid_watch_key) {
+        return Err("watch_arguments_invalid".into());
+    }
+    let watches = {
+        let mut watches = core
+            .expansion
+            .watches
+            .lock()
+            .map_err(|_| "watch_state_poisoned")?;
+        match watches.as_ref() {
+            Some(watches) => watches.clone(),
+            None => {
+                let watcher = codex_file_watcher::FileWatcher::new()
+                    .map_err(|error| format!("watch_unavailable: {error}"))?;
+                let created = Arc::new(
+                    crate::workspace_watch::WorkspaceWatches::new(
+                        Arc::new(watcher),
+                        lead.host.repository.clone(),
+                        lead.host.protected_paths(),
+                        lead.host.config.mod_limits,
+                    )
+                    .map_err(|error| error.to_string())?,
+                );
+                *watches = Some(created.clone());
+                created
+            }
+        }
+    };
+    let weak = core
+        .expansion
+        .core
+        .get()
+        .cloned()
+        .ok_or("watch_unavailable: no session")?;
+    let (owner, thread, include_ignored) =
+        (caller.id.to_owned(), lead.thread, input.include_ignored);
+    let sink: crate::workspace_watch::ChangeSink =
+        Arc::new(move |watch: &str, paths: Vec<String>| {
+            if let Some(core) = weak.upgrade() {
+                push(
+                    &core.expansion,
+                    Pending::Watch {
+                        thread,
+                        owner: owner.clone(),
+                        watch: watch.to_owned(),
+                        paths,
+                        include_ignored,
+                    },
+                );
+            }
+        });
+    let (id, _) = watches
+        .watch(
+            caller.id,
+            caller.source,
+            &input.paths,
+            input.recursive,
+            input.debounce_ms,
+            input.key.as_deref().map(|key| (key, shape.as_str())),
+            sink,
+        )
+        .map_err(|error| error.to_string())?;
+    Ok(json!({"watch_id": id}))
+}
+
+fn invalid_watch_key(key: &str) -> bool {
+    key.is_empty() || key.len() > 64
+}
+
+pub(in crate::mods) fn unwatch(
+    core: &Core,
+    caller: &str,
+    arguments: &Value,
+) -> Result<Value, String> {
+    let single = arguments
+        .as_object()
+        .is_some_and(|object| object.len() == 1);
+    let (id, key) = (arguments["watch_id"].as_str(), arguments["key"].as_str());
+    if !single || id.is_none() && key.is_none_or(invalid_watch_key) {
+        return Err("watch_arguments_invalid".into());
+    }
+    let stopped = core
+        .expansion
+        .watches
+        .lock()
+        .map_err(|_| "watch_state_poisoned")?
+        .as_ref()
+        .is_some_and(|watches| match (id, key) {
+            (Some(id), _) => watches.unwatch(caller, id),
+            (None, Some(key)) => watches.unwatch_key(caller, key),
+            (None, None) => false,
+        });
+    Ok(json!({"stopped": stopped}))
+}
+
+pub(in crate::mods) fn schedule(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    let (key, delay_ms) = codex_omd::host::validate_timer_request("events.schedule", &arguments)?;
+    let weak = core
+        .expansion
+        .core
+        .get()
+        .cloned()
+        .ok_or("timer_unavailable: no session")?;
+    let mut timers = core
+        .expansion
+        .timers
+        .lock()
+        .map_err(|_| "timer_state_poisoned")?;
+    let slot = (lead.thread.to_string(), caller.id.to_owned(), key.clone());
+    if !timers.contains_key(&slot)
+        && timers
+            .keys()
+            .filter(|(_, owner, _)| owner == caller.id)
+            .count()
+            >= lead.host.config.mod_limits.bounded().timers_per_mod
+    {
+        return Err("timer_limit".into());
+    }
+    let (owner, timer_key, thread) = (caller.id.to_owned(), key.clone(), lead.thread);
+    if let Ok(mut queue) = core.expansion.pending.lock() {
+        queue.retain(|item| {
+            !matches!(item, Pending::Timer { thread: t, owner: o, key: k, .. }
+            if *t == thread && o == &owner && k == &timer_key)
+        });
+    }
+    let source = caller.source.to_owned();
+    let incarnation = core
+        .expansion
+        .timer_sequence
+        .fetch_add(1, Ordering::Relaxed);
+    let task = tokio::spawn(async move {
+        tokio::time::sleep(std::time::Duration::from_millis(delay_ms)).await;
+        if let Some(core) = weak.upgrade() {
+            push_timer(
+                &core.expansion,
+                Pending::Timer {
+                    thread,
+                    owner,
+                    key: timer_key,
+                    source,
+                    incarnation,
+                },
+            );
+        }
+    });
+    if let Some((_, _, previous)) =
+        timers.insert(slot, (caller.source.to_owned(), incarnation, task))
+    {
+        previous.abort();
+    }
+    Ok(json!({"key": key, "delay_ms": delay_ms}))
+}
+
+pub(in crate::mods) fn cancel(
+    core: &Core,
+    lead: &Lead,
+    caller: &str,
+    arguments: &Value,
+) -> Result<Value, String> {
+    let (key, _) = codex_omd::host::validate_timer_request("events.cancel", arguments)?;
+    let mut timers = core
+        .expansion
+        .timers
+        .lock()
+        .map_err(|_| "timer_state_poisoned")?;
+    let removed = timers.remove(&(lead.thread.to_string(), caller.to_owned(), key.to_owned()));
+    if let Some((_, _, task)) = &removed {
+        task.abort();
+    }
+    let mut cancelled = removed.is_some();
+    if let Ok(mut queue) = core.expansion.pending.lock() {
+        let before = queue.len();
+        queue.retain(|item| {
+            !matches!(item, Pending::Timer { thread, owner, key: k, .. }
+            if *thread == lead.thread && owner == caller && k == &key)
+        });
+        cancelled |= queue.len() != before;
+    }
+    Ok(json!({"cancelled": cancelled}))
+}
+
+pub(in crate::mods) fn retain_sources(core: &Core, sources: &BTreeMap<String, String>) {
+    if let Ok(mut timers) = core.expansion.timers.lock() {
+        timers.retain(|(_, owner, _), (source, _, task)| {
+            let keep = sources.get(owner) == Some(source);
+            if !keep {
+                task.abort();
+            }
+            keep
+        });
+        if let Ok(mut queue) = core.expansion.pending.lock() {
+            queue.retain(|item| {
+                !matches!(item, Pending::Timer { owner, source, .. }
+                    if sources.get(owner) != Some(source))
+            });
+        }
+    }
+    if let Ok(mut rates) = core.expansion.timer_deliveries.lock() {
+        rates.retain(|(_, owner), _| sources.contains_key(owner));
+    }
+    if let Ok(watches) = core.expansion.watches.lock()
+        && let Some(watches) = watches.as_ref()
+    {
+        watches.retain_sources(sources);
+    }
+}
+
+pub(in crate::mods) fn release_owner(core: &Core, owner: &str) {
+    core.environment.clear(None, Some(owner));
+    clear_timers(core, None, Some(owner));
+    if let Ok(watches) = core.expansion.watches.lock()
+        && let Some(watches) = watches.as_ref()
+    {
+        watches.unwatch_all(owner);
+    }
+}
+
+pub(in crate::mods) fn release_thread(core: &Core, thread: ThreadId) {
+    clear_timers(core, Some(thread), None);
+}
+
+fn clear_timers(core: &Core, thread: Option<ThreadId>, owner: Option<&str>) {
+    let matches = |t: &str, id: &str| {
+        thread.is_none_or(|thread| thread.to_string() == t) && owner.is_none_or(|owner| owner == id)
+    };
+    if let Ok(mut timers) = core.expansion.timers.lock() {
+        timers.retain(|(t, id, _), (_, _, task)| {
+            if matches(t, id) {
+                task.abort();
+                false
+            } else {
+                true
+            }
+        });
+        if let Ok(mut queue) = core.expansion.pending.lock() {
+            queue.retain(|item| {
+                !matches!(item, Pending::Timer { thread, owner, .. }
+                if matches(&thread.to_string(), owner))
+            });
+        }
+    }
+    if let Ok(mut rates) = core.expansion.timer_deliveries.lock() {
+        rates.retain(|(thread, owner), _| !matches(&thread.to_string(), owner));
+    }
+}
+
+pub(in crate::mods) fn process_started(core: &Core, lead: &Lead, caller: &str, arguments: &Value) {
+    let session = arguments["session"].as_str().unwrap_or_default();
+    let command = arguments["name"].as_str().unwrap_or_default();
+    super::activity::record(core, lead, |turn| {
+        codex_omd::turn_activity::ActivityRecord::ProcessStarted {
+            turn_id: turn.to_owned(),
+            id: format!("{caller}/{session}"),
+            kind: "managed".into(),
+            command: command.to_owned(),
+            at: super::activity::now(),
+        }
+    });
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs b/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88d615bce42a22a149417a38dc838c20a8148617
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs
@@ -0,0 +1,157 @@
+use super::*;
+use codex_extension_api::ToolBatchContributor;
+use codex_extension_api::ToolBatchInput;
+use codex_extension_api::ToolBatchMerge;
+
+const MERGES: usize = 32;
+
+pub(in crate::mods) fn tool_before_payload(
+    turn_store: &ExtensionData,
+    call_id: &str,
+    tool: &ToolName,
+    arguments: &Value,
+    raw: &str,
+) -> Value {
+    let facts = turn_store
+        .get::<codex_extension_api::ToolCallFacts>()
+        .and_then(|facts| facts.get(call_id))
+        .unwrap_or_default();
+    json!({"tool": tool.to_string(), "arguments": arguments, "call_id": call_id,
+        "schema": facts.schema, "raw_arguments": raw,
+        "batch": facts.batch.map(|batch| json!({"id": batch.id, "index": batch.index, "size": batch.size}))})
+}
+
+pub(super) fn parse(
+    owner: &str,
+    value: Value,
+    known: &[String],
+) -> Result<Vec<ToolBatchMerge>, String> {
+    let invalid = || "invalid_tool_batch_decision".to_owned();
+    let merges = match value {
+        Value::Null => return Ok(Vec::new()),
+        Value::Object(object) if object.len() == 1 => object
+            .get("merge")
+            .and_then(Value::as_array)
+            .cloned()
+            .ok_or_else(invalid)?,
+        _ => return Err(invalid()),
+    };
+    if merges.len() > MERGES {
+        return Err(invalid());
+    }
+    merges
+        .into_iter()
+        .map(|merge| {
+            let object = merge.as_object().ok_or_else(invalid)?;
+            let success_per_call = match object.get("success_per_call") {
+                None => false,
+                Some(Value::Bool(flag)) => *flag,
+                Some(_) => return Err(invalid()),
+            };
+            if object.len() != 3 + usize::from(object.contains_key("success_per_call")) {
+                return Err(invalid());
+            }
+            let call_ids = object
+                .get("call_ids")
+                .and_then(Value::as_array)
+                .ok_or_else(invalid)?
+                .iter()
+                .map(|id| {
+                    id.as_str()
+                        .filter(|id| known.iter().any(|known| known == id))
+                        .map(str::to_owned)
+                        .ok_or_else(invalid)
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+            let tool = object
+                .get("tool")
+                .and_then(Value::as_str)
+                .filter(|tool| !tool.is_empty() && tool.len() <= 64)
+                .ok_or_else(invalid)?;
+            let arguments = object
+                .get("arguments")
+                .filter(|arguments| arguments.is_object())
+                .ok_or_else(invalid)?;
+            Ok(ToolBatchMerge {
+                call_ids,
+                tool: format!("mod_{owner}_{tool}"),
+                arguments: arguments.to_string(),
+                success_per_call,
+            })
+        })
+        .collect()
+}
+
+impl ToolBatchContributor for Mods {
+    fn batching(&self, thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_batch.load(Ordering::Acquire) && lead_thread(thread_store)
+    }
+
+    fn merge_tool_batch<'a>(
+        &'a self,
+        input: ToolBatchInput<'a>,
+    ) -> ExtensionFuture<'a, Vec<ToolBatchMerge>> {
+        Box::pin(async move {
+            let Some(lead) = input.thread_store.get::<Lead>() else {
+                return Vec::new();
+            };
+            let known = input
+                .calls
+                .iter()
+                .map(|call| call.call_id.clone())
+                .collect::<Vec<_>>();
+            let calls = input
+                .calls
+                .iter()
+                .map(|call| {
+                    let arguments = serde_json::from_str::<Value>(&call.arguments)
+                        .unwrap_or_else(|_| Value::String(call.arguments.clone()));
+                    json!({"call_id": call.call_id, "tool": call.tool, "arguments": arguments,
+                        "parallel_safe": call.parallel_safe})
+                })
+                .collect::<Vec<_>>();
+            let payload = json!({"batch_id": input.batch_id, "thread_id": lead.thread.to_string(), "calls": calls});
+            let runtime = self.runtime.clone();
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let result = tokio::task::spawn_blocking(move || {
+                let mut runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned".to_owned())?;
+                let owner = runtime
+                    .replacement_owner("tool_batch")
+                    .ok_or("tool_batch_owner_unavailable")?;
+                let generation = runtime.generation();
+                let value = runtime
+                    .invoke_with(
+                        &owner,
+                        generation,
+                        "tool_batch",
+                        "",
+                        payload,
+                        || !cancelled.load(Ordering::Acquire),
+                        |_| {
+                            Err(std::io::Error::other(
+                                "host_operation_unavailable: tool_batch runs without host operations",
+                            ))
+                        },
+                    )
+                    .map_err(|error| error.to_string())?;
+                parse(&owner, value, &known).map_err(|error| format!("{owner}: {error}"))
+            })
+            .await
+            .map_err(|error| error.to_string())
+            .and_then(|result| result);
+            self.cleanup_failed(Some(&lead)).await;
+            match result {
+                Ok(merges) => merges,
+                Err(error) => {
+                    self.views.diagnostic(
+                        &self.host,
+                        "tool_batch",
+                        Some(format!("{error}; calls dispatched individually")),
+                    );
+                    Vec::new()
+                }
+            }
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_output.rs b/codex-rs/ext/omd/src/mods/expansion/tool_output.rs
new file mode 100644
index 0000000000000000000000000000000000000000..701dea1f7e504beb78e26b1c0e0c3ba0af4c8262
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_output.rs
@@ -0,0 +1,323 @@
+use super::*;
+use codex_extension_api::ToolOutputContributor;
+use codex_extension_api::ToolOutputInput;
+use codex_extension_api::ToolOutputReplacement;
+
+use codex_extension_api::TOOL_OUTPUT_FEEDBACK_BYTES;
+
+const TAIL_BYTES: usize = 16 * 1024;
+const APPEND_BYTES: usize = 4096;
+
+fn bounded(text: &str) -> &str {
+    &text[..text.floor_char_boundary(codex_omd::TOOL_OUTPUT_BYTES)]
+}
+
+async fn original(
+    lead: &Lead,
+    owner: &str,
+    source: &str,
+    call_id: &str,
+    text: Arc<str>,
+) -> Result<Value, String> {
+    let scope = lead.session.data.0.clone();
+    let initialized = scope.lock().map_err(|_| "data_scope_poisoned")?.is_some();
+    let authority = match initialized {
+        true => None,
+        false => Some(crate::workspace_operations::WorkspaceAuthority::for_lead(lead).await?),
+    };
+    let (root, thread) = (lead.host.root.clone(), lead.thread.to_string());
+    let (owner, source) = (owner.to_owned(), source.to_owned());
+    let label = format!("tool_output:{call_id}");
+    tokio::task::spawn_blocking(move || {
+        let mut scope = scope.lock().map_err(|_| "data_scope_poisoned")?;
+        if scope.is_none() {
+            let authority = authority.ok_or("data_scope_unavailable")?;
+            *scope = Some(codex_omd::scoped_data::ScopedDataHosts::new(
+                root,
+                authority.repository,
+                authority.session_root,
+                authority.session_database,
+                thread,
+            ));
+        }
+        let hosts = scope.as_mut().ok_or("data_scope_unavailable")?;
+        let reference = hosts
+            .text_evidence(&owner, &source, &label, &text)
+            .map_err(|error| error.to_string())?;
+        serde_json::to_value(reference).map_err(|error| error.to_string())
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
+
+pub(super) async fn stored(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        call_id: String,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+    let text = expansion::CHAIN_CALL
+        .try_with(|chain| chain.clone())
+        .ok()
+        .filter(|chain| *chain == input.call_id)
+        .and_then(|call_id| {
+            core.expansion
+                .originals
+                .lock()
+                .ok()?
+                .get(&(lead.thread.to_string(), call_id))
+                .cloned()
+        })
+        .ok_or("tool_original_unavailable: only the call's own interceptor chain can read it")?;
+    let reference = original(lead, caller.id, caller.source, &input.call_id, text.clone()).await?;
+    Ok(
+        json!({"reference": reference, "sha256": codex_omd::resource_data::hash(text.as_bytes()),
+        "bytes": text.len()}),
+    )
+}
+
+pub(super) struct Stash<'a> {
+    originals: &'a Mutex<BTreeMap<(String, String), Arc<str>>>,
+    key: (String, String),
+}
+
+impl<'a> Stash<'a> {
+    pub(super) fn new(
+        originals: &'a Mutex<BTreeMap<(String, String), Arc<str>>>,
+        key: (String, String),
+        text: Arc<str>,
+    ) -> Self {
+        if let Ok(mut originals) = originals.lock() {
+            originals.insert(key.clone(), text);
+        }
+        Self { originals, key }
+    }
+
+    fn latest(&self) -> Option<Arc<str>> {
+        self.originals.lock().ok()?.get(&self.key).cloned()
+    }
+}
+
+impl Drop for Stash<'_> {
+    fn drop(&mut self) {
+        if let Ok(mut originals) = self.originals.lock() {
+            originals.remove(&self.key);
+        }
+    }
+}
+
+fn append(value: Value) -> Result<Option<String>, String> {
+    match value {
+        Value::Null => Ok(None),
+        Value::Object(object) if object.len() == 1 => match object.get("append") {
+            Some(Value::String(text)) if text.len() <= APPEND_BYTES => Ok(Some(text.clone())),
+            _ => Err("invalid_tool_output_feedback".into()),
+        },
+        _ => Err("invalid_tool_output_feedback".into()),
+    }
+}
+
+impl ToolOutputContributor for Mods {
+    fn replacing(&self, _thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_output_active()
+            || self.pending.lock().is_ok_and(|pending| !pending.is_empty())
+    }
+
+    fn wants_value(&self, call_id: &str) -> bool {
+        self.pending
+            .lock()
+            .is_ok_and(|pending| pending.get(call_id).is_some_and(|pending| pending.values))
+    }
+
+    fn replace_tool_output<'a>(
+        &'a self,
+        input: ToolOutputInput<'a>,
+    ) -> ExtensionFuture<'a, Option<ToolOutputReplacement>> {
+        Box::pin(async move {
+            let diagnostic = |message: String| {
+                self.views
+                    .diagnostic(&self.host, "tool_output", Some(message));
+            };
+            let head = bounded(input.text);
+            let mut executed = json!({"output": head, "success": input.success,
+                "truncated": input.text.len() > codex_omd::TOOL_OUTPUT_BYTES, "bytes": input.text.len()});
+            if let Some(value) = input.value
+                && serde_json::to_vec(value).is_ok_and(|bytes| {
+                    bytes.len() <= 32_768
+                        && head.len() + bytes.len() <= codex_omd::TOOL_OUTPUT_BYTES
+                })
+            {
+                executed["value"] = value.clone();
+            }
+            let mut text = None;
+            let mut replaced_by = "feedback".to_owned();
+            let stash = self
+                .pending
+                .lock()
+                .is_ok_and(|pending| pending.contains_key(input.call_id))
+                .then(|| {
+                    Stash::new(
+                        &self.expansion.originals,
+                        (
+                            thread_id(input.thread_store).unwrap_or_default(),
+                            input.call_id.to_owned(),
+                        ),
+                        Arc::from(input.text),
+                    )
+                });
+            let resumed = self.resume(input.call_id, Ok(executed.clone())).await;
+            match resumed {
+                Some(Ok(chain))
+                    if chain.result.get("deny").is_some()
+                        || chain.result["output"] != executed["output"] =>
+                {
+                    replaced_by = super::super::intercept::settled_by(&chain);
+                    text = Some(match chain.result["deny"].as_str() {
+                        Some(reason) => format!("mod_tool_denied: {replaced_by}: {reason}"),
+                        None => chain.result["output"]
+                            .as_str()
+                            .unwrap_or_default()
+                            .to_owned(),
+                    });
+                }
+                Some(Err(error)) => {
+                    replaced_by = "intercept".to_owned();
+                    text = Some(format!("mod_interception_failed: {error}"));
+                }
+                _ => {}
+            }
+            let latest = stash.as_ref().and_then(Stash::latest);
+            let original_text = latest.as_deref().unwrap_or(input.text);
+            let original_bytes = original_text.len();
+            let replaced = |text: Option<String>| {
+                text.map(|text| ToolOutputReplacement {
+                    text,
+                    original_bytes,
+                })
+            };
+            let limit = codex_extension_api::TOOL_OUTPUT_REPLACEMENT_BYTES.max(original_bytes);
+            if text.as_ref().is_some_and(|text| text.len() > limit) {
+                diagnostic(format!(
+                    "{replaced_by}: replacement over the {limit}-byte limit dropped"
+                ));
+                text = None;
+            }
+            let Some(lead) = input.thread_store.get::<Lead>() else {
+                return replaced(text);
+            };
+            if text.is_some() && replaced_by != "intercept" {
+                let (runtime, id) = (self.runtime.clone(), replaced_by.clone());
+                let source = tokio::task::spawn_blocking(move || {
+                    runtime
+                        .lock()
+                        .ok()
+                        .and_then(|runtime| runtime.grants(&id))
+                        .map(|grants| grants.source_sha256)
+                })
+                .await
+                .ok()
+                .flatten();
+                let kept = latest.clone().unwrap_or_else(|| Arc::from(input.text));
+                if let Some(source) = source
+                    && let Err(error) =
+                        original(&lead, &replaced_by, &source, input.call_id, kept).await
+                {
+                    diagnostic(format!("{replaced_by}: original unavailable: {error}"));
+                }
+            }
+            if !self.expansion.tool_output_active() {
+                if let Some(text) = &text {
+                    activity::output_replaced(
+                        &self.core,
+                        &lead,
+                        input.call_id,
+                        &replaced_by,
+                        original_text,
+                        text,
+                    );
+                }
+                return replaced(text);
+            }
+            let runtime = self.runtime.clone();
+            let observers = tokio::task::spawn_blocking(move || {
+                let runtime = runtime.lock().ok()?;
+                Some(
+                    runtime
+                        .owners()
+                        .into_iter()
+                        .map(|(id, _)| id)
+                        .filter(|id| runtime.registered(id, "tool_output"))
+                        .collect::<Vec<_>>(),
+                )
+            })
+            .await
+            .ok()
+            .flatten()?;
+            let arguments = input
+                .arguments
+                .map(|raw| {
+                    serde_json::from_str::<Value>(raw)
+                        .unwrap_or_else(|_| Value::String(bounded(raw).to_owned()))
+                })
+                .unwrap_or(Value::Null);
+            let payload = |text: &str| {
+                json!({"call_id": input.call_id, "tool": input.tool_name.to_string(),
+                    "arguments": arguments, "success": input.success,
+                    "text": bounded(text),
+                    "tail": (text.len() > codex_omd::TOOL_OUTPUT_BYTES).then(|| &text[text.ceil_char_boundary(text.len() - TAIL_BYTES)..]),
+                    "bytes": text.len()})
+            };
+            let mut appended = String::new();
+            for id in observers {
+                let current = text.as_deref().unwrap_or(input.text);
+                let Some(result) = invoke_one(
+                    &self.core,
+                    &lead,
+                    id.clone(),
+                    "tool_output",
+                    payload(current),
+                )
+                .await
+                else {
+                    continue;
+                };
+                match result.and_then(append) {
+                    Ok(Some(extra))
+                        if appended.len() + extra.len() + 2 <= TOOL_OUTPUT_FEEDBACK_BYTES =>
+                    {
+                        appended.push_str("\n\n");
+                        appended.push_str(&extra);
+                    }
+                    Ok(Some(_)) => diagnostic(format!(
+                        "{id}: feedback over the {TOOL_OUTPUT_FEEDBACK_BYTES}-byte budget dropped"
+                    )),
+                    Ok(None) => {}
+                    Err(error) => diagnostic(format!("{id}: {error}; feedback dropped")),
+                }
+            }
+            if !appended.is_empty() {
+                text = Some(format!(
+                    "{}{appended}",
+                    text.as_deref().unwrap_or(input.text)
+                ));
+            }
+            if let Some(text) = &text {
+                activity::output_replaced(
+                    &self.core,
+                    &lead,
+                    input.call_id,
+                    &replaced_by,
+                    original_text,
+                    text,
+                );
+            }
+            replaced(text)
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs b/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..61aa70f120336e3554fb2880766aa1dcd8a476f4
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs
@@ -0,0 +1,206 @@
+use super::*;
+use codex_extension_api::ToolInventoryEntry;
+use codex_extension_api::ToolSpecAdjustment;
+use codex_extension_api::ToolSpecContributor;
+use codex_extension_api::ToolSpecView;
+
+const SPEC_TOOLS: usize = 512;
+const PARAMETER_BYTES: usize = 16 * 1024;
+
+fn bounded_description(text: &str) -> String {
+    text.chars().take(4096).collect()
+}
+
+fn bounded_parameters(parameters: &Value) -> Value {
+    if parameters.to_string().len() <= PARAMETER_BYTES {
+        parameters.clone()
+    } else {
+        Value::Null
+    }
+}
+
+fn inventory_entry(tool: &ToolInventoryEntry) -> Value {
+    json!({"name": tool.name, "kind": tool.kind, "server": tool.server,
+        "original": {"description": bounded_description(&tool.description),
+            "parameters": bounded_parameters(&tool.parameters), "freeform": tool.freeform},
+        "effective": tool.effective.as_ref().map(|view| json!({
+            "description": bounded_description(&view.description),
+            "parameters": bounded_parameters(&view.parameters), "deferred": view.deferred}))})
+}
+
+pub(super) fn list(core: &Core, lead: &Lead) -> Result<Value, String> {
+    core.expansion
+        .inventories
+        .lock()
+        .map_err(|_| "tool_inventory_poisoned")?
+        .get(&lead.thread)
+        .cloned()
+        .ok_or_else(|| "tools_unavailable: this thread has not built its tools".into())
+}
+
+impl State {
+    pub(in crate::mods) fn validate_call(
+        &self,
+        thread: ThreadId,
+        tool: &str,
+        arguments: &Value,
+        rewritten: bool,
+    ) -> Result<(), String> {
+        let inventories = self
+            .inventories
+            .lock()
+            .map_err(|_| "tool_inventory_poisoned")?;
+        let Some(entry) = inventories
+            .get(&thread)
+            .and_then(|inventory| inventory["tools"].as_array())
+            .and_then(|tools| tools.iter().find(|entry| entry["name"] == tool))
+        else {
+            return Ok(());
+        };
+        let schema = &entry["original"]["parameters"];
+        if schema.is_null()
+            || entry["original"]["freeform"] == true
+            || !rewritten && entry["effective"]["parameters"] == *schema
+        {
+            return Ok(());
+        }
+        codex_omd::tool_schema::validate(schema, arguments)
+            .map_err(|reason| format!("tool_arguments_invalid: {tool}: {reason}"))
+    }
+
+    pub(in crate::mods) fn forget_inventory(&self, thread: ThreadId) {
+        if let Ok(mut inventories) = self.inventories.lock() {
+            inventories.remove(&thread);
+        }
+    }
+}
+
+pub(super) fn adjustment(original: &[Value], tools: &Value) -> ToolSpecAdjustment {
+    let tools = tools.as_array().cloned().unwrap_or_default();
+    let mut adjustment = ToolSpecAdjustment::default();
+    for before in original {
+        let name = before["name"].as_str().unwrap_or_default();
+        let Some(after) = tools.iter().find(|tool| tool["name"] == name) else {
+            adjustment.hide.push(name.to_owned());
+            continue;
+        };
+        if after["deferred"] == true {
+            adjustment.defer.push(name.to_owned());
+        }
+        let description = (after["description"] != before["description"])
+            .then(|| after["description"].as_str().map(str::to_owned))
+            .flatten();
+        let parameters = (after["parameters"] != before["parameters"]
+            && after["parameters"].is_object())
+        .then(|| after["parameters"].clone());
+        if description.is_some() || parameters.is_some() {
+            adjustment
+                .describe
+                .insert(name.to_owned(), (description, parameters));
+        }
+    }
+    adjustment
+}
+
+impl ToolSpecContributor for Mods {
+    fn adjusting(&self, thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_specs.load(Ordering::Acquire) && lead_thread(thread_store)
+            || thread_store.get::<roles::AgentTools>().is_some()
+    }
+
+    fn observing(&self, thread_store: &ExtensionData) -> bool {
+        lead_thread(thread_store) && self.expansion.tool_inventory.load(Ordering::Acquire)
+    }
+
+    fn observe_tool_inventory(
+        &self,
+        thread_store: &ExtensionData,
+        inventory: &[ToolInventoryEntry],
+    ) {
+        let Some(lead) = thread_store.get::<Lead>() else {
+            return;
+        };
+        let Ok(mut inventories) = self.expansion.inventories.lock() else {
+            return;
+        };
+        if !self.expansion.tool_inventory.load(Ordering::Acquire) {
+            return;
+        }
+        let snapshot = json!({"thread_id": lead.thread.to_string(),
+            "tools": inventory.iter().take(SPEC_TOOLS).map(inventory_entry).collect::<Vec<_>>()});
+        if inventories.get(&lead.thread) != Some(&snapshot) {
+            let _ = codex_omd::tool_schema::write_inventory(&lead.host.root, &snapshot);
+            inventories.insert(lead.thread, snapshot);
+        }
+    }
+
+    fn adjust_tool_specs(
+        &self,
+        thread_store: &ExtensionData,
+        specs: &[ToolSpecView],
+    ) -> Option<ToolSpecAdjustment> {
+        if let Some(allowed) = thread_store.get::<roles::AgentTools>() {
+            return Some(ToolSpecAdjustment {
+                hide: specs
+                    .iter()
+                    .filter(|spec| !allowed.0.contains(&spec.name))
+                    .map(|spec| spec.name.clone())
+                    .collect(),
+                ..ToolSpecAdjustment::default()
+            });
+        }
+        if !self.adjusting(thread_store) {
+            return None;
+        }
+        let lead = thread_store.get::<Lead>()?;
+        let route = self
+            .host
+            .accounts
+            .by_thread
+            .lock()
+            .ok()?
+            .get(&lead.thread.to_string())
+            .map(|account| {
+                json!({"name": account.route.clone().unwrap_or_else(|| "session".into()),
+                    "model": account.model, "provider": account.provider})
+            });
+        let tools = specs
+            .iter()
+            .take(SPEC_TOOLS)
+            .map(|spec| {
+                json!({"name": spec.name, "description": bounded_description(&spec.description),
+                    "parameters": bounded_parameters(&spec.parameters), "deferred": false})
+            })
+            .collect::<Vec<_>>();
+        let payload = json!({"thread_id": lead.thread.to_string(), "route": route, "tools": tools});
+        let origin = json!({"caller": "engine", "thread_id": lead.thread.to_string()});
+        let chain = codex_omd::intercept_shared(
+            &self.runtime,
+            "tool_specs",
+            self.expansion.tool_specs_required.load(Ordering::Acquire),
+            payload,
+            origin,
+            || true,
+            |_, _| {
+                Err(std::io::Error::other(
+                    "host_operation_unavailable: tool_specs runs without host operations",
+                ))
+            },
+            |effective| Ok(json!({"tools": effective["tools"]})),
+        );
+        match chain {
+            Ok(chain) => {
+                self.views.diagnostic(&self.host, "tool_specs", None);
+                Some(adjustment(&tools, &chain.result["tools"]))
+            }
+            Err(error) => {
+                self.views.diagnostic(
+                    &self.host,
+                    "tool_specs",
+                    Some(format!("{error}; native tool specs kept")),
+                );
+                None
+            }
+        }
+    }
+}
