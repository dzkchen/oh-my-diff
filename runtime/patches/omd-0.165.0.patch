+#[test]
+#[serial_test::serial]
+fn kitty_images_transmit_once_replace_per_component_and_tear_down() {
+    let png = || {
+        Some((
+            Pixels {
+                bytes: vec![1, 2, 3],
+                width: 1,
+                height: 1,
+                alpha: false,
+            },
+            4,
+            2,
+        ))
+    };
+    let (id, columns, rows) = kitty_image("thumb", "a", png).expect("placed");
+    assert_eq!((columns, rows), (4, 2));
+    assert_eq!(kitty_image("thumb", "a", || None), Some((id, 4, 2)));
+    let sent = std::mem::take(&mut images().transmissions);
+    assert_eq!(sent.len(), 1);
+    let (_, pixels, _, _) = &sent[0];
+    let payload = |command: String, medium: &str| {
+        let encoded = command
+            .strip_prefix(&format!(
+                "\x1b_Ga=T,U=1,f=24,s=1,v=1,i={id},c=4,r=2,q=2,t={medium},m=0;"
+            ))
+            .and_then(|rest| rest.strip_suffix("\x1b\\"))
+            .expect("one-chunk transmission");
+        base64::engine::general_purpose::STANDARD
+            .decode(encoded)
+            .expect("base64 payload")
+    };
+    images().directory = private_directory();
+    let directory = images()
+        .directory
+        .as_ref()
+        .expect("private directory")
+        .path()
+        .to_owned();
+    #[cfg(unix)]
+    assert_eq!(
+        std::os::unix::fs::PermissionsExt::mode(
+            &std::fs::metadata(&directory)
+                .expect("directory")
+                .permissions()
+        ) & 0o777,
+        0o700
+    );
+    assert_eq!(
+        payload(
+            transmission(Some(&directory.join("missing")), id, pixels, 4, 2, false),
+            "d"
+        ),
+        vec![1, 2, 3],
+        "pixels go inline when the file can't be written"
+    );
+    let path = std::path::PathBuf::from(
+        String::from_utf8(payload(
+            transmission(Some(&directory), id, pixels, 4, 2, false),
+            "t",
+        ))
+        .expect("utf-8 path"),
+    );
+    assert_eq!(path, directory.join(file_name(id)));
+    assert!(path.to_string_lossy().contains("tty-graphics-protocol"));
+    assert_eq!(std::fs::read(&path).expect("pixels"), vec![1, 2, 3]);
+    assert!(images().pending.is_empty(), "nothing is deleted yet");
+    let (next, _, _) = kitty_image("thumb", "b", png).expect("replaced");
+    assert!(!path.exists(), "a replaced image's unread file is removed");
+    let (last, _, _) = kitty_image("thumb", "c", png).expect("replaced");
+    assert_ne!(next, id);
+    assert_eq!(
+        std::mem::take(&mut images().transmissions)
+            .iter()
+            .map(|(id, ..)| *id)
+            .collect::<Vec<_>>(),
+        vec![last],
+        "an image replaced before it was sent is never sent"
+    );
+    assert_eq!(
+        std::mem::take(&mut images().pending),
+        vec![
+            crate::mod_kitty::kitty_remove(id),
+            crate::mod_kitty::kitty_remove(next)
+        ]
+    );
+    retain(&BTreeSet::new());
+    assert_eq!(
+        std::mem::take(&mut images().pending),
+        vec![crate::mod_kitty::kitty_remove(last)]
+    );
+    kitty_image("other", "c", png).expect("placed");
+    let removed = images().placed["other"].1;
+    teardown();
+    assert!(
+        images().placed.is_empty()
+            && images().pending.is_empty()
+            && images().transmissions.is_empty()
+    );
+    assert!(
+        !directory.exists(),
+        "teardown removes the private directory"
+    );
+    assert_eq!(
+        kitty_image("other", "c", png).map(|(id, _, _)| id == removed),
+        Some(false)
+    );
+    retain(&BTreeSet::new());
+    images().pending.clear();
+    images().transmissions.clear();
+}
