+#[tokio::test]
+#[serial_test::serial]
+#[ignore = "needs OMD_MODE=omd and a batch-local OMD_MOD_STORE; run with --ignored"]
+async fn native_approval_stays_visible_and_owns_enter_over_retained_mod_dialog() -> Result<()> {
+    for owned in [false, true] {
+        let (mut app, mut events, _operations) = make_test_app_with_channels().await;
+        let repository = tempfile::tempdir()?;
+        let cwd = AbsolutePathBuf::try_from(repository.path().canonicalize()?)?;
+        app.config.cwd = cwd.clone();
+        attach_thread_at(&mut app, ThreadId::new(), cwd);
+        app.chat_widget.apply_external_edit("original draft".into());
+        let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        tui.set_alt_screen_enabled(owned);
+        tui.set_owned_screen(owned)?;
+        let size = Size::new(80, 24);
+        tui.screen_size_for_event(&TuiEvent::Resize(size))?;
+        // Context sync invalidates old previews, so inject only after the App context exists, as terminal callbacks do in production.
+        app.sync_mod_ui();
+        crate::mod_ui::preview(codex_omd::ModViewSnapshot {
+            view: codex_omd::ModView::parse(serde_json::json!({
+                "sites":{"dialog":{"components":[
+                {"type":"dialog","id":"theme","label":"Theme","title":"Theme","children":[
+                    {"type":"button","id":"cover","label":"Close","text":"THEME COVER","action":{"copy":"MOD MOUSE DISPATCH PROBE","label":"fixture"}}
+                ]}
+            ]}}}))?,
+            contributors: vec!["fixture".into()],
+            ..Default::default()
+        });
+        app.render_chat_widget_frame(&mut tui, size)?;
+        assert!(crate::mod_ui::focus("cover"));
+        let initial = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+        let (row, column) = buffer_text(initial)
+            .lines()
+            .enumerate()
+            .find_map(|(row, line)| line.find("THEME COVER").map(|column| (row, column)))
+            .unwrap();
+        let stale_target = (
+            initial.area.x + column as u16 + 1,
+            initial.area.y + row as u16,
+        );
+        let pointer_up = || {
+            TuiEvent::Mouse(MouseEvent {
+                kind: Up(Left),
+                column: stale_target.0,
+                row: stale_target.1,
+                modifiers: KeyModifiers::NONE,
+            })
+        };
+        if owned {
+            assert!(
+                crate::omd::mouse_enabled(),
+                "fixture requires a batch-local OMD mod store and mouse enabled"
+            );
+            app.handle_tui_event(&mut tui, &mut server, pointer_up())
+                .await?;
+            let pending: Vec<_> = std::iter::from_fn(|| events.try_recv().ok()).collect();
+            assert!(
+                pending.iter().any(|event| matches!(event,
+                AppEvent::CopySelection { text,.. } if text.as_ref()=="MOD MOUSE DISPATCH PROBE")),
+                "live mod pointer route dispatches the probe before native approval"
+            );
+        }
+        app.chat_widget.handle_exec_approval_now(
+            crate::approval_events::ExecApprovalRequestEvent {
+                kind: Default::default(),
+                call_id: "native-approval".into(),
+                approval_id: Some("native-approval".into()),
+                turn_id: "turn".into(),
+                environment_id: None,
+                command: vec!["echo".into(), "APPROVAL COMMAND".into()],
+                cwd: app.config.cwd.clone(),
+                reason: Some("NATIVE APPROVAL REASON".into()),
+                network_approval_context: None,
+                proposed_execpolicy_amendment: None,
+                proposed_network_policy_amendments: None,
+                additional_permissions: None,
+                available_decisions: None,
+            },
+        );
+        assert!(!app.mod_overlays_allowed());
+        if owned {
+            app.handle_tui_event(&mut tui, &mut server, pointer_up())
+                .await?;
+            let pending: Vec<_> = std::iter::from_fn(|| events.try_recv().ok()).collect();
+            assert!(
+                !pending.iter().any(|event| matches!(event,
+                AppEvent::CopySelection { text,.. } if text.as_ref()=="MOD MOUSE DISPATCH PROBE")),
+                "native approval prevents stale mod pointer dispatch"
+            );
+            assert_eq!(
+                app.chat_widget.composer_text_with_pending(),
+                "original draft",
+                "stale mod mouse action refused"
+            );
+            assert!(app.chat_widget.has_active_modal());
+        }
+        app.render_chat_widget_frame(&mut tui, size)?;
+        let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+        let text = buffer_text(buffer);
+        assert!(
+            text.contains("NATIVE APPROVAL REASON"),
+            "owned={owned}: {text}"
+        );
+        assert!(text.contains("APPROVAL COMMAND"), "owned={owned}: {text}");
+        assert!(!text.contains("THEME COVER"), "owned={owned}: {text}");
+        assert!(
+            crate::mod_ui::dialog_visible(&crate::mod_ui::snapshot()),
+            "dialog state retained"
+        );
+        app.handle_key_event(
+            &mut tui,
+            &mut server,
+            KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE),
+        )
+        .await;
+        assert!(
+            !app.chat_widget.has_active_modal(),
+            "native Enter resolves approval"
+        );
+        assert!(
+            std::iter::from_fn(|| events.try_recv().ok()).any(|event| matches!(event,
+            AppEvent::SubmitThreadOp { op:AppCommand::ExecApproval { id,.. },.. } if id=="native-approval")),
+            "native decision emitted"
+        );
+        app.render_chat_widget_frame(&mut tui, size)?;
+        assert!(
+            buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+                &tui.terminal
+            ))
+            .contains("THEME COVER")
+        );
+        crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+        tui.set_owned_screen(false)?;
+        server.shutdown().await?;
+    }
+    Ok(())
+}
