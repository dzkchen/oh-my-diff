+    let _listener = std::os::unix::net::UnixListener::bind(&socket).unwrap();
+    let inside = repository.join("integration.sock");
+    let _inside = std::os::unix::net::UnixListener::bind(&inside).unwrap();
+    let name = "EXEC_SOCKET_FIXTURE";
