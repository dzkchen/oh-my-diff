+            .unwrap()
+        },
+    );
+    let AppEvent::ModSurfaceCall(mut call, _) = rx.try_recv().unwrap() else {
+        panic!("queued surface call")
+    };
+    assert!(validate_call(&call).is_ok());
+    call.lifetime.admission.as_mut().unwrap()["source"] = json!("replaced");
+    assert_eq!(
+        validate_call(&call).unwrap_err(),
+        "client_surface_admission_changed"
+    );
+    call.lifetime.admission.as_mut().unwrap()["source"] = json!(source);
+    cancelled.store(true, std::sync::atomic::Ordering::Release);
+    assert!(validate_call(&call).is_err());
+    cancelled.store(false, std::sync::atomic::Ordering::Release);
+    attach(&sender, Some("another-thread".into()));
+    attach(&sender, Some("surface-thread".into()));
+    assert!(validate_call(&call).is_err());
+    drop(pending);
+    *STATE.locked() = previous;
