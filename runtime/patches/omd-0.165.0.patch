+    let mut manifest = base;
+    manifest["compatibility"] = json!({"releases": [OMD_HOST_RELEASE]});
+    std::fs::write(&manifest_path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+    ModStore::inspect_package(&path).unwrap();
