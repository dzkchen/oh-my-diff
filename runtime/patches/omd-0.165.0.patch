+  "properties": {
+    "author": {
+      "description": "Recorded as edit provenance; defaults to the client name.",
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "edits": {
+      "default": [],
+      "description": "Row edits applied in order: `{op: \"delete\", id}`, `{op: \"replace\", id, items}`, `{op: \"insert\", before?, after?, items}` and `{op: \"move\", id, before?, after?}`, where `items` is one Responses message or one tool call followed by its output.",
+      "items": true,
+      "type": "array"
+    },
+    "expectedRevision": {
+      "description": "Revision the edits were made against; a different current revision is a conflict.",
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "threadId": {
+      "type": "string"
+    },
+    "undo": {
+      "default": false,
+      "description": "Restore the transcript the latest rewrite replaced, keeping rows added since.",
+      "type": "boolean"
+    }
+  },
+  "required": [
+    "threadId"
+  ],
+  "title": "ThreadRewriteParams",
+  "type": "object"
+}
