+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn extension_continuation_keeps_the_turn_sampling_until_it_declines() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_assistant_message("msg-1", "draft"),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-2"),
+                ev_assistant_message("msg-2", "verified"),
+                ev_completed("resp-2"),
+            ]),
+        ],
