+struct InteractiveListenOptions {
+    /// Serve this session's app server to other clients.
+    ///
+    /// Accepted forms: `unix://PATH` or `ws://IP:PORT` with a fixed port.
+    #[arg(long = "listen", value_name = "URL", value_parser = parse_interactive_listen_url)]
