index 0000000000000000000000000000000000000000..6f5862b167dc93a5474bdfff4787e7d8cc1f4880
--- /dev/null
+++ b/codex-rs/core/src/compact_intercept.rs
@@ -0,0 +1,461 @@
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use crate::compact::CompactedHistoryMetadata;
+use crate::compact::SUMMARY_PREFIX;
+use crate::compact::build_compacted_history;
+use crate::compact::build_compaction_replacement_history;
+use crate::compact::collect_annotated_user_messages;
+use crate::context::UserGoalUpdate;
+use crate::context::world_state::WorldState;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::turn_context::TurnContext;
+use codex_analytics::CompactionImplementation;
+use codex_analytics::CompactionPhase;
+use codex_analytics::CompactionReason;
+use codex_analytics::CompactionTrigger;
+use codex_extension_api::CompactionPlan;
+use codex_extension_api::CompactionReplacement;
+use codex_extension_api::CompactionSettle;
+use codex_extension_api::CompactionSettled;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::ResponseItemId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::items::ContextCompactionItem;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::TokenUsage;
+use codex_protocol::protocol::WarningEvent;
+use codex_utils_output_truncation::approx_token_count;
+
+#[derive(Clone, Copy)]
+pub(crate) struct Occurrence {
+    pub(crate) trigger: CompactionTrigger,
+    pub(crate) reason: CompactionReason,
+    pub(crate) phase: CompactionPhase,
+    pub(crate) implementation: &'static str,
+}
+
+impl Occurrence {
+    pub(crate) fn new(
+        trigger: CompactionTrigger,
+        reason: CompactionReason,
+        phase: CompactionPhase,
+        implementation: Option<CompactionImplementation>,
+    ) -> Self {
+        let implementation = match implementation {
+            Some(CompactionImplementation::Responses) => "local",
+            Some(CompactionImplementation::ResponsesCompactionV2) => "remote",
+            None => "budget",
+        };
+        Self {
+            trigger,
+            reason,
+            phase,
+            implementation,
+        }
+    }
+}
+
+pub(crate) struct Native {
+    pub(crate) summary_prompt: Option<String>,
+    settle: Option<CompactionSettle>,
+}
+
+/// A contributor skipped compaction in this turn; later automatic occurrences stay held.
+struct SkippedThisTurn {
+    by: String,
+}
+
+pub(crate) enum Plan {
+    Native(Native),
+    Held,
+    Replace(CompactionReplacement, HashSet<ResponseItemId>),
+}
+
+fn label<T: serde::Serialize>(value: T) -> String {
+    serde_json::to_value(value)
+        .ok()
+        .and_then(|value| value.as_str().map(str::to_owned))
+        .unwrap_or_default()
+}
+
+fn serialize<'a>(items: impl IntoIterator<Item = &'a ResponseItem>) -> Vec<serde_json::Value> {
+    items
+        .into_iter()
+        .filter_map(|item| serde_json::to_value(item).ok())
+        .collect()
+}
+
+/// Asks contributors how to handle this occurrence; skips and deferrals at the hard limit fail.
+pub(crate) async fn plan(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    occurrence: Occurrence,
+    summary_prompt: Option<&str>,
+) -> CodexResult<Plan> {
+    let contributors = sess.services.extensions.turn_lifecycle_contributors();
+    if contributors.is_empty() {
+        return Ok(Plan::Native(Native {
+            summary_prompt: None,
+            settle: None,
+        }));
+    }
+    let tokens = sess.get_total_token_usage().await;
+    let context_window = turn_context.model_context_window();
+    let hard = context_window.is_some_and(|window| tokens >= window);
+    if !hard
+        && matches!(occurrence.trigger, CompactionTrigger::Auto)
+        && let Some(skipped) = turn_context.extension_data.get::<SkippedThisTurn>()
+    {
+        crate::hook_runtime::notify_compaction_lifecycle(
+            sess,
+            turn_context,
+            occurrence.trigger,
+            Some(("skipped", Some(&skipped.by), false)),
+        )
+        .await;
+        return Ok(Plan::Held);
+    }
+    let snapshot = sess.clone_history().await;
+    let input_goal_ids = UserGoalUpdate::message_ids(snapshot.raw_items());
+    let history = serialize(snapshot.raw_items());
+    let (trigger, reason, phase) = (
+        label(occurrence.trigger),
+        label(occurrence.reason),
+        label(occurrence.phase),
+    );
+    for contributor in contributors {
+        let plan = contributor
+            .plan_compaction(codex_extension_api::CompactionInterceptInput {
+                turn_id: turn_context.sub_id.as_str(),
+                trigger: &trigger,
+                reason: &reason,
+                phase: &phase,
+                implementation: occurrence.implementation,
+                tokens,
+                auto_limit: turn_context.model_info().auto_compact_token_limit(),
+                context_window,
+                hard,
+                history: &history,
+                summary_prompt,
+                session_store: &sess.services.session_extension_data,
+                thread_store: &sess.services.thread_extension_data,
+                turn_store: turn_context.extension_data.as_ref(),
+            })
+            .await;
+        let (outcome, by, why) = match plan {
+            CompactionPlan::Native {
+                summary_prompt: None,
+                settle: None,
+            } => continue,
+            CompactionPlan::Native {
+                summary_prompt,
+                settle,
+            } => {
+                return Ok(Plan::Native(Native {
+                    summary_prompt,
+                    settle,
+                }));
+            }
+            CompactionPlan::Replace(replacement) => {
+                return Ok(Plan::Replace(replacement, input_goal_ids));
+            }
+            CompactionPlan::Fail(reason) => return Err(CodexErr::InvalidRequest(reason)),
+            CompactionPlan::Skip { by, reason } => ("skipped", by, reason),
+            CompactionPlan::Defer { by, reason } => ("deferred", by, reason),
+        };
+        if outcome == "skipped" {
+            turn_context
+                .extension_data
+                .insert(SkippedThisTurn { by: by.clone() });
+        }
+        if hard {
+            return Err(CodexErr::InvalidRequest(format!(
+                "compaction_required: {by} {outcome} compaction at the context limit ({why}); \
+                 fix or disable that mod, or run /compact"
+            )));
+        }
+        sess.send_event(
+            turn_context,
+            EventMsg::Warning(WarningEvent {
+                message: format!("Compaction {outcome} by {by}: {why}"),
+            }),
+        )
+        .await;
+        crate::hook_runtime::notify_compaction_lifecycle(
+            sess,
+            turn_context,
+            occurrence.trigger,
+            Some((outcome, Some(by.as_str()), false)),
+        )
+        .await;
+        return Ok(Plan::Held);
+    }
+    Ok(Plan::Native(Native {
+        summary_prompt: None,
+        settle: None,
+    }))
+}
+
+impl Native {
+    pub(crate) async fn settle(
+        self,
+        history: &[ResponseItemEnvelope],
+        summary: Option<&str>,
+        usage: Option<&TokenUsage>,
+        provider_call: bool,
+    ) -> Option<CompactionReplacement> {
+        let settle = self.settle?;
+        settle(CompactionSettled {
+            summary: summary.map(str::to_owned),
+            history: serialize(history.iter().map(|envelope| &envelope.item)),
+            provider_call,
+            usage: usage.cloned(),
+        })
+        .await
+    }
+}
+
+pub(crate) async fn install(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    (replacement_step_context, world_state): (&StepContext, &WorldState),
+    replacement: CompactionReplacement,
+    input_goal_ids: HashSet<ResponseItemId>,
+    emit_item: bool,
+) -> CodexResult<String> {
+    let (by, history, message) = match replacement {
+        CompactionReplacement::Summary { by, text } => {
+            let summary_text = format!("{SUMMARY_PREFIX}\n{text}");
+            let snapshot = sess.clone_history().await;
+            let user_messages = collect_annotated_user_messages(snapshot.annotated_items());
+            let mut history = build_compacted_history(Vec::new(), &user_messages, &summary_text);
+            if let Some(summary_item) = history.last_mut() {
+                summary_item.set_turn_id_if_missing(&turn_context.sub_id);
+            }
+            (by, history, summary_text)
+        }
+        CompactionReplacement::History { by, items } => {
+            let history = items
+                .into_iter()
+                .map(serde_json::from_value::<ResponseItem>)
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|error| {
+                    CodexErr::InvalidRequest(format!(
+                        "compaction_history_invalid: {by} returned an unreadable item: {error}"
+                    ))
+                })?;
+            let history = history.into_iter().map(ResponseItemEnvelope::new).collect();
+            (by, history, String::new())
+        }
+    };
+    let estimate: usize = history
+        .iter()
+        .map(|envelope| {
+            approx_token_count(&serde_json::to_string(&envelope.item).unwrap_or_default())
+        })
+        .sum();
+    if let Some(window) = replacement_step_context.turn.model_context_window()
+        && i64::try_from(estimate).unwrap_or(i64::MAX) >= window
+    {
+        return Err(CodexErr::InvalidRequest(format!(
+            "compaction_replacement_over_limit: {by} returned about {estimate} tokens for a \
+             {window}-token context window"
+        )));
+    }
+    let compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::new());
+    if emit_item {
+        sess.emit_turn_item_started(turn_context, &compaction_item)
+            .await;
+    }
+    let (history, world_state_baseline) = build_compaction_replacement_history(
+        sess.as_ref(),
+        replacement_step_context,
+        world_state,
+        history,
+    )
+    .await;
+    let (window_number, window_ids) = sess.advance_auto_compact_window().await;
+    sess.replace_compacted_history(
+        history,
+        replacement_step_context.to_turn_context_item(),
+        world_state_baseline,
+        CompactedHistoryMetadata {
+            input_goal_ids,
+            message,
+            window_number,
+            window_ids,
+            compaction_response_id: None,
+            compaction_model_hash: None,
+            reviewer_compaction_hash: None,
+        },
+    )
+    .await;
+    sess.recompute_token_usage(&replacement_step_context.turn)
+        .await;
+    if emit_item {
+        sess.emit_turn_item_completed(turn_context, compaction_item)
+            .await;
+    }
+    Ok(by)
+}
+
+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    use codex_extension_api::{
+        CompactionInterceptInput, CompactionLifecycleInput, ExtensionFuture,
+        TurnLifecycleContributor,
+    };
+
+    struct Skip(std::sync::Mutex<Vec<&'static str>>);
+    impl TurnLifecycleContributor for Skip {
+        fn plan_compaction<'a>(
+            &'a self,
+            _: CompactionInterceptInput<'a>,
+        ) -> ExtensionFuture<'a, CompactionPlan> {
+            Box::pin(async {
+                CompactionPlan::Skip {
+                    by: "fixture".into(),
+                    reason: "hold".into(),
+                }
+            })
+        }
+        fn on_compaction_start<'a>(
+            &'a self,
+            _: CompactionLifecycleInput<'a>,
+        ) -> ExtensionFuture<'a, ()> {
+            self.0.lock().unwrap().push("start");
+            Box::pin(async {})
+        }
+        fn on_compaction_end<'a>(
+            &'a self,
+            input: CompactionLifecycleInput<'a>,
+        ) -> ExtensionFuture<'a, ()> {
+            assert_eq!(input.outcome, Some("skipped"));
+            assert_eq!(input.by, Some("fixture"));
+            self.0.lock().unwrap().push("end");
+            Box::pin(async {})
+        }
+    }
+
+    #[tokio::test]
+    async fn replacement_compaction_preserves_goal_edits_accepted_during_planning() {
+        struct Replace {
+            started: tokio::sync::Notify,
+            proceed: tokio::sync::Notify,
+        }
+        impl TurnLifecycleContributor for Replace {
+            fn plan_compaction<'a>(
+                &'a self,
+                _: CompactionInterceptInput<'a>,
+            ) -> ExtensionFuture<'a, CompactionPlan> {
+                Box::pin(async {
+                    self.started.notify_one();
+                    self.proceed.notified().await;
+                    CompactionPlan::Replace(CompactionReplacement::History {
+                        by: "fixture".into(),
+                        items: Vec::new(),
+                    })
+                })
+            }
+        }
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let contributor = Arc::new(Replace {
+            started: tokio::sync::Notify::new(),
+            proceed: tokio::sync::Notify::new(),
+        });
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.turn_lifecycle_contributor(contributor.clone());
+        session.services.extensions = Arc::new(builder.build());
+        let (session, turn) = (Arc::new(session), Arc::new(turn));
+        session
+            .record_user_goal_update(UserGoalUpdate::Clear)
+            .await
+            .unwrap();
+        let occurrence = Occurrence::new(
+            CompactionTrigger::Auto,
+            CompactionReason::UserRequested,
+            CompactionPhase::PreTurn,
+            None,
+        );
+        let (planned, ()) = tokio::join!(plan(&session, &turn, occurrence, None), async {
+            contributor.started.notified().await;
+            session
+                .record_user_goal_update(UserGoalUpdate::Clear)
+                .await
+                .unwrap();
+            contributor.proceed.notify_one();
+        });
+        let Plan::Replace(replacement, input_goal_ids) = planned.unwrap() else {
+            panic!("expected replacement compaction");
+        };
+        assert_eq!(input_goal_ids.len(), 1);
+        let accepted_goal = session
+            .clone_history()
+            .await
+            .annotated_items()
+            .last()
+            .unwrap()
+            .clone();
+        let step = session
+            .capture_step_context(
+                Arc::clone(&turn),
+                &tokio_util::sync::CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        let world_state = session
+            .build_world_state_for_step(&step, true)
+            .await
+            .unwrap();
+        install(
+            &session,
+            &turn,
+            (&step, &world_state),
+            replacement,
+            input_goal_ids,
+            false,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            session.clone_history().await.annotated_items().last(),
+            Some(&accepted_goal)
+        );
+    }
+
+    #[tokio::test]
+    async fn skipped_and_held_compactions_pair_each_started_occurrence() {
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let observer = Arc::new(Skip(std::sync::Mutex::new(Vec::new())));
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.turn_lifecycle_contributor(observer.clone());
+        session.services.extensions = Arc::new(builder.build());
+        let (session, turn) = (Arc::new(session), Arc::new(turn));
+        for _ in 0..2 {
+            crate::hook_runtime::run_pre_compact_hooks(&session, &turn, CompactionTrigger::Auto)
+                .await;
+            let occurrence = Occurrence::new(
+                CompactionTrigger::Auto,
+                CompactionReason::UserRequested,
+                CompactionPhase::PreTurn,
+                None,
+            );
+            assert!(matches!(
+                plan(&session, &turn, occurrence, None).await.unwrap(),
+                Plan::Held
+            ));
+        }
+        assert_eq!(
+            *observer.0.lock().unwrap(),
+            vec!["start", "end", "start", "end"]
+        );
+    }
+}
diff --git a/codex-rs/core/src/session/persisted_text.rs b/codex-rs/core/src/session/persisted_text.rs
new file mode 100644
index 0000000000000000000000000000000000000000..46b8aeebd24ee65fe7107ee43c96b1451f8923ea
--- /dev/null
+++ b/codex-rs/core/src/session/persisted_text.rs
@@ -0,0 +1,626 @@
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_extension_api::PersistedText;
+use codex_extension_api::PersistedTextInput;
+use codex_extension_api::TurnLifecycleContributor;
+use codex_history::HistoryRewriteProvenance;
+use codex_history::ResponseItemEnvelope;
+use codex_history::RolloutItem;
+use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+use codex_protocol::items::AgentMessageContent;
+use codex_protocol::items::TurnItem;
+use codex_protocol::mcp::CallToolResult;
+use codex_protocol::models::AgentMessageInputContent;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::LocalShellAction;
+use codex_protocol::models::ReasoningItemContent;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::models::WebSearchAction;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::FileChange;
+use codex_protocol::protocol::ReviewOutputEvent;
+use codex_protocol::protocol::ReviewTarget;
+use codex_protocol::user_input::UserInput;
+use codex_thread_store::LiveThread;
+use codex_thread_store::ThreadStoreError;
+use codex_thread_store::ThreadStoreResult;
+use serde_json::Value;
+
+use super::Session;
+
+/// Receives each text field with its kind, role and call id; returns whether it changed the text.
+type Visit<'v> = dyn FnMut(&'static str, Option<&str>, Option<&str>, &mut String) -> bool + 'v;
+
+impl Session {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "rollout appends must stay ordered until the store accepts them"
+    )]
+    pub(crate) async fn append_rollout(
+        &self,
+        live_thread: &LiveThread,
+        items: &[RolloutItem],
+    ) -> ThreadStoreResult<()> {
+        let rewriters = self
+            .services
+            .extensions
+            .turn_lifecycle_contributors()
+            .iter()
+            .filter(|contributor| contributor.rewrites_persisted_text())
+            .cloned()
+            .collect::<Vec<_>>();
+        if rewriters.is_empty()
+            && let Ok(_order) = self.rollout_order.try_lock()
+        {
+            return live_thread.append_items(items).await;
+        }
+        let order = Arc::clone(&self.rollout_order);
+        let live_thread = live_thread.clone();
+        let items = items.to_vec();
+        let thread_id = self.thread_id().to_string();
+        // Detached, so an interrupted turn cannot drop items its live history already holds.
+        tokio::spawn(async move {
+            let _order = order.lock_owned().await;
+            let items = persisted(&rewriters, &thread_id, items).await;
+            live_thread.append_items(&items).await
+        })
+        .await
+        .map_err(|error| ThreadStoreError::Internal {
+            message: error.to_string(),
+        })?
+    }
+}
+
+async fn persisted(
+    rewriters: &[Arc<dyn TurnLifecycleContributor>],
+    thread_id: &str,
+    mut items: Vec<RolloutItem>,
+) -> Vec<RolloutItem> {
+    if rewriters.is_empty() {
+        return items;
+    }
+    let mut entries = Vec::new();
+    let unchanged = HistoryRewriteProvenance {
+        revision: String::new(),
+        op: String::new(),
+        source: None,
+        by: String::new(),
+    };
+    for item in &mut items {
+        rollout_item(item, &unchanged, &mut |kind, role, call_id, text| {
+            entries.push(PersistedText {
+                kind,
+                role: role.map(str::to_owned),
+                call_id: call_id.map(str::to_owned),
+                text: text.clone(),
+            });
+            false
+        });
+    }
+    if entries.is_empty() {
+        return items;
+    }
+    let mut by = Vec::new();
+    for rewriter in rewriters {
+        let Some(rewrite) = rewriter
+            .rewrite_persisted_text(PersistedTextInput {
+                thread_id,
+                entries: &entries,
+            })
+            .await
+        else {
+            continue;
+        };
+        if rewrite.texts.len() == entries.len() {
+            for (entry, text) in entries.iter_mut().zip(rewrite.texts) {
+                entry.text = text;
+            }
+            by.push(rewrite.by);
+        }
+    }
+    if by.is_empty() {
+        return items;
+    }
+    let provenance = HistoryRewriteProvenance {
+        revision: thread_id.to_owned(),
+        op: "redact".to_owned(),
+        source: None,
+        by: by.join(", "),
+    };
+    let mut texts = entries.into_iter().map(|entry| entry.text);
+    for item in &mut items {
+        rollout_item(item, &provenance, &mut |_, _, _, text| {
+            let Some(replacement) = texts.next() else {
+                return false;
+            };
+            let changed = *text != replacement;
+            *text = replacement;
+            changed
+        });
+    }
+    items
+}
+
+fn rollout_item(
+    item: &mut RolloutItem,
+    provenance: &HistoryRewriteProvenance,
+    visit: &mut Visit<'_>,
+) {
+    match item {
+        RolloutItem::ResponseItem(item) => envelope(item, provenance, visit),
+        RolloutItem::Compacted(compacted) => {
+            visit("compacted", None, None, &mut compacted.message);
+            for item in compacted.replacement_history.iter_mut().flatten() {
+                envelope(item, provenance, visit);
+            }
+        }
+        RolloutItem::InterAgentCommunication(communication) => {
+            visit(
+                "inter_agent_communication",
+                None,
+                None,
+                &mut communication.content,
+            );
+        }
+        RolloutItem::EventMsg(event) => event_msg(event, visit),
+        _ => {}
+    }
+}
+
+fn event_msg(event: &mut EventMsg, visit: &mut Visit<'_>) {
+    match event {
+        EventMsg::UserMessage(event) => {
+            if visit("event:user_message", Some("user"), None, &mut event.message) {
+                event.text_elements.clear();
+            }
+        }
+        EventMsg::AgentMessage(event) => {
+            visit(
+                "event:agent_message",
+                Some("assistant"),
+                None,
+                &mut event.message,
+            );
+        }
+        EventMsg::TurnComplete(event) => {
+            if let Some(message) = &mut event.last_agent_message {
+                visit("event:agent_message", Some("assistant"), None, message);
+            }
+        }
+        EventMsg::ThreadGoalUpdated(event) => {
+            visit("event:goal", Some("user"), None, &mut event.goal.objective);
+        }
+        EventMsg::AgentReasoning(event) => {
+            visit("event:reasoning", None, None, &mut event.text);
+        }
+        EventMsg::AgentReasoningRawContent(event) => {
+            visit("event:reasoning", None, None, &mut event.text);
+        }
+        EventMsg::McpToolCallEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            if let Some(arguments) = &mut event.invocation.arguments {
+                json("event:mcp_tool_call", call_id, arguments, visit);
+            }
+            match &mut event.result {
+                Ok(result) => {
+                    tool_result("event:mcp_tool_call", call_id, result, visit);
+                }
+                Err(error) => {
+                    visit("event:mcp_tool_call", None, call_id, error);
+                }
+            }
+        }
+        EventMsg::PatchApplyEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            visit("event:file_change", None, call_id, &mut event.stdout);
+            visit("event:file_change", None, call_id, &mut event.stderr);
+            changes("event:file_change", call_id, &mut event.changes, visit);
+        }
+        EventMsg::WebSearchEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            visit("event:web_search", None, call_id, &mut event.query);
+            web_search("event:web_search", call_id, &mut event.action, visit);
+            for result in event.results.iter_mut().flatten() {
+                json("event:web_search", call_id, result, visit);
+            }
+        }
+        EventMsg::ImageGenerationEnd(event) => {
+            if let Some(prompt) = &mut event.revised_prompt {
+                visit("event:image_generation", None, Some(&event.call_id), prompt);
+            }
+        }
+        EventMsg::EnteredReviewMode(event) => {
+            review_target(&mut event.target, event.user_facing_hint.as_mut(), visit);
+        }
+        EventMsg::ExitedReviewMode(event) => {
+            if let Some(output) = &mut event.review_output {
+                review_output(output, visit);
+            }
+        }
+        EventMsg::ItemCompleted(event) => turn_item(&mut event.item, visit),
+        _ => {}
+    }
+}
+
+fn turn_item(item: &mut TurnItem, visit: &mut Visit<'_>) {
+    match item {
+        TurnItem::UserMessage(message) => {
+            for input in &mut message.content {
+                if let UserInput::Text {
+                    text,
+                    text_elements,
+                } = input
+                    && visit("event:user_message", Some("user"), None, text)
+                {
+                    text_elements.clear();
+                }
+            }
+        }
+        TurnItem::AgentMessage(message) => {
+            for AgentMessageContent::Text { text } in &mut message.content {
+                visit("event:agent_message", Some("assistant"), None, text);
+            }
+        }
+        TurnItem::FunctionCallOutput(item) => {
+            body(
+                "event:function_call_output",
+                Some(&item.id),
+                &mut item.output,
+                visit,
+            );
+        }
+        TurnItem::HookPrompt(item) => {
+            for fragment in &mut item.fragments {
+                visit("event:hook_prompt", None, None, &mut fragment.text);
+            }
+        }
+        TurnItem::Plan(item) => {
+            visit("event:plan", None, None, &mut item.text);
+        }
+        TurnItem::Reasoning(item) => {
+            for text in item.summary_text.iter_mut().chain(&mut item.raw_content) {
+                visit("event:reasoning", None, None, text);
+            }
+        }
+        TurnItem::CommandExecution(item) => {
+            let call_id = Some(item.id.as_str());
+            for text in item
+                .command
+                .iter_mut()
+                .chain(&mut item.interaction_input)
+                .chain(&mut item.aggregated_output)
+            {
+                visit("event:command_execution", None, call_id, text);
+            }
+        }
+        TurnItem::DynamicToolCall(item) => {
+            let call_id = Some(item.id.as_str());
+            json(
+                "event:dynamic_tool_call",
+                call_id,
+                &mut item.arguments,
+                visit,
+            );
+            for content in item.content_items.iter_mut().flatten() {
+                if let DynamicToolCallOutputContentItem::InputText { text } = content {
+                    visit("event:dynamic_tool_call", None, call_id, text);
+                }
+            }
+            if let Some(error) = &mut item.error {
+                visit("event:dynamic_tool_call", None, call_id, error);
+            }
+        }
+        TurnItem::CollabAgentToolCall(item) => {
+            if let Some(prompt) = &mut item.prompt {
+                visit("event:collab_agent_tool_call", None, Some(&item.id), prompt);
+            }
+        }
+        TurnItem::WebSearch(item) => {
+            let call_id = Some(item.id.as_str());
+            visit("event:web_search", None, call_id, &mut item.query);
+            web_search("event:web_search", call_id, &mut item.action, visit);
+            for result in item.results.iter_mut().flatten() {
+                json("event:web_search", call_id, result, visit);
+            }
+        }
+        TurnItem::ImageGeneration(item) => {
+            if let Some(prompt) = &mut item.revised_prompt {
+                visit("event:image_generation", None, Some(&item.id), prompt);
+            }
+        }
+        TurnItem::EnteredReviewMode(item) => {
+            review_target(&mut item.target, Some(&mut item.user_facing_hint), visit);
+        }
+        TurnItem::ExitedReviewMode(item) => {
+            if let Some(output) = &mut item.review_output {
+                review_output(output, visit);
+            }
+        }
+        TurnItem::FileChange(item) => {
+            let call_id = Some(item.id.as_str());
+            changes("event:file_change", call_id, &mut item.changes, visit);
+            for text in item.stdout.iter_mut().chain(&mut item.stderr) {
+                visit("event:file_change", None, call_id, text);
+            }
+        }
+        TurnItem::McpToolCall(item) => {
+            let call_id = Some(item.id.as_str());
+            json("event:mcp_tool_call", call_id, &mut item.arguments, visit);
+            if let Some(result) = &mut item.result {
+                tool_result("event:mcp_tool_call", call_id, result, visit);
+            }
+            if let Some(error) = &mut item.error {
+                visit("event:mcp_tool_call", None, call_id, &mut error.message);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn envelope(
+    envelope: &mut ResponseItemEnvelope,
+    provenance: &HistoryRewriteProvenance,
+    visit: &mut Visit<'_>,
+) {
+    let mut changed = response_item(&mut envelope.item, visit);
+    if let Some(metadata) = envelope.metadata.as_mut() {
+        if let Some(text) = metadata.delivered_assistant_message.as_mut() {
+            changed |= visit("delivered_message", Some("assistant"), None, text);
+        }
+        if let Some(messages) = metadata.sender_user_messages.as_mut() {
+            changed |= visit(
+                "sender_user_messages",
+                Some("user"),
+                None,
+                &mut messages.text,
+            );
+        }
+    }
+    if changed {
+        envelope.metadata.get_or_insert_default().rewritten = Some(provenance.clone());
+    }
+}
+
+fn response_item(item: &mut ResponseItem, visit: &mut Visit<'_>) -> bool {
+    let mut changed = false;
+    match item {
+        ResponseItem::Message { role, content, .. } => {
+            for part in content {
+                if let ContentItem::InputText { text } | ContentItem::OutputText { text, .. } = part
+                {
+                    changed |= visit("message", Some(role), None, text);
+                }
+            }
+        }
+        ResponseItem::AgentMessage { content, .. } => {
+            for part in content {
+                if let AgentMessageInputContent::InputText { text } = part {
+                    changed |= visit("agent_message", None, None, text);
+                }
+            }
+        }
+        ResponseItem::Reasoning {
+            summary, content, ..
+        } => {
+            for ReasoningItemReasoningSummary::SummaryText { text } in summary {
+                changed |= visit("reasoning", None, None, text);
+            }
+            for ReasoningItemContent::ReasoningText { text }
+            | ReasoningItemContent::Text { text } in content.iter_mut().flatten()
+            {
+                changed |= visit("reasoning", None, None, text);
+            }
+        }
+        ResponseItem::LocalShellCall {
+            call_id,
+            action: LocalShellAction::Exec(exec),
+            ..
+        } => {
+            let environment = exec.env.iter_mut().flat_map(|env| env.values_mut());
+            for text in exec.command.iter_mut().chain(environment) {
+                changed |= visit("local_shell_call", None, call_id.as_deref(), text);
+            }
+        }
+        ResponseItem::FunctionCall {
+            arguments, call_id, ..
+        } => changed |= visit("function_call", None, Some(call_id), arguments),
+        ResponseItem::ToolSearchCall {
+            call_id, arguments, ..
+        } => changed |= json("tool_search_call", call_id.as_deref(), arguments, visit),
+        ResponseItem::CustomToolCall { input, call_id, .. } => {
+            changed |= visit("custom_tool_call", None, Some(call_id), input);
+        }
+        ResponseItem::FunctionCallOutput {
+            call_id, output, ..
+        } => {
+            changed |= body(
+                "function_call_output",
+                call_id.as_deref(),
+                &mut output.body,
+                visit,
+            );
+        }
+        ResponseItem::CustomToolCallOutput {
+            call_id, output, ..
+        } => {
+            changed |= body(
+                "custom_tool_call_output",
+                Some(call_id),
+                &mut output.body,
+                visit,
+            );
+        }
+        ResponseItem::ToolSearchOutput { call_id, tools, .. } => {
+            for tool in tools {
+                changed |= keyed(
+                    "description",
+                    "tool_search_output",
+                    call_id.as_deref(),
+                    tool,
+                    visit,
+                );
+            }
+        }
+        ResponseItem::WebSearchCall {
+            action: Some(action),
+            ..
+        } => changed |= web_search("web_search_call", None, action, visit),
+        ResponseItem::ImageGenerationCall {
+            revised_prompt: Some(prompt),
+            ..
+        } => changed |= visit("image_generation_call", None, None, prompt),
+        _ => {}
+    }
+    changed
+}
+
+fn body(
+    kind: &'static str,
+    call_id: Option<&str>,
+    body: &mut FunctionCallOutputBody,
+    visit: &mut Visit<'_>,
+) -> bool {
+    match body {
+        FunctionCallOutputBody::Text(text) => visit(kind, None, call_id, text),
+        FunctionCallOutputBody::ContentItems(items) => {
+            let mut changed = false;
+            for item in items {
+                if let FunctionCallOutputContentItem::InputText { text } = item {
+                    changed |= visit(kind, None, call_id, text);
+                }
+            }
+            changed
+        }
+    }
+}
+
+/// Every string in model-authored JSON, in document order.
+fn json(
+    kind: &'static str,
+    call_id: Option<&str>,
+    value: &mut Value,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let mut changed = false;
+    match value {
+        Value::String(text) => changed = visit(kind, None, call_id, text),
+        Value::Array(values) => {
+            for value in values {
+                changed |= json(kind, call_id, value, visit);
+            }
+        }
+        Value::Object(map) => {
+            for value in map.values_mut() {
+                changed |= json(kind, call_id, value, visit);
+            }
+        }
+        _ => {}
+    }
+    changed
+}
+
+/// The strings stored under `key` anywhere in `value`, leaving tags and identifiers alone.
+fn keyed(
+    key: &str,
+    kind: &'static str,
+    call_id: Option<&str>,
+    value: &mut Value,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let mut changed = false;
+    match value {
+        Value::Array(values) => {
+            for value in values {
+                changed |= keyed(key, kind, call_id, value, visit);
+            }
+        }
+        Value::Object(map) => {
+            for (name, value) in map {
+                changed |= match value {
+                    Value::String(text) if name == key => visit(kind, None, call_id, text),
+                    value => keyed(key, kind, call_id, value, visit),
+                };
+            }
+        }
+        _ => {}
+    }
+    changed
+}
+
+fn tool_result(
+    kind: &'static str,
+    call_id: Option<&str>,
+    result: &mut CallToolResult,
+    visit: &mut Visit<'_>,
+) {
+    for content in &mut result.content {
+        keyed("text", kind, call_id, content, visit);
+    }
+    if let Some(structured) = &mut result.structured_content {
+        json(kind, call_id, structured, visit);
+    }
+}
+
+fn changes(
+    kind: &'static str,
+    call_id: Option<&str>,
+    changes: &mut HashMap<PathBuf, FileChange>,
+    visit: &mut Visit<'_>,
+) {
+    for change in changes.values_mut() {
+        match change {
+            FileChange::Add { content } | FileChange::Delete { content } => {
+                visit(kind, None, call_id, content);
+            }
+            FileChange::Update { unified_diff, .. } => {
+                visit(kind, None, call_id, unified_diff);
+            }
+        }
+    }
+}
+
+fn web_search(
+    kind: &'static str,
+    call_id: Option<&str>,
+    action: &mut WebSearchAction,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let texts: Vec<&mut String> = match action {
+        WebSearchAction::Search { query, queries } => query
+            .iter_mut()
+            .chain(queries.iter_mut().flatten())
+            .collect(),
+        WebSearchAction::OpenPage { url } => url.iter_mut().collect(),
+        WebSearchAction::FindInPage { url, pattern } => {
+            url.iter_mut().chain(pattern.iter_mut()).collect()
+        }
+        _ => Vec::new(),
+    };
+    let mut changed = false;
+    for text in texts {
+        changed |= visit(kind, None, call_id, text);
+    }
+    changed
+}
+
+fn review_target(target: &mut ReviewTarget, hint: Option<&mut String>, visit: &mut Visit<'_>) {
+    if let ReviewTarget::Custom { instructions } = target {
+        visit("event:review", None, None, instructions);
+    }
+    if let Some(hint) = hint {
+        visit("event:review", None, None, hint);
+    }
+}
+
+fn review_output(output: &mut ReviewOutputEvent, visit: &mut Visit<'_>) {
+    for finding in &mut output.findings {
+        visit("event:review", None, None, &mut finding.title);
+        visit("event:review", None, None, &mut finding.body);
+    }
+    visit("event:review", None, None, &mut output.overall_explanation);
+}
