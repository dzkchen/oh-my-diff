+        chmod(0o644);
+        std::os::unix::fs::symlink("a.py", root.join("link")).unwrap();
+        approved.insert("link".to_owned());
+        let linked = readable.identity(&approved, 1024).unwrap();
+        assert!(linked.is_some() && linked != full);
+    }
