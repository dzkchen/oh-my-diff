+#[test]
+#[serial_test::serial]
+fn mod_session_header_suffix_and_greeting_preserve_raw_fields_and_disable_fallback() {
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    let cell = SessionHeaderHistoryCell::new(
+        "live-model".to_owned(),
+        Some(ReasoningEffortConfig::High),
+        PathBuf::from("/tmp/actual-project"),
+        "9.8.7",
+    );
+    let original = cell.raw_lines();
+    for greeting in ["", "Ready to work?"] {
+        crate::mod_ui::preview(codex_omd::ModViewSnapshot {
+            view: codex_omd::ModView::parse(
+                serde_json::json!({"session_title_suffix":" | Remote dev","greeting":greeting}),
+            )
+            .unwrap(),
+            ..Default::default()
+        });
+        let raw = cell
+            .raw_lines()
+            .iter()
+            .map(Line::to_string)
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(raw.contains("OpenAI Codex (v9.8.7) | Remote dev"), "{raw}");
+        assert!(raw.contains("model: live-model high"), "{raw}");
+        assert!(raw.contains("directory: /tmp/actual-project"), "{raw}");
+        if !greeting.is_empty() {
+            assert!(raw.contains(greeting));
+        }
+        assert!(
+            cell.display_lines(80)
+                .iter()
+                .any(|line| line.to_string().contains("Remote dev"))
+        );
+        assert!(cell.display_lines(12).iter().all(|line| line.width() <= 12));
+    }
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    assert_eq!(cell.raw_lines(), original);
+    assert!(
+        !cell
+            .display_lines(80)
+            .iter()
+            .any(|line| line.to_string().contains("Remote dev"))
+    );
+}
