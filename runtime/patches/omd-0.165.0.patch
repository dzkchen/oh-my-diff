+    /// A native choice question: the user picks, types an "Other" answer or cancels; the caller only receives the answer.
+    fn show_choice_prompt(&mut self, call: SurfaceCall) {
+        let arguments = &call.arguments;
+        let options = arguments["options"]
+            .as_array()
+            .filter(|options| (1..=32).contains(&options.len()))
+            .and_then(|options| {
+                options
+                    .iter()
+                    .map(|option| {
+                        Some((
+                            prompt_text(&option["value"], 128).ok()?,
+                            prompt_text(&option["label"], 128).ok()?,
+                        ))
+                    })
+                    .collect::<Option<Vec<_>>>()
+            });
+        let (Ok(title), Ok(message), Some(options)) = (
+            prompt_text(&arguments["title"], 120),
+            prompt_text(&arguments["message"], 2000),
+            options,
+        ) else {
+            let _ = call.reply.send(Err("terminal_prompt_invalid".into()));
+            return;
+        };
+        let multiple = arguments["multiple"] == true;
+        let other = arguments["other"] == true && !multiple;
+        let title = if call.caller == codex_omd::broker::HOST_CALLER {
+            title
+        } else {
+            format!("Mod {} asks: {title}", call.caller)
+        };
+        let held_call = call.clone();
+        let reply = std::sync::Arc::new(std::sync::Mutex::new(Some(call.reply)));
+        let answer = move |value: Value| {
+            if let Some(reply) = reply.locked().take() {
+                let _ = reply.send(crate::mod_surface::validate_call(&held_call).map(|()| value));
+            }
+        };
+        let declined = json!({"status": "declined"});
+        if multiple {
+            let (confirm, cancel) = (answer.clone(), answer);
+            let picker = crate::bottom_pane::MultiSelectPicker::builder(
+                title,
+                Some(message),
+                self.app_event_tx.clone(),
+            )
+            .items(
+                options
+                    .into_iter()
+                    .map(|(value, label)| crate::bottom_pane::MultiSelectItem {
+                        id: value,
+                        name: label,
+                        orderable: false,
+                        ..Default::default()
+                    })
+                    .collect(),
+            )
+            .on_confirm(move |values, _| confirm(json!({"status": "accepted", "values": values})))
+            .on_cancel(move |_| cancel(declined.clone()))
+            .build();
+            self.chat_widget.show_bottom_pane_view(Box::new(picker));
+            return;
+        }
+        let mut items = options
+            .into_iter()
+            .map(|(value, label)| {
+                let answer = answer.clone();
+                SelectionItem {
+                    name: label,
+                    actions: vec![Box::new(
+                        move |_: &crate::app_event_sender::AppEventSender| {
+                            answer(json!({"status": "accepted", "values": [value]}))
+                        },
+                    )],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect::<Vec<_>>();
+        if other {
+            let validity = call.validity.clone();
+            let lifetime = call.lifetime.clone();
+            let (answer, caller, context, thread, question) = (
+                answer.clone(),
+                call.caller.clone(),
+                call.context,
+                call.thread.clone(),
+                title.clone(),
+            );
+            items.push(SelectionItem {
+                name: "Other…".into(),
+                actions: vec![Box::new(move |tx: &crate::app_event_sender::AppEventSender| {
+                    let (reply, typed) = std::sync::mpsc::sync_channel::<Result<Value, String>>(1);
+                    let answer = answer.clone();
+                    std::thread::spawn(move || {
+                        answer(match typed.recv() {
+                            Ok(Ok(typed)) if typed["status"] == "accepted" => {
+                                json!({"status": "accepted", "values": [typed["value"]], "other": true})
+                            }
+                            _ => json!({"status": "declined"}),
+                        });
+                    });
+                    tx.send(AppEvent::ModSurfaceCall(Box::new(SurfaceCall {
+                        validity: validity.clone(),
+                        caller: caller.clone(),
+                        operation: "terminal.prompt".into(),
+                        arguments: json!({"kind": "text", "title": "Other", "message": question}),
+                        context,
+                        remote: false,
+                        thread: thread.clone(),
+                        authority: None,
+                        confirm: None,
+                        reply,
+                        lifetime: lifetime.clone(),
+                        depth: 0,
+                    }), None));
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(title),
+            subtitle: Some(message),
+            items,
+            on_cancel: Some(Box::new(
+                move |_: &crate::app_event_sender::AppEventSender| answer(declined.clone()),
+            )),
+            ..SelectionViewParams::picker()
+        });
+    }
