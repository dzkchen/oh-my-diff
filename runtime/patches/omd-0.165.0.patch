+fn strip_private(value: &mut Value) {
+    match value {
+        Value::Object(fields) => {
+            fields.remove("encrypted_content");
+            fields.remove("internal_chat_message_metadata_passthrough");
+            for child in fields.values_mut() {
+                strip_private(child);
+            }
+        }
+        Value::Array(items) => {
+            for child in items {
+                strip_private(child);
+            }
+        }
+        _ => (),
+    }
+}
