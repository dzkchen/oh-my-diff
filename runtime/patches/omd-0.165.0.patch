+    assert_eq!(
+        index.call("sessions.list", json!({}), || true).unwrap()["sessions"],
+        json!([])
+    );
+    assert!(
+        index
+            .call(
+                "sessions.read",
+                json!({"session_id":"session-a","revision":old["revision"],"handle":old["handle"]}),
