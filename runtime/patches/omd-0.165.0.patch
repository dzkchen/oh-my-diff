new file mode 100644
index 0000000000000000000000000000000000000000..7f016fb395d63716bdf94a2f8baae584523289b8
--- /dev/null
+++ b/codex-rs/omd/src/frame_metrics.rs
@@ -0,0 +1,73 @@
+use std::fs::File;
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+use std::time::Instant;
+
+static TRACE: LazyLock<Option<Mutex<File>>> = LazyLock::new(|| {
+    let path = std::env::var_os("OMD_FRAME_TRACE")?;
+    File::options()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+        .ok()
+        .map(Mutex::new)
+});
+
+fn cpu() -> u64 {
+    let mut time = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    unsafe {
+        libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut time);
+    }
+    time.tv_sec as u64 * 1_000_000_000 + time.tv_nsec as u64
+}
+
+pub struct Stage {
+    stage: &'static str,
+    start: Option<(Instant, u64)>,
+}
+
+pub fn stage(name: &'static str) -> Stage {
+    Stage {
+        stage: name,
+        start: TRACE.as_ref().map(|_| (Instant::now(), cpu())),
+    }
+}
+
+impl Drop for Stage {
+    fn drop(&mut self) {
+        if let Some((start, before)) = self.start {
+            record(
+                self.stage,
+                start.elapsed().as_nanos(),
+                cpu().saturating_sub(before),
+            );
+        }
+    }
+}
+
+pub fn waited(name: &'static str, deadline: Instant) {
+    if TRACE.is_some() {
+        record(name, deadline.elapsed().as_nanos(), 0);
+    }
+}
+
+fn record(name: &str, wall: u128, used: u64) {
+    if let Some(trace) = TRACE.as_ref()
+        && let Ok(mut file) = trace.lock()
+    {
+        let at = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |time| time.as_nanos());
+        let _ = writeln!(
+            file,
+            "{{\"stage\":\"{}\",\"wall_ns\":{},\"cpu_ns\":{},\"at_ns\":{}}}",
+            name, wall, used, at
+        );
+    }
+}
diff --git a/codex-rs/omd/src/fsio.rs b/codex-rs/omd/src/fsio.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f08500cadea6fc511d7d581bcde993890135bcfa
--- /dev/null
+++ b/codex-rs/omd/src/fsio.rs
@@ -0,0 +1,101 @@
+//! The host's one file writer: every write stages a 0600 temporary beside the target and renames it over, so a crash
+//! leaves the old or the new file, never a torn one.
+
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+
+/// Staging files start with this; directory scans skip them.
+pub const STAGING_PREFIX: &str = ".tmp";
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Durability {
+    /// The data and the rename survive power loss: the file and its directory are synced.
+    Durable,
+    /// Crash consistency without durability: a write barrier orders the data before the rename (mod state, stored data, exec output, cost snapshots).
+    Ordered,
+    /// Atomic but unsynced: a crash leaves the old or new file, power loss may lose the write.
+    Volatile,
+}
+
+/// Replaces `path` with `value` as JSON, durably.
+pub fn write_json(path: &Path, value: &impl serde::Serialize) -> io::Result<()> {
+    write_bytes(path, &serde_json::to_vec(value)?, Durability::Durable)
+}
+
+pub fn write_bytes(path: &Path, bytes: &[u8], durability: Durability) -> io::Result<()> {
+    write_bytes_before(path, bytes, durability, || Ok(()))
+}
+
+/// Replaces `path`, running `before_replace` once the bytes are staged; its error leaves `path` untouched.
+pub fn write_bytes_before(
+    path: &Path,
+    bytes: &[u8],
+    durability: Durability,
+    before_replace: impl FnOnce() -> io::Result<()>,
+) -> io::Result<()> {
+    let (parent, file) = staged(path, bytes, durability)?;
+    before_replace()?;
+    file.persist(path).map_err(|error| error.error)?;
+    if durability == Durability::Durable {
+        fs::File::open(parent)?.sync_all()?;
+    }
+    Ok(())
+}
+
+/// Creates `path` durably, failing if it exists; the file is removed again if its directory can't be synced.
+pub fn create_new(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let (parent, file) = staged(path, bytes, Durability::Durable)?;
+    file.persist_noclobber(path).map_err(|error| error.error)?;
+    fs::File::open(parent)
+        .and_then(|parent| parent.sync_all())
+        .inspect_err(|_| {
+            let _ = fs::remove_file(path);
+        })
+}
+
+fn staged<'a>(
+    path: &'a Path,
+    bytes: &[u8],
+    durability: Durability,
+) -> io::Result<(&'a Path, tempfile::NamedTempFile)> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::other("write_parent_missing"))?;
+    let mut file = tempfile::Builder::new()
+        .prefix(STAGING_PREFIX)
+        .tempfile_in(parent)?;
+    file.write_all(bytes)?;
+    match durability {
+        Durability::Durable => file.as_file().sync_all()?,
+        Durability::Ordered => barrier(file.as_file())?,
+        Durability::Volatile => {}
+    }
+    Ok((parent, file))
+}
+
+fn barrier(file: &fs::File) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    #[cfg(target_os = "macos")]
+    // SAFETY: `file` owns an open descriptor for the duration of the call.
+    let status = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_BARRIERFSYNC) };
+    #[cfg(not(target_os = "macos"))]
+    // SAFETY: `file` owns an open descriptor for the duration of the call.
+    let status = unsafe { libc::fsync(file.as_raw_fd()) };
+    match status {
+        -1 => Err(io::Error::last_os_error()),
+        _ => Ok(()),
+    }
+}
+
+/// Durably replaces `path` unless it already holds exactly `bytes`.
+pub fn write_if_changed(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let unchanged = fs::symlink_metadata(path)
+        .is_ok_and(|metadata| metadata.is_file() && metadata.len() == bytes.len() as u64)
+        && fs::read(path).is_ok_and(|existing| existing == bytes);
+    if unchanged {
+        return Ok(());
+    }
+    write_bytes(path, bytes, Durability::Durable)
+}
diff --git a/codex-rs/omd/src/history.rs b/codex-rs/omd/src/history.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e8f4632d0e873b0fec7c45e5685adb135b705951
--- /dev/null
+++ b/codex-rs/omd/src/history.rs
@@ -0,0 +1,291 @@
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+
+pub const PREVIEW_BYTES: usize = 2048;
+pub const VIEW_ITEMS: usize = 2048;
+pub const EDIT_BYTES: usize = 262_144;
+
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HistoryEdit {
+    #[serde(default)]
+    drop: Vec<usize>,
+    #[serde(default)]
+    replace: Vec<Replace>,
+    #[serde(default)]
+    insert: Vec<Insert>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Replace {
+    index: usize,
+    text: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Insert {
+    before: usize,
+    role: String,
+    text: String,
+}
+
+fn text(item: &Value) -> Option<String> {
+    match item["type"].as_str()? {
+        "message" => Some(
+            item["content"]
+                .as_array()?
+                .iter()
+                .filter_map(|part| part["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n"),
+        ),
+        "function_call_output" | "custom_tool_call_output" => match &item["output"] {
+            Value::String(text) => Some(text.clone()),
+            other => Some(other.to_string()),
+        },
+        "function_call" => item["arguments"].as_str().map(str::to_owned),
+        "custom_tool_call" => item["input"].as_str().map(str::to_owned),
+        _ => None,
+    }
+}
+
+fn images(item: &Value) -> usize {
+    ["content", "output"]
+        .iter()
+        .filter_map(|field| item[*field].as_array())
+        .flatten()
+        .filter(|part| part["type"] == "input_image")
+        .count()
+}
+
+fn editable(item: &Value) -> bool {
+    text(item).is_some()
+        && item.get("encrypted_content").is_none()
+        && item["content"].as_array().is_none_or(|parts| {
+            parts.iter().all(|part| {
+                matches!(
+                    part["type"].as_str(),
+                    Some("input_text" | "output_text" | "input_image")
+                )
+            })
+        })
+}
+
+fn call_id(item: &Value) -> Option<&str> {
+    item["call_id"].as_str()
+}
+
+fn preview(text: &str) -> &str {
+    &text[..text.floor_char_boundary(PREVIEW_BYTES)]
+}
+
+pub fn view(items: &[Value]) -> Value {
+    let start = items.len().saturating_sub(VIEW_ITEMS);
+    Value::Array(
+        items
+            .iter()
+            .enumerate()
+            .skip(start)
+            .map(|(index, item)| {
+                let body = text(item);
+                json!({"index": index, "type": item["type"], "role": item.get("role"),
+                    "call_id": call_id(item), "editable": editable(item) && index + 1 < items.len(),
+                    "images": images(item),
+                    "text": body.as_deref().map(preview), "bytes": body.map_or(0, |body| body.len())})
+            })
+            .collect(),
+    )
+}
+
+const COMPACTION_PREVIEW_BYTES: usize = 512;
+const COMPACTION_VIEW_ITEMS: usize = 1024;
+const COMPACTION_VIEW_TEXT: usize = 131_072;
+
+pub fn compaction_view(items: &[Value]) -> Value {
+    let start = items.len().saturating_sub(COMPACTION_VIEW_ITEMS);
+    let mut budget = COMPACTION_VIEW_TEXT;
+    let mut view = items
+        .iter()
+        .enumerate()
+        .skip(start)
+        .rev()
+        .map(|(index, item)| {
+            let body = text(item);
+            let preview = body.as_deref().map(|body| {
+                &body[..body.floor_char_boundary(COMPACTION_PREVIEW_BYTES.min(budget))]
+            });
+            budget -= preview.map_or(0, str::len);
+            json!({"index": index, "type": item["type"], "role": item.get("role"),
+                "call_id": call_id(item), "editable": editable(item), "images": images(item),
+                "text": preview, "bytes": body.as_deref().map_or(0, str::len)})
+        })
+        .collect::<Vec<_>>();
+    view.reverse();
+    Value::Array(view)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CompactionEdit {
+    keep: Vec<usize>,
+    #[serde(default)]
+    insert: Vec<Insert>,
+}
+
+pub fn compact(items: &[Value], edit: CompactionEdit) -> Result<Vec<Value>, String> {
+    let invalid = |reason: &str| Err(format!("compaction_history_invalid: {reason}"));
+    let bytes = edit.insert.iter().map(|i| i.text.len()).sum::<usize>();
+    if bytes > EDIT_BYTES || edit.keep.len() + edit.insert.len() > 4096 {
+        return invalid("limit");
+    }
+    let kept: BTreeSet<usize> = edit.keep.iter().copied().collect();
+    if kept.iter().any(|&index| index >= items.len()) {
+        return invalid("keep");
+    }
+    let reasoning = |index: usize| items[index]["type"] == "reasoning";
+    for &index in &kept {
+        if reasoning(index) && !kept.contains(&(index + 1)) {
+            return invalid("reasoning_pair");
+        }
+        if index > 0 && reasoning(index - 1) && !kept.contains(&(index - 1)) {
+            return invalid("reasoning_pair");
+        }
+        if let Some(id) = call_id(&items[index])
+            && items
+                .iter()
+                .enumerate()
+                .any(|(other, item)| call_id(item) == Some(id) && !kept.contains(&other))
+        {
+            return invalid("unpaired_call");
+        }
+    }
+    let mut inserted: BTreeMap<usize, Vec<Value>> = BTreeMap::new();
+    for insert in edit.insert {
+        if insert.before > items.len()
+            || !matches!(insert.role.as_str(), "user" | "developer")
+            || insert.text.trim().is_empty()
+        {
+            return invalid("insert");
+        }
+        if insert.before > 0 && reasoning(insert.before - 1) && kept.contains(&(insert.before - 1))
+        {
+            return invalid("reasoning_pair");
+        }
+        inserted
+            .entry(insert.before)
+            .or_default()
+            .push(json!({"type": "message",
+            "role": insert.role, "content": [{"type": "input_text", "text": insert.text}]}));
+    }
+    let mut result = Vec::new();
+    for (index, item) in items.iter().enumerate() {
+        result.extend(inserted.remove(&index).unwrap_or_default());
+        if kept.contains(&index) {
+            result.push(item.clone());
+        }
+    }
+    result.extend(inserted.remove(&items.len()).unwrap_or_default());
+    if result.is_empty() {
+        return invalid("empty");
+    }
+    Ok(result)
+}
+
+pub fn apply(items: &[Value], edit: HistoryEdit) -> Result<Vec<Value>, String> {
+    let invalid = |reason: &str| Err(format!("history_edit_invalid: {reason}"));
+    let last = items.len().checked_sub(1).ok_or("history_empty")?;
+    let bytes = edit.replace.iter().map(|r| r.text.len()).sum::<usize>()
+        + edit.insert.iter().map(|i| i.text.len()).sum::<usize>();
+    if bytes > EDIT_BYTES || edit.drop.len() + edit.replace.len() + edit.insert.len() > 4096 {
+        return invalid("limit");
+    }
+    let dropped: BTreeSet<usize> = edit.drop.iter().copied().collect();
+    let mut replaced = BTreeMap::new();
+    for replace in edit.replace {
+        if replace.index >= last
+            || !editable(&items[replace.index])
+            || dropped.contains(&replace.index)
+            || replaced.insert(replace.index, replace.text).is_some()
+        {
+            return invalid("replace");
+        }
+    }
+    let reasoning = |index: usize| {
+        items
+            .get(index)
+            .is_some_and(|item| item["type"] == "reasoning")
+    };
+    for &index in &dropped {
+        let item = items.get(index).ok_or("history_edit_invalid: drop")?;
+        let droppable = if reasoning(index) {
+            dropped.contains(&(index + 1))
+        } else {
+            editable(item) || call_id(item).is_some()
+        };
+        if index >= last || !droppable {
+            return invalid("drop");
+        }
+        if index > 0 && reasoning(index - 1) && !dropped.contains(&(index - 1)) {
+            return invalid("reasoning_pair");
+        }
+        if let Some(id) = call_id(item)
+            && items
+                .iter()
+                .enumerate()
+                .any(|(other, item)| call_id(item) == Some(id) && !dropped.contains(&other))
+        {
+            return invalid("unpaired_call");
+        }
+    }
+    let mut inserted: BTreeMap<usize, Vec<Value>> = BTreeMap::new();
+    for insert in edit.insert {
+        if insert.before > last || !matches!(insert.role.as_str(), "user" | "developer") {
+            return invalid("insert");
+        }
+        if insert.before > 0
+            && reasoning(insert.before - 1)
+            && !dropped.contains(&(insert.before - 1))
+        {
+            return invalid("reasoning_pair");
+        }
+        inserted
+            .entry(insert.before)
+            .or_default()
+            .push(json!({"type": "message",
+            "role": insert.role, "content": [{"type": "input_text", "text": insert.text}]}));
+    }
+    let mut result = Vec::with_capacity(items.len());
+    for (index, item) in items.iter().enumerate() {
+        result.extend(inserted.remove(&index).unwrap_or_default());
+        if dropped.contains(&index) {
+            continue;
+        }
+        let mut item = item.clone();
+        if let Some(text) = replaced.remove(&index) {
+            match item["type"].as_str() {
+                Some("message") => {
+                    let kind = if item["role"] == "assistant" {
+                        "output_text"
+                    } else {
+                        "input_text"
+                    };
+                    item["content"] = json!([{"type": kind, "text": text}]);
+                }
+                Some("function_call") => item["arguments"] = Value::String(text),
+                Some("custom_tool_call") => item["input"] = Value::String(text),
+                _ => item["output"] = Value::String(text),
+            }
+        }
+        result.push(item);
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
