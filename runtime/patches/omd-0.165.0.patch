+        .package_apply(install(&allowed, "allowed"), &plan.confirmation)
+        .unwrap();
+    store.package_enable("allowed").unwrap();
+    admin.write_policy(json!({"schema": 1, "updates": "managed",
+        "sources": [admin.root.join("allowed").display().to_string()]}));
