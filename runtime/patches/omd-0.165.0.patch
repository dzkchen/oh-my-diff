+/// Outermost first: `before`/`after`, then consumers outside dependencies, then ID; a cycle fails only the mods declaring its edges.
+pub(super) fn order(
+    loaded: &BTreeMap<String, Loaded>,
+) -> std::result::Result<Vec<String>, Vec<String>> {
+    let ids = loaded
+        .iter()
+        .filter(|(_, m)| m.error.is_none() && !m.registrations.interceptors.is_empty())
+        .map(|(id, _)| id.clone())
+        .collect::<Vec<_>>();
+    fn height(loaded: &BTreeMap<String, Loaded>, id: &str, depth: usize) -> usize {
+        let Some(m) = loaded.get(id).filter(|_| depth < 32) else {
+            return 0;
+        };
+        m.package
+            .dependencies
+            .iter()
+            .map(|dependency| height(loaded, &dependency.id, depth + 1) + 1)
+            .max()
+            .unwrap_or(0)
+    }
+    let mut edges = BTreeSet::new();
+    for id in &ids {
+        for interceptor in &loaded[id].registrations.interceptors {
+            for other in interceptor
+                .before
+                .iter()
+                .filter(|other| ids.contains(other))
+            {
+                edges.insert((id.clone(), other.clone(), id.clone()));
+            }
+            for other in interceptor.after.iter().filter(|other| ids.contains(other)) {
+                edges.insert((other.clone(), id.clone(), id.clone()));
+            }
+        }
+    }
+    let mut remaining = ids;
+    let mut sorted = Vec::new();
+    while !remaining.is_empty() {
+        let next = remaining
+            .iter()
+            .filter(|id| {
+                !edges
+                    .iter()
+                    .any(|(from, to, _)| to == *id && remaining.contains(from))
+            })
+            .min_by_key(|id| (std::cmp::Reverse(height(loaded, id, 0)), (*id).clone()))
+            .cloned();
+        let Some(next) = next else {
+            let reaches = |start: &String, goal: &String| {
+                let (mut seen, mut queue) = (BTreeSet::from([start]), vec![start]);
+                while let Some(node) = queue.pop() {
+                    for (_, to, _) in edges
+                        .iter()
+                        .filter(|(from, to, _)| from == node && remaining.contains(to))
+                    {
+                        if to == goal {
+                            return true;
+                        }
+                        if seen.insert(to) {
+                            queue.push(to);
+                        }
+                    }
+                }
+                false
+            };
+            let declarers = edges
+                .iter()
+                .filter(|(from, to, _)| remaining.contains(from) && reaches(to, from))
+                .map(|(_, _, declarer)| declarer.clone())
+                .collect::<BTreeSet<_>>();
+            return Err(declarers.into_iter().collect());
+        };
+        remaining.retain(|id| *id != next);
+        sorted.push(next);
+    }
+    Ok(sorted)
+}
