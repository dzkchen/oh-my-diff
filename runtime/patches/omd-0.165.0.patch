+type MarkdownKey = (
+    u64,
+    u16,
+    u64,
+    Option<(u8, u8, u8)>,
+    Option<(u8, u8, u8)>,
+    crate::terminal_palette::StdoutColorLevel,
+);
+type MarkdownEntry = (MarkdownKey, usize, Arc<[HyperlinkLine]>);
+static MARKDOWN: Mutex<Vec<MarkdownEntry>> = Mutex::new(Vec::new());
+const MARKDOWN_ENTRIES: usize = 256;
+const MARKDOWN_BYTES: usize = 1024 * 1024;
+
+fn markdown_weight(lines: &[HyperlinkLine]) -> usize {
+    lines
+        .iter()
+        .map(|line| {
+            let spans = line
+                .line
+                .spans
+                .iter()
+                .map(|span| 64 + span.content.len())
+                .sum::<usize>();
+            96 + spans + 96 * line.hyperlinks.len()
+        })
+        .sum()
+}
+
+/// The most recently drawn markdown renders, so a draw re-parses only changed or resized text.
+fn markdown_lines(text: &str, width: u16) -> Arc<[HyperlinkLine]> {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    let key = (
+        hasher.finish(),
+        width,
+        crate::render::highlight::syntax_theme_revision(),
+        crate::terminal_palette::default_fg(),
+        crate::terminal_palette::default_bg(),
+        crate::terminal_palette::stdout_color_level(),
+    );
+    {
+        let mut cache = MARKDOWN.locked();
+        if let Some(index) = cache.iter().position(|(cached, _, _)| *cached == key) {
+            let entry = cache.remove(index);
+            let lines = Arc::clone(&entry.2);
+            cache.push(entry);
+            return lines;
+        }
+    }
+    let lines: Arc<[HyperlinkLine]> = crate::markdown::render_markdown_agent_with_list_spacing(
+        text,
+        Some(usize::from(width)),
+        None,
+        None,
+        crate::markdown_render::ListSpacing::AfterMultiline,
+    )
+    .into();
+    let mut cache = MARKDOWN.locked();
+    cache.retain(|(cached, _, _)| *cached != key);
+    cache.push((key, markdown_weight(&lines), Arc::clone(&lines)));
+    let mut bytes = cache.iter().map(|(_, bytes, _)| bytes).sum::<usize>();
+    while cache.len() > MARKDOWN_ENTRIES || (cache.len() > 1 && bytes > MARKDOWN_BYTES) {
+        bytes -= cache.remove(0).1;
+    }
+    lines
+}
+static BLOCKED_SNAPSHOT: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+
+static APPLIED_PLACEHOLDER: Mutex<Option<Option<String>>> = Mutex::new(None);
+
+pub(crate) fn sync_placeholder() -> Option<Option<String>> {
+    let current = with_cache(|cache| cache.snapshot.view.placeholder.clone()).flatten();
+    let mut applied = APPLIED_PLACEHOLDER.locked();
+    if applied.as_ref() == Some(&current) {
+        return None;
+    }
+    *applied = Some(current.clone());
+    Some(current)
+}
