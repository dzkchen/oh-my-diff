+fn register_keys(interaction: &mut Interaction, id: &str, keys: ModKeys) {
+    if !keys.is_off() {
+        interaction.key_panes.insert(id.to_owned());
+    }
+    if keys == ModKeys::All {
+        interaction.all_keys.insert(id.to_owned());
+    }
+}
