+        source: ModPackageSource::Local {
+            path: path.to_path_buf(),
+        },
+        index: None,
+        scope: "user".into(),
+        offline: false,
+        trust: ModPackageTrust {
+            packages: BTreeMap::from([(
+                id.to_owned(),
+                ModPackageGrant {
+                    capabilities: vec!["interception".into()],
+                    dependencies: false,
+                    lifecycle: Vec::new(),
+                    secret_environment: Vec::new(),
+                },
+            )]),
