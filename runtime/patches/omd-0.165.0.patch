+pub(crate) fn composer_edit(
+    source: &str,
+    caller: &str,
+    revision: u64,
+    edit: Value,
+) -> Result<Value, String> {
+    let thread = crate::mod_surface::current_thread();
+    let input = || serde_json::json!({"source": source, "caller": caller, "revision": revision, "edit": edit});
+    let result = match intercept_within(
+        "composer_edit",
+        input,
+        serde_json::json!({"caller": caller, "thread_id": thread}),
+        &mut |effective| Ok(serde_json::json!({"edit": effective["edit"]})),
+    ) {
+        Err(error)
+            if source != "mod"
+                && remembered_intercept("composer_edit", None) == Some(false)
+                && ["mod_runtime_busy", "callback_cancelled"]
+                    .iter()
+                    .any(|skipped| error.starts_with(skipped)) =>
+        {
+            crate::mod_ui::notice(
+                "omd",
+                Some("composer_edit"),
+                "warning",
+                crate::mod_ui::NoticePlacement::Status,
+                &format!("Edit interception skipped: {error}"),
+                std::time::Duration::from_secs(5),
+            );
+            return Ok(edit);
+        }
+        result => result?,
+    };
+    match result {
+        None => Ok(edit),
+        Some(result) => match result["deny"].as_str() {
+            Some(reason) => Err(format!("composer_edit_denied: {reason}")),
+            None => Ok(result["edit"].clone()),
+        },
+    }
+}
