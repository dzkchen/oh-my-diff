+static KNOWN_INTERCEPTS: Mutex<BTreeMap<String, Option<bool>>> = Mutex::new(BTreeMap::new());
+
+/// Never waits for a busy runtime, except within the keystroke budget for a surface never looked up.
+pub(crate) fn intercepts(surface: &str) -> bool {
+    if !crate::omd::mod_paths().is_some_and(|paths| paths.store.is_some()) {
+        return false;
+    }
+    let wait = if KNOWN_INTERCEPTS.locked().contains_key(surface) {
+        Duration::ZERO
+    } else {
+        KEY_BUDGET
+    };
+    let fresh = lock_within(&HOST, Duration::ZERO)
+        .and_then(|host| host.clone())
+        .and_then(|runtime| lock_within(&runtime, wait).map(|runtime| runtime.intercepts(surface)));
+    remembered_intercept(surface, fresh).is_some()
+}
+
+/// A busy runtime answers from the last lookup; a surface never looked up fails closed as if a required interceptor selected it.
+fn remembered_intercept(surface: &str, fresh: Option<Option<bool>>) -> Option<bool> {
+    let mut known = KNOWN_INTERCEPTS.locked();
+    match fresh {
+        Some(intercepts) => {
+            known.insert(surface.to_owned(), intercepts);
+            intercepts
+        }
+        None => known.get(surface).copied().unwrap_or(Some(true)),
+    }
+}
