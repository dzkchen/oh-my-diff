+    );
+    assert_eq!(
+        call(&mut restored, "required", "call"),
+        json!("provider:hello")
+    );
+    assert!(
+        std::fs::read_to_string(&types)
+            .unwrap()
+            .contains("'shared.echo@1.0.0'")
+    );
+}
