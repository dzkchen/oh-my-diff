+    };
+    std::fs::read(store.join("host.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .and_then(|config| config["routes"].as_array().cloned())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|route| {
+            route["roles"]
+                .as_array()
+                .is_some_and(|roles| roles.iter().any(|role| role == "lead"))
+        })
+        .filter_map(|route| {
