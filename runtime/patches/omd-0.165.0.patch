+            .is_some_and(|name| name.trim().is_empty() || name.len() > 64)
+        {
+            return Err("provider_name_invalid".into());
+        }
+        let mut models = Vec::with_capacity(input.models.len());
+        for model in input.models {
+            if model.slug.is_empty()
