+#[cfg(test)]
+pub(crate) fn test_completion_registrations(id: &str, trigger: &str) -> impl Drop {
+    struct Restore(Option<State>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            *STATE.locked() = self.0.take();
+        }
+    }
+    Restore(STATE.locked().replace(State {
+        checked: Some(Instant::now()),
+        completers: [id.to_owned()].into(),
+        triggers: [(trigger.to_owned(), id.to_owned())].into(),
+        ..Default::default()
+    }))
+}
