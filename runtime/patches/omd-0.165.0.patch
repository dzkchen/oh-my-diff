+fn command(core: &Core, id: &str, name: &str) -> Value {
+    let mut runtime = core.runtime.lock().unwrap();
+    let generation = runtime.generation();
+    runtime
+        .invoke_with(
+            id,
+            generation,
+            "command",
+            name,
+            Value::Null,
+            || true,
+            |_| Err(std::io::Error::other("unexpected_host_call")),
+        )
+        .unwrap()
+}
