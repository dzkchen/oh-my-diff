+    let path = package(&root, "incompatible", "export default () => {}", &[]);
+    let manifest_path = path.join("mod.json");
+    let base: Value = serde_json::from_slice(&std::fs::read(&manifest_path).unwrap()).unwrap();
+    for (field, value, expected) in [
