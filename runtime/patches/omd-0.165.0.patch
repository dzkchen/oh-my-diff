+        let value = Value::deserialize(deserializer)?;
+        if let Some(object) = value.as_object()
+            && object.keys().map(String::as_str).collect::<BTreeSet<_>>()
+                == BTreeSet::from(["action", "label"])
+        {
+            return Ok(Self {
