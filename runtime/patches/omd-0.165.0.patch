+impl Drop for Running {
+    fn drop(&mut self) {
+        if let Ok(mut running) = RUNNING.lock()
+            && let Some(count) = running.get_mut(&self.0)
+        {
+            *count = count.saturating_sub(1);
+        }
+    }
+}
