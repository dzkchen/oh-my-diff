+            let literal = serde_json::to_string(&path.to_string_lossy())
+                .map_err(|error| error.to_string())?;
+            profile.push_str(&format!(
+                "\n(deny file-read* file-write* (literal {literal}) (subpath {literal}))"
+            ));
+        }
+    }
+    Ok(())
+}
