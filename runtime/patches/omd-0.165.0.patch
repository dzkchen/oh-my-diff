+pub(crate) fn replaceable_tool_output(
+    invocation: &ToolInvocation,
+    output: &dyn ToolOutput,
+) -> Option<String> {
+    let thread_store = &invocation.session.services.thread_extension_data;
+    if !invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+        .iter()
+        .any(|contributor| contributor.replacing(thread_store))
