+
+pub(crate) fn host_call(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+    scope: &crate::mod_runtime::CallScope<'_>,
+) -> std::io::Result<Value> {
+    let other = std::io::Error::other;
+    let operation = call.operation.as_str();
+    let context = scope.context;
+    if codex_omd::client_surface::SURFACE_OPERATIONS.contains(&operation) {
+        let _authority = grants.as_ref().map(|grants| {
+            let mut authority = grants.surface_authority.clone();
+            authority.epoch = scope.epoch;
+            authority.enter()
+        });
+        let thread = scope.thread.map(str::to_owned).or_else(current_thread);
+        let grants = grants.ok_or_else(|| other("host_caller_inactive"))?;
+        let runtime = crate::mod_runtime::shared_host().map_err(std::io::Error::other)?;
+        let generation = runtime.locked().generation();
+        let source = grants.source_sha256.clone();
+        let admitted_source = source.clone();
+        let capabilities = grants.capabilities.clone();
+        let id = caller.to_owned();
+        let continued = scope.active.clone();
+        let active: std::sync::Arc<dyn Fn() -> bool + Send + Sync> =
+            std::sync::Arc::new(move || {
+                if !continued() {
+                    return false;
+                }
+                let mut runtime = runtime.locked();
+                if runtime.reload().is_err() {
+                    return false;
+                }
+                runtime.generation() == generation
+                    && runtime.grants(&id).is_some_and(|grants| {
+                        grants.source_sha256 == source && grants.capabilities == capabilities
+                    })
+            });
+        return codex_omd::client_surface::with_admission(
+            &admitted_source,
+            generation,
+            None,
+            || {
+                if operation == "app.request" {
+                    return codex_omd::client_surface::app_request(
+                        caller,
+                        &grants.capabilities,
+                        context,
+                        false,
+                        thread.as_deref(),
+                        &paths.repository,
+                        &configured_routes(paths),
+                        call.arguments,
+                        active,
+                    )
+                    .map_err(std::io::Error::other);
+                }
+                codex_omd::client_surface::call(
+                    caller,
+                    operation,
+                    call.arguments,
+                    context,
+                    false,
+                    thread.as_deref(),
+                    None,
+                    active,
+                )
+                .map_err(std::io::Error::other)
+            },
+        );
+    }
+    match operation {
+        "environment.set" | "environment.read" | "exec.run" => {
+            let thread = scope.thread.map(str::to_owned).or_else(current_thread);
+            let scoped = crate::mod_runtime::CallScope {
+                epoch: scope.epoch,
+                context: scope.context,
+                thread: thread.as_deref(),
+                active: scope.active.clone(),
+            };
+            crate::mod_runtime::command_host_guarded(paths, policy, grants, caller, call, &scoped)
+        }
+        "app.routes" => Ok(codex_omd::app_routes::routes()),
+        "model.complete" | "model.fork" | "session.info" | "tools.list" | "turns.abort" => {
+            let thread = scope
+                .thread
+                .map(str::to_owned)
+                .or_else(current_thread)
+                .ok_or_else(|| other("model_call_requires_a_session_thread"))?;
+            let grants = grants.ok_or_else(|| other("host_caller_inactive"))?;
+            codex_omd::host::session_call(
+                &thread,
+                caller,
+                Some(&grants.source_sha256),
+                None,
+                call,
+                scope.active.as_ref(),
+            )
+        }
+        "turns.activity" => {
+            let thread = scope
+                .thread
+                .map(str::to_owned)
+                .or_else(current_thread)
+                .ok_or_else(|| other("turn_activity_unavailable"))?;
+            codex_omd::turn_activity::read_registered(&thread, call.arguments)
+                .map_err(std::io::Error::other)
+        }
+        "events.publish" => {
+            let thread = scope
+                .thread
+                .map(str::to_owned)
+                .or_else(current_thread)
+                .ok_or_else(|| other("channel_thread_unavailable"))?;
+            let channel = call.arguments["channel"]
+                .as_str()
+                .ok_or_else(|| other("channel_name_invalid"))?;
+            let correlation = call.arguments["correlation"].as_str().map(str::to_owned);
+            let delivery = codex_omd::event_bus::global()
+                .lock()
+                .map_err(|_| other("event_bus_poisoned"))?
+                .publish(
+                    caller,
+                    channel,
+                    call.arguments["data"].clone(),
+                    correlation,
+                    &thread,
+                )?;
+            codex_omd::client_surface::wake();
+            Ok(json!({"delivered": delivery.delivered, "dropped": delivery.dropped}))
+        }
+        "credentials.list" => codex_omd::credentials::CredentialProfiles::open(&store(paths)?)?
+            .visible(caller)
+            .map(Value::Array),
+        "settings.write" if context == codex_omd::app_routes::InvocationContext::User => {
+            let store = codex_omd::ModStore::open(store(paths)?)?;
+            let id = call.arguments["id"].as_str().unwrap_or(caller);
+            crate::mod_runtime::write_settings(&store, id, &call.arguments["values"], caller)
+        }
+        "settings.write" => Err(other("host_operation_user_only: settings.write")),
+        "packages.list" | "packages.index" | "packages.preview" | "packages.reload" => {
+            let store = codex_omd::ModStore::open(store(paths)?)?;
+            match operation {
+                "packages.list" => codex_omd::package_controls::list_fields(
+                    &store,
+                    crate::omd::mod_status().as_deref(),
+                    call.arguments,
+                    Some(&paths.repository),
+                ),
+                "packages.index" => codex_omd::package_controls::index(&store, call.arguments),
+                "packages.preview" => codex_omd::package_controls::preview(&store, call.arguments)
+                    .map(|preview| preview.public),
+                _ if context == codex_omd::app_routes::InvocationContext::User => {
+                    codex_omd::package_controls::reload(&store)
+                }
+                _ => Err(other("host_operation_user_only: packages.reload")),
+            }
+        }
+        _ => crate::mod_runtime::command_host_guarded(paths, policy, grants, caller, call, scope),
+    }
+}
