+    extensions.approval_gate_contributor(Arc::new(Gate(Arc::clone(&decisions))));
+    session.services.extensions = Arc::new(extensions.build());
+    let mut user_rules = codex_execpolicy::PolicyParser::new();
+    user_rules.parse(
+        "user.rules",
+        r#"prefix_rule(pattern=["rm"], decision="forbidden")"#,
+    )?;
+    session.services.exec_policy = Arc::new(crate::exec_policy::ExecPolicyManager::new(Arc::new(
+        user_rules.build(),
+    )));
+    let session = Arc::new(session);
+    let turn = session.new_default_turn().await;
+    let tool_ctx = crate::tools::sandboxing::ToolCtx {
+        cancellation_token: CancellationToken::new(),
+        session: Arc::clone(&session),
+        step_context: StepContext::for_test(Arc::clone(&turn)),
+        call_id: "gated-call".to_string(),
+        tool_name: codex_tools::ToolName::plain("probe"),
+    };
+    let forbidden = ExecApprovalRequirement::Forbidden {
+        reason: "policy".to_string(),
+    };
+    for (requirement, command, expected) in [
+        (
+            ExecApprovalRequirement::Skip {
+                bypass_sandbox: false,
+                proposed_execpolicy_amendment: None,
+            },
+            "ls",
+            Some("gated"),
+        ),
+        (forbidden.clone(), "ls", Some("policy")),
+        (forbidden, "rm", None),
+    ] {
+        let mut tool = ProbeToolRuntime {
+            requirement,
+            command,
+            runs: 0,
+        };
+        let result = crate::tools::orchestrator::ToolOrchestrator::new()
+            .run(
+                &mut tool,
+                turn.initial_environments
+                    .primary()
+                    .expect("turn should have a primary environment"),
+                &tool_ctx,
+            )
+            .await;
+        match expected {
+            Some(expected) => {
+                assert!(matches!(result, Err(ToolError::Rejected(reason)) if reason == expected));
+                assert_eq!(tool.runs, 0);
+            }
+            None => {
+                assert!(result.is_ok());
+                assert_eq!(tool.runs, 1);
+            }
+        }
+    }
+    assert_eq!(
+        *decisions.lock().unwrap(),
+        vec!["skip".to_string(), "forbidden".to_string()]
+    );
+    Ok(())
+}
