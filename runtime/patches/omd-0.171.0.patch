+            generation,
+            "read",
+            json!({"path":"a.txt","uri":"fixture://manual/intro"}),
+            || true,
+            |_, _| panic!(),
+            |_| {}
+        )
+        .is_err()
+    );
+    store.enable(&package, false).unwrap();
+    host.turn_boundary(&|| true);
+    assert!(!host.tools().iter().any(|(owner, _, _)| owner.is_empty()));
+    assert!(
+        host.invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"path":"a.txt"}),
+            || true,
+            |_, _| panic!(),
+            |_| {}
+        )
+        .is_err()
+    );
+}
