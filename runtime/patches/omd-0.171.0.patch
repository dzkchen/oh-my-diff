+/// Runs `config_set` interceptors for one row, writes the effective value and announces `config_change` to other mods.
+#[cfg(test)]
+pub(crate) fn set_config(
+    row: &Value,
+    value: Value,
+    expected: Option<&Value>,
+    caller: &str,
+    mut write: impl FnMut(&Value) -> Result<Value, String>,
+) -> Result<Value, String> {
+    validate_config_value(row, &value, expected)?;
+    let context = configuration_context(configuration_binding())?;
+    set_config_in(row, value, expected, caller, &context, &mut write)
+}
+
+fn validate_config_value(
+    row: &Value,
+    value: &Value,
+    expected: Option<&Value>,
+) -> Result<(), String> {
+    let key = row["key"].as_str().unwrap_or_default();
+    if row["editable"] != true {
+        return Err(format!("config_not_editable: {key}"));
+    }
+    if expected.is_some_and(|expected| *expected != row["value"]) {
+        return Err(format!("config_stale: {key} changed since it was read"));
+    }
+    // A masked read never overwrites a Codex value; mod settings may hold the literal text.
+    let masked =
+        |value: &Value| !key.starts_with("mods.") && codex_omd::app_routes::redacted(value);
+    if masked(value) {
+        return Err(format!("app_config_value_redacted: {key}"));
+    }
+    Ok(())
+}
+
+pub(crate) fn set_config_in(
+    row: &Value,
+    value: Value,
+    expected: Option<&Value>,
+    caller: &str,
+    context: &ConfigurationContext,
+    mut write: impl FnMut(&Value) -> Result<Value, String>,
+) -> Result<Value, String> {
+    validate_config_value(row, &value, expected)?;
+    let key = row["key"].as_str().unwrap_or_default();
+    let masked =
+        |value: &Value| !key.starts_with("mods.") && codex_omd::app_routes::redacted(value);
+    let _thread = codex_omd::StateThread::enter(context.thread.clone());
+    if !configuration_binding_current(context.binding) {
+        return Err("terminal_context_changed".into());
+    }
+    let paths = &context.paths;
+    let runtime = &context.runtime;
+    let grants = {
+        let mut runtime = runtime.locked();
+        runtime
+            .refresh(&|| true)
+            .map_err(|error| error.to_string())?;
+        owner_grants(&runtime)
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let thread = context.thread.clone();
+    let active = || configuration_binding_current(context.binding);
+    let scope = CallScope {
+        terminal_owner: context.owner.clone(),
+        epoch: context.epoch,
+        context: codex_omd::app_routes::InvocationContext::Event,
+        thread: thread.as_deref(),
+        active: Arc::new({
+            let binding = context.binding;
+            move || configuration_binding_current(binding)
+        }),
+    };
+    let input = serde_json::json!({"key": key, "value": value, "original": row["value"],
+        "source": row["source"], "scope": row["scope"]});
+    let result = codex_omd::continue_operation(
+        runtime,
+        "config_set",
+        input,
+        serde_json::json!({"caller": caller, "thread_id": thread}),
+        active,
+        |caller, call| {
+            crate::mod_surface::host_call(
+                paths,
+                &policy,
+                grants.get(caller).cloned(),
+                caller,
+                call,
+                &scope,
+            )
+        },
+        |effective| {
+            if masked(&effective["value"]) {
+                return Err(std::io::Error::other(format!(
+                    "app_config_value_redacted: {key}"
+                )));
+            }
+            write(&effective["value"]).map_err(std::io::Error::other)?;
+            Ok(serde_json::json!({"value": effective["value"]}))
+        },
+    )
+    .map_err(|error| error.to_string())?;
+    let payload = serde_json::json!({"key":key,"original":row["value"],"effective":result["value"],"source":row["source"],"scope":row["scope"],"caller":caller});
+    let (generation, listeners) = {
+        let runtime = runtime.locked();
+        (
+            runtime.generation(),
+            runtime
+                .owners()
+                .into_iter()
+                .map(|(id, _)| id)
+                .filter(|id| id != caller && runtime.registered(id, "config_change"))
+                .collect::<Vec<_>>(),
+        )
+    };
+    for listener in listeners {
+        let _ = codex_omd::invoke_shared(
+            runtime,
+            &listener,
+            generation,
+            "config_change",
+            "",
+            payload.clone(),
+            codex_omd::ModInvokeOptions {
+                active: scope.active.as_ref(),
+                host: codex_omd::ModHostCallback::Scoped(&mut |caller, call| {
+                    crate::mod_surface::host_call(
+                        paths,
+                        &policy,
+                        grants.get(caller).cloned(),
+                        caller,
+                        call,
+                        &scope,
+                    )
+                }),
+                ..codex_omd::ModInvokeOptions::default()
+            },
+        );
+    }
+    Ok(result["value"].clone())
+}
