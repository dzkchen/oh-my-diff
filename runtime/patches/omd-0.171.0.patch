+            column,
+            row,
+            modifiers: KeyModifiers::NONE,
+        })
+    };
+    down(anchor.x + 2, anchor.y + 1);
+    assert!(test_interaction.lock().unwrap().terminal_press.is_some());
+    down(0, 0);
