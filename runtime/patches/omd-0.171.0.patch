+    fn render_members(&self, width: u16) -> Vec<crate::history_cell::RenderMember<'_>> {
+        if !self.is_exploring_cell() {
+            return Vec::new();
+        }
+        let Some(mut target) = self.render_target() else {
+            return Vec::new();
+        };
+        target.props["expanded"] = false.into();
+        target.props["presentation"] = "row".into();
