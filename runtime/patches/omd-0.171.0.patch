+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModConfiguration {
+    pub schema: u32,
+    #[serde(default)]
+    pub revision: u64,
+    /// Written by 1.0.0, which ran mods on Node; ignored, and dropped at the next write.
+    #[serde(default, skip_serializing)]
+    pub node: Option<PathBuf>,
+    pub mods: Vec<ModSelection>,
+}
+
+impl ModConfiguration {
+    pub fn parse(bytes: &[u8], path: &Path) -> Result<Self> {
+        let mut config: Self = serde_json::from_slice(bytes)
+            .map_err(|error| failure(format!("invalid {}: {error}", path.display())))?;
+        #[derive(Deserialize)]
+        struct Epochs {
+            revision: u64,
+            epochs: Vec<(String, PathBuf, u64)>,
+        }
+        let epochs = path
+            .parent()
+            .and_then(|root| store::read(&root.join(store::CONFIGURATION_EPOCHS), 65_536).ok())
+            .and_then(|bytes| serde_json::from_slice::<Epochs>(&bytes).ok())
+            .filter(|sidecar| sidecar.revision == config.revision)
+            .map(|sidecar| sidecar.epochs)
+            .unwrap_or_default();
+        for selection in &mut config.mods {
+            if let Some((_, _, epoch)) = epochs
+                .iter()
+                .find(|(scope, path, _)| *scope == selection.scope && *path == selection.path)
+            {
+                selection.configuration_epoch = *epoch;
+            }
+        }
+        Ok(config)
+    }
+}
