+            "entrypoint": "main.ts", "state_version": 1, "description": "Demo", "license": "MIT",
+            "provenance": {"maintainer": "Demo Author", "source": "demo"}, "capabilities": ["commands"],
+            "contributes": {"commands": [{"name": "demo", "description": "Run the demo"}]}})
+        .to_string(),
+    )
+    .unwrap();
