+static OWNER_BOUND: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+crate::omd::isolated_static! { OWNER_VIEW_GENERATION: Mutex<u64> = Mutex::new(0) }
+crate::omd::isolated_static! { RENDER_REQUEST: Mutex<u64> = Mutex::new(0) }
+
+fn publish_owner_snapshot(snapshot: ModViewSnapshot) {
+    OWNER_VIEW_GENERATION.with(|owner_state| {
+        let mut generation = owner_state.locked();
+        *generation = generation.wrapping_add(1);
+        crate::mod_ui::preview(snapshot);
+    });
+}
+
+pub(crate) fn owner_view_active() -> bool {
+    OWNER_BOUND.load(std::sync::atomic::Ordering::Acquire)
+}
+
+static FRONTEND_APPLY: Mutex<()> = Mutex::new(());
+static FRONTEND_GENERATION: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static REMOTE_FRONTEND: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+#[cfg(test)]
+pub(crate) fn remote_frontend(remote: bool) {
+    let _binding = FRONTEND_APPLY.locked();
+    reset_frontend(remote);
+    FRONTEND_GENERATION.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+}
+
+fn reset_frontend(remote: bool) {
+    ACTIVE_CONTEXT.with(|state| {
+        let mut context = state.locked();
+        context.sequence = context.sequence.saturating_add(1);
+    });
+    OWNER_BOUND.store(false, std::sync::atomic::Ordering::Release);
+    *TERMINAL_TOKEN.locked() = None;
+    *REMOTE_PACKAGES.locked() = None;
+    *REMOTE_STATUS.locked() = None;
+    *EFFECTIVE_BUILTINS.locked() = codex_omd::BuiltinSnapshot::default();
+    *CONFIGURATION_TRANSPORT.locked() = None;
+    publish_owner_snapshot(ModViewSnapshot::default());
+    REMOTE_FRONTEND.store(remote, std::sync::atomic::Ordering::Release);
+    *CATALOG.locked() = None;
+}
+
+pub(crate) fn remote_frontend_active() -> bool {
+    REMOTE_FRONTEND.load(std::sync::atomic::Ordering::Acquire)
+}
+
+pub(crate) fn owner_snapshot(value: Value) -> Result<(), String> {
+    let snapshot = decode_owner_snapshot(value)?;
+    publish_owner_snapshot(snapshot);
+    refresh_catalog();
+    Ok(())
+}
+
+static CONFIGURATION_TRANSPORT: std::sync::LazyLock<
+    Mutex<
+        Option<(
+            codex_app_server_client::AppServerRequestHandle,
+            tokio::runtime::Handle,
+        )>,
+    >,
+> = std::sync::LazyLock::new(|| Mutex::new(None));
+
+pub(crate) fn activate_configuration(
+    remote: bool,
+    token: Option<&str>,
+    handle: Option<codex_app_server_client::AppServerRequestHandle>,
+) {
+    let previous = {
+        let _binding = FRONTEND_APPLY.locked();
+        reset_frontend(remote);
+        *TERMINAL_TOKEN.locked() = token.map(str::to_owned);
+        OWNER_BOUND.store(token.is_some(), std::sync::atomic::Ordering::Release);
+        *TERMINAL_OWNER.locked() = token
+            .map(codex_omd::terminal_configuration_owner)
+            .unwrap_or_default();
+        let previous = HOST.locked().take();
+        *CONFIGURATION_TRANSPORT.locked() =
+            handle.map(|handle| (handle, tokio::runtime::Handle::current()));
+        FRONTEND_GENERATION.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+        previous
+    };
+    drop(previous);
+    if remote {
+        std::thread::spawn(send_client_viewport);
+    } else if token.is_some() {
+        open_in_background();
+    }
+}
+
+fn send_client_viewport() {
+    static SENT: Mutex<Option<(u64, Value)>> = Mutex::new(None);
+    let generation = FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire);
+    let Some((handle, executor)) = CONFIGURATION_TRANSPORT.locked().clone() else {
+        return;
+    };
+    let client = crate::mod_client::value();
+    let size = |key: &str| {
+        client[key]
+            .as_u64()
+            .and_then(|value| u32::try_from(value).ok())
+            .filter(|value| *value > 0)
+    };
+    let (Some(width), Some(height)) = (size("columns"), size("rows")) else {
+        return;
+    };
+    let sent = Some((generation, client.clone()));
+    if std::mem::replace(&mut *SENT.locked(), sent.clone()) == sent {
+        return;
+    }
+    let result = executor.block_on(
+        handle.request_typed::<codex_app_server_protocol::OmdClientUpdateResponse>(
+            codex_app_server_protocol::ClientRequest::OmdClientUpdate {
+                request_id: codex_app_server_protocol::RequestId::String(
+                    uuid::Uuid::new_v4().to_string(),
+                ),
+                params: codex_app_server_protocol::OmdClientUpdateParams {
+                    renderer: None,
+                    viewport: Some(codex_app_server_protocol::OmdViewport {
+                        width,
+                        height,
+                        unit: "cells".to_owned(),
+                    }),
+                    focus: None,
+                    client: Some(client),
+                },
+            },
+        ),
+    );
+    if result.is_err() {
+        let mut current = SENT.locked();
+        if *current == sent {
+            *current = None;
+        }
+    }
+}
+
+fn remote_configuration(request: Value) -> Option<std::io::Result<Value>> {
+    remote_configuration_at(
+        request,
+        FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire),
+    )
+}
+
+fn remote_configuration_at(request: Value, binding: u64) -> Option<std::io::Result<Value>> {
+    let expected_owner = codex_omd::client_surface::terminal_owner_id();
+    let (handle, executor) = {
+        let _binding = FRONTEND_APPLY.locked();
+        if binding != FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire) {
+            return Some(Err(std::io::Error::other("terminal_context_changed")));
+        }
+        if expected_owner.is_some() && expected_owner != configuration_owner_id() {
+            return Some(Err(std::io::Error::other("terminal_context_changed")));
+        }
+        CONFIGURATION_TRANSPORT.locked().clone()?
+    };
+    Some(
+        std::thread::spawn(move || {
+            executor.block_on(async move {
+                let response = handle
+                    .request_typed::<codex_app_server_protocol::OmdConfigurationResponse>(
+                        codex_app_server_protocol::ClientRequest::OmdConfiguration {
+                            request_id: codex_app_server_protocol::RequestId::String(
+                                uuid::Uuid::new_v4().to_string(),
+                            ),
+                            params: serde_json::from_value::<
+                                codex_app_server_protocol::OmdConfigurationParams,
+                            >(request)
+                            .map_err(|error| std::io::Error::other(error.to_string()))?,
+                        },
+                    )
+                    .await
+                    .map_err(|error| std::io::Error::other(error.to_string()))?;
+                Ok(response.0)
+            })
+        })
+        .join()
+        .unwrap_or_else(|_| {
+            Err(std::io::Error::other(
+                "terminal_configuration_transport_failed",
+            ))
+        }),
+    )
+}
+
+static TERMINAL_TOKEN: Mutex<Option<String>> = Mutex::new(None);
+
+pub(crate) fn configuration_owner_id() -> Option<String> {
+    TERMINAL_TOKEN.locked().clone()
+}
+
+static TERMINAL_OWNER: std::sync::LazyLock<Mutex<Arc<Mutex<codex_omd::ConfigurationOverrides>>>> =
+    std::sync::LazyLock::new(|| Mutex::new(Arc::default()));
+
+fn shared_host_active(active: &dyn Fn() -> bool) -> Result<Arc<Mutex<ModHost>>, String> {
+    let mut host = try_lock_until(&HOST, active).ok_or("callback_cancelled")?;
+    if host.is_none() {
+        let paths = crate::omd::mod_paths().ok_or("Oh My Diff mods are not active")?;
+        let store = paths.store;
+        let owner = TERMINAL_OWNER
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let runtime = ModHost::open(
+            store,
+            ModOpenOptions {
+                repository: Some(&paths.repository),
+                active,
+                configuration_overrides: owner,
+                ..ModOpenOptions::default()
+            },
+        )
+        .map_err(|e| e.to_string())?;
+        if !active() {
+            return Err("callback_cancelled".to_owned());
+        }
+        *host = Some(Arc::new(Mutex::new(runtime)));
+    }
+    host.clone()
+        .ok_or_else(|| "mod runtime unavailable".to_owned())
+}
