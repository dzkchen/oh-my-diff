+    let mut failed = call();
+    failed.complete(Duration::ZERO, Err("\n  boom  \nstack".into()));
+    assert_eq!(failed.render_target().unwrap().props["error"], "boom");
+    let mut errored = call();
+    errored.complete(
+        Duration::ZERO,
+        Ok(CallToolResult {
+            content: vec![text_block("denied\nmore")],
+            is_error: Some(true),
+            structured_content: None,
+            meta: None,
+        }),
