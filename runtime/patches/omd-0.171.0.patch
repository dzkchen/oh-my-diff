+            .expect("raised surface");
+        menu.set_style(Rect::new(0, 2, 64, 1), Style::default().bg(raised));
+        menu.set_string(0, 2, "menu", Style::default().bg(raised));
+        underlay_tint(&snapshot, screen, &[], &mut menu, level);
+        menu
+    });
+    assert_eq!(
+        menu[(0, 2)].bg,
+        crate::terminal_palette::with_test_default_colors(colors, || {
+            crate::style::user_message_style().bg.unwrap()
+        })
+    );
+    let glass = (0..64).map(|x| menu[(x, 2)].symbol()).collect::<String>();
+    assert_eq!(glass, format!("menu{}", " ".repeat(60)));
+    crate::terminal_palette::with_test_default_colors(colors, || {
+        let mut prompt = Buffer::empty(screen);
+        prompt.set_style(screen, crate::style::user_message_style());
+        prompt.set_string(0, 0, "a long wrapped prompt", Style::default());
+        prompt.set_string(0, 1, "with another line", Style::default());
+        let native = prompt.clone();
+        underlay_glyphs(&snapshot, screen, screen, &[], &mut prompt, level, now);
+        underlay_tint(&snapshot, screen, &[], &mut prompt, level);
+        assert_eq!(prompt, native);
+    });
+    suspend(key);
+    retain(&BTreeSet::new());
+    let mut returned = Buffer::empty(screen);
+    underlay_glyphs(&snapshot, screen, screen, &[], &mut returned, level, now);
+    underlay_tint(&snapshot, screen, &[], &mut returned, level);
+    assert_eq!(returned[(0, 0)].symbol(), "x");
+    assert_eq!(returned[(0, 0)].bg, tinted);
+    let light = crate::terminal_probe::DefaultColors {
+        fg: (20, 20, 20),
+        bg: (240, 240, 240),
+    };
+    let code = crate::terminal_palette::with_test_default_colors(light, || {
+        let mut code = Buffer::empty(screen);
+        code.set_string(
+            0,
+            0,
+            "fn",
+            Style::default().fg(crate::terminal_palette::rgb_color((30, 30, 30))),
+        );
+        underlay_tint(&snapshot, screen, &[], &mut code, level);
+        code
+    });
+    assert_eq!(
+        code[(0, 0)].fg,
+        crate::terminal_palette::rgb_color((255, 255, 255)),
+        "dark text set for a light terminal stays readable"
+    );
+    retain(&BTreeSet::new());
+}
