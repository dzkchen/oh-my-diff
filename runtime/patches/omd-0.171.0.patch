+impl Loaded {
+    fn inspected(&self) -> Self {
+        Self {
+            state: self.state.clone(),
+            ui: None,
+            ..self.invocation()
+        }
+    }
+
+    fn invocation(&self) -> Self {
+        Self {
+            package: self.package.clone(),
+            selection: self.selection.clone(),
+            source: self.source.clone(),
+            assets: self.assets.clone(),
+            request_metadata: self.request_metadata.clone(),
+            session_key: self.session_key.clone(),
+            code_cache: self.code_cache.clone(),
+            adapter: self.adapter.clone(),
+            state: Value::Null,
+            state_revision: self.state_revision,
+            registered_state: self.registered_state.clone(),
+            ui: self.ui.clone(),
+            ui_state: Value::Null,
+            ui_revision: 0,
+            ui_clears: 0,
+            command_view: None,
+            registrations: self.registrations.clone(),
+            source_use: self.source_use.clone(),
+            unused_grants: self.unused_grants.clone(),
+            unused_environment: self.unused_environment.clone(),
+            withheld: self.withheld.clone(),
+            settings_file: self.settings_file.clone(),
+            error: self.error.clone(),
+            telemetry: ModTelemetry::default(),
+        }
+    }
+
+    fn set_state(&mut self, state: Value) {
+        static REVISIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        self.state = state;
+        self.state_revision = REVISIONS.fetch_add(1, Ordering::Relaxed) + 1;
+    }
+
+    fn clear_ui(&mut self) {
+        self.command_view = None;
+        if let Some((_, state)) = self.ui.take()
+            && let Ok(mut state) = state.lock()
+        {
+            state.value = Value::Null;
+            state.revision = state.revision.wrapping_add(1);
+            state.clears = state.clears.wrapping_add(1);
+        }
+    }
+
+    fn fault(&mut self, error: String) {
+        self.telemetry.faults = self.telemetry.faults.saturating_add(1);
+        if self.telemetry.faults >= MOD_FAULT_LIMIT && self.error.is_none() {
+            self.error = Some(error.clone());
+            self.clear_ui();
+            let mut turned_off = TURNED_OFF
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            // Each host counts its own faults; one notice per mod, and processes that never drain stay bounded.
+            if !turned_off.iter().any(|(id, _)| id == &self.package.id) {
+                let blocks = self
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .any(|interceptor| interceptor.required);
+                turned_off.push((self.package.id.clone(), blocks));
+            }
+        }
+        self.telemetry.last_error = Some(error);
+    }
+}
+
+impl ModTelemetry {
+    fn record(
+        &mut self,
+        generation: u64,
+        event: &str,
+        name: &str,
+        elapsed: u128,
+        outcome: &'static str,
+    ) {
+        self.invocations = self.invocations.saturating_add(1);
+        self.total_micros = self.total_micros.saturating_add(elapsed);
+        self.last_micros = elapsed;
+        if self.logs.len() == 64 {
+            self.logs.pop_front();
+        }
+        self.logs.push_back(TelemetryLog {
+            generation,
+            event: event.to_owned(),
+            name: name.to_owned(),
+            outcome,
+            elapsed_micros: elapsed,
+        });
+    }
+}
