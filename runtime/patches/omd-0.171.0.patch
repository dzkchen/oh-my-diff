+pub(crate) fn hold_clipboard(id: u64, call: SurfaceCall) {
+    if let Some((_, previous)) = with(|state| state.clipboard.replace((id, call))) {
+        let _ = previous
+            .reply
+            .send(Err("clipboard_request_replaced".into()));
+    }
+}
+
+pub(crate) fn complete_clipboard(
+    completion: Option<(u64, crate::clipboard_copy::worker::CopyResult)>,
+) -> bool {
+    let Some((id, call)) = with(|state| state.clipboard.take()) else {
+        return false;
+    };
+    let result = match validate_call(&call) {
+        Err(error) => Err(error),
+        Ok(()) => match completion.filter(|(completed, _)| *completed == id) {
+            Some((_, Ok(crate::clipboard_copy::CopyStatus::Pending(_)))) => {
+                with(|state| state.clipboard = Some((id, call)));
+                return true;
+            }
+            Some((_, result)) => result.map(|status| serde_json::json!({"status": match status {
+                crate::clipboard_copy::CopyStatus::Confirmed => "confirmed",
+                crate::clipboard_copy::CopyStatus::Unconfirmed => "unconfirmed",
+                crate::clipboard_copy::CopyStatus::Busy => "busy",
+                crate::clipboard_copy::CopyStatus::Pending(_) => unreachable!("pending handled above"),
+            }})),
+            None => {
+                with(|state| state.clipboard = Some((id, call)));
+                return true;
+            }
+        },
+    };
+    let _ = call.reply.send(result);
+    false
+}
+
+pub(crate) fn hold(call: SurfaceCall) -> u64 {
+    with(|state| {
+        state.next += 1;
+        let id = state.next;
+        if state.pending.len() >= 16
+            && let Some(oldest) = state.pending.keys().next().copied()
+            && let Some(call) = state.pending.remove(&oldest)
+        {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+        }
+        state.pending.insert(id, call);
+        id
+    })
+}
+
+pub(crate) fn release(id: u64) -> Option<SurfaceCall> {
+    with(|state| state.pending.remove(&id))
+}
+
+pub(crate) fn keys_changed(keys: &[(String, Option<String>)]) -> bool {
+    with(|state| {
+        let changed =
+            state.keys.as_deref() != Some(keys) && (state.keys.is_some() || !keys.is_empty());
+        state.keys = Some(keys.to_vec());
+        changed
+    })
+}
+
+pub(crate) fn notify_allowed() -> bool {
+    with(|state| {
+        let allowed = state
+            .notified
+            .is_none_or(|last| last.elapsed() >= Duration::from_secs(2));
+        if allowed {
+            state.notified = Some(Instant::now());
+        }
+        allowed
+    })
+}
+
+pub(crate) fn resource_binding(
+    caller: &str,
+    thread: Option<&str>,
+) -> Result<(codex_omd::scoped_data::ScopedDataHost, PathBuf), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store;
+    let host = codex_omd::client_surface::resource_host(&store, &paths.repository, caller, thread)?;
+    Ok((host, store))
+}
+
+fn configured_routes(paths: &crate::omd::ModPaths) -> Vec<(String, String)> {
+    let store = &paths.store;
+    std::fs::read(store.join("host.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .and_then(|config| config["routes"].as_array().cloned())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|route| {
+            route["roles"]
+                .as_array()
+                .is_some_and(|roles| roles.iter().any(|role| role == "lead"))
+        })
+        .filter_map(|route| {
+            Some((
+                route["model"].as_str()?.to_owned(),
+                route["provider"].as_str()?.to_owned(),
+            ))
+        })
+        .collect()
+}
