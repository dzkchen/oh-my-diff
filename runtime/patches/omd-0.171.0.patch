+
+pub(super) fn asset_map(assets: BTreeMap<String, String>) -> BTreeMap<String, Value> {
+    assets
+        .into_iter()
+        .map(|(name, text)| {
+            let sha256 = crate::sha256_hex(text.as_bytes());
+            (name, serde_json::json!({"text": text, "sha256": sha256}))
+        })
+        .collect()
