+                owner_snapshot(latest.clone()).unwrap();
+                assert!(crate::mod_ui::shared_snapshot().progress.is_none());
+            }
+            true
+        });
+        assert!(checks.load(Ordering::SeqCst) > 1);
+        wait_until(
+            "the latest owner snapshot and viewport were not rendered",
+            || {
+                let drawn = crate::mod_ui::shared_snapshot();
+                drawn.progress.is_none()
+                    && drawn.activity.len() == 1
+                    && drawn.view.title == Some(crate::mod_client::value()["columns"].to_string())
+            },
