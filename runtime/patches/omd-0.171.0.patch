+fn channel_sink() -> (ChangeSink, mpsc::Receiver<(String, Vec<String>)>) {
+    let (tx, rx) = mpsc::channel();
+    let tx = Mutex::new(tx);
+    (
+        Arc::new(move |id: &str, paths: Vec<String>| {
+            let _ = tx.lock().unwrap().send((id.to_owned(), paths));
+        }),
+        rx,
+    )
