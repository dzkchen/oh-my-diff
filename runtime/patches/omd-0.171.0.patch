+const COST_SNAPSHOT_INTERVAL: Duration = Duration::from_secs(1);
+
+/// Per snapshot path: when it was last written and whether a later change is still unwritten.
+static COST_SNAPSHOTS: Mutex<BTreeMap<std::path::PathBuf, (Instant, bool)>> =
+    Mutex::new(BTreeMap::new());
+
+/// The append-only task journal is the durable record; this snapshot is rewritten in full, so request-path writes coalesce to one a second and flush at turn end.
+fn persist_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let due = COST_SNAPSHOTS.lock().map_or(true, |mut snapshots| {
+        match snapshots.get_mut(&account.cost_capture) {
+            Some((written, dirty)) if written.elapsed() < COST_SNAPSHOT_INTERVAL => {
+                *dirty = true;
+                false
+            }
+            _ => {
+                snapshots.insert(account.cost_capture.clone(), (Instant::now(), false));
+                true
+            }
+        }
+    });
+    if due {
+        write_cost_capture(account, Durability::Volatile)?;
+    }
+    Ok(())
+}
+
+fn flush_cost_capture(account: &Account) -> Result<(), TransportError> {
+    let dirty = COST_SNAPSHOTS
+        .lock()
+        .ok()
+        .and_then(|mut snapshots| snapshots.remove(&account.cost_capture))
+        .is_some_and(|(_, dirty)| dirty);
+    if dirty {
+        write_cost_capture(account, Durability::Ordered)?;
+    }
+    Ok(())
+}
+
+static COST_WRITES: Mutex<BTreeMap<std::path::PathBuf, Arc<Mutex<()>>>> =
+    Mutex::new(BTreeMap::new());
+
+fn cost_write_lock(path: &std::path::Path) -> Arc<Mutex<()>> {
+    COST_WRITES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .entry(path.to_path_buf())
+        .or_default()
+        .clone()
+}
+
+#[cfg(test)]
+type CostReplaceHook = (std::path::PathBuf, Box<dyn FnOnce() + Send>);
+
+#[cfg(test)]
+pub(crate) static BEFORE_COST_REPLACE: Mutex<Option<CostReplaceHook>> = Mutex::new(None);
+
+fn write_cost_capture(account: &Account, durability: Durability) -> Result<(), TransportError> {
+    let writing = cost_write_lock(&account.cost_capture);
+    let guard = writing.lock();
+    let result = write_cost_snapshot(account, durability);
+    drop(guard);
+    let mut locks = COST_WRITES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if Arc::strong_count(&writing) == 2 {
+        locks.remove(&account.cost_capture);
+    }
+    result
+}
+
+fn write_cost_snapshot(account: &Account, durability: Durability) -> Result<(), TransportError> {
+    let bytes =
+        serde_json::to_vec(&account.task.cost_capture().map_err(denied)?).map_err(denied)?;
+    codex_omd::fsio::write_bytes_before(&account.cost_capture, &bytes, durability, || {
+        #[cfg(test)]
+        if let Some((_, hook)) = BEFORE_COST_REPLACE
+            .lock()
+            .ok()
+            .and_then(|mut hook| hook.take_if(|(path, _)| *path == account.cost_capture))
+        {
+            hook();
+        }
+        Ok(())
+    })
+    .map_err(denied)
+}
