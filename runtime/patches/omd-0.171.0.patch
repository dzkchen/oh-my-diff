+pub(crate) fn remote_mod_status() -> Option<Arc<Value>> {
+    refresh_catalog();
+    REMOTE_STATUS.locked().clone()
+}
+static EFFECTIVE_BUILTINS: std::sync::LazyLock<Mutex<codex_omd::BuiltinSnapshot>> =
+    std::sync::LazyLock::new(|| Mutex::new(codex_omd::BuiltinSnapshot::default()));
+
+pub(crate) fn effective_builtins() -> codex_omd::BuiltinSnapshot {
+    if !remote_frontend_active() {
+        if crate::omd::mod_paths().is_none() {
+            return codex_omd::BuiltinSnapshot::default();
+        }
+        let host = match HOST.try_lock() {
+            Ok(host) => {
+                let opened = host.clone();
+                drop(host);
+                opened.or_else(|| shared_host().ok())
+            }
+            Err(_) => None,
+        };
+        if let Some(host) = host
+            && let Ok(mut runtime) = host.try_lock()
+        {
+            if runtime.refresh_due() {
+                let _ = runtime.refresh(&|| true);
+            }
+            *EFFECTIVE_BUILTINS.locked() =
+                codex_omd::BuiltinSnapshot::from_controls(&runtime.builtin_controls());
+        }
+    }
+    EFFECTIVE_BUILTINS.locked().clone()
+}
+
+pub(crate) fn remote_packages() -> Option<Value> {
+    if !remote_frontend_active() {
+        return None;
+    }
+    refresh_catalog();
+    Some(
+        REMOTE_PACKAGES
+            .locked()
+            .clone()
+            .unwrap_or_else(|| serde_json::json!({"packages":[]})),
+    )
+}
+
+pub(crate) fn load_remote_packages() -> Result<(), String> {
+    let binding = FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire);
+    let response = remote_configuration_at(serde_json::json!({"action":"catalog"}), binding)
+        .ok_or("terminal_configuration_unavailable")?
+        .map_err(|error| error.to_string())?;
+    let _binding = FRONTEND_APPLY.locked();
+    if binding != FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire) {
+        return Err("terminal_context_changed".into());
+    }
+    let status = cache_remote_catalog(&response);
+    *CATALOG.locked() = Some((Instant::now(), build(entries(Some(status)))));
+    Ok(())
+}
