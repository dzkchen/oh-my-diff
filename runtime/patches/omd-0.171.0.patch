+                && changed.fetch_add(1, Ordering::SeqCst) == 0
+            {
+                match change {
+                    "render" => assert_eq!(
+                        host.terminal_view(json!({"value":"new"}), || true)
+                            .view
+                            .greeting
+                            .as_deref(),
