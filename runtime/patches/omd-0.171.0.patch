+        );
+        assert_eq!(
+            catalog.route(&json!({"model": "gpt-5.5"})),
+            Err("routes_add_model_unknown".into())
+        );
+        assert_eq!(
+            catalog.listed(),
+            json!([{"model": "fixture-live-only", "display_name": "fixture-live-only",
+            "efforts": ["low", "high"], "default_effort": "high", "context_window": 299_700}])
