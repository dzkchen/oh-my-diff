+#[test]
+fn a_notice_splits_a_run_and_long_runs_keep_their_latest_steps() {
+    let cell = run();
+    let notice: Arc<dyn HistoryCell> = Arc::new(new_info_event("declined".into(), None));
+    let parts = cell.split_around("exec:c1", notice.clone()).unwrap();
+    assert_eq!(parts.len(), 2);
+    assert!(Arc::ptr_eq(&parts[0], &notice));
+    assert!(parts[1].as_any().is::<ToolRunCell>());
+    let mut failed = new_active_exec_command(
+        "f".into(),
+        vec!["false".into()],
+        Vec::new(),
+        CommandExecutionSource::Agent,
+        None,
+        false,
+    );
+    failed.complete_call("f", CommandOutput::new(1, String::new()), Duration::ZERO);
+    let mut long = ToolRunCell::new(Arc::new(failed));
+    for _ in 0..70 {
+        long.push(cell.group.calls[1].clone());
+    }
+    let props = long.render_target().unwrap().props;
+    assert_eq!(
+        (
+            &props["status"],
+            &props["call_count"],
+            props["calls"].as_array().unwrap().len()
+        ),
+        (&json!("failed"), &json!(71), 64)
+    );
+}
