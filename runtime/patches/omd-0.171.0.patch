+
+impl NewThreadRoute {
+    fn read(&self) -> Result<serde_json::Value> {
+        color_eyre::eyre::ensure!(
+            super::mod_surface::caller_source(&self.caller).as_deref() == Some(&self.source),
+            "route_owner_changed: select a route again"
+        );
+        let paths = crate::omd::mod_paths()
+            .ok_or_else(|| color_eyre::eyre::eyre!("mod store is not configured"))?;
+        let store = paths.store;
+        let host: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(store.join("host.json"))?)?;
+        let routes = host["routes"]
+            .as_array()
+            .ok_or_else(|| color_eyre::eyre::eyre!("routes_invalid"))?;
+        let selected = routes
+            .iter()
+            .find(|route| {
+                route["name"] == self.name
+                    && route["roles"]
+                        .as_array()
+                        .is_some_and(|roles| roles.iter().any(|role| role == "lead"))
+                    && route["mods"].as_array().is_none_or(|mods| {
+                        mods.is_empty() || mods.iter().any(|id| id == &self.caller)
+                    })
+            })
+            .cloned()
+            .ok_or_else(|| color_eyre::eyre::eyre!("route_not_configured: {}", self.name))?;
+        color_eyre::eyre::ensure!(
+            routes
+                .iter()
+                .filter(|route| {
+                    route["model"] == selected["model"]
+                        && route["provider"] == selected["provider"]
+                        && route["roles"]
+                            .as_array()
+                            .is_some_and(|roles| roles.iter().any(|role| role == "lead"))
+                })
+                .count()
+                == 1,
+            "route_ambiguous_for_new_thread: {}",
+            self.name
+        );
+        Ok(selected)
+    }
+}
