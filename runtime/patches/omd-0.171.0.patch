+    result: Arc<Mutex<Option<Result<String, String>>>>,
+    failure: Arc<Mutex<Option<Value>>>,
+    job: Option<tokio::task::JoinHandle<()>>,
+    runtime: tokio::runtime::Handle,
+    consumed: bool,
+    task: Arc<Task>,
+    worker: String,
+    workspace: Option<Workspace>,
+    candidate: Option<(String, Vec<String>)>,
+    evidence: Option<String>,
+    resolution: Option<ResolutionBinding>,
+    mailbox: Arc<Mailbox>,
+}
+
+enum Mail {
+    Open,
+    Waiting {
+        waiters: usize,
+        status: Option<AgentStatus>,
+        claimed: bool,
+    },
+    Held(AgentStatus),
+    Sending,
+    Delivered,
+    Done,
+}
+
+struct Mailbox {
+    manager: Weak<ThreadManager>,
+    parent: ThreadId,
+    child: ThreadId,
+    name: String,
+    hold_failure: bool,
+    state: Mutex<Mail>,
+}
+
+struct Waiter(Option<Arc<Mailbox>>);
+
+impl Waiter {
+    fn new(mailbox: Arc<Mailbox>) -> Self {
+        mailbox.waiting();
+        Self(Some(mailbox))
+    }
+
+    async fn done(mut self, claimed: bool) {
+        if let Some(mailbox) = self.0.take() {
+            mailbox.send(mailbox.waited(claimed)).await;
+        }
+    }
+}
+
+impl Drop for Waiter {
+    fn drop(&mut self) {
+        if let Some(mailbox) = self.0.take()
+            && let Some(status) = mailbox.waited(false)
+            && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        {
+            runtime.spawn(async move { mailbox.send(Some(status)).await });
+        }
+    }
+}
+
+impl Mailbox {
+    fn settle(&self, state: &mut Mail, status: AgentStatus) -> Option<AgentStatus> {
+        if self.hold_failure && matches!(status, AgentStatus::Errored(_)) {
+            *state = Mail::Held(status);
+            return None;
+        }
+        Some(status)
+    }
+
+    fn resolve(
+        &self,
+        state: &mut Mail,
+        waiters: usize,
+        status: Option<AgentStatus>,
+        claimed: bool,
+    ) -> Option<AgentStatus> {
+        match status {
+            Some(status) if claimed => {
+                *state = Mail::Done;
+                self.settle(state, status);
+                None
+            }
+            Some(status) if waiters == 0 => self.settle(state, status),
+            None if waiters == 0 && !claimed => {
+                *state = Mail::Open;
+                None
+            }
+            status => {
+                *state = Mail::Waiting {
+                    waiters,
+                    status,
+                    claimed,
+                };
+                None
+            }
+        }
+    }
+
+    fn update(
+        &self,
+        next: impl FnOnce(&Self, &mut Mail, Mail) -> Option<AgentStatus>,
+    ) -> Option<AgentStatus> {
+        let mut state = self.state.lock().ok()?;
+        let current = std::mem::replace(&mut *state, Mail::Done);
+        let released = next(self, &mut state, current);
+        if released.is_some() {
+            *state = Mail::Sending;
+        }
+        released
+    }
+
+    async fn send(&self, status: Option<AgentStatus>) -> bool {
+        let Some(status) = status else {
+            return false;
+        };
+        let sent = match self.manager.upgrade() {
+            Some(manager) => manager
+                .deliver_subagent_result(self.parent, self.child, &self.name, status)
+                .await
+                .unwrap_or(false),
+            None => false,
+        };
+        if let Ok(mut state) = self.state.lock()
+            && matches!(*state, Mail::Sending)
+        {
+            *state = if sent { Mail::Delivered } else { Mail::Done };
+        }
+        sent
+    }
+
+    fn delivered(&self) -> Option<Value> {
+        match *self.state.lock().ok()? {
+            Mail::Sending => Some(json!("pending")),
+            Mail::Delivered => Some(json!(true)),
+            _ => None,
+        }
+    }
+
+    fn finished(&self, status: AgentStatus) -> Option<AgentStatus> {
+        self.update(|mailbox, state, current| match current {
+            Mail::Open => mailbox.settle(state, status),
+            Mail::Waiting {
+                waiters, claimed, ..
+            } => mailbox.resolve(state, waiters, Some(status), claimed),
+            other => {
+                *state = other;
+                None
+            }
+        })
+    }
+
+    fn waiting(&self) {
+        self.update(|_, state, current| {
+            *state = match current {
+                Mail::Open => Mail::Waiting {
+                    waiters: 1,
+                    status: None,
+                    claimed: false,
+                },
+                Mail::Waiting {
+                    waiters,
+                    status,
+                    claimed,
+                } => Mail::Waiting {
+                    waiters: waiters + 1,
+                    status,
+                    claimed,
+                },
+                other => other,
+            };
+            None
+        });
+    }
+
+    fn waited(&self, claimed: bool) -> Option<AgentStatus> {
+        self.update(|mailbox, state, current| match current {
+            Mail::Waiting {
+                waiters,
+                status,
+                claimed: earlier,
+            } => mailbox.resolve(state, waiters.saturating_sub(1), status, earlier || claimed),
+            other => {
+                *state = other;
+                None
+            }
+        })
+    }
+
+    fn claim(&self) {
+        self.update(|mailbox, state, current| match current {
+            Mail::Open => mailbox.resolve(state, 0, None, true),
+            Mail::Waiting {
+                waiters, status, ..
+            } => mailbox.resolve(state, waiters, status, true),
+            other => {
+                *state = other;
+                None
+            }
+        });
+    }
+
+    fn release(&self, deliver: bool) -> Option<AgentStatus> {
+        self.update(|_, state, current| match current {
+            Mail::Held(status) if deliver => Some(status),
+            Mail::Held(_) => None,
+            other => {
+                *state = other;
+                None
+            }
+        })
+    }
+}
+
+#[derive(Clone)]
+struct ResolutionBinding {
+    candidate_sha256: String,
+    acceptance_sha256: String,
+    findings: BTreeSet<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ResolutionContext {
+    acceptance_sha256: String,
+    findings: Vec<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ResolutionAssertion {
+    outcome: codex_omd::ReceiptOutcome,
+    candidate_sha256: String,
+    acceptance_sha256: String,
+    resolves: Vec<String>,
+}
+
+fn separate_producer(
+    integrable: bool,
+    supplied: Option<&str>,
+    acceptance_sha256: Option<&str>,
+) -> Result<(), String> {
+    if integrable {
+        return Err("receipt_agent_produced_candidate".into());
+    }
+    if acceptance_sha256.is_some_and(|acceptance| supplied != Some(acceptance)) {
+        return Err("receipt_agent_acceptance_mismatch".into());
+    }
+    Ok(())
+}
+
+fn validate_resolution_assertion(
+    binding: Option<&ResolutionBinding>,
+    acceptance_sha256: Option<&str>,
+    resolves: &[String],
+    text: &str,
+) -> Result<(), String> {
+    let binding = binding.ok_or("finding_resolution_context_missing")?;
+    if acceptance_sha256 != Some(binding.acceptance_sha256.as_str())
+        || resolves.is_empty()
+        || resolves.len() > 32
+        || resolves.iter().collect::<BTreeSet<_>>().len() != resolves.len()
+        || resolves
+            .iter()
+            .any(|fingerprint| !binding.findings.contains(fingerprint))
+    {
+        return Err("finding_resolution_agent_binding_mismatch".into());
+    }
+    let result: Value =
+        serde_json::from_str(text).map_err(|_| "finding_resolution_agent_result_invalid")?;
+    let assertion: ResolutionAssertion = serde_json::from_value(
+        result
+            .get("resolution_assertion")
+            .cloned()
+            .ok_or("finding_resolution_assertion_missing")?,
+    )
+    .map_err(|_| "finding_resolution_assertion_invalid")?;
+    if assertion.outcome != codex_omd::ReceiptOutcome::Pass
+        || assertion.candidate_sha256 != binding.candidate_sha256
+        || assertion.acceptance_sha256 != binding.acceptance_sha256
+        || assertion.resolves.iter().collect::<BTreeSet<_>>()
+            != resolves.iter().collect::<BTreeSet<_>>()
+        || assertion.resolves.len() != resolves.len()
+    {
+        return Err("finding_resolution_assertion_mismatch".into());
+    }
+    Ok(())
+}
+
+fn agent_owned_by(
+    agent_mod: &str,
+    agent_generation: u64,
+    agent_task: &Arc<Task>,
+    mod_id: &str,
+    generation: u64,
+    task: &Arc<Task>,
+) -> bool {
+    agent_mod == mod_id && agent_generation == generation && Arc::ptr_eq(agent_task, task)
+}
