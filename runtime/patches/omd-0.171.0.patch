+
+    fn render_target(&self) -> Option<crate::mod_render::RenderTarget> {
+        let calls = self.iter_calls().collect::<Vec<_>>();
+        let first = calls.first()?;
+        let running = self.is_active();
+        let status = |call: &ExecCall| match &call.output {
+            _ if call.duration.is_none() => "running",
+            _ if self.interrupted.contains(&call.call_id) => "interrupted",
+            Some(output) if output.exit_code != 0 => "failed",
+            _ => "completed",
+        };
+        let call = |call: &ExecCall| {
+            let status = status(call);
+            let (total, _) = call
+                .output
+                .as_ref()
+                .map_or((0, 0), CommandOutput::line_counts);
+            serde_json::json!({
+                "call_id": call.call_id,
+                "kind": "exec",
+                "command": crate::mod_render::bounded(&strip_bash_lc_and_escape(&call.command)),
+                "parsed": call.parsed.iter().take(8).map(|parsed| {
+                    let mut value = serde_json::to_value(parsed).unwrap_or_default();
+                    for field in ["cmd", "name", "path", "query"] {
+                        if let Some(text) = value[field].as_str() {
+                            value[field] = crate::mod_render::bounded(text).into();
+                        }
+                    }
+                    value
+                }).collect::<Vec<_>>(),
+                "status": status,
+                "exit_code": call.output.as_ref().filter(|_| status != "interrupted").map(|output| output.exit_code),
+                "duration_ms": call.duration.map(|duration| duration.as_millis() as u64),
+                "output_lines": total,
+                "output_tail": call.output.as_ref().map(|output| {
+                    let mut tail = output.lines().rev().take(5).map(std::borrow::Cow::into_owned).collect::<Vec<_>>();
+                    tail.reverse();
+                    crate::mod_render::bounded(&tail.join("\n"))
+                }),
+                "user_shell": matches!(call.source, ExecCommandSource::UserShell),
+            })
+        };
+        let exploring = self.is_exploring_cell()
+            && (calls.len() > 1
+                || !self.group_exec
+                || !first.parsed.is_empty()
+                    && first.parsed.iter().all(|parsed| {
