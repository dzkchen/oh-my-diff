+    write_guard(strict);
+    let limited = package(
+        &root,
+        "limited",
+        "export default api => { api.command('run', () => api.host.call('exec.run', {program: 'true'})); api.command('read', () => api.host.call('store.get', {key: 'k'})); api.command('nap', () => api.time.sleep(1)); }",
