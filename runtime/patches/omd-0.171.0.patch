+    app.sync_mod_ui();
+    assert!(crate::mod_surface::validate_call(&previous).is_err());
+    tokio::time::timeout(Duration::from_secs(30), async {
+        let mut presented = false;
+        loop {
+            match events.recv().await.expect("app event") {
+                AppEvent::ModSurfaceCall(call, _) => {
+                    assert_eq!(call.thread, Some(thread.to_string()));
