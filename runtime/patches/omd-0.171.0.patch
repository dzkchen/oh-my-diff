+/// Only a thread the user opened sets or clears the "Mods are off" warning; internal and sub-agent threads (memory runs in CODEX_HOME) don't.
+fn reports_directory(
+    source: &SessionSource,
+    cwd: &std::path::Path,
+    codex_home: &std::path::Path,
+) -> bool {
+    !source.is_non_root_agent() && !cwd.starts_with(codex_home)
+}
+
+impl ThreadLifecycleContributor<Config> for Mods {
+    fn on_thread_start<'a>(
+        &'a self,
+        input: ThreadStartInput<'a, Config>,
+    ) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            let selected = clients::for_store(input.thread_store);
+            if let Some(owner) = selected.as_ref() {
+                input.thread_store.insert_arc(owner.clone());
+            }
+            let this = selected.as_deref().unwrap_or(self);
+            let Ok(thread) = ThreadId::from_string(input.thread_store.level_id()) else {
+                return;
+            };
+            this.native_agent_started(thread, input.session_source, input.thread_store);
+            let host = this.host_for(input.config.cwd.as_path());
+            if reports_directory(
+                input.session_source,
+                input.config.cwd.as_path(),
+                input.config.codex_home.as_path(),
+            ) {
+                this.views.diagnostic(
+                    &this.host,
+                    "directory",
+                    host.is_none().then(|| {
+                        format!(
+                            "Mods are off in {}: it is neither the launch project nor one of its worktrees",
+                            input.config.cwd.display()
+                        )
+                    }),
+                );
+            }
+            let Some(host) = host else {
+                return;
+            };
+            if this
+                .host
+                .accounts
+                .by_thread
+                .lock()
+                .map_or(true, |accounts| accounts.contains_key(&thread.to_string()))
+            {
+                return;
+            }
+            let parent = match input.session_source {
+                SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id, ..
+                }) => Some(*parent_thread_id),
+                _ => None,
+            };
+            let parent_session = parent.and_then(|parent| {
+                this.sessions
+                    .lock()
+                    .ok()?
+                    .get(&parent.to_string())
+                    .and_then(std::sync::Weak::upgrade)
+            });
+            let Some((owner, depth)) = thread_owner(&input, thread, parent_session.is_some())
+            else {
+                if parent.is_some()
+                    && codex_model_provider_info::runtime_provider(&input.config.model_provider_id)
+                        .is_some()
+                {
+                    host.accounts.refuse(
+                        &thread.to_string(),
+                        "agent_parent_unavailable: a subagent on a registered provider runs only beside its parent session".into(),
+                    );
+                }
+                return;
+            };
+            let session = match parent_session {
+                Some(session) => session,
+                None => match host.open_session(
+                    thread,
+                    input
+                        .thread_store
+                        .get::<codex_extension_api::ResumedThread>()
+                        .is_some(),
+                ) {
+                    Ok(session) => session,
+                    Err(error) => {
+                        this.views.diagnostic(
+                            &this.host,
+                            "session",
+                            Some(format!("OMD session unavailable: {error}")),
+                        );
+                        return;
+                    }
+                },
+            };
+            let route = (owner == "lead")
+                .then(|| host.lead_route(input.config))
+                .flatten();
+            let parent_account = parent.and_then(|parent| {
+                host.accounts
+                    .by_thread
+                    .lock()
+                    .ok()?
+                    .get(&parent.to_string())
+                    .map(|account| (account.owner.clone(), account.provider.clone()))
+            });
+            let cross_provider = parent_account.as_ref().filter(|(owner, provider)| {
+                crate::cross_provider_child(
+                    owner,
+                    provider,
+                    &input.config.model_provider_id,
+                    &input.config.configured_model_provider_id,
+                )
+            });
+            let enrolled = match cross_provider {
+                Some((parent_owner, _)) => host.enroll_cross_provider(
+                    thread,
+                    &session,
+                    &owner,
+                    parent_owner,
+                    depth,
+                    &input.config.model_provider_id,
+                    input.config.model.as_deref().unwrap_or_default(),
+                ),
+                None => host.enroll(thread, &session, &owner, route.as_ref(), Some(input.config)),
+            };
+            if let Err(error) = enrolled {
+                this.views.diagnostic(
+                    &this.host,
+                    "session",
+                    Some(format!("OMD ledger enrollment failed: {error}")),
+                );
+                if cross_provider.is_some() {
+                    host.accounts.refuse(&thread.to_string(), error);
+                }
+                return;
+            }
+            if owner != "lead"
+                && let Some((provider, model, billing)) =
+                    host.accounts.by_thread.lock().ok().and_then(|accounts| {
+                        let account = accounts.get(&thread.to_string())?;
+                        Some((
+                            account.provider.clone(),
+                            account.model.clone(),
+                            account
+                                .rates
+                                .is_some()
+                                .then(|| crate::accounting::billing(account.rates.as_ref())),
+                        ))
+                    })
+            {
+                this.inventory
+                    .describe(&thread.to_string(), &provider, &model, billing);
+            }
+            if owner == "lead" {
+                let runtime = this.runtime.clone();
+                let documents = tokio::task::spawn_blocking(move || {
+                    runtime
+                        .lock()
+                        .map(|runtime| runtime.contract_documents())
+                        .unwrap_or_default()
+                })
+                .await
+                .unwrap_or_default();
+                let mut resolved = contract::SessionContract::resolve(&host, &documents);
+                if let Err(error) = resolved.restore(&session.contract_state) {
+                    resolved.invalidate(error);
+                }
+                if let Ok(mut current) = session.contract.lock() {
+                    *current = resolved;
+                }
+                let _ = session.persist_contract();
+            }
+            if let Ok(mut sessions) = this.sessions.lock() {
+                sessions.retain(|_, session| session.strong_count() > 0);
+                sessions.insert(thread.to_string(), Arc::downgrade(&session));
+            }
+            if let Ok(mut invokers) = this.expansion.invokers.lock() {
+                invokers.insert(
+                    thread.to_string(),
+                    input
+                        .thread_store
+                        .get_or_init(codex_extension_api::ToolInvokerSlot::default),
+                );
+            }
+            input.thread_store.insert(Lead {
+                permission_profile: Arc::new(std::sync::Mutex::new(
+                    input.config.permissions.effective_permission_profile(),
+                )),
+                host,
+                session,
+                thread,
+                owner: owner.clone(),
+                depth,
+            });
+            if let Some(lead) = input.thread_store.get::<Lead>() {
+                this.core.expansion.thread_started(&lead);
+            }
+            if owner == "lead" {
+                if let Some(lead) = input.thread_store.get::<Lead>() {
+                    this.views.start_thread(input.thread_store);
+                    let forked = input
+                        .thread_store
+                        .get::<codex_extension_api::ForkedFromThread>()
+                        .map(|forked| forked.0);
+                    expansion::lead_started(&this.core, &lead, forked);
+                    peering::start(&this.core, lead.thread);
+                }
+                this.event(
+                    "session",
+                    json!({"phase":"start","thread_id":thread.to_string()}),
+                    None,
+                )
+                .await;
+            }
+        })
+    }
+
+    fn on_thread_ready<'a>(
+        &'a self,
+        input: ThreadReadyInput<'a, Config>,
+    ) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            let selected = clients::for_store(input.thread_store);
