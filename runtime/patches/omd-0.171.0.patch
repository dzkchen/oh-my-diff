+pub(crate) const LIFECYCLE_EVENTS: &[&str] = &[
+    "intercept",
+    "start",
+    "resume",
+    "idle",
+    "stop",
+    "turn_start",
+    "turn_end",
+    "assistant_message",
+    "tool_result",
+    "workspace_change",
+    "compaction_start",
+    "compaction_end",
+    "agent_end",
+    "tool_batch_end",
+    "instructions_loaded",
+    "thread_settings",
+    "worktree",
+    "mods_changed",
+    "elicitation_result",
+];
+
+pub(crate) fn event_allows(event: &str, operation: &str) -> bool {
+    LIFECYCLE_EVENTS.contains(&event)
+        || event == "workspace_pre_rename"
+            && matches!(
+                operation,
+                "workspace.read"
+                    | "process.start"
+                    | "process.exchange"
+                    | "process.status"
+                    | "process.stop"
+                    | "process.which"
+            )
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn call(
+    runtime_grants: Option<codex_omd::ModGrants>,
+    workspace: &WorkspaceAuthority,
+    data_root: &Path,
+    environment: Option<&codex_omd::host::Environment>,
+    protected: Vec<PathBuf>,
+    caller: &str,
+    origin: Origin,
+    thread: Option<&str>,
+    request: codex_omd::ModHostCall,
+    active: &dyn Fn() -> bool,
+    record_changes: bool,
+) -> Result<Value, String> {
+    let grants = runtime_grants.ok_or("host_caller_inactive")?;
+    let authority = NativeAuthority {
+        workspace,
+        protected,
+    };
+    Host {
+        authority: &authority,
+        data_root,
+        environment,
+        active,
+        record_changes,
+    }
+    .call(
+        &Caller {
+            id: caller,
+            source_sha256: &grants.source_sha256,
+            capabilities: &grants.capabilities,
+            exec_environment: &grants.exec_environment,
+            os_access: grants.os_access.as_ref(),
+            fs_access: grants.fs_access.as_ref(),
+            origin,
+            thread,
+        },
+        &request.operation,
+        request.arguments,
+    )
+}
