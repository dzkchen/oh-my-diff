diff --git a/codex-rs/exec/src/omd_surface.rs b/codex-rs/exec/src/omd_surface.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ca00d9d08164ec02b1db52f4bfc513c24a68332e
--- /dev/null
+++ b/codex-rs/exec/src/omd_surface.rs
@@ -0,0 +1,70 @@
+use codex_app_server_client::InProcessAppServerRequestHandle;
+use codex_app_server_protocol::ClientRequest;
+use codex_omd::client_surface::ClientSurface;
+use codex_omd::client_surface::SurfaceCall;
+use serde_json::Value;
+use serde_json::json;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+pub(crate) struct ExecSurface {
+    handle: InProcessAppServerRequestHandle,
+    runtime: tokio::runtime::Handle,
+    next: AtomicU64,
+}
+
+impl ExecSurface {
+    pub(crate) fn new(handle: InProcessAppServerRequestHandle) -> Self {
+        Self {
+            handle,
+            runtime: tokio::runtime::Handle::current(),
+            next: AtomicU64::new(0),
+        }
+    }
+}
+
+pub(crate) fn report_activation_failures() {
+    let Some(root) = std::env::var_os(codex_omd::MOD_STORE_ENV) else {
+        return;
+    };
+    let Some(status) = std::fs::read(std::path::Path::new(&root).join("mod-status.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+    else {
+        return;
+    };
+    #[allow(clippy::print_stderr)]
+    for failure in codex_omd::activation_failures(&status) {
+        eprintln!("Oh My Diff mod failed to activate: {failure}");
+    }
+}
+
+impl ClientSurface for ExecSurface {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        if call.operation != "app.request" {
+            return Err(format!(
+                "client_surface_operation_unavailable: {} needs an interactive terminal",
+                call.operation
+            ));
+        }
+        if call.confirm.is_some() {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return Ok(());
+        }
+        let id = self.next.fetch_add(1, Ordering::Relaxed) + 1;
+        let request = json!({"method": call.arguments["method"], "id": format!("omd-{id}"),
+            "params": call.arguments["params"]});
+        let request = serde_json::from_value::<ClientRequest>(request)
+            .map_err(|error| format!("app_params_invalid: {error}"))?;
+        let handle = self.handle.clone();
+        let reply = call.reply;
+        self.runtime.spawn(async move {
+            let result = handle
+                .request_typed::<Value>(request)
+                .await
+                .map_err(|error| error.to_string());
+            let _ = reply.send(result);
+        });
+        Ok(())
+    }
+}
diff --git a/codex-rs/ext/extension-api/src/capabilities/tool_invoker.rs b/codex-rs/ext/extension-api/src/capabilities/tool_invoker.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5868dbfe9fdd6ec797d581f9a8a6d474043dc4ee
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/capabilities/tool_invoker.rs
@@ -0,0 +1,62 @@
+use std::sync::Arc;
+
+use crate::ExtensionFuture;
+
+pub struct ToolInvocationRequest {
+    pub call_id: String,
+    pub tool: String,
+    pub arguments: serde_json::Value,
+    /// Waits for the turn's tool execution gate; false inside a tool call that already holds it.
+    pub serialized: bool,
+}
+
+pub struct ToolInvocationOutcome {
+    pub output: String,
+    pub success: bool,
+}
+
+/// The host's permission verdict for a tool call, computed without running it.
+pub struct ToolCheckOutcome {
+    pub decision: &'static str,
+    pub reason: Option<String>,
+    pub authority: &'static str,
+}
+
+/// Host-provided dispatch for the current turn, with the same interception, approvals, sandbox, accounting and cancellation as model tool calls.
+pub trait ToolInvoker: Send + Sync {
+    fn invoke<'a>(
+        &'a self,
+        request: ToolInvocationRequest,
+    ) -> ExtensionFuture<'a, Result<ToolInvocationOutcome, String>>;
+
+    fn check<'a>(
+        &'a self,
+        tool: &'a str,
+        arguments: serde_json::Value,
+    ) -> ExtensionFuture<'a, Result<ToolCheckOutcome, String>>;
+}
+
+/// The thread's current sampling-step invoker; the host replaces it at every step.
+#[derive(Default)]
+pub struct ToolInvokerSlot(std::sync::Mutex<Option<(String, Arc<dyn ToolInvoker>)>>);
+
+impl ToolInvokerSlot {
+    pub fn set(&self, turn_id: &str, invoker: Arc<dyn ToolInvoker>) {
+        if let Ok(mut current) = self.0.lock() {
+            *current = Some((turn_id.to_owned(), invoker));
+        }
+    }
+
+    pub fn get(&self) -> Option<Arc<dyn ToolInvoker>> {
+        Some(self.0.lock().ok()?.as_ref()?.1.clone())
+    }
+
+    /// Ends dispatch for a finished turn unless a later turn already replaced it.
+    pub fn clear(&self, turn_id: &str) {
+        if let Ok(mut current) = self.0.lock()
+            && current.as_ref().is_some_and(|(id, _)| id == turn_id)
+        {
+            *current = None;
+        }
+    }
+}
