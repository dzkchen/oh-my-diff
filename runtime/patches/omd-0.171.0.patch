+    assert_eq!(
+        error(client.authorized("policy.rollback", json!({"key": "other"}))),
+        "authority_policy_previous_missing"
+    );
+    assert_eq!(
+        *gate.asked.lock().unwrap(),
+        [
+            GRANT_RIGHT,
+            GRANT_RIGHT,
+            GRANT_RIGHT,
+            POLICY_RIGHT,
+            POLICY_RIGHT,
+            POLICY_RIGHT,
+            POLICY_RIGHT,
+            POLICY_RIGHT
