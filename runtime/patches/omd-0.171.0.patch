+        modifiers: KeyModifiers::NONE,
+    };
+    assert!(matches!(pointer(down), Some(ModPointer::Consumed)));
+    let up = MouseEvent {
+        kind: MouseEventKind::Up(MouseButton::Left),
+        ..down
+    };
+    match pointer(up) {
+        Some(ModPointer::Action(name, ModKeyAction::Copy { copy, label })) => {
+            assert_eq!(name, "Copy shortcuts");
+            assert_eq!(copy, "F8 settings");
+            assert_eq!(label, "workspace shortcuts");
+        }
+        _ => panic!("pointer activation missing"),
+    }
+    assert!(
+        matches!(
+            input(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE), true),
+            Some(ModInput::Consumed)
+        ),
+        "a modal dialog keeps Enter from the composer behind it"
+    );
+    assert!(modal_key(KeyEvent::new(
+        KeyCode::Char('v'),
+        KeyModifiers::CONTROL
+    )));
+    assert!(!modal_key(KeyEvent::new(
+        KeyCode::Char('c'),
+        KeyModifiers::CONTROL
+    )));
+    let mut repeat = KeyEvent::new(KeyCode::Char('x'), KeyModifiers::NONE);
+    repeat.kind = KeyEventKind::Repeat;
+    assert!(
+        matches!(input(repeat, true), Some(ModInput::Consumed)),
+        "held keys stay in the dialog"
+    );
+    let narrow = Rect::new(0, 0, 40, 12);
+    render(narrow, narrow, &mut Buffer::empty(narrow), &snapshot);
+    assert!(focus("review"));
+    assert!(matches!(
+        input(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE), true),
+        Some(ModInput::Consumed)
+    ));
+    assert_eq!(
+        test_interaction
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused,
+        None
+    );
+    assert!(input(KeyEvent::new(KeyCode::Char('a'), KeyModifiers::NONE), true).is_none());
+    let mut buffer = Buffer::empty(area);
+    render(area, area, &mut buffer, &snapshot);
+    assert!(!rows(&buffer, area).contains("Settings"));
+    assert!(input(KeyEvent::new(KeyCode::Char('a'), KeyModifiers::NONE), true).is_none());
+}
