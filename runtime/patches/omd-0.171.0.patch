+/// Where a tool row is drawn: a compact row, a row the user opened, or the full transcript.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum Presentation {
+    Row,
+    Opened,
+    Transcript,
+}
+
+impl Presentation {
+    fn of(open: bool, transcript: bool) -> Self {
+        match (open, transcript) {
+            (_, true) => Self::Transcript,
+            (true, false) => Self::Opened,
+            (false, false) => Self::Row,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Self::Row => "row",
+            Self::Opened => "opened",
+            Self::Transcript => "transcript",
+        }
+    }
+
+    fn apply(self, props: &mut serde_json::Value, expanded: bool) {
+        props["expanded"] = expanded.into();
+        props["presentation"] = self.name().into();
+    }
+}
+
+/// Runs `cell`'s native drawing through the matching mod `render` hooks, telling tool rows how they are presented; the flag reports whether a hook replaced the native drawing.
+pub(crate) fn hooked_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    presentation: Presentation,
+    draw: impl FnOnce(&C, u16) -> Vec<HyperlinkLine>,
+) -> (Vec<HyperlinkLine>, bool) {
+    let expanded = presentation != Presentation::Row;
+    let expanded_ids = if expanded {
+        cell.activity_ids().into_iter().collect()
+    } else {
+        Default::default()
+    };
+    if let Some(members) = hooked_member_lines(
+        cell,
+        width,
+        &expanded_ids,
+        presentation == Presentation::Transcript,
+    ) {
+        return (
+            members
+                .into_iter()
+                .flat_map(|member| member.lines)
+                .collect(),
+            true,
+        );
+    }
+    match cell.render_target() {
+        Some(mut target) => {
+            if target.component == "tool_call" {
+                presentation.apply(&mut target.props, expanded);
+            }
+            let (mut lines, replaced) =
+                crate::mod_render::hyperlink_lines(&target, width, |props, width| {
+                    cell.render_native(props, draw(cell, width))
+                });
+            lines.extend(crate::mod_render::tool_notice_lines(&target));
+            (lines, replaced)
+        }
+        None => (draw(cell, width), false),
+    }
+}
+
+pub(crate) struct RenderMember<'a> {
+    pub(crate) id: String,
+    pub(crate) target: crate::mod_render::RenderTarget,
+    pub(crate) native: Box<dyn Fn(u16, bool) -> Vec<HyperlinkLine> + 'a>,
+}
+
+pub(crate) struct MemberLines {
+    pub(crate) id: String,
+    pub(crate) lines: Vec<HyperlinkLine>,
+}
+
+fn member_lines(member: RenderMember<'_>, width: u16, open: bool) -> MemberLines {
+    let (mut lines, _) = crate::mod_render::hyperlink_lines(&member.target, width, |_, width| {
+        (member.native)(width, open)
+    });
+    lines.extend(crate::mod_render::tool_notice_lines(&member.target));
+    MemberLines {
+        id: member.id,
+        lines,
+    }
+}
+
+/// A run a hook draws is one header row, followed by a row per step once opened or in the transcript.
+fn hooked_run_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: &std::collections::HashSet<String>,
+    transcript: bool,
+) -> Option<Vec<MemberLines>> {
+    let mut target = cell
+        .render_target()
+        .filter(|target| target.props["kind"] == "run")?;
+    let open = transcript || expanded.contains(&target.id);
+    Presentation::of(open, transcript).apply(&mut target.props, open);
+    crate::mod_render::resolve(&target, width)?;
+    let header = member_lines(
+        RenderMember {
+            id: target.id.clone(),
+            target,
+            native: Box::new(|width, _| cell.display_hyperlink_lines(width)),
+        },
+        width,
+        open,
+    );
+    let mut lines = vec![header];
+    if open {
+        lines.extend(cell.render_members(width).into_iter().map(|mut member| {
+            let open = transcript || expanded.contains(&member.id);
+            Presentation::of(open, transcript).apply(&mut member.target.props, open);
+            member_lines(member, width, open)
+        }));
+    }
+    Some(lines)
+}
+
+pub(crate) fn hooked_member_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: &std::collections::HashSet<String>,
+    transcript: bool,
+) -> Option<Vec<MemberLines>> {
+    if !crate::mod_render::enabled() {
+        return None;
+    }
+    if let Some(lines) = hooked_run_lines(cell, width, expanded, transcript) {
+        return Some(lines);
+    }
+    let mut members = cell.render_members(width);
+    for member in &mut members {
+        Presentation::Row.apply(&mut member.target.props, false);
+    }
+    // A group stays per-member while any compact row is hooked; expanded rows are probed compact only as a last resort, since their drawn render must be the last one queued.
+    let hooked =
+        |member: &RenderMember| crate::mod_render::resolve(&member.target, width).is_some();
+    let (open, compact): (Vec<_>, Vec<_>) = members
+        .iter()
+        .partition(|member| expanded.contains(&member.id));
+    if !compact.into_iter().any(hooked) && !open.into_iter().any(hooked) {
+        return None;
+    }
+    Some(
+        members
+            .into_iter()
+            .map(|mut member| {
+                let open = expanded.contains(&member.id);
+                Presentation::of(open, transcript).apply(&mut member.target.props, open);
+                member_lines(member, width, open)
+            })
+            .collect(),
+    )
+}
