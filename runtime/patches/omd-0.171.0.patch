+        for (column, row) in [(-1, -3), (0, i32::MIN), (i32::MIN, i32::MAX), (i32::MAX, 0)] {
+            let event = json!({"kind": "pointer", "pointer": {
+                "column": column, "row": row, "half": 1, "action": action, "button": "left"
