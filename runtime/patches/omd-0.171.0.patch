+static REMOTE_PACKAGES: Mutex<Option<Value>> = Mutex::new(None);
+static REMOTE_STATUS: Mutex<Option<Arc<Value>>> = Mutex::new(None);
+
+fn decode_owner_snapshot(value: Value) -> Result<ModViewSnapshot, String> {
+    if value.is_null() {
+        return Ok(ModViewSnapshot::default());
+    }
+    serde_json::from_value(value).map_err(|error| error.to_string())
+}
+
+fn cache_remote_catalog(value: &Value) -> Arc<Value> {
+    let status = Arc::new(value["status"].clone());
+    *REMOTE_STATUS.locked() = Some(status.clone());
+    *REMOTE_PACKAGES.locked() = Some(value["packages"].clone());
+    if let Ok(builtins) = serde_json::from_value(value["builtins"].clone()) {
+        *EFFECTIVE_BUILTINS.locked() = builtins;
+    }
+    if let Ok(snapshot) = decode_owner_snapshot(value["view"].clone()) {
+        publish_owner_snapshot(snapshot);
+    }
+    status
+}
