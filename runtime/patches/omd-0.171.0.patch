+#[derive(Default)]
+pub struct ThreadOwnedTerminal {
+    cleanup: Mutex<Vec<Box<dyn FnOnce() + Send + Sync>>>,
+}
+
+impl std::fmt::Debug for ThreadOwnedTerminal {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("ThreadOwnedTerminal")
+    }
+}
+
+impl ThreadOwnedTerminal {
+    pub fn on_drop(&self, cleanup: impl FnOnce() + Send + Sync + 'static) {
+        self.cleanup
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .push(Box::new(cleanup));
+    }
+}
+
+impl Drop for ThreadOwnedTerminal {
+    fn drop(&mut self) {
+        for cleanup in self
+            .cleanup
+            .get_mut()
+            .unwrap_or_else(PoisonError::into_inner)
+            .drain(..)
+        {
+            cleanup();
+        }
+    }
+}
