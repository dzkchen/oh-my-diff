+
+fn component_height(
+    components: &[ModComponent],
+    width: u16,
+    look: (ModBorder, ModIcons),
+    interaction: &Interaction,
+) -> u16 {
+    components
+        .iter()
+        .map(|component| match component {
+            ModComponent::Box { .. } | ModComponent::Pane { .. } if !component.fits(width) => 0,
+            ModComponent::Box {
+                title,
+                children,
+                style,
+                ..
+            } => {
+                let frame = Frame::new(style.unwrap_or_default(), look, false, false);
+                frame.rows(title.is_some())
+                    + stack_height(children, frame.inner(width), &frame, interaction)
+            }
+            ModComponent::Dialog {
+                children, style, ..
+            } => {
+                let frame = Frame::card(*style, look, false, false);
+                frame.rows(true) + stack_height(children, frame.inner(width), &frame, interaction)
+            }
+            ModComponent::Pane {
+                collapsed,
+                children,
+                style,
+                ..
+            } => {
+                let mut frame = Frame::card(*style, look, false, false);
+                if *collapsed {
+                    frame.padding.0 = 0;
+                    frame.rows(true)
+                } else {
+                    frame.rows(true)
+                        + stack_height(children, frame.inner(width), &frame, interaction).min(8)
+                }
+            }
+            ModComponent::Line { .. } => 1,
+            ModComponent::Text { text, .. } => {
+                u16::try_from(text.lines().count()).unwrap_or(u16::MAX)
+            }
+            ModComponent::Markdown { text, .. } => {
+                u16::try_from(markdown_lines(text, width).len()).unwrap_or(u16::MAX)
+            }
+            ModComponent::Code {
+                text,
+                language,
+                start,
+                ..
+            } => u16::try_from(
+                usize::from(language.is_some())
+                    + code_lines(text, language.as_deref().unwrap_or_default())
+                        .len()
+                        .saturating_sub(*start),
+            )
+            .unwrap_or(u16::MAX),
+            ModComponent::Button { .. }
+            | ModComponent::Input { .. }
+            | ModComponent::Select { .. } => 1,
+            ModComponent::Multiselect { options, .. } => {
+                u16::try_from(options.len() + 1).unwrap_or(u16::MAX)
+            }
+            ModComponent::List { rows, height, .. } => {
+                u16::try_from(rows.len().clamp(1, usize::from(height.unwrap_or(8))))
+                    .unwrap_or(u16::MAX)
+            }
+            ModComponent::Document {
+                id,
+                lines,
+                source,
+                height,
+                ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                source.is_none().then_some(lines.len()),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Diff {
+                id,
+                unified,
+                height,
+                ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                Some(unified.lines().count()),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Image {
+                id, image, height, ..
+            } => crate::mod_components::image_height(
+                image,
+                &interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>(),
+                width,
+                height.unwrap_or(12),
+            ),
+            ModComponent::Raster { height, .. } => height.unwrap_or(RASTER_HEIGHT),
+            ModComponent::Module { id, height, .. } => {
+                height.unwrap_or_else(|| crate::mod_module::height(id))
+            }
+            ModComponent::Terminal {
+                id,
+                session,
+                height,
+                ..
+            } => crate::mod_pty::height(
+                interaction
+                    .component_owners
+                    .get(id)
+                    .and_then(|owner| interaction.pty_bindings.get(owner)),
+                session,
+                height.unwrap_or(16),
+            ),
+            ModComponent::Slot | ModComponent::Native { .. } => 0,
+        })
+        .sum()
+}
+
+/// Leaves only dialogs, progress and diagnostics in the inline viewport once a mod hides its sites.
+pub(crate) fn inline_snapshot(mut snapshot: Arc<ModViewSnapshot>) -> Arc<ModViewSnapshot> {
+    if snapshot.view.inline_sites.is_some() {
+        let snapshot = Arc::make_mut(&mut snapshot);
+        snapshot
+            .view
+            .sites
+            .retain(|name, _| name != "sidebar" && name != "header" && !name.contains('/'));
+        snapshot.view.panels.clear();
+        snapshot.view.header = None;
+    }
+    snapshot
+}
+
+pub(crate) fn header_rows(screen: Rect, snapshot: &ModViewSnapshot) -> u16 {
+    if screen.height < 16 {
+        return 0;
+    }
+    if let Some(header) = site(&snapshot.view, "header") {
+        let width = column(screen, snapshot).width;
+        let mut components = Vec::new();
+        for component in &header.components {
+            component.descendants(&mut components);
+        }
+        let owned = components.iter().any(|component| {
+            matches!(
+                component,
+                ModComponent::Image { .. } | ModComponent::Terminal { .. }
+            )
+        });
+        let interaction = if owned {
+            Interaction {
+                component_owners: snapshot.component_owners.clone(),
+                pty_bindings: pty_bindings(snapshot),
+                ..Interaction::default()
+            }
+        } else {
+            Interaction::default()
+        };
+        return component_height(
+            &header.components,
+            width,
+            (snapshot.view.theme.border, snapshot.view.theme.icons),
+            &interaction,
+        )
+        .clamp(1, 6)
+            + 1;
+    }
+    match &snapshot.view.header {
+        Some(header) => u16::try_from(header.lines.len()).unwrap_or(3).min(3) + 2,
+        None => 0,
+    }
+}
+
+fn named_sites(view: &ModView) -> impl Iterator<Item = &ModRenderSite> {
+    view.sites
+        .iter()
+        .filter(|(name, site)| name.contains('/') && site.overlay.is_none())
+        .map(|(_, site)| site)
+}
+
+fn has_sidebar(snapshot: &ModViewSnapshot) -> bool {
+    site(&snapshot.view, "sidebar").is_some_and(|site| !site.components.is_empty())
+        || named_sites(&snapshot.view).any(|site| !site.components.is_empty())
+        || !snapshot.view.panels.is_empty()
+}
+
+fn sidebar(area: Rect, snapshot: &ModViewSnapshot) -> Option<Rect> {
+    if area.width < 80 || !has_sidebar(snapshot) {
+        return None;
+    }
+    let width = snapshot
+        .view
+        .sidebar_width
+        .clamp(20, 60)
+        .min(area.width / 3);
+    Some(match snapshot.view.sidebar_side {
+        ModSidebarSide::Left => Rect { width, ..area },
+        ModSidebarSide::Right => Rect {
+            x: area.right() - width,
+            width,
+            ..area
+        },
+    })
+}
+
+fn column(area: Rect, snapshot: &ModViewSnapshot) -> Rect {
+    match sidebar(area, snapshot) {
+        Some(bar) if snapshot.view.sidebar_side == ModSidebarSide::Left => Rect {
+            x: bar.right(),
+            width: area.width - bar.width,
+            ..area
+        },
+        Some(bar) => Rect {
+            width: area.width - bar.width,
+            ..area
+        },
+        None => area,
+    }
+}
