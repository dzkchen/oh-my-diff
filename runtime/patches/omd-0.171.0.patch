+
+async fn intercept_user_text(
+    session: &Arc<Session>,
+    content: &mut Vec<ResolvedUserInput>,
+    client_id: Option<&str>,
+    terminal_owner: Option<codex_protocol::turn_input::TerminalOwner>,
+    submission_id: &str,
+) -> CodexResult<()> {
+    let contributors = session.services.extensions.turn_lifecycle_contributors();
+    if contributors.is_empty() {
+        return Ok(());
+    }
+    for item in content.iter() {
+        let (source, bytes) = match item {
+            ResolvedUserInput::LocalImage { path, bytes, .. } => (
+                path.display().to_string(),
+                bytes.as_deref().map(<[u8]>::to_vec).unwrap_or_default(),
+            ),
+            ResolvedUserInput::Image { image, .. } => (
+                "image".to_string(),
+                serde_json::to_vec(image.as_ref()).unwrap_or_default(),
+            ),
+            _ => continue,
+        };
+        session
+            .notify_instructions_loaded("attachment", &source, &bytes, "explicit", None)
+            .await;
+    }
+    let mut text = content
+        .iter()
+        .filter_map(|item| match item {
+            ResolvedUserInput::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    if text.is_empty() {
+        return Ok(());
+    }
+    let attachments = content
+        .iter()
+        .filter(|item| !matches!(item, ResolvedUserInput::Text { .. }))
+        .count();
+    let items = content
+        .iter()
+        .filter_map(|item| serde_json::to_value(item.to_user_input()).ok())
+        .collect::<Vec<_>>();
+    for contributor in contributors {
+        let decision = contributor
+            .intercept_user_input(codex_extension_api::UserInputInterceptInput {
+                terminal_owner: terminal_owner.clone(),
+                text: &text,
+                attachments,
+                client_id,
+                items: &items,
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+            })
+            .await;
+        match decision {
+            codex_extension_api::UserInputDecision::Keep => {}
+            codex_extension_api::UserInputDecision::Deny { notice } => {
+                return Err(CodexErr::InvalidRequest(notice));
+            }
+            codex_extension_api::UserInputDecision::Rewrite {
+                text: rewritten,
+                notice,
+            } => {
+                let position = content
+                    .iter()
+                    .position(|item| matches!(item, ResolvedUserInput::Text { .. }))
+                    .unwrap_or(0);
+                content.retain(|item| !matches!(item, ResolvedUserInput::Text { .. }));
+                content.insert(
+                    position.min(content.len()),
+                    ResolvedUserInput::text(rewritten.clone()),
+                );
+                text = rewritten;
+                session
+                    .send_event_raw(Event {
+                        id: submission_id.to_string(),
+                        msg: EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                            message: notice,
+                        }),
+                    })
+                    .await;
+            }
+        }
+    }
+    Ok(())
+}
