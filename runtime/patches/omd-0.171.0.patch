+            .watch("n", "sha", &[".".to_owned()], true, true, None, None, sink)
+            .unwrap_err()
+            .to_string(),
+        "watch_git_unavailable"
+    );
+
+    for other in [
+        base.join("private/.git"),
+        base.join("elsewhere/.git/modules/sub"),
+    ] {
+        for path in [other.join("refs/heads"), other.join("objects")] {
+            std::fs::create_dir_all(path).unwrap();
+        }
+        std::fs::write(other.join("HEAD"), "ref: refs/heads/main\n").unwrap();
+        std::fs::write(sub.join(".git"), format!("gitdir: {}\n", other.display())).unwrap();
+        let (sink, _rx) = channel_sink();
+        assert_eq!(
+            watches
+                .watch("o", "sha", &[".".to_owned()], true, true, None, None, sink)
+                .unwrap_err()
+                .to_string(),
+            "watch_git_unavailable",
+            "{other:?}"
+        );
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_git_watch_resolves_relative_worktree_links_from_the_git_directory() {
+    let dir = tempfile::tempdir().unwrap();
+    let base = dir.path().canonicalize().unwrap();
+    let (main, tree) = (base.join("main/.git"), base.join("tree"));
+    let own = main.join("worktrees/tree");
+    for path in [main.join("refs/heads"), own.clone(), tree.clone()] {
+        std::fs::create_dir_all(path).unwrap();
+    }
+    std::fs::write(own.join("commondir"), "../..\n").unwrap();
+    std::fs::write(own.join("gitdir"), "../../../../tree/.git\n").unwrap();
+    std::fs::write(tree.join(".git"), "gitdir: ../main/.git/worktrees/tree\n").unwrap();
+    let watches = WorkspaceWatches::new(
+        Arc::new(FileWatcher::new().unwrap()),
+        tree.clone(),
+        Vec::new(),
+        Default::default(),
+    )
+    .unwrap();
+    let (sink, rx) = channel_sink();
+    watches
+        .watch(
+            "m",
+            "sha",
+            &[".".to_owned()],
+            true,
+            true,
+            Some(50),
+            None,
+            sink,
+        )
+        .unwrap();
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    let seen = git_events(
+        rx,
+        move |round| {
+            std::fs::write(own.join("HEAD"), round.to_string()).unwrap();
+            std::fs::write(main.join("refs/heads/x"), round.to_string()).unwrap();
+        },
+        &[".git/HEAD", ".git/refs/heads/x"],
+    )
+    .await
+    .unwrap();
+    assert_linked_git_events(&seen);
+}
diff --git a/codex-rs/ext/omd/tests/omd_mod_cli.rs b/codex-rs/ext/omd/tests/omd_mod_cli.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2584580d6bb5f222dc21e98d96650525e6bbd079
--- /dev/null
+++ b/codex-rs/ext/omd/tests/omd_mod_cli.rs
@@ -0,0 +1,209 @@
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use codex_omd::MOD_API_VERSION;
+use codex_omd::ModStore;
+use serde_json::Value;
+use serde_json::json;
+use std::ffi::OsStr;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+use tempfile::TempDir;
+
+fn omd_mod(cwd: &Path, args: &[&OsStr]) -> Result<Value, String> {
+    let output = Command::new(env!("CARGO_BIN_EXE_omd-mod"))
+        .args(args)
+        .current_dir(cwd)
+        .output()
+        .unwrap();
+    if output.status.success() {
+        Ok(serde_json::from_slice::<Value>(&output.stdout).unwrap())
+    } else {
+        Err(String::from_utf8_lossy(&output.stderr).into_owned())
+    }
+}
+
+fn package(
+    root: &Path,
+    id: &str,
+    source: &str,
+    capabilities: &[&str],
+    state_scope: Option<&str>,
+) -> PathBuf {
+    let path = root.join(id);
+    std::fs::create_dir(&path).unwrap();
+    let mut manifest = json!({"schema":1,"id":id,"version":"1.0.0",
+        "api":MOD_API_VERSION,"state_version":1,"capabilities":capabilities});
+    if let Some(scope) = state_scope {
+        manifest["state_scope"] = json!(scope);
+    }
+    std::fs::write(
+        path.join("mod.json"),
+        serde_json::to_vec(&manifest).unwrap(),
+    )
+    .unwrap();
+    std::fs::write(path.join("index.ts"), source).unwrap();
+    path
+}
+
+fn trust(store: &ModStore, path: &Path, capabilities: &[&str]) {
+    let inspected = ModStore::inspect_package(path).unwrap();
+    let granted: Vec<String> = capabilities
+        .iter()
+        .map(std::string::ToString::to_string)
+        .collect();
+    let sha256 = inspected["sha256"].as_str().unwrap();
+    store
+        .trust(path.to_path_buf(), sha256, granted, "user")
+        .unwrap();
+    store.enable(path, true).unwrap();
+}
+
+#[test]
+fn credentials_cli_stores_and_replaces_a_mod_owned_secret_from_stdin() {
+    use std::io::Write;
+    let temp = TempDir::new().unwrap();
+    let store = temp.path().canonicalize().unwrap();
+    let add = |value: &str| {
+        let mut child = std::process::Command::new(env!("CARGO_BIN_EXE_omd-mod"))
+            .arg("credentials")
+            .arg(&store)
+            .args([
+                "add-secret",
+                "fixture_mod",
+                "fixture",
+                "https://api.example.com",
+            ])
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .spawn()
+            .unwrap();
+        child
+            .stdin
+            .take()
+            .unwrap()
+            .write_all(value.as_bytes())
+            .unwrap();
+        let output = child.wait_with_output().unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        serde_json::from_slice::<Value>(&output.stdout).unwrap()
+    };
+    let first = add("first-key\n");
+    assert_eq!(
+        (&first["kind"], &first["label"], &first["status"]),
+        (&json!("secret"), &json!("fixture"), &json!("ready"))
+    );
+    let second = add("second-key");
+    assert_eq!(second["id"], first["id"]);
+    let profiles = codex_omd::credentials::CredentialProfiles::local(&store).unwrap();
+    let id = first["id"].as_str().unwrap();
+    assert_eq!(
+        profiles.owned_secret(id, "fixture_mod").unwrap()["value"],
+        "second-key"
+    );
+    assert!(profiles.owned_secret(id, "another_mod").is_err());
+    assert!(profiles.visible("").unwrap().is_empty());
+}
+
+#[test]
+fn omd_mod_reset_moves_only_resettable_store_files_aside() {
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap().join("store");
+    ModStore::create(root.clone()).unwrap();
+    std::fs::write(root.join("host.json"), b"{broken").unwrap();
+    let reset = |name: &str| {
+        omd_mod(
+            temp.path(),
+            &[OsStr::new("reset"), root.as_os_str(), OsStr::new(name)],
+        )
+    };
+    let aside = root.join("host.json.corrupt");
+    assert_eq!(
+        reset("host.json"),
+        Ok(json!({"reset": "host.json", "aside": aside}))
+    );
+    assert_eq!(std::fs::read(&aside).unwrap(), b"{broken");
+    assert!(!root.join("host.json").exists());
+    assert!(
+        reset("grants.json")
+            .unwrap_err()
+            .contains("store_file_not_resettable")
+    );
+}
+
+#[test]
+fn command_cli_scopes_state_to_the_thread_or_the_checkout_of_its_cwd() {
+    let source = "export default api => { api.command('count', () => { api.state.set(Number(api.state.get() ?? 0)+1); return api.state.get(); }); }";
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let checkout = root.join("checkout");
+    std::fs::create_dir_all(checkout.join(".git")).unwrap();
+    std::fs::create_dir_all(checkout.join("sub")).unwrap();
+    let store = ModStore::create(root.join("store")).unwrap();
+    for (id, scope) in [("threaded", "thread"), ("shared", "checkout")] {
+        let path = package(&root, id, source, &["commands", "store"], Some(scope));
+        trust(&store, &path, &["commands", "store"]);
+    }
+    let cli = |cwd: &Path, args: &[&str]| {
+        let store = root.join("store");
+        let mut arguments = vec![OsStr::new("command"), store.as_os_str()];
+        arguments.extend(args.iter().map(OsStr::new));
+        omd_mod(cwd, &arguments)
+    };
+    assert_eq!(
+        cli(&checkout, &["threaded", "count", "null", "t5"]),
+        Ok(json!(1))
+    );
+    assert_eq!(
+        cli(&checkout, &["threaded", "count", "null", "t5"]),
+        Ok(json!(2))
+    );
+    assert!(
+        cli(&checkout, &["threaded", "count", "null"])
+            .unwrap_err()
+            .contains("state_thread_unavailable")
+    );
+    assert_eq!(
+        cli(&checkout.join("sub"), &["shared", "count", "null"]),
+        Ok(json!(1))
+    );
+    assert_eq!(cli(&checkout, &["shared", "count", "null"]), Ok(json!(2)));
+    assert!(checkout.join(".git/omd/state/shared.json").is_file());
+}
+
+#[test]
+fn omd_mod_rejects_a_tool_schema_the_host_validator_refuses() {
+    let status = |parameters: &str| {
+        let source = format!(
+            "export default api => api.tool({{name:'probe',description:'probe',parameters:{parameters}}},()=>null)"
+        );
+        let temp = TempDir::new().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let store_path = root.join("store");
+        let store = ModStore::create(store_path.clone()).unwrap();
+        let path = package(&root, "fixture", &source, &["tools"], None);
+        trust(&store, &path, &["tools"]);
+        let status = omd_mod(&root, &[OsStr::new("status"), store_path.as_os_str()]).unwrap();
+        status["mods"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|item| item["id"] == "fixture")
+            .cloned()
+            .unwrap()
+    };
+    let accepted = status("{type:'object',properties:{}}");
+    assert!(accepted["error"].is_null(), "{accepted}");
+    let rejected = status("{type:'null'}");
+    assert!(
+        rejected["error"]
+            .as_str()
+            .is_some_and(|error| !error.is_empty()),
+        "{rejected}"
+    );
+}
diff --git a/codex-rs/models-manager/src/runtime_models.rs b/codex-rs/models-manager/src/runtime_models.rs
new file mode 100644
index 0000000000000000000000000000000000000000..24f6be8e26b8ae8fac98dc2d76a61235fa489774
--- /dev/null
+++ b/codex-rs/models-manager/src/runtime_models.rs
@@ -0,0 +1,185 @@
+//! Models that a runtime provider adds to this process's catalog.
+
+use codex_protocol::openai_models::ModelInfo;
+use std::sync::PoisonError;
+use std::sync::RwLock;
+
+static MODELS: RwLock<Vec<(String, ModelInfo)>> = RwLock::new(Vec::new());
+static NAMES: RwLock<Vec<(String, String)>> = RwLock::new(Vec::new());
+
+/// Replaces the models `provider` adds; an empty list removes them.
+pub fn set(provider: &str, models: Vec<ModelInfo>) {
+    let mut all = MODELS.write().unwrap_or_else(PoisonError::into_inner);
+    all.retain(|(owner, _)| owner != provider);
+    all.extend(
+        models
+            .into_iter()
+            .map(|model| (provider.to_string(), model)),
+    );
+}
+
+/// Names `provider` in the model picker; `None` falls back to its id.
+pub fn set_name(provider: &str, name: Option<String>) {
+    let mut names = NAMES.write().unwrap_or_else(PoisonError::into_inner);
+    names.retain(|(owner, _)| owner != provider);
+    names.extend(name.map(|name| (provider.to_string(), name)));
+}
+
+/// Returns the picker name of `provider`, if one was set.
+pub fn name(provider: &str) -> Option<String> {
+    NAMES
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(owner, _)| owner == provider)
+        .map(|(_, name)| name.clone())
+}
+
+/// Returns every runtime model with its provider id.
+pub fn all() -> Vec<(String, ModelInfo)> {
+    MODELS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .clone()
+}
+
+/// Returns the runtime model with this exact slug and its provider id.
+pub fn find(slug: &str) -> Option<(String, ModelInfo)> {
+    MODELS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(_, model)| model.slug == slug)
+        .cloned()
+}
+
+static WINDOWS: RwLock<Vec<(String, i64)>> = RwLock::new(Vec::new());
+
+pub fn set_context_windows(windows: Vec<(String, i64)>) {
+    *WINDOWS.write().unwrap_or_else(PoisonError::into_inner) = windows;
+}
+
+pub fn context_window(slug: &str) -> Option<i64> {
+    WINDOWS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(model, _)| model == slug)
+        .map(|(_, tokens)| *tokens)
+}
+
+static OWNED_MODELS: RwLock<Vec<(String, String, ModelInfo)>> = RwLock::new(Vec::new());
+static OWNED_NAMES: RwLock<Vec<(String, String, String)>> = RwLock::new(Vec::new());
+
+pub fn set_for(owner: Option<&str>, provider: &str, models: Vec<ModelInfo>) {
+    let Some(owner) = owner else {
+        return set(provider, models);
+    };
+    let mut all = OWNED_MODELS.write().unwrap_or_else(PoisonError::into_inner);
+    all.retain(|(terminal, id, _)| terminal != owner || id != provider);
+    all.extend(
+        models
+            .into_iter()
+            .map(|model| (owner.into(), provider.into(), model)),
+    );
+}
+
+pub fn set_name_for(owner: Option<&str>, provider: &str, name: Option<String>) {
+    let Some(owner) = owner else {
+        return set_name(provider, name);
+    };
+    let mut all = OWNED_NAMES.write().unwrap_or_else(PoisonError::into_inner);
+    all.retain(|(terminal, id, _)| terminal != owner || id != provider);
+    all.extend(name.map(|name| (owner.into(), provider.into(), name)));
+}
+
+pub fn all_for(owner: Option<&str>) -> Vec<(String, ModelInfo)> {
+    let Some(owner) = owner else {
+        return all();
+    };
+    OWNED_MODELS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .filter(|(terminal, _, _)| terminal == owner)
+        .map(|(_, provider, model)| (provider.clone(), model.clone()))
+        .collect()
+}
+
+pub fn find_for(owner: Option<&str>, slug: &str) -> Option<(String, ModelInfo)> {
+    all_for(owner)
+        .into_iter()
+        .find(|(_, model)| model.slug == slug)
+}
+
+pub fn name_for(owner: Option<&str>, provider: &str) -> Option<String> {
+    let Some(owner) = owner else {
+        return name(provider);
+    };
+    OWNED_NAMES
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(terminal, id, _)| terminal == owner && id == provider)
+        .map(|(_, _, name)| name.clone())
+}
+
+pub fn picker_for(
+    owner: Option<&str>,
+    mut presets: Vec<codex_protocol::openai_models::ModelPreset>,
+) -> Vec<codex_protocol::openai_models::ModelPreset> {
+    if owner.is_none() {
+        return presets;
+    }
+    let defaults = all();
+    presets.retain(|preset| {
+        !defaults.iter().any(|(provider, model)| {
+            preset.model_provider.as_ref() == Some(provider) && preset.model == model.slug
+        })
+    });
+    presets.extend(all_for(owner).into_iter().map(|(provider, model)| {
+        codex_protocol::openai_models::ModelPreset {
+            model_provider_name: name_for(owner, &provider),
+            model_provider: Some(provider),
+            ..model.into()
+        }
+    }));
+    presets
+}
+
+#[cfg(test)]
+mod owner_tests {
+    use super::*;
+
+    #[test]
+    fn terminal_provider_catalogs_and_shutdown_are_independent() {
+        let provider = "owner-catalog-provider";
+        let slug = "owner-catalog-model";
+        let mut a = crate::model_info::model_info_from_slug(slug);
+        a.context_window = Some(1000);
+        let mut b = a.clone();
+        b.context_window = Some(2000);
+        set_for(Some("catalog-a"), provider, vec![a]);
+        set_name_for(Some("catalog-a"), provider, Some("A".into()));
+        set_for(Some("catalog-b"), provider, vec![b]);
+        set_name_for(Some("catalog-b"), provider, Some("B".into()));
+        assert_eq!(
+            find_for(Some("catalog-a"), slug).unwrap().1.context_window,
+            Some(1000)
+        );
+        assert_eq!(
+            find_for(Some("catalog-b"), slug).unwrap().1.context_window,
+            Some(2000)
+        );
+        assert!(find_for(Some("catalog-fresh"), slug).is_none());
+        set_for(Some("catalog-a"), provider, Vec::new());
+        set_name_for(Some("catalog-a"), provider, None);
+        assert!(find_for(Some("catalog-a"), slug).is_none());
+        assert_eq!(name_for(Some("catalog-b"), provider).as_deref(), Some("B"));
+        assert!(find_for(Some("catalog-b"), slug).is_some());
+        assert!(picker_for(Some("catalog-a"), Vec::new()).is_empty());
+        assert_eq!(picker_for(Some("catalog-b"), Vec::new()).len(), 1);
+        set_for(Some("catalog-b"), provider, Vec::new());
+        set_name_for(Some("catalog-b"), provider, None);
+    }
+}
