+}
+
+async fn items_text(mcp: &mut TestAppServer, thread_id: &str) -> Result<String> {
+    let ThreadItemsListResponse { data, .. } = mcp
+        .request(|request_id| ClientRequest::ThreadItemsList {
+            request_id,
+            params: ThreadItemsListParams {
