+fn settled(redraws: &std::sync::atomic::AtomicUsize) -> usize {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        let before = redraws.load(Ordering::SeqCst);
+        std::thread::sleep(Duration::from_millis(300));
+        if redraws.load(Ordering::SeqCst) == before {
+            return before;
+        }
+        assert!(Instant::now() < deadline, "redraws never settled");
+    }
+}
