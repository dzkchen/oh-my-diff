+        assert_eq!(
+            recorded["environment"]["FIXTURE_TOKEN"],
+            json!({"sha256": codex_omd::sha256_hex(b"private-token")})
+        );
+        assert!(
+            !String::from_utf8(evidence)
+                .unwrap()
+                .contains("private-token")
+        );
+    }
+}
