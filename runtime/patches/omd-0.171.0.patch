+        codex_omd::continue_operation(
+            &runtime,
+            "component_change",
+            input,
+            json!({"owner": owner}),
+            || true,
+            |_, _| Err(std::io::Error::other("unexpected host call")),
+            |effective| {
+                Ok(match effective["kind"].as_str() {
