+        );
+        assert_eq!(
+            drawn.activity.len(),
+            1,
+            "resize lost native completion activity"
+        );
+        assert_eq!(
+            drawn.native_diagnostics,
+            vec!["after completion".to_owned()]
+        );
+        assert_eq!(
+            drawn.view.title,
+            Some(crate::mod_client::value()["columns"].to_string()),
+            "the current viewport must still be rendered"
+        );
+    });
