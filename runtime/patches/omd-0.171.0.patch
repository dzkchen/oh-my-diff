+                if (e.from === 'name' && e.to === 'other') return {deny: 'finish the name'};
+                if (e.to === 'skip') return {focus: 'name'};
+                if (e.to === 'bad') return {focus: 'Not An Id'};
+                return next(e);
+            })",
+        ),
+        (
+            "intruder",
+            "export default api => api.intercept('component_change', () => ({deny: 'mine'}))",
