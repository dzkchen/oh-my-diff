+            area,
+            owned_chat_area(area, &snapshot, 0),
+            &mut buffer,
+            &snapshot,
+        );
+        render_help(area, &snapshot, &mut buffer);
+        buffer
+    };
+    let press = |code, modifiers| input(KeyEvent::new(code, modifiers), true);
+    let region = || test_interaction.lock().unwrap().focus_region.clone();
+    let focused = || test_interaction.lock().unwrap().focused.clone();
+    draw();
+    assert!(press(KeyCode::Char('l'), KeyModifiers::NONE).is_none());
+    assert!(matches!(
+        press(KeyCode::Char(']'), KeyModifiers::CONTROL),
+        Some(ModInput::Consumed)
+    ));
+    assert_eq!(region().as_deref(), Some("demo/files"));
+    assert_eq!(focused().as_deref(), Some("files"));
+    let buffer = draw();
+    assert_eq!(
+        buffer[(0, 0)].fg,
+        crate::style::accent_style().fg.unwrap_or(Color::Reset)
+    );
+    press(KeyCode::Char('J'), KeyModifiers::NONE);
+    assert_eq!(region().as_deref(), Some("demo/files"));
+    press(KeyCode::Char('j'), KeyModifiers::NONE);
+    assert_eq!((region().as_deref(), focused()), (Some("demo/git"), None));
+    assert!(matches!(
+        press(KeyCode::Char('x'), KeyModifiers::NONE),
+        Some(ModInput::Consumed)
+    ));
