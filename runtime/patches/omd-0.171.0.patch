+        status: "completed".to_owned(),
+    };
+    let mut saved = snapshot(serde_json::json!({}));
+    saved.epoch = 7;
+    saved.input = serde_json::json!({"event": "start",
+        "ledger": {"thread_id": thread.to_string(), "cwd": repository}});
+    saved.activity = vec![activity(1, "watch"), activity(2, "list")];
+    let publish = |snapshot: &ModViewSnapshot| {
+        std::fs::write(
+            repository.join("mod-view.json"),
+            serde_json::to_vec(snapshot).unwrap(),
+        )
+        .unwrap();
+    };
+    publish(&saved);
+    startup_preview(Some(ModViewSnapshot::default()), &repository);
+    assert_eq!(take_new_activity(), Vec::new());
+    crate::mod_runtime::synchronize_context(crate::mod_runtime::ModContext {
+        thread_id: Some(thread),
+        repository: repository.clone(),
+        policy: codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted(),
+    });
+    invalidate_context();
+    refresh();
+    assert_eq!(take_new_activity(), Vec::new());
+    saved.revision = 1;
+    saved.activity.push(activity(3, "cancel"));
+    publish(&saved);
+    refresh();
+    assert_eq!(take_new_activity(), vec![activity(3, "cancel")]);
+    saved.epoch = u64::MAX;
+    saved.activity = vec![activity(1, "watch")];
+    publish(&saved);
+    refresh();
+    assert_eq!(take_new_activity(), vec![activity(1, "watch")]);
+}
