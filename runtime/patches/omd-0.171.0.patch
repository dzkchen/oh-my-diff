+
+fn status_prefix(summary: Option<String>, mod_segments: Vec<String>) -> Vec<Span<'static>> {
+    let mut prefix = Vec::new();
+    for part in summary
+        .map(ratatui::prelude::Stylize::bold)
+        .into_iter()
+        .chain(mod_segments.into_iter().map(Span::from))
+    {
+        if !prefix.is_empty() {
+            prefix.push(" · ".dim());
+        }
+        prefix.push(part);
+    }
+    prefix
+}
+
+fn prepend_status_prefix(
+    mut prefix: Vec<Span<'static>>,
+    line: Option<HyperlinkLine>,
+) -> Option<HyperlinkLine> {
+    if prefix.is_empty() {
+        return line;
+    }
+    let Some(mut line) = line else {
+        return Some(HyperlinkLine::from(Line::from(prefix)));
+    };
+    prefix.push(" · ".dim());
+    let shift = Line::from(prefix.clone()).width();
+    prefix.append(&mut line.line.spans);
+    line.line.spans = prefix;
+    line.source = None;
+    for hyperlink in &mut line.hyperlinks {
+        hyperlink.columns = hyperlink.columns.start + shift..hyperlink.columns.end + shift;
+    }
+    Some(line)
+}
