+#[tokio::test]
+async fn tool_spec_controls_use_task_owner_instead_of_the_shared_thread() {
+    struct OwnerSpecs(codex_protocol::turn_input::TerminalOwner);
+    impl codex_extension_api::ToolSpecContributor for OwnerSpecs {
+        fn adjusting(
+            &self,
+            turn_store: &codex_extension_api::ExtensionData,
+            _thread: &codex_extension_api::ExtensionData,
+        ) -> bool {
+            turn_store
+                .get::<codex_protocol::turn_input::TerminalOwner>()
+                .is_some_and(|owner| *owner == self.0)
+        }
+        fn adjust_tool_specs(
+            &self,
+            _turn: &codex_extension_api::ExtensionData,
+            _thread: &codex_extension_api::ExtensionData,
+            _specs: &[codex_extension_api::ToolSpecView],
+        ) -> Option<codex_extension_api::ToolSpecAdjustment> {
+            Some(codex_extension_api::ToolSpecAdjustment {
+                hide: vec!["mcp__srv__lookup".into()],
+                ..Default::default()
+            })
+        }
+    }
+    let (mut session, turn) = make_session_and_context().await;
+    let a = codex_protocol::turn_input::TerminalOwner(uuid::Uuid::new_v4());
+    let b = codex_protocol::turn_input::TerminalOwner(uuid::Uuid::new_v4());
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.tool_spec_contributor(Arc::new(OwnerSpecs(a.clone())));
+    session.services.extensions = Arc::new(extensions.build());
+    let mcp = codex_mcp::McpBinding::empty(mcp_config_for_test(&turn.config));
+    for (owner, expected) in [(a, 1), (b, 0)] {
+        let store = codex_extension_api::ExtensionData::new("task");
+        store.insert(owner);
+        let mut registry = build_core_tool_registry(
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            None,
+            None,
+        );
+        let tool = mcp_runtime("srv", "mcp__srv__", "lookup", ToolExposure::Direct);
+        registry.register_external_with_exposure(tool.runtime, tool.exposure);
+        assert_eq!(
+            crate::tools::spec_adjust::plan(&session, &store, &mut registry, false).len(),
+            expected
+        );
+    }
+}
