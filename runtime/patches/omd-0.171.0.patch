+        inspected["sha256"].as_str().expect("source digest"),
+        vec!["commands".into(), "terminal".into()],
+        "user",
+    )?;
+    store.enable(&package, true)?;
+    let runtime =
+        codex_omd::ModHost::open(root.join("store"), codex_omd::ModOpenOptions::default())?;
+    std::fs::write(
