+                Value::Null,
+                "routes_add_model_unknown",
+            ),
+            (
+                json!("made-up-model"),
+                Value::Null,
+                "routes_add_model_unknown",
+            ),
+            (json!(7), Value::Null, "routes_add_model_unknown"),
+        ] {
+            assert_eq!(
+                catalog_choice(&models, &model, &effort),
+                Err(error.to_owned())
+            );
+        }
+    }
+
+    #[test]
+    fn a_chosen_window_prefers_the_omd_window_then_config_then_live_then_bundled() {
+        codex_models_manager::runtime_models::set_context_windows(vec![
+            ("fixture-picked".into(), 100_000),
+            ("fixture-huge".into(), 900_000),
+        ]);
+        let live = |slug| info(slug, Some(400_000), Some(500_000));
+        assert_eq!(
