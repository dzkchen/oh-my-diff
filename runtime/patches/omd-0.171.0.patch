+#[test]
+#[serial_test::serial]
+fn hooked_runs_draw_a_row_a_header_with_steps_once_opened_and_native_transcripts() {
+    let cell = run();
+    let _hook = crate::mod_render::test_hook(|target| {
+        let props = &target.props;
+        let text = match (props["kind"].as_str()?, props["presentation"].as_str()?) {
+            (_, "transcript") => return None,
+            ("run", presentation) => {
+                format!("run {presentation} {}", props["calls"].as_array()?.len())
+            }
+            _ if props["expanded"] == true => return None,
+            (kind, presentation) => format!("{kind} {presentation}"),
+        };
+        Some(json!([{"type": "text", "id": "row", "label": "Row", "text": text}]))
+    });
+    let row = |text: &str| vec![text.to_owned()];
+    assert_eq!(
+        texts(&hooked_member_lines(&cell, 80, &Default::default(), false).unwrap()),
+        vec![("run:exec:c1".to_owned(), row("run row 2"))]
+    );
+    let opened = ["run:exec:c1".to_owned()].into_iter().collect();
+    assert_eq!(
+        texts(&hooked_member_lines(&cell, 80, &opened, false).unwrap()),
+        vec![
+            ("run:exec:c1".to_owned(), row("run opened 2")),
+            ("exec:c1".to_owned(), row("exec row")),
+            ("tool:a1:started".to_owned(), row("subagent row")),
+        ]
+    );
+    let every = cell.activity_ids().into_iter().collect();
+    let transcript = hooked_member_lines(&cell, 80, &every, true).unwrap();
+    assert_eq!(
+        transcript
+            .into_iter()
+            .map(|member| visible_lines(member.lines))
+            .collect::<Vec<_>>(),
+        cell.members()
+            .map(|member| visible_lines(member.expanded_hyperlink_lines(80)))
+            .collect::<Vec<_>>()
+    );
+    let props = cell.render_target().unwrap().props;
+    assert_eq!(
+        (
+            &props["kind"],
+            &props["status"],
+            &props["call_id"],
+            &props["calls"][1]["agent"]
