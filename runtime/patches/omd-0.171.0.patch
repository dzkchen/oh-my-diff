+    };
+    let result = session.request_approval(action, context).await.result;
+    let expected = if hook_denies {
+        assert!(matches!(result, Err(ToolError::Rejected(reason)) if reason == "hook says no"));
+        ("denied", "hook")
+    } else {
+        assert!(matches!(result, Ok(ReviewDecision::Approved)));
+        ("approved", "guardian")
+    };
