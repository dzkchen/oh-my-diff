+#[tokio::test(flavor = "multi_thread")]
+#[serial_test::serial]
+async fn remote_frontends_send_resized_client_viewports() {
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio_tungstenite::tungstenite::Message;
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            activate_configuration(false, None, None);
+        }
+    }
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("ws://{}", listener.local_addr().unwrap());
+    let (sent, mut viewports) = tokio::sync::mpsc::unbounded_channel();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+        while let Some(Ok(Message::Text(text))) = socket.next().await {
+            let codex_app_server_protocol::JSONRPCMessage::Request(request) =
+                serde_json::from_str(&text).unwrap()
+            else {
+                continue;
+            };
+            let result = if request.method == "initialize" {
+                serde_json::json!({"userAgent": "viewport-test"})
+            } else {
+                serde_json::json!({})
+            };
+            socket
+                .send(Message::Text(
+                    serde_json::json!({"id": request.id, "result": result})
+                        .to_string()
+                        .into(),
+                ))
+                .await
+                .unwrap();
+            if request.method == "omd/client/update" {
+                sent.send(request.params).unwrap();
+            }
+        }
+    });
+    let client = codex_app_server_client::RemoteAppServerClient::connect(
+        codex_app_server_client::RemoteAppServerConnectArgs {
+            required_human_approval: true,
+            endpoint: codex_app_server_client::RemoteAppServerEndpoint::WebSocket {
+                websocket_url: url,
+                auth_token: None,
+            },
+            client_name: "viewport-test".to_string(),
+            client_version: "0.0.0".to_string(),
+            experimental_api: true,
+            mcp_server_openai_form_elicitation: false,
+            opt_out_notification_methods: Vec::new(),
+            channel_capacity: 8,
+        },
+    )
+    .await
+    .unwrap();
+    let _reset = Reset;
+    crate::mod_client::update(true, 101, 31, false);
+    activate_configuration(
+        true,
+        Some("viewport-owner"),
+        Some(codex_app_server_client::AppServerRequestHandle::Remote(
+            client.request_handle(),
+        )),
+    );
+    let mut next = async || {
+        tokio::time::timeout(std::time::Duration::from_secs(10), viewports.recv())
+            .await
+            .expect("omd/client/update")
+            .unwrap()
+    };
+    let facts = |params: Option<serde_json::Value>| {
+        let params = params.unwrap();
+        (
+            params["viewport"].clone(),
+            params["client"]["columns"].clone(),
+            params["client"]["rows"].clone(),
+            params["client"]["chat"].clone(),
+        )
+    };
+    let viewport = |width: u16, height: u16| serde_json::json!({"width": width, "height": height, "unit": "cells"});
+    assert_eq!(
+        facts(next().await),
+        (
+            viewport(101, 31),
+            101.into(),
+            31.into(),
+            serde_json::Value::Null
+        )
+    );
+    crate::mod_client::update(true, 137, 41, false);
+    assert_eq!(
+        facts(next().await),
+        (
+            viewport(137, 41),
+            137.into(),
+            41.into(),
+            serde_json::Value::Null
+        ),
+        "a resize must send the new viewport and client facts"
+    );
+    crate::mod_client::note_chat(ratatui::layout::Rect::new(2, 1, 100, 30));
+    assert_eq!(
+        facts(next().await).3,
+        serde_json::json!({"x": 2, "y": 1, "columns": 100, "rows": 30}),
+        "a chat area change must send the new client facts"
+    );
+    client.shutdown().await.unwrap();
+    server.abort();
+}
