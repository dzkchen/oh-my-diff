+
+/// Applies the next submission result, returning the events queued before it unhandled.
+pub(super) async fn apply_user_turn_submission(
+    app: &mut App,
+    session: &mut AppServerSession,
+    events: &mut mpsc::UnboundedReceiver<AppEvent>,
+) -> Result<Vec<AppEvent>> {
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut skipped = Vec::new();
+    loop {
+        let event = tokio::time::timeout(Duration::from_secs(5), events.recv())
+            .await?
+            .ok_or_else(|| color_eyre::eyre::eyre!("app event channel closed"))?;
+        if matches!(event, AppEvent::UserTurnSubmissionFinished { .. }) {
+            Box::pin(app.handle_event(&mut tui, session, event)).await?;
+            return Ok(skipped);
+        }
+        skipped.push(event);
+    }
+}
+
+pub(super) async fn wait_for_user_turn_submission(
+    app: &mut App,
+    tui: &mut tui::Tui,
+    session: &mut AppServerSession,
+    events: &mut mpsc::UnboundedReceiver<AppEvent>,
+) -> Result<Arc<crate::app_event::UserTurnSubmissionResult>> {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let event = events
+                .recv()
+                .await
+                .ok_or_else(|| color_eyre::eyre::eyre!("app event channel closed"))?;
+            let completion = match &event {
+                AppEvent::UserTurnSubmissionFinished { completion, .. } => {
+                    Some(Arc::clone(completion))
+                }
+                _ => None,
+            };
+            app.handle_event(tui, session, event).await?;
+            app.drain_active_thread_events(tui).await?;
+            if let Some(completion) = completion {
+                return Ok(completion);
+            }
+        }
+    })
+    .await?
+}
