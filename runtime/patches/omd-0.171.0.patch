+            .insert("x-omd-route", "fast".parse().unwrap());
+        request.url = session.into();
+        let sent = accounts.before_send(&mut request, Some(&routed));
+        assert_eq!(sent.is_ok(), allowed, "{session} -> {target}");
+        if allowed {
