+         api.intercept('render', {match:{component:'composer_hint'}}, (e, next) => next(e)); \
+         api.command('relabel', name => { if (name) label.set(name); else api.atom('other', 0).set(1); return null; }); }",
+        &["terminal", "store", "commands"],
