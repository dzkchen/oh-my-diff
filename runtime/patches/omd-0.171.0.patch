+type PackageControl = codex_omd::package_controls::PackageControl;
+
+fn unrestricted_pty_program(
+    caller: &str,
+    arguments: &Value,
+) -> Result<(std::path::PathBuf, String, std::path::PathBuf), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store;
+    let access = crate::mod_runtime::os_access(caller).ok_or("capability_denied: os")?;
+    let argv = crate::mod_pty::argv(arguments)?;
+    let program = codex_omd::host::unrestricted_program(&access, &argv[0], &paths.repository)?;
+    let hash = codex_omd::host::program_hash(&program)?;
+    Ok((program, hash, store))
+}
