+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?;
+    let size = Size::new(80, 30);
+    app.chat_widget
+        .empty_state_animation
+        .borrow_mut()
+        .start_fresh();
+    draw(&mut app, &mut tui, size)?;
+    let mut snapshot = codex_omd::ModViewSnapshot {
+        input: serde_json::json!({"presentation":{"thread_id":app.chat_widget.thread_id().map(|id| id.to_string()),"phase":"fresh"}}),
+        view: codex_omd::ModView::parse(serde_json::json!({
+            "greeting":"", "session_title_suffix":" | Project tools", "welcome":{"show_while_composing":true},
+            "sites":{"welcome":{"components":[{"type":"text","id":"mark","label":"Approved mark","text":"╭─╮ ╭╮╭╮ ┌─╮\n│ │ │╰╯│ │ │\n╰─╯ ╵  ╵ └─╯"}]}}
+        }))?,
+        ..Default::default()
+    };
+    crate::mod_ui::preview(snapshot.clone());
+    app.queue_clear_ui_header(&mut tui);
+    for draft in ["", "typing", "edited prompt", ""] {
+        app.chat_widget.apply_external_edit(draft.to_owned());
+        draw(&mut app, &mut tui, size)?;
+        let frame = text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal,
+        ));
+        assert!(frame.contains("╭─╮ ╭╮╭╮ ┌─╮"), "{frame}");
+        assert!(frame.contains("Project tools"), "{frame}");
+    }
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Char('/'), KeyModifiers::NONE));
+    draw(&mut app, &mut tui, size)?;
+    let popup = text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(popup.contains("╭─╮ ╭╮╭╮ ┌─╮"), "{popup}");
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Backspace, KeyModifiers::NONE));
+    assert!(
+        !app.chat_widget
+            .empty_state_animation
+            .borrow_mut()
+            .handle_mouse(crossterm::event::MouseEvent {
+                kind: crossterm::event::MouseEventKind::Down(crossterm::event::MouseButton::Left),
+                column: 40,
+                row: 15,
+                modifiers: KeyModifiers::NONE,
+            },)
+    );
+    app.chat_widget.handle_paste("pasted prompt".to_owned());
+    draw(&mut app, &mut tui, size)?;
+    assert!(
+        text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal
+        ))
+        .contains("╭─╮ ╭╮╭╮ ┌─╮")
+    );
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::PlainHistoryCell::new(vec![
+            "Submission rejected".into(),
+        ])),
+    );
+    draw(&mut app, &mut tui, size)?;
+    let rejected = text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(
+        rejected.contains("Submission rejected") && !rejected.contains("╭─╮ ╭╮╭╮ ┌─╮"),
+        "{rejected}"
+    );
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnStarted(TurnStartedNotification {
+            thread_id: app
+                .chat_widget
+                .thread_id()
+                .map(|id| id.to_string())
+                .unwrap_or_default(),
+            turn: Turn {
+                root_turn_id: None,
+                id: "accepted-turn".to_owned(),
+                items_view: TurnItemsView::Full,
+                items: Vec::new(),
+                status: TurnStatus::InProgress,
+                error: None,
+                started_at: Some(0),
+                completed_at: None,
+                duration_ms: None,
+            },
+        }),
+        None,
+    );
+    draw(&mut app, &mut tui, size)?;
+    assert!(
+        !text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal
+        ))
+        .contains("╭─╮ ╭╮╭╮ ┌─╮")
+    );
+    for phase in ["started", "resumed"] {
+        snapshot.input["presentation"]["phase"] = serde_json::json!(phase);
+        crate::mod_ui::preview(snapshot.clone());
+        app.reset_transcript_state_after_clear();
+        draw(&mut app, &mut tui, size)?;
+        assert!(
+            !text(crate::custom_terminal::test_support::last_rendered_buffer(
+                &tui.terminal
+            ))
+            .contains("╭─╮ ╭╮╭╮ ┌─╮")
+        );
+    }
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    app.queue_clear_ui_header(&mut tui);
+    draw(&mut app, &mut tui, size)?;
+    assert!(
+        !text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal
+        ))
+        .contains("Project tools")
+    );
+    tui.set_owned_screen(false)?;
+    Ok(())
+}
