+        && glyphs.iter().all(|(source, display)| {
+            (2..=4).contains(&source.len())
+                && source.bytes().all(|byte| byte.is_ascii_graphic())
+                && display.chars().count() == source.chars().count()
+                && !display.chars().any(char::is_control)
+        })
