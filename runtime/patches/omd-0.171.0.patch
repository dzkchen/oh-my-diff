+            });
+            serde_json::json!({"call_id": first.call_id, "kind": "explore", "status": status,
+                "duration_ms": duration, "calls": calls.iter().map(|item| call(item)).collect::<Vec<_>>()})
+        } else {
+            call(first)
+        };
+        // Members render under their call IDs, so the group needs its own.
+        let id = if exploring {
