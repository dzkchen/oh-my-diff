+use codex_omd::ModOpenOptions;
+use codex_omd::{ModHost, ModStore};
+use std::path::Path;
+
+const HOST_FEATURES: &[&str] = &[
+    "app_v1",
+    "approval_v1",
+    "unrestricted_process_v1",
+    "delegated_approval_v1",
+    "tool_batch_v1",
+    "tool_continuation_v2",
