+    /// Ends the live tool cell: an active run keeps it, anything else goes to history.
+    pub(super) fn retire_live_cell(&mut self) {
+        if self.transcript.run().is_some() {
+            self.bump_active_cell_revision();
+        } else {
+            self.flush_active_cell();
+        }
+    }
+
+    /// Starts a live tool cell, inside a run while a mod groups tool calls.
+    pub(super) fn set_live_cell(&mut self, cell: Box<dyn HistoryCell>) {
+        let member = history_cell::is_tool_member(cell.as_ref());
+        if let Some(run) = self.transcript.run_mut()
+            && member
+        {
+            run.push(Arc::from(cell));
+            return;
+        }
+        if self.transcript.run().is_some() {
+            self.flush_active_cell();
+        }
+        if crate::omd::builtins().group_tools && member {
+            self.transcript.active_cell =
+                Some(Box::new(history_cell::ToolRunCell::new(Arc::from(cell))));
+        } else {
+            self.transcript.active_cell = Some(cell);
+        }
+    }
+
+    /// Adds a finished tool cell to the active run.
+    pub(super) fn push_to_run(
+        &mut self,
+        cell: Box<dyn HistoryCell>,
+    ) -> Result<(), Box<dyn HistoryCell>> {
+        match self.transcript.run_mut() {
+            Some(run) if history_cell::is_tool_member(cell.as_ref()) => {
+                run.push(Arc::from(cell));
+                self.bump_active_cell_revision();
+                Ok(())
+            }
+            _ => Err(cell),
+        }
+    }
+
+    /// Adds a finished tool cell to the active run, starting one once earlier activity is in history.
+    pub(super) fn join_tool_run(
+        &mut self,
+        cell: Box<dyn HistoryCell>,
+    ) -> Result<(), Box<dyn HistoryCell>> {
+        if !crate::omd::builtins().group_tools || !history_cell::is_tool_member(cell.as_ref()) {
+            return Err(cell);
+        }
+        let cell = match self.push_to_run(cell) {
+            Ok(()) => return Ok(()),
+            Err(cell) => cell,
+        };
+        if let Some(active) = self.take_history_insertion_prefix(cell.as_ref()) {
+            self.app_event_tx.send(AppEvent::InsertHistoryCell(active));
+            self.request_pending_usage_output_insertion();
+        }
+        if self.transcript.active_cell.is_some() {
+            return Err(cell);
+        }
+        self.set_live_cell(cell);
+        self.bump_active_cell_revision();
+        Ok(())
+    }
