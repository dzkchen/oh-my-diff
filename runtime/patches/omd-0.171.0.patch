+pub(crate) fn write_bound_configuration(
+    binding: ConfigurationBinding,
+    id: &str,
+    scope: &str,
+    values: Value,
+    reset: Vec<String>,
+    target: &str,
+) -> Result<Value, String> {
+    write_bound_configuration_in(binding, id, Some(scope), values, reset, target)
+}
+
+pub(crate) fn write_bound_configuration_in(
+    binding: ConfigurationBinding,
+    id: &str,
+    scope: Option<&str>,
+    values: Value,
+    reset: Vec<String>,
+    target: &str,
+) -> Result<Value, String> {
+    if remote_frontend_active() {
+        let result = remote_configuration_at(serde_json::json!({"action":"write","id":id,"scope":scope,"values":values,"reset":reset,"target":target}), binding.0).ok_or("terminal_configuration_unavailable")?.map_err(|error| error.to_string())?;
+        if !configuration_binding_current(binding) {
+            return Err("terminal_context_changed".into());
+        }
+        let _ = load_remote_packages();
+        return Ok(result);
+    }
+    let runtime = {
+        let _binding = FRONTEND_APPLY.locked();
+        if !configuration_binding_current(binding) {
+            return Err("terminal_context_changed".into());
+        }
+        shared_host()?
+    };
+    runtime
+        .locked()
+        .write_configuration_in(id, &values, target, &reset, scope)
+        .map_err(|error| error.to_string())
+}
+
+pub(crate) fn apply_bound_configuration(
+    binding: ConfigurationBinding,
+    arguments: Value,
+) -> Result<Value, String> {
+    if remote_frontend_active() {
+        let result = remote_configuration_at(
+            serde_json::json!({"action":"package","request":arguments}),
+            binding.0,
+        )
+        .ok_or("terminal_configuration_unavailable")?
+        .map_err(|error| error.to_string())?;
+        if !configuration_binding_current(binding) {
+            return Err("terminal_context_changed".into());
+        }
+        let _ = load_remote_packages();
+        return Ok(result);
+    }
+    let runtime = {
+        let _binding = FRONTEND_APPLY.locked();
+        if !configuration_binding_current(binding) {
+            return Err("terminal_context_changed".into());
+        }
+        shared_host()?
+    };
+    let mut runtime = runtime.locked();
+    let preview = runtime
+        .preview_configuration(arguments)
+        .map_err(|error| error.to_string())?;
+    runtime
+        .apply_configuration(&preview.control)
+        .map_err(|error| error.to_string())
+}
