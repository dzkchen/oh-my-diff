+fn underlay_resize_keeps_the_frame_and_fills_new_edges() {
+    let now = Instant::now();
+    let key = "underlay-resize";
+    let mut snapshot = codex_omd::ModViewSnapshot {
+        input: json!({"ledger": {"cwd": "/repo", "thread_id": "resize"}}),
+        ..Default::default()
+    };
+    snapshot.view.underlay = serde_json::from_value(json!({"raster": key})).unwrap();
+    snapshot.component_owners.insert(key.into(), "owner".into());
+    let level = Some(StdoutColorLevel::TrueColor);
+    let paint = |screen: Rect, now| {
+        let mut buffer = Buffer::empty(screen);
+        underlay_glyphs(&snapshot, screen, screen, &[], &mut buffer, level, now);
+        underlay_tint(&snapshot, screen, &[], &mut buffer, level);
+        buffer
+    };
+    let send = |width, height, rect: Value, cells: &[(char, u32, u32)], now| {
+        blit(
+            "owner",
+            Some("owner".into()),
+            Some((width, height)),
+            &json!({"key": key, "rect": rect, "packed": packed(cells)}),
+            now,
+            |_, _| unreachable!(),
+        )
+        .unwrap()
+    };
+    let screen = Rect::new(0, 0, 64, 2);
+    paint(screen, now);
