diff --git a/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs b/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3c4c82481c10f29cd9a586e617143363ac4c673f
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs
@@ -0,0 +1,274 @@
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use unicode_width::UnicodeWidthChar;
+use unicode_width::UnicodeWidthStr;
+
+use super::CancellationEvent;
+use super::bottom_pane_view::BottomPaneView;
+use super::bottom_pane_view::ViewCompletion;
+use crate::mod_ui::glyph;
+use crate::render::renderable::Renderable;
+use crate::wrapping::word_wrap_lines;
+
+const SECRET_CHARS: usize = 512;
+
+pub(crate) type SecretSubmitted = Box<dyn FnOnce(Option<String>) + Send + Sync>;
+
+pub(crate) struct SecretPromptView {
+    title: String,
+    note: String,
+    value: String,
+    masked: bool,
+    completion: Option<ViewCompletion>,
+    on_done: Option<SecretSubmitted>,
+}
+
+impl SecretPromptView {
+    pub(crate) fn new(title: String, note: String, on_done: SecretSubmitted) -> Self {
+        Self {
+            title,
+            note,
+            value: String::new(),
+            masked: true,
+            completion: None,
+            on_done: Some(on_done),
+        }
+    }
+
+    pub(crate) fn plain(mut self) -> Self {
+        self.masked = false;
+        self
+    }
+
+    fn finish(&mut self, value: Option<String>) {
+        self.completion = Some(if value.is_some() {
+            ViewCompletion::Accepted
+        } else {
+            ViewCompletion::Cancelled
+        });
+        if let Some(on_done) = self.on_done.take() {
+            on_done(value);
+        }
+    }
+
+    fn header(&self, width: u16) -> Vec<Line<'static>> {
+        let width = usize::from(width.max(1));
+        let title = self
+            .title
+            .split('\n')
+            .map(|line| Line::from(line.to_owned()).bold());
+        let note = self
+            .note
+            .split('\n')
+            .map(|line| Line::from(line.to_owned()).dim());
+        word_wrap_lines(title.chain(note), width)
+    }
+
+    fn push(&mut self, text: &str) {
+        if !self.masked {
+            self.value.push_str(text);
+            return;
+        }
+        for character in text.chars().filter(|c| !c.is_control()) {
+            if self.value.chars().count() >= SECRET_CHARS {
+                break;
+            }
+            self.value.push(character);
+        }
+    }
+}
+
+impl Drop for SecretPromptView {
+    fn drop(&mut self) {
+        if let Some(on_done) = self.on_done.take() {
+            on_done(None);
+        }
+    }
+}
+
+impl BottomPaneView for SecretPromptView {
+    fn handle_key_event(&mut self, key_event: KeyEvent) {
+        if key_event.kind == KeyEventKind::Release {
+            return;
+        }
+        match (key_event.code, key_event.modifiers) {
+            (KeyCode::Enter, KeyModifiers::SHIFT) if !self.masked => self.push("\n"),
+            (KeyCode::Tab, KeyModifiers::NONE) if !self.masked => self.push("\t"),
+            (KeyCode::Enter, _) => {
+                let value = std::mem::take(&mut self.value);
+                if self.masked {
+                    let value = value.trim().to_owned();
+                    self.finish((!value.is_empty()).then_some(value));
+                } else {
+                    self.finish(Some(value));
+                }
+            }
+            (KeyCode::Esc, _) => self.finish(None),
+            (KeyCode::Backspace, _) => {
+                self.value.pop();
+            }
+            (KeyCode::Char(character), KeyModifiers::NONE | KeyModifiers::SHIFT) => {
+                self.push(&character.to_string());
+            }
+            _ => {}
+        }
+    }
+
+    fn is_complete(&self) -> bool {
+        self.completion.is_some()
+    }
+
+    fn completion(&self) -> Option<ViewCompletion> {
+        self.completion
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.finish(None);
+        CancellationEvent::Handled
+    }
+
+    fn prefer_esc_to_handle_key_event(&self) -> bool {
+        true
+    }
+
+    fn handle_paste(&mut self, pasted: String) -> bool {
+        if self.masked {
+            self.push(pasted.trim());
+        } else {
+            self.push(&pasted);
+        }
+        true
+    }
+}
+
+impl Renderable for SecretPromptView {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let value = if self.masked {
+            glyph("•", "*").repeat(self.value.chars().count().min(64))
+        } else {
+            self.value.chars().flat_map(char::escape_debug).collect()
+        };
+        let prompt = glyph("› ", "> ");
+        // The input keeps its end, where typing happens, in view.
+        let mut room = usize::from(area.width).saturating_sub(prompt.width());
+        let start = value
+            .char_indices()
+            .rev()
+            .take_while(|(_, character)| {
+                let width = character.width().unwrap_or(0);
+                let fits = width <= room;
+                room = room.saturating_sub(width);
+                fits
+            })
+            .last()
+            .map_or(value.len(), |(start, _)| start);
+        let mut lines = self.header(area.width);
+        lines.truncate(usize::from(area.height.saturating_sub(2)));
+        lines.push(Line::from(format!("{prompt}{}", &value[start..])));
+        let hint = if self.masked {
+            format!("enter to save {} esc to cancel", glyph("·", "-"))
+        } else {
+            format!(
+                "enter to save {} shift+enter newline {} esc to cancel",
+                glyph("·", "-"),
+                glyph("·", "-")
+            )
+        };
+        lines.push(Line::from(hint).dim());
+        Paragraph::new(lines).render(area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        u16::try_from(self.header(width).len())
+            .unwrap_or(u16::MAX)
+            .saturating_add(2)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+
+    #[test]
+    fn plain_text_preserves_empty_whitespace_and_long_pasted_values() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        for value in [String::new(), "  text \n\t ".into(), "x".repeat(1024)] {
+            let result = seen.clone();
+            let mut view = SecretPromptView::new(
+                "Setting".into(),
+                String::new(),
+                Box::new(move |value| result.lock().unwrap().push(value)),
+            )
+            .plain();
+            view.handle_paste(value.clone());
+            view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+            assert_eq!(seen.lock().unwrap().last(), Some(&Some(value)));
+        }
+    }
+
+    #[test]
+    fn secrets_are_masked_trimmed_and_cancel_reports_none() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let record = |seen: &Arc<Mutex<Vec<Option<String>>>>| {
+            let seen = seen.clone();
+            Box::new(move |value| seen.lock().unwrap().push(value)) as SecretSubmitted
+        };
+        let mut view = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        view.handle_paste(" sk-test ".into());
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 40, 4));
+        view.render(Rect::new(0, 0, 40, 4), &mut buffer);
+        let screen = (0..40)
+            .map(|x| buffer[(x, 2)].symbol().to_owned())
+            .collect::<String>();
+        assert!(!screen.contains("sk-test"));
+        view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        assert!(view.is_complete());
+        let mut cancelled = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        cancelled.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        drop(SecretPromptView::new(
+            "Key".into(),
+            "note".into(),
+            record(&seen),
+        ));
+        assert_eq!(
+            *seen.lock().unwrap(),
+            vec![Some("sk-test".to_owned()), None, None]
+        );
+    }
+
+    #[test]
+    fn long_messages_wrap_and_the_input_keeps_its_end_in_view() {
+        let words = (0..50).map(|n| format!("word{n:02}")).collect::<Vec<_>>();
+        let message = [&words[..17], &words[17..34], &words[34..]]
+            .map(|line| line.join(" "))
+            .join("\n");
+        let mut view = SecretPromptView::new("Title".into(), message, Box::new(|_| {})).plain();
+        view.handle_paste(format!("{}tail", "x".repeat(60)));
+        let height = view.desired_height(40);
+        let area = Rect::new(0, 0, 40, height);
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer);
+        let rows = (0..height)
+            .map(|y| (0..40).map(|x| buffer[(x, y)].symbol()).collect::<String>())
+            .collect::<Vec<_>>();
+        let screen = rows.join("\n");
+        assert!(
+            words.iter().all(|word| screen.contains(word.as_str())),
+            "{screen}"
+        );
+        assert!(
+            rows[usize::from(height) - 2].trim_end().ends_with("xtail"),
+            "{screen}"
+        );
+    }
+}
diff --git a/codex-rs/tui/src/chatwidget/mod_commands.rs b/codex-rs/tui/src/chatwidget/mod_commands.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b1fd1ca56b82b02f6adf7a1e357fd538279799d3
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/mod_commands.rs
@@ -0,0 +1,724 @@
+use super::slash_dispatch::InterceptedCommand;
+use super::slash_dispatch::PreparedSlashCommandArgs;
+use super::slash_dispatch::SlashCommandDispatchSource;
+use super::*;
+use crate::mod_runtime::ModCommandResult;
+use crate::mod_runtime::ModSlashCommand;
+use ratatui::text::Line;
+
+impl ChatWidget {
+    pub(crate) fn mod_context(&self) -> crate::mod_runtime::ModContext {
+        let policy = self
+            .config
+            .permissions
+            .effective_permission_profile()
+            .materialize_project_roots_with_workspace_roots(std::slice::from_ref(&self.config.cwd))
+            .file_system_sandbox_policy();
+        crate::mod_runtime::ModContext {
+            thread_id: self.thread_id,
+            repository: self.config.cwd.to_path_buf(),
+            policy,
+        }
+    }
+
+    pub(crate) fn mod_command_rows(&self) -> Vec<serde_json::Value> {
+        crate::bottom_pane::slash_commands::composed_commands(
+            self.builtin_command_flags(),
+            &self.current_model_service_tier_commands(),
+        )
+        .1
+    }
+
+    pub(crate) fn run_mod_command(&mut self, command: ModSlashCommand, args: String) {
+        self.start_mod_command(command, args, false);
+    }
+
+    /// Runs a command a mod's own UI triggered, keeping it and its display text out of the transcript.
+    pub(crate) fn run_mod_command_quietly(&mut self, command: ModSlashCommand, args: String) {
+        self.start_mod_command(command, args, true);
+    }
+
+    fn mod_token(&self) -> crate::mod_runtime::ModInvocation {
+        self.mod_invocation(crate::mod_runtime::begin)
+    }
+
+    fn mod_invocation(
+        &self,
+        start: fn(crate::mod_runtime::ModContext) -> crate::mod_runtime::ModInvocation,
+    ) -> crate::mod_runtime::ModInvocation {
+        let context = self.mod_context();
+        if crate::mod_runtime::synchronize_context(context.clone()) {
+            crate::mod_ui::invalidate_context();
+        }
+        start(context)
+    }
+
+    fn start_mod_command(&mut self, command: ModSlashCommand, args: String, quiet: bool) {
+        if self.thread_id.is_none() {
+            self.held_mod_commands.push((command, args, quiet));
+            return;
+        }
+        crate::mod_ui::reopen_dialogs();
+        let token = self.mod_token();
+        self.spawn_mod_commands(vec![(command, args)], token, quiet, true);
+    }
+
+    pub(crate) fn run_held_mod_commands(&mut self) {
+        for (command, args, quiet) in std::mem::take(&mut self.held_mod_commands) {
+            self.start_mod_command(command, args, quiet);
+        }
+    }
+
+    pub(crate) fn refresh_mod_panels(&mut self) {
+        let commands = self
+            .bottom_pane
+            .mod_panel_actions()
+            .into_iter()
+            .filter_map(|(command, args)| {
+                crate::mod_runtime::find(&command).map(|command| (command, args))
+            })
+            .collect::<Vec<_>>();
+        if !commands.is_empty() {
+            let token = self.mod_invocation(crate::mod_runtime::join);
+            self.spawn_mod_commands(commands, token, true, false);
+        }
+    }
+
+    fn spawn_mod_commands(
+        &mut self,
+        commands: Vec<(ModSlashCommand, String)>,
+        token: crate::mod_runtime::ModInvocation,
+        quiet: bool,
+        refresh_panels: bool,
+    ) {
+        let tx = self.app_event_tx.clone();
+        let running = self.turn_lifecycle.agent_turn_running;
+        let work = move || {
+            let batch = crate::mod_runtime::RunningCommand::enter();
+            for (command, args) in commands {
+                let result = crate::mod_runtime::run_command(
+                    &command.invocation,
+                    &args,
+                    Some(&command.target),
+                    command.immediate,
+                    running,
+                    "user",
+                    &token,
+                    |_| Err("builtin_unavailable".to_owned()),
+                );
+                tx.send(AppEvent::ModCommandFinished {
+                    invocation: command.invocation,
+                    token: token.clone(),
+                    result,
+                    quiet,
+                });
+            }
+            drop(batch);
+            if crate::mod_runtime::reloaded() && refresh_panels {
+                tx.send(AppEvent::ModPanelsReloaded);
+            }
+        };
+        #[cfg(test)]
+        let work = crate::mod_runtime::inherit_test_context(work);
+        std::thread::spawn(work);
+    }
+
+    pub(crate) fn on_mod_command_finished(
+        &mut self,
+        invocation: String,
+        result: Result<ModCommandResult, String>,
+        quiet: bool,
+    ) -> Option<crate::mod_runtime::ModInvocation> {
+        let ModCommandResult {
+            outcome,
+            preview,
+            refresh,
+            ..
+        } = match result {
+            Ok(result) => result,
+            Err(error) => {
+                self.add_error_message(command_failure(&invocation, &error));
+                return None;
+            }
+        };
+        if let Some(display) = outcome.display.filter(|_| !quiet) {
+            let mut lines = vec![Line::from(format!("• /{invocation}")).bold()];
+            lines.extend(display.lines().map(|line| Line::from(format!("  {line}"))));
+            self.add_plain_history_lines(lines);
+        }
+        if let Some(insert) = outcome.insert {
+            if !self.bottom_pane.composer_is_empty() {
+                self.insert_str("\n");
+            }
+            self.insert_str(&insert);
+        }
+        if let Some(submit) = outcome.submit {
+            self.submit_mod_text(submit);
+        }
+        if let Some(preview) = preview {
+            crate::mod_ui::preview(preview);
+            self.refresh_status_line();
+        }
+        self.request_redraw();
+        refresh
+    }
+
+    pub(crate) fn show_mod_secret_prompt(&mut self, view: crate::bottom_pane::SecretPromptView) {
+        self.bottom_pane.show_view(Box::new(view));
+        self.request_redraw();
+    }
+
+    pub(crate) fn show_mod_panel(
+        &mut self,
+        caller: String,
+        request: crate::bottom_pane::ModPanelRequest,
+    ) {
+        self.bottom_pane.show_mod_panel(caller, request);
+        self.request_redraw();
+    }
+
+    pub(crate) fn show_mod_panel_prompt(
+        &mut self,
+        title: String,
+        value: String,
+        command: String,
+        args: String,
+    ) {
+        let tx = self.app_event_tx.clone();
+        let view = crate::bottom_pane::custom_prompt_view::CustomPromptView::new(
+            title,
+            String::new(),
+            value,
+            None,
+            Box::new(move |text| {
+                tx.send(AppEvent::ModPanelCommand {
+                    command: command.clone(),
+                    args: format!("{args} {text}"),
+                });
+            }),
+        );
+        self.bottom_pane.show_text_prompt(view);
+        self.request_redraw();
+    }
+
+    pub(crate) fn mod_view_state(&self) -> (usize, Option<&'static str>) {
+        self.bottom_pane.view_stack_state()
+    }
+
+    /// The draft at its current revision; `path` is replaced by a resource before it reaches a mod.
+    pub(crate) fn mod_composer_read(&mut self) -> serde_json::Value {
+        let composer = self.bottom_pane.composer_mut();
+        let revision = composer.mod_draft_sync();
+        let attachments = composer
+            .local_images()
+            .iter()
+            .map(|image| {
+                let owner = composer
+                    .mod_draft_owner(&image.path)
+                    .map(|(owner, _)| owner);
+                serde_json::json!({"kind": "image", "label": image.placeholder,
+                    "owner": owner.as_deref().unwrap_or("user"), "path": image.path})
+            })
+            .collect::<Vec<_>>();
+        let selection = composer
+            .mod_selection()
+            .map(|range| serde_json::json!({"start": range.start, "end": range.end}));
+        let suggestion = composer
+            .mod_suggestion_owner()
+            .map(|(owner, id)| serde_json::json!({"owner": owner, "id": id}));
+        serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor(), "selection": selection,
+            "revision": revision, "attachments": attachments, "suggestion": suggestion})
+    }
+
+    pub(crate) fn mod_composer_write(
+        &mut self,
+        caller: &str,
+        source: &str,
+        arguments: &serde_json::Value,
+        attachments: Vec<std::path::PathBuf>,
+    ) -> Result<serde_json::Value, String> {
+        let object = arguments
+            .as_object()
+            .filter(|object| {
+                object.keys().all(|key| {
+                    matches!(
+                        key.as_str(),
+                        "revision" | "edit" | "cursor" | "selection" | "detach"
+                    )
+                })
+            })
+            .ok_or("composer_write_arguments_invalid")?;
+        let revision = object
+            .get("revision")
+            .and_then(serde_json::Value::as_u64)
+            .ok_or("composer_revision_required")?;
+        let composer = self.bottom_pane.composer_mut();
+        if revision != composer.mod_draft_sync() {
+            return Err("stale_revision".into());
+        }
+        let index = |value: &serde_json::Value| value.as_u64().map(|at| at as usize);
+        let selection = match object.get("selection") {
+            None | Some(serde_json::Value::Null) => None,
+            Some(range) => Some(
+                index(&range["start"])
+                    .zip(index(&range["end"]))
+                    .map(|(start, end)| start..end)
+                    .ok_or("composer_selection_invalid")?,
+            ),
+        };
+        let cursor = object
+            .get("cursor")
+            .map(|at| index(at).ok_or("composer_cursor_invalid"))
+            .transpose()?;
+        let edit = if let Some(edit) = object.get("edit") {
+            if edit["text"].as_str().is_none_or(|text| text.len() > 65_536) {
+                return Err("composer_edit_invalid".into());
+            }
+            crate::mod_runtime::composer_edit("mod", caller, revision, edit.clone())?
+        } else {
+            serde_json::json!({"kind": "insert", "text": ""})
+        };
+        let detach = match object.get("detach") {
+            None => Vec::new(),
+            Some(value) => value
+                .as_array()
+                .ok_or("composer_detach_invalid")?
+                .iter()
+                .map(|value| value.as_str().ok_or("composer_detach_invalid"))
+                .collect::<Result<Vec<_>, _>>()?,
+        };
+        let current = self
+            .bottom_pane
+            .composer_mut()
+            .mod_edit_detach(caller, revision, &edit, cursor, selection, &detach)?;
+        for path in attachments {
+            self.bottom_pane
+                .composer_mut()
+                .mod_draft_owned(path.clone(), caller, source);
+            self.attach_image(path, ClipboardPasteContext::Composer);
+        }
+        let composer = self.bottom_pane.composer_mut();
+        composer.mod_draft_origin(caller);
+        let revision = composer.mod_draft_sync().max(current);
+        self.request_redraw();
+        Ok(serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor(), "revision": revision}))
+    }
+
+    pub(crate) fn mod_composer_suggest(
+        &mut self,
+        caller: &str,
+        source: &str,
+        arguments: &serde_json::Value,
+    ) -> Result<serde_json::Value, String> {
+        let composer = self.bottom_pane.composer_mut();
+        if arguments.get("clear") == Some(&serde_json::Value::Bool(true)) {
+            if composer
+                .mod_suggestion_owner()
+                .is_some_and(|(owner, _)| owner == caller)
+            {
+                composer.mod_suggestion_clear("owner");
+            }
+            self.request_redraw();
+            return Ok(serde_json::json!({"cleared": true}));
+        }
+        let (Some(revision), Some(id), Some(text)) = (
+            arguments["revision"].as_u64(),
+            arguments["id"].as_str(),
+            arguments["text"].as_str(),
+        ) else {
+            return Err("composer_suggest_arguments_invalid".into());
+        };
+        if id.is_empty() || id.len() > 128 || text.is_empty() || text.len() > 4096 {
+            return Err("composer_suggest_arguments_invalid".into());
+        }
+        if self.bottom_pane.has_active_view() {
+            return Err("composer_unavailable: a dialog is open".into());
+        }
+        self.bottom_pane.composer_mut().mod_suggest(
+            caller,
+            source,
+            revision,
+            id.to_owned(),
+            text.to_owned(),
+        )?;
+        self.request_redraw();
+        Ok(serde_json::json!({"shown": true}))
+    }
+
+    pub(crate) fn mod_draft_tick(&mut self) {
+        if !crate::omd::terminal_active() {
+            return;
+        }
+        if self.bottom_pane.has_active_view() {
+            self.bottom_pane
+                .composer_mut()
+                .mod_suggestion_clear("dialog");
+        }
+        let composer = self.bottom_pane.composer_mut();
+        composer.mod_draft_sync();
+        if composer.mod_draft_holds_mods() {
+            let status = crate::omd::mod_status();
+            composer.mod_draft_revoke(|owner, source| {
+                status.as_ref().is_some_and(|status| {
+                    status["mods"].as_array().into_iter().flatten().any(|item| {
+                        item["id"] == owner && (source.is_empty() || item["sha256"] == source)
+                    })
+                })
+            });
+        }
+        let mut due = Vec::new();
+        for (owner, payload) in self.bottom_pane.composer_mut().mod_draft_take_events() {
+            match owner {
+                Some(owner) => due.push((Some(owner), payload)),
+                None => self.mod_draft_change = Some((payload, std::time::Instant::now())),
+            }
+        }
+        if let Some((payload, at)) = self.mod_draft_change.take() {
+            let delay = std::time::Duration::from_millis(250);
+            if at.elapsed() >= delay {
+                due.push((None, payload));
+            } else {
+                self.frame_requester
+                    .schedule_frame_in(delay.saturating_sub(at.elapsed()));
+                self.mod_draft_change = Some((payload, at));
+            }
+        }
+        // Handlers may call terminal operations, which this thread serves, so deliver elsewhere.
+        if !due.is_empty() {
+            std::thread::spawn(move || {
+                for (owner, payload) in due {
+                    match owner {
+                        Some(owner) => {
+                            let _ = crate::mod_runtime::invoke_event(&owner, "composer", payload);
+                        }
+                        None => crate::mod_runtime::broadcast_event("composer", payload),
+                    }
+                }
+            });
+        }
+    }
+
+    pub(super) fn command_intercepted(command: crate::slash_command::SlashCommand) -> bool {
+        !codex_omd::PROTECTED_COMMANDS.contains(&command.command())
+            && crate::mod_runtime::intercepts("command")
+    }
+
+    pub(crate) fn intercept_builtin(
+        &mut self,
+        command: crate::slash_command::SlashCommand,
+        args: String,
+        text_elements: Vec<TextElement>,
+    ) -> bool {
+        if !Self::command_intercepted(command) {
+            return false;
+        }
+        let prepared = if command.supports_inline_args()
+            && !args.trim().is_empty()
+            && command != crate::slash_command::SlashCommand::Goal
+        {
+            self.prepare_live_inline_args(args, text_elements)
+        } else {
+            Some((args, text_elements))
+        };
+        if let Some((args, text_elements)) = prepared {
+            self.intercept_command(
+                command,
+                PreparedSlashCommandArgs::new(
+                    args,
+                    text_elements,
+                    SlashCommandDispatchSource::Live,
+                ),
+            );
+        }
+        self.bottom_pane.record_pending_slash_command_history();
+        true
+    }
+
+    /// Dispatches what the `command` interceptor chain lets through, never superseding the running command.
+    pub(super) fn intercept_command(
+        &mut self,
+        command: crate::slash_command::SlashCommand,
+        prepared: PreparedSlashCommandArgs,
+    ) {
+        let tx = self.app_event_tx.clone();
+        let token = self.mod_invocation(crate::mod_runtime::join);
+        let running = self.turn_lifecycle.agent_turn_running;
+        std::thread::spawn(move || {
+            let dispatch = tx.clone();
+            let result = crate::mod_runtime::run_command(
+                command.command(),
+                &prepared.args,
+                None,
+                command.available_during_task(),
+                running,
+                "user",
+                &token,
+                |effective| {
+                    let mut prepared = prepared.clone();
+                    if effective != prepared.args {
+                        prepared.args = effective;
+                        prepared.text_elements = Vec::new();
+                    }
+                    dispatch.send(AppEvent::OmdDispatchCommand(Box::new(InterceptedCommand {
+                        command,
+                        prepared,
+                        token: token.clone(),
+                        surface: None,
+                    })));
+                    Ok(serde_json::json!({"invoked": true}))
+                },
+            );
+            if let Err(error) = result {
+                tx.send(AppEvent::ModCommandFinished {
+                    invocation: command.command().to_owned(),
+                    token,
+                    result: Err(error),
+                    quiet: false,
+                });
+            }
+        });
+    }
+
+    pub(crate) fn mod_invoke_command(&mut self, call: codex_omd::client_surface::SurfaceCall) {
+        use crate::slash_command::SlashCommand;
+        use std::sync::atomic::Ordering;
+        let name = call.arguments["command"]
+            .as_str()
+            .unwrap_or_default()
+            .trim_start_matches('/')
+            .to_owned();
+        let args = call.arguments["args"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        let rows = self.mod_command_rows();
+        let Some(row) = rows.iter().find(|row| row["command"] == name.as_str()) else {
+            let _ = call.reply.send(Err(format!("command_unknown: {name}")));
+            return;
+        };
+        let target = crate::mod_runtime::find(&name);
+        let builtin = <SlashCommand as std::str::FromStr>::from_str(&name).ok();
+        if builtin.is_some_and(|command| {
+            matches!(
+                command,
+                SlashCommand::Permissions
+                    | SlashCommand::ElevateSandbox
+                    | SlashCommand::Logout
+                    | SlashCommand::Quit
+                    | SlashCommand::Exit
+                    | SlashCommand::TestApproval
+                    | SlashCommand::Feedback
+            )
+        }) || target.is_none() && builtin.is_none()
+        {
+            let _ = call
+                .reply
+                .send(Err(format!("command_invoke_refused: {name}")));
+            return;
+        }
+        if call.depth >= 4 {
+            let _ = call.reply.send(Err(
+                "command_recursion_limit: at most 4 nested commands".into()
+            ));
+            return;
+        }
+        let immediate = row["immediate"] != false;
+        let running = self.turn_lifecycle.agent_turn_running;
+        let token = self.mod_invocation(crate::mod_runtime::join);
+        let tx = self.app_event_tx.clone();
+        std::thread::spawn(move || {
+            if let Err(error) = crate::mod_surface::validate_call(&call) {
+                let _ = call.reply.send(Err(error));
+                return;
+            }
+            let _nested = codex_omd::client_surface::nest(call.depth + 1);
+            let dispatch = tx.clone();
+            let queued = std::sync::atomic::AtomicBool::new(false);
+            let result = crate::mod_runtime::run_command(
+                &name,
+                &args,
+                target.as_ref().map(|command| &command.target),
+                immediate,
+                running,
+                &call.caller,
+                &token,
+                |args| match builtin.filter(|_| crate::mod_surface::validate_call(&call).is_ok()) {
+                    Some(command) => {
+                        queued.store(true, Ordering::Release);
+                        dispatch.send(AppEvent::OmdDispatchCommand(Box::new(InterceptedCommand {
+                            command,
+                            prepared: PreparedSlashCommandArgs::new(
+                                args,
+                                Vec::new(),
+                                SlashCommandDispatchSource::Queued,
+                            ),
+                            token: token.clone(),
+                            surface: Some(call.clone()),
+                        })));
+                        Ok(serde_json::json!({"invoked": true}))
+                    }
+                    None => Err(format!("command_invoke_refused: {name}")),
+                },
+            );
+            match result {
+                Ok(result) => {
+                    if target.is_some() || !queued.load(Ordering::Acquire) {
+                        let _ = call.reply.send(Ok(
+                            serde_json::json!({"command": name, "result": result.value}),
+                        ));
+                    }
+                    if target.is_some() {
+                        tx.send(AppEvent::ModCommandFinished {
+                            invocation: name,
+                            token,
+                            result: Ok(result),
+                            quiet: true,
+                        });
+                    }
+                }
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+        });
+    }
+
+    pub(crate) fn add_mod_activity(&mut self, activity: codex_omd::ModActivity) {
+        let line = match activity.status.as_str() {
+            "completed" => format!("• Ran {} ({})", activity.label, activity.tool),
+            status => format!("• {} {status} ({})", activity.label, activity.tool),
+        };
+        let row = format!("mod:{}:{}", activity.mod_id, activity.sequence);
+        let props = serde_json::json!({"call_id": row, "kind": "dynamic", "tool": activity.tool,
+            "arguments": null, "status": if activity.status == "completed" { "completed" } else { "failed" },
+            "duration_ms": null, "output_lines": null});
+        self.add_to_history(history_cell::ToolCallCell::new(
+            PlainHistoryCell::new(vec![Line::from(line).dim()]),
+            row,
+            props,
+        ));
+        self.request_redraw();
+    }
+
+    pub(crate) fn apply_mod_placeholder(&mut self, placeholder: Option<String>) {
+        self.normal_placeholder_text = placeholder.unwrap_or_else(|| {
+            if crate::omd::is_active() {
+                "Ask Oh My Diff to do anything".to_string()
+            } else {
+                super::PLACEHOLDER.to_string()
+            }
+        });
+        if !self.active_side_conversation && !self.blocks_direct_input {
+            self.bottom_pane
+                .set_placeholder_text(self.normal_placeholder_text.clone());
+        }
+    }
+
+    pub(crate) fn mod_prompt_blocked(&self, steer: bool) -> Option<&'static str> {
+        if !self.is_session_configured() {
+            return Some("session_starting");
+        }
+        if self.queued_input_held() {
+            return Some("input_held");
+        }
+        match steer {
+            false if self.is_user_turn_pending_or_running() => Some("busy"),
+            true if !self.turn_lifecycle.agent_turn_running => Some("no_active_turn"),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn mod_submit_prompt(
+        &mut self,
+        text: String,
+        images: Vec<std::path::PathBuf>,
+        client_id: String,
+        steer: bool,
+    ) -> Result<&'static str, String> {
+        if let Some(reason) = self.mod_prompt_blocked(steer) {
+            return Err(reason.into());
+        }
+        let mut user_message = UserMessage::from(text);
+        user_message.local_images = images
+            .into_iter()
+            .enumerate()
+            .map(|(index, path)| crate::bottom_pane::LocalImageAttachment {
+                placeholder: format!("[Image #{}]", index + 1),
+                path,
+            })
+            .collect();
+        self.mod_client_id = Some(client_id);
+        let (accepted, _) = self.submit_user_message_with_history_and_shell_escape_policy(
+            user_message,
+            UserMessageHistoryRecord::UserMessageText,
+            ShellEscapePolicy::Disallow,
+            UserMessageSource::Prompt,
+        );
+        self.mod_client_id = None;
+        match (accepted, steer) {
+            (false, _) => Err("refused".into()),
+            (true, true) => Ok("steered"),
+            (true, false) => Ok("started"),
+        }
+    }
+
+    pub(crate) fn submit_mod_text(&mut self, text: String) {
+        let user_message = UserMessage::from(text);
+        if self.is_session_configured() && !self.turn_lifecycle.agent_turn_running {
+            let _ = self.submit_user_message_with_shell_escape_policy(
+                user_message,
+                ShellEscapePolicy::Disallow,
+            );
+        } else {
+            self.queue_user_message(user_message);
+        }
+    }
+}
+
+fn command_failure(invocation: &str, error: &str) -> String {
+    let code = error
+        .lines()
+        .find(|line| !line.trim().is_empty())
+        .unwrap_or("")
+        .trim();
+    let sentence = match code.split(':').next().unwrap_or("").trim() {
+        "mod_failed" => "its mod stopped after an error; reload it with /omd (Reload mods)",
+        "mod_disabled" => "its mod is off; turn it on in /omd",
+        "callback_timeout" => "its mod took too long to answer; try again, or reload it with /omd",
+        "callback_cancelled" => "it was cancelled before it finished; try again",
+        "host_call_limit" => {
+            "its mod made too many host calls in one run; try again or report it to the mod's author"
+        }
+        "capability_denied" => {
+            "its mod needs a permission it doesn't have; approve it again with omd mods update ID"
+        }
+        "mod_runtime_busy" => "its mod is still busy with another call; try again in a moment",
+        "stale_mod_generation" => "mods were reloaded while it ran; try again",
+        "state_thread_unavailable" => {
+            "it needs a started session; send a message first, then try again"
+        }
+        _ => return format!("/{invocation} failed: {code}"),
+    };
+    format!("/{invocation} failed: {sentence} ({code})")
+}
+
+#[cfg(test)]
+mod failure_tests {
+    use super::command_failure;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn known_codes_read_as_a_sentence_and_keep_the_code() {
+        assert_eq!(
+            command_failure("x", "capability_denied: process\nstack"),
+            "/x failed: its mod needs a permission it doesn't have; approve it again with omd mods update ID (capability_denied: process)"
+        );
+        assert_eq!(
+            command_failure("x", "mod_runtime_busy"),
+            "/x failed: its mod is still busy with another call; try again in a moment (mod_runtime_busy)"
+        );
+        assert_eq!(command_failure("x", "\nboom\nmore"), "/x failed: boom");
+    }
+}
