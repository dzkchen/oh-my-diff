+    /// An invoked key never reaches a dialog, popup, overlay or focused mod component, where it could answer a prompt.
+    pub(super) fn builtin_action_key(
+        &self,
+        action: &str,
+    ) -> Result<crossterm::event::KeyEvent, String> {
+        if self.overlay.is_some()
+            || !self.chat_widget.no_modal_or_popup_active()
+            || crate::mod_ui::captures_keys()
+        {
+            return Err(format!("builtins_view_active: {action}"));
+        }
+        let keys = crate::omd::builtin_keys();
+        crate::keymap_overlay::overlay(&self.local_settings.tui.keymap, &keys)
+            .and_then(|(_, runtime)| crate::keymap_overlay::action_key(&runtime, action))
+    }
+
+    async fn run_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+        held: Option<Confirmed>,
+    ) {
+        if let Err(error) = crate::mod_surface::validate_call_classified(&call) {
+            call.reply_blit(Err(error));
+            return;
+        }
+        let (pty, pin) = match &held {
+            Some(Confirmed::Pty(binding, pin, _)) if crate::mod_pty::current(binding) => {
+                (Some(binding.clone()), pin.clone())
+            }
+            _ => (None, None),
+        };
+        if call.operation == "terminal.pty" && pty.is_none() {
+            let _ = call.reply.send(Err("pty_context_changed".into()));
+            return;
+        }
+        let approval = match &held {
+            Some(Confirmed::Pty(_, _, Some(approval))) => {
+                let current = store_paths().and_then(|(store, repository)| {
+                    PtyApproval::new(&store, &repository, &call.caller, &call.arguments)
+                });
+                if current.as_ref() != Ok(approval.as_ref()) {
+                    let _ = call.reply.send(Err("pty_approval_changed".into()));
+                    return;
+                }
+                Some(approval)
+            }
+            _ => None,
+        };
+        let result = match call.operation.as_str() {
+            "app.request" => {
+                spawn_app_request(
+                    call,
+                    app_server.request_handle(),
+                    app_server.next_request_id(),
+                );
+                return;
+            }
+            "app.respond" => {
+                let result = call.arguments["result"].clone();
+                let request = crate::mod_surface::pending_server_request(
+                    &call.caller,
+                    &call.arguments["request_id"],
+                )
+                .and_then(|method| codex_omd::app_routes::response_allowed(&method, &result))
+                .and_then(|()| {
+                    serde_json::from_value::<codex_app_server_protocol::RequestId>(
+                        call.arguments["request_id"].clone(),
+                    )
+                    .map_err(|error| format!("app_request_id_invalid: {error}"))
+                });
+                match request {
+                    Ok(request_id) => app_server
+                        .resolve_server_request(request_id, result)
+                        .await
+                        .map(|()| json!({"resolved": true}))
+                        .map_err(|error| error.to_string()),
+                    Err(error) => Err(error),
+                }
+            }
+            "terminal.notify" => Ok(self.mod_notify(tui, &call.arguments)),
+            "terminal.show_thread" => match call.arguments["thread_id"]
+                .as_str()
+                .and_then(|thread| codex_protocol::ThreadId::from_string(thread).ok())
+            {
+                Some(thread) => {
+                    self.app_event_tx.send(AppEvent::SelectModThread {
+                        thread_id: thread,
+                        call,
+                    });
+                    return;
+                }
+                None => Err("thread_id_invalid".into()),
+            },
+            "terminal.import_file" => {
+                tokio::task::spawn_blocking(move || {
+                    let result = import_file(&call);
+                    let _ = call.reply.send(result);
+                });
+                return;
+            }
+            "terminal.image_sample" => {
+                tokio::task::spawn_blocking(move || {
+                    let sample = image_sample(&call);
+                    let _ = call
+                        .reply
+                        .send(crate::mod_surface::validate_call(&call).and(sample));
+                });
+                return;
+            }
+            "terminal.open" if call.arguments["editor"] == true => {
+                match editor_command(&call.arguments) {
+                    Ok((argv, true)) => match call.lifetime.begin_execution() {
+                        Ok(()) => tui
+                            .with_restored(tui::TerminalHandoff::KeepScreen, || {
+                                tokio::process::Command::new(&argv[0])
+                                    .args(&argv[1..])
+                                    .status()
+                            })
+                            .await
+                            .map(|_| json!({"opened": true}))
+                            .map_err(|error| format!("terminal_open_failed: {error}")),
+                        Err(error) => Err(error),
+                    },
+                    Ok(_) => open(&call.arguments),
+                    Err(error) => Err(error),
+                }
+            }
+            "terminal.open" => open(&call.arguments),
+            operation if operation == codex_omd::program_trust::OPERATION => {
+                Ok(json!({"trusted": true}))
+            }
+            "terminal.pty" if call.arguments["action"] == "start" => {
+                let command = (call.context == codex_omd::app_routes::InvocationContext::User)
+                    .then_some(())
+                    .ok_or_else(|| "host_operation_user_only: terminal.pty start".to_owned())
+                    .and_then(|()| {
+                        self.mod_shell_command(&call.caller, &call.arguments, pin.as_ref())
+                    });
+                match (command, pty.as_ref()) {
+                    (Ok((command, home, dir)), Some(binding)) => {
+                        let started = crate::mod_pty::start(
+                            binding,
+                            &call.arguments,
+                            command,
+                            &home,
+                            dir,
+                            tui.frame_requester(),
+                            self.app_event_tx.clone(),
+                        )
+                        .await;
+                        if started.is_ok()
+                            && let Some(approval) = approval
+                            && let Err(error) = approval.save()
+                        {
+                            tracing::warn!("terminal approval not saved: {error}");
+                        }
+                        match (
+                            started,
+                            pin,
+                            crate::omd::mod_paths().map(|paths| paths.store),
+                        ) {
+                            (Ok(started), Some(pin), Some(store)) if !pin.stored => {
+                                if let Err(error) = codex_omd::program_trust::pin(
+                                    &store,
+                                    &call.caller,
+                                    &pin.program,
+                                    &pin.hash,
+                                ) {
+                                    tracing::warn!("terminal program pin not saved: {error}");
+                                }
+                                Ok(started)
+                            }
+                            (started, _, _) => started,
+                        }
+                    }
+                    (Err(error), _) => Err(error),
+                    (_, None) => Err("pty_context_changed".into()),
+                }
+            }
+            "terminal.pty" => pty
+                .as_ref()
+                .ok_or_else(|| "pty_context_changed".to_owned())
+                .and_then(|binding| crate::mod_pty::call(binding, &call.arguments)),
+            "terminal.prompt" if call.arguments["kind"] == "confirm" => {
+                Ok(json!({"status": "accepted"}))
+            }
+            "terminal.prompt" if call.arguments["kind"] == "choice" => {
+                self.show_choice_prompt(call);
+                return;
+            }
+            "terminal.pane" => {
+                tui.frame_requester().schedule_frame();
+                crate::mod_ui::pane(&call.caller, &call.arguments)
+            }
+            "terminal.panes" => Ok(crate::mod_ui::panes(&call.caller)),
+            "terminal.panel" => {
+                crate::bottom_pane::ModPanelRequest::parse(&call.caller, &call.arguments).map(
+                    |request| {
+                        self.chat_widget
+                            .show_mod_panel(call.caller.clone(), request);
+                        json!({"shown": true})
+                    },
+                )
+            }
+            "terminal.notice" => self.mod_notice(tui, &call),
+            "terminal.selection" => {
+                if call
+                    .arguments
+                    .as_object()
+                    .is_none_or(|args| !args.is_empty())
+                {
+                    Err("terminal_selection_arguments_invalid".into())
+                } else {
+                    let text = match self.overlay.as_mut() {
+                        Some(crate::pager_overlay::Overlay::Transcript(overlay)) => {
+                            overlay.selected_text()
+                        }
+                        Some(_) => None,
+                        None => self.transcript_view.selected_text(&self.transcript_cells),
+                    };
+                    Ok(selection_result(text))
+                }
+            }
+            "terminal.copy" => {
+                crate::mod_surface::complete_clipboard(tui.clipboard.poll().cloned());
+                let result = copy_text(&call.arguments).and_then(|text| {
+                    tui.clipboard.copy(
+                        text.into(),
+                        crate::clipboard_copy::CopyFormat::PlainText,
+                        tui.frame_requester(),
+                    )
+                });
+                match result {
+                    Ok(crate::clipboard_copy::CopyStatus::Pending(id)) => {
+                        crate::mod_surface::hold_clipboard(id, call);
+                        tui.frame_requester().schedule_frame();
+                        return;
+                    }
+                    Ok(status) => Ok(json!({"status": match status {
+                        crate::clipboard_copy::CopyStatus::Confirmed => "confirmed",
+                        crate::clipboard_copy::CopyStatus::Unconfirmed => "unconfirmed",
+                        crate::clipboard_copy::CopyStatus::Busy => "busy",
+                        crate::clipboard_copy::CopyStatus::Pending(_) => unreachable!(),
+                    }})),
+                    Err(error) => Err(error),
+                }
+            }
+            "terminal.blit" => {
+                let key = call.arguments["key"].as_str().unwrap_or_default();
+                let result = (|| {
+                    let reply = crate::mod_raster::blit(
+                        &call.caller,
+                        crate::mod_ui::component_owner(key),
+                        crate::mod_ui::raster_size(key),
+                        &call.arguments,
+                        std::time::Instant::now(),
+                        |source, next| call.snapshot_pixels(source, next),
+                    )?;
+                    if let Some(delay) =
+                        crate::mod_raster::pending_delay(key, std::time::Instant::now())
+                    {
+                        tui.frame_requester().schedule_frame_in(delay);
+                    }
+                    Ok(reply)
+                })();
+                call.reply_blit(result);
+                return;
+            }
+            "terminal.prompt" => {
+                let title = match (
+                    prompt_text(&call.arguments["title"], 120),
+                    prompt_text(&call.arguments["message"], 2000),
+                ) {
+                    (Ok(title), Ok(message)) if call.arguments["kind"] == "text" => {
+                        (title, message)
+                    }
+                    _ => {
+                        let _ = call.reply.send(Err("terminal_prompt_invalid".into()));
+                        return;
+                    }
+                };
+                let held_call = call.clone();
+                let reply = call.reply;
+                let view = crate::bottom_pane::SecretPromptView::new(
+                    if call.caller == codex_omd::broker::HOST_CALLER {
+                        title.0
+                    } else {
+                        format!("Mod {} asks: {}", call.caller, title.0)
+                    },
+                    title.1,
+                    Box::new(move |value| {
+                        if let Err(error) = crate::mod_surface::validate_call(&held_call) {
+                            let _ = reply.send(Err(error));
+                            return;
+                        }
+                        let _ = reply.send(Ok(match value {
+                            Some(value) => json!({"status": "accepted", "value": value}),
+                            None => json!({"status": "declined"}),
+                        }));
+                    }),
+                );
+                let view = if call.arguments["masked"] == true {
+                    view
+                } else {
+                    view.plain()
+                };
+                self.chat_widget.show_mod_secret_prompt(view);
+                return;
+            }
+            "packages.apply" => {
+                tokio::task::spawn_blocking(move || {
+                    let result = apply_package(&call, held);
+                    let _ = call.reply.send(result);
+                });
+                return;
+            }
+            "contract.select" => select_contract(&call.arguments, held),
+            "routes.add" => match held {
+                Some(Confirmed::Route(plan)) => store_paths().and_then(|(store, repository)| {
+                    codex_omd::plan_routes::add(&store, &repository, &plan)
+                        .map(|route| json!({"route": route}))
+                        .map_err(|error| error.to_string())
+                }),
+                _ => Err("routes_add_confirmation_missing".into()),
+            },
+            "routes.write" => match held {
+                Some(Confirmed::RouteWrite(write)) => {
+                    tokio::task::spawn_blocking(move || {
+                        let result = store_paths().and_then(|(store, repository)| {
+                            codex_omd::route_writes::apply(&store, &repository, &write)
+                        });
+                        let _ = call.reply.send(result);
+                    });
+                    return;
+                }
+                _ => Err("routes_write_confirmation_missing".into()),
+            },
+            "routes.select" => {
+                self.select_new_thread_route(&call.caller, &call.arguments, call.context)
+            }
+            "composer.read" => {
+                let mut draft = self.chat_widget.mod_composer_read();
+                draft_resources(&call.caller, call.thread.as_deref(), &mut draft).map(|()| draft)
+            }
+            "composer.suggest" => {
+                let source = caller_source(&call.caller).unwrap_or_default();
+                self.chat_widget
+                    .mod_composer_suggest(&call.caller, &source, &call.arguments)
+            }
+            "prompts.consent" | "prompts.submit" | "prompts.status" | "prompts.revoke" => {
+                self.prompts(&call)
+            }
+            "commands.list" => Ok(json!({"commands": self.chat_widget.mod_command_rows()})),
+            "commands.describe" => {
+                let name = call.arguments["command"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .trim_start_matches('/');
+                self.chat_widget
+                    .mod_command_rows()
+                    .into_iter()
+                    .find(|row| row["command"] == name)
+                    .ok_or_else(|| format!("command_unknown: {name}"))
+            }
+            "commands.invoke" => {
+                self.chat_widget.mod_invoke_command(call);
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            "config.describe" | "config.set" => {
+                let binding = crate::mod_runtime::configuration_binding();
+                let handle = app_server.request_handle();
+                let cwd = self.chat_widget.config_ref().cwd.to_path_buf();
+                let read = json!({"method": "config/read", "id": app_server.next_request_id(), "params": {"cwd": cwd}});
+                let write_id = app_server.next_request_id();
+                let runtime = tokio::runtime::Handle::current();
+                let reply = call.reply.clone();
+                tokio::spawn(async move {
+                    let result = async move {
+                        let read = serde_json::from_value::<codex_app_server_protocol::ClientRequest>(read)
+                            .map_err(|error| error.to_string())?;
+                        let read = handle
+                            .request_typed::<Value>(read)
+                            .await
+                            .map_err(|error| error.to_string())?;
+                        tokio::task::spawn_blocking(move || {
+                            crate::mod_surface::validate_call(&call)?;
+                            config_call(&call, &read, binding, |key, value, version| {
+                                crate::mod_surface::validate_call(&call)?;
+                                let request = serde_json::from_value::<codex_app_server_protocol::ClientRequest>(json!({
+                                    "method": "config/value/write", "id": write_id,
+                                    "params": {"keyPath": key, "value": value, "mergeStrategy": "replace", "expectedVersion": version}}))
+                                    .map_err(|error| error.to_string())?;
+                                runtime
+                                    .block_on(handle.request_typed::<Value>(request))
+                                    .map_err(|error| error.to_string())
+                            })
+                        })
+                        .await
+                        .map_err(|error| error.to_string())?
+                    }
+                    .await;
+                    let _ = reply.send(result);
+                });
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            "sessions.ports" => {
+                let Some(thread_id) = call.thread.clone() else {
+                    let _ = call
+                        .reply
+                        .send(Err("session_ports_unavailable: no thread".into()));
+                    return;
+                };
+                let request =
+                    codex_app_server_protocol::ClientRequest::ThreadBackgroundTerminalsList {
+                        request_id: app_server.next_request_id(),
+                        params: codex_app_server_protocol::ThreadBackgroundTerminalsListParams {
+                            thread_id,
+                            cursor: None,
+                            limit: Some(64),
+                        },
+                    };
+                let handle = app_server.request_handle();
+                let reply = call.reply;
+                tokio::spawn(async move {
+                    let result = match handle
+                        .request_typed::<codex_app_server_protocol::ThreadBackgroundTerminalsListResponse>(request)
+                        .await
+                    {
+                        Ok(list) => listening_ports(list.data.iter().filter_map(|terminal| terminal.os_pid).collect()).await,
+                        Err(error) => Err(error.to_string()),
+                    };
+                    let _ = reply.send(result);
+                });
+                return;
+            }
+            "composer.write" => {
+                let attachments =
+                    call.arguments["attach"]
+                        .as_array()
+                        .map(Vec::as_slice)
+                        .unwrap_or_default()
+                        .iter()
+                        .take(8)
+                        .map(|item| {
+                            match item.as_object().map(|item| (item.len(), item.get("image"))) {
+                                Some((1, Some(image))) => {
+                                    materialize(&call.caller, call.thread.as_deref(), image)
+                                }
+                                _ => Err("composer_attach_invalid: attach a resource reference"
+                                    .to_owned()),
+                            }
+                        })
+                        .collect::<Result<Vec<_>, _>>();
+                match attachments {
+                    Ok(attachments) => {
+                        if let Err(error) = crate::mod_surface::validate_call(&call) {
+                            let _ = call.reply.send(Err(error));
+                            return;
+                        }
+                        let mut arguments = call.arguments.clone();
+                        if let Some(object) = arguments.as_object_mut() {
+                            object.remove("attach");
+                        }
+                        let source = caller_source(&call.caller).unwrap_or_default();
+                        self.chat_widget.mod_composer_write(
+                            &call.caller,
+                            &source,
+                            &arguments,
+                            attachments,
+                        )
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            "builtins.invoke" => match call.arguments["action"].as_str() {
+                Some(action) => match self.builtin_action_key(action) {
+                    Ok(key) => {
+                        let _ = call.reply.send(Ok(json!({"invoked": true})));
+                        self.handle_key_event(tui, app_server, key).await;
+                        tui.frame_requester().schedule_frame();
+                        return;
+                    }
+                    Err(error) => Err(error),
+                },
+                None => Err("builtins_action_required".into()),
+            },
+            "credentials.request" => {
+                self.run_mod_credentials(call);
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        };
+        let _ = call.reply.send(result);
+        if call.operation != "terminal.blit" {
+            tui.frame_requester().schedule_frame();
+        }
+    }
+
+    fn mod_notice(&mut self, tui: &mut tui::Tui, call: &SurfaceCall) -> Result<Value, String> {
+        match notice_request(&call.arguments)? {
+            NoticeRequest::Clear { id } => {
+                let cleared = crate::mod_ui::clear_notice(&call.caller, id);
+                tui.frame_requester().schedule_frame();
+                Ok(json!({"cleared": cleared}))
+            }
+            NoticeRequest::Transient {
+                id,
+                kind,
+                placement,
+                text,
+                ttl,
+            } => {
+                crate::mod_ui::notice(&call.caller, id, kind, placement, text, ttl);
+                tui.frame_requester().schedule_frame();
+                tui.frame_requester().schedule_frame_in(ttl);
+                Ok(json!({"shown": true}))
+            }
+            NoticeRequest::Transcript {
+                kind,
+                text,
+                model,
+                call_id,
+            } => {
+                if model {
+                    let thread = call
+                        .thread
+                        .as_deref()
+                        .ok_or("terminal_notice_thread_unavailable")?;
+                    codex_omd::model_request::queue_section(thread, &call.caller, text)?;
+                }
+                match call_id {
+                    Some(call_id)
+                        if tui.is_owned_screen()
+                            && crate::mod_render::tool_notice(
+                                call_id,
+                                kind,
+                                text,
+                                &call.caller,
+                            ) => {}
+                    Some(call_id) => {
+                        self.chat_widget
+                            .add_to_history(crate::history_cell::new_mod_notice(
+                                kind,
+                                text.to_owned(),
+                                &format!("{} · tool {call_id}", call.caller),
+                            ))
+                    }
+                    None => self
+                        .chat_widget
+                        .add_to_history(crate::history_cell::new_mod_notice(
+                            kind,
+                            text.to_owned(),
+                            &call.caller,
+                        )),
+                }
+                Ok(json!({"shown": true, "model": model}))
+            }
+        }
+    }
+
+    fn mod_notify(&mut self, tui: &mut tui::Tui, arguments: &Value) -> Value {
+        let title = arguments["title"].as_str().unwrap_or_default();
+        let body = arguments["body"].as_str().unwrap_or_default();
+        if title.trim().is_empty() {
+            return json!({"delivered": false, "method": "none", "reason": "title_required"});
+        }
+        if !crate::mod_surface::notify_allowed() {
+            return json!({"delivered": false, "method": "none", "reason": "rate_limited"});
+        }
+        match tui.notify_titled(title, body) {
+            Ok(method) => json!({"delivered": true, "method": method}),
+            Err(reason) => json!({"delivered": false, "method": "none", "reason": reason}),
+        }
+    }
+}
