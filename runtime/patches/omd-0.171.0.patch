+        std::fs::create_dir(&repository).unwrap();
+        std::fs::create_dir(repository.join(".git")).unwrap();
+    }
+    let store = ModStore::create(base.join("store")).unwrap();
+    let sources = base.join("packages");
+    std::fs::create_dir(&sources).unwrap();
+    for package in packages {
+        install(&store, &sources, package);
+    }
+    let root = base.join("store").canonicalize().unwrap();
+    let host = Arc::new(Host {
+        root: root.clone(),
+        repository,
+        repository_identity: "fixture".into(),
+        config: config::HostConfig::default(),
+        routes: Mutex::new(crate::RouteTable {
+            stamp: None,
+            config: Arc::new(config::HostConfig::default()),
+            error: None,
+        }),
+        route_status: Arc::default(),
+        accounts: Arc::new(accounting::Accounts::default()),
+        manager: std::sync::Weak::new(),
+        epoch: 1,
+    });
+    let core = if let Some(registry) = registry {
+        initialize(registry, host.clone()).unwrap().core.clone()
+    } else {
+        let runtime = ModHost::open(root.clone(), ModOpenOptions::default()).unwrap();
+        let environment = runtime.environment();
+        let runtime = Arc::new(Mutex::new(runtime));
+        let input_runtime = Arc::new(Mutex::new(
+            ModHost::open(root.clone(), ModOpenOptions::default()).unwrap(),
+        ));
+        let persist_runtime = Arc::new(Mutex::new(
+            ModHost::open(root, ModOpenOptions::default()).unwrap(),
+        ));
+        let persist_required = persist_runtime.lock().unwrap().required_surfaces();
+        let views = Arc::new(view::Views::new(true));
+        let runtime_required = runtime.lock().unwrap().required_surfaces();
+        Arc::new_cyclic(|core| Core {
+            sessions: Arc::default(),
+            turns: Arc::default(),
+            provider_switches: Arc::default(),
+            terminal_owner: None,
+            session_runtime: tokio::runtime::Handle::try_current().ok(),
+            agents: agents::Agents::new(core.clone(), runtime.clone(), views.clone(), host.clone()),
+            host: host.clone(),
+            runtime_required,
+            runtime,
+            input_runtime,
+            disabled_modes: Arc::default(),
+            removed_features: Arc::default(),
+            persist_runtime,
+            persist_required,
+            environment,
+            codex_config: Default::default(),
+            services: services::Services::default(),
+            views,
+            expansion: State::default(),
+            inventory: Arc::default(),
+            autonomy: autonomy::Queues::default(),
+            peering: peering::Registry::default(),
+            this: core.clone(),
+        })
