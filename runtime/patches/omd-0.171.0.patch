+pub(crate) fn synchronize_context(context: ModContext) -> bool {
+    ACTIVE_CONTEXT.with(|active_context_state| {
+        let mut active = active_context_state.locked();
+        let changed = active.synchronize(context);
+        sync_pty_context(&active);
+        changed
+    })
+}
+
+pub(crate) fn begin(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT.with(|active_context_state| {
+        let mut active = active_context_state.locked();
+        let invocation = active.begin(context);
+        sync_pty_context(&active);
+        invocation
+    })
+}
