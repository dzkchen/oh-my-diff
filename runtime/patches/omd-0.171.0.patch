+#[test]
+fn credential_files_are_replaced_privately_and_atomically() {
+    use std::os::unix::fs::PermissionsExt;
+    let (_temp, profiles) = profiles();
+    let secret = profiles
+        .create_secret("site", "https://example.com", "vault")
+        .unwrap();
+    let key = profiles
+        .create(
+            "key",
+            "provider",
+            Some("p"),
+            Some("https://api.example.com"),
+        )
+        .unwrap();
+    let tokens = ["a".repeat(64), "b".repeat(4000)];
+    for (id, origin, owner, file) in [
+        (&secret.id, "https://example.com", Some("vault"), "secret"),
+        (&key.id, "https://api.example.com", None, "auth.json"),
+    ] {
+        let store = |token: &str| {
+            if file == "secret" {
+                profiles.store_secret(id, token)
+            } else {
+                profiles.store_auth(
+                    id,
+                    &serde_json::json!({"OPENAI_API_KEY": token}).to_string(),
+                )
+            }
+        };
+        let read = || profiles.secret(id, origin, owner).unwrap().token;
+        let home = profiles.root.join(id);
+        store(&tokens[0]).unwrap();
+        fs::set_permissions(&home, fs::Permissions::from_mode(0o500)).unwrap();
+        let staged = store(&tokens[1]);
+        fs::set_permissions(&home, fs::Permissions::from_mode(0o700)).unwrap();
+        assert!(staged.is_err());
+        assert_eq!(read(), tokens[0]);
+        assert_eq!(fs::read_dir(&home).unwrap().count(), 1);
+        let done = std::sync::atomic::AtomicBool::new(false);
+        std::thread::scope(|scope| {
+            let reader = scope.spawn(|| {
+                let mut reads = 0;
+                while !done.load(std::sync::atomic::Ordering::Acquire) {
+                    assert!(tokens.contains(&read()));
+                    reads += 1;
+                }
+                reads
+            });
+            for round in 0..200 {
+                store(&tokens[round % 2]).unwrap();
+            }
+            done.store(true, std::sync::atomic::Ordering::Release);
+            assert!(reader.join().unwrap() > 0);
+        });
+        let path = home.join(file);
+        assert_eq!(
+            fs::symlink_metadata(&path).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+        fs::remove_file(&path).unwrap();
+        std::os::unix::fs::symlink(home.join("elsewhere"), &path).unwrap();
+        assert!(store(&tokens[0]).is_err());
+        assert!(fs::symlink_metadata(home.join("elsewhere")).is_err());
+    }
+}
diff --git a/codex-rs/omd/src/data_store.rs b/codex-rs/omd/src/data_store.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5cccb61a26e63bf73f48d2b963085e6fdc53401b
--- /dev/null
+++ b/codex-rs/omd/src/data_store.rs
@@ -0,0 +1,515 @@
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::os::unix::fs::DirBuilderExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::LazyLock;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+pub const KEY_BYTES: usize = 256;
+pub const VALUE_BYTES: usize = 65_536;
+pub const SCOPE_BYTES: usize = 16 * 1024 * 1024;
+pub const KEY_LIMIT: usize = 4096;
+const LIST_LIMIT: usize = 256;
+const CACHED_BYTES: usize = 2 * SCOPE_BYTES;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Origin {
+    UserCommand,
+    Tool,
+    Event,
+    Cli,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct StoreProvenance {
+    pub r#mod: String,
+    pub source_sha256: String,
+    pub thread_id: Option<String>,
+    pub origin: Origin,
+    pub at: u128,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Entry {
+    value: Value,
+    revision: u64,
+    provenance: StoreProvenance,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Document {
+    schema: u32,
+    generation: u64,
+    next_revision: u64,
+    entries: BTreeMap<String, Entry>,
+}
+
+impl Document {
+    fn empty() -> Self {
+        Self {
+            schema: 1,
+            generation: 1,
+            next_revision: 1,
+            entries: BTreeMap::new(),
+        }
+    }
+}
+
+struct Cached {
+    stamp: crate::FileStamp,
+    bytes: usize,
+    document: Arc<Document>,
+}
+
+static DOCUMENTS: LazyLock<Mutex<BTreeMap<PathBuf, Cached>>> = LazyLock::new(Default::default);
+
+fn remember(path: &Path, stamp: crate::FileStamp, bytes: usize, document: &Arc<Document>) {
+    let mut documents = DOCUMENTS.lock().unwrap_or_else(PoisonError::into_inner);
+    documents.remove(path);
+    if documents.values().map(|cached| cached.bytes).sum::<usize>() + bytes > CACHED_BYTES {
+        documents.clear();
+    }
+    documents.insert(
+        path.to_path_buf(),
+        Cached {
+            stamp,
+            bytes,
+            document: Arc::clone(document),
+        },
+    );
+}
+
+fn load(path: &Path) -> io::Result<Arc<Document>> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.is_file() && metadata.len() <= SCOPE_BYTES as u64 => metadata,
+        Ok(_) => return Err(failure("store_document_invalid")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            return Ok(Arc::new(Document::empty()));
+        }
+        Err(error) => return Err(error),
+    };
+    let stamp = crate::file_stamp(&metadata);
+    if let Some(cached) = DOCUMENTS
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(path)
+        .filter(|cached| cached.stamp == stamp)
+    {
+        return Ok(Arc::clone(&cached.document));
+    }
+    let document = serde_json::from_slice::<Document>(&fs::read(path)?)?;
+    if document.schema != 1 {
+        return Err(failure("store_schema_unsupported"));
+    }
+    let document = Arc::new(document);
+    remember(path, stamp, metadata.len() as usize, &document);
+    Ok(document)
+}
+
+fn open_lock(directory: &Path) -> io::Result<fs::File> {
+    fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .mode(0o600)
+        .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+        .open(directory.join(".store.lock"))
+}
+
+fn existing_directory(root: &Path, components: &[&str]) -> io::Result<Option<PathBuf>> {
+    let mut path = root.to_path_buf();
+    for component in components {
+        path.push(component);
+        match fs::symlink_metadata(&path) {
+            Ok(metadata) if metadata.is_dir() => {}
+            Ok(_) => return Err(failure("store_directory_invalid")),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(Some(path))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    #[serde(default)]
+    key: Option<String>,
+    #[serde(default)]
+    value: Option<Value>,
+    #[serde(default)]
+    expected_revision: Option<u64>,
+    #[serde(default)]
+    expected_generation: Option<u64>,
+    #[serde(default)]
+    prefix: Option<String>,
+    #[serde(default)]
+    cursor: Option<String>,
+    #[serde(default)]
+    limit: Option<usize>,
+    #[serde(default = "repository_scope")]
+    scope: String,
+}
+fn repository_scope() -> String {
+    "repository".into()
+}
+
+fn parse_request(operation: &str, arguments: &Value) -> io::Result<Input> {
+    let input: Input = serde_json::from_value(arguments.clone())?;
+    if !matches!(input.scope.as_str(), "repository" | "user" | "thread") {
+        return Err(failure("store_scope_invalid"));
+    }
+    if matches!(operation, "store.get" | "store.put" | "store.delete")
+        && !input.key.as_deref().is_some_and(key)
+    {
+        return Err(failure("store_key_invalid"));
+    }
+    match operation {
+        "store.put" => {
+            let value = input
+                .value
+                .as_ref()
+                .ok_or_else(|| failure("store_value_required"))?;
+            if serde_json::to_vec(value)?.len() > VALUE_BYTES {
+                return Err(failure("store_value_limit"));
+            }
+            if arguments.get("expected_revision").is_none() {
+                return Err(failure("store_expected_revision_required"));
+            }
+        }
+        "store.delete" if input.expected_revision.is_none() => {
+            return Err(failure("store_expected_revision_required"));
+        }
+        "store.reset" if input.expected_generation.is_none() => {
+            return Err(failure("store_expected_generation_required"));
+        }
+        _ => {}
+    }
+    Ok(input)
+}
+
+pub(crate) fn validate_request(operation: &str, arguments: &Value) -> io::Result<()> {
+    parse_request(operation, arguments).map(|_| ())
+}
+
+pub struct DataStore<'a> {
+    pub root: &'a Path,
+    pub repository_key: &'a str,
+    pub owner: &'a str,
+    pub provenance: StoreProvenance,
+}
+
+fn failure(message: impl ToString) -> io::Error {
+    io::Error::other(message.to_string())
+}
+
+fn key(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= KEY_BYTES
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_graphic() && byte != b'\\')
+}
+
+fn newest_change(path: &Path) -> Option<std::time::SystemTime> {
+    let mut newest = fs::symlink_metadata(path).ok()?.modified().ok()?;
+    for entry in fs::read_dir(path).ok()?.filter_map(Result::ok) {
+        if entry.file_type().is_ok_and(|kind| kind.is_dir())
+            && let Some(changed) = newest_change(&entry.path())
+        {
+            newest = newest.max(changed);
+        }
+    }
+    Some(newest)
+}
+
+pub fn prune_thread_directories(directory: &Path, keep: impl Fn(&str) -> bool) {
+    let Ok(entries) = fs::read_dir(directory) else {
+        return;
+    };
+    let cutoff = std::time::SystemTime::now() - std::time::Duration::from_secs(30 * 86_400);
+    for entry in entries.filter_map(Result::ok) {
+        if entry.file_type().is_ok_and(|kind| kind.is_dir())
+            && !keep(&entry.file_name().to_string_lossy())
+            && newest_change(&entry.path()).is_some_and(|changed| changed < cutoff)
+        {
+            let _ = fs::remove_dir_all(entry.path());
+        }
+    }
+}
+
+fn thread_directory(root: &Path, thread: &str) -> io::Result<PathBuf> {
+    if !crate::resource_data::token(thread) || root.canonicalize()? != root {
+        return Err(failure("store_thread_invalid"));
+    }
+    Ok(root.join("data").join("threads").join(thread))
+}
+
+fn copy_regular_tree(from: &Path, to: &Path) -> io::Result<()> {
+    fs::DirBuilder::new()
+        .recursive(true)
+        .mode(0o700)
+        .create(to)?;
+    for entry in fs::read_dir(from)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        let target = to.join(entry.file_name());
+        if kind.is_dir() {
+            copy_regular_tree(&entry.path(), &target)?;
+        } else if kind.is_file() && !entry.file_name().to_string_lossy().starts_with('.') {
+            fs::copy(entry.path(), &target)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn fork_thread_data(root: &Path, from: &str, to: &str) -> io::Result<bool> {
+    let (source, target) = (thread_directory(root, from)?, thread_directory(root, to)?);
+    match fs::symlink_metadata(&source) {
+        Ok(metadata) if metadata.is_dir() => {
+            if target.try_exists()? {
+                return Err(io::Error::new(
+                    io::ErrorKind::AlreadyExists,
+                    "store_thread_exists",
+                ));
+            }
+            let threads = target
+                .parent()
+                .ok_or_else(|| failure("store_thread_invalid"))?;
+            let stage = tempfile::Builder::new()
+                .prefix(".fork-")
+                .tempdir_in(threads)?;
+            copy_regular_tree(&source, stage.path())?;
+            // A writer may create the target directory meanwhile; an exclusive rename never replaces even an empty one.
+            crate::workspace::rename_exclusive(
+                rustix::fs::CWD,
+                stage.path(),
+                rustix::fs::CWD,
+                target.as_path(),
+            )?;
+            let _ = stage.keep();
+            Ok(true)
+        }
+        Ok(_) => Err(failure("store_directory_invalid")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+pub fn remove_thread_data(root: &Path, thread: &str) -> io::Result<bool> {
+    crate::turn_activity::TurnActivityLog::open(&root.join("turn-activity"), thread)?.remove()?;
+    let directory = thread_directory(root, thread)?;
+    match fs::symlink_metadata(&directory) {
+        Ok(metadata) if metadata.is_dir() => fs::remove_dir_all(&directory).map(|()| true),
+        Ok(_) => Err(failure("store_directory_invalid")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+impl DataStore<'_> {
+    fn directory(&self, scope: &str, create: bool) -> io::Result<Option<PathBuf>> {
+        let components = match scope {
+            "repository" => vec!["data", self.repository_key, self.owner],
+            "user" => vec!["data", "user", self.owner],
+            "thread" => {
+                let thread = self
+                    .provenance
+                    .thread_id
+                    .as_deref()
+                    .ok_or_else(|| failure("store_thread_unavailable"))?;
+                if !crate::resource_data::token(thread) {
+                    return Err(failure("store_thread_invalid"));
+                }
+                vec!["data", "threads", thread, self.owner]
+            }
+            _ => return Err(failure("store_scope_invalid")),
+        };
+        if !crate::resource_data::token(self.owner)
+            || !(scope != "repository" || crate::is_sha256_hex(self.repository_key))
+            || self.root.canonicalize()? != self.root
+        {
+            return Err(failure("store_root_invalid"));
+        }
+        if create {
+            crate::workspace::private_path(self.root, &components, "store_directory_invalid")
+                .map(Some)
+        } else {
+            existing_directory(self.root, &components)
+        }
+    }
+
+    fn read<T>(&self, scope: &str, read: impl FnOnce(&Document) -> io::Result<T>) -> io::Result<T> {
+        let Some(directory) = self.directory(scope, false)? else {
+            return read(&Document::empty());
+        };
+        let lock = open_lock(&directory)?;
+        lock.lock_shared()?;
+        let document = load(&directory.join("store.json"))?;
+        read(&document)
+    }
+
+    fn write<T>(
+        &self,
+        scope: &str,
+        change: impl FnOnce(&mut Document) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let directory = self
+            .directory(scope, true)?
+            .ok_or_else(|| failure("store_directory_invalid"))?;
+        let lock = open_lock(&directory)?;
+        lock.lock()?;
+        let path = directory.join("store.json");
+        let mut document = load(&path)?;
+        DOCUMENTS
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .remove(&path);
+        let value = change(Arc::make_mut(&mut document))?;
+        let bytes = serde_json::to_vec(&*document)?;
+        if bytes.len() > SCOPE_BYTES || document.entries.len() > KEY_LIMIT {
+            return Err(failure("store_quota"));
+        }
+        crate::fsio::write_bytes(&path, &bytes, crate::fsio::Durability::Ordered)?;
+        let stamp = crate::file_stamp(&fs::symlink_metadata(&path)?);
+        remember(&path, stamp, bytes.len(), &document);
+        Ok(value)
+    }
+
+    pub fn call(&self, operation: &str, arguments: Value) -> io::Result<Value> {
+        let input = parse_request(operation, &arguments)?;
+        let checked_key = || {
+            input
+                .key
+                .as_deref()
+                .ok_or_else(|| failure("store_key_invalid"))
+        };
+        match operation {
+            "store.get" => {
+                let name = checked_key()?.to_owned();
+                self.read(&input.scope, |document| {
+                    Ok(document.entries.get(&name).map_or(Value::Null, |entry| {
+                        json!({"value": entry.value, "revision": entry.revision, "provenance": entry.provenance})
+                    }))
+                })
+            }
+            "store.put" => {
+                let name = checked_key()?.to_owned();
+                let value = input
+                    .value
+                    .clone()
+                    .ok_or_else(|| failure("store_value_required"))?;
+                let expected = input.expected_revision;
+                let provenance = StoreProvenance {
+                    at: u128::from(crate::peers::now_ms()),
+                    ..self.provenance.clone()
+                };
+                self.write(&input.scope, |document| {
+                    let current = document.entries.get(&name).map(|entry| entry.revision);
+                    if current != expected {
+                        return Err(failure(format!(
+                            "store_revision_conflict: current {}",
+                            current.map_or("absent".to_owned(), |value| value.to_string())
+                        )));
+                    }
+                    let revision = document.next_revision;
+                    document.next_revision += 1;
+                    document.entries.insert(
+                        name,
+                        Entry {
+                            value,
+                            revision,
+                            provenance,
+                        },
+                    );
+                    Ok(json!({"revision": revision}))
+                })
+            }
+            "store.delete" => {
+                let name = checked_key()?.to_owned();
+                let expected = input
+                    .expected_revision
+                    .ok_or_else(|| failure("store_expected_revision_required"))?;
+                self.write(&input.scope, |document| match document.entries.get(&name) {
+                    Some(entry) if entry.revision == expected => {
+                        document.entries.remove(&name);
+                        Ok(json!({"deleted": true}))
+                    }
+                    Some(_) => Err(failure("store_revision_conflict")),
+                    None => Ok(json!({"deleted": false})),
+                })
+            }
+            "store.list" => {
+                let prefix = input.prefix.clone().unwrap_or_default();
+                let limit = input.limit.unwrap_or(LIST_LIMIT).clamp(1, LIST_LIMIT);
+                self.read(&input.scope, |document| {
+                    let keys = document
+                        .entries
+                        .iter()
+                        .filter(|(name, _)| name.starts_with(&prefix))
+                        .filter(|(name, _)| input.cursor.as_ref().is_none_or(|cursor| *name > cursor))
+                        .take(limit + 1)
+                        .map(|(name, entry)| {
+                            Ok(json!({"key": name, "revision": entry.revision,
+                                "bytes": serde_json::to_vec(&entry.value)?.len(), "provenance": entry.provenance}))
+                        })
+                        .collect::<io::Result<Vec<_>>>()?;
+                    let cursor = (keys.len() > limit).then(|| keys[limit - 1]["key"].clone());
+                    Ok(json!({"keys": &keys[..keys.len().min(limit)], "cursor": cursor.unwrap_or(Value::Null),
+                        "generation": document.generation}))
+                })
+            }
+            "store.export" => {
+                self.read(&input.scope, |document| {
+                    let mut entries = serde_json::Map::new();
+                    let mut bytes = 0;
+                    let mut cursor = Value::Null;
+                    for (name, entry) in document.entries.iter().filter(|(name, _)| {
+                        input.cursor.as_ref().is_none_or(|cursor| *name > cursor)
+                    }) {
+                        let value = serde_json::to_value(entry)?;
+                        let size = name.len() + serde_json::to_vec(&value)?.len();
+                        if !entries.is_empty() && bytes + size > VALUE_BYTES {
+                            cursor = json!(entries.keys().next_back());
+                            break;
+                        }
+                        bytes += size;
+                        entries.insert(name.clone(), value);
+                    }
+                    Ok(
+                        json!({"schema": 1, "owner": self.owner, "scope": input.scope,
+                    "generation": document.generation, "entries": entries, "cursor": cursor}),
+                    )
+                })
+            }
+            "store.reset" => {
+                let expected = input
+                    .expected_generation
+                    .ok_or_else(|| failure("store_expected_generation_required"))?;
+                self.write(&input.scope, |document| {
+                    if document.generation != expected {
+                        return Err(failure("store_generation_conflict"));
+                    }
+                    document.entries.clear();
+                    document.generation += 1;
+                    Ok(json!({"generation": document.generation}))
+                })
+            }
+            _ => Err(failure(format!("unsupported_host_operation: {operation}"))),
+        }
+    }
+}
diff --git a/codex-rs/omd/src/drafts.rs b/codex-rs/omd/src/drafts.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9bd4322894b74db06818c99ddc5479d09edc92ea
--- /dev/null
+++ b/codex-rs/omd/src/drafts.rs
@@ -0,0 +1,19 @@
+//! Draft revisions handed from the terminal to the prompt submission they produced.
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+static SUBMITTED: Mutex<BTreeMap<String, u64>> = Mutex::new(BTreeMap::new());
+
+pub fn submitted(client_id: &str, revision: u64) {
+    if let Ok(mut submitted) = SUBMITTED.lock() {
+        if submitted.len() >= 64 {
+            submitted.clear();
+        }
+        submitted.insert(client_id.to_owned(), revision);
+    }
+}
+
+pub fn take(client_id: &str) -> Option<u64> {
+    SUBMITTED.lock().ok()?.remove(client_id)
+}
diff --git a/codex-rs/omd/src/event_bus.rs b/codex-rs/omd/src/event_bus.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c8781fd555a1992e5da89c8dc49ee94ce9fcfe7a
--- /dev/null
+++ b/codex-rs/omd/src/event_bus.rs
@@ -0,0 +1,272 @@
+use crate::app_routes::subscribed;
+use serde_json::Value;
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+use std::io;
+use std::sync::{LazyLock, Mutex};
+use std::time::{Duration, Instant};
+
+pub const CHANNEL_QUEUE_EVENTS: usize = 256;
+pub const CHANNEL_QUEUE_BYTES: usize = 1 << 20;
+pub const CHANNEL_EVENT_BYTES: usize = 64 * 1024;
+pub const CHANNELS_PER_PUBLISHER: usize = 256;
+pub const CHANNEL_SEQUENCES: usize = 4096;
+pub const CHANNEL_PUBLISHER_IDLE: Duration = Duration::from_secs(15 * 60);
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChannelEvent {
+    pub scope: Option<String>,
+    pub publisher: String,
+    pub thread: String,
+    pub channel: String,
+    pub data: Value,
+    pub correlation: Option<String>,
+    pub sequence: u64,
+    pub dropped: u64,
+}
+
+#[derive(Debug, Default, PartialEq)]
+pub struct Delivery {
+    pub delivered: usize,
+    pub dropped: usize,
+}
+
+struct Subscriber {
+    patterns: Vec<String>,
+    queue: VecDeque<(ChannelEvent, usize)>,
+    bytes: usize,
+    dropped: u64,
+}
+
+struct PublisherSequences {
+    used: Instant,
+    channels: BTreeMap<String, u64>,
+}
+
+type Key = (Option<String>, String);
+
+fn key(scope: Option<&str>, id: &str) -> Key {
+    (scope.map(str::to_owned), id.to_owned())
+}
+
+pub struct EventBus {
+    subscribers: BTreeMap<Key, Subscriber>,
+    sequences: BTreeMap<Key, PublisherSequences>,
+    max_events: usize,
+    max_bytes: usize,
+}
+
+static GLOBAL: LazyLock<Mutex<EventBus>> = LazyLock::new(|| Mutex::new(EventBus::default()));
+
+pub fn global() -> &'static Mutex<EventBus> {
+    &GLOBAL
+}
+
+impl Default for EventBus {
+    fn default() -> Self {
+        Self::new(CHANNEL_QUEUE_EVENTS, CHANNEL_QUEUE_BYTES)
+    }
+}
+
+fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 64
+        && name.bytes().all(|b| {
+            b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'_' | b'-' | b'.')
+        })
+}
+
+impl EventBus {
+    pub fn new(max_events: usize, max_bytes: usize) -> Self {
+        Self {
+            subscribers: BTreeMap::new(),
+            sequences: BTreeMap::new(),
+            max_events,
+            max_bytes,
+        }
+    }
+
+    pub fn subscribe(&mut self, scope: Option<&str>, subscriber: &str, patterns: Vec<String>) {
+        if patterns.is_empty() {
+            self.unsubscribe(scope, subscriber);
+            return;
+        }
+        let entry = self
+            .subscribers
+            .entry(key(scope, subscriber))
+            .or_insert_with(|| Subscriber {
+                patterns: Vec::new(),
+                queue: VecDeque::new(),
+                bytes: 0,
+                dropped: 0,
+            });
+        entry.patterns = patterns;
+    }
+
+    pub fn unsubscribe(&mut self, scope: Option<&str>, subscriber: &str) {
+        self.subscribers.remove(&key(scope, subscriber));
+    }
+
+    pub fn release_scope(&mut self, scope: &str) {
+        self.subscribers
+            .retain(|(owner, _), _| owner.as_deref() != Some(scope));
+        self.sequences
+            .retain(|(owner, _), _| owner.as_deref() != Some(scope));
+    }
+
+    pub fn publish(
+        &mut self,
+        scope: Option<&str>,
+        publisher: &str,
+        name: &str,
+        data: Value,
+        correlation: Option<String>,
+        thread: &str,
+    ) -> io::Result<Delivery> {
+        self.publish_at(
+            scope,
+            publisher,
+            name,
+            data,
+            correlation,
+            thread,
+            Instant::now(),
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn publish_at(
+        &mut self,
+        scope: Option<&str>,
+        publisher: &str,
+        name: &str,
+        data: Value,
+        correlation: Option<String>,
+        thread: &str,
+        now: Instant,
+    ) -> io::Result<Delivery> {
+        if !valid_name(name) {
+            return Err(io::Error::other(format!("channel_name_invalid: {name}")));
+        }
+        let size = data.to_string().len();
+        if size > CHANNEL_EVENT_BYTES {
+            return Err(io::Error::other(format!("channel_event_too_large: {size}")));
+        }
+        if correlation.as_ref().is_some_and(|c| c.len() > 256) {
+            return Err(io::Error::other("channel_correlation_too_large"));
+        }
+        if self
+            .sequences
+            .values()
+            .any(|sequences| now.duration_since(sequences.used) >= CHANNEL_PUBLISHER_IDLE)
+        {
+            let queued = self
+                .subscribers
+                .values()
+                .flat_map(|subscriber| {
+                    subscriber
+                        .queue
+                        .iter()
+                        .map(|(event, _)| key(event.scope.as_deref(), &event.publisher))
+                })
+                .collect::<BTreeSet<_>>();
+            self.sequences.retain(|publisher, sequences| {
+                now.duration_since(sequences.used) < CHANNEL_PUBLISHER_IDLE
+                    || queued.contains(publisher)
+            });
+        }
+        let publisher_key = key(scope, publisher);
+        let current = self.sequences.get(&publisher_key);
+        if !current.is_some_and(|sequences| sequences.channels.contains_key(name))
+            && (current.is_some_and(|sequences| sequences.channels.len() >= CHANNELS_PER_PUBLISHER)
+                || self
+                    .sequences
+                    .values()
+                    .map(|sequences| sequences.channels.len())
+                    .sum::<usize>()
+                    >= CHANNEL_SEQUENCES)
+        {
+            return Err(io::Error::other("channel_sequence_limit"));
+        }
+        let channel = format!("{publisher}/{name}");
+        let publisher_sequences =
+            self.sequences
+                .entry(publisher_key)
+                .or_insert_with(|| PublisherSequences {
+                    used: now,
+                    channels: BTreeMap::new(),
+                });
+        publisher_sequences.used = now;
+        let sequence = publisher_sequences
+            .channels
+            .entry(name.to_owned())
+            .or_default();
+        *sequence += 1;
+        let event = ChannelEvent {
+            scope: scope.map(str::to_owned),
+            publisher: publisher.to_owned(),
+            thread: thread.to_owned(),
+            channel: channel.clone(),
+            data,
+            correlation,
+            sequence: *sequence,
+            dropped: 0,
+        };
+        let mut delivery = Delivery::default();
+        for subscriber in self
+            .subscribers
+            .iter_mut()
+            .filter(|((subscriber_scope, _), s)| {
+                subscriber_scope.as_deref() == scope && subscribed(&s.patterns, &channel)
+            })
+            .map(|(_, subscriber)| subscriber)
+        {
+            subscriber.bytes += size;
+            subscriber.queue.push_back((event.clone(), size));
+            delivery.delivered += 1;
+            while subscriber.queue.len() > self.max_events
+                || (subscriber.bytes > self.max_bytes && subscriber.queue.len() > 1)
+            {
+                if let Some((_, old)) = subscriber.queue.pop_front() {
+                    subscriber.bytes -= old;
+                    subscriber.dropped += 1;
+                    delivery.dropped += 1;
+                }
+            }
+        }
+        Ok(delivery)
+    }
+
+    pub fn drain(
+        &mut self,
+        scope: Option<&str>,
+        subscriber: &str,
+        limit: usize,
+    ) -> Vec<ChannelEvent> {
+        let Some(entry) = self.subscribers.get_mut(&key(scope, subscriber)) else {
+            return Vec::new();
+        };
+        let count = limit.min(entry.queue.len());
+        let mut drained: Vec<_> = entry
+            .queue
+            .drain(..count)
+            .map(|(event, bytes)| {
+                entry.bytes -= bytes;
+                event
+            })
+            .collect();
+        if let Some(first) = drained.first_mut() {
+            first.dropped = std::mem::take(&mut entry.dropped);
+        }
+        drained
+    }
+
+    pub fn pending(&self, scope: Option<&str>, subscriber: &str) -> usize {
+        self.subscribers
+            .get(&key(scope, subscriber))
+            .map_or(0, |s| s.queue.len())
+    }
+}
+
