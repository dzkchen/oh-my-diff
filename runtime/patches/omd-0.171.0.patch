+pub(crate) fn rerender() {
+    if remote_frontend_active() {
+        send_client_viewport();
+        return;
+    }
+    if owner_view_active() {
+        codex_omd::client_surface::client_changed();
+        return;
+    }
+    if let Some(context) = active_context() {
+        rerender_for(context, &|| true);
+    }
+}
+
+fn rerender_for(context: ModContext, allowed: &dyn Fn() -> bool) {
+    if allowed() && !defer_while_command_runs() {
+        render_for(context, allowed);
+    }
+}
+
+fn render_for(context: ModContext, allowed: &dyn Fn() -> bool) {
+    RENDER_REQUEST.with(|requests| {
+        if !allowed() {
+            return;
+        }
+        let Some(invocation) = ACTIVE_CONTEXT.with(|state| {
+            let mut active = state.locked();
+            (active.context.as_ref() == Some(&context)).then(|| active.join(context.clone()))
+        }) else {
+            return;
+        };
+        let request = {
+            let mut current = requests.locked();
+            *current = current.wrapping_add(1);
+            *current
+        };
+        let active = || *requests.locked() == request && current(&invocation) && allowed();
+        let Some(paths) = crate::omd::mod_paths_for(&context.repository) else {
+            return;
+        };
+        let Ok(runtime) = shared_host_active(&active) else {
+            return;
+        };
+        loop {
+            let (mut snapshot, owner_generation) = if owner_view_active() {
+                OWNER_VIEW_GENERATION.with(|owner_state| {
+                    let generation = owner_state.locked();
+                    (
+                        crate::mod_ui::shared_snapshot().as_ref().clone(),
+                        Some(*generation),
+                    )
+                })
+            } else if let Some(snapshot) = crate::omd::view_snapshot(&paths.store.join("mod-view.json")) {
+                (snapshot, None)
+            } else {
+                return;
+            };
+            snapshot.rendered_ms = codex_omd::peers::now_ms();
+            snapshot.input["client"] = crate::mod_client::value();
+            snapshot.input["ledger"] = serde_json::json!({
+                "thread_id": context.thread_id.map(|id| id.to_string()),
+                "cwd": context.repository,
+            });
+            {
+                let mut runtime = runtime.locked();
+                reload_active(&mut runtime, &active);
+            }
+            let input = snapshot.input.clone();
+            let mut retry = false;
+            let rendered = codex_omd::terminal_shared(&runtime, input, active, |terminal, configuration| {
+                let current = requests.locked();
+                if *current != request || !allowed() {
+                    return;
+                }
+                publish_for_context(&invocation, || {
+                    OWNER_VIEW_GENERATION.with(|owner_state| {
+                        let generation = owner_state.locked();
+                        if owner_generation.is_some_and(|expected| expected != *generation) {
+                            retry = true;
+                            return;
+                        }
+                        snapshot.input["pty_scope"] = serde_json::json!({"epoch": codex_omd::client_surface::epoch(), "admission": codex_omd::client_surface::admission(), "configuration": configuration});
+                        snapshot.revision = snapshot.revision.saturating_add(1);
+                        snapshot.view = terminal.view;
+                        snapshot.conflicts = terminal.conflicts;
+                        snapshot.contributors = terminal.contributors;
+                        snapshot.component_owners = terminal.component_owners;
+                        snapshot.layout_owner = terminal.layout_owner;
+                        snapshot.diagnostics = snapshot.native_diagnostics.clone();
+                        for diagnostic in terminal.diagnostics {
+                            if !snapshot.diagnostics.contains(&diagnostic) {
+                                snapshot.diagnostics.push(diagnostic);
+                            }
+                        }
+                        snapshot.diagnostics.truncate(16);
+                        if crate::mod_ui::preview(snapshot) {
+                            codex_omd::client_surface::redraw();
+                        } else {
+                            crate::mod_render::reask();
+                        }
+                    });
+                });
+            });
+            let superseded =
+                rendered.is_err_and(|error| error.to_string() == "terminal_view_stale");
+            if !(retry || superseded) || !active() {
+                break;
+            }
+        }
+    });
+}
