+    let cell = run();
+    let mut expected = cell.group.calls[0].display_lines(80);
+    expected.push(Line::from(""));
+    expected.extend(cell.group.calls[1].display_lines(80));
+    assert_eq!(cell.display_lines(80), expected);
+    assert!(is_tool_member(cell.group.calls[1].as_ref()));
+    assert!(!is_tool_member(&cell));
+}
