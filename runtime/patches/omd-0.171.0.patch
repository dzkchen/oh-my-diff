+        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    }
+    assert!(text.contains("[<0;3;2M"), "{text}");
+    pointer(MouseEvent {
+        kind: MouseEventKind::Up(MouseButton::Left),
+        column: anchor.x + 2,
+        row: 0,
+        modifiers: KeyModifiers::NONE,
+    });
