+    binding: ConfigurationBinding,
+    owner: Option<String>,
+    thread: Option<String>,
+) -> Result<ConfigurationContext, String> {
+    let _binding = FRONTEND_APPLY.locked();
+    if !configuration_binding_current(binding) {
+        return Err("terminal_context_changed".into());
+    }
+    if owner.is_some() && owner != configuration_owner_id() {
+        return Err("terminal_context_changed".into());
+    }
+    Ok(ConfigurationContext {
+        binding,
+        runtime: shared_host()?,
+        paths: crate::omd::mod_paths().ok_or("mods are not configured for this session")?,
+        owner,
+        thread,
+        epoch: codex_omd::client_surface::epoch(),
+        remote: remote_frontend_active(),
+    })
+}
+
+fn packages(context: &ConfigurationContext) -> Result<Value, String> {
+    if context.remote {
+        let result =
+            remote_configuration_at(serde_json::json!({"action":"read"}), context.binding.0)
+                .ok_or("terminal_configuration_unavailable")?;
+        return result.map_err(|error| error.to_string());
+    }
+    let store = codex_omd::ModStore::open(context.paths.store.clone())
+        .map_err(|error| error.to_string())?;
+    let mut runtime = context.runtime.locked();
+    runtime
+        .refresh(&|| true)
+        .map_err(|error| error.to_string())?;
+    let listed = codex_omd::package_controls::list(&store, Some(&runtime.status()))
+        .map_err(|error| error.to_string())?;
+    runtime
+        .configuration_listing(listed)
+        .map_err(|error| error.to_string())
+}
