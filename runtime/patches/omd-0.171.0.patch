+        owner: "lead".into(),
+        depth: 0,
+        permission_profile: Arc::new(Mutex::new(PermissionProfile::default())),
+    };
+    core.expansion.thread_started(&lead);
+    core.expansion.refresh(&core.runtime.lock().unwrap());
+    Some(Fixture {
+        _dir: dir,
+        core,
+        lead,
+    })
+}
