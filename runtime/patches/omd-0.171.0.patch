+                generation,
+                "command",
+                "write",
+                json!(0),
+                ModInvokeOptions::default(),
+            )
+            .unwrap();
+            assert_eq!(
+                host.terminal_view(json!({}), || true)
+                    .view
+                    .greeting
+                    .as_deref(),
+                Some("0"),
+                "state returned to zero: {state}, cached={cached}"
+            );
+        }
+    }
