+    }
+    let value = std::thread::scope(|scope| {
+        std::thread::Builder::new()
+            .stack_size(256 * 1024)
+            .spawn_scoped(scope, || {
+                call(
+                    &source,
+                    "environment.read",
+                    json!({"names": ["FIXTURE_VALUE"]}),
+                )
+            })
+            .unwrap()
+            .join()
+            .unwrap()
