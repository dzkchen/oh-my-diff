index 0000000000000000000000000000000000000000..32cc507259823594a76703cb33669b8ec6b13f75
--- /dev/null
+++ b/codex-rs/tui/src/notifications/titled.rs
@@ -0,0 +1,116 @@
+use std::fmt;
+
+use crossterm::Command;
+
+pub const TITLE_CHARS: usize = 64;
+pub const BODY_CHARS: usize = 256;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TitledProtocol {
+    Osc9,
+    Osc99,
+    Osc777,
+    Bel,
+}
+
+impl TitledProtocol {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Osc9 => "osc9",
+            Self::Osc99 => "osc99",
+            Self::Osc777 => "osc777",
+            Self::Bel => "bel",
+        }
+    }
+}
+
+pub fn sanitize(text: &str, limit: usize) -> String {
+    text.chars()
+        .map(|c| if c.is_control() || c == ';' { ' ' } else { c })
+        .take(limit)
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+#[derive(Debug, Clone)]
+pub struct PostTitledNotification {
+    pub protocol: TitledProtocol,
+    pub title: String,
+    pub body: String,
+    pub dcs_passthrough: bool,
+}
+
+impl PostTitledNotification {
+    fn sequence(&self) -> String {
+        let (title, body) = (
+            sanitize(&self.title, TITLE_CHARS),
+            sanitize(&self.body, BODY_CHARS),
+        );
+        match self.protocol {
+            TitledProtocol::Osc99 if body.is_empty() => format!("\x1b]99;i=omd:d=1;{title}\x1b\\"),
+            TitledProtocol::Osc99 => {
+                format!("\x1b]99;i=omd:d=0;{title}\x1b\\\x1b]99;i=omd:d=1:p=body;{body}\x1b\\")
+            }
+            TitledProtocol::Osc777 => format!("\x1b]777;notify;{title};{body}\x07"),
+            TitledProtocol::Osc9 if body.is_empty() => format!("\x1b]9;{title}\x07"),
+            TitledProtocol::Osc9 => format!("\x1b]9;{title}: {body}\x07"),
+            TitledProtocol::Bel => "\x07".to_string(),
+        }
+    }
+}
+
+impl Command for PostTitledNotification {
+    fn write_ansi(&self, f: &mut impl fmt::Write) -> fmt::Result {
+        let sequence = self.sequence();
+        if self.dcs_passthrough && self.protocol != TitledProtocol::Bel {
+            write!(
+                f,
+                "\x1bPtmux;{}\x1b\\",
+                sequence.replace('\x1b', "\x1b\x1b")
+            )
+        } else {
+            f.write_str(&sequence)
+        }
+    }
+
+    #[cfg(windows)]
+    fn execute_winapi(&self) -> std::io::Result<()> {
+        Err(std::io::Error::other(
+            "titled notifications use ANSI sequences",
+        ))
+    }
+
+    #[cfg(windows)]
+    fn is_ansi_code_supported(&self) -> bool {
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn ansi(protocol: TitledProtocol, title: &str, body: &str, dcs_passthrough: bool) -> String {
+        let mut out = String::new();
+        PostTitledNotification {
+            protocol,
+            title: title.into(),
+            body: body.into(),
+            dcs_passthrough,
+        }
+        .write_ansi(&mut out)
+        .unwrap();
+        out
+    }
+
+    #[test]
+    fn text_is_sanitized_and_bounded() {
+        assert_eq!(
+            ansi(TitledProtocol::Osc777, "a;b\x1b]0;x\x07", "c\nd", false),
+            "\x1b]777;notify;a b ]0 x;c d\x07"
+        );
+        assert_eq!(sanitize(&"x".repeat(100), TITLE_CHARS).len(), TITLE_CHARS);
+    }
+}
