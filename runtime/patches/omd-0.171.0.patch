+    use serde_json::json;
+
+    #[test]
+    fn typed_configuration_requests_reject_malformed_targets_and_fields() {
+        let valid =
+            json!({"action":"write","id":"demo","values":{"choice":null},"reset":["color"]});
+        assert!(serde_json::from_value::<OmdConfigurationParams>(valid).is_ok());
+        for invalid in [
+            json!({"action":"read","id":"demo"}),
+            json!({"action":"write","id":"demo","values":[],"target":"terminal"}),
+            json!({"action":"write","id":"demo","values":{},"target":"thread"}),
+            json!({"action":"write","id":"demo","values":{},"reset":[null]}),
+            json!({"action":"package","request":{"action":"install","id":"demo","scope":"user"}}),
+            json!({"action":"package","request":{"action":"disable","id":"demo","scope":"managed"}}),
+            json!({"action":"package","request":{"action":"disable","id":"demo","scope":"user","expected_generation":-1}}),
+            json!({"action":"package","request":{"action":"disable","id":"demo","scope":"user","extra":true}}),
+        ] {
