+
+crate::omd::isolated_static! { MESSAGE_HISTORY: Mutex<std::collections::BTreeMap<String, bool>> =
+Mutex::new(std::collections::BTreeMap::new()) }
+
+pub(crate) fn remember_message_history(thread: &str, canonical: bool) {
+    MESSAGE_HISTORY.with(|message_history_state| {
+        if !crate::omd::is_active() {
+            return;
+        }
+        let mut modes = message_history_state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if modes.len() >= 4096 && !modes.contains_key(thread) {
+            modes.pop_first();
+        }
+        modes.insert(thread.to_owned(), canonical);
+    })
+}
+
+pub(crate) fn replay_message_id(
+    thread: Option<codex_protocol::ThreadId>,
+    id: String,
+) -> Option<String> {
+    MESSAGE_HISTORY.with(|message_history_state| {
+        thread
+            .filter(|thread| {
+                message_history_state
+                    .lock()
+                    .is_ok_and(|modes| modes.get(&thread.to_string()) == Some(&true))
+            })
+            .map(|_| id)
+    })
+}
+
+const DONE_LIMIT: usize = 2048;
+const PENDING_LIMIT: usize = 256;
+const RETRY: Duration = Duration::from_millis(250);
+
+pub(crate) struct RenderTarget {
+    pub(crate) component: &'static str,
+    pub(crate) id: String,
+    pub(crate) live: bool,
+    pub(crate) props: Value,
+}
+
+impl RenderTarget {
+    pub(crate) fn new(
+        component: &'static str,
+        id: impl Into<String>,
+        live: bool,
+        props: Value,
+    ) -> Self {
+        Self {
+            component,
+            id: id.into(),
+            live,
+            props,
+        }
+    }
+}
+
+/// A content digest: equal content draws identically, and it survives resume and reflow.
+pub(crate) fn content_id(kind: &str, text: &str) -> String {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    format!("{kind}-{:016x}", hasher.finish())
+}
+
+const PROP_BYTES: usize = codex_omd::MOD_TEXT_BYTES;
+
+/// Props carry at most `MOD_TEXT_BYTES` of text; hooks needing more read their own sources.
+pub(crate) fn bounded(text: &str) -> String {
+    text[..text.floor_char_boundary(PROP_BYTES)].to_owned()
+}
+
+pub(crate) fn first_line<'a>(texts: impl IntoIterator<Item = &'a str>) -> Option<String> {
+    texts
+        .into_iter()
+        .flat_map(str::lines)
+        .map(str::trim)
+        .find(|line| !line.is_empty())
+        .map(bounded)
+}
+
+pub(crate) fn bounded_json(value: &Value) -> Value {
+    let text = value.to_string();
+    if text.len() <= PROP_BYTES {
+        value.clone()
+    } else {
+        Value::String(bounded(&text))
+    }
+}
+
+pub(crate) fn message_identity(turn: Option<&str>, id: Option<&str>) -> Option<String> {
+    turn.zip(id).map(|(turn, id)| format!("{turn}:{id}"))
+}
+
+pub(crate) fn assistant_props(text: &str, first: bool, message_id: Option<&str>) -> Value {
+    serde_json::json!({"text": bounded(text), "first": first, "truncated": text.len() > PROP_BYTES, "message_id": message_id})
+}
+
+pub(crate) fn question_props(
+    questions: &[codex_app_server_protocol::ToolRequestUserInputQuestion],
+) -> Value {
+    Value::Array(
+        questions
+            .iter()
+            .map(|question| {
+                json!({
+                    "id": question.id,
+                    "header": bounded(&question.header),
+                    "question": bounded(&question.question),
+                    "secret": question.is_secret,
+                    "options": question.options.iter().flatten().map(|option| bounded(&option.label)).collect::<Vec<_>>(),
+                })
+            })
+            .collect(),
+    )
+}
+
+#[derive(Clone, PartialEq)]
+pub(crate) struct Rendered {
+    /// `None` when the hooks passed the target's props on unchanged.
+    pub(crate) props: Option<Value>,
+    pub(crate) tree: Vec<ModComponent>,
+}
+
+impl Rendered {
+    fn props<'a>(&'a self, target: &'a RenderTarget) -> &'a Value {
+        self.props.as_ref().unwrap_or(&target.props)
+    }
+}
+
+fn digest(value: &Value, hasher: &mut impl Hasher) {
+    std::mem::discriminant(value).hash(hasher);
+    match value {
+        Value::String(text) => text.hash(hasher),
+        Value::Array(items) => {
+            items.len().hash(hasher);
+            items.iter().for_each(|item| digest(item, hasher));
+        }
+        Value::Object(map) => {
+            map.len().hash(hasher);
+            for (key, item) in map {
+                key.hash(hasher);
+                digest(item, hasher);
+            }
+        }
+        other => other.to_string().hash(hasher),
+    }
+}
+
+struct Job {
+    key: u64,
+    instance: (String, String),
+    input: Value,
+    cleared: u64,
+    context: u64,
+    background: bool,
+}
+
+#[derive(Default)]
+struct Engine {
+    done: HashMap<u64, Option<Rendered>>,
+    latest: HashMap<(String, String), Option<Rendered>>,
+    generations: HashMap<(String, String), u64>,
+    generation: u64,
+    asked: HashMap<(String, String), (u64, Value, u64)>,
+    asks: u64,
+    frame_from: u64,
+    drawn_from: u64,
+    pending: VecDeque<Job>,
+    running: bool,
+    revision: Option<(u64, u64)>,
+    cleared: u64,
+    context: u64,
+    #[cfg(test)]
+    changes: usize,
+}
+
+impl Engine {
+    fn remember(
+        &mut self,
+        key: u64,
+        instance: (String, String),
+        rendered: Option<Rendered>,
+        cleared: u64,
+        context: u64,
+    ) -> bool {
+        if self.context != context {
+            return false;
+        }
+        if self.done.len() >= DONE_LIMIT {
+            self.done.clear();
+        }
+        if self.latest.len() >= DONE_LIMIT {
+            self.latest.clear();
+            self.generations.clear();
+        }
+        if self.cleared == cleared {
+            self.done.insert(key, rendered.clone());
+        }
+        let changed = self
+            .latest
+            .insert(instance.clone(), rendered.clone())
+            .flatten()
+            != rendered;
+        if changed {
+            self.generation += 1;
+            self.generations.insert(instance, self.generation);
+        }
+        changed
+    }
+
+    fn ask(&mut self, key: u64, instance: &(String, String), input: &Value) {
+        if self.asked.len() >= DONE_LIMIT {
+            self.asked.clear();
+        }
+        self.asks += 1;
+        self.asked
+            .insert(instance.clone(), (key, input.clone(), self.asks));
+    }
+
+    fn reasked(&mut self, key: u64, instance: &(String, String)) {
+        self.asks += 1;
+        if let Some(asked) = self.asked.get_mut(instance).filter(|asked| asked.0 == key) {
+            asked.2 = self.asks;
+        }
+    }
+
+    fn queue(&mut self, job: Job) -> bool {
+        self.pending
+            .retain(|queued| queued.instance != job.instance);
+        if self.pending.len() >= PENDING_LIMIT {
+            self.pending.pop_front();
+        }
+        self.pending.push_back(job);
+        let start = !self.running;
+        self.running = true;
+        start
+    }
+}
+
+crate::omd::isolated_static! { ENGINE: Mutex<Option<Engine>> = Mutex::new(None) }
+crate::omd::isolated_static! { HOOKED: AtomicBool = AtomicBool::new(false) }
+crate::omd::isolated_static! { FULLSCREEN: AtomicBool = AtomicBool::new(false) }
+crate::omd::isolated_static! { COLUMNS: AtomicU16 = AtomicU16::new(0) }
+crate::omd::isolated_static! { ROWS: AtomicU16 = AtomicU16::new(0) }
+crate::omd::isolated_static! { EPOCH: AtomicU64 = AtomicU64::new(0) }
+crate::omd::isolated_static! { LIVE_EPOCH: AtomicU64 = AtomicU64::new(0) }
+crate::omd::isolated_static! { FRAMES: Mutex<Option<crate::tui::FrameRequester>> = Mutex::new(None) }
+crate::omd::isolated_static! { TOOL_NOTICES: Mutex<VecDeque<ToolNotice>> = Mutex::new(VecDeque::new()) }
+crate::omd::isolated_static! { DRAWN_CALLS: Mutex<std::collections::BTreeSet<String>> =
+Mutex::new(std::collections::BTreeSet::new()) }
+crate::omd::isolated_static! { REFRESHES: AtomicU64 = AtomicU64::new(0) }
+
+struct ToolNotice {
+    call_id: String,
+    kind: &'static str,
+    text: String,
+    owner: String,
+}
+
+pub(crate) fn clear_tool_notices() {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            EPOCH.with(|epoch_state| {
+                drawn_calls_state.locked().clear();
+                tool_notices_state.locked().clear();
+                epoch_state.fetch_add(1, Ordering::Relaxed);
+            })
+        })
+    })
+}
+
+/// Attaches a mod notice beneath the drawn transcript cell of one tool call; false, storing nothing, when no drawn cell claims the call.
+pub(crate) fn tool_notice(call_id: &str, kind: &str, text: &str, owner: &str) -> bool {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            EPOCH.with(|epoch_state| {
+                if !drawn_calls_state.locked().contains(call_id) {
+                    return false;
+                }
+                let mut notices = tool_notices_state.locked();
+                if notices.len() >= 256 {
+                    notices.pop_front();
+                }
+                notices.push_back(ToolNotice {
+                    call_id: call_id.to_owned(),
+                    kind: crate::history_cell::notice_kind(kind),
+                    text: text.to_owned(),
+                    owner: owner.to_owned(),
+                });
+                epoch_state.fetch_add(1, Ordering::Relaxed);
+                schedule_frame(Duration::ZERO);
+                true
+            })
+        })
+    })
+}
+
+pub(crate) fn tool_notice_lines(target: &RenderTarget) -> Vec<HyperlinkLine> {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            let calls = target.props["calls"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|call| call["call_id"].as_str())
+                .chain([target.id.as_str()])
+                .chain(target.props["call_id"].as_str())
+                .collect::<Vec<_>>();
+            if target.component.starts_with("tool_") {
+                let mut drawn = drawn_calls_state.locked();
+                if drawn.len() >= DONE_LIMIT {
+                    drawn.clear();
+                }
+                drawn.extend(calls.iter().map(|call| (*call).to_owned()));
+            }
+            let notices = tool_notices_state.locked();
+            if notices.is_empty() {
+                return Vec::new();
+            }
+            notices
+                .iter()
+                .filter(|notice| calls.contains(&notice.call_id.as_str()))
+                .map(|notice| {
+                    let mut spans = vec![crate::mod_ui::glyph("  ↳ ", "  -> ").dim()];
+                    spans.extend(crate::history_cell::notice_spans(notice.kind, &notice.text));
+                    spans.push(format!(" ({})", notice.owner).dark_gray());
+                    HyperlinkLine {
+                        line: Line::from(spans),
+                        ..HyperlinkLine::default()
+                    }
+                })
+                .collect()
+        })
+    })
+}
+
+type Instance = (String, String);
+type Answers = Vec<(Instance, u64)>;
+
+thread_local! {
+    static WAITING: Cell<bool> = const { Cell::new(false) };
+    static TRACKED: std::cell::RefCell<Option<Option<Answers>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// The hook answers one layout drew from, so a cache keeps it until one of them changes or a view refresh asks them again.
+#[derive(Clone, Default)]
+pub(crate) struct Stamp(Option<(u64, Answers)>);
+
+impl Stamp {
+    pub(crate) fn is_current(&self) -> bool {
+        let Some((refreshes, answers)) = &self.0 else {
+            return true;
+        };
+        *refreshes == REFRESHES.with(|state| state.load(Ordering::Relaxed))
+            && (answers.is_empty()
+                || engine(|engine| {
+                    answers.iter().all(|(instance, generation)| {
+                        engine
+                            .generations
+                            .get(instance)
+                            .copied()
+                            .unwrap_or_default()
+                            == *generation
+                    })
+                }))
+    }
+}
+
+pub(crate) fn track<T>(run: impl FnOnce() -> T) -> (T, Stamp) {
+    let refreshes = REFRESHES.with(|state| state.load(Ordering::Relaxed));
+    let outer = TRACKED.with(|tracked| tracked.replace(Some(None)));
+    let value = run();
+    let answers = TRACKED.with(|tracked| tracked.replace(outer)).flatten();
+    if let Some(answers) = &answers {
+        touch();
+        answers.iter().for_each(|(instance, _)| record(instance));
+    }
+    (value, Stamp(answers.map(|answers| (refreshes, answers))))
+}
+
+fn record(instance: &Instance) {
+    TRACKED.with(|tracked| {
+        if let Some(answers) = tracked.borrow_mut().as_mut() {
+            let generation =
+                engine(|engine| engine.generations.get(instance).copied()).unwrap_or_default();
+            answers
+                .get_or_insert_default()
+                .push((instance.clone(), generation));
+        }
+    });
+}
+
+fn touch() {
+    TRACKED.with(|tracked| {
+        if let Some(answers) = tracked.borrow_mut().as_mut() {
+            answers.get_or_insert_default();
+        }
+    });
+}
+
+fn engine<T>(run: impl FnOnce(&mut Engine) -> T) -> T {
+    ENGINE.with(|engine_state| {
+        let mut engine = engine_state.locked();
+        run(engine.get_or_insert_with(Engine::default))
+    })
+}
+
+pub(crate) fn set_frames(frames: crate::tui::FrameRequester) {
+    FRAMES.with(|frames_state| {
+        *frames_state.locked() = Some(frames);
+    })
+}
+
+pub(crate) fn set_surface(fullscreen: bool, columns: u16, rows: u16) {
+    ROWS.with(|rows_state| {
+        COLUMNS.with(|columns_state| {
+            FULLSCREEN.with(|fullscreen_state| {
+                fullscreen_state.store(fullscreen, Ordering::Relaxed);
+                columns_state.store(columns, Ordering::Relaxed);
+                rows_state.store(rows, Ordering::Relaxed);
+            })
+        })
+    });
+    frame_started();
+}
+
+fn frame_started() {
+    engine(|engine| {
+        engine.drawn_from = engine.frame_from;
+        engine.frame_from = engine.asks;
+        let drawn_from = engine.drawn_from;
+        engine.asked.retain(|_, (_, _, ask)| *ask > drawn_from);
+    });
+}
+
+/// Screen columns, for hooked components laid out before their final width is known.
+pub(crate) fn columns() -> u16 {
+    COLUMNS.with(
+        |columns_state| match columns_state.load(Ordering::Relaxed) {
+            0 => 80,
+            columns => columns,
+        },
+    )
+}
+
+pub(crate) fn enabled() -> bool {
+    HOOKED.with(|hooked_state| hooked_state.load(Ordering::Relaxed))
+}
+
+/// Changes whenever a tool notice changes what a retained layout drew.
+pub(crate) fn epoch() -> u64 {
+    EPOCH.with(|epoch_state| epoch_state.load(Ordering::Relaxed))
+}
+
+/// Advances whenever a hook answer changes, so layouts cached for the live cell redraw.
+pub(crate) fn live_epoch() -> u64 {
+    LIVE_EPOCH.with(|live_epoch_state| live_epoch_state.load(Ordering::Relaxed))
+}
+
+/// A new view revision may follow a state change, so finished renders are asked again; each instance's last tree stands until its answer arrives.
+pub(crate) fn refresh(revision: (u64, u64)) {
+    LIVE_EPOCH.with(|live_epoch_state| {
+        HOOKED.with(|hooked_state| {
+            let changed = engine(|engine| {
+                let changed = engine.revision != Some(revision);
+                engine.revision = Some(revision);
+                changed
+            });
+            if !changed {
+                return;
+            }
+            crate::mod_module::refresh();
+            match crate::mod_runtime::render_hooked() {
+                Some(hooked) => {
+                    forget();
+                    hooked_state.store(hooked, Ordering::Relaxed);
+                    REFRESHES.with(|state| state.fetch_add(1, Ordering::Relaxed));
+                    live_epoch_state.fetch_add(1, Ordering::Relaxed);
+                }
+                // A busy runtime leaves the flag and finished renders as they were and asks again next frame; forgetting them now would only queue renders needing the same busy runtime.
+                None => engine(|engine| engine.revision = None),
+            }
+        })
+    })
+}
+
+/// Ids of the components the latest hook trees draw, whose images and documents must outlive a view sync.
+pub(crate) fn component_ids() -> std::collections::BTreeSet<String> {
+    engine(|engine| {
+        engine
+            .latest
+            .values()
+            .flatten()
+            .flat_map(|rendered| codex_omd::component_ids_of(&rendered.tree))
+            .collect()
+    })
+}
+
+/// State a TUI-side callback wrote may change what hooks draw, so finished renders are asked again.
+pub(crate) fn forget() {
+    engine(|engine| {
+        engine.done.clear();
+        engine.cleared += 1;
+    });
+}
+
+/// State only hooks read may change under an identical view, so the instances asked since the previous frame began are asked again off-frame.
+pub(crate) fn reask() {
+    if !enabled() {
+        return;
+    }
+    let start = engine(|engine| {
+        let cleared = engine.cleared;
+        let mut recent = engine
+            .asked
+            .iter()
+            .map(|(instance, (key, input, ask))| {
+                let job = Job {
+                    key: *key,
+                    instance: instance.clone(),
+                    input: input.clone(),
+                    cleared,
+                    context: engine.context,
+                    background: true,
+                };
+                (*ask, job)
+            })
+            .collect::<Vec<_>>();
+        recent.sort_unstable_by_key(|(ask, _)| std::cmp::Reverse(*ask));
+        recent.truncate(PENDING_LIMIT);
+        let mut start = false;
+        for (_, job) in recent.into_iter().rev() {
+            start |= engine.queue(job);
+        }
+        start
+    });
+    if start {
+        spawn_work();
+    }
+}
+
+fn spawn_work() {
+    #[cfg(test)]
+    let work = inherit_test_state(crate::mod_runtime::inherit_test_context(work));
+    std::thread::spawn(work);
+}
+
+/// Cells asked for another context never draw again.
+pub(crate) fn clear_asked() {
+    engine(|engine| {
+        engine.asked.clear();
+        engine.done.clear();
+        engine.latest.clear();
+        engine.generations.clear();
+        engine.pending.clear();
+        engine.revision = None;
+        engine.cleared += 1;
+        engine.context += 1;
+    });
+    REFRESHES.with(|state| state.fetch_add(1, Ordering::Relaxed));
+}
+
+/// Lets a test drive a fresh render engine with its own frames, restoring the previous ones after.
+#[cfg(test)]
+pub(crate) fn test_engine(frames: crate::tui::FrameRequester) -> impl Drop {
+    struct Restore(bool, Option<Engine>, Option<crate::tui::FrameRequester>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            HOOKED.with(|hooked| hooked.store(self.0, Ordering::Relaxed));
+            ENGINE.with(|engine| *engine.locked() = self.1.take());
+            FRAMES.with(|stored| *stored.locked() = self.2.take());
+        }
+    }
+    Restore(
+        HOOKED.with(|hooked| hooked.swap(true, Ordering::Relaxed)),
+        ENGINE.with(|engine| engine.locked().take()),
+        FRAMES.with(|stored| stored.locked().replace(frames)),
+    )
+}
