+        assert_eq!(serde_json::to_value(typed).unwrap(), package);
+    }
+}
diff --git a/codex-rs/app-server-transport/src/transport/websocket_tests.rs b/codex-rs/app-server-transport/src/transport/websocket_tests.rs
