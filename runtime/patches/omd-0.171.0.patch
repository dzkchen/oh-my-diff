--- /dev/null
+++ b/codex-rs/core/src/session/prompt_expansion_tests.rs
@@ -0,0 +1,183 @@
+use super::prompt_expansion_items;
+use codex_protocol::user_input::TextElement;
+use codex_protocol::user_input::UserInput;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+fn skill(index: usize) -> UserInput {
+    UserInput::Skill {
+        name: format!("skill-{index}"),
+        path: PathBuf::from(index.to_string()),
+    }
+}
+
+#[tokio::test]
+async fn prompt_expansion_reads_overlap_with_a_bound_and_preserve_order() {
+    let input = (0..6).map(skill).collect::<Vec<_>>();
+    let gates = (0..6)
+        .map(|_| tokio::sync::Semaphore::new(0))
+        .collect::<Vec<_>>();
+    let (started, mut starts) = tokio::sync::mpsc::unbounded_channel();
+    let mut expansion = Box::pin(prompt_expansion_items(&input, |path| {
+        let index: usize = path.to_str().unwrap().parse().unwrap();
+        let gate = &gates[index];
+        let started = &started;
+        async move {
+            started.send(index).unwrap();
+            gate.acquire().await.unwrap().forget();
+            Ok(index.to_string().into_bytes())
+        }
+    }));
+    assert!(futures::poll!(expansion.as_mut()).is_pending());
+    for index in 0..4 {
+        assert_eq!(starts.try_recv().unwrap(), index);
+    }
+    assert!(starts.try_recv().is_err());
+    for index in (1..4).rev() {
+        gates[index].add_permits(1);
+        assert!(futures::poll!(expansion.as_mut()).is_pending());
+    }
+    assert!(starts.try_recv().is_err());
+    gates[0].add_permits(1);
+    assert!(futures::poll!(expansion.as_mut()).is_pending());
+    assert_eq!(starts.try_recv().unwrap(), 4);
+    assert_eq!(starts.try_recv().unwrap(), 5);
+    assert!(starts.try_recv().is_err());
+    gates[5].add_permits(1);
+    assert!(futures::poll!(expansion.as_mut()).is_pending());
+    gates[4].add_permits(1);
+    let items = expansion.await;
+    assert_eq!(items.len(), 6);
+    for (index, item) in items.iter().enumerate() {
+        assert_eq!(item["name"], format!("skill-{index}"));
+        assert_eq!(item["source"], index.to_string());
+    }
+}
+
+#[tokio::test]
+async fn prompt_expansion_preserves_mixed_metadata_and_read_errors() {
+    let input = vec![
+        skill(0),
+        UserInput::Mention {
+            name: "docs".into(),
+            path: "plugin://docs".into(),
+        },
+        UserInput::Text {
+            text: "abcé[Image]".into(),
+            text_elements: vec![
+                TextElement::new((0..3).into(), None),
+                TextElement::new((3..4).into(), None),
+                TextElement::new((5..12).into(), None),
+                TextElement::new((50..60).into(), None),
+            ],
+        },
+        UserInput::LocalImage {
+            path: PathBuf::from("picture.png"),
+            detail: None,
+        },
+        UserInput::LocalAudio {
+            path: PathBuf::from("audio.wav"),
+        },
+        skill(1),
+        skill(0),
+    ];
+    let reads = Mutex::new(Vec::new());
+    let items = prompt_expansion_items(&input, |path| {
+        reads.lock().unwrap().push(path.clone());
+        std::future::ready(if path == std::path::Path::new("1") {
+            Err(std::io::Error::from(std::io::ErrorKind::NotFound))
+        } else {
+            Ok(b"abc".to_vec())
+        })
+    })
+    .await;
+    let abc = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+    let empty = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
+    assert_eq!(
+        items,
+        vec![
+            json!({"kind": "skill", "name": "skill-0", "source": "0", "sha256": abc}),
+            json!({"kind": "mention", "name": "docs", "source": "plugin://docs"}),
+            json!({"kind": "paste", "start": 0, "end": 3, "bytes": 3, "sha256": abc}),
+            json!({"kind": "image", "start": 5, "end": 12, "bytes": 7,
+                "sha256": "dfb293375a25989e87b1df7d6175aaac91af34bc16b83c0dc790eef8dffd6d35"}),
+            json!({"kind": "image", "source": "picture.png"}),
+            json!({"kind": "skill", "name": "skill-1", "source": "1", "sha256": empty}),
+            json!({"kind": "skill", "name": "skill-0", "source": "0", "sha256": abc}),
+        ]
+    );
+    assert_eq!(
+        *reads.lock().unwrap(),
+        vec![PathBuf::from("0"), PathBuf::from("1"), PathBuf::from("0")]
+    );
+}
+
+type PromptObservations = Arc<Mutex<Vec<(usize, Vec<serde_json::Value>)>>>;
+
+struct PromptObserver {
+    ordinal: usize,
+    observed: PromptObservations,
+}
+
+impl codex_extension_api::TurnLifecycleContributor for PromptObserver {
+    fn on_prompt_expanded<'a>(
+        &'a self,
+        input: codex_extension_api::PromptExpandedInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            if self.ordinal == 0 {
+                tokio::task::yield_now().await;
+            }
+            self.observed
+                .lock()
+                .unwrap()
+                .push((self.ordinal, input.items.to_vec()));
+        })
+    }
+}
+
+#[tokio::test]
+async fn prompt_expansion_notifies_contributors_in_order_with_complete_items() {
+    let (mut session, turn) = super::tests::make_session_and_context().await;
+    let observed = Arc::new(Mutex::new(Vec::new()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    for ordinal in 0..2 {
+        extensions.turn_lifecycle_contributor(Arc::new(PromptObserver {
+            ordinal,
+            observed: Arc::clone(&observed),
+        }));
+    }
+    session.services.extensions = Arc::new(extensions.build());
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("SKILL.md");
+    tokio::fs::write(&path, b"abc").await.unwrap();
+    session.notify_prompt_expanded(&turn, &[]).await;
+    assert!(observed.lock().unwrap().is_empty());
+    session
+        .notify_prompt_expanded(
+            &turn,
+            &[
+                UserInput::Skill {
+                    name: "example".into(),
+                    path: path.clone(),
+                },
+                UserInput::Mention {
+                    name: "docs".into(),
+                    path: "plugin://docs".into(),
+                },
+            ],
+        )
+        .await;
+    let expected = vec![
+        json!({"kind": "skill", "name": "example", "source": path.display().to_string(),
+            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}),
+        json!({"kind": "mention", "name": "docs", "source": "plugin://docs"}),
+    ];
+    assert_eq!(
+        *observed.lock().unwrap(),
+        vec![(0, expected.clone()), (1, expected)]
+    );
+}
diff --git a/codex-rs/core/src/tools/approval_gate.rs b/codex-rs/core/src/tools/approval_gate.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef1e2065a4b5ce9eeaa9f331c642bed590e64eab
--- /dev/null
+++ b/codex-rs/core/src/tools/approval_gate.rs
@@ -0,0 +1,263 @@
+use std::sync::Arc;
+
+use codex_extension_api::ApprovalGate;
+use codex_extension_api::ApprovalGateInput;
+use codex_extension_api::ApprovalResultInput;
+use codex_protocol::protocol::ReviewDecision;
+
+use crate::guardian::GuardianReviewContext;
+use crate::session::session::Session;
+use crate::tools::approvals::ApprovalAction;
+use crate::tools::approvals::ApprovalContext;
+use crate::tools::approvals::ApprovalResolutionSource;
+use crate::tools::sandboxing::ExecApprovalRequirement;
+use crate::tools::sandboxing::ToolCtx;
+use crate::tools::sandboxing::ToolError;
+
+const DETAIL_BYTES: usize = 64 * 1024;
+
+pub(crate) fn kind(action: &ApprovalAction) -> &'static str {
+    match action {
+        ApprovalAction::ExecCommand { .. } => "exec",
+        ApprovalAction::WriteStdin { .. } => "stdin",
+        ApprovalAction::ApplyPatch { .. } => "patch",
+        ApprovalAction::McpToolCall { .. } => "mcp_tool",
+        ApprovalAction::NetworkAccess { .. } => "network",
+        ApprovalAction::RequestPermissions { .. } => "permissions",
+    }
+}
+
+fn details(action: &ApprovalAction) -> serde_json::Value {
+    let mut value = serde_json::to_value(action).unwrap_or(serde_json::Value::Null);
+    if value.to_string().len() > DETAIL_BYTES
+        && let Some(object) = value.as_object_mut()
+    {
+        for field in ["patch", "arguments", "input", "tool_description"] {
+            object.remove(field);
+        }
+        object.insert("truncated".into(), serde_json::Value::Bool(true));
+    }
+    value
+}
+
+pub(crate) fn decision_name(decision: &ReviewDecision) -> &'static str {
+    match decision {
+        ReviewDecision::Approved => "approved",
+        ReviewDecision::ApprovedForSession => "approved_for_session",
+        ReviewDecision::ApprovedExecpolicyAmendment { .. }
+        | ReviewDecision::ApprovedMcpPolicyAmendment
+        | ReviewDecision::NetworkPolicyAmendment { .. } => "amended",
+        ReviewDecision::Denied { .. } => "denied",
+        ReviewDecision::TimedOut => "timed_out",
+        ReviewDecision::Abort => "aborted",
+    }
+}
+
+pub(crate) async fn gate(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    host_decision: &str,
+) -> ApprovalGate {
+    gate_with(
+        session,
+        action,
+        ctx,
+        host_decision,
+        /*assessment*/ false,
+    )
+    .await
+}
+
+pub(crate) async fn gate_with(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    host_decision: &str,
+    assessment: bool,
+) -> ApprovalGate {
+    let contributors = session.services.extensions.approval_gate_contributors();
+    if contributors.is_empty() {
+        return ApprovalGate::Continue;
+    }
+    let turn = ctx.review_context.turn();
+    let policy = turn.approval_policy().to_string();
+    let details = details(action);
+    let mut ask = None;
+    let mut approve = None;
+    for contributor in contributors {
+        match contributor
+            .gate_approval(ApprovalGateInput {
+                turn_store: turn.extension_data.as_ref(),
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                turn_id: Some(turn.sub_id.as_str()),
+                kind: kind(action),
+                host_decision,
+                policy: &policy,
+                details: details.clone(),
+                assessment,
+            })
+            .await
+        {
+            ApprovalGate::Continue => {}
+            ApprovalGate::Deny(reason) => return ApprovalGate::Deny(reason),
+            ApprovalGate::Ask(reason) => {
+                ask.get_or_insert(reason);
+            }
+            ApprovalGate::Approve(reason) => {
+                approve.get_or_insert(reason);
+            }
+        }
+    }
+    match (ask, approve) {
+        (Some(reason), _) => ApprovalGate::Ask(reason),
+        (None, Some(reason)) => ApprovalGate::Approve(reason),
+        (None, None) => ApprovalGate::Continue,
+    }
+}
+
+pub(crate) async fn approved_by_extension(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    reason: String,
+) {
+    session
+        .send_event(
+            ctx.review_context.turn(),
+            codex_protocol::protocol::EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                message: reason,
+            }),
+        )
+        .await;
+    report(session, kind(action), ctx, "approved", "mod").await;
+}
+
+pub(crate) async fn report(
+    session: &Arc<Session>,
+    kind: &str,
+    ctx: &ApprovalContext,
+    decision: &str,
+    source: &str,
+) {
+    for contributor in session.services.extensions.approval_gate_contributors() {
+        contributor
+            .on_approval_result(ApprovalResultInput {
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                kind,
+                decision,
+                source,
+            })
+            .await;
+    }
+}
+
+fn context(
+    tool_ctx: &ToolCtx,
+    exec_requirement: Option<ExecApprovalRequirement>,
+    strict_auto_review: bool,
+    approval_reason: Option<String>,
+) -> ApprovalContext {
+    ApprovalContext {
+        exec_requirement,
+        review_context: GuardianReviewContext::from(&tool_ctx.step_context),
+        cancellation_token: Some(tool_ctx.cancellation_token.clone()),
+        call_id: tool_ctx.call_id.clone(),
+        tool_name: tool_ctx.tool_name.clone(),
+        strict_auto_review,
+        approval_reason,
+        retry_reason: None,
+        network_approval_context: None,
+    }
+}
+
+/// Gates a call that needs no approval; the approval's source when a gate asked and the user approved it.
+pub(crate) async fn on_skip(
+    tool_ctx: &ToolCtx,
+    action: impl FnOnce() -> Option<ApprovalAction>,
+    strict_auto_review: bool,
+) -> Result<Option<ApprovalResolutionSource>, ToolError> {
+    let session = &tool_ctx.session;
+    if session
+        .services
+        .extensions
+        .approval_gate_contributors()
+        .is_empty()
+    {
+        return Ok(None);
+    }
+    let Some(action) = action() else {
+        return Ok(None);
+    };
+    let mut approval_ctx = context(tool_ctx, None, strict_auto_review, None);
+    match gate(session, &action, &approval_ctx, "skip").await {
+        ApprovalGate::Continue | ApprovalGate::Approve(_) => Ok(None),
+        ApprovalGate::Deny(reason) => {
+            report(session, kind(&action), &approval_ctx, "denied", "mod").await;
+            Err(ToolError::Rejected(reason))
+        }
+        ApprovalGate::Ask(reason) => {
+            approval_ctx.approval_reason = Some(reason);
+            let approval = session.resolve_approval(action, approval_ctx, true).await;
+            approval.result?;
+            Ok(approval.source.or(Some(ApprovalResolutionSource::User)))
+        }
+    }
+}
+
+/// Lets a gate approve a command that only the user's own exec-policy rules forbid.
+pub(crate) async fn override_forbidden(
+    tool_ctx: &ToolCtx,
+    action: impl FnOnce() -> Option<ApprovalAction>,
+    reason: &str,
+    strict_auto_review: bool,
+) -> Result<(), ToolError> {
+    let session = &tool_ctx.session;
+    let rejected = || ToolError::Rejected(reason.to_owned());
+    if session
+        .services
+        .extensions
+        .approval_gate_contributors()
+        .is_empty()
+    {
+        return Err(rejected());
+    }
+    let approval_ctx = context(
+        tool_ctx,
+        Some(ExecApprovalRequirement::Forbidden {
+            reason: reason.to_owned(),
+        }),
+        strict_auto_review,
+        Some(reason.to_owned()),
+    );
+    let action = action()
+        .filter(|action| match action {
+            ApprovalAction::ExecCommand {
+                command,
+                environment_id,
+                ..
+            } => {
+                let environments = approval_ctx.review_context.environments();
+                let environment_policy = environments
+                    .turn_environments()
+                    .find(|environment| environment.selection.environment_id == *environment_id)
+                    .and_then(|environment| environment.config().exec_policy.as_ref());
+                session
+                    .services
+                    .exec_policy
+                    .forbidden_only_by_user_rules(command, environment_policy)
+            }
+            _ => false,
+        })
+        .ok_or_else(rejected)?;
+    match gate(session, &action, &approval_ctx, "forbidden").await {
+        ApprovalGate::Approve(approval) => {
+            approved_by_extension(session, &action, &approval_ctx, approval).await;
+            Ok(())
+        }
+        _ => Err(rejected()),
+    }
+}
diff --git a/codex-rs/core/src/tools/batch.rs b/codex-rs/core/src/tools/batch.rs
