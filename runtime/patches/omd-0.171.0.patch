+                            ParsedCommand::Read { .. }
+                                | ParsedCommand::ListFiles { .. }
+                                | ParsedCommand::Search { .. }
+                        )
+                    }));
+        let props = if exploring {
+            let status = if running {
+                "running"
+            } else if calls.iter().any(|item| status(item) == "failed") {
+                "failed"
+            } else if calls.iter().any(|item| status(item) == "interrupted") {
+                "interrupted"
