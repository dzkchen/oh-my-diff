+    fn upgrade(&self) -> Option<Lead> {
+        Some(Lead {
+            host: self.host.clone(),
+            session: self.session.upgrade()?,
+            thread: self.thread,
+            owner: "lead".into(),
+            depth: 0,
+            permission_profile: self.permission_profile.clone(),
+        })
