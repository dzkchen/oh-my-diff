+#[test]
+#[serial_test::serial]
+fn split_gaps_leave_cells_between_children_and_their_handle() {
+    let layout = layout(
+        serde_json::json!({"split": "horizontal", "gap": 2, "children": [
+        {"content": "site:files/tree", "style": {"border": "thick"}}, {"content": "transcript"}]}),
+    );
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.regions[0],
+        Region {
+            path: "r.0".into(),
+            content: "site:files/tree".into(),
+            area: Rect::new(0, 0, 20, 10),
+            style: Some(codex_omd::ModBoxStyle {
+                border: Some(codex_omd::ModBoxBorder::Thick),
+                ..Default::default()
+            }),
+            title: None,
+            tabs: None,
+        }
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(22, 0, 20, 10)));
+    let narrow = place(&layout, None, Rect::new(0, 0, 7, 10));
+    assert_eq!(narrow.area("transcript"), Some(Rect::new(4, 0, 3, 10)));
+    place(&layout, None, Rect::new(0, 0, 42, 10));
+    let at = |kind, column| MouseEvent {
+        kind,
+        column,
+        row: 4,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(at(MouseEventKind::Down(MouseButton::Left), 21)));
+    assert!(pointer(at(MouseEventKind::Drag(MouseButton::Left), 30)));
+    assert!(pointer(at(MouseEventKind::Up(MouseButton::Left), 30)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 0, 30, 10))
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+    hide();
+    assert!(!pointer(at(MouseEventKind::Down(MouseButton::Left), 31)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+}
+
+fn dock_layout() -> ModLayout {
+    layout(serde_json::json!({
+        "split": "horizontal",
+        "children": [
+            {"split": "vertical", "children": [{"content": "site:a/one"}, {"content": "site:a/two"}]},
+            {"split": "vertical", "children": [{"content": "transcript"}, {"content": "composer"}]}
+        ]
+    }))
+}
+
+fn mouse(kind: MouseEventKind, (column, row): (u16, u16)) -> MouseEvent {
+    MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    }
+}
+
+fn dock_drag(from: (u16, u16), to: (u16, u16)) {
+    assert!(!pointer(mouse(
+        MouseEventKind::Down(MouseButton::Left),
+        from
+    )));
+    pointer(mouse(MouseEventKind::Drag(MouseButton::Left), to));
+    pointer(mouse(MouseEventKind::Up(MouseButton::Left), to));
+}
+
+#[test]
+#[serial_test::serial]
+fn dock_drags_shade_edges_and_centre_of_a_site_and_only_edges_of_the_chat() {
+    place(&dock_layout(), Some("owner"), Rect::new(0, 0, 100, 40));
+    let hover = |at| {
+        assert!(!pointer(mouse(
+            MouseEventKind::Down(MouseButton::Left),
+            (10, 0)
+        )));
+        assert!(pointer(mouse(MouseEventKind::Drag(MouseButton::Left), at)));
+        let shade = dock_preview();
+        assert!(pointer(mouse(MouseEventKind::Up(MouseButton::Left), at)));
+        assert_eq!(dock_preview(), None);
+        shade
+    };
+    for (at, shade) in [
+        ((1, 30), Some(Rect::new(0, 20, 25, 20))),
+        ((48, 30), Some(Rect::new(25, 20, 25, 20))),
