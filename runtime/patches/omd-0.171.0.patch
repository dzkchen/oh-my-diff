+#[test]
+fn exploration_groups_split_at_render_call_limit() {
+    let mut group = completed_read("0", "ok");
+    for i in 1..32 {
+        group
+            .append_completed(completed_read(&i.to_string(), "ok"))
+            .unwrap();
+    }
+    let mut failed = completed_read("32", "failed");
+    failed.group.calls[0].output = Some(CommandOutput::new(1, "failed".into()));
+    let failed = group
+        .append_completed(failed)
+        .expect_err("must keep the 33rd call visible");
+    assert_eq!(failed.render_target().unwrap().props["status"], "failed");
+    assert_eq!(
+        group.render_target().unwrap().props["calls"]
+            .as_array()
+            .unwrap()
+            .len(),
+        32
+    );
+    assert_ne!(
+        group.render_target().unwrap().id,
+        group.render_members(80)[0].target.id
+    );
+    let command = vec!["cat".into(), "next".into()];
+    let parsed = codex_shell_command::parse_command::parse_command(&command);
+    assert!(!group.add_call(
+        "next".into(),
+        command,
+        parsed,
+        CommandExecutionSource::UnifiedExecStartup,
+        None
+    ));
+}
