+    };
+    let opened = screen(&view);
+    assert!(opened.contains("▾ On (2)") && opened.contains("Language servers card"));
+    press(&mut view, KeyCode::Char('u'));
+    assert_eq!(selected(&view), "usage");
+    press(&mut view, KeyCode::Char('g'));
