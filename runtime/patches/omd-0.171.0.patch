+#[test]
+fn a_wrap_encloses_a_replacement_composed_after_it() {
+    let mut target = ModView::default();
+    let mut claims = BTreeMap::new();
+    for (id, patch) in [
+        (
+            "frame",
+            json!({"sites": {"sidebar": {"mode": "wrap", "components": [{"type": "box", "id": "frame",
+                "label": "Frame", "children": [{"type": "slot"}]}]}}}),
+        ),
