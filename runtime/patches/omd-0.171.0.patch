+struct Admission {
+    task: Arc<Task>,
+    worker: String,
+    transferred: bool,
+}
+
+struct SpawnReservation(Arc<std::sync::atomic::AtomicUsize>);
+
+impl Drop for SpawnReservation {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, std::sync::atomic::Ordering::AcqRel);
+    }
+}
