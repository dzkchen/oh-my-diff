+pub(super) struct AgentClaim<'a> {
+    pub candidate_sha256: &'a str,
+    pub acceptance_sha256: Option<&'a str>,
+    pub resolves: &'a [String],
+    pub evidence: &'a codex_omd::resource_data::ResourceRef,
+}
