+    #[tokio::test]
+    #[serial_test::serial]
+    // The held guard is the point: the sample must not need it on the event loop.
+    #[allow(clippy::await_holding_lock)]
+    async fn image_samples_reply_off_the_event_loop() -> color_eyre::Result<()> {
+        let mut app = crate::app::test_support::make_test_app().await;
+        let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let event_loop = std::thread::current().id();
+        let gate = std::sync::Arc::new(std::sync::Mutex::new(()));
+        let held = gate.lock().unwrap();
+        let check = gate.clone();
+        let (reply, answer) = std::sync::mpsc::sync_channel(1);
+        let mut call = SurfaceCall {
+            terminal_user: false,
+            terminal_owner: None,
+            validity: codex_omd::client_surface::Validity(std::sync::Arc::new(move || {
+                if std::thread::current().id() != event_loop {
+                    drop(check.lock());
+                }
+                true
+            })),
+            caller: codex_omd::broker::HOST_CALLER.into(),
+            operation: "terminal.image_sample".into(),
+            arguments: json!({"resource": null, "columns": 1, "rows": 1}),
+            context: codex_omd::app_routes::InvocationContext::User,
+            remote: false,
+            thread: None,
+            authority: None,
+            confirm: None,
+            reply,
+            lifetime: Default::default(),
+            depth: 0,
+        };
+        crate::mod_surface::bind_test_call(&mut call);
+        app.run_mod_surface_call(&mut tui, &mut server, call, None)
+            .await;
+        assert!(
+            answer.try_recv().is_err(),
+            "the sample must be taken off the event loop"
+        );
+        drop(held);
+        assert_eq!(
+            answer.recv_timeout(std::time::Duration::from_secs(5))?,
+            Err("image_resource_invalid".into())
+        );
+        Ok(())
+    }
