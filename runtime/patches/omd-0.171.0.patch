+                        title: Some(title),
+                        subtitle: Some(message),
+                        items,
+                        on_cancel: Some(Box::new(move |_| {
+                            respond(serde_json::json!({"status":"declined"}))
+                        })),
+                        ..crate::bottom_pane::SelectionViewParams::picker()
