+/// The last cacheable `input[item].content[part]`: for `"system"` the last developer message before the turn's user message, else that user message's context block.
+fn cache_breakpoint(input: &Value, through: &Value) -> Option<(usize, usize)> {
+    let items = input.as_array()?;
+    let user = items
+        .iter()
+        .rposition(|item| item["type"] == "message" && item["role"] == "user")?;
+    match through.as_u64() {
+        Some(block) => {
+            let block = usize::try_from(block).ok()?;
+            (block + 1 < items[user]["content"].as_array()?.len()).then_some((user, block))
+        }
+        None => {
+            let item = items[..user]
+                .iter()
+                .rposition(|item| item["type"] == "message" && item["role"] == "developer")?;
+            let parts = items[item]["content"].as_array()?.len();
+            Some((item, parts.checked_sub(1)?))
+        }
+    }
+}
