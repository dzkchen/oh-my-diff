+#[cfg(test)]
+mod installation_tests {
+    use super::*;
+
+    #[test]
+    fn resolve_program_refuses_programs_the_agent_can_write() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        if crate::git_work_tree(&root).is_some() {
+            return;
+        }
+        let launch = root.join("launch");
+        fs::create_dir(&launch).unwrap();
+        let [outside, planted] = [root.join("tool"), launch.join("tool")];
+        for program in [&outside, &planted] {
+            fs::write(program, "").unwrap();
+        }
+        let resolve = |program: &Path| resolve_program(program.to_str().unwrap(), &launch);
+        assert_eq!(resolve(&planted), None);
+        assert_eq!(resolve(&outside), Some(outside.clone()));
+        fs::create_dir(root.join(".git")).unwrap();
+        assert_eq!(resolve(&outside), None);
+    }
+
+    #[test]
+    fn unrestricted_commands_pass_the_ssh_agent_and_declared_names_only() {
+        let access = crate::ModOsAccess {
+            programs: vec!["env".to_owned()],
+            network: true,
+        };
+        let command = unrestricted_command_from(
+            &access,
+            Path::new("/usr/bin/env"),
+            &["EXTRA".to_owned()],
+            |name| {
+                matches!(name, "PATH" | "SSH_AUTH_SOCK" | "EXTRA" | "OPENAI_API_KEY")
+                    .then(|| format!("/{name}").into())
+            },
+        )
+        .unwrap();
+        let environment = command
+            .get_envs()
+            .map(|(name, value)| (name.to_owned(), value.map(ToOwned::to_owned)))
+            .collect::<BTreeMap<_, _>>();
+        assert_eq!(
+            environment,
+            ["EXTRA", "PATH", "SSH_AUTH_SOCK"]
+                .map(|name| (name.into(), Some(format!("/{name}").into())))
+                .into()
+        );
+    }
+
+    #[test]
+    fn singleton_rejects_replacement_and_stale_teardown() {
+        let dispatcher = || {
+            Arc::new(
+                |_: Option<&str>,
+                 _: &str,
+                 _: &str,
+                 _: Option<&str>,
+                 _: Option<&Value>,
+                 _: crate::ModHostCall,
+                 _: &dyn Fn() -> bool| Ok(Value::Null),
+            ) as SessionDispatcher
+        };
+        let pending = reserve_session_dispatcher().unwrap();
+        assert!(install_session_dispatcher(dispatcher()).is_err());
+        drop(pending);
+        let first = install_session_dispatcher(dispatcher()).unwrap();
+        assert!(
+            matches!(install_session_dispatcher(dispatcher()), Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists)
+        );
+        let stale = SessionRegistration(first.0.clone());
+        drop(first);
+        let second = install_session_dispatcher(dispatcher()).unwrap();
+        assert!(stale.install(dispatcher()).is_err());
+        drop(stale);
+        assert!(install_session_dispatcher(dispatcher()).is_err());
+        drop(second);
+        assert!(install_session_dispatcher(dispatcher()).is_ok());
+    }
+}
+
+#[cfg(test)]
+mod program_hash_tests {
+    use super::*;
+
+    #[test]
+    fn program_hash_follows_the_file_stamp() {
+        let directory = tempfile::tempdir().unwrap();
+        let program = directory.path().join("program");
+        fs::write(&program, "one").unwrap();
+        let first = program_hash(&program).unwrap();
+        assert_eq!(first, crate::sha256_hex(b"one"));
+        assert_eq!(program_hash(&program).unwrap(), first);
+        fs::write(&program, "three").unwrap();
+        assert_eq!(program_hash(&program).unwrap(), crate::sha256_hex(b"three"));
+    }
+}
