+pub(crate) fn invoke_event_guarded(
+    id: &str,
+    event: &str,
+    payload: Value,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+) -> Option<Result<Value, String>> {
+    invoke_event_with(id, event, payload, current, true)
+}
+
+/// Skips the callback while `current` fails before it starts; once running it finishes, so its runner stays warm.
+pub(crate) fn invoke_event_queued(
+    id: &str,
+    event: &str,
+    payload: Value,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+) -> Option<Result<Value, String>> {
+    invoke_event_with(id, event, payload, current, false)
+}
+
+fn invoke_event_with(
+    id: &str,
+    event: &str,
+    payload: Value,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+    cancel_running: bool,
+) -> Option<Result<Value, String>> {
+    if !current() {
+        return None;
+    }
+    let paths = crate::omd::mod_paths()?;
+    let runtime = shared_host().ok()?;
+    let (generation, grants, before) = {
+        let mut runtime = runtime.locked();
+        if !current() {
+            return None;
+        }
+        reload(&mut runtime);
+        if !runtime.registered(id, event) {
+            return None;
+        }
+        (
+            runtime.generation(),
+            owner_grants(&runtime),
+            (
+                runtime.state(id).cloned(),
+                runtime.configuration_sha256().to_owned(),
+                runtime.ui_revision(id),
+            ),
+        )
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let thread = crate::mod_surface::current_thread();
+    let _thread = codex_omd::StateThread::enter(thread.clone());
+    let (epoch, active) = context_unchanged();
+    let scope = CallScope {
+        terminal_owner: configuration_owner_id(),
+        epoch,
+        context: codex_omd::app_routes::InvocationContext::Event,
+        thread: thread.as_deref(),
+        active: Arc::new(move || active() && (!cancel_running || current())),
+    };
+    let result = codex_omd::invoke_shared(
+        &runtime,
+        id,
+        generation,
+        event,
+        "",
+        payload,
+        codex_omd::ModInvokeOptions {
+            active: scope.active.as_ref(),
+            host: codex_omd::ModHostCallback::Scoped(&mut |caller, call| {
+                crate::mod_surface::host_call(
+                    &paths,
+                    &policy,
+                    grants.get(caller).cloned(),
+                    caller,
+                    call,
+                    &scope,
+                )
+            }),
+            ..codex_omd::ModInvokeOptions::default()
+        },
+    );
+    let context = {
+        let mut runtime = runtime.locked();
+        reload(&mut runtime);
+        let changed = runtime.state(id) != before.0.as_ref()
+            || runtime.configuration_sha256() != before.1
+            || runtime.ui_revision(id) != before.2;
+        active_context().filter(|_| changed && (scope.active)())
+    };
+    if let Some(context) = context {
+        rerender_for(context, scope.active.as_ref());
+    }
+    Some(result.map_err(|error| error.to_string()))
+}
+
+fn publish_for_context(invocation: &ModInvocation, publish: impl FnOnce()) -> bool {
+    ACTIVE_CONTEXT.with(|state| {
+        let active = state.locked();
+        if !active.current(invocation) {
+            return false;
+        }
+        publish();
+        true
+    })
+}
