+#[serial_test::serial]
+fn owner_snapshot_retries_stop_when_the_context_changes() {
+    with_owner_render(|context, _runtime| {
+        let snapshot = serde_json::json!({
+            "epoch": 1,
+            "input": {"event":"idle","client":{"columns":100}},
+            "native_diagnostics": ["new owner update"]
+        });
+        crate::mod_ui::preview(serde_json::from_value(snapshot.clone()).unwrap());
+        let mut next = context.clone();
+        next.thread_id = Some(ThreadId::new());
+        let checks = std::sync::atomic::AtomicUsize::new(0);
+        render_for(context, &|| {
+            let check = checks.fetch_add(1, Ordering::SeqCst);
+            if check > 0 {
+                let mut latest = snapshot.clone();
+                latest["revision"] = check.into();
+                publish_owner_snapshot(decode_owner_snapshot(latest).unwrap());
+            }
+            if check == 32 {
+                synchronize_context(next.clone());
+            }
+            check < 64
+        });
+        let checks = checks.load(Ordering::SeqCst);
+        assert!(
+            checks > 32,
+            "owner snapshots did not keep the render pending"
+        );
+        assert!(
+            checks <= 64,
+            "the old context kept retrying until cancellation"
+        );
+        assert_eq!(active_context(), Some(next));
+        let drawn = crate::mod_ui::shared_snapshot();
+        assert!(
+            drawn.view.title.is_none(),
+            "the old context projected a view"
+        );
+        assert_eq!(drawn.revision, (checks - 1) as u64);
+        assert_eq!(drawn.native_diagnostics, vec!["new owner update"]);
+    });
+}
