+    let (tx, mut rx) = unbounded_channel();
+    let mut view = ModPanelView::new(
+        "demo".into(),
+        ModPanelRequest::parse("demo", &arguments).expect("valid panel"),
+        AppEventSender::new(tx),
+        RuntimeKeymap::defaults().list,
+    );
+    assert_eq!(selected(&view), "lsp");
+    let area = Rect::new(0, 0, 60, view.desired_height(60));
+    let screen = |view: &ModPanelView| {
+        let mut buf = Buffer::empty(area);
+        view.render(area, &mut buf);
+        (0..area.height)
+            .flat_map(|y| (0..area.width).map(move |x| (x, y)))
+            .map(|position| buf[position].symbol().to_owned())
