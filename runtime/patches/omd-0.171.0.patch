+    pub(super) fn thread(&self, thread: ThreadId) -> Option<Lead> {
+        let threads = self.threads.lock().ok()?;
+        let (handle, owner, depth) = threads.get(&thread)?;
+        Some(Lead {
+            owner: owner.clone(),
+            depth: *depth,
+            ..handle.upgrade()?
+        })
+    }
