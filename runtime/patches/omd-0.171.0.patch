+    static EARLY: std::sync::LazyLock<ToolName> =
+        std::sync::LazyLock::new(|| ToolName::plain("early"));
+    static ANSWERED: std::sync::LazyLock<ToolName> =
+        std::sync::LazyLock::new(|| ToolName::plain("answered"));
