+pub(crate) fn take_new_activity() -> Vec<ModActivity> {
+    CACHE.with(|cache_state| {
+        let mut cache = cache_state
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(cache) = cache.as_mut() else {
+            return Vec::new();
+        };
+        if !cache.terminal {
+            return Vec::new();
+        }
+        let epoch = cache.snapshot.epoch;
+        if epoch == 0 {
+            return Vec::new();
+        }
+        let newest = cache
+            .snapshot
+            .activity
+            .iter()
+            .map(|activity| activity.sequence)
+            .max()
+            .unwrap_or_default();
+        let last = match cache.seen.replace((epoch, newest)) {
+            Some((seen, last)) if seen == epoch => last,
+            _ if epoch
+                > ATTACHED.with(|attached| attached.load(std::sync::atomic::Ordering::Relaxed)) =>
+            {
+                0
+            }
+            _ => return Vec::new(),
+        };
+        cache
+            .snapshot
+            .activity
+            .iter()
+            .filter(|activity| activity.sequence > last)
+            .cloned()
+            .collect()
+    })
+}
