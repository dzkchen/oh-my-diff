+pub(crate) fn describe_config(
+    read: &Value,
+    context: &ConfigurationContext,
+) -> Result<Vec<Value>, String> {
+    let _thread = codex_omd::StateThread::enter(context.thread.clone());
+    let rows = codex_omd::client_surface::config_rows(read, &packages(context)?);
+    let result = codex_omd::compose_rows(&context.runtime, "config_list", "rows", "key", rows)
+        .map_err(|error| error.to_string())?;
+    if !configuration_binding_current(context.binding) {
+        return Err("terminal_context_changed".into());
+    }
+    Ok(result)
+}
