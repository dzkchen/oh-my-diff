+#[derive(serde::Deserialize)]
+#[serde(untagged)]
+enum WireCell {
+    Glyph(String),
+    Styled(String, Option<crate::ModColor>, Option<crate::ModColor>),
+}
+
+#[derive(Clone, Copy, Debug, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BlitRect {
+    pub x: u16,
+    pub y: u16,
+    pub width: u16,
+    pub height: u16,
+}
