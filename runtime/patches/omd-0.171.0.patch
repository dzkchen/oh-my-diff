+fn exec_output_pages_a_multibyte_artifact_without_splitting_characters() {
+    let _exec = exec_slot();
+    let (_temp, repository, data, authority) = setup();
+    let active = || true;
+    let host = Host {
+        authority: &authority,
+        data_root: &data,
