+    }
+    let snapshot = control_call(&fixture, Origin::Event, "workspace.snapshot", json!({}))
+        .await
+        .unwrap();
+    for (explicit, expected) in [
+        (json!({}), "scoped"),
+        (json!({"FIXTURE_VALUE": "explicit"}), "explicit"),
+    ] {
+        let result = control_call(
+            &fixture,
+            Origin::Event,
+            "exec.run",
+            json!({
