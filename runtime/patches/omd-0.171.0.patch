+    assert_eq!(region(), None);
+    press(KeyCode::Char(']'), KeyModifiers::CONTROL);
+    assert_eq!(region().as_deref(), Some("demo/git"));
+    press(KeyCode::Char('1'), KeyModifiers::NONE);
+    assert_eq!(
+        (region().as_deref(), focused().as_deref()),
+        (Some("demo/files"), Some("files"))
+    );
+    press(KeyCode::Char('?'), KeyModifiers::NONE);
+    let help = rows(&draw(), area);
+    assert!(
+        help.contains("Keys: demo/files") && help.contains("Show keys"),
+        "{help}"
+    );
+    for character in "/panel 2".chars() {
+        press(KeyCode::Char(character), KeyModifiers::NONE);
+    }
+    let filtered = rows(&draw(), area);
+    assert!(
+        filtered.contains("Focus panel 2") && !filtered.contains("Show keys"),
+        "{filtered}"
+    );
+    press(KeyCode::Enter, KeyModifiers::NONE);
+    assert_eq!(region().as_deref(), Some("demo/git"));
+    assert!(test_interaction.lock().unwrap().help.is_none());
+    let held =
+        KeyEvent::new_with_kind(KeyCode::Char('x'), KeyModifiers::NONE, KeyEventKind::Repeat);
+    assert!(matches!(input(held, true), Some(ModInput::Consumed)));
+    assert!(paste("text"));
+    press(KeyCode::Esc, KeyModifiers::NONE);
+    assert_eq!(region(), None);
+    press(KeyCode::Char(']'), KeyModifiers::CONTROL);
+    press(KeyCode::Char('1'), KeyModifiers::NONE);
+    assert_eq!(focused().as_deref(), Some("files"));
+    press(KeyCode::Char(']'), KeyModifiers::CONTROL);
+    assert_eq!((region(), focused()), (None, None));
