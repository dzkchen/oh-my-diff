+
+impl PtyApproval {
+    fn new(
+        store: &std::path::Path,
+        repository: &std::path::Path,
+        caller: &str,
+        arguments: &Value,
+    ) -> Result<Self, String> {
+        use sha2::Digest;
+        let repository = repository
+            .canonicalize()
+            .map_err(|error| error.to_string())?;
+        let argv = crate::mod_pty::argv(arguments)?;
+        let program = codex_omd::host::resolve_program(&argv[0], &repository)
+            .ok_or("pty_program_unavailable")?;
+        let hash = codex_omd::host::program_hash(&program)?;
+        let value = json!({"repository": repository, "caller": caller, "arguments": arguments, "program": program, "sha256": hash});
+        let digest = sha2::Sha256::digest(value.to_string().as_bytes());
+        Ok(Self {
+            path: store.join("pty-approvals").join(format!("{digest:x}.json")),
+            value,
+        })
+    }
+
+    fn stored(&self) -> bool {
+        std::fs::read(&self.path)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+            .as_ref()
+            == Some(&self.value)
+    }
+
+    fn save(&self) -> std::io::Result<()> {
+        if let Some(parent) = self.path.parent() {
+            std::fs::create_dir_all(parent)?;
+        }
+        codex_omd::fsio::write_json(&self.path, &self.value)
+    }
+}
