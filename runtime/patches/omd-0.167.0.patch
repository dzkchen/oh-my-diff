+        "rejected_names",
+        json!({"capabilities":["state","commands"]}),
+        "export default api => api.command('x', () => api.state.get())",
+        &[],
+    );
+    assert!(
+        ModStore::inspect_package(&rejected_names)
+            .unwrap_err()
+            .to_string()
+            .contains("capability")
+    );
+    let old_event = package(
+        &root,
+        "old_event",
+        json!({"capabilities":["lifecycle"]}),
+        "export default api => api.on('worker_context', () => null)",
+        &[],
+    );
+    trust(&store, &old_event);
+    let old_point = package(
+        &root,
+        "old_point",
+        json!({"capabilities":["lifecycle"]}),
+        "export default api => api.replace('retired_point', () => null)",
+        &[],
+    );
+    trust(&store, &old_point);
+    let adapter = package(
+        &root,
+        "adapter",
+        json!({"capabilities":[],"assets":["adapt.ts","shim.mjs"],"adapter_module":{"entry":"adapt.ts","aliases":{"shim":"shim.mjs"}}}),
+        "export default () => {}",
+        &[
+            (
+                "adapt.ts",
+                "export default api => ({ register(name: string, value: number) { api.command(name, () => value); } });",
+            ),
+            ("shim.mjs", "export const answer = 42;"),
+        ],
+    );
+    trust(&store, &adapter);
+    let adapted = package(
+        &root,
+        "adapted",
+        json!({"capabilities":["commands"],"adapter":"adapter","dependencies":[{"id":"adapter","version":"^1.0.0"}]}),
+        "import { answer } from 'shim'; export default host => host.register('answer', answer);",
+        &[],
+    );
+    trust(&store, &adapted);
+    let mut runtime = ModHost::open(root.join("store"), ModOpenOptions::default()).unwrap();
+    assert!(
+        error_of(&runtime, "old_event").contains("unsupported_event"),
+        "{}",
+        error_of(&runtime, "old_event")
+    );
+    assert!(
+        error_of(&runtime, "old_point").contains("unsupported_replacement_point: retired_point"),
+        "{}",
+        error_of(&runtime, "old_point")
+    );
+    assert_eq!(error_of(&runtime, "accepted"), "");
+    assert_eq!(error_of(&runtime, "adapted"), "");
+    assert_eq!(
+        runtime
+            .invoke(
+                "adapted",
+                runtime.generation(),
+                "command",
+                "answer",
+                Value::Null,
+                ModInvokeOptions::default()
+            )
+            .unwrap(),
+        json!(42)
+    );
+    let controls = runtime.builtin_controls();
+    assert_eq!(controls.len(), 1);
+    assert_eq!(controls[0].1.commands.hide, vec!["plan"]);
+    let documents = runtime.contract_documents();
+    assert_eq!(documents[0].0.key(), "fixture@1");
+    let mut calls = Vec::new();
+    let result = runtime
+        .invoke(
+            "accepted",
+            runtime.generation(),
+            "command",
+            "run",
+            Value::Null,
+            ModInvokeOptions {
+                host: ModHostCallback::Own(&mut |call| {
+                    calls.push(call.operation.clone());
+                    Ok(if call.operation == "exec.run" {
+                        json!({"exit_code":0})
+                    } else {
+                        json!({"revision":1})
+                    })
+                }),
+                ..ModInvokeOptions::default()
+            },
+        )
+        .unwrap();
+    assert_eq!(result, json!({"revision":1}));
+    assert_eq!(calls, vec!["exec.run", "store.put"]);
+    let grants = runtime.grants("accepted").unwrap();
+    assert_eq!(grants.exec_environment, vec!["FIXTURE_ENV"]);
+    assert!(grants.capabilities.contains(&"exec".to_owned()));
+    store.enable(&old_event, false).unwrap();
+    std::fs::write(adapter.join("shim.mjs"), "export const answer = 43;").unwrap();
+    trust(&store, &adapter);
+    runtime.reload().unwrap();
+    assert_eq!(
+        runtime
+            .invoke(
+                "adapted",
+                runtime.generation(),
+                "command",
+                "answer",
+                Value::Null,
+                ModInvokeOptions::default()
+            )
+            .unwrap(),
+        json!(43)
+    );
+}
