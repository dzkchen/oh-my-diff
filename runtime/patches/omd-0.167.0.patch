+    .unwrap();
+    let scope = crate::mod_runtime::CallScope {
+        thread: Some("captured-thread"),
+        ..scope(InvocationContext::User)
+    };
+    for (operation, arguments) in [
+        (
+            "events.schedule",
+            json!({"key":"time:job.refresh","delay_ms":16,"data":{"input":"value"}}),
+        ),
+        ("events.cancel", json!({"key":"time:job.refresh"})),
+    ] {
+        let value = host_call(
+            &paths,
+            &policy,
+            grants(&["events"]),
+            "background_fixture",
+            codex_omd::ModHostCall {
+                operation: operation.into(),
+                arguments: arguments.clone(),
+            },
+            &scope,
+        )
+        .unwrap();
+        assert_eq!(value, json!({"operation":operation,"arguments":arguments}));
+    }
+    drop(registration);
+}
