+                "store.get": [{"arguments":{"key":"expected"},"result":null}]
+            }}),
+            0,
+        )
+        .unwrap();
+        assert!(
+            host.call(
+                "test",
+                call(
+                    "store.put",
+                    json!({"key":"k","value":null,"expected_revision":null})
