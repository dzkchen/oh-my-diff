+use super::prepend_status_prefix;
+use crate::bottom_pane::footer_content::FooterContent;
+use crate::terminal_hyperlinks::osc8_hyperlink;
+use crate::ui_tree::UiNode;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+
+#[test]
+fn status_prefix_leads_the_extension_tree_without_flattening_it() {
+    let url = "https://example.com/pr/42";
+    let tree: UiNode = serde_json::from_value(serde_json::json!({
+        "type": "row", "props": {}, "children": [
+            { "type": "text", "props": { "text": "main · " } },
+            { "type": "link", "props": { "href": url }, "children": [
+                { "type": "text", "props": { "text": "PR #42" } }
+            ] }
+        ]
+    }))
+    .unwrap();
+    let extension = FooterContent::Extension {
+        content: tree.clone(),
+    };
+    assert_eq!(
+        prepend_status_prefix(Vec::new(), Some(extension.clone())),
+        Some(extension.clone())
+    );
+    let content = prepend_status_prefix(vec!["OMD".bold()], Some(extension)).unwrap();
+    assert_eq!(
+        content,
+        FooterContent::PrefixedExtension {
+            prefix: vec!["OMD".bold(), " · ".dim()].into(),
+            content: tree,
+        }
+    );
+    assert_eq!(content.width(), 19);
+    let line = content.clone().into_hyperlink_line();
+    assert_eq!(line.line.to_string(), "OMD · main · PR #42");
+    assert_eq!(line.hyperlinks[0].columns, 13..19);
+
+    let area = Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 17, /*height*/ 1,
+    );
+    let mut buf = Buffer::empty(area);
+    content.render(area, &mut buf);
+    let text = (0..6).map(|x| buf[(x, 0)].symbol()).collect::<String>();
+    assert_eq!(text, "OMD · ");
+    assert!(
+        buf[(0, 0)]
+            .modifier
+            .contains(ratatui::style::Modifier::BOLD)
+    );
+    for (x, ch) in (13..16).zip("PR ".chars()) {
+        assert_eq!(buf[(x, 0)].symbol(), osc8_hyperlink(url, &ch.to_string()));
+    }
+    assert_eq!(buf[(16, 0)].symbol(), "…");
+}
