+fn request(changed: bool) -> ModPanelRequest {
+    let mut arguments = json!({
+        "title": "Demo",
+        "subtitle": "Preview\nsecond line",
+        "tabs": [{"id": "main", "title": "Main"}, {"id": "more", "title": "More"}],
+        "search": true,
+        "action": {"command": "panel", "args": "set"},
+        "items": [
+            {"id": "alpha", "tab": "main", "label": "Alpha", "kind": "toggle", "value": changed},
+            {"id": "mode", "tab": "main", "label": "Mode", "kind": "choice", "value": "b",
+                "options": [{"value": "a", "label": "A"}, {"value": "b", "label": "B"}]},
+            {"id": "name", "tab": "more", "label": "Name", "kind": "text", "value": "x"},
+            {"id": "reset", "tab": "more", "label": "Reset", "kind": "action"},
+        ],
+    });
+    if changed {
+        arguments["items"].as_array_mut().unwrap().insert(
+            2,
+            json!({"id": "added", "tab": "more", "label": "Added", "kind": "action"}),
+        );
+    }
+    ModPanelRequest::parse("demo", &arguments).expect("valid panel")
