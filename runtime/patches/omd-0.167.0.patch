+struct Unreachable;
+
+impl HistoryWitness for Unreachable {
+    fn append(&self, _stream: &Path, _sha256: &str) -> std::io::Result<()> {
+        Err(std::io::Error::other("broker unreachable"))
+    }
+
+    fn verify(&self, _stream: &Path, _sha256s: &[String]) -> std::io::Result<()> {
+        Err(std::io::Error::other("broker unreachable"))
+    }
+}
