+pub(crate) fn focus(focused: bool, idle: bool) {
+    DISPLAY_ACTIVE.store(focused && !idle, Ordering::Release);
+    terminal_event("focus", json!({"focused": focused, "idle": idle}));
+}
+
+pub(crate) fn view_state(depth: usize, view_id: Option<&'static str>, overlay: bool) {
+    let previous = with(|state| state.view.replace((depth, view_id, overlay)));
+    let Some((before_depth, before_id, before_overlay)) = previous else {
+        return;
+    };
+    if before_overlay != overlay {
+        terminal_event(
+            "view",
+            json!({"phase": if overlay {"opened"} else {"closed"}, "view": "overlay", "view_id": null}),
+        );
+    }
+    if (before_depth, before_id) != (depth, view_id) {
+        if before_depth > 0 {
+            terminal_event(
+                "view",
+                json!({"phase": "closed", "view": "bottom_pane", "view_id": before_id}),
+            );
+        }
+        if depth > 0 {
+            terminal_event(
+                "view",
+                json!({"phase": "opened", "view": "bottom_pane", "view_id": view_id}),
+            );
+        }
+    }
+}
