+fn exec_output_page_rejects_bytes_changed_without_a_new_file_stamp() {
+    use std::os::fd::AsRawFd;
+    let _exec = exec_slot();
+    let (_temp, repository, data, authority) = setup();
+    let active = || true;
+    let host = Host {
