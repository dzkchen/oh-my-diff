+fn replayed_items_publish_their_recorded_duration() {
+    let cwd = test_path_buf("/workspace").abs();
+    let timed = |payload| codex_app_server_protocol::ThreadItem {
+        payload,
+        started_at_ms: Some(1_000),
+        completed_at_ms: Some(1_250),
+    };
+    let items = [
+        timed(ThreadItemPayload::ImageView {
+            id: "view-1".to_string(),
+            path: LegacyAppPathString::from_string("diagram.png".to_string()),
+        }),
+        timed(ThreadItemPayload::WebSearch(WebSearchItem {
+            id: "search-1".to_string(),
+            query: "query".to_string(),
+            action: None,
+            results: None,
+        })),
+        codex_app_server_protocol::ThreadItem::untimed(ThreadItemPayload::ImageView {
+            id: "view-2".to_string(),
+            path: LegacyAppPathString::from_string("diagram.png".to_string()),
+        }),
+    ];
+    let durations = crate::thread_transcript::thread_items_to_transcript_cells(
+        /*thread_id*/ None,
+        &cwd,
+        items,
+        crate::thread_transcript::RawReasoningVisibility::Hidden,
+        /*config*/ None,
+    )
+    .iter()
+    .map(|cell| cell.render_target().expect("render target").props["duration_ms"].clone())
+    .collect::<Vec<_>>();
+    assert_eq!(
+        durations,
+        [
+            serde_json::json!(250),
+            serde_json::json!(250),
+            serde_json::Value::Null
+        ]
+    );
+}
