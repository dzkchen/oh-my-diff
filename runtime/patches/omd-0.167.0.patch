diff --git a/codex-rs/omd/src/mods/operation_validation.rs b/codex-rs/omd/src/mods/operation_validation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fc6d299c1cf91077a6efe36b9dcab68e494d011b
--- /dev/null
+++ b/codex-rs/omd/src/mods/operation_validation.rs
@@ -0,0 +1,210 @@
+use serde_json::Value;
+use std::sync::LazyLock;
+
+static SCHEMAS: LazyLock<Result<Value, String>> = LazyLock::new(|| {
+    let schemas: Value = serde_json::from_str(include_str!("operation_schema.json"))
+        .map_err(|error| format!("operation_schemas_invalid: {error}"))?;
+    for operation in schemas["operations"]
+        .as_object()
+        .ok_or("operation_schemas_invalid: operations")?
+        .values()
+    {
+        for field in ["arguments", "result"] {
+            supported(&operation[field], &schemas)?;
+        }
+    }
+    for definition in schemas["$defs"]
+        .as_object()
+        .ok_or("operation_schemas_invalid: definitions")?
+        .values()
+    {
+        supported(definition, &schemas)?;
+    }
+    Ok(schemas)
+});
+
+fn supported(schema: &Value, document: &Value) -> Result<(), String> {
+    if let Some(object) = schema.as_object() {
+        for (name, child) in object {
+            match name.as_str() {
+                "properties" => {
+                    for child in child
+                        .as_object()
+                        .ok_or("schema properties invalid")?
+                        .values()
+                    {
+                        supported(child, document)?;
+                    }
+                }
+                "anyOf" | "allOf" | "prefixItems" => {
+                    for child in child.as_array().ok_or("schema alternatives invalid")? {
+                        supported(child, document)?;
+                    }
+                }
+                "items" | "additionalProperties" => supported(child, document)?,
+                "$ref" => {
+                    let name = child
+                        .as_str()
+                        .and_then(|value| value.strip_prefix("#/$defs/"))
+                        .ok_or("schema reference invalid")?;
+                    if document["$defs"].get(name).is_none() {
+                        return Err("schema reference missing".into());
+                    }
+                }
+                "type" | "const" | "required" | "minItems" | "maxItems" | "format" => {}
+                _ => return Err(format!("unsupported schema keyword {name}")),
+            }
+        }
+    } else if !schema.is_boolean() {
+        return Err("schema must be an object or boolean".into());
+    }
+    Ok(())
+}
+
+fn check(schema: &Value, value: &Value, path: &str) -> Result<(), String> {
+    let invalid = |reason: &str| Err(format!("{path}: {reason}"));
+    if let Some(reference) = schema["$ref"].as_str() {
+        let schemas = SCHEMAS.as_ref().map_err(Clone::clone)?;
+        return check(
+            &schemas["$defs"][&reference["#/$defs/".len()..]],
+            value,
+            path,
+        );
+    }
+    if schema == &Value::Bool(false) {
+        return invalid("value forbidden");
+    }
+    if let Some(kind) = schema["type"].as_str() {
+        let valid = match kind {
+            "null" => value.is_null(),
+            "boolean" => value.is_boolean(),
+            "number" => value.is_number(),
+            "string" => value.is_string(),
+            "array" => value.is_array(),
+            "object" => value.is_object(),
+            _ => false,
+        };
+        if !valid {
+            return invalid(&format!("expected {kind}"));
+        }
+    }
+    if let Some(expected) = schema.get("const")
+        && value != expected
+    {
+        return invalid("literal mismatch");
+    }
+    if let Some(variants) = schema["anyOf"].as_array()
+        && !variants
+            .iter()
+            .any(|variant| check(variant, value, path).is_ok())
+    {
+        return invalid("no union member matched");
+    }
+    if let Some(variants) = schema["allOf"].as_array() {
+        for variant in variants {
+            check(variant, value, path)?;
+        }
+    }
+    if let Some(format) = schema.get("format") {
+        let valid = match (format.as_str(), value.as_str()) {
+            (Some("dotted-string"), Some(text)) => text.contains('.'),
+            (Some("hash-prefixed-string"), Some(text)) => text.starts_with('#'),
+            _ => false,
+        };
+        if !valid {
+            return invalid("string format mismatch or unsupported format");
+        }
+    }
+    if let Some(object) = value.as_object() {
+        if let Some(required) = schema["required"].as_array() {
+            for name in required.iter().filter_map(Value::as_str) {
+                if !object.contains_key(name) {
+                    return invalid(&format!("missing {name}"));
+                }
+            }
+        }
+        for (name, member) in object {
+            let member_schema = schema["properties"]
+                .get(name)
+                .or_else(|| schema.get("additionalProperties"));
+            if let Some(member_schema) = member_schema {
+                check(member_schema, member, &format!("{path}/{name}"))?;
+            }
+        }
+    }
+    if let Some(values) = value.as_array() {
+        if schema["minItems"]
+            .as_u64()
+            .is_some_and(|min| (values.len() as u64) < min)
+            || schema["maxItems"]
+                .as_u64()
+                .is_some_and(|max| values.len() as u64 > max)
+        {
+            return invalid("array length invalid");
+        }
+        for (index, member) in values.iter().enumerate() {
+            let member_schema = schema["prefixItems"]
+                .get(index)
+                .or_else(|| schema.get("items"));
+            if let Some(member_schema) = member_schema {
+                check(member_schema, member, &format!("{path}/{index}"))?;
+            }
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn validate(operation: &str, field: &str, value: &Value) -> Result<(), String> {
+    let schemas = SCHEMAS.as_ref().map_err(Clone::clone)?;
+    let schema = schemas["operations"]
+        .get(operation)
+        .and_then(|entry| entry.get(field))
+        .ok_or_else(|| format!("offline_unknown_host_operation: {operation}"))?;
+    check(schema, value, field)
+        .map_err(|reason| format!("offline_invalid_{field}: {operation}: {reason}"))?;
+    if field == "arguments" {
+        match operation {
+            operation if operation.starts_with("store.") => {
+                crate::data_store::validate_request(operation, value)
+                    .map_err(|error| error.to_string())?
+            }
+            "environment.read" => {
+                crate::host::validate_environment_read(value)?;
+            }
+            "environment.set" => {
+                crate::host::validate_environment_set(value)?;
+            }
+            "events.schedule" | "events.cancel" => {
+                crate::host::validate_timer_request(operation, value)?;
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn generated_schema_covers_every_host_operation() {
+        let schemas = SCHEMAS.as_ref().unwrap();
+        for operation in super::super::MOD_HOST_OPERATIONS {
+            assert!(
+                schemas["operations"][*operation]["arguments"].is_object()
+                    || schemas["operations"][*operation]["arguments"].is_boolean(),
+                "{operation}"
+            );
+            assert!(
+                schemas["operations"][*operation]["result"].is_object()
+                    || schemas["operations"][*operation]["result"].is_boolean(),
+                "{operation}"
+            );
+        }
+        assert_eq!(
+            schemas["operations"].as_object().unwrap().len(),
+            super::super::MOD_HOST_OPERATIONS.len()
+        );
+    }
+}
diff --git a/codex-rs/omd/src/mods/outcome.rs b/codex-rs/omd/src/mods/outcome.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e25e0ed2ff1e1bb787435731d9ca471e86b6953d
--- /dev/null
+++ b/codex-rs/omd/src/mods/outcome.rs
@@ -0,0 +1,75 @@
+use super::*;
+
+const TEXT_LIMIT: usize = 16_384;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ModCommandOutcome {
+    pub display: Option<String>,
+    pub insert: Option<String>,
+    pub submit: Option<String>,
+    pub terminal: Option<Value>,
+}
+
+fn text(value: &Value, limit: usize) -> Result<String> {
+    let text = value
+        .as_str()
+        .ok_or_else(|| failure("invalid_outcome_text"))?;
+    if text.is_empty()
+        || text.len() > limit
+        || text
+            .chars()
+            .any(|c| c.is_control() && c != '\n' && c != '\t')
+    {
+        return Err(failure("invalid_outcome_text"));
+    }
+    Ok(text.to_owned())
+}
+
+fn truncated(mut text: String) -> String {
+    text.truncate(text.floor_char_boundary(TEXT_LIMIT));
+    text.chars()
+        .filter(|c| !c.is_control() || *c == '\n' || *c == '\t')
+        .collect()
+}
+
+impl ModCommandOutcome {
+    pub fn parse(value: &Value) -> Result<Self> {
+        match value {
+            Value::Null => Ok(Self::default()),
+            Value::String(display) => Ok(Self {
+                display: Some(truncated(display.clone())).filter(|s| !s.is_empty()),
+                ..Self::default()
+            }),
+            Value::Object(object)
+                if !object.is_empty()
+                    && object.keys().all(|key| {
+                        ["display", "insert", "submit", "terminal"].contains(&key.as_str())
+                    }) =>
+            {
+                let outcome = Self {
+                    terminal: object.get("terminal").cloned(),
+                    display: object
+                        .get("display")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    insert: object
+                        .get("insert")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    submit: object
+                        .get("submit")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                };
+                if outcome.insert.is_some() && outcome.submit.is_some() {
+                    return Err(failure("command_outcome_conflict: insert or submit"));
+                }
+                Ok(outcome)
+            }
+            other => Ok(Self {
+                display: Some(truncated(serde_json::to_string_pretty(other)?)),
+                ..Self::default()
+            }),
+        }
+    }
+}
diff --git a/codex-rs/omd/src/mods/package_manager.rs b/codex-rs/omd/src/mods/package_manager.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cde030b2f90b3c6d9c1c49b0a78461828bcef9d1
--- /dev/null
+++ b/codex-rs/omd/src/mods/package_manager.rs
@@ -0,0 +1,2883 @@
+use super::*;
+use serde_json::Map;
+use std::io::Read;
+use std::process::Command;
+
+const PACKAGE_LOCK_SCHEMA: u32 = 1;
+const PACKAGE_HISTORY_LIMIT: usize = 8;
+const NPM_METADATA_LIMIT: usize = 16 * 1024 * 1024;
+const NPM_TARBALL_LIMIT: usize = 4 * 1024 * 1024;
+const NPM_UNPACKED_LIMIT: usize = 16 * 1024 * 1024;
+const NPM_ARCHIVE_ENTRIES: usize = 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ModPackageSource {
+    Local {
+        path: PathBuf,
+    },
+    Repository {
+        repository: String,
+        revision: String,
+        #[serde(default)]
+        subdirectory: String,
+    },
+    Package {
+        index: PathBuf,
+        id: String,
+        version: String,
+    },
+    Npm {
+        package: String,
+        #[serde(default)]
+        version: String,
+        #[serde(default)]
+        registry: String,
+        #[serde(default, skip_serializing_if = "String::is_empty")]
+        integrity: String,
+    },
+}
+
+#[derive(Default)]
+struct NpmConfig {
+    registry: Option<String>,
+    scopes: BTreeMap<String, String>,
+    tokens: Vec<(String, String)>,
+}
+
+impl NpmConfig {
+    fn load() -> Self {
+        let path = std::env::var_os("NPM_CONFIG_USERCONFIG")
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".npmrc")));
+        let text = path
+            .filter(|path| {
+                std::fs::metadata(path).is_ok_and(|meta| meta.is_file() && meta.len() <= 65_536)
+            })
+            .and_then(|path| std::fs::read_to_string(path).ok())
+            .unwrap_or_default();
+        let expand = |value: &str| {
+            interpolate(value.trim().trim_matches('"'), |name| {
+                std::env::var(name).ok()
+            })
+        };
+        let mut config = Self::default();
+        for line in text.lines().map(str::trim) {
+            let Some((key, value)) = line
+                .split_once('=')
+                .filter(|_| !line.starts_with(['#', ';']))
+            else {
+                continue;
+            };
+            let (key, value) = (key.trim(), expand(value));
+            if key == "registry" {
+                config.registry = Some(value);
+            } else if let Some(scope) = key
+                .strip_suffix(":registry")
+                .filter(|scope| scope.starts_with('@'))
+            {
+                config.scopes.insert(scope.to_owned(), value);
+            } else if let Some(prefix) = key
+                .strip_suffix(":_authToken")
+                .filter(|prefix| prefix.starts_with("//"))
+            {
+                config
+                    .tokens
+                    .push((format!("{}/", prefix.trim_end_matches('/')), value));
+            }
+        }
+        config
+    }
+
+    fn registry(&self, package: &str) -> String {
+        package
+            .split_once('/')
+            .and_then(|(scope, _)| self.scopes.get(scope))
+            .or(self.registry.as_ref())
+            .map_or("https://registry.npmjs.org", String::as_str)
+            .trim_end_matches('/')
+            .to_owned()
+    }
+
+    fn token(&self, url: &str) -> Option<&str> {
+        let target = format!("//{}", url.split_once("://")?.1);
+        self.tokens
+            .iter()
+            .filter(|(prefix, _)| target.starts_with(prefix.as_str()))
+            .max_by_key(|(prefix, _)| prefix.len())
+            .map(|(_, token)| token.as_str())
+            .filter(|token| !token.is_empty())
+    }
+}
+
+fn interpolate(value: &str, resolve: impl Fn(&str) -> Option<String>) -> String {
+    let (mut expanded, mut rest) = (String::new(), value);
+    while let Some(start) = rest.find("${") {
+        let Some(length) = rest[start..].find('}') else {
+            break;
+        };
+        expanded.push_str(&rest[..start]);
+        expanded.push_str(&resolve(&rest[start + 2..start + length]).unwrap_or_default());
+        rest = &rest[start + length + 1..];
+    }
+    expanded + rest
+}
+
+impl ModPackageSource {
+    pub fn parse(reference: &str, index: Option<PathBuf>) -> Result<Self> {
+        let reference = reference.trim();
+        let versioned = |value: &str| match value.get(1..).and_then(|rest| rest.rfind('@')) {
+            Some(at) => (value[..=at].to_owned(), value[at + 2..].to_owned()),
+            None => (value.to_owned(), String::new()),
+        };
+        if let Some(npm) = reference.strip_prefix("npm:") {
+            let (package, version) = versioned(npm);
+            return Ok(Self::Npm {
+                package,
+                version,
+                registry: String::new(),
+                integrity: String::new(),
+            });
+        }
+        if let Some(git) = reference.strip_prefix("git+") {
+            let (repository, fragment) = git.split_once('#').unwrap_or((git, "HEAD"));
+            let (revision, subdirectory) = fragment.split_once(':').unwrap_or((fragment, ""));
+            return Ok(Self::Repository {
+                repository: repository
+                    .strip_prefix("file://")
+                    .unwrap_or(repository)
+                    .to_owned(),
+                revision: revision.to_owned(),
+                subdirectory: subdirectory.to_owned(),
+            });
+        }
+        if reference.starts_with('/') {
+            return Ok(Self::Local {
+                path: reference.into(),
+            });
+        }
+        let (id, version) = versioned(reference);
+        if !identifier(&id) || !version_selector(&version) {
+            return Err(failure(
+                "package_reference_invalid: use ID[@VERSION], npm:NAME[@VERSION], git+URL[#REF[:DIRECTORY]] or an absolute folder",
+            ));
+        }
+        Ok(Self::Package {
+            index: index.ok_or_else(|| {
+                failure("package_index_unavailable: install from npm:, git+ or a folder instead")
+            })?,
+            id,
+            version,
+        })
+    }
+
+    pub fn with_version(self, requested: &str) -> Result<Self> {
+        match self {
+            Self::Package { index, id, .. } => Ok(Self::Package {
+                index,
+                id,
+                version: requested.to_owned(),
+            }),
+            Self::Npm {
+                package, registry, ..
+            } => Ok(Self::Npm {
+                package,
+                version: requested.to_owned(),
+                registry,
+                integrity: String::new(),
+            }),
+            _ => Err(failure(
+                "package_version_unsupported: pin a Git source with #REF; folders have no versions",
+            )),
+        }
+    }
+
+    /// The source an update resolves: newer compatible index and npm releases; pinned commits and local folders as is.
+    pub fn updatable(&self) -> Self {
+        let compatible = |version: &str| match SemanticVersion::parse(version) {
+            Some(_) => format!("^{version}"),
+            None => String::new(),
+        };
+        match self {
+            Self::Package { index, id, version } => Self::Package {
+                index: index.clone(),
+                id: id.clone(),
+                version: compatible(version),
+            },
+            Self::Npm {
+                package,
+                version,
+                registry,
+                ..
+            } => Self::Npm {
