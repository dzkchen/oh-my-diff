+pub(crate) fn attach(sender: &AppEventSender, thread: Option<String>) {
+    if !crate::omd::is_active() {
+        return;
+    }
+    let opened = with(|state| {
+        let changed = state.thread != thread;
+        if changed {
+            CONTEXT_EPOCH.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+        }
+        state.thread = thread;
+        if state.registration.is_none() {
+            state.registration = Some(codex_omd::client_surface::register(Arc::new(TuiSurface(
+                sender.clone(),
+            ))));
+        }
+        changed.then(|| state.thread.clone()).flatten()
+    });
+    if let Some(thread) = opened {
+        terminal_event(
+            "view",
+            json!({"phase": "opened", "view": "thread", "view_id": thread}),
+        );
+    }
+}
+
+pub(crate) fn current_thread() -> Option<String> {
+    with(|state| state.thread.clone())
+}
+
+fn call_binding(caller: &str) -> Value {
+    let status = crate::omd::mod_status().unwrap_or_default();
+    let source = status["mods"]
+        .as_array()
+        .and_then(|mods| {
+            mods.iter()
+                .find(|item| item["id"] == caller && item["error"].is_null())
+        })
+        .map(|item| item["sha256"].clone());
+    json!({"thread": current_thread(), "repository": crate::omd::mod_paths().map(|paths| paths.repository), "epoch": CONTEXT_EPOCH.load(std::sync::atomic::Ordering::Acquire), "generation": status["generation"], "source": source})
+}
+
+#[cfg(test)]
+pub(crate) fn bind_test_call(call: &mut SurfaceCall) {
+    call.lifetime.binding = Some(call_binding(&call.caller));
+}
+
+pub(crate) fn validate_call(call: &SurfaceCall) -> Result<(), String> {
+    validate_call_classified(call).map_err(|error| error.message)
+}
+
+pub(crate) fn validate_call_classified(
+    call: &SurfaceCall,
+) -> Result<(), codex_omd::client_surface::BlitError> {
+    if !call.lifetime.active() {
+        return Err(codex_omd::client_surface::BlitError::retryable(
+            "callback_cancelled_or_expired",
+        ));
+    }
+    if !(call.validity.0)() {
+        return Err("client_context_changed".into());
+    }
+    let binding = call_binding(&call.caller);
+    // Terminal and session hosts reload at different times, so either's admission is current; the terminal host is asked only when needed.
+    let session_admits = binding["source"].is_string()
+        && call
+            .lifetime
+            .admission
+            .as_ref()
+            .is_none_or(|admitted| admitted["source"] == binding["source"]);
+    let terminal_source = (!session_admits)
+        .then(|| crate::mod_runtime::terminal_source(&call.caller))
+        .flatten();
+    if let Some(admitted) = &call.lifetime.admission
+        && admitted["source"] != binding["source"]
+        && admitted["source"].as_str() != terminal_source.as_deref()
+    {
+        return Err(codex_omd::client_surface::BlitError::retryable(
+            "client_surface_admission_changed",
+        ));
+    }
+    if call.lifetime.binding.as_ref() != Some(&binding)
+        || (call.caller != codex_omd::broker::HOST_CALLER
+            && (binding["source"].is_null() && terminal_source.is_none()
+                || call.thread.is_some() && call.thread != current_thread()))
+    {
+        return Err(codex_omd::client_surface::BlitError::retryable(
+            "client_surface_context_changed",
+        ));
+    }
+    Ok(())
+}
+
+fn refresh_subscribers(state: &mut State) {
+    if state
+        .checked
+        .is_some_and(|checked| checked.elapsed() < SUBSCRIBER_TTL)
+    {
+        return;
+    }
+    state.checked = Some(Instant::now());
+    let mods = crate::omd::mod_status()
+        .and_then(|status| status["mods"].as_array().cloned())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|item| item["error"].is_null())
+        .collect::<Vec<_>>();
+    state.events = mods
+        .iter()
+        .flat_map(|item| {
+            item["registrations"]["events"]
+                .as_array()
+                .cloned()
+                .unwrap_or_default()
+        })
+        .filter_map(|event| event.as_str().map(str::to_owned))
+        .collect();
+    let registers = |item: &Value, kind: &str| {
+        item["registrations"][kind]
+            .as_array()
+            .is_some_and(|names| names.iter().any(|name| name == "completion"))
+    };
+    state.completers = mods
+        .iter()
+        .filter(|item| registers(item, "events"))
+        .filter_map(|item| item["id"].as_str().map(str::to_owned))
+        .collect();
+    state.completion_owner = mods.iter().any(|item| registers(item, "replacements"));
+    let mut triggers = BTreeMap::new();
+    for item in &mods {
+        let id = item["id"].as_str().unwrap_or_default();
+        for completion in item["registrations"]["completions"]
+            .as_array()
+            .into_iter()
+            .flatten()
+        {
+            let trigger = completion["trigger"].as_str().unwrap_or_default();
+            match triggers.get(trigger) {
+                None => {
+                    triggers.insert(trigger.to_owned(), id.to_owned());
+                }
+                Some(owner) if state.triggers.get(trigger) != Some(owner) => {
+                    crate::mod_ui::notice(
+                        id,
+                        Some("completion_trigger"),
+                        "warning",
+                        crate::mod_ui::NoticePlacement::Status,
+                        &format!(
+                            "{id}: completion trigger {trigger} is already completed by {owner}"
+                        ),
+                        Duration::from_secs(10),
+                    );
+                }
+                Some(_) => {}
+            }
+        }
+    }
+    state.triggers = triggers;
+    state.subscribers = mods
+        .into_iter()
+        .filter_map(|item| {
+            let patterns = item["subscriptions"]["app"]
+                .as_array()?
+                .iter()
+                .filter_map(|pattern| pattern.as_str().map(str::to_owned))
+                .collect::<Vec<_>>();
+            let id = item["id"].as_str()?.to_owned();
+            (!patterns.is_empty()).then_some((id, patterns))
+        })
+        .collect();
+    let live = state
+        .subscribers
+        .iter()
+        .map(|(id, _)| id.clone())
+        .collect::<BTreeSet<_>>();
+    state.queues.retain(|id, _| live.contains(id));
+    state.requests.retain(|id, _| live.contains(id));
+}
+
+pub(crate) fn wants_notifications() -> bool {
+    with(|state| {
+        refresh_subscribers(state);
+        !state.subscribers.is_empty()
+    })
+}
+
+pub(crate) fn notification(method: &str, params: Value) {
+    if !codex_omd::app_routes::notification_routed(method) {
+        return;
+    }
+    enqueue(method, params, false);
+}
+
+pub(crate) fn server_request(method: &str, request_id: Value, params: Value) {
+    if !codex_omd::app_routes::server_request_routed(method) {
+        return;
+    }
+    with(|state| {
+        if state.requested.len() >= 256 {
+            state.requested.clear();
+        }
+        state
+            .requested
+            .insert(request_id.to_string(), method.to_owned());
+    });
+    enqueue(
+        method,
+        json!({"request_id": request_id, "phase": "requested", "params": params, "resolution": null}),
+        true,
+    );
+}
+
+pub(crate) fn pending_server_request(caller: &str, request_id: &Value) -> Result<String, String> {
+    with(|state| {
+        refresh_subscribers(state);
+        let method = state
+            .requested
+            .get(&request_id.to_string())
+            .cloned()
+            .ok_or_else(|| "app_request_not_pending".to_owned())?;
+        state
+            .subscribers
+            .iter()
+            .any(|(id, patterns)| {
+                id == caller && codex_omd::app_routes::subscribed(patterns, &method)
+            })
+            .then_some(method)
+            .ok_or_else(|| "app_request_not_subscribed".to_owned())
+    })
+}
+
+pub(crate) fn server_request_resolved(request_id: Value) {
+    let Some(method) = with(|state| state.requested.remove(&request_id.to_string())) else {
+        return;
+    };
+    enqueue(
+        &method,
+        json!({"request_id": request_id, "phase": "resolved", "params": null, "resolution": null}),
+        true,
+    );
+}
+
+fn enqueue(method: &str, params: Value, request: bool) {
+    let start = with(|state| {
+        refresh_subscribers(state);
+        let targets = state
+            .subscribers
+            .iter()
+            .filter(|(_, patterns)| codex_omd::app_routes::subscribed(patterns, method))
+            .map(|(id, _)| id.clone())
+            .collect::<Vec<_>>();
+        for id in targets {
+            let queues = if request {
+                &mut state.requests
+            } else {
+                &mut state.queues
+            };
+            queues.entry(id).or_default().push(method, params.clone());
+        }
+        let pending = state.queues.values().any(|queue| !queue.is_empty())
+            || state.requests.values().any(|queue| !queue.is_empty());
+        let start = pending && !state.delivering;
+        state.delivering |= start;
+        start
+    });
+    if start {
+        std::thread::spawn(deliver);
+    }
+}
+
+fn deliver() {
+    loop {
+        let batch = with(|state| {
+            let mut batch = Vec::new();
+            for (id, queue) in state.queues.iter_mut() {
+                batch.extend(
+                    queue
+                        .drain()
+                        .into_iter()
+                        .map(|item| (id.clone(), false, item)),
+                );
+            }
+            for (id, queue) in state.requests.iter_mut() {
+                batch.extend(
+                    queue
+                        .drain()
+                        .into_iter()
+                        .map(|item| (id.clone(), true, item)),
+                );
+            }
+            if batch.is_empty() {
+                state.delivering = false;
+            }
+            batch
+        });
+        if batch.is_empty() {
+            return;
+        }
+        for (id, request, item) in batch {
+            let (event, payload) = if request {
+                let phase = item.params["phase"].clone();
+                (
+                    "app_server_request",
+                    json!({"method": item.method, "request_id": item.params["request_id"],
+                        "phase": phase, "params": item.params["params"], "resolution": item.params["resolution"]}),
+                )
+            } else {
+                (
+                    "app_notification",
+                    json!({"method": item.method, "params": item.params, "thread_id": item.thread_id,
+                        "coalesced": item.coalesced, "dropped": item.dropped}),
+                )
+            };
+            let _ = crate::mod_runtime::invoke_event(&id, event, payload);
+        }
+    }
+}
+
+static COMPLETION: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+fn completion_items() -> usize {
+    crate::omd::mod_paths()
+        .map(|paths| paths.store)
+        .map_or_else(Default::default, |store| {
+            codex_omd::mod_limits::ModLimits::read(&store)
+        })
+        .completion_items
+}
+
+pub(crate) fn completion_owned() -> bool {
+    with(|state| {
+        refresh_subscribers(state);
+        state.completion_owner
+    })
+}
+
+fn own_completer(command: &str) -> Option<String> {
+    let id = crate::mod_runtime::find(command)?.target.id;
+    with(|state| {
+        refresh_subscribers(state);
+        state.completers.contains(&id)
+    })
+    .then_some(id)
+}
+
+pub(crate) fn completes_arguments(command: &str) -> bool {
+    own_completer(command).is_some()
+        || (completion_owned() && crate::mod_runtime::find(command).is_some())
+}
+
+pub(crate) fn complete_files(
+    query: String,
+    matches: Vec<codex_file_search::FileMatch>,
+    tx: crate::app_event_sender::AppEventSender,
+) {
+    let generation = COMPLETION.fetch_add(1, Ordering::AcqRel) + 1;
+    let limit = completion_items();
+    std::thread::spawn(move || {
+        std::thread::sleep(std::time::Duration::from_millis(120));
+        if COMPLETION.load(Ordering::Acquire) != generation {
+            return;
+        }
+        let payload = json!({"kind": "mention", "query": query,
+            "candidates": matches.iter().take(limit)
+                .map(|candidate| json!({"path": candidate.path, "score": candidate.score}))
+                .collect::<Vec<_>>()});
+        let root = matches
+            .first()
+            .map(|candidate| candidate.root.clone())
+            .unwrap_or_default();
+        let current = std::sync::Arc::new(move || COMPLETION.load(Ordering::Acquire) == generation);
+        let ranked = crate::mod_runtime::invoke_replacement("completion", payload, current)
+            .and_then(Result::ok)
+            .and_then(|value| ranked_files(&value, &root, limit));
+        if COMPLETION.load(Ordering::Acquire) == generation {
+            tx.send(crate::app_event::AppEvent::ModFileCompletion {
+                query,
+                matches: ranked.unwrap_or(matches),
+            });
+        }
+    });
+}
+
+pub(crate) fn trigger_owner(trigger: char) -> Option<String> {
+    with(|state| {
+        refresh_subscribers(state);
+        state
+            .triggers
+            .get(trigger.encode_utf8(&mut [0; 4]))
+            .cloned()
+    })
+}
+
+pub(crate) fn complete_arguments(
+    query: String,
+    payload: Value,
+    tx: crate::app_event_sender::AppEventSender,
+) {
+    let generation = COMPLETION.fetch_add(1, Ordering::AcqRel) + 1;
+    let limit = completion_items();
+    std::thread::spawn(move || {
+        std::thread::sleep(std::time::Duration::from_millis(120));
+        if COMPLETION.load(Ordering::Acquire) != generation {
+            return;
+        }
+        let owner = match payload["kind"].as_str() {
+            Some("token") => payload["trigger"]
+                .as_str()
+                .and_then(|trigger| trigger.chars().next())
+                .and_then(trigger_owner),
+            _ => payload["command"].as_str().and_then(own_completer),
+        };
+        let current = std::sync::Arc::new(move || COMPLETION.load(Ordering::Acquire) == generation);
+        let reply = match owner {
+            Some(id) => {
+                crate::mod_runtime::invoke_event_queued(&id, "completion", payload, current)
+            }
+            None if payload["kind"] == "token" => None,
+            None => crate::mod_runtime::invoke_replacement("completion", payload, current),
+        };
+        let matches = reply
+            .and_then(Result::ok)
+            .and_then(|value| {
+                value["items"]
+                    .as_array()
+                    .filter(|items| items.len() <= limit)?
+                    .iter()
+                    .enumerate()
+                    .map(|(rank, item)| {
+                        let insert = item["insert"]
+                            .as_str()
+                            .filter(|text| !text.is_empty() && text.len() <= 1024)?;
+                        Some(codex_file_search::FileMatch {
+                            score: (limit - rank) as u32,
+                            path: std::path::PathBuf::from(insert),
+                            match_type: codex_file_search::MatchType::File,
+                            root: std::path::PathBuf::new(),
+                            indices: None,
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()
+            })
+            .unwrap_or_default();
+        if COMPLETION.load(Ordering::Acquire) == generation {
+            tx.send(crate::app_event::AppEvent::ModFileCompletion { query, matches });
+        }
+    });
+}
+
+fn ranked_files(
+    value: &Value,
+    root: &std::path::Path,
+    limit: usize,
+) -> Option<Vec<codex_file_search::FileMatch>> {
+    let items = value["items"]
+        .as_array()
+        .filter(|items| items.len() <= limit)?;
+    items
+        .iter()
+        .enumerate()
+        .map(|(rank, item)| {
+            let path =
+                std::path::PathBuf::from(item["path"].as_str().filter(|path| path.len() <= 1024)?);
+            path.components()
+                .all(|part| matches!(part, std::path::Component::Normal(_)))
+                .then(|| codex_file_search::FileMatch {
+                    score: (limit - rank) as u32,
+                    path,
+                    match_type: codex_file_search::MatchType::File,
+                    root: root.to_path_buf(),
+                    indices: None,
+                })
+        })
+        .collect()
+}
+
+fn registered(event: &str) -> bool {
+    with(|state| {
+        refresh_subscribers(state);
+        state.events.contains(event)
+    })
+}
+
+const EVENT_QUEUE: usize = 256;
+
+/// In-order delivery on one worker; beyond `EVENT_QUEUE` new events drop and `with_dropped` reports the count on the next.
+struct EventQueue<T> {
+    sender: std::sync::mpsc::SyncSender<T>,
+    dropped: Arc<AtomicUsize>,
+}
+
+impl<T: Send + 'static> EventQueue<T> {
+    fn spawn(deliver: impl Fn(T, &AtomicUsize) + Send + 'static) -> Self {
+        let (sender, receiver) = std::sync::mpsc::sync_channel(EVENT_QUEUE);
+        let dropped = Arc::new(AtomicUsize::new(0));
+        let counter = Arc::clone(&dropped);
+        std::thread::spawn(move || {
+            while let Ok(item) = receiver.recv() {
+                deliver(item, &counter);
+            }
+        });
+        Self { sender, dropped }
+    }
+
+    fn push(&self, item: T) -> bool {
+        let queued = self.sender.try_send(item).is_ok();
+        if !queued {
+            self.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+        queued
+    }
+}
+
+fn with_dropped(mut payload: Value, dropped: &AtomicUsize) -> Value {
+    let dropped = dropped.swap(0, Ordering::Relaxed);
+    if dropped > 0 {
+        payload["dropped"] = dropped.into();
+    }
+    payload
+}
+
+struct TerminalEvent {
+    event: &'static str,
+    payload: Value,
+    thread: Option<String>,
+    epoch: u64,
+}
+
+impl TerminalEvent {
+    fn capture(event: &'static str, payload: Value) -> Self {
+        let (thread, epoch) =
+            with(|state| (state.thread.clone(), CONTEXT_EPOCH.load(Ordering::Acquire)));
+        Self {
+            event,
+            payload,
+            thread,
+            epoch,
+        }
+    }
+
+    fn deliver(self, dropped: &AtomicUsize) {
+        let Self {
+            event,
+            payload,
+            thread,
+            epoch,
+        } = self;
+        if event != "view" || payload["view"] != "thread" {
+            crate::mod_runtime::broadcast_event(event, with_dropped(payload, dropped));
+            return;
+        }
+        let current = Arc::new(move || {
+            with(|state| CONTEXT_EPOCH.load(Ordering::Acquire) == epoch && state.thread == thread)
+        });
+        crate::mod_runtime::broadcast_event_guarded(event, with_dropped(payload, dropped), current);
+    }
+}
+
+pub(crate) fn terminal_event(event: &'static str, payload: Value) {
+    static QUEUE: std::sync::OnceLock<EventQueue<TerminalEvent>> = std::sync::OnceLock::new();
+    let queued = TerminalEvent::capture(event, payload);
+    if registered(event) {
+        QUEUE
+            .get_or_init(|| EventQueue::spawn(TerminalEvent::deliver))
+            .push(queued);
+    }
+}
+
+/// Pointer input on a raster, and key input on a keys component, bound to a managed process goes to its stdin instead of a callback.
+pub(crate) fn to_process(thread: Option<&str>, owner: Option<&str>, payload: &Value) -> bool {
+    use codex_omd::process_raster::Role;
+    if crate::mod_module::accept(payload) {
+        return true;
+    }
+    let Some(component) = payload["component"].as_str() else {
+        return false;
+    };
+    let Some(owner) = owner else {
+        return false;
+    };
+    let Some((role, _, sink)) = codex_omd::process_raster::target(thread, owner, component) else {
+        return false;
+    };
+    let message = match (Some(role), payload["kind"].as_str()) {
+        (Some(Role::Raster), Some("pointer")) => {
+            let pointer = &payload["pointer"];
+            let at = crate::mod_raster::pixel(
+                component,
+                pointer["column"].as_i64().unwrap_or(-1),
+                pointer["row"].as_i64().unwrap_or(-1),
+                pointer["half"].as_u64(),
+                pointer["fraction"][0]
+                    .as_f64()
+                    .zip(pointer["fraction"][1].as_f64()),
+            );
+            json!({"pointer": {"action": pointer["action"], "button": pointer["button"],
+                "x": at.map(|at| at.0), "y": at.map(|at| at.1), "inside": at.is_some_and(|at| at.2)}})
+        }
+        (Some(Role::Keys), Some("input")) => json!({"input": payload["events"]}),
+        _ => return false,
+    };
+    sink(message);
+    true
+}
+
+/// Delivers a `component_event` to the component's owner only.
+pub(crate) fn component_event(payload: Value) {
+    owned_component_event(None, payload);
+}
+
+/// Layout tab and resize events go to the mod whose view claimed the layout.
+pub(crate) fn layout_event(owner: &str, payload: Value) {
+    owned_component_event(Some(owner.to_owned()), payload);
+}
+
+fn owned_component_event(owner: Option<String>, payload: Value) {
+    static QUEUE: std::sync::OnceLock<EventQueue<(Option<String>, Value)>> =
+        std::sync::OnceLock::new();
+    if registered("component_event") || codex_omd::process_raster::any() {
+        let queue = QUEUE.get_or_init(|| {
+            EventQueue::spawn(|(owner, payload): (Option<String>, Value), dropped| {
+                let mut payload = if payload["kind"] == "motion" {
+                    let Some(latest) = payload["component"]
+                        .as_str()
+                        .and_then(|component| motion().remove(component))
+                    else {
+                        return;
+                    };
+                    latest
+                } else {
+                    payload
+                };
+                if let Some(pointer) = payload["pointer"].as_object_mut() {
+                    pointer.remove("fraction");
+                }
+                if let Some(owner) = owner {
+                    crate::mod_runtime::invoke_event(
+                        &owner,
+                        "component_event",
+                        with_dropped(payload, dropped),
+                    );
+                }
+            })
+        });
+        let owner = owner.or_else(|| {
+            payload["component"]
+                .as_str()
+                .and_then(crate::mod_ui::component_owner)
+        });
+        if let Some(pending) = close_motion(&payload) {
+            queue.push((owner.clone(), pending));
+        }
+        let marker = (payload["kind"] == "motion")
+            .then(|| payload["component"].as_str().map(str::to_owned))
+            .flatten();
+        // A dropped marker releases its pending motion, so the next move queues a new one.
+        if !queue.push((owner, payload))
+            && let Some(component) = marker
+        {
+            motion().remove(&component);
+        }
+    }
+}
+
+/// A queued non-motion event closes its component's pending motion, which then delivers ahead of it.
+fn close_motion(payload: &Value) -> Option<Value> {
+    if payload["kind"] == "motion" {
+        return None;
+    }
+    motion().remove(payload["component"].as_str()?)
+}
+
+fn motion() -> MutexGuard<'static, BTreeMap<String, Value>> {
+    static MOTION: Mutex<BTreeMap<String, Value>> = Mutex::new(BTreeMap::new());
+    MOTION.locked()
+}
+
+/// Pointer motion is latest-wins per component: one queued marker delivers the newest position.
+pub(crate) fn pointer_motion(component: &str, payload: Value) {
+    if (registered("component_event") || codex_omd::process_raster::any())
+        && motion().insert(component.to_owned(), payload).is_none()
+    {
+        component_event(json!({"component": component, "kind": "motion"}));
+    }
+}
+
+const INPUT_BATCH_EVENTS: usize = 64;
+const INPUT_BATCH_BYTES: usize = 64 * 1024;
+
+static INPUT_DROPPED: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+pub(crate) fn input_event(
+    thread: Option<&str>,
+    owner: Option<&str>,
+    component: &str,
+    event: Value,
+) {
+    if to_process(
+        thread,
+        owner,
+        &json!({"component": component, "kind": "input", "events": [event]}),
+    ) {
+        return;
+    }
+    static QUEUE: std::sync::OnceLock<std::sync::mpsc::SyncSender<(String, Value)>> =
+        std::sync::OnceLock::new();
+    if registered("component_event") || codex_omd::process_raster::any() {
+        let queue = QUEUE.get_or_init(|| {
+            let (sender, receiver) = std::sync::mpsc::sync_channel::<(String, Value)>(EVENT_QUEUE);
+            std::thread::spawn(move || {
+                while let Ok(first) = receiver.recv() {
+                    let mut pending = vec![first];
+                    pending.extend(receiver.try_iter());
+                    let dropped = INPUT_DROPPED.swap(0, std::sync::atomic::Ordering::Relaxed);
+                    for payload in input_batches(pending, dropped) {
+                        if let Some(owner) = payload["component"]
+                            .as_str()
+                            .and_then(crate::mod_ui::component_owner)
+                        {
+                            crate::mod_runtime::invoke_event(&owner, "component_event", payload);
+                        }
+                    }
+                }
+            });
+            sender
+        });
+        if queue.try_send((component.to_owned(), event)).is_err() {
+            INPUT_DROPPED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+fn input_batches(pending: Vec<(String, Value)>, dropped: usize) -> Vec<Value> {
+    let mut pending = std::collections::VecDeque::from(pending);
+    let mut batches = Vec::new();
+    while let Some((component, event)) = pending.pop_front() {
+        let mut bytes = event.to_string().len();
+        let mut events = vec![event];
+        while let Some((next, event)) = pending.front()
+            && *next == component
+            && events.len() < INPUT_BATCH_EVENTS
+            && bytes + event.to_string().len() <= INPUT_BATCH_BYTES
+        {
+            if let Some((_, event)) = pending.pop_front() {
+                bytes += event.to_string().len();
+                events.push(event);
+            }
+        }
+        let mut payload = json!({"component": component, "kind": "input", "events": events});
+        if dropped > 0 && batches.is_empty() {
+            payload["dropped"] = dropped.into();
+        }
+        batches.push(payload);
+    }
+    batches
+}
+
+static DISPLAY_ACTIVE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+pub(crate) fn display_active() -> bool {
+    DISPLAY_ACTIVE.load(Ordering::Acquire)
+}
