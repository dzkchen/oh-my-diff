+        let home = tempfile::tempdir().unwrap();
+        let config = config(home.path()).await;
+        let auth = AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            home.path().to_path_buf(),
+        );
+        let provider =
+            config.model_providers[codex_model_provider_info::OPENAI_PROVIDER_ID].clone();
+        let mut hidden = info("fixture-hidden", Some(200_000), None);
+        hidden.visibility = ModelVisibility::Hide;
+        let entry = codex_model_provider::test_support::models_cache_entry(
+            &provider,
+            auth.auth_cached().as_ref(),
+            vec![info("fixture-live-only", Some(333_000), None), hidden],
+        );
+        std::fs::write(
+            home.path().join("models_cache.json"),
+            serde_json::to_vec(&entry).unwrap(),
+        )
+        .unwrap();
+        let catalog = load_chatgpt_catalog(&config, auth).await.unwrap();
+        assert!(
+            catalog
+                .models
+                .iter()
+                .any(|model| model.model == "fixture-live-only")
+        );
+        assert!(
+            catalog
+                .infos
+                .iter()
+                .any(|model| model.slug == "fixture-live-only")
+        );
+        assert!(
+            !catalog
+                .models
+                .iter()
+                .any(|model| model.model == "fixture-hidden" && model.show_in_picker)
+        );
+    }
+
+    #[tokio::test]
+    async fn choosing_a_model_needs_chatgpt_auth_not_an_api_key() {
+        let home = tempfile::tempdir().unwrap();
+        let config = config(home.path()).await;
+        let auth = AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::from_api_key("sk-fixture"),
+            home.path().to_path_buf(),
+        );
+        assert_eq!(
+            load_chatgpt_catalog(&config, auth).await.err(),
+            Some(NEEDS_CHATGPT_CATALOG.to_owned())
+        );
+    }
+}
