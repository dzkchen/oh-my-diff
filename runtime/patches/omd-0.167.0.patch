+impl App {
+    pub(super) fn forward_mod_notification(&self, notification: &ServerNotification) {
+        match notification {
+            ServerNotification::ThreadDeleted(deleted) => {
+                if let Some(store) = crate::omd::store_root() {
+                    let _ = codex_omd::data_store::remove_thread_data(&store, &deleted.thread_id);
+                }
+            }
+            ServerNotification::ServerRequestResolved(resolved) => {
+                if let Ok(request_id) = serde_json::to_value(&resolved.request_id) {
+                    crate::mod_surface::server_request_resolved(request_id);
+                }
+            }
+            _ => {}
+        }
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(notification)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::notification(
+                &method,
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    pub(super) fn forward_mod_server_request(&self, request: &ServerRequest) {
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(request)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::server_request(
+                &method,
+                value.remove("id").unwrap_or(Value::Null),
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    fn mod_shell_command(
+        &self,
+        caller: &str,
+        arguments: &Value,
+        pin: Option<&Pin>,
+    ) -> Result<
+        (
+            std::process::Command,
+            std::path::PathBuf,
+            Option<crate::mod_pty::SessionDir>,
+        ),
+        String,
+    > {
+        let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+        if arguments["sandbox"] == "none" {
+            let access = crate::mod_runtime::os_access(caller).ok_or("capability_denied: os")?;
+            if !arguments["network"].is_null() || !arguments["write"].is_null() {
+                return Err("pty_unrestricted_arguments_invalid".into());
+            }
+            let cwd = paths
+                .repository
+                .join(arguments["cwd"].as_str().unwrap_or("."))
+                .canonicalize()
+                .map_err(|_| "pty_cwd_invalid")?;
+            let mut argv = crate::mod_pty::argv(arguments)?;
+            let program =
+                codex_omd::host::unrestricted_program(&access, &argv[0], &paths.repository)?;
+            let store = paths.store;
+            let pin = pin
+                .filter(|pin| pin.program == program)
+                .ok_or("pty_program_unpinned")?;
+            let hash = codex_omd::host::program_hash(&program)?;
+            if hash != pin.hash || arguments["sha256"].as_str().is_some_and(|sha| sha != hash) {
+                return Err("pty_program_changed".into());
+            }
+            let environment = crate::mod_runtime::exec_environment(caller);
+            let mut command =
+                codex_omd::host::unrestricted_command(&access, &program, &environment)?;
+            let home = std::env::var_os("HOME").ok_or("pty_home_unavailable")?;
+            let dir = crate::mod_pty::prepare(&store, true, arguments, &mut argv)?;
+            command.args(&argv[1..]).current_dir(cwd);
+            return Ok((command, home.into(), dir));
+        }
+        if !arguments["sandbox"].is_null() {
+            return Err("pty_sandbox_invalid".into());
+        }
+        let policy = self.chat_widget.mod_context().policy;
+        let cwd = paths
+            .repository
+            .join(arguments["cwd"].as_str().unwrap_or("."))
+            .canonicalize()
+            .map_err(|_| "pty_cwd_invalid")?;
+        if !cwd.starts_with(&paths.repository) || !cwd.is_dir() {
+            return Err("pty_cwd_invalid".into());
+        }
+        let store = paths.store.clone();
+        let scratch = store.join("pty-scratch");
+        std::fs::create_dir_all(&scratch).map_err(|error| error.to_string())?;
+        let loopback = match arguments["network"].as_str() {
+            None if arguments["network"].is_null() => false,
+            Some("loopback") => true,
+            _ => return Err("pty_network_invalid".into()),
+        };
+        let mut argv = crate::mod_pty::argv(arguments)?;
+        let program = codex_omd::host::resolve_program(&argv[0], &paths.repository)
+            .ok_or("pty_program_unavailable")?;
+        if let Some(expected) = arguments["sha256"].as_str()
+            && codex_omd::host::program_hash(&program)? != expected
+        {
+            return Err("pty_program_changed".into());
+        }
+        argv[0] = program.to_string_lossy().into_owned();
+        let dir = crate::mod_pty::prepare(&store, false, arguments, &mut argv)?;
+        let mut command = crate::mod_runtime::sandboxed_command(
+            &paths,
+            &policy,
+            argv,
+            &scratch,
+            arguments["write"] == true,
+            loopback,
+        )?;
+        command.current_dir(cwd);
+        Ok((command, scratch, dir))
+    }
+
+    pub(super) async fn handle_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+        binding: Option<crate::mod_pty::Binding>,
+    ) {
+        if let Err(error) = crate::mod_surface::validate_call_classified(&call) {
+            call.reply_blit(Err(error));
+            return;
+        }
+        if call.operation == "terminal.pty"
+            && !binding.as_ref().is_some_and(crate::mod_pty::current)
+        {
+            let _ = call.reply.send(Err("pty_context_changed".into()));
+            return;
+        }
+        if call.operation == "routes.add" || call.operation == "routes.models" {
+            let mod_id = match route_mod(&call) {
+                Ok(mod_id) => mod_id,
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                    return;
+                }
+            };
+            if call.operation == "routes.add" && call.arguments["model"].is_null() {
+                match self.route_model(&call.arguments) {
+                    Ok(chosen) => self.confirm_route(call, mod_id, chosen),
+                    Err(error) => {
+                        let _ = call.reply.send(Err(error));
+                    }
+                }
+                return;
+            }
+            let (config, events) = (self.config.clone(), self.app_event_tx.clone());
+            tokio::spawn(async move {
+                let catalog = chatgpt_catalog(config).await;
+                if call.operation == "routes.models" {
+                    let _ = call.reply.send(catalog.map(|catalog| catalog.listed()));
+                } else {
+                    let planned = catalog.and_then(|catalog| catalog.route(&call.arguments));
+                    events.send(AppEvent::ModRoutePlanned {
+                        call: Box::new(call),
+                        mod_id,
+                        planned,
+                    });
+                }
+            });
+            return;
+        }
+        if call.operation == "routes.write" {
+            let planned = store_paths().and_then(|(store, repository)| {
+                codex_omd::route_writes::plan(&store, &repository, &call.caller, &call.arguments)
+            });
+            match planned {
+                Ok((_, changes)) if changes.is_empty() => {
+                    let _ = call
+                        .reply
+                        .send(Ok(json!({"routes": [], "services": [], "unchanged": true})));
+                }
+                Ok((write, changes)) => {
+                    let title = format!("Let {} change its model routes?", call.caller);
+                    let prompt = format!(
+                        "{}\n\nIt stays in host.json in your mod store until the mod or you change it.",
+                        changes.join("\n")
+                    );
+                    self.confirm_mod_surface_call(
+                        call,
+                        Some(title),
+                        prompt,
+                        Some(Confirmed::RouteWrite(Box::new(write))),
+                    );
+                }
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+            return;
+        }
+        if let Some(binding) = &binding
+            && call.arguments["action"] == "start"
+            && call.arguments["sandbox"] == "none"
+        {
+            let (program, hash, store) =
+                match unrestricted_pty_program(&call.caller, &call.arguments) {
+                    Ok(found) => found,
+                    Err(error) => {
+                        let _ = call.reply.send(Err(error));
+                        return;
+                    }
+                };
+            let previous = codex_omd::program_trust::pinned(&store, &call.caller, &program);
+            let stored = previous.as_deref() == Some(hash.as_str());
+            let (title, prompt) = codex_omd::program_trust::prompt(
+                &call.caller,
+                &program,
+                &hash,
+                previous.as_deref(),
+            );
+            let held = Some(Confirmed::Pty(
+                binding.clone(),
+                Some(Pin {
+                    program,
+                    hash,
+                    stored,
+                }),
+                None,
+            ));
+            if stored {
+                self.run_mod_surface_call(tui, app_server, call, held).await;
+            } else {
+                self.confirm_mod_surface_call(call, Some(title), prompt, held);
+            }
+            return;
+        }
+        if let Some(binding) = &binding
+            && call.arguments["action"] == "start"
+            && call.arguments["sandbox"].is_null()
+        {
+            let approval = store_paths().and_then(|(store, repository)| {
+                PtyApproval::new(&store, &repository, &call.caller, &call.arguments)
+            });
+            match approval {
+                Ok(approval) => {
+                    let stored = approval.stored();
+                    let held = Some(Confirmed::Pty(
+                        binding.clone(),
+                        None,
+                        Some(Box::new(approval)),
+                    ));
+                    if stored {
+                        self.run_mod_surface_call(tui, app_server, call, held).await;
+                    } else {
+                        match crate::mod_pty::start_prompt(&call.caller, &call.arguments) {
+                            Ok(prompt) => self.confirm_mod_surface_call(call, None, format!("{prompt} Approval is remembered for this workspace and this command and access until its executable changes."), held),
+                            Err(error) => { let _ = call.reply.send(Err(error)); }
+                        }
+                    }
+                }
+                Err(error) => {
+                    let _ = call.reply.send(Err(error));
+                }
+            }
+            return;
+        }
+        match confirmation(&call) {
+            Ok(Some((title, prompt, held))) => {
+                let held = match binding {
+                    Some(binding) => Some(Confirmed::Pty(binding, None, None)),
+                    None => held,
+                };
+                self.confirm_mod_surface_call(call, title, prompt, held)
+            }
+            Ok(None) => {
+                let held = binding.map(|binding| Confirmed::Pty(binding, None, None));
+                self.run_mod_surface_call(tui, app_server, call, held).await
+            }
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
