+impl NewThreadRoute {
+    fn read(&self) -> Result<serde_json::Value> {
+        color_eyre::eyre::ensure!(
+            super::mod_surface::caller_source(&self.caller).as_deref() == Some(&self.source),
+            "route_owner_changed: select a route again"
+        );
