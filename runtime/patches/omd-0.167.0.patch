+/// `None` while the runtime is busy or the context moves on, so the render is asked again.
+pub(crate) fn render(input: Value) -> Option<Option<codex_omd::ModChain>> {
+    let _thread = codex_omd::StateThread::enter(crate::mod_surface::current_thread());
+    let Some(runtime) = lock_within(&HOST, LOCK_WAIT)?.clone() else {
+        return Some(None);
+    };
+    match codex_omd::render_shared(&runtime, input, context_unchanged().1) {
+        Err(error)
+            if ["mod_runtime_busy", "callback_cancelled"]
+                .iter()
+                .any(|retry| error.to_string().starts_with(retry)) =>
+        {
+            None
+        }
+        chain => Some(chain.ok()),
+    }
+}
+
+/// One frame step of a component module; `None` while the runtime is busy, so the step is asked again.
+pub(crate) fn component(owner: &str, module: &str, frame: Value) -> Option<Result<Value, String>> {
+    let _thread = codex_omd::StateThread::enter(crate::mod_surface::current_thread());
+    let Some(runtime) = lock_within(&HOST, LOCK_WAIT)?.clone() else {
+        return Some(Err("mods are not running".to_owned()));
+    };
+    match codex_omd::component_shared(&runtime, owner, module, frame, context_unchanged().1) {
+        Err(error) if error.to_string().starts_with("callback_cancelled") => None,
+        result => Some(result.map_err(|error| error.to_string())),
+    }
+}
+
+/// Asked from the draw loop, so it never waits: a busy runtime answers `None` and the next frame asks again.
+pub(crate) fn render_hooked() -> Option<bool> {
+    let runtime = lock_within(&HOST, std::time::Duration::ZERO)?.clone()?;
+    let runtime = lock_within(&runtime, std::time::Duration::ZERO)?;
+    Some(runtime.intercepts("render").is_some())
+}
+
+pub(crate) fn run(
+    target: &ModSlashTarget,
+    args: &str,
+    invocation: &ModInvocation,
+) -> Result<ModCommandResult, String> {
+    let paths = crate::omd::mod_paths_for(&invocation.context.repository)
+        .ok_or("mods are not configured for this session")?;
+    let active = || current(invocation);
+    if !active() {
+        return Err("callback_cancelled".to_owned());
+    }
+    let ModSlashTarget { id, command } = target;
+    let runtime = shared_host()?;
+    let thread = invocation.context.thread_id.map(|id| id.to_string());
+    let _thread = codex_omd::StateThread::enter(thread.clone());
+    let scope = CallScope {
+        epoch: invocation.epoch,
+        context: codex_omd::app_routes::InvocationContext::User,
+        thread: thread.as_deref(),
+        active: {
+            let invocation = invocation.clone();
+            Arc::new(move || current(&invocation))
+        },
+    };
+    let mut retried = false;
+    let (generation, value) = loop {
+        let (generation, grants) = {
+            let mut runtime = runtime.locked();
+            reload(&mut runtime);
+            (runtime.generation(), owner_grants(&runtime))
+        };
+        let mut wrote = false;
+        let result = codex_omd::invoke_shared(
+            &runtime,
+            id,
+            generation,
+            "command",
+            command,
+            Value::String(args.to_owned()),
+            codex_omd::ModInvokeOptions {
+                active: &active,
+                host: codex_omd::ModHostCallback::Scoped(&mut |caller, call| {
+                    wrote |= !codex_omd::read_only_call(&call);
+                    crate::mod_surface::host_call(
+                        &paths,
+                        &invocation.context.policy,
+                        grants.get(caller).cloned(),
+                        caller,
+                        call,
+                        &scope,
+                    )
+                }),
+                ..codex_omd::ModInvokeOptions::default()
+            },
+        );
+        // A reload during the callback discards its result; when it only read, running it again repeats nothing.
+        match result {
+            Err(error)
+                if !wrote && !retried && error.to_string().starts_with("stale_mod_generation") =>
+            {
+                retried = true;
+            }
+            result => break (generation, result.map_err(|error| error.to_string())?),
+        }
+    };
+    if !active() {
+        return Err("callback_cancelled".to_owned());
+    }
+    let outcome = ModCommandOutcome::parse(&value).map_err(|e| e.to_string())?;
+    let preview = preview_with(
+        &mut runtime.locked(),
+        &paths,
+        &invocation.context,
+        outcome
+            .terminal
+            .clone()
+            .map(|patch| (id.as_str(), generation, patch)),
+        &active,
+    );
+    Ok(ModCommandResult {
+        refresh: outcome.terminal.as_ref().map(|_| invocation.clone()),
+        value,
+        outcome,
+        preview,
+    })
+}
+
+type Composed = (String, Vec<Value>, Vec<Value>);
+
+static COMPOSED: Mutex<Option<Composed>> = Mutex::new(None);
+
+fn composition_key(runtime: &ModHost) -> String {
+    format!(
+        "{}:{}",
+        runtime.configuration_sha256(),
+        runtime.generation()
+    )
+}
+
+/// Applies `command_list` interceptors to the command rows off the UI thread; until they answer, the last composition of the same rows or else the rows stand in.
+pub(crate) fn composed_commands(rows: Vec<Value>) -> Vec<Value> {
+    let Some(runtime) = lock_within(&HOST, Duration::ZERO).and_then(|host| host.clone()) else {
+        return rows;
+    };
+    let key = lock_within(&runtime, Duration::ZERO).map(|runtime| composition_key(&runtime));
+    let cached = COMPOSED
+        .locked()
+        .as_ref()
+        .and_then(|(cached, same, composed)| {
+            (*same == rows).then(|| {
+                (
+                    key.as_ref().is_none_or(|key| key == cached),
+                    composed.clone(),
+                )
+            })
+        });
+    match cached {
+        Some((true, composed)) => composed,
+        Some((false, composed)) => {
+            compose_later(rows);
+            composed
+        }
+        None => {
+            compose_later(rows.clone());
+            rows
+        }
+    }
+}
+
+fn compose_later(rows: Vec<Value>) {
+    static PENDING: Mutex<(bool, Option<Vec<Value>>)> = Mutex::new((false, None));
+    in_background(&PENDING, rows, |rows| {
+        let Ok(runtime) = shared_host() else {
+            return;
+        };
+        let key = {
+            let mut runtime = runtime.locked();
+            reload(&mut runtime);
+            composition_key(&runtime)
+        };
+        if COMPOSED
+            .locked()
+            .as_ref()
+            .is_some_and(|(cached, same, _)| *cached == key && *same == rows)
+        {
+            return;
+        }
+        let composed = codex_omd::compose_rows(
+            &runtime,
+            "command_list",
+            "commands",
+            "command",
+            rows.clone(),
+        )
+        .unwrap_or_else(|_| rows.clone());
+        *COMPOSED.locked() = Some((key, rows, composed));
+        codex_omd::client_surface::redraw();
+    });
+}
+
+pub(crate) fn command_label(command: &str, fallback: &str) -> String {
+    let cache = COMPOSED.locked();
+    let Some(row) = cache
+        .as_ref()
+        .and_then(|(_, _, rows)| rows.iter().find(|row| row["command"] == command))
+    else {
+        return fallback.to_owned();
+    };
+    let description = row["description"].as_str().unwrap_or(fallback);
+    match row["args_hint"].as_str() {
+        Some(hint) => format!("{description} · {hint}"),
+        None => description.to_owned(),
+    }
+}
+
+static KNOWN_INTERCEPTS: Mutex<BTreeMap<String, Option<bool>>> = Mutex::new(BTreeMap::new());
+
+/// Never waits for a busy runtime, except within the keystroke budget for a surface never looked up.
+pub(crate) fn intercepts(surface: &str) -> bool {
+    if crate::omd::mod_paths().is_none() {
+        return false;
+    }
+    let wait = if KNOWN_INTERCEPTS.locked().contains_key(surface) {
+        Duration::ZERO
+    } else {
+        KEY_BUDGET
+    };
+    let fresh = lock_within(&HOST, Duration::ZERO)
+        .and_then(|host| host.clone())
+        .and_then(|runtime| lock_within(&runtime, wait).map(|runtime| runtime.intercepts(surface)));
+    remembered_intercept(surface, fresh).is_some()
+}
+
+/// A busy runtime answers from the last lookup; a surface never looked up fails closed as if a required interceptor selected it.
+fn remembered_intercept(surface: &str, fresh: Option<Option<bool>>) -> Option<bool> {
+    let mut known = KNOWN_INTERCEPTS.locked();
+    match fresh {
+        Some(intercepts) => {
+            known.insert(surface.to_owned(), intercepts);
+            intercepts
+        }
+        None => known.get(surface).copied().unwrap_or(Some(true)),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn run_command(
+    command: &str,
+    args: &str,
+    target: Option<&ModSlashTarget>,
+    immediate: bool,
+    active_turn: bool,
+    caller: &str,
+    invocation: &ModInvocation,
+    mut builtin: impl FnMut(String) -> Result<Value, String>,
+) -> Result<ModCommandResult, String> {
+    if active_turn && !immediate && target.is_some() {
+        return Err(format!("command_unavailable_during_turn: /{command}"));
+    }
+    let input = serde_json::json!({"command": command, "args": args,
+        "owner": target.map(|target| target.id.clone()), "immediate": immediate, "active_turn": active_turn});
+    let mut ran = None;
+    let mut core = |effective: Value| {
+        let args = effective["args"].as_str().unwrap_or_default().to_owned();
+        let value = match target {
+            Some(target) => {
+                let result = run(target, &args, invocation).map_err(std::io::Error::other)?;
+                let value = result.value.clone();
+                ran = Some(result);
+                value
+            }
+            None => builtin(args).map_err(std::io::Error::other)?,
+        };
+        Ok(serde_json::json!({"result": value}))
+    };
+    // Protected built-ins never reach the mod runtime, so recovery works even when it is broken.
+    let result = if target.is_none() && codex_omd::PROTECTED_COMMANDS.contains(&command) {
+        core(input)
+    } else {
+        let paths = crate::omd::mod_paths_for(&invocation.context.repository)
+            .ok_or("mods are not configured for this session")?;
+        let runtime = shared_host()?;
+        let grants = {
+            let mut runtime = runtime.locked();
+            reload(&mut runtime);
+            owner_grants(&runtime)
+        };
+        let active = || current(invocation);
+        let thread = invocation.context.thread_id.map(|id| id.to_string());
+        let scope = CallScope {
+            epoch: invocation.epoch,
+            context: codex_omd::app_routes::InvocationContext::User,
+            thread: thread.as_deref(),
+            active: {
+                let invocation = invocation.clone();
+                Arc::new(move || current(&invocation))
+            },
+        };
+        codex_omd::continue_operation(
+            &runtime,
+            "command",
+            input,
+            serde_json::json!({"caller": caller, "thread_id": thread}),
+            active,
+            |caller, call| {
+                crate::mod_surface::host_call(
+                    &paths,
+                    &invocation.context.policy,
+                    grants.get(caller).cloned(),
+                    caller,
+                    call,
+                    &scope,
+                )
+            },
+            core,
+        )
+    }
+    .map_err(|error| error.to_string())?;
+    let value = &result["result"];
+    match ran {
+        Some(ran) if &ran.value == value => Ok(ran),
+        _ => Ok(ModCommandResult {
+            refresh: None,
+            outcome: ModCommandOutcome::parse(value).unwrap_or_default(),
+            value: value.clone(),
+            preview: None,
+        }),
+    }
+}
