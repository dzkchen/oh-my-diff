+/// Runs `cell`'s native drawing through the matching mod `render` hooks, telling tool rows whether the user expanded them; the flag reports whether a hook replaced the native drawing.
+pub(crate) fn hooked_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: bool,
+    draw: impl FnOnce(&C, u16) -> Vec<HyperlinkLine>,
+) -> (Vec<HyperlinkLine>, bool) {
+    let expanded_ids = if expanded {
+        cell.activity_ids().into_iter().collect()
+    } else {
+        Default::default()
+    };
+    if let Some(members) = hooked_member_lines(cell, width, &expanded_ids) {
+        return (
+            members
+                .into_iter()
+                .flat_map(|member| member.lines)
+                .collect(),
+            true,
+        );
+    }
+    match cell.render_target() {
+        Some(mut target) => {
+            if target.component == "tool_call" {
+                target.props["expanded"] = serde_json::Value::Bool(expanded);
+            }
+            let (mut lines, replaced) =
+                crate::mod_render::hyperlink_lines(&target, width, |props, width| {
+                    cell.render_native(props, draw(cell, width))
+                });
+            lines.extend(crate::mod_render::tool_notice_lines(&target));
+            (lines, replaced)
+        }
+        None => (draw(cell, width), false),
+    }
+}
