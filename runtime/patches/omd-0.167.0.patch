+    fn route_model(&self, arguments: &Value) -> Result<(String, String, u64), String> {
+        if !arguments["effort"].is_null() {
+            return Err("routes_add_effort_needs_model".into());
+        }
+        if !self.chat_widget.has_chatgpt_account() || !self.chat_widget.requires_openai_auth {
+            return Err(
+                "routes_add_needs_chatgpt: sign in to Codex with ChatGPT and chat with a model on your plan".into(),
+            );
+        }
+        let effort = self
+            .chat_widget
+            .current_reasoning_effort()
+            .map_or_else(|| "medium".to_owned(), |effort| effort.to_string());
+        let context_window = self
+            .chat_widget
+            .status_line_context_window_size()
+            .and_then(|window| u64::try_from(window).ok())
+            .unwrap_or(STANDARD_CONTEXT_WINDOW);
+        Ok((
+            self.chat_widget.current_model().to_owned(),
+            effort,
+            context_window,
+        ))
+    }
