+            Some((4, 2)),
+            &json!({"key": key, "rect": {"x": 2, "y": 1, "width": 2, "height": 1},
+                "packed": packed(&[('c', 0x00ff_0000, 0x0100_0000), ('d', 0x0100_0000, 0x0200_0004)])}),
+            at(2),
+            |_, _| unreachable!(),
+        )
+        .expect("packed queued"),
+        cells(
