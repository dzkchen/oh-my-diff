+async fn assess_exec_command(
+    invocation: &ToolInvocation,
+    lifetime: ExecCommandLifetime,
+) -> Result<crate::tools::registry::ToolAssessment, String> {
+    let ToolPayload::Function { arguments } = &invocation.payload else {
+        return Err("exec_command takes function arguments".into());
+    };
+    let turn_environment = selected_executor(
+        &invocation.environments,
+        &invocation.step_context.environments,
+    )
+    .map_err(|error| error.to_string())?;
+    let prepared = ParsedExecCommand::parse(
+        arguments,
+        &invocation.session,
+        &invocation.step_context,
+        turn_environment,
+    )
+    .and_then(|parsed| parsed.prepare(lifetime))
+    .map_err(|error| error.to_string())?;
+    let requirement = prepared
+        .approval_requirement(&invocation.session, &invocation.step_context)
+        .await;
+    let overridable = matches!(
+        requirement,
+        crate::tools::sandboxing::ExecApprovalRequirement::Forbidden { .. }
+    ) && invocation
+        .session
+        .services
+        .exec_policy
+        .forbidden_only_by_user_rules(
+            &prepared.resolved.command,
+            prepared.turn_environment.config().exec_policy.as_ref(),
+        );
+    let action = prepared.approval_action(&invocation.call_id, &requirement);
+    Ok(crate::tools::registry::ToolAssessment {
+        requirement,
+        action: Some(action),
+        overridable,
+    })
+}
