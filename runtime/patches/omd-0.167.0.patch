+    /// Reports what a submitted prompt expanded to by name, path and digest, never by content.
+    pub(crate) async fn notify_prompt_expanded(
+        &self,
+        turn_context: &TurnContext,
+        input: &[codex_protocol::user_input::UserInput],
+    ) {
+        use codex_protocol::user_input::UserInput;
+        use sha2::Digest;
+        let digest = |bytes: &[u8]| format!("{:x}", sha2::Sha256::digest(bytes));
+        let mut items = Vec::new();
+        for item in input {
+            match item {
+                UserInput::Skill { name, path } => {
+                    let content = tokio::fs::read(path).await.unwrap_or_default();
+                    items.push(serde_json::json!({"kind": "skill", "name": name,
+                        "source": path.display().to_string(), "sha256": digest(&content)}));
+                }
+                UserInput::Mention { name, path } => {
+                    items
+                        .push(serde_json::json!({"kind": "mention", "name": name, "source": path}));
+                }
+                UserInput::LocalImage { path, .. } => {
+                    items.push(
+                        serde_json::json!({"kind": "image", "source": path.display().to_string()}),
+                    );
+                }
+                UserInput::Text {
+                    text,
+                    text_elements,
+                } => {
+                    for element in text_elements {
+                        let range = element.byte_range.start..element.byte_range.end;
+                        let Some(content) = text.get(range.clone()) else {
+                            continue;
+                        };
+                        let kind = if element
+                            .placeholder(text)
+                            .is_some_and(|placeholder| placeholder.starts_with("[Image"))
+                        {
+                            "image"
+                        } else {
+                            "paste"
+                        };
+                        items.push(serde_json::json!({"kind": kind, "start": range.start,
+                            "end": range.end, "bytes": content.len(),
+                            "sha256": digest(content.as_bytes())}));
+                    }
+                }
+                _ => {}
+            }
+        }
+        if items.is_empty() {
+            return;
+        }
+        for contributor in self.services.extensions.turn_lifecycle_contributors() {
+            contributor
+                .on_prompt_expanded(codex_extension_api::PromptExpandedInput {
+                    turn_id: turn_context.sub_id.as_str(),
+                    items: &items,
+                    session_store: &self.services.session_extension_data,
+                    thread_store: &self.services.thread_extension_data,
+                    turn_store: turn_context.extension_data.as_ref(),
+                })
+                .await;
+        }
+    }
