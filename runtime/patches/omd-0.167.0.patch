+#[tokio::test]
+async fn mod_prompts_wait_for_input_held_across_reconnect() {
+    for confirmed in [false, true] {
+        let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.submit_user_message("first message".into());
+        let client_id = chat
+            .input_queue
+            .pending_user_message_client_id
+            .clone()
+            .unwrap();
+        chat.queue_user_message("follow-up".into());
+        chat.pause_for_disconnect();
+        assert_eq!(
+            chat.mod_submit_prompt("mod prompt".into(), Vec::new(), "mod-1".into(), false),
+            Err("input_held".into())
+        );
+        let mut input = chat.capture_thread_input_state();
+        input.as_mut().unwrap().reconnect_pending = true;
+        let (mut restored, _rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        restored.thread_id = Some(ThreadId::new());
+        let ids = if confirmed { vec![client_id] } else { vec![] };
+        restored.restore_reconnected_input(input, &ids);
+        assert_eq!(restored.maybe_send_next_queued_input(), confirmed);
+        if confirmed {
+            assert_matches!(next_submit_op(&mut ops), Op::UserTurn { items, .. }
+                if items == vec![UserInput::Text { text: "follow-up".into(), text_elements: Vec::new() }]);
+            assert_eq!(
+                restored.mod_submit_prompt("mod prompt".into(), Vec::new(), "mod-1".into(), false),
+                Err("busy".into())
+            );
+            assert!(!restored.has_queued_follow_up_messages());
+        } else {
+            assert_eq!(
+                restored.mod_submit_prompt("mod prompt".into(), Vec::new(), "mod-1".into(), false),
+                Err("input_held".into())
+            );
+            assert_eq!(
+                restored.queued_user_message_texts(),
+                vec!["first message", "follow-up"]
+            );
+        }
+        assert_no_submit_op(&mut ops);
+    }
+}
