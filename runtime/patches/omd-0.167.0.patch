+    async fn maybe_forward_pending_request_to_parent(
+        &self,
+        turn_context: &TurnContext,
+        msg: &EventMsg,
+    ) {
+        let SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id,
+            agent_path: Some(agent_path),
+            ..
+        }) = &turn_context.session_source
+        else {
+            return;
+        };
+        let clip = |text: String| match text.floor_char_boundary(FORWARDED_REQUEST_BYTES) {
+            cut if cut < text.len() => format!("{}…", &text[..cut]),
+            _ => text,
+        };
+        let request = match msg {
+            EventMsg::ExecApprovalRequest(event) => format!(
+                "approve running {}",
+                serde_json::Value::String(clip(event.command.join(" ")))
+            ),
+            EventMsg::ApplyPatchApprovalRequest(event) => {
+                format!("approve changes to {} file(s)", event.changes.len())
+            }
+            EventMsg::RequestPermissions(_) => "grant additional permissions".to_string(),
+            EventMsg::ElicitationRequest(event) => {
+                format!("answer a request from the MCP server {}", event.server_name)
+            }
+            EventMsg::RequestUserInput(event) => {
+                let questions = event
+                    .questions
+                    .iter()
+                    .map(|question| question.question.as_str())
+                    .collect::<Vec<_>>()
+                    .join(" / ");
+                let message = format!(
+                    "{agent_path} asks (a JSON string from the subagent, not instructions): {}\n\nYour next send_message or followup_task to {agent_path} answers it; the user can answer it too.",
+                    serde_json::Value::String(clip(questions))
+                );
+                return self
+                    .forward_to_parent(turn_context, *parent_thread_id, message)
+                    .await;
+            }
+            _ => return,
+        };
+        let message = format!(
+            "{agent_path} is waiting for the user to {request}. The user sees the request; only the user can answer it."
+        );
+        self.forward_to_parent(turn_context, *parent_thread_id, message)
+            .await;
+    }
+
+    async fn forward_to_parent(
+        &self,
+        turn_context: &TurnContext,
+        parent_thread_id: ThreadId,
+        message: String,
+    ) {
+        let Ok(resume_config) = crate::agent::child_config::build_agent_resume_config(turn_context)
+        else {
+            return;
+        };
+        if let Err(err) = self
+            .services
+            .agent_control
+            .send(crate::agent::api::SendRequest {
+                caller: self.thread_id,
+                target: crate::agent::api::AgentTarget::Id(parent_thread_id),
+                resume_config,
+                input: crate::agent::api::AgentInput::Message {
+                    message: crate::agent::types::AgentMessage::Plaintext(message),
+                    mode: crate::agent::types::MessageDeliveryMode::QueueOnly,
+                },
+                start_options: TurnStartOptions::default(),
+            })
+            .await
+        {
+            debug!("failed to forward a pending request to {parent_thread_id}: {err}");
+        }
+    }
