+#[test]
+#[serial_test::serial]
+fn startup_preview_survives_only_empty_bootstrap_and_yields_to_real_publications() {
+    let test_interaction = INTERACTION.capture();
+    let startup = codex_omd::ModViewSnapshot {
+        input: serde_json::json!({"event":"startup","ledger":null,
+            "presentation":{"thread_id":null,"phase":"fresh"}}),
+        view: codex_omd::ModView::parse(serde_json::json!({
+            "sites":{"dialog":{"components":[{"type":"text","id":"pending",
+                "label":"Pending preview","text":"pending"}]}}
+        }))
+        .unwrap(),
+        ..Default::default()
+    };
+    let empty = codex_omd::ModViewSnapshot::default();
+    assert!(super::preserve_preview(&startup, &empty));
+    let failed = codex_omd::ModViewSnapshot {
+        diagnostics: vec!["mod failed".into()],
+        ..Default::default()
+    };
+    assert!(!super::preserve_preview(&startup, &failed));
+    for event in ["start", "reload", "input_rejected", "turn_start"] {
+        let live_empty = codex_omd::ModViewSnapshot {
+            epoch: 1,
+            input: serde_json::json!({"event":event,"ledger":null,
+                "presentation":{"thread_id":"actual-thread","phase":"started"}}),
+            ..Default::default()
+        };
+        assert!(!super::preserve_preview(&startup, &live_empty), "{event}");
+    }
+    let welcome = snapshot(serde_json::json!({"sites":{"welcome":{"components":[{
+        "type":"button","id":"recipe","label":"Recipe","text":"Create project",
+        "action":{"command":"starter:create"}
+    }]}}}));
+    let repository = std::path::Path::new("/startup-pointer-fixture");
+    for replacement in [None, Some(ModViewSnapshot::default())] {
+        startup_preview(Some(welcome.clone()), repository);
+        let area = Rect::new(0, 0, 80, 12);
+        render_welcome(area, &mut Buffer::empty(area), &welcome);
+        let hitbox = test_interaction.lock().unwrap().hitboxes[0].area;
+        let click = MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column: hitbox.x,
+            row: hitbox.y,
+            modifiers: KeyModifiers::NONE,
+        };
+        assert!(matches!(pointer(click), Some(ModPointer::Action(_, _))));
+        startup_preview(replacement, repository);
+        assert!(pointer(click).is_none());
+        let interaction = test_interaction.lock().unwrap();
+        assert!(interaction.focused.is_none());
+        assert!(interaction.targets.is_empty());
+        assert!(interaction.order.is_empty());
+        assert!(interaction.hitboxes.is_empty());
+    }
+    startup_preview(None, repository);
+}
