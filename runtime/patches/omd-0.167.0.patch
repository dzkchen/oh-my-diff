+#[test]
+fn assistant_message_identity_distinguishes_equal_text_and_survives_reflow() {
+    let first = AgentMarkdownCell::new("same text".into(), &test_cwd())
+        .with_message_id(Some("message-one".into()))
+        .with_message_turn(Some("turn-one".into()));
+    let second = AgentMarkdownCell::new("same text".into(), &test_cwd())
+        .with_message_id(Some("message-two".into()))
+        .with_message_turn(Some("turn-one".into()));
+    let original = first.render_target().unwrap();
+    assert_eq!(original.props["message_id"], "turn-one:message-one");
+    assert_ne!(
+        original.props["message_id"],
+        second.render_target().unwrap().props["message_id"]
+    );
+    let reused = AgentMarkdownCell::new("same text".into(), &test_cwd())
+        .with_message_id(Some("message-one".into()))
+        .with_message_turn(Some("turn-two".into()));
+    assert_ne!(
+        original.props["message_id"],
+        reused.render_target().unwrap().props["message_id"]
+    );
+    first.display_lines(8);
+    first.display_lines(80);
+    assert_eq!(
+        original.props["message_id"],
+        first.render_target().unwrap().props["message_id"]
+    );
+    let streaming = StreamingAgentTailCell::new(vec![Line::from("partial").into()], true)
+        .with_message_id(Some("message-one".into()))
+        .with_message_turn(Some("turn-one".into()));
+    assert_eq!(
+        original.props["message_id"],
+        streaming.render_target().unwrap().props["message_id"]
+    );
+}
