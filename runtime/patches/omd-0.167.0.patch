+fn setup() -> (
+    tempfile::TempDir,
+    Accounts,
+    Arc<Task>,
+    Request,
+    EncodedJsonBody,
+) {
+    let root = tempfile::tempdir().unwrap();
+    let task = Arc::new(
+        Task::create(
+            Limits {
+                requests: 3,
+                exposure_microusd: 20000,
+                seconds: 30,
+                concurrent_workers: 2,
+                max_depth: 2,
+            },
