+#[cfg(not(test))]
+pub(crate) struct Shared<T>(T);
+
+#[cfg(not(test))]
+impl<T> Shared<T> {
+    pub(crate) const fn new(value: T) -> Self {
+        Self(value)
+    }
+
+    pub(crate) fn with<R>(&self, read: impl FnOnce(&T) -> R) -> R {
+        read(&self.0)
+    }
+}
+
+#[cfg(test)]
+pub(crate) struct TestShared<T: 'static>(
+    &'static std::thread::LocalKey<std::cell::RefCell<std::sync::Arc<T>>>,
+);
+
+#[cfg(test)]
+impl<T> TestShared<T> {
+    pub(crate) const fn new(
+        key: &'static std::thread::LocalKey<std::cell::RefCell<std::sync::Arc<T>>>,
+    ) -> Self {
+        Self(key)
+    }
+
+    pub(crate) fn capture(&self) -> std::sync::Arc<T> {
+        self.0.with(|value| value.borrow().clone())
+    }
+
+    pub(crate) fn replace(&self, value: std::sync::Arc<T>) {
+        self.0.with(|slot| *slot.borrow_mut() = value);
+    }
+
+    pub(crate) fn with<R>(&self, read: impl FnOnce(&T) -> R) -> R {
+        read(&self.capture())
+    }
+}
+
+macro_rules! isolated_static {
+    ($name:ident: $ty:ty = $value:expr) => {
+        #[cfg(not(test))]
+        static $name: crate::omd::Shared<$ty> = crate::omd::Shared::new($value);
+        #[cfg(test)]
+        static $name: crate::omd::TestShared<$ty> = {
+            std::thread_local! {
+                static VALUE: std::cell::RefCell<std::sync::Arc<$ty>> =
+                    std::cell::RefCell::new(std::sync::Arc::new($value));
+            }
+            crate::omd::TestShared::new(&VALUE)
+        };
+    };
+}
+pub(crate) use isolated_static;
