+                config
+                    .features
+                    .enable(feature)
+                    .expect("test config should allow feature update");
+            }
+        })
+        .build(&startup)
+        .await?;
+
+    turn(&test, "turn one").await?;
+    turn(&test, "spawn a researcher").await?;
+    for _ in 0..200 {
+        if !other_log.requests().is_empty() {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+
+    let child = other_log.requests();
+    assert_eq!(child.len(), 1);
+    assert_eq!(child[0].body_json()["model"], "spawn-other-model");
+    let hosted_search = |body: Value| {
+        body["tools"]
+            .to_string()
+            .contains("\"type\":\"web_search\"")
+    };
+    assert!(hosted_search(startup_log.requests()[0].body_json()));
+    assert!(!hosted_search(child[0].body_json()));
+    let input = child[0].input();
+    assert!(mentions(&input, "CHILD_TASK") && mentions(&input, "turn one"));
+    assert_eq!(reasoning_summaries(&input), Vec::<String>::new());
+    assert!(
+        startup_log
+            .requests()
+            .iter()
+            .all(|request| request.body_json()["model"] != "spawn-other-model")
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn spawned_base_model_agent_returns_to_the_configured_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let startup = start_mock_server().await;
+    let other = start_mock_server().await;
+    let _provider = runtime_provider("spawn_home", "spawn-home-model", &other);
+    let test = test_codex()
+        .with_config(|config| {
+            for feature in [Feature::Collab, Feature::MultiAgentV2] {
+                config
+                    .features
+                    .enable(feature)
+                    .expect("test config should allow feature update");
+            }
+        })
+        .build(&startup)
+        .await?;
+    let startup_model = test.session_configured.model.clone();
+    let spawn = sse(vec![
+        ev_function_call_with_namespace(
+            "spawn-1",
+            "collaboration",
+            "spawn_agent",
+            &json!({"task_name": "researcher", "message": "CHILD_TASK", "fork_turns": "all",
+                "model": startup_model})
+            .to_string(),
+        ),
+        ev_completed("b1"),
+    ]);
+    let other_log = mount_sse_sequence(&other, vec![spawn, reply("b2", "SPAWNED")]).await;
+    let startup_log = mount_sse_sequence(&startup, vec![reply("a1", "CHILD_DONE")]).await;
+
+    switch(&test, "spawn_home", "spawn-home-model").await?;
+    turn(&test, "spawn a researcher").await?;
+    for _ in 0..200 {
+        if !startup_log.requests().is_empty() {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+
+    let child = startup_log.requests();
+    assert_eq!(child.len(), 1);
+    assert_eq!(child[0].body_json()["model"], startup_model.as_str());
+    assert!(
+        child[0].body_json()["tools"]
+            .to_string()
+            .contains("\"type\":\"web_search\"")
+    );
+    assert!(mentions(&child[0].input(), "CHILD_TASK"));
+    assert!(
+        other_log
+            .requests()
+            .iter()
+            .all(|request| request.body_json()["model"] == "spawn-home-model")
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn a_thread_started_on_a_runtime_provider_keeps_the_configured_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let _provider = runtime_provider("resume_runtime", "resume-runtime-model", &server);
+    let home = tempfile::TempDir::new()?;
+    let config = codex_core::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .harness_overrides(codex_core::config::ConfigOverrides {
+            model_provider: Some("resume_runtime".to_string()),
+            ..Default::default()
+        })
+        .build()
+        .await?;
+    assert_eq!(
+        (
+            config.model_provider_id.as_str(),
