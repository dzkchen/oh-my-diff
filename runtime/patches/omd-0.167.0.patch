+#[test]
+#[serial_test::serial]
+fn inline_renders_bound_both_caches_across_state_invalidations() {
+    let test_hooked = HOOKED.capture();
+    let test_engine = ENGINE.capture();
+    struct Restore(bool, Option<Engine>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            let test_hooked = HOOKED.capture();
+            let test_engine = ENGINE.capture();
+            test_hooked.store(self.0, Ordering::Relaxed);
+            *test_engine
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner) = self.1.take();
+        }
+    }
+    let _restore = Restore(
+        test_hooked.swap(true, Ordering::Relaxed),
+        test_engine.lock().unwrap().take(),
+    );
+    engine(|engine| engine.running = true);
+    let target = RenderTarget::new(
+        "tool_call",
+        "pending-group",
+        false,
+        json!({"kind":"explore"}),
+    );
+    assert!(resolve_state(&target, 80).is_none());
+    engine(|engine| {
+        engine.remember(
+            0,
+            ("tool_call".into(), "pending-group".into()),
+            None,
+            engine.cleared,
+        )
+    });
+    let changed = RenderTarget::new(
+        "tool_call",
+        "pending-group",
+        true,
+        json!({"kind":"explore"}),
+    );
+    assert!(matches!(resolve_state(&changed, 80), Some(None)));
+    let _wait = Wait::enter();
+    assert!(matches!(resolve_state(&target, 80), Some(None)));
+    for invalidated in [false, true] {
+        for index in 0..=DONE_LIMIT {
+            let target = RenderTarget::new(
+                "assistant_message",
+                format!("inline-{invalidated}-{index}"),
+                false,
+                json!({"text": "cached response"}),
+            );
+            resolve(&target, 80);
+            let (done, latest, newest) = engine(|engine| {
+                (
+                    engine.done.len(),
+                    engine.latest.len(),
+                    engine
+                        .latest
+                        .contains_key(&(target.component.to_owned(), target.id.clone())),
+                )
+            });
+            assert!(done > 0 && done <= DONE_LIMIT);
+            assert!(latest <= DONE_LIMIT);
+            assert!(newest);
+            if invalidated {
+                forget();
+            }
+        }
+    }
+}
