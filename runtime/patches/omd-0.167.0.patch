+Mutex::new(std::collections::BTreeMap::new()) }
+
+pub(crate) fn remember_message_history(thread: &str, canonical: bool) {
+    MESSAGE_HISTORY.with(|message_history_state| {
+        if !crate::omd::is_active() {
+            return;
+        }
+        let mut modes = message_history_state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if modes.len() >= 4096 && !modes.contains_key(thread) {
+            modes.pop_first();
+        }
+        modes.insert(thread.to_owned(), canonical);
+    })
+}
+
+pub(crate) fn replay_message_id(
+    thread: Option<codex_protocol::ThreadId>,
+    id: String,
+) -> Option<String> {
+    MESSAGE_HISTORY.with(|message_history_state| {
+        thread
+            .filter(|thread| {
+                message_history_state
+                    .lock()
+                    .is_ok_and(|modes| modes.get(&thread.to_string()) == Some(&true))
+            })
+            .map(|_| id)
+    })
+}
