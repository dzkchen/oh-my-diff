index 0000000000000000000000000000000000000000..0d0cc3533d2adf7951385a69a7bc1991f7e8b5e2
--- /dev/null
+++ b/codex-rs/tui/src/mod_module.rs
@@ -0,0 +1,457 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+use crate::omd::LockExt;
+use codex_omd::ModComponent;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use serde_json::Value;
+use serde_json::json;
+
+const FRAME: Duration = Duration::from_millis(16);
+const RETRY: Duration = Duration::from_millis(100);
+const EVENTS: usize = 256;
+/// A module not drawn for this long (a collapsed pane, a hidden site) stops ticking until it is drawn again.
+const UNDRAWN: Duration = Duration::from_secs(1);
+
+struct Instance {
+    generation: u64,
+    owner: String,
+    module: String,
+    props: Value,
+    columns: u16,
+    rows: u16,
+    events: Vec<Value>,
+    tree: Vec<ModComponent>,
+    composed: Option<(u16, Vec<Line<'static>>)>,
+    drawn: Instant,
+    mounted: bool,
+    changed: bool,
+    due: Option<Instant>,
+    stepped: Option<Instant>,
+    failed: Option<String>,
+}
+
+static INSTANCES: Mutex<Option<HashMap<String, Instance>>> = Mutex::new(None);
+static WORKER: OnceLock<std::thread::Thread> = OnceLock::new();
+static POSTS: Mutex<Vec<Post>> = Mutex::new(Vec::new());
+
+struct Post {
+    id: String,
+    generation: u64,
+    owner: String,
+    payload: Value,
+}
+
+impl Post {
+    fn current(&self, instances: &HashMap<String, Instance>) -> bool {
+        current_generation(instances, &self.id, self.generation)
+    }
+}
+
+fn current_generation(instances: &HashMap<String, Instance>, id: &str, generation: u64) -> bool {
+    instances
+        .get(id)
+        .is_some_and(|instance| instance.generation == generation)
+}
+
+fn instances<T>(run: impl FnOnce(&mut HashMap<String, Instance>) -> T) -> T {
+    let mut instances = INSTANCES.locked();
+    run(instances.get_or_insert_with(HashMap::new))
+}
+
+fn clock() -> u64 {
+    static ORIGIN: OnceLock<Instant> = OnceLock::new();
+    ORIGIN.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+fn wake() {
+    WORKER
+        .get_or_init(|| std::thread::spawn(work).thread().clone())
+        .unpark();
+}
+
+/// The rows a mounted module draws at `width`; mounting it, or changing its props or size, asks for a step.
+pub(crate) fn rows(
+    id: &str,
+    owner: Option<&str>,
+    module: &str,
+    props: &Value,
+    width: u16,
+    height: Option<u16>,
+) -> Vec<Line<'static>> {
+    let Some(owner) = owner else {
+        return vec![Line::from(format!("{module}: no owner")).dim()];
+    };
+    let rows = height.unwrap_or(0);
+    let (lines, step, replaced) = instances(|instances| {
+        let instance = instances
+            .entry(id.to_owned())
+            .or_insert_with(|| fresh(owner, module));
+        let mut replaced = None;
+        if instance.owner != owner || instance.module != module {
+            replaced = Some(instance.owner.clone());
+            *instance = fresh(owner, module);
+        }
+        let resumed = instance.drawn.elapsed() > UNDRAWN;
+        instance.drawn = Instant::now();
+        if instance.props != *props || instance.columns != width || instance.rows != rows {
+            instance.props = props.clone();
+            instance.columns = width;
+            instance.rows = rows;
+            instance.changed = true;
+        }
+        let lines = match &instance.failed {
+            Some(error) => vec![failure_line(owner, module, error)],
+            None => composed(instance, width).to_vec(),
+        };
+        let step = instance.failed.is_none()
+            && (instance.changed
+                || instance
+                    .due
+                    .is_some_and(|due| resumed || due <= Instant::now()));
+        (lines, step, replaced)
+    });
+    if let Some(previous) = replaced {
+        codex_omd::component_unmount(&previous, id);
+    }
+    if step {
+        wake();
+    }
+    let mut lines = lines;
+    if let Some(height) = height {
+        lines.resize(usize::from(height), Line::default());
+    } else if lines.is_empty() {
+        lines.push(Line::default());
+    }
+    lines
+}
+
+pub(crate) fn mounted(id: &str) -> bool {
+    instances(|instances| instances.contains_key(id))
+}
+
+/// Rows a module without a declared height takes: what its latest tree draws.
+pub(crate) fn height(id: &str) -> u16 {
+    instances(|instances| {
+        instances.get_mut(id).map_or(1, |instance| {
+            let drawn = if instance.failed.is_some() {
+                1
+            } else {
+                let columns = instance.columns.max(1);
+                composed(instance, columns).len()
+            };
+            u16::try_from(drawn.max(1)).unwrap_or(u16::MAX)
+        })
+    })
+}
+
+fn composed(instance: &mut Instance, width: u16) -> &[Line<'static>] {
+    if instance
+        .composed
+        .as_ref()
+        .is_some_and(|(cached, _)| *cached != width)
+    {
+        instance.composed = None;
+    }
+    let tree = &instance.tree;
+    &instance
+        .composed
+        .get_or_insert_with(|| {
+            let lines = crate::mod_render::compose_lines(tree, width, None, Vec::new());
+            (width, lines.into_iter().map(|line| line.line).collect())
+        })
+        .1
+}
+
+fn failure_line(owner: &str, module: &str, error: &str) -> Line<'static> {
+    let error = error.lines().next().unwrap_or_default();
+    Line::from(format!("{owner}: {module}: {error}")).dim()
+}
+
+fn next_generation() -> u64 {
+    static GENERATION: AtomicU64 = AtomicU64::new(1);
+    GENERATION.fetch_add(1, Ordering::Relaxed)
+}
+
+fn fresh(owner: &str, module: &str) -> Instance {
+    Instance {
+        generation: next_generation(),
+        owner: owner.to_owned(),
+        module: module.to_owned(),
+        props: Value::Null,
+        columns: 0,
+        rows: 0,
+        events: Vec::new(),
+        tree: Vec::new(),
+        composed: None,
+        drawn: Instant::now(),
+        mounted: false,
+        changed: true,
+        due: None,
+        stepped: None,
+        failed: None,
+    }
+}
+
+pub(crate) fn retain(ids: &std::collections::BTreeSet<String>) {
+    let gone = instances(|instances| {
+        let mut gone = Vec::new();
+        instances.retain(|id, instance| {
+            let kept = ids.contains(id);
+            if !kept {
+                gone.push((instance.owner.clone(), id.clone()));
+            }
+            kept
+        });
+        gone
+    });
+    for (owner, id) in gone {
+        codex_omd::component_unmount(&owner, &id);
+    }
+}
+
+/// Queues a key or pointer event for a mounted module; false leaves it to the component's other routes.
+pub(crate) fn accept(payload: &Value) -> bool {
+    let Some(component) = payload["component"].as_str() else {
+        return false;
+    };
+    let accepted = instances(|instances| {
+        let Some(instance) = instances.get_mut(component) else {
+            return false;
+        };
+        if instance.failed.is_some() {
+            return true;
+        }
+        for event in codex_omd::component_events(payload) {
+            let moved = |event: &Value| {
+                event["kind"] == "pointer"
+                    && matches!(event["action"].as_str(), Some("move" | "drag"))
+            };
+            if moved(&event) && instance.events.last().is_some_and(moved) {
+                instance.events.pop();
+            }
+            if instance.events.len() >= EVENTS {
+                instance.events.remove(0);
+            }
+            instance.events.push(event);
+        }
+        true
+    });
+    if accepted {
+        wake();
+    }
+    accepted
+}
+
+/// A new view revision mounts failed modules again.
+pub(crate) fn refresh() {
+    let retry = instances(|instances| {
+        let mut retry = false;
+        for instance in instances
+            .values_mut()
+            .filter(|instance| instance.failed.is_some())
+        {
+            instance.generation = next_generation();
+            instance.failed = None;
+            instance.mounted = false;
+            instance.changed = true;
+            retry = true;
+        }
+        retry
+    });
+    if retry {
+        wake();
+    }
+}
+
+struct Job {
+    id: String,
+    generation: u64,
+    owner: String,
+    module: String,
+    frame: Value,
+    events: Vec<Value>,
+}
+
+fn next_job() -> Result<Job, Option<Duration>> {
+    let now = Instant::now();
+    instances(|instances| {
+        let mut wait: Option<Duration> = None;
+        let mut ready = None;
+        for (id, instance) in instances.iter() {
+            if instance.failed.is_some() {
+                continue;
+            }
+            let wanted = if instance.changed || !instance.events.is_empty() {
+                Some(now)
+            } else if now.saturating_duration_since(instance.drawn) > UNDRAWN {
+                None
+            } else {
+                instance.due
+            };
+            let Some(wanted) = wanted else {
+                continue;
+            };
+            let at = instance
+                .stepped
+                .map_or(wanted, |stepped| wanted.max(stepped + FRAME));
+            if at <= now {
+                ready = Some(id.clone());
+                break;
+            }
+            let until = at - now;
+            wait = Some(wait.map_or(until, |wait| wait.min(until)));
+        }
+        let Some(id) = ready else {
+            return Err(wait);
+        };
+        let instance = instances.get_mut(&id).ok_or(wait)?;
+        let events = std::mem::take(&mut instance.events);
+        let frame = json!({"instance": id, "mount": !instance.mounted, "props": instance.props,
+            "now": clock(), "columns": instance.columns, "rows": instance.rows, "events": events});
+        instance.changed = false;
+        instance.due = None;
+        instance.stepped = Some(now);
+        Ok(Job {
+            id,
+            generation: instance.generation,
+            owner: instance.owner.clone(),
+            module: instance.module.clone(),
+            frame,
+            events,
+        })
+    })
+}
+
+fn work() {
+    loop {
+        let mut job = match next_job() {
+            Ok(job) => job,
+            Err(wait) => {
+                match wait {
+                    Some(wait) => std::thread::park_timeout(wait),
+                    None => std::thread::park(),
+                }
+                continue;
+            }
+        };
+        let result =
+            crate::mod_runtime::component(&job.owner, &job.module, std::mem::take(&mut job.frame));
+        let post = instances(|instances| finish_job(instances, &mut job, result));
+        match post {
+            Some(Some(post)) => deliver(post),
+            Some(None) => {}
+            None => instances(|instances| {
+                // Replacement or removal already unmounted the old runner; a late step may recreate it but must never tear down a same-owner replacement.
+                if instances
+                    .get(&job.id)
+                    .is_none_or(|instance| instance.owner != job.owner)
+                {
+                    codex_omd::component_unmount(&job.owner, &job.id);
+                }
+            }),
+        }
+    }
+}
+
+fn finish_job(
+    instances: &mut HashMap<String, Instance>,
+    job: &mut Job,
+    result: Option<Result<Value, String>>,
+) -> Option<Option<Post>> {
+    let instance = instances.get_mut(&job.id)?;
+    if instance.generation != job.generation {
+        return None;
+    }
+    let Some(result) = result else {
+        let mut events = std::mem::take(&mut job.events);
+        events.append(&mut instance.events);
+        instance.events = events;
+        instance.changed = true;
+        instance.stepped = Some(Instant::now() + RETRY);
+        return Some(None);
+    };
+    Some(match result {
+        Ok(step) => {
+            instance.mounted = true;
+            instance.due = step["next_ms"]
+                .as_u64()
+                .map(|ms| Instant::now() + Duration::from_millis(ms));
+            if let Ok(tree) = serde_json::from_value::<Vec<ModComponent>>(step["tree"].clone())
+                && tree != instance.tree
+            {
+                instance.tree = tree;
+                instance.composed = None;
+                crate::mod_render::schedule_frame(Duration::ZERO);
+            }
+            step["post"].as_object().map(|post| Post {
+                id: job.id.clone(),
+                generation: job.generation,
+                owner: job.owner.clone(),
+                payload: json!({"component": job.id, "module": job.module, "data": post["data"]}),
+            })
+        }
+        Err(error) => {
+            instance.failed = Some(error);
+            instance.mounted = false;
+            instance.tree.clear();
+            instance.composed = None;
+            crate::mod_render::schedule_frame(Duration::ZERO);
+            None
+        }
+    })
+}
+
+/// A post reaches the owner's `component_post` hooks off the frame worker; a newer post from the same instance replaces an undelivered one.
+fn deliver(post: Post) {
+    static SENDER: OnceLock<std::thread::Thread> = OnceLock::new();
+    {
+        let mut posts = POSTS.locked();
+        posts.retain(|queued| queued.owner != post.owner || queued.id != post.id);
+        posts.push(post);
+    }
+    SENDER
+        .get_or_init(|| {
+            std::thread::spawn(|| {
+                loop {
+                    let next = {
+                        let mut posts = POSTS.locked();
+                        (!posts.is_empty()).then(|| posts.remove(0))
+                    };
+                    match next {
+                        Some(post) => {
+                            if instances(|instances| post.current(instances)) {
+                                let id = post.id;
+                                let generation = post.generation;
+                                crate::mod_runtime::invoke_event_guarded(
+                                    &post.owner,
+                                    "component_post",
+                                    post.payload,
+                                    Arc::new(move || {
+                                        instances(|instances| {
+                                            current_generation(instances, &id, generation)
+                                        })
+                                    }),
+                                );
+                            }
+                        }
+                        None => std::thread::park(),
+                    }
+                }
+            })
+            .thread()
+            .clone()
+        })
+        .unpark();
+}
+
+#[cfg(test)]
+#[path = "mod_module_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/mod_module_tests.rs b/codex-rs/tui/src/mod_module_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6fcbc58e569730183ee7a88fde9ff76ca6a682ab
--- /dev/null
+++ b/codex-rs/tui/src/mod_module_tests.rs
@@ -0,0 +1,89 @@
+use super::*;
+use std::sync::Arc;
+use std::sync::mpsc;
+
+fn tree(text: &str) -> Vec<ModComponent> {
+    serde_json::from_value(json!([
+        {"type": "text", "id": "body", "label": "body", "text": text}
+    ]))
+    .expect("valid component tree")
+}
+
+fn take_job(instance: &mut Instance) -> Job {
+    instance.changed = false;
+    Job {
+        id: "module".to_owned(),
+        generation: instance.generation,
+        owner: instance.owner.clone(),
+        module: instance.module.clone(),
+        frame: Value::Null,
+        events: std::mem::take(&mut instance.events),
+    }
+}
+
+#[test]
+fn replacement_during_step_rejects_old_success_error_and_retry() {
+    for (owner, module, remount) in [
+        ("new-owner", "old-module", false),
+        ("owner", "new-module", false),
+        ("owner", "old-module", true),
+    ] {
+        for result in [
+            Some(Ok(json!({
+                "tree": tree("obsolete"), "next_ms": 1,
+                "post": {"data": {"obsolete": true}}
+            }))),
+            Some(Err("obsolete failure".to_owned())),
+            None,
+        ] {
+            let mut original = fresh("owner", "old-module");
+            original.events = vec![json!({"old": true})];
+            let mut job = take_job(&mut original);
+            let mounted = Arc::new(Mutex::new(HashMap::from([(job.id.clone(), original)])));
+            let (started, stepping) = mpsc::channel();
+            let (release, response) = mpsc::channel();
+            let worker_instances = Arc::clone(&mounted);
+            let worker = std::thread::spawn(move || {
+                started.send(()).unwrap();
+                let result = response.recv().unwrap();
+                finish_job(&mut worker_instances.lock().unwrap(), &mut job, result).is_none()
+            });
+            stepping.recv().unwrap();
+            let due = Instant::now() + Duration::from_secs(10);
+            let stepped = Instant::now();
+            {
+                let mut mounted = mounted.lock().unwrap();
+                if remount {
+                    mounted.remove("module");
+                }
+                let mut replacement = fresh(owner, module);
+                replacement.tree = tree("replacement");
+                replacement.composed = Some((20, vec![Line::raw("cached replacement")]));
+                replacement.events = vec![json!({"new": true})];
+                replacement.changed = false;
+                replacement.mounted = true;
+                replacement.due = Some(due);
+                replacement.stepped = Some(stepped);
+                mounted.insert("module".to_owned(), replacement);
+            }
+            release.send(result).unwrap();
+            assert!(
+                worker.join().unwrap(),
+                "obsolete completion produced a post/result"
+            );
+            let mounted = mounted.lock().unwrap();
+            let replacement = &mounted["module"];
+            assert_eq!(replacement.tree, tree("replacement"));
+            assert_eq!(replacement.failed, None);
+            assert!(replacement.mounted);
+            assert!(!replacement.changed);
+            assert_eq!(replacement.due, Some(due));
+            assert_eq!(replacement.stepped, Some(stepped));
+            assert_eq!(replacement.events, vec![json!({"new": true})]);
+            assert_eq!(
+                replacement.composed.as_ref().unwrap().1,
+                vec![Line::raw("cached replacement")]
+            );
+        }
+    }
+}
