+    );
+    assert_eq!(
+        host.call(
+            &reader,
+            "exec.run",
+            json!({"program":"sh","network":"loopback"})
+        )
+        .unwrap_err(),
+        "capability_denied: network"
+    );
+    assert_eq!(
+        host.call(&reader, "exec.run", json!({"program":"sh","cwd":"../"}))
+            .unwrap_err(),
