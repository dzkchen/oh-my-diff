+pub(crate) fn removed_features_changed() -> Vec<codex_features::Feature> {
+    static LAST: std::sync::Mutex<std::collections::BTreeSet<codex_features::Feature>> =
+        std::sync::Mutex::new(std::collections::BTreeSet::new());
+    let current = builtins().removed_features();
+    let mut last = LAST.locked();
+    let changed: Vec<_> = last.symmetric_difference(&current).copied().collect();
+    if !changed.is_empty() {
+        codex_features::set_removed("tui", current.clone());
+    }
+    *last = current;
+    changed
+}
