+
+fn broadcast_event_except_guarded(
+    event: &str,
+    payload: Value,
+    except: &str,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+) {
+    if !current() {
+        return;
+    }
+    let Some(ids) = with_host(|runtime, _| {
+        Some(
+            runtime
+                .owners()
+                .into_iter()
+                .map(|(id, _)| id)
+                .filter(|id| id != except && runtime.registered(id, event))
+                .collect::<Vec<_>>(),
+        )
+    }) else {
+        return;
+    };
+    for id in ids {
+        let _ = invoke_event_guarded(&id, event, payload.clone(), current.clone());
+    }
+}
