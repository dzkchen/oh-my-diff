+            .unwrap()
+            .stdout;
+        let store = tempfile::tempdir_in(String::from_utf8(user_temp).unwrap().trim()).unwrap();
+        let root = repository.path().canonicalize().unwrap();
+        let store = store.path().canonicalize().unwrap();
