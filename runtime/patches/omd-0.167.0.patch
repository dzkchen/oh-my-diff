+/// Extension verdict on a pending approval. Any deny wins, then any ask, then any approve.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ApprovalGate {
+    Continue,
+    Deny(String),
+    Ask(String),
+    /// Approve a request the host would otherwise ask about, under a user-delegated grant.
+    Approve(String),
+}
+
+/// Approval offered to gates before hooks, automatic review or policy shortcuts run.
+pub struct ApprovalGateInput<'a> {
+    pub session_store: &'a ExtensionData,
+    pub thread_store: &'a ExtensionData,
+    pub call_id: &'a str,
+    pub turn_id: Option<&'a str>,
+    pub kind: &'a str,
+    pub host_decision: &'a str,
+    pub policy: &'a str,
+    pub details: serde_json::Value,
+    /// A `tools.check` assessment: nothing will run and no prompt follows.
+    pub assessment: bool,
+}
+
+pub struct ApprovalResultInput<'a> {
+    pub thread_store: &'a ExtensionData,
+    pub call_id: &'a str,
+    pub kind: &'a str,
+    pub decision: &'a str,
+    pub source: &'a str,
+}
