+    let other = profiles.create("other", "api_key", None, None).unwrap();
+    let (base, registration) =
+        register(store, "mod".into(), BTreeSet::from([approved.id.clone()])).unwrap();
+    let port = base.rsplit_once('/').unwrap().0;
