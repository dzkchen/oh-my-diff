+        .unwrap();
+    store.enable(&package, true).unwrap();
+    let mut runtime = ModHost::open(
+        data.clone(),
+        ModOpenOptions {
+            repository: Some(&root),
+            ..ModOpenOptions::default()
+        },
+    )
+    .unwrap();
+    let paths = crate::omd::ModPaths {
+        repository: root.clone(),
+        store: data.clone(),
+        protected: vec![],
+    };
+    let mut snapshot = ModViewSnapshot {
+        input: serde_json::json!({"event":"idle","ledger":{"thread_id":"previous"}}),
+        ..Default::default()
+    };
+    let terminal = runtime.terminal_view(snapshot.input.clone(), || true);
+    assert_eq!(terminal.diagnostics.len(), 1);
+    snapshot.native_diagnostics = vec!["native evidence diagnostic".into()];
+    snapshot.diagnostics = terminal
+        .diagnostics
+        .into_iter()
