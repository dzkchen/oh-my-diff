+#[tokio::test]
+async fn replacing_the_provisional_tail_while_scrolled_up_reports_no_new_activity() -> Result<()> {
+    let (mut app, mut rx, _op_rx) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(/*owned*/ true)?;
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(crate::history_cell::PlainHistoryCell::new(vec![
+            "earlier output".into();
+            60
+        ])),
+    );
+    enqueue_pending_patch(&mut app, thread_id).await?;
+    drain_pending_patch(&mut app, &mut tui).await?;
+    let apply = |app: &mut App, tui: &mut crate::tui::Tui, rx: &mut UnboundedReceiver<AppEvent>| {
+        while let Ok(event) = rx.try_recv() {
+            match event {
+                AppEvent::InsertHistoryCell(cell) => app.insert_history_cell(tui, cell),
+                AppEvent::ReplaceHistoryCell { activity_id, cell } => {
+                    app.replace_history_cell(tui, &activity_id, cell)
+                }
+                _ => {}
+            }
+        }
+    };
+    apply(&mut app, &mut tui, &mut rx);
+    let size = tui.terminal.size()?;
+    app.render_owned_transcript(&mut tui, size)?;
+    app.transcript_view
+        .scroll(&app.transcript_cells, /*rows*/ -1000);
+    app.render_owned_transcript(&mut tui, size)?;
+    let footer = |tui: &crate::tui::Tui| {
+        let screen = buffer_text(last_rendered_buffer(&tui.terminal));
+        (
+            screen.contains("New activity") || screen.contains("New · "),
+            screen,
+        )
+    };
+    let (unseen, screen) = footer(&tui);
+    assert!(!unseen, "{screen}");
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE));
+    app.enqueue_thread_notification(
+        thread_id,
+        ServerNotification::ItemCompleted(
+            codex_app_server_protocol::ItemCompletedNotification::new(
+                thread_id.to_string(),
+                TURN_ID.to_string(),
+                ThreadItemPayload::FileChange {
+                    id: ITEM_ID.to_string(),
+                    changes: changes(),
+                    status: PatchApplyStatus::Completed,
+                },
+                /*started_at_ms*/ Some(1_000),
+                /*completed_at_ms*/ 2_500,
+            ),
+        ),
+    )
+    .await?;
+    drain_pending_patch(&mut app, &mut tui).await?;
+    apply(&mut app, &mut tui, &mut rx);
+    assert!(
+        app.transcript_cells
+            .last()
+            .is_some_and(|cell| cell.activity_ids() == [format!("patch:{ITEM_ID}")])
+    );
+    app.render_owned_transcript(&mut tui, size)?;
+    let (unseen, screen) = footer(&tui);
+    tui.set_owned_screen(/*owned*/ false)?;
+    assert!(!app.transcript_view.is_following(), "{screen}");
+    assert!(!unseen, "{screen}");
+    Ok(())
+}
