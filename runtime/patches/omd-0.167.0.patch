+    let path = Arc::new(directory.path().join("owner.json"));
+    let writers: Vec<_> = (0..8)
+        .map(|writer| {
+            let path = path.clone();
+            std::thread::spawn(move || (0..50).all(|_| write_json(&path, &json!(writer)).is_ok()))
+        })
+        .collect();
+    for writer in writers {
+        assert!(writer.join().unwrap());
+    }
+}
