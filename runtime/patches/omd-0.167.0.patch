+#[test]
+#[serial_test::serial]
+fn split_gaps_leave_cells_between_children_and_their_handle() {
+    let layout = layout(
+        serde_json::json!({"split": "horizontal", "gap": 2, "children": [
+        {"content": "site:files/tree", "style": {"border": "thick"}}, {"content": "transcript"}]}),
+    );
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.regions[0],
+        Region {
+            path: "r.0".into(),
+            content: "site:files/tree".into(),
+            area: Rect::new(0, 0, 20, 10),
+            style: Some(codex_omd::ModBoxStyle {
+                border: Some(codex_omd::ModBoxBorder::Thick),
+                ..Default::default()
+            }),
+            title: None,
+            tabs: None,
+        }
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(22, 0, 20, 10)));
+    let narrow = place(&layout, None, Rect::new(0, 0, 7, 10));
+    assert_eq!(narrow.area("transcript"), Some(Rect::new(4, 0, 3, 10)));
+    place(&layout, None, Rect::new(0, 0, 42, 10));
+    let at = |kind, column| MouseEvent {
+        kind,
+        column,
+        row: 4,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(at(MouseEventKind::Down(MouseButton::Left), 21)));
+    assert!(pointer(at(MouseEventKind::Drag(MouseButton::Left), 30)));
+    assert!(pointer(at(MouseEventKind::Up(MouseButton::Left), 30)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 0, 30, 10))
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+    hide();
+    assert!(!pointer(at(MouseEventKind::Down(MouseButton::Left), 31)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+}
