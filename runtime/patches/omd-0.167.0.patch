+async fn listening_ports(roots: Vec<u32>) -> Result<Value, String> {
+    if roots.is_empty() {
+        return Ok(json!({"ports": []}));
+    }
+    let run = |program: &'static str, args: Vec<String>| async move {
+        tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            tokio::process::Command::new(program)
+                .args(args)
+                .kill_on_drop(true)
+                .output(),
+        )
+        .await
+        .map_err(|_| format!("session_ports_timeout: {program}"))?
+        .map_err(|error| format!("session_ports_unavailable: {program}: {error}"))
+    };
+    let table = run("/bin/ps", vec!["-axo".into(), "pid=,ppid=".into()]).await?;
+    let pids = descendants(&String::from_utf8_lossy(&table.stdout), &roots);
+    let lsof = ["/usr/sbin/lsof", "/usr/bin/lsof"]
+        .into_iter()
+        .find(|path| std::path::Path::new(path).exists())
+        .ok_or("session_ports_unavailable: lsof")?;
+    let pids = pids
+        .iter()
+        .map(u32::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    let output = run(
+        lsof,
+        [
+            "-nP",
+            "-w",
+            "-a",
+            "-iTCP",
+            "-sTCP:LISTEN",
+            "-Fpn",
+            "-p",
+            &pids,
+        ]
+        .map(str::to_owned)
+        .to_vec(),
+    )
+    .await?;
+    Ok(json!({"ports": parse_listeners(&String::from_utf8_lossy(&output.stdout))}))
+}
+
+fn descendants(table: &str, roots: &[u32]) -> Vec<u32> {
+    let pairs = table
+        .lines()
+        .filter_map(|line| {
+            let mut fields = line.split_whitespace().map(str::parse::<u32>);
+            Some((fields.next()?.ok()?, fields.next()?.ok()?))
+        })
+        .collect::<Vec<_>>();
+    let mut found = roots.to_vec();
+    let mut index = 0;
+    while index < found.len() && found.len() < 256 {
+        let parent = found[index];
+        let children = pairs
+            .iter()
+            .filter(|(pid, ppid)| *ppid == parent && !found.contains(pid))
+            .map(|(pid, _)| *pid)
+            .collect::<Vec<_>>();
+        found.extend(children);
+        index += 1;
+    }
+    found.truncate(256);
+    found
+}
+
+fn parse_listeners(output: &str) -> Vec<Value> {
+    let mut pid = 0;
+    let mut ports = std::collections::BTreeMap::new();
+    for line in output.lines() {
+        if let Some(value) = line.strip_prefix('p') {
+            pid = value.parse().unwrap_or(0);
+        } else if let Some(address) = line.strip_prefix('n')
+            && let Some(port) = address
+                .rsplit(':')
+                .next()
+                .and_then(|port| port.parse::<u16>().ok())
+        {
+            ports
+                .entry(port)
+                .or_insert_with(|| json!({"port": port, "pid": pid, "address": address}));
+        }
+    }
+    ports.into_values().take(32).collect()
+}
+
+fn catalog_choice(
+    models: &[codex_protocol::openai_models::ModelPreset],
+    model: &Value,
+    effort: &Value,
+) -> Result<(String, String), String> {
+    let preset = model
+        .as_str()
+        .and_then(|model| {
+            models
+                .iter()
+                .find(|preset| preset.model_provider.is_none() && preset.model == model)
+        })
+        .ok_or("routes_add_model_unknown")?;
+    let effort = match effort {
+        Value::Null => preset.default_reasoning_effort.clone(),
+        effort => preset
+            .supported_reasoning_efforts
+            .iter()
+            .map(|option| option.effort.clone())
+            .find(|supported| effort.as_str() == Some(supported.as_str()))
+            .ok_or("routes_add_effort_unsupported")?,
+    };
+    Ok((preset.model.clone(), effort.to_string()))
+}
+
+fn route_mod(call: &SurfaceCall) -> Result<String, String> {
+    call.arguments["mod"]
+        .as_str()
+        .or(Some(call.caller.as_str()))
+        .filter(|id| {
+            crate::mod_runtime::terminal_source(id).is_some() || caller_source(id).is_some()
+        })
+        .map(str::to_owned)
+        .ok_or_else(|| "routes_add_mod_unknown".into())
+}
+
+struct ChatgptCatalog {
+    models: Vec<codex_protocol::openai_models::ModelPreset>,
+    infos: Vec<codex_protocol::openai_models::ModelInfo>,
+    configured: Option<(String, i64)>,
+}
+
+impl ChatgptCatalog {
+    fn route(&self, arguments: &Value) -> Result<(String, String, u64), String> {
+        let (model, effort) =
+            catalog_choice(&self.models, &arguments["model"], &arguments["effort"])?;
+        let window = self.window(&model);
+        Ok((model, effort, window))
+    }
+
+    fn window(&self, model: &str) -> u64 {
+        chosen_window(
+            model,
+            self.infos.iter().find(|info| info.slug == model),
+            self.configured
+                .as_ref()
+                .filter(|(configured, _)| configured == model)
+                .map(|(_, window)| *window),
+        )
+    }
+
+    fn listed(&self) -> Value {
+        self.models
+            .iter()
+            .filter(|preset| preset.show_in_picker)
+            .take(ROUTE_MODELS)
+            .map(|preset| {
+                json!({"model": preset.model, "display_name": preset.display_name,
+                    "efforts": preset.supported_reasoning_efforts.iter().take(16)
+                        .map(|option| option.effort.to_string()).collect::<Vec<_>>(),
+                    "default_effort": preset.default_reasoning_effort.to_string(),
+                    "context_window": self.window(&preset.model)})
+            })
+            .collect()
+    }
+}
+
+async fn chatgpt_catalog(
+    config: crate::legacy_core::config::Config,
+) -> Result<ChatgptCatalog, String> {
+    let catalog = codex_app_server_client::model_catalog::chatgpt_catalog(config).await?;
+    Ok(ChatgptCatalog {
+        models: catalog.models,
+        infos: catalog.infos,
+        configured: catalog.configured,
+    })
+}
+
+fn chosen_window(
+    model: &str,
+    live: Option<&codex_protocol::openai_models::ModelInfo>,
+    configured: Option<i64>,
+) -> u64 {
+    let bundled = live
+        .is_none()
+        .then(codex_models_manager::bundled_models_response)
+        .and_then(Result::ok)
+        .and_then(|response| response.models.into_iter().find(|info| info.slug == model));
+    let info = live.or(bundled.as_ref());
+    let within =
+        |window: i64, ceiling: Option<i64>| ceiling.map_or(window, |ceiling| window.min(ceiling));
+    let window = codex_models_manager::runtime_models::context_window(model)
+        .map(|window| {
+            within(
+                window,
+                info.and_then(|info| info.max_context_window.or(info.context_window)),
+            )
+        })
+        .or_else(|| {
+            configured.map(|window| within(window, info.and_then(|info| info.max_context_window)))
+        })
+        .or_else(|| {
+            info.and_then(codex_protocol::openai_models::ModelInfo::resolved_context_window)
+        });
+    let percent = info.map_or(95, |info| info.effective_context_window_percent);
+    window
+        .map(|window| window.saturating_mul(percent) / 100)
+        .and_then(|window| u64::try_from(window).ok())
+        .unwrap_or(STANDARD_CONTEXT_WINDOW)
+}
