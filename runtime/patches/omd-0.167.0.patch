+pub(super) async fn wait_for_user_turn_submission(
+    app: &mut App,
+    tui: &mut tui::Tui,
+    session: &mut AppServerSession,
+    events: &mut mpsc::UnboundedReceiver<AppEvent>,
+) -> Result<Arc<crate::app_event::UserTurnSubmissionResult>> {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let event = events
+                .recv()
+                .await
+                .ok_or_else(|| color_eyre::eyre::eyre!("app event channel closed"))?;
+            let completion = match &event {
+                AppEvent::UserTurnSubmissionFinished { completion, .. } => {
+                    Some(Arc::clone(completion))
+                }
+                _ => None,
+            };
+            app.handle_event(tui, session, event).await?;
+            app.drain_active_thread_events(tui).await?;
+            if let Some(completion) = completion {
+                return Ok(completion);
+            }
+        }
+    })
+    .await?
+}
