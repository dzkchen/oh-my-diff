+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub(crate) enum FooterSite {
+    Above,
+    Below,
+}
+
+#[derive(Default)]
+struct FooterCache {
+    active: bool,
+    layouts: BTreeMap<(FooterSite, u16), Arc<FooterLayout>>,
+    rendered: BTreeMap<FooterSite, (Rect, Arc<FooterLayout>, usize)>,
+}
+
+crate::omd::isolated_static! { FOOTER: Mutex<FooterCache> = Mutex::new(FooterCache {
+    active: false,
+    layouts: BTreeMap::new(),
+    rendered: BTreeMap::new(),
+}) }
