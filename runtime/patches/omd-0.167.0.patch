+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open(&self.path)
+            .ok()?;
+        let metadata = dir.metadata().ok()?;
+        ((metadata.dev(), metadata.ino()) == self.identity).then_some(dir)
+    }
+}
