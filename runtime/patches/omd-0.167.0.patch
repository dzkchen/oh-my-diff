+#[expect(clippy::too_many_arguments)]
+pub(crate) async fn assess_mcp_tool_call(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    cancellation_token: &CancellationToken,
+    call_id: &str,
+    tool_info: &ToolInfo,
+    prepared_call: Option<PreparedMcpCall>,
+    hook_tool_name: &HookToolName,
+    invocation_tool_name: &ToolName,
+    arguments: &str,
+) -> Result<crate::tools::registry::ToolAssessment, String> {
+    let server = tool_info.server_name.clone();
+    let tool_name = tool_info.tool.name.to_string();
+    let arguments = if arguments.trim().is_empty() {
+        None
+    } else {
+        Some(serde_json::from_str::<JsonValue>(arguments).map_err(|error| error.to_string())?)
+    };
+    let invocation = McpInvocation {
+        server: server.clone(),
+        tool: tool_name.clone(),
+        arguments,
+    };
+    let forbidden = |reason: String| crate::tools::registry::ToolAssessment {
+        requirement: ExecApprovalRequirement::Forbidden { reason },
+        action: None,
+        overridable: false,
+    };
+    let Some(prepared_call) = prepared_call else {
+        return Ok(forbidden(format!(
+            "MCP tool `{server}/{tool_name}` is not available to the model"
+        )));
+    };
+    let metadata = match mcp_tool_metadata(
+        prepared_call.tool_info(),
+        prepared_call.plugin_id(),
+        invocation.arguments.as_ref(),
+    ) {
+        Ok(metadata) => metadata,
+        Err(error) => return Ok(forbidden(error.to_string())),
+    };
+    let (app_tool_policy, policy) =
+        mcp_tool_call_policy(&server, &tool_name, &metadata, &prepared_call);
+    if server == CODEX_APPS_MCP_SERVER_NAME && !app_tool_policy.enabled {
+        return Ok(forbidden(
+            "MCP tool call blocked by app configuration".to_string(),
+        ));
+    }
+    let (need, action, _) = mcp_tool_approval_need(
+        sess,
+        step_context,
+        cancellation_token,
+        call_id,
+        &invocation,
+        invocation_tool_name,
+        hook_tool_name,
+        &metadata,
+        prepared_call.config(),
+        prepared_call.permission_profile(),
+        prepared_call.server_environment_id(),
+        policy,
+    )
+    .await;
+    Ok(crate::tools::registry::ToolAssessment {
+        requirement: match need {
+            McpApprovalNeed::NotRequired | McpApprovalNeed::Remembered => {
+                ExecApprovalRequirement::Skip {
+                    bypass_sandbox: false,
+                    proposed_execpolicy_amendment: None,
+                }
+            }
+            McpApprovalNeed::Prompt => ExecApprovalRequirement::NeedsApproval {
+                reason: None,
+                proposed_execpolicy_amendment: None,
+            },
+        },
+        action: Some(action),
+        overridable: false,
+    })
+}
