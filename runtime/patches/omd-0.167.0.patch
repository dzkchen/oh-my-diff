+pub(crate) struct RenderTarget {
+    pub(crate) component: &'static str,
+    pub(crate) id: String,
+    pub(crate) live: bool,
+    pub(crate) props: Value,
+}
+
+impl RenderTarget {
+    pub(crate) fn new(
+        component: &'static str,
+        id: impl Into<String>,
+        live: bool,
+        props: Value,
+    ) -> Self {
