+/// Adds `denied` to a restricted profile; other profiles keep their access.
+pub fn permissions_with_denied_paths(
+    permissions: &PermissionProfile,
+    denied: &[AbsolutePathBuf],
+) -> PermissionProfile {
+    let mut file_system = permissions.file_system_sandbox_policy();
+    if denied.is_empty() || !matches!(file_system.kind, FileSystemSandboxKind::Restricted) {
+        return permissions.clone();
+    }
+    let denies = denied
+        .iter()
+        .map(|path| {
+            FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: path.clone().into(),
+                },
+                FileSystemAccessMode::Deny,
+            )
+        })
+        .collect();
+    file_system.preserve_deny_read_restrictions_from(&FileSystemSandboxPolicy::restricted(denies));
+    PermissionProfile::from_runtime_permissions_with_enforcement(
+        permissions.enforcement(),
+        &file_system,
+        permissions.network_sandbox_policy(),
+    )
+}
