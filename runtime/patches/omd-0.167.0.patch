+#[test]
+#[serial_test::serial]
+fn terminal_bindings_refresh_when_scope_changes_without_a_view_revision() {
+    let _scope = crate::mod_pty::test_scope();
+    let owners = BTreeMap::from([
+        ("m".to_owned(), "source".to_owned()),
+        ("other".to_owned(), "other-source".to_owned()),
+    ]);
+    crate::mod_pty::context(1, Some("a".into()));
+    crate::mod_pty::retain(1, "admitted", &owners, &Default::default());
+    let mut snapshot = ModViewSnapshot {
+        epoch: 7,
+        revision: 9,
+        contributors: vec!["m".into()],
+        input: serde_json::json!({"ledger": {"thread_id": "a"}, "pty_scope": {
+            "epoch": 1, "admission": codex_omd::client_surface::admission(), "configuration": "admitted"
+        }}),
+        ..Default::default()
+    };
+    let mut interaction = Interaction::default();
+    bind_terminals(&mut interaction, &snapshot);
