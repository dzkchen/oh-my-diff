+#[test]
+#[serial_test::serial]
+fn code_highlights_known_languages_and_keeps_plain_cyan_otherwise() {
+    let colors = |language: &str| {
+        let mut colors = Vec::new();
+        for line in code_lines("fn main() {\n    let x = \"a\"; // b\n}", language).iter() {
+            for span in &line.line.spans {
+                if !colors.contains(&span.style.fg) {
+                    colors.push(span.style.fg);
+                }
+            }
+        }
+        colors.len()
+    };
+    assert!(colors("rust") > 2, "{} colors", colors("rust"));
+    let text = "/* open\n still comment */\nfn main() {}";
+    let full = code_lines(text, "rust");
+    let snapshot = snapshot(serde_json::json!({"sites":{"sidebar":{"components":[
+        {"type":"code","id":"src","label":"Source","text":text,"language":"rust","start":1}
+    ]}},"sidebar_width":40}));
+    let area = Rect::new(0, 0, 80, 24);
+    sync_interaction(&snapshot.view);
+    let mut buffer = Buffer::empty(area);
+    render(area, area, &mut buffer, &snapshot);
+    let rows = (0..area.height)
+        .map(|y| {
+            (0..area.width)
+                .map(|x| buffer[(x, y)].symbol().to_owned())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>();
+    assert!(!rows.iter().any(|row| row.contains("/* open")));
+    let y = rows
+        .iter()
+        .position(|row| row.contains("still comment"))
+        .expect("comment row");
+    let x = rows[y].find("still").expect("comment column");
+    let x = u16::try_from(rows[y][..x].chars().count()).expect("column");
+    let comment = full[1]
+        .line
+        .spans
+        .iter()
+        .find(|span| span.content.contains("still"))
+        .expect("span");
+    assert_eq!(
+        buffer[(x, u16::try_from(y).expect("row"))].fg,
+        comment.style.fg.expect("comment color")
+    );
+    for language in ["", "no-such-language"] {
+        let lines = code_lines("a\nb", language);
+        assert_eq!(lines.len(), 2);
+        assert!(lines.iter().all(|line| {
+            line.line.style.fg == Some(Color::Cyan)
+                || line
+                    .line
+                    .spans
+                    .iter()
+                    .all(|span| span.style.fg == Some(Color::Cyan))
+        }));
