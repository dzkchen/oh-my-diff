+        ("schema", json!(99), "supports package schema"),
+        (
+            "compatibility",
+            json!({"releases":["9.0.0"]}),
+            "this host is",
+        ),
+        (
+            "compatibility",
+            json!({"required_features":["future_required_v1"]}),
+            "provides",
+        ),
+    ] {
+        let mut manifest = base.clone();
+        manifest[field] = value;
