+            &reader,
+            "exec.run",
+            json!({"program":"sh","sha256":"0".repeat(64)})
+        )
+        .unwrap_err(),
+        "exec_program_changed"
+    );
+    assert_eq!(
+        host.call(&reader, "exec.run", json!({"program":"../sh"}))
+            .unwrap_err(),
