+
+    pub fn status(&self) -> Value {
+        let mut status = json!({"api": MOD_API_VERSION, "host": {"codex":CODEX_HOST_RELEASE,"omd":OMD_HOST_RELEASE,
+            "package_schema":MOD_PACKAGE_SCHEMA_VERSION,"state_storage_schema":MOD_STATE_STORAGE_SCHEMA_VERSION,
+            "installed_contract_types":INSTALLED_CONTRACT_TYPES_VERSION,"features":MOD_HOST_FEATURES,
+            "supported_apis":SUPPORTED_MOD_APIS.iter().map(|(version,stability,support_until)|
+                json!({"version":version,"stability":stability,"support_until":support_until})).collect::<Vec<_>>()},
+            "generation": self.generation, "reload_error": self.reload_error,
+            "authority": crate::broker::status(), "order": self.order, "rejected": self.rejected, "field_policies": Self::field_policies(),
+            "installed_contract_types": self.store.root.join("installed-contracts.d.ts"),
+            "active_host_types": self.store.root.join("active-host.d.ts"),
+            "service_calls": self.service_calls,
+            "chains": self.chains,
+            "mods": self.loaded.iter().map(|(id, m)| { let mut status = json!({"id": id, "version": m.package.version,
+                "api":m.package.api,"api_stability":api_support(&m.package.api).map(|support|support.0),
+                "entrypoint":m.package.entrypoint,"license":m.package.license,
+                "provenance":m.package.provenance,"dependencies":m.package.dependencies,
+                "settings_schema":m.package.settings_schema,"lifecycle":m.package.lifecycle.keys().collect::<Vec<_>>(),
+                "package_schema":m.package.schema,"state_version":m.package.state_version,
+                "host_compatibility":m.package.compatibility,
+                "negotiated_features":{"required":m.package.compatibility.required_features,
+                    "optional_available":m.package.compatibility.optional_features.iter().filter(|feature|MOD_HOST_FEATURES.contains(&feature.as_str())).collect::<Vec<_>>(),
+                    "optional_unavailable":m.package.compatibility.optional_features.iter().filter(|feature|!MOD_HOST_FEATURES.contains(&feature.as_str())).collect::<Vec<_>>()},
+                "sha256": m.selection.sha256, "capabilities": m.package.capabilities, "subscriptions": m.package.subscriptions,
+                "scope": m.selection.scope, "requires": m.package.requires, "services": m.package.services,
+                "source_use":m.source_use,"unused_grants":m.unused_grants,
+                "unused_environment":m.unused_environment,"hook_budget_ms":m.package.hook_budget_ms,
+                "registrations": *m.registrations, "telemetry":m.telemetry, "error": m.error});
+                status["settings_file"] = json!(m.settings_file);
+                status["authority"] = json!({"os_access": m.package.os_access, "approves": m.package.approves,
+                    "http_access": m.package.http_access, "fs_access": m.package.fs_access, "mcp_servers": m.package.mcp_servers,
+                    "policy": m.package.policy, "peer_access": m.package.peer_access,
+                    "autonomy": m.package.autonomy, "codex_config": m.package.codex_config, "withheld": m.withheld,
+                    "expires_at": m.selection.expires_at, "current": m.selection.authority_current(),
+                    "exposure": authority_exposure(&m.selection.capabilities)});
+                status }).collect::<Vec<_>>()});
+        status["request_policy_unavailable"] =
+            json!(self.send_policy().and_then(|policy| policy.unavailable));
+        status["access"] = json!(self.access);
+        status["tool_types"] = json!(crate::tool_schema::types_path(&self.store.root));
+        status["managed"] = json!(self.managed.as_ref().map(|managed| json!({
+            "origin": managed.origin, "sha256": managed.sha256, "policy": managed.policy,
+            "unserved": self.unserved.iter().map(|(id, _, reason)| json!({"id": id, "reason": reason}))
+                .collect::<Vec<_>>()})));
+        status
+    }
+}
+
+fn validate_ui_state(encoded: &str) -> Result<Value> {
+    if encoded.len() > 65_536 {
+        return Err(failure("ui_state_limit"));
+    }
+    serde_json::from_str(encoded).map_err(|_| failure("ui_state_invalid_json"))
+}
+
+fn service_ts_type(kind: &str) -> &'static str {
+    match kind {
+        "null" => "null",
+        "boolean" => "boolean",
+        "number" => "number",
+        "string" => "string",
+        "array" => "Json[]",
+        "object" => "Record<string, Json>",
+        _ => "Json",
+    }
+}
+
+pub fn release_disposable_runners() {
+    process::release_disposable_runners();
+}
diff --git a/codex-rs/omd/src/mods/author.rs b/codex-rs/omd/src/mods/author.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5ba618bb30c359c90eca7f2e17e8d8677b5c0ede
--- /dev/null
+++ b/codex-rs/omd/src/mods/author.rs
@@ -0,0 +1,1156 @@
+use super::*;
+use std::collections::VecDeque;
+
+type OfflineTimers = BTreeMap<(Option<String>, String, String), (u64, Option<Value>)>;
+
+#[derive(Default)]
+struct OfflineHost {
+    replies: BTreeMap<String, VecDeque<Value>>,
+    calls: Vec<Value>,
+    violations: Vec<String>,
+    now_ms: u64,
+    /// Live timers are per thread: (thread, owner, key), firing in the thread that scheduled them.
+    timers: OfflineTimers,
+    thread: Option<String>,
+    /// Mods with `state_scope: "thread"`; the others' timers share the one session thread, as live.
+    thread_scoped: std::collections::BTreeSet<String>,
+    environment: Option<BTreeMap<String, String>>,
+    clients: Vec<Value>,
+    attached: u64,
+    owner: String,
+}
+
+const POINTER_ACTIONS: [&str; 8] = [
+    "down",
+    "up",
+    "scroll_up",
+    "scroll_down",
+    "move",
+    "drag",
+    "enter",
+    "leave",
+];
+
+impl OfflineHost {
+    fn from_scenario(scenario: &Value, now_ms: u64) -> Result<Self> {
+        static SCENARIOS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let scenario_number = SCENARIOS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let mut host = Self {
+            now_ms,
+            owner: format!("offline-{scenario_number}"),
+            ..Self::default()
+        };
+        if let Some(environment) = scenario.get("environment") {
+            let mut values = BTreeMap::new();
+            for (name, value) in environment
+                .as_object()
+                .ok_or_else(|| failure("offline_environment_must_be_an_object"))?
+            {
+                if crate::host::secret_like(name) {
+                    return Err(failure(format!("offline_environment_secret_name: {name}")));
+                }
+                let value = value.as_str().filter(|value| value.len() <= 4096);
+                values.insert(
+                    name.clone(),
+                    value
+                        .ok_or_else(|| {
+                            failure(format!("offline_environment_value_invalid: {name}"))
+                        })?
+                        .to_owned(),
+                );
+            }
+            host.environment = Some(values);
+        }
+        let Some(operations) = scenario.get("host_operations") else {
+            return Ok(host);
+        };
+        let operations = operations
+            .as_object()
+            .ok_or_else(|| failure("offline_host_operations_must_be_an_object"))?;
+        for (operation, values) in operations {
+            if !MOD_HOST_OPERATIONS.contains(&operation.as_str()) {
+                return Err(failure(format!(
+                    "offline_unknown_host_operation: {operation}"
+                )));
+            }
+            let values = values
+                .as_array()
+                .ok_or_else(|| failure("offline_mock_replies_must_be_an_array"))?;
+            for response in values {
+                let fields = response
+                    .as_object()
+                    .ok_or_else(|| failure("offline_mock_reply_must_be_an_object"))?;
+                if fields.keys().any(|name| {
+                    !matches!(
+                        name.as_str(),
+                        "result" | "error" | "optional" | "arguments" | "unsafe"
+                    )
+                }) || fields.contains_key("result") == fields.contains_key("error")
+                    || fields.get("error").is_some_and(|value| !value.is_string())
+                    || fields
+                        .get("optional")
+                        .is_some_and(|value| !value.is_boolean())
+                {
+                    return Err(failure("offline_mock_reply_invalid"));
+                }
+                if let Some(unsafe_fields) = fields.get("unsafe") {
+                    let flags = unsafe_fields
+                        .as_object()
+                        .ok_or_else(|| failure("offline_mock_unsafe_invalid"))?;
+                    if flags.iter().any(|(name, value)| {
+                        !matches!(name.as_str(), "arguments" | "result") || !value.is_boolean()
+                    }) {
+                        return Err(failure("offline_mock_unsafe_invalid"));
+                    }
+                }
+                if response.get("error").and_then(Value::as_str).is_none()
+                    && response["unsafe"]["result"] != true
+                {
+                    operation_validation::validate(operation, "result", &response["result"])
+                        .map_err(failure)?;
+                }
+            }
+            host.replies
+                .insert(operation.clone(), VecDeque::from(values.clone()));
+        }
+        Ok(host)
+    }
+
+    fn finish(&self) -> Result<()> {
+        if !self.violations.is_empty() {
+            return Err(failure(format!(
+                "offline_mock_violation: {}",
+                self.violations.join("; ")
+            )));
+        }
+        let remaining = self
+            .replies
+            .iter()
+            .flat_map(|(operation, replies)| {
+                replies
+                    .iter()
+                    .filter(|reply| reply["optional"] != true)
+                    .map(move |_| operation.as_str())
+            })
+            .collect::<Vec<_>>();
+        if !remaining.is_empty() {
+            return Err(failure(format!(
+                "offline_unused_mock_replies: {}",
+                remaining.join(", ")
+            )));
+        }
+        Ok(())
+    }
+
+    fn timer_thread(&self, caller: &str) -> Option<String> {
+        self.thread
+            .clone()
+            .filter(|_| self.thread_scoped.contains(caller))
+    }
+
+    fn call(&mut self, caller: &str, call: ModHostCall) -> Result<Value> {
+        self.calls.push(
+            json!({"at_ms":self.now_ms,"caller":caller,"operation":call.operation,
+            "arguments":call.arguments}),
+        );
+        let intrinsic = !self.replies.contains_key(&call.operation)
+            && (matches!(call.operation.as_str(), "events.schedule" | "events.cancel")
+                || call.operation == "environment.read" && self.environment.is_some());
+        if intrinsic {
+            operation_validation::validate(&call.operation, "arguments", &call.arguments)
+                .map_err(failure)?;
+            return self.intrinsic(caller, &call);
+        }
+        let replies = self.replies.entry(call.operation.clone()).or_default();
+        while replies.front().is_some_and(|reply| {
+            reply["optional"] == true
+                && reply
+                    .get("arguments")
+                    .is_some_and(|expected| expected != &call.arguments)
+        }) {
+            replies.pop_front();
+        }
+        let Some(response) = replies.pop_front() else {
+            let reason = format!(
+                "offline_unmocked_host_operation: {}; add a deterministic host_operations fixture",
+                call.operation
+            );
+            self.violations.push(reason.clone());
+            return Err(failure(reason));
+        };
+        if let Some(expected) = response.get("arguments")
+            && expected != &call.arguments
+        {
+            let reason = format!(
+                "offline_mock_arguments_mismatch: {}: expected {expected}, got {}",
+                call.operation, call.arguments
+            );
+            replies.push_front(response);
+            self.violations.push(reason.clone());
+            return Err(failure(reason));
+        }
+        if response["unsafe"]["arguments"] != true {
+            operation_validation::validate(&call.operation, "arguments", &call.arguments)
+                .map_err(failure)?;
+        }
+        if let Some(error) = response.get("error").and_then(Value::as_str) {
+            return Err(failure(error));
+        }
+        Ok(response["result"].clone())
+    }
+
+    fn intrinsic(&mut self, caller: &str, call: &ModHostCall) -> Result<Value> {
+        let key = call.arguments["key"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        match (call.operation.as_str(), &self.environment) {
+            ("environment.read", Some(environment)) => {
+                let names = call.arguments["names"]
+                    .as_array()
+                    .filter(|names| (1..=16).contains(&names.len()))
+                    .ok_or_else(|| failure("environment_names_invalid"))?;
+                let values = names
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|name| {
+                        let value = environment.get(name);
+                        let entry = if crate::host::secret_like(name) {
+                            json!({"set": value.is_some()})
+                        } else {
+                            json!({"set": value.is_some(), "value": value})
+                        };
+                        (name.to_owned(), entry)
+                    })
+                    .collect::<serde_json::Map<_, _>>();
+                Ok(json!({"values": values}))
+            }
+            ("events.schedule", _) => {
+                let delay = call.arguments["delay_ms"]
+                    .as_u64()
+                    .filter(|delay| (16..=86_400_000).contains(delay))
+                    .ok_or_else(|| failure("timer_delay_invalid"))?;
+                let deadline = self
+                    .now_ms
+                    .checked_add(delay)
+                    .ok_or_else(|| failure("offline_time_overflow"))?;
+                self.timers.insert(
+                    (self.timer_thread(caller), caller.to_owned(), key.clone()),
+                    (deadline, call.arguments.get("data").cloned()),
+                );
+                Ok(json!({"key": key, "delay_ms": delay}))
+            }
+            _ => {
+                let cancelled = self
+                    .timers
+                    .remove(&(self.timer_thread(caller), caller.to_owned(), key))
+                    .is_some();
+                Ok(json!({"cancelled": cancelled}))
+            }
+        }
+    }
+}
+
+impl ModHost {
+    pub fn author_inspection(&self) -> Value {
+        json!({
+            "api":MOD_API_VERSION,
+            "generation":self.generation,
+            "precedence":"dependencies first, then lexical mod ID; project scope shadows user scope; exclusive replacements fail closed on conflict",
+            "order":self.order,
+            "events":self.loaded.iter().map(|(id, loaded)| json!({
+                "id":id,
+                "scope":loaded.selection.scope,
+                "requires":loaded.package.requires,
+                "events":loaded.registrations.events,
+                "replacements":loaded.registrations.replacements,
+                "error":loaded.error,
+            })).collect::<Vec<_>>(),
+            "rejected":self.rejected,
+        })
+    }
+
+    pub fn capability_explanation(code: &str) -> Value {
+        let unknown;
+        let (cause, fix) = if code.starts_with("capability_denied") {
+            (
+                "The package requested authority that the manifest or explicit trust grant does not include.",
+                "Declare the exact capability in mod.json, inspect the source-use report, then have the user approve the new digest and exact grant; a revoked mod is approved again with omd mods update ID.",
+            )
+        } else if code.starts_with("undeclared_operation_use") {
+            (
+                "Source analysis found a literal host operation whose capability is not declared.",
+                "Add the operation's documented capability or remove the call; rerun check before asking for trust.",
+            )
+        } else if code.starts_with("undeclared_service_use") {
+            (
+                "Source analysis found a service call without a matching manifest import.",
+                "Declare the service name and compatible version under services.imports or remove the call.",
+            )
+        } else if code.starts_with("undeclared_environment_use") {
+            (
+                "Source analysis found environment access outside the manifest declaration.",
+                "Remove the access or declare an admitted environment feature; network, filesystem, process and DOM access are intentionally unavailable.",
+            )
+        } else if code.starts_with("state_capability_denied") {
+            (
+                "The callback changed persistent state without the state capability.",
+                "Declare state or keep the callback stateless, then re-inspect and re-approve the source digest.",
+            )
+        } else if code.starts_with("state_thread_unavailable") {
+            (
+                "The mod keeps thread-scoped state and the call had no session thread to bind it to.",
+                "Pass a thread id as the last argument (omd-mod command STORE MOD NAME JSON THREAD, omd-mod test ROOT SCENARIO THREAD) or set thread_id on the scenario step; in codex, retry once the session has started.",
+            )
+        } else if code.starts_with("repository_provenance_mismatch") {
+            (
+                "A Git install requires mod.json provenance.source to name the repository it is installed from.",
+                "Set provenance.source to the repository URL without git+ and #REF:DIR, or for git+file the repository's absolute path with symlinks resolved; commit it at the tagged revision.",
+            )
+        } else if code.starts_with("host_operation_unavailable") {
+            (
+                "The callback ran without an active native task capable of servicing that host operation.",
+                "Run it inside a task/tool callback or supply an explicit offline host-operation mock in tests.",
+            )
+        } else if code.starts_with("package_blocked") {
+            (
+                "The installed version was quarantined with omd mods quarantine, so it cannot be enabled, reinstalled or rolled back to.",
+                "If the reason no longer applies, run omd mods unblock ID, then omd mods enable ID.",
+            )
+        } else if code.starts_with("source_changed") {
+            (
+                "The package's files no longer match the digest the user trusted.",
+                "Review the change and approve it again in /omd or with omd mods update ID.",
+            )
+        } else if code.starts_with("package_not_trusted") {
+            (
+                "The store has no trusted selection for that mod or folder.",
+                "Install it with omd install REFERENCE, or trust a folder with omd-mod trust STORE PACKAGE SHA256 CAPABILITIES_CSV.",
+            )
+        } else if code.starts_with("managed_by_policy") {
+            (
+                "Administrator policy requires this mod, so it cannot be turned off locally.",
+                "Run omd-mod policy explain STORE to see the policy, then ask your administrator to change it.",
+            )
+        } else {
+            unknown = format!("OMD has no explanation for {code}; its cause is unknown.");
+            (
+                unknown.as_str(),
+                "Run omd-mod report STORE and omd-mod events STORE to see which mod or host step raised it.",
+            )
+        };
+        json!({"code":code,"cause":cause,"fix":fix,
+            "guarantee":"Author tooling can explain a denial but cannot grant authority, change trust, or bypass host enforcement."})
+    }
+
+    pub fn diagnostic_bundle(&self) -> Value {
+        let mut bundle = json!({
+            "schema":1,
+            "host":{"codex":CODEX_HOST_RELEASE,"omd":OMD_HOST_RELEASE,"api":MOD_API_VERSION},
+            "configuration_sha256":self.configuration_sha256,
+            "status":self.status(),
+            "inspection":self.author_inspection(),
+            "redaction":{"paths":true,"settings":true,"environment":true,"credentials":true},
+        });
+        let mut paths = vec![(self.store.root.display().to_string(), "$STORE".to_owned())];
+        paths.extend(self.loaded.iter().map(|(id, loaded)| {
+            (
+                loaded.selection.path.display().to_string(),
+                format!("$MOD/{id}"),
+            )
+        }));
+        redact_value(&mut bundle, None, &paths);
+        bundle
+    }
+
+    pub fn offline_test(&mut self, scenario: Value) -> Result<Value> {
+        if scenario.get("schema").and_then(Value::as_u64) != Some(1) {
+            return Err(failure("offline_scenario_schema_1_required"));
+        }
+        let mut now_ms = scenario
+            .get("virtual_time_ms")
+            .and_then(Value::as_u64)
+            .unwrap_or(0);
+        let mut host = OfflineHost::from_scenario(&scenario, now_ms)?;
+        let steps = scenario
+            .get("steps")
+            .and_then(Value::as_array)
+            .ok_or_else(|| failure("offline_steps_required"))?;
+        if steps.len() > 256 {
+            return Err(failure("offline_step_limit"));
+        }
+        let mut tiers = BTreeMap::new();
+        for (id, tier) in scenario
+            .get("tiers")
+            .map(|tiers| {
+                tiers
+                    .as_object()
+                    .ok_or_else(|| failure("offline_tiers_must_be_an_object"))
+            })
+            .transpose()?
+            .into_iter()
+            .flatten()
+        {
+            let tier: ManagedTier = serde_json::from_value(tier.clone())
+                .map_err(|_| failure(format!("offline_tier_invalid: {id}")))?;
+            let loaded = self
+                .loaded
+                .get(id)
+                .ok_or_else(|| failure(format!("offline_tier_unknown_mod: {id}")))?;
+            tiers.insert(id.clone(), (tier, (*loaded.selection).clone()));
+        }
+        self.tier_selections = tiers
+            .iter()
+            .map(|(id, (_, selection))| (id.clone(), selection.clone()))
+            .collect();
+        let result = self.offline_steps(steps, &tiers, &mut host, &mut now_ms);
+        self.tier_selections.clear();
+        process::detach(&host.owner);
+        for (id, (_, selection)) in tiers {
+            if let Some(loaded) = self
+                .loaded
+                .get_mut(&id)
+                .filter(|loaded| loaded.selection.scope == MANAGED_SCOPE)
+            {
+                let current = Arc::make_mut(&mut loaded.selection);
+                current.scope = selection.scope;
+                current.tier = selection.tier;
+            }
+        }
+        self.virtual_time_ms = None;
+        let outputs = result?;
+        host.finish()?;
+        let remaining = host
+            .replies
+            .iter()
+            .filter(|(_, replies)| replies.iter().any(|reply| reply["optional"] != true))
+            .map(|(operation, replies)| json!({"operation":operation,"remaining":replies.iter().filter(|reply| reply["optional"] != true).count()}))
+            .collect::<Vec<_>>();
+        Ok(
+            json!({"schema":1,"offline":true,"paid_requests":0,"virtual_time_ms":now_ms,
+            "steps":outputs,"host_calls":host.calls,"unused_mock_replies":remaining,
+            "status":self.status()}),
+        )
+    }
+
+    fn offline_steps(
+        &mut self,
+        steps: &[Value],
+        tiers: &BTreeMap<String, (ManagedTier, ModSelection)>,
+        host: &mut OfflineHost,
+        now_ms: &mut u64,
+    ) -> Result<Vec<Value>> {
+        let mut outputs = Vec::new();
+        for (index, step) in steps.iter().enumerate() {
+            for (id, (tier, _)) in tiers {
+                if let Some(loaded) = self.loaded.get_mut(id) {
+                    let selection = Arc::make_mut(&mut loaded.selection);
+                    selection.scope = MANAGED_SCOPE.to_owned();
+                    selection.tier = Some(*tier);
+                }
+            }
+            let kind = step
+                .get("type")
+                .and_then(Value::as_str)
+                .ok_or_else(|| failure("offline_step_type_required"))?;
+            let cancelled = step
+                .get("cancelled")
+                .and_then(Value::as_bool)
+                .unwrap_or(false);
+            self.virtual_time_ms = Some(*now_ms);
+            host.now_ms = *now_ms;
+            host.thread_scoped = self
+                .loaded
+                .iter()
+                .filter(|(_, loaded)| loaded.package.state_scope == "thread")
+                .map(|(id, _)| id.clone())
+                .collect();
+            let result = self.offline_step(kind, step, !cancelled, host, now_ms);
+            let output = match result {
+                Ok(value) => {
+                    if let Some(expected) = step.get("expect")
+                        && &value != expected
+                    {
+                        return Err(failure(format!(
+                            "offline_expectation_failed at step {index}: expected {expected}, got {value}"
+                        )));
+                    }
+                    if step.get("expect_error").is_some() {
+                        return Err(failure(format!(
+                            "offline_expected_error_missing at step {index}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":*now_ms,"value":value})
+                }
+                Err(error) => {
+                    let text = error.to_string();
+                    let Some(expected) = step.get("expect_error").and_then(Value::as_str) else {
+                        return Err(failure(format!(
+                            "offline_step_failed at step {index}: {text}"
+                        )));
+                    };
+                    if !text.contains(expected) {
+                        return Err(failure(format!(
+                            "offline_error_mismatch at step {index}: expected {expected}, got {text}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":*now_ms,"error":text})
+                }
+            };
+            outputs.push(output);
+        }
+        Ok(outputs)
+    }
+
+    fn offline_step(
+        &mut self,
+        kind: &str,
+        step: &Value,
+        active: bool,
+        host: &mut OfflineHost,
+        now_ms: &mut u64,
+    ) -> Result<Value> {
+        let payload = step.get("payload").cloned().unwrap_or(Value::Null);
+        let _thread = StateThread::enter(
+            state_thread(&payload).or_else(|| step["thread_id"].as_str().map(str::to_owned)),
+        );
+        host.thread = bound_thread();
+        match kind {
+            "advance_time" => {
+                let delta = step
+                    .get("ms")
+                    .and_then(Value::as_u64)
+                    .ok_or_else(|| failure("offline_advance_ms_required"))?;
+                let until = now_ms
+                    .checked_add(delta)
+                    .ok_or_else(|| failure("offline_virtual_time_overflow"))?;
+                let mut fired = Vec::new();
+                // Due timers fire in due order at their own virtual time; a handler may reschedule.
+                while let Some(((thread, owner, key), (due, data))) = host
+                    .timers
+                    .iter()
+                    .filter(|(_, (due, _))| *due <= until)
+                    .min_by_key(|(_, (due, _))| *due)
+                    .map(|(timer, value)| (timer.clone(), value.clone()))
+                {
+                    if fired.len() >= 256 {
+                        return Err(failure("offline_timer_limit"));
+                    }
+                    host.timers
+                        .remove(&(thread.clone(), owner.clone(), key.clone()));
+                    (*now_ms, host.now_ms) = (due, due);
+                    self.virtual_time_ms = Some(due);
+                    host.thread = thread.clone().or_else(bound_thread);
+                    let _thread = StateThread::enter(host.thread.clone());
+                    let mut payload = json!({"key": key});
+                    if let Some(data) = data {
+                        payload["data"] = data;
+                    }
+                    let value = self.invoke(
+                        &owner,
+                        self.generation,
+                        "timer",
+                        "",
+                        payload,
+                        ModInvokeOptions {
+                            active: &|| active,
+                            host: ModHostCallback::Scoped(&mut |caller, call| {
+                                host.call(caller, call)
+                            }),
+                            ..ModInvokeOptions::default()
+                        },
+                    );
+                    fired.push(match value {
+                        Ok(_) => json!({"mod": owner, "key": key, "at_ms": due}),
+                        Err(error) => json!({"mod": owner, "key": key, "at_ms": due, "error": error.to_string()}),
+                    });
+                }
+                *now_ms = until;
+                let mut value = json!({"now_ms": now_ms});
+                if !fired.is_empty() {
+                    value["timers"] = json!(fired);
+                }
+                Ok(value)
+            }
+            "wait_until" => {
+                let check = step
+                    .get("check")
+                    .ok_or_else(|| failure("offline_wait_check_required"))?;
+                let until = step
+                    .get("until")
+                    .ok_or_else(|| failure("offline_wait_until_required"))?;
+                let every_ms = step.get("every_ms").and_then(Value::as_u64).unwrap_or(1000);
+                let max_ms = step
+                    .get("max_ms")
+                    .and_then(Value::as_u64)
+                    .ok_or_else(|| failure("offline_wait_max_ms_required"))?;
+                if every_ms == 0 || max_ms / every_ms > 256 {
+                    return Err(failure("offline_wait_limit"));
+                }
+                let start = *now_ms;
+                loop {
+                    self.virtual_time_ms = Some(*now_ms);
+                    host.now_ms = *now_ms;
+                    let value = self.offline_step(
+                        required_string(check, "type")?,
+                        check,
+                        active,
+                        host,
+                        now_ms,
+                    )?;
+                    if &value == until {
+                        return Ok(json!({"waited_ms": *now_ms - start, "value": value}));
+                    }
+                    if *now_ms - start >= max_ms {
+                        return Err(failure(format!(
+                            "offline_wait_timeout: {until} not reached in {max_ms} ms, last {value}"
+                        )));
+                    }
+                    let delta = every_ms.min(max_ms - (*now_ms - start));
+                    self.offline_step("advance_time", &json!({"ms": delta}), active, host, now_ms)?;
+                }
+            }
+            "client_attach" => {
+                host.attached += 1;
+                let mut renderer = json!({"kind": "gui", "formats": [], "pointer": "none", "reduced_motion": false});
+                if let (Some(renderer), Some(given)) = (
+                    renderer.as_object_mut(),
+                    step.get("renderer").and_then(Value::as_object),
+                ) {
+                    renderer.extend(given.clone());
+                }
+                let id = format!("client-{}", host.attached);
+                host.clients.push(json!({"id": id, "name": required_string(step, "name")?,
+                    "renderer": renderer,
+                    "viewport": step.get("viewport").cloned().unwrap_or(Value::Null),
+                    "focused": step["focused"].as_bool().unwrap_or(false), "attached_ms": *now_ms}));
+                Ok(json!({"id": id, "clients": host.clients}))
+            }
+            "client_detach" => {
+                let id = required_string(step, "id")?;
+                let before = host.clients.len();
+                host.clients.retain(|client| client["id"] != id);
+                if host.clients.len() == before {
+                    return Err(failure("offline_client_not_attached"));
+                }
+                Ok(json!({"clients": host.clients}))
+            }
+            "status" => Ok(self.status()),
+            "state" => {
+                let id = required_string(step, "mod")?;
+                let loaded = self.loaded.get(id).ok_or_else(|| failure("mod_disabled"))?;
+                let location = self.state_location(
+                    &loaded.package,
+                    &loaded.selection.scope,
+                    step.get("thread_id").and_then(Value::as_str),
+                );
+                let version = loaded.package.state_version;
+                let current = self.store.scoped_state(&location, version)?;
+                let Some(value) = step.get("value") else {
+                    return Ok(current);
+                };
+                if !loaded.package.capabilities.iter().any(|c| c == "store") {
+                    return Err(failure("state_capability_denied"));
+                }
+                self.store
+                    .write_scoped_state(&location, version, &current, value)?;
+                Ok(value.clone())
+            }
+            "reload" => {
+                self.store.reload()?;
+                self.turn_boundary(&|| true);
+                if let Some(error) = &self.reload_error {
+                    return Err(failure(error));
+                }
+                Ok(json!({"generation":self.generation,"reload_error":self.reload_error}))
+            }
+            "tool_exposure" => {
+                let thread_id = step
+                    .get("thread_id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned);
+                let tools = self.tools_for_step(thread_id, payload, || active);
+                Ok(json!(
+                    tools
+                        .into_iter()
+                        .map(|(id, _, tool)| format!("mod_{id}_{}", tool.name))
+                        .collect::<Vec<_>>()
+                ))
+            }
+            "intercept" => {
+                let surface = required_string(step, "surface")?;
+                let mut replies = step
+                    .get("core")
+                    .and_then(Value::as_array)
+                    .cloned()
+                    .unwrap_or_default()
+                    .into_iter();
+                let mut core_calls = Vec::new();
+                let mut core = |input: Value| {
+                    core_calls.push(input);
+                    let reply = replies
+                        .next()
+                        .ok_or_else(|| failure("offline_core_reply_missing"))?;
+                    match reply.get("error").and_then(Value::as_str) {
+                        Some(error) => Err(failure(error)),
+                        None => Ok(reply.get("value").cloned().unwrap_or(Value::Null)),
+                    }
+                };
+                let origin = step
+                    .get("origin")
+                    .cloned()
+                    .unwrap_or_else(|| json!({"caller": "offline"}));
+                let chain = chain::intercept(
+                    &mut Access::Held(self),
+                    &mut |caller, call| host.call(caller, call),
+                    &mut chain::Core::Call(&mut core),
+                    surface,
+                    true,
+                    payload,
+                    origin,
+                    &|| active,
+                    &InvocationScope::default(),
+                )?;
+                let mut value = serde_json::to_value(chain)?;
+                for entry in value["trace"].as_array_mut().into_iter().flatten() {
+                    entry.as_object_mut().map(|entry| entry.remove("ms"));
+                }
+                value["core_calls"] = Value::Array(core_calls);
+                Ok(value)
+            }
+            "event" | "tool_outcome" | "agent" => {
+                let event = match kind {
+                    "tool_outcome" => "tool_result",
+                    "agent" => "agent",
+                    _ => step
+                        .get("event")
+                        .and_then(Value::as_str)
+                        .ok_or_else(|| failure("offline_event_name_required"))?,
+                };
+                let ids = self.event_ids(event);
+                let mut values = Vec::new();
+                for id in ids {
+                    let generation = self.generation;
+                    let value = self.invoke(
+                        &id,
+                        generation,
+                        event,
+                        "",
+                        payload.clone(),
+                        ModInvokeOptions {
+                            active: &|| active,
+                            host: ModHostCallback::Scoped(&mut |caller, call| {
+                                host.call(caller, call)
+                            }),
+                            ..ModInvokeOptions::default()
+                        },
+                    )?;
+                    values.push(json!({"mod":id,"value":value}));
+                }
+                Ok(Value::Array(values))
+            }
+            "invoke" => {
+                let id = required_string(step, "mod")?;
+                let event = required_string(step, "event")?;
+                let name = required_string(step, "name")?;
+                self.invoke(
+                    id,
+                    self.generation,
+                    event,
+                    name,
+                    payload,
+                    ModInvokeOptions {
+                        active: &|| active,
+                        host: ModHostCallback::Scoped(&mut |caller, call| host.call(caller, call)),
+                        ..ModInvokeOptions::default()
+                    },
+                )
+            }
+            "component" => {
+                let id = required_string(step, "mod")?;
+                let module = required_string(step, "module")?;
+                let instance = step
+                    .get("instance")
+                    .and_then(Value::as_str)
+                    .unwrap_or(module);
+                let size = |name: &str, default: u64| {
+                    step.get(name).and_then(Value::as_u64).unwrap_or(default)
+                };
+                let frame = json!({"instance": format!("{}.{instance}", host.owner),
+                    "client": host.owner, "props": step.get("props").cloned().unwrap_or(Value::Null),
+                    "now": *now_ms, "columns": size("columns", 80), "rows": size("rows", 0),
+                    "events": step.get("events").cloned().unwrap_or_else(|| json!([]))});
+                let mut host = |_: &str, call: ModHostCall| {
+                    Err(failure(format!(
+                        "host_operation_unavailable: {} is not available to component modules",
+                        call.operation
+                    )))
+                };
+                let options = ModInvokeOptions {
+                    active: &|| active,
+                    host: ModHostCallback::Scoped(&mut host),
+                    ..ModInvokeOptions::default()
+                };
+                let result =
+                    self.invoke(id, self.generation, "component", module, frame, options)?;
+                render::checked_tree(&result)?;
+                Ok(result)
+            }
+            "terminal_mount" | "terminal_interact" => {
+                let id = required_string(step, "mod")?;
+                let mut payload = payload;
+                if let Some(input) = payload.as_object_mut() {
+                    input
+                        .entry("clients")
+                        .or_insert_with(|| json!(host.clients));
+                }
+                let view = self.invoke(
+                    id,
+                    self.generation,
+                    "terminal",
+                    "",
+                    payload,
+                    ModInvokeOptions {
+                        active: &|| active,
+                        host: ModHostCallback::Scoped(&mut |caller, call| host.call(caller, call)),
+                        ..ModInvokeOptions::default()
+                    },
+                )?;
+                ModViewPatch::parse(view.clone())?;
+                let parsed = ModView::parse(view.clone())?;
+                if kind == "terminal_mount" {
+                    return Ok(view);
+                }
+                if let Some(pointer) = step.get("pointer") {
+                    let component = required_string(step, "component")?;
+                    let mounted = parsed
+                        .sites
+                        .values()
+                        .find_map(|site| terminal_component(&site.components, component))
+                        .ok_or_else(|| failure("offline_terminal_component_not_mounted"))?;
+                    if !matches!(
+                        mounted,
+                        ModComponent::Box { pointer: true, .. }
+                            | ModComponent::Pane { pointer: true, .. }
+                            | ModComponent::Image { pointer: true, .. }
+                            | ModComponent::Raster { pointer: true, .. }
+                            | ModComponent::Module { pointer: true, .. }
+                    ) {
+                        return Err(failure("offline_terminal_component_not_pointer"));
+                    }
+                    let valid = pointer["column"].is_i64()
+                        && pointer["row"].is_i64()
+                        && pointer["action"]
+                            .as_str()
+                            .is_some_and(|action| POINTER_ACTIONS.contains(&action))
+                        && (pointer["half"].is_null()
+                            || matches!(pointer["half"].as_u64(), Some(0 | 1)))
+                        && (pointer["button"].is_null()
+                            || matches!(
+                                pointer["button"].as_str(),
+                                Some("left" | "right" | "middle")
+                            ));
+                    if !valid {
+                        return Err(failure("offline_terminal_pointer_invalid"));
+                    }
+                    let mut event = json!({"component": component, "kind": "pointer",
+                        "pointer": {"column": pointer["column"], "row": pointer["row"], "half": pointer["half"],
+                            "action": pointer["action"], "button": pointer["button"]}});
+                    match step.get("client").and_then(Value::as_str) {
+                        Some(client) if host.clients.iter().any(|entry| entry["id"] == client) => {
+                            event["client"] = json!(client);
+                        }
+                        Some(_) => return Err(failure("offline_client_not_attached")),
+                        None => event["origin"] = json!("user"),
+                    }
+                    let result = self.invoke(
+                        id,
+                        self.generation,
+                        "component_event",
+                        "",
+                        event.clone(),
+                        ModInvokeOptions {
+                            active: &|| active,
+                            host: ModHostCallback::Scoped(&mut |caller, call| {
+                                host.call(caller, call)
+                            }),
+                            ..ModInvokeOptions::default()
+                        },
+                    )?;
+                    return Ok(json!({"event": event, "result": result}));
+                }
+                let action = if let Some(component) = step.get("component").and_then(Value::as_str)
+                {
+                    terminal_component_action(
+                        &parsed,
+                        component,
+                        step.get("value").and_then(Value::as_str),
+                    )?
+                } else {
+                    let key = required_string(step, "key")?;
+                    serde_json::to_value(
+                        parsed
+                            .keybindings
+                            .get(key)
+                            .or_else(|| {
+                                parsed.key_contexts.iter().find_map(|context| {
+                                    context.keys.get(key).map(|binding| &binding.action)
+                                })
+                            })
+                            .ok_or_else(|| failure("offline_terminal_key_not_mounted"))?,
+                    )?
+                };
+                if let Some(command) = action.get("command").and_then(Value::as_str) {
+                    let (owner, name) = command.split_once(':').unwrap_or((id, command));
+                    let args = action.get("args").cloned().unwrap_or_else(|| json!(""));
+                    let result = self.invoke(
+                        owner,
+                        self.generation,
+                        "command",
+                        name,
+                        args,
+                        ModInvokeOptions {
+                            active: &|| active,
+                            host: ModHostCallback::Scoped(&mut |caller, call| {
+                                host.call(caller, call)
+                            }),
+                            ..ModInvokeOptions::default()
+                        },
+                    )?;
+                    Ok(json!({"action":action,"result":result}))
+                } else {
+                    Ok(json!({"action":action}))
+                }
+            }
+            _ => Err(failure(format!("offline_unknown_step_type: {kind}"))),
+        }
+    }
+}
+
+fn required_string<'a>(value: &'a Value, key: &str) -> Result<&'a str> {
+    value
+        .get(key)
+        .and_then(Value::as_str)
+        .ok_or_else(|| failure(format!("offline_{key}_required")))
+}
+
+fn terminal_component<'a>(components: &'a [ModComponent], id: &str) -> Option<&'a ModComponent> {
+    components.iter().find_map(|component| {
+        let (component_id, children) = match component {
+            ModComponent::Box { id, children, .. }
+            | ModComponent::Pane { id, children, .. }
+            | ModComponent::Dialog { id, children, .. } => (Some(id.as_str()), children.as_slice()),
+            ModComponent::Text { id, .. }
+            | ModComponent::Line { id, .. }
+            | ModComponent::Button { id, .. }
+            | ModComponent::Input { id, .. }
+            | ModComponent::Select { id, .. }
+            | ModComponent::Multiselect { id, .. }
+            | ModComponent::Markdown { id, .. }
+            | ModComponent::Code { id, .. }
+            | ModComponent::List { id, .. }
+            | ModComponent::Document { id, .. }
+            | ModComponent::Diff { id, .. }
+            | ModComponent::Terminal { id, .. }
+            | ModComponent::Image { id, .. }
+            | ModComponent::Raster { id, .. }
+            | ModComponent::Module { id, .. } => (Some(id.as_str()), &[][..]),
+            ModComponent::Slot | ModComponent::Native { .. } => (None, &[][..]),
+        };
+        if component_id == Some(id) {
+            Some(component)
+        } else {
+            terminal_component(children, id)
+        }
+    })
+}
+
+fn terminal_component_action(view: &ModView, id: &str, value: Option<&str>) -> Result<Value> {
+    let component = view
+        .sites
+        .values()
+        .find_map(|site| terminal_component(&site.components, id))
+        .ok_or_else(|| failure("offline_terminal_component_not_mounted"))?;
+    let command = |action: &ModCommandAction, value: Option<&str>| {
+        let args = match value {
+            Some(value) if action.args.is_empty() => value.to_owned(),
+            Some(value) => format!("{} {value}", action.args),
+            None => action.args.clone(),
+        };
+        serde_json::to_value(ModKeyAction::Command {
+            command: action.command.clone(),
+            args,
+        })
+        .map_err(failure)
+    };
+    match component {
+        ModComponent::Button { action, .. } => serde_json::to_value(action).map_err(failure),
+        ModComponent::Input {
+            action,
+            value: current,
+            ..
+        } => command(action, value.or(Some(current))),
+        ModComponent::Select {
+            action,
+            value: current,
+            options,
+            ..
+        } => {
+            let selected = value.unwrap_or(current);
+            if !options.iter().any(|option| option.value == selected) {
+                return Err(failure("offline_terminal_select_value_not_mounted"));
+            }
+            command(action, Some(selected))
+        }
+        ModComponent::Multiselect {
+            action,
+            value: current,
+            options,
+            ..
+        } => {
+            let selected = match value {
+                Some(value) => serde_json::from_str::<Vec<String>>(value)
+                    .map_err(|_| failure("offline_terminal_multiselect_value_invalid"))?,
+                None => current.clone(),
+            };
+            if selected
+                .iter()
+                .collect::<std::collections::BTreeSet<_>>()
+                .len()
+                != selected.len()
+                || !selected
+                    .iter()
+                    .all(|value| options.iter().any(|option| option.value == *value))
+            {
+                return Err(failure("offline_terminal_select_value_not_mounted"));
+            }
+            let ordered = options
+                .iter()
+                .filter(|option| selected.contains(&option.value))
+                .map(|option| &option.value)
+                .collect::<Vec<_>>();
+            command(
+                action,
+                Some(&serde_json::to_string(&ordered).map_err(failure)?),
+            )
+        }
+        ModComponent::List {
+            action,
+            rows,
+            selected: current,
+            ..
+        } => {
+            let selected = value
+                .or(current.as_deref())
+                .ok_or_else(|| failure("offline_terminal_list_value_required"))?;
+            if !rows.iter().any(|row| row.value == selected) {
+                return Err(failure("offline_terminal_list_value_not_mounted"));
+            }
+            command(action, Some(selected))
+        }
+        _ => Err(failure("offline_terminal_component_not_interactive")),
+    }
+}
+
+fn redact_value(value: &mut Value, key: Option<&str>, paths: &[(String, String)]) {
+    if key.is_some_and(crate::resource_data::secret_name) && !value.is_boolean() {
+        *value = Value::String("[REDACTED]".to_owned());
+        return;
+    }
+    match value {
+        Value::String(text) => {
+            for (path, replacement) in paths {
+                *text = text.replace(path, replacement);
+            }
+            *text = crate::resource_data::redact(text);
+        }
+        Value::Array(values) => {
+            for value in values {
+                redact_value(value, None, paths);
+            }
+        }
+        Value::Object(object) => {
+            for (key, value) in object {
+                redact_value(value, Some(key), paths);
+            }
+        }
+        _ => {}
+    }
+}
