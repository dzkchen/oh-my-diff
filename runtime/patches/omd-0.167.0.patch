+pub(crate) fn paint_surface(
+    area: Rect,
+    buffer: &mut Buffer,
+    paint: &codex_omd::ModSurfacePaint,
+    base: Option<Color>,
+) {
+    if area.is_empty() || crate::mod_client::facts().no_color {
+        return;
+    }
+    let a = paint.top.or(paint.bottom).map(rgb);
+    let b = paint.bottom.or(paint.top).map(rgb);
+    let alpha = paint.opacity.unwrap_or(1.0);
+    let fallback = crate::terminal_palette::default_bg()
+        .map(|(r, g, b)| [r, g, b])
+        .unwrap_or([0; 3]);
+    for y in area.top()..area.bottom() {
+        for x in area.left()..area.right() {
+            let cell = &mut buffer[(x, y)];
+            let can_paint_background = cell.bg == Color::Reset || Some(cell.bg) == base;
+            if can_paint_background && let (Some(a), Some(b)) = (a, b) {
+                let ratio = f32::from(y - area.y) / f32::from(area.height.saturating_sub(1).max(1));
+                let underlying = match cell.bg {
+                    Color::Rgb(r, g, b) => [r, g, b],
+                    _ => fallback,
+                };
+                let value: [u8; 3] = std::array::from_fn(|i| {
+                    ((f32::from(a[i]) * (1.0 - ratio) + f32::from(b[i]) * ratio) * alpha
+                        + f32::from(underlying[i]) * (1.0 - alpha))
+                        .round() as u8
+                });
+                cell.set_bg(crate::terminal_palette::best_color((
+                    value[0], value[1], value[2],
+                )));
+            }
+            if cell.fg == Color::Reset
+                && let Some(fg) = paint.foreground
+            {
+                let actual_background = match cell.bg {
+                    Color::Rgb(r, g, b) => [r, g, b],
+                    Color::Indexed(index) => rgb(ModColor::Indexed(index)),
+                    _ => fallback,
+                };
+                cell.set_fg(color(readable(fg, actual_background)));
+            }
+            if can_paint_background
+                && alpha > 0.0
+                && let Some(border) = paint.border
+                && cell.symbol() == " "
+                && area.width >= 4
+                && area.height >= 3
+            {
+                let on_top = y == area.top();
+                let on_bottom = y + 1 == area.bottom();
+                if on_top || on_bottom || x == area.left() || x + 1 == area.right() {
+                    cell.set_char(if on_top || on_bottom { '-' } else { '|' })
+                        .set_fg(color(border));
+                }
+            }
+        }
+    }
+}
+
+pub(crate) const APPROVAL_VIEW_ID: &str = "approval";
+
+fn contrast(a: [u8; 3], b: [u8; 3]) -> f32 {
+    let luminance = |rgb: [u8; 3]| -> f32 {
+        rgb.into_iter()
+            .enumerate()
+            .map(|(i, c)| {
+                let value = f32::from(c) / 255.0;
+                let value = if value <= 0.04045 {
+                    value / 12.92
+                } else {
+                    ((value + 0.055) / 1.055).powf(2.4)
+                };
+                value * [0.2126, 0.7152, 0.0722][i]
+            })
+            .sum()
+    };
+    let (a, b) = (luminance(a), luminance(b));
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
+
+pub(crate) fn rgb(color: ModColor) -> [u8; 3] {
+    let (r, g, b) = match color {
+        ModColor::Rgb(r, g, b) => (r, g, b),
+        ModColor::Indexed(index) => crate::terminal_palette::XTERM_COLORS[usize::from(index)],
+    };
+    [r, g, b]
+}
+
+pub(crate) fn readable(fg: ModColor, background: [u8; 3]) -> ModColor {
+    if contrast(rgb(fg), background) >= 4.5 {
+        fg
+    } else if contrast([255; 3], background) >= contrast([0; 3], background) {
+        ModColor::Rgb(255, 255, 255)
+    } else {
+        ModColor::Rgb(0, 0, 0)
+    }
+}
+
+pub(crate) fn paint_named(name: &str, area: Rect, buffer: &mut Buffer, base: Option<Color>) {
+    let Some(paint) =
+        with_cache(|cache| cache.snapshot.view.surface_styles.get(name).cloned()).flatten()
+    else {
+        return;
+    };
+    paint_surface(area, buffer, &paint, base);
+    if name != APPROVAL_VIEW_ID {
+        return;
+    }
+    let cell_rgb = |color: Color, default: Option<(u8, u8, u8)>| match color {
+        Color::Rgb(r, g, b) => Some([r, g, b]),
+        Color::Indexed(index) => Some(rgb(ModColor::Indexed(index))),
+        Color::Reset => default.map(|(r, g, b)| [r, g, b]),
+        _ => None,
+    };
+    let (default_fg, default_bg) = (
+        crate::terminal_palette::default_fg(),
+        crate::terminal_palette::default_bg(),
+    );
+    for y in area.top()..area.bottom() {
+        for x in area.left()..area.right() {
+            let cell = &mut buffer[(x, y)];
+            if let (Some(fg), Some(bg)) =
+                (cell_rgb(cell.fg, default_fg), cell_rgb(cell.bg, default_bg))
+            {
+                cell.set_fg(color(readable(ModColor::Rgb(fg[0], fg[1], fg[2]), bg)));
+            }
+        }
+    }
+}
+
+/// Components without a height share the rows a layout region leaves after its fixed components.
+fn fill_heights(
+    components: &mut [ModComponent],
+    width: u16,
+    rows: u16,
+    frame: &Frame,
+    interaction: &Interaction,
+) {
+    let fills = |component: &ModComponent| {
+        matches!(
+            component,
+            ModComponent::Terminal { height: None, .. }
+                | ModComponent::Document { height: None, .. }
+                | ModComponent::Diff { height: None, .. }
+                | ModComponent::List { height: None, .. }
+                | ModComponent::Raster { height: None, .. }
+        )
+    };
+    let count = components
+        .iter()
+        .filter(|component| fills(component))
+        .count();
+    if count == 0 {
+        return;
+    }
+    let fixed = components
+        .iter()
+        .filter(|component| !fills(component))
+        .cloned()
+        .collect::<Vec<_>>();
+    let visible = components
+        .iter()
+        .filter(|component| {
+            component_height(
+                std::slice::from_ref(component),
+                width,
+                frame.look,
+                interaction,
+            ) > 0
+        })
+        .count();
+    let share = match frame.direction {
+        ModDirection::Row => rows,
+        ModDirection::Column => {
+            rows.saturating_sub(component_height(&fixed, width, frame.look, interaction))
+                .saturating_sub(
+                    frame.gap * u16::try_from(visible.saturating_sub(1)).unwrap_or(u16::MAX),
+                )
+                / u16::try_from(count).unwrap_or(u16::MAX)
+        }
+    };
+    for component in components {
+        match component {
+            ModComponent::Terminal { height, .. } if height.is_none() => {
+                *height = Some(share.saturating_sub(1).max(2));
+            }
+            ModComponent::Document { height, .. }
+            | ModComponent::Diff { height, .. }
+            | ModComponent::List { height, .. }
+            | ModComponent::Raster { height, .. }
+                if height.is_none() =>
+            {
+                *height = Some(share.max(1));
+            }
+            _ => {}
+        }
+    }
+}
+
+pub(crate) fn render_owned(
+    screen: Rect,
+    chat: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+) -> BTreeMap<String, (u16, u16)> {
+    INTERACTION.with(|interaction_state| {
+        let Some(placement) = placement(screen, snapshot) else {
+            return render(screen, chat, buffer, snapshot);
+        };
+        let style = panel_style(&snapshot.view);
+        let mut interaction = interaction_state.locked();
+        let tabs = placement
+            .regions
+            .iter()
+            .filter_map(|region| {
+                Some((
+                    region.content.strip_prefix("site:")?.to_owned(),
+                    region.tabs.clone()?,
+                ))
+            })
+            .collect();
+        begin_regions(&mut interaction, snapshot, focus_areas(&placement), tabs);
+        interaction.targets.clear();
+        interaction.key_panes.clear();
+        interaction.order.clear();
+        interaction.columns.clear();
+        interaction.hitboxes.clear();
+        interaction.regions.clear();
+        interaction.layers.clear();
+        interaction.anchors.clear();
+        interaction.layer = 0;
+        interaction.owners = snapshot.contributors.clone();
+        interaction.component_owners = snapshot.component_owners.clone();
+        bind_terminals(&mut interaction, snapshot);
+        footer::register_footer(&mut interaction);
+        let mut drawn = BTreeMap::new();
+        for region in &placement.regions {
+            let Some(name) = region.content.strip_prefix("site:") else {
+                continue;
+            };
+            let mut components = site(&snapshot.view, name)
+                .map(|site| site.components.clone())
+                .unwrap_or_default();
+            let theme = &snapshot.view.theme;
+            let focused = interaction.focus_region.as_deref() == Some(name);
+            let frame = Frame::card(region.style, (theme.border, theme.icons), false, focused);
+            fill_heights(
+                &mut components,
+                frame.inner(region.area.width),
+                region.area.height.saturating_sub(frame.rows(true)),
+                &frame,
+                &interaction,
+            );
+            let margin = frame.margin;
+            let bordered = frame.border.is_some();
+            if let Some(inner) = render_site(
+                region.area,
+                &components,
+                style,
+                buffer,
+                &mut interaction,
+                frame,
+                match region.title.as_deref() {
+                    Some("") => None,
+                    title => Some(Line::from(title.unwrap_or(name).to_owned())),
+                },
+            ) && name.contains('/')
+            {
+                drawn.insert(name.to_owned(), (inner.width, inner.height));
+            }
+            if focused && region.style.and_then(|style| style.focus).is_none() {
+                accent_edges(
+                    region
+                        .area
+                        .inner(ratatui::layout::Margin::new(margin.1, margin.0)),
+                    bordered,
+                    buffer,
+                );
+            }
+        }
+        if let Some((area, title)) = &placement.heading {
+            let rule = glyph("─", "-");
+            let title_style = if interaction.region_keys && interaction.focus_region.is_none() {
+                crate::style::accent_style().bold()
+            } else {
+                Style::default()
+            };
+            let line = Line::from(vec![
+                ratatui::text::Span::styled(format!("{rule} "), style.dim()),
+                ratatui::text::Span::styled(title.clone(), title_style),
+                ratatui::text::Span::styled(
+                    format!(" {}", rule.repeat(usize::from(area.width))),
+                    style.dim(),
+                ),
+            ]);
+            Paragraph::new(crate::line_truncation::truncate_line_to_width(
+                line,
+                usize::from(area.width),
+            ))
+            .render(*area, buffer);
+        }
+        for bar in &placement.tabs {
+            let spans = crate::mod_layout::tab_line(bar)
+                .into_iter()
+                .map(|(title, active)| {
+                    if active {
+                        ratatui::text::Span::styled(title, crate::style::accent_style().bold())
+                    } else {
+                        ratatui::text::Span::styled(title, style.dim())
+                    }
+                })
+                .collect::<Vec<_>>();
+            Paragraph::new(Line::from(spans)).render(bar.area, buffer);
+        }
+        if let Some(shade) = crate::mod_layout::dock_preview() {
+            shade_dock_zone(shade, buffer);
+        }
+        if std::mem::take(&mut interaction.follow_tab)
+            && let Some(region) = interaction.focus_region.clone()
+        {
+            interaction.focused = region_control(&interaction, &region);
+        }
+        render_overlays(
+            screen,
+            snapshot,
+            style,
+            buffer,
+            &mut interaction,
+            &mut drawn,
+        );
+        render_dialog(screen, chat, snapshot, style, buffer, &mut interaction);
+        settle_terminals(&mut interaction);
+        highlight_focus(buffer, &mut interaction);
+        drawn
+    })
+}
+
+fn shade_dock_zone(shade: Rect, buffer: &mut Buffer) {
+    const INSIDE: f32 = 0.18;
+    const EDGE: f32 = 0.4;
+    let accent = (!crate::mod_client::facts().no_color)
+        .then(|| crate::style::background_rgb(Some(crate::style::accent_color())))
+        .flatten();
+    for y in shade.top()..shade.bottom() {
+        for x in shade.left()..shade.right() {
+            let edge = x == shade.left()
+                || x + 1 == shade.right()
+                || y == shade.top()
+                || y + 1 == shade.bottom();
+            let cell = &mut buffer[(x, y)];
+            match accent.zip(crate::style::background_rgb(Some(cell.bg))) {
+                Some((accent, under)) => {
+                    cell.set_bg(crate::terminal_palette::best_color(crate::color::blend(
+                        accent,
+                        under,
+                        if edge { EDGE } else { INSIDE },
+                    )));
+                }
+                None if edge && cell.symbol() == " " => {
+                    cell.modifier.insert(Modifier::REVERSED);
+                }
+                None => cell.modifier.insert(Modifier::DIM),
+            }
+        }
+    }
+}
+
+fn focus_areas(placement: &crate::mod_layout::Placement) -> Vec<(String, Rect)> {
+    placement
+        .regions
+        .iter()
+        .filter_map(|region| match region.content.as_str() {
+            "transcript" => placement.chat().map(|chat| ("chat".to_owned(), chat)),
+            content => content
+                .strip_prefix("site:")
+                .map(|site| (site.to_owned(), region.area)),
+        })
+        .collect()
+}
+
+fn begin_regions(
+    interaction: &mut Interaction,
+    snapshot: &ModViewSnapshot,
+    areas: Vec<(String, Rect)>,
+    tabs: Vec<(String, String)>,
+) {
+    interaction.all_keys.clear();
+    interaction.component_region = snapshot
+        .view
+        .sites
+        .iter()
+        .flat_map(|(name, site)| {
+            codex_omd::component_ids_of(&site.components)
+                .into_iter()
+                .map(move |id| (id, name.clone()))
+        })
+        .collect();
+    interaction.region_keys = !snapshot.view.key_contexts.is_empty();
+    interaction.focus_areas = areas;
+    if let Some(region) = interaction.focus_region.clone().filter(|region| {
+        !interaction
+            .focus_areas
+            .iter()
+            .any(|(name, _)| name == region)
+    }) {
+        let follow = interaction
+            .region_tabs
+            .iter()
+            .find(|(site, _)| *site == region)
+            .and_then(|(_, path)| tabs.iter().find(|(_, tabs)| tabs == path))
+            .map(|(site, _)| site.clone());
+        interaction.follow_tab = follow.is_some();
+        if follow.is_some()
+            && let Some(focused) = interaction.focused.take()
+            && interaction.component_region.get(&focused) == Some(&region)
+        {
+            interaction.region_focus.insert(region, focused);
+        }
+        interaction.focus_region = follow;
+    }
+    interaction.region_tabs = tabs;
+    follow_region(interaction);
+}
+
+fn accent_edges(area: Rect, bordered: bool, buffer: &mut Buffer) {
+    let accent = crate::style::accent_style().bold();
+    if !bordered || area.width < 2 || area.height < 2 {
+        buffer.set_style(
+            Rect {
+                height: 1.min(area.height),
+                ..area
+            },
+            accent,
+        );
+        return;
+    }
+    for x in area.left()..area.right() {
+        buffer[(x, area.top())].set_style(accent);
+        buffer[(x, area.bottom() - 1)].set_style(accent);
+    }
+    for y in area.top()..area.bottom() {
+        buffer[(area.left(), y)].set_style(accent);
+        buffer[(area.right() - 1, y)].set_style(accent);
+    }
+}
