+            .unwrap();
+        assert_eq!(answer["messages"][0]["id"], 1);
+        let child = fs::read_to_string(&pidfile).unwrap().trim().to_owned();
+        let alive = || {
+            Command::new("kill")
+                .args(["-0", &child])
+                .stderr(Stdio::null())
