+        policy: FileSystemSandboxPolicy::unrestricted(),
+    };
+    let refreshed = preview_with(&mut runtime, &paths, &context, None, &|| true).unwrap();
+    assert!(
+        refreshed.diagnostics == ["native evidence diagnostic"],
