+fn canonical_store_root(root: &std::path::Path) -> Result<PathBuf, String> {
+    if !root.is_absolute() {
+        return Err("the mod store must be absolute and outside the repository".into());
+    }
+    root.canonicalize().map_err(|error| error.to_string())
+}
