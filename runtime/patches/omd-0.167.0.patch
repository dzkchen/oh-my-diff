+    pub(crate) async fn shutdown_if_idle_and_wait(&self) -> CodexResult<bool> {
+        let session_loop_termination = self.session_loop_termination.clone();
+        let (reply, idle) = oneshot::channel();
+        match self.submit(Op::ShutdownIfIdle { reply }).await {
+            Ok(_) => {}
+            Err(err) if matches!(err.details(), CodexErrorDetails::InternalAgentDied) => {}
+            Err(err) => return Err(err),
+        }
+        // A closed reply means the loop ended before answering, so it is already shut down.
+        if idle.await == Ok(false) {
+            return Ok(false);
+        }
+        session_loop_termination.await;
+        Ok(true)
+    }
