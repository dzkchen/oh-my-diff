+    assert_eq!(set("LIGHT").unwrap()["value"], "light");
+    assert_eq!(
+        set("forbidden").unwrap_err().to_string(),
+        "config_set_denied: not allowed"
+    );
+    assert_eq!(written, [json!("light")]);
