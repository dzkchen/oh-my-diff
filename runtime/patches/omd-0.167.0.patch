+    #[test]
+    fn pty_approval_survives_restart_and_is_scoped_to_workspace_command_and_access() {
+        let store = tempfile::tempdir().unwrap();
+        let repository = tempfile::tempdir().unwrap();
+        let other = tempfile::tempdir().unwrap();
+        let arguments = json!({"action": "start", "session": "shell", "program": "/bin/sh"});
+        let approval =
+            PtyApproval::new(store.path(), repository.path(), "workspace", &arguments).unwrap();
+        assert!(!approval.stored());
+        approval.save().unwrap();
+        assert!(
+            PtyApproval::new(store.path(), repository.path(), "workspace", &arguments)
+                .unwrap()
+                .stored()
+        );
+        assert!(
+            !PtyApproval::new(store.path(), other.path(), "workspace", &arguments)
+                .unwrap()
+                .stored()
+        );
+        assert!(
+            !PtyApproval::new(store.path(), repository.path(), "other", &arguments)
+                .unwrap()
+                .stored()
+        );
+        for (field, value) in [
+            ("write", json!(true)),
+            ("network", json!("loopback")),
+            ("argv", json!(["-l"])),
+        ] {
+            let mut changed = arguments.clone();
+            changed[field] = value;
+            assert!(
+                !PtyApproval::new(store.path(), repository.path(), "workspace", &changed)
+                    .unwrap()
+                    .stored()
+            );
+        }
+        std::fs::write(&approval.path, b"invalid").unwrap();
+        assert!(!approval.stored());
+    }
