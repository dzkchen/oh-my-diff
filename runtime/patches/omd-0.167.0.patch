+const NEEDS_CHATGPT_CATALOG: &str =
+    "routes_add_needs_chatgpt: sign in to Codex with ChatGPT to choose a model on your plan";
+
+pub struct ChatgptModelCatalog {
+    pub models: Vec<codex_protocol::openai_models::ModelPreset>,
+    pub infos: Vec<codex_protocol::openai_models::ModelInfo>,
+    pub configured: Option<(String, i64)>,
+}
+
+pub async fn chatgpt_catalog(
+    config: codex_core::config::Config,
+) -> Result<ChatgptModelCatalog, String> {
+    let auth = codex_login::AuthManager::shared_from_config(
+        &config, /*enable_codex_api_key_env*/ false,
+    )
+    .await
+    .map_err(|error| error.to_string())?;
+    load_chatgpt_catalog(&config, auth).await
+}
+
+async fn load_chatgpt_catalog(
+    config: &codex_core::config::Config,
+    auth: std::sync::Arc<codex_login::AuthManager>,
+) -> Result<ChatgptModelCatalog, String> {
+    if !auth
+        .auth_cached()
+        .is_some_and(|auth| auth.is_chatgpt_auth())
+    {
+        return Err(NEEDS_CHATGPT_CATALOG.into());
+    }
+    let provider = config
+        .model_providers
+        .get(codex_model_provider_info::OPENAI_PROVIDER_ID)
+        .cloned()
+        .unwrap_or_else(|| {
+            codex_model_provider_info::ModelProviderInfo::create_openai_provider(None)
+        });
+    let manager = codex_model_provider::create_model_provider(provider, Some(auth)).models_manager(
+        config.codex_home.to_path_buf(),
+        /*config_model_catalog*/ None,
+    );
+    let infos = manager
+        .raw_model_catalog(
+            codex_models_manager::manager::RefreshStrategy::OnlineIfUncached,
+            config.http_client_factory(),
+        )
+        .await
+        .models;
+    let models = manager
+        .build_available_models(infos.clone())
+        .into_iter()
+        .filter(|preset| preset.model_provider.is_none())
+        .collect();
+    Ok(ChatgptModelCatalog {
+        models,
+        infos,
+        configured: config.model.clone().zip(config.model_context_window),
+    })
+}
