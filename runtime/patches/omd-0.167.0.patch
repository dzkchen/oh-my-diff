+                let metadata = fs::metadata(&input.path).map_err(|error| error.to_string())?;
+                if !metadata.is_file()
+                    || metadata.len() > 128 * 1024 * 1024
+                    || codex_omd::host::program_hash(&input.path)? != input.sha256
+                {
+                    return Err("process_executable_changed".into());
