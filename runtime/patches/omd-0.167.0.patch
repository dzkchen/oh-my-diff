+            "pointer",
+            json!({"pointer": {"column": 1, "row": 2, "action": "down", "button": "left", "extra": 1}})
+        ),
+        json!({"kind": "pointer", "pointer": {"column": 1, "row": 2, "half": null,
+            "action": "down", "button": "left"}})
