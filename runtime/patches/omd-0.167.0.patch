+    let mut headers = HeaderMap::new();
+    headers.insert(
+        SEC_WEBSOCKET_PROTOCOL,
+        HeaderValue::from_static("codex-app-server, codex.bearer.super-secret-token"),
+    );
+    authorize_upgrade(&headers, &policy).expect("subprotocol token should authorize");
+
+    headers.insert(
+        AUTHORIZATION,
+        HeaderValue::from_static("Bearer wrong-token"),
+    );
+    let err = authorize_upgrade(&headers, &policy).expect_err("authorization takes precedence");
+    assert_eq!(err.message(), "invalid websocket bearer token");
+
+    headers.remove(AUTHORIZATION);
+    headers.insert(
