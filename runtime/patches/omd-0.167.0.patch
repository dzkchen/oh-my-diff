+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn commands_can_only_exchange_with_or_check_existing_processes() {
+        for operation in ["process.status", "process.exchange"] {
+            assert!(event_allows("command", operation), "{operation}");
+            assert!(!event_allows("component_event", operation), "{operation}");
+            assert!(!event_allows("component_post", operation), "{operation}");
+        }
+        for operation in ["process.start", "process.which", "process.stop"] {
+            assert!(!event_allows("command", operation), "{operation}");
+        }
+    }
+
+    #[test]
+    fn unsandboxed_process_start_checks_the_program_before_asking() {
+        let access = codex_omd::ModOsAccess {
+            programs: vec!["sh".into()],
+            network: true,
+        };
+        let (repository, store) = (tempfile::tempdir().unwrap(), tempfile::tempdir().unwrap());
+        let sh = codex_omd::host::unrestricted_program(&access, "sh", repository.path()).unwrap();
+        let start = |path: &std::path::Path| {
+            trust_start(
+                &access,
+                &json!({"name": "sh", "path": path, "sha256": "aa"}),
+                repository.path(),
+                store.path(),
+                "m",
+                &|| true,
+            )
+        };
+        assert_eq!(
+            start(std::path::Path::new("/bin/ls")),
+            Err("process_program_or_arguments_invalid".into())
+        );
+        assert_eq!(start(&sh), Err("process_executable_changed".into()));
+        assert_eq!(
+            codex_omd::program_trust::pinned(store.path(), "m", &sh),
+            None
+        );
+    }
+
+    #[test]
+    fn live_exec_write_reserves_the_workspace_across_sessions() {
+        let temp = tempfile::tempdir().unwrap();
+        let repository = temp.path().to_str().unwrap();
+        let write = json!({"program":"sh","write":true});
+        assert!(
+            workspace_guard("exec.run", &json!({"program":"sh"}), repository)
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            workspace_guard(
+                "exec.run",
+                &json!({"program":"sh","write":true,"snapshot":{"sha256":"x"}}),
+                repository
+            )
+            .unwrap()
+            .is_none()
+        );
+        let (held_tx, held_rx) = std::sync::mpsc::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        std::thread::scope(|scope| {
+            let write = &write;
+            scope.spawn(move || {
+                let _guard = workspace_guard("exec.run", write, repository)
+                    .unwrap()
+                    .unwrap();
+                held_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+            });
+            held_rx.recv().unwrap();
+            assert!(
+                workspace_guard("workspace.restore", &json!({}), repository)
+                    .err()
+                    .unwrap()
+                    .contains("workspace_operation_active")
+            );
+            release_tx.send(()).unwrap();
+        });
+        let _guard = workspace_guard("exec.run", &write, repository)
+            .unwrap()
+            .unwrap();
+    }
+}
