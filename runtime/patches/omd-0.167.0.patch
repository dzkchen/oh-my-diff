+async fn initialize(ws: &mut WsClient) -> Result<()> {
+    send_request(
+        ws,
+        "initialize",
+        1,
+        Some(
+            json!({"clientInfo": {"name": "omd-client", "version": "0.1.0"},
+            "capabilities": {"experimentalApi": true}}),
+        ),
+    )
+    .await?;
+    read_response_for_id(ws, 1).await?;
+    Ok(())
+}
+
+async fn attach(ws: &mut WsClient, name: &str) -> Result<OmdClientAttachResponse> {
+    send_request(
+        ws,
+        "omd/client/attach",
+        2,
+        Some(json!({"name": name, "operations": [],
+            "renderer": {"kind": "gui", "formats": ["svg"], "pointer": "pixel"}})),
+    )
+    .await?;
+    to_response(read_response_for_id(ws, 2).await?)
+}
+
+async fn view_read(ws: &mut WsClient, id: i64) -> Result<OmdViewReadResponse> {
+    send_request(ws, "omd/view/read", id, Some(json!({}))).await?;
+    to_response(read_response_for_id(ws, id).await?)
+}
+
+/// Mods re-render after each roster change, so wait for the view to stop moving.
+async fn settled_view(ws: &mut WsClient, mut id: i64) -> Result<OmdViewReadResponse> {
+    let mut previous = view_read(ws, id).await?;
+    loop {
+        sleep(Duration::from_millis(300)).await;
+        id += 1;
+        let current = view_read(ws, id).await?;
+        if (&current.epoch, current.revision) == (&previous.epoch, previous.revision) {
+            return Ok(current);
+        }
+        previous = current;
+    }
+}
+
+async fn error_message(ws: &mut WsClient, id: i64, method: &str, params: Value) -> Result<String> {
+    send_request(ws, method, id, Some(params)).await?;
+    Ok(read_error_for_id(ws, id).await?.error.message)
+}
