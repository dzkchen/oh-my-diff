+impl Machine {
+    fn new(disabled: bool, owner: u32) -> Self {
+        let temp = tempfile::tempdir().unwrap();
+        let base = temp.path().canonicalize().unwrap();
+        let pmset = base.join("pmset");
+        fs::write(
+            &pmset,
+            "#!/bin/sh\nd=$(dirname \"$0\")\nif [ \"$1\" = sleepnow ]; then echo sleepnow >> \"$d/log\"; exit 0; fi\nif [ \"$1\" = -g ]; then printf 'System-wide power settings:\\n SleepDisabled\\t\\t%s\\n' \"$(cat \"$d/state\")\"; exit 0; fi\necho \"$3\" > \"$d/state\"\necho \"$3\" >> \"$d/log\"\n",
+        )
+        .unwrap();
+        let ioreg = base.join("ioreg");
+        fs::write(&ioreg, "#!/bin/sh\necho \"  \\\"AppleClamshellState\\\" = $(cat \"$(dirname \"$0\")/lid\")\"\n").unwrap();
+        for program in [&pmset, &ioreg] {
+            fs::set_permissions(program, fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        fs::write(base.join("lid"), "No").unwrap();
+        fs::write(base.join("state"), if disabled { "1\n" } else { "0\n" }).unwrap();
+        let setting =
+            Arc::new(Setting::open(pmset, ioreg, base.join("power.json"), owner).unwrap());
+        let helper = base.join("helper.sock");
+        let listener = UnixListener::bind(&helper).unwrap();
+        std::thread::spawn(move || setting.serve(listener));
+        let root = base.join("broker");
+        fs::create_dir(&root).unwrap();
+        let mut served = broker::Broker::open(root).unwrap();
+        served.power = helper.clone();
+        let served = Arc::new(served);
+        let socket = base.join("broker.sock");
+        let listener = UnixListener::bind(&socket).unwrap();
+        std::thread::spawn(move || served.serve(listener, Arc::new(OpenGate)));
+        Self {
+            _temp: temp,
+            base,
+            helper,
+            broker: socket,
+        }
+    }
+
+    fn uid() -> u32 {
+        unsafe { libc::getuid() }
+    }
+
+    fn state(&self) -> String {
+        fs::read_to_string(self.base.join("state"))
+            .unwrap()
+            .trim()
+            .to_owned()
+    }
+
+    fn close_lid(&self) {
+        fs::write(self.base.join("lid"), "Yes").unwrap();
+    }
+
+    fn log(&self) -> String {
+        fs::read_to_string(self.base.join("log")).unwrap_or_default()
+    }
+
+    fn settles(&self, state: &str) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while self.state() != state || self.base.join("power.json").exists() != (state == "1") {
+            assert!(
+                Instant::now() < deadline,
+                "SleepDisabled stayed {}",
+                self.state()
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+
+    fn leases(&self) -> Leases {
+        Leases {
+            broker: Some(self.broker.clone()),
+            ..Leases::default()
+        }
+    }
+}
+
+fn hold(lid_closed: bool) -> Value {
+    json!({"reason": "agents working", "lid_closed": lid_closed, "max_duration_ms": 60_000})
+}
+
+#[test]
+fn lid_closed_leases_share_one_setting_and_the_last_one_restores_it_and_sleeps_a_closed_mac() {
+    let machine = Machine::new(false, Machine::uid());
+    machine.close_lid();
+    let leases = machine.leases();
+    let first = leases.hold("a", "s", &hold(true)).unwrap();
+    leases.hold("b", "s", &hold(true)).unwrap();
+    assert_eq!(first["lid_closed"], true);
+    machine.settles("1");
+    assert_eq!(
+        leases
+            .release("a", &json!({"lease": first["lease"]}))
+            .unwrap(),
+        json!({"released": true})
+    );
+    std::thread::sleep(Duration::from_millis(100));
+    assert_eq!(machine.state(), "1");
+    leases.release_owner("b");
+    machine.settles("0");
+    assert_eq!(machine.log(), "1\n0\nsleepnow\n");
+}
+
+#[test]
+fn a_setting_that_was_already_disabled_is_put_back() {
+    let machine = Machine::new(true, Machine::uid());
+    machine.close_lid();
+    let leases = machine.leases();
+    let held = leases.hold("a", "s", &hold(true)).unwrap();
+    machine.settles("1");
+    leases
+        .release("a", &json!({"lease": held["lease"]}))
+        .unwrap();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while machine.base.join("power.json").exists() {
+        assert!(Instant::now() < deadline);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    assert_eq!(
+        (machine.state().as_str(), machine.log().as_str()),
+        ("1", "1\n1\n")
+    );
+}
+
+#[test]
+fn an_expired_broker_hold_restores_sleep() {
+    let machine = Machine::new(false, Machine::uid());
+    let mut client = broker::Client::at(&machine.broker).unwrap();
+    let arguments = json!({"reason": "agents working", "max_duration_ms": 200});
+    client.call("power.hold", arguments.clone()).unwrap();
+    assert_eq!(
+        client
+            .call("power.hold", arguments)
+            .unwrap_err()
+            .to_string(),
+        "authority_power_held"
+    );
+    machine.settles("1");
+    machine.settles("0");
+    assert!(client.call("anchor.get", json!({})).is_err());
+}
+
+#[test]
+fn a_lease_ends_when_its_broker_connection_drops() {
+    let temp = tempfile::tempdir().unwrap();
+    let socket = temp.path().join("broker.sock");
+    let listener = UnixListener::bind(&socket).unwrap();
+    std::thread::spawn(move || {
+        let (stream, _) = listener.accept().unwrap();
+        let mut line = String::new();
+        BufReader::new(&stream).read_line(&mut line).unwrap();
+        (&stream).write_all(b"{\"ok\":null}\n").unwrap();
+    });
+    let leases = Leases {
+        broker: Some(socket),
+        ..Leases::default()
+    };
+    let held = leases.hold("a", "s", &hold(true)).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while leases
+        .records
+        .lock()
+        .unwrap()
+        .contains_key(held["lease"].as_str().unwrap())
+    {
+        assert!(
+            Instant::now() < deadline,
+            "the lease outlived its broker connection"
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn the_helper_restores_a_record_left_by_a_crash_and_refuses_other_users() {
+    let machine = Machine::new(true, Machine::uid() + 1);
+    assert_eq!(machine.state(), "1");
+    fs::write(machine.base.join("power.json"), r#"{"previous":false}"#).unwrap();
+    let base = &machine.base;
+    Setting::open(
+        base.join("pmset"),
+        base.join("ioreg"),
+        base.join("power.json"),
+        0,
+    )
+    .unwrap();
+    assert_eq!(machine.state(), "0");
+    assert!(!machine.base.join("power.json").exists());
+    let refused = Hold::start(
+        &machine.helper,
+        &json!({"reason": "agents working", "max_duration_ms": 1000}),
+        UnixStream::pair().unwrap().0,
+    );
+    assert_eq!(
+        refused.err().unwrap().to_string(),
+        "authority_peer_unverified"
+    );
+}
+
+#[test]
+fn leases_belong_to_their_owner_and_current_source() {
+    let leases = Leases::default();
+    let held = leases.hold("a", "s1", &hold(false)).unwrap();
+    assert_eq!(held["lid_closed"], false);
+    assert_eq!(
+        leases
+            .release("b", &json!({"lease": held["lease"]}))
+            .unwrap(),
+        json!({"released": false})
+    );
+    let mut renew = hold(false);
+    renew["lease"] = held["lease"].clone();
+    assert_eq!(leases.hold("a", "s1", &renew).unwrap(), held);
+    assert_ne!(leases.hold("b", "s1", &renew).unwrap(), held);
+    for _ in 1..LEASES_PER_OWNER {
+        leases.hold("a", "s1", &hold(false)).unwrap();
+    }
+    assert_eq!(
+        leases.hold("a", "s1", &hold(false)).unwrap_err(),
+        "power_lease_limit"
+    );
+    assert_eq!(
+        leases
+            .hold("b", "s1", &json!({"reason": "x", "max_duration_ms": 1000}))
+            .unwrap_err(),
+        "power_request_invalid"
+    );
+    leases.retain(&BTreeMap::from([("a".to_owned(), "s2".to_owned())]));
+    assert_eq!(
+        leases
+            .release("a", &json!({"lease": held["lease"]}))
+            .unwrap(),
+        json!({"released": false})
+    );
+    leases.hold("a", "s2", &hold(false)).unwrap();
+}
diff --git a/codex-rs/omd/src/process_raster.rs b/codex-rs/omd/src/process_raster.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c1f5c12542ce890d42bf0d90a3244e46f2d07b41
--- /dev/null
+++ b/codex-rs/omd/src/process_raster.rs
@@ -0,0 +1,713 @@
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::PoisonError;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+pub type Sink = Arc<dyn Fn(Value) -> bool + Send + Sync>;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Role {
+    Raster,
+    Keys,
+}
+
+type Key = (Option<String>, String, String);
+type Bound = BTreeMap<Key, (String, Role, Sink, u64)>;
+
+static BOUND: Mutex<Bound> = Mutex::new(BTreeMap::new());
+static SERIAL: AtomicU64 = AtomicU64::new(0);
+static PIXELS: Mutex<BTreeMap<String, Arc<Mutex<PixelBuffer>>>> = Mutex::new(BTreeMap::new());
+
+struct PixelBuffer {
+    key: Key,
+    serial: u64,
+    file: File,
+    accepted: Option<Arc<PixelFrame>>,
+    generation: Option<u64>,
+    /// When the last ready acknowledgement goes out, and how long the producer then takes to publish.
+    released: Option<Instant>,
+    lead: Duration,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PixelSource {
+    pub source: String,
+    pub format: String,
+    pub width: u32,
+    pub height: u32,
+    pub sequence: u64,
+}
+
+#[derive(Debug)]
+pub struct PixelFrame {
+    pub source: PixelSource,
+    pub id: String,
+    pub image: image::DynamicImage,
+    encoded: Mutex<BTreeMap<(bool, u32, u32), Encoding>>,
+}
+
+type Encoding = Arc<OnceLock<Option<Arc<[u8]>>>>;
+
+impl PixelFrame {
+    pub fn new(source: PixelSource, image: image::DynamicImage) -> Self {
+        Self {
+            id: format!("{}:{}", source.source, source.sequence),
+            source,
+            image,
+            encoded: Mutex::new(BTreeMap::new()),
+        }
+    }
+
+    pub fn encoded(&self, jpeg: bool, bounds: (u32, u32)) -> Option<Arc<[u8]>> {
+        let size = fit_within((self.image.width(), self.image.height()), bounds);
+        let cache = self
+            .encoded
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .entry((jpeg, size.0, size.1))
+            .or_default()
+            .clone();
+        cache
+            .get_or_init(|| {
+                encode(&self.image, size, jpeg)
+                    .filter(|bytes| bytes.len() <= crate::blob_store::IMAGE_BYTES)
+                    .map(Arc::from)
+            })
+            .clone()
+    }
+}
+
+pub fn fit_within((width, height): (u32, u32), bounds: (u32, u32)) -> (u32, u32) {
+    let scale = (f64::from(bounds.0) / f64::from(width.max(1)))
+        .min(f64::from(bounds.1) / f64::from(height.max(1)))
+        .min(1.0);
+    let scaled = |pixels: u32| ((f64::from(pixels) * scale).round() as u32).max(1);
+    (scaled(width), scaled(height))
+}
+
+pub fn resized(
+    image: &image::DynamicImage,
+    (width, height): (u32, u32),
+) -> std::borrow::Cow<'_, image::DynamicImage> {
+    if (width, height) == (image.width(), image.height()) {
+        std::borrow::Cow::Borrowed(image)
+    } else {
+        std::borrow::Cow::Owned(image.resize_exact(
+            width,
+            height,
+            image::imageops::FilterType::Triangle,
+        ))
+    }
+}
+
+pub fn encode(image: &image::DynamicImage, size: (u32, u32), jpeg: bool) -> Option<Vec<u8>> {
+    let image = resized(image, size);
+    let mut encoded = std::io::Cursor::new(Vec::new());
+    if jpeg {
+        image::DynamicImage::ImageRgb8(image.to_rgb8())
+            .write_to(&mut encoded, image::ImageFormat::Jpeg)
+            .ok()?;
+    } else {
+        image.write_to(&mut encoded, image::ImageFormat::Png).ok()?;
+    }
+    Some(encoded.into_inner())
+}
+
+impl PixelSource {
+    pub fn byte_len(&self) -> Result<usize, String> {
+        let channels = match self.format.as_str() {
+            "rgb" => 3,
+            "rgba" => 4,
+            _ => return Err("terminal_blit_pixels_invalid".into()),
+        };
+        if !(1..=crate::client_surface::IMAGE_PIXELS).contains(&self.width)
+            || !(1..=crate::client_surface::IMAGE_PIXELS).contains(&self.height)
+            || self.sequence == 0
+        {
+            return Err("terminal_blit_pixels_invalid".into());
+        }
+        Ok(self.width as usize * self.height as usize * channels)
+    }
+}
+
+pub fn snapshot(
+    thread: Option<&str>,
+    owner: &str,
+    component: &str,
+    source: PixelSource,
+    next: Instant,
+) -> Result<Arc<PixelFrame>, String> {
+    let arrived = Instant::now();
+    let _stage = crate::frame_metrics::stage("raw_snapshot");
+    let key = key(thread, owner, component);
+    let (sink, serial, buffer) = {
+        let table = bound();
+        let (_, role, sink, serial) = table.get(&key).ok_or("terminal_blit_source_unavailable")?;
+        if *role != Role::Raster {
+            return Err("terminal_blit_source_not_owned".into());
+        }
+        let buffer = PIXELS
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .get(&source.source)
+            .cloned()
+            .ok_or("terminal_blit_source_not_owned")?;
+        (sink.clone(), *serial, buffer)
+    };
+    let mut buffer = buffer.lock().unwrap_or_else(PoisonError::into_inner);
+    if !(buffer.key == key
+        && buffer.serial == serial
+        && buffer.generation == crate::client_surface::current_generation())
+    {
+        return Err("terminal_blit_source_not_owned".into());
+    }
+    if let Some(accepted) = buffer
+        .accepted
+        .as_ref()
+        .filter(|accepted| accepted.source == source)
+    {
+        return Ok(accepted.clone());
+    }
+    let result = (|| {
+        let length = source.byte_len()?;
+        if buffer
+            .accepted
+            .as_ref()
+            .is_some_and(|accepted| source.sequence <= accepted.source.sequence)
+        {
+            return Err("terminal_blit_sequence_stale".into());
+        }
+        if buffer
+            .file
+            .metadata()
+            .map_err(|_| "terminal_blit_pixels_io".to_owned())?
+            .len()
+            != length as u64
+        {
+            return Err("terminal_blit_pixels_length".to_owned());
+        }
+        let mut bytes = vec![0; length];
+        buffer
+            .file
+            .read_exact_at(&mut bytes, 0)
+            .map_err(|_| "terminal_blit_pixels_io".to_owned())?;
+        let image = if source.format == "rgb" {
+            image::DynamicImage::ImageRgb8(
+                image::RgbImage::from_raw(source.width, source.height, bytes)
+                    .ok_or("terminal_blit_pixels_invalid")?,
+            )
+        } else {
+            image::DynamicImage::ImageRgba8(
+                image::RgbaImage::from_raw(source.width, source.height, bytes)
+                    .ok_or("terminal_blit_pixels_invalid")?,
+            )
+        };
+        if !bound()
+            .get(&key)
+            .is_some_and(|(_, _, current, current_serial)| {
+                *current_serial == serial && Arc::ptr_eq(current, &sink)
+            })
+        {
+            return Err("terminal_blit_source_unavailable".into());
+        }
+        if let Some(released) = buffer.released {
+            let lead = arrived
+                .saturating_duration_since(released)
+                .min(crate::client_surface::BLIT_FRAME);
+            buffer.lead = lead.max(buffer.lead - buffer.lead.saturating_sub(lead) / 8);
+        }
+        let frame = Arc::new(PixelFrame::new(source.clone(), image));
+        buffer.accepted = Some(frame.clone());
+        Ok(frame)
+    })();
+    let release = next
+        .checked_sub(buffer.lead)
+        .filter(|release| result.is_ok() && *release > Instant::now());
+    buffer.released = Some(release.unwrap_or_else(Instant::now));
+    drop(buffer);
+    let ack = serde_json::json!({"pixels": {"source": source.source, "sequence": source.sequence,
+        "ready": result.is_ok(), "error": result.as_ref().err()}});
+    match release {
+        Some(release) => acknowledge_at(release, sink, ack),
+        None => {
+            sink(ack);
+        }
+    }
+    result
+}
+
+fn acknowledge_at(release: Instant, sink: Sink, ack: Value) {
+    static TIMER: OnceLock<std::sync::mpsc::Sender<(Instant, Sink, Value)>> = OnceLock::new();
+    let timer = TIMER.get_or_init(|| {
+        let (sender, receiver) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            let mut pending: Vec<(Instant, Sink, Value)> = Vec::new();
+            loop {
+                let received = match pending.iter().map(|(at, _, _)| *at).min() {
+                    Some(at) => receiver.recv_timeout(at.saturating_duration_since(Instant::now())),
+                    None => receiver
+                        .recv()
+                        .map_err(|_| std::sync::mpsc::RecvTimeoutError::Disconnected),
+                };
+                match received {
+                    Ok(item) => pending.push(item),
+                    Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}
+                    Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => return,
+                }
+                let now = Instant::now();
+                for (_, sink, ack) in pending.extract_if(.., |(at, _, _)| *at <= now) {
+                    sink(ack);
+                }
+            }
+        });
+        sender
+    });
+    let _ = timer.send((release, sink, ack));
+}
+
+fn bound() -> std::sync::MutexGuard<'static, Bound> {
+    BOUND.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+pub struct Binding {
+    components: Vec<(Key, Role)>,
+    sink: Sink,
+    pixels: Option<String>,
+    serial: u64,
+}
+
+impl Binding {
+    pub fn prepare(
+        thread: Option<&str>,
+        owner: &str,
+        components: Vec<(String, Role)>,
+        sink: Sink,
+    ) -> Self {
+        Self {
+            components: components
+                .into_iter()
+                .map(|(component, role)| (key(thread, owner, &component), role))
+                .collect(),
+            sink,
+            pixels: None,
+            serial: SERIAL.fetch_add(1, Ordering::Relaxed),
+        }
+    }
+
+    pub fn publish(&self) {
+        let mut table = bound();
+        for (key, role) in &self.components {
+            if table
+                .get(key)
+                .is_none_or(|(_, _, _, serial)| *serial < self.serial)
+            {
+                table.insert(
+                    key.clone(),
+                    (key.1.clone(), *role, self.sink.clone(), self.serial),
+                );
+            }
+        }
+        drop(table);
+        crate::client_surface::redraw();
+    }
+
+    pub fn pixels(&mut self, path: &Path, generation: Option<u64>) -> Result<Value, String> {
+        if self.pixels.is_some() {
+            return Err("terminal_blit_source_exists".into());
+        }
+        let key = self
+            .components
+            .iter()
+            .find(|(_, role)| *role == Role::Raster)
+            .map(|(key, _)| key.clone())
+            .ok_or("terminal_blit_source_unavailable")?;
+        let serial = self.serial;
+        let file = File::options()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(path)
+            .map_err(|_| "terminal_blit_pixels_io".to_owned())?;
+        let source = format!("pixels-{}-{serial}", std::process::id());
+        PIXELS
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .insert(
+                source.clone(),
+                Arc::new(Mutex::new(PixelBuffer {
+                    key,
+                    serial,
+                    file,
+                    accepted: None,
+                    generation,
+                    released: None,
+                    lead: Duration::ZERO,
+                })),
+            );
+        self.pixels = Some(source.clone());
+        Ok(serde_json::json!({"pixels": {"source": source, "path": path}}))
+    }
+}
+
+pub fn bind(
+    thread: Option<&str>,
+    owner: &str,
+    components: Vec<(String, Role)>,
+    sink: Sink,
+) -> Binding {
+    let binding = Binding::prepare(thread, owner, components, sink);
+    binding.publish();
+    binding
+}
+
+impl Drop for Binding {
+    fn drop(&mut self) {
+        let mut table = bound();
+        if let Some(source) = &self.pixels {
+            PIXELS
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .remove(source);
+        }
+        for (component, _) in &self.components {
+            if table.get(component).is_some_and(|(_, _, sink, serial)| {
+                *serial == self.serial && Arc::ptr_eq(sink, &self.sink)
+            }) {
+                table.remove(component);
+            }
+        }
+    }
+}
+
+/// Whether any process is bound, so the terminal keeps routing input even when no mod handles components.
+pub fn any() -> bool {
+    !bound().is_empty()
+}
+
+fn key(thread: Option<&str>, owner: &str, component: &str) -> Key {
+    (
+        thread.map(str::to_owned),
+        owner.to_owned(),
+        component.to_owned(),
+    )
+}
+
+pub fn role(thread: Option<&str>, owner: &str, component: &str) -> Option<Role> {
+    bound()
+        .get(&key(thread, owner, component))
+        .filter(|(bound, _, _, _)| bound == owner)
+        .map(|(_, role, _, _)| *role)
+}
+
+pub fn target(thread: Option<&str>, owner: &str, component: &str) -> Option<(Role, u64, Sink)> {
+    bound()
+        .get(&key(thread, owner, component))
+        .map(|(_, role, sink, serial)| (*role, *serial, sink.clone()))
+}
+
+pub fn serial(thread: Option<&str>, owner: &str, component: &str) -> Option<u64> {
+    bound()
+        .get(&key(thread, owner, component))
+        .filter(|(bound, _, _, _)| bound == owner)
+        .map(|(_, _, _, serial)| *serial)
+}
+
+pub fn keys(thread: Option<&str>, owner: &str, component: &str) -> Option<String> {
+    let table = bound();
+    let (_, role, _, serial) = table
+        .get(&key(thread, owner, component))
+        .filter(|(bound, _, _, _)| bound == owner)?;
+    (*role == Role::Raster).then_some(())?;
+    table
+        .iter()
+        .find(|(_, (_, role, _, other))| *role == Role::Keys && other == serial)
+        .map(|(keys, _)| keys.2.clone())
+}
+
+pub fn send(thread: Option<&str>, owner: &str, component: &str, message: Value) -> bool {
+    let sink = bound()
+        .get(&key(thread, owner, component))
+        .filter(|(bound, _, _, _)| bound == owner)
+        .map(|(_, _, sink, _)| sink.clone());
+    sink.is_some_and(|sink| sink(message))
+}
