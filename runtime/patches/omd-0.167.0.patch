+                    &EventMsg::TurnStarted(codex_protocol::protocol::TurnStartedEvent {
+                        turn_attribution: None,
+                        turn_id: id.to_string(),
+                        root_turn_id: None,
+                        trace_id: None,
+                        started_at: None,
+                        model_context_window: None,
+                        collaboration_mode_kind: Default::default(),
+                    }),
+                );
+            }
+            state
+                .lock()
+                .await
+                .track_current_turn_event("old", &terminal);
+            {
+                let mut state = state.lock().await;
+                state
+                    .pending_interrupts
+                    .insert("old".to_string(), Vec::new());
+                state
+                    .pending_interrupts
+                    .insert("new".to_string(), Vec::new());
+            }
+            let watch = ThreadWatchManager::new();
+            watch.note_turn_started(&thread_id.to_string()).await;
+            let (tx, mut rx) = mpsc::channel(CHANNEL_CAPACITY);
+            let outgoing = ThreadScopedOutgoingMessageSender::new(
+                Arc::new(OutgoingMessageSender::new(
+                    tx,
+                    codex_analytics::AnalyticsEventsClient::disabled(),
+                )),
+                vec![ConnectionId(1)],
+                thread_id,
+            );
+            apply_bespoke_event_handling(
+                Event {
+                    id: "old".to_string(),
+                    msg: terminal,
+                },
+                thread_id,
+                thread.clone(),
+                thread_manager.clone(),
+                outgoing,
+                state.clone(),
+                watch.clone(),
+            )
+            .await;
+            assert!(matches!(
+                recv_broadcast_notification(&mut rx).await?,
+                ServerNotification::TurnCompleted(_)
+            ));
+            assert_eq!(watch.running_turn_count().await, 1);
+            let state = state.lock().await;
+            assert!(!state.pending_interrupts.contains_key("old"));
+            assert!(state.pending_interrupts.contains_key("new"));
+        }
+        Ok(())
+    }
