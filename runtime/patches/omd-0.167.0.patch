+struct ContinueOnce;
+
+impl codex_extension_api::TurnLifecycleContributor for ContinueOnce {
+    fn continue_turn<'a>(
+        &'a self,
+        input: codex_extension_api::TurnContinueInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<codex_extension_api::TurnContinuation>>
+    {
+        let continuation = (input.continued == 0).then(|| codex_extension_api::TurnContinuation {
+            source: "extension:test".into(),
+            prompt: "verify once more".into(),
+        });
+        Box::pin(std::future::ready(continuation))
+    }
+}
