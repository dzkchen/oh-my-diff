+    bind_terminals(&mut interaction, &snapshot);
+    assert!(!interaction.pty_bindings.contains_key("m"));
+    assert!(crate::mod_pty::current(&interaction.pty_bindings["other"]));
+    bind_terminals(&mut interaction, &stale);
+    assert!(interaction.pty_bindings.is_empty());
