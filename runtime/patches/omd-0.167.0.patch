+pub(super) fn package_lifecycle(
+    path: &Path,
+    event: &str,
+) -> Result<(ModPackage, String, Option<Vec<u8>>)> {
+    let (package, _, hash, _, _, script) = inspect_package(path, false, Some(event))?;
+    Ok((package, hash, script))
+}
