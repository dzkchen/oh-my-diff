+impl Loaded {
+    /// This activation for another host: the inspection without this host's UI or telemetry.
+    fn inspected(&self) -> Self {
+        Self {
+            ui: None,
+            ui_state: Value::Null,
+            ui_revision: 0,
+            ui_clears: 0,
+            command_view: None,
+            telemetry: ModTelemetry::default(),
+            ..self.clone()
+        }
+    }
+
+    fn invocation(&mut self) -> Self {
+        let state = std::mem::take(&mut self.state);
+        let telemetry = std::mem::take(&mut self.telemetry);
+        let copy = self.clone();
+        (self.state, self.telemetry) = (state, telemetry);
+        copy
+    }
+
+    fn set_state(&mut self, state: Value) {
+        static REVISIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        self.state = state;
+        self.state_revision = REVISIONS.fetch_add(1, Ordering::Relaxed) + 1;
+    }
+
+    fn clear_ui(&mut self) {
+        self.command_view = None;
+        if let Some((_, state)) = self.ui.take()
+            && let Ok(mut state) = state.lock()
+        {
+            state.value = Value::Null;
+            state.revision = state.revision.wrapping_add(1);
+            state.clears = state.clears.wrapping_add(1);
+        }
+    }
+
+    fn fault(&mut self, error: String) {
+        self.telemetry.faults = self.telemetry.faults.saturating_add(1);
+        if self.telemetry.faults >= MOD_FAULT_LIMIT && self.error.is_none() {
+            self.error = Some(error.clone());
+            self.clear_ui();
+            let mut turned_off = TURNED_OFF
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            // Each host counts its own faults; one notice per mod, and processes that never drain stay bounded.
+            if !turned_off.contains(&self.package.id) {
+                turned_off.push(self.package.id.clone());
+            }
+        }
+        self.telemetry.last_error = Some(error);
+    }
+}
+
+impl ModTelemetry {
+    fn record(
+        &mut self,
+        generation: u64,
+        event: &str,
+        name: &str,
+        elapsed: u128,
+        outcome: &'static str,
+    ) {
+        self.invocations = self.invocations.saturating_add(1);
+        self.total_micros = self.total_micros.saturating_add(elapsed);
+        self.last_micros = elapsed;
+        if self.logs.len() == 64 {
+            self.logs.pop_front();
+        }
+        self.logs.push_back(TelemetryLog {
+            generation,
+            event: event.to_owned(),
+            name: name.to_owned(),
+            outcome,
+            elapsed_micros: elapsed,
+        });
+    }
+}
