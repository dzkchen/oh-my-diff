+/// Opens and activates the shared host while the rest of startup runs, so `prepare_startup` finds it ready.
+pub(crate) fn open_in_background() {
+    if crate::omd::is_active() {
+        std::thread::spawn(|| {
+            // Keys typed while startup refreshes the terminal view then pass at once unless a mod intercepts them.
+            if let Ok(runtime) = shared_host() {
+                let runtime = runtime.locked();
+                remembered_intercept("composer_key", Some(runtime.intercepts("composer_key")));
+            }
+        });
+    }
+}
