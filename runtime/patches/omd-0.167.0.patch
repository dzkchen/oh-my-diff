+pub(crate) struct FooterLayout {
+    rows: Vec<ComponentRow>,
+    lines: Vec<HyperlinkLine>,
+    key_panes: BTreeSet<String>,
+    site: FooterSite,
+    /// Host rows (cards, toasts) start here; only the mod rows above them are clipped and scrolled.
+    host_from: usize,
+}
+
+pub(crate) fn footer_layout(site: FooterSite, width: u16) -> Arc<FooterLayout> {
+    FOOTER.with(|footer_state| {
+        INTERACTION.with(|interaction_state| {
+            if let Some(layout) = footer_state.locked().layouts.get(&(site, width)) {
+                return Arc::clone(layout);
+            }
+            let snapshot = with_cache(|cache| Arc::clone(&cache.snapshot)).unwrap_or_default();
+            let style = panel_style(&snapshot.view);
+            let look = (snapshot.view.theme.border, snapshot.view.theme.icons);
+            let mut interaction = interaction_state.locked();
+            interaction.component_owners = snapshot.component_owners.clone();
+            bind_terminals(&mut interaction, &snapshot);
+            let mod_rows;
+            let rows = match site {
+                FooterSite::Above => {
+                    let mut rows = if let Some(site) = self::site(&snapshot.view, "above_composer")
+                    {
+                        component_rows(&site.components, width, &mut interaction, look)
+                    } else {
+                        snapshot
+                            .view
+                            .footer
+                            .as_ref()
+                            .map(panel_lines)
+                            .unwrap_or_default()
+                            .into_iter()
+                            .map(|line| ComponentRow {
+                                line,
+                                ..ComponentRow::default()
+                            })
+                            .collect()
+                    };
+                    mod_rows = rows.len();
+                    if let Some(cards) = native_cards(&snapshot, width) {
+                        rows.extend(component_rows(&[cards], width, &mut interaction, look));
+                    }
+                    rows.extend(
+                        live_notices(NoticePlacement::Toast)
+                            .into_iter()
+                            .map(|notice| {
+                                let mut spans =
+                                    crate::history_cell::notice_spans(notice.kind, &notice.text);
+                                spans.push(format!(" ({})", notice.owner).dark_gray());
+                                ComponentRow {
+                                    line: Line::from(spans),
+                                    ..ComponentRow::default()
+                                }
+                            }),
+                    );
+                    rows
+                }
+                FooterSite::Below => {
+                    let rows = self::site(&snapshot.view, "below_composer")
+                        .map(|site| component_rows(&site.components, width, &mut interaction, look))
+                        .unwrap_or_default();
+                    mod_rows = rows.len();
+                    rows
+                }
+            };
+            settle_drawn_terminals(&rows, true, &mut interaction);
+            let mut lines = Vec::new();
+            let mut host_from = usize::MAX;
+            let rows: Vec<ComponentRow> = rows
+                .into_iter()
+                .enumerate()
+                .flat_map(|(index, row)| {
+                    if index == mod_rows {
+                        host_from = lines.len();
+                    }
+                    let line = HyperlinkLine {
+                        hyperlinks: row_links(&row).into_iter().cloned().collect(),
+                        ..HyperlinkLine::new(row.line.clone().patch_style(style))
+                    };
+                    let wrapped = if line.width() > usize::from(width) {
+                        crate::terminal_hyperlinks::adaptive_wrap_hyperlink_lines(
+                            &[line],
+                            crate::wrapping::RtOptions::new(usize::from(width.max(1))),
+                        )
+                    } else {
+                        vec![line]
+                    };
+                    let mut fragments = Vec::new();
+                    for line in wrapped {
+                        let mut fragment = row.clone();
+                        fragment.line = line.line.clone();
+                        fragments.push(fragment);
+                        lines.push(line);
+                    }
+                    fragments
+                })
+                .collect();
+            let mut ids = Vec::new();
+            targets(&rows, &mut ids);
+            let key_panes = ids
+                .into_iter()
+                .chain(rows.iter().filter_map(|row| row.id.clone()))
+                .filter(|id| interaction.key_panes.contains(id))
+                .collect();
+            let host_from = host_from.min(lines.len());
+            let layout = Arc::new(FooterLayout {
+                rows,
+                lines,
+                key_panes,
+                site,
+                host_from,
+            });
+            let mut cache = footer_state.locked();
+            if cache.active {
+                cache.layouts.insert((site, width), Arc::clone(&layout));
+            }
+            layout
+        })
+    })
+}
+
+impl FooterLayout {
+    pub(crate) fn height(&self) -> u16 {
+        let cap = match self.site {
+            FooterSite::Above => ABOVE_COMPOSER_ROWS,
+            FooterSite::Below => BELOW_COMPOSER_ROWS,
+        };
+        let mods = u16::try_from(self.host_from).unwrap_or(u16::MAX).min(cap);
+        let host = u16::try_from(self.lines.len() - self.host_from).unwrap_or(u16::MAX);
+        mods.saturating_add(host)
+    }
+
+    /// The mod rows' area above the host rows' area, which keeps every row it can.
+    fn split(&self, area: Rect) -> (Rect, Rect) {
+        let host = u16::try_from(self.lines.len() - self.host_from)
+            .unwrap_or(u16::MAX)
+            .min(area.height);
+        let mods = area.height - host;
+        (
+            Rect {
+                height: mods,
+                ..area
+            },
+            Rect {
+                y: area.y + mods,
+                height: host,
+                ..area
+            },
+        )
+    }
+
+    pub(crate) fn render(self: &Arc<Self>, area: Rect, buffer: &mut Buffer) {
+        FOOTER.with(|footer_state| {
+            INTERACTION.with(|interaction_state| {
+                let (mods, host) = self.split(area);
+                let interaction = interaction_state.locked();
+                let scroll =
+                    focused_scroll(&self.rows[..self.host_from], mods.height, &interaction);
+                drop(interaction);
+                crate::terminal_hyperlinks::HyperlinkParagraph::new(
+                    &self.lines[scroll..self.host_from],
+                    Style::default(),
+                )
+                .render(mods, buffer);
+                crate::terminal_hyperlinks::HyperlinkParagraph::new(
+                    &self.lines[self.host_from..],
+                    Style::default(),
+                )
+                .render(host, buffer);
+                let mut cache = footer_state.locked();
+                if cache.active {
+                    if area.is_empty() {
+                        cache.rendered.remove(&self.site);
+                    } else {
+                        cache
+                            .rendered
+                            .insert(self.site, (area, Arc::clone(self), scroll));
+                    }
+                }
+            })
+        })
+    }
+}
+
+pub(super) fn register_footer(interaction: &mut Interaction) {
+    FOOTER.with(|footer_state| {
+        let cache = footer_state.locked();
+        for (area, layout, scroll) in cache.rendered.values() {
+            interaction
+                .key_panes
+                .extend(layout.key_panes.iter().cloned());
+            let (mods, host) = layout.split(*area);
+            register_component_targets(
+                mods,
+                layout.rows[..layout.host_from].to_vec(),
+                *scroll,
+                interaction,
+            );
+            register_component_targets(
+                host,
+                layout.rows[layout.host_from..].to_vec(),
+                0,
+                interaction,
+            );
+        }
+    })
+}
+
+#[cfg(test)]
+pub(crate) fn footer_hyperlink_lines(width: u16) -> Vec<HyperlinkLine> {
+    footer_layout(FooterSite::Above, width).lines.clone()
+}
