+    assert_eq!(chain.result, json!({"output":"ran B1 A","success":true}));
+    assert_eq!(
+        calls,
+        [json!({"tool":"exec","arguments":{"a":true,"b":"model"}})]
+    );
+    assert_eq!(chain.input, calls[0]);
