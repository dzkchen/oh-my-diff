+            )
+            .is_err()
+        );
+        let mut next = app.config.clone();
+        app.apply_new_thread_route(&mut next)?;
+        assert_eq!(next.model.as_deref(), Some("other-model"));
+        assert_eq!(next.model_provider_id, "next-provider");
+        assert_eq!(
+            next.web_search_mode.value(),
+            codex_protocol::config_types::WebSearchMode::Disabled
+        );
+        assert_eq!(
+            next.model_reasoning_effort,
+            Some(codex_protocol::openai_models::ReasoningEffort::High)
+        );
+        assert_eq!(app.config.model, active_model);
+        assert_eq!(app.config.model_provider_id, active_provider);
+        assert_eq!(next.permissions, app.config.permissions);
+        std::fs::write(
+            store.join("host.json"),
+            serde_json::to_vec(
+                &json!({"routes": [route, {"name": "ambiguous", "model": "other-model", "provider": "next-provider", "roles": ["lead"]}]}),
+            )?,
+        )?;
+        assert!(
+            app.apply_new_thread_route(&mut next)
+                .unwrap_err()
+                .to_string()
+                .contains("route_ambiguous")
+        );
+        std::fs::write(store.join("host.json"), br#"{"routes": []}"#)?;
+        assert!(
+            app.apply_new_thread_route(&mut next)
+                .unwrap_err()
+                .to_string()
+                .contains("route_not_configured")
+        );
+        assert_eq!(app.config.model, active_model);
+        Ok(())
+    }
+}
