+            serde_json::json!({"settled_task_charge_microusd":7,
+                "retained_exposure_upper_bound_microusd":10,"raw_usage_attempts":2,
+                "observed":[{"model":"a"},{"model":"b"},{"model":"c"}]})
+            .to_string(),
+        )
+        .unwrap();
+        std::fs::write(
+            session.join("contract.json"),
+            serde_json::json!({"status":"active","active":{"id":"reviewed","version":1,
+                "assurance":"separately_reviewed"}})
+            .to_string(),
+        )
+        .unwrap();
+        store
+    }
+
+    pub(crate) fn omd_environment(store: &Path) -> (EnvGuard, EnvGuard) {
+        crate::mod_runtime::synchronize_context(crate::mod_runtime::ModContext {
+            thread_id: None,
+            repository: store.to_path_buf(),
+            policy: codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted(),
+        });
+        (
+            EnvGuard::set(MODE_ENV, Some("omd")),
+            EnvGuard::set(codex_omd::MOD_STORE_ENV, store.to_str()),
+        )
+    }
+
+    #[cfg(unix)]
+    #[test]
+    #[serial]
+    fn store_root_normalizes_filesystem_aliases() {
+        let directory = TempDir::new().unwrap();
+        let store = directory.path().canonicalize().unwrap();
+        let alias = store.join("store-alias");
+        std::os::unix::fs::symlink(&store, &alias).unwrap();
+        let _environment = omd_environment(&alias);
+        assert_eq!(store_root(), Some(store));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    #[serial]
+    fn mod_snapshot_reloads_same_length_replacements_and_status_errors() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _environment = omd_environment(&store);
+        let view = store.join("mod-view.json");
+        std::fs::write(&view, br#"{"revision":1}"#).unwrap();
+        assert_eq!(mod_snapshot().1.revision, 1);
+        let modified = std::fs::metadata(&view).unwrap().modified().unwrap();
+        let replacement = store.join("replacement.json");
+        std::fs::write(&replacement, br#"{"revision":2}"#).unwrap();
+        std::fs::File::open(&replacement)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        std::fs::rename(&replacement, &view).unwrap();
+        assert_eq!(mod_snapshot().1.revision, 2);
+        // An in-place rewrite of the same length with the old mtime keeps the inode too.
+        std::fs::write(&view, br#"{"revision":3}"#).unwrap();
+        std::fs::File::options()
+            .write(true)
+            .open(&view)
+            .unwrap()
+            .set_times(std::fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        assert_eq!(mod_snapshot().1.revision, 3);
+        std::fs::write(
+            &replacement,
+            br#"{"mods":[{"id":"fixture","error":"failed"}]}"#,
+        )
+        .unwrap();
+        std::fs::rename(&replacement, store.join("mod-status.json")).unwrap();
+        assert_eq!(
+            mod_snapshot().1.errors,
+            [("fixture".to_owned(), "failed".to_owned())]
+        );
+    }
+
+    #[test]
+    #[serial]
+    fn builtin_controls_hide_and_replace_commands_but_never_recovery() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let launch = std::env::current_dir().unwrap();
+        std::fs::write(
+            store.join(codex_omd::builtins_snapshot(&launch)),
+            serde_json::json!({"schema":1,"hidden_commands":{"plan":["fixture"]},
+                "disabled_modes":{},"group_exec":true,"disabled_surfaces":{"status_line":["fixture"]},
+                "replaced_commands":{"review":["fixture","review"]}})
+            .to_string(),
+        )
+        .unwrap();
+        let _omd = omd_environment(&store);
+        assert!(
+            builtins().command_hidden("plan"),
+            "a thread in another checkout reads the launch directory's built-ins, as the host writes them"
+        );
+        assert!(!builtins().command_hidden("omd"));
+        assert!(!builtins().command_hidden("model"));
+        assert!(command_replacement(&builtins(), "review").is_some());
+        assert!(
+            crate::bottom_pane::slash_commands::commands_for_input(Default::default(), &[])
+                .iter()
+                .any(|command| matches!(
+                    command,
+                    crate::bottom_pane::slash_commands::SlashCommandItem::Mod(item)
+                        if item.invocation == "review"
+                ))
+        );
+        assert!(builtins().group_exec);
+        let call = |source| {
+            crate::exec_cell::new_active_exec_command(
+                "grouped".into(),
+                vec!["cargo".into(), "test".into()],
+                Vec::new(),
+                source,
+                None,
+                false,
+            )
+        };
+        let mut grouped = call(codex_app_server_protocol::CommandExecutionSource::Agent);
+        assert!(grouped.add_call(
+            "second".into(),
+            vec!["cargo".into(), "check".into()],
+            Vec::new(),
+            codex_app_server_protocol::CommandExecutionSource::Agent,
+            None
+        ));
+        let mut single = call(codex_app_server_protocol::CommandExecutionSource::Agent);
+        assert!(single.is_exploring_cell());
+        assert!(
+            !call(codex_app_server_protocol::CommandExecutionSource::UserShell).is_exploring_cell()
+        );
+        assert!(status_line_disabled());
+        assert_eq!(
+            codex_omd::BuiltinSnapshot::read(&store, &store.join("sessions")),
+            codex_omd::BuiltinSnapshot::default(),
+            "sessions in another repository keep their built-ins"
+        );
+        {
+            let _home = EnvGuard::set("HOME", launch.to_str());
+            assert!(!status_line_disabled());
+            assert!(!builtins().command_hidden("plan"));
+            assert!(command_replacement(&builtins(), "review").is_none());
+        }
+        assert!(builtins().command_hidden("plan"));
+        let _direct = EnvGuard::set(MODE_ENV, Some("upstream_direct"));
+        assert!(!builtins().command_hidden("plan"));
+        assert!(grouped.is_exploring_cell());
+        use crate::history_cell::HistoryCell;
+        assert!(single.is_exploring_cell());
+        assert!(single.render_members(80).is_empty());
+        assert_eq!(single.render_target().unwrap().props["kind"], "exec");
+        assert_eq!(grouped.render_members(80).len(), 2);
+        assert!(
+            grouped
+                .display_lines(80)
+                .iter()
+                .any(|line| line.to_string().contains("cargo test"))
+        );
+        assert!(
+            !call(codex_app_server_protocol::CommandExecutionSource::Agent).is_exploring_cell()
+        );
+        assert!(!single.add_call(
+            "after-disable".into(),
+            vec!["cargo".into(), "check".into()],
+            Vec::new(),
+            codex_app_server_protocol::CommandExecutionSource::Agent,
+            None
+        ));
+        assert_eq!(
+            grouped.render_target().unwrap().props["calls"]
+                .as_array()
+                .unwrap()
+                .len(),
+            2
+        );
+    }
+
+    #[test]
+    #[serial]
+    fn mods_stay_off_in_the_home_directory_with_a_notice() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _omd = omd_environment(&store);
+        assert!(mod_paths().is_some());
+        let _home = EnvGuard::set("HOME", store.to_str());
+        std::fs::write(
+            store.join("mod-status.json"),
+            serde_json::json!({"activation_error":"home","mods":[],"rejected":[]}).to_string(),
+        )
+        .unwrap();
+        assert!(mod_paths().is_none());
+        assert!(!terminal_active());
+        assert!(mod_status().is_some());
+        assert_eq!(
+            compact_status().as_deref(),
+            Some("Oh My Diff · mods off in this directory · run codex in a project")
+        );
+    }
+}
