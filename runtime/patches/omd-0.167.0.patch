+            match input(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE), true) {
+                Some(ModInput::Interaction(_, ModKeyAction::Command { command, .. })) => {
+                    assert_eq!(command, format!("fixture:{name}"))
+                }
+                _ => panic!("recovery action not keyboard reachable at height {height}"),
+            }
+            assert!(
+                test_interaction
+                    .lock()
+                    .unwrap()
