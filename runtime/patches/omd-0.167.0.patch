+        agent_nickname: None,
+        agent_role: Some("worker".to_string()),
+    }));
+    let child = harness
+        .manager
+        .spawn_isolated_subagent(parent_thread_id, options)
+        .await
+        .expect("isolated spawn should succeed");
+    assert!(
+        harness
+            .manager
+            .remove_thread(&child.thread_id)
+            .await
+            .is_some()
+    );
+
+    let subtree = harness
+        .manager
+        .list_agent_subtree_thread_ids(parent_thread_id)
+        .await
+        .expect("subtree should load");
+    assert_eq!(subtree, vec![parent_thread_id, child.thread_id]);
+
+    assert!(
+        !harness
+            .manager
+            .deliver_subagent_result(
+                parent_thread_id,
+                child.thread_id,
+                "mod_worker",
+                AgentStatus::Interrupted,
+            )
+            .await
+            .expect("an interruption sends nothing")
+    );
+    assert!(
+        harness
+            .manager
+            .deliver_subagent_result(
+                parent_thread_id,
+                child.thread_id,
+                "mod_worker",
+                AgentStatus::Completed(Some("worker result".to_string())),
+            )
+            .await
+            .expect("result delivery should succeed")
+    );
+    let delivered = harness
+        .manager
+        .captured_ops()
+        .into_iter()
+        .find_map(|(thread_id, op)| match op {
+            Op::InterAgentCommunication { communication, .. } if thread_id == parent_thread_id => {
+                Some(communication)
+            }
+            _ => None,
+        })
+        .expect("parent should receive the result");
+    assert_eq!(delivered.author.as_str(), "/root/mod_worker");
+    assert_eq!(delivered.recipient, AgentPath::root());
+    assert!(!delivered.trigger_turn);
+    assert!(delivered.content.contains("worker result"));
+
+    harness
+        .manager
+        .deliver_subagent_result(
+            parent_thread_id,
+            child.thread_id,
+            "mod_worker",
+            AgentStatus::Completed(Some("x".repeat(20_000))),
+        )
+        .await
+        .expect("long result delivery should succeed");
+    let long = harness
+        .manager
+        .captured_ops()
+        .into_iter()
+        .filter_map(|(thread_id, op)| match op {
+            Op::InterAgentCommunication { communication, .. } if thread_id == parent_thread_id => {
+                Some(communication.content)
+            }
+            _ => None,
+        })
+        .last()
+        .expect("parent should receive the long result");
+    assert!(long.contains("[Result truncated to "));
+    assert!(!long.contains("list_agents"));
