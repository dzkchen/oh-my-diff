+#[test]
+#[serial_test::serial]
+fn an_answer_stales_only_the_layouts_that_drew_from_it() {
+    let test_hooked = HOOKED.capture();
+    let test_engine = ENGINE.capture();
+    struct Restore(bool, Option<Engine>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            HOOKED.capture().store(self.0, Ordering::Relaxed);
+            *ENGINE
+                .capture()
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner) = self.1.take();
+        }
+    }
+    let _restore = Restore(
+        test_hooked.swap(true, Ordering::Relaxed),
+        test_engine.lock().unwrap().take(),
+    );
+    engine(|engine| engine.running = true);
+    let target = |id: &str| RenderTarget::new("tool_call", id, false, json!({"kind": "exec"}));
+    let ((), first) = track(|| {
+        resolve_state(&target("first"), 80);
+    });
+    let ((), second) = track(|| {
+        resolve_state(&target("second"), 80);
+    });
+    let ((), untouched) = track(|| ());
+    assert!(first.is_current() && second.is_current());
+    let rendered = Rendered {
+        props: None,
+        tree: tree(json!([{"type":"text","id":"own","label":"Own","text":"drawn"}])),
+    };
+    engine(|engine| {
+        engine.remember(
+            1,
+            ("tool_call".into(), "first".into()),
+            Some(rendered.clone()),
+            engine.cleared,
+        )
+    });
+    assert!(!first.is_current());
+    assert!(second.is_current());
+    engine(|engine| {
+        engine.remember(
+            1,
+            ("tool_call".into(), "second".into()),
+            None,
+            engine.cleared,
+        )
+    });
+    assert!(second.is_current());
+    REFRESHES.with(|state| state.fetch_add(1, Ordering::Relaxed));
+    assert!(!second.is_current());
+    assert!(untouched.is_current());
+}
