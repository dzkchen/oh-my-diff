+#[serial_test::serial]
+#[allow(clippy::disallowed_methods)]
+fn hover_and_focus_accents_restyle_without_events_or_moving_rows() {
+    let test_interaction = INTERACTION.capture();
+    let snapshot = snapshot(box_model());
+    preview(snapshot.clone());
+    let area = Rect::new(0, 0, 130, 24);
+    let chat = chat_area(area, &snapshot, 0);
+    let draw = || {
+        let mut buffer = Buffer::empty(area);
+        render(area, chat, &mut buffer, &snapshot);
+        buffer
+    };
+    let before = draw();
+    let regions = test_interaction
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .regions
+        .clone();
+    let region = |id: &str| regions.iter().find(|region| region.id == id).cloned();
+    let (cpu, live) = (region("cpu").expect("cpu"), region("live").expect("live"));
+    assert!(!cpu.events && live.events);
+    assert_eq!(before[(cpu.area.x, cpu.area.y)].symbol(), "╭");
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, cpu.area.x + 2, cpu.area.y + 1),
+        (true, events(&[])),
+        "a hover-only box restyles but sends nothing"
+    );
+    let hovered = draw();
+    assert_eq!(hovered[(cpu.area.x, cpu.area.y)].symbol(), "┏");
+    assert_eq!(
+        rows(&before, area).lines().count(),
+        rows(&hovered, area).lines().count()
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, live.area.x + 1, live.area.y),
+        (true, events(&[("live", "enter 1 0"), ("live", "move 1 0")]))
+    );
+    let on_live = draw();
+    assert_eq!(on_live[(cpu.area.x, cpu.area.y)].symbol(), "╭");
+    assert_eq!(on_live[(live.area.x, live.area.y)].bg, Color::Cyan);
+    let flat = test_interaction.lock().unwrap().anchors["flat"];
+    assert_eq!(before[(flat.x, flat.y)].bg, Color::Indexed(236));
+    test_interaction.lock().unwrap().focused = Some("flat_button".into());
+    assert_eq!(draw()[(flat.x, flat.y)].bg, Color::Indexed(238));
+    test_interaction.lock().unwrap().focused = None;
+    preview(ModViewSnapshot::default());
+}
