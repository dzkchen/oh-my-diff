+pub(crate) struct FooterFrame;
+
+pub(crate) fn footer_frame() -> FooterFrame {
+    FOOTER.with(|footer_state| {
+        *footer_state.locked() = FooterCache {
+            active: true,
+            ..FooterCache::default()
+        };
+        FooterFrame
+    })
+}
