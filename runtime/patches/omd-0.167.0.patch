+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct Limits {
+    pub requests: u32,
+    pub exposure_microusd: u64,
+    pub seconds: u64,
+    pub concurrent_workers: u32,
+    pub max_depth: u32,
+}
