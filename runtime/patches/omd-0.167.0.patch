+    let generation = binding["generation"].as_u64().unwrap();
+    let mut runtime = codex_omd::ModHost::open(store_path, ModOpenOptions::default()).unwrap();
+    let native_generation = runtime.generation();
+    let preview = codex_omd::package_controls::preview(
+        &store,
+        json!({"action": "disable", "id": "surface_fixture"}),
+    )
+    .unwrap();
+    let pending = codex_omd::client_surface::with_admission(&source, generation, None, || {
