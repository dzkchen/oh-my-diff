+    pub(crate) async fn answer_forwarded_question(&self, author: &codex_protocol::AgentPath) {
+        let parent = match &self.state.lock().await.session_configuration.session_source {
+            SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                agent_path: Some(path),
+                ..
+            }) => path
+                .as_str()
+                .rsplit_once('/')
+                .and_then(|(parent, _)| codex_protocol::AgentPath::try_from(parent).ok()),
+            _ => None,
+        };
+        if parent.as_ref() != Some(author) {
+            return;
+        }
+        let turn_state = self
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .map(|active| Arc::clone(&active.turn_state));
+        let Some(turn_state) = turn_state else {
+            return;
+        };
+        let Some((sender, question_ids)) = turn_state.lock().await.take_any_pending_user_input()
+        else {
+            return;
+        };
+        let answer = "Your parent replied; its message follows.".to_string();
+        let response = RequestUserInputResponse {
+            answers: question_ids
+                .into_iter()
+                .map(|id| {
+                    (
+                        id,
+                        RequestUserInputAnswer {
+                            answers: vec![answer.clone()],
+                        },
+                    )
+                })
+                .collect(),
+        };
+        let acceptance_order = self.reserve_user_input_order().await;
+        sender
+            .send(AcceptedUserInputResponse {
+                response,
+                acceptance_order,
+            })
+            .ok();
+    }
