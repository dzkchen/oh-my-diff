+            ModInvokeOptions {
+                host: ModHostCallback::Own(&mut |_| {
+                    Err(std::io::Error::other("unexpected_host_call"))
+                }),
+                ..ModInvokeOptions::default()
+            },
+        )
+        .unwrap()
+}
