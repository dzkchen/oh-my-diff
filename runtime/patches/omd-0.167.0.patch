+    .expect("materialized rollout should be created");
+    let path = app_test_support::rollout_path(config.codex_home.as_path(), filename_ts, &thread_id);
+    let session_meta = std::fs::read_to_string(&path)?
+        .lines()
+        .next()
+        .expect("fake rollout should have session metadata")
+        .to_string();
+    std::fs::write(&path, format!("{session_meta}\n"))?;
+    let thread_id = ThreadId::from_string(&thread_id)?;
+    for item in [
+        RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "turn-0".to_string(),
+            root_turn_id: None,
+            turn_attribution: None,
+            trace_id: None,
+            started_at: None,
+            model_context_window: None,
+            collaboration_mode_kind: ModeKind::default(),
+        })),
+        RolloutItem::ResponseItem(
+            ResponseItem::Message {
+                id: None,
+                role: "user".to_string(),
+                content: vec![ContentItem::InputText {
+                    text: "deploy with secret-alpha".to_string(),
+                }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+                encrypted_content: None,
+                status: None,
+            }
+            .into(),
+        ),
+        RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id,
+            turn_id: "turn-0".to_string(),
+            item: TurnItem::UserMessage(UserMessageItem {
+                id: "user-turn-0".to_string(),
+                client_id: None,
+                content: vec![UserInput::Text {
+                    text: "deploy with secret-alpha".to_string(),
+                    text_elements: Vec::new(),
+                }],
+            }),
+            started_at_ms: None,
+            completed_at_ms: 0,
+        })),
+        RolloutItem::EventMsg(EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: "turn-0".to_string(),
+            root_turn_id: None,
+            last_agent_message: None,
+            error: None,
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+            time_to_first_token_ms: None,
+        })),
+    ] {
+        codex_rollout::append_rollout_item_to_path(&path, &item).await?;
+    }
+    let mut app_server = Box::pin(crate::start_embedded_app_server_for_picker(&config)).await?;
+    let started = app_server
+        .resume_thread(
+            &crate::local_settings::LocalSettings::from(&config),
+            config.clone(),
+            thread_id,
+            crate::app_server_session::ResumeModelSettings::OverrideFromCurrentConfig,
+        )
+        .await?;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let transcript = |app: &App| {
+        app.transcript_cells
+            .iter()
+            .map(|cell| lines_to_single_string(&cell.display_lines(/*width*/ 80)))
+            .collect::<String>()
+    };
+    while let Ok(event) = app_event_rx.try_recv() {
+        Box::pin(app.handle_event(&mut tui, &mut app_server, event)).await?;
+    }
+    assert!(transcript(&app).contains("secret-alpha"));
+    let navigated = app.agent_navigation.get(&thread_id).is_some();
+
+    let rewrite = |params: serde_json::Value, id: codex_app_server_protocol::RequestId| {
+        serde_json::from_value::<codex_app_server_protocol::ClientRequest>(
+            serde_json::json!({"method": "thread/rewrite", "id": id, "params": params}),
+        )
+    };
+    let read: serde_json::Value = app_server
+        .request_handle()
+        .request_typed(rewrite(
+            serde_json::json!({"threadId": thread_id.to_string()}),
+            app_server.next_request_id(),
+        )?)
+        .await?;
+    let _: serde_json::Value = app_server
+        .request_handle()
+        .request_typed(rewrite(
+            serde_json::json!({"threadId": thread_id.to_string(), "expectedRevision": read["revision"],
+                "edits": [{"op": "replace", "id": "user-turn-0", "items": [{"type": "message", "role": "user",
+                    "content": [{"type": "input_text", "text": "deploy with [redacted]"}]}]}]}),
+            app_server.next_request_id(),
+        )?)
+        .await?;
+    loop {
+        let event = tokio::time::timeout(Duration::from_secs(10), app_server.next_event())
+            .await?
+            .expect("app-server event")
+            .event;
+        let rewritten = matches!(
+            &event,
+            codex_app_server_client::AppServerEvent::ServerNotification(notification)
+                if matches!(notification.as_ref(), ServerNotification::ThreadRewritten(_))
+        );
+        app.handle_app_server_event(&app_server, event).await;
+        if rewritten {
+            break;
+        }
+    }
+    for _ in 0..4 {
+        while let Ok(event) = app_event_rx.try_recv() {
+            Box::pin(app.handle_event(&mut tui, &mut app_server, event)).await?;
+        }
+    }
+    let reloaded = transcript(&app);
+    assert!(reloaded.contains("[redacted]"), "{reloaded}");
+    assert!(!reloaded.contains("secret-alpha"), "{reloaded}");
+    assert_eq!(app.active_thread_id, Some(thread_id));
+    assert_eq!(app.agent_navigation.get(&thread_id).is_some(), navigated);
+    app_server.shutdown().await?;
+    Ok(())
+}
