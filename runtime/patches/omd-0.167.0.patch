+    let binding = call_binding("surface_fixture");
+    assert_eq!(binding["source"], source);
+    let native_generation = binding["generation"].as_u64().unwrap() + 10;
+    let cancelled = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let pending = codex_omd::client_surface::with_admission(
+        &source,
