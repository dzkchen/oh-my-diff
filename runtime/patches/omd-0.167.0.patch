+fn prepend_status_prefix(
+    mut prefix: Vec<Span<'static>>,
+    content: Option<FooterContent>,
+) -> Option<FooterContent> {
+    if prefix.is_empty() {
+        return content;
+    }
+    let Some(content) = content else {
+        return Some(FooterContent::Line(Line::from(prefix)));
+    };
+    prefix.push(" · ".dim());
+    if let FooterContent::Extension { content } = content {
+        return Some(FooterContent::PrefixedExtension {
+            prefix: Line::from(prefix),
+            content,
+        });
+    }
+    let shift = Line::from(prefix.clone()).width();
+    let mut line = content.into_hyperlink_line();
+    prefix.append(&mut line.line.spans);
+    line.line.spans = prefix;
+    line.source = None;
+    for hyperlink in &mut line.hyperlinks {
+        hyperlink.columns = hyperlink.columns.start + shift..hyperlink.columns.end + shift;
+    }
+    Some(FooterContent::HyperlinkLine(line))
