+    assert_eq!(output["stdout_preview_truncated"], true);
+    assert_eq!(output["stdout"].as_str().unwrap().len(), 4096);
+    let artifact = output["output_artifact"].clone();
+    let first = host
+        .call(
+            &owner,
+            "exec.output_page",
+            json!({"artifact":artifact,"max_bytes":1}),
+        )
+        .unwrap();
+    assert_eq!(first["text"], "é");
+    assert_eq!(first["cursor"], 2);
+    let second = host
+        .call(
+            &owner,
+            "exec.output_page",
+            json!({"artifact":artifact,"cursor":2,"max_bytes":16384}),
+        )
+        .unwrap();
+    assert_eq!(second["text"].as_str().unwrap().len(), 5000);
+    assert!(second["cursor"].is_null());
+    let split = host
+        .call(
+            &owner,
+            "exec.run",
+            json!({"program":"sh", "argv":["-c", "printf 'aé'"], "output_artifact":true}),
+        )
+        .unwrap()["output_artifact"]
+        .clone();
+    let head = host
+        .call(
+            &owner,
+            "exec.output_page",
+            json!({"artifact":split,"max_bytes":2}),
+        )
+        .unwrap();
+    assert_eq!(
+        (head["text"].clone(), head["cursor"].clone()),
+        (json!("a"), json!(1))
+    );
+    let tail = host
+        .call(
+            &owner,
+            "exec.output_page",
+            json!({"artifact":split,"cursor":1,"max_bytes":2}),
+        )
+        .unwrap();
+    assert_eq!(
+        (tail["text"].clone(), tail["cursor"].clone()),
+        (json!("é"), Value::Null)
+    );
+    let other = Caller {
+        thread: Some("thread-2"),
+        ..caller(&capabilities, &[], Origin::Tool)
+    };
+    assert!(
+        host.call(&other, "exec.output_page", json!({"artifact":artifact}))
+            .is_err()
+    );
+    assert_eq!(
+        host.call(
+            &owner,
+            "exec.output_page",
+            json!({"artifact":artifact,"cursor":1})
+        )
+        .unwrap_err(),
+        "exec_output_cursor_invalid"
+    );
+    let path = data
+        .join("exec-output")
+        .join(codex_omd::host::repository_key(&repository))
+        .join("fixture")
+        .join("thread-1")
+        .join(owner.source_sha256)
