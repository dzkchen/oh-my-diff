+#[allow(clippy::too_many_arguments)]
+fn invoke(
+    access: &mut Access<'_>,
+    id: &str,
+    generation: u64,
+    event: &str,
+    name: &str,
+    payload: Value,
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(&str, ModHostCall) -> Result<Value>,
+    progress: &mut dyn FnMut(String),
+    scope: &InvocationScope,
+    mut next: Option<&mut NextFn<'_>>,
+) -> Result<Value> {
+    let _frame = scope.enter(id)?;
+    let thread = state_thread(&payload);
+    let payload = match payload {
+        Value::Object(mut fields) if event == "component_event" => {
+            fields.insert(
+                "thread_id".into(),
+                thread.clone().map_or(Value::Null, Value::String),
+            );
+            Value::Object(fields)
+        }
+        payload => payload,
+    };
+    let retained = !(matches!(
+        event,
+        "terminal"
+            | "inspect"
+            | "workspace_pre_rename"
+            | "command_list"
+            | "config_list"
+            | "component"
+    ) || event == "intercept"
+        && matches!(
+            payload["surface"].as_str(),
+            Some("render" | "input" | "mention" | "history_persist")
+        ));
+    let activation_key = if retained {
+        access.with(|runtime| {
+            if !active() {
+                return Err(failure("callback_cancelled"));
+            }
+            if generation != runtime.generation {
+                return Err(failure("stale_mod_generation"));
+            }
+            let loaded = runtime
+                .loaded
+                .get(id)
+                .cloned()
+                .ok_or_else(|| failure("mod_disabled"))?;
+            runtime.check_callback_authority(&loaded)?;
+            runtime.session_key(id, thread.as_deref())
+        })?
+    } else {
+        None
+    };
+    let _activation = activation_key
+        .as_ref()
+        .map(|key| process::Stepping::enter_guarded(key, active))
+        .transpose()?;
+    let authority_active = active;
+    let admitted = || {
+        authority_active()
+            && activation_key
+                .as_ref()
+                .is_none_or(|key| process::session_current(key))
+    };
+    let active: &dyn Fn() -> bool = &admitted;
+    let started = Instant::now();
+    let budget = Duration::from_millis(MOD_CALLBACK_TOTAL_BUDGET_MS);
+    let now_ms = crate::peers::now_ms();
+    let mut replay: Vec<Value> = Vec::new();
+    loop {
+        let replaying = !replay.is_empty();
+        let mut downstream = None;
+        let mut invocation =
+            access.with(|runtime| runtime.begin(id, generation, active, thread.as_deref()))?;
+        if retained && invocation.loaded.session_key != activation_key {
+            return Err(failure("callback_cancelled"));
+        }
+        if invocation.migrate {
+            invocation.loaded.state =
+                packages::migrate_state(&invocation.loaded, &invocation.location, active)?;
+        }
+        let mut reply = registered_call(&invocation.loaded, &invocation.dynamic, event, name).and_then(|()| {
+        bridge::run(
+            &invocation.loaded,
+            event,
+            name,
+            payload.clone(),
+            &replay,
+            active,
+            &mut |call| {
+                if call.operation == "continuation.next" {
+                    let input = call.arguments.get("input").cloned().unwrap_or(Value::Null);
+                    return match next.as_mut() {
+                        Some(next) => next(&mut *access, &mut *host, input)
+                            .inspect_err(|error| downstream = Some(error.to_string())),
+                        None => Err(failure("continuation_outside_interceptor")),
+                    };
+                }
+                if call.operation == "time.sleep" {
+                    if hostless(event, &payload) {
+                        return Err(failure(format!(
+                            "host_operation_unavailable: time.sleep is not available during {event}"
+                        )));
+                    }
+                    if let Some(surface) = request_path(event, &payload) {
+                        return Err(failure(format!(
+                            "time_sleep_unavailable: {surface} runs on the request path"
+                        )));
+                    }
+                    return sleep(&mut *access, &call.arguments, invocation.virtual_time_ms, active);
+                }
+                if matches!(event, "terminal" | "component") {
+                    return host(id, call);
+                }
+                let mut call = call;
+                if call.operation == "turns.queue"
+                    && let Some(arguments) = call.arguments.as_object_mut()
+                {
+                    arguments.insert("event".into(), json!(event));
+                }
+                let private = call.operation.starts_with("sessions.")
+                    || call.operation.starts_with("evidence.");
+                let masked = private
+                    || ["store.", "credentials.", "http.", "exec."]
+                        .iter()
+                        .any(|prefix| call.operation.starts_with(prefix))
+                    || matches!(call.operation.as_str(), "environment.read" | "environment.set");
+                if access.with(|runtime| Ok(runtime.has_event("host_operation"))).unwrap_or(false) {
+                    let before = json!({"phase":"before","caller":id,"operation":call.operation,"arguments":if masked {Value::Null} else {call.arguments.clone()}});
+                    let _ = access.with(|runtime| {
+                        Ok(runtime.event_except("host_operation", before, id, active, scope))
+                    });
+                }
+                let intercepted = (!private && event != "intercept")
+                    .then(|| access.with(|runtime| Ok(runtime.intercepts("host_operation"))))
+                    .and_then(|intercepts| intercepts.ok().flatten());
+                let result = if let Some(required) = intercepted {
+                    let namespace = host_namespace(&call.operation, &call.arguments);
+                    let input = json!({"operation": call.operation, "namespace": namespace, "arguments": call.arguments});
+                    let chain = scope.stack.borrow().clone();
+                    let provider = (chain.len() > 1).then(|| id.to_owned());
+                    let origin = json!({"caller": id, "thread_id": thread, "provider": provider, "chain": chain});
+                    chain::intercept(
+                        &mut *access,
+                        &mut *host,
+                        &mut chain::Core::Host { caller: id.to_owned(), generation },
+                        "host_operation",
+                        required,
+                        input,
+                        origin,
+                        active,
+                        scope,
+                    )
+                    .and_then(|chain| match chain.result.get("error").and_then(Value::as_str) {
+                        Some(error) => Err(failure(error)),
+                        None => Ok(chain.result["value"].clone()),
+                    })
+                } else {
+                    chain::dispatch(&mut *access, &mut *host, id, generation, call.clone(), active, scope)
+                };
+                if access.with(|runtime| Ok(runtime.has_event("host_operation"))).unwrap_or(false) {
+                    let after = match &result {
+                        Ok(value) => {
+                            json!({"phase":"after","caller":id,"operation":call.operation,"result":if masked {Value::Null} else {value.clone()}})
+                        }
+                        Err(error) => {
+                            json!({"phase":"after","caller":id,"operation":call.operation,"error":if masked {"private_operation_failed".to_owned()} else {error.to_string()}})
+                        }
+                    };
+                    let _ = access.with(|runtime| {
+                        Ok(runtime.event_except("host_operation", after, id, active, scope))
+                    });
+                }
+                result
+            },
+            progress,
+            Some(invocation.virtual_time_ms.unwrap_or(now_ms)),
+            scope,
+        )
+    });
+        // A handler that only rethrows what `next` rejected with is not at fault.
+        invocation.rethrown = matches!((&reply, &downstream), (Err(error), Some(downstream))
+            if rethrown(&error.to_string(), downstream));
+        // A retry replays recorded host results; a divergent replay of read-only calls runs fresh.
+        if replaying && reply.is_err() {
+            if replay.iter().all(read_only_receipt) && started.elapsed() < budget {
+                replay.clear();
+                continue;
+            }
+            reply = Err(failure("state_conflict: reload before retry"));
+        }
+        let session_key = activation_key.clone();
+        let receipts = reply.as_ref().ok().map(|reply| reply.receipts.clone());
+        match access
+            .with(|runtime| runtime.finish(id, generation, event, name, invocation, reply, active))
+        {
+            Err(error)
+                if started.elapsed() < budget
+                    && session_key.is_none()
+                    && error.to_string().starts_with("state_conflict") =>
+            {
+                let Some(receipts) = receipts else {
+                    return Err(error);
+                };
+                replay = receipts;
+            }
+            result => {
+                if result.is_err()
+                    && let Some(key) = session_key
+                {
+                    process::invalidate_activation(&key);
+                }
+                return result;
+            }
+        }
+    }
+}
+
+/// Whether a host call only reads, so a callback that made no other call can run again.
+pub fn read_only_call(call: &ModHostCall) -> bool {
+    read_only(&call.operation, &call.arguments)
+}
+
+fn read_only_receipt(receipt: &Value) -> bool {
+    read_only(
+        receipt["call"]["operation"].as_str().unwrap_or_default(),
+        &receipt["call"]["arguments"],
+    )
+}
+
+fn read_only(operation: &str, arguments: &Value) -> bool {
+    match operation {
+        "workspace.read"
+        | "workspace.list"
+        | "workspace.stat"
+        | "workspace.fingerprint"
+        | "store.get"
+        | "store.list"
+        | "store.export"
+        | "evidence.read"
+        | "sessions.list"
+        | "sessions.read"
+        | "routes.list"
+        | "task.status"
+        | "contract.status"
+        | "agents.list"
+        | "process.which"
+        | "process.status"
+        | "sidecars.status"
+        | "app.routes"
+        | "credentials.list"
+        | "turns.activity"
+        | "composer.read"
+        | "prompts.status"
+        | "packages.list"
+        | "packages.index"
+        | "packages.preview"
+        | "exec.output_page"
+        | "terminal.image_sample" => true,
+        "workspace.check_access" => arguments["write"] != true,
+        "models.context_window" => arguments.get("tokens").is_none(),
+        "exec.run" => {
+            arguments["write"] != true
+                && arguments["network"]
+                    .as_str()
+                    .is_none_or(|network| network == "none")
+                && arguments["unix_sockets"].is_null()
+                && arguments["sandbox"].is_null()
+        }
+        _ => false,
+    }
+}
+
+fn invoke_with_options(
+    access: &mut Access<'_>,
+    id: &str,
+    generation: u64,
+    event: &str,
+    name: &str,
+    payload: Value,
+    options: ModInvokeOptions<'_>,
+) -> Result<Value> {
+    let ModInvokeOptions {
+        active,
+        mut host,
+        progress,
+    } = options;
+    let mut dispatch = |caller: &str, call: ModHostCall| match &mut host {
+        ModHostCallback::Scoped(host) => host(caller, call),
+        _ if caller != id => Err(failure("service_provider_host_dispatch_unavailable")),
+        ModHostCallback::Own(host) => host(call),
+        ModHostCallback::Unavailable => Err(failure(
+            "host_operation_unavailable: requires a native task",
+        )),
+    };
+    invoke(
+        access,
+        id,
+        generation,
+        event,
+        name,
+        payload,
+        active,
+        &mut dispatch,
+        progress.unwrap_or(&mut |_| {}),
+        &InvocationScope::default(),
+        None,
+    )
+}
+
+pub fn invoke_shared(
+    runtime: &Mutex<ModHost>,
+    id: &str,
+    generation: u64,
+    event: &str,
+    name: &str,
+    payload: Value,
+    options: ModInvokeOptions<'_>,
+) -> Result<Value> {
+    invoke_with_options(
+        &mut Access::Shared(runtime),
+        id,
+        generation,
+        event,
+        name,
+        payload,
+        options,
+    )
+}
+
+pub fn event_shared(
+    runtime: &Mutex<ModHost>,
+    event: &str,
+    mut payload: impl FnMut(&str) -> Value,
+    mut options: ModInvokeOptions<'_>,
+) -> Vec<(String, Result<Value>)> {
+    let Ok((ids, generation)) = runtime
+        .lock()
+        .map(|runtime| (runtime.event_ids(event), runtime.generation))
+    else {
+        return Vec::new();
+    };
+    ids.into_iter()
+        .map(|id| {
+            let result = invoke_shared(
+                runtime,
+                &id,
+                generation,
+                event,
+                "",
+                payload(&id),
+                options.reborrow(),
+            );
+            (id, result)
+        })
+        .collect()
+}
+
+fn always_active() -> bool {
+    true
+}
+
+pub struct ModOpenOptions<'a> {
+    pub tool_validator: fn(&Value) -> Result<()>,
+    pub repository: Option<&'a Path>,
+    pub active: &'a dyn Fn() -> bool,
+}
+
+impl Default for ModOpenOptions<'_> {
+    fn default() -> Self {
+        Self {
+            tool_validator: |_| Ok(()),
+            repository: None,
+            active: &always_active,
+        }
+    }
+}
+
+pub enum ModHostCallback<'a> {
+    Unavailable,
+    Own(&'a mut dyn FnMut(ModHostCall) -> Result<Value>),
+    Scoped(&'a mut dyn FnMut(&str, ModHostCall) -> Result<Value>),
+}
+
+pub struct ModInvokeOptions<'a> {
+    pub active: &'a dyn Fn() -> bool,
+    pub host: ModHostCallback<'a>,
+    pub progress: Option<&'a mut dyn FnMut(String)>,
+}
+
+impl Default for ModInvokeOptions<'_> {
+    fn default() -> Self {
+        Self {
+            active: &always_active,
+            host: ModHostCallback::Unavailable,
+            progress: None,
+        }
+    }
+}
+
+impl ModInvokeOptions<'_> {
+    fn reborrow(&mut self) -> ModInvokeOptions<'_> {
+        ModInvokeOptions {
+            active: self.active,
+            host: match &mut self.host {
+                ModHostCallback::Unavailable => ModHostCallback::Unavailable,
+                ModHostCallback::Own(host) => ModHostCallback::Own(&mut **host),
+                ModHostCallback::Scoped(host) => ModHostCallback::Scoped(&mut **host),
+            },
+            progress: self.progress.as_deref_mut().map(|progress| progress as _),
+        }
+    }
+}
+
+impl ModHost {
+    pub fn open(root: PathBuf, options: ModOpenOptions<'_>) -> Result<Self> {
+        let ModOpenOptions {
+            tool_validator,
+            repository,
+            active,
+        } = options;
+        let store = ModStore::open(root)?;
+        let mut host = Self {
+            store,
+            generation: 0,
+            configuration_sha256: String::new(),
+            configuration_stamp: None,
+            inspect_retried: String::new(),
+            inspect_retry: None,
+            ui_configuration: None,
+            selections: (0, 0),
+            loaded: BTreeMap::new(),
+            order: Vec::new(),
+            rejected: Vec::new(),
+            reload_error: None,
+            service_calls: Vec::new(),
+            tool_validator,
+            virtual_time_ms: None,
+            tier_selections: BTreeMap::new(),
+            dynamic_tools: BTreeMap::new(),
+            checkout: None,
+            valid_views: BTreeMap::new(),
+            renders: BTreeMap::new(),
+            clock_reads: BTreeSet::new(),
+            ui_mods: mod_ui_allowlist().map(<[String]>::to_vec),
+            rendered: HashMap::new(),
+            chains: Vec::new(),
+            access: Vec::new(),
+            admissions: BTreeMap::new(),
+            brokered: None,
+            callback_configuration: Mutex::default(),
+            callback_verdicts: HashMap::new(),
+            required_surfaces: Arc::default(),
+            intercepted_surfaces: Arc::default(),
+            codex_config: Arc::default(),
+            environment: Arc::default(),
+            policies: Vec::new(),
+            managed: None,
+            unserved: Vec::new(),
+            project: None,
+            pool: {
+                static HOSTS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                HOSTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+            },
+            seeded: BTreeMap::new(),
+        };
+        if let Some(repository) = repository {
+            host.set_checkout(repository);
+        }
+        let key = (host.store.root.clone(), host.project.clone());
+        if let Some((_, loaded)) = ACTIVATED
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .iter()
+            .find(|(activated, _)| activated == &key)
+        {
+            host.seeded = loaded
+                .iter()
+                .map(|(id, loaded)| (id.clone(), loaded.inspected()))
+                .collect();
+        }
+        host.refresh(active)?;
+        Ok(host)
+    }
+
+    /// One mod's launch-like cost for `omd-mod cost`; it stops every runner in the process.
+    pub fn cost(
+        root: PathBuf,
+        tool_validator: fn(&Value) -> Result<()>,
+        repository: &Path,
+        id: &str,
+        command: Option<(&str, Value)>,
+        runs: usize,
+    ) -> Result<Value> {
+        let _thread = StateThread::enter(
+            bound_thread().or_else(|| Some("00000000-0000-4000-8000-000000000001".to_owned())),
+        );
+        let mut samples: BTreeMap<&str, Vec<f64>> = BTreeMap::new();
+        let mut usage = (0, 0);
+        let elapsed = |started: Instant| started.elapsed().as_secs_f64() * 1000.0;
+        for _ in 0..runs {
+            process::stop_runners();
+            ACTIVATED
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .retain(|((store, _), _)| store != &root);
+            let started = Instant::now();
+            let mut host = Self::open(
+                root.clone(),
+                ModOpenOptions {
+                    tool_validator,
+                    repository: Some(repository),
+                    ..ModOpenOptions::default()
+                },
+            )?;
+            samples
+                .entry("activation_ms")
+                .or_default()
+                .push(elapsed(started));
+            let loaded = host.loaded.get(id).ok_or_else(|| failure("mod_disabled"))?;
+            if let Some(error) = &loaded.error {
+                return Err(failure(format!("mod_failed: {error}")));
+            }
+            if host
+                .event_ids("terminal")
+                .iter()
+                .any(|handler| handler == id)
+            {
+                let started = Instant::now();
+                let view = host.terminal_view(json!({"event": "draw", "ledger": null}), || true);
+                let render_ms = elapsed(started);
+                let prefix = format!("{id}: ");
+                if let Some(error) = view
+                    .diagnostics
+                    .iter()
+                    .find_map(|d| d.strip_prefix(&prefix))
+                {
+                    return Err(failure(format!("mod_failed: {error}")));
+                }
+                samples
+                    .entry("first_render_ms")
+                    .or_default()
+                    .push(render_ms);
+            }
+            if let Some((name, payload)) = &command {
+                for sample in ["fresh_callback_ms", "reused_callback_ms"] {
+                    let started = Instant::now();
+                    host.invoke(
+                        id,
+                        host.generation,
+                        "command",
+                        name,
+                        payload.clone(),
+                        ModInvokeOptions::default(),
+                    )?;
+                    samples.entry(sample).or_default().push(elapsed(started));
+                }
+            }
+            usage = process::runner_usage();
+        }
+        let mut report = json!({"mod": id, "runs": runs, "runners": usage.0,
+            "runner_peak_footprint_bytes": usage.1});
+        for (metric, values) in samples {
+            let first = values[0];
+            let mut sorted = values;
+            sorted.sort_by(f64::total_cmp);
+            let at =
+                |quantile: f64| sorted[((sorted.len() - 1) as f64 * quantile).round() as usize];
+            report[metric] = json!({"first": first, "p50": at(0.5), "p95": at(0.95)});
+        }
+        Ok(report)
+    }
+
+    /// Selects where `state_scope: "checkout"` mod state lives: the Git directory, else nowhere.
+    pub fn set_checkout(&mut self, repository: &Path) {
+        self.configuration_stamp = None;
+        self.callback_verdicts.clear();
+        if self.project.as_deref() != repository.canonicalize().ok().as_deref() {
+            for loaded in self.loaded.values_mut() {
+                loaded.clear_ui();
+            }
+        }
+        self.project = repository.canonicalize().ok();
+        self.checkout = repository
+            .ancestors()
+            .find_map(|directory| {
+                let marker = directory.join(".git");
+                let metadata = std::fs::symlink_metadata(&marker).ok()?;
+                let git = if metadata.is_dir() {
+                    marker
+                } else if metadata.is_file() {
+                    let text = std::fs::read_to_string(&marker).ok()?;
+                    directory.join(text.strip_prefix("gitdir:")?.trim())
+                } else {
+                    return None;
+                };
+                git.canonicalize().ok()
+            })
+            .map(|git| git.join("omd").join("state"));
+    }
+
+    /// The state an inspection runs with: the bound thread's or checkout's, `null` while older state awaits migration.
+    fn inspection_state(&self, package: &ModPackage, scope: &str) -> Result<Value> {
+        let location = self.state_location(package, scope, bound_thread().as_deref());
+        match self.store.scoped_state(&location, package.state_version) {
+            // Older thread or checkout state migrates at the mod's first callback there.
+            Err(error)
+                if matches!(location, store::StateLocation::Directory(..))
+                    && error.to_string().starts_with("state_migration_required") =>
+            {
+                Ok(Value::Null)
+            }
+            state => state,
+        }
+    }
+
+    fn state_location(
+        &self,
+        package: &ModPackage,
+        scope: &str,
+        thread: Option<&str>,
+    ) -> store::StateLocation {
+        let name = format!("{}.json", package.id);
+        match package.state_scope.as_str() {
+            "thread" => match thread.filter(|thread| crate::resource_data::token(thread)) {
+                Some(thread) => store::StateLocation::Directory(
+                    self.store
+                        .root
+                        .join("data")
+                        .join("threads")
+                        .join(thread)
+                        .join(".state"),
+                    ModStore::state_name(&package.id, scope),
+                ),
+                None => store::StateLocation::Unavailable("state_thread_unavailable"),
+            },
+            "checkout" => match &self.checkout {
+                Some(directory) => store::StateLocation::Directory(directory.clone(), name),
+                None => store::StateLocation::Unavailable("state_checkout_unavailable"),
+            },
+            _ => store::StateLocation::Store {
+                id: package.id.clone(),
+                scope: scope.to_owned(),
+            },
+        }
+    }
+
+    fn session_owner(&self, loaded: &Loaded) -> String {
+        crate::sha256_hex(
+            json!([
+                self.store.root,
+                self.project,
+                loaded.package.id,
+                loaded.selection.scope
+            ])
+            .to_string()
+            .as_bytes(),
+        )
+    }
+
+    fn session_key(&self, id: &str, thread: Option<&str>) -> Result<Option<String>> {
+        let Some(loaded) = self.loaded.get(id) else {
+            return Ok(None);
+        };
+        if !loaded
+            .package
+            .compatibility
+            .required_features
+            .iter()
+            .any(|feature| feature == "session_activation_v1")
+        {
+            return Ok(None);
+        }
+        let Some(thread) = thread else {
+            return Ok(None);
+        };
+        let reset = UI_RESETS
+            .lock()
+            .ok()
+            .and_then(|resets| resets.get(&self.store.root).copied());
+        let binding = crate::sha256_hex(
+            json!([
+                loaded.selection,
+                loaded.adapter.as_ref().map(|adapter| &adapter.sha256),
+                loaded.settings_file,
+                loaded.withheld,
+                reset
+            ])
+            .to_string()
+            .as_bytes(),
+        );
+        process::session_key(&self.session_owner(loaded), thread, &binding).map(Some)
+    }
+
+    pub fn release_thread_activations(&self, thread: &str) {
+        for loaded in self.loaded.values() {
+            process::invalidate_session_owner(&self.session_owner(loaded), Some(thread));
+        }
+    }
+
+    pub fn reload(&mut self) -> Result<bool> {
+        for loaded in self.loaded.values() {
+            process::invalidate_session_owner(&self.session_owner(loaded), None);
+        }
+        for loaded in self.loaded.values_mut() {
+            loaded.clear_ui();
+        }
+        self.refresh(&always_active)
+    }
+
+    pub fn refresh(&mut self, active: &dyn Fn() -> bool) -> Result<bool> {
+        let result = self.reload_active(active);
+        if result.is_err() && !active() {
+            self.fail_closed("callback_cancelled".to_owned());
+            return Err(failure("callback_cancelled"));
+        }
+        result
+    }
+
+    fn fail_closed(&mut self, reason: String) {
+        for loaded in self.loaded.values_mut() {
+            loaded.clear_ui();
+        }
+        if !self.loaded.is_empty() {
+            self.loaded.clear();
+            self.environment.clear(None, None);
+            self.order.clear();
+            self.generation += 1;
+            self.dynamic_tools.clear();
+        }
+        self.unserved = vec![(
+            "authority".to_owned(),
+            MOD_CAPABILITIES
+                .iter()
+                .map(|capability| (*capability).to_owned())
+                .collect(),
+            reason,
+        )];
+        self.publish_surfaces();
+        self.configuration_sha256.clear();
+        self.inspect_retry = None;
+    }
+
+    fn current(&self, stamp: &Option<ConfigurationStamp>) -> bool {
+        !self.inspect_retry_due()
+            && stamp.is_some()
+            && *stamp == self.configuration_stamp
+            && self
+                .brokered
+                .as_ref()
+                .is_some_and(|(at, _, _)| at.elapsed() < BROKER_REFRESH)
+    }
+
+    /// Retries a timed-out inspection of this configuration once.
+    fn schedule_inspect_retry(&mut self, hash: &str, initial: bool) {
+        self.inspect_retry = (self.inspect_retried != hash).then(|| (initial, Instant::now()));
+        hash.clone_into(&mut self.inspect_retried);
+    }
+
+    /// `stamp` if the configuration files still match it, so a change during the reload triggers another.
+    fn settled(&self, stamp: Option<ConfigurationStamp>) -> Option<ConfigurationStamp> {
+        stamp.filter(|stamp| configuration_stamps(&self.store.root).as_ref() == Some(stamp))
+    }
+
+    /// A timed-out inspection is retried once it is 2 s old.
+    fn inspect_retry_due(&self) -> bool {
+        self.inspect_retry
+            .is_some_and(|(_, failed)| failed.elapsed() >= Duration::from_secs(2))
+    }
+
+    pub fn refresh_due(&self) -> bool {
+        !self.current(&configuration_stamps(&self.store.root))
+    }
+
+    fn reload_active(&mut self, active: &dyn Fn() -> bool) -> Result<bool> {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        let path = self.store.root.join("mods.json");
+        let stamp = configuration_stamps(&self.store.root);
+        if self.current(&stamp) {
+            return Ok(false);
+        }
+        self.configuration_stamp = None;
+        let (stamp, sha256, bytes) = read_configuration(&self.store.root, stamp);
+        let authority = match self.authority(&sha256) {
+            Ok(authority) => authority,
+            Err(error) => {
+                self.fail_closed(format!("authority_unavailable: {error}"));
+                return Err(error);
+            }
+        };
+        let hash = self.authority_hash(&sha256, &authority);
+        let (brokered, managed, deployment) = authority;
+        let (deployment, unreadable) = match deployment {
+            Ok(deployment) => (deployment, None),
+            Err(error) => (policy::ManagedDeployment::default(), Some(error)),
+        };
+        let retrying = hash == self.configuration_sha256;
+        if retrying && !self.inspect_retry_due() {
+            self.configuration_stamp = self.settled(stamp);
+            return Ok(false);
+        }
+        let configured = bytes
+            .and_then(|bytes| ModConfiguration::parse(&bytes, &path))
+            .and_then(|config| match config.schema != 1 {
+                true => Err(failure("invalid_mod_configuration")),
+                false => Ok(config),
+            });
+        let mut rejected = Vec::new();
+        let config = match configured {
+            Ok(config) => config,
+            Err(error) if managed.is_some() => {
+                // Administrator policy still loads when the user's configuration is broken.
+                rejected.push(ModRejection {
+                    path,
+                    id: None,
+                    scope: user_scope(),
+                    reason: format!("invalid_mod_configuration: {error}"),
+                });
+                ModConfiguration {
+                    schema: 1,
+                    revision: 0,
+                    node: None,
+                    mods: Vec::new(),
+                }
+            }
+            Err(error) => return Err(error),
+        };
+        if let Err(error) = process::runner_path().and_then(|runner| {
+            store::verify_runner(&runner, brokered.as_ref().map(|(_, grants)| grants))
+        }) {
+            self.fail_closed(error.to_string());
+            return Err(error);
+        }
+        let ui_signature = crate::sha256_hex(serde_json::to_vec(&config.mods)?.as_slice());
+        if self
+            .ui_configuration
+            .as_ref()
+            .is_some_and(|(revision, signature)| {
+                *revision != config.revision && signature == &ui_signature
+            })
+        {
+            reset_ui_states(&self.store.root, config.revision);
+        }
+        self.ui_configuration = Some((config.revision, ui_signature));
+        let mut selections = Vec::new();
+        let user = self.store.managed_user();
+        if let Some(managed) = &managed {
+            if let Some(reason) = unreadable {
+                rejected.push(ModRejection {
+                    path: self.store.root.join("managed.json"),
+                    id: None,
+                    scope: MANAGED_SCOPE.to_owned(),
+                    reason,
+                });
+            }
+            let (administered, pending) =
+                managed.selections(&deployment, &user, self.project.as_deref());
+            selections = administered;
+            rejected.extend(pending);
+        }
+        let administered = selections.len();
+        selections.extend(config.mods.iter().cloned());
+        self.managed = managed;
+        self.policies = selections
+            .iter()
+            .filter(|m| m.enabled && m.capabilities.iter().any(|c| c == "request_policy"))
+            .map(|m| m.path.clone())
+            .collect();
+        self.publish_surfaces();
+        let initial = match self.inspect_retry {
+            Some((initial, _)) if retrying => initial,
+            _ => self.configuration_sha256.is_empty() || self.managed.is_some(),
+        };
+        let retained = self.loaded.len();
+        self.loaded.retain(|_, loaded| {
+            let keep = selections.iter().enumerate().any(|(index, m)| {
+                m.enabled
+                    && m.path == loaded.selection.path
+                    && m.scope == loaded.selection.scope
+                    && loaded
+                        .package
+                        .capabilities
+                        .iter()
+                        .all(|cap| m.capabilities.contains(cap))
+                    && (index < administered
+                        || brokered
+                            .as_ref()
+                            .is_none_or(|(_, grants)| grants.contains(&store::grant(&json!(m)))))
+            });
+            if !keep {
+                loaded.clear_ui();
+            }
+            keep
+        });
+        if self.loaded.len() != retained {
+            self.retain_environment();
+            self.generation += 1;
+            self.dynamic_tools.clear();
+        }
+        self.unserved = self.unserved_targets(&user);
+        self.publish_surfaces();
+        let selected = Self::select(
+            &selections,
+            administered,
+            initial,
+            brokered.as_ref().map(|(_, grants)| grants),
+            self.managed.as_ref().map(|managed| &managed.policy),
+            &mut rejected,
+            |path| {
+                store::verified(path)
+                    .map(|v| (v.package.clone(), v.source.clone(), v.sha256.clone()))
+            },
+        )?;
+        let adapters = Self::adapters(&selected);
+        let seeded = std::mem::take(&mut self.seeded);
+        // Trust pinned outside the store (broker or managed policy) must not depend on files in it.
+        let caching = brokered.is_none() && self.managed.is_none();
+        let cache_root = || {
+            Arc::new(code_cache::CacheRoot::new(
+                self.store.root.join("cache").join("code"),
+            ))
+        };
+        let mut next = BTreeMap::new();
+        let mut inspections = Vec::new();
+        for (id, (mut selection, package, source)) in selected {
+            if !active() {
+                return Err(failure("callback_cancelled"));
+            }
+            let (settings_file, file_settings) = self.store.settings_file(&package, &selection);
+            selection.settings.extend(file_settings);
+            // An unchanged trusted selection and adapter keep their inspection; another host's also needs the state it ran with.
+            let unchanged = |previous: &&Loaded| {
+                previous.error.is_none()
+                    && previous.settings_file == settings_file
+                    && previous.adapter.as_ref()
+                        == package
+                            .adapter
+                            .as_deref()
+                            .and_then(|name| adapters.get(name))
+                    && serde_json::to_value(&previous.selection).ok()
+                        == serde_json::to_value(&selection).ok()
+                    && previous
+                        .registrations
+                        .tools
+                        .iter()
+                        .all(|tool| (self.tool_validator)(&tool.parameters).is_ok())
+            };
+            let reused = self.loaded.get(&id).filter(unchanged).or_else(|| {
+                seeded.get(&id).filter(unchanged).filter(|previous| {
+                    self.inspection_state(&previous.package, &previous.selection.scope)
+                        .is_ok_and(|state| state == *previous.registered_state)
+                })
+            });
+            if let Some(previous) = reused {
+                let mut reused = previous.clone();
+                reused.code_cache = match reused.code_cache.take() {
+                    Some(cache) if caching => Some(cache),
+                    _ => caching.then(cache_root),
+                };
+                next.insert(id, reused);
+                continue;
+            }
+            let assets = (|| {
+                if package.assets.is_empty() {
+                    return Ok(BTreeMap::new());
+                }
+                let verified = store::verified(&selection.path)?;
+                if verified.sha256 != selection.sha256 {
+                    return Err(failure(format!(
+                        "source_changed: {} changed after it was trusted; review it in /omd or run omd mods update {}",
+                        package.id, package.id
+                    )));
+                }
+                Ok(store::asset_map(verified.assets.clone()))
+            })();
+            let assets = match assets {
+                Ok(assets) => assets,
+                Err(error) => {
+                    reject(
+                        initial,
+                        &mut rejected,
+                        &selection,
+                        Some(&package.id),
+                        error.to_string(),
+                    )?;
+                    continue;
+                }
+            };
+            let adapter = package.adapter.as_deref().map(|name| {
+                adapters
+                    .get(name)
+                    .cloned()
+                    .ok_or_else(|| failure(format!("adapter_unavailable: {name}")))
+            });
+            let mut loaded = Loaded {
+                adapter: adapter
+                    .as_ref()
+                    .and_then(|value| value.as_ref().ok().cloned()),
+                package: Arc::new(package),
+                source: source.into(),
+                assets: Arc::new(assets),
+                request_metadata: Arc::new(OnceLock::new()),
+                session_key: None,
+                code_cache: caching.then(cache_root),
+                selection: Arc::new(selection),
+                state: Value::Null,
+                state_revision: 0,
+                registered_state: Arc::default(),
+                ui: None,
+                ui_state: Value::Null,
+                ui_revision: 0,
+                ui_clears: 0,
+                command_view: None,
+                registrations: Registered::default(),
+                source_use: Arc::default(),
+                unused_grants: Vec::new(),
+                unused_environment: Vec::new(),
+                withheld: Vec::new(),
+                settings_file,
+                error: None,
+                telemetry: ModTelemetry::default(),
+            };
+            let ready = (|| {
+                if let Some(Err(error)) = &adapter {
+                    return Err(failure(error.to_string()));
+                }
+                loaded.set_state(self.inspection_state(&loaded.package, &loaded.selection.scope)?);
+                Ok(())
+            })();
+            inspections.push((id, loaded, ready));
+        }
+        for (id, (mut loaded, prepared)) in
+            Self::inspect_all(inspections, self.tool_validator, active)?
+        {
+            match prepared {
+                Ok((registrations, source_use, unused_grants, unused_environment)) => {
+                    loaded.registered_state = Arc::new(loaded.state.clone());
+                    loaded.registrations = registrations;
+                    loaded.source_use = Arc::new(source_use);
+                    loaded.unused_grants = unused_grants;
+                    loaded.unused_environment = unused_environment;
+                }
+                Err(error) => {
+                    let lenient = initial
+                        || self
+                            .loaded
+                            .get(&id)
+                            .is_none_or(|previous| previous.error.is_some());
+                    // The working mods stay; the transactional reload runs once more when a retry is due, then waits for a configuration change.
+                    if !lenient && timed_out(&error.to_string()) {
+                        self.schedule_inspect_retry(&hash, initial);
+                        self.configuration_stamp = self.settled(stamp.clone());
+                    }
+                    fail(lenient, &mut loaded, error)?;
+                }
+            }
+            next.insert(id, loaded);
+        }
+        // Mods without a working previous version fail alone; working ones keep reloads transactional.
+        let working: BTreeSet<String> = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_none())
+            .map(|(id, _)| id.clone())
+            .collect();
+        let lenient = |id: &str| initial || !working.contains(id);
+        Self::resolve_conflicts(&mut next, &lenient)?;
+        Self::resolve_services(&mut next, &lenient)?;
+        Self::resolve_virtual_readers(&mut next, &lenient)?;
+        let order = Self::resolve_dependencies(&mut next, &lenient)?;
+        self.selections = (
+            config
+                .mods
+                .iter()
+                .map(|m| &m.path)
+                .collect::<BTreeSet<_>>()
+                .len(),
+            config
+                .mods
+                .iter()
+                .filter(|m| m.enabled)
+                .map(|m| &m.path)
+                .collect::<BTreeSet<_>>()
+                .len(),
+        );
+        // A timed-out inspection runs again at the next reload, once per configuration.
+        let any_timed_out = next
+            .values()
+            .any(|loaded| loaded.error.as_deref().is_some_and(timed_out));
+        for (id, previous) in &mut self.loaded {
+            if next.get(id).is_none_or(|loaded| {
+                !Arc::ptr_eq(&loaded.request_metadata, &previous.request_metadata)
+            }) {
+                process::invalidate_session_owner(
+                    &crate::sha256_hex(
+                        json!([
+                            self.store.root,
+                            self.project,
+                            previous.package.id,
+                            previous.selection.scope
+                        ])
+                        .to_string()
+                        .as_bytes(),
+                    ),
+                    None,
+                );
+                previous.clear_ui();
+            }
+        }
+        self.loaded = next;
+        self.order = order;
+        let denied = rejected
+            .iter()
+            .filter(|rejection| {
+                !self.rejected.iter().any(|previous| {
+                    previous.path == rejection.path && previous.reason == rejection.reason
+                })
+            })
+            .map(|rejection| {
+                json!({"path": rejection.path, "mod": rejection.id,
+                "scope": rejection.scope, "reason": rejection.reason.split(':').next()})
+            })
+            .collect::<Vec<_>>();
+        if !denied.is_empty()
+            && let Ok(_guard) = self.store.lock()
+        {
+            let _ = self
+                .store
+                .record_security_event("load_denied", json!({"selections": denied}));
+        }
+        self.rejected = rejected;
+        self.admit(active);
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        self.retain_environment();
+        self.unserved = self.unserved_targets(&user);
+        if any_timed_out {
+            self.schedule_inspect_retry(&hash, initial);
+        } else {
+            self.inspect_retry = None;
+        }
+        self.configuration_sha256 = hash;
+        self.configuration_stamp = self.settled(stamp);
+        let key = (self.store.root.clone(), self.project.clone());
+        let mut inspected: BTreeMap<_, _> = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_none())
+            .map(|(id, loaded)| (id.clone(), loaded.inspected()))
+            .collect();
+        {
+            let mut activated = ACTIVATED.lock().unwrap_or_else(PoisonError::into_inner);
+            // A mod that failed here (an inspection timeout) keeps the inspection another host published.
+            if let Some(index) = activated
+                .iter()
+                .position(|(activated, _)| activated == &key)
+            {
+                let (_, mut previous) = activated.remove(index);
+                for id in self.loaded.keys() {
+                    if !inspected.contains_key(id)
+                        && let Some(loaded) = previous.remove(id)
+                    {
+                        inspected.insert(id.clone(), loaded);
+                    }
+                }
+            }
+            activated.insert(0, (key, inspected));
+            activated.truncate(ACTIVATED_CHECKOUTS);
+        }
+        self.generation += 1;
+        self.dynamic_tools.clear();
+        self.reload_error = None;
+        self.publish_surfaces();
+        if let Err(error) = self.write_installed_service_types() {
+            self.reload_error = Some(format!("derived_types_unavailable: {error}"));
+        }
+        Ok(true)
+    }
+
+    /// Intercept surfaces with a required interceptor, readable while another caller holds the runtime.
+    pub fn required_surfaces(&self) -> Arc<Mutex<Vec<&'static str>>> {
+        self.required_surfaces.clone()
+    }
+
+    /// Intercept surfaces with any interceptor, readable while another caller holds the runtime.
+    pub fn intercepted_surfaces(&self) -> Arc<Mutex<Vec<&'static str>>> {
+        self.intercepted_surfaces.clone()
+    }
+
+    pub fn environment(&self) -> Arc<crate::host::Environment> {
+        self.environment.clone()
+    }
+
+    /// Codex config keys the active packages turn on, readable while another caller holds the runtime.
+    pub fn codex_config(&self) -> Arc<Mutex<BTreeSet<String>>> {
+        self.codex_config.clone()
+    }
+
+    fn retain_environment(&self) {
+        self.environment.retain(
+            &self
+                .owners()
+                .into_iter()
+                .map(|(id, owner)| (id, owner.sha256))
+                .collect(),
+        );
+    }
+
+    fn publish_surfaces(&self) {
+        process::size_reused_pool(
+            self.pool,
+            Some(
+                self.loaded
+                    .values()
+                    .filter(|m| m.error.is_none() && m.registrations.calls_back())
+                    .count(),
+            ),
+        );
+        let surfaces = MOD_INTERCEPT_SURFACES
+            .iter()
+            .map(|(surface, _)| *surface)
+            .filter(|surface| {
+                self.intercepts(surface) == Some(true)
+                    || *surface == "model_send" && !self.policies.is_empty()
+            })
+            .collect();
+        if let Ok(mut published) = self.required_surfaces.lock() {
+            *published = surfaces;
+        }
+        let intercepted = MOD_INTERCEPT_SURFACES
+            .iter()
+            .map(|(surface, _)| *surface)
+            .filter(|surface| self.intercepts(surface).is_some())
+            .collect();
+        if let Ok(mut published) = self.intercepted_surfaces.lock() {
+            *published = intercepted;
+        }
+        if let Ok(mut published) = self.codex_config.lock() {
+            *published = self
+                .active()
+                .flat_map(|(_, loaded)| loaded.package.codex_config.keys().cloned())
+                .collect();
+        }
+    }
+
+    fn unserved_targets(&self, user: &str) -> Vec<(String, Vec<String>, String)> {
+        let Some(managed) = &self.managed else {
+            return Vec::new();
+        };
+        managed
+            .targets(user, self.project.as_deref())
+            .into_iter()
+            .filter(|target| {
+                !self.loaded.get(&target.id).is_some_and(|loaded| {
+                    loaded.selection.scope == MANAGED_SCOPE
+                        && (loaded.error.is_none()
+                            || *loaded.registrations != Registrations::default())
+                })
+            })
+            .map(|target| {
+                let reason = self
+                    .rejected
+                    .iter()
+                    .find(|rejection| {
+                        rejection.scope == MANAGED_SCOPE
+                            && rejection.id.as_ref() == Some(&target.id)
+                    })
+                    .map(|rejection| rejection.reason.clone())
+                    .or_else(|| self.loaded.get(&target.id)?.error.clone())
+                    .unwrap_or_else(|| {
+                        format!(
+                            "managed_not_running: {}; see omd-mod policy explain",
+                            target.id
+                        )
+                    });
+                (target.id.clone(), target.capabilities.clone(), reason)
+            })
+            .collect()
+    }
+
+    /// Re-asks the broker and policy source and re-reads the deployment record when `mods.json` changes or the last answer is older than `BROKER_REFRESH`.
+    fn authority(&mut self, digest: &str) -> Result<Authority> {
+        if let Some((at, cached, authority)) = &self.brokered
+            && cached == digest
+            && at.elapsed() < BROKER_REFRESH
+        {
+            return Ok(authority.clone());
+        }
+        self.brokered = None;
+        let grants = store::brokered_grants(&self.store.root)?;
+        let managed = self.store.managed()?;
+        let deployment = match managed {
+            Some(_) => self
+                .store
+                .managed_deployment()
+                .map_err(|error| error.to_string()),
+            None => Ok(policy::ManagedDeployment::default()),
+        };
+        let authority = (grants, managed, deployment);
+        self.brokered = Some((Instant::now(), digest.to_owned(), authority.clone()));
+        Ok(authority)
+    }
+
+    fn authority_hash(&self, configuration_sha256: &str, authority: &Authority) -> String {
+        let (brokered, managed, deployment) = authority;
+        format!(
+            "{configuration_sha256}:{}:{}:{}:{}",
+            brokered.as_ref().map_or(0, |(generation, _)| *generation),
+            managed
+                .as_ref()
+                .map_or("", |managed| managed.sha256.as_str()),
+            deployment
+                .as_ref()
+                .map_or(0, |deployment| deployment.generation),
+            self.project.as_deref().unwrap_or(Path::new("")).display()
+        )
+    }
+
+    pub fn set_managed_policy(&mut self, file: PathBuf, owner: u32, user: &str) -> Result<bool> {
+        self.store.set_managed_policy(file, owner, user);
+        self.brokered = None;
+        self.reload()
+    }
+
+    fn adapters(
+        selected: &BTreeMap<String, (ModSelection, ModPackage, String)>,
+    ) -> BTreeMap<String, Arc<Adapter>> {
+        selected
+            .iter()
+            .filter_map(|(id, (selection, package, _))| {
+                let module = package.adapter_module.as_ref()?;
+                let verified = store::verified(&selection.path).ok()?;
+                if verified.sha256 != selection.sha256 {
+                    return None;
+                }
+                let file = |asset: &String| {
+                    verified.assets.get(asset).map(|source| {
+                        json!({"source": source, "filename": selection.path.join(asset)})
+                    })
+                };
+                let entry = file(&module.entry)?;
+                let aliases = module
+                    .aliases
+                    .iter()
+                    .map(|(specifier, asset)| Some((specifier.clone(), file(asset)?)))
+                    .collect::<Option<serde_json::Map<_, _>>>()?;
+                let module = json!({"source": entry["source"], "filename": entry["filename"], "aliases": aliases});
+                let sha256 = crate::sha256_hex(module.to_string().as_bytes());
+                Some((id.clone(), Arc::new(Adapter { module, sha256 })))
+            })
+            .collect()
+    }
+
+    /// Trusted, enabled selections keyed by mod ID after administrator policy and scope precedence; the first `administered` selections come from the policy.
+    fn select(
+        selections: &[ModSelection],
+        administered: usize,
+        initial: bool,
+        grants: Option<&BTreeSet<String>>,
+        managed: Option<&ManagedPolicy>,
+        rejected: &mut Vec<ModRejection>,
+        inspect: fn(&Path) -> Result<(ModPackage, String, String)>,
+    ) -> Result<BTreeMap<String, (ModSelection, ModPackage, String)>> {
+        let mut valid = Vec::new();
+        for (index, selection) in selections.iter().enumerate().filter(|(_, m)| m.enabled) {
+            let mut inspected = None;
+            let verdict = inspect(&selection.path).and_then(|(package, source, sha256)| {
+                inspected = Some(package.id.clone());
+                let refusal = selection_verdict(
+                    selection,
+                    &package,
+                    &sha256,
+                    index < administered,
+                    grants,
+                    managed,
+                )?;
+                Ok((refusal, package, source))
+            });
+            match verdict {
+                Ok((None, package, source)) => valid.push((selection, package, source)),
+                // Policy refusals apply on every reload: the user cannot repair them.
+                Ok((Some(reason), package, _)) => rejected.push(ModRejection {
+                    path: selection.path.clone(),
+                    id: Some(package.id),
+                    scope: selection.scope.clone(),
+                    reason,
+                }),
+                Err(error) => reject(
+                    initial,
+                    rejected,
+                    selection,
+                    inspected.as_deref(),
+                    error.to_string(),
+                )?,
+            }
+        }
+        let ranked = precedence(
+            &valid
+                .iter()
+                .map(|(selection, package, _)| (package.id.as_str(), *selection))
+                .collect::<Vec<_>>(),
+        );
+        let mut selected = BTreeMap::new();
+        for ((selection, package, source), loss) in valid.into_iter().zip(ranked) {
+            match loss {
+                None => {
+                    selected.insert(package.id.clone(), (selection.clone(), package, source));
+                }
+                Some(reason) if reason.starts_with("mod_conflict") => {
+                    reject(initial, rejected, selection, Some(&package.id), reason)?
+                }
+                Some(reason) => rejected.push(ModRejection {
+                    path: selection.path.clone(),
+                    id: Some(package.id),
+                    scope: selection.scope.clone(),
+                    reason,
+                }),
+            }
+        }
+        Ok(selected)
+    }
+
+    /// Every claimant of a contested slot is disabled; none silently wins.
+    fn resolve_conflicts(
+        next: &mut BTreeMap<String, Loaded>,
+        lenient: &dyn Fn(&str) -> bool,
+    ) -> Result<()> {
+        let mut tools: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        let mut points: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        let mut contracts: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, m)| m.error.is_none()) {
+            for tool in &loaded.registrations.tools {
+                tools
+                    .entry(format!("mod_{id}_{}", tool.name))
+                    .or_default()
+                    .push(id.clone());
+            }
+            for point in &loaded.registrations.replacements {
+                points.entry(point.clone()).or_default().push(id.clone());
+            }
+            for contract in &loaded.registrations.contracts {
+                contracts
+                    .entry(contract["id"].as_str().unwrap_or_default().to_owned())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        let contested = |kind: &'static str, claims: BTreeMap<String, Vec<String>>| {
+            claims
+                .into_iter()
+                .filter(|(_, ids)| ids.len() > 1)
+                .flat_map(move |(slot, ids)| {
+                    let reason = format!("{kind}: {slot} claimed by {}", ids.join(", "));
+                    ids.into_iter().map(move |id| (id, reason.clone()))
+                })
+                .collect::<Vec<_>>()
+        };
+        let mut conflicts = contested("tool_name_conflict", tools);
+        conflicts.extend(contested("replacement_conflict", points));
+        conflicts.extend(contested("contract_conflict", contracts));
+        if let Err(cycle) = chain::order(next) {
+            let reason = format!("interceptor_order_conflict: {}", cycle.join(", "));
+            conflicts.extend(cycle.into_iter().map(|id| (id, reason.clone())));
+        }
+        for (id, reason) in conflicts {
+            if let Some(loaded) = next.get_mut(&id) {
+                fail(lenient(&id), loaded, failure(reason))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn resolve_services(
+        next: &mut BTreeMap<String, Loaded>,
+        lenient: &dyn Fn(&str) -> bool,
+    ) -> Result<()> {
+        let mut claims: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, loaded)| loaded.error.is_none()) {
+            for contract in &loaded.registrations.services {
+                claims
+                    .entry(contract.name.clone())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        for (name, providers) in claims.iter().filter(|(_, providers)| providers.len() > 1) {
+            let reason = format!(
+                "service_provider_collision: {name} provided by {}",
+                providers.join(", ")
+            );
+            for provider in providers {
+                if let Some(loaded) = next.get_mut(provider) {
+                    fail(lenient(provider), loaded, failure(reason.clone()))?;
+                }
+            }
+        }
+        loop {
+            let providers: BTreeMap<String, (String, String)> = next
+                .iter()
+                .filter(|(_, loaded)| loaded.error.is_none())
+                .flat_map(|(id, loaded)| {
+                    loaded.registrations.services.iter().map(|contract| {
+                        (
+                            contract.name.clone(),
+                            (id.clone(), contract.version.clone()),
+                        )
+                    })
+                })
+                .collect();
+            let unavailable: Vec<_> = next
+                .iter()
+                .filter(|(_, loaded)| loaded.error.is_none())
+                .filter_map(|(id, loaded)| {
+                    loaded.package.services.imports.iter().find_map(|import| {
+                        match providers.get(&import.name) {
+                            Some((_, version))
+                                if service_version_satisfies(&import.version, version) =>
+                            {
+                                None
+                            }
+                            None if import.optional => None,
+                            Some((_, version)) => Some((
+                                id.clone(),
+                                format!(
+                                    "service_version_incompatible: consumer {id} requires {} {} but the active provider exports {}. Install a compatible provider/consumer pair; the consumer was not activated and the provider remains eligible.",
+                                    import.name, import.version, version,
+                                ),
+                            )),
+                            None => Some((
+                                id.clone(),
+                                format!(
+                                    "service_provider_missing: {} requires {}",
+                                    id, import.name
+                                ),
+                            )),
+                        }
+                    })
+                })
+                .collect();
+            if unavailable.is_empty() {
+                break;
+            }
+            for (id, reason) in unavailable {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(lenient(&id), loaded, failure(reason))?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn dependencies(id: &str, next: &BTreeMap<String, Loaded>) -> Vec<String> {
+        let Some(loaded) = next.get(id) else {
+            return Vec::new();
+        };
+        let providers: BTreeMap<&str, &str> = next
+            .iter()
+            .filter(|(_, candidate)| candidate.error.is_none())
+            .flat_map(|(provider, candidate)| {
+                candidate
+                    .registrations
+                    .services
+                    .iter()
+                    .map(move |contract| (contract.name.as_str(), provider.as_str()))
+            })
+            .collect();
+        let mut dependencies = loaded.package.requires.clone();
+        dependencies.extend(
+            loaded
+                .package
+                .dependencies
+                .iter()
+                .map(|dependency| dependency.id.clone()),
+        );
+        dependencies.extend(
+            loaded
+                .package
+                .services
+                .imports
+                .iter()
+                .filter_map(|import| providers.get(import.name.as_str()).copied())
+                .map(str::to_owned),
+        );
+        dependencies.sort();
+        dependencies.dedup();
+        dependencies
+    }
+
+    fn resolve_dependencies(
+        next: &mut BTreeMap<String, Loaded>,
+        lenient: &dyn Fn(&str) -> bool,
+    ) -> Result<Vec<String>> {
+        loop {
+            let unavailable: Vec<(String, String)> = next
+                .iter()
+                .filter(|(_, m)| m.error.is_none())
+                .filter_map(|(id, loaded)| {
+                    if let Some(dependency) = loaded.package.dependencies.iter().find(|dependency| {
+                        next.get(&dependency.id).is_some_and(|candidate| {
+                            candidate.error.is_none()
+                                && !service_version_satisfies(
+                                    &dependency.version,
+                                    &candidate.package.version,
+                                )
+                        })
+                    }) {
+                        let actual = &next[&dependency.id].package.version;
+                        return Some((
+                            id.clone(),
+                            format!(
+                                "dependency_version_incompatible: {id} requires {} {} but {} is active",
+                                dependency.id, dependency.version, actual
+                            ),
+                        ));
+                    }
+                    Self::dependencies(id, next)
+                        .iter()
+                        .find(|required| next.get(*required).is_none_or(|m| m.error.is_some()))
+                        .map(|required| {
+                            (
+                                id.clone(),
+                                format!("dependency_unavailable: {id} requires {required}"),
+                            )
+                        })
+                })
+                .collect();
+            if unavailable.is_empty() {
+                break;
+            }
+            for (id, reason) in unavailable {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(lenient(&id), loaded, failure(reason))?;
+                }
+            }
+        }
+        let mut remaining: BTreeSet<String> = next
+            .iter()
+            .filter(|(_, m)| m.error.is_none())
+            .map(|(id, _)| id.clone())
+            .collect();
+        let mut order = Vec::new();
+        while let Some(id) = remaining
+            .iter()
+            .find(|id| {
+                Self::dependencies(id, next)
+                    .iter()
+                    .all(|required| !remaining.contains(required))
+            })
+            .cloned()
+        {
+            remaining.remove(&id);
+            order.push(id);
+        }
+        if !remaining.is_empty() {
+            let reason = format!(
+                "dependency_cycle: {}",
+                remaining.iter().cloned().collect::<Vec<_>>().join(" -> ")
+            );
+            for id in remaining {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(lenient(&id), loaded, failure(reason.clone()))?;
+                }
+            }
+        }
+        Ok(order)
+    }
+
+    fn validate_registrations(package: &ModPackage, registrations: &Registrations) -> Result<()> {
+        let has = |cap: &str| package.capabilities.iter().any(|c| c == cap);
+        if registrations.tools.len() > 32
+            || registrations.commands.len() > 32
+            || registrations.events.len() > MOD_EVENTS.len()
+            || ((!registrations.tools.is_empty() || registrations.dynamic_tools) && !has("tools"))
+            || (!registrations.commands.is_empty() && !has("commands"))
+            || (!registrations.contracts.is_empty() && !has("contracts"))
+            || (!registrations.services.is_empty() && !has("services"))
+            || (!registrations.builtins.is_empty() && !has("builtins"))
+            || registrations.contracts.len() > 4
+            || registrations.builtins.len() > 1
+            || registrations.services.len() > 8
+            || registrations.components.len() > 16
+        {
+            return Err(failure("registration_limit_or_capability_denied"));
+        }
+        if registrations.services != package.services.exports {
+            return Err(failure(
+                "registered_service_contracts_do_not_match_manifest",
+            ));
+        }
+        resources::validate_registrations(package, &registrations.virtual_reads)?;
+        let triggers = registrations
+            .completions
+            .iter()
+            .map(|completion| completion.trigger.as_str())
+            .collect::<BTreeSet<_>>();
+        if !registrations.completions.is_empty()
+            && (!has("composer")
+                || registrations.completions.len() > 4
+                || triggers.len() != registrations.completions.len()
+                || !triggers.iter().all(|trigger| completion_trigger(trigger)))
+        {
+            return Err(failure("invalid_completion_registration"));
+        }
+        let mut contract_ids = BTreeSet::new();
+        for contract in &registrations.contracts {
+            let id = crate::ContractDocument::parse(contract)
+                .map_err(failure)?
+                .id;
+            if !contract_ids.insert(id) {
+                return Err(failure("invalid_or_duplicate_contract_registration"));
+            }
+        }
+        for controls in &registrations.builtins {
+            crate::BuiltinControls::parse(controls).map_err(failure)?;
+        }
+        let visible = |text: &str, limit: usize| {
+            !text.is_empty() && text.len() <= limit && !text.chars().any(char::is_control)
+        };
+        let mut names = BTreeSet::new();
+        for tool in &registrations.tools {
+            if !identifier(&tool.name)
+                || !names.insert(&tool.name)
+                || tool
+                    .label
+                    .as_deref()
+                    .is_some_and(|label| !visible(label, 64))
+                || tool.description.is_empty()
+                || tool.description.len() > 2048
+                || tool.parameters["type"] != "object"
+                || !tool.parameters["properties"].is_object()
+                || serde_json::to_vec(&tool.parameters)?.len() > 8192
+            {
+                return Err(failure("invalid_tool_registration"));
+            }
+        }
+        names.clear();
+        for agent in &registrations.agents {
+            if !has("agents")
+                || registrations.agents.len() > 8
+                || !identifier(&agent.name)
+                || agent.name.len() > 32
+                || !names.insert(&agent.name)
+                || !visible(&agent.description, 512)
+                || agent.instructions.trim().is_empty()
+                || agent.instructions.len() > 16_384
+                || agent
+                    .route
+                    .as_deref()
+                    .is_some_and(|route| !visible(route, 64))
+                || agent
+                    .effort
+                    .as_deref()
+                    .is_some_and(|effort| !crate::model_request::EFFORTS.contains(&effort))
+                || agent.tools.as_ref().is_some_and(|tools| {
+                    tools.len() > 32 || tools.iter().any(|tool| !visible(tool, 128))
+                })
+            {
+                return Err(failure("invalid_agent_registration"));
+            }
+        }
+        names.clear();
+        for command in &registrations.commands {
+            if let Some(cli) = &command.cli
+                && (!package
+                    .compatibility
+                    .required_features
+                    .iter()
+                    .any(|feature| feature == "plugin_dispatch_v1")
+                    || cli.is_empty()
+                    || cli.len() > 64
+                    || !cli.bytes().all(|byte| {
+                        byte.is_ascii_lowercase()
+                            || byte.is_ascii_digit()
+                            || matches!(byte, b'-' | b'_')
+                    }))
+            {
+                return Err(failure("cli_command_version_or_name_invalid"));
+            }
+            if !identifier(&command.name)
+                || !names.insert(&command.name)
+                || command
+                    .description
+                    .as_deref()
+                    .is_some_and(|description| !visible(description, 256))
+                || command
+                    .args_hint
+                    .as_deref()
+                    .is_some_and(|hint| !visible(hint, 64))
+            {
+                return Err(failure("command_conflict_or_invalid_description"));
+            }
+        }
+        names.clear();
+        for event in &registrations.events {
+            let capability = MOD_EVENTS
+                .iter()
+                .find(|(name, _)| name == event)
+                .map(|(_, capability)| *capability)
+                .ok_or_else(|| failure("unsupported_event"))?;
+            if !(has(capability) || event == "tool_result" && has("middleware"))
+                || !names.insert(event)
+            {
+                return Err(failure("event_capability_denied_or_conflict"));
+            }
+        }
+        if registrations.replacements.iter().any(|point| {
+            !MOD_REPLACEMENT_POINTS.contains(&point.as_str())
+                || !registrations.events.contains(point)
+        }) {
+            return Err(failure("invalid_replacement_point"));
+        }
+        chain::validate(&registrations.interceptors, &package.capabilities)
+    }
+
+    /// Inspects mods in id order, so registration order and conflicts resolve as if serial.
+    fn inspect_all(
+        inspections: Vec<(String, Loaded, Result<()>)>,
+        tool_validator: fn(&Value) -> Result<()>,
+        active: &dyn Fn() -> bool,
+    ) -> Result<BTreeMap<String, (Loaded, Result<Inspection>)>> {
+        let inspected = concurrently(inspections, active, |(id, loaded, ready), active| {
+            let inspection = ready.and_then(|()| Self::inspect(&loaded, tool_validator, active));
+            (id, (loaded, inspection))
+        });
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        Ok(inspected.into_iter().collect())
+    }
+
+    fn inspect(
+        loaded: &Loaded,
+        tool_validator: fn(&Value) -> Result<()>,
+        active: &dyn Fn() -> bool,
+    ) -> Result<Inspection> {
+        let reply = Self::run(loaded, "inspect", "", Value::Null, active)?;
+        if reply.state != loaded.state {
+            return Err(failure("state_write_during_registration"));
+        }
+        let registrations = reply
+            .registrations
+            .ok_or_else(|| failure("registrations_missing"))?;
+        Self::validate_registrations(&loaded.package, &registrations)?;
+        for tool in &registrations.tools {
+            tool_validator(&tool.parameters)?;
+        }
+        let (source_use, unused_grants, unused_environment) = cached_source_use(
+            &loaded.selection.sha256,
+            &loaded.package,
+            &registrations,
+            || {
+                let mut code = loaded.source.to_string();
+                for name in registrations
+                    .modules
+                    .iter()
+                    .filter(|name| !name.ends_with(".json"))
+                {
+                    if let Some(text) = loaded
+                        .assets
+                        .get(name)
+                        .and_then(|asset| asset["text"].as_str())
+                    {
+                        code.push('\n');
+                        code.push_str(text);
+                    }
+                }
+                code
+            },
+        )?;
+        Ok((
+            Registered::new(registrations)?,
+            source_use,
+            unused_grants,
+            unused_environment,
+        ))
+    }
+
+    fn run(
+        loaded: &Loaded,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: &dyn Fn() -> bool,
+    ) -> Result<Reply> {
+        bridge::run(
+            loaded,
+            event,
+            name,
+            payload,
+            &[],
+            active,
+            &mut |_| {
+                Err(failure(
+                    "host_operation_unavailable: requires a native task",
+                ))
+            },
+            &mut |_| {},
+            None,
+            &InvocationScope::default(),
+        )
+    }
+
+    pub fn invoke(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        options: ModInvokeOptions<'_>,
+    ) -> Result<Value> {
+        invoke_with_options(
+            &mut Access::Held(self),
+            id,
+            generation,
+            event,
+            name,
+            payload,
+            options,
+        )
+    }
+
+    /// Between broker refreshes a passed check stands until `mods.json` or the authority inventory changes.
+    fn check_callback_authority(&mut self, loaded: &Loaded) -> Result<()> {
+        let key = (
+            loaded.package.id.clone(),
+            loaded.selection.path.clone(),
+            loaded.selection.scope.clone(),
+        );
+        let modified = configuration_stamp(&self.store.root.join("mods.json"));
+        let grant = store::grant(&json!(loaded.selection));
+        if let Some((at, stamp, sha256, granted)) = self.callback_verdicts.get(&key)
+            && modified.is_some()
+            && self.fresh_broker() == Some(*at)
+            && *stamp == modified
+            && *sha256 == self.configuration_sha256
+            && *granted == grant
+        {
+            return Ok(());
+        }
+        self.check_callback_authority_now(loaded)?;
+        if self.configuration_stamp.is_some()
+            && let Some(at) = self.fresh_broker()
+        {
+            self.callback_verdicts.insert(
+                key,
+                (at, modified, self.configuration_sha256.clone(), grant),
+            );
+        }
+        Ok(())
+    }
+
+    fn fresh_broker(&self) -> Option<Instant> {
+        self.brokered
+            .as_ref()
+            .filter(|(at, _, _)| at.elapsed() < BROKER_REFRESH)
+            .map(|(at, _, _)| *at)
+    }
+
+    fn check_callback_authority_now(&mut self, loaded: &Loaded) -> Result<()> {
+        let (configuration_sha256, configuration) = self.callback_configuration();
+        let authority = self.authority(&configuration_sha256)?;
+        let hash = self.authority_hash(&configuration_sha256, &authority);
+        let (brokered, managed, deployment) = authority;
+        let mut selections = match &managed {
+            Some(managed) => {
+                managed
+                    .selections(
+                        &deployment.unwrap_or_default(),
+                        &self.store.managed_user(),
+                        self.project.as_deref(),
+                    )
+                    .0
+            }
+            None => Vec::new(),
+        };
+        let mut administered = selections.len();
+        let configured = self
+            .tier_selections
+            .get(&loaded.package.id)
+            .unwrap_or(&loaded.selection);
+        // An unchanged authority inventory cannot introduce a different precedence winner.
+        let unchanged = hash == self.configuration_sha256;
+        if !unchanged {
+            self.configuration_stamp = None;
+        }
+        match configuration {
+            Ok(config) if config.schema == 1 => selections.extend(
+                config
+                    .mods
+                    .iter()
+                    .filter(|selection| !unchanged || selection.path == loaded.selection.path)
+                    .cloned(),
+            ),
+            _ if configured.scope == MANAGED_SCOPE && managed.is_some() => (),
+            _ => return Err(failure("callback_authority_changed")),
+        }
+        if unchanged {
+            administered = selections
+                .iter()
+                .take(administered)
+                .filter(|selection| selection.path == loaded.selection.path)
+                .count();
+            selections.retain(|selection| selection.path == loaded.selection.path);
+        }
+        let selected = Self::select(
+            &selections,
+            administered,
+            false,
+            brokered.as_ref().map(|(_, grants)| grants),
+            managed.as_ref().map(|managed| &managed.policy),
+            &mut Vec::new(),
+            |path| {
+                store::verified_package(path).map(|(package, hash)| (package, String::new(), hash))
+            },
+        )?;
+        let Some((selection, _, _)) = selected.get(&loaded.package.id) else {
+            return Err(failure("callback_authority_changed"));
+        };
+        if selection.path != configured.path
+            || selection.scope != configured.scope
+            || store::grant(&json!(selection)) != store::grant(&json!(configured))
+        {
+            return Err(failure("callback_authority_changed"));
+        }
+        Ok(())
+    }
+
+    fn callback_configuration(&self) -> (String, Result<Arc<ModConfiguration>>) {
+        let path = self.store.root.join("mods.json");
+        let stamp = configuration_stamps(&self.store.root);
+        let mut cached = self
+            .callback_configuration
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let (Some(stamp), Some((cached_stamp, sha256, configuration))) =
+            (&stamp, cached.as_ref())
+            && stamp == cached_stamp
+        {
+            return (sha256.clone(), Ok(configuration.clone()));
+        }
+        let (stamp, sha256, bytes) = read_configuration(&self.store.root, stamp);
+        let configuration = bytes
+            .and_then(|bytes| ModConfiguration::parse(&bytes, &path))
+            .map(Arc::new);
+        *cached = stamp
+            .zip(configuration.as_ref().ok())
+            .map(|(stamp, configuration)| (stamp, sha256.clone(), configuration.clone()));
+        (sha256, configuration)
+    }
+
+    fn begin(
+        &mut self,
+        id: &str,
+        generation: u64,
+        active: &dyn Fn() -> bool,
+        thread: Option<&str>,
+    ) -> Result<Invocation> {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        if generation != self.generation {
+            return Err(failure("stale_mod_generation: retry on the next turn"));
+        }
+        let Some(mut loaded) = self.loaded.get_mut(id).map(Loaded::invocation) else {
+            return Err(
+                match self
+                    .rejected
+                    .iter()
+                    .find(|rejection| rejection.id.as_deref() == Some(id))
+                {
+                    Some(rejection) => failure(format!("mod_disabled: {}", rejection.reason)),
+                    None => failure("mod_disabled"),
+                },
+            );
+        };
+        if let Some(error) = &loaded.error {
+            return Err(failure(format!("mod_failed: {error}")));
+        }
+        self.check_callback_authority(&loaded)?;
+        loaded.session_key = self.session_key(id, thread)?;
+        let location = self.state_location(&loaded.package, &loaded.selection.scope, thread);
+        let mut migrate = false;
+        loaded.state = match self
+            .store
+            .scoped_state(&location, loaded.package.state_version)
+        {
+            Err(error) if packages::migratable(&loaded, &location, &error) => {
+                migrate = true;
+                Value::Null
+            }
+            state => state?,
+        };
+        let key = self.ui_key(&loaded, thread);
+        if loaded
+            .ui
+            .as_ref()
+            .is_none_or(|(previous, _)| previous != &key)
+        {
+            let mut states = UI_STATES
+                .lock()
+                .map_err(|_| failure("ui_state_unavailable"))?;
+            states.retain(|_, state| state.strong_count() > 0);
+            let state = states
+                .get(&key)
+                .and_then(std::sync::Weak::upgrade)
+                .unwrap_or_default();
+            states.insert(key.clone(), Arc::downgrade(&state));
+            loaded.ui = Some((key, state));
+            self.loaded
+                .get_mut(id)
+                .ok_or_else(|| failure("mod_disabled"))?
+                .ui = loaded.ui.clone();
+        }
+        if let Some((_, state)) = &loaded.ui {
+            let state = state.lock().map_err(|_| failure("ui_state_unavailable"))?;
+            loaded.ui_state = state.value.clone();
+            loaded.ui_revision = state.revision;
+            loaded.ui_clears = state.clears;
+        }
+        Ok(Invocation {
+            authority_current: loaded.selection.authority_current(),
+            location,
+            thread: thread.map(str::to_owned),
+            dynamic: self
+                .dynamic_tools
+                .get(id)
+                .into_iter()
+                .flatten()
+                .map(|tool| tool.name.clone())
+                .collect(),
+            loaded,
+            virtual_time_ms: self.virtual_time_ms,
+            started: Instant::now(),
+            migrate,
+            rethrown: false,
+        })
+    }
+
+    fn accept(
+        &mut self,
+        loaded: &Loaded,
+        location: &store::StateLocation,
+        thread: Option<&str>,
+        event: &str,
+        reply: Reply,
+        active: &dyn Fn() -> bool,
+    ) -> Result<(Value, Value)> {
+        let ui_state = validate_ui_state(reply.ui_state.as_deref().unwrap_or("null"))?;
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        let mut ui = loaded
+            .ui
+            .as_ref()
+            .map(|(_, state)| state.lock())
+            .transpose()
+            .map_err(|_| failure("ui_state_unavailable"))?;
+        let current = self.loaded.get(&loaded.package.id);
+        let rebind = loaded
+            .ui
+            .as_ref()
+            .zip(current)
+            .is_some_and(|((key, _), current)| {
+                current.ui.is_none() && key == &self.ui_key(current, thread)
+            });
+        if reply.ui_read {
+            if !rebind
+                && current
+                    .and_then(|current| current.ui.as_ref())
+                    .zip(loaded.ui.as_ref())
+                    .is_none_or(|((_, current), (_, prior))| !Arc::ptr_eq(current, prior))
+            {
+                return Err(failure("callback_cancelled"));
+            }
+            if !loaded
+                .package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "terminal")
+            {
+                return Err(failure("ui_state_capability_denied"));
+            }
+            if ui.as_ref().is_none_or(|state| {
+                state.revision.wrapping_sub(loaded.ui_revision)
+                    != state.clears.wrapping_sub(loaded.ui_clears)
+            }) {
+                return Err(failure("state_conflict: ui revision changed"));
+            }
+        }
+        if ui_state != loaded.ui_state
+            && (!reply.ui_read || !matches!(event, "command" | "component_event"))
+        {
+            return Err(failure("ui_state_write_unavailable"));
+        }
+        let mut parsed_command = None;
+        if event == "command"
+            && let Some(patch) = reply.value.get("terminal")
+        {
+            if !loaded
+                .package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "terminal")
+            {
+                return Err(failure("terminal_capability_denied"));
+            }
+            if !patch.is_null() {
+                parsed_command = Some(Arc::new(ModViewPatch::parse(patch.clone())?));
+            }
+        }
+        let replaces = |point: &str| {
+            loaded
+                .registrations
+                .replacements
+                .iter()
+                .any(|registered| registered == point)
+        };
+        if matches!(event, "routing" | "compaction") && !reply.value.is_null() && !replaces(event) {
+            return Err(failure("exclusive_replacement_registration_required"));
+        }
+        if event == "context" && !reply.value.is_null() {
+            let text = reply
+                .value
+                .get("text")
+                .and_then(Value::as_str)
+                .ok_or_else(|| failure("invalid_context_result"))?;
+            if text.len() > 1024 {
+                return Err(failure("context_limit"));
+            }
+        }
+        if event == "routing" && !reply.value.is_null() {
+            let valid = reply.value.as_object().is_some_and(|object| {
+                object.len() == 1
+                    && object
+                        .get("route")
+                        .and_then(Value::as_str)
+                        .is_some_and(crate::resource_data::token)
+            });
+            if !valid {
+                return Err(failure("invalid_routing_result"));
+            }
+        }
+        if matches!(
+            event,
+            "prompt" | "session" | "agent" | "tool_call" | "tool_result" | "host_operation"
+        ) && !reply.value.is_null()
+        {
+            return Err(failure("observe_only_event_returned_a_value"));
+        }
+        if reply.state != loaded.state {
+            if !loaded.package.capabilities.iter().any(|c| c == "store") {
+                return Err(failure("state_capability_denied"));
+            }
+            self.store.write_scoped_state(
+                location,
+                loaded.package.state_version,
+                &loaded.state,
+                &reply.state,
+            )?;
+        }
+        if let Some(state) = ui.as_mut()
+            && (ui_state != loaded.ui_state || reply.ui_written && ui_state != state.value)
+        {
+            state.value = ui_state;
+            state.revision = state.revision.wrapping_add(1);
+        }
+        if rebind
+            && reply.ui_read
+            && let Some(current) = self.loaded.get_mut(&loaded.package.id)
+        {
+            current.ui = loaded.ui.clone();
+        }
+        if event == "command"
+            && let Some(patch) = reply.value.get("terminal")
+        {
+            let stamp = Self::terminal_stamp(
+                loaded,
+                &reply.state,
+                loaded
+                    .ui
+                    .as_ref()
+                    .map(|(scope, _)| scope.as_str())
+                    .zip(ui.as_ref().map(|state| &state.value)),
+            );
+            if let Some(current) = self.loaded.get_mut(&loaded.package.id) {
+                current.command_view = Some(AcceptedCommandView {
+                    value: patch.clone(),
+                    stamp,
+                    parsed: parsed_command,
+                });
+            }
+        }
+        if event == "terminal" {
+            if reply.clock_read {
+                self.clock_reads.insert(loaded.package.id.clone());
+            } else {
+                self.clock_reads.remove(&loaded.package.id);
+            }
+        }
+        Ok((reply.value, reply.state))
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn finish(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        invocation: Invocation,
+        reply: Result<Reply>,
+        active: &dyn Fn() -> bool,
+    ) -> Result<Value> {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        // A reload that keeps this package binding (such as the callback's own `packages.apply`) must not discard a result whose host calls already ran.
+        let thread = invocation.thread.as_deref();
+        if generation != self.generation
+            && self.loaded.get(id).is_none_or(|current| {
+                self.ui_key(current, thread) != self.ui_key(&invocation.loaded, thread)
+            })
+        {
+            return Err(failure("stale_mod_generation: retry on the next turn"));
+        }
+        self.check_callback_authority(&invocation.loaded)?;
+        if invocation.authority_current
+            && !invocation.loaded.selection.authority_current()
+            && invocation
+                .loaded
+                .package
+                .capabilities
+                .iter()
+                .any(|cap| AUTHORITY_CAPABILITIES.contains(&cap.as_str()))
+        {
+            return Err(failure("callback_authority_changed"));
+        }
+        let result = reply.and_then(|reply| {
+            self.accept(
+                &invocation.loaded,
+                &invocation.location,
+                invocation.thread.as_deref(),
+                event,
+                reply,
+                active,
+            )
+        });
+        let (started, previous_state, rethrown) = (
+            invocation.started,
+            invocation.loaded.state,
+            invocation.rethrown,
+        );
+        let current = self
+            .loaded
+            .get_mut(id)
+            .ok_or_else(|| failure("mod_disabled"))?;
+        let elapsed = started.elapsed().as_micros();
+        match result {
+            Ok((value, state)) => {
+                current
+                    .telemetry
+                    .record(self.generation, event, name, elapsed, "ok");
+                current.telemetry.faults = 0;
+                if state != previous_state {
+                    current.set_state(state);
+                }
+                Ok(value)
+            }
+            Err(error) => {
+                current
+                    .telemetry
+                    .record(self.generation, event, name, elapsed, "error");
+                let message = error.to_string();
+                if ![
+                    "state_conflict",
+                    "state_thread_unavailable",
+                    "state_checkout_unavailable",
+                    "callback_cancelled",
+                    "host_receipt_limit",
+                    "host_result_limit",
+                    "host_call_limit",
+                    "callback_execution_budget",
+                ]
+                .iter()
+                .any(|transient| message.trim_start_matches("Error: ").starts_with(transient))
+                    && !matches!(event, "service" | "component")
+                    && !rethrown
+                {
+                    current.fault(message);
+                }
+                Err(error)
+            }
+        }
+    }
+
+    fn event_except(
+        &mut self,
+        event: &str,
+        payload: Value,
+        excluded: &str,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+    ) -> Vec<(String, Result<Value>)> {
+        let ids: Vec<_> = self
+            .active()
+            .filter(|(id, loaded)| {
+                id.as_str() != excluded
+                    && !scope.contains(id)
+                    && loaded
+                        .registrations
+                        .events
+                        .iter()
+                        .any(|registered| registered == event)
+            })
+            .map(|(id, _)| id.clone())
+            .collect();
+        let generation = self.generation;
+        ids.into_iter()
+            .map(|id| {
+                let result = invoke(
+                    &mut Access::Held(self),
+                    &id,
+                    generation,
+                    event,
+                    "",
+                    payload.clone(),
+                    active,
+                    &mut |_, _| Err(failure("observer_host_operation_unavailable")),
+                    &mut |_| {},
+                    scope,
+                    None,
+                );
+                (id, result)
+            })
+            .collect()
+    }
+
+    fn call_service(
+        &mut self,
+        caller: &str,
+        generation: u64,
+        arguments: Value,
+        active: &dyn Fn() -> bool,
+        host: &mut dyn FnMut(&str, ModHostCall) -> Result<Value>,
+        scope: &InvocationScope,
+    ) -> Result<Value> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct ServiceCall {
+            name: String,
+            method: String,
+            input: Value,
+        }
+        let call: ServiceCall = serde_json::from_value(arguments)?;
+        if serde_json::to_vec(&call.input)?.len() > 32_768 {
+            return Err(failure("service_input_limit"));
+        }
+        let consumer = self
+            .loaded
+            .get(caller)
+            .ok_or_else(|| failure("mod_disabled"))?;
+        let import = consumer
+            .package
+            .services
+            .imports
+            .iter()
+            .find(|import| import.name == call.name)
+            .ok_or_else(|| failure("undeclared_service_use"))?;
+        let provider = self.active().find_map(|(id, loaded)| {
+            loaded
+                .registrations
+                .services
+                .iter()
+                .find(|contract| contract.name == call.name)
+                .map(|contract| (id.clone(), contract.clone()))
+        });
+        let Some((provider, contract)) = provider else {
+            return Err(failure(if import.optional {
+                "optional_service_unavailable"
+            } else {
+                "service_provider_missing"
+            }));
+        };
+        if provider == caller {
+            return Err(failure(format!("service_self_import: {}", call.name)));
+        }
+        if !service_version_satisfies(&import.version, &contract.version) {
+            return Err(failure(format!(
+                "service_version_incompatible: consumer {caller} requires {} {} but provider {provider} exports {}",
+                call.name, import.version, contract.version
+            )));
+        }
+        let method = contract
+            .methods
+            .get(&call.method)
+            .ok_or_else(|| failure("unknown_service_method"))?;
+        validate_service_value(&call.input, &method.input)?;
+        let qualified = format!("{}.{}", call.name, call.method);
+        let result = invoke(
+            &mut Access::Held(self),
+            &provider,
+            generation,
+            "service",
+            &qualified,
+            call.input,
+            active,
+            host,
+            &mut |_| {},
+            scope,
+            None,
+        )?;
+        validate_service_value(&result, &method.output)?;
+        if serde_json::to_vec(&result)?.len() > 32_768 {
+            return Err(failure("service_output_limit"));
+        }
+        self.service_calls.push(
+            json!({"caller":caller,"provider":provider,"service":call.name,
+            "version":contract.version,"method":call.method,"generation":generation}),
+        );
+        if self.service_calls.len() > 64 {
+            self.service_calls.remove(0);
+        }
+        Ok(result)
+    }
+
+    pub fn history(
+        &mut self,
+        payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Option<(String, Value)>> {
+        let Some(owner) = self.replacement_owner("history") else {
+            return Ok(None);
+        };
+        let value = self.invoke(
+            &owner,
+            self.generation,
+            "history",
+            "",
+            payload,
+            ModInvokeOptions {
+                active: &active,
+                ..ModInvokeOptions::default()
+            },
+        )?;
+        Ok((!value.is_null()).then_some((owner, value)))
+    }
+
+    fn event_ids(&self, event: &str) -> Vec<String> {
+        self.active()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .events
+                    .iter()
+                    .any(|registered| registered == event)
+            })
+            .map(|(id, _)| id.clone())
+            .collect()
+    }
+
+    pub fn has_event(&self, event: &str) -> bool {
+        self.active().any(|(_, loaded)| {
+            loaded
+                .registrations
+                .events
+                .iter()
+                .any(|registered| registered == event)
+        })
+    }
+
+    pub fn event(
+        &mut self,
+        event: &str,
+        payload: Value,
+        mut options: ModInvokeOptions<'_>,
+    ) -> Vec<(String, Result<Value>)> {
+        let ids = self.event_ids(event);
+        ids.into_iter()
+            .map(|id| {
+                let result = self.invoke(
+                    &id,
+                    self.generation,
+                    event,
+                    "",
+                    payload.clone(),
+                    options.reborrow(),
+                );
+                (id, result)
+            })
+            .collect()
+    }
+
+    pub fn subscribers_with_capability(&self, event: &str, capability: &str) -> Vec<String> {
+        self.active()
+            .filter(|(_, loaded)| {
+                loaded
+                    .package
+                    .capabilities
+                    .iter()
+                    .any(|cap| cap == capability)
+                    && loaded.registrations.events.iter().any(|name| name == event)
+            })
+            .map(|(id, _)| id.clone())
+            .collect()
+    }
+
+    pub fn subscriptions(&self) -> Vec<(String, ModSubscriptions)> {
+        self.active()
+            .filter(|(_, loaded)| !loaded.package.subscriptions.is_empty())
+            .map(|(id, loaded)| (id.clone(), loaded.package.subscriptions.clone()))
+            .collect()
+    }
+
+    pub fn uses_operation(&self, operation: &str) -> bool {
+        self.active().any(|(_, loaded)| {
+            loaded
+                .source_use
+                .operations
+                .iter()
+                .any(|used| used == operation)
+        })
+    }
+
+    fn ui_key(&self, loaded: &Loaded, thread: Option<&str>) -> String {
+        let mut selection = json!(loaded.selection);
+        if let Some(selection) = selection.as_object_mut() {
+            selection.remove("settings");
+        }
+        format!(
+            "{}:{}",
+            self.store.root.display(),
+            crate::sha256_hex(
+                json!([
+                    self.project,
+                    thread,
+                    selection,
+                    loaded.adapter.as_ref().map(|adapter| &adapter.sha256)
+                ])
+                .to_string()
+                .as_bytes()
+            )
+        )
+    }
+
+    fn terminal_stamp(loaded: &Loaded, state: &Value, ui: Option<(&str, &Value)>) -> String {
+        crate::sha256_hex(
+            json!([
+                loaded.selection.sha256,
+                loaded.selection.settings,
+                state,
+                ui.map(|(scope, _)| scope),
+                ui.map(|(_, value)| value)
+            ])
+            .to_string()
+            .as_bytes(),
+        )
+    }
+
+    fn terminal_state_key(&self, id: &str, thread: Option<&str>) -> Option<String> {
+        let loaded = self.loaded.get(id)?;
+        let scope = self.ui_key(loaded, thread);
+        let ui = match &loaded.ui {
+            Some((current, state)) if current == &scope => Some(state.clone()),
+            _ => UI_STATES
+                .lock()
+                .ok()?
+                .get(&scope)
+                .and_then(std::sync::Weak::upgrade),
+        };
+        let ui = match ui {
+            Some(state) => state.lock().ok()?.value.clone(),
+            None => Value::Null,
+        };
+        let location = self.state_location(&loaded.package, &loaded.selection.scope, thread);
+        let state = self
+            .store
+            .scoped_state(&location, loaded.package.state_version)
+            .ok()?;
+        Some(Self::terminal_stamp(loaded, &state, Some((&scope, &ui))))
+    }
+
+    pub fn terminal_view(&mut self, payload: Value, active: impl Fn() -> bool) -> ModTerminalView {
+        let thread = state_thread(&payload);
+        let payload = TerminalPayload::new(payload);
+        let generation = self.generation;
+        let mut results = Vec::new();
+        let mut stale = Vec::new();
+        for id in self.event_ids("terminal") {
+            if thread.is_none()
+                && self
+                    .loaded
+                    .get(&id)
+                    .is_some_and(|loaded| loaded.package.state_scope == "thread")
+            {
+                continue;
+            }
+            let own = payload.own(&id);
+            let key = self
+                .terminal_state_key(&id, thread.as_deref())
+                .map(|stamp| format!("{stamp}:{}", payload.key(&own)));
+            // A handler that read the clock is rerun once its result is a second old.
+            if let (Some(key), Some((cached, value, clock))) = (&key, self.renders.get(&id))
+                && key == cached
+                && clock.is_none_or(|at| at.elapsed() < Duration::from_secs(1))
+            {
+                results.push((id, Some(Ok(value.clone()))));
+                continue;
+            }
+            let begun = self.begin(&id, generation, &active, thread.as_deref());
+            stale.push((results.len(), key, begun, own));
+            results.push((id, None));
+        }
+        // Terminal handlers make no host calls, so their runners work in parallel.
+        let payload = &payload;
+        let replies = concurrently(stale, &active, |(index, key, begun, own), active| {
+            let reply = begun.and_then(|mut invocation| {
+                if invocation.migrate {
+                    invocation.loaded.state =
+                        packages::migrate_state(&invocation.loaded, &invocation.location, active)?;
+                }
+                let reply = registered_call(&invocation.loaded, &invocation.dynamic, "terminal", "")
+                    .and_then(|()| {
+                        bridge::run(
+                            &invocation.loaded,
+                            "terminal",
+                            "",
+                            payload.payload(own),
+                            &[],
+                            active,
+                            &mut |call| {
+                                Err(failure(match call.operation.as_str() {
+                                    "time.sleep" => "host_operation_unavailable: time.sleep is not available during terminal",
+                                    _ => "host_operation_unavailable: requires a native task",
+                                }))
+                            },
+                            &mut |_| {},
+                            Some(invocation.virtual_time_ms.unwrap_or_else(crate::peers::now_ms)),
+                            &InvocationScope::default(),
+                        )
+                    });
+                Ok((invocation, reply))
+            });
+            (index, key, reply)
+        });
+        for (index, key, reply) in replies {
+            let id = results[index].0.clone();
+            let result = match reply {
+                Ok((invocation, reply)) => {
+                    match self.finish(&id, generation, "terminal", "", invocation, reply, &active) {
+                        Err(error) if error.to_string().starts_with("state_conflict") => self
+                            .invoke(
+                                &id,
+                                generation,
+                                "terminal",
+                                "",
+                                payload.payload(payload.own(&id)),
+                                ModInvokeOptions {
+                                    active: &active,
+                                    ..ModInvokeOptions::default()
+                                },
+                            ),
+                        result => result,
+                    }
+                }
+                Err(error) => Err(error),
+            };
+            match (&result, key) {
+                (Ok(value), Some(key)) => {
+                    let clock = self.clock_reads.contains(&id).then(Instant::now);
+                    self.renders.insert(id.clone(), (key, value.clone(), clock));
+                }
+                _ => {
+                    self.renders.remove(&id);
+                }
+            }
+            results[index].1 = Some(result);
+        }
+        let results: Vec<_> = results
+            .into_iter()
+            .map(|(id, result)| {
+                (
+                    id,
+                    result.unwrap_or_else(|| Err(failure("callback_cancelled"))),
+                )
+            })
+            .collect();
+        let origin = payload.shared["event"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        self.compose_terminal(results, &origin, None)
+    }
+
+    pub fn command_view(
+        &mut self,
+        id: &str,
+        generation: u64,
+        patch: Value,
+        payload: &Value,
+    ) -> Result<ModTerminalView> {
+        if generation != self.generation
+            || !self.active().any(|(owner, loaded)| {
+                owner == id
+                    && loaded
+                        .package
+                        .capabilities
+                        .iter()
+                        .any(|capability| capability == "terminal")
+            })
+        {
+            return Err(failure("terminal_owner_unavailable"));
+        }
+        let stamp = self.terminal_state_key(id, state_thread(payload).as_deref());
+        let accepted = self
+            .loaded
+            .get(id)
+            .and_then(|loaded| loaded.command_view.as_ref())
+            .filter(|accepted| accepted.value == patch && Some(&accepted.stamp) == stamp.as_ref());
+        let matched = accepted.is_some();
+        let validated = accepted
+            .and_then(|accepted| accepted.parsed.as_ref())
+            .map(|parsed| parsed.as_ref().clone());
+        let parsed = if patch.is_null() {
+            self.valid_views.remove(id);
+            None
+        } else {
+            let parsed = validated
+                .map(Ok)
+                .unwrap_or_else(|| ModViewPatch::parse(patch.clone()))?;
+            self.valid_views.insert(id.to_owned(), patch.clone());
+            Some((id, parsed))
+        };
+        self.renders.remove(id);
+        // A command's result stands in for the `terminal` handler for a second, like a clock read.
+        if matched && let Some(stamp) = stamp {
+            let payload = TerminalPayload::new(payload.clone());
+            let key = format!("{stamp}:{}", payload.key(&payload.own(id)));
+            self.renders
+                .insert(id.to_owned(), (key, patch, Some(Instant::now())));
+        }
+        let results = self
+            .active()
+            .map(|(owner, _)| {
+                (
+                    owner.clone(),
+                    Ok(self.valid_views.get(owner).cloned().unwrap_or(Value::Null)),
+                )
+            })
+            .collect();
+        Ok(self.compose_terminal(results, "command", parsed))
+    }
+
+    fn compose_terminal(
+        &mut self,
+        results: Vec<(String, Result<Value>)>,
+        origin: &str,
+        mut accepted_patch: Option<(&str, ModViewPatch)>,
+    ) -> ModTerminalView {
+        let mut view = ModView::default();
+        let mut claims = BTreeMap::new();
+        let mut component_owners = BTreeMap::new();
+        let mut contributors = Vec::new();
+        let mut conflicts = Vec::new();
+        let mut diagnostics = Vec::new();
+        let mut hiding_welcome = BTreeMap::new();
+        for (id, result) in results {
+            if let Some(error) = self
+                .loaded
+                .get(&id)
+                .and_then(|loaded| loaded.settings_file.error.as_ref())
+            {
+                diagnostics.push(format!("{id}: settings_file_invalid: {error}"));
+            }
+            let parsed = match result {
+                Ok(value) if value.is_null() => {
+                    self.valid_views.remove(&id);
+                    continue;
+                }
+                Ok(value) => match accepted_patch.take_if(|(owner, _)| *owner == id) {
+                    Some((_, patch)) => Ok(patch),
+                    None => ModViewPatch::parse(value.clone()).inspect(|_| {
+                        self.valid_views.insert(id.clone(), value);
+                    }),
+                },
+                Err(error) => Err(error),
+            };
+            let parsed = parsed.or_else(|error| {
+                // Interrupted turns cancel in-flight renders and selection changes reject them until reload; the last view stands.
+                let error_text = error.to_string();
+                if ![
+                    "callback_cancelled",
+                    "callback_authority_changed",
+                    "stale_mod_generation",
+                ]
+                .iter()
+                .any(|transient| error_text.contains(transient))
+                {
+                    diagnostics.push(format!("{id}: {error}"));
+                }
+                ModViewPatch::parse(self.valid_views.get(&id).cloned().ok_or(error)?)
+            });
+            let Ok(mut patch) = parsed else {
+                continue;
+            };
+            if self.ui_mods.as_ref().is_some_and(|ids| !ids.contains(&id)) {
+                patch.drop_persistent_ui();
+            }
+            if view.sites.get("dialog").is_some_and(|dialog| {
+                dialog.mode == ModSiteMode::Replace && !dialog.components.is_empty()
+            }) {
+                patch.sites.remove("dialog");
+            }
+            let before = view::site_component_ids(&view.sites);
+            let hides = patch
+                .welcome
+                .as_ref()
+                .filter(|welcome| welcome.hidden)
+                .map(|welcome| welcome.show_while_composing);
+            match patch.apply(&mut view, &mut claims, &id, origin) {
+                Ok(lost) => {
+                    conflicts.extend(lost);
+                    if let Some(composing) = hides {
+                        hiding_welcome.insert(id.clone(), composing);
+                    }
+                    for component in view::site_component_ids(&view.sites) {
+                        if !before.contains(&component) {
+                            component_owners
+                                .entry(component)
+                                .or_insert_with(|| id.clone());
+                        }
+                    }
+                    contributors.push(id);
+                }
+                Err(error) => diagnostics.push(format!("{id}: {error}")),
+            }
+        }
+        view.close_wraps();
+        if let Some(underlay) = &view.underlay
+            && let Some(owner) = claims.get("underlay")
+        {
+            match component_owners.get(&underlay.raster) {
+                Some(drawer) if drawer != owner => {
+                    conflicts.push(ModViewConflict {
+                        field: "underlay".to_owned(),
+                        owner: drawer.clone(),
+                        rejected: owner.clone(),
+                        origin: origin.to_owned(),
+                    });
+                    view.underlay = None;
+                }
+                _ => {
+                    component_owners.insert(underlay.raster.clone(), owner.clone());
+                }
+            }
+        }
+        // Only the underlay's owner hides the welcome: a refused underlay brings it back and a later writer can't undo it.
+        let hider = view
+            .underlay
+            .as_ref()
+            .and(claims.get("underlay"))
+            .and_then(|owner| hiding_welcome.get(owner).copied());
+        if let Some(welcome) = view.welcome.as_mut() {
+            welcome.hidden = hider.is_some();
+            welcome.show_while_composing |= hider.unwrap_or_default();
+        }
+        conflicts.truncate(32);
+        ModTerminalView {
+            layout_owner: view.layout.as_ref().and(claims.remove("layout")),
+            view,
+            contributors,
+            component_owners,
+            conflicts,
+            diagnostics,
+        }
+    }
