+    let before = fs::read_to_string(&path).unwrap();
+    let mut meta: Value = serde_json::from_str(before.lines().next().unwrap()).unwrap();
+    meta["payload"]["memory_mode"] = json!("disabled");
+    fs::write(&path, format!("{before}{meta}\n")).unwrap();
+    assert_eq!(
