+#[serial_test::serial]
+fn thread_view_events_initialize_each_context_and_drop_obsolete_delivery() {
+    struct Restore(Option<State>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            *STATE.locked() = self.0.take();
+        }
+    }
+    let _restore = Restore(STATE.locked().take());
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let package = root.join("thread_view_fixture");
+    std::fs::create_dir(&package).unwrap();
+    let capabilities = vec!["terminal".to_owned(), "store".into(), "events".into()];
+    std::fs::write(
+        package.join("mod.json"),
+        json!({"schema":1,"id":"thread_view_fixture","version":"1.0.0",
+            "api":codex_omd::MOD_API_VERSION,"state_version":1,"state_scope":"thread",
+            "capabilities":capabilities})
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        package.join("index.ts"),
+        "export default api => { api.on('view', event => { const count = Number(api.state.get() ?? 0)+1; api.state.set(count); api.host.call('events.publish', {channel:'seen',data:{event,count}}); }); api.on('focus', () => { api.host.call('events.publish', {channel:'seen',data:{barrier:true}}); }); };",
+    )
+    .unwrap();
+    let data = root.join("store");
+    let store = codex_omd::ModStore::create(data.clone()).unwrap();
+    let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+    store
+        .trust(
+            package.clone(),
+            inspected["sha256"].as_str().unwrap(),
+            capabilities,
+            "user",
+        )
+        .unwrap();
+    store.enable(&package, true).unwrap();
+    std::fs::write(
+        data.join("mod-status.json"),
+        serde_json::to_vec(
+            &codex_omd::ModHost::open(data.clone(), ModOpenOptions::default())
+                .unwrap()
+                .status(),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    let _environment = crate::omd::tests::omd_environment(&data);
+    let _host = crate::mod_runtime::test_fresh_host();
+    let observer = "thread_view_observer";
+    codex_omd::event_bus::global()
+        .lock()
+        .unwrap()
+        .subscribe(observer, vec!["thread_view_fixture/seen".into()]);
+    let receive = || {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let mut events = Vec::new();
+        loop {
+            events.extend(
+                codex_omd::event_bus::global()
+                    .lock()
+                    .unwrap()
+                    .drain(observer, 16),
+            );
+            if events
+                .last()
+                .is_some_and(|event| event.data["barrier"] == true)
+            {
+                events.pop();
+                return events;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "terminal event delivery timed out"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    };
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let sender = AppEventSender::new(tx);
+    for (thread, count) in [("main", 1), ("child", 1), ("main", 2)] {
+        attach(&sender, Some(thread.into()));
+        attach(&sender, Some(thread.into()));
+        terminal_event("focus", json!({"focused":true}));
+        let events = receive();
+        assert_eq!(events.len(), 1, "{events:?}");
+        assert_eq!(events[0].thread, thread);
+        assert_eq!(
+            events[0].data,
+            json!({"event":{
+            "phase":"opened","view":"thread","view_id":thread},"count":count})
+        );
+    }
+    let obsolete = TerminalEvent::capture(
+        "view",
+        json!({"phase":"opened","view":"thread","view_id":"obsolete"}),
+    );
+    let unguarded = TerminalEvent::capture("focus", json!({"focused":true}));
+    attach(&sender, None);
+    attach(&sender, Some("main".into()));
+    terminal_event("focus", json!({"focused":true}));
+    let events = receive();
+    assert_eq!(events.len(), 1, "{events:?}");
+    assert_eq!(events[0].thread, "main");
+    assert_eq!(events[0].data["event"]["view_id"], "main");
+    assert_eq!(events[0].data["count"], 3);
+    obsolete.deliver(&AtomicUsize::new(0));
+    unguarded.deliver(&AtomicUsize::new(0));
+    assert!(receive().is_empty());
+    codex_omd::event_bus::global()
+        .lock()
+        .unwrap()
+        .unsubscribe(observer);
+}
