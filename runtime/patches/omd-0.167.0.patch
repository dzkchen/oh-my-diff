+#[test]
+fn only_registered_sidecars_reach_approved_profiles_until_revoked() {
+    let temp = tempfile::tempdir().unwrap();
+    let store = temp.path().canonicalize().unwrap();
+    let profiles = CredentialProfiles::local(&store).unwrap();
