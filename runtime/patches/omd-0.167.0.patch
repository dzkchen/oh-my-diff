+crate::omd::isolated_static! { DRAWN_CALLS: Mutex<std::collections::BTreeSet<String>> =
+Mutex::new(std::collections::BTreeSet::new()) }
+crate::omd::isolated_static! { REFRESHES: AtomicU64 = AtomicU64::new(0) }
