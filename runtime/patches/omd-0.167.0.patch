+fn agent_owned_by(
+    agent_mod: &str,
+    agent_generation: u64,
+    agent_task: &Arc<Task>,
+    mod_id: &str,
+    generation: u64,
+    task: &Arc<Task>,
+) -> bool {
+    agent_mod == mod_id && agent_generation == generation && Arc::ptr_eq(agent_task, task)
+}
