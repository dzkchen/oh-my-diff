+fn dock_zone_tints_cells_and_keeps_their_text_and_foreground() {
+    let colors = crate::terminal_probe::DefaultColors {
+        fg: (240, 240, 240),
+        bg: (0, 0, 0),
+    };
+    crate::terminal_palette::with_test_default_colors(colors, || {
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 8, 5));
+        buffer[(3, 2)].set_char('X').set_fg(Color::Red);
+        buffer[(4, 2)].set_bg(crate::terminal_palette::rgb_color((200, 0, 0)));
+        buffer[(5, 2)].set_char('Y').set_bg(Color::Blue);
+        buffer[(1, 1)].set_char('+').set_fg(Color::Red);
+        buffer[(6, 1)].set_bg(crate::terminal_palette::indexed_color(4));
+        shade_dock_zone(Rect::new(1, 1, 6, 3), &mut buffer);
+        let accent = crate::style::accent_color();
+        let Color::Rgb(r, g, b) = accent else {
+            panic!("truecolor accent expected, got {accent:?}");
+        };
+        let tint = |under, amount| {
+            crate::terminal_palette::rgb_color(crate::color::blend((r, g, b), under, amount))
+        };
+        assert_eq!(
+            (
+                buffer[(3, 2)].symbol(),
+                buffer[(3, 2)].fg,
+                buffer[(3, 2)].bg
+            ),
+            ("X", Color::Red, tint((0, 0, 0), 0.18))
+        );
+        assert_eq!(buffer[(4, 2)].bg, tint((200, 0, 0), 0.18));
+        assert_eq!(buffer[(5, 2)].bg, Color::Blue);
+        assert!(buffer[(5, 2)].modifier.contains(Modifier::DIM));
+        assert_eq!(
+            (
+                buffer[(1, 1)].symbol(),
+                buffer[(1, 1)].fg,
+                buffer[(1, 1)].bg
+            ),
+            ("+", Color::Red, tint((0, 0, 0), 0.4))
+        );
+        assert_eq!(buffer[(0, 0)].bg, Color::Reset);
+        assert_eq!(buffer[(7, 4)].bg, Color::Reset);
+        assert!(!buffer[(5, 2)].modifier.contains(Modifier::REVERSED));
+        assert_eq!(buffer[(6, 1)].bg, crate::terminal_palette::indexed_color(4));
+        assert!(buffer[(6, 1)].modifier.contains(Modifier::REVERSED));
+    });
+}
