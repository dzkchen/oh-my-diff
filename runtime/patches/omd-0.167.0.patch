+fn tool(
+    runtime: &Mutex<ModHost>,
+    name: &str,
+    calls: &mut Vec<Value>,
+) -> std::io::Result<codex_omd::ModChain> {
+    codex_omd::intercept_shared(
+        runtime,
+        "tool",
+        true,
+        json!({"tool": name, "arguments": {}}),
+        json!({"caller": "model"}),
+        || true,
+        |_, _| Err(std::io::Error::other("unexpected host call")),
+        |input| {
+            calls.push(input);
+            Ok(json!({"output": "ran", "success": true}))
+        },
+    )
+}
