+const SLEEP_LIMIT_MS: u64 = 60_000;
+
+fn hostless(event: &str, payload: &Value) -> bool {
+    matches!(event, "terminal" | "component")
+        || event == "intercept"
+            && matches!(
+                payload["surface"].as_str(),
+                Some(
+                    "render"
+                        | "command_list"
+                        | "config_list"
+                        | "tool_specs"
+                        | "agent_offers"
+                        | "admission"
+                        | "composer_edit"
+                        | "composer_key"
+                        | "component_change"
+                        | "history_persist"
+                )
+            )
+}
