+            operation: "terminal.blit".to_string(),
+            arguments: raw.clone(),
+            pixels: None,
+        }),
+        None
+    );
+    for format in [
+        OmdRenderFormat::Png,
+        OmdRenderFormat::Jpeg,
+        OmdRenderFormat::Cells,
+    ] {
