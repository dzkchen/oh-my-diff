+
+impl ComponentRow {
+    fn take_columns(&mut self, columns: &mut Vec<Vec<String>>) {
+        columns.append(&mut self.columns);
+        for row in &mut self.beside {
+            row.take_columns(columns);
+        }
+    }
+
+    fn clip(&mut self, width: u16) {
+        self.cells = Some(self.own().min(width.saturating_sub(self.indent)));
+        for link in &mut self.links {
+            link.columns.end = link.columns.end.min(usize::from(width));
+        }
+        self.links.retain(|link| !link.columns.is_empty());
+        for row in &mut self.beside {
+            row.clip(width);
+        }
+    }
+
+    fn own(&self) -> u16 {
+        self.cells.unwrap_or_else(|| {
+            u16::try_from(self.line.width())
+                .unwrap_or(u16::MAX)
+                .saturating_sub(self.indent)
+        })
+    }
+
+    fn shift(&mut self, by: u16) {
+        self.cells = Some(self.own());
+        self.indent = self.indent.saturating_add(by);
+        for held in &mut self.regions {
+            held.x = held.x.saturating_add(by);
+        }
+        for link in &mut self.links {
+            link.columns = link.columns.start + usize::from(by)..link.columns.end + usize::from(by);
+        }
+        for row in &mut self.beside {
+            row.shift(by);
+        }
+    }
+}
