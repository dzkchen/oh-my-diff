+#[test]
+fn inline_images_emit_on_change_and_the_diff_leaves_them_alone() {
+    let id = 0x4f_4d_01;
+    let mut inline = BTreeMap::from([(
+        id,
+        Inline {
+            bytes: Arc::from(&b"png"[..]),
+            columns: 2,
+            rows: 2,
+            emitted: None,
+        },
+    )]);
+    let area = Rect::new(0, 0, 6, 3);
+    let markers = placeholder_rows(id, 2, 2, "");
+    let frame = |x: u16, overlay: bool| {
+        let mut buffer = Buffer::empty(area);
+        for (row, line) in markers.iter().enumerate() {
+            buffer.set_line(x, row as u16, line, 6);
+        }
+        if overlay {
+            buffer[(x + 1, 1)].set_symbol("X");
+        }
+        buffer
+    };
+    let mut run = |previous: &Buffer, mut current: Buffer| {
+        let emitted = mark(previous, &mut current, &mut inline);
+        (emitted, current)
+    };
+    let (emitted, first) = run(&Buffer::empty(area), frame(1, false));
+    assert_eq!(emitted, [(id, 1, 0)]);
+    assert!(
+        [(1, 0), (2, 0), (1, 1), (2, 1)]
+            .into_iter()
+            .all(|at| first[at].symbol() == " " && first[at].diff_option == CellDiffOption::Skip)
+    );
+    let (emitted, second) = run(&first, frame(1, false));
+    assert_eq!(emitted, []);
+    let (emitted, covered) = run(&second, frame(1, true));
+    assert_eq!(emitted, [], "an overlay alone doesn't redraw the picture");
+    assert_eq!(covered[(2, 1)].diff_option, CellDiffOption::AlwaysUpdate);
+    let (emitted, uncovered) = run(&covered, frame(1, false));
+    assert_eq!(
+        emitted,
+        [(id, 1, 0)],
+        "cells the overlay left show something else"
+    );
+    let (emitted, moved) = run(&uncovered, frame(2, false));
+    assert_eq!(emitted, [(id, 2, 0)]);
+    assert_eq!(moved[(1, 0)].diff_option, CellDiffOption::AlwaysUpdate);
+    let (emitted, clipped) = run(&moved, frame(5, false));
+    assert_eq!(emitted, [], "a picture running off the buffer isn't drawn");
+    assert_eq!(clipped[(5, 0)].diff_option, CellDiffOption::None);
+    assert_eq!(clipped[(5, 0)].symbol(), " ");
+}
