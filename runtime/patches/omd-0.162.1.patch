+        let routed = raw_blit_for(&renderer(&[format]), &raw, Some((4, 2)), &pixels).unwrap();
+        assert!(routed.get("pixels").is_none());
+        assert!(!routed.to_string().contains("private-handle"));
+        if let Some(encoded) = routed.get("image") {
+            assert!(
+                client_surface::decode_image(
