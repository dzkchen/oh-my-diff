+    *fixture.lead.session.contract.lock().unwrap() =
+        crate::contract::SessionContract::resolve(&fixture.lead.host, &[]);
+    let core = &fixture.core;
+    let thread = fixture.lead.thread.to_string();
+    expansion::invoke_one(
+        core,
+        &fixture.lead,
+        "monitor".into(),
+        "timer",
+        json!({"key": "poll"}),
+    )
+    .await;
+    let state = |key: &str| {
