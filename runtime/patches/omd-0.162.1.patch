+    async fn resume(
+        &self,
+        call_id: &str,
+        result: Result<Value, String>,
+    ) -> Option<Result<codex_omd::ModChain, String>> {
+        let PendingTool {
+            result: sender,
+            chain,
+            _cancellation,
+            ..
+        } = self.pending.lock().ok()?.remove(call_id)?;
+        let _ = sender.send(result);
