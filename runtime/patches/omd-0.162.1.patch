+use super::*;
+
+struct Tool {
+    core: Arc<Core>,
+    lead: Arc<Lead>,
+    id: String,
+    generation: u64,
+    definition: ModTool,
+    parameters: JsonSchema,
+}
+
+impl ToolContributor for Mods {
+    fn tools(
+        &self,
+        _: &ExtensionData,
+        thread: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(lead) = thread.get::<Lead>().filter(|lead| lead.owner == "lead") else {
+            return Vec::new();
+        };
+        let Ok(runtime) = self.runtime.lock() else {
+            return Vec::new();
+        };
+        self.tool_executors(lead, runtime.tools())
+    }
+
+    fn tools_for_step(
+        &self,
+        _: &ExtensionData,
+        thread: &ExtensionData,
+        _: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(lead) = thread.get::<Lead>().filter(|lead| lead.owner == "lead") else {
+            return Vec::new();
+        };
+        let Ok(mut runtime) = self.runtime.lock() else {
+            return Vec::new();
+        };
+        if !runtime.has_task_scoped_tools() {
+            return self.tool_executors(lead, runtime.tools());
+        }
+        let task = lead.session.task.clone();
+        if task.check_active().is_err() {
+            return self.tool_executors(
+                lead,
+                runtime
+                    .tools()
+                    .into_iter()
+                    .filter(|(_, _, tool)| !tool.task_scoped)
+                    .collect(),
+            );
+        }
+        let ledger = lead.ledger();
+        let tools =
+            runtime.tools_for_step(thread_id(thread), ledger, || task.check_active().is_ok());
+        self.tool_executors(lead, tools)
+    }
+}
+
+impl Mods {
+    fn tool_executors(
+        &self,
+        lead: Arc<Lead>,
+        tools: Vec<(String, u64, ModTool)>,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        tools
+            .into_iter()
+            .filter_map(|(id, generation, definition)| {
+                let parameters =
+                    codex_extension_api::parse_tool_input_schema(&definition.parameters).ok()?;
+                Some(Arc::new(Tool {
+                    core: self.core.clone(),
+                    lead: lead.clone(),
+                    id,
+                    generation,
+                    definition,
+                    parameters,
+                })
+                    as Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>)
+            })
+            .collect()
+    }
+}
+
+impl Tool {
+    fn label(&self) -> String {
+        self.definition
+            .label
+            .clone()
+            .unwrap_or_else(|| self.definition.name.clone())
+    }
+
+    fn name(&self) -> String {
+        if self.id.is_empty() {
+            self.definition.name.clone()
+        } else {
+            format!("mod_{}_{}", self.id, self.definition.name)
+        }
+    }
+}
+
+impl<'call> ToolExecutor<ToolCall<'call>> for Tool {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain(self.name())
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(ResponsesApiTool {
+            name: self.name(),
+            description: self.definition.description.clone(),
+            strict: false,
+            defer_loading: None,
+            output_schema: None,
+            parameters: self.parameters.clone(),
+        })
+    }
+
+    fn exposure(&self) -> ToolExposure {
+        ToolExposure::Deferred
+    }
+
+    fn search_info(&self) -> Option<codex_tools::ToolSearchInfo> {
+        let source = (!self.id.is_empty()).then(|| codex_tools::ToolSearchSourceInfo {
+            name: format!("{} mod tools", self.id),
+            description: Some(format!("Tools of the enabled {} mod", self.id)),
+        });
+        codex_tools::ToolSearchInfo::from_tool_spec(self.spec(), source)
+    }
+
+    fn handle<'a>(&'a self, call: ToolCall<'call>) -> ToolExecutorFuture<'a>
+    where
+        'call: 'a,
+    {
+        Box::pin(async move {
+            let payload: Value = serde_json::from_str(call.function_arguments()?)
+                .map_err(|e| FunctionCallError::RespondToModel(e.to_string()))?;
+            let core = &self.core;
+            let runtime = core.runtime.clone();
+            let (id, name, generation) = (
+                self.id.clone(),
+                self.definition.name.clone(),
+                self.generation,
+            );
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let (label, tool_name) = (self.label(), self.name());
+            core.views.progress(&core.host, &label, "Running");
+            let (views, host_info, progress_label) =
+                (core.views.clone(), core.host.clone(), label.clone());
+            let (requests, mut receiver) = tokio::sync::mpsc::channel::<HostRequest>(1);
+            let flag = cancelled.clone();
+            let thread = self.lead.thread.to_string();
+            let job = tokio::task::spawn_blocking(move || {
+                let _thread = codex_omd::StateThread::enter(Some(thread));
+                let poisoned = || std::io::Error::other("mod runtime poisoned");
+                let facts = facts(&*runtime.lock().map_err(|_| poisoned())?);
+                let active = || !flag.load(Ordering::Acquire);
+                let host =
+                    |caller: &str, request| forward(&requests, &facts, caller, request, &active);
+                let progress =
+                    |update: String| views.progress(&host_info, &progress_label, &update);
+                if id.is_empty() {
+                    return runtime
+                        .lock()
+                        .map_err(|_| poisoned())?
+                        .invoke_tool(&id, generation, &name, payload, active, host, progress);
+                }
+                codex_omd::invoke_shared(
+                    &runtime, &id, generation, "tool", &name, payload, active, host, progress,
+                )
+            });
+            let mut ordinal = 0u32;
+            while let Some(host_call) = receiver.recv().await {
+                ordinal += 1;
+                let mut nested = call.clone();
+                nested.call_id = format!("{}/mod/{}/{generation}/{ordinal}", call.call_id, self.id);
+                let value = operations::dispatch(
+                    core,
+                    &self.lead,
+                    operations::Caller {
+                        id: &host_call.caller,
+                        source: &host_call.source,
+                        grants: host_call.grants,
+                        generation,
+                        origin: codex_omd::data_store::Origin::Tool,
+                        record_changes: false,
+                    },
+                    Some(&nested),
+                    host_call.request,
+                    &cancelled,
+                )
+                .await;
+                let _ = host_call.reply.send(value.map_err(std::io::Error::other));
+            }
+            let result = job
+                .await
+                .map_err(|e| e.to_string())
+                .and_then(|result| result.map_err(|e| e.to_string()));
+            match result {
+                Ok(value) => {
+                    core.views
+                        .finish(&core.host, &self.id, &tool_name, &label, "completed");
+                    Ok(Box::new(JsonToolOutput::new(value)) as Box<dyn ToolOutput>)
+                }
+                Err(error) => {
+                    core.views
+                        .finish(&core.host, &self.id, &tool_name, &label, "failed");
+                    core.agents.cleanup_owned(&self.id, generation).await;
+                    core.services.cleanup_owned(&self.id, generation).await;
+                    self.lead
+                        .session
+                        .processes
+                        .cleanup_owned(&self.id, generation);
+                    super::access::release_servers(&self.lead, generation, Some(&self.id)).await;
+                    Err(FunctionCallError::RespondToModel(error))
+                }
+            }
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/view.rs b/codex-rs/ext/omd/src/mods/view.rs
new file mode 100644
index 000000000..0ca825258
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/view.rs
@@ -0,0 +1,259 @@
+use super::*;
+use codex_omd::ModActivity;
+use codex_omd::ModPanel;
+use codex_omd::ModTerminalView;
+use codex_omd::ModViewSnapshot;
+
+#[derive(Default)]
+struct State {
+    snapshot: ModViewSnapshot,
+    presentation: Value,
+    sequence: u64,
+    diagnostics: BTreeMap<String, String>,
+}
+
+pub(super) struct Views {
+    state: Mutex<State>,
+    /// The snapshot as last persisted; `None` until the first publish.
+    published: Mutex<Option<Arc<ModViewSnapshot>>>,
+    /// Set while re-rendering for a roster change: an unchanged view keeps its revision.
+    pub(super) quiet: AtomicBool,
+}
+
+/// Keeps at most `limit` UTF-8 bytes, matching `ModViewSnapshot::read`.
+fn visible(text: &str, limit: usize) -> String {
+    let mut output = String::new();
+    for character in text.chars().filter(|c| !c.is_control()) {
+        if output.len() + character.len_utf8() > limit {
+            break;
+        }
+        output.push(character);
+    }
+    output
+}
+
+impl Views {
+    pub(super) fn start_thread(&self, thread: &codex_extension_api::ExtensionData) -> Value {
+        let phase = if thread.get::<codex_extension_api::ResumedThread>().is_some()
+            || thread
+                .get::<codex_extension_api::ForkedFromThread>()
+                .is_some()
+        {
+            "resumed"
+        } else {
+            "fresh"
+        };
+        self.presentation(thread.level_id(), Some(phase))
+    }
+
+    pub(super) fn presentation(&self, thread: &str, phase: Option<&str>) -> Value {
+        let Ok(mut state) = self.state.lock() else {
+            return Value::Null;
+        };
+        if state.presentation["thread_id"].as_str() != Some(thread) {
+            state.presentation = json!({"thread_id": thread, "phase": "fresh"});
+        }
+        if let Some(phase) = phase {
+            state.presentation["phase"] = json!(phase);
+        }
+        state.presentation.clone()
+    }
+
+    pub(super) fn current_presentation(&self) -> Value {
+        self.state
+            .lock()
+            .map(|state| state.presentation.clone())
+            .unwrap_or(Value::Null)
+    }
+
+    pub(super) fn new() -> Self {
+        let epoch = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|elapsed| u64::try_from(elapsed.as_nanos()).unwrap_or(u64::MAX))
+            .unwrap_or_default();
+        Self {
+            state: Mutex::new(State {
+                snapshot: ModViewSnapshot {
+                    epoch,
+                    ..ModViewSnapshot::default()
+                },
+                ..State::default()
+            }),
+            published: Mutex::new(None),
+            quiet: AtomicBool::new(false),
+        }
+    }
+
+    pub(super) fn published(&self) -> Option<Arc<ModViewSnapshot>> {
+        self.published.lock().ok()?.clone()
+    }
+
+    fn update(&self, owner: &Host, change: impl FnOnce(&mut State)) {
+        let Ok(mut state) = self.state.lock() else {
+            return;
+        };
+        change(&mut state);
+        state.snapshot.diagnostics = state.diagnostics.values().take(16).cloned().collect();
+        let _ = owner.persist_json("mod-view.json", &state.snapshot);
+        if let Ok(mut published) = self.published.lock() {
+            *published = Some(Arc::new(state.snapshot.clone()));
+        }
+        super::clients::reconcile(self, &state.snapshot);
+        codex_omd::client_surface::redraw();
+    }
+
+    pub(super) fn base(
+        &self,
+        owner: &Host,
+        terminal: ModTerminalView,
+        input: Value,
+        rendered_ms: u64,
+    ) {
+        let quiet = self.quiet.load(Ordering::Acquire);
+        self.update(owner, |state| {
+            let snapshot = &state.snapshot;
+            if !quiet
+                || snapshot.view != terminal.view
+                || snapshot.conflicts != terminal.conflicts
+                || snapshot.contributors != terminal.contributors
+                || snapshot.component_owners != terminal.component_owners
+            {
+                state.snapshot.revision = state.snapshot.revision.saturating_add(1);
+            }
+            state.snapshot.rendered_ms = rendered_ms;
+            state.snapshot.view = terminal.view;
+            state.snapshot.conflicts = terminal.conflicts;
+            state.snapshot.contributors = terminal.contributors;
+            state.snapshot.component_owners = terminal.component_owners;
+            state.snapshot.input = input;
+            state
+                .diagnostics
+                .retain(|key, _| !key.starts_with("terminal:"));
+            for (index, diagnostic) in terminal.diagnostics.into_iter().enumerate() {
+                state
+                    .diagnostics
+                    .insert(format!("terminal:{index}"), visible(&diagnostic, 512));
+            }
+        });
+    }
+
+    pub(super) fn diagnostic(&self, owner: &Host, key: &str, message: Option<String>) {
+        self.update(owner, |state| match message {
+            Some(message) => {
+                state
+                    .diagnostics
+                    .insert(key.to_owned(), visible(&message, 512));
+            }
+            None => {
+                state.diagnostics.remove(key);
+            }
+        });
+    }
+
+    pub(super) fn progress(&self, owner: &Host, label: &str, text: &str) {
+        let lines = text
+            .split('\n')
+            .map(|line| visible(line, 1024))
+            .filter(|line| !line.is_empty())
+            .collect::<Vec<_>>();
+        let start = lines.len().saturating_sub(8);
+        self.update(owner, |state| {
+            state.snapshot.progress = Some(ModPanel {
+                title: visible(label, 128),
+                lines: lines[start..].to_vec(),
+            });
+        });
+    }
+
+    pub(super) fn finish(&self, owner: &Host, mod_id: &str, tool: &str, label: &str, status: &str) {
+        self.update(owner, |state| {
+            state.snapshot.progress = None;
+            state.sequence += 1;
+            state.snapshot.activity.push(ModActivity {
+                sequence: state.sequence,
+                mod_id: mod_id.to_owned(),
+                tool: visible(tool, 128),
+                label: visible(label, 128),
+                status: status.to_owned(),
+            });
+            let excess = state.snapshot.activity.len().saturating_sub(32);
+            state.snapshot.activity.drain(..excess);
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Views, visible};
+
+    #[test]
+    fn welcome_phase_survives_ready_reload_and_rejected_input_until_accepted_start() {
+        let views = Views::new();
+        assert_eq!(
+            views.presentation("thread-a", Some("fresh"))["phase"],
+            "fresh"
+        );
+        // A view refresh, reload, or rejected submission does not supply an accepted phase.
+        assert_eq!(views.presentation("thread-a", None)["phase"], "fresh");
+        views.presentation("thread-a", Some("started"));
+        assert_eq!(views.presentation("thread-a", None)["phase"], "started");
+        assert_eq!(views.current_presentation()["phase"], "started");
+        views.presentation("thread-b", Some("resumed"));
+        assert_eq!(views.presentation("thread-b", None)["phase"], "resumed");
+        assert_eq!(views.presentation("thread-c", None)["phase"], "fresh");
+    }
+
+    #[test]
+    fn welcome_resume_and_fork_markers_are_latched_before_ready_publication() {
+        let views = Views::new();
+        let thread = codex_extension_api::ExtensionData::new("resumed");
+        thread.insert(codex_extension_api::ResumedThread);
+        views.start_thread(&thread);
+        assert_eq!(views.current_presentation()["phase"], "resumed");
+        assert_eq!(
+            views.presentation(thread.level_id(), None)["phase"],
+            "resumed"
+        );
+        let fork = codex_extension_api::ExtensionData::new("forked");
+        fork.insert(codex_extension_api::ForkedFromThread(
+            codex_protocol::ThreadId::new(),
+        ));
+        views.start_thread(&fork);
+        assert_eq!(views.current_presentation()["phase"], "resumed");
+        assert_eq!(views.current_presentation()["thread_id"], "forked");
+    }
+
+    #[test]
+    fn the_published_snapshot_is_served_from_memory_after_the_first_update() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let host = crate::Host {
+            root: root.clone(),
+            repository: root.clone(),
+            repository_identity: "fixture".into(),
+            config: crate::config::HostConfig::default(),
+            routes: std::sync::Mutex::new(crate::RouteTable {
+                stamp: None,
+                config: std::sync::Arc::new(crate::config::HostConfig::default()),
+                error: None,
+            }),
+            accounts: std::sync::Arc::new(crate::accounting::Accounts::default()),
+            manager: std::sync::Weak::new(),
+            epoch: 1,
+        };
+        let views = Views::new();
+        assert!(views.published().is_none());
+        views.diagnostic(&host, "k", Some("broken".into()));
+        std::fs::remove_file(root.join("mod-view.json")).unwrap();
+        let published = views.published().expect("published after an update");
+        assert_eq!(published.diagnostics, vec!["broken".to_owned()]);
+    }
+
+    #[test]
+    fn visible_bounds_bytes_on_a_character_boundary() {
+        let text = visible(&"💥".repeat(300), 512);
+        assert_eq!(text.len(), 512);
+        assert_eq!(text.chars().count(), 128);
+        assert_eq!(visible("a\u{7}é", 2), "a");
+    }
+}
diff --git a/codex-rs/ext/omd/src/request_observer.rs b/codex-rs/ext/omd/src/request_observer.rs
new file mode 100644
index 000000000..41270872f
--- /dev/null
+++ b/codex-rs/ext/omd/src/request_observer.rs
@@ -0,0 +1,170 @@
+use codex_client::EncodedJsonBody;
+use codex_client::Request;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use serde_json::Value;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+pub trait ResponseAttempt: Send + Sync {
+    /// Observes one raw event; replacing it with `Value::Null` drops it.
+    fn observe(&mut self, event: &mut Value, valid: bool) -> Result<(), TransportError>;
+    /// Raw events to deliver after the one just observed.
+    fn injected(&mut self) -> Vec<Value> {
+        Vec::new()
+    }
+    fn failed(&mut self, reason: &str);
+}
+
+pub trait ResponseObserver: Send + Sync {
+    fn prepare(
+        &self,
+        request: &mut Request,
+        body: &mut Option<EncodedJsonBody>,
+    ) -> Result<(), TransportError>;
+    fn before_send(
+        &self,
+        request: &mut Request,
+        body: Option<&EncodedJsonBody>,
+    ) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError>;
+    fn requires_observation(&self, thread: Option<&str>) -> bool {
+        let _ = thread;
+        true
+    }
+    /// Whether a required final-request policy must see every provider request.
+    fn policed(&self) -> bool {
+        false
+    }
+    /// Raw events answering an admitted request without sending it.
+    fn answer(&self, request: &Request) -> Option<Vec<Value>> {
+        let _ = request;
+        None
+    }
+}
+
+/// Marks a request whose items carry metadata the provider does not accept; it is removed after `prepare`.
+pub const STRIP_ITEM_METADATA: &str = "x-codex-strip-item-metadata";
+
+pub fn installed() -> bool {
+    OBSERVER.get().is_some()
+}
+
+pub const STREAM_CONTROL: &str = "stream_control:";
+
+pub fn stream_control_error(control: &serde_json::Value) -> TransportError {
+    TransportError::Build(format!("{STREAM_CONTROL}{control}"))
+}
+
+pub fn stream_control(message: &str) -> Option<serde_json::Value> {
+    let start = message.find(STREAM_CONTROL)? + STREAM_CONTROL.len();
+    serde_json::Deserializer::from_str(&message[start..])
+        .into_iter::<serde_json::Value>()
+        .next()?
+        .ok()
+        .filter(serde_json::Value::is_object)
+}
+
+static OBSERVER: OnceLock<Arc<dyn ResponseObserver>> = OnceLock::new();
+
+pub fn install_response_observer(observer: Arc<dyn ResponseObserver>) -> Result<(), &'static str> {
+    OBSERVER
+        .set(observer)
+        .map_err(|_| "response observer already installed")
+}
+
+pub(crate) struct ObservedStream {
+    pub response: StreamResponse,
+    pub attempt: Option<Box<dyn ResponseAttempt>>,
+}
+
+impl crate::telemetry::WithStatus for ObservedStream {
+    fn status(&self) -> http::StatusCode {
+        self.response.status
+    }
+}
+
+pub(crate) fn admit(
+    request: &mut Request,
+    body: Option<&EncodedJsonBody>,
+) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError> {
+    match OBSERVER.get() {
+        Some(observer) => observer.before_send(request, body),
+        None => Ok(None),
+    }
+}
+
+pub(crate) fn reject_policed_transport() -> Result<(), crate::error::ApiError> {
+    if OBSERVER.get().is_some_and(|observer| observer.policed()) {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy: final_request_refused: request_policy_unsupported_transport: a final-request policy is active and this provider transport cannot pass it".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn reject_unobserved_transport(
+    headers: &http::HeaderMap,
+) -> Result<(), crate::error::ApiError> {
+    reject_policed_transport()?;
+    let thread = headers
+        .get("thread-id")
+        .and_then(|value| value.to_str().ok());
+    if OBSERVER
+        .get()
+        .is_some_and(|observer| observer.requires_observation(thread))
+    {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy requires observed HTTP Responses transport".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn reject_websocket_transport() -> Result<(), crate::error::ApiError> {
+    if OBSERVER.get().is_some() {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy requires observed HTTP Responses transport".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn prepare(
+    request: &mut Request,
+    body: &mut Option<EncodedJsonBody>,
+) -> Result<(), TransportError> {
+    if let Some(observer) = OBSERVER.get() {
+        observer.prepare(request, body)?;
+    }
+    if request.headers.remove(STRIP_ITEM_METADATA).is_some()
+        && let Some(encoded) = body.as_ref()
+    {
+        let build = |error: serde_json::Error| TransportError::Build(error.to_string());
+        let mut value: Value = serde_json::from_slice(encoded.as_bytes()).map_err(build)?;
+        for item in value["input"].as_array_mut().into_iter().flatten() {
+            if let Some(item) = item.as_object_mut() {
+                item.remove("internal_chat_message_metadata_passthrough");
+            }
+        }
+        *body = Some(EncodedJsonBody::encode(&value).map_err(build)?);
+    }
+    Ok(())
+}
+
+pub(crate) fn answer(request: &Request) -> Option<StreamResponse> {
+    let events = OBSERVER.get()?.answer(request)?;
+    let chunks = events
+        .into_iter()
+        .map(|event| Ok(bytes::Bytes::from(format!("data: {event}\n\n"))))
+        .collect::<Vec<_>>();
+    let mut headers = http::HeaderMap::new();
+    headers.insert(
+        http::header::CONTENT_TYPE,
+        http::HeaderValue::from_static("text/event-stream"),
+    );
+    Some(StreamResponse {
+        status: http::StatusCode::OK,
+        headers,
+        bytes: Box::pin(futures::stream::iter(chunks)),
+    })
+}
diff --git a/codex-rs/ext/omd/src/workspace_operations.rs b/codex-rs/ext/omd/src/workspace_operations.rs
new file mode 100644
index 000000000..d0f24c0a3
--- /dev/null
+++ b/codex-rs/ext/omd/src/workspace_operations.rs
@@ -0,0 +1,810 @@
+use codex_file_system::FileSystemSandboxContext;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use codex_protocol::permissions::FileSystemSandboxPolicyContext;
+use codex_protocol::permissions::ReadDenyMatcher;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+
+pub(super) struct WorkspaceAuthority {
+    pub repository: PathBuf,
+    pub session_root: Option<PathBuf>,
+    pub session_database: Option<PathBuf>,
+    pub policy: FileSystemSandboxPolicy,
+    pub context: FileSystemSandboxContext,
+}
+
+fn local_context(
+    profile: codex_protocol::models::PermissionProfile,
+    cwd: PathUri,
+) -> Result<FileSystemSandboxContext, String> {
+    let mut context = FileSystemSandboxContext::from_permission_profile(profile, cwd);
+    context.user_home_dir = PathUri::from_host_native_path("~").ok();
+    context.temporary_directories = Some(
+        match std::env::var_os("TMPDIR").filter(|path| !path.is_empty()) {
+            Some(path) => vec![PathUri::from(
+                AbsolutePathBuf::from_absolute_path(PathBuf::from(path))
+                    .map_err(|e| e.to_string())?,
+            )],
+            None => Vec::new(),
+        },
+    );
+    Ok(context)
+}
