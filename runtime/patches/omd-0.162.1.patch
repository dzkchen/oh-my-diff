+async fn an_evicted_contributed_role_child_reloads_in_its_workspace() {
+    let (_home, mut config) = test_config().await;
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    let _ = config.features.enable(Feature::Sqlite);
+    config.model = Some("gpt-5.6-sol".to_string());
+    let role_file = config.codex_home.join("contributed.toml");
+    std::fs::write(
+        &role_file,
+        "name = \"ext/reviewer\"\ndescription = \"Reviews diffs\"\nmodel_reasoning_effort = \"low\"\n",
+    )
+    .expect("write role file");
+    let workspace = config.codex_home.join("worktree");
+    std::fs::create_dir_all(&workspace).expect("create worktree");
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.agent_role_contributor(Arc::new(ContributedReviewer(role_file, workspace.clone())));
+    let state_db = init_state_db(&config).await;
+    let manager = ThreadManager::with_models_provider_home_and_state_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+        state_db,
+    )
+    .with_extensions_for_tests(Arc::new(extensions.build()));
+    let root = manager
+        .start_thread(StartThreadOptions {
+            history_mode: Some(ThreadHistoryMode::Paginated),
+            ..StartThreadOptions::new(config.clone())
+        })
+        .await
+        .expect("start root thread");
+    let control = root
+        .thread
+        .session
+        .services
+        .local_agent_runtime
+        .control(root.thread.session.session_id());
+    let source = thread_spawn_source(
+        root.thread.session.thread_id,
+        &root.thread.session_source,
+        next_thread_spawn_depth(&root.thread.session_source),
+        Some("ext/reviewer"),
+        Some("reviewer".to_string()),
+    )
+    .expect("child source");
+    let spawned = control
+        .spawn_agent_with_metadata(
+            config.clone(),
+            text_input("hello child"),
+            source,
+            SpawnAgentOptions {
+                parent_thread_id: Some(root.thread.session.thread_id),
+                ..Default::default()
+            },
+        )
+        .await
+        .expect("spawn contributed role child");
+    let child = manager
+        .get_thread(spawned.thread_id)
+        .await
+        .expect("child thread should exist");
+    child
+        .inject_response_items(vec![assistant_message(
+            "child persisted",
+            Some(MessagePhase::FinalAnswer),
+        )])
+        .await
+        .expect("child rollout should persist");
+    child.shutdown_and_wait().await.expect("child shuts down");
+    assert!(manager.remove_thread(&spawned.thread_id).await.is_some());
+
+    control
+        .ensure_v2_agent_loaded(config, spawned.thread_id, Some(root.thread.clone()))
+        .await
+        .expect("a contributed role child reloads");
+    let reloaded = manager
+        .get_thread(spawned.thread_id)
+        .await
+        .expect("reloaded child")
+        .config_snapshot()
+        .await;
+    assert_eq!(reloaded.cwd(), &workspace);
+}
