+#[test]
+#[serial_test::serial]
+fn client_surface_accepts_independent_reload_generations() {
+    let (directory, _store, source) = surface_package();
+    let _environment =
+        crate::omd::tests::omd_environment(&directory.path().canonicalize().unwrap().join("store"));
+    let previous = state().take();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let sender = AppEventSender::new(tx);
+    attach(&sender, Some("surface-thread".into()));
+    let binding = call_binding("surface_fixture");
+    assert_eq!(binding["source"], source);
+    let native_generation = binding["generation"].as_u64().unwrap() + 10;
+    let cancelled = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let pending = codex_omd::client_surface::with_admission(
+        &source,
+        native_generation,
+        Some(cancelled.clone()),
+        || {
+            codex_omd::client_surface::submit(
+                "surface_fixture",
+                "composer.read",
+                json!({}),
+                InvocationContext::User,
+                false,
+                Some("surface-thread"),
+                None,
+            )
+            .unwrap()
+        },
+    );
+    let AppEvent::ModSurfaceCall(mut call, _) = rx.try_recv().unwrap() else {
+        panic!("queued surface call")
+    };
+    assert!(validate_call(&call).is_ok());
+    call.lifetime.admission.as_mut().unwrap()["source"] = json!("replaced");
+    assert_eq!(
+        validate_call(&call).unwrap_err(),
+        "client_surface_admission_changed"
+    );
+    call.lifetime.admission.as_mut().unwrap()["source"] = json!(source);
+    cancelled.store(true, std::sync::atomic::Ordering::Release);
+    assert!(validate_call(&call).is_err());
+    cancelled.store(false, std::sync::atomic::Ordering::Release);
+    attach(&sender, Some("another-thread".into()));
+    attach(&sender, Some("surface-thread".into()));
+    assert!(validate_call(&call).is_err());
+    drop(pending);
+    *state() = previous;
+}
