+        entry("run", &schema, Some((&schema, false))),
+        entry("hidden", &schema, None),
+        entry("later", &schema, Some((&schema, true))),
+        entry("patch", &Value::Null, Some((&Value::Null, false))),
+        entry("loose", &schema, Some((&replaced, false))),
