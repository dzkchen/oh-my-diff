+/// Replaces each attachment path with an immutable image resource bound to the reading mod.
+fn draft_resources(caller: &str, thread: Option<&str>, draft: &mut Value) -> Result<(), String> {
+    let Some(attachments) = draft["attachments"].as_array_mut() else {
+        return Ok(());
+    };
+    let mut seen = std::collections::BTreeMap::<String, usize>::new();
+    for attachment in attachments {
+        let path = attachment
+            .as_object_mut()
+            .and_then(|object| object.remove("path"))
+            .and_then(|path| path.as_str().map(std::path::PathBuf::from));
+        let bytes = path
+            .as_ref()
+            .filter(|path| std::fs::metadata(path).is_ok_and(|meta| meta.len() <= IMPORT_BYTES))
+            .and_then(|path| std::fs::read(path).ok());
+        let media = match bytes.as_deref() {
+            Some(bytes) if bytes.starts_with(b"\x89PNG\r\n\x1a\n") => Some("image/png"),
+            Some([0xFF, 0xD8, 0xFF, ..]) => Some("image/jpeg"),
+            _ => None,
+        };
+        let (Some(bytes), Some(media)) = (bytes, media) else {
+            attachment["id"] = json!(attachment["label"]);
+            attachment["resource"] = Value::Null;
+            continue;
+        };
+        let sha256 = codex_omd::resource_data::hash(&bytes);
+        let count = seen.entry(sha256.clone()).or_default();
+        *count += 1;
+        attachment["id"] = json!(format!("img-{}-{count}", &sha256[..12]));
+        if let Some((width, height)) = crate::mod_components::dimensions(&bytes) {
+            attachment["width"] = json!(width);
+            attachment["height"] = json!(height);
+        }
+        let (mut host, _) = crate::mod_surface::resource_binding(caller, thread)?;
+        host.binding.thread = "package".into();
+        host.binding.generation = 0;
+        let resources = host.resources();
+        use base64::Engine;
+        let record = resources
+            .evidence_record(json!({"media_type": media,
+                "base64": base64::engine::general_purpose::STANDARD.encode(&bytes),
+                "label": attachment["label"]}))
+            .map_err(|error| error.to_string())?;
+        let reference = resources
+            .save("evidence", record)
+            .map_err(|error| error.to_string())?;
+        attachment["resource"] =
+            serde_json::to_value(reference).map_err(|error| error.to_string())?;
+    }
+    Ok(())
+}
