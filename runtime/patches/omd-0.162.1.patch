+impl ManagedIndex {
+    pub fn location(&self) -> Result<PathBuf> {
+        self.locations
+            .iter()
+            .find(|location| {
+                store::read(location, 524_288).is_ok_and(|bytes| digest(&bytes) == self.sha256)
+            })
+            .cloned()
+            .ok_or_else(|| {
+                failure(format!(
+                    "managed_index_unavailable: no location holds index {}",
+                    self.sha256
+                ))
+            })
