+    );
+    assert!(install.public.get("confirmation").is_none());
+    assert!(
+        !install
+            .public
+            .to_string()
+            .contains(install.control.confirmation.as_deref().unwrap())
+    );
+    assert_eq!(
+        apply(&store, &install.control).unwrap()["status"],
