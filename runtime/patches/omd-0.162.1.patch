+        &step_context.environments,
+        &step_context.mcp,
+        /*apps_enabled*/ false,
+        &turn.extension_data,
+        /*tool_suggest_candidates*/ None,
+    )
+    .expect("build tool router");
+    let plan = ToolPlanProbe::from_router(router);
+    let ToolSpec::Namespace(namespace) = plan.visible_spec(MULTI_AGENT_V1_NAMESPACE) else {
+        panic!("expected v1 multi-agent namespace");
+    };
+    let Some(ResponsesApiNamespaceTool::Function(spawn_agent)) =
+        namespace.tools.iter().find(|tool| {
+            matches!(
+                tool,
+                ResponsesApiNamespaceTool::Function(tool) if tool.name == "spawn_agent"
+            )
+        })
+    else {
+        panic!("expected v1 spawn_agent function");
+    };
+    let agent_type = serde_json::to_string(
+        &spawn_agent
+            .parameters
+            .properties
+            .as_ref()
+            .expect("spawn_agent should use object params")["agent_type"],
+    )
+    .expect("agent_type serializes");
+    assert!(agent_type.contains("ext/reviewer"), "{agent_type}");
+    assert!(agent_type.contains("Reviews staged diffs"), "{agent_type}");
+}
