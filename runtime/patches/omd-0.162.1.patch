+    assert_eq!(cells["cells"][0][0], "▀");
+    assert_eq!(route(&[OmdRenderFormat::Jpeg, OmdRenderFormat::Svg]), None);
+    use base64::Engine;
+    let pixels = codex_omd::process_raster::PixelFrame::new(
+        serde_json::from_value(json!({"source":"private-handle", "format":"rgba", "width":1, "height":1, "sequence":1})).unwrap(),
+        client_surface::decode_image(&base64::engine::general_purpose::STANDARD.decode(png).unwrap()).unwrap(),
+    );
+    let raw = json!({"key":"r", "pixels":{"source":"private-handle"}});
+    assert_eq!(
+        Mirror::of(&Observed::Mirrored {
