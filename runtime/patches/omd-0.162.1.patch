+/// The uncomposed row for `key`, so a hidden row stays settable.
+pub(crate) fn config_row(read: &Value, key: &str) -> Result<Value, String> {
+    let paths = crate::omd::mod_paths().ok_or("mods are not configured for this session")?;
+    codex_omd::client_surface::config_rows(read, &packages(&paths)?)
+        .into_iter()
