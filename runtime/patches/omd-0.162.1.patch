+#[test]
+fn mirrored_image_frames_reach_clients_as_sent_cells_or_not_at_all() {
+    let png = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
+    let frame = json!({"key": "r", "image": {"media_type": "image/png", "base64": png}});
