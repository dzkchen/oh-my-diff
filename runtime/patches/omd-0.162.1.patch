+            false,
+            "",
+            std::time::Instant::now(),
+        );
+    };
+    let next = || received.recv_timeout(std::time::Duration::from_millis(500));
+    draw(10, (20, 4));
+    draw(10, (20, 4));
+    assert_eq!(
+        next(),
+        Ok(json!({"box": {"columns": 10, "rows": 4, "cell_px": {"width": 8, "height": 16}}}))
