+#[test]
+#[ignore = "explicit bounded appearance timing fixture"]
+#[allow(clippy::print_stdout)]
+fn appearance_render_cost_fixture() {
+    use std::hint::black_box;
+    use std::time::Instant;
+
+    fn summary(mut samples: Vec<f64>) -> serde_json::Value {
+        samples.sort_by(f64::total_cmp);
+        serde_json::json!({"median_ms":samples[samples.len()/2],
+            "p95_ms":samples[(samples.len()*95).div_ceil(100)-1],"samples_ms":samples})
+    }
+    fn measure(mut operation: impl FnMut(), count: usize) -> serde_json::Value {
+        summary(
+            (0..count)
+                .map(|_| {
+                    let started = Instant::now();
+                    operation();
+                    started.elapsed().as_secs_f64() * 1000.0
+                })
+                .collect(),
+        )
+    }
+    fn rss() -> Option<u64> {
+        let result = std::process::Command::new("ps")
+            .args(["-o", "rss=", "-p", &std::process::id().to_string()])
+            .output()
+            .ok()?;
+        String::from_utf8(result.stdout).ok()?.trim().parse().ok()
+    }
+
+    let before_rss = rss();
+    let colors = crate::terminal_probe::DefaultColors {
+        fg: (240, 240, 240),
+        bg: (0, 0, 0),
+    };
+    let mut cell_results = Vec::new();
+    crate::terminal_palette::with_test_default_colors(colors, || {
+        for (width, height) in [(80, 24), (120, 40)] {
+            let area = Rect::new(0, 0, width, height);
+            let mut base = Buffer::empty(area);
+            base[(1, 1)].set_char('T');
+            let solid = serde_json::from_value(
+                serde_json::json!({"top":"#262626","bottom":"#262626","foreground":"#eeeeee"}),
+            )
+            .unwrap();
+            let bordered=serde_json::from_value(serde_json::json!({"top":"#3a3a3a","bottom":"#202020","foreground":"#eeeeee","border":"#aaaaaa","opacity":0.85})).unwrap();
+            let baseline = measure(
+                || {
+                    black_box(base.clone());
+                },
+                20,
+            );
+            let plain = measure(
+                || {
+                    let mut buffer = base.clone();
+                    paint_surface(area, &mut buffer, &solid, /*base*/ None);
+                    assert_eq!(buffer[(1, 1)].symbol(), "T");
+                    black_box(buffer);
+                },
+                20,
+            );
+            let bordered_paint = measure(
+                || {
+                    let mut buffer = base.clone();
+                    paint_surface(area, &mut buffer, &bordered, /*base*/ None);
+                    assert_eq!(buffer[(1, 1)].symbol(), "T");
+                    black_box(buffer);
+                },
+                20,
+            );
+            cell_results.push(serde_json::json!({"columns":width,"rows":height,
+                "cell_struct_bytes":base.content.len()*std::mem::size_of::<ratatui::buffer::Cell>(),
+                "buffer_clone":baseline,"solid_paint":plain,"bordered_paint":bordered_paint}));
+        }
+    });
+    println!(
+        "APPEARANCE_COST {}",
+        serde_json::json!({"profile":"debug test process; terminal graphic transmission excluded",
+        "cells":cell_results,"process_rss_before_kib":before_rss,"process_rss_after_kib":rss(),
+        "memory_limit":"cell struct bytes exclude heap string capacity; RSS is a test-process sample, not an allocator or instantaneous peak measurement"})
+    );
+}
