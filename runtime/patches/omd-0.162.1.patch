+#[test]
+fn timer_delivery_budget_coalesces_keys_and_does_not_block_other_owners() {
+    let state = State::default();
+    let thread = ThreadId::new();
+    let timer = |owner: &str, key: &str| delivery::Pending::Timer {
+        thread,
+        owner: owner.into(),
+        key: key.into(),
+        source: "source".into(),
+        incarnation: 0,
+    };
+    for item in [
+        timer("a", "one"),
+        timer("a", "one"),
+        timer("a", "two"),
+        timer("b", "one"),
+    ] {
