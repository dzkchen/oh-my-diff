+pub(crate) fn visual_input(text: &str) -> Cow<'_, str> {
+    let glyphs = crate::mod_ui::glyphs();
+    mod_glyphs(text, &glyphs)
+}
+
+fn mod_glyphs<'a>(
+    text: &'a str,
+    glyphs: &std::collections::BTreeMap<String, String>,
+) -> Cow<'a, str> {
+    if !glyphs.keys().any(|source| text.contains(source.as_str())) {
+        return Cow::Borrowed(text);
+    }
+    let mut ordered = glyphs.iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(source, _)| std::cmp::Reverse(source.len()));
+    let mut rendered = String::with_capacity(text.len());
+    let mut remaining = text;
+    'outer: while !remaining.is_empty() {
+        for (source, display) in &ordered {
+            if let Some(rest) = remaining.strip_prefix(source.as_str()) {
+                rendered.push_str(display);
+                remaining = rest;
+                continue 'outer;
+            }
+        }
+        if let Some(character) = remaining.chars().next() {
+            rendered.push(character);
+            remaining = &remaining[character.len_utf8()..];
+        }
+    }
+    Cow::Owned(rendered)
+}
+
+fn latest_session(root: &Path) -> Option<PathBuf> {
+    std::fs::read_dir(root.join("sessions"))
+        .ok()?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path)
+}
