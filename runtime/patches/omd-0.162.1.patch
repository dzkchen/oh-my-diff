+}
+
+async fn search(mcp: &mut TestAppServer, term: &str) -> Result<Vec<String>> {
+    let request_id = mcp
+        .send_thread_search_request(ThreadSearchParams {
+            cursor: None,
+            limit: Some(10),
+            sort_key: None,
+            sort_direction: None,
+            source_kinds: None,
+            archived: None,
+            search_term: term.to_string(),
+        })
+        .await?;
+    let ThreadSearchResponse { data, .. } =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(request_id)).await??;
+    Ok(data.into_iter().map(|result| result.thread.id).collect())
+}
+
+async fn start(codex_home: &std::path::Path) -> Result<TestAppServer> {
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home)
+        .build()
+        .await?;
+    let initialized = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.initialize_with_capabilities(
+            ClientInfo {
+                name: "test-client".to_string(),
+                title: None,
+                version: "0.1.0".to_string(),
+            },
+            Some(InitializeCapabilities {
+                explicit_gateway_oauth: false,
+                experimental_api: true,
+                request_attestation: false,
+                opt_out_notification_methods: None,
+                mcp_server_openai_form_elicitation: false,
+                extensions: None,
+            }),
+        ),
+    )
+    .await??;
+    assert!(matches!(initialized, JSONRPCMessage::Response(_)));
+    Ok(mcp)
+}
diff --git a/codex-rs/cli/src/mod_supervisor.rs b/codex-rs/cli/src/mod_supervisor.rs
new file mode 100644
index 000000000..b67d78d32
--- /dev/null
+++ b/codex-rs/cli/src/mod_supervisor.rs
@@ -0,0 +1,95 @@
+use std::io;
+use std::io::{Read, Write};
+use std::process::Command;
+use std::process::Stdio;
+use std::time::Duration;
+use std::time::Instant;
+
+pub(crate) fn run() -> Option<io::Result<()>> {
+    let mut arguments = std::env::args_os().skip(1);
+    let request = match arguments.next()?.to_str()? {
+        "--omd-managed-service-v1" => false,
+        "--omd-managed-request-v1" => true,
+        _ => return None,
+    };
+    Some((|| {
+        let parent = arguments
+            .next()
+            .and_then(|v| v.to_str().and_then(|v| v.parse::<i32>().ok()))
+            .filter(|v| *v > 1)
+            .ok_or_else(|| io::Error::other("invalid_service_parent"))?;
+        let seconds = arguments
+            .next()
+            .and_then(|v| v.to_str().and_then(|v| v.parse::<u64>().ok()))
+            .filter(|v| (1..=86400).contains(v))
+            .ok_or_else(|| io::Error::other("invalid_service_deadline"))?;
+        let program = arguments
+            .next()
+            .ok_or_else(|| io::Error::other("missing_service_program"))?;
+        let group = unsafe { libc::getpgrp() };
+        if group != unsafe { libc::getpid() } || unsafe { libc::getppid() } != parent {
+            return Err(io::Error::other("service_requires_owned_process_group"));
+        }
+        let mut command = Command::new(program);
+        command.args(arguments);
+        if request {
+            command.stdout(Stdio::piped()).stderr(Stdio::null());
+        }
+        let mut child = command.spawn()?;
+        let receiver = if request {
+            let stdout = child
+                .stdout
+                .take()
+                .ok_or_else(|| io::Error::other("request_stdout_missing"))?;
+            let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+            std::thread::spawn(move || {
+                let mut bytes = Vec::new();
+                let result = stdout.take(32769).read_to_end(&mut bytes).map(|_| bytes);
+                let _ = sender.send(result);
+            });
+            Some(receiver)
+        } else {
+            None
+        };
+        let mut delivered = false;
+        let deadline = Instant::now() + Duration::from_secs(seconds);
+        loop {
+            let status = child.try_wait();
+            if unsafe { libc::getppid() } != parent
+                || Instant::now() >= deadline
+                || status.is_err()
+                || (!request && status.as_ref().is_ok_and(Option::is_some))
+            {
+                unsafe {
+                    libc::kill(-group, libc::SIGKILL);
+                }
+                return Err(io::Error::other("service_group_termination_failed"));
+            }
+            if request
+                && !delivered
+                && let Ok(Some(status)) = status
+            {
+                match receiver
+                    .as_ref()
+                    .expect("request output receiver")
+                    .try_recv()
+                {
+                    Ok(Ok(bytes)) if bytes.len() <= 32768 => {
+                        let output = serde_json::json!({"exit_code":status.code(),"stdout":String::from_utf8_lossy(&bytes)});
+                        writeln!(io::stdout(), "{output}")?;
+                        io::stdout().flush()?;
+                        delivered = true;
+                    }
+                    Err(std::sync::mpsc::TryRecvError::Empty) => (),
+                    _ => {
+                        unsafe {
+                            libc::kill(-group, libc::SIGKILL);
+                        }
+                        return Err(io::Error::other("service_output_limit_or_failure"));
+                    }
+                }
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    })())
+}
diff --git a/codex-rs/codex-api/src/request_observer.rs b/codex-rs/codex-api/src/request_observer.rs
new file mode 100644
index 000000000..41270872f
--- /dev/null
+++ b/codex-rs/codex-api/src/request_observer.rs
@@ -0,0 +1,170 @@
+use codex_client::EncodedJsonBody;
+use codex_client::Request;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use serde_json::Value;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+pub trait ResponseAttempt: Send + Sync {
+    /// Observes one raw event; replacing it with `Value::Null` drops it.
+    fn observe(&mut self, event: &mut Value, valid: bool) -> Result<(), TransportError>;
+    /// Raw events to deliver after the one just observed.
+    fn injected(&mut self) -> Vec<Value> {
+        Vec::new()
+    }
+    fn failed(&mut self, reason: &str);
+}
+
+pub trait ResponseObserver: Send + Sync {
+    fn prepare(
+        &self,
+        request: &mut Request,
+        body: &mut Option<EncodedJsonBody>,
+    ) -> Result<(), TransportError>;
+    fn before_send(
+        &self,
+        request: &mut Request,
+        body: Option<&EncodedJsonBody>,
+    ) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError>;
+    fn requires_observation(&self, thread: Option<&str>) -> bool {
+        let _ = thread;
+        true
+    }
+    /// Whether a required final-request policy must see every provider request.
+    fn policed(&self) -> bool {
+        false
+    }
+    /// Raw events answering an admitted request without sending it.
+    fn answer(&self, request: &Request) -> Option<Vec<Value>> {
+        let _ = request;
+        None
+    }
+}
+
+/// Marks a request whose items carry metadata the provider does not accept; it is removed after `prepare`.
+pub const STRIP_ITEM_METADATA: &str = "x-codex-strip-item-metadata";
+
+pub fn installed() -> bool {
+    OBSERVER.get().is_some()
+}
+
+pub const STREAM_CONTROL: &str = "stream_control:";
+
+pub fn stream_control_error(control: &serde_json::Value) -> TransportError {
+    TransportError::Build(format!("{STREAM_CONTROL}{control}"))
+}
+
+pub fn stream_control(message: &str) -> Option<serde_json::Value> {
+    let start = message.find(STREAM_CONTROL)? + STREAM_CONTROL.len();
+    serde_json::Deserializer::from_str(&message[start..])
+        .into_iter::<serde_json::Value>()
+        .next()?
+        .ok()
+        .filter(serde_json::Value::is_object)
+}
+
+static OBSERVER: OnceLock<Arc<dyn ResponseObserver>> = OnceLock::new();
+
+pub fn install_response_observer(observer: Arc<dyn ResponseObserver>) -> Result<(), &'static str> {
+    OBSERVER
+        .set(observer)
+        .map_err(|_| "response observer already installed")
+}
+
+pub(crate) struct ObservedStream {
+    pub response: StreamResponse,
+    pub attempt: Option<Box<dyn ResponseAttempt>>,
+}
+
+impl crate::telemetry::WithStatus for ObservedStream {
+    fn status(&self) -> http::StatusCode {
+        self.response.status
+    }
+}
+
+pub(crate) fn admit(
+    request: &mut Request,
+    body: Option<&EncodedJsonBody>,
+) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError> {
+    match OBSERVER.get() {
+        Some(observer) => observer.before_send(request, body),
+        None => Ok(None),
+    }
+}
+
+pub(crate) fn reject_policed_transport() -> Result<(), crate::error::ApiError> {
+    if OBSERVER.get().is_some_and(|observer| observer.policed()) {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy: final_request_refused: request_policy_unsupported_transport: a final-request policy is active and this provider transport cannot pass it".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn reject_unobserved_transport(
+    headers: &http::HeaderMap,
+) -> Result<(), crate::error::ApiError> {
+    reject_policed_transport()?;
+    let thread = headers
+        .get("thread-id")
+        .and_then(|value| value.to_str().ok());
+    if OBSERVER
+        .get()
+        .is_some_and(|observer| observer.requires_observation(thread))
+    {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy requires observed HTTP Responses transport".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn reject_websocket_transport() -> Result<(), crate::error::ApiError> {
+    if OBSERVER.get().is_some() {
+        return Err(crate::error::ApiError::InvalidRequest {
+            message: "local OMD request policy requires observed HTTP Responses transport".into(),
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn prepare(
+    request: &mut Request,
+    body: &mut Option<EncodedJsonBody>,
+) -> Result<(), TransportError> {
+    if let Some(observer) = OBSERVER.get() {
+        observer.prepare(request, body)?;
+    }
+    if request.headers.remove(STRIP_ITEM_METADATA).is_some()
+        && let Some(encoded) = body.as_ref()
+    {
+        let build = |error: serde_json::Error| TransportError::Build(error.to_string());
+        let mut value: Value = serde_json::from_slice(encoded.as_bytes()).map_err(build)?;
+        for item in value["input"].as_array_mut().into_iter().flatten() {
+            if let Some(item) = item.as_object_mut() {
+                item.remove("internal_chat_message_metadata_passthrough");
+            }
+        }
+        *body = Some(EncodedJsonBody::encode(&value).map_err(build)?);
+    }
+    Ok(())
+}
+
+pub(crate) fn answer(request: &Request) -> Option<StreamResponse> {
+    let events = OBSERVER.get()?.answer(request)?;
+    let chunks = events
+        .into_iter()
+        .map(|event| Ok(bytes::Bytes::from(format!("data: {event}\n\n"))))
+        .collect::<Vec<_>>();
+    let mut headers = http::HeaderMap::new();
+    headers.insert(
+        http::header::CONTENT_TYPE,
+        http::HeaderValue::from_static("text/event-stream"),
+    );
+    Some(StreamResponse {
+        status: http::StatusCode::OK,
+        headers,
+        bytes: Box::pin(futures::stream::iter(chunks)),
+    })
+}
diff --git a/codex-rs/codex-api/tests/policed_transport.rs b/codex-rs/codex-api/tests/policed_transport.rs
