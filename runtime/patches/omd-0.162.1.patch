+        let manager = KernelManager::new();
+        let cell_id = CellId::new("csv-chart-cell".into());
+        let tools = vec![
+            tool("exec_command"),
+            tool("write_stdin"),
+            tool("audit_probe"),
+            definition(&kernels),
+        ];
+        let call = |language: &str, code: &str| CodeModeNestedToolCall {
+            cell_id: cell_id.clone(),
+            runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+            tool_name: ToolName::plain("kernel"),
+            tool_kind: CodeModeToolKind::Function,
+            input: Some(json!({"kernel": language, "code": code})),
+        };
+        let first = manager.run(
+            Arc::clone(&session), Arc::clone(&step), runtime.clone(),
+            call("python", "import csv, io, json\nr = json.loads(tool('audit_probe', {}))\nvalues = [int(row['total']) for row in csv.DictReader(io.StringIO(r['csv']))]\nprint(json.dumps(values))"),
+            tools.clone(), CancellationToken::new(),
+        ).await.unwrap();
+        assert_eq!(first["ok"], true);
+        assert_eq!(first["output"], "[2, 4, 3]\n");
+        let second = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call(
+                    "python",
+                    "json.loads(tool('audit_probe', {})); print(sum(values))",
+                ),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(second["ok"], true);
+        assert_eq!(second["output"], "9\n");
+        let bun_code = format!(
+            "globalThis.values={}; console.log('<svg>'+values.map(v=>'<rect height=\\\"'+(v*10)+'\\\"/>').join('')+'</svg>')",
+            first["output"].as_str().unwrap().trim(),
+        );
+        let chart = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call("bun", &bun_code),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(chart["ok"], true);
+        assert_eq!(
+            chart["output"].as_str().unwrap().matches("<rect").count(),
+            3
+        );
+        let bun_state = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call("bun", "JSON.parse(await tool('audit_probe', {})); console.log(values.reduce((a,b)=>a+b,0))"),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(bun_state["output"], "9\n");
+        let cancellation = CancellationToken::new();
+        let stop = cancellation.clone();
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            stop.cancel();
+        });
+        let interrupted = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime,
+                call("python", "import time; time.sleep(10)"),
+                tools,
+                cancellation,
+            )
+            .await;
+        assert!(interrupted.is_err());
+        assert!(!manager.live.lock().unwrap().contains_key("python"));
+        manager.shutdown(&session).await;
+        assert!(!manager.has_workers());
+    }
+}
diff --git a/codex-rs/core/src/tools/invoker.rs b/codex-rs/core/src/tools/invoker.rs
new file mode 100644
index 000000000..f0636d445
--- /dev/null
+++ b/codex-rs/core/src/tools/invoker.rs
@@ -0,0 +1,212 @@
+use std::sync::Arc;
+use std::sync::Weak;
+
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ToolCheckOutcome;
+use codex_extension_api::ToolInvocationOutcome;
+use codex_extension_api::ToolInvocationRequest;
+use codex_extension_api::ToolInvoker;
+use codex_protocol::ToolName;
+use tokio_util::sync::CancellationToken;
+
+use crate::guardian::GuardianReviewContext;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::tools::approvals::ApprovalContext;
+use crate::tools::context::SharedTurnDiffTracker;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::parallel::ToolCallRuntime;
+use crate::tools::router::ToolCall;
+use crate::tools::router::ToolCallSource;
+use crate::tools::sandboxing::ExecApprovalRequirement;
+use codex_extension_api::ApprovalGate;
+
+fn payload(arguments: serde_json::Value) -> Result<ToolPayload, String> {
+    match arguments {
+        serde_json::Value::String(input) => Ok(ToolPayload::Custom { input }),
+        serde_json::Value::Object(arguments) => Ok(ToolPayload::Function {
+            arguments: serde_json::Value::Object(arguments).to_string(),
+        }),
+        _ => Err("tool_arguments_invalid".to_owned()),
+    }
+}
+
+/// Runs extension-requested tool calls through the current step's ordinary dispatch.
+pub(crate) struct TurnToolInvoker {
+    pub(crate) session: Weak<Session>,
+    pub(crate) step_context: Arc<StepContext>,
+    pub(crate) tracker: SharedTurnDiffTracker,
+    pub(crate) cancellation: CancellationToken,
+    pub(crate) execution: Arc<tokio::sync::RwLock<()>>,
+}
+
+impl TurnToolInvoker {
+    async fn current(&self) -> Result<Arc<Session>, String> {
+        self.session
+            .upgrade()
+            .filter(|_| !self.cancellation.is_cancelled())
+            .ok_or_else(|| {
+                "tools_unavailable: the turn that published this tool dispatch has ended".into()
+            })
+    }
+
+    fn tool_name(&self, tool: &str) -> Option<ToolName> {
+        self.step_context
+            .tool_router
+            .resolve_tool_name(ToolName::plain(tool))
+    }
+}
+
+impl ToolInvoker for TurnToolInvoker {
+    fn invoke<'a>(
+        &'a self,
+        request: ToolInvocationRequest,
+    ) -> ExtensionFuture<'a, Result<ToolInvocationOutcome, String>> {
+        Box::pin(async move {
+            let session = self.current().await?;
+            let tool_name = self
+                .tool_name(&request.tool)
+                .ok_or_else(|| format!("tool_unavailable: {}", request.tool))?;
+            let payload = payload(request.arguments)?;
+            let call = ToolCall {
+                tool_name,
+                call_id: request.call_id.clone(),
+                payload,
+                encrypted_function_args: None,
+            };
+            let runtime = ToolCallRuntime::new(
+                Arc::clone(&session),
+                Arc::clone(&self.step_context),
+                Arc::clone(&self.tracker),
+            );
+            let runtime = match request.serialized {
+                true => runtime.sharing(Arc::clone(&self.execution)),
+                false => runtime,
+            };
+            let result = runtime
+                .handle_tool_call_with_source(
+                    Arc::clone(&self.step_context),
+                    call,
+                    ToolCallSource::Direct,
+                    self.cancellation.child_token(),
+                    Arc::default(),
+                )
+                .await;
+            Ok(match result {
+                Ok(result) => {
+                    let success = result.result.success_for_logging();
+                    ToolInvocationOutcome {
+                        output: super::lifecycle::response_text(
+                            result
+                                .result
+                                .to_response_item(&result.call_id, &result.payload),
+                        )
+                        .unwrap_or_else(|| "[media output]".to_owned()),
+                        success,
+                    }
+                }
+                Err(error) => ToolInvocationOutcome {
+                    output: error.to_string(),
+                    success: false,
+                },
+            })
+        })
+    }
+
+    fn check<'a>(
+        &'a self,
+        tool: &'a str,
+        arguments: serde_json::Value,
+    ) -> ExtensionFuture<'a, Result<ToolCheckOutcome, String>> {
+        Box::pin(async move {
+            let session = self.current().await?;
+            let Some(tool_name) = self.tool_name(tool) else {
+                return Ok(ToolCheckOutcome {
+                    decision: "deny",
+                    reason: Some(format!("no tool named {tool} in this turn")),
+                    authority: "host",
+                });
+            };
+            let Some(runtime) = self.step_context.tool_router.tool_runtime(&tool_name) else {
+                return Err(format!("tool_unavailable: {tool}"));
+            };
+            let invocation = ToolInvocation {
+                session: Arc::clone(&session),
+                turn: Arc::clone(&self.step_context.turn),
+                step_context: Arc::clone(&self.step_context),
+                cancellation_token: self.cancellation.child_token(),
+                tracker: Arc::clone(&self.tracker),
+                call_id: format!("check-{}", uuid::Uuid::new_v4()),
+                tool_name,
+                source: ToolCallSource::Direct,
+                payload: payload(arguments)?,
+            };
+            let Some(assessment) = runtime.assess(&invocation) else {
+                return Ok(ToolCheckOutcome {
+                    decision: "allow",
+                    reason: Some(format!("{tool} has no approval step")),
+                    authority: "host",
+                });
+            };
+            let assessment = assessment.await?;
+            let (decision, reason, host_decision) = match assessment.requirement {
+                ExecApprovalRequirement::Skip { .. } => ("allow", None, "skip"),
+                ExecApprovalRequirement::NeedsApproval { reason, .. } => ("ask", reason, "ask"),
+                ExecApprovalRequirement::Forbidden { reason } => {
+                    ("deny", Some(reason), "forbidden")
+                }
+            };
+            let host = ToolCheckOutcome {
+                decision,
+                reason,
+                authority: "host",
+            };
+            let Some(action) = assessment
+                .action
+                .filter(|_| host_decision != "forbidden" || assessment.overridable)
+            else {
+                return Ok(host);
+            };
+            let context = ApprovalContext {
+                review_context: GuardianReviewContext::from(&self.step_context),
+                cancellation_token: Some(invocation.cancellation_token.clone()),
+                call_id: invocation.call_id.clone(),
+                tool_name: invocation.tool_name.clone(),
+                strict_auto_review: false,
+                approval_reason: None,
+                retry_reason: None,
+                network_approval_context: None,
+            };
+            let mod_verdict = |decision, reason| ToolCheckOutcome {
+                decision,
+                reason: Some(reason),
+                authority: "mod",
+            };
+            Ok(
+                match super::approval_gate::gate_with(
+                    &session,
+                    &action,
+                    &context,
+                    host_decision,
+                    /*assessment*/ true,
+                )
+                .await
+                {
+                    ApprovalGate::Deny(reason) => mod_verdict("deny", reason),
+                    ApprovalGate::Ask(reason) if host_decision != "forbidden" => {
+                        mod_verdict("ask", reason)
+                    }
+                    ApprovalGate::Approve(reason) if host_decision != "skip" => {
+                        mod_verdict("allow", reason)
+                    }
+                    _ => host,
+                },
+            )
+        })
+    }
+}
+
