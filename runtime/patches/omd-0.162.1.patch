+        codex_omd::intercept_shared(
+            &runtime,
+            surface,
+            false,
+            input,
+            json!({"caller":"engine"}),
+            || true,
+            |_, _| Err(std::io::Error::other("unexpected host call")),
+            |input| Ok(core(input)),
+        )
+        .unwrap()
+    };
+    let request = run(
+        "model_request",
