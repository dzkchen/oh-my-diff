+#[test]
+#[serial_test::serial]
+fn raster_cadence_recovers_small_delays_without_catching_up_after_stalls() {
+    let start = Instant::now();
+    let key = "raster-cadence";
+    for glyph in ["a", "b", "c", "d"] {
+        blit_at(
+            key,
+            "owner",
+            json!({"rect":{"x":0,"y":0,"width":1,"height":1},"cells":[glyph]}),
+            start,
+        )
+        .unwrap();
+    }
+    let draw = |millis| {
+        super::rows(
+            key,
+            Some("owner"),
+            "chart",
+            4,
+            (4, 2),
+            false,
+            "",
+            start + Duration::from_millis(millis),
+        )
+    };
+    assert_eq!(draw(0).1, Some(FRAME));
+    let (rows, next) = draw(20);
