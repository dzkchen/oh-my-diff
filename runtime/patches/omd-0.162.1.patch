+/// Fits the image into `width`×`height` cells of `cell` pixels, keeping its aspect ratio.
+pub(crate) fn fit(image: (u32, u32), width: u16, height: u16, cell: (u16, u16)) -> (u16, u16) {
+    let (cell_width, cell_height) = (f64::from(cell.0), f64::from(cell.1));
+    let scale = (f64::from(width) * cell_width / f64::from(image.0.max(1)))
+        .min(f64::from(height) * cell_height / f64::from(image.1.max(1)));
+    let cells = |pixels: u32, cell: f64, limit: u16| {
+        ((f64::from(pixels) * scale / cell).round() as u16).clamp(1, limit)
+    };
+    (
+        cells(image.0, cell_width, width),
+        cells(image.1, cell_height, height),
+    )
+}
+
+/// The transmitted size of a placement: both sides scaled together to stay within 2048 pixels.
+pub(crate) fn kitty_pixels(columns: u16, rows: u16, cell: (u16, u16)) -> (u32, u32) {
+    let (width, height) = (
+        u32::from(columns) * u32::from(cell.0),
+        u32::from(rows) * u32::from(cell.1),
+    );
+    let scale = (2048.0 / f64::from(width.max(height))).min(1.0);
+    let scaled = |pixels: u32| ((f64::from(pixels) * scale).round() as u32).max(1);
+    (scaled(width), scaled(height))
+}
