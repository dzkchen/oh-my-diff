+        let token = &text[range.start..cursor];
+        let first_line = &text[..text.find('\n').unwrap_or(text.len())];
+        if let Some(name_end) = first_line
+            .strip_prefix('/')
+            .and_then(|line| line.find(char::is_whitespace))
+            .map(|end| end + 1)
+            && cursor > name_end
+            && cursor <= first_line.len()
+            && crate::mod_surface::completes_arguments(&first_line[1..name_end])
+        {
+            return Some((
+                range,
+                token.to_owned(),
+                serde_json::json!({"kind": "argument", "command": &first_line[1..name_end],
+                    "query": token, "line": first_line[name_end..cursor].trim_start()}),
+            ));
+        }
+        let trigger = token.chars().next().filter(char::is_ascii_punctuation)?;
+        crate::mod_surface::trigger_owner(trigger)?;
+        Some((
+            range,
+            token.to_owned(),
+            serde_json::json!({"kind": "token", "trigger": trigger.to_string(),
+                "query": &token[trigger.len_utf8()..], "line": &text[line_start..cursor]}),
+        ))
+    }
+
+    /// The whitespace-delimited token containing `cursor`, which a completion replaces whole.
+    fn token_around(text: &str, cursor: usize) -> Range<usize> {
+        let start = text[..cursor]
+            .char_indices()
+            .rfind(|(_, c)| c.is_whitespace())
+            .map_or(0, |(index, c)| index + c.len_utf8());
+        let end = text[cursor..]
+            .find(char::is_whitespace)
+            .map_or(text.len(), |offset| cursor + offset);
+        start..end
+    }
