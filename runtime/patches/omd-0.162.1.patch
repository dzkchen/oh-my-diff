+#[test]
+#[serial_test::serial]
+fn markdown_cache_keeps_every_block_of_a_many_block_frame() {
+    let texts = (0..24)
+        .map(|block| format!("# Block {block} of markdown_cache_keeps_every_block\n\nbody"))
+        .collect::<Vec<_>>();
+    for text in &texts {
+        markdown_lines(text, 40);
+    }
+    let hashes = texts
+        .iter()
+        .map(|text| {
+            use std::hash::Hash;
+            use std::hash::Hasher;
+            let mut hasher = std::collections::hash_map::DefaultHasher::new();
+            text.hash(&mut hasher);
+            hasher.finish()
+        })
+        .collect::<BTreeSet<_>>();
+    let cached = MARKDOWN
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .iter()
+        .filter(|((hash, width, ..), _, _)| *width == 40 && hashes.contains(hash))
+        .count();
+    assert_eq!(cached, texts.len());
+}
