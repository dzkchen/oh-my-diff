+#[test]
+fn command_results_require_the_current_context_and_sequence() {
+    let thread_a = ThreadId::new();
+    let thread_b = ThreadId::new();
+    let context = |thread_id, repository| ModContext {
+        thread_id: Some(thread_id),
+        repository: PathBuf::from(repository),
+        policy: FileSystemSandboxPolicy::unrestricted(),
+    };
+    let a = context(thread_a, "/tmp/repository-a");
+    let b = context(thread_b, "/tmp/repository-b");
+    let mut active = ActiveContext::default();
+    let first = active.begin(a.clone());
+    assert!(active.current(&first));
+    let second = active.begin(a.clone());
+    assert!(!active.current(&first));
+    assert!(active.current(&second));
+    let nested = active.join(a.clone());
+    assert!(
+        active.current(&second) && active.current(&nested),
+        "a nested command shares its caller's invocation"
+    );
+    assert!(active.synchronize(b));
+    assert!(!active.current(&second));
+    assert!(active.synchronize(a.clone()));
+    assert!(!active.current(&second));
+    let mut changed_permissions = a;
+    changed_permissions.policy = FileSystemSandboxPolicy {
+        kind: codex_protocol::permissions::FileSystemSandboxKind::Restricted,
+        glob_scan_max_depth: None,
+        entries: Vec::new(),
+    };
+    let before_permissions = active.begin(changed_permissions.clone());
+    assert!(active.current(&before_permissions));
+    changed_permissions.policy = FileSystemSandboxPolicy::unrestricted();
+    assert!(active.synchronize(changed_permissions));
+    assert!(!active.current(&before_permissions));
+}
