+fn surface_package() -> (tempfile::TempDir, codex_omd::ModStore, String) {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let package = root.join("package");
+    std::fs::create_dir(&package).unwrap();
+    std::fs::write(package.join("mod.json"), serde_json::to_vec(&json!({"schema": 1, "id": "surface_fixture", "version": "1.0.0", "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": ["packages"]})).unwrap()).unwrap();
+    std::fs::write(package.join("index.ts"), "export default () => {};").unwrap();
+    let store = codex_omd::ModStore::create(
+        root.join("store"),
+        PathBuf::from(std::env::var_os("OMD_TEST_NODE").unwrap()),
+    )
+    .unwrap();
+    let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+    let source = inspected["sha256"].as_str().unwrap().to_owned();
+    store
+        .trust(package.clone(), &source, vec!["packages".into()], "user")
+        .unwrap();
+    store.enable(&package, true).unwrap();
+    let runtime = codex_omd::ModHost::open(root.join("store")).unwrap();
+    std::fs::write(
+        root.join("store/mod-status.json"),
+        serde_json::to_vec(&runtime.status()).unwrap(),
+    )
+    .unwrap();
+    (directory, store, source)
+}
