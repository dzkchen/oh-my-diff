+            ] {
+                let (mut composer, mut rx) = new_test_composer();
+                composer.set_text_content(draft.into(), Vec::new(), Vec::new());
+                composer.draft.textarea.set_cursor(draft.len());
+                composer.sync_popups();
+                assert_eq!(composer.mod_argument_token().unwrap().1, query);
+                let matches = || {
+                    vec![FileMatch {
+                        score: 1,
+                        path: PathBuf::from(selected),
+                        match_type: codex_file_search::MatchType::File,
+                        root: PathBuf::from("/tmp"),
+                        indices: None,
+                    }]
+                };
+                composer.on_file_search_result(query.into(), matches());
+                assert!(matches!(composer.popups.active, ActivePopup::File(_)));
+                while rx.try_recv().is_ok() {}
+                let _ = composer.handle_key_event(KeyEvent::new(key, KeyModifiers::NONE));
