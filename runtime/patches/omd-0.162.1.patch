+fn pax_size_applies_to_the_file_after_a_gnu_longname() {
+    let mut builder = tar::Builder::new(Vec::new());
+    builder
+        .append_pax_extensions([("size", b"5".as_slice())])
+        .expect("append PAX size");
+    let name = b"plugin.json\0";
+    let mut header = tar::Header::new_gnu();
+    header.set_mode(0o644);
+    header.set_path("././@LongLink").expect("longname path");
+    header.set_entry_type(tar::EntryType::GNULongName);
+    header.set_size(name.len() as u64);
+    header.set_cksum();
+    builder.append(&header, &name[..]).expect("append longname");
+    header.set_path("plugin").expect("file path");
+    header.set_entry_type(tar::EntryType::Regular);
+    header.set_size(5);
+    header.set_cksum();
+    builder.append(&header, &b"hello"[..]).expect("append file");
+    let bytes = builder.into_inner().expect("finish archive");
+    let destination = tempdir().expect("destination tempdir");
+    unpack_plugin_bundle_tar(&mut Archive::new(&bytes[..]), destination.path(), 5)
+        .expect("unpack extended archive");
+    assert_eq!(
+        fs::read(destination.path().join("plugin.json")).unwrap(),
+        b"hello"
+    );
+}
