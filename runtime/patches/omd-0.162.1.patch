+#[test]
+#[serial_test::serial]
+fn raw_raster_admission_precedes_snapshot() {
+    retain(&BTreeSet::new());
+    let source = json!({"source":"owned", "format":"rgb", "width":1, "height":1, "sequence":1});
+    let now = Instant::now();
+    for size in [None, Some((0, 0))] {
+        assert!(
+            blit(
+                "owner",
+                Some("owner".into()),
+                size,
+                &json!({"key":"hidden", "pixels":source}),
+                now,
+                |_, _| panic!("snapshot before layout admission")
+            )
+            .is_err()
+        );
+    }
+    for n in 0..RASTERS_PER_MOD {
+        rasters().insert(format!("occupied-{n}"), Raster::new("owner", 4, 2));
+    }
+    assert_eq!(
+        blit(
+            "owner",
+            Some("owner".into()),
+            Some((4, 2)),
+            &json!({"key":"overflow", "pixels":source}),
+            now,
+            |_, _| panic!("snapshot before capacity admission")
+        ),
+        Err(codex_omd::client_surface::BlitError::retryable("terminal_blit_limit"))
+    );
+    retain(&BTreeSet::new());
+    let mut snapshots = 0;
+    blit(
+        "owner",
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key":"admitted", "pixels":source}),
+        now,
+        |_, _| {
+            snapshots += 1;
+            assert!(
+                RASTERS.try_lock().is_ok(),
+                "the copy runs outside the raster lock"
+            );
+            Ok(std::sync::Arc::new(
+                codex_omd::process_raster::PixelFrame::new(
+                    serde_json::from_value(source.clone()).unwrap(),
+                    image::DynamicImage::new_rgb8(1, 1),
+                ),
+            ))
+        },
+    )
+    .unwrap();
+    assert_eq!(snapshots, 1);
+    retain(&BTreeSet::new());
+}
+
+fn raw_at(key: &str, sequence: u64, now: Instant, next: Option<Instant>) -> Result<Value, codex_omd::client_surface::BlitError> {
+    let source =
+        json!({"source":"owned", "format":"rgb", "width":1, "height":1, "sequence":sequence});
+    blit(
+        "owner",
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key":key, "pixels":source}),
+        now,
+        |source, due| {
+            assert_eq!(
+                Some(due),
+                next,
+                "a frame waiting for its tick is not copied, and the next one is due a tick after this one shows"
+            );
+            Ok(std::sync::Arc::new(
+                codex_omd::process_raster::PixelFrame::new(
+                    source.clone(),
+                    image::DynamicImage::new_rgb8(1, 1),
+                ),
+            ))
+        },
+    )
+}
