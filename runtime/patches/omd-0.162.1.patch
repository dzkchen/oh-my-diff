+    admin.administer(policy.clone(), "alice");
+    let mut unavailable = policy.clone();
+    unavailable["packages"].as_array_mut().unwrap().push(entry(
+        "remote",
+        Path::new(UNREACHABLE),
+        &guard_sha,
+        json!({}),
+    ));
