+        )
+        .await
+        .expect("rewrite with witness");
+    fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect("intact history verifies");
+
+    let log = log_path(&fixture.store, fixture.thread_id);
+    let orphan = ThreadId::new();
+    append_record(
+        &log,
+        Some(witness.as_ref()),
+        &Record::Begin {
+            revision: orphan,
+            previous: orphan,
+            undo: false,
+            author: "crashed".to_string(),
+            at_ms: 0,
+            sources: Vec::new(),
+            written: 0,
+            source_forked_from_ordinal_exclusive: None,
+            source_subagent_history_start_ordinal: None,
+            edits: Vec::new(),
+        },
+    )
+    .expect("write interrupted begin");
+    fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect("interrupted rewrite is aborted");
+    assert!(
+        std::fs::read_to_string(&log)
+            .expect("read log")
+            .ends_with(&format!(
+                "{{\"kind\":\"abort\",\"revision\":\"{orphan}\"}}\n"
+            ))
+    );
+
+    let tampered = std::fs::read_to_string(&log)
+        .expect("read log")
+        .replace("mod:redactor", "someone-else");
+    std::fs::write(&log, tampered).expect("tamper log");
+    let err = fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(Arc::clone(&witness)))
+        .await
+        .expect_err("tampered log fails");
+    assert!(err.to_string().contains("history_anchor_mismatch"), "{err}");
+    let err = fixture
+        .store
+        .rewrite_thread(RewriteThreadParams {
+            thread_id: fixture.thread_id,
+            expected_revision: Some(fixture.read().await.revision),
+            edits: Vec::new(),
+            undo: true,
+            author: "mod:redactor".to_string(),
+            multi_agent_version: None,
+            witness: Some(Arc::clone(&witness)),
+            dry_run: true,
+        })
+        .await
+        .expect_err("a dry run refuses the tampered log too");
+    assert!(err.to_string().contains("history_anchor_mismatch"), "{err}");
+
+    std::fs::write(
+        &log,
+        std::fs::read_to_string(&log)
+            .unwrap()
+            .replace("someone-else", "mod:redactor"),
+    )
+    .expect("restore log");
+    let original = std::fs::read_to_string(&fixture.original).expect("read original");
+    std::fs::write(&fixture.original, original.replace("SECRET-1", "SECRET-2"))
+        .expect("forge original");
+    let err = fixture
+        .store
+        .verify_thread_history(fixture.thread_id, Some(witness))
+        .await
+        .expect_err("forged original fails");
+    assert!(
+        err.to_string().contains("history_original_mismatch"),
+        "{err}"
+    );
+}
