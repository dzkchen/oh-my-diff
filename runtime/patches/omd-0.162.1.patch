+    impl Fixture {
+        fn new() -> Self {
+            let directory = tempfile::tempdir().unwrap();
+            let repository = directory.path().canonicalize().unwrap();
+            let fixture = Self {
+                _directory: directory,
+                repository,
+                policy: FileSystemSandboxPolicy::read_only(),
