+            parameters: parameters.clone(),
+            effective: effective.map(|(parameters, deferred)| ToolInventoryView {
+                description: "d".into(),
+                parameters: parameters.clone(),
+                deferred,
+            }),
+        };
+    let replaced = json!({"type": "object"});
