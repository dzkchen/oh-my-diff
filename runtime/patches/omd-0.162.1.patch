+    )
+    .unwrap();
+    let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+    store
+        .trust(
+            package.clone(),
+            inspected["sha256"].as_str().unwrap(),
+            vec!["terminal".into()],
+            "user",
+        )
+        .unwrap();
+    store.enable(&package, true).unwrap();
+    let mut runtime = ModHost::open_in_guarded(data.clone(), |_| Ok(()), &root, &|| true).unwrap();
+    let paths = crate::omd::ModPaths {
+        repository: root.clone(),
+        evidence: data.clone(),
+        store: Some(data.clone()),
+        protected: vec![],
+    };
+    let snapshot = ModViewSnapshot {
+        input: serde_json::json!({"event":"idle","ledger":{"thread_id":"previous"}}),
+        ..Default::default()
+    };
+    std::fs::write(
+        data.join("mod-view.json"),
+        serde_json::to_vec(&snapshot).unwrap(),
+    )
+    .unwrap();
+    let thread = ThreadId::new();
+    let context = ModContext {
+        thread_id: Some(thread),
+        repository: root,
+        policy: FileSystemSandboxPolicy::unrestricted(),
+    };
+    let refreshed = preview_with(&mut runtime, &paths, &context, None, &|| true).unwrap();
+    assert!(
+        refreshed.diagnostics.is_empty(),
+        "{:?}",
+        refreshed.diagnostics
+    );
+    assert_eq!(refreshed.input["ledger"]["thread_id"], thread.to_string());
+    assert!(
+        serde_json::to_string(&refreshed.view)
+            .unwrap()
+            .contains(&thread.to_string()),
+        "view={:?} status={}",
+        refreshed.view,
+        runtime.status()
+    );
+    assert!(preview_with(&mut runtime, &paths, &context, None, &|| false).is_none());
+}
