+#[test]
+#[serial_test::serial]
+fn clipboard_surface_waits_for_matching_completion_and_cleans_cancelled_calls() {
+    let previous = state().take();
+    let make_call = || {
+        let (reply, answer) = std::sync::mpsc::sync_channel(1);
+        let caller = codex_omd::broker::HOST_CALLER.to_string();
+        let mut lifetime = codex_omd::client_surface::CallLifetime::default();
+        lifetime.binding = Some(call_binding(&caller));
+        (
+            SurfaceCall {
+                validity: codex_omd::client_surface::Validity(Arc::new(|| true)),
+                caller,
+                operation: "terminal.copy".into(),
+                arguments: json!({"text": "copy"}),
+                context: InvocationContext::User,
+                remote: false,
+                thread: None,
+                authority: None,
+                confirm: None,
+                reply,
+                lifetime,
+            },
+            answer,
+        )
+    };
+    for status in [
+        crate::clipboard_copy::CopyStatus::Confirmed,
+        crate::clipboard_copy::CopyStatus::Unconfirmed,
+    ] {
+        let (call, answer) = make_call();
+        hold_clipboard(7, call);
+        assert!(complete_clipboard(None));
+        assert!(complete_clipboard(Some((6, Ok(status)))));
+        assert!(answer.try_recv().is_err());
+        assert!(!complete_clipboard(Some((7, Ok(status)))));
+        assert_eq!(
+            answer.recv().unwrap().unwrap()["status"],
+            if status == crate::clipboard_copy::CopyStatus::Confirmed {
+                "confirmed"
+            } else {
+                "unconfirmed"
+            }
+        );
+        assert!(with(|state| state.clipboard.is_none()));
+    }
+    let (mut call, answer) = make_call();
+    call.validity = codex_omd::client_surface::Validity(Arc::new(|| false));
+    hold_clipboard(8, call);
+    assert!(!complete_clipboard(None));
+    assert_eq!(answer.recv().unwrap(), Err("client_context_changed".into()));
+    assert!(with(|state| state.clipboard.is_none()));
+    *state() = previous;
+}
