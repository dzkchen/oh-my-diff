+#[test]
+fn action_tokens_are_single_use_and_bound_to_the_view_revision() {
+    let mut view = View::default();
+    let first = view.token_for(1, 1);
+    assert_eq!(view.token_for(1, 1), first);
+    let (next, bound) = view.spend(&first).unwrap();
+    assert_eq!(bound, (1, 1));
+    assert_ne!(next, first);
+    assert!(
+        view.spend(&first)
+            .unwrap_err()
+            .message
+            .starts_with("action_replayed:")
+    );
+    let current = view.token_for(1, 2);
+    assert_ne!(current, next);
+    assert!(
+        view.spend(&next)
+            .unwrap_err()
+            .message
+            .starts_with("action_stale:")
+    );
+    assert!(
+        view.spend(&first)
+            .unwrap_err()
+            .message
+            .starts_with("action_replayed:")
+    );
+    assert!(
+        view.spend("feedface")
+            .unwrap_err()
+            .message
+            .starts_with("action_unknown:")
+    );
+    assert_eq!(current.len(), 32);
+}
