+use regex_lite::RegexBuilder;
+use std::ops::Range;
+
+pub(crate) const DOCUMENT_LINES: usize = 100_000;
+pub(crate) const FIND_MATCHES: usize = 10_000;
+const REGEX_FIND_BYTES: usize = 256 << 10;
+const REGEX_SIZE_LIMIT: usize = 16 << 10;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Find {
+    pub(crate) query: String,
+    pub(crate) regex: bool,
+    pub(crate) case: bool,
+    pub(crate) matches: Vec<(usize, usize, usize)>,
+    pub(crate) current: usize,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct DocumentView {
+    pub(crate) cursor: usize,
+    pub(crate) anchor: Option<usize>,
+    pub(crate) scroll: usize,
+    pub(crate) find: Option<Find>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum DocumentKey {
+    Up,
+    Down,
+    PageUp,
+    PageDown,
+    Top,
+    Bottom,
+    ExtendUp,
+    ExtendDown,
+    Activate,
+    FindNext,
+    FindPrevious,
+    Escape,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum DocumentEvent {
+    Select { start: usize, end: usize },
+    Activate { line: usize },
+}
+
+pub(crate) fn find_matches(
+    lines: &[String],
+    query: &str,
+    regex: bool,
+    case: bool,
+) -> Result<Vec<(usize, usize, usize)>, String> {
+    if query.is_empty() {
+        return Ok(Vec::new());
+    }
+    let pattern = if regex {
+        query.to_string()
+    } else {
+        regex_lite::escape(query)
+    };
+    let matcher = RegexBuilder::new(&pattern)
+        .case_insensitive(!case)
+        .size_limit(if regex { REGEX_SIZE_LIMIT } else { 1 << 20 })
+        .build()
+        .map_err(|error| format!("find_pattern_invalid: {error}"))?;
+    let mut found = Vec::new();
+    let mut scanned = 0;
+    for (line, text) in lines.iter().enumerate() {
+        if regex {
+            scanned += text.len() + 1;
+            if scanned > REGEX_FIND_BYTES {
+                break;
+            }
+        }
+        for hit in matcher.find_iter(text).filter(|hit| !hit.is_empty()) {
+            found.push((line, hit.start(), hit.end()));
+            if found.len() == FIND_MATCHES {
+                return Ok(found);
+            }
+        }
+    }
+    Ok(found)
+}
+
+impl DocumentView {
+    pub(crate) fn selection(&self) -> Range<usize> {
+        let anchor = self.anchor.unwrap_or(self.cursor);
+        anchor.min(self.cursor)..anchor.max(self.cursor) + 1
+    }
+
+    pub(crate) fn window(&mut self, total: usize, height: usize) -> Range<usize> {
+        let height = height.max(1);
+        self.cursor = self.cursor.min(total.saturating_sub(1));
+        if self.cursor < self.scroll {
+            self.scroll = self.cursor;
+        } else if self.cursor >= self.scroll + height {
+            self.scroll = self.cursor + 1 - height;
+        }
+        self.scroll = self.scroll.min(total.saturating_sub(height));
+        self.scroll..(self.scroll + height).min(total)
+    }
+
+    pub(crate) fn set_find(
+        &mut self,
+        lines: &[String],
+        query: &str,
+        regex: bool,
+        case: bool,
+    ) -> Result<usize, String> {
+        let matches = find_matches(lines, query, regex, case)?;
+        let current = matches
+            .iter()
+            .position(|(line, _, _)| *line >= self.cursor)
+            .unwrap_or(0);
+        if let Some((line, _, _)) = matches.get(current) {
+            self.cursor = *line;
+        }
+        let count = matches.len();
+        self.find = Some(Find {
+            query: query.to_string(),
+            regex,
+            case,
+            matches,
+            current,
+        });
+        Ok(count)
+    }
+
+    pub(crate) fn handle(
+        &mut self,
+        key: DocumentKey,
+        total: usize,
+        height: usize,
+    ) -> Option<DocumentEvent> {
+        if total == 0 {
+            return None;
+        }
+        let last = total - 1;
+        let page = height.max(1);
+        let extending = matches!(key, DocumentKey::ExtendUp | DocumentKey::ExtendDown);
+        if extending && self.anchor.is_none() {
+            self.anchor = Some(self.cursor);
+        } else if !extending && !matches!(key, DocumentKey::Activate) {
+            self.anchor = None;
+        }
+        match key {
+            DocumentKey::Up | DocumentKey::ExtendUp => self.cursor = self.cursor.saturating_sub(1),
+            DocumentKey::Down | DocumentKey::ExtendDown => {
+                self.cursor = (self.cursor + 1).min(last)
+            }
+            DocumentKey::PageUp => self.cursor = self.cursor.saturating_sub(page),
+            DocumentKey::PageDown => self.cursor = (self.cursor + page).min(last),
+            DocumentKey::Top => self.cursor = 0,
+            DocumentKey::Bottom => self.cursor = last,
+            DocumentKey::FindNext | DocumentKey::FindPrevious => {
+                let find = self.find.as_mut()?;
+                if find.matches.is_empty() {
+                    return None;
+                }
+                let count = find.matches.len();
+                find.current = if key == DocumentKey::FindNext {
+                    (find.current + 1) % count
+                } else {
+                    (find.current + count - 1) % count
+                };
+                self.cursor = find.matches[find.current].0;
+            }
+            DocumentKey::Escape => {
+                self.find = None;
+                return None;
+            }
+            DocumentKey::Activate => {
+                let range = self.selection();
+                return Some(if range.len() > 1 {
+                    DocumentEvent::Select {
+                        start: range.start,
+                        end: range.end - 1,
+                    }
+                } else {
+                    DocumentEvent::Activate { line: self.cursor }
+                });
+            }
+        }
+        if extending {
+            let range = self.selection();
+            return Some(DocumentEvent::Select {
+                start: range.start,
+                end: range.end - 1,
+            });
+        }
+        None
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum DiffKind {
+    File,
+    Hunk,
+    Added,
+    Removed,
+    Context,
+}
+
+pub(crate) fn diff_lines(unified: &str) -> Vec<(DiffKind, String, Option<String>)> {
+    let (mut file, mut old, mut new) = (String::new(), 0usize, 0usize);
+    let mut out = Vec::new();
+    for text in unified.lines().take(DOCUMENT_LINES) {
+        let (kind, anchor) = if let Some(path) = text.strip_prefix("+++ ") {
+            file = path.strip_prefix("b/").unwrap_or(path).to_string();
+            (DiffKind::File, None)
+        } else if text.starts_with("--- ")
+            || text.starts_with("diff ")
+            || text.starts_with("index ")
+        {
+            (DiffKind::File, None)
+        } else if let Some(header) = text.strip_prefix("@@ ") {
+            let mut ranges = header.split_whitespace();
+            let start = |part: Option<&str>, sign: char| {
+                part.and_then(|p| p.strip_prefix(sign))
+                    .and_then(|p| p.split(',').next())
+                    .and_then(|n| n.parse::<usize>().ok())
+                    .unwrap_or(0)
+            };
+            old = start(ranges.next(), '-');
+            new = start(ranges.next(), '+');
+            (DiffKind::Hunk, None)
+        } else if text.starts_with('+') {
+            new += 1;
+            (DiffKind::Added, Some(format!("{file}:+{}", new - 1)))
+        } else if text.starts_with('-') {
+            old += 1;
+            (DiffKind::Removed, Some(format!("{file}:-{}", old - 1)))
+        } else {
+            old += 1;
+            new += 1;
+            (DiffKind::Context, Some(format!("{file}:+{}", new - 1)))
+        };
+        out.push((kind, text.to_string(), anchor));
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn lines(texts: &[&str]) -> Vec<String> {
+        texts.iter().map(ToString::to_string).collect()
+    }
+
+    #[test]
+    fn find_supports_literal_regex_and_case() {
+        let text = lines(&["Foo bar", "foo.baz", "qux"]);
+        assert_eq!(
+            find_matches(&text, "foo", false, false).unwrap(),
+            [(0, 0, 3), (1, 0, 3)]
+        );
+        assert_eq!(
+            find_matches(&text, "foo", false, true).unwrap(),
+            [(1, 0, 3)]
+        );
+        assert_eq!(find_matches(&text, ".", false, true).unwrap(), [(1, 3, 4)]);
+        assert_eq!(
+            find_matches(&text, "ba[rz]", true, true).unwrap(),
+            [(0, 4, 7), (1, 4, 7)]
+        );
+        assert!(find_matches(&text, "(", true, true).is_err());
+        assert_eq!(find_matches(&text, "", false, true).unwrap(), []);
+    }
+
+    #[test]
+    fn regex_find_scans_a_bounded_prefix_and_rejects_oversized_patterns() {
+        let mut text = vec!["a".repeat(1023); 2047];
+        text.push("needle".into());
+        let hits = find_matches(&text, "a+b?", true, true).unwrap();
+        assert_eq!(hits.last().map(|hit| hit.0), Some(255));
+        assert_eq!(find_matches(&text, "needle", true, true).unwrap(), []);
+        assert_eq!(
+            find_matches(&text, "needle", false, true).unwrap(),
+            [(2047, 0, 6)]
+        );
+        assert!(
+            find_matches(&text, "(?:a{1,100}){1,100}", true, true)
+                .unwrap_err()
+                .starts_with("find_pattern_invalid")
+        );
+    }
+
+    #[test]
+    fn window_keeps_the_cursor_visible() {
+        let mut view = DocumentView::default();
+        assert_eq!(view.window(100, 10), 0..10);
+        view.cursor = 25;
+        assert_eq!(view.window(100, 10), 16..26);
+        view.cursor = 3;
+        assert_eq!(view.window(100, 10), 3..13);
+        view.cursor = 500;
+        assert_eq!((view.window(100, 10), view.cursor), (90..100, 99));
+        assert_eq!(DocumentView::default().window(3, 10), 0..3);
+    }
+
+    #[test]
+    fn extending_selects_ranges_and_activate_reports_them() {
+        let mut view = DocumentView {
+            cursor: 5,
+            ..Default::default()
+        };
+        assert_eq!(
+            view.handle(DocumentKey::ExtendDown, 20, 5),
+            Some(DocumentEvent::Select { start: 5, end: 6 })
+        );
+        assert_eq!(
+            view.handle(DocumentKey::ExtendDown, 20, 5),
+            Some(DocumentEvent::Select { start: 5, end: 7 })
+        );
+        assert_eq!(
+            view.handle(DocumentKey::Activate, 20, 5),
+            Some(DocumentEvent::Select { start: 5, end: 7 })
+        );
+        assert_eq!(view.handle(DocumentKey::Down, 20, 5), None);
+        assert_eq!((view.anchor, view.cursor), (None, 8));
+        assert_eq!(
+            view.handle(DocumentKey::Activate, 20, 5),
+            Some(DocumentEvent::Activate { line: 8 })
+        );
+        view.handle(DocumentKey::Bottom, 20, 5);
+        view.handle(DocumentKey::Down, 20, 5);
+        assert_eq!(view.cursor, 19);
+        assert_eq!(
+            DocumentView::default().handle(DocumentKey::Down, 0, 5),
+            None
+        );
+    }
+
+    #[test]
+    fn find_navigation_cycles_through_matches() {
+        let text = lines(&["a", "x", "a", "a"]);
+        let mut view = DocumentView {
+            cursor: 1,
+            ..Default::default()
+        };
+        assert_eq!(view.set_find(&text, "a", false, true).unwrap(), 3);
+        assert_eq!(view.cursor, 2);
+        view.handle(DocumentKey::FindNext, 4, 2);
+        assert_eq!(view.cursor, 3);
+        view.handle(DocumentKey::FindNext, 4, 2);
+        assert_eq!(view.cursor, 0);
+        view.handle(DocumentKey::FindPrevious, 4, 2);
+        assert_eq!(view.cursor, 3);
+        view.handle(DocumentKey::Escape, 4, 2);
+        assert_eq!(view.find, None);
+    }
+
+    #[test]
+    fn diff_lines_carry_file_and_line_anchors() {
+        let diff = "diff --git a/src/a.rs b/src/a.rs\n--- a/src/a.rs\n+++ b/src/a.rs\n@@ -10,3 +10,4 @@ fn x\n ctx\n-old\n+new\n+more\n";
+        let parsed = diff_lines(diff);
+        let summary: Vec<_> = parsed
+            .iter()
+            .map(|(kind, _, anchor)| (*kind, anchor.clone()))
+            .collect();
+        assert_eq!(
+            summary,
+            [
+                (DiffKind::File, None),
+                (DiffKind::File, None),
+                (DiffKind::File, None),
+                (DiffKind::Hunk, None),
+                (DiffKind::Context, Some("src/a.rs:+10".into())),
+                (DiffKind::Removed, Some("src/a.rs:-11".into())),
+                (DiffKind::Added, Some("src/a.rs:+11".into())),
+                (DiffKind::Added, Some("src/a.rs:+12".into())),
+            ]
+        );
+    }
+}
