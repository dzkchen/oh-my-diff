+fn inline_png(
+    pixels: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> Option<Vec<u8>> {
+    let _stage = codex_omd::frame_metrics::stage("iip_encode");
+    codex_omd::process_raster::encode(
+        pixels,
+        placed_size(pixels, columns, rows, cell),
+        /*jpeg*/ false,
+    )
+}
+
+fn placement_pixels(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> crate::mod_client::Pixels {
+    let _stage = codex_omd::frame_metrics::stage("placement_pixels");
+    let decoded = placed(decoded, columns, rows, cell);
+    let translucent = decoded
+        .color()
+        .has_alpha()
+        .then(|| decoded.to_rgba8())
+        .filter(|rgba| rgba.pixels().any(|pixel| pixel[3] < u8::MAX));
+    crate::mod_client::Pixels {
+        alpha: translucent.is_some(),
+        bytes: translucent.map_or_else(|| decoded.to_rgb8().into_raw(), image::RgbaImage::into_raw),
+        width: decoded.width(),
+        height: decoded.height(),
+    }
+}
+
+/// The pixel size of a PNG or JPEG from its header alone, within the limits `decode_image` enforces.
+pub(crate) fn dimensions(bytes: &[u8]) -> Option<(u32, u32)> {
+    let reader = image::ImageReader::new(std::io::Cursor::new(bytes))
+        .with_guessed_format()
+        .ok()?;
+    let (width, height) = reader
+        .format()
+        .filter(|format| matches!(format, image::ImageFormat::Png | image::ImageFormat::Jpeg))
+        .and_then(|_| reader.into_dimensions().ok())?;
+    (bytes.len() <= 8 * 1024 * 1024 && width.max(height) <= codex_omd::client_surface::IMAGE_PIXELS)
+        .then_some((width, height))
+}
