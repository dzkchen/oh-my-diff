+            width: 1,
+            height: 1,
+            sequence: 1,
+        };
+        std::fs::write(&path, [1, 2, 3]).unwrap();
+        let released = || PIXELS.lock().unwrap()[&handle].lock().unwrap().released;
+        let frame = crate::client_surface::BLIT_FRAME;
+        let snap = |source: &PixelSource, next| {
+            snapshot(
+                Some("paced-thread"),
+                "paced-owner",
+                "paced-frame",
+                source.clone(),
+                next,
+            )
+        };
+        let next = Instant::now() + frame * 3;
