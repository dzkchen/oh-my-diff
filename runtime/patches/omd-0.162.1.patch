+pub(crate) fn terminal_event(event: &'static str, payload: Value) {
+    static QUEUE: std::sync::OnceLock<std::sync::mpsc::Sender<(&'static str, Value)>> =
+        std::sync::OnceLock::new();
+    if registered(event) {
+        let queue = QUEUE.get_or_init(|| {
+            let (sender, receiver) = std::sync::mpsc::channel::<(&'static str, Value)>();
+            std::thread::spawn(move || {
+                while let Ok((event, payload)) = receiver.recv() {
+                    crate::mod_runtime::broadcast_event(event, payload);
+                }
+            });
+            sender
+        });
+        let _ = queue.send((event, payload));
+    }
+}
