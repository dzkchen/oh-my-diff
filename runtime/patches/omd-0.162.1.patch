+#[test]
+#[serial_test::serial]
+fn startup_cancelled_while_waiting_for_runtime_does_not_publish() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let root = tempfile::tempdir().unwrap();
+    let repository = root.path().canonicalize().unwrap();
+    let store_path = repository.join("store");
+    codex_omd::ModStore::create(
+        store_path.clone(),
+        std::env::var_os("OMD_TEST_NODE").unwrap().into(),
+    )
+    .unwrap();
+    let _environment = crate::omd::tests::omd_environment(&store_path);
+    let previous = HOST.lock().unwrap().take();
+    let runtime = shared_host().unwrap();
+    let busy = runtime.lock().unwrap();
+    let active = Arc::new(AtomicBool::new(true));
+    let worker_active = active.clone();
+    let worker_repository = repository.clone();
+    let (entered, waiting) = std::sync::mpsc::channel();
+    let (finished, completion) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        prepare_startup_active(&worker_repository, "new", &|| {
+            let current = worker_active.load(Ordering::SeqCst);
+            let _ = entered.send(());
+            current
+        });
+        finished.send(()).unwrap();
+    });
+    waiting.recv_timeout(Duration::from_secs(5)).unwrap();
+    active.store(false, Ordering::SeqCst);
+    let cancelled = completion.recv_timeout(Duration::from_secs(5));
+    drop(busy);
+    worker.join().unwrap();
+    let published = crate::mod_ui::startup_context_matches(&repository, "new");
+    *HOST.lock().unwrap() = previous;
+    cancelled.unwrap();
+    assert!(!published);
+}
