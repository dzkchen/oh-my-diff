+        fs::create_dir(&before).unwrap();
+        let held = shared(&before).unwrap();
+        fs::rename(&before, &after).unwrap();
+        assert!(exclusive(&after).is_err());
+        drop(held);
+        exclusive(&after).expect("renamed checkout lease must release on drop");
+    }
+}
