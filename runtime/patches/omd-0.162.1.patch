+    store.enable(&path, true).unwrap();
+    first.reload().unwrap();
+    invoke(&mut first, "write", json!(4));
+    store.reload().unwrap();
+    assert!(invoke(&mut second, "read", Value::Null).is_null());
+    invoke(&mut first, "write", json!(5));
