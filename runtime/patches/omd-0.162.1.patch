+#[test_case::test_case(codex_extension_api::ApprovalGate::Approve("granted".into()); "delegated")]
+#[tokio::test]
+async fn approval_gates_tighten_before_automatic_review(
+    verdict: codex_extension_api::ApprovalGate,
+) -> anyhow::Result<()> {
+    use anyhow::Context;
+    let (mut session, turn, events) = make_session_and_context_with_rx().await;
+    let results = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_review_contributor(Arc::new(AllowEverything));
+    extensions.approval_gate_contributor(Arc::new(RecordingGate {
+        verdict: verdict.clone(),
+        results: results.clone(),
+    }));
+    Arc::get_mut(&mut session)
+        .context("session is uniquely owned")?
+        .services
+        .extensions = Arc::new(extensions.build());
+    *session.active_turn.lock().await = Some(crate::state::ActiveTurn::default());
+    let mut review_context = GuardianReviewContext::from(&turn);
+    review_context.approval_policy = AskForApproval::OnRequest;
+    review_context.approvals_reviewer = ApprovalsReviewer::AutoReview;
+    let context = ApprovalContext {
+        review_context,
+        cancellation_token: None,
+        call_id: "gated".to_string(),
+        tool_name: ToolName::plain("exec_command"),
+        strict_auto_review: false,
+        approval_reason: None,
+        retry_reason: None,
+        network_approval_context: None,
+    };
+    let action = ApprovalAction::ExecCommand {
+        id: context.call_id.clone(),
+        environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+        command: vec!["npm".to_string(), "install".to_string()],
+        hook_command: "npm install".to_string(),
+        cwd: PathUri::from_abs_path(&AbsolutePathBuf::try_from(PathBuf::from("/tmp"))?),
+        sandbox_permissions: SandboxPermissions::UseDefault,
+        additional_permissions: None,
+        justification: None,
+        tty: false,
+        proposed_execpolicy_amendment: None,
+    };
+    let approval = session.request_approval(action, context);
+    tokio::pin!(approval);
+    let recorded = |decision: &str, source: &str| {
+        vec![("gated".to_owned(), decision.to_owned(), source.to_owned())]
+    };
+    match verdict {
+        codex_extension_api::ApprovalGate::Deny(_) => {
+            let Err(ToolError::Rejected(reason)) = approval.await else {
+                panic!("a gate denial must reject");
+            };
+            assert_eq!(reason, "blocked");
+            assert_eq!(
+                *results
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner),
+                recorded("denied", "mod")
+            );
+        }
+        codex_extension_api::ApprovalGate::Ask(_) => {
+            tokio::select! {
+                resolution = &mut approval => panic!("expected a forced user prompt, got {resolution:?}"),
+                event = events.recv() => {
+                    let codex_protocol::protocol::EventMsg::ExecApprovalRequest(request) =
+                        event.context("receive user prompt")?.msg
+                    else {
+                        panic!("expected a command approval prompt");
+                    };
+                    assert_eq!(request.reason.as_deref(), Some("person"));
+                    session
+                        .notify_approval(&request.call_id, ReviewDecision::Denied { rejection: "no".into() })
+                        .await;
+                }
+            }
+            assert!(approval.await.is_err());
+            assert_eq!(
+                *results
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner),
+                recorded("denied", "user")
+            );
+        }
+        codex_extension_api::ApprovalGate::Continue => {
+            assert!(matches!(approval.await, Ok(ReviewDecision::Approved)));
+            assert_eq!(
+                *results
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner),
+                recorded("approved", "guardian")
+            );
+        }
+        codex_extension_api::ApprovalGate::Approve(_) => {
+            assert!(matches!(approval.await, Ok(ReviewDecision::Approved)));
+            let codex_protocol::protocol::EventMsg::Warning(warning) =
+                events.recv().await.context("receive approval notice")?.msg
+            else {
+                panic!("a delegated approval must be announced natively");
+            };
+            assert_eq!(warning.message, "granted");
+            assert_eq!(
+                *results
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner),
+                recorded("approved", "mod")
+            );
+        }
+    }
+    Ok(())
+}
