+/// Receives each text field with its kind, role and call id; returns whether it changed the text.
+type Visit<'v> = dyn FnMut(&'static str, Option<&str>, Option<&str>, &mut String) -> bool + 'v;
+
+impl Session {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "rollout appends must stay ordered until the store accepts them"
+    )]
+    pub(crate) async fn append_rollout(
+        &self,
+        live_thread: &LiveThread,
+        items: &[RolloutItem],
+    ) -> ThreadStoreResult<()> {
+        let rewriters = self
+            .services
+            .extensions
+            .turn_lifecycle_contributors()
+            .iter()
+            .filter(|contributor| contributor.rewrites_persisted_text())
+            .cloned()
+            .collect::<Vec<_>>();
+        if rewriters.is_empty()
+            && let Ok(_order) = self.rollout_order.try_lock()
+        {
+            return live_thread.append_items(items).await;
+        }
+        let order = Arc::clone(&self.rollout_order);
+        let live_thread = live_thread.clone();
+        let items = items.to_vec();
+        let thread_id = self.thread_id().to_string();
+        // Detached, so an interrupted turn cannot drop items its live history already holds.
+        tokio::spawn(async move {
+            let _order = order.lock_owned().await;
+            let items = persisted(&rewriters, &thread_id, items).await;
+            live_thread.append_items(&items).await
+        })
+        .await
+        .map_err(|error| ThreadStoreError::Internal {
+            message: error.to_string(),
+        })?
+    }
+}
+
+/// Offers the texts of items about to be persisted to store-time rewrites.
+async fn persisted(
+    rewriters: &[Arc<dyn TurnLifecycleContributor>],
+    thread_id: &str,
+    mut items: Vec<RolloutItem>,
+) -> Vec<RolloutItem> {
+    if rewriters.is_empty() {
+        return items;
+    }
+    let mut entries = Vec::new();
+    let unchanged = HistoryRewriteProvenance {
+        revision: String::new(),
+        op: String::new(),
+        source: None,
+        by: String::new(),
+    };
+    for item in &mut items {
+        rollout_item(item, &unchanged, &mut |kind, role, call_id, text| {
+            entries.push(PersistedText {
+                kind,
+                role: role.map(str::to_owned),
+                call_id: call_id.map(str::to_owned),
+                text: text.clone(),
+            });
+            false
+        });
+    }
+    if entries.is_empty() {
+        return items;
+    }
+    let mut by = Vec::new();
+    for rewriter in rewriters {
+        let Some(rewrite) = rewriter
+            .rewrite_persisted_text(PersistedTextInput {
+                thread_id,
+                entries: &entries,
+            })
+            .await
+        else {
+            continue;
+        };
+        if rewrite.texts.len() == entries.len() {
+            for (entry, text) in entries.iter_mut().zip(rewrite.texts) {
+                entry.text = text;
+            }
+            by.push(rewrite.by);
+        }
+    }
+    if by.is_empty() {
+        return items;
+    }
+    let provenance = HistoryRewriteProvenance {
+        revision: thread_id.to_owned(),
+        op: "redact".to_owned(),
+        source: None,
+        by: by.join(", "),
+    };
+    let mut texts = entries.into_iter().map(|entry| entry.text);
+    for item in &mut items {
+        rollout_item(item, &provenance, &mut |_, _, _, text| {
+            let Some(replacement) = texts.next() else {
+                return false;
+            };
+            let changed = *text != replacement;
+            *text = replacement;
+            changed
+        });
+    }
+    items
+}
+
+fn rollout_item(
+    item: &mut RolloutItem,
+    provenance: &HistoryRewriteProvenance,
+    visit: &mut Visit<'_>,
+) {
+    match item {
+        RolloutItem::ResponseItem(item) => envelope(item, provenance, visit),
+        RolloutItem::Compacted(compacted) => {
+            visit("compacted", None, None, &mut compacted.message);
+            for item in compacted.replacement_history.iter_mut().flatten() {
+                envelope(item, provenance, visit);
+            }
+        }
+        RolloutItem::InterAgentCommunication(communication) => {
+            visit(
+                "inter_agent_communication",
+                None,
+                None,
+                &mut communication.content,
+            );
+        }
+        RolloutItem::EventMsg(event) => event_msg(event, visit),
+        _ => {}
+    }
+}
+
+fn event_msg(event: &mut EventMsg, visit: &mut Visit<'_>) {
+    match event {
+        EventMsg::UserMessage(event) => {
+            if visit("event:user_message", Some("user"), None, &mut event.message) {
+                event.text_elements.clear();
+            }
+        }
+        EventMsg::AgentMessage(event) => {
+            visit(
+                "event:agent_message",
+                Some("assistant"),
+                None,
+                &mut event.message,
+            );
+        }
+        EventMsg::TurnComplete(event) => {
+            if let Some(message) = &mut event.last_agent_message {
+                visit("event:agent_message", Some("assistant"), None, message);
+            }
+        }
+        EventMsg::ThreadGoalUpdated(event) => {
+            visit("event:goal", Some("user"), None, &mut event.goal.objective);
+        }
+        EventMsg::AgentReasoning(event) => {
+            visit("event:reasoning", None, None, &mut event.text);
+        }
+        EventMsg::AgentReasoningRawContent(event) => {
+            visit("event:reasoning", None, None, &mut event.text);
+        }
+        EventMsg::McpToolCallEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            if let Some(arguments) = &mut event.invocation.arguments {
+                json("event:mcp_tool_call", call_id, arguments, visit);
+            }
+            match &mut event.result {
+                Ok(result) => {
+                    tool_result("event:mcp_tool_call", call_id, result, visit);
+                }
+                Err(error) => {
+                    visit("event:mcp_tool_call", None, call_id, error);
+                }
+            }
+        }
+        EventMsg::PatchApplyEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            visit("event:file_change", None, call_id, &mut event.stdout);
+            visit("event:file_change", None, call_id, &mut event.stderr);
+            changes("event:file_change", call_id, &mut event.changes, visit);
+        }
+        EventMsg::WebSearchEnd(event) => {
+            let call_id = Some(event.call_id.as_str());
+            visit("event:web_search", None, call_id, &mut event.query);
+            web_search("event:web_search", call_id, &mut event.action, visit);
+            for result in event.results.iter_mut().flatten() {
+                json("event:web_search", call_id, result, visit);
+            }
+        }
+        EventMsg::ImageGenerationEnd(event) => {
+            if let Some(prompt) = &mut event.revised_prompt {
+                visit("event:image_generation", None, Some(&event.call_id), prompt);
+            }
+        }
+        EventMsg::EnteredReviewMode(event) => {
+            review_target(&mut event.target, event.user_facing_hint.as_mut(), visit);
+        }
+        EventMsg::ExitedReviewMode(event) => {
+            if let Some(output) = &mut event.review_output {
+                review_output(output, visit);
+            }
+        }
+        EventMsg::ItemCompleted(event) => turn_item(&mut event.item, visit),
+        _ => {}
+    }
+}
+
+fn turn_item(item: &mut TurnItem, visit: &mut Visit<'_>) {
+    match item {
+        TurnItem::UserMessage(message) => {
+            for input in &mut message.content {
+                if let UserInput::Text {
+                    text,
+                    text_elements,
+                } = input
+                    && visit("event:user_message", Some("user"), None, text)
+                {
+                    text_elements.clear();
+                }
+            }
+        }
+        TurnItem::AgentMessage(message) => {
+            for AgentMessageContent::Text { text } in &mut message.content {
+                visit("event:agent_message", Some("assistant"), None, text);
+            }
+        }
+        TurnItem::FunctionCallOutput(item) => {
+            body(
+                "event:function_call_output",
+                Some(&item.id),
+                &mut item.output,
+                visit,
+            );
+        }
+        TurnItem::HookPrompt(item) => {
+            for fragment in &mut item.fragments {
+                visit("event:hook_prompt", None, None, &mut fragment.text);
+            }
+        }
+        TurnItem::Plan(item) => {
+            visit("event:plan", None, None, &mut item.text);
+        }
+        TurnItem::Reasoning(item) => {
+            for text in item.summary_text.iter_mut().chain(&mut item.raw_content) {
+                visit("event:reasoning", None, None, text);
+            }
+        }
+        TurnItem::CommandExecution(item) => {
+            let call_id = Some(item.id.as_str());
+            for text in item
+                .command
+                .iter_mut()
+                .chain(&mut item.interaction_input)
+                .chain(&mut item.aggregated_output)
+            {
+                visit("event:command_execution", None, call_id, text);
+            }
+        }
+        TurnItem::DynamicToolCall(item) => {
+            let call_id = Some(item.id.as_str());
+            json(
+                "event:dynamic_tool_call",
+                call_id,
+                &mut item.arguments,
+                visit,
+            );
+            for content in item.content_items.iter_mut().flatten() {
+                if let DynamicToolCallOutputContentItem::InputText { text } = content {
+                    visit("event:dynamic_tool_call", None, call_id, text);
+                }
+            }
+            if let Some(error) = &mut item.error {
+                visit("event:dynamic_tool_call", None, call_id, error);
+            }
+        }
+        TurnItem::CollabAgentToolCall(item) => {
+            if let Some(prompt) = &mut item.prompt {
+                visit("event:collab_agent_tool_call", None, Some(&item.id), prompt);
+            }
+        }
+        TurnItem::WebSearch(item) => {
+            let call_id = Some(item.id.as_str());
+            visit("event:web_search", None, call_id, &mut item.query);
+            web_search("event:web_search", call_id, &mut item.action, visit);
+            for result in item.results.iter_mut().flatten() {
+                json("event:web_search", call_id, result, visit);
+            }
+        }
+        TurnItem::ImageGeneration(item) => {
+            if let Some(prompt) = &mut item.revised_prompt {
+                visit("event:image_generation", None, Some(&item.id), prompt);
+            }
+        }
+        TurnItem::EnteredReviewMode(item) => {
+            review_target(&mut item.target, Some(&mut item.user_facing_hint), visit);
+        }
+        TurnItem::ExitedReviewMode(item) => {
+            if let Some(output) = &mut item.review_output {
+                review_output(output, visit);
+            }
+        }
+        TurnItem::FileChange(item) => {
+            let call_id = Some(item.id.as_str());
+            changes("event:file_change", call_id, &mut item.changes, visit);
+            for text in item.stdout.iter_mut().chain(&mut item.stderr) {
+                visit("event:file_change", None, call_id, text);
+            }
+        }
+        TurnItem::McpToolCall(item) => {
+            let call_id = Some(item.id.as_str());
+            json("event:mcp_tool_call", call_id, &mut item.arguments, visit);
+            if let Some(result) = &mut item.result {
+                tool_result("event:mcp_tool_call", call_id, result, visit);
+            }
+            if let Some(error) = &mut item.error {
+                visit("event:mcp_tool_call", None, call_id, &mut error.message);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn envelope(
+    envelope: &mut ResponseItemEnvelope,
+    provenance: &HistoryRewriteProvenance,
+    visit: &mut Visit<'_>,
+) {
+    let mut changed = response_item(&mut envelope.item, visit);
+    if let Some(metadata) = envelope.metadata.as_mut() {
+        if let Some(text) = metadata.delivered_assistant_message.as_mut() {
+            changed |= visit("delivered_message", Some("assistant"), None, text);
+        }
+        if let Some(messages) = metadata.sender_user_messages.as_mut() {
+            changed |= visit(
+                "sender_user_messages",
+                Some("user"),
+                None,
+                &mut messages.text,
+            );
+        }
+    }
+    if changed {
+        envelope.metadata.get_or_insert_default().rewritten = Some(provenance.clone());
+    }
+}
+
+fn response_item(item: &mut ResponseItem, visit: &mut Visit<'_>) -> bool {
+    let mut changed = false;
+    match item {
+        ResponseItem::Message { role, content, .. } => {
+            for part in content {
+                if let ContentItem::InputText { text } | ContentItem::OutputText { text } = part {
+                    changed |= visit("message", Some(role), None, text);
+                }
+            }
+        }
+        ResponseItem::AgentMessage { content, .. } => {
+            for part in content {
+                if let AgentMessageInputContent::InputText { text } = part {
+                    changed |= visit("agent_message", None, None, text);
+                }
+            }
+        }
+        ResponseItem::Reasoning {
+            summary, content, ..
+        } => {
+            for ReasoningItemReasoningSummary::SummaryText { text } in summary {
+                changed |= visit("reasoning", None, None, text);
+            }
+            for ReasoningItemContent::ReasoningText { text }
+            | ReasoningItemContent::Text { text } in content.iter_mut().flatten()
+            {
+                changed |= visit("reasoning", None, None, text);
+            }
+        }
+        ResponseItem::LocalShellCall {
+            call_id,
+            action: LocalShellAction::Exec(exec),
+            ..
+        } => {
+            let environment = exec.env.iter_mut().flat_map(|env| env.values_mut());
+            for text in exec.command.iter_mut().chain(environment) {
+                changed |= visit("local_shell_call", None, call_id.as_deref(), text);
+            }
+        }
+        ResponseItem::FunctionCall {
+            arguments, call_id, ..
+        } => changed |= visit("function_call", None, Some(call_id), arguments),
+        ResponseItem::ToolSearchCall {
+            call_id, arguments, ..
+        } => changed |= json("tool_search_call", call_id.as_deref(), arguments, visit),
+        ResponseItem::CustomToolCall { input, call_id, .. } => {
+            changed |= visit("custom_tool_call", None, Some(call_id), input);
+        }
+        ResponseItem::FunctionCallOutput {
+            call_id, output, ..
+        } => {
+            changed |= body(
+                "function_call_output",
+                call_id.as_deref(),
+                &mut output.body,
+                visit,
+            );
+        }
+        ResponseItem::CustomToolCallOutput {
+            call_id, output, ..
+        } => {
+            changed |= body(
+                "custom_tool_call_output",
+                Some(call_id),
+                &mut output.body,
+                visit,
+            );
+        }
+        ResponseItem::ToolSearchOutput { call_id, tools, .. } => {
+            for tool in tools {
+                changed |= keyed(
+                    "description",
+                    "tool_search_output",
+                    call_id.as_deref(),
+                    tool,
+                    visit,
+                );
+            }
+        }
+        ResponseItem::WebSearchCall {
+            action: Some(action),
+            ..
+        } => changed |= web_search("web_search_call", None, action, visit),
+        ResponseItem::ImageGenerationCall {
+            revised_prompt: Some(prompt),
+            ..
+        } => changed |= visit("image_generation_call", None, None, prompt),
+        _ => {}
+    }
+    changed
+}
+
+fn body(
+    kind: &'static str,
+    call_id: Option<&str>,
+    body: &mut FunctionCallOutputBody,
+    visit: &mut Visit<'_>,
+) -> bool {
+    match body {
+        FunctionCallOutputBody::Text(text) => visit(kind, None, call_id, text),
+        FunctionCallOutputBody::ContentItems(items) => {
+            let mut changed = false;
+            for item in items {
+                if let FunctionCallOutputContentItem::InputText { text } = item {
+                    changed |= visit(kind, None, call_id, text);
+                }
+            }
+            changed
+        }
+    }
+}
+
+/// Every string in model-authored JSON, in document order.
+fn json(
+    kind: &'static str,
+    call_id: Option<&str>,
+    value: &mut Value,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let mut changed = false;
+    match value {
+        Value::String(text) => changed = visit(kind, None, call_id, text),
+        Value::Array(values) => {
+            for value in values {
+                changed |= json(kind, call_id, value, visit);
+            }
+        }
+        Value::Object(map) => {
+            for value in map.values_mut() {
+                changed |= json(kind, call_id, value, visit);
+            }
+        }
+        _ => {}
+    }
+    changed
+}
+
+/// The strings stored under `key` anywhere in `value`, leaving tags and identifiers alone.
+fn keyed(
+    key: &str,
+    kind: &'static str,
+    call_id: Option<&str>,
+    value: &mut Value,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let mut changed = false;
+    match value {
+        Value::Array(values) => {
+            for value in values {
+                changed |= keyed(key, kind, call_id, value, visit);
+            }
+        }
+        Value::Object(map) => {
+            for (name, value) in map {
+                changed |= match value {
+                    Value::String(text) if name == key => visit(kind, None, call_id, text),
+                    value => keyed(key, kind, call_id, value, visit),
+                };
+            }
+        }
+        _ => {}
+    }
+    changed
+}
+
+fn tool_result(
+    kind: &'static str,
+    call_id: Option<&str>,
+    result: &mut CallToolResult,
+    visit: &mut Visit<'_>,
+) {
+    for content in &mut result.content {
+        keyed("text", kind, call_id, content, visit);
+    }
+    if let Some(structured) = &mut result.structured_content {
+        json(kind, call_id, structured, visit);
+    }
+}
+
+fn changes(
+    kind: &'static str,
+    call_id: Option<&str>,
+    changes: &mut HashMap<PathBuf, FileChange>,
+    visit: &mut Visit<'_>,
+) {
+    for change in changes.values_mut() {
+        match change {
+            FileChange::Add { content } | FileChange::Delete { content } => {
+                visit(kind, None, call_id, content);
+            }
+            FileChange::Update { unified_diff, .. } => {
+                visit(kind, None, call_id, unified_diff);
+            }
+        }
+    }
+}
+
+fn web_search(
+    kind: &'static str,
+    call_id: Option<&str>,
+    action: &mut WebSearchAction,
+    visit: &mut Visit<'_>,
+) -> bool {
+    let texts: Vec<&mut String> = match action {
+        WebSearchAction::Search { query, queries } => query
+            .iter_mut()
+            .chain(queries.iter_mut().flatten())
+            .collect(),
+        WebSearchAction::OpenPage { url } => url.iter_mut().collect(),
+        WebSearchAction::FindInPage { url, pattern } => {
+            url.iter_mut().chain(pattern.iter_mut()).collect()
+        }
+        _ => Vec::new(),
+    };
+    let mut changed = false;
+    for text in texts {
+        changed |= visit(kind, None, call_id, text);
+    }
+    changed
+}
+
+fn review_target(target: &mut ReviewTarget, hint: Option<&mut String>, visit: &mut Visit<'_>) {
+    if let ReviewTarget::Custom { instructions } = target {
+        visit("event:review", None, None, instructions);
+    }
+    if let Some(hint) = hint {
+        visit("event:review", None, None, hint);
+    }
+}
+
+fn review_output(output: &mut ReviewOutputEvent, visit: &mut Visit<'_>) {
+    for finding in &mut output.findings {
+        visit("event:review", None, None, &mut finding.title);
+        visit("event:review", None, None, &mut finding.body);
+    }
+    visit("event:review", None, None, &mut output.overall_explanation);
+}
diff --git a/codex-rs/core/src/session/persisted_text_tests.rs b/codex-rs/core/src/session/persisted_text_tests.rs
new file mode 100644
index 000000000..c94a7157f
--- /dev/null
+++ b/codex-rs/core/src/session/persisted_text_tests.rs
@@ -0,0 +1,222 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+struct Redactor;
+
+impl codex_extension_api::TurnLifecycleContributor for Redactor {
+    fn rewrites_persisted_text(&self) -> bool {
+        true
+    }
+
+    fn rewrite_persisted_text<'a>(
+        &'a self,
+        input: codex_extension_api::PersistedTextInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<codex_extension_api::PersistedTextRewrite>>
+    {
+        Box::pin(async move {
+            Some(codex_extension_api::PersistedTextRewrite {
+                texts: input
+                    .entries
+                    .iter()
+                    .map(|entry| entry.text.replace("secret-sentinel", "[redacted]"))
+                    .collect(),
+                by: "mod:redactor".to_owned(),
+            })
+        })
+    }
+}
+
+#[tokio::test]
+async fn persisted_text_is_rewritten_at_rest_while_live_history_keeps_the_original() {
+    let (mut session, turn_context) = make_session_and_context().await;
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(Redactor));
+    session.services.extensions = Arc::new(builder.build());
+    let rollout_path = attach_thread_persistence(&mut session).await;
+    let message_id = ResponseItemId::with_suffix("msg", "secret");
+    let items = [
+        ResponseItem::Message {
+            id: Some(message_id.clone()),
+            role: "user".to_owned(),
+            content: vec![ContentItem::InputText {
+                text: "token secret-sentinel".to_owned(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        },
+        ResponseItem::FunctionCall {
+            id: None,
+            name: "exec_command".to_owned(),
+            namespace: None,
+            arguments: "{\"cmd\":\"echo secret-sentinel\"}".to_owned(),
+            encrypted_function_args: None,
+            call_id: "call-secret".to_owned(),
+            internal_chat_message_metadata_passthrough: None,
+        },
+        ResponseItem::FunctionCallOutput {
+            id: None,
+            call_id: Some("call-secret".to_owned()),
+            name: None,
+            namespace: None,
+            output: FunctionCallOutputPayload::from_text("secret-sentinel".to_owned()),
+            internal_chat_message_metadata_passthrough: None,
+        },
+    ];
+    session
+        .record_conversation_items(&turn_context, turn_context.model_info(), &items)
+        .await;
+    session
+        .persist_rollout_items(&[RolloutItem::EventMsg(EventMsg::UserMessage(
+            UserMessageEvent {
+                message: "token secret-sentinel".to_owned(),
+                ..Default::default()
+            },
+        ))])
+        .await;
+    session.flush_rollout().await.expect("rollout should flush");
+
+    let live = session.clone_history().await;
+    assert!(live.raw_items().any(|item| {
+        serde_json::to_string(item).is_ok_and(|text| text.contains("secret-sentinel"))
+    }));
+    let stored = std::fs::read_to_string(&rollout_path).expect("read rollout");
+    assert!(!stored.contains("secret-sentinel"));
+    let InitialHistory::Resumed(resumed) = RolloutRecorder::get_rollout_history(&rollout_path)
+        .await
+        .expect("read rollout history")
+    else {
+        panic!("expected resumed rollout history");
+    };
+    let envelopes = resumed
+        .history
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::ResponseItem(envelope) => Some(envelope),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let message = envelopes
+        .iter()
+        .find(|envelope| envelope.item.id() == Some(&message_id))
+        .expect("message keeps its id");
+    assert_eq!(
+        message
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.rewritten.as_ref())
+            .map(|rewritten| (rewritten.op.as_str(), rewritten.by.as_str())),
+        Some(("redact", "mod:redactor"))
+    );
+    assert_eq!(
+        envelopes
+            .iter()
+            .filter_map(|envelope| match &envelope.item {
+                ResponseItem::FunctionCall { call_id, .. }
+                | ResponseItem::FunctionCallOutput {
+                    call_id: Some(call_id),
+                    ..
+                } => Some(call_id.as_str()),
+                _ => None,
+            })
+            .collect::<Vec<_>>(),
+        ["call-secret", "call-secret"]
+    );
+    assert!(stored.contains("[redacted]"));
+}
+
+#[tokio::test]
+async fn tool_records_reasoning_and_event_copies_are_rewritten_at_rest() {
+    let (mut session, _turn_context) = make_session_and_context().await;
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(Redactor));
+    session.services.extensions = Arc::new(builder.build());
+    let rollout_path = attach_thread_persistence(&mut session).await;
+    let items = [
+        serde_json::json!({"type":"response_item","payload":{"type":"local_shell_call","call_id":"c1","status":"completed","action":{"type":"exec","command":["echo","secret-sentinel"],"env":{"TOKEN":"secret-sentinel"}}}}),
+        serde_json::json!({"type":"response_item","payload":{"type":"reasoning","summary":[{"type":"summary_text","text":"secret-sentinel"}],"content":[{"type":"reasoning_text","text":"secret-sentinel"}],"encrypted_content":"opaque-kept"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"agent_reasoning","text":"secret-sentinel"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"task_complete","turn_id":"t","last_agent_message":"secret-sentinel"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"patch_apply_end","call_id":"c2","turn_id":"t","stdout":"secret-sentinel","stderr":"secret-sentinel","changes":{"/tmp/a":{"type":"add","content":"secret-sentinel"}},"success":true,"status":"completed"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"mcp_tool_call_end","call_id":"c3","invocation":{"server":"s","tool":"t","arguments":{"q":"secret-sentinel"}},"duration":{"secs":0,"nanos":0},"result":{"Ok":{"content":[{"type":"text","text":"secret-sentinel"}],"structuredContent":{"k":"secret-sentinel"}}}}}),
+    ]
+    .map(|item| serde_json::from_value::<RolloutItem>(item).expect("rollout item"));
+    session.persist_rollout_items(&items).await;
+    session.flush_rollout().await.expect("rollout should flush");
+
+    let stored = std::fs::read_to_string(&rollout_path).expect("read rollout");
+    assert!(!stored.contains("secret-sentinel"), "{stored}");
+    assert!(stored.contains("opaque-kept"));
+    assert_eq!(stored.matches("[redacted]").count(), 12);
+}
+
+struct SlowRewriter;
+
+impl codex_extension_api::TurnLifecycleContributor for SlowRewriter {
+    fn rewrites_persisted_text(&self) -> bool {
+        true
+    }
+
+    fn rewrite_persisted_text<'a>(
+        &'a self,
+        input: codex_extension_api::PersistedTextInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<codex_extension_api::PersistedTextRewrite>>
+    {
+        Box::pin(async move {
+            if input
+                .entries
+                .iter()
+                .any(|entry| entry.text.contains("slow"))
+            {
+                tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+            }
+            None
+        })
+    }
+}
+
+#[tokio::test]
+async fn rollout_appends_keep_call_order_while_a_rewrite_is_pending() {
+    let (mut session, _turn_context) = make_session_and_context().await;
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(SlowRewriter));
+    session.services.extensions = Arc::new(builder.build());
+    let rollout_path = attach_thread_persistence(&mut session).await;
+    let message = |text: &str| {
+        RolloutItem::EventMsg(EventMsg::UserMessage(UserMessageEvent {
+            message: text.to_owned(),
+            ..Default::default()
+        }))
+    };
+    let slow = [message("slow first")];
+    tokio::join!(session.persist_rollout_items(&slow), async {
+        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        session
+            .persist_rollout_items(&[message("fast second")])
+            .await
+    });
+    session.flush_rollout().await.expect("rollout should flush");
+
+    let stored = std::fs::read_to_string(&rollout_path).expect("read rollout");
+    let first = stored.find("slow first").expect("first message stored");
+    let second = stored.find("fast second").expect("second message stored");
+    assert!(first < second);
+
+    let interrupted = [message("slow interrupted")];
+    assert!(
+        tokio::time::timeout(
+            std::time::Duration::from_millis(20),
+            session.persist_rollout_items(&interrupted),
+        )
+        .await
+        .is_err()
+    );
+    session
+        .persist_rollout_items(&[message("later sentinel")])
+        .await;
+    session.flush_rollout().await.expect("rollout should flush");
+    let stored = std::fs::read_to_string(&rollout_path).expect("read rollout");
+    let interrupted = stored
+        .find("slow interrupted")
+        .expect("an interrupted append is still stored");
+    assert!(interrupted < stored.find("later sentinel").expect("later message stored"));
+}
diff --git a/codex-rs/core/src/tools/approval_gate.rs b/codex-rs/core/src/tools/approval_gate.rs
new file mode 100644
index 000000000..33f890244
--- /dev/null
+++ b/codex-rs/core/src/tools/approval_gate.rs
@@ -0,0 +1,255 @@
+use std::sync::Arc;
+
+use codex_extension_api::ApprovalGate;
+use codex_extension_api::ApprovalGateInput;
+use codex_extension_api::ApprovalResultInput;
+use codex_protocol::protocol::ReviewDecision;
+
+use crate::guardian::GuardianReviewContext;
+use crate::session::session::Session;
+use crate::tools::approvals::ApprovalAction;
+use crate::tools::approvals::ApprovalContext;
+use crate::tools::sandboxing::ToolCtx;
+use crate::tools::sandboxing::ToolError;
+
+const DETAIL_BYTES: usize = 64 * 1024;
+
+pub(crate) fn kind(action: &ApprovalAction) -> &'static str {
+    match action {
+        ApprovalAction::ExecCommand { .. } => "exec",
+        ApprovalAction::WriteStdin { .. } => "stdin",
+        #[cfg(unix)]
+        ApprovalAction::Execve { .. } => "execve",
+        ApprovalAction::ApplyPatch { .. } => "patch",
+        ApprovalAction::McpToolCall { .. } => "mcp_tool",
+        ApprovalAction::NetworkAccess { .. } => "network",
+        ApprovalAction::RequestPermissions { .. } => "permissions",
+    }
+}
+
+fn details(action: &ApprovalAction) -> serde_json::Value {
+    let mut value = serde_json::to_value(action).unwrap_or(serde_json::Value::Null);
+    if value.to_string().len() > DETAIL_BYTES
+        && let Some(object) = value.as_object_mut()
+    {
+        for field in ["patch", "arguments", "input", "tool_description"] {
+            object.remove(field);
+        }
+        object.insert("truncated".into(), serde_json::Value::Bool(true));
+    }
+    value
+}
+
+pub(crate) fn decision_name(decision: &ReviewDecision) -> &'static str {
+    match decision {
+        ReviewDecision::Approved => "approved",
+        ReviewDecision::ApprovedForSession => "approved_for_session",
+        ReviewDecision::ApprovedExecpolicyAmendment { .. }
+        | ReviewDecision::ApprovedMcpPolicyAmendment
+        | ReviewDecision::NetworkPolicyAmendment { .. } => "amended",
+        ReviewDecision::Denied { .. } => "denied",
+        ReviewDecision::TimedOut => "timed_out",
+        ReviewDecision::Abort => "aborted",
+    }
+}
+
+pub(crate) async fn gate(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    host_decision: &str,
+) -> ApprovalGate {
+    gate_with(
+        session,
+        action,
+        ctx,
+        host_decision,
+        /*assessment*/ false,
+    )
+    .await
+}
+
+pub(crate) async fn gate_with(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    host_decision: &str,
+    assessment: bool,
+) -> ApprovalGate {
+    let contributors = session.services.extensions.approval_gate_contributors();
+    if contributors.is_empty() {
+        return ApprovalGate::Continue;
+    }
+    let turn = ctx.review_context.turn();
+    let policy = serde_json::to_value(turn.approval_policy())
+        .ok()
+        .and_then(|value| value.as_str().map(str::to_owned))
+        .unwrap_or_default();
+    let details = details(action);
+    let mut ask = None;
+    let mut approve = None;
+    for contributor in contributors {
+        match contributor
+            .gate_approval(ApprovalGateInput {
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                turn_id: Some(turn.sub_id.as_str()),
+                kind: kind(action),
+                host_decision,
+                policy: &policy,
+                details: details.clone(),
+                assessment,
+            })
+            .await
+        {
+            ApprovalGate::Continue => {}
+            ApprovalGate::Deny(reason) => return ApprovalGate::Deny(reason),
+            ApprovalGate::Ask(reason) => {
+                ask.get_or_insert(reason);
+            }
+            ApprovalGate::Approve(reason) => {
+                approve.get_or_insert(reason);
+            }
+        }
+    }
+    match (ask, approve) {
+        (Some(reason), _) => ApprovalGate::Ask(reason),
+        (None, Some(reason)) => ApprovalGate::Approve(reason),
+        (None, None) => ApprovalGate::Continue,
+    }
+}
+
+pub(crate) async fn approved_by_extension(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    reason: String,
+) {
+    session
+        .send_event(
+            ctx.review_context.turn(),
+            codex_protocol::protocol::EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                message: reason,
+            }),
+        )
+        .await;
+    report(session, kind(action), ctx, "approved", "mod").await;
+}
+
+pub(crate) async fn report(
+    session: &Arc<Session>,
+    kind: &str,
+    ctx: &ApprovalContext,
+    decision: &str,
+    source: &str,
+) {
+    for contributor in session.services.extensions.approval_gate_contributors() {
+        contributor
+            .on_approval_result(ApprovalResultInput {
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                kind,
+                decision,
+                source,
+            })
+            .await;
+    }
+}
+
+fn context(
+    tool_ctx: &ToolCtx,
+    strict_auto_review: bool,
+    approval_reason: Option<String>,
+) -> ApprovalContext {
+    ApprovalContext {
+        review_context: GuardianReviewContext::from(&tool_ctx.step_context),
+        cancellation_token: Some(tool_ctx.cancellation_token.clone()),
+        call_id: tool_ctx.call_id.clone(),
+        tool_name: tool_ctx.tool_name.clone(),
+        strict_auto_review,
+        approval_reason,
+        retry_reason: None,
+        network_approval_context: None,
+    }
+}
+
+/// Gates a call that needs no approval; `Ok(true)` when a gate asked and the user approved it.
+pub(crate) async fn on_skip(
+    tool_ctx: &ToolCtx,
+    action: impl FnOnce() -> Option<ApprovalAction>,
+    strict_auto_review: bool,
+) -> Result<bool, ToolError> {
+    let session = &tool_ctx.session;
+    if session
+        .services
+        .extensions
+        .approval_gate_contributors()
+        .is_empty()
+    {
+        return Ok(false);
+    }
+    let Some(action) = action() else {
+        return Ok(false);
+    };
+    let mut approval_ctx = context(tool_ctx, strict_auto_review, None);
+    match gate(session, &action, &approval_ctx, "skip").await {
+        ApprovalGate::Continue | ApprovalGate::Approve(_) => Ok(false),
+        ApprovalGate::Deny(reason) => {
+            report(session, kind(&action), &approval_ctx, "denied", "mod").await;
+            Err(ToolError::Rejected(reason))
+        }
+        ApprovalGate::Ask(reason) => {
+            approval_ctx.approval_reason = Some(reason);
+            session.resolve_approval(action, approval_ctx, true).await?;
+            Ok(true)
+        }
+    }
+}
+
+/// Lets a gate approve a command that only the user's own exec-policy rules forbid.
+pub(crate) async fn override_forbidden(
+    tool_ctx: &ToolCtx,
+    action: impl FnOnce() -> Option<ApprovalAction>,
+    reason: &str,
+    strict_auto_review: bool,
+) -> Result<(), ToolError> {
+    let session = &tool_ctx.session;
+    let rejected = || ToolError::Rejected(reason.to_owned());
+    if session
+        .services
+        .extensions
+        .approval_gate_contributors()
+        .is_empty()
+    {
+        return Err(rejected());
+    }
+    let approval_ctx = context(tool_ctx, strict_auto_review, Some(reason.to_owned()));
+    let action = action()
+        .filter(|action| match action {
+            ApprovalAction::ExecCommand {
+                command,
+                environment_id,
+                ..
+            } => {
+                let environments = approval_ctx.review_context.environments();
+                let environment_policy = environments
+                    .turn_environments()
+                    .find(|environment| environment.selection.environment_id == *environment_id)
+                    .and_then(|environment| environment.config().exec_policy.as_ref());
+                session
+                    .services
+                    .exec_policy
+                    .forbidden_only_by_user_rules(command, environment_policy)
+            }
+            _ => false,
+        })
+        .ok_or_else(rejected)?;
+    match gate(session, &action, &approval_ctx, "forbidden").await {
+        ApprovalGate::Approve(approval) => {
+            approved_by_extension(session, &action, &approval_ctx, approval).await;
+            Ok(())
+        }
+        _ => Err(rejected()),
+    }
+}
