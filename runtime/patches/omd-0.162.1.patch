+    fn write_observation_hides_denied_paths() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let root_uri =
+            PathUri::from_abs_path(&AbsolutePathBuf::from_absolute_path_checked(&root).unwrap());
+        let secret_uri = PathUri::from_abs_path(
+            &AbsolutePathBuf::from_absolute_path_checked(root.join("secret.py")).unwrap(),
+        );
+        let policy = FileSystemSandboxPolicy::restricted(vec![
+            FileSystemSandboxEntry::new(
+                FileSystemPath::Path { path: root_uri },
+                FileSystemAccessMode::Read,
+            ),
+            FileSystemSandboxEntry::new(
+                FileSystemPath::Path { path: secret_uri },
+                FileSystemAccessMode::Deny,
+            ),
+        ]);
+        let profile =
+            PermissionProfile::from_runtime_permissions(&policy, NetworkSandboxPolicy::Restricted);
+        let authority = WorkspaceAuthority::for_platform(&root, profile).unwrap();
+        let change = |path: &str| codex_omd::WorkspaceChange {
+            path: path.to_owned(),
+            before: None,
+            after: Some("sha".into()),
+        };
+        assert_eq!(
+            authority
+                .visible_changes(vec![change("public.py")])
+                .unwrap()
+                .len(),
+            1
+        );
+        assert_eq!(
+            authority
+                .visible_changes(vec![change("secret.py")])
+                .unwrap_err(),
+            "workspace_change_scope_unavailable"
+        );
+    }
+
+    #[test]
+    fn pre_rename_process_calls_obey_the_normal_dispatch_gates() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        std::fs::write(root.join("a.py"), "x\n").unwrap();
+        let authority = authority(root, FileSystemAccessMode::Write);
+        let processes = crate::managed_process::ManagedProcesses::default();
+        let grants = codex_omd::ModGrants::default();
+        let call = |operation: &str, arguments: Value, restricted: bool| {
+            authority.pre_rename_call(
+                "mod",
+                codex_omd::ModHostCall {
+                    operation: operation.into(),
+                    arguments,
+                },
+                Some(&grants),
+                &|_, _| {
+                    if restricted {
+                        Err("contract_restricted".into())
+                    } else {
+                        Ok(())
+                    }
+                },
+                &processes,
+                &[],
+                1,
+                "thread",
+                &codex_omd::host::Environment::default(),
+                &|| true,
+            )
+        };
+        assert_eq!(
+            call(
+                "process.start",
+                json!({"session":"s","name":"sh","path":"/bin/sh","sha256":"x","environment":{"SECRET":"1"}}),
+                false
+            )
+            .unwrap_err(),
+            "exec_environment_undeclared"
+        );
+        assert_eq!(
+            call("process.which", json!({"names":["sh"]}), true).unwrap_err(),
+            "contract_restricted"
+        );
+        assert!(
+            call("process.which", json!({"names":["sh"]}), false).unwrap()["found"][0]["path"]
+                .is_string()
+        );
+        assert_eq!(
+            call("workspace.transaction", json!({}), false).unwrap_err(),
+            "host_operation_unavailable: workspace.transaction is not available during workspace_pre_rename"
+        );
+        assert_eq!(
+            call("process.start", json!({"network":"loopback"}), false).unwrap_err(),
+            "pre_rename_operation_unavailable"
+        );
+        assert_eq!(
+            call("workspace.read", json!({"paths":["a.py"]}), false).unwrap()["files"]["a.py"]["text"],
+            "x\n"
+        );
+    }
+
+    #[test]
+    fn pre_rename_plan_applies_companion_write_and_move() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        std::fs::write(root.join("old.ts"), "export const value = 1;\n").unwrap();
+        std::fs::write(root.join("index.ts"), "export * from './old';\n").unwrap();
+        let authority = authority(root.clone(), FileSystemAccessMode::Write);
+        let input = authority.rename_input("old.ts", "new.ts", || true).unwrap();
+        let index = authority
+            .call("workspace.read", json!({"paths":["index.ts"]}), || true)
+            .unwrap();
+        let result = authority
+            .apply_rename_plan(
+                &input,
+                json!({
+                    "status":"ready",
+                    "expected":{
+                        "old.ts":input["expected"]["old.ts"],
+                        "new.ts":null,
+                        "index.ts":index["files"]["index.ts"]["sha256"]
+                    },
+                    "writes":{"index.ts":"export * from './new';\n"}
+                }),
+                || true,
+            )
+            .unwrap();
+        assert_eq!(result["status"], "renamed");
+        assert!(!root.join("old.ts").exists());
+        assert_eq!(
+            std::fs::read_to_string(root.join("new.ts")).unwrap(),
+            "export const value = 1;\n"
+        );
+        assert_eq!(
+            std::fs::read_to_string(root.join("index.ts")).unwrap(),
+            "export * from './new';\n"
+        );
+    }
+}
diff --git a/codex-rs/ext/omd/src/workspace_watch.rs b/codex-rs/ext/omd/src/workspace_watch.rs
new file mode 100644
index 000000000..2908f9615
--- /dev/null
+++ b/codex-rs/ext/omd/src/workspace_watch.rs
@@ -0,0 +1,189 @@
+use codex_file_watcher::DebouncedWatchReceiver;
+use codex_file_watcher::FileWatcher;
+use codex_file_watcher::WatchPath;
+use codex_file_watcher::WatchRegistration;
+use std::collections::BTreeMap;
+use std::io;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+pub(crate) const DEBOUNCE_MS: (u64, u64, u64) = (50, 200, 10_000);
+
+pub(crate) type ChangeSink = Arc<dyn Fn(&str, Vec<String>) + Send + Sync>;
+
+struct Watch {
+    source: String,
+    _registration: WatchRegistration,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for Watch {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+pub(crate) struct WorkspaceWatches {
+    watcher: Arc<FileWatcher>,
+    root: PathBuf,
+    protected: Vec<PathBuf>,
+    watches: Mutex<BTreeMap<(String, String), Watch>>,
+    next: Mutex<u64>,
+    limits: codex_omd::mod_limits::ModLimits,
+}
+
+fn relative(root: &Path, path: &Path) -> Option<String> {
+    let relative = path.strip_prefix(root).ok()?;
+    if relative.components().any(|c| c.as_os_str() == ".git") {
+        return None;
+    }
+    relative.to_str().map(str::to_owned)
+}
+
+impl WorkspaceWatches {
+    pub(crate) fn new(
+        watcher: Arc<FileWatcher>,
+        root: PathBuf,
+        protected: Vec<PathBuf>,
+        limits: codex_omd::mod_limits::ModLimits,
+    ) -> io::Result<Self> {
+        let root = root.canonicalize()?;
+        Ok(Self {
+            watcher,
+            root,
+            protected,
+            watches: Mutex::new(BTreeMap::new()),
+            next: Mutex::new(0),
+            limits: limits.bounded(),
+        })
+    }
+
+    fn resolve(&self, path: &str) -> io::Result<PathBuf> {
+        let candidate = Path::new(path);
+        if candidate.is_absolute()
+            || candidate
+                .components()
+                .any(|c| matches!(c, Component::ParentDir))
+        {
+            return Err(io::Error::other(format!("watch_path_invalid: {path}")));
+        }
+        let resolved = self
+            .root
+            .join(candidate)
+            .canonicalize()
+            .map_err(|_| io::Error::other(format!("watch_path_missing: {path}")))?;
+        let protected = self
+            .protected
+            .iter()
+            .any(|p| resolved.starts_with(p) || p.starts_with(&resolved));
+        if !resolved.starts_with(&self.root)
+            || relative(&self.root, &resolved).is_none() && resolved != self.root
+            || protected
+        {
+            return Err(io::Error::other(format!("watch_path_denied: {path}")));
+        }
+        Ok(resolved)
+    }
+
+    pub(crate) fn watch(
+        &self,
+        owner: &str,
+        source: &str,
+        paths: &[String],
+        recursive: bool,
+        debounce_ms: Option<u64>,
+        sink: ChangeSink,
+    ) -> io::Result<String> {
+        if paths.is_empty() || paths.len() > self.limits.paths_per_watch {
+            return Err(io::Error::other("watch_paths_invalid"));
+        }
+        let debounce = debounce_ms.unwrap_or(DEBOUNCE_MS.1);
+        if !(DEBOUNCE_MS.0..=DEBOUNCE_MS.2).contains(&debounce) {
+            return Err(io::Error::other("watch_debounce_invalid"));
+        }
+        let resolved = paths
+            .iter()
+            .map(|path| self.resolve(path))
+            .collect::<io::Result<Vec<_>>>()?;
+        let mut watches = self
+            .watches
+            .lock()
+            .map_err(|_| io::Error::other("watch_state_poisoned"))?;
+        if watches.keys().filter(|(mod_id, _)| mod_id == owner).count()
+            >= self.limits.watches_per_mod
+        {
+            return Err(io::Error::other("watch_limit"));
+        }
+        let id = {
+            let mut next = self
+                .next
+                .lock()
+                .map_err(|_| io::Error::other("watch_state_poisoned"))?;
+            *next += 1;
+            format!("w{}", *next)
+        };
+        let (subscriber, receiver) = self.watcher.add_subscriber();
+        let registration = subscriber.register_paths(
+            resolved
+                .iter()
+                .map(|path| WatchPath {
+                    path: path.clone(),
+                    recursive,
+                })
+                .collect(),
+        );
+        let mut receiver = DebouncedWatchReceiver::new(receiver, Duration::from_millis(debounce));
+        let (root, protected, watch_id) = (self.root.clone(), self.protected.clone(), id.clone());
+        let task = tokio::spawn(async move {
+            let _subscriber = subscriber;
+            while let Some(event) = receiver.recv().await {
+                let changed: Vec<String> = event
+                    .paths
+                    .iter()
+                    .filter(|path| !protected.iter().any(|p| path.starts_with(p)))
+                    .filter_map(|path| relative(&root, path))
+                    .collect();
+                if !changed.is_empty() {
+                    sink(&watch_id, changed);
+                }
+            }
+        });
+        watches.insert(
+            (owner.to_owned(), id.clone()),
+            Watch {
+                source: source.to_owned(),
+                _registration: registration,
+                task,
+            },
+        );
+        Ok(id)
+    }
+
+    pub(crate) fn unwatch(&self, owner: &str, id: &str) -> bool {
+        self.watches
+            .lock()
+            .is_ok_and(|mut watches| watches.remove(&(owner.to_owned(), id.to_owned())).is_some())
+    }
+
+    pub(crate) fn retain_sources(&self, sources: &BTreeMap<String, String>) {
+        if let Ok(mut watches) = self.watches.lock() {
+            watches.retain(|(owner, _), watch| sources.get(owner) == Some(&watch.source));
+        }
+    }
+
+    pub(crate) fn unwatch_all(&self, owner: &str) -> usize {
+        self.watches.lock().map_or(0, |mut watches| {
+            let before = watches.len();
+            watches.retain(|(mod_id, _), _| mod_id != owner);
+            before - watches.len()
+        })
+    }
+}
+
+#[cfg(test)]
+#[path = "workspace_watch_tests.rs"]
+mod tests;
