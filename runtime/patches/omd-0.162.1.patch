+fn service_ts_type(kind: &str) -> &'static str {
+    match kind {
+        "null" => "null",
+        "boolean" => "boolean",
+        "number" => "number",
+        "string" => "string",
+        "array" => "Json[]",
+        "object" => "Record<string, Json>",
