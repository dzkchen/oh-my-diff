+/// One cached picture per component: its key and rows.
+static IMAGES: Mutex<BTreeMap<String, (String, Vec<Line<'static>>)>> = Mutex::new(BTreeMap::new());
+
+/// The newest decoded picture, so redraws at another size don't decode again.
+static DECODED: Mutex<Option<(String, Arc<image::DynamicImage>)>> = Mutex::new(None);
+
+static UNDECODABLE: Mutex<BTreeSet<String>> = Mutex::new(BTreeSet::new());
+
+/// Content that failed to decode is remembered by hash, so frames don't retry it.
+pub(crate) fn decode_once(
+    sha256: &str,
+    load: impl FnOnce() -> Option<Vec<u8>>,
+) -> Option<Arc<image::DynamicImage>> {
+    let failed = || {
+        UNDECODABLE
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    };
+    let mut decoded = DECODED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached, image)) = decoded.as_ref()
+        && cached == sha256
+    {
+        return Some(Arc::clone(image));
+    }
+    if failed().contains(sha256) {
+        return None;
+    }
+    let image = codex_omd::client_surface::decode_image(&load()?)
+        .ok()
+        .map(Arc::new);
+    match &image {
+        Some(image) => *decoded = Some((sha256.to_owned(), Arc::clone(image))),
+        None => {
+            let mut failed = failed();
+            if failed.len() >= 32 {
+                failed.clear();
+            }
+            failed.insert(sha256.to_owned());
+        }
+    }
+    image
+}
