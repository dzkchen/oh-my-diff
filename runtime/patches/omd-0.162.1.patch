+fn text(lines: &[Line<'static>]) -> Vec<String> {
+    lines
+        .iter()
+        .map(|line| {
+            line.spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect()
+        })
+        .collect()
+}
+
+fn blit_at(key: &str, caller: &str, value: Value, now: Instant) -> Result<Value, codex_omd::client_surface::BlitError> {
+    blit(
+        caller,
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key": key, "rect": value["rect"], "cells": value["cells"]}),
+        now,
+        |_, _| unreachable!(),
+    )
+}
