+/// A box's resolved look. Hover and focus accents restyle it but never add or remove the
+/// border, so its geometry stays put.
+#[derive(Clone, Copy)]
+struct Frame {
+    look: (ModBorder, ModIcons),
+    border: Option<ratatui::symbols::border::Set<'static>>,
+    padding: (u16, u16),
+    margin: (u16, u16),
+    gap: u16,
+    background: Option<Color>,
+    foreground: Style,
+    direction: ModDirection,
+}
+
+fn look() -> (ModBorder, ModIcons) {
+    with_cache(|cache| {
+        (
+            cache.snapshot.view.theme.border,
+            cache.snapshot.view.theme.icons,
+        )
+    })
+    .unwrap_or_default()
+}
+
+fn card(border: ModBorder) -> ModBoxStyle {
+    ModBoxStyle {
+        border: Some(match border {
+            ModBorder::Plain => ModBoxBorder::Plain,
+            ModBorder::Rounded => ModBoxBorder::Rounded,
+            ModBorder::Double => ModBoxBorder::Double,
+        }),
+        padding: Some(ModSpacing::Axes([0, 1])),
+        ..ModBoxStyle::default()
+    }
+}
+
+fn paint(paint: ModPaint) -> Style {
+    match paint {
+        ModPaint::Tone(tone) => tone_style(tone),
+        ModPaint::Color(value) => Style::default().fg(color(value)),
+    }
+}
+
+impl Frame {
+    fn card(
+        style: Option<ModBoxStyle>,
+        look: (ModBorder, ModIcons),
+        hovered: bool,
+        focused: bool,
+    ) -> Self {
+        Self::new(
+            style.unwrap_or_default().over(card(look.0)),
+            look,
+            hovered,
+            focused,
+        )
+    }
+
+    fn new(style: ModBoxStyle, look: (ModBorder, ModIcons), hovered: bool, focused: bool) -> Self {
+        let mut border = style.border.unwrap_or(ModBoxBorder::None);
+        let (mut background, mut foreground) = (style.background, style.foreground);
+        for accent in [
+            style.hover.filter(|_| hovered),
+            style.focus.filter(|_| focused),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if border != ModBoxBorder::None {
+                border = accent
+                    .border
+                    .filter(|accent| *accent != ModBoxBorder::None)
+                    .unwrap_or(border);
+            }
+            background = accent.background.or(background);
+            foreground = accent.foreground.or(foreground);
+        }
+        Self {
+            look,
+            border: match border {
+                ModBoxBorder::None => None,
+                _ if look.1 == ModIcons::Ascii || !crate::omd::unicode_supported() => {
+                    Some(ASCII_BORDER)
+                }
+                ModBoxBorder::Plain => Some(ratatui::symbols::border::PLAIN),
+                ModBoxBorder::Rounded => Some(ratatui::symbols::border::ROUNDED),
+                ModBoxBorder::Double => Some(ratatui::symbols::border::DOUBLE),
+                ModBoxBorder::Thick => Some(ratatui::symbols::border::THICK),
+            },
+            padding: style.padding.map_or((0, 0), ModSpacing::axes),
+            margin: style.margin.map_or((0, 0), ModSpacing::axes),
+            gap: style.gap.map_or(0, u16::from),
+            background: background.and_then(|value| paint(value).fg),
+            foreground: foreground.map(paint).unwrap_or_default(),
+            direction: style.direction.unwrap_or_default(),
+        }
+    }
+
+    fn edge(&self) -> u16 {
+        u16::from(self.border.is_some())
+    }
+
+    fn left(&self) -> u16 {
+        self.margin.1 + self.edge() + self.padding.1
+    }
+
+    fn inner(&self, width: u16) -> u16 {
+        width.saturating_sub(self.left() * 2).max(1)
+    }
+
+    /// Rows around the content; a title takes its own row only without a border.
+    fn rows(&self, title: bool) -> u16 {
+        (self.margin.0 + self.edge() + self.padding.0) * 2
+            + u16::from(title && self.border.is_none())
+    }
+
+    fn style(&self) -> Style {
+        match self.background {
+            Some(background) => self.foreground.bg(background),
+            None => self.foreground,
+        }
+    }
+
+    /// Draws margin, border, fill and padding into `area`; returns the content rect.
+    fn draw(&self, area: Rect, title: Option<Line<'static>>, buffer: &mut Buffer) -> Rect {
+        let area = area.inner(ratatui::layout::Margin::new(self.margin.1, self.margin.0));
+        let mut block =
+            Block::default()
+                .style(self.style())
+                .padding(ratatui::widgets::Padding::symmetric(
+                    self.padding.1,
+                    self.padding.0,
+                ));
+        if let Some(set) = self.border {
+            block = block.borders(Borders::ALL).border_set(set);
+        }
+        if let Some(title) = title {
+            block = block.title(Line::from(
+                [vec![" ".into()], title.spans, vec![" ".into()]].concat(),
+            ));
+        }
+        let inner = block.inner(area);
+        block.render(area, buffer);
+        inner
+    }
+}
+
+/// `line` cut or padded to exactly `width` cells over `base`.
+fn fit(line: Line<'static>, width: u16, base: Style) -> Vec<ratatui::text::Span<'static>> {
+    let base = base.patch(line.style);
+    let line = crate::line_truncation::truncate_line_to_width(line, usize::from(width));
+    let room = usize::from(width).saturating_sub(line.width());
+    let mut spans = line
+        .spans
+        .into_iter()
+        .map(|span| {
+            let style = base.patch(span.style);
+            span.style(style)
+        })
+        .collect::<Vec<_>>();
+    spans.push(ratatui::text::Span::styled(" ".repeat(room), base));
+    spans
+}
+
+/// Draws `frame` around `body` in rows `width` cells wide; `head` titles the top edge, or
+/// leads the content when the frame has no border.
+fn framed(
+    frame: &Frame,
+    width: u16,
+    head: Option<ComponentRow>,
+    body: Vec<ComponentRow>,
+) -> Vec<ComponentRow> {
+    use ratatui::text::Span;
+    let (vertical, horizontal) = frame.margin;
+    let span = usize::from(width.saturating_sub(horizontal * 2));
+    let style = frame.style();
+    let margin = || Span::raw(" ".repeat(usize::from(horizontal)));
+    let pad = || Span::styled(" ".repeat(usize::from(frame.padding.1)), style);
+    let wrap = |mut row: ComponentRow| {
+        row.shift(frame.left());
+        let line = std::mem::take(&mut row.line);
+        let mut spans = vec![margin()];
+        spans.extend(
+            frame
+                .border
+                .map(|set| Span::styled(set.vertical_left, style)),
+        );
+        spans.push(pad());
+        if frame.border.is_some() || frame.background.is_some() {
+            spans.extend(fit(line, frame.inner(width), style));
+            spans.push(pad());
+            spans.extend(
+                frame
+                    .border
+                    .map(|set| Span::styled(set.vertical_right, style)),
+            );
+        } else {
+            let base = style.patch(line.style);
+            spans.extend(line.spans.into_iter().map(|span| {
+                let style = base.patch(span.style);
+                span.style(style)
+            }));
+        }
+        row.line = Line::from(spans);
+        row
+    };
+    let edge =
+        |set: ratatui::symbols::border::Set<'static>, head: Option<ComponentRow>, top: bool| {
+            let (open, fill, close) = if top {
+                (set.top_left, set.horizontal_top, set.top_right)
+            } else {
+                (set.bottom_left, set.horizontal_bottom, set.bottom_right)
+            };
+            let mut row = head.unwrap_or_default();
+            let title = std::mem::take(&mut row.line);
+            let mut spans = vec![margin(), Span::styled(open, style)];
+            let mut used = 1;
+            let room = span.saturating_sub(4);
+            if room > 0 && title.width() > 0 {
+                row.shift(horizontal + 2);
+                let title = crate::line_truncation::truncate_line_to_width(title, room);
+                used += title.width() + 2;
+                spans.push(Span::styled(" ", style));
+                let base = style.patch(title.style);
+                spans.extend(title.spans.into_iter().map(|span| {
+                    let style = base.patch(span.style);
+                    span.style(style)
+                }));
+                spans.push(Span::styled(" ", style));
+            }
+            spans.push(Span::styled(
+                fill.repeat(span.saturating_sub(used + 1)),
+                style,
+            ));
+            spans.push(Span::styled(close, style));
+            row.line = Line::from(spans);
+            row
+        };
+    let mut head = head;
+    let mut rows = (0..vertical)
+        .map(|_| ComponentRow::default())
+        .collect::<Vec<_>>();
+    if let Some(set) = frame.border {
+        rows.push(edge(set, head.take(), true));
+    }
+    rows.extend((0..frame.padding.0).map(|_| wrap(ComponentRow::default())));
+    rows.extend(head.into_iter().chain(body).map(wrap));
+    rows.extend((0..frame.padding.0).map(|_| wrap(ComponentRow::default())));
+    if let Some(set) = frame.border {
+        rows.push(edge(set, None, false));
+    }
+    rows.extend((0..vertical).map(|_| ComponentRow::default()));
+    rows
+}
+
+/// Marks the framed rows, margins excluded, as held by box `id`.
+fn hold(rows: &mut [ComponentRow], id: &str, frame: &Frame, width: u16, events: bool, hover: bool) {
+    let (vertical, horizontal) = frame.margin;
+    let end = rows.len().saturating_sub(usize::from(vertical));
+    for (top, row) in rows[..end]
+        .iter_mut()
+        .skip(usize::from(vertical))
+        .enumerate()
+    {
+        row.regions.insert(
+            0,
+            Held {
+                id: id.to_owned(),
+                x: horizontal,
+                top: u16::try_from(top).unwrap_or(u16::MAX),
+                width: width.saturating_sub(horizontal * 2),
+                events,
+                hover,
+            },
+        );
+    }
+}
+
+fn natural_width(component: &ModComponent) -> Option<u16> {
+    let width = match component {
+        ModComponent::Button { text, .. } => text.width() + 4,
+        ModComponent::Text { text, .. } => {
+            text.lines().map(UnicodeWidthStr::width).max().unwrap_or(0)
+        }
+        ModComponent::Line { spans, .. } => spans.iter().map(|span| span.text.width()).sum(),
+        _ => return None,
+    };
+    Some(u16::try_from(width).unwrap_or(u16::MAX))
+}
+
+/// Places a row's children: buttons, text and lines take their natural width and the other
+/// children share the rest by `flex`; each drawn width is capped by `max_width`, and a child
+/// narrower than its `min_width` drops out and the rest share its room.
+fn columns(children: &[ModComponent], width: u16, gap: u16) -> Vec<(&ModComponent, u16, u16)> {
+    let mut shown = children
+        .iter()
+        .filter(|child| !matches!(child, ModComponent::Slot | ModComponent::Native { .. }))
+        .collect::<Vec<_>>();
+    loop {
+        let gaps = gap * u16::try_from(shown.len().saturating_sub(1)).unwrap_or(0);
+        let mut room = width.saturating_sub(gaps);
+        let mut natural = shown
+            .iter()
+            .map(|child| natural_width(child))
+            .collect::<Vec<_>>();
+        let demand = natural
+            .iter()
+            .flatten()
+            .map(|width| u32::from(*width))
+            .sum::<u32>();
+        let flexible = natural.iter().filter(|width| width.is_none()).count();
+        if demand + flexible as u32 > u32::from(room) {
+            let mut order = natural
+                .iter()
+                .enumerate()
+                .filter_map(|(index, width)| width.map(|width| (index, width)))
+                .collect::<Vec<_>>();
+            order.sort_by_key(|(_, width)| *width);
+            let mut remaining = shown.len();
+            for (index, desired) in order {
+                let width = desired.min(room / u16::try_from(remaining).unwrap_or(u16::MAX));
+                natural[index] = Some(width);
+                room -= width;
+                remaining -= 1;
+            }
+        } else {
+            room -= u16::try_from(demand).unwrap_or(u16::MAX);
+        }
+        let mut shares = crate::mod_layout::distribute(
+            room,
+            &shown
+                .iter()
+                .zip(&natural)
+                .filter(|(_, natural)| natural.is_none())
+                .map(|(child, _)| child.flex())
+                .collect::<Vec<_>>(),
+        )
+        .into_iter();
+        let slots = natural
+            .iter()
+            .map(|slot| slot.unwrap_or_else(|| shares.next().unwrap_or(0)))
+            .collect::<Vec<_>>();
+        let drawn = shown
+            .iter()
+            .zip(&slots)
+            .map(|(child, slot)| child.width_bounds().1.map_or(*slot, |max| max.min(*slot)))
+            .collect::<Vec<_>>();
+        if let Some(index) = shown
+            .iter()
+            .zip(&drawn)
+            .position(|(child, width)| !child.fits(*width))
+        {
+            shown.remove(index);
+            continue;
+        }
+        let mut x = 0;
+        return shown
+            .into_iter()
+            .zip(slots.into_iter().zip(drawn))
+            .map(|(child, (slot, drawn))| {
+                let at = x;
+                x += slot + gap;
+                (child, at, drawn)
+            })
+            .collect();
+    }
+}
+
+/// Lays children out in a column or a row with `gap` cells between them.
+fn stack(
+    children: &[ModComponent],
+    width: u16,
+    frame: &Frame,
+    interaction: &mut Interaction,
+) -> Vec<ComponentRow> {
+    use ratatui::text::Span;
+    match frame.direction {
+        ModDirection::Column => {
+            let mut rows = Vec::new();
+            for child in children {
+                let child_rows =
+                    component_rows(std::slice::from_ref(child), width, interaction, frame.look);
+                if child_rows.is_empty() {
+                    continue;
+                }
+                if !rows.is_empty() {
+                    rows.extend((0..frame.gap).map(|_| ComponentRow::default()));
+                }
+                rows.extend(child_rows);
+            }
+            rows
+        }
+        ModDirection::Row => {
+            let mut placed = columns(children, width, frame.gap)
+                .into_iter()
+                .map(|(child, x, width)| {
+                    let rows =
+                        component_rows(std::slice::from_ref(child), width, interaction, frame.look);
+                    (x, width, rows.into_iter())
+                })
+                .collect::<Vec<_>>();
+            let mut ids = Vec::new();
+            for (_, _, rows) in &placed {
+                targets(rows.as_slice(), &mut ids);
+            }
+            let height = placed
+                .iter()
+                .map(|(_, _, rows)| rows.len())
+                .max()
+                .unwrap_or(0);
+            let mut rows = (0..height)
+                .map(|_| {
+                    let (mut merged, mut spans, mut cursor) = (None::<ComponentRow>, Vec::new(), 0);
+                    for (x, width, rows) in &mut placed {
+                        let mut row = rows.next().unwrap_or_default();
+                        row.clip(*width);
+                        row.shift(*x);
+                        spans.push(Span::raw(" ".repeat(usize::from(*x - cursor))));
+                        spans.extend(fit(std::mem::take(&mut row.line), *width, Style::default()));
+                        cursor = *x + *width;
+                        match &mut merged {
+                            Some(first) => first.beside.push(row),
+                            None => merged = Some(row),
+                        }
+                    }
+                    let mut row = merged.unwrap_or_default();
+                    row.line = Line::from(spans);
+                    row
+                })
+                .collect::<Vec<_>>();
+            if ids.len() > 1
+                && let Some(row) = rows.first_mut()
+            {
+                row.columns.push(ids);
+            }
+            rows
+        }
+    }
+}
+
+fn targets(rows: &[ComponentRow], ids: &mut Vec<String>) {
+    for row in rows {
+        if let (Some(_), Some(id)) = (&row.target, &row.id)
+            && !ids.contains(id)
+        {
+            ids.push(id.clone());
+        }
+        targets(&row.beside, ids);
+    }
+}
+
+/// Rows interleave a row box's columns; focus visits one column at a time, outer boxes first.
+fn column_order(interaction: &mut Interaction) {
+    for group in std::mem::take(&mut interaction.columns).into_iter().rev() {
+        let order = &mut interaction.order;
+        let ids = group
+            .into_iter()
+            .filter(|id| order.contains(id))
+            .collect::<Vec<_>>();
+        let mut slots = ids
+            .iter()
+            .filter_map(|id| order.iter().position(|held| held == id))
+            .collect::<Vec<_>>();
+        slots.sort_unstable();
+        for (slot, id) in slots.into_iter().zip(ids) {
+            order[slot] = id;
+        }
+    }
+}
+
+fn stack_height(children: &[ModComponent], width: u16, frame: &Frame) -> u16 {
+    match frame.direction {
+        ModDirection::Column => {
+            let heights = children
+                .iter()
+                .map(|child| component_height(std::slice::from_ref(child), width, frame.look))
+                .filter(|height| *height > 0)
+                .collect::<Vec<_>>();
+            heights.iter().sum::<u16>()
+                + frame.gap * u16::try_from(heights.len().saturating_sub(1)).unwrap_or(0)
+        }
+        ModDirection::Row => columns(children, width, frame.gap)
+            .into_iter()
+            .map(|(child, _, width)| {
+                component_height(std::slice::from_ref(child), width, frame.look)
+            })
+            .max()
+            .unwrap_or(0),
+    }
+}
+
+fn focus_within(component: &ModComponent, interaction: &Interaction) -> bool {
+    interaction.focused.as_ref().is_some_and(|focused| {
+        let mut all = Vec::new();
+        component.descendants(&mut all);
+        all.iter().any(|held| held.id() == Some(focused.as_str()))
+    })
+}
+
+fn span_line(
+    prefix: String,
+    spans: &[codex_omd::ModSpan],
+) -> (Line<'static>, Vec<TerminalHyperlink>) {
+    let mut column = prefix.width();
+    let mut links = Vec::new();
+    let mut line = vec![ratatui::text::Span::raw(prefix)];
+    for span in spans {
+        let width = span.text.width();
+        if let Some(link) = &span.link {
+            links.push(TerminalHyperlink::web(column..column + width, link.clone()));
+        }
+        column += width;
+        line.push(ratatui::text::Span::styled(
+            span.text.clone(),
+            span_style(span),
+        ));
+    }
+    (Line::from(line), links)
+}
+
+fn row_links(row: &ComponentRow) -> Vec<&TerminalHyperlink> {
+    row.links
+        .iter()
+        .chain(row.beside.iter().flat_map(row_links))
+        .collect()
+}
+
+fn mark_links(buffer: &mut Buffer, area: Rect, rows: &[ComponentRow]) {
+    for (row, links) in rows
+        .iter()
+        .map(row_links)
+        .enumerate()
+        .take(usize::from(area.height))
+    {
+        for link in links {
+            let Some(destination) = link.terminal_destination() else {
+                continue;
+            };
+            for column in link
+                .columns
+                .clone()
+                .take_while(|column| *column < usize::from(area.width))
+            {
+                let cell = &mut buffer[(area.x + column as u16, area.y + row as u16)];
+                if cell.diff_option == ratatui::buffer::CellDiffOption::Skip {
+                    continue;
+                }
+                let width = std::num::NonZeroU16::new(cell.cell_width())
+                    .unwrap_or(std::num::NonZeroU16::MIN);
+                let symbol = format!("\x1b]8;;{destination}\x07{}\x1b]8;;\x07", cell.symbol());
+                cell.set_symbol(&symbol)
+                    .set_diff_option(ratatui::buffer::CellDiffOption::ForcedWidth(width));
+            }
+        }
+    }
+}
