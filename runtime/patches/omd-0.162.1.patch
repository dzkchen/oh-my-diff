+impl ClientSurface for TuiSurface {
+    fn submit(&self, mut call: SurfaceCall) -> Result<(), String> {
+        call.lifetime.binding = Some(call_binding(&call.caller));
+        let admitted = call.validity.clone();
+        let current = crate::mod_runtime::context_unchanged().1;
+        let thread = call.thread.clone();
+        let host = call.caller == codex_omd::broker::HOST_CALLER;
+        call.validity = codex_omd::client_surface::Validity(std::sync::Arc::new(move || {
+            (admitted.0)() && current() && (host || thread == current_thread())
+        }));
+        if !(call.validity.0)() {
+            call.reply_blit(Err("client_context_changed".into()));
+            return Ok(());
+        }
+        let binding = (call.operation == "terminal.pty")
+            .then(|| {
+                crate::mod_pty::binding(
+                    &call.caller,
+                    call.thread.as_deref(),
+                    call.authority.as_ref().ok_or("pty_authority_missing")?,
+                )
+            })
+            .transpose()?;
+        self.0
+            .send(AppEvent::ModSurfaceCall(Box::new(call), binding));
+        Ok(())
+    }
+
+    fn redraw(&self) {
+        self.0.send(AppEvent::ModViewChanged);
+    }
+
+    fn client(&self) -> Value {
+        crate::mod_client::value()
+    }
+}
+
+#[derive(Default)]
+struct State {
+    registration: Option<Registration>,
+    thread: Option<String>,
+    checked: Option<Instant>,
+    subscribers: Vec<(String, Vec<String>)>,
+    events: BTreeSet<String>,
+    completers: BTreeSet<String>,
+    completion_owner: bool,
+    triggers: BTreeMap<String, String>,
+    view: Option<(usize, Option<&'static str>, bool)>,
+    queues: BTreeMap<String, NotificationQueue>,
+    requests: BTreeMap<String, NotificationQueue>,
+    requested: BTreeMap<String, String>,
+    delivering: bool,
+    pending: BTreeMap<u64, SurfaceCall>,
+    clipboard: Option<(u64, SurfaceCall)>,
+    next: u64,
+    notified: Option<Instant>,
+    keys: Option<Vec<(String, Option<String>)>>,
+}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+static CONTEXT_EPOCH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn state() -> MutexGuard<'static, Option<State>> {
+    STATE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn with<T>(run: impl FnOnce(&mut State) -> T) -> T {
+    let mut guard = state();
+    run(guard.get_or_insert_with(State::default))
+}
