+use super::*;
+use std::sync::Arc;
+
+const BELOW_COMPOSER_ROWS: u16 = 6;
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub(crate) enum FooterSite {
+    Above,
+    Below,
+}
+
+#[derive(Default)]
+struct FooterCache {
+    active: bool,
+    layouts: BTreeMap<(FooterSite, u16), Arc<FooterLayout>>,
+    rendered: BTreeMap<FooterSite, (Rect, Arc<FooterLayout>, usize)>,
+}
+
+static FOOTER: Mutex<FooterCache> = Mutex::new(FooterCache {
+    active: false,
+    layouts: BTreeMap::new(),
+    rendered: BTreeMap::new(),
+});
+
+pub(crate) struct FooterFrame;
+
+pub(crate) fn footer_frame() -> FooterFrame {
+    *FOOTER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = FooterCache {
+        active: true,
+        ..FooterCache::default()
+    };
+    FooterFrame
+}
+
+impl Drop for FooterFrame {
+    fn drop(&mut self) {
+        *FOOTER
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = FooterCache::default();
+    }
+}
+
+pub(crate) struct FooterLayout {
+    rows: Vec<ComponentRow>,
+    lines: Vec<HyperlinkLine>,
+    key_panes: BTreeSet<String>,
+    site: FooterSite,
+}
+
+pub(crate) fn footer_layout(site: FooterSite, width: u16) -> Arc<FooterLayout> {
+    if let Some(layout) = FOOTER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .layouts
+        .get(&(site, width))
+    {
+        return Arc::clone(layout);
+    }
+    let snapshot = with_cache(|cache| Arc::clone(&cache.snapshot)).unwrap_or_default();
+    let style = panel_style(&snapshot.view);
+    let look = (snapshot.view.theme.border, snapshot.view.theme.icons);
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction.component_owners = snapshot.component_owners.clone();
+    bind_terminals(&mut interaction, &snapshot);
+    let rows = match site {
+        FooterSite::Above => {
+            let mut rows = if let Some(site) = self::site(&snapshot.view, "above_composer") {
+                component_rows(&site.components, width, &mut interaction, look)
+            } else {
+                snapshot
+                    .view
+                    .footer
+                    .as_ref()
+                    .map(panel_lines)
+                    .unwrap_or_default()
+                    .into_iter()
+                    .map(|line| ComponentRow {
+                        line,
+                        ..ComponentRow::default()
+                    })
+                    .collect()
+            };
+            if let Some(cards) = native_cards(&snapshot) {
+                rows.extend(component_rows(&[cards], width, &mut interaction, look));
+            }
+            rows.extend(
+                live_notices(NoticePlacement::Toast)
+                    .into_iter()
+                    .map(|notice| {
+                        let mut spans =
+                            crate::history_cell::notice_spans(notice.kind, &notice.text);
+                        spans.push(format!(" ({})", notice.owner).dark_gray());
+                        ComponentRow {
+                            line: Line::from(spans),
+                            ..ComponentRow::default()
+                        }
+                    }),
+            );
+            rows
+        }
+        FooterSite::Below => self::site(&snapshot.view, "below_composer")
+            .map(|site| component_rows(&site.components, width, &mut interaction, look))
+            .unwrap_or_default(),
+    };
+    let mut lines = Vec::new();
+    let rows: Vec<ComponentRow> = rows
+        .into_iter()
+        .flat_map(|row| {
+            let line = HyperlinkLine {
+                hyperlinks: row_links(&row).into_iter().cloned().collect(),
+                ..HyperlinkLine::new(row.line.clone().patch_style(style))
+            };
+            let wrapped = if line.width() > usize::from(width) {
+                crate::terminal_hyperlinks::adaptive_wrap_hyperlink_lines(
+                    &[line],
+                    crate::wrapping::RtOptions::new(usize::from(width.max(1))),
+                )
+            } else {
+                vec![line]
+            };
+            let mut fragments = Vec::new();
+            for line in wrapped {
+                let mut fragment = row.clone();
+                fragment.line = line.line.clone();
+                fragments.push(fragment);
+                lines.push(line);
+            }
+            fragments
+        })
+        .collect();
+    let mut ids = Vec::new();
+    targets(&rows, &mut ids);
+    let key_panes = ids
+        .into_iter()
+        .chain(rows.iter().filter_map(|row| row.id.clone()))
+        .filter(|id| interaction.key_panes.contains(id))
+        .collect();
+    let layout = Arc::new(FooterLayout {
+        rows,
+        lines,
+        key_panes,
+        site,
+    });
+    let mut cache = FOOTER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if cache.active {
+        cache.layouts.insert((site, width), Arc::clone(&layout));
+    }
+    layout
+}
+
+impl FooterLayout {
+    pub(crate) fn height(&self) -> u16 {
+        let height = u16::try_from(self.lines.len()).unwrap_or(u16::MAX);
+        match self.site {
+            FooterSite::Above => height,
+            FooterSite::Below => height.min(BELOW_COMPOSER_ROWS),
+        }
+    }
+
+    pub(crate) fn render(self: &Arc<Self>, area: Rect, buffer: &mut Buffer) {
+        let interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let scroll = focused_scroll(&self.rows, area.height, &interaction);
+        drop(interaction);
+        crate::terminal_hyperlinks::HyperlinkParagraph::new(
+            &self.lines[scroll..],
+            Style::default(),
+        )
+        .render(area, buffer);
+        let mut cache = FOOTER
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if cache.active {
+            if area.is_empty() {
+                cache.rendered.remove(&self.site);
+            } else {
+                cache
+                    .rendered
+                    .insert(self.site, (area, Arc::clone(self), scroll));
+            }
+        }
+    }
+}
+
+pub(super) fn register_footer(interaction: &mut Interaction) {
+    let cache = FOOTER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    for (area, layout, scroll) in cache.rendered.values() {
+        interaction
+            .key_panes
+            .extend(layout.key_panes.iter().cloned());
+        register_component_targets(*area, layout.rows.clone(), *scroll, interaction);
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn footer_hyperlink_lines(width: u16) -> Vec<HyperlinkLine> {
+    footer_layout(FooterSite::Above, width).lines.clone()
+}
