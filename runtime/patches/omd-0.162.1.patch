+pub(crate) fn wants_call_facts(session: &Session) -> bool {
+    let extensions = &session.services.extensions;
+    !extensions.tool_reaction_contributors().is_empty()
+        || extensions
+            .tool_lifecycle_contributors()
+            .iter()
+            .any(|contributor| contributor.wants_call_facts())
+}
