+    sync_interaction(&plain.view);
+    render(area, area, &mut buffer, &plain);
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, events(&[("chart", "leave 1 2")])),
+        "a vanished region leaves at its last known cells"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Moved, x + 1, y + 2),
+        (false, Vec::new()),
+        "views without pointer components add no pointer work"
+    );
+    crate::mod_raster::retain(&BTreeSet::new());
