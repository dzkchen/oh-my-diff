+/// `None` means the thread was busy and is still running.
+pub(super) async fn wait_for_thread_shutdown_if_idle(
+    thread: &Arc<CodexThread>,
+) -> Option<ThreadShutdownResult> {
+    match tokio::time::timeout(Duration::from_secs(10), thread.shutdown_if_idle()).await {
+        Ok(Ok(false)) => None,
+        Ok(Ok(true)) => Some(ThreadShutdownResult::Complete),
+        Ok(Err(_)) => Some(ThreadShutdownResult::SubmitFailed),
+        Err(_) => Some(ThreadShutdownResult::TimedOut),
+    }
