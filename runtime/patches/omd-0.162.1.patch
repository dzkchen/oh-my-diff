+#[test]
+#[serial_test::serial]
+fn inline_renders_bound_both_caches_across_state_invalidations() {
+    struct Restore(bool, Option<Engine>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            HOOKED.store(self.0, Ordering::Relaxed);
+            *ENGINE.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = self.1.take();
+        }
+    }
+    let _restore = Restore(
+        HOOKED.swap(true, Ordering::Relaxed),
+        ENGINE.lock().unwrap().take(),
+    );
+    let _wait = Wait::enter();
+    for invalidated in [false, true] {
+        for index in 0..=DONE_LIMIT {
+            let target = RenderTarget::new(
+                "assistant_message",
+                format!("inline-{invalidated}-{index}"),
+                false,
+                json!({"text": "cached response"}),
+            );
+            resolve(&target, 80);
+            let (done, latest, newest) = engine(|engine| {
+                (
+                    engine.done.len(),
+                    engine.latest.len(),
+                    engine.latest.contains_key(&(target.component.to_owned(), target.id.clone())),
+                )
+            });
+            assert!(done > 0 && done <= DONE_LIMIT);
+            assert!(latest <= DONE_LIMIT);
+            assert!(newest);
+            if invalidated {
+                forget();
+            }
+        }
+    }
+}
