+fn placed(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> std::borrow::Cow<'_, image::DynamicImage> {
+    codex_omd::process_raster::resized(decoded, placed_size(decoded, columns, rows, cell))
+}
+
+fn placed_size(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> (u32, u32) {
+    codex_omd::process_raster::fit_within(
+        (decoded.width(), decoded.height()),
+        kitty_pixels(columns, rows, cell),
+    )
+}
