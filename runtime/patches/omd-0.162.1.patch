+    for case in cases.as_array().unwrap() {
+        let encoded = format!(
+            "{}{}{}",
+            case["prefix"].as_str().unwrap(),
+            case["unit"]
+                .as_str()
+                .unwrap()
+                .repeat(case["repeat"].as_u64().unwrap() as usize),
+            case["suffix"].as_str().unwrap()
+        );
+        assert_eq!(
+            validate_ui_state(&encoded).is_ok(),
+            case["valid"].as_bool().unwrap(),
+            "{}",
+            case["name"]
+        );
+    }
