@@ -0,0 +1,504 @@
+use super::*;
+use std::os::unix::fs::MetadataExt;
+
+#[cfg(target_os = "macos")]
+pub const MANAGED_POLICY_FILE: &str = "/Library/Application Support/OhMyDiff/policy.json";
+#[cfg(not(target_os = "macos"))]
