+fn tampered_policy_fails_closed_and_stale_or_revoked_managed_content_never_loads() {
+    let admin = Admin::new();
+    let store = admin.store("alice");
+    let (guard, guard_sha) = admin.package("guard", "guard", GUARD, &["interception"]);
