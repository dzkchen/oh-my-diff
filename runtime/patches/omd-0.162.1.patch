+pub(super) async fn rewrite(
+    store: &LocalThreadStore,
+    params: RewriteThreadParams,
+) -> ThreadStoreResult<ThreadRewrite> {
+    let RewriteThreadParams {
+        thread_id,
+        expected_revision,
+        edits,
+        undo,
+        author,
+        multi_agent_version,
+        witness,
+        dry_run,
+    } = params;
+    let Some(expected_revision) = expected_revision else {
+        let (rollout_id, _, entries, _) = load_current(store, thread_id).await?;
+        return Ok(ThreadRewrite {
+            revision: revision(rollout_id, &entries),
+            previous_revision: None,
+            rows: public_rows(&entries),
+        });
+    };
+    if edits.is_empty() != undo || edits.len() > MAX_EDITS {
+        return Err(invalid(format!(
+            "history_rewrite_invalid: pass 1 to {MAX_EDITS} edits or undo"
+        )));
+    }
+    let log = log_path(store, thread_id);
+    if dry_run {
+        let records = recover(store, thread_id, &log, witness.as_deref(), false).await?;
+        let planned = plan(
+            store,
+            thread_id,
+            &records,
+            &expected_revision,
+            &edits,
+            undo,
+            &author,
+        )
+        .await?;
+        return Ok(ThreadRewrite {
+            revision: revision(planned.new_rollout_id, &planned.entries),
+            previous_revision: Some(planned.previous_revision),
+            rows: public_rows(&planned.entries),
+        });
+    }
+    let state_db = store
+        .state_db()
+        .await
+        .ok_or(ThreadStoreError::Unsupported {
+            operation: "rewrite_thread",
+        })?;
+    let _lifecycle_guard = store.live_writer_locks.lock_lifecycle(thread_id).await;
+    let _live_writer_guard = store.live_writer_locks.lock(thread_id).await;
+    store.ensure_live_recorder_absent(thread_id).await?;
+    let writer_lock = store.acquire_writer_lock(thread_id)?;
+    let records = recover(store, thread_id, &log, witness.as_deref(), true).await?;
+
+    let expected_sqlite_path = state_db
+        .get_thread(thread_id)
+        .await
+        .map_err(|err| {
+            internal(format!(
+                "failed to read thread metadata for {thread_id}: {err}"
+            ))
+        })?
+        .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?
+        .rollout_path;
+    let Plan {
+        rollout_id,
+        previous_revision,
+        new_rollout_id,
+        mut source_meta,
+        sources,
+        entries,
+        forked,
+        subagent,
+        source_forked,
+        source_subagent,
+    } = plan(
+        store,
+        thread_id,
+        &records,
+        &expected_revision,
+        &edits,
+        undo,
+        &author,
+    )
+    .await?;
+
+    append_record(
+        &log,
+        witness.as_deref(),
+        &Record::Begin {
+            revision: new_rollout_id,
+            previous: rollout_id,
+            undo,
+            author: author.clone(),
+            at_ms: chrono::Utc::now().timestamp_millis(),
+            sources,
+            written: entries.len() as u64,
+            source_forked_from_ordinal_exclusive: source_forked,
+            source_subagent_history_start_ordinal: source_subagent,
+            edits,
+        },
+    )?;
+    source_meta.multi_agent_version = multi_agent_version.or(source_meta.multi_agent_version);
+    source_meta.subagent_history_start_ordinal = subagent;
+    let items: Vec<RolloutItem> = entries.iter().map(|entry| entry.item.clone()).collect();
+    let written = async {
+        let recorder = create_replacement_recorder(
+            store,
+            source_meta,
+            new_rollout_id,
+            None,
+            forked,
+            Arc::clone(&writer_lock),
+        )
+        .await?;
+        let path = recorder.rollout_path().to_path_buf();
+        recorder
+            .record_canonical_items(&items)
+            .await
+            .map_err(thread_store_io_error)?;
+        recorder.persist().await.map_err(thread_store_io_error)?;
+        recorder.shutdown().await.map_err(thread_store_io_error)?;
+        super::thread_history_materialization::materialize_to_sqlite(
+            store,
+            new_rollout_id,
+            path.as_path(),
+        )
+        .await?;
+        let replaced = state_db
+            .replace_rollout_path_if_current(
+                thread_id,
+                expected_sqlite_path.as_path(),
+                path.as_path(),
+            )
+            .await
+            .map_err(|err| {
+                internal(format!(
+                    "failed to switch thread {thread_id} to rewritten rollout: {err}"
+                ))
+            })?;
+        if !replaced {
+            return Err(ThreadStoreError::Conflict {
+                message: format!("thread {thread_id} changed while it was being rewritten"),
+            });
+        }
+        Ok(())
+    }
+    .await;
+    if let Err(err) = written {
+        // A failed abort stays a pending record, which the next access resolves.
+        let _ = abort(store, &log, witness.as_deref(), new_rollout_id).await;
+        return Err(err);
+    }
+    // The rollout switch is the commit point; a missing record is resolved by the next access.
+    let _ = append_record(
+        &log,
+        witness.as_deref(),
+        &Record::Commit {
+            revision: new_rollout_id,
+        },
+    );
+    Ok(ThreadRewrite {
+        revision: revision(new_rollout_id, &entries),
+        previous_revision: Some(previous_revision),
+        rows: public_rows(&entries),
+    })
+}
+
+pub(super) async fn verify(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    witness: Option<Arc<dyn HistoryWitness>>,
+) -> ThreadStoreResult<()> {
+    let log = log_path(store, thread_id);
+    if !log.exists() && witness.is_none() {
+        return Ok(());
+    }
+    let _lifecycle_guard = store.live_writer_locks.lock_lifecycle(thread_id).await;
+    // A rewrite in another process holds the writer lock until its commit record is written.
+    let writer_lock = store.acquire_writer_lock(thread_id).ok();
+    recover(
+        store,
+        thread_id,
+        &log,
+        witness.as_deref(),
+        writer_lock.is_some(),
+    )
+    .await
+    .map(drop)
+}
+
+async fn recover(
+    store: &LocalThreadStore,
+    thread_id: ThreadId,
+    log: &Path,
+    witness: Option<&dyn HistoryWitness>,
+    resolve_pending: bool,
+) -> ThreadStoreResult<Vec<Record>> {
+    let (mut records, digests, torn) = read_log(log)?;
+    if torn && resolve_pending {
+        drop_last_record(log)?;
+    }
+    if let Some(witness) = witness
+        && let Err(err) = witness.verify(log, &digests)
+    {
+        if err.kind() != std::io::ErrorKind::InvalidData {
+            return Err(internal(format!(
+                "history_anchor_unavailable: revision log of thread {thread_id}: {err}"
+            )));
+        }
+        // A record is fsynced before its anchor, so a crash or lost reply leaves the log one record ahead.
+        let behind = digests
+            .len()
+            .checked_sub(1)
+            .is_some_and(|last| witness.verify(log, &digests[..last]).is_ok());
+        if !behind {
+            return Err(invalid(format!(
+                "history_anchor_mismatch: revision log of thread {thread_id}: {err}"
+            )));
+        }
+        if resolve_pending {
+            drop_last_record(log)?;
+            records.pop();
+        }
+    }
+    if resolve_pending && let Some(Record::Begin { revision, .. }) = records.last() {
+        let revision = *revision;
+        let current = thread_rollout_resolver::resolve_current(store, thread_id)
+            .await?
+            .map(|current| current.rollout_id);
+        if current == Some(revision) {
+            append_record(log, witness, &Record::Commit { revision })?;
+            records.push(Record::Commit { revision });
+        } else {
+            abort(store, log, witness, revision).await?;
+            records.push(Record::Abort { revision });
+        }
+    }
+    let committed: HashSet<ThreadId> = records
+        .iter()
+        .filter_map(|record| match record {
+            Record::Commit { revision } => Some(*revision),
+            _ => None,
+        })
+        .collect();
+    if let Some(Record::Begin { sources, .. }) = records.iter().rev().find(
+        |record| matches!(record, Record::Begin { revision, .. } if committed.contains(revision)),
+    ) {
+        load_segments(store, sources).await?;
+    }
+    Ok(records)
+}
+
+async fn abort(
+    store: &LocalThreadStore,
+    log: &Path,
+    witness: Option<&dyn HistoryWitness>,
+    revision: ThreadId,
+) -> ThreadStoreResult<()> {
+    if let Some(path) =
+        codex_rollout::find_rollout_path_by_rollout_id(store.config.codex_home.as_path(), revision)
+            .await
+            .map_err(thread_store_io_error)?
+    {
+        let _ = tokio::fs::remove_file(path).await;
+    }
+    append_record(log, witness, &Record::Abort { revision })
+}
