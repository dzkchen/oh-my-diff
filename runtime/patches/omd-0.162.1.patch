+#[test]
+fn current_completion_retries_and_posts_but_queued_posts_expire_on_remount() {
+    let mut original = fresh("owner", "module");
+    original.events = vec![json!({"first": true})];
+    let mut job = take_job(&mut original);
+    original.events = vec![json!({"second": true})];
+    let mut mounted = HashMap::from([(job.id.clone(), original)]);
+    assert!(matches!(finish_job(&mut mounted, &mut job, None), Some(None)));
+    assert_eq!(
+        mounted["module"].events,
+        vec![json!({"first": true}), json!({"second": true})]
+    );
+    assert!(mounted["module"].changed);
+    assert!(mounted["module"].stepped.is_some());
+
+    let mut job = take_job(mounted.get_mut("module").unwrap());
+    let post = finish_job(
+        &mut mounted,
+        &mut job,
+        Some(Ok(json!({
+            "tree": tree("current"), "next_ms": 5,
+            "post": {"data": {"current": true}}
+        }))),
+    )
+    .flatten()
+    .expect("current step posts");
+    assert!(post.current(&mounted));
+    assert_eq!(post.owner, "owner");
+    assert_eq!(post.payload, json!({
+        "component": "module", "module": "module", "data": {"current": true}
+    }));
+    assert_eq!(mounted["module"].tree, tree("current"));
+    assert!(mounted["module"].mounted);
+    assert!(mounted["module"].due.is_some());
+    mounted.remove("module");
+    assert!(!post.current(&mounted));
+    mounted.insert("module".to_owned(), fresh("owner", "module"));
+    assert!(!post.current(&mounted));
+
+    let mut job = take_job(mounted.get_mut("module").unwrap());
+    assert!(matches!(
+        finish_job(&mut mounted, &mut job, Some(Err("current failure".to_owned()))),
+        Some(None)
+    ));
+    assert_eq!(mounted["module"].failed.as_deref(), Some("current failure"));
+    assert!(!mounted["module"].mounted);
+}
