+/// Marker cells for a picture the terminal draws: Kitty placeholders over a transmitted image, or inline-image markers `mod_client::place` replaces.
+#[allow(clippy::too_many_arguments)]
+fn marker_rows(
+    component: &str,
+    sha256: &str,
+    width: u16,
+    height: u16,
+    cell: (u16, u16),
+    load: &dyn Fn() -> Option<Vec<u8>>,
+    prefix: &str,
+    inline: bool,
+    pixels: Option<&image::DynamicImage>,
+) -> Option<Vec<Line<'static>>> {
+    let (width, height) = (
+        width.min(crate::mod_client::max_placeholder_cells()),
+        height.min(crate::mod_client::max_placeholder_cells()),
+    );
+    let key = format!("{sha256}:{width}:{height}:{}x{}", cell.0, cell.1);
+    let (id, columns, rows) = if inline {
+        crate::mod_client::iip_image(component, &key, || {
+            let (bytes, size) = if let Some(pixels) = pixels {
+                let size = (pixels.width(), pixels.height());
+                let (columns, rows) = fit(size, width, height, cell);
+                (inline_png(pixels, columns, rows, cell)?, size)
+            } else {
+                let bytes = load()?;
+                let size = dimensions(&bytes)?;
+                (bytes, size)
+            };
+            let (columns, rows) = fit(size, width, height, cell);
+            Some((Arc::<[u8]>::from(bytes), columns, rows))
+        })?
+    } else {
+        crate::mod_client::kitty_image(component, &key, || {
+            let decoded;
+            let pixels = if let Some(pixels) = pixels {
+                pixels
+            } else {
+                decoded = decode_once(sha256, load)?;
+                &decoded
+            };
+            let (columns, rows) = fit((pixels.width(), pixels.height()), width, height, cell);
+            Some((placement_pixels(pixels, columns, rows, cell), columns, rows))
+        })?
+    };
+    Some(crate::mod_client::placeholder_rows(
+        id, columns, rows, prefix,
+    ))
+}
+
+/// Terminal-drawn pictures where the client supports them, else cached half-block rows (`key` identifies the picture and its fit).
+pub(crate) fn picture_rows(
+    component: &str,
+    sha256: &str,
+    key: &str,
+    width: u16,
+    height: u16,
+    prefix: &str,
+    load: &dyn Fn() -> Option<Vec<u8>>,
+    pixels: Option<&image::DynamicImage>,
+) -> Option<Vec<Line<'static>>> {
+    let client = crate::mod_client::facts();
+    if (client.placeholders || client.iip)
+        && let Some(rows) = marker_rows(
+            component,
+            sha256,
+            width,
+            height,
+            client.cell.unwrap_or(crate::mod_client::DEFAULT_CELL),
+            load,
+            prefix,
+            client.iip,
+            pixels,
+        )
+    {
+        return Some(rows);
+    }
+    let mut images = IMAGES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached, rows)) = images.get(component)
+        && cached == key
+    {
+        return Some(rows.clone());
+    }
+    let decoded;
+    let pixels = if let Some(pixels) = pixels {
+        pixels
+    } else {
+        decoded = decode_once(sha256, load)?;
+        &decoded
+    };
+    let rows = codex_omd::client_surface::half_block(pixels, width, height)
+        .iter()
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend(row.iter().map(|cell| crate::mod_raster::span(cell, false)));
+            Line::from(spans)
+        })
+        .collect::<Vec<_>>();
+    images.insert(component.to_owned(), (key.to_owned(), rows.clone()));
+    Some(rows)
+}
