+    assert_eq!(provenance["event"], "timer");
+    core.autonomy
+        .with(&thread, |queue| queue.running = None)
+        .unwrap();
+    let mut stale = grants.clone();
+    stale.get_mut("monitor").unwrap().source_sha256 = "other".into();
+    let (none, notices) = pick(&stale);
