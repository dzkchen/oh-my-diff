+#[serial_test::serial]
+fn tool_notices_report_whether_a_drawn_cell_claims_the_call() {
+    clear_tool_notices();
+    let target = |id: &str| RenderTarget::new("tool_call", id, false, json!({}));
+    assert!(!tool_notice("call_unseen", "info", "x", "checks"));
+    assert!(
+        tool_notice_lines(&target("call_unseen")).is_empty(),
+        "a refused notice is not stored for a cell drawn later"
+    );
+    tool_notice_lines(&target("call_seen"));
