+use super::*;
+use crate::outgoing_message::OutgoingEnvelope;
+use crate::transport::OutgoingMessage;
+use codex_app_server_protocol::ServerRequest;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::sync::mpsc;
+
+fn renderer(formats: &[OmdRenderFormat]) -> Mutex<OmdRenderer> {
+    Mutex::new(OmdRenderer {
+        kind: OmdRendererKind::Terminal,
+        formats: formats.to_vec(),
+        pointer: OmdPointer::None,
+        reduced_motion: false,
+        cell_px: None,
+    })
+}
+
+fn attach(clients: &OmdClients, connection: u64, operations: &[&str]) {
+    let operations = operations
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>();
+    let entry = client_surface::attach(client_surface::ClientEntry {
+        id: format!("test-{connection}"),
+        name: "test".to_string(),
+        renderer: Value::Null,
+        viewport: Value::Null,
+        operations: operations.clone(),
+        attached_ms: 0,
+        focused: false,
+    });
+    clients.attached().insert(
+        ConnectionId(connection),
+        Attached {
+            client_id: format!("test-{connection}"),
+            operations,
+            renderer: Arc::new(renderer(&[])),
+            view: Arc::default(),
+            _observer: client_surface::register_observer(Arc::new(|_| {})),
+            _entry: entry,
+        },
+    );
+}
+
+async fn sent_call(outgoing: &mut mpsc::Receiver<OutgoingEnvelope>) -> (u64, RequestId, Value) {
+    match outgoing.recv().await {
+        Some(OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::Request(ServerRequest::OmdSurfaceCall { request_id, params }),
+            ..
+        }) => (connection_id.0, request_id, json!(params)),
+        other => panic!("expected omd/surface/call, got {other:?}"),
+    }
+}
+
+#[tokio::test]
+async fn surface_calls_reach_declaring_clients_and_end_with_the_mod_call_or_the_connection() {
+    let (sender, mut outgoing) = mpsc::channel(8);
+    let clients = OmdClients::new(Arc::new(OutgoingMessageSender::new(
+        sender,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    )));
+    attach(&clients, 91, &["terminal.pane"]);
+    attach(&clients, 92, &[]);
+    assert_eq!(clients.serving("terminal.pane"), vec![ConnectionId(91)]);
+    let params = OmdSurfaceCallParams {
+        caller: "demo".to_string(),
+        operation: "terminal.pane".to_string(),
+        arguments: json!({"action": "open", "id": "main"}),
+        confirm: None,
+    };
+
+    let call = tokio::spawn({
+        let clients = Arc::clone(&clients);
+        let params = params.clone();
+        async move {
+            clients
+                .surface_call(vec![ConnectionId(91)], params, || true)
+                .await
+        }
+    });
+    let (connection, request_id, sent) = sent_call(&mut outgoing).await;
+    assert_eq!(
+        (connection, sent),
+        (
+            91,
+            json!({"caller": "demo", "operation": "terminal.pane",
+                "arguments": {"action": "open", "id": "main"}})
+        )
+    );
+    clients
+        .outgoing
+        .notify_client_response(ConnectionId(91), request_id, json!({"applied": true}))
+        .await;
+    assert_eq!(call.await.unwrap(), Ok(json!({"applied": true})));
+
+    let active = Arc::new(AtomicBool::new(true));
+    let call = tokio::spawn({
+        let (clients, params, active) = (Arc::clone(&clients), params.clone(), Arc::clone(&active));
+        async move {
+            clients
+                .surface_call(vec![ConnectionId(91)], params, || {
+                    active.load(Ordering::Acquire)
+                })
+                .await
+        }
+    });
+    sent_call(&mut outgoing).await;
+    active.store(false, Ordering::Release);
+    assert_eq!(call.await.unwrap(), Err("callback_cancelled".to_string()));
+    assert!(clients.calls().is_empty());
+
+    let call = tokio::spawn({
+        let clients = Arc::clone(&clients);
+        async move {
+            clients
+                .surface_call(vec![ConnectionId(91)], params, || true)
+                .await
+        }
+    });
+    sent_call(&mut outgoing).await;
+    clients.connection_closed(ConnectionId(91)).await;
+    assert_eq!(
+        call.await.unwrap(),
+        Err("client_surface_closed".to_string())
+    );
+    assert_eq!(clients.serving("terminal.pane"), Vec::<ConnectionId>::new());
+}
