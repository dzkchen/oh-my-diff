+#[test]
+fn a_backlog_of_image_frames_keeps_only_the_newest_per_raster() {
+    let blit = |key: &str, image: bool| Observed::Mirrored {
+        pixels: None,
+        caller: "demo".to_string(),
+        operation: "terminal.blit".to_string(),
+        arguments: if image {
+            json!({"key": key, "image": {"media_type": "image/png", "base64": ""}})
+        } else {
+            json!({"key": key, "rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]})
+        },
+    };
+    let batch = [
+        blit("a", true),
+        blit("b", true),
+        blit("a", false),
+        blit("a", true),
+        Observed::Redraw,
+        blit("b", false),
+    ];
+    let mut queue = std::collections::VecDeque::new();
+    let queue_one = |queue: &mut std::collections::VecDeque<Queued>, observed: Observed| {
+        let mirror = Mirror::of(&observed).unwrap();
+        queue_observation(queue, observed, mirror);
+    };
+    for observed in batch {
+        queue_one(&mut queue, observed);
+    }
+    assert_eq!(queue.len(), 5);
+    for n in 0..40 {
+        queue_one(&mut queue, blit(&format!("r{n}"), true));
+    }
+    let frames = |queue: &std::collections::VecDeque<Queued>| {
+        queue
+            .iter()
+            .filter_map(|queued| queued.frame.clone())
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(frames(&queue).len(), 32);
+    assert_eq!(frames(&queue).last().unwrap().0.1, "r39");
+    let large = |key: &str| Observed::Mirrored {
+        pixels: None,
+        caller: "demo".to_string(),
+        operation: "terminal.blit".to_string(),
+        arguments: json!({"key": key, "image": {"media_type": "image/png", "base64": "A".repeat(20 << 20)}}),
+    };
+    for key in ["big1", "big2", "big3", "big4"] {
+        queue_one(&mut queue, large(key));
+    }
+    assert_eq!(
+        frames(&queue)
+            .iter()
+            .map(|((_, key), bytes)| (key.as_str(), *bytes))
+            .collect::<Vec<_>>(),
+        [("big2", 20 << 20), ("big3", 20 << 20), ("big4", 20 << 20)]
+    );
+}
