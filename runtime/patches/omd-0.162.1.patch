+pub(crate) use codex_omd::profile as startup_profile;
+
+/// Evaluate presentation before the provisional composer has a live thread.
+/// The normal terminal observer path rejects native-task operations at the host boundary.
+pub(crate) fn prepare_startup(repository: &Path, phase: &str) {
+    prepare_startup_active(repository, phase, &|| true);
+}
+
+pub(crate) fn prepare_startup_active(repository: &Path, phase: &str, active: &dyn Fn() -> bool) {
+    let started = Instant::now();
+    if !crate::omd::is_active() || !active() {
+        return;
+    }
+    if crate::mod_ui::startup_context_matches(repository, phase) {
+        return;
+    }
+    let snapshot = (|| {
+        crate::omd::mod_paths_for(repository)?;
+        let runtime = shared_host_active(active).ok()?;
+        let mut runtime = try_lock_until(&runtime, active)?;
+        if !active() {
+            return None;
+        }
+        reload_active(&mut runtime, active);
+        let mut input = serde_json::json!({
+            "event": "startup", "ledger": null,
+            "identity": runtime.identity(crate::version::CODEX_CLI_VERSION,
+                std::env::var(crate::omd::INSTALL_PROFILE_ENV).ok().as_deref(), "omd"),
+            "presentation": codex_omd::client_surface::presented(
+                serde_json::json!({"thread_id": null, "phase": phase})),
+            "client": crate::mod_client::value(),
+        });
+        let pty_scope = serde_json::json!({"epoch": codex_omd::client_surface::epoch(), "admission": codex_omd::client_surface::admission(), "configuration": runtime.configuration_sha256()});
+        let terminal_started = Instant::now();
+        let terminal = runtime.terminal_view(input.clone(), active);
+        startup_profile("startup_terminal", terminal_started);
+        input["pty_scope"] = pty_scope;
+        Some(ModViewSnapshot {
+            view: terminal.view,
+            contributors: terminal.contributors,
+            conflicts: terminal.conflicts,
+            component_owners: terminal.component_owners,
+            diagnostics: terminal.diagnostics,
+            input,
+            ..ModViewSnapshot::default()
+        })
+    })();
+    if active() {
+        let prepared = snapshot.is_some();
+        crate::mod_ui::startup_preview(snapshot, repository);
+        if prepared {
+            if let Some(path) = std::env::var_os("OMD_PROFILE_READY") {
+                if let Ok(now) = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+                {
+                    let value = serde_json::json!({"pid": std::process::id(), "ready_unix_ns": now.as_nanos()});
+                    let _ = std::fs::write(path, value.to_string());
+                }
+            }
+            if let Some(store) = crate::omd::mod_paths_for(repository).and_then(|paths| paths.store)
+            {
+                std::thread::spawn(move || {
+                    let _ = codex_omd::ModStore::open(store).and_then(|store| {
+                        store.verify_selections()?;
+                        codex_omd::package_controls::list(&store, None)
+                    });
+                });
+            }
+        }
+    }
+    startup_profile("startup_prepare", started);
+}
+
+fn builtin(name: &str) -> bool {
+    SlashCommand::from_str(name).is_ok()
+}
+
+fn protected(path: &Path, roots: &[std::path::PathBuf]) -> bool {
+    roots.iter().any(|root| path.starts_with(root))
+}
+
+#[cfg(target_os = "macos")]
+fn sandboxed_seatbelt(
+    executable: &Path,
+    mut args: Vec<String>,
+    protected: &[std::path::PathBuf],
+    cwd: &Path,
+) -> Result<std::process::Command, String> {
+    if args.first().map(String::as_str) != Some("-p") || args.len() < 2 {
+        return Err("exec_sandbox_unavailable".to_owned());
+    }
+    codex_omd::host::deny_protected(&mut args[1], protected)?;
+    let mut command = std::process::Command::new(executable);
+    command.args(args).current_dir(cwd);
+    Ok(command)
+}
+
+fn entries() -> Vec<Entry> {
+    if crate::omd::mod_paths().is_none() {
+        return Vec::new();
+    }
+    let mut entries = Vec::new();
+    // The terminal host reloads a changed mods.json at once, so enabled mods' commands appear before the next turn.
+    let status = (|| {
+        let runtime = shared_host().ok()?;
+        let mut runtime = lock_within(&runtime, LOCK_WAIT)?;
+        reload(&mut runtime);
+        Some(runtime.status())
+    })()
+    .or_else(crate::omd::mod_status);
+    if let Some(status) = status {
+        for item in status["mods"].as_array().into_iter().flatten() {
+            let Some(id) = item["id"].as_str() else {
+                continue;
+            };
+            if !item["error"].is_null()
+                || !item["capabilities"]
+                    .as_array()
+                    .is_some_and(|c| c.iter().any(|c| c == "commands"))
+            {
+                continue;
+            }
+            for command in item["registrations"]["commands"]
+                .as_array()
+                .into_iter()
+                .flatten()
+            {
+                let Some(name) = command["name"].as_str() else {
+                    continue;
+                };
+                let description = command["description"]
+                    .as_str()
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| format!("{id} mod command"));
+                entries.push(Entry {
+                    namespaced: format!("{id}:{name}"),
+                    bare: name.to_owned(),
+                    description,
+                    args_hint: command["args_hint"].as_str().map(str::to_owned),
+                    immediate: command["immediate"] != false,
+                    target: ModSlashTarget {
+                        id: id.to_owned(),
+                        command: name.to_owned(),
+                    },
+                });
+            }
+        }
+    }
+    entries
+}
+
+pub(crate) fn build(entries: Vec<Entry>) -> Vec<ModSlashCommand> {
+    let mut counts: BTreeMap<&str, usize> = BTreeMap::new();
+    for entry in &entries {
+        *counts.entry(entry.bare.as_str()).or_default() += 1;
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut commands = Vec::new();
+    for entry in &entries {
+        if !seen.insert(entry.namespaced.clone()) {
+            continue;
+        }
+        let conflict = if builtin(&entry.bare) {
+            Some(format!("conflicts with built-in /{}", entry.bare))
+        } else if counts[entry.bare.as_str()] > 1 {
+            Some("defined by more than one mod".to_owned())
+        } else {
+            None
+        };
+        let description = match &conflict {
+            Some(reason) => format!(
+                "{} · bare /{} unavailable: {reason}",
+                entry.description, entry.bare
+            ),
+            None => entry.description.clone(),
+        };
+        commands.push(ModSlashCommand {
+            invocation: entry.namespaced.clone(),
+            description: description.clone(),
+            args_hint: entry.args_hint.clone(),
+            immediate: entry.immediate,
+            target: entry.target.clone(),
+        });
+        if conflict.is_none() && seen.insert(entry.bare.clone()) {
+            commands.push(ModSlashCommand {
+                invocation: entry.bare.clone(),
+                description: format!("{} (/{})", entry.description, entry.namespaced),
+                args_hint: entry.args_hint.clone(),
+                immediate: entry.immediate,
+                target: entry.target.clone(),
+            });
+        }
+    }
+    commands
+}
+
+pub(crate) fn slash_commands() -> Vec<ModSlashCommand> {
+    let mut cache = CATALOG
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((loaded, commands)) = cache.as_ref()
+        && loaded.elapsed() < CATALOG_TTL
+    {
+        return commands.clone();
+    }
+    let commands = build(entries());
+    *cache = Some((Instant::now(), commands.clone()));
+    commands
+}
+
+pub(crate) fn find(invocation: &str) -> Option<ModSlashCommand> {
+    slash_commands()
+        .into_iter()
+        .find(|command| command.invocation == invocation)
+}
+
+struct CommandAuthority<'a> {
+    repository: &'a Path,
+    protected: &'a [std::path::PathBuf],
+    policy: &'a codex_protocol::permissions::FileSystemSandboxPolicy,
+}
+
+impl codex_omd::host::Authority for CommandAuthority<'_> {
+    fn repository(&self) -> &Path {
+        self.repository
+    }
+
+    fn readable(&self, path: &Path) -> bool {
+        !protected(path, self.protected)
+            && self
+                .policy
+                .can_read_local_path_with_cwd(path, self.repository)
+    }
+
+    fn writable(&self, path: &Path) -> bool {
+        self.readable(path)
+            && self
+                .policy
+                .can_write_local_path_with_cwd(path, self.repository)
+    }
+
+    fn command(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        if access.loopback {
+            return Err("exec_network_unavailable_in_commands".to_owned());
+        }
+        self.seatbelt(argv, access)
+    }
+
+    fn protected(&self) -> &[std::path::PathBuf] {
+        self.protected
+    }
+}
+
+impl CommandAuthority<'_> {
+    fn seatbelt(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        #[cfg(target_os = "macos")]
+        {
+            use codex_protocol::permissions::FileSystemAccessMode;
+            use codex_protocol::permissions::FileSystemPath;
+            use codex_protocol::permissions::FileSystemSandboxEntry;
+            use codex_protocol::permissions::FileSystemSandboxKind;
+            use codex_protocol::permissions::FileSystemSandboxPolicy;
+            use codex_sandboxing::seatbelt::CreateSeatbeltCommandArgsParams;
+            use codex_sandboxing::seatbelt::MACOS_PATH_TO_SEATBELT_EXECUTABLE;
+            use codex_sandboxing::seatbelt::create_seatbelt_command_args;
+            if self.policy.kind == FileSystemSandboxKind::ExternalSandbox {
+                return Err("exec_requires_native_sandbox".to_owned());
+            }
+            let mut scope = if access.write {
+                self.policy.clone()
+            } else if self.policy.kind == FileSystemSandboxKind::Unrestricted {
+                FileSystemSandboxPolicy::read_only()
+            } else {
+                FileSystemSandboxPolicy::restricted(
+                    self.policy
+                        .entries
+                        .iter()
+                        .cloned()
+                        .map(|mut entry| {
+                            if entry.access == FileSystemAccessMode::Write {
+                                entry.access = FileSystemAccessMode::Read;
+                            }
+                            entry
+                        })
+                        .collect(),
+                )
+            };
+            let scratch = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(
+                access.scratch,
+            )
+            .map_err(|error| error.to_string())?;
+            scope.entries.push(FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: scratch.into(),
+                },
+                FileSystemAccessMode::Write,
+            ));
+            let loopback = codex_network_proxy::ManagedNetworkSandboxContext {
+                allow_local_binding: true,
+                ..Default::default()
+            };
+            let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+                command: argv,
+                file_system_sandbox_policy: &scope,
+                network_sandbox_policy:
+                    codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+                sandbox_policy_cwd: self.repository,
+                enforce_managed_network: access.loopback,
+                managed_network: access.loopback.then_some(&loopback),
+                environment_id: None,
+                network: None,
+                extra_allow_unix_sockets: &access
+                    .unix_sockets
+                    .iter()
+                    .map(|path| {
+                        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(path)
+                    })
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|error| error.to_string())?,
+            })?;
+            sandboxed_seatbelt(
+                Path::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE),
+                args,
+                self.protected,
+                self.repository,
+            )
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (argv, access);
+            Err("exec_sandbox_unavailable".to_owned())
+        }
+    }
+}
+
+pub(crate) fn sandboxed_command(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    argv: Vec<String>,
+    scratch: &Path,
+    write: bool,
+    loopback: bool,
+) -> Result<std::process::Command, String> {
+    let mut protected = paths.protected.clone();
+    protected.push(codex_omd::workspace_lease::directory());
+    protected.push(paths.evidence.clone());
+    CommandAuthority {
+        repository: &paths.repository,
+        protected: &protected,
+        policy,
+    }
+    .seatbelt(
+        argv,
+        &codex_omd::host::ExecAccess {
+            write,
+            loopback,
+            unix_sockets: &[],
+            scratch,
+        },
+    )
+}
+
+pub(crate) struct CallScope<'a> {
+    pub(crate) epoch: u64,
+    pub(crate) context: codex_omd::app_routes::InvocationContext,
+    pub(crate) thread: Option<&'a str>,
+    pub(crate) active: Arc<dyn Fn() -> bool + Send + Sync>,
+}
+
+#[cfg(test)]
+pub(crate) fn command_host(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+) -> std::io::Result<Value> {
+    let scope = CallScope {
+        epoch: codex_omd::client_surface::epoch(),
+        context: codex_omd::app_routes::InvocationContext::User,
+        thread: None,
+        active: Arc::new(|| true),
+    };
+    command_host_guarded(paths, policy, grants, caller, call, &scope)
+}
+
+pub(crate) fn command_host_guarded(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+    scope: &CallScope<'_>,
+) -> std::io::Result<Value> {
+    if !codex_omd::host::served(&call.operation) {
+        return Err(std::io::Error::other(format!(
+            "unsupported_host_operation: {}",
+            call.operation
+        )));
+    }
+    let grants = grants.ok_or_else(|| std::io::Error::other("host_caller_inactive"))?;
+    if matches!(
+        call.operation.as_str(),
+        "environment.read" | "environment.set" | "exec.run"
+    ) {
+        if !grants
+            .capabilities
+            .iter()
+            .any(|capability| capability == "exec")
+        {
+            return Err(std::io::Error::other("capability_denied: exec"));
+        }
+        if !(scope.active)() {
+            return Err(std::io::Error::other("host_operation_cancelled"));
+        }
+        if let Some(thread) = scope.thread {
+            if call.operation == "exec.run" && call.arguments["network"] == "loopback" {
+                return Err(std::io::Error::other(
+                    "exec_network_unavailable_in_commands",
+                ));
+            }
+            return codex_omd::host::session_call(
+                thread,
+                caller,
+                Some(&grants.source_sha256),
+                Some(&serde_json::to_value(
+                    codex_protocol::models::PermissionProfile::from_runtime_permissions(
+                        policy,
+                        codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+                    ),
+                )?),
+                call,
+                scope.active.as_ref(),
+            );
+        }
+    }
+    let mut protected = paths.protected.clone();
+    protected.push(codex_omd::workspace_lease::directory());
+    protected.push(paths.evidence.clone());
+    let data_root = paths
+        .store
+        .clone()
+        .ok_or_else(|| std::io::Error::other("mod store is not configured"))?;
+    let authority = CommandAuthority {
+        repository: &paths.repository,
+        protected: &protected,
+        policy,
+    };
+    codex_omd::host::Host {
+        authority: &authority,
+        data_root: &data_root,
+        environment: None,
+        active: scope.active.as_ref(),
+        record_changes: true,
+    }
+    .call(
+        &codex_omd::host::Caller {
+            id: caller,
+            source_sha256: &grants.source_sha256,
+            capabilities: &grants.capabilities,
+            exec_environment: &grants.exec_environment,
+            os_access: grants.os_access.as_ref(),
+            fs_access: grants.fs_access.as_ref(),
+            origin: match scope.context {
+                codex_omd::app_routes::InvocationContext::User => {
+                    codex_omd::data_store::Origin::UserCommand
+                }
+                codex_omd::app_routes::InvocationContext::Event => {
+                    codex_omd::data_store::Origin::Event
+                }
+            },
+            thread: scope.thread,
+        },
+        &call.operation,
+        call.arguments,
+    )
+    .map_err(std::io::Error::other)
+}
+
+fn preview(
+    runtime: &mut ModHost,
+    paths: &crate::omd::ModPaths,
+    context: &ModContext,
+) -> Option<ModViewSnapshot> {
+    preview_with(runtime, paths, context, None, &|| true)
+}
+
+fn preview_with(
+    runtime: &mut ModHost,
+    paths: &crate::omd::ModPaths,
+    context: &ModContext,
+    command: Option<(&str, u64, Value)>,
+    active: &dyn Fn() -> bool,
+) -> Option<ModViewSnapshot> {
+    if !active() {
+        return None;
+    }
+    let mut snapshot = ModViewSnapshot::read(&paths.evidence.join("mod-view.json")).ok()?;
+    snapshot.rendered_ms = ModViewSnapshot::clock();
+    if command.is_none() {
+        reload_active(runtime, active);
+    }
+    snapshot.input["client"] = crate::mod_client::value();
+    snapshot.input["ledger"] = serde_json::json!({
+        "thread_id": context.thread_id.map(|id| id.to_string()),
+        "cwd": context.repository,
+    });
+    let pty_scope = serde_json::json!({"epoch": codex_omd::client_surface::epoch(), "admission": codex_omd::client_surface::admission(), "configuration": runtime.configuration_sha256()});
+    let terminal = match command {
+        Some((id, generation, patch)) => runtime
+            .command_view(id, generation, patch, &snapshot.input)
+            .ok()?,
+        None => runtime.terminal_view(snapshot.input.clone(), active),
+    };
+    snapshot.input["pty_scope"] = pty_scope;
+    snapshot.revision = snapshot.revision.saturating_add(1);
+    snapshot.view = terminal.view;
+    snapshot.conflicts = terminal.conflicts;
+    snapshot.contributors = terminal.contributors;
+    snapshot.component_owners = terminal.component_owners;
+    for diagnostic in terminal.diagnostics {
+        if !snapshot.diagnostics.contains(&diagnostic) {
+            snapshot.diagnostics.push(diagnostic);
+        }
+    }
+    snapshot.diagnostics.truncate(16);
+    active().then_some(snapshot)
+}
+
+pub(crate) fn refresh_command(invocation: ModInvocation) {
+    let _thread =
+        codex_omd::StateThread::enter(invocation.context.thread_id.map(|id| id.to_string()));
+    let active = || current(&invocation);
+    if !active() {
+        return;
+    }
+    let Some(paths) = crate::omd::mod_paths_for(&invocation.context.repository) else {
+        return;
+    };
+    let Ok(runtime) = shared_host_active(&active) else {
+        return;
+    };
+    let snapshot = try_lock_until(&runtime, &active).and_then(|mut runtime| {
+        preview_with(&mut runtime, &paths, &invocation.context, None, &active)
+    });
+    if active()
+        && let Some(snapshot) = snapshot
+    {
+        crate::mod_ui::preview(snapshot);
+        codex_omd::client_surface::redraw();
+    }
+}
+
+pub(crate) fn shared_host() -> Result<Arc<Mutex<ModHost>>, String> {
+    shared_host_active(&|| true)
+}
+
+/// Retries a busy lock while `retry` holds.
+fn try_lock_until<T>(
+    mutex: &Mutex<T>,
+    retry: impl Fn() -> bool,
+) -> Option<std::sync::MutexGuard<'_, T>> {
+    loop {
+        match mutex.try_lock() {
+            Ok(guard) => return Some(guard),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => return Some(poisoned.into_inner()),
+            Err(std::sync::TryLockError::WouldBlock) if retry() => {
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            Err(std::sync::TryLockError::WouldBlock) => return None,
+        }
+    }
+}
+
+fn shared_host_active(active: &dyn Fn() -> bool) -> Result<Arc<Mutex<ModHost>>, String> {
+    let mut host = try_lock_until(&HOST, active).ok_or("callback_cancelled")?;
+    if host.is_none() {
+        let paths = crate::omd::mod_paths().ok_or("mods are off in this directory")?;
+        let store = paths.store.ok_or("mod store is not configured")?;
+        let runtime = ModHost::open_in_guarded(store, |_| Ok(()), &paths.repository, active)
+            .map_err(|e| e.to_string())?;
+        if !active() {
+            return Err("callback_cancelled".to_owned());
+        }
+        *host = Some(Arc::new(Mutex::new(runtime)));
+    }
+    host.clone()
+        .ok_or_else(|| "mod runtime unavailable".to_owned())
+}
+
+pub(crate) fn contract_documents()
+-> Option<Vec<(codex_omd::ContractDocument, codex_omd::PolicyOwner)>> {
+    with_host(|runtime, _| Some(runtime.contract_documents()))
+}
+
+fn reload(runtime: &mut ModHost) {
+    reload_active(runtime, &|| true);
+}
+
+fn reload_active(runtime: &mut ModHost, active: &dyn Fn() -> bool) {
+    static CHECKOUT: Mutex<Option<std::path::PathBuf>> = Mutex::new(None);
+    if let Some(paths) = crate::omd::mod_paths() {
+        let mut checkout = CHECKOUT
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if checkout.as_ref() != Some(&paths.repository) {
+            runtime.set_checkout(&paths.repository);
+            *checkout = Some(paths.repository);
+        }
+    }
+    runtime.turn_boundary_guarded(active);
+    if !active() {
+        return;
+    }
+    let owners = runtime
+        .owners()
+        .into_iter()
+        .map(|(id, owner)| (id, owner.sha256))
+        .collect::<std::collections::BTreeMap<_, _>>();
+    let unrestricted = owners
+        .keys()
+        .filter(|id| {
+            runtime
+                .grants(id)
+                .is_some_and(|grants| grants.os_access.is_some())
+        })
+        .cloned()
+        .collect();
+    crate::mod_pty::retain(
+        runtime.generation(),
+        runtime.configuration_sha256(),
+        &owners,
+        &unrestricted,
+    );
+}
+
+fn with_host<T>(run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let runtime = shared_host().ok()?;
+    let mut runtime = runtime
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    reload(&mut runtime);
+    let result = run(&mut runtime, &paths);
+    record_status(&runtime, &paths);
+    result
+}
+
+/// How long a caller off the draw path waits for a busy lock before giving up.
+const LOCK_WAIT: std::time::Duration = std::time::Duration::from_millis(100);
+
+/// Waits up to `wait` for a busy lock instead of silently giving up on the first contention.
+fn lock_within<T>(
+    mutex: &Mutex<T>,
+    wait: std::time::Duration,
+) -> Option<std::sync::MutexGuard<'_, T>> {
+    let deadline = std::time::Instant::now() + wait;
+    try_lock_until(mutex, || std::time::Instant::now() < deadline)
+}
+
+fn try_with_host<T>(
+    run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>,
+) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let opened = lock_within(&HOST, LOCK_WAIT)?.clone();
+    let runtime = match opened {
+        Some(runtime) => runtime,
+        None => shared_host().ok()?,
+    };
+    let mut runtime = lock_within(&runtime, LOCK_WAIT)?;
+    reload(&mut runtime);
+    let result = run(&mut runtime, &paths);
+    record_status(&runtime, &paths);
+    result
+}
+
+fn record_status(runtime: &ModHost, paths: &crate::omd::ModPaths) {
+    let status = runtime.status();
+    if status["mods"]
+        .as_array()
+        .is_some_and(|mods| mods.iter().any(|item| item["error"].is_string()))
+        && let Ok(bytes) = serde_json::to_vec(&status)
+        && bytes.len() <= 262_144
+        && let Ok(mut file) = tempfile::NamedTempFile::new_in(&paths.evidence)
+        && file.write_all(&bytes).is_ok()
+    {
+        let _ = file.persist(paths.evidence.join("mod-status.json"));
+    }
+}
+
+pub(crate) fn invoke_event(id: &str, event: &str, payload: Value) -> Option<Result<Value, String>> {
+    invoke_event_guarded(id, event, payload, Arc::new(|| true))
+}
+
+pub(crate) fn invoke_event_guarded(
+    id: &str,
+    event: &str,
+    payload: Value,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+) -> Option<Result<Value, String>> {
+    if !current() {
+        return None;
+    }
+    let paths = crate::omd::mod_paths()?;
+    let runtime = shared_host().ok()?;
+    let (generation, grants, before) = {
+        let mut runtime = runtime
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !current() {
+            return None;
+        }
+        reload(&mut runtime);
+        if !runtime.registered(id, event) {
+            return None;
+        }
+        (
+            runtime.generation(),
+            owner_grants(&runtime),
+            (
+                runtime.state(id).cloned(),
+                runtime.configuration_sha256().to_owned(),
+                runtime.ui_revision(id),
+            ),
+        )
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let thread = crate::mod_surface::current_thread();
+    let _thread = codex_omd::StateThread::enter(thread.clone());
+    let (epoch, active) = context_unchanged();
+    let scope = CallScope {
+        epoch,
+        context: codex_omd::app_routes::InvocationContext::Event,
+        thread: thread.as_deref(),
+        active: Arc::new(move || active() && current()),
+    };
+    let result = codex_omd::invoke_shared(
+        &runtime,
+        id,
+        generation,
+        event,
+        "",
+        payload,
+        scope.active.as_ref(),
+        |caller, call| {
+            crate::mod_surface::host_call(
+                &paths,
+                &policy,
+                grants.get(caller).cloned(),
+                caller,
+                call,
+                &scope,
+            )
+        },
+        |_| {},
+    );
+    let snapshot = {
+        let mut runtime = runtime
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        record_status(&runtime, &paths);
+        reload(&mut runtime);
+        let changed = runtime.state(id) != before.0.as_ref()
+            || runtime.configuration_sha256() != before.1
+            || runtime.ui_revision(id) != before.2;
+        active_context()
+            .filter(|_| changed && (scope.active)())
+            .and_then(|context| {
+                preview_with(&mut runtime, &paths, &context, None, scope.active.as_ref())
+            })
+    };
+    if (scope.active)()
+        && let Some(snapshot) = snapshot
+    {
+        crate::mod_ui::preview(snapshot);
+        codex_omd::client_surface::redraw();
+    }
+    Some(result.map_err(|error| error.to_string()))
+}
+
+/// Renders the mod view again with the current client facts.
+pub(crate) fn rerender() {
+    let Some(paths) = crate::omd::mod_paths() else {
+        return;
+    };
+    let Ok(runtime) = shared_host() else {
+        return;
+    };
+    let snapshot = {
+        let mut runtime = runtime
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        active_context().and_then(|context| preview(&mut runtime, &paths, &context))
+    };
+    if let Some(snapshot) = snapshot {
+        crate::mod_ui::preview(snapshot);
+        codex_omd::client_surface::redraw();
+    }
+}
