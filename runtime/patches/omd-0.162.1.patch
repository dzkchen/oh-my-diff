+        "owner",
+        vec![("box-raster".into(), codex_omd::process_raster::Role::Raster)],
+        Arc::new(move |message| sender.lock().unwrap().send(message).is_ok()),
+    );
+    let draw = |width: u16, size: (u16, u16)| {
+        crate::mod_raster::track(
+            "box-raster",
+            crate::mod_surface::current_thread().as_deref(),
