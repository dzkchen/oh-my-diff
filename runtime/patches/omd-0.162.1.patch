+        let output = |outcome: &str, candidate: &str, acceptance: &str, resolves: Vec<String>| {
+            json!({"resolution_assertion":{"outcome":outcome,"candidate_sha256":candidate,
+                "acceptance_sha256":acceptance,"resolves":resolves}})
+            .to_string()
+        };
+        let valid = output(
+            "pass",
+            &binding.candidate_sha256,
+            &binding.acceptance_sha256,
+            requested.clone(),
+        );
+        assert!(
+            validate_resolution_assertion(
+                Some(&binding),
+                Some(&binding.acceptance_sha256),
+                &requested,
+                &valid
+            )
+            .is_ok()
+        );
+        assert!(
+            validate_resolution_assertion(
+                None,
+                Some(&binding.acceptance_sha256),
+                &requested,
+                &valid
+            )
+            .is_err()
+        );
+        assert!(
+            validate_resolution_assertion(
+                Some(&binding),
+                Some(&"c".repeat(64)),
+                &requested,
+                &valid
+            )
+            .is_err()
+        );
+        assert!(
+            validate_resolution_assertion(
+                Some(&binding),
+                Some(&binding.acceptance_sha256),
+                &["other".into()],
+                &valid
+            )
+            .is_err()
+        );
+        for invalid in [
+            output(
+                "fail",
+                &binding.candidate_sha256,
+                &binding.acceptance_sha256,
+                requested.clone(),
+            ),
+            output(
+                "pass",
+                &"d".repeat(64),
+                &binding.acceptance_sha256,
+                requested.clone(),
+            ),
+            output(
+                "pass",
+                &binding.candidate_sha256,
+                &"e".repeat(64),
+                requested.clone(),
+            ),
+            output(
+                "pass",
+                &binding.candidate_sha256,
+                &binding.acceptance_sha256,
+                vec!["other".into()],
+            ),
+            json!({"summary":"No assertion"}).to_string(),
+            "not json".into(),
+        ] {
+            assert!(
+                validate_resolution_assertion(
+                    Some(&binding),
+                    Some(&binding.acceptance_sha256),
+                    &requested,
+                    &invalid
+                )
+                .is_err()
+            );
+        }
+    }
