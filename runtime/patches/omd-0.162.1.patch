+    frame_at(key, frame(8, 2, [1, 2, 3]), start).expect("queued");
+    super::rows(key, Some("owner"), "chart", 10, (4, 2), false, "", start);
+    assert!(rasters().get(key).is_some_and(|raster| raster.drawn));
+    super::rows(key, Some("other"), "chart", 10, (4, 2), false, "", start);
+    assert!(rasters().get(key).is_none());
+    retain(&BTreeSet::new());
+}
+
+#[test]
+#[serial_test::serial]
+fn bursts_of_image_frames_apply_only_the_newest() {
+    let start = Instant::now();
+    let key = "raster-frame-burst";
+    let cell = json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]});
+    blit_at(key, "owner", cell, start).expect("queued");
+    for red in 1..=5 {
+        let reply = frame_at(key, frame(8, 2, [red * 40, 0, 0]), start).expect("queued");
+        assert_eq!(
+            reply["queued"], 1,
+            "a frame replaces everything queued before it"
+        );
+    }
+    let (rows, next) = super::rows(key, Some("owner"), "chart", 10, (4, 2), false, "", start);
+    assert_eq!(next, None);
+    assert_eq!(
+        rows[0].spans[1].style.fg,
+        Some(crate::mod_ui::color(ModColor::Rgb(200, 0, 0)))
+    );
+    retain(&BTreeSet::new());
+}
+
+#[test]
+#[serial_test::serial]
+fn a_shown_frame_is_refit_when_the_raster_is_resized() {
+    let start = Instant::now();
+    let key = "raster-frame-resize";
+    frame_at(key, frame(8, 2, [255, 0, 0]), start).expect("queued");
+    let columns = |size| {
+        let (rows, _) = super::rows(key, Some("owner"), "chart", 10, size, false, "", start);
+        text(&rows)[0].chars().count()
+    };
+    assert_eq!(columns((4, 2)), 4);
+    assert_eq!(columns((8, 2)), 8, "a larger raster refits the same frame");
+    assert_eq!(columns((2, 2)), 2, "a smaller raster refits it too");
+    retain(&BTreeSet::new());
+}
