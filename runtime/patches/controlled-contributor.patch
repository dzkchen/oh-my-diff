+use codex_omd::EvidenceStatus;
+use codex_omd::KnowledgeAction;
+use codex_omd::KnowledgeApproval;
+use codex_omd::KnowledgeMode;
+use codex_omd::KnowledgeRemoval;
+use codex_omd::KnowledgeReset;
+use codex_omd::KnowledgeStore;
+use codex_omd::LessonCandidate;
+use codex_omd::RecordKind;
+use codex_omd::SourceAnchor;
+use codex_omd::SourceFactInput;
+use codex_omd::SourceFactStatus;
+use codex_omd::TaskEvidenceInput;
+use std::sync::Arc;
+use std::sync::Barrier;
+
+fn hash(character: char) -> String {
+    character.to_string().repeat(64)
+}
+
+fn action(reason: &str) -> KnowledgeAction {
+    KnowledgeAction {
+        actor: "maintainer@example.test".into(),
+        reason: reason.into(),
+    }
+}
+
+fn evidence_input(
+    expected_revision: u64,
+    id: &str,
+    artifact: std::path::PathBuf,
+) -> TaskEvidenceInput {
+    TaskEvidenceInput {
+        expected_revision,
+        id: id.into(),
+        task_id: "development-task".into(),
+        summary: "Focused executable task evidence".into(),
+        kind: "check".into(),
+        workspace_sha256: hash('a'),
+        artifact,
+    }
+}
+
+fn fact_input(expected_revision: u64, id: &str) -> SourceFactInput {
+    SourceFactInput {
+        expected_revision,
+        id: id.into(),
+        task_id: "development-task".into(),
+        label: "Selected configuration line".into(),
+        source: SourceAnchor {
+            path: "src/config.txt".into(),
+            start_line: 2,
+            end_line: 2,
+        },
+    }
+}
+
+fn fixture() -> (
+    tempfile::TempDir,
+    std::path::PathBuf,
+    std::path::PathBuf,
+    KnowledgeStore,
+) {
+    let temp = tempfile::tempdir().unwrap();
+    let repository = temp.path().join("repository");
+    let parent = temp.path().join("stores");
+    std::fs::create_dir_all(repository.join("src")).unwrap();
+    std::fs::create_dir(&parent).unwrap();
+    std::fs::write(repository.join("src/config.txt"), "first\nsecond\n").unwrap();
+    let artifact = temp.path().join("check.json");
+    std::fs::write(&artifact, "{\"passed\":true}").unwrap();
+    let store =
+        KnowledgeStore::create(parent.join("knowledge"), "fixture/repository".into()).unwrap();
+    (
+        temp,
+        repository.canonicalize().unwrap(),
+        artifact.canonicalize().unwrap(),
+        store,
+    )
+}
+
+#[test]
+fn retains_task_evidence_with_provenance_and_detects_tampering() {
+    let (_temp, repository, artifact, store) = fixture();
+    let evidence = store
+        .retain_evidence(evidence_input(0, "check-1", artifact.clone()))
+        .unwrap();
+    assert_eq!(evidence.original_artifact, artifact);
+    assert_eq!(evidence.workspace_sha256, hash('a'));
+    assert_eq!(evidence.status, EvidenceStatus::Available);
+    assert_eq!(
+        std::fs::read(store.root().join(&evidence.retained_artifact)).unwrap(),
+        b"{\"passed\":true}"
+    );
+
+    std::fs::write(store.root().join(&evidence.retained_artifact), "changed").unwrap();
+    let inspection = store.inspect(&repository).unwrap();
+    assert!(matches!(
+        inspection.evidence[0].status,
+        EvidenceStatus::Invalidated { .. }
+    ));
+    assert_eq!(inspection.events.last().unwrap().record_ids, ["check-1"]);
+}
+
+#[test]
+fn refreshes_exact_source_facts_and_invalidates_missing_sources() {
+    let (_temp, repository, _artifact, store) = fixture();
+    let original = store
+        .retain_source_fact(&repository, fact_input(0, "config-line"))
+        .unwrap();
+    let SourceFactStatus::Fresh { version } = original.status else {
+        unreachable!();
+    };
+    assert_eq!(version.excerpt, "second");
+
+    std::fs::write(repository.join("src/config.txt"), "first\nupdated\n").unwrap();
+    let reused = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert_eq!(reused.refreshed_fact_ids, ["config-line"]);
+    let SourceFactStatus::Fresh { version } = &reused.facts[0].status else {
+        unreachable!();
+    };
+    assert_eq!(version.excerpt, "updated");
+
+    std::fs::remove_file(repository.join("src/config.txt")).unwrap();
+    let invalidated = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert!(invalidated.facts.is_empty());
+    assert_eq!(invalidated.invalidated_ids, ["config-line"]);
+    assert!(matches!(
+        store.inspect(&repository).unwrap().facts[0].status,
+        SourceFactStatus::Invalidated { .. }
+    ));
+}
+
+#[test]
+fn inferred_lessons_are_inert_until_explicit_approval() {
+    let (_temp, repository, artifact, store) = fixture();
+    store
+        .retain_evidence(evidence_input(0, "check-1", artifact))
+        .unwrap();
+    store
+        .propose_lesson(LessonCandidate {
+            expected_revision: 1,
+            id: "lesson-1".into(),
+            task_id: "development-task".into(),
+            text: "Run the focused configuration check after changing the manifest.".into(),
+            evidence_ids: vec!["check-1".into()],
+        })
+        .unwrap();
+    let candidate = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert!(candidate.approved_lessons.is_empty());
+    assert!(!candidate.render().unwrap().contains("configuration check"));
+
+    store
+        .approve_lesson(KnowledgeApproval {
+            expected_revision: 2,
+            lesson_id: "lesson-1".into(),
+            action: action("Approve this bounded repository lesson for reuse"),
+        })
+        .unwrap();
+    let approved = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert_eq!(approved.approved_lessons.len(), 1);
+    assert!(approved.render().unwrap().contains("configuration check"));
+}
+
+#[test]
+fn cold_state_excludes_reuse_and_removal_invalidates_dependencies() {
+    let (_temp, repository, artifact, store) = fixture();
+    store
+        .retain_evidence(evidence_input(0, "check-1", artifact))
+        .unwrap();
+    store
+        .propose_lesson(LessonCandidate {
+            expected_revision: 1,
+            id: "lesson-1".into(),
+            task_id: "development-task".into(),
+            text: "Reusable only after approval.".into(),
+            evidence_ids: vec!["check-1".into()],
+        })
+        .unwrap();
+    store
+        .approve_lesson(KnowledgeApproval {
+            expected_revision: 2,
+            lesson_id: "lesson-1".into(),
+            action: action("Approve for a reuse trial"),
+        })
+        .unwrap();
+
+    let cold = store
+        .session(&repository, KnowledgeMode::Cold, 65_536)
+        .unwrap();
+    assert_eq!(cold.mode, KnowledgeMode::Cold);
+    assert!(cold.facts.is_empty());
+    assert!(cold.approved_lessons.is_empty());
+    assert!(cold.render().unwrap().contains("no retained task evidence"));
+
+    store
+        .remove(KnowledgeRemoval {
+            expected_revision: 3,
+            kind: RecordKind::Evidence,
+            id: "check-1".into(),
+            action: action("Remove retained check evidence"),
+        })
+        .unwrap();
+    let reused = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert!(reused.approved_lessons.is_empty());
+    assert!(store.inspect(&repository).unwrap().evidence.is_empty());
+}
+
+#[test]
+fn reset_advances_generation_and_clears_all_reusable_state() {
+    let (_temp, repository, artifact, store) = fixture();
+    store
+        .retain_evidence(evidence_input(0, "check-1", artifact))
+        .unwrap();
+    store
+        .retain_source_fact(&repository, fact_input(1, "config-line"))
+        .unwrap();
+    let reset = store
+        .reset(KnowledgeReset {
+            expected_revision: 2,
+            action: action("Start an isolated cold trial"),
+        })
+        .unwrap();
+    assert_eq!(reset.generation, 1);
+    assert!(reset.evidence.is_empty());
+    assert!(reset.facts.is_empty());
+    assert!(reset.lessons.is_empty());
+    let reused = store
+        .session(&repository, KnowledgeMode::Reuse, 65_536)
+        .unwrap();
+    assert_eq!(reused.generation, 1);
+    assert!(reused.facts.is_empty());
+    assert!(reused.approved_lessons.is_empty());
+}
+
+#[test]
+fn concurrent_writers_cannot_overwrite_same_revision() {
+    let (_temp, _repository, artifact, store) = fixture();
+    let store = Arc::new(store);
+    let barrier = Arc::new(Barrier::new(3));
+    let threads = ["check-a", "check-b"].map(|id| {
+        let store = store.clone();
+        let artifact = artifact.clone();
+        let barrier = barrier.clone();
+        std::thread::spawn(move || {
+            barrier.wait();
+            store.retain_evidence(evidence_input(0, id, artifact))
+        })
+    });
+    barrier.wait();
+    let results = threads.map(|thread| thread.join().unwrap());
+    assert_eq!(results.iter().filter(|result| result.is_ok()).count(), 1);
+    assert_eq!(results.iter().filter(|result| result.is_err()).count(), 1);
+    assert_eq!(store.revision().unwrap(), 1);
+}
+
+#[test]
+fn unsafe_source_paths_and_unbounded_context_fail_closed() {
+    let (_temp, repository, artifact, store) = fixture();
+    let mut input = fact_input(0, "unsafe");
+    input.source.path = "../outside".into();
+    assert!(store.retain_source_fact(&repository, input).is_err());
+    assert!(store.session(&repository, KnowledgeMode::Reuse, 0).is_err());
+    assert!(
+        store
+            .retain_evidence(evidence_input(0, "safe/../escape", artifact))
+            .is_err()
+    );
+}
diff --git a/codex-rs/omd/tests/mods.rs b/codex-rs/omd/tests/mods.rs
new file mode 100644
index 0000000..aec2c11
--- /dev/null
+++ b/codex-rs/omd/tests/mods.rs
@@ -0,0 +1,2419 @@
+use codex_omd::MOD_API_VERSION;
+use codex_omd::MOD_HOST_FEATURES;
+use codex_omd::MOD_PACKAGE_SCHEMA_VERSION;
+use codex_omd::MOD_STATE_STORAGE_SCHEMA_VERSION;
+use codex_omd::ModHost;
+use codex_omd::ModStore;
+use codex_omd::OMD_HOST_RELEASE;
+use serde_json::Value;
+use serde_json::json;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tempfile::TempDir;
+
+fn package(root: &std::path::Path, id: &str, source: &str, capabilities: &[&str]) -> PathBuf {
+    packaged(root, id, id, source, capabilities, &[])
+}
+
+fn packaged(
+    root: &std::path::Path,
+    directory: &str,
+    id: &str,
+    source: &str,
+    capabilities: &[&str],
+    requires: &[&str],
+) -> PathBuf {
+    let path = root.join(directory);
+    std::fs::create_dir(&path).unwrap();
+    let mut manifest = json!({"schema":1,"id":id,"version":"1.0.0",
+        "api":MOD_API_VERSION,"state_version":1,"capabilities":capabilities});
+    if !requires.is_empty() {
+        manifest["requires"] = json!(requires);
+    }
+    std::fs::write(
+        path.join("mod.json"),
+        serde_json::to_vec(&manifest).unwrap(),
+    )
+    .unwrap();
+    std::fs::write(path.join("index.ts"), source).unwrap();
+    path
+}
+
+fn service_package(
+    root: &std::path::Path,
+    id: &str,
+    source: &str,
+    services: Value,
+    capabilities: &[&str],
+) -> PathBuf {
+    let path = root.join(id);
+    std::fs::create_dir(&path).unwrap();
+    let manifest = json!({"schema":1,"id":id,"version":"1.0.0",
+        "api":MOD_API_VERSION,"state_version":1,"capabilities":capabilities,
+        "services":services});
+    std::fs::write(
+        path.join("mod.json"),
+        serde_json::to_vec(&manifest).unwrap(),
+    )
+    .unwrap();
+    std::fs::write(path.join("index.ts"), source).unwrap();
+    path
+}
+
+fn node() -> PathBuf {
+    PathBuf::from(
+        std::env::var_os("OMD_TEST_NODE")
+            .expect("set OMD_TEST_NODE to Node 24.18.0; sandbox tests must actually execute"),
+    )
+}
+
+fn fixture(source: &str, capabilities: &[&str]) -> (TempDir, ModStore, PathBuf) {
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let store = ModStore::create(root.join("store"), node()).unwrap();
+    let path = package(&root, "fixture", source, capabilities);
+    trust(&store, &path, capabilities);
+    (temp, store, path)
+}
+
+fn trust(store: &ModStore, path: &std::path::Path, capabilities: &[&str]) {
+    trust_scoped(store, path, capabilities, "user");
+}
+
+fn trust_scoped(store: &ModStore, path: &std::path::Path, capabilities: &[&str], scope: &str) {
+    let inspected = ModStore::inspect_package(path).unwrap();
+    let granted: Vec<String> = capabilities.iter().map(|s| s.to_string()).collect();
+    let sha256 = inspected["sha256"].as_str().unwrap();
+    contended(|| store.trust(path.to_path_buf(), sha256, granted.clone(), scope));
+    contended(|| store.enable(path, true));
+}
+
+fn activation_error(temp: &TempDir, id: &str) -> String {
+    let runtime = ModHost::open(temp.path().canonicalize().unwrap().join("store")).unwrap();
+    runtime.status()["mods"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|m| m["id"] == id)
+        .and_then(|m| m["error"].as_str())
+        .unwrap_or_default()
+        .to_string()
+}
+
+fn contended<T>(mut operation: impl FnMut() -> std::io::Result<T>) -> T {
+    for _ in 0..200 {
+        match operation() {
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                std::thread::sleep(std::time::Duration::from_millis(20))
+            }
+            result => return result.unwrap(),
+        }
+    }
+    panic!("store lock stayed contended")
+}
+
+fn host(temp: &TempDir) -> ModHost {
+    ModHost::open(temp.path().canonicalize().unwrap().join("store")).unwrap()
+}
+
+const COUNTER: &str = "export default api => api.command('count', () => { api.state.set(Number(api.state.get() ?? 0)+1); return api.state.get(); })";
+
+#[test]
+fn mod_state_refreshes_per_call_and_racing_writers_fail_without_lost_updates() {
+    let source = "export default api => { api.command('count', () => { api.state.set(Number(api.state.get() ?? 0)+1); return api.state.get(); }); api.command('slow', () => { const value = Number(api.state.get() ?? 0); const end = Date.now() + 500; while (Date.now() < end) {} api.state.set(value + 100); return value; }); }";
+    let (temp, _, _) = fixture(source, &["commands", "state"]);
+    let mut first = host(&temp);
+    let mut second = host(&temp);
+    let invoke = |runtime: &mut ModHost, name: &str| {
+        let generation = runtime.generation();
+        runtime.invoke("fixture", generation, "command", name, Value::Null)
+    };
+    assert_eq!(invoke(&mut first, "count").unwrap(), json!(1));
+    assert_eq!(invoke(&mut second, "count").unwrap(), json!(2));
+    assert_eq!(invoke(&mut first, "count").unwrap(), json!(3));
+    let racing = std::thread::spawn(move || {
+        let result = invoke(&mut first, "slow");
+        (first, result)
+    });
+    std::thread::sleep(std::time::Duration::from_millis(200));
+    assert_eq!(invoke(&mut second, "count").unwrap(), json!(4));
+    let (mut first, result) = racing.join().unwrap();
+    assert!(result.unwrap_err().to_string().contains("state_conflict"));
+    assert_eq!(invoke(&mut first, "count").unwrap(), json!(5));
+    let mut resumed = host(&temp);
+    assert_eq!(invoke(&mut resumed, "count").unwrap(), json!(6));
+}
+
+#[test]
+fn mod_reload_is_transactional_and_stale_calls_are_rejected() {
+    let (temp, store, path) = fixture(COUNTER, &["commands", "state"]);
+    let mut runtime = host(&temp);
+    let generation = runtime.generation();
+    std::fs::write(
+        path.join("index.ts"),
+        "export default () => { throw new Error('broken') }",
+    )
+    .unwrap();
+    trust(&store, &path, &["commands", "state"]);
+    assert!(runtime.reload().is_err());
+    assert_eq!(
+        runtime
+            .invoke("fixture", generation, "command", "count", Value::Null)
+            .unwrap(),
+        json!(1)
+    );
+    store.enable(&path, false).unwrap();
+    runtime.reload().unwrap();
+    assert!(
+        runtime
+            .invoke("fixture", generation, "command", "count", Value::Null)
+            .is_err()
+    );
+    assert!(runtime.status()["mods"].as_array().unwrap().is_empty());
+}
+
+#[test]
+fn mod_capabilities_source_tamper_and_symlinks_are_rejected() {
+    let (temp, store, path) = fixture(
+        "export default api => api.command('bad', () => api.state.set(1))",
+        &["commands"],
+    );
+    let mut runtime = host(&temp);
+    assert!(
+        runtime
+            .invoke(
+                "fixture",
+                runtime.generation(),
+                "command",
+                "bad",
+                Value::Null
+            )
+            .unwrap_err()
+            .to_string()
+            .contains("capability_denied")
+    );
+    std::fs::write(path.join("index.ts"), COUNTER).unwrap();
+    assert!(store.enable(&path, true).is_err());
+    std::fs::remove_file(path.join("index.ts")).unwrap();
+    std::os::unix::fs::symlink("mod.json", path.join("index.ts")).unwrap();
+    assert!(ModStore::inspect_package(&path).is_err());
+}
+
+#[test]
+fn mod_cancellation_discards_state_and_explicit_reload_recovers() {
+    let (temp, store, _) = fixture(COUNTER, &["commands", "state"]);
+    let mut runtime = host(&temp);
+    let calls = AtomicUsize::new(0);
+    let result = runtime.invoke_guarded(
+        "fixture",
+        runtime.generation(),
+        "command",
+        "count",
+        Value::Null,
+        || calls.fetch_add(1, Ordering::Relaxed) == 0,
+    );
+    assert!(
+        result
+            .unwrap_err()
+            .to_string()
+            .contains("callback_cancelled")
+    );
+    store.reload().unwrap();
+    runtime.reload().unwrap();
+    assert_eq!(
+        runtime
+            .invoke(
+                "fixture",
+                runtime.generation(),
+                "command",
+                "count",
+                Value::Null
+            )
+            .unwrap(),
+        json!(1)
+    );
+}
+
+#[test]
+fn mod_context_is_bounded_and_callback_failure_is_isolated() {
+    let (temp, store, _) = fixture(
+        "export default api => api.on('context', () => ({text:'x'.repeat(1025)}))",
+        &["context"],
+    );
+    let root = temp.path().canonicalize().unwrap();
+    let other = package(
+        &root,
+        "healthy",
+        "export default api => api.on('context', () => ({text:'hello'}))",
+        &["context"],
+    );
+    trust(&store, &other, &["context"]);
+    let mut runtime = host(&temp);
+    let results = runtime.event("context", Value::Null);
+    assert!(
+        results[0]
+            .1
+            .as_ref()
+            .unwrap_err()
+            .to_string()
+            .contains("context_limit")
+    );
+    assert_eq!(*results[1].1.as_ref().unwrap(), json!({"text":"hello"}));
+    assert_eq!(runtime.event("context", Value::Null).len(), 1);
+}
+
+#[test]
+fn mod_pending_callback_has_a_host_deadline() {
+    let (temp, _, _) = fixture(
+        "export default api => api.command('hang', () => new Promise(() => { function spin() { Promise.resolve().then(spin) }; spin(); }))",
+        &["commands"],
+    );
+    let mut runtime = host(&temp);
+    let start = std::time::Instant::now();
+    assert!(
+        runtime
+            .invoke(
+                "fixture",
+                runtime.generation(),
+                "command",
+                "hang",
+                Value::Null
+            )
