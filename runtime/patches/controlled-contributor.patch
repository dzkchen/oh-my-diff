+#[derive(Default)]
+struct Interaction {
+    focused: Option<String>,
+    ids: BTreeSet<String>,
+    targets: BTreeMap<String, ComponentTarget>,
+    order: Vec<String>,
+    hitboxes: Vec<HitBox>,
+    input_values: BTreeMap<String, String>,
+    selected: BTreeMap<String, usize>,
+    collapsed: BTreeMap<String, bool>,
