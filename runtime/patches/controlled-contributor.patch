+}
+
+impl LeadName {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Sol => "sol",
+            Self::Astra => "astra",
+        }
+    }
+
+    fn opposite(self) -> Self {
+        match self {
+            Self::Sol => Self::Astra,
+            Self::Astra => Self::Sol,
+        }
+    }
+}
