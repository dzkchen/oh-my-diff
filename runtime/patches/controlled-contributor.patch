+#[serial_test::serial]
+fn native_escape_and_cancel_keys_cannot_be_intercepted() {
+    let view = ModView::parse(serde_json::json!({"keybindings":{"F6":"draft","Ctrl+r":{"submit":"run"},"Alt+x":{"command":"counter:reset"}}})).unwrap();
+    assert_eq!(
