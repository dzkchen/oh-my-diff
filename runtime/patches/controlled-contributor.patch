+#[derive(Clone, Debug, Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub enum LspAdapterRequest {
+    Status,
+    Diagnostics {
+        paths: Vec<String>,
+    },
+    Definition {
+        paths: Vec<String>,
+        path: String,
+        position: LspPosition,
+    },
+    References {
+        paths: Vec<String>,
+        path: String,
+        position: LspPosition,
+        #[serde(default)]
+        include_declaration: bool,
+    },
+    CodeActions {
+        paths: Vec<String>,
+        path: String,
+        range: LspRange,
+    },
+    ApplyCodeAction {
+        paths: Vec<String>,
+        action_value: Value,
+        scope: Vec<String>,
+        expected_versions: BTreeMap<String, Option<String>>,
+    },
+    RenameSymbol {
+        paths: Vec<String>,
+        path: String,
+        position: LspPosition,
+        new_name: String,
+        scope: Vec<String>,
+        expected_versions: BTreeMap<String, Option<String>>,
+    },
+    RenameFile {
+        paths: Vec<String>,
+        old_path: String,
+        new_path: String,
+        scope: Vec<String>,
+        expected_versions: BTreeMap<String, Option<String>>,
+    },
+}
+
+impl LspAdapterRequest {
+    pub fn command(&self) -> &'static str {
+        match self {
+            Self::Status => "status",
+            Self::Diagnostics { .. } => "diagnostics",
+            Self::Definition { .. } => "definition",
+            Self::References { .. } => "references",
+            Self::CodeActions { .. } => "code_actions",
+            Self::ApplyCodeAction { .. } => "apply_code_action",
+            Self::RenameSymbol { .. } => "rename_symbol",
+            Self::RenameFile { .. } => "rename_file",
+        }
+    }
+
+    fn paths(&self) -> &[String] {
+        match self {
+            Self::Status => &[],
+            Self::Diagnostics { paths }
+            | Self::Definition { paths, .. }
+            | Self::References { paths, .. }
+            | Self::CodeActions { paths, .. }
+            | Self::ApplyCodeAction { paths, .. }
+            | Self::RenameSymbol { paths, .. }
+            | Self::RenameFile { paths, .. } => paths,
+        }
+    }
+}
