+            generator: CODE_GRAPH_GENERATOR.to_string(),
+            repository: GraphRepository {
+                identity: repository_identity,
+                root,
+                revision,
+                source_digest: source_digest(&sources),
+            },
+            limits,
+            sources,
+            nodes: nodes.into_values().collect(),
+            edges,
+            coverage,
+        };
+        graph.validate()?;
+        Ok(graph)
+    }
