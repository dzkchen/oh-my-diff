+
+pub const LSP_PREFERENCE_SCHEMA: u32 = 1;
+pub const LSP_RESULT_SCHEMA: u32 = 1;
+pub const LSP_WORKSPACE_BINDING_SCHEMA: u32 = 1;
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, Ord, PartialEq, PartialOrd, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum LspLanguage {
+    Rust,
+    TypeScript,
+    JavaScript,
+    Python,
+    Java,
+}
+
+impl LspLanguage {
+    pub fn from_path(path: &Path) -> Option<Self> {
+        match path.extension()?.to_str()? {
+            "rs" => Some(Self::Rust),
+            "ts" | "tsx" | "mts" | "cts" => Some(Self::TypeScript),
+            "js" | "jsx" | "mjs" | "cjs" => Some(Self::JavaScript),
+            "py" | "pyi" => Some(Self::Python),
+            "java" => Some(Self::Java),
+            _ => None,
+        }
+    }
+
+    pub fn language_id(self) -> &'static str {
+        match self {
+            Self::Rust => "rust",
+            Self::TypeScript => "typescript",
+            Self::JavaScript => "javascript",
+            Self::Python => "python",
+            Self::Java => "java",
+        }
+    }
+
+    fn candidates(self) -> &'static [(&'static str, &'static [&'static str])] {
+        match self {
+            Self::Rust => &[("rust-analyzer", &[])],
+            Self::TypeScript | Self::JavaScript => &[
+                ("typescript-language-server", &["--stdio"]),
+                ("vtsls", &["--stdio"]),
+            ],
+            Self::Python => &[
+                ("pyright-langserver", &["--stdio"]),
+                ("pylsp", &[]),
+                ("jedi-language-server", &[]),
+            ],
+            Self::Java => &[("jdtls", &[])],
+        }
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct LspLimits {
+    pub startup_ms: u64,
+    pub request_ms: u64,
+    pub diagnostic_batch_ms: u64,
+    pub idle_ms: u64,
+    pub max_workspace_files: usize,
+    pub max_workspace_bytes: usize,
+    pub max_response_bytes: usize,
+    pub max_edit_files: usize,
+    pub max_text_edits: usize,
+    pub max_check_output_bytes: usize,
+    pub check_timeout_ms: u64,
+}
+
+impl Default for LspLimits {
+    fn default() -> Self {
+        Self {
+            startup_ms: 10_000,
+            request_ms: 10_000,
+            diagnostic_batch_ms: 150,
+            idle_ms: 60_000,
+            max_workspace_files: 20_000,
+            max_workspace_bytes: 128 * 1024 * 1024,
+            max_response_bytes: 4 * 1024 * 1024,
+            max_edit_files: 128,
+            max_text_edits: 4_096,
+            max_check_output_bytes: 1024 * 1024,
+            check_timeout_ms: 120_000,
+        }
+    }
+}
+
+impl LspLimits {
+    pub fn validate(&self) -> io::Result<()> {
+        if self.startup_ms == 0
+            || self.startup_ms > 120_000
+            || self.request_ms == 0
+            || self.request_ms > 120_000
+            || self.diagnostic_batch_ms == 0
+            || self.diagnostic_batch_ms > self.request_ms
+            || self.idle_ms < self.request_ms
+            || self.idle_ms > 3_600_000
+            || self.max_workspace_files == 0
+            || self.max_workspace_files > 1_000_000
+            || self.max_workspace_bytes == 0
+            || self.max_workspace_bytes > 2 * 1024 * 1024 * 1024
+            || self.max_response_bytes == 0
+            || self.max_response_bytes > 64 * 1024 * 1024
+            || self.max_edit_files == 0
+            || self.max_edit_files > 4_096
+            || self.max_text_edits == 0
+            || self.max_text_edits > 100_000
+            || self.max_check_output_bytes == 0
+            || self.max_check_output_bytes > 16 * 1024 * 1024
+            || self.check_timeout_ms == 0
+            || self.check_timeout_ms > 30 * 60 * 1_000
+        {
+            return Err(io::Error::other("invalid LSP limits"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct LspPreference {
+    pub repository_identity: String,
+    pub enabled: bool,
+    pub revision: u64,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct LspPreferenceFile {
+    schema: u32,
+    repositories: BTreeMap<String, LspPreference>,
+}
+
+pub struct LspPreferenceStore {
+    path: PathBuf,
+    state: LspPreferenceFile,
+}
+
+impl LspPreferenceStore {
+    pub fn open(path: PathBuf) -> io::Result<Self> {
+        let state = if path.exists() {
+            let bytes = fs::read(&path)?;
+            if bytes.len() > 1024 * 1024 {
+                return Err(io::Error::other("LSP preference store exceeds limit"));
+            }
+            let state: LspPreferenceFile = serde_json::from_slice(&bytes)?;
+            if state.schema != LSP_PREFERENCE_SCHEMA || state.repositories.len() > 10_000 {
+                return Err(io::Error::other("invalid LSP preference store"));
+            }
+            state
+        } else {
+            LspPreferenceFile {
+                schema: LSP_PREFERENCE_SCHEMA,
+                repositories: BTreeMap::new(),
+            }
+        };
+        Ok(Self { path, state })
+    }
+
+    pub fn preference(&self, repository_identity: &str) -> Option<&LspPreference> {
+        self.state.repositories.get(repository_identity)
+    }
+
+    pub fn set(&mut self, repository_identity: String, enabled: bool) -> io::Result<LspPreference> {
+        if repository_identity.is_empty() || repository_identity.len() > 512 {
+            return Err(io::Error::other("invalid repository identity"));
+        }
+        let revision = self
+            .state
+            .repositories
+            .get(&repository_identity)
+            .map_or(1, |prior| prior.revision.saturating_add(1));
+        let preference = LspPreference {
+            repository_identity: repository_identity.clone(),
+            enabled,
+            revision,
+        };
+        self.state
+            .repositories
+            .insert(repository_identity, preference.clone());
+        self.write()?;
+        Ok(preference)
+    }
+
+    fn write(&self) -> io::Result<()> {
+        let parent = self
+            .path
+            .parent()
+            .ok_or_else(|| io::Error::other("LSP preference parent missing"))?;
+        fs::create_dir_all(parent)?;
+        let name = self
+            .path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| io::Error::other("invalid LSP preference path"))?;
+        let temporary = parent.join(format!(".{name}.tmp-{}", std::process::id()));
+        let bytes = serde_json::to_vec_pretty(&self.state)?;
+        fs::write(&temporary, bytes)?;
+        fs::rename(temporary, &self.path)
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct LspWorkspaceBinding {
+    pub repository_identity: String,
+    pub repository: PathBuf,
+    pub revision: u64,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct LspWorkspaceBindingFile {
+    schema: u32,
+    repositories: BTreeMap<String, LspWorkspaceBinding>,
+}
+
+pub struct LspWorkspaceBindingStore {
+    path: PathBuf,
+    state: LspWorkspaceBindingFile,
+}
+
+pub fn lsp_workspace_binding_path(preference_store: &Path) -> io::Result<PathBuf> {
+    let parent = preference_store
+        .parent()
+        .ok_or_else(|| io::Error::other("LSP preference parent missing"))?;
+    let name = preference_store
+        .file_name()
+        .and_then(|name| name.to_str())
+        .ok_or_else(|| io::Error::other("invalid LSP preference path"))?;
+    Ok(parent.join(format!("{name}.workspaces.json")))
+}
+
+impl LspWorkspaceBindingStore {
+    pub fn open(path: PathBuf) -> io::Result<Self> {
+        let state = if path.exists() {
+            let bytes = fs::read(&path)?;
+            if bytes.len() > 1024 * 1024 {
+                return Err(io::Error::other(
+                    "LSP workspace binding store exceeds limit",
+                ));
+            }
+            let state: LspWorkspaceBindingFile = serde_json::from_slice(&bytes)?;
+            if state.schema != LSP_WORKSPACE_BINDING_SCHEMA || state.repositories.len() > 10_000 {
+                return Err(io::Error::other("invalid LSP workspace binding store"));
+            }
+            state
+        } else {
+            LspWorkspaceBindingFile {
+                schema: LSP_WORKSPACE_BINDING_SCHEMA,
+                repositories: BTreeMap::new(),
+            }
+        };
+        Ok(Self { path, state })
+    }
+
+    pub fn binding(&self, repository_identity: &str) -> Option<&LspWorkspaceBinding> {
+        self.state.repositories.get(repository_identity)
+    }
+
+    pub fn matches(&self, repository_identity: &str, repository: &Path) -> bool {
+        self.binding(repository_identity)
+            .is_some_and(|binding| binding.repository == repository)
+    }
+
+    pub fn set(
+        &mut self,
+        repository_identity: String,
+        repository: PathBuf,
+    ) -> io::Result<LspWorkspaceBinding> {
+        if repository_identity.is_empty() || repository_identity.len() > 512 {
+            return Err(io::Error::other("invalid repository identity"));
+        }
+        if !repository.is_absolute() || repository.is_symlink() {
+            return Err(io::Error::other(
+                "repository binding must be a canonical absolute directory",
+            ));
+        }
+        let canonical = repository.canonicalize()?;
+        if repository != canonical || !canonical.is_dir() {
+            return Err(io::Error::other(
+                "repository binding must be a canonical absolute directory",
+            ));
+        }
+        let revision = self
+            .state
+            .repositories
+            .get(&repository_identity)
+            .map_or(1, |prior| prior.revision.saturating_add(1));
+        let binding = LspWorkspaceBinding {
+            repository_identity: repository_identity.clone(),
+            repository: canonical,
+            revision,
+        };
+        self.state
+            .repositories
+            .insert(repository_identity, binding.clone());
+        self.write()?;
+        Ok(binding)
+    }
+
+    fn write(&self) -> io::Result<()> {
+        let parent = self
+            .path
+            .parent()
+            .ok_or_else(|| io::Error::other("LSP workspace binding parent missing"))?;
+        fs::create_dir_all(parent)?;
+        let name = self
+            .path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| io::Error::other("invalid LSP workspace binding path"))?;
+        let temporary = parent.join(format!(".{name}.tmp-{}", std::process::id()));
+        let bytes = serde_json::to_vec_pretty(&self.state)?;
+        fs::write(&temporary, bytes)?;
+        fs::rename(temporary, &self.path)
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct InstalledServer {
+    pub language: LspLanguage,
+    pub executable: Option<PathBuf>,
+    pub arguments: Vec<String>,
+}
+
+pub fn detect_installed_servers() -> Vec<InstalledServer> {
+    [
+        LspLanguage::Rust,
+        LspLanguage::TypeScript,
+        LspLanguage::JavaScript,
+        LspLanguage::Python,
+        LspLanguage::Java,
+    ]
+    .into_iter()
+    .map(|language| {
+        let found = language.candidates().iter().find_map(|(name, arguments)| {
+            resolve_executable(name)
+                .filter(|path| executable_responds(path))
+                .map(|path| {
+                    (
+                        path,
+                        arguments.iter().map(|value| (*value).to_string()).collect(),
+                    )
+                })
+        });
+        InstalledServer {
+            language,
+            executable: found.as_ref().map(|found| found.0.clone()),
+            arguments: found.map_or_else(Vec::new, |found| found.1),
+        }
+    })
+    .collect()
+}
+
+fn resolve_executable(name: &str) -> Option<PathBuf> {
+    let path = Path::new(name);
+    if path.components().count() > 1 {
+        return path.is_file().then(|| path.to_path_buf());
+    }
+    env::split_paths(&env::var_os("PATH")?).find_map(|directory| {
+        let candidate = directory.join(name);
+        candidate.is_file().then_some(candidate)
+    })
+}
+
+fn executable_responds(path: &Path) -> bool {
+    let mut child = match Command::new(path)
+        .arg("--version")
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+    {
+        Ok(child) => child,
+        Err(_) => return false,
+    };
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => return status.success(),
+            Ok(None) if Instant::now() < deadline => {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return false;
+            }
+        }
+    }
+}
