+++ b/codex-rs/omd/src/bin/omd-graph.rs
@@ -0,0 +1,81 @@
+use codex_omd::CodeGraph;
+use codex_omd::GraphFreshness;
+use codex_omd::GraphLimits;
+use serde::Serialize;
+use std::error::Error;
+use std::io;
+use std::path::Path;
+
+type AppResult<T> = Result<T, Box<dyn Error>>;
+
+fn print<T: Serialize>(value: &T) -> AppResult<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+
+fn ensure_fresh(graph: &CodeGraph, repository: &Path) -> AppResult<()> {
+    match graph.freshness(repository)? {
+        GraphFreshness::Fresh => Ok(()),
+        stale => Err(io::Error::other(format!(
+            "graph snapshot is stale; regenerate it: {}",
+            serde_json::to_string(&stale)?
+        ))
+        .into()),
+    }
+}
+
+fn build(
+    repository: &str,
+    graph_path: &str,
+    identity: &str,
+    revision: &str,
+) -> AppResult<CodeGraph> {
+    let graph = CodeGraph::build(
+        Path::new(repository),
+        identity.to_string(),
+        revision.to_string(),
+        GraphLimits::default(),
+    )?;
+    graph.write(Path::new(graph_path))?;
+    Ok(graph)
+}
+
+fn run(args: Vec<String>) -> AppResult<()> {
+    match args.as_slice() {
+        [_, command, repository, graph_path, identity, revision] if command == "build" => {
+            print(&build(repository, graph_path, identity, revision)?.repository)
+        }
+        [_, command, repository, graph_path, html_path, identity, revision] if command == "snapshot" => {
+            let graph = build(repository, graph_path, identity, revision)?;
+            graph.write_html(Path::new(html_path))?;
+            print(&graph.repository)
+        }
+        [_, command, repository, graph_path, html_path] if command == "html" => {
+            let graph = CodeGraph::read(Path::new(graph_path))?;
+            ensure_fresh(&graph, Path::new(repository))?;
+            graph.write_html(Path::new(html_path))?;
+            print(&graph.repository)
+        }
+        [_, command, repository, graph_path] if command == "validate" => {
+            let graph = CodeGraph::read(Path::new(graph_path))?;
+            ensure_fresh(&graph, Path::new(repository))?;
+            print(&graph.repository)
+        }
+        [_, command, repository, graph_path, ids @ ..] if command == "select" && !ids.is_empty() => {
+            let graph = CodeGraph::read(Path::new(graph_path))?;
+            ensure_fresh(&graph, Path::new(repository))?;
+            print(&graph.select(ids)?)
+        }
+        _ => Err(io::Error::other(
+            "usage: omd-graph build REPOSITORY GRAPH REPOSITORY_ID REVISION | snapshot REPOSITORY GRAPH HTML REPOSITORY_ID REVISION | html REPOSITORY GRAPH HTML | validate REPOSITORY GRAPH | select REPOSITORY GRAPH NODE_ID [...]",
+        )
+        .into()),
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().collect()) {
+        eprintln!("{error}");
+        std::process::exit(1);
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-guidelines.rs b/codex-rs/omd/src/bin/omd-guidelines.rs
new file mode 100644
index 0000000..3f3418a
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-guidelines.rs
@@ -0,0 +1,58 @@
+use codex_omd::GuidelineProposal;
+use codex_omd::GuidelineStore;
+use codex_omd::PromotionRequest;
+use codex_omd::RollbackRequest;
+use codex_omd::ValidationRecord;
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use std::error::Error;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+type AppResult<T> = Result<T, Box<dyn Error>>;
+
+fn read<T: DeserializeOwned>(path: &Path) -> AppResult<T> {
+    let bytes = std::fs::read(path)?;
+    if bytes.len() > 65_536 {
+        return Err(io::Error::other("input exceeds size limit").into());
+    }
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+fn print<T: Serialize>(value: &T) -> AppResult<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+
+fn run(args: Vec<String>) -> AppResult<()> {
+    let [_, command, root, rest @ ..] = args.as_slice() else {
+        return Err(io::Error::other("usage: omd-guidelines COMMAND STORE [ACTION.json]").into());
+    };
+    let root = PathBuf::from(root)
+        .canonicalize()
+        .unwrap_or_else(|_| PathBuf::from(root));
+    if command == "init" {
+        if !rest.is_empty() {
+            return Err(io::Error::other("init does not accept an action file").into());
+        }
+        return print(&GuidelineStore::create(root)?.active()?);
+    }
+    let store = GuidelineStore::open(root)?;
+    match (command.as_str(), rest) {
+        ("propose", [path]) => print(&store.propose(read::<GuidelineProposal>(Path::new(path))?)?),
+        ("validate", [path]) => print(&store.validate(read::<ValidationRecord>(Path::new(path))?)?),
+        ("promote", [path]) => print(&store.promote(read::<PromotionRequest>(Path::new(path))?)?),
+        ("rollback", [path]) => print(&store.rollback(read::<RollbackRequest>(Path::new(path))?)?),
+        ("active", []) => print(&store.active()?),
+        ("history", []) => print(&store.transitions()?),
+        _ => Err(io::Error::other("usage: omd-guidelines COMMAND STORE [ACTION.json]").into()),
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().collect()) {
+        eprintln!("{error}");
+        std::process::exit(1);
+    }
+}
