+#[test]
+fn a_later_failed_attempt_invalidates_an_earlier_completion() {
+    let mut gate = CompletionGate::new(CompletionPolicy::default(), contract(), sha('0')).unwrap();
+    gate.submit(submission('a')).unwrap();
