+pub struct ModHost {
+    store: ModStore,
+    node: PathBuf,
+    generation: u64,
+    configuration_sha256: String,
+    loaded: BTreeMap<String, Loaded>,
+    order: Vec<String>,
+    rejected: Vec<ModRejection>,
+    reload_error: Option<String>,
+    service_calls: Vec<Value>,
+    tool_validator: fn(&Value) -> Result<()>,
+    virtual_time_ms: Option<u64>,
+}
+
+impl ModHost {
+    pub fn open(root: PathBuf) -> Result<Self> {
+        Self::open_validated(root, |_| Ok(()))
+    }
+
+    pub fn open_validated(root: PathBuf, tool_validator: fn(&Value) -> Result<()>) -> Result<Self> {
+        let store = ModStore::open(root)?;
+        let mut host = Self {
+            store,
+            node: PathBuf::new(),
+            generation: 0,
+            configuration_sha256: String::new(),
+            loaded: BTreeMap::new(),
+            order: Vec::new(),
+            rejected: Vec::new(),
+            reload_error: None,
+            service_calls: Vec::new(),
+            tool_validator,
+            virtual_time_ms: None,
+        };
+        host.reload()?;
+        Ok(host)
+    }
+
+    pub fn reload(&mut self) -> Result<bool> {
+        let bytes = store::read(&self.store.root.join("mods.json"), 65_536)?;
+        let hash = digest(&bytes);
+        if hash == self.configuration_sha256 {
+            return Ok(false);
+        }
+        let config: ModConfiguration = serde_json::from_slice(&bytes)?;
+        if config.schema != 1 || !config.node.is_absolute() {
+            return Err(failure("invalid_mod_configuration"));
+        }
+        let initial = self.configuration_sha256.is_empty();
+        let retained = self.loaded.len();
+        self.loaded.retain(|_, loaded| {
+            config.mods.iter().any(|m| {
+                m.enabled
+                    && m.path == loaded.selection.path
+                    && loaded
+                        .package
+                        .capabilities
+                        .iter()
+                        .all(|cap| m.capabilities.contains(cap))
+            })
+        });
+        if self.loaded.len() != retained {
+            self.generation += 1;
+        }
+        let mut rejected = Vec::new();
+        let selected = Self::select(&config, initial, &mut rejected)?;
+        let mut next = BTreeMap::new();
+        for (id, (selection, package, source)) in selected {
+            let mut loaded = Loaded {
+                package,
+                source,
+                selection,
+                state: Value::Null,
+                registrations: Registrations::default(),
+                source_use: ModSourceUse::default(),
+                unused_grants: Vec::new(),
+                unused_environment: Vec::new(),
+                error: None,
+                telemetry: ModTelemetry::default(),
+            };
+            let prepared = (|| {
+                loaded.state = self.store.state(
+                    &loaded.package.id,
+                    &loaded.selection.scope,
+                    loaded.package.state_version,
+                )?;
+                let reply = Self::run(&config.node, &loaded, "inspect", "", Value::Null, &|| true)?;
+                Self::validate_registrations(&loaded.package, &reply.registrations)?;
+                if reply.state != loaded.state {
+                    return Err(failure("state_write_during_registration"));
+                }
+                for tool in &reply.registrations.tools {
+                    (self.tool_validator)(&tool.parameters)?;
+                }
+                let (source_use, unused_grants, unused_environment) =
+                    source_use(&loaded.source, &loaded.package, &reply.registrations)?;
+                Ok((
+                    reply.registrations,
+                    source_use,
+                    unused_grants,
+                    unused_environment,
+                ))
+            })();
+            match prepared {
+                Ok((registrations, source_use, unused_grants, unused_environment)) => {
+                    loaded.registrations = registrations;
+                    loaded.source_use = source_use;
+                    loaded.unused_grants = unused_grants;
+                    loaded.unused_environment = unused_environment;
+                }
+                Err(error) => fail(initial, &mut loaded, error)?,
+            }
+            next.insert(id, loaded);
+        }
+        Self::resolve_conflicts(&mut next, initial)?;
+        Self::resolve_services(&mut next, initial)?;
+        let order = Self::resolve_dependencies(&mut next, initial)?;
+        self.node = config.node;
+        self.loaded = next;
+        self.order = order;
+        self.rejected = rejected;
+        self.configuration_sha256 = hash;
+        self.generation += 1;
+        self.reload_error = None;
+        self.write_installed_service_types()?;
+        Ok(true)
+    }
+
+    /// Trusted, enabled selections keyed by mod ID after scope precedence.
+    fn select(
+        config: &ModConfiguration,
+        initial: bool,
+        rejected: &mut Vec<ModRejection>,
+    ) -> Result<BTreeMap<String, (ModSelection, ModPackage, String)>> {
+        let mut selected: BTreeMap<String, (ModSelection, ModPackage, String)> = BTreeMap::new();
+        for selection in config.mods.iter().filter(|m| m.enabled) {
+            let loaded = (|| {
+                if !MOD_SCOPES.contains(&selection.scope.as_str()) {
+                    return Err(failure(format!("unsupported_scope: {}", selection.scope)));
+                }
+                let (package, source, hash) = store::package(&selection.path)?;
+                if hash != selection.sha256 {
+                    return Err(failure(format!("untrusted_source: {}", package.id)));
+                }
+                let granted: BTreeSet<_> = selection.capabilities.iter().collect();
+                if package.capabilities.iter().any(|c| !granted.contains(c))
+                    || selection
+                        .capabilities
+                        .iter()
+                        .any(|c| !MOD_CAPABILITIES.contains(&c.as_str()))
+                {
+                    return Err(failure(format!("capability_denied: {}", package.id)));
+                }
+                validate_settings(&package, &selection.settings)?;
+                Ok((package, source))
+            })();
+            let (package, source) = match loaded {
+                Ok(loaded) => loaded,
+                Err(error) => {
+                    reject(initial, rejected, selection, None, error.to_string())?;
+                    continue;
+                }
+            };
+            let id = package.id.clone();
+            let Some((previous, ..)) = selected.get(&id) else {
+                selected.insert(id, (selection.clone(), package, source));
+                continue;
+            };
+            if previous.scope != selection.scope {
+                let (loser, winner) = match selection.scope.as_str() {
+                    "project" => {
+                        let (previous, ..) = selected
+                            .insert(id.clone(), (selection.clone(), package, source))
+                            .expect("checked above");
+                        (previous, selection.path.clone())
+                    }
+                    _ => (selection.clone(), previous.path.clone()),
+                };
+                rejected.push(ModRejection {
+                    path: loser.path,
+                    id: Some(id),
+                    scope: loser.scope,
+                    reason: format!("shadowed_by_project_scope: {}", winner.display()),
+                });
+                continue;
+            }
+            let reason = format!(
+                "mod_conflict: {id} is enabled twice in the {} scope",
+                selection.scope
+            );
+            let (previous, ..) = selected.remove(&id).expect("checked above");
+            reject(initial, rejected, &previous, Some(&id), reason.clone())?;
+            reject(initial, rejected, selection, Some(&id), reason)?;
+        }
+        Ok(selected)
+    }
+
+    /// Every claimant of a contested slot is disabled; none silently wins.
+    fn resolve_conflicts(next: &mut BTreeMap<String, Loaded>, initial: bool) -> Result<()> {
+        let mut tools: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        let mut points: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        let mut contracts: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, m)| m.error.is_none()) {
+            for tool in &loaded.registrations.tools {
+                tools
+                    .entry(format!("mod_{id}_{}", tool.name))
+                    .or_default()
+                    .push(id.clone());
+            }
+            for point in &loaded.registrations.replacements {
+                points.entry(point.clone()).or_default().push(id.clone());
+            }
+            for contract in &loaded.registrations.contracts {
+                contracts
+                    .entry(contract.id.clone())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        let contested = |kind: &'static str, claims: BTreeMap<String, Vec<String>>| {
+            claims
+                .into_iter()
+                .filter(|(_, ids)| ids.len() > 1)
+                .flat_map(move |(slot, ids)| {
+                    let reason = format!("{kind}: {slot} claimed by {}", ids.join(", "));
+                    ids.into_iter().map(move |id| (id, reason.clone()))
+                })
+                .collect::<Vec<_>>()
+        };
+        let mut conflicts = contested("tool_name_conflict", tools);
+        conflicts.extend(contested("replacement_conflict", points));
+        conflicts.extend(contested("workflow_replacement_conflict", contracts));
+        for (id, reason) in conflicts {
+            if let Some(loaded) = next.get_mut(&id) {
+                fail(initial, loaded, failure(reason))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn resolve_services(next: &mut BTreeMap<String, Loaded>, initial: bool) -> Result<()> {
+        let mut claims: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, loaded)| loaded.error.is_none()) {
+            for contract in &loaded.registrations.services {
+                claims
+                    .entry(contract.name.clone())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        for (name, providers) in claims.iter().filter(|(_, providers)| providers.len() > 1) {
+            let reason = format!(
+                "service_provider_collision: {name} provided by {}",
+                providers.join(", ")
+            );
+            for provider in providers {
+                if let Some(loaded) = next.get_mut(provider) {
+                    fail(initial, loaded, failure(reason.clone()))?;
+                }
+            }
+        }
+        loop {
+            let providers: BTreeMap<String, (String, String)> = next
+                .iter()
+                .filter(|(_, loaded)| loaded.error.is_none())
+                .flat_map(|(id, loaded)| {
+                    loaded.registrations.services.iter().map(|contract| {
+                        (
+                            contract.name.clone(),
+                            (id.clone(), contract.version.clone()),
+                        )
+                    })
+                })
+                .collect();
+            let unavailable: Vec<_> = next
+                .iter()
+                .filter(|(_, loaded)| loaded.error.is_none())
+                .filter_map(|(id, loaded)| {
+                    loaded.package.services.imports.iter().find_map(|import| {
+                        match providers.get(&import.name) {
+                            Some((_, version))
+                                if service_version_satisfies(&import.version, version) =>
+                            {
+                                None
+                            }
+                            None if import.optional => None,
+                            Some((_, version)) => Some((
+                                id.clone(),
+                                format!(
+                                    "service_version_incompatible: consumer {id} requires {} {} but the active provider exports {}. Install a compatible provider/consumer pair; the consumer was not activated and the provider remains eligible.",
+                                    import.name, import.version, version,
+                                ),
+                            )),
+                            None => Some((
+                                id.clone(),
+                                format!(
+                                    "service_provider_missing: {} requires {}",
+                                    id, import.name
+                                ),
+                            )),
+                        }
+                    })
+                })
+                .collect();
+            if unavailable.is_empty() {
+                break;
+            }
+            for (id, reason) in unavailable {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(initial, loaded, failure(reason))?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn dependencies(id: &str, next: &BTreeMap<String, Loaded>) -> Vec<String> {
+        let Some(loaded) = next.get(id) else {
+            return Vec::new();
+        };
+        let providers: BTreeMap<&str, &str> = next
+            .iter()
+            .filter(|(_, candidate)| candidate.error.is_none())
+            .flat_map(|(provider, candidate)| {
+                candidate
+                    .registrations
+                    .services
+                    .iter()
+                    .map(move |contract| (contract.name.as_str(), provider.as_str()))
+            })
+            .collect();
+        let mut dependencies = loaded.package.requires.clone();
+        dependencies.extend(
+            loaded
+                .package
+                .dependencies
+                .iter()
+                .map(|dependency| dependency.id.clone()),
+        );
+        dependencies.extend(
+            loaded
+                .package
+                .services
+                .imports
+                .iter()
+                .filter_map(|import| providers.get(import.name.as_str()).copied())
+                .filter(|provider| *provider != id)
+                .map(str::to_owned),
+        );
+        dependencies.sort();
+        dependencies.dedup();
+        dependencies
+    }
+
+    /// Resolves declared dependencies and returns the activation order.
+    fn resolve_dependencies(
+        next: &mut BTreeMap<String, Loaded>,
+        initial: bool,
+    ) -> Result<Vec<String>> {
+        loop {
+            let unavailable: Vec<(String, String)> = next
+                .iter()
+                .filter(|(_, m)| m.error.is_none())
+                .filter_map(|(id, loaded)| {
+                    if let Some(dependency) = loaded.package.dependencies.iter().find(|dependency| {
+                        next.get(&dependency.id).is_some_and(|candidate| {
+                            candidate.error.is_none()
+                                && !service_version_satisfies(
+                                    &dependency.version,
+                                    &candidate.package.version,
+                                )
+                        })
+                    }) {
+                        let actual = &next[&dependency.id].package.version;
+                        return Some((
+                            id.clone(),
+                            format!(
+                                "dependency_version_incompatible: {id} requires {} {} but {} is active",
+                                dependency.id, dependency.version, actual
+                            ),
+                        ));
+                    }
+                    Self::dependencies(id, next)
+                        .iter()
+                        .find(|required| next.get(*required).is_none_or(|m| m.error.is_some()))
+                        .map(|required| {
+                            (
+                                id.clone(),
+                                format!("dependency_unavailable: {id} requires {required}"),
+                            )
+                        })
+                })
+                .collect();
+            if unavailable.is_empty() {
+                break;
+            }
+            for (id, reason) in unavailable {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(initial, loaded, failure(reason))?;
+                }
+            }
+        }
+        let mut remaining: BTreeSet<String> = next
+            .iter()
+            .filter(|(_, m)| m.error.is_none())
+            .map(|(id, _)| id.clone())
+            .collect();
+        let mut order = Vec::new();
+        while let Some(id) = remaining
+            .iter()
+            .find(|id| {
+                Self::dependencies(id, next)
+                    .iter()
+                    .all(|required| !remaining.contains(required))
+            })
+            .cloned()
+        {
+            remaining.remove(&id);
+            order.push(id);
+        }
+        if !remaining.is_empty() {
+            let reason = format!(
+                "dependency_cycle: {}",
+                remaining.iter().cloned().collect::<Vec<_>>().join(" -> ")
+            );
+            for id in remaining {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(initial, loaded, failure(reason.clone()))?;
+                }
+            }
+        }
+        Ok(order)
+    }
+
+    fn validate_registrations(package: &ModPackage, registrations: &Registrations) -> Result<()> {
+        let has = |cap: &str| package.capabilities.iter().any(|c| c == cap);
+        if package.api != MOD_API_VERSION
+            && (registrations.tools.iter().any(|tool| tool.task_scoped)
+                || registrations
+                    .events
+                    .iter()
+                    .any(|event| event == "tool_exposure"))
+        {
+            return Err(failure("task_tool_exposure_requires_current_api"));
+        }
+        if registrations.tools.len() > 16
+            || registrations.commands.len() > 16
+            || registrations.events.len() > MOD_EVENTS.len()
+            || (!registrations.tools.is_empty() && !has("tools"))
+            || (!registrations.commands.is_empty() && !has("commands"))
+            || (!registrations.contracts.is_empty() && !has("workflow"))
+            || (!registrations.services.is_empty() && !has("services"))
+            || registrations.contracts.len() > 4
+            || registrations.services.len() > 8
+        {
+            return Err(failure("registration_limit_or_capability_denied"));
+        }
+        if registrations.services != package.services.exports {
+            return Err(failure(
+                "registered_service_contracts_do_not_match_manifest",
+            ));
+        }
+        let mut contract_ids = BTreeSet::new();
+        for contract in &registrations.contracts {
+            contract.validate().map_err(failure)?;
+            if contract.host_owned() || !contract_ids.insert(&contract.id) {
+                return Err(failure("invalid_or_duplicate_contract_registration"));
+            }
+        }
+        let visible = |text: &str, limit: usize| {
+            !text.is_empty() && text.len() <= limit && !text.chars().any(char::is_control)
+        };
+        let mut names = BTreeSet::new();
+        for tool in &registrations.tools {
+            if !identifier(&tool.name)
+                || !names.insert(&tool.name)
+                || tool
+                    .label
+                    .as_deref()
+                    .is_some_and(|label| !visible(label, 64))
+                || tool.description.is_empty()
+                || tool.description.len() > 2048
+                || tool.parameters["type"] != "object"
+                || !tool.parameters["properties"].is_object()
+                || serde_json::to_vec(&tool.parameters)?.len() > 8192
+            {
+                return Err(failure("invalid_tool_registration"));
+            }
+        }
+        names.clear();
+        for command in &registrations.commands {
+            if !identifier(&command.name)
+                || !names.insert(&command.name)
+                || command
+                    .description
+                    .as_deref()
+                    .is_some_and(|description| !visible(description, 256))
+            {
+                return Err(failure("command_conflict_or_invalid_description"));
+            }
+        }
+        names.clear();
+        for event in &registrations.events {
+            let capability = MOD_EVENTS
+                .iter()
+                .find(|(name, _)| name == event)
+                .map(|(_, capability)| *capability)
+                .ok_or_else(|| failure("unsupported_event"))?;
+            if !(has(capability) || event == "tool_result" && has("middleware"))
+                || !names.insert(event)
+            {
+                return Err(failure("event_capability_denied_or_conflict"));
+            }
+        }
+        if registrations.replacements.iter().any(|point| {
+            !MOD_REPLACEMENT_POINTS.contains(&point.as_str())
+                || !registrations.events.contains(point)
+        }) {
+            return Err(failure("invalid_replacement_point"));
+        }
+        Ok(())
+    }
+
+    fn run(
+        node: &Path,
+        loaded: &Loaded,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: &dyn Fn() -> bool,
+    ) -> Result<Reply> {
+        bridge::run(
+            node,
+            loaded,
+            event,
+            name,
+            payload,
+            active,
+            &mut |_| {
+                Err(failure(
+                    "host_operation_unavailable: requires a native task",
+                ))
+            },
+            &mut |_| {},
+            None,
+        )
+    }
+
+    pub fn invoke(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+    ) -> Result<Value> {
+        self.invoke_guarded(id, generation, event, name, payload, || true)
+    }
+
+    pub fn invoke_guarded(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value> {
+        self.invoke_with(id, generation, event, name, payload, active, |_| {
+            Err(failure(
+                "host_operation_unavailable: requires a native task",
+            ))
+        })
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn invoke_with(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+        host: impl FnMut(ModHostCall) -> Result<Value>,
+    ) -> Result<Value> {
+        self.invoke_streaming(id, generation, event, name, payload, active, host, |_| {})
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn invoke_streaming(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(ModHostCall) -> Result<Value>,
+        mut progress: impl FnMut(String),
+    ) -> Result<Value> {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        if generation != self.generation {
+            return Err(failure("stale_mod_generation: retry on the next turn"));
+        }
+        let mut loaded = self
+            .loaded
+            .get(id)
+            .cloned()
+            .ok_or_else(|| failure("mod_disabled"))?;
+        if let Some(error) = &loaded.error {
+            return Err(failure(format!(
+                "mod_failed: {error}; explicitly reload to recover"
+            )));
+        }
+        loaded.state = self.store.state(
+            &loaded.package.id,
+            &loaded.selection.scope,
+            loaded.package.state_version,
+        )?;
+        let previous_state = loaded.state.clone();
+        let node = self.node.clone();
+        let virtual_time_ms = self.virtual_time_ms;
+        let started = Instant::now();
+        let result = (|| {
+            match event {
+                "tool" if loaded.registrations.tools.iter().any(|t| t.name == name) => (),
+                "command" if loaded.registrations.commands.iter().any(|c| c.name == name) => (),
+                "service"
+                    if loaded.registrations.services.iter().any(|contract| {
+                        contract
+                            .methods
+                            .keys()
+                            .any(|method| format!("{}.{}", contract.name, method) == name)
+                    }) => {}
+                e if loaded
+                    .registrations
+                    .events
+                    .iter()
+                    .any(|registered| registered == e) => {}
+                _ => return Err(failure("unsupported_or_unregistered_operation")),
+            }
+            let reply = bridge::run(
+                &node,
+                &loaded,
+                event,
+                name,
+                payload,
+                &active,
+                &mut |call| {
+                    let before = json!({"phase":"before","caller":id,"operation":call.operation,"arguments":call.arguments});
+                    let _ = self.event_except("host_operation", before, id, &active);
+                    let result = if call.operation == "mods.service" {
+                        self.call_service(id, generation, call.arguments.clone(), &active)
+                    } else {
+                        host(call.clone())
+                    };
+                    let after = match &result {
+                        Ok(value) => {
+                            json!({"phase":"after","caller":id,"operation":call.operation,"result":value})
+                        }
+                        Err(error) => {
+                            json!({"phase":"after","caller":id,"operation":call.operation,"error":error.to_string()})
+                        }
+                    };
+                    let _ = self.event_except("host_operation", after, id, &active);
+                    result
+                },
+                &mut progress,
+                virtual_time_ms,
+            )?;
+            if !active() {
+                return Err(failure("callback_cancelled"));
+            }
+            if reply.registrations != loaded.registrations {
+                return Err(failure("registration_changed_during_callback"));
+            }
+            let replaces = |point: &str| {
+                loaded
+                    .registrations
+                    .replacements
+                    .iter()
+                    .any(|registered| registered == point)
+            };
+            if matches!(event, "routing" | "worker_context" | "compaction")
+                && !reply.value.is_null()
+                && !replaces(event)
+            {
+                return Err(failure("exclusive_replacement_registration_required"));
+            }
+            if event == "context" && !reply.value.is_null() {
+                let text = reply
+                    .value
+                    .get("text")
+                    .and_then(Value::as_str)
+                    .ok_or_else(|| failure("invalid_context_result"))?;
+                if text.len() > 1024 {
+                    return Err(failure("context_limit"));
+                }
+            }
+            if event == "worker_context" && !reply.value.is_null() {
+                let object = reply
+                    .value
+                    .as_object()
+                    .filter(|object| object.len() == 1)
+                    .ok_or_else(|| failure("invalid_worker_context_result"))?;
+                if object
+                    .get("mode")
+                    .and_then(Value::as_str)
+                    .is_none_or(|mode| {
+                        !["focused_brief", "shared_task_packet", "parent_history"].contains(&mode)
+                    })
+                {
+                    return Err(failure("invalid_worker_context_result"));
+                }
+            }
+            if event == "routing" && !reply.value.is_null() {
+                let valid = reply
+                    .value
+                    .as_str()
+                    .is_some_and(|route| ["sol", "astra"].contains(&route))
+                    || reply.value.as_object().is_some_and(|object| {
+                        object.len() == 2
+                            && object
+                                .get("route")
+                                .and_then(Value::as_str)
+                                .is_some_and(|route| ["sol", "astra"].contains(&route))
+                            && object
+                                .get("policy")
+                                .and_then(Value::as_str)
+                                .is_some_and(|policy| ["fixed", "task_entry"].contains(&policy))
+                    });
+                if !valid {
+                    return Err(failure("invalid_routing_result"));
+                }
+            }
+            if event == "tool_before"
+                && reply.value.get("arguments").is_some()
+                && !replaces("tool_before")
+            {
+                return Err(failure("exclusive_replacement_registration_required"));
+            }
+            if event == "terminal" && !reply.value.is_null() {
+                if replaces("terminal") {
+                    ModView::parse(reply.value.clone())?;
+                } else if loaded.package.api == MOD_API_VERSION {
+                    ModViewPatch::parse(reply.value.clone())?;
+                } else {
+                    return Err(failure("exclusive_replacement_registration_required"));
+                }
+            }
+            if event == "input" {
+                let decision = ModInputDecision::parse(&reply.value)?;
+                if matches!(decision, ModInputDecision::Rewrite(_)) && !replaces("input") {
+                    return Err(failure("exclusive_replacement_registration_required"));
+                }
+            }
+            if matches!(
+                event,
+                "prompt" | "session" | "agent" | "tool_call" | "tool_result" | "host_operation"
+            ) && !reply.value.is_null()
+            {
+                return Err(failure("observe_only_event_returned_a_value"));
+            }
+            if reply.state != loaded.state {
+                if !loaded.package.capabilities.iter().any(|c| c == "state") {
+                    return Err(failure("state_capability_denied"));
+                }
+                self.store.write_state(
+                    &loaded.package.id,
+                    &loaded.selection.scope,
+                    loaded.package.state_version,
+                    &loaded.state,
+                    &reply.state,
+                )?;
+            }
+            Ok((reply.value, reply.state))
+        })();
+        let current = self
+            .loaded
+            .get_mut(id)
+            .ok_or_else(|| failure("mod_disabled"))?;
+        let elapsed = started.elapsed().as_micros();
+        match result {
+            Ok((value, state)) => {
+                current
+                    .telemetry
+                    .record(self.generation, event, name, elapsed, "ok");
+                if state != previous_state {
+                    current.state = state;
+                }
+                Ok(value)
+            }
+            Err(error) => {
+                current
+                    .telemetry
+                    .record(self.generation, event, name, elapsed, "error");
+                if !error.to_string().starts_with("state_conflict") {
+                    current.error = Some(error.to_string());
+                }
+                Err(error)
+            }
+        }
+    }
+
+    fn event_except(
+        &mut self,
+        event: &str,
+        payload: Value,
+        excluded: &str,
+        active: &dyn Fn() -> bool,
+    ) -> Vec<(String, Result<Value>)> {
+        let ids: Vec<_> = self
+            .active()
+            .filter(|(id, loaded)| {
+                id.as_str() != excluded
+                    && loaded
+                        .registrations
+                        .events
+                        .iter()
+                        .any(|registered| registered == event)
+            })
+            .map(|(id, _)| id.clone())
+            .collect();
+        ids.into_iter()
+            .map(|id| {
+                let result =
+                    self.invoke_guarded(&id, self.generation, event, "", payload.clone(), active);
+                (id, result)
+            })
+            .collect()
+    }
+
+    fn call_service(
+        &mut self,
+        caller: &str,
+        generation: u64,
+        arguments: Value,
+        active: &dyn Fn() -> bool,
+    ) -> Result<Value> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct ServiceCall {
+            name: String,
+            method: String,
+            input: Value,
+        }
+        let call: ServiceCall = serde_json::from_value(arguments)?;
+        if serde_json::to_vec(&call.input)?.len() > 32_768 {
+            return Err(failure("service_input_limit"));
+        }
+        let consumer = self
+            .loaded
+            .get(caller)
+            .ok_or_else(|| failure("mod_disabled"))?;
+        let import = consumer
+            .package
+            .services
+            .imports
+            .iter()
+            .find(|import| import.name == call.name)
+            .ok_or_else(|| failure("undeclared_service_use"))?;
+        let provider = self.active().find_map(|(id, loaded)| {
+            loaded
+                .registrations
+                .services
+                .iter()
+                .find(|contract| contract.name == call.name)
+                .map(|contract| (id.clone(), contract.clone()))
+        });
+        let Some((provider, contract)) = provider else {
+            return Err(failure(if import.optional {
+                "optional_service_unavailable"
+            } else {
+                "service_provider_missing"
+            }));
+        };
+        if !service_version_satisfies(&import.version, &contract.version) {
+            return Err(failure(format!(
+                "service_version_incompatible: consumer {caller} requires {} {} but provider {provider} exports {}",
+                call.name, import.version, contract.version
+            )));
+        }
+        let method = contract
+            .methods
+            .get(&call.method)
+            .ok_or_else(|| failure("unknown_service_method"))?;
+        validate_service_value(&call.input, &method.input)?;
+        let qualified = format!("{}.{}", call.name, call.method);
+        let result = self.invoke_guarded(
+            &provider, generation, "service", &qualified, call.input, active,
+        )?;
+        validate_service_value(&result, &method.output)?;
+        if serde_json::to_vec(&result)?.len() > 32_768 {
+            return Err(failure("service_output_limit"));
+        }
+        self.service_calls.push(
+            json!({"caller":caller,"provider":provider,"service":call.name,
+            "version":contract.version,"method":call.method,"generation":generation}),
+        );
+        if self.service_calls.len() > 64 {
+            self.service_calls.remove(0);
+        }
+        Ok(result)
+    }
+
+    pub fn event(&mut self, event: &str, payload: Value) -> Vec<(String, Result<Value>)> {
+        self.event_guarded(event, payload, || true)
+    }
+
+    pub fn model_request(
+        &mut self,
+        mut payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value> {
+        let presets = payload["authorized_presets"]
+            .as_array()
+            .ok_or_else(|| failure("authorized_presets_required"))?
+            .clone();
+        let mut effective = payload["effective"]
+            .as_object()
+            .cloned()
+            .ok_or_else(|| failure("effective_route_required"))?;
+        let ids = self.event_ids("model_request");
+        let mut provenance = Vec::new();
+        for (order, id) in ids.into_iter().enumerate() {
+            payload["effective"] = Value::Object(effective.clone());
+            let value = self.invoke_guarded(
+                &id,
+                self.generation,
+                "model_request",
+                "",
+                payload.clone(),
+                &active,
+            )?;
+            if value.is_null() {
+                continue;
+            }
+            let object = value
+                .as_object()
+                .filter(|object| object.len() == 1)
+                .ok_or_else(|| failure("invalid_model_request_result"))?;
+            let selected = object
+                .get("preset")
+                .and_then(Value::as_str)
+                .ok_or_else(|| failure("invalid_model_request_result"))?;
+            let preset = presets
+                .iter()
+                .find(|preset| preset["name"].as_str() == Some(selected))
+                .and_then(Value::as_object)
+                .ok_or_else(|| failure(format!("unauthorized_request_preset: {selected}")))?;
+            let previous = effective.get("name").cloned().unwrap_or(Value::Null);
+            effective = preset.clone();
+            if let Some(loaded) = self.loaded.get(&id) {
+                provenance.push(
+                    json!({"order":order,"origin":id,"version":loaded.package.version,
+                    "sha256":loaded.selection.sha256,"tier":loaded.selection.scope,
+                    "from":previous,"to":selected}),
+                );
+            }
+        }
+        payload["effective"] = Value::Object(effective);
+        payload["provenance"] = Value::Array(provenance);
+        Ok(payload)
+    }
+
+    pub fn response_stream(
+        &mut self,
+        mut payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value> {
+        let protected = payload["protected"].as_bool().unwrap_or(true);
+        let original = payload.get("text").cloned().unwrap_or(Value::Null);
+        let mut effective = original.clone();
+        let mut provenance = Vec::new();
+        let mut fallback = Vec::new();
+        for (order, id) in self.event_ids("response_stream").into_iter().enumerate() {
+            payload["text"] = effective.clone();
+            let value = match self.invoke_guarded(
+                &id,
+                self.generation,
+                "response_stream",
+                "",
+                payload.clone(),
+                &active,
+            ) {
+                Ok(value) => value,
+                Err(error) => {
+                    fallback.push(json!({"origin":id,"error":error.to_string()}));
+                    continue;
+                }
+            };
+            if value.is_null() {
+                continue;
+            }
+            if protected {
+                let error = "protected_stream_field_is_observe_only".to_owned();
+                if let Some(loaded) = self.loaded.get_mut(&id) {
+                    loaded.error = Some(error.clone());
+                }
+                fallback.push(json!({"origin":id,"error":error}));
+                continue;
+            }
+            let Some(text) = value
+                .as_object()
+                .filter(|object| object.len() == 1)
+                .and_then(|object| object.get("text"))
+                .and_then(Value::as_str)
+                .filter(|text| text.len() <= 8192)
+            else {
+                let error = "invalid_stream_transformation".to_owned();
+                if let Some(loaded) = self.loaded.get_mut(&id) {
+                    loaded.error = Some(error.clone());
+                }
+                fallback.push(json!({"origin":id,"error":error}));
+                continue;
+            };
+            let previous = effective.clone();
+            effective = Value::String(text.to_owned());
+            if let Some(loaded) = self.loaded.get(&id) {
+                provenance.push(
+                    json!({"order":order,"origin":id,"version":loaded.package.version,
+                    "sha256":loaded.selection.sha256,"tier":loaded.selection.scope,
+                    "from_sha256":digest(serde_json::to_string(&previous)?.as_bytes()),
+                    "to_sha256":digest(serde_json::to_string(&effective)?.as_bytes())}),
+                );
+            }
+        }
+        payload["original"] = original;
+        payload["effective"] = effective;
+        payload["provenance"] = Value::Array(provenance);
+        payload["fallback"] = Value::Array(fallback);
+        Ok(payload)
+    }
+
+    fn event_ids(&self, event: &str) -> Vec<String> {
+        self.active()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .events
+                    .iter()
+                    .any(|registered| registered == event)
+            })
+            .map(|(id, _)| id.clone())
+            .collect()
+    }
+
+    pub fn event_guarded(
+        &mut self,
+        event: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Vec<(String, Result<Value>)> {
+        let ids = self.event_ids(event);
+        ids.into_iter()
+            .map(|id| {
+                let result =
+                    self.invoke_guarded(&id, self.generation, event, "", payload.clone(), &active);
+                (id, result)
+            })
+            .collect()
+    }
+
+    pub fn terminal_view(&mut self, payload: Value, active: impl Fn() -> bool) -> ModTerminalView {
+        let owner = self.replacement_owner("terminal");
+        let results = self.event_guarded("terminal", payload, active);
+        let mut view = ModView::default();
+        let mut patches = Vec::new();
+        let mut diagnostics = Vec::new();
+        for (id, result) in results {
+            match result {
+                Ok(value) if value.is_null() => {}
+                Ok(value) if owner.as_deref() == Some(id.as_str()) => match ModView::parse(value) {
+                    Ok(candidate) => view = candidate,
+                    Err(error) => diagnostics.push(format!("{id}: {error}")),
+                },
+                Ok(value) => match ModViewPatch::parse(value) {
+                    Ok(patch) => patches.push((id, patch)),
+                    Err(error) => diagnostics.push(format!("{id}: {error}")),
+                },
+                Err(error) => diagnostics.push(format!("{id}: {error}")),
+            }
+        }
+        let mut replaced_sites = BTreeSet::new();
+        let mut completed_tools_owner = false;
+        let mut contributors = Vec::new();
+        for (id, patch) in patches {
+            match patch.apply(&mut view, &mut replaced_sites, &mut completed_tools_owner) {
+                Ok(()) => contributors.push(id),
+                Err(error) => {
+                    diagnostics.push(format!("{id}: {error}"));
+                    if let Some(loaded) = self.loaded.get_mut(&id) {
+                        loaded.error = Some(error.to_string());
+                    }
+                }
+            }
+        }
+        ModTerminalView {
+            view,
+            owner,
+            contributors,
+            diagnostics,
+        }
+    }
+
+    pub fn turn_boundary(&mut self) {
+        if let Err(error) = self.reload() {
+            self.reload_error = Some(error.to_string());
+        }
+    }
+
+    /// Activated mods in composition order: dependencies first, mod ID otherwise.
+    fn active(&self) -> impl Iterator<Item = (&String, &Loaded)> {
+        self.order.iter().filter_map(|id| {
+            self.loaded
+                .get(id)
+                .filter(|m| m.error.is_none())
+                .map(|m| (id, m))
+        })
+    }
+
+    pub fn tools(&self) -> Vec<(String, u64, ModTool)> {
+        self.active()
+            .flat_map(|(id, m)| {
+                m.registrations
+                    .tools
+                    .iter()
+                    .map(|tool| (id.clone(), self.generation, tool.clone()))
+            })
+            .collect()
+    }
+
+    pub fn has_task_scoped_tools(&self) -> bool {
+        self.active().any(|(_, loaded)| {
+            loaded
+                .registrations
+                .tools
+                .iter()
+                .any(|tool| tool.task_scoped)
+        })
+    }
+
+    pub fn tools_for_step(
+        &mut self,
+        thread_id: Option<String>,
+        checkpoint: Value,
+        active: impl Fn() -> bool,
+    ) -> Vec<(String, u64, ModTool)> {
+        let ids: Vec<String> = self
+            .active()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .tools
+                    .iter()
+                    .any(|tool| tool.task_scoped)
+            })
+            .map(|(id, _)| id.clone())
+            .collect();
+        let mut enabled = BTreeSet::new();
+        for id in ids {
+            let Some(loaded) = self.loaded.get(&id) else {
+                continue;
+            };
+            let available: BTreeSet<String> = loaded
+                .registrations
+                .tools
+                .iter()
+                .filter(|tool| tool.task_scoped)
+                .map(|tool| tool.name.clone())
+                .collect();
+            if !loaded
+                .registrations
+                .events
+                .iter()
+                .any(|event| event == "tool_exposure")
+            {
+                continue;
+            }
+            let payload =
+                json!({"thread_id":thread_id,"checkpoint":checkpoint,"available":available});
+            let result =
+                self.invoke_guarded(&id, self.generation, "tool_exposure", "", payload, &active);
+            let selection = result.ok().and_then(|value| {
+                let object = value.as_object().filter(|object| object.len() == 1)?;
+                let names = object.get("enable")?.as_array()?;
+                if names.len() > available.len() {
+                    return None;
+                }
+                let selected: Option<BTreeSet<String>> = names
+                    .iter()
+                    .map(|value| {
+                        value
+                            .as_str()
+                            .filter(|name| available.contains(*name))
+                            .map(str::to_owned)
+                    })
+                    .collect();
+                selected.filter(|selected| selected.len() == names.len())
+            });
+            if let Some(selection) = selection {
+                enabled.extend(selection.into_iter().map(|name| (id.clone(), name)));
+            } else if self
+                .loaded
+                .get(&id)
+                .is_some_and(|loaded| loaded.error.is_none())
+                && let Some(loaded) = self.loaded.get_mut(&id)
+            {
+                loaded.error = Some(
+                    "invalid_tool_exposure: only owned task-scoped tools may be selected".into(),
+                );
+            }
+        }
+        self.tools()
+            .into_iter()
+            .filter(|(id, _, tool)| {
+                !tool.task_scoped || enabled.contains(&(id.clone(), tool.name.clone()))
+            })
+            .collect()
+    }
+
+    pub fn commands(&self) -> Vec<(String, ModCommand)> {
+        self.active()
+            .flat_map(|(id, m)| {
+                m.registrations
+                    .commands
+                    .iter()
+                    .map(|command| (id.clone(), command.clone()))
+            })
+            .collect()
+    }
+
+    pub fn owners(&self) -> Vec<(String, crate::PolicyOwner)> {
+        self.active()
+            .map(|(id, m)| (id.clone(), Self::owner(m)))
+            .collect()
+    }
+
+    /// The mod holding the exclusive replacement slot for a decision point.
+    pub fn replacement_owner(&self, point: &str) -> Option<String> {
+        self.active()
+            .find(|(_, m)| m.registrations.replacements.iter().any(|p| p == point))
+            .map(|(id, _)| id.clone())
+    }
+
+    fn owner(loaded: &Loaded) -> crate::PolicyOwner {
+        crate::PolicyOwner {
+            kind: crate::OwnerKind::Mod,
+            id: loaded.package.id.clone(),
+            version: loaded.package.version.clone(),
+            source: loaded.selection.path.display().to_string(),
+            sha256: loaded.selection.sha256.clone(),
+        }
+    }
+
+    pub fn contracts(&self) -> Vec<(crate::WorkflowContract, crate::PolicyOwner)> {
+        self.active()
+            .map(|(_, m)| m)
+            .flat_map(|m| {
+                m.registrations
+                    .contracts
+                    .iter()
+                    .map(|contract| (contract.clone(), Self::owner(m)))
+            })
+            .collect()
+    }
+
+    pub fn registered(&self, id: &str, event: &str) -> bool {
+        self.loaded
+            .get(id)
+            .is_some_and(|m| m.error.is_none() && m.registrations.events.iter().any(|e| e == event))
+    }
+
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    pub fn configuration_sha256(&self) -> &str {
+        &self.configuration_sha256
+    }
+
+    fn write_installed_service_types(&self) -> Result<()> {
+        let mut output = format!(
+            "export type InstalledContractTypesVersion = {INSTALLED_CONTRACT_TYPES_VERSION};\nexport type InstalledHostRelease = '{OMD_HOST_RELEASE}';\nexport type InstalledModApi = '{MOD_API_VERSION}';\nexport type Json = null | boolean | number | string | Json[] | {{ [key: string]: Json }};\nexport interface InstalledModServices {{\n",
+        );
+        for (_, loaded) in self.active() {
+            for contract in &loaded.registrations.services {
+                output.push_str(&format!("  '{}@{}': {{\n", contract.name, contract.version));
+                for (name, method) in &contract.methods {
+                    output.push_str(&format!(
+                        "    {}(input: {}): {};\n",
+                        name,
+                        service_ts_type(&method.input),
+                        service_ts_type(&method.output)
+                    ));
+                }
+                output.push_str("  };\n");
+            }
+        }
+        output.push_str("}\n");
+        self.store
+            .write_bytes("installed-contracts.d.ts", output.as_bytes())?;
+        self.write_active_host_types()
+    }
+
+    fn write_active_host_types(&self) -> Result<()> {
+        let literal = |values: &[&str]| {
+            values
+                .iter()
+                .map(|value| format!("'{value}'"))
+                .collect::<Vec<_>>()
+                .join(" | ")
+        };
+        let events = MOD_EVENTS
+            .iter()
+            .map(|(event, _)| *event)
+            .collect::<Vec<_>>();
+        let output = format!(
+            "export type ActiveHostRelease = '{OMD_HOST_RELEASE}';\nexport type ActiveCodexRelease = '{CODEX_HOST_RELEASE}';\nexport type ActiveModApi = '{MOD_API_VERSION}';\nexport type ActivePackageSchema = {MOD_PACKAGE_SCHEMA_VERSION};\nexport type ActiveStateStorageSchema = {MOD_STATE_STORAGE_SCHEMA_VERSION};\nexport type ActiveCapability = {};\nexport type ActiveEvent = {};\nexport type ActiveReplacementPoint = {};\nexport type ActiveHostOperation = {};\n",
+            literal(MOD_CAPABILITIES),
+            literal(&events),
+            literal(MOD_REPLACEMENT_POINTS),
+            literal(MOD_HOST_OPERATIONS),
+        );
+        self.store
+            .write_bytes("active-host.d.ts", output.as_bytes())
+    }
+
+    pub fn field_policies() -> Value {
+        json!({
+            "model_request": {"request_id":"observe_only","scope":"observe_only","authorized_presets":"observe_only","original":"observe_only","effective":"alterable","provenance":"observe_only"},
+            "response_stream": {"kind":"observe_only","raw_sha256":"observe_only","raw_usage":"observe_only","opaque_reasoning":"observe_only","protected":"observe_only","text":"alterable","original":"observe_only","effective":"observe_only","provenance":"observe_only","fallback":"observe_only"},
+            "prompt": {"thread_id":"observe_only","turn_id":"observe_only","original":"observe_only","effective":"replaceable","provenance":"observe_only"},
+            "session": {"phase":"observe_only","thread_id":"observe_only","cause":"observe_only"},
+            "agent": {"phase":"observe_only","agent_id":"observe_only","parent_agent_id":"observe_only","role":"observe_only","status":"observe_only"},
+            "tool_call": {"call_id":"observe_only","agent_id":"observe_only","tool":"observe_only","arguments":"observe_only"},
+            "tool_before": {"call_id":"observe_only","tool":"replaceable","arguments":"replaceable","deny":"alterable"},
+            "tool_exposure": {"thread_id":"observe_only","checkpoint":"observe_only","available":"observe_only","enable":"alterable"},
+            "tool_result": {"call_id":"observe_only","agent_id":"observe_only","tool":"observe_only","outcome":"observe_only"},
+            "host_operation": {"phase":"observe_only","caller":"observe_only","operation":"observe_only","arguments":"observe_only","result":"observe_only","error":"observe_only"}
+        })
+    }
+
+    pub fn status(&self) -> Value {
+        json!({"api": MOD_API_VERSION, "host": {"codex":CODEX_HOST_RELEASE,"omd":OMD_HOST_RELEASE,
+            "package_schema":MOD_PACKAGE_SCHEMA_VERSION,"state_storage_schema":MOD_STATE_STORAGE_SCHEMA_VERSION,
+            "installed_contract_types":INSTALLED_CONTRACT_TYPES_VERSION,"features":MOD_HOST_FEATURES,
+            "supported_apis":SUPPORTED_MOD_APIS.iter().map(|(version,stability,support_until)|
+                json!({"version":version,"stability":stability,"support_until":support_until})).collect::<Vec<_>>()},
+            "generation": self.generation, "reload_error": self.reload_error,
+            "order": self.order, "rejected": self.rejected, "field_policies": Self::field_policies(),
+            "installed_contract_types": self.store.root.join("installed-contracts.d.ts"),
+            "active_host_types": self.store.root.join("active-host.d.ts"),
+            "service_calls": self.service_calls,
+            "mods": self.loaded.iter().map(|(id, m)| json!({"id": id, "version": m.package.version,
+                "api":m.package.api,"api_stability":api_support(&m.package.api).map(|support|support.0),
+                "entrypoint":m.package.entrypoint,"license":m.package.license,
+                "provenance":m.package.provenance,"dependencies":m.package.dependencies,
+                "settings_schema":m.package.settings_schema,"lifecycle":m.package.lifecycle.keys().collect::<Vec<_>>(),
+                "package_schema":m.package.schema,"state_version":m.package.state_version,
+                "host_compatibility":m.package.compatibility,
+                "negotiated_features":{"required":m.package.compatibility.required_features,
+                    "optional_available":m.package.compatibility.optional_features.iter().filter(|feature|MOD_HOST_FEATURES.contains(&feature.as_str())).collect::<Vec<_>>(),
+                    "optional_unavailable":m.package.compatibility.optional_features.iter().filter(|feature|!MOD_HOST_FEATURES.contains(&feature.as_str())).collect::<Vec<_>>()},
+                "sha256": m.selection.sha256, "capabilities": m.package.capabilities,
+                "scope": m.selection.scope, "requires": m.package.requires, "services": m.package.services,
+                "source_use":m.source_use,"unused_grants":m.unused_grants,
+                "unused_environment":m.unused_environment,"hook_budget_ms":m.package.hook_budget_ms,
+                "registrations": m.registrations, "telemetry":m.telemetry, "error": m.error})).collect::<Vec<_>>()})
+    }
+}
+
+fn service_ts_type(kind: &str) -> &'static str {
+    match kind {
+        "null" => "null",
+        "boolean" => "boolean",
+        "number" => "number",
+        "string" => "string",
+        "array" => "Json[]",
+        "object" => "Record<string, Json>",
+        _ => "Json",
+    }
+}
diff --git a/codex-rs/omd/src/mods/author.rs b/codex-rs/omd/src/mods/author.rs
new file mode 100644
index 0000000..25e860f
--- /dev/null
+++ b/codex-rs/omd/src/mods/author.rs
@@ -0,0 +1,477 @@
+use super::*;
+use std::collections::VecDeque;
+
+#[derive(Default)]
+struct OfflineHost {
+    replies: BTreeMap<String, VecDeque<Value>>,
+    calls: Vec<Value>,
+    now_ms: u64,
+}
+
+impl OfflineHost {
+    fn from_scenario(scenario: &Value, now_ms: u64) -> Result<Self> {
+        let mut host = Self {
+            now_ms,
+            ..Self::default()
+        };
+        let Some(operations) = scenario.get("host_operations") else {
+            return Ok(host);
+        };
+        let operations = operations
+            .as_object()
+            .ok_or_else(|| failure("offline_host_operations_must_be_an_object"))?;
+        for (operation, values) in operations {
+            if !MOD_HOST_OPERATIONS.contains(&operation.as_str()) {
+                return Err(failure(format!(
+                    "offline_unknown_host_operation: {operation}"
+                )));
+            }
+            let values = values
+                .as_array()
+                .cloned()
+                .unwrap_or_else(|| vec![values.clone()]);
+            host.replies
+                .insert(operation.clone(), VecDeque::from(values));
+        }
+        Ok(host)
+    }
+
+    fn call(&mut self, call: ModHostCall) -> Result<Value> {
+        self.calls
+            .push(json!({"at_ms":self.now_ms,"operation":call.operation,
+            "arguments":call.arguments}));
+        let response = self
+            .replies
+            .get_mut(&call.operation)
+            .and_then(VecDeque::pop_front)
+            .ok_or_else(|| {
+                failure(format!(
+                    "offline_unmocked_host_operation: {}; add a deterministic host_operations fixture",
+                    call.operation
+                ))
+            })?;
+        if let Some(error) = response.get("error").and_then(Value::as_str) {
+            return Err(failure(error));
+        }
+        Ok(response.get("result").cloned().unwrap_or(response))
+    }
+}
+
+impl ModHost {
+    pub fn author_inspection(&self) -> Value {
+        json!({
+            "api":MOD_API_VERSION,
+            "generation":self.generation,
+            "precedence":"dependencies first, then lexical mod ID; project scope shadows user scope; exclusive replacements fail closed on conflict",
+            "order":self.order,
+            "events":self.loaded.iter().map(|(id, loaded)| json!({
+                "id":id,
+                "scope":loaded.selection.scope,
+                "requires":loaded.package.requires,
+                "events":loaded.registrations.events,
+                "replacements":loaded.registrations.replacements,
+                "error":loaded.error,
+            })).collect::<Vec<_>>(),
+            "rejected":self.rejected,
+        })
+    }
+
+    pub fn capability_explanation(code: &str) -> Value {
+        let (cause, fix) = if code.starts_with("capability_denied") {
+            (
+                "The package requested authority that the manifest or explicit trust grant does not include.",
+                "Declare the exact capability in mod.json, inspect the source-use report, then have the user approve the new digest and exact grant.",
+            )
+        } else if code.starts_with("undeclared_operation_use") {
+            (
+                "Source analysis found a literal host operation whose capability is not declared.",
+                "Add the operation's documented capability or remove the call; rerun check before asking for trust.",
+            )
+        } else if code.starts_with("undeclared_service_use") {
+            (
+                "Source analysis found a service call without a matching manifest import.",
+                "Declare the service name and compatible version under services.imports or remove the call.",
+            )
+        } else if code.starts_with("undeclared_environment_use") {
+            (
+                "Source analysis found environment access outside the manifest declaration.",
+                "Remove the access or declare an admitted environment feature; network, filesystem, process and DOM access are intentionally unavailable.",
+            )
+        } else if code.starts_with("state_capability_denied") {
+            (
+                "The callback changed persistent state without the state capability.",
+                "Declare state or keep the callback stateless, then re-inspect and re-approve the source digest.",
+            )
+        } else if code.starts_with("host_operation_unavailable") {
+            (
+                "The callback ran without an active native task capable of servicing that host operation.",
+                "Run it inside a task/tool callback or supply an explicit offline host-operation mock in tests.",
+            )
+        } else {
+            (
+                "The host denied or could not classify the requested authority.",
+                "Use omd-mod report and omd-mod events, then compare the literal operation, manifest declaration and user-approved grant.",
+            )
+        };
+        json!({"code":code,"cause":cause,"fix":fix,
+            "guarantee":"Author tooling can explain a denial but cannot grant authority, change trust, or bypass host enforcement."})
+    }
+
+    pub fn diagnostic_bundle(&self) -> Value {
+        let mut bundle = json!({
+            "schema":1,
+            "host":{"codex":CODEX_HOST_RELEASE,"omd":OMD_HOST_RELEASE,"api":MOD_API_VERSION},
+            "configuration_sha256":self.configuration_sha256,
+            "status":self.status(),
+            "inspection":self.author_inspection(),
+            "redaction":{"paths":true,"settings":true,"environment":true,"credentials":true},
+        });
+        let mut paths = vec![(self.store.root.display().to_string(), "$STORE".to_owned())];
+        paths.extend(self.loaded.iter().map(|(id, loaded)| {
+            (
+                loaded.selection.path.display().to_string(),
+                format!("$MOD/{id}"),
+            )
+        }));
+        redact_value(&mut bundle, None, &paths);
+        bundle
+    }
+
+    pub fn offline_test(&mut self, scenario: Value) -> Result<Value> {
+        if scenario.get("schema").and_then(Value::as_u64) != Some(1) {
+            return Err(failure("offline_scenario_schema_1_required"));
+        }
+        let mut now_ms = scenario
+            .get("virtual_time_ms")
+            .and_then(Value::as_u64)
+            .unwrap_or(0);
+        let mut host = OfflineHost::from_scenario(&scenario, now_ms)?;
+        let steps = scenario
+            .get("steps")
+            .and_then(Value::as_array)
+            .ok_or_else(|| failure("offline_steps_required"))?;
+        if steps.len() > 256 {
+            return Err(failure("offline_step_limit"));
+        }
+        let mut outputs = Vec::new();
+        for (index, step) in steps.iter().enumerate() {
+            let kind = step
+                .get("type")
+                .and_then(Value::as_str)
+                .ok_or_else(|| failure("offline_step_type_required"))?;
+            let cancelled = step
+                .get("cancelled")
+                .and_then(Value::as_bool)
+                .unwrap_or(false);
+            self.virtual_time_ms = Some(now_ms);
+            host.now_ms = now_ms;
+            let result = self.offline_step(kind, step, !cancelled, &mut host, &mut now_ms);
+            let output = match result {
+                Ok(value) => {
+                    if let Some(expected) = step.get("expect")
+                        && &value != expected
+                    {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_expectation_failed at step {index}: expected {expected}, got {value}"
+                        )));
+                    }
+                    if step.get("expect_error").is_some() {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_expected_error_missing at step {index}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":now_ms,"value":value})
+                }
+                Err(error) => {
+                    let text = error.to_string();
+                    let Some(expected) = step.get("expect_error").and_then(Value::as_str) else {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_step_failed at step {index}: {text}"
+                        )));
+                    };
+                    if !text.contains(expected) {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_error_mismatch at step {index}: expected {expected}, got {text}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":now_ms,"error":text})
+                }
+            };
+            outputs.push(output);
+        }
+        self.virtual_time_ms = None;
+        let remaining = host
+            .replies
+            .iter()
+            .filter(|(_, replies)| !replies.is_empty())
+            .map(|(operation, replies)| json!({"operation":operation,"remaining":replies.len()}))
+            .collect::<Vec<_>>();
+        Ok(
+            json!({"schema":1,"offline":true,"paid_requests":0,"virtual_time_ms":now_ms,
+            "steps":outputs,"host_calls":host.calls,"unused_mock_replies":remaining,
+            "status":self.status()}),
+        )
+    }
+
+    fn offline_step(
+        &mut self,
+        kind: &str,
+        step: &Value,
+        active: bool,
+        host: &mut OfflineHost,
+        now_ms: &mut u64,
+    ) -> Result<Value> {
+        let payload = step.get("payload").cloned().unwrap_or(Value::Null);
+        match kind {
+            "advance_time" => {
+                let delta = step
+                    .get("ms")
+                    .and_then(Value::as_u64)
+                    .ok_or_else(|| failure("offline_advance_ms_required"))?;
+                *now_ms = now_ms
+                    .checked_add(delta)
+                    .ok_or_else(|| failure("offline_virtual_time_overflow"))?;
+                Ok(json!({"now_ms":now_ms}))
+            }
+            "status" => Ok(self.status()),
+            "reload" => {
+                self.store.reload()?;
+                self.turn_boundary();
+                if let Some(error) = &self.reload_error {
+                    return Err(failure(error));
+                }
+                Ok(json!({"generation":self.generation,"reload_error":self.reload_error}))
+            }
+            "model_request" => self.model_request(payload, || active),
+            "tool_exposure" => {
+                let thread_id = step
+                    .get("thread_id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned);
+                let tools = self.tools_for_step(thread_id, payload, || active);
+                Ok(json!(
+                    tools
+                        .into_iter()
+                        .map(|(id, _, tool)| format!("mod_{id}_{}", tool.name))
+                        .collect::<Vec<_>>()
+                ))
+            }
+            "response_stream" => self.response_stream(payload, || active),
+            "event" | "tool_outcome" | "agent" => {
+                let event = match kind {
+                    "tool_outcome" => "tool_result",
+                    "agent" => "agent",
+                    _ => step
+                        .get("event")
+                        .and_then(Value::as_str)
+                        .ok_or_else(|| failure("offline_event_name_required"))?,
+                };
+                let ids = self.event_ids(event);
+                let mut values = Vec::new();
+                for id in ids {
+                    let generation = self.generation;
+                    let value = self.invoke_with(
+                        &id,
+                        generation,
+                        event,
+                        "",
+                        payload.clone(),
+                        || active,
+                        |call| host.call(call),
+                    )?;
+                    values.push(json!({"mod":id,"value":value}));
+                }
+                Ok(Value::Array(values))
+            }
+            "invoke" => {
+                let id = required_string(step, "mod")?;
+                let event = required_string(step, "event")?;
+                let name = required_string(step, "name")?;
+                self.invoke_with(
+                    id,
+                    self.generation,
+                    event,
+                    name,
+                    payload,
+                    || active,
+                    |call| host.call(call),
+                )
+            }
+            "terminal_mount" | "terminal_interact" => {
+                let id = required_string(step, "mod")?;
+                let view = self.invoke_with(
+                    id,
+                    self.generation,
+                    "terminal",
+                    "",
+                    payload,
+                    || active,
+                    |call| host.call(call),
+                )?;
+                let parsed = ModView::parse(view.clone())?;
+                if kind == "terminal_mount" {
+                    return Ok(view);
+                }
+                let action = if let Some(component) = step.get("component").and_then(Value::as_str)
+                {
+                    terminal_component_action(
+                        &parsed,
+                        component,
+                        step.get("value").and_then(Value::as_str),
+                    )?
+                } else {
+                    let key = required_string(step, "key")?;
+                    serde_json::to_value(
+                        parsed
+                            .keybindings
+                            .get(key)
+                            .ok_or_else(|| failure("offline_terminal_key_not_mounted"))?,
+                    )?
+                };
+                if let Some(command) = action.get("command").and_then(Value::as_str) {
+                    let (owner, name) = command.split_once(':').unwrap_or((id, command));
+                    let args = action.get("args").cloned().unwrap_or_else(|| json!(""));
+                    let result = self.invoke_with(
+                        owner,
+                        self.generation,
+                        "command",
+                        name,
+                        args,
+                        || active,
+                        |call| host.call(call),
+                    )?;
+                    Ok(json!({"action":action,"result":result}))
+                } else {
+                    Ok(json!({"action":action}))
+                }
+            }
+            _ => Err(failure(format!("offline_unknown_step_type: {kind}"))),
+        }
+    }
+}
+
+fn required_string<'a>(value: &'a Value, key: &str) -> Result<&'a str> {
+    value
+        .get(key)
+        .and_then(Value::as_str)
+        .ok_or_else(|| failure(format!("offline_{key}_required")))
+}
+
+fn terminal_component<'a>(components: &'a [ModComponent], id: &str) -> Option<&'a ModComponent> {
+    components.iter().find_map(|component| {
+        let (component_id, children) = match component {
+            ModComponent::Box { id, children, .. }
+            | ModComponent::Pane { id, children, .. }
+            | ModComponent::Dialog { id, children, .. } => (Some(id.as_str()), children.as_slice()),
+            ModComponent::Text { id, .. }
+            | ModComponent::Button { id, .. }
+            | ModComponent::Input { id, .. }
+            | ModComponent::Select { id, .. }
+            | ModComponent::Markdown { id, .. }
+            | ModComponent::Code { id, .. } => (Some(id.as_str()), &[][..]),
+            ModComponent::Slot => (None, &[][..]),
+        };
+        if component_id == Some(id) {
+            Some(component)
+        } else {
+            terminal_component(children, id)
+        }
+    })
+}
+
+fn terminal_component_action(view: &ModView, id: &str, value: Option<&str>) -> Result<Value> {
+    let component = view
+        .sites
+        .values()
+        .find_map(|site| terminal_component(&site.components, id))
+        .ok_or_else(|| failure("offline_terminal_component_not_mounted"))?;
+    let command = |action: &ModCommandAction, value: Option<&str>| {
+        let args = match value {
+            Some(value) if action.args.is_empty() => value.to_owned(),
+            Some(value) => format!("{} {value}", action.args),
+            None => action.args.clone(),
+        };
+        serde_json::to_value(ModKeyAction::Command {
+            command: action.command.clone(),
+            args,
+        })
+        .map_err(failure)
+    };
+    match component {
+        ModComponent::Button { action, .. } => serde_json::to_value(action).map_err(failure),
+        ModComponent::Input {
+            action,
+            value: current,
+            ..
+        } => command(action, value.or(Some(current))),
+        ModComponent::Select {
+            action,
+            value: current,
+            options,
+            ..
+        } => {
+            let selected = value.unwrap_or(current);
+            if !options.iter().any(|option| option.value == selected) {
+                return Err(failure("offline_terminal_select_value_not_mounted"));
+            }
+            command(action, Some(selected))
+        }
+        _ => Err(failure("offline_terminal_component_not_interactive")),
+    }
+}
+
+fn redact_value(value: &mut Value, key: Option<&str>, paths: &[(String, String)]) {
+    let sensitive = key.is_some_and(|key| {
+        let key = key.to_ascii_lowercase();
+        ["secret", "token", "password", "credential", "api_key"]
+            .iter()
+            .any(|needle| key.contains(needle))
+    });
+    if sensitive && !value.is_boolean() {
+        *value = Value::String("[REDACTED]".to_owned());
+        return;
+    }
+    match value {
+        Value::String(text) => {
+            for (path, replacement) in paths {
+                *text = text.replace(path, replacement);
+            }
+            *text = redact_text(text);
+        }
+        Value::Array(values) => {
+            for value in values {
+                redact_value(value, None, paths);
+            }
+        }
+        Value::Object(object) => {
+            for (key, value) in object {
+                redact_value(value, Some(key), paths);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn redact_text(text: &str) -> String {
+    let mut output = text.to_owned();
+    for prefix in ["sk-", "ghp_", "github_pat_", "Bearer "] {
+        while let Some(start) = output.find(prefix) {
+            let tail = &output[start + prefix.len()..];
+            let length = tail
+                .find(|character: char| {
+                    character.is_whitespace()
+                        || matches!(character, '\'' | '"' | ',' | ']' | '}' | ')')
+                })
+                .unwrap_or(tail.len());
+            if length == 0 {
+                break;
+            }
+            output.replace_range(start..start + prefix.len() + length, "[REDACTED]");
+        }
+    }
+    output
+}
diff --git a/codex-rs/omd/src/mods/bridge.rs b/codex-rs/omd/src/mods/bridge.rs
new file mode 100644
index 0000000..5da08c4
--- /dev/null
+++ b/codex-rs/omd/src/mods/bridge.rs
@@ -0,0 +1,127 @@
+use super::*;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModHostCall {
+    pub operation: String,
+    pub arguments: Value,
+}
+
+impl ModHostCall {
+    pub fn capability(&self) -> Result<&'static str> {
+        match self.operation.as_str() {
+            "task.status" | "routes.list" | "checkpoint.read" | "checkpoint.update" => Ok("task"),
+            "agents.spawn" | "agents.message" | "agents.cancel" | "agents.result"
+            | "agents.wait" | "agents.list" => Ok("agents"),
+            "review.run" | "review.complete" => Ok("review"),
+            "recovery.escalate" | "delegation.contribute" => Ok("recovery"),
+            "tools.exec" => Ok("execution"),
+            "providers.register" | "providers.unregister" => Ok("providers"),
+            "pi.discover" | "pi.expand" => Ok("pi_resources"),
+            "sidecars.start" | "sidecars.stop" | "sidecars.status" => Ok("sidecars"),
+            "workflow.status" | "workflow.restrict" => Ok("workflow"),
+            "mods.service" => Ok("services"),
+            _ => Err(failure(format!(
+                "unsupported_host_operation: {}",
+                self.operation
+            ))),
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn run(
+    node: &Path,
+    loaded: &Loaded,
+    event: &str,
+    name: &str,
+    payload: Value,
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(ModHostCall) -> Result<Value>,
+    progress: &mut dyn FnMut(String),
+    virtual_time_ms: Option<u64>,
+) -> Result<Reply> {
+    let mut receipts = Vec::new();
+    let mut expected = Vec::new();
+    let mut execution = Duration::ZERO;
+    let mut forwarded = 0;
+    loop {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        let request = json!({"source": loaded.source, "filename": loaded.selection.path.join("index.ts"),
+            "api": MOD_API_VERSION,
+            "capabilities": loaded.package.capabilities, "adapter": loaded.package.adapter, "settings": loaded.selection.settings,
+            "state": loaded.state, "event": event, "name": name, "payload": payload, "receipts": receipts,
+            "hook_budget_ms": loaded.package.hook_budget_ms,"environment":loaded.package.environment});
+        let mut request = request;
+        request["field_policies"] = ModHost::field_policies();
+        request["virtual_time_ms"] = virtual_time_ms.map_or(Value::Null, Value::from);
+        let started = Instant::now();
+        let budget = Duration::from_millis(loaded.package.hook_budget_ms);
+        let reply: Reply =
+            serde_json::from_value(process::evaluate(node, &request, budget, active)?)?;
+        if event != "inspect" && reply.registrations != loaded.registrations {
+            return Err(failure("registration_changed_during_callback"));
+        }
+        execution += started.elapsed();
+        // `hook_budget_ms` bounds each evaluation, which `process::evaluate` already enforces.
+        // Replaying host calls re-runs the module, so the whole callback carries its own total.
+        if execution > Duration::from_millis(MOD_CALLBACK_TOTAL_BUDGET_MS) {
+            return Err(failure("callback_execution_budget"));
+        }
+        if !reply.calls.starts_with(&expected) {
+            return Err(failure("host_call_replay_diverged"));
+        }
+        if reply.updates.len() > 32
+            || reply
+                .updates
+                .iter()
+                .any(|update| update.is_empty() || update.len() > 1024)
+        {
+            return Err(failure("invalid_progress"));
+        }
+        if event == "tool" {
+            for update in reply.updates.iter().skip(forwarded) {
+                progress(update.clone());
+            }
+            forwarded = forwarded.max(reply.updates.len());
+        }
+        let Some(call) = &reply.host_call else {
+            if reply.calls != expected {
+                return Err(failure("invalid_host_call_receipts"));
+            }
+            return Ok(reply);
+        };
+        if event == "inspect"
+            || reply.calls.len() != expected.len() + 1
+            || reply.calls.last() != Some(call)
+        {
+            return Err(failure("invalid_host_call_sequence"));
+        }
+        if expected.len() >= 32 {
+            return Err(failure("host_call_limit"));
+        }
+        let capability = call.capability()?;
+        if !loaded.package.capabilities.iter().any(|c| c == capability) {
+            return Err(failure(format!("capability_denied: {capability}")));
+        }
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        let result = host(call.clone());
+        let receipt = match result {
+            Ok(value) => json!({"call": call, "value": value}),
+            Err(error) => {
+                json!({"call": call, "error": error.to_string().chars().take(768).collect::<String>()})
+            }
+        };
+        expected.push(call.clone());
+        receipts.push(receipt);
+        if serde_json::to_vec(&receipts)?.len() > 131_072 {
+            return Err(failure("host_receipt_limit"));
+        }
+    }
+}
diff --git a/codex-rs/omd/src/mods/outcome.rs b/codex-rs/omd/src/mods/outcome.rs
new file mode 100644
index 0000000..1a7b669
--- /dev/null
+++ b/codex-rs/omd/src/mods/outcome.rs
@@ -0,0 +1,108 @@
+use super::*;
+
+const TEXT_LIMIT: usize = 16_384;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ModCommandOutcome {
+    pub display: Option<String>,
+    pub insert: Option<String>,
+    pub submit: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ModInputDecision {
+    Keep,
+    Rewrite(String),
+    Deny(String),
+}
+
+fn text(value: &Value, limit: usize) -> Result<String> {
+    let text = value
+        .as_str()
+        .ok_or_else(|| failure("invalid_outcome_text"))?;
+    if text.is_empty()
+        || text.len() > limit
+        || text
+            .chars()
+            .any(|c| c.is_control() && c != '\n' && c != '\t')
+    {
+        return Err(failure("invalid_outcome_text"));
+    }
+    Ok(text.to_owned())
+}
+
+fn truncated(mut text: String) -> String {
+    if text.len() > TEXT_LIMIT {
+        let mut end = TEXT_LIMIT;
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        text.truncate(end);
+    }
+    text.chars()
+        .filter(|c| !c.is_control() || *c == '\n' || *c == '\t')
+        .collect()
+}
+
+impl ModCommandOutcome {
+    pub fn parse(value: &Value) -> Result<Self> {
+        match value {
+            Value::Null => Ok(Self::default()),
+            Value::String(display) => Ok(Self {
+                display: Some(truncated(display.clone())).filter(|s| !s.is_empty()),
+                ..Self::default()
+            }),
+            Value::Object(object)
+                if !object.is_empty()
+                    && object
+                        .keys()
+                        .all(|key| ["display", "insert", "submit"].contains(&key.as_str())) =>
+            {
+                let outcome = Self {
+                    display: object
+                        .get("display")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    insert: object
+                        .get("insert")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    submit: object
+                        .get("submit")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                };
+                if outcome.insert.is_some() && outcome.submit.is_some() {
+                    return Err(failure("command_outcome_conflict: insert or submit"));
+                }
+                Ok(outcome)
+            }
+            other => Ok(Self {
+                display: Some(truncated(serde_json::to_string_pretty(other)?)),
+                ..Self::default()
+            }),
+        }
+    }
+}
+
+impl ModInputDecision {
+    pub fn parse(value: &Value) -> Result<Self> {
+        let Some(object) = value.as_object() else {
+            return if value.is_null() {
+                Ok(Self::Keep)
+            } else {
+                Err(failure("invalid_input_decision"))
+            };
+        };
+        match object
+            .keys()
+            .map(String::as_str)
+            .collect::<Vec<_>>()
+            .as_slice()
+        {
+            ["text"] => Ok(Self::Rewrite(text(&object["text"], 61_440)?)),
+            ["deny"] => Ok(Self::Deny(text(&object["deny"], 512)?)),
+            _ => Err(failure("invalid_input_decision")),
+        }
+    }
+}
diff --git a/codex-rs/omd/src/mods/package_manager.rs b/codex-rs/omd/src/mods/package_manager.rs
new file mode 100644
index 0000000..14bec99
--- /dev/null
+++ b/codex-rs/omd/src/mods/package_manager.rs
@@ -0,0 +1,1143 @@
+use super::*;
+use serde_json::Map;
+use std::process::Command;
+
+const PACKAGE_LOCK_SCHEMA: u32 = 1;
+const PACKAGE_HISTORY_LIMIT: usize = 8;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ModPackageSource {
+    Local {
+        path: PathBuf,
+    },
+    Repository {
+        repository: String,
+        revision: String,
+        #[serde(default)]
+        subdirectory: String,
+    },
+    Package {
+        index: PathBuf,
+        id: String,
+        version: String,
+    },
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModPackageGrant {
+    pub capabilities: Vec<String>,
+    #[serde(default)]
+    pub dependencies: bool,
+    #[serde(default)]
+    pub lifecycle: Vec<String>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModPackageTrust {
+    pub packages: BTreeMap<String, ModPackageGrant>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModInstallRequest {
+    pub source: ModPackageSource,
+    #[serde(default)]
+    pub index: Option<PathBuf>,
+    #[serde(default = "user_scope")]
+    pub scope: String,
+    #[serde(default)]
+    pub activate: bool,
+    #[serde(default)]
+    pub offline: bool,
+    #[serde(default)]
+    pub trust: ModPackageTrust,
+    #[serde(default)]
+    pub settings: BTreeMap<String, BTreeMap<String, Value>>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModLockedPackage {
+    pub id: String,
+    pub version: String,
+    pub integrity: String,
+    pub source: ModPackageSource,
+    pub path: PathBuf,
+    pub cache_path: PathBuf,
+    pub license: String,
+    pub provenance: ModProvenance,
+    pub entrypoint: String,
+    pub api: String,
+    pub state_version: u32,
+    pub dependencies: Vec<ModDependency>,
+    pub capabilities: Vec<String>,
+    pub settings_schema_sha256: String,
+    pub lifecycle: Vec<String>,
+    pub scope: String,
+    pub enabled: bool,
+    pub settings: BTreeMap<String, Value>,
+    pub trust: ModPackageGrant,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModPackageLock {
+    pub schema: u32,
+    pub revision: u64,
+    pub packages: BTreeMap<String, ModLockedPackage>,
+    #[serde(default)]
+    pub history: BTreeMap<String, Vec<ModLockedPackage>>,
+}
+
+impl Default for ModPackageLock {
+    fn default() -> Self {
+        Self {
+            schema: PACKAGE_LOCK_SCHEMA,
+            revision: 0,
+            packages: BTreeMap::new(),
+            history: BTreeMap::new(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModPackagePlan {
+    pub schema: u32,
+    pub action: String,
+    pub root: String,
+    pub packages: Vec<ModLockedPackage>,
+    pub changes: Value,
+    pub confirmation: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PackageIndex {
+    schema: u32,
+    packages: BTreeMap<String, Vec<IndexRelease>>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct IndexRelease {
+    version: String,
+    source: ModPackageSource,
+    integrity: String,
+}
+
+#[derive(Clone)]
+struct ResolvedPackage {
+    locked: ModLockedPackage,
+    package: ModPackage,
+}
+
+impl ModStore {
+    pub fn package_lock(&self) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        self.read_package_lock()
+    }
+
+    pub(super) fn read_package_lock(&self) -> Result<ModPackageLock> {
+        match store::read(&self.root.join("packages.lock.json"), 524_288) {
+            Ok(bytes) => {
+                let lock: ModPackageLock = serde_json::from_slice(&bytes)?;
+                if lock.schema != PACKAGE_LOCK_SCHEMA {
+                    return Err(failure("unsupported_package_lock_schema"));
+                }
+                validate_package_lock(&lock)?;
+                Ok(lock)
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(ModPackageLock::default()),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub fn package_plan(&self, request: ModInstallRequest) -> Result<ModPackagePlan> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        self.package_plan_locked(request)
+    }
+
+    fn package_plan_locked(&self, request: ModInstallRequest) -> Result<ModPackagePlan> {
+        if !MOD_SCOPES.contains(&request.scope.as_str()) {
+            return Err(failure("unsupported_scope: user or project"));
+        }
+        let existing = self.read_package_lock()?;
+        let mut resolved = BTreeMap::new();
+        let mut visiting = Vec::new();
+        let root = self.resolve_requested(
+            &request.source,
+            None,
+            &request,
+            &mut resolved,
+            &mut visiting,
+        )?;
+        let root_id = root.package.id.clone();
+        resolved.insert(root_id.clone(), root);
+        let mut packages = resolved
+            .into_values()
+            .map(|mut resolved| {
+                let previous = existing.packages.get(&resolved.package.id);
+                let settings = request
+                    .settings
+                    .get(&resolved.package.id)
+                    .cloned()
+                    .or_else(|| previous.map(|locked| locked.settings.clone()))
+                    .unwrap_or_default();
+                validate_settings(&resolved.package, &settings)?;
+                resolved.locked.settings = settings;
+                let state_migration_required = previous.is_some_and(|locked| {
+                    locked.state_version != resolved.package.state_version
+                        && self
+                            .root
+                            .join(ModStore::state_name(&resolved.package.id, &request.scope))
+                            .exists()
+                });
+                resolved.locked.enabled = request.activate && !state_migration_required;
+                Ok(resolved.locked)
+            })
+            .collect::<Result<Vec<_>>>()?;
+        packages.sort_by(|a, b| a.id.cmp(&b.id));
+        let action = if existing.packages.contains_key(&root_id) {
+            "update"
+        } else {
+            "install"
+        };
+        let changes = package_changes(&existing, &packages);
+        let mut plan = ModPackagePlan {
+            schema: PACKAGE_LOCK_SCHEMA,
+            action: action.to_owned(),
+            root: root_id,
+            packages,
+            changes,
+            confirmation: String::new(),
+        };
+        plan.confirmation = digest(&serde_json::to_vec(&plan)?);
+        Ok(plan)
+    }
+
+    pub fn package_apply(
+        &self,
+        request: ModInstallRequest,
+        confirmation: &str,
+    ) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        let plan = self.package_plan_locked(request)?;
+        if plan.confirmation != confirmation {
+            return Err(failure("package_plan_changed: preview again"));
+        }
+        let mut lock = self.read_package_lock()?;
+        let mut config = self.configuration()?;
+        let old_lock = serde_json::to_value(&lock)?;
+        let old_config = serde_json::to_value(&config)?;
+        let mut lifecycle = Vec::new();
+        for package in &plan.packages {
+            match lock.packages.get(&package.id) {
+                None => lifecycle.push((package.clone(), "install")),
+                Some(previous) if previous.integrity != package.integrity => {
+                    lifecycle.push((package.clone(), "update"))
+                }
+                Some(_) => {}
+            }
+            if let Some(previous) = lock.packages.insert(package.id.clone(), package.clone())
+                && previous.integrity != package.integrity
+            {
+                push_history(&mut lock, &package.id, previous)?;
+            }
+            let selection = config.mods.iter_mut().find(|selection| {
+                selection.scope == package.scope
+                    && store::package(&selection.path)
+                        .is_ok_and(|(manifest, _, _)| manifest.id == package.id)
+            });
+            let next = ModSelection {
+                path: package.path.clone(),
+                sha256: package.integrity.clone(),
+                enabled: package.enabled,
+                capabilities: package.trust.capabilities.clone(),
+                settings: package.settings.clone(),
+                scope: package.scope.clone(),
+            };
+            if let Some(selection) = selection {
+                *selection = next;
+            } else {
+                config.mods.push(next);
+            }
+        }
+        validate_locked_graph(&lock.packages)?;
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        lock.revision = lock
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.write(
+            "package-transaction.json",
+            &json!({"old_lock":old_lock,"old_config":old_config}),
+        )?;
+        let result = (|| {
+            for (package, event) in &lifecycle {
+                self.run_lifecycle(package, event)?;
+            }
+            self.write("mods.json", &serde_json::to_value(&config)?)?;
+            self.write("packages.lock.json", &serde_json::to_value(&lock)?)?;
+            std::fs::remove_file(self.root.join("package-transaction.json"))?;
+            std::fs::File::open(&self.root)?.sync_all()?;
+            Ok(lock)
+        })();
+        if result.is_err() {
+            self.recover_package_transaction()?;
+        }
+        result
+    }
+
+    pub fn package_uninstall_plan(&self, id: &str) -> Result<ModPackagePlan> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        self.package_uninstall_plan_locked(id)
+    }
+
+    fn package_uninstall_plan_locked(&self, id: &str) -> Result<ModPackagePlan> {
+        let lock = self.read_package_lock()?;
+        let package = lock
+            .packages
+            .get(id)
+            .cloned()
+            .ok_or_else(|| failure("package_not_installed"))?;
+        if lock.packages.values().any(|candidate| {
+            candidate.id != id
+                && candidate
+                    .dependencies
+                    .iter()
+                    .any(|dependency| dependency.id == id)
+        }) {
+            return Err(failure("package_has_installed_dependents"));
+        }
+        let mut plan = ModPackagePlan {
+            schema: PACKAGE_LOCK_SCHEMA,
+            action: "uninstall".into(),
+            root: id.to_owned(),
+            packages: vec![package.clone()],
+            changes: json!({"removed":[{"id":id,"version":package.version,"integrity":package.integrity}],
+                "cache_retained_for_offline_reuse":true,"state_retained":true,"local_source_untouched":true}),
+            confirmation: String::new(),
+        };
+        plan.confirmation = digest(&serde_json::to_vec(&plan)?);
+        Ok(plan)
+    }
+
+    pub fn package_disable(&self, id: &str) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut lock = self.read_package_lock()?;
+        let package = lock
+            .packages
+            .get_mut(id)
+            .ok_or_else(|| failure("package_not_installed"))?;
+        package.enabled = false;
+        let path = package.path.clone();
+        let scope = package.scope.clone();
+        lock.revision = lock
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|selection| selection.path == path && selection.scope == scope)
+            .ok_or_else(|| failure("package_selection_missing"))?;
+        selection.enabled = false;
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.commit_package_transaction(lock, config)
+    }
+
+    pub fn package_enable(&self, id: &str) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut lock = self.read_package_lock()?;
+        let package = lock
+            .packages
+            .get_mut(id)
+            .ok_or_else(|| failure("package_not_installed"))?;
+        let (manifest, _, integrity) = store::package(&package.path)?;
+        if integrity != package.integrity || manifest.id != package.id {
+            return Err(failure(
+                "source_changed: inspect and preview the new package",
+            ));
+        }
+        if package.state_version != manifest.state_version {
+            return Err(failure(
+                "state_migration_required: previous state preserved",
+            ));
+        }
+        self.state(&package.id, &package.scope, package.state_version)?;
+        package.enabled = true;
+        let path = package.path.clone();
+        let scope = package.scope.clone();
+        lock.revision = lock
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        validate_locked_graph(&lock.packages)?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|selection| selection.path == path && selection.scope == scope)
+            .ok_or_else(|| failure("package_selection_missing"))?;
+        if selection.sha256 != integrity {
+            return Err(failure("source_changed: inspect and trust the new digest"));
+        }
+        if manifest
+            .capabilities
+            .iter()
+            .any(|capability| !selection.capabilities.contains(capability))
+        {
+            return Err(failure("capability_denied"));
+        }
+        super::validate_settings(&manifest, &selection.settings)?;
+        selection.enabled = true;
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.commit_package_transaction(lock, config)
+    }
+
+    pub fn package_uninstall(&self, id: &str, confirmation: &str) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        let plan = self.package_uninstall_plan_locked(id)?;
+        if plan.confirmation != confirmation {
+            return Err(failure("package_plan_changed: preview again"));
+        }
+        let mut lock = self.read_package_lock()?;
+        let package = lock
+            .packages
+            .remove(id)
+            .ok_or_else(|| failure("package_not_installed"))?;
+        self.run_lifecycle(&package, "uninstall")?;
+        push_history(&mut lock, id, package.clone())?;
+        lock.revision = lock
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        let mut config = self.configuration()?;
+        config.mods.retain(|selection| {
+            !(selection.scope == package.scope
+                && store::package(&selection.path).is_ok_and(|(manifest, _, _)| manifest.id == id))
+        });
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.commit_package_transaction(lock, config)
+    }
+
+    pub fn package_rollback_plan(&self, id: &str) -> Result<ModPackagePlan> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        self.package_rollback_plan_locked(id)
+    }
+
+    fn package_rollback_plan_locked(&self, id: &str) -> Result<ModPackagePlan> {
+        let lock = self.read_package_lock()?;
+        let current = lock
+            .packages
+            .get(id)
+            .ok_or_else(|| failure("package_not_installed"))?;
+        let previous = lock
+            .history
+            .get(id)
+            .and_then(|history| history.last())
+            .cloned()
+            .ok_or_else(|| failure("package_rollback_unavailable"))?;
+        let mut plan = ModPackagePlan {
+            schema: PACKAGE_LOCK_SCHEMA,
+            action: "rollback".into(),
+            root: id.to_owned(),
+            packages: vec![previous.clone()],
+            changes: json!({"version":{"from":current.version,"to":previous.version},
+                "integrity":{"from":current.integrity,"to":previous.integrity},
+                "capabilities":{"from":current.capabilities,"to":previous.capabilities},
+                "dependencies":{"from":current.dependencies,"to":previous.dependencies},
+                "settings_preserved":current.settings}),
+            confirmation: String::new(),
+        };
+        plan.confirmation = digest(&serde_json::to_vec(&plan)?);
+        Ok(plan)
+    }
+
+    pub fn package_rollback(&self, id: &str, confirmation: &str) -> Result<ModPackageLock> {
+        let _guard = self.lock()?;
+        self.recover_package_transaction()?;
+        let plan = self.package_rollback_plan_locked(id)?;
+        if plan.confirmation != confirmation {
+            return Err(failure("package_plan_changed: preview again"));
+        }
+        let mut lock = self.read_package_lock()?;
+        let mut previous = plan.packages[0].clone();
+        if store::package(&previous.cache_path)?.2 != previous.integrity {
+            return Err(failure("cached_package_integrity_failure"));
+        }
+        let current = lock
+            .packages
+            .remove(id)
+            .ok_or_else(|| failure("package_not_installed"))?;
+        let current_path = current.path.clone();
+        previous.path = previous.cache_path.clone();
+        previous.settings = current.settings.clone();
+        previous.enabled = false;
+        validate_settings(&store::package(&previous.path)?.0, &previous.settings)?;
+        let history = lock.history.entry(id.to_owned()).or_default();
+        history.pop();
+        history.push(current);
+        lock.packages.insert(id.to_owned(), previous.clone());
+        validate_locked_graph(&lock.packages)?;
+        lock.revision = lock
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|selection| selection.scope == previous.scope && selection.path == current_path)
+            .ok_or_else(|| failure("package_selection_missing"))?;
+        *selection = ModSelection {
+            path: previous.path,
+            sha256: previous.integrity,
+            enabled: false,
+            capabilities: previous.trust.capabilities,
+            settings: previous.settings,
+            scope: previous.scope,
+        };
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.commit_package_transaction(lock, config)
+    }
+
+    fn commit_package_transaction(
+        &self,
+        lock: ModPackageLock,
+        config: ModConfiguration,
+    ) -> Result<ModPackageLock> {
+        let old_lock = serde_json::to_value(self.read_package_lock()?)?;
+        let old_config = serde_json::to_value(self.configuration()?)?;
+        self.write(
+            "package-transaction.json",
+            &json!({"old_lock":old_lock,"old_config":old_config}),
+        )?;
+        let result = (|| {
+            self.write("mods.json", &serde_json::to_value(&config)?)?;
+            self.write("packages.lock.json", &serde_json::to_value(&lock)?)?;
+            std::fs::remove_file(self.root.join("package-transaction.json"))?;
+            std::fs::File::open(&self.root)?.sync_all()?;
+            Ok(lock)
+        })();
+        if result.is_err() {
+            self.recover_package_transaction()?;
+        }
+        result
+    }
+
+    pub(super) fn recover_package_transaction(&self) -> Result<()> {
+        let path = self.root.join("package-transaction.json");
+        let bytes = match store::read(&path, 1_048_576) {
+            Ok(bytes) => bytes,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+            Err(error) => return Err(error),
+        };
+        let transaction: Value = serde_json::from_slice(&bytes)?;
+        self.write("mods.json", &transaction["old_config"])?;
+        self.write("packages.lock.json", &transaction["old_lock"])?;
+        std::fs::remove_file(path)?;
+        std::fs::File::open(&self.root)?.sync_all()
+    }
+
+    fn resolve_requested(
+        &self,
+        source: &ModPackageSource,
+        requirement: Option<(&str, &str)>,
+        request: &ModInstallRequest,
+        resolved: &mut BTreeMap<String, ResolvedPackage>,
+        visiting: &mut Vec<String>,
+    ) -> Result<ResolvedPackage> {
+        let (path, normalized_source, expected_integrity) =
+            self.materialize_source(source, request.offline)?;
+        let (package, _, integrity) = store::package(&path)?;
+        if let Some(expected) = expected_integrity
+            && expected != integrity
+        {
+            return Err(failure("package_integrity_failure"));
+        }
+        if let Some((id, version)) = requirement
+            && (package.id != id || !service_version_satisfies(version, &package.version))
+        {
+            return Err(failure("resolved_dependency_identity_or_version_mismatch"));
+        }
+        if visiting.contains(&package.id) {
+            visiting.push(package.id.clone());
+            return Err(failure(format!(
+                "dependency_cycle: {}",
+                visiting.join(" -> ")
+            )));
+        }
+        if let Some(existing) = resolved.get(&package.id) {
+            if existing.locked.integrity == integrity {
+                return Ok(existing.clone());
+            }
+            return Err(failure("dependency_resolution_conflict"));
+        }
+        visiting.push(package.id.clone());
+        let license = package
+            .license
+            .clone()
+            .ok_or_else(|| failure("managed_package_license_required"))?;
+        let provenance = package
+            .provenance
+            .clone()
+            .ok_or_else(|| failure("managed_package_provenance_required"))?;
+        validate_provenance(&normalized_source, &provenance)?;
+        let grant = request
+            .trust
+            .packages
+            .get(&package.id)
+            .cloned()
+            .ok_or_else(|| failure(format!("package_trust_required: {}", package.id)))?;
+        if grant.capabilities != package.capabilities {
+            return Err(failure(format!(
+                "explicit_exact_capability_grant_required: {}",
+                package.id
+            )));
+        }
+        let declared_lifecycle = package.lifecycle.keys().cloned().collect::<Vec<_>>();
+        if grant.lifecycle != declared_lifecycle {
+            return Err(failure(format!(
+                "explicit_exact_lifecycle_trust_required: {}",
+                package.id
+            )));
+        }
+        if !package.dependencies.is_empty() && !grant.dependencies {
+            return Err(failure(format!(
+                "dependency_installation_trust_required: {}",
+                package.id
+            )));
+        }
+        let cache_path = self.cache_package(&path, &package, &integrity)?;
+        let active_path = match normalized_source {
+            ModPackageSource::Local { .. } => path,
+            _ => {
+                if path.starts_with(&self.root) && path != cache_path {
+                    std::fs::remove_dir_all(&path)?;
+                }
+                cache_path.clone()
+            }
+        };
+        let locked = ModLockedPackage {
+            id: package.id.clone(),
+            version: package.version.clone(),
+            integrity,
+            source: normalized_source,
+            path: active_path,
+            cache_path,
+            license,
+            provenance,
+            entrypoint: package.entrypoint.clone(),
+            api: package.api.clone(),
+            state_version: package.state_version,
+            dependencies: package.dependencies.clone(),
+            capabilities: package.capabilities.clone(),
+            settings_schema_sha256: digest(
+                &serde_json::to_vec(&package.settings_schema).unwrap_or_default(),
+            ),
+            lifecycle: declared_lifecycle,
+            scope: request.scope.clone(),
+            enabled: false,
+            settings: BTreeMap::new(),
+            trust: grant,
+        };
+        let provisional = ResolvedPackage {
+            locked,
+            package: package.clone(),
+        };
+        resolved.insert(package.id.clone(), provisional.clone());
+        for dependency in &package.dependencies {
+            let dependency_source = ModPackageSource::Package {
+                index: request
+                    .index
+                    .clone()
+                    .ok_or_else(|| failure("dependency_index_required"))?,
+                id: dependency.id.clone(),
+                version: dependency.version.clone(),
+            };
+            let dependency_package = self.resolve_requested(
+                &dependency_source,
+                Some((&dependency.id, &dependency.version)),
+                request,
+                resolved,
+                visiting,
+            )?;
+            resolved.insert(dependency.id.clone(), dependency_package);
+        }
+        visiting.pop();
+        Ok(provisional)
+    }
+
+    fn materialize_source(
+        &self,
+        source: &ModPackageSource,
+        offline: bool,
+    ) -> Result<(PathBuf, ModPackageSource, Option<String>)> {
+        match source {
+            ModPackageSource::Local { path } => {
+                let path = path.canonicalize()?;
+                if path.starts_with(&self.root) {
+                    return Err(failure("local_package_must_be_outside_store"));
+                }
+                Ok((path.clone(), ModPackageSource::Local { path }, None))
+            }
+            ModPackageSource::Repository {
+                repository,
+                revision,
+                subdirectory,
+            } => {
+                if revision.len() != 40
+                    || !revision.bytes().all(|byte| byte.is_ascii_hexdigit())
+                    || repository.is_empty()
+                    || repository.len() > 2048
+                    || !package_directory(subdirectory)
+                {
+                    return Err(failure("immutable_repository_revision_required"));
+                }
+                let local = PathBuf::from(repository);
+                let (repository_path, repository_source) = if local.exists() {
+                    let path = local.canonicalize()?;
+                    let source = path.display().to_string();
+                    (path, source)
+                } else {
+                    if offline
+                        && let Some(package) =
+                            self.read_package_lock()?.packages.values().find(|package| {
+                                package.source == *source && package.cache_path.exists()
+                            })
+                    {
+                        return Ok((
+                            package.cache_path.canonicalize()?,
+                            package.source.clone(),
+                            Some(package.integrity.clone()),
+                        ));
+                    }
+                    if !repository.starts_with("https://") {
+                        return Err(failure("remote_repository_requires_https"));
+                    }
+                    let repositories = self.root.join("repository-cache");
+                    std::fs::create_dir_all(&repositories)?;
+                    let cached =
+                        repositories.join(format!("{}.git", digest(repository.as_bytes())));
+                    if !cached.exists() {
+                        if offline {
+                            return Err(failure("repository_unavailable_offline_and_not_cached"));
+                        }
+                        let staging = repositories.join(format!(
+                            ".{}.{}.tmp",
+                            digest(repository.as_bytes()),
+                            std::process::id()
+                        ));
+                        let output = Command::new("git")
+                            .args(["clone", "--bare", "--filter=blob:none", "--", repository])
+                            .arg(&staging)
+                            .env_clear()
+                            .env("PATH", "/usr/bin:/bin")
+                            .output()?;
+                        if !output.status.success() {
+                            let _ = std::fs::remove_dir_all(&staging);
+                            return Err(failure(format!(
+                                "repository_clone_failed: {}",
+                                String::from_utf8_lossy(&output.stderr).trim()
+                            )));
+                        }
+                        std::fs::rename(&staging, &cached)?;
+                        std::fs::File::open(&repositories)?.sync_all()?;
+                    }
+                    if !offline {
+                        let output = Command::new("git")
+                            .arg("-C")
+                            .arg(&cached)
+                            .args(["fetch", "--force", "--no-tags", "origin", revision])
+                            .env_clear()
+                            .env("PATH", "/usr/bin:/bin")
+                            .output()?;
+                        if !output.status.success() {
+                            return Err(failure(format!(
+                                "repository_fetch_failed: {}",
+                                String::from_utf8_lossy(&output.stderr).trim()
+                            )));
+                        }
+                    }
+                    (cached.canonicalize()?, repository.clone())
+                };
+                let revision = revision.to_lowercase();
+                let actual = git(
+                    &repository_path,
+                    &["rev-parse", &format!("{revision}^{{commit}}")],
+                )?;
+                if actual.trim() != revision {
+                    return Err(failure("repository_revision_mismatch"));
+                }
+                let staging = self.root.join(format!(
+                    ".repository-{}.{}.tmp",
+                    &revision[..12],
+                    std::process::id()
+                ));
+                if staging.exists() {
+                    return Err(failure("stale_repository_staging_directory"));
+                }
+                std::fs::create_dir(&staging)?;
+                let result = (|| {
+                    let prefix = if subdirectory.is_empty() {
+                        String::new()
+                    } else {
+                        format!("{subdirectory}/")
+                    };
+                    let manifest = git_bytes(
+                        &repository_path,
+                        &["show", &format!("{revision}:{prefix}mod.json")],
+                    )?;
+                    std::fs::write(staging.join("mod.json"), &manifest)?;
+                    let package: ModPackage = serde_json::from_slice(&manifest)?;
+                    package.validate()?;
+                    for path in
+                        std::iter::once(&package.entrypoint).chain(package.lifecycle.values())
+                    {
+                        let bytes = git_bytes(
+                            &repository_path,
+                            &["show", &format!("{revision}:{prefix}{path}")],
+                        )?;
+                        let target = staging.join(path);
+                        if let Some(parent) = target.parent() {
+                            std::fs::create_dir_all(parent)?;
+                        }
+                        std::fs::write(target, bytes)?;
+                    }
+                    Ok::<_, io::Error>(())
+                })();
+                if let Err(error) = result {
+                    let _ = std::fs::remove_dir_all(&staging);
+                    return Err(error);
+                }
+                Ok((
+                    staging,
+                    ModPackageSource::Repository {
+                        repository: repository_source,
+                        revision,
+                        subdirectory: subdirectory.clone(),
+                    },
+                    None,
+                ))
+            }
+            ModPackageSource::Package { index, id, version } => {
+                let index_path = match index.canonicalize() {
+                    Ok(index) => index,
+                    Err(_error) if offline => {
+                        if let Some(package) =
+                            self.read_package_lock()?.packages.values().find(|package| {
+                                matches!(&package.source,
+                                    ModPackageSource::Package { index: locked_index, id: locked_id, version: locked_version }
+                                    if locked_index == index && locked_id == id
+                                        && service_version_satisfies(version, locked_version))
+                                    && package.cache_path.exists()
+                            })
+                        {
+                            return Ok((
+                                package.cache_path.canonicalize()?,
+                                package.source.clone(),
+                                Some(package.integrity.clone()),
+                            ));
+                        }
+                        return Err(failure("package_index_unavailable_offline"));
+                    }
+                    Err(error) => return Err(error),
+                };
+                let index_value: PackageIndex =
+                    serde_json::from_slice(&store::read(&index_path, 524_288)?)?;
+                if index_value.schema != 1 {
+                    return Err(failure("unsupported_package_index_schema"));
+                }
+                let releases = index_value
+                    .packages
+                    .get(id)
+                    .ok_or_else(|| failure("package_unavailable"))?;
+                let release = releases
+                    .iter()
+                    .filter_map(|release| {
+                        service_version_satisfies(version, &release.version)
+                            .then_some((SemanticVersion::parse(&release.version)?, release))
+                    })
+                    .max_by_key(|(version, _)| *version)
+                    .map(|(_, release)| release)
+                    .ok_or_else(|| failure("package_version_unavailable"))?;
+                let (path, resolved, actual_expected) =
+                    self.materialize_source(&release.source, offline)?;
+                if actual_expected
+                    .as_deref()
+                    .is_some_and(|value| value != release.integrity)
+                {
+                    return Err(failure("index_integrity_conflict"));
+                }
+                let _ = resolved;
+                Ok((
+                    path,
+                    ModPackageSource::Package {
+                        index: index_path,
+                        id: id.clone(),
+                        version: release.version.clone(),
+                    },
+                    Some(release.integrity.clone()),
+                ))
+            }
+        }
+    }
+
+    fn cache_package(
+        &self,
+        source: &Path,
+        package: &ModPackage,
+        integrity: &str,
+    ) -> Result<PathBuf> {
+        let base = self.root.join("package-cache").join(&package.id);
+        std::fs::create_dir_all(&base)?;
+        let destination = base.join(integrity);
+        if destination.exists() {
+            let destination = destination.canonicalize()?;
+            if store::package(&destination)?.2 != integrity {
+                return Err(failure("cached_package_integrity_failure"));
+            }
+            return Ok(destination);
+        }
+        let staging = base.join(format!(".{integrity}.{}.tmp", std::process::id()));
+        std::fs::create_dir(&staging)?;
+        let result = (|| {
+            copy_file(source, &staging, "mod.json", 8192)?;
+            copy_file(source, &staging, &package.entrypoint, 65_536)?;
+            for script in package.lifecycle.values() {
+                copy_file(source, &staging, script, 65_536)?;
+            }
+            if store::package(&staging.canonicalize()?)?.2 != integrity {
+                return Err(failure("package_integrity_changed_during_copy"));
+            }
+            std::fs::rename(&staging, &destination)?;
+            std::fs::File::open(&base)?.sync_all()?;
+            destination.canonicalize()
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_dir_all(&staging);
+        }
+        result
+    }
+
+    fn run_lifecycle(&self, package: &ModLockedPackage, event: &str) -> Result<()> {
+        if !package.lifecycle.iter().any(|declared| declared == event) {
+            return Ok(());
+        }
+        if !package
+            .trust
+            .lifecycle
+            .iter()
+            .any(|trusted| trusted == event)
+        {
+            return Err(failure("lifecycle_script_not_trusted"));
+        }
+        let inspected = store::package(&package.path);
+        if event == "uninstall" {
+            match &inspected {
+                Ok((_, _, integrity)) if integrity == &package.integrity => {}
+                _ => return Ok(()),
+            }
+        }
+        let (manifest, _, integrity) = inspected?;
+        if integrity != package.integrity {
+            return Err(failure("package_integrity_failure"));
+        }
+        let script = manifest
+            .lifecycle
+            .get(event)
+            .ok_or_else(|| failure("lifecycle_script_missing"))?;
+        let source =
+            String::from_utf8(store::read(&package.path.join(script), 65_536)?).map_err(failure)?;
+        let node = self.configuration()?.node;
+        let request = json!({"source":source,"filename":script,"adapter":null,"event":"inspect",
+            "name":event,"payload":null,"state":null,"settings":{"event":event,"package":package.id,
+                "version":package.version,"integrity":package.integrity},"capabilities":[],"environment":[],
+            "hook_budget_ms":1000,"receipts":[],"field_policies":{},"virtual_time_ms":null});
+        process::evaluate(&node, &request, std::time::Duration::from_secs(1), &|| true)?;
+        Ok(())
+    }
+}
+
+fn copy_file(source: &Path, destination: &Path, relative: &str, limit: u64) -> Result<()> {
+    let bytes = store::read(&source.join(relative), limit)?;
+    let target = destination.join(relative);
+    if let Some(parent) = target.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    std::fs::write(target, bytes)
+}
+
+fn git(repository: &Path, arguments: &[&str]) -> Result<String> {
+    String::from_utf8(git_bytes(repository, arguments)?).map_err(failure)
+}
+
+fn git_bytes(repository: &Path, arguments: &[&str]) -> Result<Vec<u8>> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(repository)
+        .args(arguments)
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .output()?;
+    if !output.status.success() {
+        return Err(failure(format!(
+            "repository_read_failed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        )));
+    }
+    Ok(output.stdout)
+}
+
+fn validate_provenance(source: &ModPackageSource, provenance: &ModProvenance) -> Result<()> {
+    if let ModPackageSource::Repository { repository, .. } = source
+        && provenance.source != *repository
+    {
+        return Err(failure("repository_provenance_mismatch"));
+    }
+    Ok(())
+}
+
+fn package_directory(value: &str) -> bool {
+    value.is_empty()
+        || (!value.starts_with('/')
+            && value.len() <= 256
+            && value.split('/').all(|part| {
+                !part.is_empty()
+                    && part != "."
+                    && part != ".."
+                    && part.bytes().all(|byte| {
+                        byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.')
+                    })
+            }))
+}
+
+fn validate_package_lock(lock: &ModPackageLock) -> Result<()> {
+    if lock
+        .history
+        .values()
+        .any(|history| history.len() > PACKAGE_HISTORY_LIMIT)
+        || lock.packages.iter().any(|(id, package)| {
+            id != &package.id
+                || package.integrity.len() != 64
+                || !package
+                    .integrity
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit())
+        })
+    {
+        return Err(failure("invalid_package_lock"));
+    }
+    Ok(())
+}
+
+fn push_history(lock: &mut ModPackageLock, id: &str, package: ModLockedPackage) -> Result<()> {
+    let history = lock.history.entry(id.to_owned()).or_default();
+    history.push(package);
+    if history.len() > PACKAGE_HISTORY_LIMIT {
+        history.remove(0);
+    }
+    Ok(())
+}
+
+fn validate_locked_graph(packages: &BTreeMap<String, ModLockedPackage>) -> Result<()> {
+    for package in packages.values() {
+        for dependency in &package.dependencies {
+            let resolved = packages
+                .get(&dependency.id)
+                .ok_or_else(|| failure(format!("dependency_unavailable: {}", dependency.id)))?;
+            if !service_version_satisfies(&dependency.version, &resolved.version) {
+                return Err(failure("dependency_version_incompatible"));
+            }
+        }
+    }
+    let mut remaining: BTreeSet<_> = packages.keys().cloned().collect();
+    while let Some(id) = remaining
+        .iter()
+        .find(|id| {
+            packages[*id]
+                .dependencies
+                .iter()
+                .all(|dependency| !remaining.contains(&dependency.id))
+        })
+        .cloned()
+    {
+        remaining.remove(&id);
+    }
+    if remaining.is_empty() {
+        Ok(())
+    } else {
+        Err(failure(format!(
+            "dependency_cycle: {}",
+            remaining.into_iter().collect::<Vec<_>>().join(" -> ")
+        )))
+    }
+}
+
+fn package_changes(existing: &ModPackageLock, packages: &[ModLockedPackage]) -> Value {
+    let mut changes = Vec::new();
+    for package in packages {
+        let previous = existing.packages.get(&package.id);
+        changes.push(json!({
+            "id":package.id,
+            "version":{"from":previous.map(|value|&value.version),"to":package.version},
+            "integrity":{"from":previous.map(|value|&value.integrity),"to":package.integrity},
+            "source":{"from":previous.map(|value|&value.source),"to":package.source},
+            "license":{"from":previous.map(|value|&value.license),"to":package.license},
+            "provenance":{"from":previous.map(|value|&value.provenance),"to":package.provenance},
+            "entrypoint":{"from":previous.map(|value|&value.entrypoint),"to":package.entrypoint},
+            "api":{"from":previous.map(|value|&value.api),"to":package.api},
+            "state_version":{"from":previous.map(|value|value.state_version),"to":package.state_version,
+                "migration_required":previous.is_some_and(|value|value.state_version != package.state_version) && !package.enabled},
+            "dependencies":{"from":previous.map(|value|&value.dependencies),"to":package.dependencies},
+            "capabilities":{"from":previous.map(|value|&value.capabilities),"to":package.capabilities},
+            "settings_schema_sha256":{"from":previous.map(|value|&value.settings_schema_sha256),"to":package.settings_schema_sha256},
+            "settings":{"from":previous.map(|value|&value.settings),"to":package.settings},
+            "lifecycle":{"from":previous.map(|value|&value.lifecycle),"to":package.lifecycle},
+            "activation":{"from":previous.is_some_and(|value|value.enabled),"to":package.enabled}
+        }));
+    }
+    Value::Object(Map::from_iter([
+        ("packages".to_owned(), Value::Array(changes)),
+        (
+            "authority".to_owned(),
+            json!(
+                "dependency resolution installs no capability, lifecycle, permission, credential, provider, or spending grant"
+            ),
+        ),
+        ("local_sources_preserved".to_owned(), Value::Bool(true)),
+        (
+            "activation_requires_confirmation".to_owned(),
+            Value::Bool(true),
+        ),
+    ]))
+}
diff --git a/codex-rs/omd/src/mods/packages.rs b/codex-rs/omd/src/mods/packages.rs
new file mode 100644
index 0000000..48e1177
--- /dev/null
+++ b/codex-rs/omd/src/mods/packages.rs
@@ -0,0 +1,217 @@
+use super::*;
+
+impl ModStore {
+    pub fn settings(&self, path: &Path, settings: BTreeMap<String, Value>) -> Result<()> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if hash != selection.sha256 {
+            return Err(failure("source_changed: inspect and trust the new digest"));
+        }
+        validate_settings(&package, &settings)?;
+        selection.settings = settings;
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.write("mods.json", &serde_json::to_value(config)?)
+    }
+
+    pub fn discover(user: &Path, project: &Path) -> Result<Value> {
+        let mut selected: BTreeMap<String, Value> = BTreeMap::new();
+        let mut errors = Vec::new();
+        for (scope, root) in [("user", user), ("project", project)] {
+            if !root.exists() {
+                continue;
+            }
+            let mut paths = std::fs::read_dir(root)?
+                .map(|e| e.map(|e| e.path()))
+                .collect::<std::io::Result<Vec<_>>>()?;
+            if paths.len() > 256 {
+                return Err(failure("discovery_limit"));
+            }
+            paths.sort();
+            for path in paths {
+                if !path.is_dir() {
+                    continue;
+                }
+                let result = path
+                    .canonicalize()
+                    .and_then(|path| Self::inspect_package(&path));
+                match result {
+                    Ok(mut value) => {
+                        let id = value["manifest"]["id"]
+                            .as_str()
+                            .ok_or_else(|| failure("missing_mod_id"))?
+                            .to_owned();
+                        value["scope"] = json!(scope);
+                        value["shadows"] = selected
+                            .get(&id)
+                            .map(|v| v["path"].clone())
+                            .unwrap_or(Value::Null);
+                        value["trusted"] = json!(false);
+                        selected.insert(id, value);
+                    }
+                    Err(error) => errors.push(json!({"path":path,"error":error.to_string()})),
+                }
+            }
+        }
+        Ok(
+            json!({"packages":selected.into_values().collect::<Vec<_>>(),"errors":errors,"precedence":"project over user; discovery never grants trust"}),
+        )
+    }
+
+    pub fn migrate(&self, path: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, source, hash) = store::package(path)?;
+        if selection.enabled
+            || hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package.capabilities.iter().any(|c| c == "state")
+        {
+            return Err(failure(
+                "migration_requires_disabled_trusted_state_capability",
+            ));
+        }
+        let name = ModStore::state_name(&package.id, &selection.scope);
+        let previous: Value =
+            serde_json::from_slice(&store::read(&self.root.join(&name), 65_536)?)?;
+        let from = previous["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if previous["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || from == u64::from(package.state_version)
+        {
+            return Err(failure("migration_requires_different_state_version"));
+        }
+        let to = package.state_version;
+        let mut loaded = Loaded {
+            package,
+            source,
+            selection: selection.clone(),
+            state: previous["value"].clone(),
+            registrations: Registrations::default(),
+            source_use: ModSourceUse::default(),
+            unused_grants: Vec::new(),
+            unused_environment: Vec::new(),
+            error: None,
+            telemetry: ModTelemetry::default(),
+        };
+        let inspected = ModHost::run(&config.node, &loaded, "inspect", "", Value::Null, &|| true)?;
+        ModHost::validate_registrations(&loaded.package, &inspected.registrations)?;
+        if inspected.state != loaded.state
+            || !inspected
+                .registrations
+                .events
+                .iter()
+                .any(|e| e == "migrate")
+        {
+            return Err(failure("explicit_migration_handler_required"));
+        }
+        loaded.registrations = inspected.registrations.clone();
+        let reply = ModHost::run(
+            &config.node,
+            &loaded,
+            "migrate",
+            "",
+            json!({"from":from,"to":to}),
+            &|| true,
+        )?;
+        if reply.registrations != inspected.registrations {
+            return Err(failure("migration_changed_registration"));
+        }
+        let state_name = ModStore::state_name(&loaded.package.id, &selection.scope);
+        let backup = format!(
+            "{}-backup-{}",
+            state_name,
+            digest(&serde_json::to_vec(&previous)?)
+        );
+        self.write(&backup, &previous)?;
+        self.write(
+            &name,
+            &json!({"schema":MOD_STATE_STORAGE_SCHEMA_VERSION,"version":to,"value":reply.state}),
+        )?;
+        Ok(
+            json!({"id":loaded.package.id,"from":from,"to":to,"backup":self.root.join(backup),
+            "source_sha256":hash,"settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+
+    pub fn rollback(&self, path: &Path, backup: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter()
+            .find(|selection| selection.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if selection.enabled
+            || hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "state")
+        {
+            return Err(failure(
+                "rollback_requires_disabled_trusted_state_capability",
+            ));
+        }
+        let backup = backup.canonicalize()?;
+        if backup.parent() != Some(self.root.as_path()) {
+            return Err(failure("rollback_backup_must_be_in_store"));
+        }
+        let state_name = ModStore::state_name(&package.id, &selection.scope);
+        let prefix = format!("{state_name}-backup-");
+        let backup_name = backup
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| failure("rollback_backup_does_not_match_package_scope"))?;
+        let Some(expected_digest) = backup_name.strip_prefix(&prefix) else {
+            return Err(failure("rollback_backup_does_not_match_package_scope"));
+        };
+        let restored: Value = serde_json::from_slice(&store::read(&backup, 65_536)?)?;
+        if digest(&serde_json::to_vec(&restored)?) != expected_digest {
+            return Err(failure("rollback_backup_digest_mismatch"));
+        }
+        let restored_version = restored["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if restored["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION {
+            return Err(failure("incompatible_state_storage_schema"));
+        }
+        let current_path = self.root.join(&state_name);
+        let current: Value = serde_json::from_slice(&store::read(&current_path, 65_536)?)?;
+        if current["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || current["version"].as_u64().is_none()
+        {
+            return Err(failure("incompatible_current_state"));
+        }
+        let recovery = format!(
+            "{state_name}-rollback-{}",
+            digest(&serde_json::to_vec(&current)?)
+        );
+        self.write(&recovery, &current)?;
+        self.write(&state_name, &restored)?;
+        Ok(
+            json!({"id":package.id,"from":current["version"],"to":restored_version,
+            "restored":backup,"recovery":self.root.join(recovery),"source_sha256":hash,
+            "settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/mods/pi.rs b/codex-rs/omd/src/mods/pi.rs
new file mode 100644
index 0000000..88c4a82
--- /dev/null
+++ b/codex-rs/omd/src/mods/pi.rs
@@ -0,0 +1,517 @@
+use super::*;
+use ignore::gitignore::GitignoreBuilder;
+
+const IGNORE_FILES: &[&str] = &[".gitignore", ".ignore", ".fdignore"];
+const ENTRY_LIMIT: usize = 1024;
+const DEPTH_LIMIT: usize = 8;
+const RESOURCE_BYTES: u64 = 16_384;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PiPrompt {
+    pub name: String,
+    pub description: String,
+    pub argument_hint: Option<String>,
+    pub body: String,
+    pub path: PathBuf,
+    pub scope: &'static str,
+    pub sha256: String,
+}
+
+struct Traversal<'a> {
+    root: &'a Path,
+    patterns: Vec<String>,
+    visited: usize,
+    resources: Vec<Value>,
+    diagnostics: Vec<Value>,
+}
+
+fn normalize(content: &str) -> String {
+    content.replace("\r\n", "\n").replace('\r', "\n")
+}
+
+fn frontmatter(content: &str) -> Result<(serde_json::Map<String, Value>, String)> {
+    let normalized = normalize(content);
+    if !normalized.starts_with("---") {
+        return Ok((serde_json::Map::new(), normalized));
+    }
+    let Some(end) = normalized
+        .get(3..)
+        .and_then(|rest| rest.find("\n---"))
+        .map(|index| index + 3)
+    else {
+        return Ok((serde_json::Map::new(), normalized));
+    };
+    let yaml = normalized.get(4..end).unwrap_or_default();
+    let body = normalized
+        .get(end + 4..)
+        .unwrap_or_default()
+        .trim()
+        .to_owned();
+    if yaml.is_empty() {
+        return Ok((serde_json::Map::new(), body));
+    }
+    let parsed: Value =
+        serde_yaml::from_str(yaml).map_err(|e| failure(format!("pi_frontmatter: {e}")))?;
+    Ok((parsed.as_object().cloned().unwrap_or_default(), body))
+}
+
+fn string_field(fields: &serde_json::Map<String, Value>, key: &str) -> Option<String> {
+    fields
+        .get(key)
+        .and_then(Value::as_str)
+        .filter(|value| !value.is_empty())
+        .map(str::to_owned)
+}
+
+fn prompt_description(fields: &serde_json::Map<String, Value>, body: &str) -> String {
+    string_field(fields, "description").unwrap_or_else(|| {
+        body.split('\n')
+            .find(|line| !line.trim().is_empty())
+            .map(|line| {
+                let mut description: String = line.chars().take(60).collect();
+                if line.chars().count() > 60 {
+                    description.push_str("...");
+                }
+                description
+            })
+            .unwrap_or_default()
+    })
+}
+
+fn prefix_pattern(line: &str, prefix: &str) -> Option<String> {
+    let trimmed = line.trim();
+    if trimmed.is_empty() || (trimmed.starts_with('#') && !trimmed.starts_with("\\#")) {
+        return None;
+    }
+    let mut pattern = line;
+    let mut negated = false;
+    if let Some(rest) = pattern.strip_prefix('!') {
+        negated = true;
+        pattern = rest;
+    } else if pattern.starts_with("\\!") {
+        pattern = &pattern[1..];
+    }
+    let pattern = pattern.strip_prefix('/').unwrap_or(pattern);
+    let prefixed = format!("{prefix}{pattern}");
+    Some(if negated {
+        format!("!{prefixed}")
+    } else {
+        prefixed
+    })
+}
+
+fn relative(root: &Path, path: &Path) -> String {
+    path.strip_prefix(root)
+        .unwrap_or(path)
+        .components()
+        .map(|c| c.as_os_str().to_string_lossy().into_owned())
+        .collect::<Vec<_>>()
+        .join("/")
+}
+
+fn symlink(path: &Path) -> Result<bool> {
+    Ok(std::fs::symlink_metadata(path)?.file_type().is_symlink())
+}
+
+fn sorted_entries(directory: &Path) -> Result<Vec<PathBuf>> {
+    let mut entries = std::fs::read_dir(directory)?
+        .map(|entry| entry.map(|entry| entry.path()))
+        .collect::<Result<Vec<_>>>()?;
+    entries.sort();
+    Ok(entries)
+}
+
+impl Traversal<'_> {
+    fn ignored(&self, path: &Path, directory: bool) -> Result<bool> {
+        let mut builder = GitignoreBuilder::new(self.root);
+        for pattern in &self.patterns {
+            builder
+                .add_line(None, pattern)
+                .map_err(|e| failure(format!("pi_ignore_pattern: {e}")))?;
+        }
+        let matcher = builder
+            .build()
+            .map_err(|e| failure(format!("pi_ignore_pattern: {e}")))?;
+        Ok(matcher
+            .matched_path_or_any_parents(path, directory)
+            .is_ignore())
+    }
+
+    fn add_rules(&mut self, directory: &Path) -> Result<()> {
+        let relative = relative(self.root, directory);
+        let prefix = if relative.is_empty() {
+            String::new()
+        } else {
+            format!("{relative}/")
+        };
+        for name in IGNORE_FILES {
+            let path = directory.join(name);
+            if !path.exists() {
+                continue;
+            }
+            if symlink(&path)? {
+                self.diagnostics
+                    .push(json!({"path":path,"error":"pi_symlink_unsupported"}));
+                continue;
+            }
+            let content = String::from_utf8(store::read(&path, 65_536)?).map_err(failure)?;
+            self.patterns.extend(
+                content
+                    .split('\n')
+                    .map(|line| line.strip_suffix('\r').unwrap_or(line))
+                    .filter_map(|line| prefix_pattern(line, &prefix)),
+            );
+        }
+        Ok(())
+    }
+
+    fn skill(&mut self, path: &Path, scope: &str) {
+        let result = store::read(path, RESOURCE_BYTES).and_then(|bytes| {
+            let content = String::from_utf8(bytes.clone()).map_err(failure)?;
+            let (fields, _) = frontmatter(&content)?;
+            Ok((bytes, content, fields))
+        });
+        let (bytes, content, fields) = match result {
+            Ok(value) => value,
+            Err(error) => {
+                self.diagnostics
+                    .push(json!({"path":path,"error":error.to_string()}));
+                return;
+            }
+        };
+        let Some(description) = string_field(&fields, "description")
+            .filter(|description| !description.trim().is_empty())
+        else {
+            self.diagnostics
+                .push(json!({"path":path,"error":"pi_skill_description_required"}));
+            return;
+        };
+        let parent = path
+            .parent()
+            .and_then(Path::file_name)
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        let name = string_field(&fields, "name").unwrap_or(parent);
+        self.resources.push(
+            json!({"kind":"skills","name":name,"scope":scope,"path":path,
+            "description":description,"sha256":digest(&bytes),"content":content}),
+        );
+    }
+
+    fn skills(
+        &mut self,
+        directory: &Path,
+        scope: &str,
+        root_files: bool,
+        depth: usize,
+    ) -> Result<()> {
+        if depth > DEPTH_LIMIT {
+            self.diagnostics
+                .push(json!({"path":directory,"error":"pi_depth_limit"}));
+            return Ok(());
+        }
+        self.add_rules(directory)?;
+        let entries = sorted_entries(directory)?;
+        self.visited += entries.len();
+        if self.visited > ENTRY_LIMIT {
+            return Err(failure("pi_discovery_limit"));
+        }
+        let skill = directory.join("SKILL.md");
+        if entries.contains(&skill) {
+            if symlink(&skill)? {
+                self.diagnostics
+                    .push(json!({"path":skill,"error":"pi_symlink_unsupported"}));
+            } else if skill.is_file() && !self.ignored(&skill, false)? {
+                self.skill(&skill, scope);
+                return Ok(());
+            }
+        }
+        for entry in entries {
+            let Some(name) = entry.file_name().map(|n| n.to_string_lossy().into_owned()) else {
+                continue;
+            };
+            if name.starts_with('.') || name == "node_modules" {
+                continue;
+            }
+            if symlink(&entry)? {
+                self.diagnostics
+                    .push(json!({"path":entry,"error":"pi_symlink_unsupported"}));
+                continue;
+            }
+            let is_directory = entry.is_dir();
+            if self.ignored(&entry, is_directory)? {
+                continue;
+            }
+            if is_directory {
+                self.skills(&entry, scope, false, depth + 1)?;
+            } else if root_files && entry.is_file() && name.ends_with(".md") {
+                self.skill(&entry, scope);
+            }
+        }
+        Ok(())
+    }
+}
+
+fn roots(user_agent: &Path, project: &Path) -> [(&'static str, PathBuf); 2] {
+    [
+        ("user", user_agent.to_path_buf()),
+        ("project", project.join(".pi")),
+    ]
+}
+
+fn canonical_directory(directory: &Path, diagnostics: &mut Vec<Value>) -> Result<bool> {
+    if !directory.exists() {
+        return Ok(false);
+    }
+    if directory.canonicalize()? != directory {
+        diagnostics.push(json!({"path":directory,"error":"pi_symlink_unsupported"}));
+        return Ok(false);
+    }
+    Ok(true)
+}
+
+pub fn parse_command_args(arguments: &str) -> Vec<String> {
+    let mut parsed = Vec::new();
+    let mut current = String::new();
+    let mut quote = None;
+    for character in arguments.chars() {
+        match quote {
+            Some(open) if character == open => quote = None,
+            Some(_) => current.push(character),
+            None if character == '"' || character == '\'' => quote = Some(character),
+            None if character == ' ' || character == '\t' => {
+                if !current.is_empty() {
+                    parsed.push(std::mem::take(&mut current));
+                }
+            }
+            None => current.push(character),
+        }
+    }
+    if !current.is_empty() {
+        parsed.push(current);
+    }
+    parsed
+}
+
+fn digits(text: &str) -> usize {
+    text.bytes().take_while(u8::is_ascii_digit).count()
+}
+
+fn index(text: &str) -> Option<usize> {
+    text.parse::<usize>().ok()
+}
+
+pub fn substitute_args(content: &str, arguments: &[String]) -> String {
+    let mut positional = String::with_capacity(content.len());
+    let mut rest = content;
+    while let Some(position) = rest.find('$') {
+        positional.push_str(&rest[..position]);
+        let after = &rest[position + 1..];
+        let length = digits(after);
+        if length == 0 {
+            positional.push('$');
+            rest = after;
+            continue;
+        }
+        let value = index(&after[..length])
+            .and_then(|n| n.checked_sub(1))
+            .and_then(|n| arguments.get(n))
+            .map(String::as_str)
+            .unwrap_or_default();
+        positional.push_str(value);
+        rest = &after[length..];
+    }
+    positional.push_str(rest);
+    let mut sliced = String::with_capacity(positional.len());
+    let mut rest = positional.as_str();
+    while let Some(position) = rest.find("${@:") {
+        sliced.push_str(&rest[..position]);
+        let after = &rest[position + 4..];
+        let start_length = digits(after);
+        let mut consumed = start_length;
+        let mut count = None;
+        if start_length > 0 && after[consumed..].starts_with(':') {
+            let length = digits(&after[consumed + 1..]);
+            if length > 0 {
+                count = Some(&after[consumed + 1..consumed + 1 + length]);
+                consumed += 1 + length;
+            }
+        }
+        if start_length == 0 || !after[consumed..].starts_with('}') {
+            sliced.push_str("${@:");
+            rest = after;
+            continue;
+        }
+        let start = index(&after[..start_length])
+            .map(|n| n.saturating_sub(1))
+            .unwrap_or(usize::MAX);
+        let selected: Vec<&str> = arguments
+            .iter()
+            .skip(start)
+            .take(count.and_then(index).unwrap_or(usize::MAX))
+            .map(String::as_str)
+            .collect();
+        sliced.push_str(&selected.join(" "));
+        rest = &after[consumed + 1..];
+    }
+    sliced.push_str(rest);
+    let all = arguments.join(" ");
+    js_replace_all(&js_replace_all(&sliced, "$ARGUMENTS", &all), "$@", &all)
+}
+
+fn js_replace_all(haystack: &str, needle: &str, replacement: &str) -> String {
+    let mut output = String::with_capacity(haystack.len());
+    let mut cursor = 0;
+    while let Some(offset) = haystack[cursor..].find(needle) {
+        let start = cursor + offset;
+        let end = start + needle.len();
+        output.push_str(&haystack[cursor..start]);
+        let mut characters = replacement.chars().peekable();
+        while let Some(character) = characters.next() {
+            if character != '$' {
+                output.push(character);
+                continue;
+            }
+            match characters.peek() {
+                Some('$') => output.push('$'),
+                Some('&') => output.push_str(needle),
+                Some('`') => output.push_str(&haystack[..start]),
+                Some('\'') => output.push_str(&haystack[end..]),
+                _ => {
+                    output.push('$');
+                    continue;
+                }
+            }
+            characters.next();
+        }
+        cursor = end;
+    }
+    output.push_str(&haystack[cursor..]);
+    output
+}
+
+impl ModStore {
+    pub fn discover_pi(user_agent: &Path, project: &Path) -> Result<Value> {
+        let mut resources = BTreeMap::new();
+        let mut diagnostics = Vec::new();
+        for (scope, root) in roots(user_agent, project) {
+            let directory = root.join("skills");
+            if canonical_directory(&directory, &mut diagnostics)? {
+                let mut traversal = Traversal {
+                    root: &directory,
+                    patterns: Vec::new(),
+                    visited: 0,
+                    resources: Vec::new(),
+                    diagnostics: Vec::new(),
+                };
+                traversal.skills(&directory, scope, true, 0)?;
+                diagnostics.extend(traversal.diagnostics);
+                let mut seen = BTreeSet::new();
+                for resource in traversal.resources {
+                    let name = resource["name"].as_str().unwrap_or_default().to_owned();
+                    if !seen.insert(name.clone()) {
+                        diagnostics.push(
+                            json!({"path":resource["path"],"error":"pi_duplicate_skill_name"}),
+                        );
+                        continue;
+                    }
+                    resources.insert(format!("skills/{name}"), resource);
+                }
+            }
+        }
+        for prompt in Self::pi_prompts_with(user_agent, project, &mut diagnostics)? {
+            resources.insert(
+                format!("prompts/{}", prompt.name),
+                json!({"kind":"prompts","name":prompt.name,"scope":prompt.scope,"path":prompt.path,
+                    "description":prompt.description,"argument_hint":prompt.argument_hint,
+                    "sha256":prompt.sha256,"content":prompt.body}),
+            );
+        }
+        let value = json!({"adapter":"pi-0.74-resources-v2","resources":resources.into_values().collect::<Vec<_>>(),"diagnostics":diagnostics});
+        if serde_json::to_vec(&value)?.len() > 131_072 {
+            return Err(failure("pi_resource_aggregate_limit"));
+        }
+        Ok(value)
+    }
+
+    pub fn pi_prompts(user_agent: &Path, project: &Path) -> Result<(Vec<PiPrompt>, Vec<Value>)> {
+        let mut diagnostics = Vec::new();
+        let prompts = Self::pi_prompts_with(user_agent, project, &mut diagnostics)?;
+        Ok((prompts, diagnostics))
+    }
+
+    fn pi_prompts_with(
+        user_agent: &Path,
+        project: &Path,
+        diagnostics: &mut Vec<Value>,
+    ) -> Result<Vec<PiPrompt>> {
+        let mut prompts: BTreeMap<String, PiPrompt> = BTreeMap::new();
+        for (scope, root) in roots(user_agent, project) {
+            let directory = root.join("prompts");
+            if !canonical_directory(&directory, diagnostics)? {
+                continue;
+            }
+            let entries = sorted_entries(&directory)?;
+            if entries.len() > 128 {
+                return Err(failure("pi_discovery_limit"));
+            }
+            for entry in entries {
+                if symlink(&entry)? {
+                    diagnostics.push(json!({"path":entry,"error":"pi_symlink_unsupported"}));
+                    continue;
+                }
+                if !entry.is_file() || entry.extension().is_none_or(|e| e != "md") {
+                    continue;
+                }
+                let Some(name) = entry
+                    .file_stem()
+                    .and_then(|n| n.to_str())
+                    .map(str::to_owned)
+                else {
+                    continue;
+                };
+                let parsed = store::read(&entry, RESOURCE_BYTES).and_then(|bytes| {
+                    let content = String::from_utf8(bytes.clone()).map_err(failure)?;
+                    let (fields, body) = frontmatter(&content)?;
+                    Ok((bytes, fields, body))
+                });
+                match parsed {
+                    Ok((bytes, fields, body)) => {
+                        prompts.insert(
+                            name.clone(),
+                            PiPrompt {
+                                description: prompt_description(&fields, &body),
+                                argument_hint: string_field(&fields, "argument-hint"),
+                                name,
+                                body,
+                                path: entry,
+                                scope,
+                                sha256: digest(&bytes),
+                            },
+                        );
+                    }
+                    Err(error) => diagnostics.push(json!({"path":entry,"error":error.to_string()})),
+                }
+            }
+        }
+        Ok(prompts.into_values().collect())
+    }
+
+    pub fn expand_pi_prompt(
+        user_agent: &Path,
+        project: &Path,
+        name: &str,
+        arguments: &str,
+    ) -> Result<Value> {
+        let (prompts, _) = Self::pi_prompts(user_agent, project)?;
+        let prompt = prompts
+            .into_iter()
+            .find(|prompt| prompt.name == name)
+            .ok_or_else(|| failure("pi_prompt_not_found"))?;
+        let text = substitute_args(&prompt.body, &parse_command_args(arguments));
+        if text.len() > 61_440 {
+            return Err(failure("pi_prompt_expansion_limit"));
+        }
+        Ok(json!({"name":prompt.name,"path":prompt.path,"sha256":prompt.sha256,"text":text}))
+    }
+}
