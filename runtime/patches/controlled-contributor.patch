+fn snapshot() -> Snapshot {
+    Snapshot {
+        files: BTreeMap::from([(
+            "source.txt".into(),
+            File {
+                bytes: b"dirty tracked input".to_vec(),
+                executable: false,
+            },
+        )]),
+    }
