+#[derive(Clone, Debug, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct LspCapabilities {
+    pub definition: bool,
+    pub references: bool,
+    pub rename_symbol: bool,
+    pub prepare_rename: bool,
