+
+def send(value):
+    body = json.dumps(value, separators=(',', ':')).encode()
+    sys.stdout.buffer.write(('Content-Length: %d\r\n\r\n' % len(body)).encode() + body)
+    sys.stdout.buffer.flush()
+
+documents = {}
+while True:
+    message = read()
+    method = message.get('method')
+    request_id = message.get('id')
