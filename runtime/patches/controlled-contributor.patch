+    }
+
+    fn matches_worker(&self, worker: &Worker) -> bool {
+        self.parent == worker.parent
+            && self.depth == worker.depth
+            && self.limits == worker.limits
+            && self.requests == worker.requests
+            && self.exposure_microusd == worker.exposure
