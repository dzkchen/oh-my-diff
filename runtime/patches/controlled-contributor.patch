+
+fn visible(text: &str, limit: usize) -> bool {
+    text.len() <= limit && !text.chars().any(char::is_control)
+}
+
+fn multiline(text: &str, limit: usize) -> bool {
+    text.len() <= limit
+        && !text
+            .chars()
+            .any(|c| c.is_control() && c != '\n' && c != '\t')
+}
+
+fn component_id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 48
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')
+}
+
+pub fn mod_key_name(key: &str) -> bool {
+    let function = key
+        .strip_prefix('F')
+        .and_then(|number| number.parse::<u8>().ok())
+        .is_some_and(|number| (2..=12).contains(&number) && key == format!("F{number}"));
+    let letter = |rest: Option<&str>| {
+        rest.is_some_and(|rest| rest.len() == 1 && rest.bytes().all(|b| b.is_ascii_lowercase()))
+    };
+    let reserved = [
+        "Ctrl+c", "Ctrl+d", "Ctrl+z", "Ctrl+h", "Ctrl+i", "Ctrl+j", "Ctrl+m",
+    ];
+    !reserved.contains(&key)
+        && (function || letter(key.strip_prefix("Ctrl+")) || letter(key.strip_prefix("Alt+")))
+}
+
+pub fn mod_command_reference(value: &str) -> bool {
+    match value.split_once(':') {
+        Some((id, name)) => identifier(id) && id.len() <= 24 && identifier(name),
+        None => identifier(value),
+    }
+}
+
+impl ModPanel {
+    fn valid(&self, lines: usize) -> bool {
+        visible(&self.title, 1024)
+            && self.lines.len() <= lines
+            && self.lines.iter().all(|line| visible(line, 1024))
+    }
+}
+
+impl ModCommandAction {
+    fn valid(&self) -> bool {
+        mod_command_reference(&self.command) && multiline(&self.args, 4096)
+    }
+}
+
+impl ModComponentAction {
+    fn valid(&self) -> bool {
+        match self {
+            Self::Command(action) => action.valid(),
+            Self::Copy { copy, label } => {
+                !copy.is_empty()
+                    && multiline(copy, 4096)
+                    && !label.is_empty()
+                    && visible(label, 128)
+            }
+        }
+    }
+}
+
+impl ModComponent {
+    fn validate(
+        &self,
+        depth: usize,
+        count: &mut usize,
+        ids: &mut BTreeSet<String>,
+        slots: &mut usize,
+    ) -> bool {
+        if depth > 6 {
+            return false;
+        }
+        *count += 1;
+        if *count > MOD_COMPONENT_LIMIT {
+            return false;
+        }
+        let identified = |id: &str, label: &str, ids: &mut BTreeSet<String>| {
+            component_id(id)
+                && !label.is_empty()
+                && visible(label, 128)
+                && ids.insert(id.to_owned())
+        };
+        let children = |children: &[Self],
+                        count: &mut usize,
+                        ids: &mut BTreeSet<String>,
+                        slots: &mut usize| {
+            children
+                .iter()
+                .all(|child| child.validate(depth + 1, count, ids, slots))
+        };
+        match self {
+            Self::Box {
+                id,
+                label,
+                title,
+                children: nested,
+            }
+            | Self::Pane {
+                id,
+                label,
+                title,
+                children: nested,
+                ..
+            } => {
+                identified(id, label, ids)
+                    && title.as_ref().is_none_or(|title| visible(title, 128))
+                    && children(nested, count, ids, slots)
+            }
+            Self::Dialog {
+                id,
+                label,
+                title,
+                children: nested,
+            } => {
+                identified(id, label, ids)
+                    && !title.is_empty()
+                    && visible(title, 128)
+                    && children(nested, count, ids, slots)
+            }
+            Self::Text {
+                id, label, text, ..
+            }
+            | Self::Markdown { id, label, text }
+            | Self::Code {
+                id, label, text, ..
+            } => identified(id, label, ids) && multiline(text, 4096),
+            Self::Button {
+                id,
+                label,
+                text,
+                action,
+            } => {
+                identified(id, label, ids)
+                    && !text.is_empty()
+                    && visible(text, 256)
+                    && action.valid()
+            }
+            Self::Input {
+                id,
+                label,
+                value,
+                placeholder,
+                action,
+            } => {
+                identified(id, label, ids)
+                    && multiline(value, 1024)
+                    && visible(placeholder, 256)
+                    && action.valid()
+            }
+            Self::Select {
+                id,
+                label,
+                value,
+                options,
+                action,
+            } => {
+                let values = options
+                    .iter()
+                    .map(|option| option.value.as_str())
+                    .collect::<BTreeSet<_>>();
+                identified(id, label, ids)
+                    && (1..=16).contains(&options.len())
+                    && values.len() == options.len()
+                    && options.iter().any(|option| option.value == *value)
+                    && options.iter().all(|option| {
+                        !option.value.is_empty()
+                            && visible(&option.value, 128)
+                            && !option.label.is_empty()
+                            && visible(&option.label, 128)
+                    })
+                    && action.valid()
+            }
+            Self::Slot => {
+                *slots += 1;
+                *slots <= 1
+            }
+        }
+    }
+}
+
+impl ModRenderSite {
+    fn valid(&self, patch: bool, ids: &mut BTreeSet<String>) -> bool {
+        let mut count = 0;
+        let mut slots = 0;
+        let valid = self
+            .components
+            .iter()
+            .all(|component| component.validate(1, &mut count, ids, &mut slots));
+        valid
+            && if patch && self.mode == ModSiteMode::Wrap {
+                slots == 1
+            } else {
+                slots == 0
+            }
+    }
+}
+
+fn valid_site(name: &str) -> bool {
+    ["sidebar", "header", "above_composer", "dialog"].contains(&name)
+}
+
+fn valid_action(action: &ModKeyAction) -> bool {
+    match action {
+        ModKeyAction::Draft(text)
+        | ModKeyAction::Insert { insert: text }
+        | ModKeyAction::Submit { submit: text } => !text.is_empty() && multiline(text, 4096),
+        ModKeyAction::Command { command, args } => {
+            mod_command_reference(command) && multiline(args, 4096)
+        }
+        ModKeyAction::Focus { focus } => component_id(focus),
+        ModKeyAction::Copy { copy, label } => {
+            !copy.is_empty() && multiline(copy, 4096) && !label.is_empty() && visible(label, 128)
+        }
+    }
+}
+
+fn valid_templates(message: &Option<String>, tool: &Option<String>) -> bool {
+    [message, tool]
+        .into_iter()
+        .flatten()
+        .all(|template| visible(template, 1024) && template.matches("{text}").count() == 1)
+}
+
+fn valid_bindings(bindings: &BTreeMap<String, ModKeyAction>) -> bool {
+    bindings.len() <= MOD_KEY_LIMIT
+        && bindings
+            .iter()
+            .all(|(key, action)| mod_key_name(key) && valid_action(action))
+}
+
+fn valid_status(status: &[String]) -> bool {
+    status.len() <= 4
+        && status
+            .iter()
+            .all(|segment| !segment.is_empty() && visible(segment, 40))
+}
+
+fn valid_sites(sites: &BTreeMap<String, ModRenderSite>, patch: bool) -> bool {
+    let mut ids = BTreeSet::new();
+    sites.len() <= 4
+        && sites
+            .iter()
+            .all(|(name, site)| valid_site(name) && site.valid(patch, &mut ids))
+}
+
+fn component_ids(component: &ModComponent, ids: &mut BTreeSet<String>) {
+    match component {
+        ModComponent::Box { id, children, .. }
+        | ModComponent::Pane { id, children, .. }
+        | ModComponent::Dialog { id, children, .. } => {
+            ids.insert(id.clone());
+            for child in children {
+                component_ids(child, ids);
+            }
+        }
+        ModComponent::Text { id, .. }
+        | ModComponent::Button { id, .. }
+        | ModComponent::Input { id, .. }
+        | ModComponent::Select { id, .. }
+        | ModComponent::Markdown { id, .. }
+        | ModComponent::Code { id, .. } => {
+            ids.insert(id.clone());
+        }
+        ModComponent::Slot => {}
+    }
+}
+
+fn valid_focus_targets(
+    bindings: &BTreeMap<String, ModKeyAction>,
+    sites: &BTreeMap<String, ModRenderSite>,
+) -> bool {
+    let mut ids = BTreeSet::new();
+    for site in sites.values() {
+        for component in &site.components {
+            component_ids(component, &mut ids);
+        }
+    }
+    bindings.values().all(|action| match action {
+        ModKeyAction::Focus { focus } => ids.contains(focus),
+        _ => true,
+    })
+}
+
+fn replace_slot(components: Vec<ModComponent>, current: &[ModComponent]) -> Vec<ModComponent> {
+    components
+        .into_iter()
+        .flat_map(|component| match component {
+            ModComponent::Slot => current.to_vec(),
+            ModComponent::Box {
+                id,
+                label,
+                title,
+                children,
+            } => vec![ModComponent::Box {
+                id,
+                label,
+                title,
+                children: replace_slot(children, current),
+            }],
+            ModComponent::Pane {
+                id,
+                label,
+                title,
+                collapsed,
+                scroll,
+                children,
+            } => vec![ModComponent::Pane {
+                id,
+                label,
+                title,
+                collapsed,
+                scroll,
+                children: replace_slot(children, current),
+            }],
+            ModComponent::Dialog {
+                id,
+                label,
+                title,
+                children,
+            } => vec![ModComponent::Dialog {
+                id,
+                label,
+                title,
+                children: replace_slot(children, current),
+            }],
+            component => vec![component],
+        })
+        .collect()
+}
+
+impl ModThemePatch {
+    fn apply(self, target: &mut ModTheme) {
+        macro_rules! assign {
+            ($field:ident) => {
+                if self.$field.is_some() {
+                    target.$field = self.$field;
+                }
+            };
+        }
+        assign!(accent);
+        assign!(user_message_background);
+        assign!(syntax);
+        assign!(success);
+        assign!(attention);
+        assign!(failure);
+        assign!(diff_added);
+        assign!(diff_removed);
+        assign!(muted);
+        if let Some(border) = self.border {
+            target.border = border;
+        }
+        if let Some(density) = self.density {
+            target.density = density;
+        }
+        if let Some(icons) = self.icons {
+            target.icons = icons;
+        }
+    }
+}
+
+impl ModViewPatch {
+    pub fn parse(value: Value) -> Result<Self> {
+        let patch: Self = serde_json::from_value(value)?;
+        if patch.sidebar_width.is_some_and(|width| width > 60)
+            || patch
+                .title
+                .as_ref()
+                .is_some_and(|title| !visible(title, 1024))
+            || !valid_sites(&patch.sites, true)
+            || !valid_status(&patch.status)
+            || !valid_bindings(&patch.keybindings)
+            || !valid_templates(&patch.message_template, &patch.tool_template)
+            || patch
+                .theme
+                .syntax
+                .as_ref()
+                .is_some_and(|syntax| syntax.is_empty() || !visible(syntax, 128))
+            || serde_json::to_vec(&patch)?.len() > 16_384
+        {
+            return Err(failure("invalid_terminal_patch"));
+        }
+        Ok(patch)
+    }
+
+    pub fn apply(
+        self,
+        target: &mut ModView,
+        replaced_sites: &mut BTreeSet<String>,
+        completed_tools_owner: &mut bool,
+    ) -> Result<()> {
+        let mut candidate = target.clone();
+        let mut candidate_sites = replaced_sites.clone();
+        let mut candidate_completed_tools = *completed_tools_owner;
+        self.apply_to(
+            &mut candidate,
+            &mut candidate_sites,
+            &mut candidate_completed_tools,
+        )?;
+        *target = candidate;
+        *replaced_sites = candidate_sites;
+        *completed_tools_owner = candidate_completed_tools;
+        Ok(())
+    }
+
+    fn apply_to(
+        self,
+        target: &mut ModView,
+        replaced_sites: &mut BTreeSet<String>,
+        completed_tools_owner: &mut bool,
+    ) -> Result<()> {
+        if let Some(title) = self.title {
+            target.title = Some(title);
+        }
+        if let Some(foreground) = self.foreground {
+            target.foreground = Some(foreground);
+        }
+        if let Some(background) = self.background {
+            target.background = Some(background);
+        }
+        if let Some(width) = self.sidebar_width {
+            target.sidebar_width = width;
+        }
+        if let Some(side) = self.sidebar_side {
+            target.sidebar_side = side;
+        }
+        for (name, site) in self.sites {
+            match site.mode {
+                ModSiteMode::Replace => {
+                    if !replaced_sites.insert(name.clone()) {
+                        return Err(failure(format!("terminal_site_conflict: {name}")));
+                    }
+                    target.sites.insert(name, site);
+                }
+                ModSiteMode::Wrap => {
+                    let current = target
+                        .sites
+                        .get(&name)
+                        .map(|site| site.components.as_slice())
+                        .unwrap_or_default();
+                    target.sites.insert(
+                        name,
+                        ModRenderSite {
+                            mode: ModSiteMode::Replace,
+                            components: replace_slot(site.components, current),
+                        },
+                    );
+                }
+            }
+        }
+        for (key, action) in self.keybindings {
+            if target.keybindings.insert(key.clone(), action).is_some() {
+                return Err(failure(format!("terminal_key_conflict: {key}")));
+            }
+        }
+        target.status.extend(self.status);
+        if target.status.len() > 4 {
+            return Err(failure("terminal_status_limit"));
+        }
+        self.theme.apply(&mut target.theme);
+        if let Some(mode) = self.completed_tools {
+            if *completed_tools_owner {
+                return Err(failure("terminal_completed_tools_conflict"));
+            }
+            *completed_tools_owner = true;
+            target.completed_tools = mode;
+        }
+        if let Some(template) = self.message_template {
+            target.message_template = Some(match target.message_template.take() {
+                Some(current) => template.replace("{text}", &current),
+                None => template,
+            });
+        }
+        if let Some(template) = self.tool_template {
+            target.tool_template = Some(match target.tool_template.take() {
+                Some(current) => template.replace("{text}", &current),
+                None => template,
+            });
+        }
+        ModView::parse(serde_json::to_value(target.clone())?)?;
+        Ok(())
+    }
+}
+
+impl ModView {
+    pub fn parse(value: Value) -> Result<Self> {
+        let view: Self = serde_json::from_value(value)?;
+        if view.sidebar_width > 60
+            || view.panels.len() > 8
+            || view
+                .title
+                .as_ref()
+                .is_some_and(|title| !visible(title, 1024))
+            || !valid_templates(&view.message_template, &view.tool_template)
+            || view.panels.iter().any(|panel| !panel.valid(32))
+            || [&view.header, &view.footer]
+                .into_iter()
+                .flatten()
+                .any(|panel| !panel.valid(3))
+            || !valid_sites(&view.sites, false)
+            || !valid_status(&view.status)
+            || !valid_bindings(&view.keybindings)
+            || !valid_focus_targets(&view.keybindings, &view.sites)
+            || view
+                .theme
+                .syntax
+                .as_ref()
+                .is_some_and(|syntax| syntax.is_empty() || !visible(syntax, 128))
+            || serde_json::to_vec(&view)?.len() > 16_384
+        {
+            return Err(failure("invalid_terminal_view"));
+        }
+        Ok(view)
+    }
+
+    pub fn read(path: &Path) -> Result<Self> {
+        Ok(ModViewSnapshot::read(path)?.view)
+    }
+}
+
+impl ModViewSnapshot {
+    pub fn read(path: &Path) -> Result<Self> {
+        let value: Value = serde_json::from_slice(&store::read(path, 131_072)?)?;
+        let mut snapshot: Self = serde_json::from_value(value)?;
+        snapshot.view = ModView::parse(serde_json::to_value(&snapshot.view)?)?;
+        if snapshot
+            .progress
+            .as_ref()
+            .is_some_and(|panel| !panel.valid(8))
+            || snapshot.activity.len() > 32
+            || snapshot.contributors.len() > 16
+            || snapshot
+                .contributors
+                .iter()
+                .any(|contributor| !identifier(contributor))
+            || serde_json::to_vec(&snapshot.input)?.len() > 65_536
+            || snapshot.diagnostics.len() > 16
+            || snapshot
+                .diagnostics
+                .iter()
+                .any(|diagnostic| !visible(diagnostic, 512))
+            || snapshot.activity.iter().any(|activity| {
+                !visible(&activity.label, 128)
+                    || !visible(&activity.tool, 128)
+                    || !visible(&activity.status, 32)
+                    || !identifier(&activity.mod_id)
+            })
+        {
+            return Err(failure("invalid_terminal_snapshot"));
+        }
+        Ok(snapshot)
+    }
+}
diff --git a/codex-rs/omd/src/reactive.rs b/codex-rs/omd/src/reactive.rs
new file mode 100644
index 0000000..f28113b
--- /dev/null
+++ b/codex-rs/omd/src/reactive.rs
@@ -0,0 +1,264 @@
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::io;
+use std::sync::Mutex;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum ReactiveScope {
+    Lead,
+    Worker,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum ReactiveToolOutcome {
+    CompletedHostSuccess,
+    CompletedHostFailure,
+    Blocked,
+    FailedBeforeExecution,
+    FailedAfterExecution,
+    Aborted,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(tag = "event", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ReactiveTrigger {
+    ToolFinished {
+        tool: String,
+        outcome: ReactiveToolOutcome,
+    },
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReactiveRule {
+    pub id: String,
+    pub scope: ReactiveScope,
+    pub trigger: ReactiveTrigger,
+    pub instruction: String,
+    pub max_activations: u32,
+    pub max_context_reactivations: u32,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ReactiveRuleSet {
+    pub schema: u32,
+    pub version: String,
+    pub rules: Vec<ReactiveRule>,
+}
+
+#[derive(Clone, Debug, Serialize, Eq, PartialEq)]
+pub struct ReactiveActivation {
+    pub rule_id: String,
+    pub rule_set_version: String,
+    pub source: String,
+    pub source_sha256: String,
+    pub scope: ReactiveScope,
+    pub trigger: ReactiveTrigger,
+    pub activation: u32,
+    pub max_activations: u32,
+    pub executed_effects_rolled_back: bool,
+    pub retry_started: bool,
+    #[serde(skip)]
+    instruction: String,
+}
+
+#[derive(Clone)]
+struct ActiveRule {
+    activation: ReactiveActivation,
+    remaining_context_reactivations: u32,
+}
+
+#[derive(Default)]
+struct ReactiveState {
+    activations: BTreeMap<String, u32>,
+    active: BTreeMap<(String, String), ActiveRule>,
+}
+
+pub struct ReactiveRules {
+    rule_set: ReactiveRuleSet,
+    source: String,
+    source_sha256: String,
+    state: Mutex<ReactiveState>,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::other(message)
+}
+
+fn valid_token(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 64
+        && value.bytes().enumerate().all(|(index, byte)| {
+            byte.is_ascii_lowercase()
+                || byte.is_ascii_digit()
+                || (index > 0 && matches!(byte, b'.' | b'_' | b'-'))
+        })
+}
+
+fn valid_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn valid_tool(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.' | b':' | b'/')
+        })
+}
+
+fn valid_instruction(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 512
+        && value.trim() == value
+        && !value.contains(['\r', '\n'])
+}
+
+impl ReactiveRuleSet {
+    pub fn validate(&self) -> io::Result<()> {
+        if self.schema != 1 || !valid_token(&self.version) || !(1..=16).contains(&self.rules.len())
+        {
+            return Err(invalid("invalid reactive rule set"));
+        }
+        let mut ids = BTreeSet::new();
+        let mut matches = BTreeSet::new();
+        for rule in &self.rules {
+            let ReactiveTrigger::ToolFinished { tool, .. } = &rule.trigger;
+            if !valid_token(&rule.id)
+                || !ids.insert(rule.id.as_str())
+                || !valid_tool(tool)
+                || !valid_instruction(&rule.instruction)
+                || !(1..=8).contains(&rule.max_activations)
+                || rule.max_context_reactivations > 4
+                || !matches.insert((rule.scope, rule.trigger.clone()))
+            {
+                return Err(invalid("invalid or ambiguous reactive rule"));
+            }
+        }
+        if serde_json::to_vec(self)?.len() > 65_536 {
+            return Err(invalid("reactive rule set exceeds size limit"));
+        }
+        Ok(())
+    }
+}
+
+impl ReactiveActivation {
+    pub fn prompt(&self) -> String {
+        format!(
+            "A scoped reactive rule was activated after the host observed an exact tool outcome. Rule {} from rule set {} at {} with SHA256 {} says: {} This developer-capability guidance is subordinate to current user and project instructions. The triggering call has already reached its recorded outcome; no executed effect was rolled back. This activation does not start a retry. Any follow-up model request or retry remains subject to the shared task allowance and request accounting.",
+            self.rule_id, self.rule_set_version, self.source, self.source_sha256, self.instruction
+        )
+    }
+
+    pub fn context_prompt(&self) -> String {
+        format!("Reactivated after a context rebuild: {}", self.prompt())
+    }
+}
+
+impl ReactiveRules {
+    pub fn new(
+        rule_set: ReactiveRuleSet,
+        source: String,
+        source_sha256: String,
+    ) -> io::Result<Self> {
+        rule_set.validate()?;
+        if source.is_empty() || source.len() > 4096 || !valid_sha256(&source_sha256) {
+            return Err(invalid("invalid reactive rule provenance"));
+        }
+        Ok(Self {
+            rule_set,
+            source,
+            source_sha256,
+            state: Mutex::new(ReactiveState::default()),
+        })
+    }
+
+    pub fn rule_set(&self) -> &ReactiveRuleSet {
+        &self.rule_set
+    }
+
+    pub fn source(&self) -> &str {
+        &self.source
+    }
+
+    pub fn source_sha256(&self) -> &str {
+        &self.source_sha256
+    }
+
+    pub fn activate(
+        &self,
+        thread: &str,
+        owner: &str,
+        trigger: &ReactiveTrigger,
+    ) -> io::Result<Option<ReactiveActivation>> {
+        if thread.is_empty() || thread.len() > 256 || owner.is_empty() || owner.len() > 256 {
+            return Err(invalid("invalid reactive activation identity"));
+        }
+        let scope = if owner == "lead" {
+            ReactiveScope::Lead
+        } else {
+            ReactiveScope::Worker
+        };
+        let Some(rule) = self
+            .rule_set
+            .rules
+            .iter()
+            .find(|rule| rule.scope == scope && &rule.trigger == trigger)
+        else {
+            return Ok(None);
+        };
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| invalid("reactive rule lock poisoned"))?;
+        let count = state.activations.entry(rule.id.clone()).or_default();
+        if *count >= rule.max_activations {
+            return Ok(None);
+        }
+        *count += 1;
+        let activation = ReactiveActivation {
+            rule_id: rule.id.clone(),
+            rule_set_version: self.rule_set.version.clone(),
+            source: self.source.clone(),
+            source_sha256: self.source_sha256.clone(),
+            scope: rule.scope,
+            trigger: rule.trigger.clone(),
+            activation: *count,
+            max_activations: rule.max_activations,
+            executed_effects_rolled_back: false,
+            retry_started: false,
+            instruction: rule.instruction.clone(),
+        };
+        state.active.insert(
+            (thread.to_owned(), rule.id.clone()),
+            ActiveRule {
+                activation: activation.clone(),
+                remaining_context_reactivations: rule.max_context_reactivations,
+            },
+        );
+        Ok(Some(activation))
+    }
+
+    pub fn context_prompts(&self, thread: &str) -> io::Result<Vec<String>> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| invalid("reactive rule lock poisoned"))?;
+        let mut prompts = Vec::new();
+        for ((active_thread, _), active) in &mut state.active {
+            if active_thread == thread && active.remaining_context_reactivations > 0 {
+                active.remaining_context_reactivations -= 1;
+                prompts.push(active.activation.context_prompt());
+            }
+        }
+        Ok(prompts)
+    }
+}
