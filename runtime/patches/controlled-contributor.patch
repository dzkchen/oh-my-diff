+                        .map_err(|e| e.to_string())?,
+                    ))
+                }
+                TurnItem::CollabAgentToolCall(output)
+                    if !matches!(
+                        output.status,
+                        codex_protocol::items::CollabAgentToolCallStatus::InProgress
+                    ) =>
+                {
+                    Some((
+                        output.id.as_str(),
+                        serde_json::to_vec(&(
+                            output.status,
+                            &output.receiver_thread_ids,
+                            &output.receiver_agents,
