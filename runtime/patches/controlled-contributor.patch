+    const FAKE_SERVER: &str = r#"
+import json, sys
+
+def read():
+    length = None
+    while True:
+        line = sys.stdin.buffer.readline()
+        if not line:
+            raise SystemExit
+        if line in (b'\r\n', b'\n'):
