+use codex_omd::GraphLimits;
+use codex_omd::HealthBaseline;
+use codex_omd::HealthConstraints;
+use serde::Serialize;
+use std::error::Error;
+use std::io;
+use std::path::Path;
+
+type AppResult<T> = Result<T, Box<dyn Error>>;
+
+fn print<T: Serialize>(value: &T) -> AppResult<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+
+fn run(args: Vec<String>) -> AppResult<bool> {
+    match args.as_slice() {
+        [_, command, repository, constraints_path, baseline_path, revision]
+            if command == "baseline" =>
+        {
+            let constraints = HealthConstraints::read(Path::new(constraints_path))?;
+            let baseline = HealthBaseline::build(
+                Path::new(repository),
+                &constraints,
+                revision.clone(),
+                GraphLimits::default(),
+            )?;
+            baseline.write(Path::new(baseline_path))?;
+            print(&baseline)?;
+            Ok(false)
+        }
+        [_, command, repository, constraints_path, baseline_path, report_path, revision]
+            if command == "check" =>
+        {
+            let constraints = HealthConstraints::read(Path::new(constraints_path))?;
+            let baseline = HealthBaseline::read(Path::new(baseline_path))?;
+            let report = baseline.check(Path::new(repository), &constraints, revision.clone())?;
+            report.write(Path::new(report_path))?;
+            print(&report)?;
+            Ok(report.has_introduced_findings())
+        }
+        _ => Err(io::Error::other(
+            "usage: omd-health baseline REPOSITORY CONSTRAINTS BASELINE REVISION | check REPOSITORY CONSTRAINTS BASELINE REPORT REVISION",
+        )
+        .into()),
+    }
+}
+
+fn main() {
+    match run(std::env::args().collect()) {
+        Ok(true) => std::process::exit(2),
+        Ok(false) => {}
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-knowledge.rs b/codex-rs/omd/src/bin/omd-knowledge.rs
new file mode 100644
index 0000000..23ccec1
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-knowledge.rs
@@ -0,0 +1,90 @@
+use codex_omd::KnowledgeApproval;
+use codex_omd::KnowledgeMode;
+use codex_omd::KnowledgeRemoval;
+use codex_omd::KnowledgeReset;
+use codex_omd::KnowledgeStore;
+use codex_omd::LessonCandidate;
+use codex_omd::SourceFactInput;
+use codex_omd::TaskEvidenceInput;
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use std::error::Error;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+type AppResult<T> = Result<T, Box<dyn Error>>;
+
+fn read<T: DeserializeOwned>(path: &Path) -> AppResult<T> {
+    let bytes = std::fs::read(path)?;
+    if bytes.len() > 1_048_576 {
+        return Err(io::Error::other("input exceeds size limit").into());
+    }
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+fn print<T: Serialize>(value: &T) -> AppResult<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+
+fn mode(value: &str) -> AppResult<KnowledgeMode> {
+    match value {
+        "cold" => Ok(KnowledgeMode::Cold),
+        "reuse" => Ok(KnowledgeMode::Reuse),
+        _ => Err(io::Error::other("knowledge state must be cold or reuse").into()),
+    }
+}
+
+fn run(args: Vec<String>) -> AppResult<()> {
+    let [_, command, root, rest @ ..] = args.as_slice() else {
+        return Err(io::Error::other("usage: omd-knowledge COMMAND STORE [ARG ...]").into());
+    };
+    let root = PathBuf::from(root)
+        .canonicalize()
+        .unwrap_or_else(|_| PathBuf::from(root));
+    if command == "init" {
+        let [repository_identity] = rest else {
+            return Err(io::Error::other("usage: omd-knowledge init STORE REPOSITORY_ID").into());
+        };
+        return print(
+            &KnowledgeStore::create(root, repository_identity.clone())?
+                .inspect(Path::new(".").canonicalize()?.as_path())?,
+        );
+    }
+    let store = KnowledgeStore::open(root)?;
+    match (command.as_str(), rest) {
+        ("retain-evidence", [path]) => {
+            print(&store.retain_evidence(read::<TaskEvidenceInput>(Path::new(path))?)?)
+        }
+        ("retain-fact", [repository, path]) => print(&store.retain_source_fact(
+            &Path::new(repository).canonicalize()?,
+            read::<SourceFactInput>(Path::new(path))?,
+        )?),
+        ("propose-lesson", [path]) => {
+            print(&store.propose_lesson(read::<LessonCandidate>(Path::new(path))?)?)
+        }
+        ("approve-lesson", [path]) => {
+            print(&store.approve_lesson(read::<KnowledgeApproval>(Path::new(path))?)?)
+        }
+        ("inspect", [repository]) => print(&store.inspect(&Path::new(repository).canonicalize()?)?),
+        ("session", [repository, state]) => print(&store.session(
+            &Path::new(repository).canonicalize()?,
+            mode(state)?,
+            262_144,
+        )?),
+        ("remove", [path]) => {
+            store.remove(read::<KnowledgeRemoval>(Path::new(path))?)?;
+            print(&store.revision()?)
+        }
+        ("reset", [path]) => print(&store.reset(read::<KnowledgeReset>(Path::new(path))?)?),
+        _ => Err(io::Error::other("usage: omd-knowledge COMMAND STORE [ARG ...]").into()),
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().collect()) {
+        eprintln!("{error}");
+        std::process::exit(1);
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-lsp.rs b/codex-rs/omd/src/bin/omd-lsp.rs
new file mode 100644
index 0000000..556a4c7
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-lsp.rs
@@ -0,0 +1,180 @@
+use codex_omd::LspAdapterRequest;
+use codex_omd::LspLanguage;
+use codex_omd::LspLimits;
+use codex_omd::LspPreferenceStore;
+use codex_omd::LspWorkspaceBindingStore;
+use codex_omd::detect_installed_servers;
+use codex_omd::execute_lsp_adapter_request;
+use codex_omd::lsp_workspace_binding_path;
+use serde::Serialize;
+use serde_json::json;
+use std::error::Error;
+use std::io;
+use std::io::Read;
+use std::path::PathBuf;
+
+type AppResult<T> = Result<T, Box<dyn Error>>;
+
+fn print<T: Serialize>(value: &T) -> AppResult<()> {
+    println!("{}", serde_json::to_string_pretty(value)?);
+    Ok(())
+}
+
+fn language(value: &str) -> AppResult<LspLanguage> {
+    match value {
+        "rust" => Ok(LspLanguage::Rust),
+        "typescript" => Ok(LspLanguage::TypeScript),
+        "javascript" => Ok(LspLanguage::JavaScript),
+        "python" => Ok(LspLanguage::Python),
+        "java" => Ok(LspLanguage::Java),
+        _ => Err(io::Error::other(
+            "language must be rust, typescript, javascript, python, or java",
+        )
+        .into()),
+    }
+}
+
+fn canonical_repository(value: &str) -> AppResult<PathBuf> {
+    let supplied = PathBuf::from(value);
+    if !supplied.is_absolute() || supplied.is_symlink() {
+        return Err(io::Error::other(
+            "repository must be a canonical absolute directory without a symlink endpoint",
+        )
+        .into());
+    }
+    let repository = supplied.canonicalize()?;
+    if supplied != repository || !repository.is_dir() {
+        return Err(io::Error::other(
+            "repository must be a canonical absolute directory without symlink traversal",
+        )
+        .into());
+    }
+    Ok(repository)
+}
+
+fn adapter(
+    repository: &str,
+    store: &str,
+    repository_identity: &str,
+    language_name: &str,
+) -> AppResult<()> {
+    let repository = canonical_repository(repository)?;
+    let supplied_store_path = PathBuf::from(store);
+    if !supplied_store_path.is_absolute() || supplied_store_path.is_symlink() {
+        return Err(io::Error::other(
+            "preference store must be an existing canonical absolute file without symlink traversal",
+        )
+        .into());
+    }
+    let store_path = supplied_store_path.canonicalize()?;
+    if supplied_store_path != store_path || !store_path.is_file() {
+        return Err(io::Error::other(
+            "preference store must be an existing canonical absolute file without symlink traversal",
+        )
+        .into());
+    }
+    let language = language(language_name)?;
+    let mut input = Vec::new();
+    io::stdin().take(1024 * 1024 + 1).read_to_end(&mut input)?;
+    if input.len() > 1024 * 1024 {
+        return Err(io::Error::other("adapter request exceeds the 1 MiB limit").into());
+    }
+    let request: LspAdapterRequest = serde_json::from_slice(&input)?;
+    let command = request.command();
+    let preferences = LspPreferenceStore::open(store_path.clone())?;
+    let preference = preferences.preference(repository_identity);
+    let binding_path = lsp_workspace_binding_path(&store_path)?;
+    let bindings = LspWorkspaceBindingStore::open(binding_path)?;
+    if !preference.is_some_and(|preference| preference.enabled)
+        || !bindings.matches(repository_identity, &repository)
+    {
+        return print(&json!({
+            "schema": 1,
+            "status": "unsupported",
+            "language": language,
+            "command": command,
+            "reason": "semantic LSP is not enabled for the exact repository identity and canonical workspace",
+            "fallback": "Bind and enable the repository explicitly with omd-lsp preference before using semantic tools; until then use ordinary search, edits, and executable checks.",
+            "repository_identity": repository_identity,
+            "opt_in": "disabled",
+        }));
+    }
+    let revision = preference.map(|preference| preference.revision);
+    let binding_revision = bindings
+        .binding(repository_identity)
+        .map(|binding| binding.revision);
+    let mut result =
+        execute_lsp_adapter_request(repository, language, LspLimits::default(), None, request);
+    result["repository_identity"] = json!(repository_identity);
+    result["preference_revision"] = json!(revision);
+    result["workspace_binding_revision"] = json!(binding_revision);
+    result["opt_in"] = json!("enabled");
+    print(&result)
+}
+
+fn run(args: Vec<String>) -> AppResult<()> {
+    match args.as_slice() {
+        [_, command] if command == "detect" => print(&detect_installed_servers()),
+        [_, command, store, repository_identity, enabled] if command == "preference" => {
+            let enabled = match enabled.as_str() {
+                "enabled" => true,
+                "disabled" => false,
+                _ => return Err(io::Error::other("preference must be enabled or disabled").into()),
+            };
+            let mut store = LspPreferenceStore::open(PathBuf::from(store))?;
+            print(&store.set(repository_identity.clone(), enabled)?)
+        }
+        [_, command, store, repository_identity, enabled, repository]
+            if command == "preference" =>
+        {
+            let enabled = match enabled.as_str() {
+                "enabled" => true,
+                "disabled" => false,
+                _ => return Err(io::Error::other("preference must be enabled or disabled").into()),
+            };
+            let store_path = PathBuf::from(store);
+            let mut store = LspPreferenceStore::open(store_path.clone())?;
+            let preference = store.set(repository_identity.clone(), enabled)?;
+            let binding_path = lsp_workspace_binding_path(&store_path)?;
+            let mut bindings = LspWorkspaceBindingStore::open(binding_path.clone())?;
+            let binding = bindings.set(
+                repository_identity.clone(),
+                canonical_repository(repository)?,
+            )?;
+            print(&json!({
+                "preference": preference,
+                "workspace_binding": binding,
+                "workspace_binding_store": binding_path,
+            }))
+        }
+        [_, command, store, repository_identity] if command == "status" => {
+            let store_path = PathBuf::from(store);
+            let store = LspPreferenceStore::open(store_path.clone())?;
+            let binding_path = lsp_workspace_binding_path(&store_path)?;
+            let bindings = LspWorkspaceBindingStore::open(binding_path.clone())?;
+            print(&json!({
+                "repository_identity": repository_identity,
+                "preference": store.preference(repository_identity),
+                "workspace_binding": bindings.binding(repository_identity),
+                "workspace_binding_store": binding_path,
+                "installed_servers": detect_installed_servers(),
+            }))
+        }
+        [_, command, repository, store, repository_identity, language]
+            if command == "adapter" =>
+        {
+            adapter(repository, store, repository_identity, language)
+        }
+        _ => Err(io::Error::other(
+            "usage: omd-lsp detect | preference STORE REPOSITORY_ID enabled|disabled [REPOSITORY] | status STORE REPOSITORY_ID | adapter REPOSITORY STORE REPOSITORY_ID LANGUAGE < REQUEST.json",
+        )
+        .into()),
+    }
+}
+
+fn main() {
+    if let Err(error) = run(std::env::args().collect()) {
+        eprintln!("{error}");
+        std::process::exit(1);
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-mod.rs b/codex-rs/omd/src/bin/omd-mod.rs
new file mode 100644
index 0000000..4dacfe7
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-mod.rs
@@ -0,0 +1,317 @@
+use codex_omd::ModHost;
+use codex_omd::ModInstallRequest;
+use codex_omd::ModStore;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn plugin_files(root: &std::path::Path) -> io::Result<BTreeMap<String, String>> {
+    let mut files = BTreeMap::new();
+    let mut pending = vec![root.to_path_buf()];
+    let mut total = 0_u64;
+    while let Some(directory) = pending.pop() {
+        for entry in fs::read_dir(&directory)? {
+            let entry = entry?;
+            let kind = entry.file_type()?;
+            if kind.is_symlink() {
+                return Err(io::Error::other("plugin_preview_symlink_refused"));
+            }
+            if kind.is_dir() {
+                pending.push(entry.path());
+                continue;
+            }
+            if !kind.is_file() || files.len() >= 512 {
+                return Err(io::Error::other("plugin_preview_file_limit"));
+            }
+            let entry_path = entry.path();
+            let bytes = fs::read(&entry_path)?;
+            total += bytes.len() as u64;
+            if total > 16_777_216 {
+                return Err(io::Error::other("plugin_preview_size_limit"));
+            }
+            let path = entry_path.strip_prefix(root).map_err(io::Error::other)?;
+            files.insert(
+                path.to_string_lossy().into_owned(),
+                format!("{:x}", Sha256::digest(bytes)),
+            );
+        }
+    }
+    Ok(files)
+}
+
+fn plugin_preview(codex: &str, home: &str, id: &str, candidate: &str) -> io::Result<Value> {
+    let (name, marketplace) = id
+        .split_once('@')
+        .ok_or_else(|| io::Error::other("plugin_id_requires_name_at_marketplace"))?;
+    if [name, marketplace].iter().any(|part| {
+        part.is_empty()
+            || !part
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+    }) {
+        return Err(io::Error::other("invalid_plugin_id"));
+    }
+    let home = PathBuf::from(home).canonicalize()?;
+    let candidate = PathBuf::from(candidate).canonicalize()?;
+    let output = Command::new(codex)
+        .env("CODEX_HOME", &home)
+        .args(["plugin", "list", "--json", "--marketplace", marketplace])
+        .output()?;
+    if !output.status.success() {
+        return Err(io::Error::other(
+            String::from_utf8_lossy(&output.stderr).into_owned(),
+        ));
+    }
+    let listing: Value = serde_json::from_slice(&output.stdout)?;
+    let installed = listing["installed"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .find(|entry| entry["pluginId"] == id)
+        .ok_or_else(|| io::Error::other("plugin_not_installed"))?;
+    if installed["source"]["source"] != "local" {
+        return Err(io::Error::other("plugin_preview_requires_local_source"));
+    }
+    let version = installed["version"]
+        .as_str()
+        .ok_or_else(|| io::Error::other("installed_plugin_version_missing"))?;
+    if !version
+        .bytes()
+        .all(|byte| byte.is_ascii_alphanumeric() || byte == b'.' || byte == b'-' || byte == b'_')
+    {
+        return Err(io::Error::other("invalid_installed_plugin_version"));
+    }
+    let installed_path = home
+        .join("plugins/cache")
+        .join(marketplace)
+        .join(name)
+        .join(version);
+    let manifest: Value =
+        serde_json::from_slice(&fs::read(candidate.join(".codex-plugin/plugin.json"))?)?;
+    if manifest["name"] != name || !manifest["version"].is_string() {
+        return Err(io::Error::other("candidate_plugin_manifest_mismatch"));
+    }
+    let current = plugin_files(&installed_path)?;
+    let proposed = plugin_files(&candidate)?;
+    let paths = current
+        .keys()
+        .chain(proposed.keys())
+        .collect::<std::collections::BTreeSet<_>>();
+    let changes = paths
+        .into_iter()
+        .filter_map(|path| {
+            let before = current.get(path);
+            let after = proposed.get(path);
+            (before != after).then(
+                || serde_json::json!({"path":path,"before_sha256":before,"after_sha256":after}),
+            )
+        })
+        .collect::<Vec<_>>();
+    Ok(serde_json::json!({
+        "plugin": id,
+        "installed_version": version,
+        "candidate_version": manifest["version"],
+        "installed_enabled": installed["enabled"],
+        "installed_path": installed_path,
+        "candidate_path": candidate,
+        "changes": changes,
+        "same_version_changed": manifest["version"] == version && current != proposed,
+        "applied": false,
+        "note": "This is a read-only local file preview. Codex still owns plugin installation and hook trust."
+    }))
+}
+
+fn run(args: &[String]) -> io::Result<Value> {
+    let bad = || {
+        io::Error::other(
+            "usage: omd-mod init STORE NODE | inspect PACKAGE | trust STORE PACKAGE SHA256 CAPABILITIES_CSV [user|project] | enable/disable STORE PACKAGE | package-plan STORE REQUEST_JSON | package-apply STORE REQUEST_JSON CONFIRMATION | package-lock STORE | package-enable/package-disable STORE ID | package-rollback-plan/package-uninstall-plan STORE ID | package-rollback/package-uninstall STORE ID CONFIRMATION | plugin-preview CODEX_BIN CODEX_HOME NAME@MARKETPLACE CANDIDATE | status/selection-status/reload/report/events/declarations STORE | test STORE SCENARIO_JSON | diagnostics STORE OUTPUT_JSON | explain DENIAL | discover USER_DIR PROJECT_DIR | pi-discover USER_AGENT_DIR PROJECT_ROOT | settings STORE PACKAGE JSON | migrate STORE PACKAGE | rollback STORE PACKAGE BACKUP | command STORE MOD NAME JSON",
+        )
+    };
+    match args {
+        [command, codex, home, id, candidate] if command == "plugin-preview" => {
+            plugin_preview(codex, home, id, candidate)
+        }
+        [command, root, request] if command == "package-plan" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_plan(serde_json::from_str::<ModInstallRequest>(request)?)
+                .and_then(|plan| serde_json::to_value(plan).map_err(io::Error::other))
+        }
+        [command, root, request, confirmation] if command == "package-apply" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_apply(
+                    serde_json::from_str::<ModInstallRequest>(request)?,
+                    confirmation,
+                )
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root] if command == "package-lock" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_lock()
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_disable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-enable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_enable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id]
+            if command == "package-rollback-plan" || command == "package-uninstall-plan" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let plan = if command == "package-rollback-plan" {
+                store.package_rollback_plan(id)?
+            } else {
+                store.package_uninstall_plan(id)?
+            };
+            serde_json::to_value(plan).map_err(io::Error::other)
+        }
+        [command, root, id, confirmation]
+            if command == "package-rollback" || command == "package-uninstall" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let lock = if command == "package-rollback" {
+                store.package_rollback(id, confirmation)?
+            } else {
+                store.package_uninstall(id, confirmation)?
+            };
+            serde_json::to_value(lock).map_err(io::Error::other)
+        }
+        [command, user, project] if command == "pi-discover" => {
+            ModStore::discover_pi(&PathBuf::from(user), &PathBuf::from(project))
+        }
+        [command, user, project] if command == "discover" => {
+            ModStore::discover(&PathBuf::from(user), &PathBuf::from(project))
+        }
+        [command, root, path, settings] if command == "settings" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.settings(
+                &PathBuf::from(path).canonicalize()?,
+                serde_json::from_str(settings)?,
+            )?;
+            Ok(Value::String(
+                "settings saved for next turn boundary".into(),
+            ))
+        }
+        [command, root, path] if command == "migrate" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .migrate(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, backup] if command == "rollback" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .rollback(&PathBuf::from(path).canonicalize()?, &PathBuf::from(backup))
+        }
+        [command, root, node] if command == "init" => {
+            ModStore::create(PathBuf::from(root), PathBuf::from(node))?;
+            Ok(Value::String("created".into()))
+        }
+        [command, path] if command == "inspect" => {
+            ModStore::inspect_package(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, sha, capabilities] | [command, root, path, sha, capabilities, _]
+            if command == "trust" =>
+        {
+            let scope = match args {
+                [.., scope] if args.len() == 6 => scope.as_str(),
+                _ => "user",
+            };
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.trust(
+                PathBuf::from(path).canonicalize()?,
+                sha,
+                capabilities
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(str::to_string)
+                    .collect(),
+                scope,
+            )?;
+            Ok(Value::String(format!(
+                "trusted in the {scope} scope; disabled until explicitly enabled"
+            )))
+        }
+        [command, root, path] if command == "enable" || command == "disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .enable(&PathBuf::from(path), command == "enable")?;
+            Ok(Value::String(
+                "selection saved; takes effect at the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "reload" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.reload()?;
+            Ok(Value::String(
+                "reload queued for the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "status" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.status())
+        }
+        [command, root] if command == "selection-status" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.selection_status()
+        }
+        [command, root] if command == "report" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"mods":status["mods"].as_array()
+                .into_iter().flatten().map(|item| serde_json::json!({
+                    "id":item["id"],"declared":{"capabilities":item["capabilities"],
+                        "services":item["services"]},"used":item["source_use"],
+                    "unused_grants":item["unused_grants"],
+                    "unused_environment":item["unused_environment"],"error":item["error"]
+                })).collect::<Vec<_>>() }),
+            )
+        }
+        [command, root] if command == "events" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.author_inspection())
+        }
+        [command, root] if command == "declarations" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"active_host":status["active_host_types"],
+                "installed_contracts":status["installed_contract_types"]}),
+            )
+        }
+        [command, root, scenario] if command == "test" => {
+            let scenario: Value = serde_json::from_slice(&std::fs::read(scenario)?)?;
+            ModHost::open(PathBuf::from(root).canonicalize()?)?.offline_test(scenario)
+        }
+        [command, root, output] if command == "diagnostics" => {
+            let bundle = ModHost::open(PathBuf::from(root).canonicalize()?)?.diagnostic_bundle();
+            let output = PathBuf::from(output);
+            std::fs::write(&output, serde_json::to_vec_pretty(&bundle)?)?;
+            Ok(serde_json::json!({"bundle":output,"redacted":true}))
+        }
+        [command, denial] if command == "explain" => Ok(ModHost::capability_explanation(denial)),
+        [command, root, id, name, payload] if command == "command" => {
+            let mut host = ModHost::open(PathBuf::from(root).canonicalize()?)?;
+            host.invoke(
+                id,
+                host.generation(),
+                "command",
+                name,
+                serde_json::from_str(payload)?,
+            )
+        }
+        _ => Err(bad()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => println!(
+            "{}",
+            serde_json::to_string_pretty(&value).unwrap_or_default()
+        ),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/checkpoint.rs b/codex-rs/omd/src/checkpoint.rs
new file mode 100644
index 0000000..be18550
--- /dev/null
+++ b/codex-rs/omd/src/checkpoint.rs
@@ -0,0 +1,258 @@
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeSet;
+use std::io;
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct TaskContract {
+    pub objective: String,
+    pub acceptance_criteria: Vec<String>,
+    pub max_no_progress_calls: u32,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(deny_unknown_fields)]
+pub struct VersionMarker {
+    pub label: String,
+    pub sha256: String,
+    pub evidence: String,
+    pub evidence_sha256: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(deny_unknown_fields)]
+pub struct AcceptanceEvidence {
+    pub criterion: String,
+    pub evidence: Vec<VersionMarker>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct CheckpointUpdate {
+    pub completed_acceptance: Vec<AcceptanceEvidence>,
+    pub completed_steering: Vec<String>,
+    pub remaining_work: Vec<String>,
+    pub failed_hypotheses: Vec<String>,
+    pub candidate_versions: Vec<VersionMarker>,
+    pub check_versions: Vec<VersionMarker>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(rename_all = "snake_case")]
+pub enum ProcessStatus {
+    Running,
+    Stopped,
+    Completed,
+    Unknown,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+pub struct ProcessSnapshot {
+    pub identity: String,
+    pub owner: String,
+    pub status: ProcessStatus,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct LiveState {
+    pub workspace_sha256: String,
+    pub tracked_paths_sha256: String,
+    pub processes: Vec<ProcessSnapshot>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum WorkerStatus {
+    Active,
+    Stopped,
+    Completed,
+    Consumed,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct WorkerCheckpoint {
+    pub id: String,
+    pub parent: String,
+    pub depth: u32,
+    pub objective: Option<String>,
+    pub status: WorkerStatus,
+    pub result: Option<VersionMarker>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum CheckpointTaskStatus {
+    Active,
+    Paused,
+    Stopped,
+    Completed,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct AllowanceCheckpoint {
+    pub seconds_remaining: u64,
+    pub requests_consumed: u32,
+    pub requests_remaining: u32,
+    pub exposure_consumed_microusd: u64,
+    pub exposure_remaining_microusd: u64,
+    pub uncertain_requests: Vec<u32>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct Reconciliation {
+    pub reason: String,
+    pub prior_workspace_sha256: String,
+    pub current_workspace_sha256: String,
+    pub changed_workspace: bool,
+    pub prior_processes: Vec<ProcessSnapshot>,
+    pub current_processes: Vec<ProcessSnapshot>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct NoProgressCheckpoint {
+    pub signature_sha256: Option<String>,
+    pub unchanged_calls: u32,
+    pub max_unchanged_calls: u32,
+    pub decision: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+pub struct TaskCheckpoint {
+    pub schema: u32,
+    pub revision: u64,
+    pub progress_revision: u64,
+    pub task_status: CheckpointTaskStatus,
+    pub objective: String,
+    pub acceptance_criteria: Vec<String>,
+    pub completed_acceptance: Vec<AcceptanceEvidence>,
+    pub completed_steering: Vec<String>,
+    pub remaining_work: Vec<String>,
+    pub failed_hypotheses: Vec<String>,
+    pub candidate_versions: Vec<VersionMarker>,
+    pub check_versions: Vec<VersionMarker>,
+    pub workers: Vec<WorkerCheckpoint>,
+    #[serde(default)]
+    pub archived_workers: u32,
+    pub allowance: AllowanceCheckpoint,
+    pub live: LiveState,
+    pub reconciliation: Option<Reconciliation>,
+    pub no_progress: NoProgressCheckpoint,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum CallDecision {
+    Progress,
+    Unchanged,
+    Reassess,
+    LegitimateWait,
+    Paused,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::other(message)
+}
+
+fn valid_text(value: &str, max: usize) -> bool {
+    !value.trim().is_empty() && value.len() <= max
+}
+
+fn unique_text(values: &[String], max_items: usize, max_bytes: usize) -> bool {
+    values.len() <= max_items
+        && values.iter().all(|value| valid_text(value, max_bytes))
+        && values.iter().collect::<BTreeSet<_>>().len() == values.len()
+}
+
+fn valid_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+impl VersionMarker {
+    pub(crate) fn validate(&self) -> io::Result<()> {
+        if !valid_text(&self.label, 256)
+            || !valid_sha256(&self.sha256)
+            || !valid_text(&self.evidence, 4096)
+            || !valid_sha256(&self.evidence_sha256)
+        {
+            return Err(invalid("invalid version marker"));
+        }
+        Ok(())
+    }
+}
+
+impl TaskContract {
+    pub(crate) fn validate(&self) -> io::Result<()> {
+        if !valid_text(&self.objective, 4096)
+            || !unique_text(&self.acceptance_criteria, 32, 1024)
+            || self.acceptance_criteria.is_empty()
+            || !(2..=16).contains(&self.max_no_progress_calls)
+        {
+            return Err(invalid("invalid bounded task contract"));
+        }
+        Ok(())
+    }
+}
+
+impl LiveState {
+    pub(crate) fn validate(&self) -> io::Result<()> {
+        if !valid_sha256(&self.workspace_sha256)
+            || !valid_sha256(&self.tracked_paths_sha256)
+            || self.processes.len() > 128
+        {
+            return Err(invalid("invalid live state"));
+        }
+        let mut identities = BTreeSet::new();
+        for process in &self.processes {
+            if !valid_text(&process.identity, 256)
+                || !valid_text(&process.owner, 128)
+                || !identities.insert(&process.identity)
+            {
+                return Err(invalid("invalid live process state"));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl CheckpointUpdate {
+    pub(crate) fn validate(&self, contract: &TaskContract) -> io::Result<()> {
+        if !unique_text(&self.completed_steering, 64, 4096)
+            || !unique_text(&self.remaining_work, 64, 4096)
+            || !unique_text(&self.failed_hypotheses, 64, 4096)
+            || self.completed_acceptance.len() > contract.acceptance_criteria.len()
+            || self.candidate_versions.len() > 32
+            || self.check_versions.len() > 32
+        {
+            return Err(invalid("invalid bounded checkpoint update"));
+        }
+        let criteria = contract.acceptance_criteria.iter().collect::<BTreeSet<_>>();
+        let mut completed = BTreeSet::new();
+        for acceptance in &self.completed_acceptance {
+            if !criteria.contains(&acceptance.criterion)
+                || !completed.insert(&acceptance.criterion)
+                || acceptance.evidence.is_empty()
+                || acceptance.evidence.len() > 16
+            {
+                return Err(invalid("invalid acceptance evidence"));
+            }
+            for marker in &acceptance.evidence {
+                marker.validate()?;
+            }
+        }
+        for marker in self.candidate_versions.iter().chain(&self.check_versions) {
+            marker.validate()?;
+        }
+        if serde_json::to_vec(self)?.len() > 65_536 {
+            return Err(invalid("checkpoint update exceeds size limit"));
+        }
+        Ok(())
+    }
+}
+
+pub(crate) fn preserves<T: Ord>(prior: &[T], current: &[T]) -> bool {
+    let current = current.iter().collect::<BTreeSet<_>>();
+    prior.iter().all(|value| current.contains(value))
+}
diff --git a/codex-rs/omd/src/checks.rs b/codex-rs/omd/src/checks.rs
new file mode 100644
index 0000000..55ff4fc
--- /dev/null
+++ b/codex-rs/omd/src/checks.rs
@@ -0,0 +1,323 @@
+use crate::LspLanguage;
+use crate::LspLimits;
+use crate::lsp_hash;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::env;
+use std::fs;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct IntermediateCheck {
+    pub language: LspLanguage,
+    pub program: PathBuf,
+    pub arguments: Vec<String>,
+    pub working_directory: PathBuf,
+    pub scope: Vec<String>,
+    pub input_sha256: String,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct UnsupportedCheck {
+    pub language: LspLanguage,
+    pub reason: String,
+    pub fallback: String,
+}
+
+pub fn select_intermediate_checks(
+    repository: &Path,
+    changed_paths: &[String],
+    limits: &LspLimits,
+) -> io::Result<(Vec<IntermediateCheck>, Vec<UnsupportedCheck>)> {
+    limits.validate()?;
+    if changed_paths.is_empty() || changed_paths.len() > limits.max_edit_files {
+        return Err(io::Error::other(
+            "changed path batch is empty or exceeds limit",
+        ));
+    }
+    let mut languages = BTreeMap::<LspLanguage, Vec<String>>::new();
+    for relative in changed_paths {
+        let path = resolve_source(repository, relative)?;
+        let language = LspLanguage::from_path(&path)
+            .ok_or_else(|| io::Error::other(format!("unsupported source path {relative}")))?;
+        languages
+            .entry(language)
+            .or_default()
+            .push(relative.clone());
+    }
+    let mut checks = Vec::new();
+    let mut unsupported = Vec::new();
+    for (language, mut scope) in languages {
+        scope.sort();
+        scope.dedup();
+        match select_one(repository, language, scope, limits)? {
+            Ok(check) => checks.push(check),
+            Err(reason) => unsupported.push(UnsupportedCheck {
+                language,
+                reason,
+                fallback: "Use a repository-configured executable check through the ordinary command tool and bind its result to the current input SHA256; unavailable evidence is not success.".into(),
+            }),
+        }
+    }
+    Ok((checks, unsupported))
+}
+
+fn select_one(
+    repository: &Path,
+    language: LspLanguage,
+    scope: Vec<String>,
+    limits: &LspLimits,
+) -> io::Result<Result<IntermediateCheck, String>> {
+    let selected = match language {
+        LspLanguage::Rust => resolve_executable("cargo").and_then(|program| {
+            nearest_ancestor(repository, &scope, "Cargo.toml").map(|working_directory| {
+                (
+                    program,
+                    vec!["check".into(), "--quiet".into()],
+                    working_directory,
+                )
+            })
+        }),
+        LspLanguage::TypeScript | LspLanguage::JavaScript => {
+            resolve_executable("pnpm").and_then(|program| {
+                nearest_ancestor(repository, &scope, "tsconfig.json").map(|config| {
+                    let relative = config
+                        .join("tsconfig.json")
+                        .strip_prefix(repository)
+                        .expect("config is in repository")
+                        .to_string_lossy()
+                        .replace('\\', "/");
+                    (
+                        program,
+                        vec![
+                            "exec".into(),
+                            "tsc".into(),
+                            "--noEmit".into(),
+                            "--pretty".into(),
+                            "false".into(),
+                            "-p".into(),
+                            relative,
+                        ],
+                        repository.to_path_buf(),
+                    )
+                })
+            })
+        }
+        LspLanguage::Python => ["pyright", "mypy", "ruff"]
+            .into_iter()
+            .find_map(|name| resolve_executable(name).map(|program| (name, program)))
+            .map(|(name, program)| {
+                let arguments = if name == "ruff" {
+                    std::iter::once("check".to_string())
+                        .chain(scope.iter().cloned())
+                        .collect()
+                } else {
+                    scope.clone()
+                };
+                (program, arguments, repository.to_path_buf())
+            }),
+        LspLanguage::Java => {
+            let gradle = repository.join("gradlew");
+            let maven = repository.join("mvnw");
+            if gradle.is_file() {
+                Some((gradle, vec!["compileJava".into()], repository.to_path_buf()))
+            } else if maven.is_file() {
+                Some((
+                    maven,
+                    vec!["-q".into(), "-DskipTests".into(), "compile".into()],
+                    repository.to_path_buf(),
+                ))
+            } else {
+                resolve_executable("gradle")
+                    .map(|program| {
+                        (
+                            program,
+                            vec!["compileJava".into()],
+                            repository.to_path_buf(),
+                        )
+                    })
+                    .or_else(|| {
+                        resolve_executable("mvn").map(|program| {
+                            (
+                                program,
+                                vec!["-q".into(), "-DskipTests".into(), "compile".into()],
+                                repository.to_path_buf(),
+                            )
+                        })
+                    })
+            }
+        }
+    };
+    let Some((program, arguments, working_directory)) = selected else {
+        return Ok(Err(match language {
+            LspLanguage::Rust => "cargo or a repository Cargo.toml is unavailable".into(),
+            LspLanguage::TypeScript | LspLanguage::JavaScript => {
+                "pnpm or a repository tsconfig.json is unavailable".into()
+            }
+            LspLanguage::Python => "pyright, mypy, and ruff are not installed".into(),
+            LspLanguage::Java => "Gradle or Maven is not installed or configured".into(),
+        }));
+    };
+    let input_sha256 = check_input_hash(repository, language, limits)?;
+    Ok(Ok(IntermediateCheck {
+        language,
+        program,
+        arguments,
+        working_directory,
+        scope,
+        input_sha256,
+    }))
+}
+
+fn nearest_ancestor(repository: &Path, scope: &[String], marker: &str) -> Option<PathBuf> {
+    let first = repository.join(scope.first()?);
+    let mut directory = first.parent()?;
+    loop {
+        if directory.join(marker).is_file() {
+            return Some(directory.to_path_buf());
+        }
+        if directory == repository {
+            break;
+        }
+        directory = directory.parent()?;
+        if !directory.starts_with(repository) {
+            break;
+        }
+    }
+    None
+}
+
+fn check_input_hash(
+    repository: &Path,
+    language: LspLanguage,
+    limits: &LspLimits,
+) -> io::Result<String> {
+    let config_names = match language {
+        LspLanguage::Rust => ["Cargo.toml", "Cargo.lock"].as_slice(),
+        LspLanguage::TypeScript | LspLanguage::JavaScript => {
+            ["package.json", "pnpm-lock.yaml", "tsconfig.json"].as_slice()
+        }
+        LspLanguage::Python => ["pyproject.toml", "setup.cfg", "mypy.ini"].as_slice(),
+        LspLanguage::Java => [
+            "build.gradle",
+            "build.gradle.kts",
+            "settings.gradle",
+            "settings.gradle.kts",
+            "pom.xml",
+        ]
+        .as_slice(),
+    }
+    .iter()
+    .copied()
+    .collect::<BTreeSet<_>>();
+    let mut stack = vec![repository.to_path_buf()];
+    let mut entries = BTreeMap::<String, String>::new();
+    let mut bytes = 0_usize;
+    while let Some(directory) = stack.pop() {
+        for entry in fs::read_dir(directory)? {
+            let entry = entry?;
+            let path = entry.path();
+            let name = entry.file_name();
+            if entry.file_type()?.is_symlink() {
+                continue;
+            }
+            if path.is_dir() {
+                if !matches!(
+                    name.to_str(),
+                    Some(
+                        ".git"
+                            | ".omd"
+                            | "target"
+                            | "node_modules"
+                            | ".venv"
+                            | "venv"
+                            | "build"
+                            | "dist"
+                    )
+                ) {
+                    stack.push(path);
+                }
+                continue;
+            }
+            let include = LspLanguage::from_path(&path) == Some(language)
+                || name
+                    .to_str()
+                    .is_some_and(|name| config_names.contains(name));
+            if !include {
+                continue;
+            }
+            let content = fs::read(&path)?;
+            bytes = bytes.saturating_add(content.len());
+            if entries.len() >= limits.max_workspace_files || bytes > limits.max_workspace_bytes {
+                return Err(io::Error::other("intermediate check inputs exceed bounds"));
+            }
+            let relative = path
+                .strip_prefix(repository)
+                .expect("walked repository path")
+                .to_string_lossy()
+                .replace('\\', "/");
+            entries.insert(relative, lsp_hash(&content));
+        }
+    }
+    Ok(lsp_hash(&serde_json::to_vec(&entries)?))
+}
+
+fn resolve_source(repository: &Path, relative: &str) -> io::Result<PathBuf> {
+    let relative = Path::new(relative);
+    if relative.is_absolute()
+        || relative
+            .components()
+            .any(|component| !matches!(component, std::path::Component::Normal(_)))
+    {
+        return Err(io::Error::other(
+            "check path must be normalized and repository-relative",
+        ));
+    }
+    let path = repository.join(relative).canonicalize()?;
+    if !path.starts_with(repository) || !path.is_file() {
+        return Err(io::Error::other("check path escapes repository"));
+    }
+    Ok(path)
+}
+
+fn resolve_executable(name: &str) -> Option<PathBuf> {
+    env::split_paths(&env::var_os("PATH")?).find_map(|directory| {
+        let path = directory.join(name);
+        path.is_file().then_some(path)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn check_fingerprint_changes_only_with_relevant_inputs() {
+        let temporary = tempfile::tempdir().unwrap();
+        let repository = temporary.path().canonicalize().unwrap();
+        fs::write(repository.join("main.rs"), "fn main() {}\n").unwrap();
+        fs::write(repository.join("notes.txt"), "one\n").unwrap();
+        let limits = LspLimits::default();
+        let (checks, unsupported) =
+            select_intermediate_checks(&repository, &["main.rs".into()], &limits).unwrap();
+        assert!(checks.is_empty());
+        assert_eq!(unsupported.len(), 1);
+        assert!(unsupported[0].reason.contains("Cargo.toml"));
+        let first = check_input_hash(&repository, LspLanguage::Rust, &limits).unwrap();
+        fs::write(repository.join("notes.txt"), "two\n").unwrap();
+        fs::write(repository.join("package.json"), "{}\n").unwrap();
+        let second = check_input_hash(&repository, LspLanguage::Rust, &limits).unwrap();
+        assert_eq!(first, second);
+        fs::write(repository.join("Cargo.toml"), "[workspace]\n").unwrap();
+        let configured = check_input_hash(&repository, LspLanguage::Rust, &limits).unwrap();
+        assert_ne!(second, configured);
+        fs::write(repository.join("main.rs"), "fn main() { panic!() }\n").unwrap();
+        let third = check_input_hash(&repository, LspLanguage::Rust, &limits).unwrap();
+        assert_ne!(configured, third);
+    }
+}
