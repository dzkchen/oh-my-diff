+        ModInputDecision::Deny("blocked".into())
+    );
+    for invalid in [
+        json!({"text":"a","deny":"b"}),
+        json!("text"),
+        json!({"text":""}),
+        json!({"deny":"x".repeat(513)}),
+    ] {
