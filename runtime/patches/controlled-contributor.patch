+struct LeadRoutes {
+    sol: Route,
+    astra: Route,
+}
+
+impl LeadRoutes {
+    fn get(&self, lead: LeadName) -> &Route {
+        match lead {
+            LeadName::Sol => &self.sol,
+            LeadName::Astra => &self.astra,
