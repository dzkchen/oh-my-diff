+impl TurnItemContributor for Extension {
+    fn contribute<'a>(
+        &'a self,
+        thread_store: &'a ExtensionData,
+        _turn_store: &'a ExtensionData,
+        item: &'a mut TurnItem,
+    ) -> ExtensionFuture<'a, Result<(), String>> {
+        Box::pin(async move {
+            let Some(lead) = thread_store.get::<Lead>() else {
+                return Ok(());
+            };
+            let observed = match item {
