+                    ),
+                    &value,
+                )
+                .map_err(FunctionCallError::RespondToModel)?;
+            Ok(Box::new(JsonToolOutput::new(
+                json!({"result": value, "evidence": reference}),
+            )) as Box<dyn ToolOutput>)
+        })
+    }
+}
