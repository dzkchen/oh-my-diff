+    fn find_search_match(&mut self, forward: bool) {
+        if self.search.query.is_empty() || self.cells.is_empty() {
+            self.set_search_match(None);
+            return;
+        }
+        let query = self.search.query.to_lowercase();
+        let len = self.cells.len();
+        let initial = match (self.search.match_cell, forward) {
+            (Some(index), true) => index.saturating_add(1) % len,
+            (Some(0), false) | (None, false) => len - 1,
+            (Some(index), false) => index - 1,
+            (None, true) => 0,
+        };
+        let matched = (0..len)
