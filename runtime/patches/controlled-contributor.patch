+#[test]
+fn mixed_api_mods_share_one_host_and_upgrade_independently() {
+    let temp = TempDir::new().unwrap();
+    let (root, store) = workspace(&temp);
+    let ping = "export default api => api.command('ping', () => api.version)";
+    let legacy = written(
+        &root,
+        "legacy",
+        ping,
+        &["commands"],
+        json!({"api":"0.1.0-experimental.4"}),
