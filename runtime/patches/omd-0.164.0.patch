+        };
+        contract.restrict(json!({"scoped":[{"operation":"agents.spawn","when":{"/workspace":"isolated_worktree"}},
+            {"operation":"exec.run","when":{"/write":true}}],"reason":"sealed"})).unwrap();
+        assert!(
+            contract
+                .restricted("agents.spawn", &json!({"workspace":"isolated_worktree"}))
+                .is_err()
+        );
