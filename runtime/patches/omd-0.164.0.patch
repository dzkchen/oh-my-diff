+    async fn thread_rewrite_response(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: ThreadRewriteParams,
+        app_server_client_name: Option<String>,
+        app_server_client_version: Option<String>,
+    ) -> Result<(ThreadRewriteResponse, String), JSONRPCErrorError> {
+        let ThreadRewriteParams {
+            thread_id,
+            expected_revision,
+            edits,
+            undo,
+            author,
+        } = params;
+        let edits = edits
+            .into_iter()
+            .map(serde_json::from_value)
+            .collect::<Result<Vec<codex_thread_store::HistoryRowEdit>, _>>()
+            .map_err(|err| invalid_request(format!("history_rewrite_invalid: {err}")))?;
+        let author = author
+            .or_else(|| app_server_client_name.clone())
+            .unwrap_or_else(|| "app-server client".to_string());
+        let Some(expected_revision) = expected_revision else {
+            if !edits.is_empty() || undo {
+                return Err(invalid_request(
+                    "history_rewrite_invalid: edits and undo need expectedRevision",
+                ));
+            }
+            let thread_id = ThreadId::from_string(&thread_id)
+                .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+            return Ok((
+                thread_rewrite_response(self.read_history_rows(thread_id, author).await?),
+                thread_id.to_string(),
+            ));
+        };
+        let _thread_list_state_permit = self.acquire_thread_list_state_permit().await?;
+        let (thread_id, thread) = self.load_thread(&thread_id).await?;
+        ensure_direct_input_allowed(thread.as_ref()).await?;
+        let config_snapshot = thread.config_snapshot().await;
+        if config_snapshot.ephemeral
+            || !matches!(config_snapshot.history_mode, ThreadHistoryMode::Paginated)
+        {
+            return Err(invalid_request(
+                "thread/rewrite only supports persisted paginated threads",
+            ));
+        }
+        self.ensure_rewrite_idle(thread_id).await?;
+        self.thread_store
+            .rewrite_thread(codex_thread_store::RewriteThreadParams {
+                thread_id,
+                expected_revision: Some(expected_revision.clone()),
+                edits: edits.clone(),
+                undo,
+                author: author.clone(),
+                multi_agent_version: None,
+                witness: None,
+                dry_run: true,
+            })
+            .await
+            .map_err(|err| thread_store_mutation_error("rewrite", err))?;
+        // Checked again right before the unload, since validating takes time.
+        self.ensure_rewrite_idle(thread_id).await?;
+        let runtime_snapshot = self
+            .unload_for_history_replacement(
+                request_id,
+                thread_id,
+                &thread,
+                "rewritten",
+                /*only_if_idle*/ true,
+            )
+            .await?;
+        let rewrite_result = self
+            .thread_store
+            .rewrite_thread(codex_thread_store::RewriteThreadParams {
+                thread_id,
+                expected_revision: Some(expected_revision),
+                edits,
+                undo,
+                author,
+                multi_agent_version: thread.multi_agent_version(),
+                witness: Some(history_witness()),
+                dry_run: false,
+            })
+            .await
+            .map_err(|err| thread_store_mutation_error("rewrite", err));
+        let reload_error = self
+            .reload_paginated_thread(
+                request_id,
+                thread_id,
+                runtime_snapshot,
+                app_server_client_name,
+                app_server_client_version,
