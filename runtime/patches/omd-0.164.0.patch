+        "timer",
+        json!({"key": "poll"}),
+    )
+    .await;
+    let state = |key: &str| {
+        core.runtime
+            .lock()
+            .unwrap()
+            .state("monitor")
+            .cloned()
+            .unwrap()[key]
+            .clone()
