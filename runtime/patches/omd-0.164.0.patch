+#[test]
+fn event_queue_bounds_waiting_events_and_reports_drops() {
+    let (entered, blocked) = std::sync::mpsc::channel();
+    let (release, released) = std::sync::mpsc::channel::<()>();
+    let (delivered, deliveries) = std::sync::mpsc::channel();
+    let released = Mutex::new(released);
+    let queue = EventQueue::spawn(move |value: Value, dropped| {
+        if value == 0 {
+            entered.send(()).unwrap();
+            released.lock().unwrap().recv().unwrap();
+        }
+        delivered
+            .send(with_dropped(json!({"value": value}), dropped))
+            .unwrap();
+    });
+    assert!(queue.push(json!(0)));
+    blocked.recv().unwrap();
+    for value in 1..=EVENT_QUEUE {
+        assert!(queue.push(json!(value)));
+    }
+    assert!(!queue.push(json!("overflow")));
+    assert!(!queue.push(json!("overflow")));
+    release.send(()).unwrap();
+    assert_eq!(
+        deliveries.recv().unwrap(),
+        json!({"value": 0, "dropped": 2})
+    );
+    for value in 1..=EVENT_QUEUE {
+        assert_eq!(deliveries.recv().unwrap(), json!({"value": value}));
+    }
+    assert!(queue.push(json!("after")));
+    assert_eq!(deliveries.recv().unwrap(), json!({"value": "after"}));
+}
