+    assert_eq!(
+        (narrow["packages"].clone(), narrow["generation"].as_u64()),
+        (
+            json!([{"id": "sample_mod", "enabled": false}]),
+            Some(generation)
+        )
+    );
+    for invalid in [
+        json!({}),
+        json!({"fields": "id"}),
