+    pub assessment: bool,
+}
+
+pub struct ApprovalResultInput<'a> {
+    pub thread_store: &'a ExtensionData,
+    pub call_id: &'a str,
+    pub kind: &'a str,
+    pub decision: &'a str,
+    pub source: &'a str,
+}
