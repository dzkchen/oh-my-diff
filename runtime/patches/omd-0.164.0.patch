+    let other_capabilities = strings(&["fs.write"]);
+    let other = Caller {
+        id: "other",
+        ..caller(&other_capabilities, &[], Origin::Tool)
+    };
+    assert_eq!(
+        host.call(
+            &other,
+            "workspace.restore",
+            json!({"backup":backup,"expected":{"README.md":null,"new.md":null}})
+        )
+        .unwrap_err(),
+        "backup_unavailable"
+    );
+    std::fs::create_dir(repository.join("locked")).unwrap();
+    assert_eq!(
