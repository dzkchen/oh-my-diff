+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+const DEFAULT_HEIGHT: usize = 12;
+
+#[derive(Clone, Copy)]
+pub(crate) enum Content<'a> {
+    Spans(&'a [Vec<ModSpan>]),
+    Source(&'a codex_omd::resource_data::ResourceRef),
+    Diff(&'a str),
+}
+
+#[derive(Default, PartialEq)]
+enum Key {
+    #[default]
+    None,
+    Spans(Vec<Vec<ModSpan>>),
+    Source(
+        codex_omd::resource_data::ResourceRef,
+        Vec<String>,
+        Option<String>,
+        Box<Option<Authority>>,
+    ),
+    Diff(String),
+}
+
+type Authority = (
+    std::path::PathBuf,
+    std::path::PathBuf,
+    [Option<codex_omd::FileStamp>; 2],
+);
+
+/// Resource records are content-addressed, so resolved lines stay valid until the files that grant owners access change.
+fn authority() -> Option<Authority> {
+    let paths = crate::omd::mod_paths()?;
+    let store = paths.store?;
+    let stamps =
+        ["mod-status.json", "mods.json"].map(|name| crate::omd::file_stamp(&store.join(name)));
+    Some((store, paths.repository, stamps))
+}
+
+impl Key {
+    fn matches(&self, content: &Content<'_>) -> bool {
+        match (self, content) {
+            (Self::Spans(cached), Content::Spans(lines)) => cached.as_slice() == *lines,
+            (Self::Diff(cached), Content::Diff(unified)) => cached == unified,
+            _ => false,
+        }
+    }
+}
+
+#[derive(Default)]
+struct Document {
+    view: DocumentView,
+    key: Key,
+    lines: Arc<Vec<String>>,
+    spans: Arc<Vec<Vec<Span<'static>>>>,
+    anchors: Arc<Vec<Option<String>>>,
+    /// Whether the view's `anchors` apply: not for diffs or an unavailable source.
+    anchored: bool,
+    applied_find: Option<ModFind>,
+    applied_selection: Option<ModRange>,
+    height: usize,
+}
+
+static DOCUMENTS: Mutex<BTreeMap<String, Document>> = Mutex::new(BTreeMap::new());
+
+fn documents() -> std::sync::MutexGuard<'static, BTreeMap<String, Document>> {
+    DOCUMENTS.locked()
+}
+
+fn span_text(spans: &[ModSpan]) -> String {
+    spans.iter().map(|span| span.text.as_str()).collect()
+}
+
+fn resolve(
+    reference: &codex_omd::resource_data::ResourceRef,
+    owners: &[String],
+) -> Result<Vec<String>, String> {
+    let thread = crate::mod_surface::current_thread();
+    let mut last = "resource_unavailable".to_owned();
+    for owner in owners {
+        let host = match crate::mod_surface::resource_binding(owner, thread.as_deref()) {
+            Ok((host, _)) => host,
+            Err(error) => {
+                last = error;
+                continue;
+            }
+        };
+        let resources = host.resources();
+        let record = match resources.load(reference, "evidence") {
+            Ok(record) => record,
+            Err(error) => {
+                last = error.to_string();
+                continue;
+            }
+        };
+        let text = match (record["blob"].as_str(), &record["content"]) {
+            (Some(blob), _) => {
+                String::from_utf8_lossy(&resources.blob(blob).map_err(|error| error.to_string())?)
+                    .into_owned()
+            }
+            (None, Value::String(text)) => text.clone(),
+            (None, value) => serde_json::to_string_pretty(value).unwrap_or_default(),
+        };
+        return Ok(text
+            .lines()
+            .take(crate::mod_document::DOCUMENT_LINES)
+            .map(str::to_owned)
+            .collect());
+    }
+    Err(last)
+}
+
+fn diff_style(kind: DiffKind) -> Style {
+    match kind {
+        DiffKind::File => Style::default().bold(),
+        DiffKind::Hunk => Style::default().cyan(),
+        DiffKind::Added => Style::default().green(),
+        DiffKind::Removed => Style::default().red(),
+        DiffKind::Context => Style::default(),
+    }
+}
+
+fn authorized_blob(
+    reference: &codex_omd::resource_data::ResourceRef,
+    owners: &[String],
+) -> Option<(codex_omd::scoped_data::ScopedDataHost, String)> {
+    let thread = crate::mod_surface::current_thread();
+    owners.iter().find_map(|owner| {
+        let (host, _) = crate::mod_surface::resource_binding(owner, thread.as_deref()).ok()?;
+        let resources = host.resources();
+        let record = resources
+            .load(reference, "evidence")
+            .ok()
+            .filter(|record| record["media_type"] != "image/svg+xml")?;
+        Some((host, record["blob"].as_str()?.to_owned()))
+    })
+}
+
+static IMAGES: Mutex<BTreeMap<String, (String, Vec<Line<'static>>)>> = Mutex::new(BTreeMap::new());
+
+/// The newest decoded picture, so redraws at another size don't decode again.
+static DECODED: Mutex<Option<(String, Arc<image::DynamicImage>)>> = Mutex::new(None);
+
+static UNDECODABLE: Mutex<BTreeSet<String>> = Mutex::new(BTreeSet::new());
+
+/// Content that failed to decode is remembered by hash, so frames don't retry it.
+pub(crate) fn decode_once(
+    sha256: &str,
+    load: impl FnOnce() -> Option<Vec<u8>>,
+) -> Option<Arc<image::DynamicImage>> {
+    let failed = || UNDECODABLE.locked();
+    let mut decoded = DECODED.locked();
+    if let Some((cached, image)) = decoded.as_ref()
+        && cached == sha256
+    {
+        return Some(Arc::clone(image));
+    }
+    if failed().contains(sha256) {
+        return None;
+    }
+    let image = codex_omd::client_surface::decode_image(&load()?)
+        .ok()
+        .map(Arc::new);
+    match &image {
+        Some(image) => *decoded = Some((sha256.to_owned(), Arc::clone(image))),
+        None => {
+            let mut failed = failed();
+            if failed.len() >= 32 {
+                failed.clear();
+            }
+            failed.insert(sha256.to_owned());
+        }
+    }
+    image
+}
+
+pub(crate) fn fit(image: (u32, u32), width: u16, height: u16, cell: (u16, u16)) -> (u16, u16) {
+    let (cell_width, cell_height) = (f64::from(cell.0), f64::from(cell.1));
+    let scale = (f64::from(width) * cell_width / f64::from(image.0.max(1)))
+        .min(f64::from(height) * cell_height / f64::from(image.1.max(1)));
+    let cells = |pixels: u32, cell: f64, limit: u16| {
+        ((f64::from(pixels) * scale / cell).round() as u16).clamp(1, limit)
+    };
+    (
+        cells(image.0, cell_width, width),
+        cells(image.1, cell_height, height),
+    )
+}
+
+/// The transmitted size of a placement: both sides scaled together to stay within 2048 pixels.
+pub(crate) fn kitty_pixels(columns: u16, rows: u16, cell: (u16, u16)) -> (u32, u32) {
+    let (width, height) = (
+        u32::from(columns) * u32::from(cell.0),
+        u32::from(rows) * u32::from(cell.1),
+    );
+    let scale = (2048.0 / f64::from(width.max(height))).min(1.0);
+    let scaled = |pixels: u32| ((f64::from(pixels) * scale).round() as u32).max(1);
+    (scaled(width), scaled(height))
+}
+
+fn placed(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> std::borrow::Cow<'_, image::DynamicImage> {
+    codex_omd::process_raster::resized(decoded, placed_size(decoded, columns, rows, cell))
+}
+
+fn placed_size(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> (u32, u32) {
+    codex_omd::process_raster::fit_within(
+        (decoded.width(), decoded.height()),
+        kitty_pixels(columns, rows, cell),
+    )
+}
+
+fn inline_png(
+    pixels: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> Option<Vec<u8>> {
+    let _stage = codex_omd::frame_metrics::stage("iip_encode");
+    codex_omd::process_raster::encode(
+        pixels,
+        placed_size(pixels, columns, rows, cell),
+        /*jpeg*/ false,
+    )
+}
+
+fn placement_pixels(
+    decoded: &image::DynamicImage,
+    columns: u16,
+    rows: u16,
+    cell: (u16, u16),
+) -> crate::mod_client::Pixels {
+    let _stage = codex_omd::frame_metrics::stage("placement_pixels");
+    let decoded = placed(decoded, columns, rows, cell);
+    let translucent = decoded
+        .color()
+        .has_alpha()
+        .then(|| decoded.to_rgba8())
+        .filter(|rgba| rgba.pixels().any(|pixel| pixel[3] < u8::MAX));
+    crate::mod_client::Pixels {
+        alpha: translucent.is_some(),
+        bytes: translucent.map_or_else(|| decoded.to_rgb8().into_raw(), image::RgbaImage::into_raw),
+        width: decoded.width(),
+        height: decoded.height(),
+    }
+}
+
+pub(crate) fn dimensions(bytes: &[u8]) -> Option<(u32, u32)> {
+    let reader = image::ImageReader::new(std::io::Cursor::new(bytes))
+        .with_guessed_format()
+        .ok()?;
+    let (width, height) = reader
+        .format()
+        .filter(|format| matches!(format, image::ImageFormat::Png | image::ImageFormat::Jpeg))
+        .and_then(|_| reader.into_dimensions().ok())?;
+    (bytes.len() <= 8 * 1024 * 1024 && width.max(height) <= codex_omd::client_surface::IMAGE_PIXELS)
+        .then_some((width, height))
+}
+
+/// Marker cells for a picture the terminal draws: Kitty placeholders over a transmitted image, or inline-image markers `mod_client::place` replaces.
+#[allow(clippy::too_many_arguments)]
+fn marker_rows(
+    component: &str,
+    sha256: &str,
+    width: u16,
+    height: u16,
+    cell: (u16, u16),
+    load: &dyn Fn() -> Option<Vec<u8>>,
+    prefix: &str,
+    inline: bool,
+    pixels: Option<&image::DynamicImage>,
+) -> Option<Vec<Line<'static>>> {
+    let (width, height) = (
+        width.min(crate::mod_client::max_placeholder_cells()),
+        height.min(crate::mod_client::max_placeholder_cells()),
+    );
+    let key = format!("{sha256}:{width}:{height}:{}x{}", cell.0, cell.1);
+    let (id, columns, rows) = if inline {
+        crate::mod_client::iip_image(component, &key, || {
+            let (bytes, size) = if let Some(pixels) = pixels {
+                let size = (pixels.width(), pixels.height());
+                let (columns, rows) = fit(size, width, height, cell);
+                (inline_png(pixels, columns, rows, cell)?, size)
+            } else {
+                let bytes = load()?;
+                let size = dimensions(&bytes)?;
+                (bytes, size)
+            };
+            let (columns, rows) = fit(size, width, height, cell);
+            Some((Arc::<[u8]>::from(bytes), columns, rows))
+        })?
+    } else {
+        crate::mod_client::kitty_image(component, &key, || {
+            let decoded;
+            let pixels = if let Some(pixels) = pixels {
+                pixels
+            } else {
+                decoded = decode_once(sha256, load)?;
+                &decoded
+            };
+            let (columns, rows) = fit((pixels.width(), pixels.height()), width, height, cell);
+            Some((placement_pixels(pixels, columns, rows, cell), columns, rows))
+        })?
+    };
+    Some(crate::mod_client::placeholder_rows(
+        id, columns, rows, prefix,
+    ))
+}
+
+/// Terminal-drawn pictures where the client supports them, else cached half-block rows (`key` identifies the picture and its fit).
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn picture_rows(
+    component: &str,
+    sha256: &str,
+    key: &str,
+    width: u16,
+    height: u16,
+    prefix: &str,
+    load: &dyn Fn() -> Option<Vec<u8>>,
+    pixels: Option<&image::DynamicImage>,
+) -> Option<Vec<Line<'static>>> {
+    let client = crate::mod_client::facts();
+    if (client.placeholders || client.iip)
+        && let Some(rows) = marker_rows(
+            component,
+            sha256,
+            width,
+            height,
+            client.cell.unwrap_or(crate::mod_client::DEFAULT_CELL),
+            load,
+            prefix,
+            client.iip,
+            pixels,
+        )
+    {
+        return Some(rows);
+    }
+    let mut images = IMAGES.locked();
+    if let Some((cached, rows)) = images.get(component)
+        && cached == key
+    {
+        return Some(rows.clone());
+    }
+    let decoded;
+    let pixels = if let Some(pixels) = pixels {
+        pixels
+    } else {
+        decoded = decode_once(sha256, load)?;
+        &decoded
+    };
+    let rows = codex_omd::client_surface::half_block(pixels, width, height)
+        .iter()
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend(row.iter().map(|cell| crate::mod_raster::span(cell, false)));
+            Line::from(spans)
+        })
+        .collect::<Vec<_>>();
+    images.insert(component.to_owned(), (key.to_owned(), rows.clone()));
+    Some(rows)
+}
+
+pub(crate) fn image_rows(
+    component: &str,
+    reference: &codex_omd::resource_data::ResourceRef,
+    alt: &str,
+    width: u16,
+    height: u16,
+    owners: &[String],
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    if crate::mod_client::facts().no_color || width < 4 {
+        return vec![Line::from(format!("{prefix}[image: {alt}]")).dim()];
+    }
+    let Some((host, blob)) = authorized_blob(reference, owners) else {
+        return vec![Line::from(format!("{prefix}[image unavailable: {alt}]")).dim()];
+    };
+    let key = format!(
+        "{reference:?}:{owners:?}:{}:{width}:{height}:{prefix}",
+        crate::mod_surface::current_thread().unwrap_or_default()
+    );
+    picture_rows(
+        component,
+        &reference.sha256,
+        &key,
+        width,
+        height,
+        prefix,
+        &|| host.resources().blob(&blob).ok(),
+        None,
+    )
+    .unwrap_or_else(|| vec![Line::from(format!("{prefix}[image unavailable: {alt}]")).dim()])
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rows(
+    id: &str,
+    content: Content<'_>,
+    anchors: &[String],
+    selected: Option<ModRange>,
+    find: Option<&ModFind>,
+    height: Option<u16>,
+    owners: &[String],
+    focused: bool,
+    keys: bool,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let source = match &content {
+        Content::Source(reference) => Some(Key::Source(
+            (*reference).clone(),
+            owners.to_vec(),
+            crate::mod_surface::current_thread(),
+            Box::new(authority()),
+        )),
+        _ => None,
+    };
+    let mut documents = documents();
+    let document = documents.entry(id.to_owned()).or_default();
+    let current = match &source {
+        Some(source) => document.key == *source,
+        None => document.key.matches(&content),
+    };
+    if !current {
+        let key = match content {
+            Content::Spans(lines) => Key::Spans(lines.to_vec()),
+            Content::Diff(unified) => Key::Diff(unified.to_owned()),
+            Content::Source(_) => source.unwrap_or_default(),
+        };
+        let (lines, spans, parsed_anchors, anchored) = match content {
+            Content::Spans(lines) => (
+                lines.iter().map(|line| span_text(line)).collect::<Vec<_>>(),
+                lines
+                    .iter()
+                    .map(|line| {
+                        line.iter()
+                            .map(|span| {
+                                Span::styled(span.text.clone(), crate::mod_ui::span_style(span))
+                            })
+                            .collect()
+                    })
+                    .collect(),
+                (0..lines.len())
+                    .map(|index| anchors.get(index).cloned())
+                    .collect::<Vec<_>>(),
+                true,
+            ),
+            Content::Source(reference) => match resolve(reference, owners) {
+                Ok(lines) => {
+                    let count = lines.len();
+                    (
+                        lines.clone(),
+                        lines
+                            .into_iter()
+                            .map(|line| vec![Span::raw(line)])
+                            .collect(),
+                        (0..count)
+                            .map(|index| anchors.get(index).cloned())
+                            .collect(),
+                        true,
+                    )
+                }
+                Err(error) => (
+                    vec![format!("unavailable: {error}")],
+                    vec![vec![format!("unavailable: {error}").dim()]],
+                    vec![None],
+                    false,
+                ),
+            },
+            Content::Diff(unified) => {
+                let parsed = crate::mod_document::diff_lines(unified);
+                (
+                    parsed.iter().map(|(_, text, _)| text.clone()).collect(),
+                    parsed
+                        .iter()
+                        .map(|(kind, text, _)| vec![Span::styled(text.clone(), diff_style(*kind))])
+                        .collect(),
+                    parsed.into_iter().map(|(_, _, anchor)| anchor).collect(),
+                    false,
+                )
+            }
+        };
+        if document.lines.as_ref() != &lines {
+            let view = if keys {
+                DocumentView {
+                    cursor: document.view.cursor,
+                    scroll: document.view.scroll,
+                    ..DocumentView::default()
+                }
+            } else {
+                DocumentView::default()
+            };
+            *document = Document {
+                view,
+                ..Document::default()
+            };
+        }
+        document.key = key;
+        document.lines = Arc::new(lines);
+        document.spans = Arc::new(spans);
+        document.anchors = Arc::new(parsed_anchors);
+        document.anchored = anchored;
+    }
+    if document.anchored
+        && !document
+            .anchors
+            .iter()
+            .map(Option::as_ref)
+            .eq((0..document.lines.len()).map(|index| anchors.get(index)))
+    {
+        document.anchors = Arc::new(
+            (0..document.lines.len())
+                .map(|index| anchors.get(index).cloned())
+                .collect(),
+        );
+    }
+    if selected != document.applied_selection {
+        document.applied_selection = selected;
+        if let Some(range) = selected {
+            document.view.anchor = Some(range.start);
+            document.view.cursor = range.end;
+        }
+    }
+    if find != document.applied_find.as_ref() {
+        document.applied_find = find.cloned();
+        let count = match find {
+            Some(find) => {
+                document
+                    .view
+                    .set_find(&document.lines, &find.query, find.regex, find.case)
+            }
+            None => {
+                document.view.find = None;
+                Ok(0)
+            }
+        };
+        let payload = match count {
+            Ok(matches) => json!({"component": id, "kind": "find", "matches": matches}),
+            Err(error) => json!({"component": id, "kind": "find", "matches": 0, "error": error}),
+        };
+        crate::mod_surface::component_event(payload);
+    }
+    let height = height.map_or(DEFAULT_HEIGHT, usize::from);
+    document.height = height;
+    let total = document.lines.len();
+    if total == 0 {
+        return vec![Line::from(format!("{prefix}(empty)")).dim()];
+    }
+    let window = document.view.window(total, height);
+    let selection = document.view.selection();
+    let marker = crate::mod_ui::glyph("› ", "> ");
+    let matches = document
+        .view
+        .find
+        .as_ref()
+        .map(|find| {
+            find.matches
+                .iter()
+                .map(|(line, _, _)| *line)
+                .collect::<std::collections::BTreeSet<_>>()
+        })
+        .unwrap_or_default();
+    window
+        .map(|index| {
+            let cursor = index == document.view.cursor;
+            let lead = if focused && cursor { marker } else { "  " };
+            let mut style = Style::default();
+            if !keys
+                && selection.contains(&index)
+                && (document.view.anchor.is_some() || focused && cursor)
+            {
+                style = style.reversed();
+            }
+            if matches.contains(&index) {
+                style = style.underlined();
+            }
+            let mut line = vec![Span::raw(format!("{prefix}{lead}"))];
+            line.extend(
+                document.spans[index]
+                    .iter()
+                    .map(|span| span.clone().patch_style(style)),
+            );
+            Line::from(line)
+        })
+        .collect()
+}
+
+pub(crate) fn height(id: &str, total_hint: usize, height: Option<u16>) -> usize {
+    let height = height.map_or(DEFAULT_HEIGHT, usize::from);
+    let total = documents()
+        .get(id)
+        .map(|document| document.lines.len())
+        .unwrap_or(total_hint);
+    total.clamp(1, height)
+}
+
+pub(crate) fn key(
+    code: crossterm::event::KeyCode,
+    modifiers: crossterm::event::KeyModifiers,
+) -> Option<DocumentKey> {
+    use crossterm::event::KeyCode;
+    use crossterm::event::KeyModifiers;
+    Some(match (code, modifiers) {
+        (KeyCode::Up, KeyModifiers::NONE) => DocumentKey::Up,
+        (KeyCode::Down, KeyModifiers::NONE) => DocumentKey::Down,
+        (KeyCode::Up, KeyModifiers::SHIFT) => DocumentKey::ExtendUp,
+        (KeyCode::Down, KeyModifiers::SHIFT) => DocumentKey::ExtendDown,
+        (KeyCode::PageUp, _) => DocumentKey::PageUp,
+        (KeyCode::PageDown, _) => DocumentKey::PageDown,
+        (KeyCode::Home, _) => DocumentKey::Top,
+        (KeyCode::End, _) => DocumentKey::Bottom,
+        (KeyCode::Enter, KeyModifiers::NONE) => DocumentKey::Activate,
+        (KeyCode::Char('n'), KeyModifiers::NONE) => DocumentKey::FindNext,
+        (KeyCode::Char('N'), KeyModifiers::SHIFT | KeyModifiers::NONE) => DocumentKey::FindPrevious,
+        (KeyCode::Esc, _) => DocumentKey::Escape,
+        _ => return None,
+    })
+}
+
+/// Whether Up/Down would move past the document's first or last line.
+pub(crate) fn at_edge(id: &str, key: DocumentKey) -> bool {
+    documents().get(id).is_some_and(|document| match key {
+        DocumentKey::Up => document.view.cursor == 0,
+        DocumentKey::Down => document.view.cursor + 1 >= document.lines.len(),
+        _ => false,
+    })
+}
+
+pub(crate) fn handle(id: &str, key: DocumentKey) -> Option<(String, Option<String>)> {
+    let mut documents = documents();
+    let document = documents.get_mut(id)?;
+    let total = document.lines.len();
+    let height = document.height;
+    let event = document.view.handle(key, total, height)?;
+    let anchor = |line: usize| document.anchors.get(line).cloned().flatten();
+    let (payload, argument) = match event {
+        DocumentEvent::Select { start, end } => (
+            json!({"component": id, "kind": "select", "range": {"start": start, "end": end}, "anchor": anchor(start)}),
+            None,
+        ),
+        DocumentEvent::Activate { line } => {
+            let anchor = anchor(line);
+            (
+                json!({"component": id, "kind": "activate", "range": {"start": line, "end": line}, "anchor": anchor}),
+                Some(anchor.unwrap_or_else(|| (line + 1).to_string())),
+            )
+        }
+    };
+    drop(documents);
+    crate::mod_surface::component_event(payload);
+    Some((id.to_owned(), argument))
+}
+
+pub(crate) fn retain(ids: &std::collections::BTreeSet<String>) {
+    documents().retain(|id, _| ids.contains(id));
+    IMAGES.locked().retain(|id, _| ids.contains(id));
+    crate::mod_client::retain(ids);
+    crate::mod_raster::retain(ids);
+}
+
+pub(crate) fn invalidate() {
+    documents().clear();
+    crate::mod_raster::retain(&BTreeSet::new());
+    IMAGES.locked().clear();
+}
