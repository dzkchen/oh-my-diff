+fn package_event(package: &ModLockedPackage) -> Value {
+    json!({"id": package.id, "version": package.version, "integrity": package.integrity,
+        "scope": package.scope, "source": redacted_source(&package.source),
+        "capabilities": package.trust.capabilities, "enabled": package.enabled})
+}
+
+pub(super) fn redacted_source(source: &ModPackageSource) -> Value {
+    let url = |value: &str| {
+        let value = value.split(['?', '#']).next().unwrap_or_default();
+        match value.split_once("://") {
+            Some((scheme, rest)) => format!(
+                "{scheme}://{}",
+                rest.rsplit_once('@')
+                    .filter(|(userinfo, _)| !userinfo.contains('/'))
+                    .map_or(rest, |(_, host)| host)
+            ),
+            None => value.to_owned(),
+        }
+    };
+    match source {
+        ModPackageSource::Repository {
+            repository,
+            revision,
+            subdirectory,
+        } => json!({"kind": "repository", "repository": url(repository), "revision": revision,
+            "subdirectory": subdirectory}),
+        ModPackageSource::Npm {
+            package,
+            version,
+            registry,
+            integrity,
+        } => json!({"kind": "npm", "package": package, "version": version,
+            "registry": url(registry), "integrity": integrity}),
+        source => json!(source),
+    }
+}
+
+pub(super) fn error_code(error: &io::Error) -> String {
+    let message = error.to_string();
+    message
+        .split(':')
+        .next()
+        .unwrap_or_default()
+        .chars()
+        .take(96)
+        .collect()
+}
+
+fn same_approval(previous: &ModLockedPackage, next: &ModLockedPackage) -> bool {
+    previous.trust == next.trust
+        && previous.authority == next.authority
+        && previous.exec_environment == next.exec_environment
+        && same_origin(&previous.source, &next.source)
+}
+
+fn same_origin(previous: &ModPackageSource, next: &ModPackageSource) -> bool {
+    match (previous, next) {
+        (ModPackageSource::Local { path: a }, ModPackageSource::Local { path: b }) => a == b,
+        (
+            ModPackageSource::Repository {
+                repository: a,
+                subdirectory: c,
+                ..
+            },
+            ModPackageSource::Repository {
+                repository: b,
+                subdirectory: d,
+                ..
+            },
+        ) => a == b && c == d,
+        (
+            ModPackageSource::Package {
+                index: a, id: c, ..
+            },
+            ModPackageSource::Package {
+                index: b, id: d, ..
+            },
+        ) => a == b && c == d,
+        (
+            ModPackageSource::Npm {
+                package: a,
+                registry: c,
+                ..
+            },
+            ModPackageSource::Npm {
+                package: b,
+                registry: d,
+                ..
+            },
+        ) => a == b && c == d,
+        _ => false,
+    }
+}
+
+fn release_matches(requirement: &str, version: &str) -> bool {
+    requirement.is_empty()
+        || requirement == version
+        || service_version_satisfies(requirement, version)
+}
+
+fn version_selector(value: &str) -> bool {
+    value.is_empty()
+        || (value.len() <= 64
+            && value.bytes().all(|byte| {
+                byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'-' | b'+' | b'^')
+            }))
+}
+
+fn git_reference(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && !value.starts_with(['-', '/', '.'])
+        && !value.ends_with(['/', '.'])
+        && !value.contains("..")
+        && !value.contains("//")
+        && !value.ends_with(".lock")
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.' | b'/'))
+}
+
+fn npm_name(value: &str) -> bool {
+    let name = |part: &str| {
+        !part.is_empty()
+            && !part.starts_with(['.', '_'])
+            && part.bytes().all(|byte| {
+                byte.is_ascii_lowercase()
+                    || byte.is_ascii_digit()
+                    || matches!(byte, b'-' | b'.' | b'_' | b'~')
+            })
+    };
+    value.len() <= 214
+        && match value.strip_prefix('@').map(|rest| rest.split_once('/')) {
+            Some(Some((scope, package))) => name(scope) && name(package),
+            Some(None) => false,
+            None => name(value),
+        }
+}
+
+fn npm_url(value: &str) -> bool {
+    value.len() <= 2048
+        && !value
+            .chars()
+            .any(|character| character.is_whitespace() || character.is_control())
+        && (value.starts_with("https://")
+            || ["http://127.0.0.1:", "http://localhost:", "http://[::1]:"]
+                .iter()
+                .any(|prefix| value.starts_with(prefix)))
+}
+
+fn npm_integrity(bytes: &[u8]) -> String {
+    use base64::Engine;
+    format!(
+        "sha512-{}",
+        base64::engine::general_purpose::STANDARD.encode(sha2::Sha512::digest(bytes))
+    )
+}
+
+fn bounded_output(
+    command: &mut Command,
+    input: Option<String>,
+    limit: usize,
+    code: &str,
+) -> Result<Vec<u8>> {
+    let mut child = command
+        .stdin(if input.is_some() {
+            std::process::Stdio::piped()
+        } else {
+            std::process::Stdio::null()
+        })
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()?;
+    let mut bytes = Vec::new();
+    let read = (|| {
+        if let (Some(input), Some(mut stdin)) = (input, child.stdin.take()) {
+            std::io::Write::write_all(&mut stdin, input.as_bytes())?;
+        }
+        child
+            .stdout
+            .take()
+            .ok_or_else(|| failure(code))?
+            .take(limit as u64 + 1)
+            .read_to_end(&mut bytes)
+    })();
+    if read.is_err() || bytes.len() > limit {
+        let _ = child.kill();
+        let _ = child.wait();
+        read?;
+        return Err(failure(format!("{code}: larger than {limit} bytes")));
+    }
+    let output = child.wait_with_output()?;
+    if !output.status.success() {
+        return Err(failure(format!(
+            "{code}: {}",
+            String::from_utf8_lossy(&output.stderr)
+                .trim()
+                .chars()
+                .take(256)
+                .collect::<String>()
+        )));
+    }
+    Ok(bytes)
+}
+
+fn npm_fetch(url: &str, limit: usize, accept: &str, token: Option<&str>) -> Result<Vec<u8>> {
+    if token.is_some_and(|token| {
+        token
+            .chars()
+            .any(|character| character == '"' || character == '\\' || character.is_control())
+    }) {
+        return Err(failure("npm_token_invalid: check _authToken in .npmrc"));
+    }
+    let mut command = Command::new("/usr/bin/curl");
+    command.env_clear().env("PATH", "/usr/bin:/bin").envs(
+        [
+            "HTTPS_PROXY",
+            "https_proxy",
+            "HTTP_PROXY",
+            "http_proxy",
+            "ALL_PROXY",
+            "all_proxy",
+            "NO_PROXY",
+            "no_proxy",
+        ]
+        .iter()
+        .filter_map(|name| Some((*name, std::env::var_os(name)?))),
+    );
+    if token.is_some() {
+        command.args(["--config", "-"]);
+    }
+    bounded_output(
+        command
+            .args([
+                "--silent",
+                "--show-error",
+                "--fail",
+                "--location",
+                "--max-redirs",
+                "3",
+                "--proto",
+                "=https,http",
+                "--proto-redir",
+                "=https",
+                "--connect-timeout",
+                "20",
+                "--max-time",
+                "120",
+                "--header",
+            ])
+            .arg(format!("Accept: {accept}"))
+            .arg(url),
+        token.map(|token| format!("header = \"Authorization: Bearer {token}\"\n")),
+        limit,
+        "npm_fetch_failed",
+    )
+}
+
+fn npm_archive_files(archive: &Path) -> Result<BTreeMap<String, Vec<u8>>> {
+    let tar = bounded_output(
+        Command::new("/usr/bin/gzip")
+            .env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .arg("-dc")
+            .arg(archive),
+        None,
+        NPM_UNPACKED_LIMIT,
+        "npm_archive_invalid",
+    )?;
+    let field = |bytes: &[u8]| {
+        String::from_utf8_lossy(
+            &bytes[..bytes
+                .iter()
+                .position(|byte| *byte == 0)
+                .unwrap_or(bytes.len())],
+        )
+        .into_owned()
+    };
+    let mut files = BTreeMap::new();
+    let mut offset = 0;
+    let mut long_name = None;
+    while offset + 512 <= tar.len() {
+        let header = &tar[offset..offset + 512];
+        if header.iter().all(|byte| *byte == 0) {
+            break;
+        }
+        let size = usize::from_str_radix(field(&header[124..136]).trim(), 8)
+            .map_err(|_| failure("npm_archive_invalid: entry size"))?;
+        let start = offset + 512;
+        let end = start
+            .checked_add(size)
+            .filter(|end| *end <= tar.len())
+            .ok_or_else(|| failure("npm_archive_invalid: truncated"))?;
+        let data = &tar[start..end];
+        offset = start + size.div_ceil(512) * 512;
+        let name = long_name.take().unwrap_or_else(|| {
+            let prefix = field(&header[345..500]);
+            let name = field(&header[..100]);
+            if prefix.is_empty() {
+                name
+            } else {
+                format!("{prefix}/{name}")
+            }
+        });
+        match header[156] {
+            b'x' => {
+                long_name = String::from_utf8_lossy(data).lines().find_map(|record| {
+                    record
+                        .split_once(' ')
+                        .and_then(|(_, record)| record.strip_prefix("path="))
+                        .map(str::to_owned)
+                });
+                continue;
+            }
+            b'L' => {
+                long_name = Some(field(data));
+                continue;
+            }
+            b'g' | b'5' => continue,
+            b'0' | 0 => {}
+            _ => return Err(failure(format!("npm_archive_link_rejected: {name}"))),
+        }
+        let relative = name
+            .split_once('/')
+            .map(|(_, relative)| relative)
+            .filter(|relative| {
+                relative
+                    .split('/')
+                    .all(|part| !part.is_empty() && part != "." && part != "..")
+            })
+            .ok_or_else(|| failure(format!("npm_archive_path_rejected: {name}")))?;
+        if files.len() >= NPM_ARCHIVE_ENTRIES
+            || files.insert(relative.to_owned(), data.to_vec()).is_some()
+        {
+            return Err(failure(
+                "npm_archive_invalid: too many or duplicate entries",
+            ));
+        }
+    }
+    Ok(files)
+}
+
+fn package_directory(value: &str) -> bool {
+    value.is_empty()
+        || (!value.starts_with('/')
+            && value.len() <= 256
+            && value.split('/').all(|part| {
+                !part.is_empty()
+                    && part != "."
+                    && part != ".."
+                    && part.bytes().all(|byte| {
+                        byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.')
+                    })
+            }))
+}
+
+fn validate_package_lock(lock: &ModPackageLock) -> Result<()> {
+    if lock
+        .history
+        .values()
+        .any(|history| history.len() > PACKAGE_HISTORY_LIMIT)
+        || lock.packages.iter().any(|(id, package)| {
+            id != &package.id
+                || package.integrity.len() != 64
+                || !package
+                    .integrity
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit())
+        })
+    {
+        return Err(failure("invalid_package_lock"));
+    }
+    Ok(())
+}
+
+fn push_history(
+    lock: &mut ModPackageLock,
+    id: &str,
+    package: ModLockedPackage,
+) -> Option<ModLockedPackage> {
+    let history = lock.history.entry(id.to_owned()).or_default();
+    history.push(package);
+    (history.len() > PACKAGE_HISTORY_LIMIT).then(|| history.remove(0))
+}
+
+fn validate_locked_graph(packages: &BTreeMap<String, ModLockedPackage>) -> Result<()> {
+    for package in packages.values() {
+        for dependency in &package.dependencies {
+            let resolved = packages
+                .get(&dependency.id)
+                .ok_or_else(|| failure(format!("dependency_unavailable: {}", dependency.id)))?;
+            if !service_version_satisfies(&dependency.version, &resolved.version) {
+                return Err(failure("dependency_version_incompatible"));
+            }
+        }
+    }
+    let mut remaining: BTreeSet<_> = packages.keys().cloned().collect();
+    while let Some(id) = remaining
+        .iter()
+        .find(|id| {
+            packages[*id]
+                .dependencies
+                .iter()
+                .all(|dependency| !remaining.contains(&dependency.id))
+        })
+        .cloned()
+    {
+        remaining.remove(&id);
+    }
+    if remaining.is_empty() {
+        Ok(())
+    } else {
+        Err(failure(format!(
+            "dependency_cycle: {}",
+            remaining.into_iter().collect::<Vec<_>>().join(" -> ")
+        )))
+    }
+}
+
+fn package_changes(
+    existing: &ModPackageLock,
+    packages: &[ModLockedPackage],
+    handlers: &BTreeSet<String>,
+) -> Value {
+    let mut changes = Vec::new();
+    for package in packages {
+        let previous = existing.packages.get(&package.id);
+        changes.push(json!({
+            "id":package.id,
+            "version":{"from":previous.map(|value|&value.version),"to":package.version},
+            "integrity":{"from":previous.map(|value|&value.integrity),"to":package.integrity},
+            "source":{"from":previous.map(|value|&value.source),"to":package.source},
+            "license":{"from":previous.map(|value|&value.license),"to":package.license},
+            "provenance":{"from":previous.map(|value|&value.provenance),"to":package.provenance},
+            "entrypoint":{"from":previous.map(|value|&value.entrypoint),"to":package.entrypoint},
+            "api":{"from":previous.map(|value|&value.api),"to":package.api},
+            "state_version":{"from":previous.map(|value|value.state_version),"to":package.state_version,
+                "migration_required":previous.is_some_and(|value|value.state_version != package.state_version) && !package.enabled,
+                "handler_required":handlers.contains(&package.id)},
+            "dependencies":{"from":previous.map(|value|&value.dependencies),"to":package.dependencies},
+            "capabilities":{"from":previous.map(|value|&value.capabilities),"to":package.capabilities},
+            "authority":{"from":previous.map(|value|&value.authority),"to":package.authority},
+            "grant":{"from":previous.map(|value|&value.trust),"to":package.trust},
+            "renewed_approval":previous.is_none_or(|value|!same_approval(value, package)),
+            "exec_environment":{"from":previous.map(|value|&value.exec_environment),"to":package.exec_environment},
+            "secret_environment":{"from":previous.map(|value|&value.trust.secret_environment),"to":package.trust.secret_environment},
+            "settings_schema_sha256":{"from":previous.map(|value|&value.settings_schema_sha256),"to":package.settings_schema_sha256},
+            "settings":{"from":previous.map(|value|&value.settings),"to":package.settings},
+            "lifecycle":{"from":previous.map(|value|&value.lifecycle),"to":package.lifecycle},
+            "activation":{"from":previous.is_some_and(|value|value.enabled),"to":package.enabled}
+        }));
+    }
+    Value::Object(Map::from_iter([
+        ("packages".to_owned(), Value::Array(changes)),
+        (
+            "authority".to_owned(),
+            json!(
+                "dependency resolution installs no capability, lifecycle, permission, credential, provider, or spending grant"
+            ),
+        ),
+        ("local_sources_preserved".to_owned(), Value::Bool(true)),
+        (
+            "activation".to_owned(),
+            json!(
+                "installing never enables a package; an update keeps a package on only when its grant, authority, origin and exec environment are unchanged"
+            ),
+        ),
+    ]))
+}
+
+fn selected_settings(
+    config: &ModConfiguration,
+    locked: &ModLockedPackage,
+) -> BTreeMap<String, Value> {
+    config
+        .mods
+        .iter()
+        .find(|selection| selection.scope == locked.scope && selection.path == locked.path)
+        .map_or_else(
+            || locked.settings.clone(),
+            |selection| selection.settings.clone(),
+        )
+}
+
+fn require_migration_handlers(plan: &ModPackagePlan, scope: &str) -> Result<()> {
+    let changes = plan.changes["packages"]
+        .as_array()
+        .map_or(&[][..], Vec::as_slice);
+    for (locked, change) in plan.packages.iter().zip(changes) {
+        if change["state_version"]["handler_required"] != true {
+            continue;
+        }
+        let (package, source, _, assets) = store::package_with_assets(&locked.path)?;
+        let state_scope = package.state_scope.clone();
+        let selection = ModSelection {
+            path: locked.path.clone(),
+            sha256: locked.integrity.clone(),
+            enabled: false,
+            capabilities: package.capabilities.clone(),
+            settings: locked.settings.clone(),
+            scope: scope.to_owned(),
+            secret_environment: Vec::new(),
+            expires_at: None,
+            tier: None,
+            required: false,
+        };
+        let loaded = packages::detached(package, source, assets, selection, Value::Null);
+        packages::migration_registrations(&loaded).map_err(|error| {
+            if error.to_string() != "explicit_migration_handler_required" {
+                return error;
+            }
+            failure(format!(
+                "migration_handler_required: {} changes its {state_scope} state_version without a migrate handler",
+                locked.id
+            ))
+        })?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod repository_tests {
+    use super::*;
+
+    #[test]
+    fn npmrc_interpolation_expands_only_original_references_once() {
+        let environment = BTreeMap::from([
+            ("LITERAL", "${TOKEN}"),
+            ("TOKEN", "secret"),
+            ("SELF", "${SELF}"),
+            ("A", "${B}"),
+            ("B", "${A}"),
+        ]);
+        let resolve = |name: &str| environment.get(name).map(|value| value.to_string());
+        for (value, expected) in [
+            ("${LITERAL}", "${TOKEN}"),
+            ("${TOKEN}-${LITERAL}", "secret-${TOKEN}"),
+            ("${MISSING}x${TOKEN}", "xsecret"),
+            ("${SELF}", "${SELF}"),
+            ("${A}:${B}", "${B}:${A}"),
+            ("a${TOKEN}${unclosed", "asecret${unclosed"),
+        ] {
+            assert_eq!(interpolate(value, resolve), expected, "{value}");
+        }
+    }
+
+    #[test]
+    fn online_repository_content_does_not_trust_cached_objects_or_origins() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let origin = root.join("origin");
+        let other = root.join("other");
+        for (path, value) in [(&origin, "good"), (&other, "evil")] {
+            std::fs::create_dir(path).unwrap();
+            std::fs::write(path.join("value"), value).unwrap();
+            git(path, &["init"]).unwrap();
+            git(path, &["add", "."]).unwrap();
+            git(
+                path,
+                &[
+                    "-c",
+                    "user.name=Fixture",
+                    "-c",
+                    "user.email=fixture@example.com",
+                    "commit",
+                    "-m",
+                    "fixture",
+                ],
+            )
+            .unwrap();
+        }
+        let revision = git(&origin, &["rev-parse", "HEAD"])
+            .unwrap()
+            .trim()
+            .to_owned();
+        let other_revision = git(&other, &["rev-parse", "HEAD"])
+            .unwrap()
+            .trim()
+            .to_owned();
+        let cached = root.join("cached.git");
+        git(
+            &root,
+            &[
+                "clone",
+                "--bare",
+                "--no-hardlinks",
+                origin.to_str().unwrap(),
+                cached.to_str().unwrap(),
+            ],
+        )
+        .unwrap();
+        git(&cached, &["fetch", other.to_str().unwrap(), "HEAD"]).unwrap();
+        git(
+            &cached,
+            &[
+                "config",
+                &format!("url.{}.insteadOf", other.display()),
+                origin.to_str().unwrap(),
+            ],
+        )
+        .unwrap();
+        let blob = git(&origin, &["rev-parse", "HEAD:value"])
+            .unwrap()
+            .trim()
+            .to_owned();
+        let other_blob = git(&other, &["rev-parse", "HEAD:value"])
+            .unwrap()
+            .trim()
+            .to_owned();
+        std::fs::copy(
+            other
+                .join(".git/objects")
+                .join(&other_blob[..2])
+                .join(&other_blob[2..]),
+            cached.join("objects").join(&blob[..2]).join(&blob[2..]),
+        )
+        .unwrap();
+        assert!(
+            repository_view(
+                &root,
+                &cached,
+                origin.to_str().unwrap(),
+                &other_revision,
+                false
+            )
+            .is_err()
+        );
+        let online =
+            repository_view(&root, &cached, origin.to_str().unwrap(), &revision, false).unwrap();
+        assert_eq!(
+            git_bytes(online.path(), &["show", &format!("{revision}:value")]).unwrap(),
+            b"good"
+        );
+    }
+}
diff --git a/codex-rs/omd/src/mods/packages.rs b/codex-rs/omd/src/mods/packages.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6b08a1559fdecbdb111d3896693901cbdcb4a2c0
--- /dev/null
+++ b/codex-rs/omd/src/mods/packages.rs
@@ -0,0 +1,398 @@
+use super::*;
+
+pub const SETTINGS_FILE_EXTENSIONS: [&str; 3] = ["json", "yaml", "yml"];
+
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct SettingsFile {
+    pub path: String,
+    pub status: &'static str,
+    pub error: Option<String>,
+}
+
+impl ModStore {
+    pub fn settings_file(
+        &self,
+        package: &ModPackage,
+        selection: &ModSelection,
+    ) -> (SettingsFile, BTreeMap<String, Value>) {
+        let path = |extension: &str| {
+            self.root
+                .join("settings")
+                .join(format!("{}.{extension}", package.id))
+        };
+        let present: Vec<PathBuf> = SETTINGS_FILE_EXTENSIONS
+            .iter()
+            .map(|extension| path(extension))
+            .filter(|path| std::fs::symlink_metadata(path).is_ok())
+            .collect();
+        let chosen = present.first().cloned().unwrap_or_else(|| path("json"));
+        let mut file = SettingsFile {
+            path: chosen.to_string_lossy().into_owned(),
+            status: "missing",
+            error: None,
+        };
+        if present.is_empty() {
+            return (file, BTreeMap::new());
+        }
+        if selection.scope == MANAGED_SCOPE {
+            file.status = "ignored";
+            return (file, BTreeMap::new());
+        }
+        let values = (|| {
+            if present.len() > 1 {
+                return Err(failure("more_than_one_settings_file"));
+            }
+            let bytes = store::read(&chosen, 65_536)?;
+            let parsed: Value = match chosen.extension().and_then(|name| name.to_str()) {
+                Some("json") => serde_json::from_slice(&bytes).map_err(failure)?,
+                _ => serde_yaml::from_slice(&bytes).map_err(failure)?,
+            };
+            let Value::Object(object) = parsed else {
+                return Err(failure("settings_file_must_be_object"));
+            };
+            let values: BTreeMap<String, Value> = object.into_iter().collect();
+            let mut merged = selection.settings.clone();
+            merged.extend(values.clone());
+            validate_settings(package, &merged)?;
+            Ok(values)
+        })();
+        match values {
+            Ok(values) => {
+                file.status = "loaded";
+                (file, values)
+            }
+            Err(error) => {
+                file.status = "invalid";
+                file.error = Some(error.to_string());
+                (file, BTreeMap::new())
+            }
+        }
+    }
+
+    pub fn settings(&self, path: &Path, settings: BTreeMap<String, Value>) -> Result<()> {
+        self.update_settings(path, |current| *current = settings)
+            .map(drop)
+    }
+
+    pub fn merge_settings(
+        &self,
+        path: &Path,
+        values: &serde_json::Map<String, Value>,
+    ) -> Result<BTreeMap<String, Value>> {
+        self.update_settings(path, |settings| {
+            for (name, value) in values {
+                if value.is_null() {
+                    settings.remove(name);
+                } else {
+                    settings.insert(name.clone(), value.clone());
+                }
+            }
+        })
+    }
+
+    fn update_settings(
+        &self,
+        path: &Path,
+        change: impl FnOnce(&mut BTreeMap<String, Value>),
+    ) -> Result<BTreeMap<String, Value>> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if hash != selection.sha256 {
+            return Err(failure("source_changed: inspect and trust the new digest"));
+        }
+        let mut settings = selection.settings.clone();
+        change(&mut settings);
+        validate_settings(&package, &settings)?;
+        if settings == selection.settings {
+            return Ok(settings);
+        }
+        selection.settings = settings.clone();
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.write("mods.json", &serde_json::to_value(config)?)?;
+        Ok(settings)
+    }
+
+    pub fn discover(user: &Path, project: &Path) -> Result<Value> {
+        let mut selected: BTreeMap<String, Value> = BTreeMap::new();
+        let mut errors = Vec::new();
+        for (scope, root) in [("user", user), ("project", project)] {
+            if !root.exists() {
+                continue;
+            }
+            let mut paths = std::fs::read_dir(root)?
+                .map(|e| e.map(|e| e.path()))
+                .collect::<std::io::Result<Vec<_>>>()?;
+            if paths.len() > 256 {
+                return Err(failure("discovery_limit"));
+            }
+            paths.sort();
+            for path in paths {
+                if !path.is_dir() {
+                    continue;
+                }
+                let result = path
+                    .canonicalize()
+                    .and_then(|path| Self::inspect_package(&path));
+                match result {
+                    Ok(mut value) => {
+                        let id = value["manifest"]["id"]
+                            .as_str()
+                            .ok_or_else(|| failure("missing_mod_id"))?
+                            .to_owned();
+                        value["scope"] = json!(scope);
+                        value["shadows"] = selected
+                            .get(&id)
+                            .map(|v| v["path"].clone())
+                            .unwrap_or(Value::Null);
+                        value["trusted"] = json!(false);
+                        selected.insert(id, value);
+                    }
+                    Err(error) => errors.push(json!({"path":path,"error":error.to_string()})),
+                }
+            }
+        }
+        Ok(
+            json!({"packages":selected.into_values().collect::<Vec<_>>(),"errors":errors,"precedence":"project over user; discovery never grants trust"}),
+        )
+    }
+
+    pub fn migrate(&self, target: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = selected(&config, target)?;
+        let (package, source, hash, assets) = store::package_with_assets(&selection.path)?;
+        if hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package.capabilities.iter().any(|c| c == "store")
+        {
+            return Err(failure("migration_requires_trusted_store_capability"));
+        }
+        let name = ModStore::state_name(&package.id, &selection.scope);
+        let previous: Value = serde_json::from_slice(
+            &store::read(&self.root.join(&name), store::STATE_LIMIT as u64).map_err(|error| {
+                if error.kind() == io::ErrorKind::NotFound {
+                    failure("migration_requires_saved_state")
+                } else {
+                    error
+                }
+            })?,
+        )?;
+        let from = previous["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if previous["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || from == u64::from(package.state_version)
+        {
+            return Err(failure("migration_requires_different_state_version"));
+        }
+        let to = package.state_version;
+        let mut loaded = detached(
+            package,
+            source,
+            assets,
+            selection.clone(),
+            previous["value"].clone(),
+        );
+        self.verified_runner()?;
+        loaded.registrations = migration_registrations(&loaded)?;
+        let state = run_migration(&loaded, from, &|| true)?;
+        let backup = format!("{name}-backup-{}", digest(&serde_json::to_vec(&previous)?));
+        self.write(&backup, &previous)?;
+        self.write(
+            &name,
+            &json!({"schema":MOD_STATE_STORAGE_SCHEMA_VERSION,"version":to,"value":state}),
+        )?;
+        Ok(
+            json!({"id":loaded.package.id,"from":from,"to":to,"backup":self.root.join(backup),
+            "source_sha256":hash,"settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+
+    pub fn rollback(&self, target: &Path, backup: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = selected(&config, target)?;
+        let (package, _, hash) = store::package(&selection.path)?;
+        if selection.enabled
+            || hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "store")
+        {
+            return Err(failure(
+                "rollback_requires_disabled_trusted_store_capability",
+            ));
+        }
+        let backup = backup.canonicalize()?;
+        if backup.parent() != Some(self.root.as_path()) {
+            return Err(failure("rollback_backup_must_be_in_store"));
+        }
+        let state_name = ModStore::state_name(&package.id, &selection.scope);
+        let prefix = format!("{state_name}-backup-");
+        let backup_name = backup
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| failure("rollback_backup_does_not_match_package_scope"))?;
+        let Some(expected_digest) = backup_name.strip_prefix(&prefix) else {
+            return Err(failure("rollback_backup_does_not_match_package_scope"));
+        };
+        let restored: Value =
+            serde_json::from_slice(&store::read(&backup, store::STATE_LIMIT as u64)?)?;
+        if digest(&serde_json::to_vec(&restored)?) != expected_digest {
+            return Err(failure("rollback_backup_digest_mismatch"));
+        }
+        let restored_version = restored["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if restored["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION {
+            return Err(failure("incompatible_state_storage_schema"));
+        }
+        let current_path = self.root.join(&state_name);
+        let current: Value =
+            serde_json::from_slice(&store::read(&current_path, store::STATE_LIMIT as u64)?)?;
+        if current["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || current["version"].as_u64().is_none()
+        {
+            return Err(failure("incompatible_current_state"));
+        }
+        let recovery = format!(
+            "{state_name}-rollback-{}",
+            digest(&serde_json::to_vec(&current)?)
+        );
+        self.write(&recovery, &current)?;
+        self.write(&state_name, &restored)?;
+        Ok(
+            json!({"id":package.id,"from":current["version"],"to":restored_version,
+            "restored":backup,"recovery":self.root.join(recovery),"source_sha256":hash,
+            "settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+}
+
+/// The selection for a package folder or, given a bare name, the one selected copy with that mod id.
+fn selected<'a>(config: &'a ModConfiguration, target: &Path) -> Result<&'a ModSelection> {
+    let id = (target.components().count() == 1 && target.is_relative())
+        .then(|| target.to_str())
+        .flatten();
+    let mut matches = config.mods.iter().filter(|selection| match id {
+        Some(id) => store::package(&selection.path).is_ok_and(|(package, _, _)| package.id == id),
+        None => selection.path == target,
+    });
+    match (matches.next(), matches.next()) {
+        (Some(selection), None) => Ok(selection),
+        (Some(_), Some(_)) => Err(failure(
+            "mod_ambiguous: more than one selected copy has this id; pass its package folder",
+        )),
+        _ => Err(failure("package_not_trusted")),
+    }
+}
+
+/// Whether a state read failed on thread or checkout state stored at another version that the mod can migrate; store-scope state migrates only through `ModStore::migrate`.
+pub(super) fn migratable(
+    loaded: &Loaded,
+    location: &store::StateLocation,
+    error: &io::Error,
+) -> bool {
+    matches!(location, store::StateLocation::Directory(..))
+        && error.to_string().starts_with("state_migration_required")
+        && loaded.package.capabilities.iter().any(|c| c == "store")
+        && loaded.registrations.events.iter().any(|e| e == "migrate")
+}
+
+pub(super) fn migrate_state(
+    loaded: &Loaded,
+    location: &store::StateLocation,
+    active: &dyn Fn() -> bool,
+) -> Result<Value> {
+    let store::StateLocation::Directory(directory, name) = location else {
+        return Err(failure(
+            "state_migration_required: previous state preserved",
+        ));
+    };
+    store::migrate_directory_state(
+        directory,
+        name,
+        loaded.package.state_version,
+        |from, value| {
+            let mut previous = loaded.clone();
+            previous.state = value;
+            previous.registrations = migration_registrations(&previous)?;
+            run_migration(&previous, from, active)
+        },
+    )
+}
+
+pub(super) fn detached(
+    package: ModPackage,
+    source: String,
+    assets: BTreeMap<String, String>,
+    selection: ModSelection,
+    state: Value,
+) -> Loaded {
+    Loaded {
+        package,
+        source: source.into(),
+        assets: Arc::new(store::asset_map(assets)),
+        request_metadata: Arc::new(OnceLock::new()),
+        code_cache: None,
+        selection,
+        adapter: None,
+        state,
+        registered_state: std::sync::Arc::default(),
+        ui: None,
+        ui_state: Value::Null,
+        ui_revision: 0,
+        ui_clears: 0,
+        command_view: None,
+        registrations: Registrations::default(),
+        source_use: ModSourceUse::default(),
+        unused_grants: Vec::new(),
+        unused_environment: Vec::new(),
+        withheld: Vec::new(),
+        settings_file: SettingsFile {
+            path: String::new(),
+            status: "missing",
+            error: None,
+        },
+        error: None,
+        telemetry: ModTelemetry::default(),
+    }
+}
+
+pub(super) fn migration_registrations(loaded: &Loaded) -> Result<Registrations> {
+    let inspected = ModHost::run(loaded, "inspect", "", Value::Null, &|| true)?;
+    ModHost::validate_registrations(&loaded.package, &inspected.registrations)?;
+    if inspected.state != loaded.state
+        || !inspected
+            .registrations
+            .events
+            .iter()
+            .any(|e| e == "migrate")
+    {
+        return Err(failure("explicit_migration_handler_required"));
+    }
+    Ok(inspected.registrations)
+}
+
+fn run_migration(loaded: &Loaded, from: u64, active: &dyn Fn() -> bool) -> Result<Value> {
+    let to = loaded.package.state_version;
+    let reply = ModHost::run(loaded, "migrate", "", json!({"from":from,"to":to}), active)?;
+    if reply.registrations != loaded.registrations {
+        return Err(failure("migration_changed_registration"));
+    }
+    Ok(reply.state)
+}
diff --git a/codex-rs/omd/src/mods/persisted.rs b/codex-rs/omd/src/mods/persisted.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb228f8813ecf358864e76057fe3345344b41d27
--- /dev/null
+++ b/codex-rs/omd/src/mods/persisted.rs
@@ -0,0 +1,194 @@
+use super::*;
+
+/// JSON bytes of entries per callback; the payload carries them twice (`input` and `original`).
+pub const PERSIST_CHUNK_BYTES: usize = 49_152;
+pub const PERSIST_WITHHELD: &str = "[withheld: a required history_persist interceptor failed]";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PersistedRewrite {
+    pub texts: Vec<String>,
+    pub by: String,
+}
+
+fn escaped(c: char) -> usize {
+    match c {
+        '"' | '\\' | '\n' | '\r' | '\t' | '\u{8}' | '\u{c}' => 2,
+        c if u32::from(c) < 0x20 => 6,
+        c => c.len_utf8(),
+    }
+}
+
+/// Where a chunk of `text` ends: within `budget` JSON-escaped bytes, after the last whitespace there so a token stays whole, and after at least one character.
+pub fn persist_cut(text: &str, budget: usize) -> usize {
+    let mut size = 0;
+    let end = text
+        .char_indices()
+        .find(|(_, c)| {
+            size += escaped(*c);
+            size > budget
+        })
+        .map_or(
+            text.len(),
+            |(at, c)| if at == 0 { c.len_utf8() } else { at },
+        );
+    if end == text.len() {
+        return end;
+    }
+    text[..end]
+        .rfind(|c: char| c.is_ascii_whitespace())
+        .map_or(end, |at| at + 1)
+}
+
+/// Entries (`{kind, role, call_id, text}`) in callbacks of at most `PERSIST_CHUNK_BYTES` of JSON; a longer text arrives as consecutive entries with the same index.
+pub fn persist_chunks(entries: &[Value]) -> Vec<Vec<(usize, Value)>> {
+    let mut chunks: Vec<Vec<(usize, Value)>> = vec![Vec::new()];
+    let mut size = 0;
+    for (index, entry) in entries.iter().enumerate() {
+        let mut rest = entry["text"].as_str().unwrap_or_default();
+        let value = |text: &str| {
+            json!({"index":index,"kind":entry["kind"],"role":entry["role"],
+                "call_id":entry["call_id"],"text":text})
+        };
+        let overhead = value("").to_string().len();
+        loop {
+            let cut = persist_cut(rest, PERSIST_CHUNK_BYTES.saturating_sub(overhead));
+            let piece = value(&rest[..cut]);
+            let bytes = piece.to_string().len();
+            if size + bytes > PERSIST_CHUNK_BYTES {
+                chunks.push(Vec::new());
+                size = 0;
+            }
+            size += bytes;
+            if let Some(chunk) = chunks.last_mut() {
+                chunk.push((index, piece));
+            }
+            rest = &rest[cut..];
+            if rest.is_empty() {
+                break;
+            }
+        }
+    }
+    chunks
+}
+
+/// Mods whose link changed the entries: what it passed down or returned differs from its downstream's, or, answering alone, its result differs from its input; every mod that ran when a truncated trace shows no such link.
+pub fn persist_changed_by(trace: &[Value]) -> Vec<String> {
+    let ran = |entry: &&Value| entry.get("returned").is_some();
+    let links = trace
+        .iter()
+        .filter(ran)
+        .filter(|entry| entry["mod"] != "engine")
+        .collect::<Vec<_>>();
+    let changed = links
+        .iter()
+        .copied()
+        .filter(|link| {
+            match trace
+                .iter()
+                .filter(ran)
+                .filter(|entry| entry["index"].as_u64() > link["index"].as_u64())
+                .min_by_key(|entry| entry["index"].as_u64())
+            {
+                Some(next) => {
+                    link["received"] != next["received"] || link["returned"] != next["returned"]
+                }
+                None => link["received"] != link["returned"],
+            }
+        })
+        .collect::<Vec<_>>();
+    if changed.is_empty() { links } else { changed }
+        .into_iter()
+        .filter_map(|link| link["mod"].as_str())
+        .map(|id| format!("mod:{id}"))
+        .collect()
+}
+
+/// `None` when no interceptor is installed or nothing changed; a required interceptor's failure withholds its entries. `Err` means the runtime itself was unusable, so the caller decides from the published requirement.
+pub fn persist_texts(
+    runtime: &Mutex<ModHost>,
+    thread: &str,
+    entries: &[Value],
+    active: impl Fn() -> bool,
+) -> std::result::Result<Option<PersistedRewrite>, &'static str> {
+    if !active() {
+        return Err("persist_runtime_unavailable");
+    }
+    let _thread = StateThread::enter(Some(thread.to_owned()));
+    let mut runtime = runtime.lock().map_err(|_| "persist_runtime_unavailable")?;
+    runtime
+        .refresh_guarded(&active)
+        .map_err(|_| "persist_runtime_unavailable")?;
+    let required = match runtime.intercepts("history_persist") {
+        Some(required) => required,
+        None => return Ok(None),
+    };
+    let mut texts = vec![String::new(); entries.len()];
+    let mut withheld = vec![false; entries.len()];
+    let mut by = Vec::new();
+    for chunk in persist_chunks(entries) {
+        if !active() {
+            return Err("persist_runtime_unavailable");
+        }
+        let values = chunk
+            .iter()
+            .map(|(_, entry)| entry.clone())
+            .collect::<Vec<_>>();
+        let chain = chain::intercept(
+            &mut Access::Held(&mut runtime),
+            &mut |_, call| {
+                Err(std::io::Error::other(format!(
+                    "host_operation_unavailable: history_persist interceptors run while history is persisted ({})",
+                    call.operation
+                )))
+            },
+            &mut chain::Core::Call(&mut |input| Ok(json!({"entries": input["entries"]}))),
+            "history_persist",
+            required,
+            json!({"thread_id":thread,"entries":values}),
+            json!({"caller":"host","thread_id":thread}),
+            &active,
+            &InvocationScope::default(),
+        )
+        .ok();
+        let rewritten = chain
+            .as_ref()
+            .and_then(|chain| chain.result["entries"].as_array());
+        let mut changed = false;
+        for (position, (index, original)) in chunk.iter().enumerate() {
+            let given = original["text"].as_str().unwrap_or_default();
+            let text = rewritten
+                .and_then(|entries| entries.get(position))
+                .and_then(|entry| entry["text"].as_str());
+            match text {
+                Some(text) => {
+                    changed |= text != given;
+                    texts[*index].push_str(text);
+                }
+                None => {
+                    withheld[*index] |= required;
+                    texts[*index].push_str(given);
+                }
+            }
+        }
+        if changed && let Some(chain) = &chain {
+            by.extend(persist_changed_by(&chain.trace));
+        }
+    }
+    if !active() {
+        return Err("persist_runtime_unavailable");
+    }
+    for (text, withheld) in texts.iter_mut().zip(&withheld) {
+        if *withheld {
+            *text = PERSIST_WITHHELD.to_owned();
+        }
+    }
+    if withheld.contains(&true) {
+        by.push("host".to_owned());
+    }
+    by.sort();
+    by.dedup();
+    Ok((!by.is_empty()).then(|| PersistedRewrite {
+        texts,
+        by: by.join(", "),
+    }))
+}
