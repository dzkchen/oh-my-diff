+/// The launcher's `OMD_TUI_*` knobs, read once: they are consulted on every frame.
+fn knobs() -> &'static Knobs {
+    static KNOBS: std::sync::OnceLock<Knobs> = std::sync::OnceLock::new();
+    KNOBS.get_or_init(|| {
+        let is = |name: &str, value: &str| std::env::var(name).as_deref() == Ok(value);
+        Knobs {
+            ascii: is("OMD_TUI_ASCII", "1"),
+            mouse_off: is("OMD_TUI_MOUSE", "off"),
+            header_off: is("OMD_TUI_HEADER", "off"),
+            plain_composer: is("OMD_TUI_COMPOSER", "plain"),
+        }
