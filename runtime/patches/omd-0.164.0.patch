+pub(in crate::mods) fn blit_sink(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+) -> Option<crate::managed_process::BlitSink> {
+    let grants = caller.grants.as_ref()?;
+    if !grants
+        .capabilities
+        .iter()
+        .any(|capability| capability == "terminal")
+    {
+        return None;
+    }
+    let remote = REMOTE.try_with(|remote| *remote).unwrap_or(false);
+    let (id, source, generation, thread) = (
+        caller.id.to_owned(),
+        caller.source.to_owned(),
+        caller.generation,
+        lead.thread.to_string(),
+    );
+    let runtime = core.runtime.clone();
+    let owner = id.clone();
+    let admitted_source = source.clone();
+    let capabilities = grants.capabilities.clone();
+    let verified = Arc::new(Mutex::new(None::<std::time::Instant>));
+    let last = verified.clone();
+    let current = move || {
+        let age = last
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .map(|at| at.elapsed());
+        if age.is_some_and(|age| age < std::time::Duration::from_millis(250)) {
+            return Ok(());
+        }
+        let mut runtime = match runtime.try_lock() {
+            Ok(runtime) => runtime,
+            Err(std::sync::TryLockError::WouldBlock)
+                if age.is_some_and(|age| age < std::time::Duration::from_secs(2)) =>
+            {
+                return Ok(());
+            }
+            Err(std::sync::TryLockError::WouldBlock) => runtime
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => poisoned.into_inner(),
+        };
+        let result = runtime
+            .refresh_authority()
+            .map_err(|_| codex_omd::client_surface::BlitError::retryable("callback_cancelled"))
+            .and_then(|_| {
+                (runtime.generation() == generation
+                    && runtime.grants(&owner).is_some_and(|grants| {
+                        grants.source_sha256 == admitted_source
+                            && grants.capabilities == capabilities
+                    }))
+                .then_some(())
+                .ok_or_else(|| {
+                    codex_omd::client_surface::BlitError::new(
+                        codex_omd::client_surface::BlitErrorKind::Revoked,
+                        "process_raster_revoked",
+                    )
+                })
+            });
+        *last
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            result.is_ok().then(std::time::Instant::now);
+        result
+    };
+    Some(Arc::new(move |arguments, active| {
+        current()?;
+        let verified = verified.clone();
+        let active: Arc<dyn Fn() -> bool + Send + Sync> = Arc::new(move || {
+            active()
+                && verified
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .is_some_and(|at| at.elapsed() < std::time::Duration::from_secs(2))
+        });
+        codex_omd::client_surface::with_admission(&source, generation, None, || {
+            codex_omd::client_surface::call_classified(
+                &id,
+                "terminal.blit",
+                arguments,
+                InvocationContext::Event,
+                remote,
+                Some(&thread),
+                None,
+                active,
+            )
+        })
+    }))
+}
+
+async fn surface(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    request: ModHostCall,
+    cancelled: &Arc<AtomicBool>,
+) -> Result<Value, String> {
+    let context = match caller.origin {
+        Origin::UserCommand | Origin::Cli => InvocationContext::User,
+        Origin::Tool | Origin::Event => InvocationContext::Event,
+    };
+    let remote = REMOTE.try_with(|remote| *remote).unwrap_or(false);
+    let thread = lead.thread.to_string();
+    let capabilities = caller
+        .grants
+        .as_ref()
+        .map(|grants| grants.capabilities.clone())
+        .ok_or("host_caller_inactive")?;
+    let (id, operation) = (caller.id.to_owned(), request.operation);
+    let routes = if operation == "app.request" {
+        lead.host
+            .route_config()
+            .0
+            .routes
+            .iter()
+            .filter(|route| route.roles.contains(&config::RouteRole::Lead))
+            .map(|route| (route.model.clone(), route.provider.clone()))
+            .collect::<Vec<_>>()
+    } else {
+        Vec::new()
+    };
+    let repository = lead.host.repository.clone();
+    let arguments = request.arguments;
+    let cancelled = cancelled.clone();
+    let surface_authority = caller
+        .grants
+        .as_ref()
+        .map(|grants| grants.surface_authority.clone());
+    let runtime = core.runtime.clone();
+    let generation = caller.generation;
+    let source = caller.source.to_owned();
+    let admitted_source = source.clone();
+    let admission_cancelled = cancelled.clone();
+    tokio::task::spawn_blocking(move || {
+        let _authority = surface_authority.map(codex_omd::client_surface::Authority::enter);
+        let owner = id.clone();
+        let admitted_capabilities = capabilities.clone();
+        let active: Arc<dyn Fn() -> bool + Send + Sync> = Arc::new(move || {
+            if cancelled.load(Ordering::Acquire) {
+                return false;
+            }
+            let mut runtime = runtime
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if runtime.refresh_authority().is_err() {
+                return false;
+            }
+            runtime.generation() == generation
+                && runtime.grants(&owner).is_some_and(|grants| {
+                    grants.source_sha256 == source && grants.capabilities == admitted_capabilities
+                })
+        });
+        codex_omd::client_surface::with_admission(
+            &admitted_source,
+            generation,
+            Some(admission_cancelled),
+            || {
+                if operation == "app.request" {
+                    return codex_omd::client_surface::app_request(
+                        &id,
+                        &capabilities,
+                        context,
+                        remote,
+                        Some(&thread),
+                        &repository,
+                        &routes,
+                        arguments,
+                        active,
+                    );
+                }
+                codex_omd::client_surface::call(
+                    &id,
+                    &operation,
+                    arguments,
+                    context,
+                    remote,
+                    Some(&thread),
+                    None,
+                    active,
+                )
+            },
+        )
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
