+                    "action": {"command": "open", "args": "--from list"}}
+            ]},
+            {"type": "button", "id": "copy", "label": "Copy", "text": "Copy",
+                "action": {"copy": "x", "label": "x"}},
+            {"type": "input", "id": "query", "label": "Query", "value": "draft",
