+#[test]
+fn scoped_environment_commands_share_session_state_and_keep_local_fallbacks() {
+    const CHILD: &str = "OMD_ENVIRONMENT_DISPATCH_TEST_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "mod_runtime::tests::scoped_environment_commands_share_session_state_and_keep_local_fallbacks", "--nocapture"])
+            .env(CHILD, "1").output().unwrap();
+        assert!(
+            result.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr)
+        );
+        assert!(String::from_utf8_lossy(&result.stdout).contains("1 passed"));
+        return;
+    }
+    let temp = tempfile::tempdir().unwrap();
+    let repository = temp.path().canonicalize().unwrap();
+    let data = repository.join("store");
+    std::fs::create_dir(&data).unwrap();
+    let paths = crate::omd::ModPaths {
+        repository: repository.clone(),
+        evidence: data.clone(),
+        store: Some(data.clone()),
+        protected: vec![],
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted();
+    let grants = codex_omd::ModGrants {
+        api: codex_omd::MOD_API_VERSION.into(),
+        source_sha256: "a".repeat(64),
+        capabilities: vec!["exec".into(), "fs.write".into()],
+        exec_environment: vec!["FIXTURE_VALUE".into()],
+        ..Default::default()
+    };
+    let routed = Arc::new(Mutex::new(Vec::new()));
+    let calls = routed.clone();
+    let admitted = grants.clone();
+    let environment = codex_omd::host::Environment::default();
+    let _registration = codex_omd::host::install_session_dispatcher(Arc::new(
+        move |thread, id, source, policy, call, active| {
+            assert_eq!(source, Some(admitted.source_sha256.as_str()));
+            calls
+                .lock()
+                .unwrap()
+                .push((thread.to_owned(), call.operation.clone()));
+            let authority = CommandAuthority {
+                repository: &repository,
+                protected: &[],
+                policy: &serde_json::from_value::<codex_protocol::models::PermissionProfile>(
+                    policy.cloned().unwrap(),
+                )
+                .unwrap()
+                .file_system_sandbox_policy(),
+            };
+            codex_omd::host::Host {
+                authority: &authority,
+                data_root: &data,
+                environment: Some(&environment),
+                active,
+                record_changes: false,
+            }
+            .call(
+                &codex_omd::host::Caller {
+                    id,
+                    thread: Some(thread),
+                    source_sha256: &admitted.source_sha256,
+                    capabilities: &admitted.capabilities,
+                    exec_environment: &admitted.exec_environment,
+                    os_access: None,
+                    fs_access: None,
+                    origin: codex_omd::data_store::Origin::UserCommand,
+                },
+                &call.operation,
+                call.arguments,
+            )
+            .map_err(std::io::Error::other)
+        },
+    ))
+    .unwrap();
+    let scope = CallScope {
+        epoch: 0,
+        context: codex_omd::app_routes::InvocationContext::User,
+        thread: Some("captured-thread"),
+        active: Arc::new(|| true),
+    };
+    let request = |operation: &str, arguments: Value| codex_omd::ModHostCall {
+        operation: operation.into(),
+        arguments,
+    };
+    let invoke = |scope: &CallScope<'_>, operation: &str, arguments: Value| {
+        command_host_guarded(
+            &paths,
+            &policy,
+            Some(grants.clone()),
+            "fixture",
+            request(operation, arguments),
+            scope,
+        )
+    };
+    invoke(
+        &scope,
+        "environment.set",
+        serde_json::json!({"name": "FIXTURE_VALUE", "value": "session"}),
+    )
+    .unwrap();
+    let read = invoke(
+        &scope,
+        "environment.read",
+        serde_json::json!({"names": ["FIXTURE_VALUE"]}),
+    )
+    .unwrap();
+    assert_eq!(read["values"]["FIXTURE_VALUE"]["value"], "session");
+    let run = invoke(
+        &scope,
+        "exec.run",
+        serde_json::json!({"program": "sh", "argv": ["-c", "printf %s \"$FIXTURE_VALUE\""]}),
+    )
+    .unwrap();
+    assert_eq!(run["stdout"], "session");
+    for context in [
+        codex_omd::app_routes::InvocationContext::User,
+        codex_omd::app_routes::InvocationContext::Event,
+    ] {
+        let read_only = CallScope {
+            epoch: scope.epoch,
+            context,
+            thread: scope.thread,
+            active: scope.active.clone(),
+        };
+        let write = request(
+            "exec.run",
+            serde_json::json!({"program": "sh", "argv": ["-c", "printf forbidden > proof"], "write": true}),
+        );
+        assert_eq!(
+            command_host_guarded(
+                &paths,
+                &FileSystemSandboxPolicy::read_only(),
+                Some(grants.clone()),
+                "fixture",
+                write,
+                &read_only
+            )
+            .unwrap_err()
+            .to_string(),
+            "exec_cwd_unavailable"
+        );
+    }
+    assert!(!paths.repository.join("proof").exists());
+    assert_eq!(
+        invoke(
+            &scope,
+            "exec.run",
+            serde_json::json!({"program": "sh", "network": "loopback"})
+        )
+        .unwrap_err()
+        .to_string(),
+        "exec_network_unavailable_in_commands"
+    );
+    let denied = codex_omd::ModGrants {
+        capabilities: Vec::new(),
+        ..grants.clone()
+    };
+    assert_eq!(
+        command_host_guarded(
+            &paths,
+            &policy,
+            Some(denied),
+            "fixture",
+            request(
+                "environment.read",
+                serde_json::json!({"names": ["FIXTURE_VALUE"]})
+            ),
+            &scope
+        )
+        .unwrap_err()
+        .to_string(),
+        "capability_denied: exec"
+    );
+    let cancelled = CallScope {
+        epoch: scope.epoch,
+        context: scope.context,
+        thread: scope.thread,
+        active: Arc::new(|| false),
+    };
+    assert_eq!(
+        invoke(
+            &cancelled,
+            "environment.read",
+            serde_json::json!({"names": ["FIXTURE_VALUE"]})
+        )
+        .unwrap_err()
+        .to_string(),
+        "host_operation_cancelled"
+    );
+    let local = CallScope {
+        thread: None,
+        ..scope
+    };
+    assert!(
+        invoke(
+            &local,
+            "environment.set",
+            serde_json::json!({"name": "FIXTURE_VALUE", "value": "local"})
+        )
+        .is_err()
+    );
+    let read = invoke(
+        &local,
+        "environment.read",
+        serde_json::json!({"names": ["FIXTURE_VALUE"]}),
+    )
+    .unwrap();
+    assert_ne!(read["values"]["FIXTURE_VALUE"]["value"], "session");
+    let run = invoke(
+        &local,
+        "exec.run",
+        serde_json::json!({"program": "sh", "argv": ["-c", "printf local"]}),
+    )
+    .unwrap();
+    assert_eq!(run["stdout"], "local");
+    assert_eq!(
+        *routed.lock().unwrap(),
+        vec![
+            ("captured-thread".into(), "environment.set".into()),
+            ("captured-thread".into(), "environment.read".into()),
+            ("captured-thread".into(), "exec.run".into()),
+            ("captured-thread".into(), "exec.run".into()),
+            ("captured-thread".into(), "exec.run".into())
+        ]
+    );
+}
