+        "",
+        now + FRAME,
+    );
+    assert_eq!(text(&lines), vec![" c  ", "    "]);
+    assert_eq!(next, None);
+    retain(&BTreeSet::new());
+}
+
+#[test]
+#[serial_test::serial]
+fn owner_changes_drop_raster_pixels_and_pending_frames_before_a_new_blit() {
+    let now = Instant::now();
+    let key = "raster-owner";
+    for glyph in ["a", "b"] {
+        blit_at(
+            key,
+            "owner",
+            json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": [glyph]}),
+            now,
+        )
+        .expect("queued");
+        super::rows(key, Some("owner"), "chart", 10, (4, 2), false, "", now);
+    }
+    let (lines, next) = super::rows(key, Some("owner"), "chart", 10, (4, 2), false, "", now);
+    assert_eq!(text(&lines)[0], "a   ");
+    assert_eq!(next, Some(FRAME));
+    let (lines, next) = super::rows(
+        key,
+        Some("next-owner"),
+        "new chart",
+        10,
+        (4, 2),
+        false,
+        "",
+        now + FRAME,
+    );
+    assert_eq!(text(&lines), vec!["[new chart]"]);
+    assert_eq!(next, None);
+    blit(
+        "next-owner",
+        Some("next-owner".into()),
+        Some((4, 2)),
+        &json!({"key": key, "rect": {"x": 1, "y": 0, "width": 1, "height": 1}, "cells": ["c"]}),
+        now + FRAME,
+        |_, _| unreachable!(),
+    )
+    .expect("new owner queued");
+    let (lines, next) = super::rows(
+        key,
+        Some("next-owner"),
+        "new chart",
+        10,
+        (4, 2),
+        false,
+        "",
+        now + FRAME,
+    );
+    assert_eq!(text(&lines), vec![" c  ", "    "]);
+    assert_eq!(next, None);
+    retain(&BTreeSet::new());
+}
+
+fn frame(width: u32, height: u32, color: [u8; 3]) -> Value {
+    let mut png = Vec::new();
+    image::RgbImage::from_pixel(width, height, image::Rgb(color))
+        .write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png)
+        .expect("png");
+    json!({"media_type": "image/png", "base64": base64::engine::general_purpose::STANDARD.encode(png)})
+}
+
+fn frame_at(
+    key: &str,
+    image: Value,
+    now: Instant,
+) -> Result<Value, codex_omd::client_surface::BlitError> {
+    blit(
+        "owner",
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key": key, "image": image}),
+        now,
+        |_, _| unreachable!(),
+    )
+}
+
+#[test]
+#[serial_test::serial]
+fn raw_raster_admission_precedes_snapshot() {
+    retain(&BTreeSet::new());
+    let source = json!({"source":"owned", "format":"rgb", "width":1, "height":1, "sequence":1});
+    let now = Instant::now();
+    for size in [None, Some((0, 0))] {
+        assert!(
+            blit(
+                "owner",
+                Some("owner".into()),
+                size,
+                &json!({"key":"hidden", "pixels":source}),
+                now,
+                |_, _| panic!("snapshot before layout admission")
+            )
+            .is_err()
+        );
+    }
+    for n in 0..RASTERS_PER_MOD {
+        rasters().insert(format!("occupied-{n}"), Raster::new("owner", 4, 2));
+    }
+    assert_eq!(
+        blit(
+            "owner",
+            Some("owner".into()),
+            Some((4, 2)),
+            &json!({"key":"overflow", "pixels":source}),
+            now,
+            |_, _| panic!("snapshot before capacity admission")
+        ),
+        Err(codex_omd::client_surface::BlitError::retryable(
+            "terminal_blit_limit"
+        ))
+    );
+    retain(&BTreeSet::new());
+    let mut snapshots = 0;
+    blit(
+        "owner",
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key":"admitted", "pixels":source}),
+        now,
+        |_, _| {
+            snapshots += 1;
+            assert!(
+                RASTERS.try_lock().is_ok(),
+                "the copy runs outside the raster lock"
+            );
+            Ok(std::sync::Arc::new(
+                codex_omd::process_raster::PixelFrame::new(
+                    serde_json::from_value(source.clone()).unwrap(),
+                    image::DynamicImage::new_rgb8(1, 1),
+                ),
+            ))
+        },
+    )
+    .unwrap();
+    assert_eq!(snapshots, 1);
+    retain(&BTreeSet::new());
+}
+
+#[test]
+#[serial_test::serial]
+fn invalid_image_frames_are_refused_before_queueing() {
+    let now = Instant::now();
+    let key = "raster-frame-refuse";
+    let png = frame(2, 2, [1, 2, 3]);
+    let invalid = Err("terminal_blit_image_invalid".to_owned());
+    for image in [
+        json!({"media_type": "image/gif", "base64": png["base64"]}),
+        json!({"media_type": "image/jpeg", "base64": png["base64"]}),
+        json!({"media_type": "image/png", "base64": "***"}),
+        json!({"media_type": "image/png", "base64": "bm90IGFuIGltYWdl"}),
+        frame(4097, 1, [0, 0, 0]),
+    ] {
+        assert_eq!(
+            frame_at(key, image, now),
+            invalid
+                .clone()
+                .map_err(codex_omd::client_surface::BlitError::fatal)
+        );
+    }
+    let cell = json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]});
+    for arguments in [
+        json!({"key": key, "image": png, "rect": cell["rect"], "cells": cell["cells"]}),
+        json!({"key": key}),
+        json!({"key": key, "rect": cell["rect"], "image": png}),
+    ] {
+        assert_eq!(
+            blit(
+                "owner",
+                Some("owner".into()),
+                Some((4, 2)),
+                &arguments,
+                now,
+                |_, _| unreachable!()
+            ),
+            Err("terminal_blit_invalid".into())
+        );
+    }
+    let oversized = json!({"media_type": "image/png", "base64": "A".repeat(codex_omd::client_surface::BLIT_CALL_BYTES)});
+    assert_eq!(
+        frame_at(key, oversized, now),
+        Err("terminal_blit_too_large".into())
+    );
+    assert!(
+        rasters().get(key).is_none(),
+        "no raster entry is left behind"
+    );
+}
