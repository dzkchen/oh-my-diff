+static RUNTIME_PROVIDERS: RwLock<Vec<(String, ModelProviderInfo)>> = RwLock::new(Vec::new());
+
+/// Defines a provider for the rest of this process; configured providers keep precedence.
+pub fn set_runtime_provider(id: &str, provider: Option<ModelProviderInfo>) {
+    let mut providers = RUNTIME_PROVIDERS
+        .write()
+        .unwrap_or_else(PoisonError::into_inner);
+    providers.retain(|(existing, _)| existing != id);
+    providers.extend(provider.map(|provider| (id.to_string(), provider)));
+}
+
+/// Returns a provider defined at runtime by [`set_runtime_provider`].
+pub fn runtime_provider(id: &str) -> Option<ModelProviderInfo> {
+    RUNTIME_PROVIDERS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(existing, _)| existing == id)
+        .map(|(_, provider)| provider.clone())
+}
+
+/// Adds runtime providers missing from `model_providers`.
+pub fn with_runtime_providers(
+    mut model_providers: HashMap<String, ModelProviderInfo>,
+) -> HashMap<String, ModelProviderInfo> {
+    for (id, provider) in RUNTIME_PROVIDERS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+    {
+        model_providers
+            .entry(id.clone())
+            .or_insert_with(|| provider.clone());
+    }
+    model_providers
+}
