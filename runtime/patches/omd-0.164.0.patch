+#[allow(clippy::too_many_arguments)]
+pub(crate) fn run_command(
+    command: &str,
+    args: &str,
+    target: Option<&ModSlashTarget>,
+    immediate: bool,
+    active_turn: bool,
+    caller: &str,
+    invocation: &ModInvocation,
+    mut builtin: impl FnMut(String) -> Result<Value, String>,
+) -> Result<ModCommandResult, String> {
+    if active_turn && !immediate && target.is_some() {
+        return Err(format!("command_unavailable_during_turn: /{command}"));
+    }
+    let input = serde_json::json!({"command": command, "args": args,
+        "owner": target.map(|target| target.id.clone()), "immediate": immediate, "active_turn": active_turn});
+    let mut ran = None;
+    let mut core = |effective: Value| {
+        let args = effective["args"].as_str().unwrap_or_default().to_owned();
+        let value = match target {
+            Some(target) => {
+                let result = run(target, &args, invocation).map_err(std::io::Error::other)?;
+                let value = result.value.clone();
+                ran = Some(result);
+                value
+            }
+            None => builtin(args).map_err(std::io::Error::other)?,
+        };
+        Ok(serde_json::json!({"result": value}))
+    };
+    // Protected built-ins never reach the mod runtime, so recovery works even when it is broken.
+    let result = if target.is_none() && codex_omd::PROTECTED_COMMANDS.contains(&command) {
+        core(input)
+    } else {
+        let paths = crate::omd::mod_paths_for(&invocation.context.repository)
+            .ok_or("mods are not configured for this session")?;
+        let runtime = shared_host()?;
+        let grants = {
+            let mut runtime = runtime.locked();
+            reload(&mut runtime);
+            owner_grants(&runtime)
+        };
+        let active = || current(invocation);
+        let thread = invocation.context.thread_id.map(|id| id.to_string());
+        let scope = CallScope {
+            epoch: invocation.epoch,
+            context: codex_omd::app_routes::InvocationContext::User,
+            thread: thread.as_deref(),
+            active: {
+                let invocation = invocation.clone();
+                Arc::new(move || current(&invocation))
+            },
+        };
+        codex_omd::continue_operation(
+            &runtime,
+            "command",
+            input,
+            serde_json::json!({"caller": caller, "thread_id": thread}),
+            active,
+            |caller, call| {
+                crate::mod_surface::host_call(
+                    &paths,
+                    &invocation.context.policy,
+                    grants.get(caller).cloned(),
+                    caller,
+                    call,
+                    &scope,
+                )
+            },
+            core,
+        )
+    }
+    .map_err(|error| error.to_string())?;
+    let value = &result["result"];
+    match ran {
+        Some(ran) if &ran.value == value => Ok(ran),
+        _ => Ok(ModCommandResult {
+            refresh: None,
+            outcome: ModCommandOutcome::parse(value).unwrap_or_default(),
+            value: value.clone(),
+            preview: None,
+        }),
+    }
+}
