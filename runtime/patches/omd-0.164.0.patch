+    assert_eq!(paths, ["README.md", "new.md"]);
+    let new_hash = changed["files"]["new.md"].clone();
+    let stale = host
+        .call(
+            &reader,
+            "workspace.restore",
+            json!({"backup":backup,"expected":{"README.md":null,"new.md":"0".repeat(64)}}),
