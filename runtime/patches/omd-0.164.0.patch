+        let field = if event["phase"] == "before" {
+            "arguments"
+        } else {
+            "result"
+        };
+        if operation != "exec.run" || event["phase"] == "before" {
+            assert_eq!(event[field].is_null(), !shown, "{event}");
+        }
+        if operation == "exec.run" && event["phase"] == "after" {
+            assert_eq!(event["error"], "private_operation_failed");
+        }
+    }
+}
