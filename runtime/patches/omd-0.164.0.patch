+fn client_surface_acknowledges_committed_package_toggle_after_reload() {
+    let (directory, store, source) = surface_package();
+    let store_path = directory.path().canonicalize().unwrap().join("store");
+    let _environment = crate::omd::tests::omd_environment(&store_path);
