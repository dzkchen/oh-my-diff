+            &tui.terminal
+        ))
+        .contains("╭─╮ ╭╮╭╮ ┌─╮")
+    );
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::PlainHistoryCell::new(vec![
+            "Submission rejected".into(),
+        ])),
+    );
+    draw(&mut app, &mut tui, size)?;
+    let rejected = text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(
+        rejected.contains("Submission rejected") && !rejected.contains("╭─╮ ╭╮╭╮ ┌─╮"),
+        "{rejected}"
+    );
+    app.chat_widget.handle_server_notification(
+        ServerNotification::TurnStarted(TurnStartedNotification {
+            thread_id: app
+                .chat_widget
+                .thread_id()
+                .map(|id| id.to_string())
+                .unwrap_or_default(),
+            turn: Turn {
+                root_turn_id: None,
+                id: "accepted-turn".to_owned(),
+                items_view: TurnItemsView::Full,
+                items: Vec::new(),
+                status: TurnStatus::InProgress,
+                error: None,
+                started_at: Some(0),
+                completed_at: None,
+                duration_ms: None,
+            },
+        }),
+        None,
+    );
+    draw(&mut app, &mut tui, size)?;
+    assert!(
+        !text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal
+        ))
+        .contains("╭─╮ ╭╮╭╮ ┌─╮")
+    );
+    for phase in ["started", "resumed"] {
+        snapshot.input["presentation"]["phase"] = serde_json::json!(phase);
+        crate::mod_ui::preview(snapshot.clone());
+        app.reset_transcript_state_after_clear();
+        draw(&mut app, &mut tui, size)?;
+        assert!(
+            !text(crate::custom_terminal::test_support::last_rendered_buffer(
+                &tui.terminal
+            ))
+            .contains("╭─╮ ╭╮╭╮ ┌─╮")
+        );
+    }
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    app.queue_clear_ui_header(&mut tui);
+    draw(&mut app, &mut tui, size)?;
+    assert!(
+        !text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal
+        ))
+        .contains("Project tools")
+    );
+    tui.set_owned_screen(false)?;
+    Ok(())
