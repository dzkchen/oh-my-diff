+#[serial_test::serial]
+fn pointer_input_on_a_process_bound_raster_reaches_the_process() {
+    let mut view = snapshot(
+        serde_json::json!({"sidebar_width": 30, "sites": {"sidebar": {"components": [
+            {"type":"raster","id":"bound_chart","label":"Chart","alt":"page","width":6,"height":3,"pointer":true},
+            {"type":"document","id":"bound_keys","label":"Keys","keys":true,"lines":[]}
+        ]}}}),
+    );
+    view.input = serde_json::json!({"ledger": {"thread_id": "displayed-thread"}});
+    view.component_owners = [("bound_chart", "demo"), ("bound_keys", "demo")]
+        .into_iter()
+        .map(|(id, owner)| (id.to_owned(), owner.to_owned()))
+        .collect();
+    crate::mod_raster::blit(
+        "demo",
+        Some("demo".into()),
+        Some((6, 3)),
+        &serde_json::json!({"key":"bound_chart","rect":{"x":0,"y":0,"width":1,"height":1},"cells":["x"]}),
+        std::time::Instant::now(),
+        |_, _| unreachable!(),
+    )
+    .expect("queued");
+    let area = Rect::new(0, 0, 80, 24);
+    preview(view.clone());
+    render(area, area, &mut Buffer::empty(area), &view);
+    let chart = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .regions
+        .iter()
+        .find(|region| region.id == "bound_chart")
+        .cloned()
+        .expect("raster region");
+    let (sender, received) = std::sync::mpsc::channel();
+    let sender = std::sync::Mutex::new(sender);
+    let binding = codex_omd::process_raster::bind(
+        Some("displayed-thread"),
+        "demo",
+        vec![
+            (
+                "bound_chart".into(),
+                codex_omd::process_raster::Role::Raster,
+            ),
+            ("bound_keys".into(), codex_omd::process_raster::Role::Keys),
+        ],
+        std::sync::Arc::new(move |message| sender.lock().unwrap().send(message).is_ok()),
+    );
+    let other = codex_omd::process_raster::bind(
+        Some("hidden-thread"),
+        "demo",
+        vec![
+            (
+                "bound_chart".into(),
+                codex_omd::process_raster::Role::Raster,
+            ),
+            ("bound_keys".into(), codex_omd::process_raster::Role::Keys),
+        ],
+        std::sync::Arc::new(|_| panic!("input reached the hidden thread")),
+    );
+    render(area, area, &mut Buffer::empty(area), &view);
+    assert!(
+        received
+            .recv_timeout(std::time::Duration::from_secs(1))
+            .unwrap()
+            .get("box")
+            .is_some()
+    );
+    let press = MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: chart.area.x + 1,
+        row: chart.area.y,
+        modifiers: KeyModifiers::NONE,
+    };
+    let pressing = std::thread::spawn(move || pointer(press));
+    let mut actions = Vec::new();
+    while actions.len() < 2 {
+        let message = received
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("the press reaches the bound process without locking up the terminal");
+        actions.push(format!(
+            "{} {}",
+            message["pointer"]["action"], message["pointer"]["button"]
+        ));
+    }
+    assert_eq!(actions, ["\"enter\" null", "\"down\" \"left\""]);
+    pressing.join().expect("press handled");
+    assert_eq!(
+        INTERACTION.lock().unwrap().focused.as_deref(),
+        Some("bound_keys"),
+        "the press focuses the process's keys component"
+    );
+    drop(binding);
+    drop(other);
+    crate::mod_raster::retain(&std::collections::BTreeSet::new());
+    preview(ModViewSnapshot::default());
+}
