+                .task
+                .start_worker(
+                    worker.clone(),
+                    lead.owner.clone(),
+                    lead.depth.saturating_add(1),
+                    host.worker_limits(&lead.session)?,
+                )
+                .map_err(|e| e.to_string())?;
+            struct RequestGuard {
+                task: Arc<Task>,
+                worker: String,
+            }
+            impl Drop for RequestGuard {
+                fn drop(&mut self) {
