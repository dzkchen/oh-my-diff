+use super::*;
+use pretty_assertions::assert_eq;
+use std::path::PathBuf;
+
+#[test]
+#[serial_test::serial]
+fn cached_resource_rows_require_current_owner_authority() {
+    let reference = codex_omd::resource_data::ResourceRef {
+        reference: "revoked-reference".to_owned(),
+        sha256: "a".repeat(64),
+    };
+    let owners: Vec<String> = Vec::new();
+    let revoked = Some((
+        PathBuf::from("/store"),
+        PathBuf::from("/repo"),
+        [None, None],
+    ));
+    for key in [
+        Key::None,
+        Key::Source(
+            reference.clone(),
+            owners.clone(),
+            crate::mod_surface::current_thread(),
+            Box::new(revoked),
+        ),
+    ] {
+        documents().insert(
+            "revoked-document".to_owned(),
+            Document {
+                key,
+                lines: Arc::new(vec!["private cached document".to_owned()]),
+                spans: Arc::new(vec![vec![Span::raw("private cached document")]]),
+                anchors: Arc::new(vec![None]),
+                ..Default::default()
+            },
+        );
+        let rendered = text(&rows(
+            "revoked-document",
+            Content::Source(&reference),
+            &[],
+            None,
+            None,
+            Some(2),
+            &owners,
+            false,
+            false,
+            "",
+        ));
+        assert!(rendered.iter().all(|line| !line.contains("private cached")));
+        assert!(rendered.iter().any(|line| line.contains("unavailable")));
+    }
+    let thread = crate::mod_surface::current_thread().unwrap_or_default();
+    for key in [
+        format!("{}:4:2", reference.sha256),
+        format!("{reference:?}:{owners:?}:{thread}:4:2:"),
+    ] {
+        IMAGES.lock().unwrap().insert(
+            "img".into(),
+            (key, vec![Line::from("private cached image")]),
+        );
+    }
+    assert_eq!(
+        text(&image_rows("img", &reference, "revoked", 4, 2, &owners, "")),
+        vec!["[image unavailable: revoked]"]
+    );
+    invalidate();
+    assert!(documents().is_empty());
+    assert!(IMAGES.lock().unwrap().is_empty());
+}
+
+fn text(lines: &[Line<'static>]) -> Vec<String> {
+    lines
+        .iter()
+        .map(|line| {
+            line.spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect()
+        })
+        .collect()
+}
+
+#[test]
+#[serial_test::serial]
+fn resolved_resource_rows_are_reused_until_authority_changes() {
+    let root = tempfile::TempDir::new().unwrap();
+    let store = root.path().canonicalize().unwrap();
+    std::fs::write(store.join("mod-status.json"), r#"{"mods":[]}"#).unwrap();
+    let _omd = crate::omd::tests::omd_environment(&store);
+    let reference = codex_omd::resource_data::ResourceRef {
+        reference: "b".repeat(64),
+        sha256: "b".repeat(64),
+    };
+    assert!(authority().is_some());
+    documents().insert(
+        "reused".into(),
+        Document {
+            key: Key::Source(
+                reference.clone(),
+                Vec::new(),
+                crate::mod_surface::current_thread(),
+                Box::new(authority()),
+            ),
+            lines: Arc::new(vec!["resolved document".into()]),
+            spans: Arc::new(vec![vec![Span::raw("resolved document")]]),
+            anchors: Arc::new(vec![None]),
+            ..Default::default()
+        },
+    );
+    let render = || {
+        text(&rows(
+            "reused",
+            Content::Source(&reference),
+            &[],
+            None,
+            None,
+            Some(4),
+            &[],
+            false,
+            false,
+            "",
+        ))
+    };
+    assert_eq!(render(), vec!["  resolved document"]);
+    let replacement = store.join("mod-status.next");
+    std::fs::write(&replacement, r#"{"mods":[]}"#).unwrap();
+    std::fs::rename(&replacement, store.join("mod-status.json")).unwrap();
+    assert!(render().iter().any(|line| line.contains("unavailable")));
+    invalidate();
+}
