+    #[test]
+    fn transaction_deletes_with_stat_precondition_and_backup() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        fs::write(root.join("keep.txt"), "keep\n").unwrap();
+        fs::write(root.join("drop.txt"), "drop\n").unwrap();
+        let (size, mtime_ms) = stat_fingerprint(&root, "drop.txt").unwrap().unwrap();
+        let saved = std::cell::RefCell::new(BTreeMap::new());
+        let sink = |files: &BTreeMap<String, Option<Vec<u8>>>| {
+            *saved.borrow_mut() = files.clone();
+            Ok(serde_json::json!({"backup": "ok"}))
+        };
+        let transaction = WorkspaceTransaction {
+            expected: BTreeMap::from([
+                (
+                    "drop.txt".into(),
+                    Some(Fingerprint::Stat { size, mtime_ms }),
+                ),
+                (
+                    "keep.txt".into(),
+                    Some(Fingerprint::Hash(content_hash(b"keep\n"))),
+                ),
+            ]),
+            writes: BTreeMap::from([("keep.txt".into(), "kept\n".into())]),
+            deletes: vec!["drop.txt".into()],
+            backup: true,
+            ..Default::default()
+        };
+        let result = transaction
+            .apply_with_backup(&root, || true, Some(&sink))
+            .unwrap();
+        assert!(!root.join("drop.txt").exists());
+        assert_eq!(fs::read_to_string(root.join("keep.txt")).unwrap(), "kept\n");
+        assert_eq!(result.files["drop.txt"], None);
+        assert_eq!(result.backup, Some(serde_json::json!({"backup": "ok"})));
+        assert_eq!(saved.borrow()["drop.txt"], Some(b"drop\n".to_vec()));
+        let stale = WorkspaceTransaction {
+            expected: BTreeMap::from([(
+                "keep.txt".into(),
+                Some(Fingerprint::Stat {
+                    size: 1,
+                    mtime_ms: 1,
+                }),
+            )]),
+            deletes: vec!["keep.txt".into()],
+            ..Default::default()
+        };
+        assert!(
+            stale
+                .apply(&root, || true)
+                .unwrap_err()
+                .to_string()
+                .contains("stale")
+        );
+        let missing_sink = WorkspaceTransaction {
+            expected: BTreeMap::from([(
+                "keep.txt".into(),
+                Some(Fingerprint::Hash(content_hash(b"kept\n"))),
+            )]),
+            deletes: vec!["keep.txt".into()],
+            backup: true,
+            ..Default::default()
+        };
+        assert!(missing_sink.apply(&root, || true).is_err());
+        assert!(root.join("keep.txt").exists());
+    }
+}
diff --git a/codex-rs/omd/src/workspace_lease.rs b/codex-rs/omd/src/workspace_lease.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6531a6ad6f21a8018898d3f6ac1780b6403af745
--- /dev/null
+++ b/codex-rs/omd/src/workspace_lease.rs
@@ -0,0 +1,150 @@
+use std::fs::{self, File};
+use std::io;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+
+pub struct Lease {
+    _file: File,
+}
+
+fn temporary() -> PathBuf {
+    PathBuf::from("/tmp")
+        .canonicalize()
+        .unwrap_or_else(|_| PathBuf::from("/tmp"))
+}
+
+fn name() -> String {
+    format!(
+        "codex-workspace-leases-{}",
+        rustix::process::geteuid().as_raw()
+    )
+}
+
+pub fn directory() -> PathBuf {
+    crate::workspace::private_path(&temporary(), &[&name()], "workspace_ownership_unavailable")
+        .unwrap_or_else(|_| temporary().join(name()))
+}
+
+fn identity(path: &Path, exclusive: bool) -> io::Result<(PathBuf, String)> {
+    let path = path.canonicalize()?;
+    let root = path
+        .ancestors()
+        .find(|parent| parent.join(".git").exists())
+        .unwrap_or(&path);
+    let metadata = fs::metadata(root)?;
+    let created = metadata
+        .created()
+        .ok()
+        .and_then(|time| time.duration_since(std::time::UNIX_EPOCH).ok())
+        .map(|time| time.as_nanos());
+    if exclusive && created.is_none() {
+        return Err(io::Error::other("workspace_ownership_unavailable"));
+    }
+    let key = crate::resource_data::hash(
+        format!("{}:{}:{created:?}", metadata.dev(), metadata.ino()).as_bytes(),
+    );
+    Ok((root.to_owned(), key))
+}
+
+fn acquire(path: &Path, exclusive: bool) -> io::Result<Lease> {
+    let (_, key) = identity(path, exclusive)?;
+    let uid = rustix::process::geteuid().as_raw();
+    let directory = crate::workspace::private_path(
+        &temporary(),
+        &[&name()],
+        "workspace_ownership_unavailable",
+    )?;
+    let directory_file = File::from(rustix::fs::open(
+        &directory,
+        rustix::fs::OFlags::RDONLY
+            | rustix::fs::OFlags::DIRECTORY
+            | rustix::fs::OFlags::NOFOLLOW
+            | rustix::fs::OFlags::CLOEXEC,
+        rustix::fs::Mode::empty(),
+    )?);
+    let metadata = directory_file.metadata()?;
+    if !metadata.is_dir() || metadata.uid() != uid || metadata.permissions().mode() & 0o077 != 0 {
+        return Err(io::Error::other("workspace_ownership_unavailable"));
+    }
+    let mut flags =
+        rustix::fs::OFlags::RDWR | rustix::fs::OFlags::NOFOLLOW | rustix::fs::OFlags::CLOEXEC;
+    if !exclusive {
+        flags |= rustix::fs::OFlags::CREATE;
+    }
+    let file = File::from(
+        rustix::fs::openat(
+            &directory_file,
+            key,
+            flags,
+            rustix::fs::Mode::from_raw_mode(0o600),
+        )
+        .map_err(|_| io::Error::other("workspace_ownership_unavailable"))?,
+    );
+    let metadata = file.metadata()?;
+    if !metadata.is_file()
+        || metadata.uid() != uid
+        || metadata.nlink() != 1
+        || metadata.permissions().mode() & 0o077 != 0
+    {
+        return Err(io::Error::other("workspace_ownership_unavailable"));
+    }
+    if exclusive {
+        file.try_lock()
+    } else {
+        file.try_lock_shared()
+    }
+    .map_err(|_| io::Error::other("workspace_in_use"))?;
+    Ok(Lease { _file: file })
+}
+
+pub fn shared(path: &Path) -> io::Result<Lease> {
+    acquire(path, false)
+}
+pub fn exclusive(path: &Path) -> io::Result<Lease> {
+    acquire(path, true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lease_child() {
+        let Some(path) = std::env::var_os("LEASE_TEST_PATH") else {
+            return;
+        };
+        let lease = exclusive(Path::new(&path));
+        assert_eq!(
+            lease.is_ok(),
+            std::env::var_os("LEASE_TEST_ALLOWED").is_some()
+        );
+    }
+
+    #[test]
+    fn workspace_leases_exclude_other_processes_and_release_on_drop() {
+        let root = tempfile::tempdir().unwrap();
+        assert!(exclusive(root.path()).is_err());
+        let lease = shared(root.path()).unwrap();
+        let child = |allowed: bool| {
+            let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+            command
+                .args(["--exact", "workspace_lease::tests::lease_child"])
+                .env("LEASE_TEST_PATH", root.path())
+                .env_remove("LEASE_TEST_ALLOWED");
+            if allowed {
+                command.env("LEASE_TEST_ALLOWED", "1");
+            }
+            assert!(command.output().unwrap().status.success());
+        };
+        child(false);
+        let other = shared(root.path()).unwrap();
+        drop(lease);
+        child(false);
+        drop(other);
+        child(true);
+        let exclusive = exclusive(root.path()).unwrap();
+        assert!(shared(root.path()).is_err());
+        drop(exclusive);
+        assert!(shared(root.path()).is_ok());
+    }
+}
