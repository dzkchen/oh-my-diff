+    config.sqlite =
+        codex_state::SqliteConfig::new_for_testing(codex_home.path().to_path_buf().abs());
+    let app_server = crate::start_embedded_app_server_for_picker(&config)
+        .await
+        .unwrap();
+    let store = codex_home.path().canonicalize().unwrap().join("store");
+    codex_omd::ModStore::create(store.clone()).unwrap();
+    let _environment = crate::omd::tests::omd_environment(&store);
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    attach(&AppEventSender::new(tx), Some("surface-a".to_owned()));
+    let submit = || {
+        codex_omd::client_surface::submit(
+            codex_omd::broker::HOST_CALLER,
+            "app.request",
