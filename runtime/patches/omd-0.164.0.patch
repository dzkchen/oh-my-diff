@@ -0,0 +1,62 @@
+use std::sync::Arc;
+
+use crate::ExtensionFuture;
+
+pub struct ToolInvocationRequest {
+    pub call_id: String,
+    pub tool: String,
+    pub arguments: serde_json::Value,
+    /// Waits for the turn's tool execution gate; false inside a tool call that already holds it.
+    pub serialized: bool,
+}
+
+pub struct ToolInvocationOutcome {
+    pub output: String,
+    pub success: bool,
+}
+
+/// The host's permission verdict for a tool call, computed without running it.
+pub struct ToolCheckOutcome {
+    pub decision: &'static str,
+    pub reason: Option<String>,
+    pub authority: &'static str,
+}
+
+/// Host-provided dispatch for the current turn, with the same interception, approvals, sandbox, accounting and cancellation as model tool calls.
+pub trait ToolInvoker: Send + Sync {
+    fn invoke<'a>(
+        &'a self,
+        request: ToolInvocationRequest,
+    ) -> ExtensionFuture<'a, Result<ToolInvocationOutcome, String>>;
+
+    fn check<'a>(
+        &'a self,
+        tool: &'a str,
+        arguments: serde_json::Value,
+    ) -> ExtensionFuture<'a, Result<ToolCheckOutcome, String>>;
+}
+
+/// The thread's current sampling-step invoker; the host replaces it at every step.
+#[derive(Default)]
+pub struct ToolInvokerSlot(std::sync::Mutex<Option<(String, Arc<dyn ToolInvoker>)>>);
+
+impl ToolInvokerSlot {
+    pub fn set(&self, turn_id: &str, invoker: Arc<dyn ToolInvoker>) {
+        if let Ok(mut current) = self.0.lock() {
+            *current = Some((turn_id.to_owned(), invoker));
+        }
+    }
+
+    pub fn get(&self) -> Option<Arc<dyn ToolInvoker>> {
+        Some(self.0.lock().ok()?.as_ref()?.1.clone())
+    }
+
+    /// Ends dispatch for a finished turn unless a later turn already replaced it.
+    pub fn clear(&self, turn_id: &str) {
+        if let Ok(mut current) = self.0.lock()
+            && current.as_ref().is_some_and(|(id, _)| id == turn_id)
+        {
+            *current = None;
+        }
+    }
+}
