+async fn approval_gate_denies_auto_approved_and_remembered_mcp_calls() {
+    let (mut session, turn_context) = make_session_and_context().await;
+    let gate = Arc::new(DenyingGate(Default::default()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_gate_contributor(gate.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let session = Arc::new(session);
+    let turn_context = Arc::new(turn_context);
+    let invocation = McpInvocation {
+        server: "memory".to_string(),
+        tool: "create_entities".to_string(),
+        arguments: None,
+    };
+    let metadata = |read_only| McpToolApprovalMetadata {
+        annotations: Some(annotations(
+            Some(read_only),
+            Some(!read_only),
+            /*open_world*/ None,
+        )),
+        connector_id: None,
+        link_id: None,
+        connector_name: None,
+        connector_description: None,
+        connected_account_email: None,
+        plugin_id: None,
+        tool_title: None,
+        tool_description: None,
+        mcp_app_resource_uri: None,
+        mcp_app_ui: None,
+        codex_apps_meta: None,
+        openai_file_input_optional_fields: None,
+    };
+    let writer = metadata(false);
+    let key = session_mcp_tool_approval_key(&invocation, Some(&writer), AppToolApproval::Auto)
+        .expect("memory MCP tool should support session approval");
+    remember_mcp_tool_approval(&session, key).await;
+    // Tool-mode approval, a read-only annotation and a remembered session approval all skip the prompt.
+    for (mode, metadata) in [
+        (AppToolApproval::Approve, metadata(false)),
+        (AppToolApproval::Auto, metadata(true)),
+        (AppToolApproval::Auto, writer),
