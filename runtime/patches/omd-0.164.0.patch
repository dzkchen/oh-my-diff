+        ]
+    }));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 1, 25, 39))
+    );
+    assert_eq!(placement.area("site:notes/pad"), None);
+    assert_eq!(placement.area("transcript"), Some(Rect::new(25, 0, 75, 32)));
+    assert_eq!(placement.chat(), Some(Rect::new(25, 0, 75, 40)));
+    assert_eq!(
+        placement.tabs[0].titles,
+        vec!["Files".to_owned(), "Notes".to_owned()]
+    );
+
+    let click = |kind, column, row| MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        9,
+        0
+    )));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(
+        placement.area("site:notes/pad"),
+        Some(Rect::new(0, 1, 25, 39))
+    );
+
+    assert!(pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        25,
+        10
+    )));
+    assert!(pointer(click(
+        MouseEventKind::Drag(MouseButton::Left),
+        40,
+        10
+    )));
+    assert!(pointer(click(
+        MouseEventKind::Up(MouseButton::Left),
+        40,
+        10
+    )));
+    let placement = place(&layout, None, Rect::new(0, 0, 100, 40));
+    assert_eq!(placement.area("transcript").map(|area| area.x), Some(40));
+    assert!(!pointer(click(
+        MouseEventKind::Down(MouseButton::Left),
+        70,
+        10
+    )));
+}
+
+#[test]
+#[serial_test::serial]
+fn split_gaps_leave_cells_between_children_and_their_handle() {
+    let layout = layout(
+        serde_json::json!({"split": "horizontal", "gap": 2, "children": [
+        {"content": "site:files/tree", "style": {"border": "thick"}}, {"content": "transcript"}]}),
+    );
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.regions[0],
+        Region {
+            content: "site:files/tree".into(),
+            area: Rect::new(0, 0, 20, 10),
+            style: Some(codex_omd::ModBoxStyle {
+                border: Some(codex_omd::ModBoxBorder::Thick),
+                ..Default::default()
+            }),
+            title: None,
+            tabs: None,
+        }
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(22, 0, 20, 10)));
+    let narrow = place(&layout, None, Rect::new(0, 0, 7, 10));
+    assert_eq!(narrow.area("transcript"), Some(Rect::new(4, 0, 3, 10)));
+    place(&layout, None, Rect::new(0, 0, 42, 10));
+    let at = |kind, column| MouseEvent {
+        kind,
+        column,
+        row: 4,
+        modifiers: crossterm::event::KeyModifiers::NONE,
+    };
+    assert!(pointer(at(MouseEventKind::Down(MouseButton::Left), 21)));
+    assert!(pointer(at(MouseEventKind::Drag(MouseButton::Left), 30)));
+    assert!(pointer(at(MouseEventKind::Up(MouseButton::Left), 30)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(
+        placement.area("site:files/tree"),
+        Some(Rect::new(0, 0, 30, 10))
+    );
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+    hide();
+    assert!(!pointer(at(MouseEventKind::Down(MouseButton::Left), 31)));
+    let placement = place(&layout, None, Rect::new(0, 0, 42, 10));
+    assert_eq!(placement.area("transcript"), Some(Rect::new(32, 0, 10, 10)));
+}
diff --git a/codex-rs/tui/src/mod_module.rs b/codex-rs/tui/src/mod_module.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d0cc3533d2adf7951385a69a7bc1991f7e8b5e2
--- /dev/null
+++ b/codex-rs/tui/src/mod_module.rs
@@ -0,0 +1,457 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+use crate::omd::LockExt;
+use codex_omd::ModComponent;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use serde_json::Value;
+use serde_json::json;
+
+const FRAME: Duration = Duration::from_millis(16);
+const RETRY: Duration = Duration::from_millis(100);
+const EVENTS: usize = 256;
+/// A module not drawn for this long (a collapsed pane, a hidden site) stops ticking until it is drawn again.
+const UNDRAWN: Duration = Duration::from_secs(1);
+
+struct Instance {
+    generation: u64,
+    owner: String,
+    module: String,
+    props: Value,
+    columns: u16,
+    rows: u16,
+    events: Vec<Value>,
+    tree: Vec<ModComponent>,
+    composed: Option<(u16, Vec<Line<'static>>)>,
+    drawn: Instant,
+    mounted: bool,
+    changed: bool,
+    due: Option<Instant>,
+    stepped: Option<Instant>,
+    failed: Option<String>,
+}
+
+static INSTANCES: Mutex<Option<HashMap<String, Instance>>> = Mutex::new(None);
+static WORKER: OnceLock<std::thread::Thread> = OnceLock::new();
+static POSTS: Mutex<Vec<Post>> = Mutex::new(Vec::new());
+
+struct Post {
+    id: String,
+    generation: u64,
+    owner: String,
+    payload: Value,
+}
+
+impl Post {
+    fn current(&self, instances: &HashMap<String, Instance>) -> bool {
+        current_generation(instances, &self.id, self.generation)
+    }
+}
+
+fn current_generation(instances: &HashMap<String, Instance>, id: &str, generation: u64) -> bool {
+    instances
+        .get(id)
+        .is_some_and(|instance| instance.generation == generation)
+}
+
+fn instances<T>(run: impl FnOnce(&mut HashMap<String, Instance>) -> T) -> T {
+    let mut instances = INSTANCES.locked();
+    run(instances.get_or_insert_with(HashMap::new))
+}
+
+fn clock() -> u64 {
+    static ORIGIN: OnceLock<Instant> = OnceLock::new();
+    ORIGIN.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+
+fn wake() {
+    WORKER
+        .get_or_init(|| std::thread::spawn(work).thread().clone())
+        .unpark();
+}
+
+/// The rows a mounted module draws at `width`; mounting it, or changing its props or size, asks for a step.
+pub(crate) fn rows(
+    id: &str,
+    owner: Option<&str>,
+    module: &str,
+    props: &Value,
+    width: u16,
+    height: Option<u16>,
+) -> Vec<Line<'static>> {
+    let Some(owner) = owner else {
+        return vec![Line::from(format!("{module}: no owner")).dim()];
+    };
+    let rows = height.unwrap_or(0);
+    let (lines, step, replaced) = instances(|instances| {
+        let instance = instances
+            .entry(id.to_owned())
+            .or_insert_with(|| fresh(owner, module));
+        let mut replaced = None;
+        if instance.owner != owner || instance.module != module {
+            replaced = Some(instance.owner.clone());
+            *instance = fresh(owner, module);
+        }
+        let resumed = instance.drawn.elapsed() > UNDRAWN;
+        instance.drawn = Instant::now();
+        if instance.props != *props || instance.columns != width || instance.rows != rows {
+            instance.props = props.clone();
+            instance.columns = width;
+            instance.rows = rows;
+            instance.changed = true;
+        }
+        let lines = match &instance.failed {
+            Some(error) => vec![failure_line(owner, module, error)],
+            None => composed(instance, width).to_vec(),
+        };
+        let step = instance.failed.is_none()
+            && (instance.changed
+                || instance
+                    .due
+                    .is_some_and(|due| resumed || due <= Instant::now()));
+        (lines, step, replaced)
+    });
+    if let Some(previous) = replaced {
+        codex_omd::component_unmount(&previous, id);
+    }
+    if step {
+        wake();
+    }
+    let mut lines = lines;
+    if let Some(height) = height {
+        lines.resize(usize::from(height), Line::default());
+    } else if lines.is_empty() {
+        lines.push(Line::default());
+    }
+    lines
+}
+
+pub(crate) fn mounted(id: &str) -> bool {
+    instances(|instances| instances.contains_key(id))
+}
+
+/// Rows a module without a declared height takes: what its latest tree draws.
+pub(crate) fn height(id: &str) -> u16 {
+    instances(|instances| {
+        instances.get_mut(id).map_or(1, |instance| {
+            let drawn = if instance.failed.is_some() {
+                1
+            } else {
+                let columns = instance.columns.max(1);
+                composed(instance, columns).len()
+            };
+            u16::try_from(drawn.max(1)).unwrap_or(u16::MAX)
+        })
+    })
+}
+
+fn composed(instance: &mut Instance, width: u16) -> &[Line<'static>] {
+    if instance
+        .composed
+        .as_ref()
+        .is_some_and(|(cached, _)| *cached != width)
+    {
+        instance.composed = None;
+    }
+    let tree = &instance.tree;
+    &instance
+        .composed
+        .get_or_insert_with(|| {
+            let lines = crate::mod_render::compose_lines(tree, width, None, Vec::new());
+            (width, lines.into_iter().map(|line| line.line).collect())
+        })
+        .1
+}
+
+fn failure_line(owner: &str, module: &str, error: &str) -> Line<'static> {
+    let error = error.lines().next().unwrap_or_default();
+    Line::from(format!("{owner}: {module}: {error}")).dim()
+}
+
+fn next_generation() -> u64 {
+    static GENERATION: AtomicU64 = AtomicU64::new(1);
+    GENERATION.fetch_add(1, Ordering::Relaxed)
+}
+
+fn fresh(owner: &str, module: &str) -> Instance {
+    Instance {
+        generation: next_generation(),
+        owner: owner.to_owned(),
+        module: module.to_owned(),
+        props: Value::Null,
+        columns: 0,
+        rows: 0,
+        events: Vec::new(),
+        tree: Vec::new(),
+        composed: None,
+        drawn: Instant::now(),
+        mounted: false,
+        changed: true,
+        due: None,
+        stepped: None,
+        failed: None,
+    }
+}
+
+pub(crate) fn retain(ids: &std::collections::BTreeSet<String>) {
+    let gone = instances(|instances| {
+        let mut gone = Vec::new();
+        instances.retain(|id, instance| {
+            let kept = ids.contains(id);
+            if !kept {
+                gone.push((instance.owner.clone(), id.clone()));
+            }
+            kept
+        });
+        gone
+    });
+    for (owner, id) in gone {
+        codex_omd::component_unmount(&owner, &id);
+    }
+}
+
+/// Queues a key or pointer event for a mounted module; false leaves it to the component's other routes.
+pub(crate) fn accept(payload: &Value) -> bool {
+    let Some(component) = payload["component"].as_str() else {
+        return false;
+    };
+    let accepted = instances(|instances| {
+        let Some(instance) = instances.get_mut(component) else {
+            return false;
+        };
+        if instance.failed.is_some() {
+            return true;
+        }
+        for event in codex_omd::component_events(payload) {
+            let moved = |event: &Value| {
+                event["kind"] == "pointer"
+                    && matches!(event["action"].as_str(), Some("move" | "drag"))
+            };
+            if moved(&event) && instance.events.last().is_some_and(moved) {
+                instance.events.pop();
+            }
+            if instance.events.len() >= EVENTS {
+                instance.events.remove(0);
+            }
+            instance.events.push(event);
+        }
+        true
+    });
+    if accepted {
+        wake();
+    }
+    accepted
+}
+
+/// A new view revision mounts failed modules again.
+pub(crate) fn refresh() {
+    let retry = instances(|instances| {
+        let mut retry = false;
+        for instance in instances
+            .values_mut()
+            .filter(|instance| instance.failed.is_some())
+        {
+            instance.generation = next_generation();
+            instance.failed = None;
+            instance.mounted = false;
+            instance.changed = true;
+            retry = true;
+        }
+        retry
+    });
+    if retry {
+        wake();
+    }
+}
+
+struct Job {
+    id: String,
+    generation: u64,
+    owner: String,
+    module: String,
+    frame: Value,
+    events: Vec<Value>,
+}
+
+fn next_job() -> Result<Job, Option<Duration>> {
+    let now = Instant::now();
+    instances(|instances| {
+        let mut wait: Option<Duration> = None;
+        let mut ready = None;
+        for (id, instance) in instances.iter() {
+            if instance.failed.is_some() {
+                continue;
+            }
+            let wanted = if instance.changed || !instance.events.is_empty() {
+                Some(now)
+            } else if now.saturating_duration_since(instance.drawn) > UNDRAWN {
+                None
+            } else {
+                instance.due
+            };
+            let Some(wanted) = wanted else {
+                continue;
+            };
+            let at = instance
+                .stepped
+                .map_or(wanted, |stepped| wanted.max(stepped + FRAME));
+            if at <= now {
+                ready = Some(id.clone());
+                break;
+            }
+            let until = at - now;
+            wait = Some(wait.map_or(until, |wait| wait.min(until)));
+        }
+        let Some(id) = ready else {
+            return Err(wait);
+        };
+        let instance = instances.get_mut(&id).ok_or(wait)?;
+        let events = std::mem::take(&mut instance.events);
+        let frame = json!({"instance": id, "mount": !instance.mounted, "props": instance.props,
+            "now": clock(), "columns": instance.columns, "rows": instance.rows, "events": events});
+        instance.changed = false;
+        instance.due = None;
+        instance.stepped = Some(now);
+        Ok(Job {
+            id,
+            generation: instance.generation,
+            owner: instance.owner.clone(),
+            module: instance.module.clone(),
+            frame,
+            events,
+        })
+    })
+}
+
+fn work() {
+    loop {
+        let mut job = match next_job() {
+            Ok(job) => job,
+            Err(wait) => {
+                match wait {
+                    Some(wait) => std::thread::park_timeout(wait),
+                    None => std::thread::park(),
+                }
+                continue;
+            }
+        };
+        let result =
+            crate::mod_runtime::component(&job.owner, &job.module, std::mem::take(&mut job.frame));
+        let post = instances(|instances| finish_job(instances, &mut job, result));
+        match post {
+            Some(Some(post)) => deliver(post),
+            Some(None) => {}
+            None => instances(|instances| {
+                // Replacement or removal already unmounted the old runner; a late step may recreate it but must never tear down a same-owner replacement.
+                if instances
+                    .get(&job.id)
+                    .is_none_or(|instance| instance.owner != job.owner)
+                {
+                    codex_omd::component_unmount(&job.owner, &job.id);
+                }
+            }),
+        }
+    }
+}
+
+fn finish_job(
+    instances: &mut HashMap<String, Instance>,
+    job: &mut Job,
+    result: Option<Result<Value, String>>,
+) -> Option<Option<Post>> {
+    let instance = instances.get_mut(&job.id)?;
+    if instance.generation != job.generation {
+        return None;
+    }
+    let Some(result) = result else {
+        let mut events = std::mem::take(&mut job.events);
+        events.append(&mut instance.events);
+        instance.events = events;
+        instance.changed = true;
+        instance.stepped = Some(Instant::now() + RETRY);
+        return Some(None);
+    };
+    Some(match result {
+        Ok(step) => {
+            instance.mounted = true;
+            instance.due = step["next_ms"]
+                .as_u64()
+                .map(|ms| Instant::now() + Duration::from_millis(ms));
+            if let Ok(tree) = serde_json::from_value::<Vec<ModComponent>>(step["tree"].clone())
+                && tree != instance.tree
+            {
+                instance.tree = tree;
+                instance.composed = None;
+                crate::mod_render::schedule_frame(Duration::ZERO);
+            }
+            step["post"].as_object().map(|post| Post {
+                id: job.id.clone(),
+                generation: job.generation,
+                owner: job.owner.clone(),
+                payload: json!({"component": job.id, "module": job.module, "data": post["data"]}),
+            })
+        }
+        Err(error) => {
+            instance.failed = Some(error);
+            instance.mounted = false;
+            instance.tree.clear();
+            instance.composed = None;
+            crate::mod_render::schedule_frame(Duration::ZERO);
+            None
+        }
+    })
+}
+
+/// A post reaches the owner's `component_post` hooks off the frame worker; a newer post from the same instance replaces an undelivered one.
+fn deliver(post: Post) {
+    static SENDER: OnceLock<std::thread::Thread> = OnceLock::new();
+    {
+        let mut posts = POSTS.locked();
+        posts.retain(|queued| queued.owner != post.owner || queued.id != post.id);
+        posts.push(post);
+    }
+    SENDER
+        .get_or_init(|| {
+            std::thread::spawn(|| {
+                loop {
+                    let next = {
+                        let mut posts = POSTS.locked();
+                        (!posts.is_empty()).then(|| posts.remove(0))
+                    };
+                    match next {
+                        Some(post) => {
+                            if instances(|instances| post.current(instances)) {
+                                let id = post.id;
+                                let generation = post.generation;
+                                crate::mod_runtime::invoke_event_guarded(
+                                    &post.owner,
+                                    "component_post",
+                                    post.payload,
+                                    Arc::new(move || {
+                                        instances(|instances| {
+                                            current_generation(instances, &id, generation)
+                                        })
+                                    }),
+                                );
+                            }
+                        }
+                        None => std::thread::park(),
+                    }
+                }
+            })
+            .thread()
+            .clone()
+        })
+        .unpark();
+}
+
+#[cfg(test)]
+#[path = "mod_module_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/mod_module_tests.rs b/codex-rs/tui/src/mod_module_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6fcbc58e569730183ee7a88fde9ff76ca6a682ab
--- /dev/null
+++ b/codex-rs/tui/src/mod_module_tests.rs
@@ -0,0 +1,89 @@
+use super::*;
+use std::sync::Arc;
+use std::sync::mpsc;
+
+fn tree(text: &str) -> Vec<ModComponent> {
+    serde_json::from_value(json!([
+        {"type": "text", "id": "body", "label": "body", "text": text}
+    ]))
+    .expect("valid component tree")
+}
+
+fn take_job(instance: &mut Instance) -> Job {
+    instance.changed = false;
+    Job {
+        id: "module".to_owned(),
+        generation: instance.generation,
+        owner: instance.owner.clone(),
+        module: instance.module.clone(),
+        frame: Value::Null,
+        events: std::mem::take(&mut instance.events),
+    }
+}
+
+#[test]
+fn replacement_during_step_rejects_old_success_error_and_retry() {
+    for (owner, module, remount) in [
+        ("new-owner", "old-module", false),
+        ("owner", "new-module", false),
+        ("owner", "old-module", true),
+    ] {
+        for result in [
+            Some(Ok(json!({
+                "tree": tree("obsolete"), "next_ms": 1,
+                "post": {"data": {"obsolete": true}}
+            }))),
+            Some(Err("obsolete failure".to_owned())),
+            None,
+        ] {
+            let mut original = fresh("owner", "old-module");
+            original.events = vec![json!({"old": true})];
+            let mut job = take_job(&mut original);
+            let mounted = Arc::new(Mutex::new(HashMap::from([(job.id.clone(), original)])));
+            let (started, stepping) = mpsc::channel();
+            let (release, response) = mpsc::channel();
+            let worker_instances = Arc::clone(&mounted);
+            let worker = std::thread::spawn(move || {
+                started.send(()).unwrap();
+                let result = response.recv().unwrap();
+                finish_job(&mut worker_instances.lock().unwrap(), &mut job, result).is_none()
+            });
+            stepping.recv().unwrap();
+            let due = Instant::now() + Duration::from_secs(10);
+            let stepped = Instant::now();
+            {
+                let mut mounted = mounted.lock().unwrap();
+                if remount {
+                    mounted.remove("module");
+                }
+                let mut replacement = fresh(owner, module);
+                replacement.tree = tree("replacement");
+                replacement.composed = Some((20, vec![Line::raw("cached replacement")]));
+                replacement.events = vec![json!({"new": true})];
+                replacement.changed = false;
+                replacement.mounted = true;
+                replacement.due = Some(due);
+                replacement.stepped = Some(stepped);
+                mounted.insert("module".to_owned(), replacement);
+            }
+            release.send(result).unwrap();
+            assert!(
+                worker.join().unwrap(),
+                "obsolete completion produced a post/result"
+            );
+            let mounted = mounted.lock().unwrap();
+            let replacement = &mounted["module"];
+            assert_eq!(replacement.tree, tree("replacement"));
+            assert_eq!(replacement.failed, None);
+            assert!(replacement.mounted);
+            assert!(!replacement.changed);
+            assert_eq!(replacement.due, Some(due));
+            assert_eq!(replacement.stepped, Some(stepped));
+            assert_eq!(replacement.events, vec![json!({"new": true})]);
+            assert_eq!(
+                replacement.composed.as_ref().unwrap().1,
+                vec![Line::raw("cached replacement")]
+            );
+        }
+    }
+}
diff --git a/codex-rs/tui/src/mod_pty.rs b/codex-rs/tui/src/mod_pty.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2ae62c4a1998a7aa934295be198e951187974612
--- /dev/null
+++ b/codex-rs/tui/src/mod_pty.rs
@@ -0,0 +1,610 @@
+use crate::omd::LockExt;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+const PANES: usize = 16;
+const WRITE_BYTES: usize = 4096;
+const SCROLLBACK: usize = 2000;
+
+struct Pane {
+    writer: tokio::sync::mpsc::Sender<Vec<u8>>,
+    handle: codex_utils_pty::ProcessHandle,
+    screen: Arc<Mutex<vt100::Parser>>,
+    exit: Arc<Mutex<Option<i32>>>,
+    size: (u16, u16),
+    unrestricted: bool,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct Scope {
+    epoch: u64,
+    admission: u64,
+    generation: u64,
+    configuration: String,
+    thread: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Binding {
+    owner: String,
+    scope: Scope,
+}
+
+#[derive(Default)]
+struct Sessions {
+    scope: Scope,
+    owners: BTreeMap<String, String>,
+    panes: BTreeMap<(String, String), Pane>,
+}
+
+static SESSIONS: std::sync::LazyLock<Mutex<Sessions>> =
+    std::sync::LazyLock::new(|| Mutex::new(Sessions::default()));
+
+fn sessions() -> std::sync::MutexGuard<'static, Sessions> {
+    SESSIONS.locked()
+}
+
+fn owned<'a>(
+    sessions: &'a mut Sessions,
+    binding: &Binding,
+    session: &str,
+) -> Result<&'a mut Pane, String> {
+    validate(sessions, binding)?;
+    sessions
+        .panes
+        .get_mut(&(binding.owner.clone(), session.to_owned()))
+        .ok_or_else(|| format!("pty_session_unknown: {session}"))
+}
+
+fn validate(sessions: &Sessions, binding: &Binding) -> Result<(), String> {
+    if sessions.scope != binding.scope || !sessions.owners.contains_key(&binding.owner) {
+        return Err("pty_context_changed".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn binding(
+    owner: &str,
+    thread: Option<&str>,
+    authority: &codex_omd::client_surface::Authority,
+) -> Result<Binding, String> {
+    let sessions = sessions();
+    let binding = Binding {
+        owner: owner.to_owned(),
+        scope: sessions.scope.clone(),
+    };
+    validate(&sessions, &binding)?;
+    if thread != binding.scope.thread.as_deref()
+        || authority.epoch != binding.scope.epoch
+        || authority.admission != binding.scope.admission
+        || authority.configuration != binding.scope.configuration
+        || sessions.owners.get(owner) != Some(&authority.source)
+    {
+        return Err("pty_context_changed".into());
+    }
+    Ok(binding)
+}
+
+pub(crate) fn current(binding: &Binding) -> bool {
+    validate(&sessions(), binding).is_ok()
+}
+
+pub(crate) fn view_binding(
+    owner: &str,
+    thread: Option<&str>,
+    epoch: u64,
+    admission: u64,
+    configuration: &str,
+) -> Result<Binding, String> {
+    let source = sessions()
+        .owners
+        .get(owner)
+        .cloned()
+        .ok_or("pty_context_changed")?;
+    binding(
+        owner,
+        thread,
+        &codex_omd::client_surface::Authority {
+            epoch,
+            admission,
+            configuration: configuration.to_owned(),
+            source,
+        },
+    )
+}
+
+fn clear(sessions: &mut Sessions) {
+    for pane in sessions.panes.values() {
+        pane.handle.terminate();
+    }
+    sessions.panes.clear();
+}
+
+pub(crate) fn context(epoch: u64, thread: Option<String>) {
+    let mut sessions = sessions();
+    if sessions.scope.epoch != epoch || sessions.scope.thread != thread {
+        clear(&mut sessions);
+        sessions.scope.epoch = epoch;
+        sessions.scope.thread = thread;
+    }
+}
+
+pub(crate) fn retain(
+    generation: u64,
+    configuration: &str,
+    active: &BTreeMap<String, String>,
+    unrestricted: &std::collections::BTreeSet<String>,
+) {
+    let mut sessions = sessions();
+    if sessions.scope.generation != generation || sessions.scope.configuration != configuration {
+        clear(&mut sessions);
+        sessions.scope.generation = generation;
+        sessions.scope.admission = codex_omd::client_surface::advance_admission();
+        sessions.scope.configuration = configuration.to_owned();
+    }
+    sessions.owners = active.clone();
+    sessions.panes.retain(|(owner, _), pane| {
+        let keep =
+            active.contains_key(owner) && (!pane.unrestricted || unrestricted.contains(owner));
+        if !keep {
+            pane.handle.terminate();
+        }
+        keep
+    });
+}
+
+pub(crate) fn argv(arguments: &Value) -> Result<Vec<String>, String> {
+    let Some(program) = arguments["program"].as_str() else {
+        if !arguments["argv"].is_null() || !arguments["sha256"].is_null() {
+            return Err("pty_program_required".into());
+        }
+        return Ok(vec![
+            std::env::var("SHELL").unwrap_or_else(|_| "/bin/zsh".to_owned()),
+            "-i".to_owned(),
+        ]);
+    };
+    let args = match &arguments["argv"] {
+        Value::Null => Vec::new(),
+        Value::Array(items) => items
+            .iter()
+            .map(|item| item.as_str().map(str::to_owned))
+            .collect::<Option<Vec<_>>>()
+            .ok_or("pty_argv_invalid")?,
+        _ => return Err("pty_argv_invalid".into()),
+    };
+    if program.is_empty()
+        || args.len() > 64
+        || args.iter().map(String::len).sum::<usize>() > 8192
+        || std::iter::once(program)
+            .chain(args.iter().map(String::as_str))
+            .any(|arg| arg.contains('\0'))
+    {
+        return Err("pty_argv_invalid".into());
+    }
+    Ok(std::iter::once(program.to_owned()).chain(args).collect())
+}
+
+fn session_name(value: &Value) -> Result<String, String> {
+    value
+        .as_str()
+        .filter(|name| {
+            !name.is_empty()
+                && name.len() <= 64
+                && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        })
+        .map(str::to_owned)
+        .ok_or_else(|| "pty_session_invalid".to_owned())
+}
+
+pub(crate) fn start_prompt(caller: &str, arguments: &Value) -> Result<String, String> {
+    session_name(&arguments["session"])?;
+    let argv = argv(arguments)?;
+    Ok(format!(
+        "Mod {caller} wants to open a terminal pane running `{}` in {}. It runs in the session sandbox {}, {}. The mod can type into it and read its screen.",
+        argv.join(" "),
+        arguments["cwd"].as_str().unwrap_or("."),
+        if arguments["network"] == "loopback" {
+            "with network limited to this computer (loopback)"
+        } else {
+            "without network"
+        },
+        if arguments["write"] == true {
+            "and can write to the workspace"
+        } else {
+            "read-only"
+        }
+    ))
+}
+
+pub(crate) async fn start(
+    binding: &Binding,
+    arguments: &Value,
+    command: std::process::Command,
+    home: &Path,
+    frames: crate::tui::FrameRequester,
+) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let owner = &binding.owner;
+    let key = (owner.clone(), session.clone());
+    let limit = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .map_or_else(Default::default, |store| {
+            codex_omd::mod_limits::ModLimits::read(&store)
+        })
+        .pty_panes_per_mod;
+    let unavailable = |sessions: &Sessions| {
+        sessions.panes.contains_key(&key)
+            || sessions.panes.len() >= PANES
+            || sessions.panes.keys().filter(|(id, _)| id == owner).count() >= limit
+    };
+    {
+        let sessions = sessions();
+        validate(&sessions, binding)?;
+        if unavailable(&sessions) {
+            return Err("pty_session_exists_or_limit".into());
+        }
+    }
+    let program = command.get_program().to_string_lossy().into_owned();
+    let args = command
+        .get_args()
+        .map(|arg| arg.to_string_lossy().into_owned())
+        .collect::<Vec<_>>();
+    let cwd = command
+        .get_current_dir()
+        .ok_or("pty_cwd_invalid")?
+        .to_path_buf();
+    let mut environment = std::collections::HashMap::from([
+        ("TERM".to_owned(), "xterm-256color".to_owned()),
+        ("HOME".to_owned(), home.to_string_lossy().into_owned()),
+    ]);
+    for name in ["PATH", "LANG", "USER", "SHELL"] {
+        if let Ok(value) = std::env::var(name) {
+            environment.insert(name.to_owned(), value);
+        }
+    }
+    let size = codex_utils_pty::TerminalSize { rows: 24, cols: 80 };
+    let spawned = codex_utils_pty::pty::spawn_process(
+        &program,
+        &args,
+        &cwd,
+        &environment,
+        &None,
+        size,
+        codex_utils_pty::ChildFds::Attached(&[]),
+    )
+    .await
+    .map_err(|error| format!("pty_start_failed: {error}"))?;
+    let screen = Arc::new(Mutex::new(vt100::Parser::new(
+        size.rows, size.cols, SCROLLBACK,
+    )));
+    let exit = Arc::new(Mutex::new(None));
+    let (mut output, exited) = (spawned.stdout_rx, spawned.exit_rx);
+    let (reader, reader_frames) = (screen.clone(), frames.clone());
+    tokio::spawn(async move {
+        while let Some(bytes) = output.recv().await {
+            reader.locked().process(&bytes);
+            reader_frames.schedule_frame();
+        }
+    });
+    let status = exit.clone();
+    tokio::spawn(async move {
+        let code = exited.await.unwrap_or(-1);
+        *status.locked() = Some(code);
+        frames.schedule_frame();
+    });
+    let mut sessions = sessions();
+    if let Err(error) = validate(&sessions, binding) {
+        spawned.session.terminate();
+        return Err(error);
+    }
+    if unavailable(&sessions) {
+        spawned.session.terminate();
+        return Err("pty_session_exists_or_limit".into());
+    }
+    sessions.panes.insert(
+        key,
+        Pane {
+            writer: spawned.session.writer_sender(),
+            handle: spawned.session,
+            screen,
+            exit,
+            size: (size.rows, size.cols),
+            unrestricted: arguments["sandbox"] == "none",
+        },
+    );
+    Ok(json!({"session": session, "running": true}))
+}
+
+pub(crate) fn call(binding: &Binding, arguments: &Value) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let mut sessions = sessions();
+    match arguments["action"].as_str() {
+        Some("write") => {
+            let text = arguments["text"]
+                .as_str()
+                .filter(|text| text.len() <= WRITE_BYTES)
+                .ok_or("pty_write_invalid")?;
+            owned(&mut sessions, binding, &session)?
+                .writer
+                .try_send(text.as_bytes().to_vec())
+                .map_err(|_| "pty_write_unavailable")?;
+            Ok(json!({"written": text.len()}))
+        }
+        Some("read") => {
+            let pane = owned(&mut sessions, binding, &session)?;
+            let text = pane.screen.locked().screen().contents();
+            let exit_code = *pane.exit.locked();
+            Ok(json!({"text": text, "running": exit_code.is_none(), "exit_code": exit_code}))
+        }
+        Some("stop") => {
+            owned(&mut sessions, binding, &session)?.handle.terminate();
+            sessions.panes.remove(&(binding.owner.clone(), session));
+            Ok(json!({"stopped": true}))
+        }
+        _ => Err("pty_action_invalid".into()),
+    }
+}
+
+#[allow(clippy::disallowed_methods)]
+fn color(color: vt100::Color) -> Option<Color> {
+    match color {
+        vt100::Color::Default => None,
+        vt100::Color::Idx(index) => Some(Color::Indexed(index)),
+        vt100::Color::Rgb(r, g, b) => Some(Color::Rgb(r, g, b)),
+    }
+}
+
+pub(crate) fn rows(
+    binding: Option<&Binding>,
+    session: &str,
+    width: u16,
+    height: u16,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return vec![Line::from(format!(
+            "{prefix}[shell {session} is not running]"
+        ))];
+    };
+    let (rows, cols) = (height.max(2), width.max(10));
+    let mut screen = pane.screen.locked();
+    if pane.size != (rows, cols) {
+        pane.size = (rows, cols);
+        screen.screen_mut().set_size(rows, cols);
+        let _ = pane
+            .handle
+            .resize(codex_utils_pty::TerminalSize { rows, cols });
+    }
+    let exited = *pane.exit.locked();
+    let mut lines = (0..rows)
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            for column in 0..cols {
+                let Some(cell) = screen.screen().cell(row, column) else {
+                    continue;
+                };
+                let mut style = Style::default();
+                if let Some(foreground) = color(cell.fgcolor()) {
+                    style = style.fg(foreground);
+                }
+                if let Some(background) = color(cell.bgcolor()) {
+                    style = style.bg(background);
+                }
+                if cell.bold() {
+                    style = style.add_modifier(Modifier::BOLD);
+                }
+                if cell.inverse() {
+                    style = style.add_modifier(Modifier::REVERSED);
+                }
+                let text = if cell.has_contents() {
+                    cell.contents().to_owned()
+                } else {
+                    " ".to_owned()
+                };
+                spans.push(Span::styled(text, style));
+            }
+            Line::from(spans)
+        })
+        .collect::<Vec<_>>();
+    if let Some(code) = exited {
+        lines.push(Line::from(format!("{prefix}[shell exited with {code}]")));
+    }
+    lines
+}
+
+pub(crate) fn key(binding: Option<&Binding>, session: &str, key: KeyEvent) -> bool {
+    let bytes = match (key.code, key.modifiers) {
+        (KeyCode::Char(c), KeyModifiers::CONTROL) if c.is_ascii_alphabetic() => {
+            vec![(c.to_ascii_lowercase() as u8) & 0x1f]
+        }
+        (KeyCode::Char(c), _) => c.to_string().into_bytes(),
+        (KeyCode::Enter, _) => vec![b'\r'],
+        (KeyCode::Backspace, _) => vec![0x7f],
+        (KeyCode::Tab, _) => vec![b'\t'],
+        (KeyCode::Esc, _) => vec![0x1b],
+        (KeyCode::Up, _) => b"\x1b[A".to_vec(),
+        (KeyCode::Down, _) => b"\x1b[B".to_vec(),
+        (KeyCode::Right, _) => b"\x1b[C".to_vec(),
+        (KeyCode::Left, _) => b"\x1b[D".to_vec(),
+        (KeyCode::Home, _) => b"\x1b[H".to_vec(),
+        (KeyCode::End, _) => b"\x1b[F".to_vec(),
+        (KeyCode::Delete, _) => b"\x1b[3~".to_vec(),
+        _ => return false,
+    };
+    let mut sessions = sessions();
+    binding
+        .and_then(|binding| owned(&mut sessions, binding, session).ok())
+        .is_some_and(|pane| pane.writer.try_send(bytes).is_ok())
+}
+
+pub(crate) fn paste(binding: Option<&Binding>, session: &str, text: &str) {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return;
+    };
+    let bracketed = pane.screen.locked().screen().bracketed_paste();
+    let bytes = if bracketed {
+        format!("\x1b[200~{text}\x1b[201~")
+    } else {
+        text.to_owned()
+    };
+    let _ = pane.writer.try_send(bytes.into_bytes());
+}
+
+#[cfg(test)]
+pub(crate) struct TestScope(Option<Sessions>);
+
+#[cfg(test)]
+impl Drop for TestScope {
+    fn drop(&mut self) {
+        let mut state = sessions();
+        clear(&mut state);
+        *state = self.0.take().unwrap();
+        state.scope.admission = codex_omd::client_surface::admission();
+    }
+}
