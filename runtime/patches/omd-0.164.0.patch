+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy::ReqwestDefault;
+use codex_protocol::protocol::RealtimeVoice;
+use http::HeaderMap;
+use tokio::net::TcpListener;
+
+struct Policed;
+
+impl ResponseObserver for Policed {
+    fn prepare(
+        &self,
+        _request: &mut Request,
+        _body: &mut Option<EncodedJsonBody>,
+    ) -> Result<(), TransportError> {
+        Ok(())
+    }
+
+    fn before_send(
+        &self,
+        _request: &mut Request,
+        _body: Option<&EncodedJsonBody>,
+    ) -> Result<Option<Box<dyn ResponseAttempt>>, TransportError> {
+        Ok(None)
+    }
+
+    fn requires_observation(&self, _thread: Option<&str>) -> bool {
+        false
+    }
+
+    fn police_unary(
+        &self,
+        _thread: Option<&str>,
+        body: &mut serde_json::Value,
+    ) -> Result<(), TransportError> {
+        if body["prompt"] == "SECRET-3" {
+            return Err(TransportError::Build("policy denied SECRET-3".into()));
+        }
+        body["prompt"] = "[redacted]".into();
+        Ok(())
+    }
+
+    fn policed(&self) -> Option<String> {
+        Some("privacy_fixture".into())
+    }
+}
+
+#[derive(Clone, Default)]
+struct Counting(Arc<AtomicUsize>, Arc<std::sync::Mutex<Vec<String>>>);
+
+impl HttpTransport for Counting {
+    async fn execute(&self, req: Request) -> Result<Response, TransportError> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        if let Some(codex_client::RequestBody::Json(body)) = &req.body {
+            self.1.lock().unwrap().push(body.to_string());
+        }
+        Err(TransportError::Build("sent".into()))
+    }
+
+    async fn stream(&self, _req: Request) -> Result<StreamResponse, TransportError> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Err(TransportError::Build("sent".into()))
+    }
+}
+
+struct NoAuth;
+
+impl AuthProvider for NoAuth {
+    fn add_auth_headers(&self, _headers: &mut HeaderMap) -> Result<(), AuthError> {
+        Ok(())
+    }
+}
+
+fn provider(base_url: String) -> Provider {
+    Provider {
+        name: "test".into(),
+        base_url,
+        query_params: Some(HashMap::new()),
+        headers: HeaderMap::new(),
+        retry: RetryConfig {
+            max_attempts: 1,
+            base_delay: Duration::from_millis(1),
+            retry_429: false,
+            retry_5xx: false,
+            retry_transport: false,
+        },
+        stream_idle_timeout: Duration::from_secs(5),
+    }
+}
+
+fn session(instructions: &str) -> RealtimeSessionConfig {
+    RealtimeSessionConfig {
+        instructions: instructions.into(),
+        initial_items: Vec::new(),
+        delegation_ack_filler: None,
+        model: Some("realtime-test-model".into()),
+        session_id: Some("conv".into()),
+        event_parser: RealtimeEventParser::V1,
+        session_mode: RealtimeSessionMode::Conversational,
+        output_modality: RealtimeOutputModality::Audio,
+        voice: RealtimeVoice::Cove,
+    }
+}
+
+#[tokio::test]
+async fn an_active_final_request_policy_polices_unary_requests_and_refuses_the_rest() {
+    codex_api::request_observer::install_response_observer(Arc::new(Policed))
+        .expect("observer installs once");
+    let transport = Counting::default();
+    let search = SearchClient::new(
+        transport.clone(),
+        provider("https://example.com/v1".into()),
+        Arc::new(NoAuth),
+    );
+    let request = SearchRequest {
+        id: "search".into(),
+        model: "model".into(),
+        reasoning: None,
+        input: Some(SearchInput::Text("SECRET-1".into())),
+        commands: None,
+        settings: None,
+        max_output_tokens: None,
+    };
+    let error = search
+        .search(&request, HeaderMap::new())
+        .await
+        .expect_err("the fixture transport fails after sending");
+    assert!(error.to_string().contains("sent"), "{error}");
+    assert_eq!(transport.0.load(Ordering::SeqCst), 1);
+
+    let images = ImagesClient::new(
+        transport.clone(),
+        provider("https://example.com/v1".into()),
+        Arc::new(NoAuth),
+    );
+    let image = |prompt: &str| ImageGenerationRequest {
+        prompt: prompt.into(),
+        background: None,
+        model: "image-model".into(),
+        n: None,
+        quality: None,
+        size: None,
+    };
+    let denied = images
+        .generate(&image("SECRET-3"), HeaderMap::new())
+        .await
+        .expect_err("the policy denies")
+        .into_parts()
+        .0;
+    assert!(denied.to_string().contains("policy denied SECRET-3"), "{denied}");
+    assert_eq!(transport.0.load(Ordering::SeqCst), 1);
+    let _ = images.generate(&image("SECRET-4"), HeaderMap::new()).await;
+    let sent = transport.1.lock().unwrap().clone();
+    assert!(sent[1].contains("[redacted]") && !sent[1].contains("SECRET-4"), "{sent:?}");
+
+    let call = RealtimeCallClient::new(
+        transport.clone(),
+        provider("https://example.com/backend-api".into()),
+        Arc::new(NoAuth),
+    );
+    let refused = call
+        .create_with_session("v=0".into(), session("SECRET-5"))
+        .await
+        .expect_err("call creation is refused");
+    assert!(
+        refused
+            .to_string()
+            .contains("realtime/calls requests cannot pass the final-request policy"),
+        "{refused}"
+    );
+    assert_eq!(transport.0.load(Ordering::SeqCst), 2);
+
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind listener");
+    let address = listener.local_addr().expect("listener address");
+    let realtime = RealtimeWebsocketClient::new(
+        provider(format!("http://{address}")),
+        HttpClientFactory::new(ReqwestDefault),
+    );
+    let refused = realtime
+        .connect(
+            session("SECRET-2"),
+            HeaderMap::new(),
+            HeaderMap::new(),
+        )
+        .await;
+    let Err(error) = refused else {
+        panic!("realtime websocket connected");
+    };
+    assert!(
+        error
+            .to_string()
+            .contains("realtime requests cannot pass the final-request policy of privacy_fixture"),
+        "{error}"
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(100), listener.accept())
+            .await
+            .is_err(),
+        "the realtime websocket reached the provider"
+    );
+}
