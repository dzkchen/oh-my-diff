+const NPM_ARCHIVE_ENTRIES: usize = 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ModPackageSource {
+    Local {
