+pub(crate) async fn replace_tool_output(
+    invocation: &ToolInvocation,
+    text: &str,
+    success: bool,
+    value: Option<&serde_json::Value>,
+) -> Option<String> {
+    for contributor in invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+    {
+        let replacement = contributor
+            .replace_tool_output(ToolOutputInput {
+                session_store: &invocation.session.services.session_extension_data,
+                thread_store: &invocation.session.services.thread_extension_data,
+                turn_store: invocation.turn.extension_data.as_ref(),
+                turn_id: invocation.turn.sub_id.as_str(),
+                call_id: invocation.call_id.as_str(),
+                tool_name: &invocation.tool_name,
+                arguments: match &invocation.payload {
+                    codex_tools::ToolPayload::Function { arguments } => Some(arguments.as_str()),
+                    codex_tools::ToolPayload::Custom { input } => Some(input.as_str()),
+                    _ => None,
+                },
+                success,
+                text,
+                value,
+            })
+            .await;
+        if let Some(replacement) = replacement {
+            let original_bytes = replacement.original_bytes.max(text.len());
+            return (replacement.text.len()
+                <= codex_extension_api::tool_output_limit(original_bytes))
+            .then_some(replacement.text);
+        }
+    }
+    None
+}
