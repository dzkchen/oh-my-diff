+        &json!({"reason": "agents working", "max_duration_ms": 1000}),
+        UnixStream::pair().unwrap().0,
+    );
+    assert_eq!(
+        refused.err().unwrap().to_string(),
+        "authority_peer_unverified"
+    );
+}
