+                .builtin_controls()
+                .into_iter()
+                .flat_map(|(_, controls)| controls.modes.disable)
+                .collect(),
+            Err(_) => codex_omd::BuiltinSnapshot::read(&self.host.root, &self.host.repository)
+                .disabled_modes
+                .into_values()
+                .flatten()
+                .collect(),
+        }
