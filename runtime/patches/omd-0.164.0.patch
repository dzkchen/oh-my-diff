+            "greeting":"", "session_title_suffix":" | Project tools", "welcome":{"show_while_composing":true},
+            "sites":{"welcome":{"components":[{"type":"text","id":"mark","label":"Approved mark","text":"╭─╮ ╭╮╭╮ ┌─╮\n│ │ │╰╯│ │ │\n╰─╯ ╵  ╵ └─╯"}]}}
+        }))?,
+        ..Default::default()
+    };
+    crate::mod_ui::preview(snapshot.clone());
+    app.queue_clear_ui_header(&mut tui);
+    for draft in ["", "typing", "edited prompt", ""] {
+        app.chat_widget.apply_external_edit(draft.to_owned());
+        draw(&mut app, &mut tui, size)?;
+        let frame = text(crate::custom_terminal::test_support::last_rendered_buffer(
+            &tui.terminal,
+        ));
+        assert!(frame.contains("╭─╮ ╭╮╭╮ ┌─╮"), "{frame}");
+        assert!(frame.contains("Project tools"), "{frame}");
+    }
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Char('/'), KeyModifiers::NONE));
+    draw(&mut app, &mut tui, size)?;
+    let popup = text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(popup.contains("╭─╮ ╭╮╭╮ ┌─╮"), "{popup}");
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Backspace, KeyModifiers::NONE));
+    assert!(
+        !app.chat_widget
+            .empty_state_animation
+            .borrow_mut()
+            .handle_mouse(crossterm::event::MouseEvent {
+                kind: crossterm::event::MouseEventKind::Down(crossterm::event::MouseButton::Left),
+                column: 40,
+                row: 15,
+                modifiers: KeyModifiers::NONE,
+            },)
+    );
+    app.chat_widget.handle_paste("pasted prompt".to_owned());
