+fn thread_rewrite_response(rewrite: codex_thread_store::ThreadRewrite) -> ThreadRewriteResponse {
+    ThreadRewriteResponse {
+        revision: rewrite.revision,
+        previous_revision: rewrite.previous_revision,
+        rows: rewrite
+            .rows
+            .into_iter()
+            .map(|row| ThreadRewriteRow {
+                id: row.id,
+                turn_id: row.turn_id,
+                kind: row.kind,
+                access: match row.access {
+                    codex_thread_store::HistoryRowAccess::Edit => "edit",
+                    codex_thread_store::HistoryRowAccess::Delete => "delete",
+                    codex_thread_store::HistoryRowAccess::Frozen => "frozen",
+                }
+                .to_string(),
+            })
+            .collect(),
+    }
+}
+
+// A committed rewrite is reported even when the runtime reload fails; the client can resume the thread.
+fn rewrite_outcome(
+    thread_id: ThreadId,
+    rewrite: Result<codex_thread_store::ThreadRewrite, JSONRPCErrorError>,
+    reload_error: Option<JSONRPCErrorError>,
+) -> Result<ThreadRewriteResponse, JSONRPCErrorError> {
+    if let Some(err) = reload_error {
+        warn!(
+            "failed to reload thread {thread_id} after a rewrite: {}",
+            err.message
+        );
+    }
+    rewrite.map(thread_rewrite_response)
