index 0000000000000000000000000000000000000000..bca2734ebf316cf600c480f10110df04c8503a87
--- /dev/null
+++ b/codex-rs/tui/src/mod_render.rs
@@ -0,0 +1,675 @@
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::collections::VecDeque;
+use std::hash::Hash;
+use std::hash::Hasher;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU16;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use codex_omd::ModComponent;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+
+use crate::omd::LockExt;
+use crate::terminal_hyperlinks::HyperlinkLine;
+
+const DONE_LIMIT: usize = 2048;
+const PENDING_LIMIT: usize = 256;
+const RETRY: Duration = Duration::from_millis(250);
+
+pub(crate) struct RenderTarget {
+    pub(crate) component: &'static str,
+    pub(crate) id: String,
+    pub(crate) live: bool,
+    pub(crate) props: Value,
+}
+
+impl RenderTarget {
+    pub(crate) fn new(
+        component: &'static str,
+        id: impl Into<String>,
+        live: bool,
+        props: Value,
+    ) -> Self {
+        Self {
+            component,
+            id: id.into(),
+            live,
+            props,
+        }
+    }
+}
+
+/// A content digest: equal content draws identically, and it survives resume and reflow.
+pub(crate) fn content_id(kind: &str, text: &str) -> String {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    format!("{kind}-{:016x}", hasher.finish())
+}
+
+const PROP_BYTES: usize = codex_omd::MOD_TEXT_BYTES;
+
+/// Props carry at most `MOD_TEXT_BYTES` of text; hooks needing more read their own sources.
+pub(crate) fn bounded(text: &str) -> String {
+    text[..text.floor_char_boundary(PROP_BYTES)].to_owned()
+}
+
+pub(crate) fn bounded_json(value: &Value) -> Value {
+    let text = value.to_string();
+    if text.len() <= PROP_BYTES {
+        value.clone()
+    } else {
+        Value::String(bounded(&text))
+    }
+}
+
+pub(crate) fn assistant_props(text: &str, first: bool) -> Value {
+    serde_json::json!({"text": bounded(text), "first": first, "truncated": text.len() > PROP_BYTES})
+}
+
+pub(crate) fn question_props(
+    questions: &[codex_app_server_protocol::ToolRequestUserInputQuestion],
+) -> Value {
+    Value::Array(
+        questions
+            .iter()
+            .map(|question| {
+                json!({
+                    "id": question.id,
+                    "header": bounded(&question.header),
+                    "question": bounded(&question.question),
+                    "secret": question.is_secret,
+                    "options": question.options.iter().flatten().map(|option| bounded(&option.label)).collect::<Vec<_>>(),
+                })
+            })
+            .collect(),
+    )
+}
+
+#[derive(Clone, PartialEq)]
+pub(crate) struct Rendered {
+    /// `None` when the hooks passed the target's props on unchanged.
+    pub(crate) props: Option<Value>,
+    pub(crate) tree: Vec<ModComponent>,
+}
+
+impl Rendered {
+    fn props<'a>(&'a self, target: &'a RenderTarget) -> &'a Value {
+        self.props.as_ref().unwrap_or(&target.props)
+    }
+}
+
+fn digest(value: &Value, hasher: &mut impl Hasher) {
+    std::mem::discriminant(value).hash(hasher);
+    match value {
+        Value::String(text) => text.hash(hasher),
+        Value::Array(items) => {
+            items.len().hash(hasher);
+            items.iter().for_each(|item| digest(item, hasher));
+        }
+        Value::Object(map) => {
+            map.len().hash(hasher);
+            for (key, item) in map {
+                key.hash(hasher);
+                digest(item, hasher);
+            }
+        }
+        other => other.to_string().hash(hasher),
+    }
+}
+
+#[derive(Default)]
+struct Engine {
+    done: HashMap<u64, Option<Rendered>>,
+    latest: HashMap<(String, String), Option<Rendered>>,
+    pending: VecDeque<(u64, (String, String), Value, u64)>,
+    running: bool,
+    revision: Option<(u64, u64)>,
+    cleared: u64,
+}
+
+impl Engine {
+    fn remember(
+        &mut self,
+        key: u64,
+        instance: (String, String),
+        rendered: Option<Rendered>,
+        cleared: u64,
+    ) -> bool {
+        if self.done.len() >= DONE_LIMIT {
+            self.done.clear();
+        }
+        if self.latest.len() >= DONE_LIMIT {
+            self.latest.clear();
+        }
+        // A render started before the cache was cleared may reflect older state.
+        if self.cleared == cleared {
+            self.done.insert(key, rendered.clone());
+        }
+        self.latest.insert(instance, rendered.clone()).flatten() != rendered
+    }
+}
+
+static ENGINE: Mutex<Option<Engine>> = Mutex::new(None);
+static HOOKED: AtomicBool = AtomicBool::new(false);
+static FULLSCREEN: AtomicBool = AtomicBool::new(false);
+static COLUMNS: AtomicU16 = AtomicU16::new(0);
+static ROWS: AtomicU16 = AtomicU16::new(0);
+static EPOCH: AtomicU64 = AtomicU64::new(0);
+static LIVE_EPOCH: AtomicU64 = AtomicU64::new(0);
+static FRAMES: Mutex<Option<crate::tui::FrameRequester>> = Mutex::new(None);
+static TOOL_NOTICES: Mutex<VecDeque<ToolNotice>> = Mutex::new(VecDeque::new());
+static DRAWN_CALLS: Mutex<std::collections::BTreeSet<String>> =
+    Mutex::new(std::collections::BTreeSet::new());
+
+struct ToolNotice {
+    call_id: String,
+    kind: &'static str,
+    text: String,
+    owner: String,
+}
+
+pub(crate) fn clear_tool_notices() {
+    DRAWN_CALLS.locked().clear();
+    TOOL_NOTICES.locked().clear();
+    EPOCH.fetch_add(1, Ordering::Relaxed);
+}
+
+/// Attaches a mod notice beneath the drawn transcript cell of one tool call; false, storing nothing, when no drawn cell claims the call.
+pub(crate) fn tool_notice(call_id: &str, kind: &str, text: &str, owner: &str) -> bool {
+    if !DRAWN_CALLS.locked().contains(call_id) {
+        return false;
+    }
+    let mut notices = TOOL_NOTICES.locked();
+    if notices.len() >= 256 {
+        notices.pop_front();
+    }
+    notices.push_back(ToolNotice {
+        call_id: call_id.to_owned(),
+        kind: crate::history_cell::notice_kind(kind),
+        text: text.to_owned(),
+        owner: owner.to_owned(),
+    });
+    EPOCH.fetch_add(1, Ordering::Relaxed);
+    schedule_frame(Duration::ZERO);
+    true
+}
+
+pub(crate) fn tool_notice_lines(target: &RenderTarget) -> Vec<HyperlinkLine> {
+    let calls = target.props["calls"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|call| call["call_id"].as_str())
+        .chain([target.id.as_str()])
+        .chain(target.props["call_id"].as_str())
+        .collect::<Vec<_>>();
+    if target.component.starts_with("tool_") {
+        let mut drawn = DRAWN_CALLS.locked();
+        if drawn.len() >= DONE_LIMIT {
+            drawn.clear();
+        }
+        drawn.extend(calls.iter().map(|call| (*call).to_owned()));
+    }
+    let notices = TOOL_NOTICES.locked();
+    if notices.is_empty() {
+        return Vec::new();
+    }
+    notices
+        .iter()
+        .filter(|notice| calls.contains(&notice.call_id.as_str()))
+        .map(|notice| {
+            let mut spans = vec![crate::mod_ui::glyph("  ↳ ", "  -> ").dim()];
+            spans.extend(crate::history_cell::notice_spans(notice.kind, &notice.text));
+            spans.push(format!(" ({})", notice.owner).dark_gray());
+            HyperlinkLine {
+                line: Line::from(spans),
+                ..HyperlinkLine::default()
+            }
+        })
+        .collect()
+}
+
+thread_local! {
+    static WAITING: Cell<bool> = const { Cell::new(false) };
+}
+
+fn engine<T>(run: impl FnOnce(&mut Engine) -> T) -> T {
+    let mut engine = ENGINE.locked();
+    run(engine.get_or_insert_with(Engine::default))
+}
+
+pub(crate) fn set_frames(frames: crate::tui::FrameRequester) {
+    *FRAMES.locked() = Some(frames);
+}
+
+pub(crate) fn set_surface(fullscreen: bool, columns: u16, rows: u16) {
+    FULLSCREEN.store(fullscreen, Ordering::Relaxed);
+    COLUMNS.store(columns, Ordering::Relaxed);
+    ROWS.store(rows, Ordering::Relaxed);
+}
+
+/// Screen columns, for hooked components laid out before their final width is known.
+pub(crate) fn columns() -> u16 {
+    match COLUMNS.load(Ordering::Relaxed) {
+        0 => 80,
+        columns => columns,
+    }
+}
+
+pub(crate) fn enabled() -> bool {
+    HOOKED.load(Ordering::Relaxed)
+}
+
+/// Changes whenever a hook result changes what a retained layout drew.
+pub(crate) fn epoch() -> u64 {
+    EPOCH.load(Ordering::Relaxed)
+}
+
+/// Advances whenever a hook answer changes, so layouts cached for the live cell redraw.
+pub(crate) fn live_epoch() -> u64 {
+    LIVE_EPOCH.load(Ordering::Relaxed)
+}
+
+/// A new view revision may follow a state change, so finished renders are asked again; each instance's last tree stands until its answer arrives.
+pub(crate) fn refresh(revision: (u64, u64)) {
+    let changed = engine(|engine| {
+        let changed = engine.revision != Some(revision);
+        engine.revision = Some(revision);
+        changed
+    });
+    if !changed {
+        return;
+    }
+    crate::mod_module::refresh();
+    match crate::mod_runtime::render_hooked() {
+        Some(hooked) => {
+            forget();
+            HOOKED.store(hooked, Ordering::Relaxed);
+            LIVE_EPOCH.fetch_add(1, Ordering::Relaxed);
+        }
+        // A busy runtime leaves the flag and finished renders as they were and asks again next frame; forgetting them now would only queue renders needing the same busy runtime.
+        None => engine(|engine| engine.revision = None),
+    }
+}
+
+/// Ids of the components the latest hook trees draw, whose images and documents must outlive a view sync.
+pub(crate) fn component_ids() -> std::collections::BTreeSet<String> {
+    engine(|engine| {
+        engine
+            .latest
+            .values()
+            .flatten()
+            .flat_map(|rendered| codex_omd::component_ids_of(&rendered.tree))
+            .collect()
+    })
+}
+
+/// State a TUI-side callback wrote may change what hooks draw, so finished renders are asked again.
+pub(crate) fn forget() {
+    engine(|engine| {
+        engine.done.clear();
+        engine.cleared += 1;
+    });
+}
+
+/// Inline scrollback is written once, so renders inside this scope answer before returning.
+pub(crate) struct Wait(bool);
+
+impl Wait {
+    pub(crate) fn enter() -> Self {
+        Self(WAITING.with(|waiting| waiting.replace(true)))
+    }
+}
+
+impl Drop for Wait {
+    fn drop(&mut self) {
+        WAITING.with(|waiting| waiting.set(self.0));
+    }
+}
+
+fn input(target: &RenderTarget, width: u16) -> Value {
+    json!({
+        "component": target.component,
+        "id": target.id,
+        "surface": if FULLSCREEN.load(Ordering::Relaxed) { "fullscreen" } else { "inline" },
+        "viewport": {"columns": width, "rows": ROWS.load(Ordering::Relaxed)},
+        "lifecycle": if target.live { "live" } else { "final" },
+        "owner": Value::Null,
+        "props": target.props,
+    })
+}
+
+/// `None` while the runtime is busy, so nothing is remembered and the render is asked again.
+fn run(input: Value) -> Option<Option<Rendered>> {
+    let Some(chain) = crate::mod_runtime::render(input.clone())? else {
+        return Some(None);
+    };
+    let Ok(tree) = serde_json::from_value::<Vec<ModComponent>>(chain.result["tree"].clone()) else {
+        return Some(None);
+    };
+    let native = matches!(tree.as_slice(), [ModComponent::Native { style: None }]);
+    let rewritten = chain.input["props"] != input["props"];
+    Some((!native || rewritten).then(|| Rendered {
+        props: rewritten.then(|| chain.input["props"].clone()),
+        tree,
+    }))
+}
+
+pub(crate) fn schedule_frame(delay: Duration) {
+    if let Some(frames) = FRAMES.locked().as_ref() {
+        frames.schedule_frame_in(delay);
+    }
+}
+
+fn work() {
+    loop {
+        let Some((key, instance, input, cleared)) = engine(|engine| {
+            let job = engine.pending.pop_front();
+            engine.running = job.is_some();
+            job
+        }) else {
+            return;
+        };
+        let retained = input["lifecycle"] == "final";
+        let Some(rendered) = run(input) else {
+            schedule_frame(RETRY);
+            continue;
+        };
+        let changed = engine(|engine| engine.remember(key, instance, rendered, cleared));
+        if changed {
+            if retained {
+                EPOCH.fetch_add(1, Ordering::Relaxed);
+            }
+            LIVE_EPOCH.fetch_add(1, Ordering::Relaxed);
+            schedule_frame(Duration::ZERO);
+        }
+    }
+}
+
+/// The hook result for `target`, or `None` for the unchanged native drawing.
+pub(crate) fn resolve(target: &RenderTarget, width: u16) -> Option<Rendered> {
+    if !HOOKED.load(Ordering::Relaxed) {
+        return None;
+    }
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    (
+        target.component,
+        &target.id,
+        target.live,
+        FULLSCREEN.load(Ordering::Relaxed),
+        width,
+        ROWS.load(Ordering::Relaxed),
+    )
+        .hash(&mut hasher);
+    digest(&target.props, &mut hasher);
+    let key = hasher.finish();
+    if let Some(done) = engine(|engine| engine.done.get(&key).cloned()) {
+        return done;
+    }
+    let input = input(target, width);
+    let instance = (target.component.to_owned(), target.id.clone());
+    if WAITING.with(Cell::get) {
+        let cleared = engine(|engine| engine.cleared);
+        let Some(rendered) = run(input) else {
+            return engine(|engine| engine.latest.get(&instance).cloned().flatten());
+        };
+        engine(|engine| {
+            engine.remember(key, instance, rendered.clone(), cleared);
+        });
+        return rendered;
+    }
+    let (start, stale) = engine(|engine| {
+        engine
+            .pending
+            .retain(|(_, queued, _, _)| *queued != instance);
+        if engine.pending.len() >= PENDING_LIMIT {
+            engine.pending.pop_front();
+        }
+        let cleared = engine.cleared;
+        engine
+            .pending
+            .push_back((key, instance.clone(), input, cleared));
+        let start = !engine.running;
+        engine.running = true;
+        (start, engine.latest.get(&instance).cloned().flatten())
+    });
+    if start {
+        std::thread::spawn(work);
+    }
+    stale
+}
+
+fn styled(line: Line<'static>, style: Option<&codex_omd::ModStyle>) -> Line<'static> {
+    let Some(style) = style else {
+        return line;
+    };
+    let mut patch = crate::mod_ui::tone_style(style.tone.unwrap_or_default());
+    for (on, apply) in [
+        (style.bold, ratatui::style::Modifier::BOLD),
+        (style.italic, ratatui::style::Modifier::ITALIC),
+        (style.underline, ratatui::style::Modifier::UNDERLINED),
+    ] {
+        match on {
+            Some(true) => patch = patch.add_modifier(apply),
+            Some(false) => patch = patch.remove_modifier(apply),
+            None => {}
+        }
+    }
+    if let Some(fg) = style.fg {
+        patch = patch.fg(crate::mod_ui::color(fg));
+    }
+    if let Some(bg) = style.bg {
+        patch = patch.bg(crate::mod_ui::color(bg));
+    }
+    line.patch_style(patch)
+}
+
+fn compose(
+    tree: &[ModComponent],
+    width: u16,
+    indent: usize,
+    selected: Option<&str>,
+    native: &mut Option<Vec<HyperlinkLine>>,
+    at: &mut Option<usize>,
+    lines: &mut Vec<HyperlinkLine>,
+) {
+    let prefix = " ".repeat(indent);
+    let inset = width
+        .saturating_sub(u16::try_from(indent).unwrap_or(u16::MAX))
+        .max(1);
+    for component in tree {
+        match component {
+            ModComponent::Native { style } => {
+                at.get_or_insert(lines.len());
+                lines.extend(native.take().into_iter().flatten().map(|mut native| {
+                    native.line = styled(native.line, style.as_ref());
+                    if indent > 0 {
+                        native.line.spans.insert(0, Span::raw(prefix.clone()));
+                    }
+                    native
+                }));
+            }
+            ModComponent::Box { .. } if !component.fits(width) => {}
+            ModComponent::Box {
+                title, children, ..
+            } => {
+                if let Some(title) = title {
+                    lines.push(HyperlinkLine::new(
+                        Line::from(format!("{prefix}{title}")).bold(),
+                    ));
+                }
+                compose(children, width, indent + 1, selected, native, at, lines);
+            }
+            component => lines.extend(
+                crate::mod_ui::component_lines(std::slice::from_ref(component), inset, selected)
+                    .into_iter()
+                    .map(|mut line| {
+                        if indent > 0 {
+                            line.spans.insert(0, Span::raw(prefix.clone()));
+                        }
+                        HyperlinkLine::new(line)
+                    }),
+            ),
+        }
+    }
+}
+
+/// `native` draws the host component from effective props; the flag reports whether a hook replaced the unchanged native drawing.
+pub(crate) fn hyperlink_lines(
+    target: &RenderTarget,
+    width: u16,
+    native: impl FnOnce(&Value, u16) -> Vec<HyperlinkLine>,
+) -> (Vec<HyperlinkLine>, bool) {
+    let Some(rendered) = resolve(target, width) else {
+        return (native(&target.props, width), false);
+    };
+    let inner = native_width(&rendered.tree, width);
+    let native = if native_indent(&rendered.tree).is_some() {
+        native(rendered.props(target), inner)
+    } else {
+        Vec::new()
+    };
+    (compose_lines(&rendered.tree, width, None, native), true)
+}
+
+pub(crate) fn compose_lines(
+    tree: &[ModComponent],
+    width: u16,
+    selected: Option<&str>,
+    native: Vec<HyperlinkLine>,
+) -> Vec<HyperlinkLine> {
+    let mut native = Some(native);
+    let mut lines = Vec::new();
+    compose(tree, width, 0, selected, &mut native, &mut None, &mut lines);
+    lines
+}
+
+pub(crate) fn widget_lines(
+    width: u16,
+    height: u16,
+    draw: impl FnOnce(ratatui::layout::Rect, &mut ratatui::buffer::Buffer),
+) -> Vec<HyperlinkLine> {
+    let area = ratatui::layout::Rect::new(0, 0, width, height);
+    let mut cells = ratatui::buffer::Buffer::empty(area);
+    draw(area, &mut cells);
+    (0..height)
+        .map(|row| {
+            let mut spans: Vec<Span<'static>> = Vec::new();
+            let mut covered = 0;
+            for column in 0..width {
+                let cell = &cells[(column, row)];
+                if covered > 0 {
+                    covered -= 1;
+                    continue;
+                }
+                covered = unicode_width::UnicodeWidthStr::width(cell.symbol()).saturating_sub(1);
+                let style = cell.style();
+                match spans.last_mut() {
+                    Some(span) if span.style == style => {
+                        span.content.to_mut().push_str(cell.symbol());
+                    }
+                    _ => spans.push(Span::styled(cell.symbol().to_owned(), style)),
+                }
+            }
+            HyperlinkLine::new(Line::from(spans))
+        })
+        .collect()
+}
+
+/// Where the widget's own drawing landed (rows down, columns in) unless a hook hid it.
+pub(crate) struct WidgetHook {
+    pub(crate) lines: Vec<Line<'static>>,
+    pub(crate) native: Option<ratatui::layout::Rect>,
+}
+
+impl WidgetHook {
+    /// `None` leaves the widget to draw itself unchanged.
+    pub(crate) fn resolve(
+        target: &RenderTarget,
+        width: u16,
+        height: impl Fn(&Value, u16) -> u16,
+        draw: impl Fn(&Value, ratatui::layout::Rect, &mut ratatui::buffer::Buffer),
+    ) -> Option<Self> {
+        let rendered = resolve(target, width)?;
+        let inner = native_width(&rendered.tree, width);
+        let rows = height(rendered.props(target), inner);
+        let native = widget_lines(inner, rows, |area, cells| {
+            draw(rendered.props(target), area, cells)
+        });
+        let (mut slot, mut at, mut lines) = (Some(native), None, Vec::new());
+        compose(
+            &rendered.tree,
+            width,
+            0,
+            None,
+            &mut slot,
+            &mut at,
+            &mut lines,
+        );
+        let native = at.map(|row| {
+            let column = native_indent(&rendered.tree).unwrap_or_default();
+            ratatui::layout::Rect::new(
+                u16::try_from(column).unwrap_or(u16::MAX),
+                u16::try_from(row).unwrap_or(u16::MAX),
+                inner,
+                rows,
+            )
+        });
+        Some(Self {
+            lines: lines.into_iter().map(|line| line.line).collect(),
+            native,
+        })
+    }
+
+    pub(crate) fn height(&self) -> u16 {
+        u16::try_from(self.lines.len()).unwrap_or(u16::MAX)
+    }
+
+    pub(crate) fn render(&self, area: ratatui::layout::Rect, cells: &mut ratatui::buffer::Buffer) {
+        ratatui::widgets::Widget::render(
+            ratatui::widgets::Paragraph::new(self.lines.clone()),
+            area,
+            cells,
+        );
+    }
+}
+
+pub(crate) fn native_width(tree: &[ModComponent], width: u16) -> u16 {
+    width
+        .saturating_sub(u16::try_from(native_indent(tree).unwrap_or_default()).unwrap_or(u16::MAX))
+        .max(1)
+}
+
+fn native_indent(tree: &[ModComponent]) -> Option<usize> {
+    tree.iter().find_map(|component| match component {
+        ModComponent::Native { .. } => Some(0),
+        ModComponent::Box { children, .. } => native_indent(children).map(|indent| indent + 1),
+        _ => None,
+    })
+}
+
+pub(crate) fn lines(
+    target: &RenderTarget,
+    width: u16,
+    native: impl FnOnce(&Value, u16) -> Vec<Line<'static>>,
+) -> Vec<Line<'static>> {
+    hyperlink_lines(target, width, |props, width| {
+        crate::terminal_hyperlinks::plain_hyperlink_lines(native(props, width))
+    })
+    .0
+    .into_iter()
+    .map(|line| line.line)
+    .collect()
+}
