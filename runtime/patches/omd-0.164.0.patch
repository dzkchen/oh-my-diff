+#[tokio::test]
+async fn attached_clients_stream_views_rosters_and_guard_actions() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    create_config_toml(codex_home.path(), &server.uri(), "never")?;
+    let store_dir = TempDir::new()?;
+    let store = store_dir.path().canonicalize()?;
+    std::fs::write(
+        store.join("mods.json"),
+        json!({"schema": 1, "node": "/usr/bin/true", "mods": []}).to_string(),
+    )?;
+    let (mut process, bind_addr) = spawn_websocket_server_with_env(
+        codex_home.path(),
+        "ws://127.0.0.1:0",
+        &[],
+        &[
+            ("OMD_MODE", OsStr::new("omd")),
+            ("OMD_MOD_STORE", store.as_os_str()),
+        ],
+    )
+    .await?;
+
+    let result = async {
+        let mut desk = connect_websocket(bind_addr).await?;
+        initialize(&mut desk).await?;
+        let attached = attach(&mut desk, "desk").await?;
+        assert_eq!(
+            (attached.protocol.as_str(), attached.roster.len()),
+            ("omd-client/1", 1)
+        );
+        let pushed: OmdViewUpdatedNotification = serde_json::from_value(
+            read_notification_for_method(&mut desk, "omd/view/updated")
+                .await?
+                .params
+                .context("view params")?,
+        )?;
+        assert_eq!((pushed.epoch.as_str(), pushed.snapshot), ("", Value::Null));
+        assert_eq!(pushed.action_token.len(), 32);
+
+        let mut phone = connect_websocket(bind_addr).await?;
+        initialize(&mut phone).await?;
+        attach(&mut phone, "phone").await?;
+        let roster: OmdRosterUpdatedNotification = serde_json::from_value(
+            read_notification_for_method(&mut desk, "omd/roster/updated")
+                .await?
+                .params
+                .context("roster params")?,
+        )?;
+        assert_eq!(
+            roster
+                .roster
+                .iter()
+                .map(|entry| entry.name.as_str())
+                .collect::<Vec<_>>(),
+            vec!["desk", "phone"]
+        );
+
+        send_request(
+            &mut desk,
+            "thread/start",
+            3,
+            Some(json!({"model": "mock-model"})),
+        )
+        .await?;
+        read_response_for_id(&mut desk, 3).await?;
+        let view = settled_view(&mut desk, 10).await?;
+        assert_ne!(view.epoch, "");
+        let stale = error_message(
+            &mut desk,
+            30,
+            "omd/client/event",
+            json!({"epoch": view.epoch, "component": "gone",
+                "event": {"kind": "change", "value": "x"}}),
+        )
+        .await?;
+        assert_eq!(stale, "view_stale: gone");
+
+        let token = view.action_token;
+        error_message(
+            &mut desk,
+            31,
+            "omd/action",
+            json!({"actionToken": token, "component": "gone"}),
+        )
+        .await?;
+        for (id, token, code) in [
+            (32, token.as_str(), "action_replayed"),
+            (33, "feedface", "action_unknown"),
+        ] {
+            let refused = error_message(
+                &mut desk,
+                id,
+                "omd/action",
+                json!({"actionToken": token, "component": "gone"}),
+            )
+            .await?;
+            assert!(refused.starts_with(code), "{refused}");
+        }
+        let foreign = error_message(
+            &mut phone,
+            30,
+            "omd/action",
+            json!({"actionToken": token, "component": "gone"}),
+        )
+        .await?;
+        assert!(foreign.starts_with("action_unknown"), "{foreign}");
+        Ok(())
+    }
+    .await;
+
+    process
+        .kill()
+        .await
+        .context("failed to stop websocket app-server process")?;
+    result
+}
