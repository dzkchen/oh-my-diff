+            .unwrap()
+            .packages[0]
+            .version,
+        "2.0.0",
+        "no selector follows the latest tag"
+    );
+
+    routes.lock().unwrap().clear();
+    let mut offline = npm_request(&origin, "1.1.0", &["commands"]);
+    offline.offline = true;
+    assert_eq!(
+        store.package_plan(offline).unwrap().packages[0].integrity,
