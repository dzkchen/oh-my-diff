+        Err("tool_arguments_invalid: loose: /cmd: required".into())
+    );
+    assert_eq!(validate("patch", json!("anything"), true), Ok(()));
+    assert_eq!(validate("unknown", json!(1), true), Ok(()));
+    ModStore::open(fixture.lead.host.root.clone())
