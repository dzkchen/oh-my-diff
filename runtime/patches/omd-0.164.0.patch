+    let grants = BTreeMap::from([(
+        "monitor".to_owned(),
+        core.runtime.lock().unwrap().grants("monitor").unwrap(),
+    )]);
+    let pick = |grants: &BTreeMap<String, codex_omd::ModGrants>| {
+        let mut notices = Vec::new();
+        let entry = core
+            .autonomy
+            .with(&thread, |queue| {
+                queue
+                    .pick(grants, codex_omd::peers::now_ms(), &mut notices)
