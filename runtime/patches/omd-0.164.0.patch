+fn effective_region(interaction: &Interaction) -> Option<String> {
+    interaction
+        .focused
+        .as_ref()
+        .and_then(|id| interaction.component_region.get(id))
+        .cloned()
+        .or_else(|| interaction.focus_region.clone())
+}
+
+fn follow_region(interaction: &mut Interaction) {
+    if interaction.focus_region.is_some()
+        && let Some(region) = interaction
+            .focused
+            .as_ref()
+            .and_then(|id| interaction.component_region.get(id))
+            .filter(|region| {
+                interaction
+                    .focus_areas
+                    .iter()
+                    .any(|(name, _)| name == *region)
+            })
+    {
+        interaction.focus_region = Some(region.clone());
+    }
+}
+
+fn region_entry(interaction: &Interaction, region: &str, id: &str) -> bool {
+    interaction.component_region.get(id).map(String::as_str) == Some(region)
+        && interaction.order.iter().any(|ordered| ordered == id)
+        && !interaction.key_panes.contains(id)
+        && !matches!(
+            interaction.targets.get(id),
+            Some(ComponentTarget::Terminal(_, _)) | None
+        )
+}
+
+fn enter_region(interaction: &mut Interaction, name: &str) {
+    if let Some(focused) = interaction.focused.take()
+        && let Some(region) = interaction.component_region.get(&focused).cloned()
+        && region_entry(interaction, &region, &focused)
+    {
+        interaction.region_focus.insert(region, focused);
+    }
+    if let Some(region) = interaction.focus_region.take() {
+        interaction.last_region = Some(region);
+    }
+    if name == "chat" {
+        return;
+    }
+    interaction.focus_region = Some(name.to_owned());
+    interaction.focused = region_control(interaction, name);
+}
+
+fn region_control(interaction: &Interaction, name: &str) -> Option<String> {
+    interaction
+        .region_focus
+        .get(name)
+        .filter(|id| region_entry(interaction, name, id))
+        .cloned()
+        .or_else(|| {
+            interaction
+                .order
+                .iter()
+                .find(|id| region_entry(interaction, name, id))
+                .cloned()
+        })
+}
+
+/// Orders candidates on that side of `from`: overlapping across the move first, then nearest, then best aligned.
+fn toward(from: Rect, to: Rect, direction: &str) -> Option<(bool, i32, i32)> {
+    let (from_x, from_y) = (i32::from(from.x), i32::from(from.y));
+    let (from_right, from_bottom) = (i32::from(from.right()), i32::from(from.bottom()));
+    let (to_x, to_y) = (i32::from(to.x), i32::from(to.y));
+    let (to_right, to_bottom) = (i32::from(to.right()), i32::from(to.bottom()));
+    let rows = to_y < from_bottom && from_y < to_bottom;
+    let columns = to_x < from_right && from_x < to_right;
+    let across_rows = ((to_y + to_bottom) - (from_y + from_bottom)).abs();
+    let across_columns = ((to_x + to_right) - (from_x + from_right)).abs();
+    let (gap, overlap, offset) = match direction {
+        "left" => (from_x - to_right, rows, across_rows),
+        "right" => (to_x - from_right, rows, across_rows),
+        "up" => (from_y - to_bottom, columns, across_columns),
+        _ => (to_y - from_bottom, columns, across_columns),
+    };
+    (gap >= 0).then_some((!overlap, gap, offset))
+}
+
+fn region_target(interaction: &Interaction, target: &ModRegion) -> Option<String> {
+    let areas = &interaction.focus_areas;
+    let current = effective_region(interaction).unwrap_or_else(|| "chat".to_owned());
+    let position = areas.iter().position(|(name, _)| *name == current);
+    match target {
+        ModRegion::Index(0) => Some("chat".to_owned()),
+        ModRegion::Index(index) => areas
+            .iter()
+            .filter(|(name, _)| name != "chat")
+            .nth(usize::from(*index) - 1)
+            .map(|(name, _)| name.clone()),
+        ModRegion::Name(name) => match name.as_str() {
+            "next" | "previous" if !areas.is_empty() => {
+                let count = areas.len();
+                let index = match (position, name.as_str()) {
+                    (Some(at), "next") => (at + 1) % count,
+                    (Some(at), _) => (at + count - 1) % count,
+                    (None, _) => 0,
+                };
+                Some(areas[index].0.clone())
+            }
+            "chat" => Some("chat".to_owned()),
+            "left" | "right" | "up" | "down" => {
+                let from = areas.get(position?)?.1;
+                areas
+                    .iter()
+                    .filter(|(candidate, _)| *candidate != current)
+                    .filter_map(|(candidate, area)| {
+                        toward(from, *area, name).map(|score| (score, candidate))
+                    })
+                    .min_by_key(|(score, _)| *score)
+                    .map(|(_, candidate)| candidate.clone())
+            }
+            name => areas
+                .iter()
+                .any(|(candidate, _)| candidate == name)
+                .then(|| name.to_owned()),
+        },
+    }
+}
+
+pub(crate) fn region(target: &ModRegion) -> bool {
+    observed(|| {
+        let mut interaction = INTERACTION.locked();
+        let Some(found) = region_target(&interaction, target) else {
+            return false;
+        };
+        enter_region(&mut interaction, &found);
+        true
+    })
+}
+
+fn site_owner(site: &str) -> Option<&str> {
+    site.split_once('/').map(|(owner, _)| owner)
+}
+
+fn context_holds(context: &ModKeyContext, region: Option<&str>, composer_empty: bool) -> bool {
+    context
+        .when
+        .composer
+        .is_none_or(|state| (state == codex_omd::ModComposerWhen::Empty) == composer_empty)
+        && (context.when.focus.is_empty()
+            || context
+                .when
+                .focus
+                .iter()
+                .any(|focus| match (focus.as_str(), region) {
+                    ("chat", None) | ("site", Some(_)) => true,
+                    (name, Some(region)) => name == region,
+                    _ => false,
+                }))
+}
+
+fn context_key_matches(binding: &str, key: KeyEvent) -> bool {
+    match key.code {
+        KeyCode::Char(character)
+            if character != ' '
+                && !key
+                    .modifiers
+                    .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT) =>
+        {
+            binding.chars().eq([character])
+        }
+        _ => key_name(key).as_deref() == Some(binding),
+    }
+}
+
+fn ordered_contexts<'a>(view: &'a ModView, region: Option<&str>) -> Vec<&'a ModKeyContext> {
+    let owner = region.and_then(site_owner);
+    let (mut first, rest): (Vec<_>, Vec<_>) = view
+        .key_contexts
+        .iter()
+        .partition(|context| owner.is_some_and(|owner| context.owner == owner));
+    first.extend(rest);
+    first
+}
+
+fn context_binding(
+    key: KeyEvent,
+    region: Option<&str>,
+    composer_empty: bool,
+    owner_only: bool,
+) -> Option<(String, ModKeyAction)> {
+    with_cache(|cache| {
+        let view = &cache.snapshot.view;
+        ordered_contexts(view, region)
+            .into_iter()
+            .filter(|context| {
+                !owner_only
+                    || region.is_some_and(|region| {
+                        site_owner(region) == Some(context.owner.as_str())
+                            && context.when.focus.iter().any(|focus| focus == region)
+                    })
+            })
+            .filter(|context| context_holds(context, region, composer_empty))
+            .find_map(|context| {
+                context
+                    .keys
+                    .iter()
+                    .find(|(binding, _)| context_key_matches(binding, key))
+                    .map(|(binding, bound)| (binding.clone(), bound.action.clone()))
+            })
+    })
+    .flatten()
+}
+
+fn run_context(
+    interaction: &mut Interaction,
+    name: String,
+    action: ModKeyAction,
+    composer_empty: bool,
+) -> ModInput {
+    match action {
+        ModKeyAction::Region { region } => {
+            if let Some(found) = region_target(interaction, &region) {
+                enter_region(interaction, &found);
+            }
+            ModInput::Consumed
+        }
+        ModKeyAction::Help { .. } => {
+            open_help_locked(interaction, composer_empty);
+            ModInput::Consumed
+        }
+        action => ModInput::Interaction(name, action),
+    }
+}
+
+pub(crate) fn open_help(composer_empty: bool) {
+    observed(|| open_help_locked(&mut INTERACTION.locked(), composer_empty));
+}
+
+fn open_help_locked(interaction: &mut Interaction, composer_empty: bool) {
+    interaction.help = Some(Help {
+        region: effective_region(interaction),
+        composer_empty,
+        query: None,
+        selected: 0,
+    });
+}
+
+struct HelpRow {
+    key: String,
+    label: String,
+    owner: String,
+    action: Option<ModKeyAction>,
+}
+
+fn describe(action: &ModKeyAction) -> String {
+    match action {
+        ModKeyAction::Draft(_) | ModKeyAction::Insert { .. } => "Insert text".into(),
+        ModKeyAction::Submit { .. } => "Send text".into(),
+        ModKeyAction::Command { command, args } => format!(
+            "/{} {args}",
+            command
+                .rsplit_once(':')
+                .map_or(command.as_str(), |(_, name)| name)
+        )
+        .trim_end()
+        .to_owned(),
+        ModKeyAction::Focus { focus } => format!("Focus {focus}"),
+        ModKeyAction::Copy { label, .. } => format!("Copy {label}"),
+        ModKeyAction::Region {
+            region: ModRegion::Index(index),
+        } => format!("Focus panel {index}"),
+        ModKeyAction::Region {
+            region: ModRegion::Name(name),
+        } => format!("Focus {name}"),
+        ModKeyAction::Help { .. } => "Keys for this panel".into(),
+    }
+}
+
+fn help_rows(view: &ModView, help: &Help) -> Vec<HelpRow> {
+    let region = help.region.as_deref();
+    let mut seen = BTreeSet::new();
+    let mut rows = Vec::new();
+    for context in ordered_contexts(view, region) {
+        if !context_holds(context, region, help.composer_empty) {
+            continue;
+        }
+        for (key, binding) in &context.keys {
+            if seen.insert(key.clone()) {
+                rows.push(HelpRow {
+                    key: key.clone(),
+                    label: binding
+                        .label
+                        .clone()
+                        .unwrap_or_else(|| describe(&binding.action)),
+                    owner: context.owner.clone(),
+                    action: Some(binding.action.clone()),
+                });
+            }
+        }
+    }
+    for (key, action) in &view.keybindings {
+        if seen.insert(key.clone()) {
+            rows.push(HelpRow {
+                key: key.clone(),
+                label: describe(action),
+                owner: String::new(),
+                action: Some(action.clone()),
+            });
+        }
+    }
+    rows.push(HelpRow {
+        key: "Ctrl+]".into(),
+        label: "Switch between the chat and the last panel".into(),
+        owner: String::new(),
+        action: None,
+    });
+    if region.is_some() {
+        rows.push(HelpRow {
+            key: "Esc".into(),
+            label: "Back to the chat".into(),
+            owner: String::new(),
+            action: None,
+        });
+    }
+    let query = help.query.as_deref().unwrap_or_default().to_lowercase();
+    rows.retain(|row| {
+        query.is_empty()
+            || [&row.key, &row.label, &row.owner]
+                .iter()
+                .any(|text| text.to_lowercase().contains(&query))
+    });
+    rows
+}
+
+pub(crate) fn close_help() {
+    INTERACTION.locked().help = None;
+}
+
+fn help_input(interaction: &mut Interaction, key: KeyEvent) -> ModInput {
+    let Some(mut help) = interaction.help.take() else {
+        return ModInput::Consumed;
+    };
+    let rows = with_cache(|cache| help_rows(&cache.snapshot.view, &help).len()).unwrap_or(0);
+    let plain = !key
+        .modifiers
+        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT);
+    let searching = help.query.is_some();
+    match key.code {
+        KeyCode::Esc if searching => help.query = None,
+        KeyCode::Esc => return ModInput::Consumed,
+        KeyCode::Char('?' | 'q') if plain && !searching => return ModInput::Consumed,
+        KeyCode::Char('/') if plain && !searching => help.query = Some(String::new()),
+        KeyCode::Up => help.selected = help.selected.saturating_sub(1),
+        KeyCode::Char('k') if plain && !searching => {
+            help.selected = help.selected.saturating_sub(1)
+        }
+        KeyCode::Down => help.selected = (help.selected + 1).min(rows.saturating_sub(1)),
+        KeyCode::Char('j') if plain && !searching => {
+            help.selected = (help.selected + 1).min(rows.saturating_sub(1));
+        }
+        KeyCode::Backspace if searching => {
+            help.query.as_mut().map(String::pop);
+            help.selected = 0;
+        }
+        KeyCode::Char(character) if plain && searching => {
+            help.query.get_or_insert_default().push(character);
+            help.selected = 0;
+        }
+        KeyCode::Enter => {
+            let chosen = with_cache(|cache| {
+                help_rows(&cache.snapshot.view, &help)
+                    .into_iter()
+                    .nth(help.selected)
+                    .and_then(|row| Some((row.key, row.action?)))
+            })
+            .flatten();
+            return match chosen {
+                Some((name, action)) => run_context(interaction, name, action, help.composer_empty),
+                None => ModInput::Consumed,
+            };
+        }
+        _ => {}
+    }
+    interaction.help = Some(help);
+    ModInput::Consumed
+}
+
+pub(crate) fn render_help(screen: Rect, snapshot: &ModViewSnapshot, buffer: &mut Buffer) {
+    let mut interaction = INTERACTION.locked();
+    let Some(help) = interaction.help.as_mut() else {
+        return;
+    };
+    let rows = help_rows(&snapshot.view, help);
+    let own = help
+        .region
+        .as_deref()
+        .and_then(site_owner)
+        .unwrap_or_default()
+        .to_owned();
+    help.selected = help.selected.min(rows.len().saturating_sub(1));
+    let width = screen.width.saturating_sub(4).min(72);
+    let body = u16::try_from(rows.len()).unwrap_or(u16::MAX).max(1);
+    let height = (body + 3 + u16::from(help.query.is_some())).min(screen.height.saturating_sub(2));
+    if width < 24 || height < 4 {
+        return;
+    }
+    let area = Rect::new(
+        screen.x + (screen.width - width) / 2,
+        screen.y + (screen.height - height) / 2,
+        width,
+        height,
+    );
+    Clear.render(area, buffer);
+    let title = format!(" Keys: {} ", help.region.as_deref().unwrap_or("chat"));
+    let block = Block::default()
+        .borders(Borders::ALL)
+        .border_style(crate::style::accent_style())
+        .title(Line::from(title).bold());
+    let inner = block.inner(area);
+    block.render(area, buffer);
+    let mut lines = Vec::new();
+    if let Some(query) = &help.query {
+        lines.push(Line::from(vec![
+            "/".bold(),
+            query.clone().into(),
+            "▏".dim(),
+        ]));
+    }
+    let visible = usize::from(
+        inner
+            .height
+            .saturating_sub(u16::from(help.query.is_some()) + 1),
+    );
+    let start = (help.selected + 1).saturating_sub(visible.max(1));
+    let key_width = rows
+        .iter()
+        .map(|row| row.key.len())
+        .max()
+        .unwrap_or(0)
+        .min(16);
+    for (index, row) in rows.iter().enumerate().skip(start).take(visible) {
+        let mut spans = vec![
+            format!(" {:<key_width$}  ", row.key).bold(),
+            row.label.clone().into(),
+        ];
+        if !row.owner.is_empty() && row.owner != own {
+            spans.push(format!("  {}", row.owner).dim());
+        }
+        let line = Line::from(spans);
+        lines.push(if index == help.selected {
+            line.reversed()
+        } else {
+            line
+        });
+    }
+    if rows.is_empty() {
+        lines.push(Line::from(" No matching keys".dim()));
+    }
+    while lines.len() + 1 < usize::from(inner.height) {
+        lines.push(Line::default());
+    }
+    lines.push(Line::from(
+        " / search · ↑↓ select · Enter run · Esc close".dim(),
+    ));
+    Paragraph::new(lines).render(inner, buffer);
+}
+
+pub(crate) fn focus(id: &str) -> bool {
+    observed(|| focus_unobserved(id))
+}
+
+fn focus_unobserved(id: &str) -> bool {
+    let mut interaction = INTERACTION.locked();
+    if !interaction.ids.contains(id) {
+        return false;
+    }
+    interaction.focused = Some(id.to_owned());
+    follow_region(&mut interaction);
+    true
+}
+
+pub(crate) fn captures_keys() -> bool {
+    let interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction.focused.is_some()
+        || interaction.focus_region.is_some()
+        || interaction.help.is_some()
+        || interaction
+            .dialog
+            .as_ref()
+            .is_some_and(|dialog| interaction.dismissed.as_ref() != Some(dialog))
+}
+
+pub(crate) fn input(key: KeyEvent, composer_empty: bool) -> Option<ModInput> {
+    observed(|| {
+        let input = handle_input(key, composer_empty);
+        follow_region(&mut INTERACTION.locked());
+        input
+    })
+}
+
+fn handle_input(key: KeyEvent, composer_empty: bool) -> Option<ModInput> {
+    let mut interaction = INTERACTION.locked();
+    // Held keys repeat only inside a dialog or a focused control, and never fire hotkeys or bindings.
+    let repeated = repeats(key) && (interaction.focused.is_some() || modal(&interaction, key));
+    let key = if repeated {
+        KeyEvent {
+            kind: KeyEventKind::Press,
+            ..key
+        }
+    } else {
+        key
+    };
+    if key.kind != KeyEventKind::Press {
+        return (modal(&interaction, key)
+            || interaction.help.is_some()
+            || interaction.focus_region.is_some())
+        .then_some(ModInput::Consumed);
+    }
+    if interaction.help.is_some() {
+        return Some(help_input(&mut interaction, key));
+    }
+    let escape = (key.code, key.modifiers) == (KeyCode::Esc, KeyModifiers::NONE);
+    let in_terminal = interaction.focused.as_ref().is_some_and(|focused| {
+        matches!(
+            interaction.targets.get(focused),
+            Some(ComponentTarget::Terminal(_, _))
+        )
+    });
+    let all_keys = interaction
+        .focused
+        .as_ref()
+        .is_some_and(|focused| interaction.all_keys.contains(focused));
+    if (escape && !in_terminal && !all_keys)
+        || crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key)
+    {
+        let dialog = interaction
+            .dialog
+            .clone()
+            .filter(|dialog| interaction.dismissed.as_ref() != Some(dialog));
+        if dialog.is_some() || interaction.focused.is_some() {
+            if let Some(focused) = interaction.focused.clone()
+                && escape
+            {
+                crate::mod_surface::input_event(
+                    interaction.thread.as_deref(),
+                    interaction
+                        .component_owners
+                        .get(&focused)
+                        .map(String::as_str),
+                    &focused,
+                    serde_json::json!({"key": "Esc", "text": null}),
+                );
+            }
+            let typing = interaction.focused.as_ref().is_some_and(|focused| {
+                interaction.key_panes.contains(focused)
+                    || matches!(
+                        interaction.targets.get(focused),
+                        Some(ComponentTarget::Terminal(_, _))
+                    )
+            });
+            match interaction.focus_region.clone() {
+                Some(region) if dialog.is_some() || typing && !escape => {
+                    enter_region(&mut interaction, &region);
+                    interaction.focused = None;
+                }
+                _ if dialog.is_none() => enter_region(&mut interaction, "chat"),
+                _ => interaction.focused = None,
+            }
+            interaction.dismissed = dialog.or(interaction.dismissed.take());
+            return Some(ModInput::Consumed);
+        }
+        if interaction.focus_region.is_some() {
+            enter_region(&mut interaction, "chat");
+            return Some(ModInput::Consumed);
+        }
+        if !escape
+            && interaction.region_keys
+            && let Some(region) = interaction
+                .last_region
+                .clone()
+                .filter(|last| interaction.focus_areas.iter().any(|(name, _)| name == last))
+                .or_else(|| {
+                    interaction
+                        .focus_areas
+                        .iter()
+                        .find(|(name, _)| name != "chat")
+                        .map(|(name, _)| name.clone())
+                })
+        {
+            enter_region(&mut interaction, &region);
+            return Some(ModInput::Consumed);
+        }
+    }
+    if matches!(
+        (key.code, key.modifiers),
+        (
+            KeyCode::Up | KeyCode::Down | KeyCode::Tab,
+            KeyModifiers::NONE
+        ) | (KeyCode::BackTab, KeyModifiers::SHIFT)
+    ) && modal(&interaction, key)
+        && interaction.focused.is_none()
+        && interaction.focus_region.is_none()
+        && !interaction.order.is_empty()
+    {
+        interaction.focused = if matches!(key.code, KeyCode::BackTab | KeyCode::Up) {
+            interaction.order.last().cloned()
+        } else {
+            interaction.order.first().cloned()
+        };
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(ComponentTarget::Terminal(session, binding)) = interaction.targets.get(&focused)
+    {
+        if crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key) {
+            interaction.focused = None;
+        } else {
+            crate::mod_pty::key(binding.as_ref(), session, key);
+        }
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && interaction.key_panes.contains(&focused)
+    {
+        if !all_keys && (key.code, key.modifiers) == (KeyCode::Char('c'), KeyModifiers::CONTROL) {
+            interaction.focused = None;
+            return None;
+        }
+        let region = interaction.component_region.get(&focused).cloned();
+        if let Some((name, action)) = context_binding(key, region.as_deref(), composer_empty, true)
+        {
+            return Some(run_context(&mut interaction, name, action, composer_empty));
+        }
+        if crate::key_hint::ctrl(KeyCode::Char(']')).is_press(key) {
+            interaction.focused = None;
+        } else {
+            let text = match key.code {
+                KeyCode::Char(character)
+                    if !key
+                        .modifiers
+                        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT) =>
+                {
+                    Some(character.to_string())
+                }
+                _ => None,
+            };
+            let name = key_name(key);
+            if name.is_some() || text.is_some() {
+                crate::mod_surface::input_event(
+                    interaction.thread.as_deref(),
+                    interaction
+                        .component_owners
+                        .get(&focused)
+                        .map(String::as_str),
+                    &focused,
+                    serde_json::json!({"key": name, "text": text}),
+                );
+            }
+        }
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(ComponentTarget::Document(_)) = interaction.targets.get(&focused)
+        && !matches!(key.code, KeyCode::Tab | KeyCode::BackTab | KeyCode::Enter)
+        && let Some(document_key) = crate::mod_components::key(key.code, key.modifiers)
+        && !crate::mod_components::at_edge(&focused, document_key)
+    {
+        crate::mod_components::handle(&focused, document_key);
+        return Some(ModInput::Consumed);
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && matches!(
+            interaction.targets.get(&focused),
+            Some(ComponentTarget::Input(_))
+        )
+        && !key
+            .modifiers
+            .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT)
+        && edit_input(&mut interaction, &focused, key.code)
+    {
+        return Some(ModInput::Consumed);
+    }
+    let region = effective_region(&interaction);
+    let target_key = interaction
+        .focused
+        .as_ref()
+        .and_then(|focused| interaction.targets.get(focused))
+        .is_some_and(|target| match (key.code, key.modifiers) {
+            (KeyCode::Enter | KeyCode::Up | KeyCode::Down, KeyModifiers::NONE) => true,
+            (KeyCode::Char(' '), KeyModifiers::NONE) => !matches!(target, ComponentTarget::Pane),
+            (KeyCode::Left | KeyCode::Right, KeyModifiers::NONE) => {
+                matches!(target, ComponentTarget::Select { .. })
+            }
+            _ => false,
+        });
+    if region.is_some()
+        && !target_key
+        && !repeated
+        && !modal(&interaction, key)
+        && let Some((name, action)) = context_binding(key, region.as_deref(), composer_empty, false)
+    {
+        return Some(run_context(&mut interaction, name, action, composer_empty));
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(target) = interaction.targets.get(&focused).cloned()
+    {
+        match (key.code, key.modifiers) {
+            (KeyCode::Tab, KeyModifiers::NONE) | (KeyCode::BackTab, KeyModifiers::SHIFT) => {
+                let mut index = interaction
+                    .order
+                    .iter()
+                    .position(|id| id == &focused)
+                    .unwrap_or_default();
+                if key.code == KeyCode::BackTab {
+                    index = index
+                        .checked_sub(1)
+                        .unwrap_or(interaction.order.len().saturating_sub(1));
+                } else if !interaction.order.is_empty() {
+                    index = (index + 1) % interaction.order.len();
+                }
+                interaction.focused = interaction.order.get(index).cloned();
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Char(' '), KeyModifiers::NONE)
+                if matches!(target, ComponentTarget::Multiselect { .. }) =>
+            {
+                toggle(&mut interaction, &focused, &target);
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Char(' '), KeyModifiers::NONE)
+                if matches!(target, ComponentTarget::Select { .. }) =>
+            {
+                step(&mut interaction, focused, &target, true);
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Enter, KeyModifiers::NONE) | (KeyCode::Char(' '), KeyModifiers::NONE)
+                if key.code == KeyCode::Enter
+                    || matches!(
+                        target,
+                        ComponentTarget::ListRow { .. } | ComponentTarget::Button(_)
+                    ) =>
+            {
+                let label = interaction
+                    .hitboxes
+                    .iter()
+                    .find(|hitbox| hitbox.id == focused)
+                    .map(|hitbox| hitbox.label.clone())
+                    .unwrap_or_else(|| focused.clone());
+                return activate_target(&focused, &label, &target, &mut interaction);
+            }
+            (KeyCode::Up | KeyCode::Down, KeyModifiers::NONE)
+                if within(
+                    &mut interaction,
+                    focused.clone(),
+                    &target,
+                    key.code == KeyCode::Down,
+                ) || move_focus(&mut interaction, &focused, key.code == KeyCode::Down) =>
+            {
+                return Some(ModInput::Consumed);
+            }
+            (KeyCode::Left | KeyCode::Right, KeyModifiers::NONE)
+                if matches!(target, ComponentTarget::Select { .. }) =>
+            {
+                step(
+                    &mut interaction,
+                    focused,
+                    &target,
+                    key.code == KeyCode::Right,
+                );
+                return Some(ModInput::Consumed);
+            }
+            _ => {}
+        }
+    }
+    let editing = interaction.focused.as_ref().is_some_and(|focused| {
+        matches!(
+            interaction.targets.get(focused),
+            Some(ComponentTarget::Input(_))
+        )
+    });
+    let modal = modal(&interaction, key);
+    // A shown dialog keeps every binding from writing to the composer behind it.
+    let blocked = |action: &ModKeyAction| {
+        modal
+            && matches!(
+                action,
+                ModKeyAction::Draft(_)
+                    | ModKeyAction::Insert { .. }
+                    | ModKeyAction::Submit { .. }
+                    | ModKeyAction::Region { .. }
+                    | ModKeyAction::Help { .. }
+            )
+    };
+    if !editing
+        && !repeated
+        && let Some(name) = key_name(key).filter(|name| codex_omd::mod_key_name(name))
+        && let Some((id, target)) = interaction
+            .hotkeys
+            .iter()
+            .find(|(bound, _)| *bound == name)
+            .and_then(|(_, id)| Some((id.clone(), interaction.targets.get(id)?.clone())))
+    {
+        let action = match target {
+            ComponentTarget::Button(action) => component_action(&action),
+            _ => ModKeyAction::Focus { focus: id },
+        };
+        // A laid-out dialog keeps only its own targets, whose hotkeys act like Enter on them.
+        return Some(if interaction.dialog_area.is_none() && blocked(&action) {
+            ModInput::Consumed
+        } else {
+            ModInput::Binding(name, action)
+        });
+    }
+    if !repeated
+        && region.is_none()
+        && let Some(binding) =
+            context_binding(key, None, composer_empty, false).filter(|(_, action)| !blocked(action))
+    {
+        return Some(ModInput::Binding(binding.0, binding.1));
+    }
+    if !repeated
+        && let Some(binding) = with_cache(|cache| action_for(&cache.snapshot.view, key))
+            .flatten()
+            .filter(|(_, action)| !blocked(action))
+    {
+        return Some(ModInput::Binding(binding.0, binding.1));
+    }
+    // Unbound typing in a dialog goes to its autofocus text input, so a filter needs no focusing first.
+    let document = interaction.focused.as_ref().is_some_and(|focused| {
+        matches!(
+            interaction.targets.get(focused),
+            Some(ComponentTarget::Document(_))
+        )
+    });
+    if modal
+        && !editing
+        && !document
+        && let KeyCode::Char(character) = key.code
+        && character != ' '
+        && !key
+            .modifiers
+            .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT)
+        && let Some(id) = interaction
+            .autofocus
+            .iter()
+            .find(|id| {
+                interaction.order.contains(*id)
+                    && matches!(
+                        interaction.targets.get(*id),
+                        Some(ComponentTarget::Input(_))
+                    )
+            })
+            .cloned()
+    {
+        interaction.focused = Some(id.clone());
+        edit_input(&mut interaction, &id, key.code);
+    }
+    (modal
+        || interaction.focus_region.is_some()
+            && !key
+                .modifiers
+                .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT)
+            && !matches!(key.code, KeyCode::F(_)))
+    .then_some(ModInput::Consumed)
+}
+
+/// Held navigation and editing keys repeat; Enter, Space, Tab and Esc act once per press.
+fn repeats(key: KeyEvent) -> bool {
+    key.kind == KeyEventKind::Repeat
+        && match key.code {
+            KeyCode::Up
+            | KeyCode::Down
+            | KeyCode::Left
+            | KeyCode::Right
+            | KeyCode::PageUp
+            | KeyCode::PageDown
+            | KeyCode::Home
+            | KeyCode::End
+            | KeyCode::Backspace
+            | KeyCode::Delete => true,
+            KeyCode::Char(character) => {
+                character != ' '
+                    && !key
+                        .modifiers
+                        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT)
+            }
+            _ => false,
+        }
+}
+
+/// Moves within a list or scrolled pane; false at its edge or for a control without rows.
+fn within(
+    interaction: &mut Interaction,
+    id: String,
+    target: &ComponentTarget,
+    forward: bool,
+) -> bool {
+    match target {
+        ComponentTarget::ListRow { options, .. } | ComponentTarget::Multiselect { options, .. } => {
+            let selected = interaction.selected.entry(id).or_default();
+            match forward {
+                true if *selected + 1 < options.len() => *selected += 1,
+                false if *selected > 0 => *selected -= 1,
+                _ => return false,
+            }
+        }
+        ComponentTarget::Pane => {
+            let limit = interaction.scroll_limits.get(&id).copied().unwrap_or(0);
+            let scroll = interaction.scroll.entry(id).or_default();
+            match forward {
+                true if *scroll < limit => *scroll += 1,
+                false if *scroll > 0 => *scroll -= 1,
+                _ => return false,
+            }
+        }
+        _ => return false,
+    }
+    true
+}
+
+/// Up/Down past a control's edge focus its neighbour (key panes and terminals only by Tab or click); false when there is none.
+fn move_focus(interaction: &mut Interaction, focused: &str, forward: bool) -> bool {
+    let Some(index) = interaction.order.iter().position(|id| id == focused) else {
+        return false;
+    };
+    let reachable = |id: &&String| {
+        interaction
+            .targets
+            .get(*id)
+            .is_some_and(|target| !matches!(target, ComponentTarget::Terminal(_, _)))
+    };
+    let next = if forward {
+        interaction.order[index + 1..].iter().find(reachable)
+    } else {
+        interaction.order[..index].iter().rev().find(reachable)
+    };
+    let Some(id) = next.cloned() else {
+        return false;
+    };
+    if let Some(
+        ComponentTarget::ListRow { options, .. } | ComponentTarget::Multiselect { options, .. },
+    ) = interaction.targets.get(&id)
+    {
+        let row = if forward {
+            0
+        } else {
+            options.len().saturating_sub(1)
+        };
+        interaction.selected.insert(id.clone(), row);
+    }
+    interaction.focused = Some(id);
+    true
+}
+
+fn toggle(interaction: &mut Interaction, id: &str, target: &ComponentTarget) {
+    let ComponentTarget::Multiselect { options, .. } = target else {
+        return;
+    };
+    let index = interaction.selected.get(id).copied().unwrap_or_default();
+    let Some((value, _)) = options.get(index) else {
+        return;
+    };
+    let checked = interaction.checked.entry(id.to_owned()).or_default();
+    if !checked.remove(value) {
+        checked.insert(value.clone());
+    }
+}
+
+/// Dialogs are modal: keys they do not bind stay out of the composer behind them; Ctrl+C still interrupts.
+fn modal(interaction: &Interaction, key: KeyEvent) -> bool {
+    interaction
+        .dialog
+        .as_ref()
+        .is_some_and(|dialog| interaction.dismissed.as_ref() != Some(dialog))
+        && (key.code, key.modifiers) != (KeyCode::Char('c'), KeyModifiers::CONTROL)
+}
+
+/// Whether a shown dialog keeps `key` from native handling, including a mod binding refused for shadowing a native key.
+pub(crate) fn modal_key(key: KeyEvent) -> bool {
+    modal(&INTERACTION.locked(), key)
+}
+
+pub(crate) fn holds_keys() -> bool {
+    let interaction = INTERACTION.locked();
+    interaction.focus_region.is_some()
+        || interaction.help.is_some()
+        || interaction.focused.as_ref().is_some_and(|focused| {
+            interaction.targets.contains_key(focused) || interaction.key_panes.contains(focused)
+        })
+        || (interaction.dialog.is_some() && interaction.dialog != interaction.dismissed)
+}
+
+pub(crate) fn reopen_dialogs() {
+    let mut interaction = INTERACTION.locked();
+    if interaction.dismissed.take().is_some() {
+        interaction.dialog = None;
+    }
+}
+
+/// A raster's declared size; a side left to fill its layout region is the size it last rendered at.
+pub(crate) fn raster_size(id: &str) -> Option<(u16, u16)> {
+    let (width, height) = with_cache(|cache| cache.snapshot.view.raster_declared(id)).flatten()?;
+    let rendered = crate::mod_raster::rendered(id);
+    Some((
+        width.or(rendered.map(|size| size.0))?,
+        height.or(rendered.map(|size| size.1))?,
+    ))
+}
+
+pub(crate) fn component_owner(component: &str) -> Option<String> {
+    INTERACTION
+        .locked()
+        .component_owners
+        .get(component)
+        .cloned()
+}
+
+fn edit_input(interaction: &mut Interaction, id: &str, code: KeyCode) -> bool {
+    let value = interaction
+        .input_values
+        .get(id)
+        .cloned()
+        .unwrap_or_default();
+    let length = value.chars().count();
+    let cursor = interaction
+        .input_cursor
+        .get(id)
+        .copied()
+        .unwrap_or(length)
+        .min(length);
+    let byte = |index: usize| {
+        value
+            .char_indices()
+            .nth(index)
+            .map_or(value.len(), |(at, _)| at)
+    };
+    let mut next = value.clone();
+    let cursor = match code {
+        KeyCode::Char(character) => {
+            if value.len() + character.len_utf8() > 1024 {
+                return true;
+            }
+            next.insert(byte(cursor), character);
+            cursor + 1
+        }
+        KeyCode::Backspace if cursor > 0 => {
+            next.remove(byte(cursor - 1));
+            cursor - 1
+        }
+        KeyCode::Delete if cursor < length => {
+            next.remove(byte(cursor));
+            cursor
+        }
+        KeyCode::Backspace | KeyCode::Delete => cursor,
+        KeyCode::Left => cursor.saturating_sub(1),
+        KeyCode::Right => (cursor + 1).min(length),
+        KeyCode::Home => 0,
+        KeyCode::End => length,
+        _ => return false,
+    };
+    interaction.input_values.insert(id.to_owned(), next);
+    interaction.input_cursor.insert(id.to_owned(), cursor);
+    true
+}
+
+pub(crate) fn paste(text: &str) -> bool {
+    observed(|| handle_paste(text))
+}
+
+fn handle_paste(text: &str) -> bool {
+    let mut interaction = INTERACTION.locked();
+    let Some(focused) = interaction.focused.clone() else {
+        return interaction.focus_region.is_some() || interaction.help.is_some();
+    };
+    if matches!(
+        interaction.targets.get(&focused),
+        Some(ComponentTarget::Input(_))
+    ) {
+        for character in text.chars().take(1024) {
+            let character = if character.is_control() {
+                ' '
+            } else {
+                character
+            };
+            edit_input(&mut interaction, &focused, KeyCode::Char(character));
+        }
+        return true;
+    }
+    let bounded = &text[..text.floor_char_boundary(PASTE_BYTES)];
+    if let Some(ComponentTarget::Terminal(session, binding)) = interaction.targets.get(&focused) {
+        crate::mod_pty::paste(binding.as_ref(), session, bounded);
+        return true;
+    }
+    if !interaction.key_panes.contains(&focused) {
+        return interaction.focus_region.is_some();
+    }
+    let mut event = serde_json::json!({"paste": bounded});
+    if bounded.len() < text.len() {
+        event["truncated"] = true.into();
+    }
+    crate::mod_surface::input_event(
+        interaction.thread.as_deref(),
+        interaction
+            .component_owners
+            .get(&focused)
+            .map(String::as_str),
+        &focused,
+        event,
+    );
+    true
+}
+
+fn contains(area: Rect, column: u16, row: u16) -> bool {
+    column >= area.x && column < area.right() && row >= area.y && row < area.bottom()
+}
+
+pub(crate) fn pointer(event: MouseEvent) -> Option<ModPointer> {
+    if crate::mod_layout::pointer(event) {
+        return Some(ModPointer::Consumed);
+    }
+    observed(|| {
+        let pointer = handle_pointer(event);
+        follow_region(&mut INTERACTION.locked());
+        pointer
+    })
+}
+
+fn button_name(button: MouseButton) -> &'static str {
+    match button {
+        MouseButton::Left => "left",
+        MouseButton::Right => "right",
+        MouseButton::Middle => "middle",
+    }
+}
+
+fn region_event(
+    region: &Region,
+    event: MouseEvent,
+    action: &str,
+    button: Option<MouseButton>,
+) -> serde_json::Value {
+    let column = i32::from(event.column) - i32::from(region.area.x);
+    let row = i32::from(event.row) - i32::from(region.area.y) + i32::from(region.top);
+    serde_json::json!({"component": region.id, "kind": "pointer", "pointer": {
+        "column": column, "row": row, "half": crate::mod_client::last_half(),
+        "fraction": crate::mod_client::last_fraction().map(|(x, y)| [x, y]),
+        "action": action, "button": button.map(button_name)}})
+}
+
+/// Hover, motion, drag and capture on the topmost layer; returns whether the event was consumed and the `component_event` payloads to deliver.
+fn region_pointer(
+    interaction: &mut Interaction,
+    event: MouseEvent,
+    top: u16,
+) -> (bool, Vec<serde_json::Value>) {
+    let mut events = Vec::new();
+    if interaction.regions.is_empty()
+        && interaction.hovered.is_empty()
+        && interaction.captured.is_none()
+    {
+        return (false, events);
+    }
+    let here = interaction
+        .regions
+        .iter()
+        .filter(|region| region.layer == top && contains(region.area, event.column, event.row))
+        .cloned()
+        .collect::<Vec<_>>();
+    let hovered = here
+        .iter()
+        .map(|region| (region.id.clone(), region.clone()))
+        .collect::<BTreeMap<_, _>>();
+    let restyled = hovered
+        .values()
+        .chain(interaction.hovered.values())
+        .any(|region| {
+            region.hover
+                && hovered.contains_key(&region.id) != interaction.hovered.contains_key(&region.id)
+        });
+    for (id, last) in &interaction.hovered {
+        if last.events && !hovered.contains_key(id) {
+            let region = interaction
+                .regions
+                .iter()
+                .find(|region| &region.id == id)
+                .unwrap_or(last);
+            events.push(region_event(region, event, "leave", None));
+        }
+    }
+    for entered in here
+        .iter()
+        .filter(|region| region.events && !interaction.hovered.contains_key(&region.id))
+    {
+        events.push(region_event(entered, event, "enter", None));
+    }
+    interaction.hovered = hovered;
+    let innermost = here
+        .iter()
+        .filter(|region| region.events)
+        .min_by_key(|region| region.area.area())
+        .cloned();
+    let captured = interaction.captured.as_ref().and_then(|id| {
+        interaction
+            .regions
+            .iter()
+            .find(|region| &region.id == id)
+            .cloned()
+    });
+    let consumed = match event.kind {
+        MouseEventKind::Moved => {
+            innermost
+                .map(|region| events.push(region_event(&region, event, "move", None)))
+                .is_some()
+                || restyled
+        }
+        MouseEventKind::Drag(button) => captured
+            .map(|region| events.push(region_event(&region, event, "drag", Some(button))))
+            .is_some(),
+        MouseEventKind::Down(button) => innermost
+            .map(|region| {
+                interaction.captured = Some(region.id.clone());
+                events.push(region_event(&region, event, "down", Some(button)));
+            })
+            .is_some(),
+        MouseEventKind::Up(button) => {
+            interaction.captured = None;
+            captured
+                .or(innermost)
+                .map(|region| events.push(region_event(&region, event, "up", Some(button))))
+                .is_some()
+        }
+        _ => false,
+    };
+    (consumed, events)
+}
+
+fn handle_pointer(event: MouseEvent) -> Option<ModPointer> {
+    let mut interaction = INTERACTION.locked();
+    let top = interaction
+        .layers
+        .iter()
+        .filter(|(area, _)| contains(*area, event.column, event.row))
+        .map(|(_, layer)| *layer)
+        .max()
+        .unwrap_or_default();
+    let hit = interaction
+        .hitboxes
+        .iter()
+        .rev()
+        .find(|hitbox| hitbox.layer == top && contains(hitbox.area, event.column, event.row))
+        .cloned();
+    let (consumed, events) = region_pointer(&mut interaction, event, top);
+    let pressed = events
+        .iter()
+        .find(|payload| {
+            payload["pointer"]["action"] == "down" && payload["pointer"]["button"] == "left"
+        })
+        .and_then(|payload| payload["component"].as_str())
+        .map(str::to_owned);
+    let keyed = events
+        .iter()
+        .filter_map(|payload| payload["component"].as_str())
+        .find(|id| interaction.key_panes.contains(*id) && crate::mod_module::mounted(id))
+        .map(str::to_owned);
+    for payload in events {
+        let owner = payload["component"]
+            .as_str()
+            .and_then(|id| interaction.component_owners.get(id))
+            .map(String::as_str);
+        if crate::mod_surface::to_process(interaction.thread.as_deref(), owner, &payload) {
+            continue;
+        }
+        match payload["pointer"]["action"].as_str() {
+            Some("move" | "drag") => crate::mod_surface::pointer_motion(
+                payload["component"].as_str().unwrap_or_default(),
+                payload.clone(),
+            ),
+            _ => crate::mod_surface::component_event(payload),
+        }
+    }
+    // A keyed region takes the pointer from the card around it, and a click there gives it the keys.
+    if consumed && let Some(keyed) = keyed {
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {
+            interaction.focused = Some(keyed);
+        }
+        return Some(ModPointer::Consumed);
+    }
+    if consumed && hit.is_none() {
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {
+            interaction.focused = pressed
+                .and_then(|raster| {
+                    let owner = interaction.component_owners.get(&raster)?;
+                    codex_omd::process_raster::keys(interaction.thread.as_deref(), owner, &raster)
+                })
+                .filter(|keys| interaction.key_panes.contains(keys));
+        }
+        return Some(ModPointer::Consumed);
+    }
+    let action = match event.kind {
+        MouseEventKind::Down(button) => Some(("down", Some(button))),
+        MouseEventKind::Up(button) => Some(("up", Some(button))),
+        MouseEventKind::ScrollUp => Some(("scroll_up", None)),
+        MouseEventKind::ScrollDown => Some(("scroll_down", None)),
+        _ => None,
+    };
+    if let (Some(hit), Some((action, button))) = (&hit, action) {
+        let payload = serde_json::json!({"component": hit.id, "kind": "pointer",
+            "pointer": {"column": event.column.saturating_sub(hit.area.x), "row": event.row.saturating_sub(hit.area.y),
+                "action": action,
+                "button": button.map(button_name)}});
+        if !crate::mod_surface::to_process(
+            interaction.thread.as_deref(),
+            interaction
+                .component_owners
+                .get(&hit.id)
+                .map(String::as_str),
+            &payload,
+        ) {
+            crate::mod_surface::component_event(payload);
+        }
+    }
+    let Some(hit) = hit else {
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {
+            match interaction
+                .focus_areas
+                .iter()
+                .find(|(_, area)| contains(*area, event.column, event.row))
+                .map(|(name, _)| name.clone())
+                .filter(|region| {
+                    interaction.focus_region.is_some()
+                        || interaction.region_keys && region != "chat"
+                }) {
+                Some(region) => enter_region(&mut interaction, &region),
+                None => interaction.focused = None,
+            }
+            if interaction
+                .dialog_area
+                .is_some_and(|area| !contains(area, event.column, event.row))
+            {
+                interaction.dismissed = interaction.dialog.clone();
+            }
+        }
+        return None;
+    };
+    match event.kind {
+        MouseEventKind::Down(MouseButton::Left) => {
+            if let Some(region) = interaction
+                .component_region
+                .get(&hit.id)
+                .filter(|region| {
+                    (interaction.region_keys || interaction.focus_region.is_some())
+                        && interaction
+                            .focus_areas
+                            .iter()
+                            .any(|(name, _)| name == *region)
+                })
+                .cloned()
+                .filter(|region| interaction.focus_region.as_ref() != Some(region))
+            {
+                enter_region(&mut interaction, &region);
+            }
+            interaction.focused = Some(hit.id);
+            Some(ModPointer::Consumed)
+        }
+        MouseEventKind::Up(MouseButton::Left) => {
+            interaction.focused = (!matches!(
+                hit.target,
+                ComponentTarget::Button(_) | ComponentTarget::Pane
+            ))
+            .then(|| hit.id.clone());
+            if let ComponentTarget::Multiselect { index, .. } = hit.target {
+                interaction.selected.insert(hit.id.clone(), index);
+                toggle(&mut interaction, &hit.id, &hit.target);
+                return Some(ModPointer::Consumed);
+            }
+            if let ComponentTarget::ListRow { index, .. } = hit.target {
+                interaction.selected.insert(hit.id.clone(), index);
+            }
+            activate_target(&hit.id, &hit.label, &hit.target, &mut interaction).map(|input| {
+                match input {
+                    ModInput::Consumed => ModPointer::Consumed,
+                    ModInput::Interaction(name, action) | ModInput::Binding(name, action) => {
+                        ModPointer::Action(name, action)
+                    }
+                }
+            })
+        }
+        MouseEventKind::ScrollUp | MouseEventKind::ScrollDown => {
+            let forward = event.kind == MouseEventKind::ScrollDown;
+            step(&mut interaction, hit.id, &hit.target, forward);
+            Some(ModPointer::Consumed)
+        }
+        _ => Some(ModPointer::Consumed),
+    }
+}
+
+fn step(
+    interaction: &mut Interaction,
+    id: String,
+    target: &ComponentTarget,
+    forward: bool,
+) -> bool {
+    match target {
+        ComponentTarget::Select { options, .. }
+        | ComponentTarget::ListRow { options, .. }
+        | ComponentTarget::Multiselect { options, .. } => {
+            let selected = interaction.selected.entry(id).or_default();
+            if forward {
+                if !options.is_empty() {
+                    *selected = (*selected + 1) % options.len();
+                }
+            } else {
+                *selected = selected
+                    .checked_sub(1)
+                    .unwrap_or(options.len().saturating_sub(1));
+            }
+        }
+        ComponentTarget::Pane => {
+            let limit = interaction
+                .scroll_limits
+                .get(&id)
+                .copied()
+                .unwrap_or(u16::MAX);
+            let scroll = interaction.scroll.entry(id).or_default();
+            *scroll = if forward {
+                scroll.saturating_add(1).min(limit)
+            } else {
+                scroll.saturating_sub(1)
+            };
+        }
+        _ => return false,
+    }
+    true
+}
+
+#[derive(Clone, PartialEq)]
+struct Observed {
+    focused: Option<String>,
+    values: BTreeMap<String, String>,
+    selected: BTreeMap<String, usize>,
+    scroll: BTreeMap<String, u16>,
+    collapsed: BTreeMap<String, bool>,
+    dismissed: Option<String>,
+    checked: BTreeMap<String, BTreeSet<String>>,
+}
+
+fn observe(interaction: &Interaction) -> Observed {
+    Observed {
+        focused: interaction.focused.clone(),
+        values: interaction.input_values.clone(),
+        selected: interaction.selected.clone(),
+        scroll: interaction.scroll.clone(),
+        collapsed: interaction.collapsed.clone(),
+        dismissed: interaction.dismissed.clone(),
+        checked: interaction.checked.clone(),
+    }
+}
+
+fn observed<T>(run: impl FnOnce() -> T) -> T {
+    let lock = || INTERACTION.locked();
+    let before = observe(&lock());
+    let result = run();
+    let after = observe(&lock());
+    if before != after {
+        intercept_changes(&before, &after, crate::mod_runtime::component_change);
+    }
+    let mut interaction = lock();
+    let after = observe(&interaction);
+    if before != after {
+        report(&before, &after, &mut interaction, "user");
+    }
+    result
+}
+
+/// Lets the owner of a component veto or adjust a user focus or scroll change before it is reported.
+fn intercept_changes(
+    before: &Observed,
+    after: &Observed,
+    change: impl Fn(&str, serde_json::Value) -> Result<serde_json::Value, String>,
+) {
+    let owner = |id: &str| component_owner(id);
+    let ask = |owner: &str,
+               kind: &str,
+               id: &str,
+               from: serde_json::Value,
+               to: serde_json::Value| {
+        change(
+            owner,
+            serde_json::json!({"kind": kind, "id": id, "from": from, "to": to, "origin": "user"}),
+        )
+    };
+    if before.focused != after.focused {
+        let (from, to) = (before.focused.clone(), after.focused.clone());
+        let mut target = to.clone();
+        let mut asked = BTreeSet::new();
+        for id in [&from, &to].into_iter().flatten() {
+            let Some(owner) = owner(id) else {
+                continue;
+            };
+            if !asked.insert(owner.clone()) {
+                continue;
+            }
+            let id = target
+                .as_ref()
+                .filter(|target| component_owner(target).as_deref() == Some(owner.as_str()))
+                .unwrap_or(id);
+            match ask(
+                &owner,
+                "focus",
+                id,
+                from.clone().into(),
+                target.clone().into(),
+            ) {
+                Ok(answer) if answer["focus"] != serde_json::json!(target) => {
+                    let redirect = answer["focus"].as_str().map(str::to_owned);
+                    if redirect.as_deref().is_none_or(|redirect| {
+                        component_owner(redirect).as_deref() == Some(owner.as_str())
+                    }) {
+                        target = redirect;
+                    }
+                }
+                Ok(_) => {}
+                Err(_) => {
+                    target = from.clone();
+                    break;
+                }
+            }
+        }
+        if target != to {
+            let mut interaction = INTERACTION.locked();
+            interaction.focused = target.filter(|id| interaction.ids.contains(id));
+        }
+    }
+    for (id, offset) in &after.scroll {
+        let previous = before.scroll.get(id).copied();
+        if previous == Some(*offset) {
+            continue;
+        }
+        let Some(owner) = owner(id) else {
+            continue;
+        };
+        let applied = match ask(&owner, "scroll", id, previous.into(), (*offset).into()) {
+            Ok(answer) => answer["scroll"]
+                .as_u64()
+                .and_then(|offset| u16::try_from(offset).ok()),
+            Err(_) => previous,
+        };
+        if applied != Some(*offset) {
+            let mut interaction = INTERACTION.locked();
+            match applied {
+                Some(applied) => interaction.scroll.insert(id.clone(), applied),
+                None => interaction.scroll.remove(id),
+            };
+        }
+    }
+}
+
+fn report(before: &Observed, after: &Observed, interaction: &mut Interaction, origin: &str) {
+    let send = |component: &str, mut event: serde_json::Value| {
+        event["component"] = component.into();
+        crate::mod_surface::component_event(event);
+    };
+    if before.focused != after.focused {
+        if let Some(blurred) = &before.focused {
+            send(
+                blurred,
+                serde_json::json!({"kind": "blur", "origin": origin}),
+            );
+        }
+        if let Some(focused) = &after.focused {
+            send(
+                focused,
+                serde_json::json!({"kind": "focus", "origin": origin}),
+            );
+        }
+    }
+    let mut changed = Vec::new();
+    for (id, value) in &after.values {
+        if before.values.get(id) != Some(value) {
+            changed.push((id.clone(), value.clone()));
+        }
+    }
+    for (id, index) in &after.selected {
+        if before.selected.get(id) == Some(index) {
+            continue;
+        }
+        let value = match interaction.targets.get(id) {
+            Some(ComponentTarget::Select { options, .. }) => {
+                options.get(*index).map(|(value, _)| value.clone())
+            }
+            _ => None,
+        };
+        if let Some(value) = value {
+            changed.push((id.clone(), value));
+        }
+    }
+    let echo = |interaction: &mut Interaction, id: &str, value: String| {
+        let echoes = interaction.echoes.entry(id.to_owned()).or_default();
+        echoes.push_back(value);
+        if echoes.len() > 16 {
+            echoes.pop_front();
+        }
+    };
+    for (id, value) in changed {
+        echo(interaction, &id, value.clone());
+        send(
+            &id,
+            serde_json::json!({"kind": "change", "value": value, "origin": origin}),
+        );
+    }
+    for (id, checked) in &after.checked {
+        if before.checked.get(id) == Some(checked) {
+            continue;
+        }
+        let Some(ComponentTarget::Multiselect { options, .. }) =
+            interaction.targets.get(id).cloned()
+        else {
+            continue;
+        };
+        let values = options
+            .iter()
+            .filter(|(value, _)| checked.contains(value))
+            .map(|(value, _)| value.clone())
+            .collect::<Vec<_>>();
+        echo(interaction, id, checked_value(checked.iter()));
+        send(
+            id,
+            serde_json::json!({"kind": "change", "values": values, "origin": origin}),
+        );
+    }
+    for (id, offset) in &after.scroll {
+        if before.scroll.get(id) != Some(offset) {
+            send(
+                id,
+                serde_json::json!({"kind": "scroll", "offset": offset, "origin": origin}),
+            );
+        }
+    }
+    for (id, collapsed) in &after.collapsed {
+        if before.collapsed.get(id) != Some(collapsed) {
+            let kind = if *collapsed { "close" } else { "open" };
+            send(id, serde_json::json!({"kind": kind, "origin": origin}));
+        }
+    }
+    if before.dismissed != after.dismissed {
+        let dialogs = with_cache(|cache| {
+            site(&cache.snapshot.view, "dialog")
+                .into_iter()
+                .flat_map(|site| &site.components)
+                .filter_map(|component| match component {
+                    ModComponent::Dialog { id, .. } => Some(id.clone()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+        let kind = if after.dismissed.is_some() {
+            "close"
+        } else {
+            "open"
+        };
+        for dialog in dialogs {
+            send(&dialog, serde_json::json!({"kind": kind, "origin": origin}));
+        }
+    }
+}
+
+/// `terminal.panes`: the caller's own panes; a pane is visible while its header row is on screen.
+pub(crate) fn panes(caller: &str) -> serde_json::Value {
+    let interaction = INTERACTION.locked();
+    let panes = interaction
+        .collapsed
+        .iter()
+        .filter(|(id, _)| interaction.component_owners.get(*id).map(String::as_str) == Some(caller))
+        .map(|(id, collapsed)| {
+            serde_json::json!({
+                "id": id,
+                "visible": interaction.hitboxes.iter().any(|hitbox| hitbox.id == *id),
+                "collapsed": collapsed,
+                "focused": interaction.focused.as_ref() == Some(id),
+                "scroll": interaction.scroll.get(id).copied().unwrap_or_default(),
+            })
+        })
+        .collect::<Vec<_>>();
+    serde_json::json!({ "panes": panes })
+}
+
+/// `terminal.pane`: a mod acts on its own panes, dialogs and controls only, never on the user's state or another mod's components.
+pub(crate) fn pane(
+    caller: &str,
+    arguments: &serde_json::Value,
+) -> Result<serde_json::Value, String> {
+    let id = arguments["id"].as_str().ok_or("terminal_pane_invalid")?;
+    if component_owner(id).as_deref() != Some(caller) {
+        return Err("terminal_pane_not_owned".into());
+    }
+    let mut interaction = INTERACTION.locked();
+    let before = observe(&interaction);
+    let dialog = with_cache(|cache| {
+        site(&cache.snapshot.view, "dialog").is_some_and(|site| {
+            site.components
+                .iter()
+                .any(|component| matches!(component, ModComponent::Dialog { id: dialog, .. } if dialog == id))
+        })
+    })
+    .unwrap_or_default();
+    match arguments["action"].as_str() {
+        Some("open") if dialog => {
+            interaction.dialog = None;
+            interaction.dismissed = None;
+        }
+        Some("close") if dialog => {
+            interaction.dismissed = interaction.dialog.clone();
+            interaction.focused = None;
+        }
+        Some("open" | "close") if interaction.collapsed.contains_key(id) => {
+            interaction
+                .collapsed
+                .insert(id.to_owned(), arguments["action"] == "close");
+        }
+        Some("scroll") if interaction.scroll.contains_key(id) => {
+            let offset = arguments["offset"]
+                .as_u64()
+                .and_then(|offset| u16::try_from(offset).ok())
+                .ok_or("terminal_pane_invalid")?;
+            interaction.scroll.insert(id.to_owned(), offset);
+        }
+        Some("focus" | "reveal") if interaction.ids.contains(id) => {
+            if arguments["action"] == "reveal"
+                && let Some(collapsed) = interaction.collapsed.get_mut(id)
+            {
+                *collapsed = false;
+            }
+            interaction.focused = Some(id.to_owned());
+        }
+        _ => return Err("terminal_pane_invalid".into()),
+    }
+    let after = observe(&interaction);
+    report(&before, &after, &mut interaction, "mod");
+    Ok(serde_json::json!({"applied": true}))
+}
