+    struct ChangedSource(PathBuf, PathBuf);
+    impl ClientSurface for ChangedSource {
+        fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+            assert!((call.validity.0)());
+            std::fs::write(&self.0, "export default () => { const changed = true; };").unwrap();
