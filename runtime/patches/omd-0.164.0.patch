@@ -0,0 +1,44 @@
+use super::*;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyModifiers;
+
+#[test]
+fn actions_resolve_to_their_effective_binding_and_refuse_approval() {
+    let base = TuiKeymap::default();
+    let (_, config) = overlay(
+        &base,
+        &[("composer.submit".to_owned(), Some("F5".to_owned()))],
+    )
+    .unwrap();
+    let key = action_key(&config, "composer.submit").unwrap();
+    assert_eq!(
+        (key.code, key.modifiers),
+        (KeyCode::F(5), KeyModifiers::NONE)
+    );
+    assert!(
+        action_key(&config, "approval.accept")
+            .unwrap_err()
+            .starts_with("keymap_action_refused")
+    );
+    assert!(
+        action_key(&config, "composer.nothing")
+            .unwrap_err()
+            .starts_with("keymap_action_unknown")
+    );
+    let (_, unbound) = overlay(&base, &[("composer.submit".to_owned(), None)]).unwrap();
+    assert!(
+        action_key(&unbound, "composer.submit")
+            .unwrap_err()
+            .starts_with("keymap_action_unbound")
+    );
+    let (_, defaults) = overlay(&base, &[]).unwrap();
+    assert!(action_key(&defaults, "global.open_transcript").is_ok());
+    for refused in ["list.accept", "list.move_down", "chat.next_permission_mode"] {
+        assert!(
+            action_key(&defaults, refused)
+                .unwrap_err()
+                .starts_with("keymap_action_refused"),
+            "{refused}"
+        );
+    }
+}
