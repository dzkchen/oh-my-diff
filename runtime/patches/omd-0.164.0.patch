+    preview: bool,
+    startup_repository: Option<std::path::PathBuf>,
+    presentation: u64,
+}
+
+#[derive(Clone)]
+enum ComponentTarget {
+    Button(ModComponentAction),
+    Input(ModCommandAction),
+    Select {
+        action: ModCommandAction,
