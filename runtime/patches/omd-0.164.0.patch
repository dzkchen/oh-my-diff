+use codex_app_server_protocol::OmdRecoveryApplyParams;
+use codex_app_server_protocol::OmdRecoveryApplyResponse;
+use codex_app_server_protocol::OmdRecoveryReadResponse;
+use codex_app_server_protocol::OmdRenderFormat;
+use codex_app_server_protocol::OmdRenderParams;
+use codex_app_server_protocol::OmdRenderResponse;
+use codex_app_server_protocol::OmdRenderer;
+use codex_app_server_protocol::OmdRendererKind;
+use codex_app_server_protocol::OmdResourceReadParams;
+use codex_app_server_protocol::OmdResourceReadResponse;
+use codex_app_server_protocol::OmdRosterEntry;
+use codex_app_server_protocol::OmdRosterUpdatedNotification;
+use codex_app_server_protocol::OmdSurfaceCallParams;
+use codex_app_server_protocol::OmdSurfaceMirroredNotification;
+use codex_app_server_protocol::OmdViewReadResponse;
+use codex_app_server_protocol::OmdViewUpdatedNotification;
+use codex_app_server_protocol::OmdViewport;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ServerRequestPayload;
+use codex_omd::ModViewSnapshot;
+use codex_omd::client_surface;
+use codex_omd::client_surface::Observed;
+use codex_omd_extension::clients;
+use serde_json::Value;
+use sha2::Digest;
+use tokio::sync::OwnedMutexGuard;
+
+use crate::connection_rpc_gate::ConnectionRpcGate;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_request;
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::ConnectionRequestId;
+use crate::outgoing_message::OutgoingMessageSender;
+
+type Response = Result<Option<ClientResponsePayload>, JSONRPCErrorError>;
+
+const NOT_DELEGATED: &[&str] = &[
+    "app.request",
+    "app.respond",
+    "prompts.consent",
+    "terminal.notify",
+    "terminal.notice",
+    "terminal.blit",
+];
+
+pub(crate) fn delegable(operation: &str) -> bool {
+    client_surface::SURFACE_OPERATIONS.contains(&operation)
+        && !client_surface::USER_ONLY_OPERATIONS.contains(&operation)
+        && !NOT_DELEGATED.contains(&operation)
+}
+
+pub(crate) struct OmdClients {
+    outgoing: Arc<OutgoingMessageSender>,
+    attached: Mutex<HashMap<ConnectionId, Attached>>,
+    calls: Mutex<HashMap<RequestId, Vec<ConnectionId>>>,
+    headless: AtomicBool,
+    internal: AtomicU64,
+    next_client: AtomicU64,
+}
+
+struct Attached {
+    client_id: String,
+    operations: Vec<String>,
+    renderer: Arc<Mutex<OmdRenderer>>,
+    view: Arc<tokio::sync::Mutex<View>>,
+    _observer: client_surface::Registration,
+    _entry: client_surface::Registration,
+}
+
+#[derive(Default)]
+struct View {
+    token: String,
+    bound: Option<(u64, u64)>,
+    retired: std::collections::VecDeque<(String, &'static str)>,
+    pushed: Option<PushedKey>,
+}
+
+/// What a redraw changes besides the revision: progress, activity and diagnostics.
+type PushedKey = Option<(u64, u64, Value, Value, Value)>;
+
+fn pushed_key(snapshot: Option<&ModViewSnapshot>) -> PushedKey {
+    snapshot.map(|snapshot| {
+        (
+            snapshot.epoch,
+            snapshot.revision,
+            serde_json::to_value(&snapshot.progress).unwrap_or_default(),
+            serde_json::to_value(&snapshot.activity).unwrap_or_default(),
+            serde_json::to_value(&snapshot.diagnostics).unwrap_or_default(),
+        )
+    })
+}
+
+fn bound(snapshot: Option<&ModViewSnapshot>) -> (u64, u64) {
+    snapshot.map_or((0, 0), |snapshot| (snapshot.epoch, snapshot.revision))
+}
+
+async fn serialized(snapshot: Option<Arc<ModViewSnapshot>>) -> Result<Value, JSONRPCErrorError> {
+    blocking(move || serde_json::to_value(snapshot.as_deref()).map_err(|error| error.to_string()))
+        .await
+}
+
+const RETIRED_TOKENS: usize = 8;
+
+impl View {
+    fn retire(&mut self, token: String, code: &'static str) {
+        if self.retired.len() == RETIRED_TOKENS {
+            self.retired.pop_front();
+        }
+        self.retired.push_back((token, code));
+    }
+
+    fn token_for(&mut self, epoch: u64, revision: u64) -> String {
+        if self.bound != Some((epoch, revision)) {
+            if self.bound.is_some() {
+                let stale = std::mem::take(&mut self.token);
+                self.retire(stale, "action_stale");
+            }
+            self.token = new_token();
+            self.bound = Some((epoch, revision));
+        }
+        self.token.clone()
+    }
+
+    fn spend(&mut self, token: &str) -> Result<(String, (u64, u64)), JSONRPCErrorError> {
+        if let Some(bound) = self.bound
+            && token == self.token
+        {
+            let spent = std::mem::replace(&mut self.token, new_token());
+            self.retire(spent, "action_replayed");
+            return Ok((self.token.clone(), bound));
+        }
+        Err(invalid_request(
+            match self.retired.iter().find(|(retired, _)| retired == token) {
+                Some((_, code)) => format!(
+                    "{code}: the action token is no longer valid; use the latest view's token"
+                ),
+                None => {
+                    "action_unknown: this connection did not issue the action token".to_string()
+                }
+            },
+        ))
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Mirror {
+    Unchanged,
+    Cells,
+    Image(OmdRenderFormat),
+    Raw,
+}
+
+impl Mirror {
+    fn of(observed: &Observed) -> Option<Self> {
+        let Observed::Mirrored {
+            operation,
+            arguments,
+            pixels,
+            ..
+        } = observed
+        else {
+            return Some(Self::Unchanged);
+        };
+        if operation != "terminal.blit" {
+            return Some(Self::Unchanged);
+        }
+        if arguments.get("pixels").is_some() {
+            return pixels.is_some().then_some(Self::Raw);
+        }
+        Some(match arguments["image"]["media_type"].as_str() {
+            Some("image/png") => Self::Image(OmdRenderFormat::Png),
+            Some("image/jpeg") => Self::Image(OmdRenderFormat::Jpeg),
+            _ => Self::Cells,
+        })
+    }
+
+    fn reaches(self, renderer: &Mutex<OmdRenderer>) -> bool {
+        let carries = |format| carries(renderer, format);
+        match self {
+            Self::Unchanged => true,
+            Self::Cells => carries(OmdRenderFormat::Cells),
+            Self::Image(format) => carries(format) || carries(OmdRenderFormat::Cells),
+            Self::Raw => [
+                OmdRenderFormat::Png,
+                OmdRenderFormat::Jpeg,
+                OmdRenderFormat::Cells,
+            ]
+            .into_iter()
+            .any(carries),
+        }
+    }
+}
+
+fn carries(renderer: &Mutex<OmdRenderer>, format: OmdRenderFormat) -> bool {
+    renderer
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .formats
+        .contains(&format)
+}
+
+fn blit_for(
+    renderer: &Mutex<OmdRenderer>,
+    format: OmdRenderFormat,
+    arguments: &Value,
+    size: Option<(u16, u16)>,
+) -> Option<Value> {
+    if carries(renderer, format) {
+        return Some(arguments.clone());
+    }
+    if carries(renderer, OmdRenderFormat::Cells) {
+        return client_surface::frame_cells(arguments, size?);
+    }
+    None
+}
+
+fn raw_blit_for(
+    renderer: &Mutex<OmdRenderer>,
+    arguments: &Value,
+    size: Option<(u16, u16)>,
+    pixels: &codex_omd::process_raster::PixelFrame,
+) -> Option<Value> {
+    use base64::Engine;
+    let format = if carries(renderer, OmdRenderFormat::Png) {
+        Some((false, "image/png"))
+    } else if carries(renderer, OmdRenderFormat::Jpeg) {
+        Some((true, "image/jpeg"))
+    } else {
+        None
+    };
+    let bounds = size.map_or((u32::MAX, u32::MAX), |(columns, rows)| {
+        let cell = renderer
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .cell_px
+            .as_ref()
+            .map_or((8, 16), |cell| (cell.width.max(1), cell.height.max(1)));
+        (
+            u32::from(columns).saturating_mul(cell.0),
+            u32::from(rows).saturating_mul(cell.1),
+        )
+    });
+    if let Some(encoded) =
+        format.and_then(|(jpeg, media_type)| Some((media_type, pixels.encoded(jpeg, bounds)?)))
+    {
+        return Some(
+            serde_json::json!({"key": arguments["key"], "image": {"media_type": encoded.0,
+            "base64": base64::engine::general_purpose::STANDARD.encode(encoded.1)}}),
+        );
+    }
+    carries(renderer, OmdRenderFormat::Cells)
+        .then(|| {
+            size.map(|size| client_surface::pixel_cells(&arguments["key"], &pixels.image, size))
+        })
+        .flatten()
+}
+
+struct Queued {
+    observed: Observed,
+    mirror: Mirror,
+    frame: Option<((String, String), usize)>,
+}
+
+fn queue_observation(
+    queue: &mut std::collections::VecDeque<Queued>,
+    observed: Observed,
+    mirror: Mirror,
+) {
+    let frame = match (&observed, mirror) {
+        (
+            Observed::Mirrored {
+                caller,
+                arguments,
+                pixels,
+                ..
+            },
+            Mirror::Image(_) | Mirror::Raw,
+        ) => arguments["key"].as_str().map(|key| {
+            (
+                (caller.clone(), key.to_owned()),
+                pixels.as_ref().map_or_else(
+                    || arguments["image"]["base64"].as_str().map_or(0, str::len),
+                    |pixels| pixels.image.as_bytes().len(),
+                ),
+            )
+        }),
+        _ => None,
+    };
+    if let Some((key, bytes)) = &frame {
+        queue.retain(|queued| queued.frame.as_ref().is_none_or(|(other, _)| other != key));
+        let (mut count, mut total) = queue
+            .iter()
+            .filter_map(|queued| queued.frame.as_ref())
+            .fold((0, 0), |(count, total), (_, bytes)| {
+                (count + 1, total + bytes)
+            });
+        while count >= 32 || total + bytes > 64 * 1024 * 1024 {
+            let Some(index) = queue.iter().position(|queued| queued.frame.is_some()) else {
+                return;
+            };
+            if let Some(Queued {
+                frame: Some((_, removed)),
+                ..
+            }) = queue.remove(index)
+            {
+                count -= 1;
+                total -= removed;
+            }
+        }
+    }
+    queue.push_back(Queued {
+        observed,
+        mirror,
+        frame,
+    });
+}
+
+/// The renderer as mods see it: snake_case, unlike the camelCase wire.
+#[derive(serde::Serialize, serde::Deserialize)]
+struct ModRenderer {
+    kind: OmdRendererKind,
+    formats: Vec<OmdRenderFormat>,
+    pointer: OmdPointer,
+    #[serde(default)]
+    reduced_motion: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    cell_px: Option<OmdCellPx>,
+}
+
+#[derive(serde::Deserialize)]
+struct ModEntry {
+    id: String,
+    name: String,
+    renderer: ModRenderer,
+    viewport: Option<OmdViewport>,
+    attached_ms: u64,
+    focused: bool,
+}
+
+/// Epochs exceed JS integer precision, so the wire carries them as opaque strings.
+fn wire_epoch(snapshot: Option<&ModViewSnapshot>) -> String {
+    snapshot.map_or_else(String::new, |snapshot| snapshot.epoch.to_string())
+}
+
+fn mod_renderer(renderer: OmdRenderer) -> Result<Value, JSONRPCErrorError> {
+    to_value(ModRenderer {
+        kind: renderer.kind,
+        formats: renderer.formats,
+        pointer: renderer.pointer,
+        reduced_motion: renderer.reduced_motion,
+        cell_px: renderer.cell_px,
+    })
+}
+
+fn roster() -> Vec<OmdRosterEntry> {
+    client_surface::roster()
+        .into_iter()
+        .filter_map(|entry| serde_json::from_value::<ModEntry>(entry).ok())
+        .map(|entry| OmdRosterEntry {
+            id: entry.id,
+            name: entry.name,
+            renderer: OmdRenderer {
+                kind: entry.renderer.kind,
+                formats: entry.renderer.formats,
+                pointer: entry.renderer.pointer,
+                reduced_motion: entry.renderer.reduced_motion,
+                cell_px: entry.renderer.cell_px,
+            },
+            viewport: entry.viewport,
+            attached_ms: entry.attached_ms,
+            focused: entry.focused,
+        })
+        .collect()
+}
+
+fn new_token() -> String {
+    format!("{:032x}", rand::random::<u128>())
+}
+
+async fn blocking<T: Send + 'static>(
+    call: impl FnOnce() -> Result<T, String> + Send + 'static,
+) -> Result<T, JSONRPCErrorError> {
+    tokio::task::spawn_blocking(call)
+        .await
+        .map_err(|error| internal_error(error.to_string()))?
+        .map_err(invalid_request)
+}
+
+fn to_value(value: impl serde::Serialize) -> Result<Value, JSONRPCErrorError> {
+    serde_json::to_value(value).map_err(|error| internal_error(error.to_string()))
+}
+
+fn closing() -> JSONRPCErrorError {
+    invalid_request("client_surface_closed: the connection is closing")
+}
+
+fn not_attached() -> JSONRPCErrorError {
+    invalid_request("client_not_attached: call omd/client/attach first")
+}
+
+impl OmdClients {
+    pub(crate) fn new(outgoing: Arc<OutgoingMessageSender>) -> Arc<Self> {
+        Arc::new(Self {
+            outgoing,
+            attached: Mutex::new(HashMap::new()),
+            calls: Mutex::new(HashMap::new()),
+            headless: AtomicBool::new(false),
+            internal: AtomicU64::new(u64::MAX),
+            next_client: AtomicU64::new(0),
+        })
+    }
+
+    fn attached(&self) -> std::sync::MutexGuard<'_, HashMap<ConnectionId, Attached>> {
+        self.attached.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn calls(&self) -> std::sync::MutexGuard<'_, HashMap<RequestId, Vec<ConnectionId>>> {
+        self.calls.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn client(
+        &self,
+        connection_id: ConnectionId,
+    ) -> Result<(String, Arc<tokio::sync::Mutex<View>>), JSONRPCErrorError> {
+        self.attached()
+            .get(&connection_id)
+            .map(|attached| (attached.client_id.clone(), Arc::clone(&attached.view)))
+            .ok_or_else(not_attached)
+    }
+
+    pub(crate) fn set_headless(&self) {
+        self.headless.store(true, Ordering::Release);
+    }
+
+    pub(crate) fn set_internal(&self, connection_id: ConnectionId) {
+        self.internal.store(connection_id.0, Ordering::Release);
+    }
+
+    /// The headless host's own `app.request` connection, which never subscribes to threads.
+    pub(crate) fn is_internal(&self, connection_id: ConnectionId) -> bool {
+        self.internal.load(Ordering::Acquire) == connection_id.0
+    }
+
+    pub(crate) fn serving(&self, operation: &str) -> Vec<ConnectionId> {
+        self.attached()
+            .iter()
+            .filter(|(_, attached)| attached.operations.iter().any(|served| served == operation))
+            .map(|(connection_id, _)| *connection_id)
+            .collect()
+    }
+
+    pub(crate) async fn attach(
+        self: &Arc<Self>,
+        request_id: ConnectionRequestId,
+        params: OmdClientAttachParams,
+        gate: &ConnectionRpcGate,
+    ) -> Response {
+        let connection_id = request_id.connection_id;
+        if gate.is_closed() {
+            return Err(closing());
+        }
+        let epoch = wire_epoch(clients::published().as_deref());
+        let replaced = self.attached().remove(&connection_id);
+        if let Some(replaced) = replaced {
+            clients::detached(&replaced.client_id);
+        }
+        let client_id = format!(
+            "client-{}",
+            self.next_client.fetch_add(1, Ordering::Relaxed) + 1
+        );
+        let renderer = Arc::new(Mutex::new(params.renderer.clone()));
+        let entry = client_surface::attach(client_surface::ClientEntry {
+            id: client_id.clone(),
+            name: params.name,
+            renderer: mod_renderer(params.renderer)?,
+            viewport: Value::Null,
+            operations: params.operations.clone(),
+            attached_ms: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|elapsed| elapsed.as_millis() as u64)
+                .unwrap_or_default(),
+            focused: false,
+        });
+        let view = Arc::new(tokio::sync::Mutex::new(View::default()));
+        let initial = Arc::clone(&view).lock_owned().await;
+        let observer = client_surface::register_observer(self.observer(
+            connection_id,
+            Arc::clone(&view),
+            Arc::clone(&renderer),
+        ));
+        let headless = self.headless.load(Ordering::Acquire);
+        let delegable = params
+            .operations
+            .iter()
+            .filter(|operation| headless && delegable(operation))
+            .cloned()
+            .collect();
+        let attached = Attached {
+            client_id: client_id.clone(),
+            operations: params.operations,
+            renderer,
+            view,
+            _observer: observer,
+            _entry: entry,
+        };
+        {
+            // Checked under the lock that `connection_closed` takes after closing the gate.
+            let mut connections = self.attached();
+            if gate.is_closed() {
+                drop(connections);
+                drop(attached);
+                return Err(closing());
+            }
+            connections.insert(connection_id, attached);
+        }
+        let response = OmdClientAttachResponse {
+            client_id,
+            protocol: "omd-client/1".to_string(),
+            epoch,
+            roster: roster(),
+            features: if headless {
+                vec!["surface_call".to_string()]
+            } else {
+                Vec::new()
+            },
+            delegable,
+        };
+        self.outgoing.send_response(request_id, response).await;
+        self.push(connection_id, initial, /*force*/ true).await;
+        Ok(None)
+    }
+
+    fn observer(
+        self: &Arc<Self>,
+        connection_id: ConnectionId,
+        view: Arc<tokio::sync::Mutex<View>>,
+        renderer: Arc<Mutex<OmdRenderer>>,
+    ) -> Arc<dyn Fn(Observed) + Send + Sync> {
+        let clients = Arc::downgrade(self);
+        let delivery = Arc::clone(&renderer);
+        let pending = Arc::new(Mutex::new(std::collections::VecDeque::new()));
+        let receiving = pending.clone();
+        let (ready, mut notified) = tokio::sync::mpsc::channel::<()>(1);
+        tokio::spawn(async move {
+            while notified.recv().await.is_some() {
+                let batch: Vec<_> = receiving
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner)
+                    .drain(..)
+                    .collect();
+                if clients.upgrade().is_none() {
+                    return;
+                }
+                for Queued {
+                    observed, mirror, ..
+                } in batch
+                {
+                    let Some(clients) = clients.upgrade() else {
+                        return;
+                    };
+                    let notification = match observed {
+                        Observed::Redraw => {
+                            let view = Arc::clone(&view).lock_owned().await;
+                            clients.push(connection_id, view, /*force*/ false).await;
+                            continue;
+                        }
+                        Observed::Roster => {
+                            ServerNotification::OmdRosterUpdated(OmdRosterUpdatedNotification {
+                                roster: roster(),
+                            })
+                        }
+                        Observed::Mirrored {
+                            caller,
+                            operation,
+                            mut arguments,
+                            pixels,
+                        } => {
+                            if let Mirror::Image(_) | Mirror::Raw = mirror {
+                                let size = clients::published().and_then(|snapshot| {
+                                    snapshot
+                                        .view
+                                        .raster_size(arguments["key"].as_str().unwrap_or_default())
+                                });
+                                let renderer = Arc::clone(&delivery);
+                                let routed = tokio::task::spawn_blocking(move || {
+                                    match (mirror, pixels.as_deref()) {
+                                        (Mirror::Image(format), _) => {
+                                            blit_for(&renderer, format, &arguments, size)
+                                        }
+                                        (_, Some(pixels)) => {
+                                            raw_blit_for(&renderer, &arguments, size, pixels)
+                                        }
+                                        (_, None) => None,
+                                    }
+                                })
+                                .await;
+                                let Ok(Some(routed)) = routed else {
+                                    continue;
+                                };
+                                arguments = routed;
+                            }
+                            ServerNotification::OmdSurfaceMirrored(OmdSurfaceMirroredNotification {
+                                caller,
+                                operation,
+                                arguments,
+                            })
+                        }
+                    };
+                    clients
+                        .outgoing
+                        .send_server_notification_to_connections(&[connection_id], notification)
+                        .await;
+                }
+            }
+        });
+        Arc::new(move |observed| {
+            let Some(mirror) = Mirror::of(&observed).filter(|mirror| mirror.reaches(&renderer))
+            else {
+                return;
+            };
+            queue_observation(
+                &mut pending.lock().unwrap_or_else(PoisonError::into_inner),
+                observed,
+                mirror,
+            );
+            let _ = ready.try_send(());
+        })
+    }
+
+    async fn push(
+        &self,
+        connection_id: ConnectionId,
+        mut view: OwnedMutexGuard<View>,
+        force: bool,
+    ) {
+        let published = clients::published();
+        let pushed = pushed_key(published.as_deref());
+        if !force && view.pushed.as_ref() == Some(&pushed) {
+            return;
+        }
+        let (epoch, revision) = bound(published.as_deref());
+        let epoch_wire = wire_epoch(published.as_deref());
+        let Ok(snapshot) = serialized(published).await else {
+            return;
+        };
+        let action_token = view.token_for(epoch, revision);
+        view.pushed = Some(pushed);
+        self.outgoing
+            .send_server_notification_to_connections(
+                &[connection_id],
+                ServerNotification::OmdViewUpdated(OmdViewUpdatedNotification {
+                    epoch: epoch_wire,
+                    revision,
+                    snapshot,
+                    action_token,
+                }),
+            )
+            .await;
+    }
+
+    pub(crate) async fn update(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdClientUpdateParams,
+    ) -> Response {
+        let client_id = {
+            let attached = self.attached();
+            let attached = attached.get(&connection_id).ok_or_else(not_attached)?;
+            if let Some(renderer) = &params.renderer {
+                *attached
+                    .renderer
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner) = renderer.clone();
+            }
+            attached.client_id.clone()
+        };
+        client_surface::update(
+            &client_id,
+            params.renderer.map(mod_renderer).transpose()?,
+            params.viewport.map(to_value).transpose()?,
+            params.focus,
+        );
+        Ok(Some(OmdClientUpdateResponse {}.into()))
+    }
+
+    pub(crate) async fn detach(&self, connection_id: ConnectionId) -> Response {
+        self.client(connection_id)?;
+        self.connection_closed(connection_id).await;
+        Ok(Some(OmdClientDetachResponse {}.into()))
+    }
+
+    pub(crate) async fn view_read(&self, connection_id: ConnectionId) -> Response {
+        let (_, view) = self.client(connection_id)?;
+        let published = clients::published();
+        let (epoch, revision) = bound(published.as_deref());
+        let epoch_wire = wire_epoch(published.as_deref());
+        let snapshot = serialized(published).await?;
+        let action_token = view.lock().await.token_for(epoch, revision);
+        Ok(Some(
+            OmdViewReadResponse {
+                epoch: epoch_wire,
+                revision,
+                snapshot,
+                action_token,
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn event(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdClientEventParams,
+    ) -> Response {
+        let (client_id, _) = self.client(connection_id)?;
+        if params.epoch != wire_epoch(clients::published().as_deref()) {
+            return Err(invalid_request(
+                "view_stale: the host restarted; re-read the view",
+            ));
+        }
+        let result =
+            blocking(move || clients::component_event(&client_id, &params.component, params.event))
+                .await?;
+        Ok(Some(
+            OmdClientEventResponse {
+                delivered: result["delivered"].as_bool().unwrap_or(true),
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn action(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdActionParams,
+    ) -> Response {
+        let (client_id, view) = self.client(connection_id)?;
+        // clients::action rejects a snapshot other than the one the token was spent against.
+        let (epoch, revision) = bound(clients::published().as_deref());
+        let (action_token, (epoch, revision)) = {
+            let mut view = view.lock().await;
+            view.token_for(epoch, revision);
+            view.spend(&params.action_token)?
+        };
+        let result = blocking(move || {
+            clients::action(
+                &client_id,
+                epoch,
+                revision,
+                &params.component,
+                params.row.map(|row| row as usize),
+                params.value,
+            )
+        })
+        .await?;
+        Ok(Some(
+            OmdActionResponse {
+                status: result["status"].as_str().unwrap_or("completed").to_string(),
+                outcome: result["result"].clone(),
+                action_token,
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn render(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdRenderParams,
+    ) -> Response {
+        let (client_id, _) = self.client(connection_id)?;
+        let result =
+            blocking(move || clients::render(&client_id, &params.slot, params.props)).await?;
+        Ok(Some(
+            OmdRenderResponse {
+                original: result["original"].clone(),
+                effective: result["effective"].clone(),
+                tree: result["tree"].clone(),
+                answered_by: result["answeredBy"].as_str().map(str::to_owned),
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn resource_read(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdResourceReadParams,
+    ) -> Response {
+        self.client(connection_id)?;
+        let (media_type, bytes) = blocking(move || clients::resource(&params.reference)).await?;
+        Ok(Some(
+            OmdResourceReadResponse {
+                media_type,
+                sha256: format!("{:x}", sha2::Sha256::digest(&bytes)),
+                data: base64::engine::general_purpose::STANDARD.encode(bytes),
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn recovery_read(&self, connection_id: ConnectionId) -> Response {
+        self.client(connection_id)?;
+        let result = blocking(clients::recovery_read).await?;
+        Ok(Some(OmdRecoveryReadResponse(result).into()))
+    }
+
+    pub(crate) async fn recovery_apply(
+        &self,
+        connection_id: ConnectionId,
+        params: OmdRecoveryApplyParams,
+    ) -> Response {
+        if params.action != OmdRecoveryAction::Reload {
+            self.client(connection_id)?;
+        }
+        let action = to_value(params.action)?
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        let result = blocking(move || clients::recovery_apply(&action, &params.target)).await?;
+        Ok(Some(OmdRecoveryApplyResponse(result).into()))
+    }
+
+    /// Sends `omd/surface/call` to `targets`; the first answer wins, unless the mod's call ends first.
+    pub(crate) async fn surface_call(
+        &self,
+        targets: Vec<ConnectionId>,
+        params: OmdSurfaceCallParams,
+        active: impl Fn() -> bool + Send,
+    ) -> Result<Value, String> {
+        let (request_id, answer) = self
+            .outgoing
+            .send_request_to_connections(
+                Some(&targets),
+                ServerRequestPayload::OmdSurfaceCall(params),
+                /*thread_id*/ None,
+            )
+            .await;
+        let closed = {
+            // Holding `attached` orders this against a concurrent close's `fail_calls`.
+            let attached = self.attached();
+            let live = targets
+                .into_iter()
+                .filter(|target| attached.contains_key(target))
+                .collect::<Vec<_>>();
+            let closed = live.is_empty();
+            if !closed {
+                self.calls().insert(request_id.clone(), live);
+            }
+            closed
+        };
+        if closed {
+            self.outgoing.cancel_request(&request_id).await;
+        }
+        let ended = async {
+            while active() {
+                tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            }
+        };
+        let answer = tokio::select! {
+            answer = answer => Some(answer),
+            () = ended => None,
+        };
+        self.calls().remove(&request_id);
+        match answer {
+            Some(Ok(Ok(result))) => Ok(result),
+            Some(Ok(Err(error))) => Err(error.message),
+            Some(Err(_)) => Err("client_surface_closed".to_string()),
+            None => {
+                self.outgoing.cancel_request(&request_id).await;
+                Err("callback_cancelled".to_string())
+            }
+        }
+    }
+
+    async fn fail_calls(&self, connection_id: ConnectionId) {
+        let closed = {
+            let mut calls = self.calls();
+            for targets in calls.values_mut() {
+                targets.retain(|target| *target != connection_id);
+            }
+            let closed = calls
+                .iter()
+                .filter(|(_, targets)| targets.is_empty())
+                .map(|(request_id, _)| request_id.clone())
+                .collect::<Vec<_>>();
+            for request_id in &closed {
+                calls.remove(request_id);
+            }
+            closed
+        };
+        for request_id in closed {
+            self.outgoing.cancel_request(&request_id).await;
+        }
+    }
+
+    pub(crate) async fn connection_closed(&self, connection_id: ConnectionId) {
+        let detached = self.attached().remove(&connection_id);
+        if let Some(detached) = detached {
+            clients::detached(&detached.client_id);
+        }
+        self.fail_calls(connection_id).await;
+    }
+}
