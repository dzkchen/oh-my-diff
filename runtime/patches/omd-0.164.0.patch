+#[test]
+#[serial_test::serial]
+fn queued_surface_calls_reject_thread_round_trip_and_cancelled_confirmation() {
+    struct Restore {
+        mode: Option<std::ffi::OsString>,
+        previous: Option<State>,
+    }
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            *STATE.locked() = self.previous.take();
+            match self.mode.take() {
+                Some(mode) => unsafe { std::env::set_var(codex_omd::MODE_ENV, mode) },
+                None => unsafe { std::env::remove_var(codex_omd::MODE_ENV) },
+            }
+        }
+    }
+    let _restore = Restore {
+        mode: std::env::var_os(codex_omd::MODE_ENV),
+        previous: STATE.locked().take(),
+    };
+    unsafe { std::env::set_var(codex_omd::MODE_ENV, "omd") };
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let sender = AppEventSender::new(tx);
+    attach(&sender, Some("surface-a".to_owned()));
+    let pending = codex_omd::client_surface::submit(
+        codex_omd::broker::HOST_CALLER,
+        "composer.read",
+        json!({}),
+        InvocationContext::User,
+        false,
+        Some("surface-a"),
+        None,
+    )
+    .unwrap();
+    let AppEvent::ModSurfaceCall(call, _) = rx.try_recv().unwrap() else {
+        panic!("expected queued call");
+    };
+    assert!(validate_call(&call).is_ok());
+    attach(&sender, Some("surface-b".to_owned()));
+    assert_eq!(
+        validate_call(&call).unwrap_err(),
+        "client_surface_context_changed"
+    );
+    attach(&sender, Some("surface-a".to_owned()));
+    assert_eq!(
+        validate_call(&call).unwrap_err(),
+        "client_surface_context_changed"
+    );
+    drop(pending);
+    let pending = codex_omd::client_surface::submit(
+        codex_omd::broker::HOST_CALLER,
+        "composer.write",
+        json!({"text":"must not be applied"}),
+        InvocationContext::User,
+        false,
+        Some("surface-a"),
+        Some("Confirm".into()),
+    )
+    .unwrap();
+    let AppEvent::ModSurfaceCall(call, _) = rx.try_recv().unwrap() else {
+        panic!("expected confirmation");
+    };
+    let id = hold(*call);
+    drop(pending);
+    assert_eq!(
+        validate_call(&release(id).unwrap()).unwrap_err(),
+        "callback_cancelled_or_expired"
+    );
+}
