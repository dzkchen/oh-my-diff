+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::time::Duration;
+
+use codex_code_mode::CellId;
+use codex_code_mode::CodeModeNestedToolCall;
+use codex_code_mode::CodeModeToolKind;
+use codex_code_mode::ToolDefinition;
+use codex_tools::ToolName;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+use super::submit_nested_tool;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::tools::parallel::ToolCallRuntime;
+
+const MAX_CODE_BYTES: usize = 32768;
+const MAX_BRIDGE_CALLS: usize = 32;
+const MAX_BRIDGE_REQUEST_BYTES: u64 = 65536;
+const MAX_BRIDGE_RESPONSE_BYTES: usize = 262144;
+const MAX_CELL_DURATION: Duration = Duration::from_secs(120);
+const RESULT_PREFIX: &str = "CODE_KERNEL_RESULT:";
+const MAX_DRIVER_BYTES: u64 = 262144;
+pub(crate) const TOOL_NAME: &str = "kernel";
+
+fn kernel_name(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 32
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_' || byte == b'-'
+        })
+}
+
+fn shell_word(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn kernel_command(kernel: &codex_features::CodeModeKernelToml) -> Result<String, String> {
+    if !kernel_name(&kernel.name)
+        || kernel.command.is_empty()
+        || kernel.command.len() > 16
+        || kernel
+            .command
+            .iter()
+            .any(|arg| arg.is_empty() || arg.contains('\0'))
+        || !kernel.driver.is_absolute()
+        || kernel.driver_sha256.len() != 64
+    {
+        return Err(format!("kernel {} configuration is invalid", kernel.name));
+    }
+    let metadata = std::fs::symlink_metadata(&kernel.driver)
+        .map_err(|error| format!("kernel {} driver unavailable: {error}", kernel.name))?;
+    if !metadata.is_file() || metadata.len() > MAX_DRIVER_BYTES {
+        return Err(format!(
+            "kernel {} driver is not a bounded regular file",
+            kernel.name
+        ));
+    }
+    let bytes = std::fs::read(&kernel.driver).map_err(|error| error.to_string())?;
+    let digest = format!("{:x}", <sha2::Sha256 as sha2::Digest>::digest(&bytes));
+    if !digest.eq_ignore_ascii_case(&kernel.driver_sha256) {
+        return Err(format!("kernel {} driver changed", kernel.name));
+    }
+    let driver = String::from_utf8(bytes).map_err(|_| "kernel driver must be UTF-8".to_string())?;
+    let words = kernel
+        .command
+        .iter()
+        .map(|arg| shell_word(arg))
+        .chain(std::iter::once(shell_word(&driver)))
+        .collect::<Vec<_>>();
+    Ok(format!("stty raw -echo; {}", words.join(" ")))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct KernelRequest {
+    kernel: String,
+    code: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BridgeRequest {
+    token: String,
+    name: String,
+    arguments: Value,
+}
+
+#[derive(Deserialize)]
+struct WorkerResult {
+    ok: bool,
+    output: String,
+    error: Option<String>,
+    #[serde(default)]
+    bridge_failed: bool,
+}
+
+pub(crate) fn definition(kernels: &[codex_features::CodeModeKernelToml]) -> ToolDefinition {
+    let names = kernels
+        .iter()
+        .map(|kernel| kernel.name.as_str())
+        .collect::<Vec<_>>()
+        .join("', '");
+    ToolDefinition {
+        name: TOOL_NAME.into(),
+        tool_name: ToolName::plain(TOOL_NAME),
+        description: format!(
+            "Run a cell in a persistent configured interpreter kernel. Within the cell, tool(name, arguments) calls the currently authorized agent tools through the loopback bridge. Input: {{kernel: '{names}', code: string}}. Output is bounded."
+        ),
+        kind: CodeModeToolKind::Function,
+        input_schema: None,
+        input_schema_max_bytes: None,
+        output_schema: None,
+    }
+}
+
+type WorkerSlot = Arc<Mutex<Option<WorkerState>>>;
+
+pub(super) struct KernelManager {
+    workers: std::sync::Mutex<HashMap<String, WorkerSlot>>,
+    live: std::sync::Mutex<HashMap<String, i32>>,
+    active: AtomicBool,
+}
+
+struct WorkerState {
+    process_id: i32,
+    listener: Arc<TcpListener>,
+    port: u16,
+    scope: String,
+}
+
+impl KernelManager {
+    pub(super) fn new() -> Self {
+        Self {
+            workers: std::sync::Mutex::new(HashMap::new()),
+            live: std::sync::Mutex::new(HashMap::new()),
+            active: AtomicBool::new(false),
+        }
+    }
+
+    pub(super) fn has_workers(&self) -> bool {
+        self.active.load(Ordering::Acquire)
+    }
+
+    fn track(&self, language: &str, process_id: Option<i32>) {
+        if let Ok(mut live) = self.live.lock() {
+            match process_id {
+                Some(process_id) => live.insert(language.to_owned(), process_id),
+                None => live.remove(language),
+            };
+            self.active.store(!live.is_empty(), Ordering::Release);
+        }
+    }
+
+    async fn retire(&self, session: &Arc<Session>, language: &str, worker: WorkerState) {
+        self.track(language, None);
+        session
+            .services
+            .unified_exec_manager
+            .terminate_process(worker.process_id)
+            .await;
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "one cell at a time per language worker"
+    )]
+    pub(super) async fn run(
+        &self,
+        session: Arc<Session>,
+        step_context: Arc<StepContext>,
+        runtime: ToolCallRuntime,
+        invocation: CodeModeNestedToolCall,
+        enabled_tools: Vec<ToolDefinition>,
+        cancellation: CancellationToken,
+    ) -> Result<Value, String> {
+        let kernels = &step_context.turn.config.code_mode.kernels;
+        if kernels.is_empty() {
+            return Err("no code-mode kernels are configured".into());
+        }
+        let input = invocation.input.ok_or("kernel input is required")?;
+        let request: KernelRequest =
+            serde_json::from_value(input).map_err(|error| error.to_string())?;
+        let kernel = kernels
+            .iter()
+            .find(|kernel| kernel.name == request.kernel)
+            .ok_or_else(|| format!("kernel {} is not configured", request.kernel))?;
+        let language = kernel.name.as_str();
+        if request.code.len() > MAX_CODE_BYTES {
+            return Err("kernel code limit exceeded".into());
+        }
+        if !enabled_tools.iter().any(|tool| tool.name == "exec_command")
+            || !enabled_tools.iter().any(|tool| tool.name == "write_stdin")
+        {
+            return Err("managed process tools are unavailable in this cell".into());
+        }
+        let cell_cancel = cancellation.child_token();
+        let slot = Arc::clone(
+            self.workers
+                .lock()
+                .map_err(|_| "kernel workers poisoned")?
+                .entry(language.to_owned())
+                .or_default(),
+        );
+        let mut worker = slot.lock().await;
+        let environment = step_context
+            .environments
+            .primary()
+            .ok_or("kernel workers require a turn environment")?;
+        let cwd = environment
+            .cwd()
+            .to_abs_path()
+            .map_err(|error| error.to_string())?;
+        let scope = serde_json::to_string(&(cwd.as_path(), environment.permission_profile()))
+            .map_err(|error| error.to_string())?;
+        if let Some(stale) = worker.take_if(|worker| worker.scope != scope) {
+            self.retire(&session, language, stale).await;
+        }
+        let (process_id, listener, port) = if let Some(worker) = worker.as_ref() {
+            (worker.process_id, Arc::clone(&worker.listener), worker.port)
+        } else {
+            let listener = Arc::new(
+                TcpListener::bind("127.0.0.1:0")
+                    .await
+                    .map_err(|error| format!("kernel loopback bridge unavailable: {error}"))?,
+            );
+            let port = listener
+                .local_addr()
+                .map_err(|error| error.to_string())?
+                .port();
+            let result = native_call(
+                Arc::clone(&session),
+                Arc::clone(&step_context),
+                runtime.clone(),
+                &invocation.cell_id,
+                "exec_command",
+                json!({
+                    "cmd": kernel_command(kernel)?,
+                    "workdir": cwd.as_path().to_string_lossy(),
+                    "tty": true,
+                    "yield_time_ms": 1000,
+                    "max_output_tokens": 256
+                }),
+                cell_cancel.clone(),
+                Some(port),
+            )
+            .await?;
+            let process_id = result["session_id"]
+                .as_i64()
+                .and_then(|value| i32::try_from(value).ok())
+                .ok_or_else(|| {
+                    format!("{language} worker failed to start: {}", result["output"])
+                })?;
+            *worker = Some(WorkerState {
+                process_id,
+                listener: Arc::clone(&listener),
+                port,
+                scope,
+            });
+            self.track(language, Some(process_id));
+            (process_id, listener, port)
+        };
+
+        let token = uuid::Uuid::new_v4().to_string();
+        let bridge_cancel = cell_cancel.child_token();
+        let bridge = tokio::spawn(serve_bridge(
+            listener,
+            token.clone(),
+            invocation.cell_id.clone(),
+            Arc::clone(&session),
+            Arc::clone(&step_context),
+            runtime.clone(),
+            enabled_tools,
+            bridge_cancel.clone(),
+        ));
+        let payload =
+            json!({"code": request.code, "port": port, "token": token}).to_string() + "\n";
+        let result = tokio::time::timeout(MAX_CELL_DURATION, async {
+            let mut buffer = String::new();
+            let mut chars = payload;
+            loop {
+                let result = native_call(
+                    Arc::clone(&session),
+                    Arc::clone(&step_context),
+                    runtime.clone(),
+                    &invocation.cell_id,
+                    "write_stdin",
+                    json!({
+                        "session_id": process_id,
+                        "chars": chars,
+                        "yield_time_ms": if chars.is_empty() { 5000 } else { 1000 },
+                        "max_output_tokens": MAX_BRIDGE_RESPONSE_BYTES
+                    }),
+                    cell_cancel.clone(),
+                    None,
+                )
+                .await?;
+                chars.clear();
+                if let Some(output) = result["output"].as_str() {
+                    buffer.push_str(output);
+                }
+                if buffer.len() > MAX_BRIDGE_RESPONSE_BYTES {
+                    return Err("kernel output limit exceeded".into());
+                }
+                if let Some(result) = parse_worker_result(&buffer)? {
+                    return Ok(result);
+                }
+                if result["session_id"].is_null() {
+                    return Err("kernel worker disconnected".into());
+                }
+            }
+        })
+        .await
+        .unwrap_or_else(|_| Err("kernel cell timed out".to_string()));
+        cell_cancel.cancel();
+        bridge_cancel.cancel();
+        bridge.abort();
+        if (result.as_ref().map_or(true, |worker| worker.bridge_failed)
+            || cancellation.is_cancelled())
+            && let Some(failed) = worker.take()
+        {
+            self.retire(&session, language, failed).await;
+        }
+        let result = result?;
+        Ok(
+            json!({"kernel": language, "ok": result.ok, "output": result.output, "error": result.error}),
+        )
+    }
+
+    pub(super) async fn shutdown(&self, session: &Arc<Session>) {
+        if let Ok(mut workers) = self.workers.lock() {
+            workers.clear();
+        }
+        let live = self
+            .live
+            .lock()
+            .map(|mut live| {
+                live.drain()
+                    .map(|(_, process_id)| process_id)
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        self.active.store(false, Ordering::Release);
+        for process_id in live {
+            session
+                .services
+                .unified_exec_manager
+                .terminate_process(process_id)
+                .await;
+        }
+    }
+}
+
+fn parse_worker_result(buffer: &str) -> Result<Option<WorkerResult>, String> {
+    let Some(start) = buffer.find(RESULT_PREFIX) else {
+        return Ok(None);
+    };
+    let body = &buffer[start + RESULT_PREFIX.len()..];
+    let Some(end) = body.find('\n') else {
+        return Ok(None);
+    };
+    serde_json::from_str(&body[..end])
+        .map(Some)
+        .map_err(|error| format!("invalid kernel result: {error}"))
+}
