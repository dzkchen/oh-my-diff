+async fn intercept_user_input(
+    session: &Arc<Session>,
+    mut request: TurnInputRequest,
+    submission_id: &str,
+) -> CodexResult<TurnInputRequest> {
+    let contributors = session.services.extensions.turn_lifecycle_contributors();
+    if let SubmittedTurnInput::UserInput {
+        content, client_id, ..
+    } = &mut request.input
+    {
+        intercept_user_text(session, content, client_id.as_deref(), submission_id).await?;
+    }
+    // Mods reload while intercepting input, so read their disabled modes afterwards.
+    let disabled = contributors
+        .iter()
+        .flat_map(|contributor| contributor.disabled_collaboration_modes())
+        .collect::<Vec<_>>();
+    if !disabled.is_empty() {
+        let requested = match &request.thread_settings.collaboration_mode {
+            Some(mode) => mode.clone(),
+            None => session.collaboration_mode().await,
+        };
+        let name = requested.mode.display_name();
+        if crate::thread_manager::mode_is_disabled(&disabled, requested.mode) {
+            request.thread_settings.collaboration_mode =
+                Some(codex_protocol::config_types::CollaborationMode {
+                    mode: codex_protocol::config_types::ModeKind::Default,
+                    settings: codex_protocol::config_types::Settings {
+                        developer_instructions: None,
+                        ..requested.settings
+                    },
+                });
+            session
+                .send_event_raw(Event {
+                    id: submission_id.to_string(),
+                    msg: EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                        message: format!(
+                            "The {name} collaboration mode is disabled by an installed mod; this turn uses the default mode."
+                        ),
+                    }),
+                })
+                .await;
+        }
+    }
+    Ok(request)
+}
+
+async fn intercept_user_text(
+    session: &Arc<Session>,
+    content: &mut Vec<UserInput>,
+    client_id: Option<&str>,
+    submission_id: &str,
+) -> CodexResult<()> {
+    let contributors = session.services.extensions.turn_lifecycle_contributors();
+    if contributors.is_empty() {
+        return Ok(());
+    }
+    for item in content.iter() {
+        let (source, bytes) = match item {
+            UserInput::LocalImage { path, .. } => (
+                path.display().to_string(),
+                tokio::fs::read(path).await.unwrap_or_default(),
+            ),
+            UserInput::Image { image, .. } => (
+                "image".to_string(),
+                serde_json::to_vec(image).unwrap_or_default(),
+            ),
+            _ => continue,
+        };
+        session
+            .notify_instructions_loaded("attachment", &source, &bytes, "explicit", None)
+            .await;
+    }
+    let mut text = content
+        .iter()
+        .filter_map(|item| match item {
+            UserInput::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    if text.is_empty() {
+        return Ok(());
+    }
+    let attachments = content
+        .iter()
+        .filter(|item| !matches!(item, UserInput::Text { .. }))
+        .count();
+    let items = content
+        .iter()
+        .filter_map(|item| serde_json::to_value(item).ok())
+        .collect::<Vec<_>>();
+    for contributor in contributors {
+        let decision = contributor
+            .intercept_user_input(codex_extension_api::UserInputInterceptInput {
+                text: &text,
+                attachments,
+                client_id,
+                items: &items,
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+            })
+            .await;
+        match decision {
+            codex_extension_api::UserInputDecision::Keep => {}
+            codex_extension_api::UserInputDecision::Deny { notice } => {
+                return Err(CodexErr::InvalidRequest(notice));
+            }
+            codex_extension_api::UserInputDecision::Rewrite {
+                text: rewritten,
+                notice,
+            } => {
+                let position = content
+                    .iter()
+                    .position(|item| matches!(item, UserInput::Text { .. }))
+                    .unwrap_or(0);
+                content.retain(|item| !matches!(item, UserInput::Text { .. }));
+                content.insert(
+                    position.min(content.len()),
+                    UserInput::Text {
+                        text: rewritten.clone(),
+                        text_elements: Vec::new(),
+                    },
+                );
+                text = rewritten;
+                session
+                    .send_event_raw(Event {
+                        id: submission_id.to_string(),
+                        msg: EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                            message: notice,
+                        }),
+                    })
+                    .await;
+            }
+        }
+    }
+    Ok(())
+}
