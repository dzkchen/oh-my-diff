+            &ToolName::namespaced(&invocation.server, &invocation.tool),
+            &HookToolName::new("mcp__memory__create_entities"),
+            &metadata,
+            &approval_config(&turn_context),
+            turn_context.config.permissions.permission_profile(),
+            McpToolApprovalPolicy::for_server(mode),
+        )
+        .await;
+        assert!(
+            matches!(
+                decision,
+                Some(McpToolApproval {
+                    decision: ReviewDecision::Denied { .. },
+                    ..
+                })
+            ),
+            "{mode:?}: {decision:?}"
+        );
+    }
+    let seen = gate.0.lock().unwrap().clone();
+    let entry = |kind: &str, decision: &str, source: &str| {
+        (kind.to_owned(), decision.to_owned(), source.to_owned())
+    };
+    let denied = [
+        entry("mcp_tool", "skip", "gate"),
+        entry("mcp_tool", "denied", "mod"),
+    ];
+    assert_eq!(seen, [denied.clone(), denied.clone(), denied].concat());
+}
