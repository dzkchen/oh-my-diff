+static FACTS: Mutex<Option<Facts>> = Mutex::new(None);
+static PIXEL_MODE: AtomicBool = AtomicBool::new(false);
+static RERENDER: AtomicBool = AtomicBool::new(false);
+static HALF: AtomicU8 = AtomicU8::new(HALF_UNKNOWN);
+static FRACTION: Mutex<Option<(f64, f64)>> = Mutex::new(None);
+fn with<T>(run: impl FnOnce(&mut Facts) -> T) -> T {
+    let mut facts = FACTS.locked();
+    run(facts.get_or_insert_with(|| {
+        if cfg!(test) {
+            Facts::default()
+        } else {
+            Facts::detect()
+        }
+    }))
+}
