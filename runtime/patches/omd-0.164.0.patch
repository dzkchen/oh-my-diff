+#[serial_test::serial]
+fn startup_preview_stays_until_a_publication_matches_the_attached_thread() {
+    let store = tempfile::tempdir().unwrap();
+    let repository = store.path().canonicalize().unwrap();
+    let _environment = crate::omd::tests::omd_environment(&repository);
+    let publish = |snapshot: &ModViewSnapshot| {
+        std::fs::write(
+            repository.join("mod-view.json"),
+            serde_json::to_vec(snapshot).unwrap(),
+        )
+        .unwrap();
+    };
+    publish(&ModViewSnapshot::default());
+    let mut startup = snapshot(serde_json::json!({"greeting": "preview"}));
+    startup.input = serde_json::json!({"event": "startup", "ledger": null,
+        "presentation": {"thread_id": null, "phase": "fresh"}});
+    startup_preview(Some(startup), &repository);
+    let thread = codex_protocol::ThreadId::new();
+    let attach = |thread_id| {
+        crate::mod_runtime::synchronize_context(crate::mod_runtime::ModContext {
+            thread_id,
+            repository: repository.clone(),
+            policy: codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted(),
+        });
+        invalidate_context();
+        refresh();
+    };
+    attach(Some(thread));
+    let mut thread_less = snapshot(serde_json::json!({"greeting": "thread-less"}));
+    thread_less.epoch = 1;
+    thread_less.input = serde_json::json!({"event": "start",
+        "ledger": {"thread_id": null, "cwd": repository}});
+    publish(&thread_less);
+    refresh();
+    assert_eq!(greeting().as_deref(), Some("preview"));
+    let mut live = snapshot(serde_json::json!({"greeting": "live"}));
+    live.epoch = 1;
+    live.revision = 1;
+    live.input = serde_json::json!({"event": "start",
+        "ledger": {"thread_id": thread.to_string(), "cwd": repository}});
+    publish(&live);
+    refresh();
+    assert_eq!(greeting().as_deref(), Some("live"));
+    attach(None);
+}
