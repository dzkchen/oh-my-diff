+fn payload(arguments: serde_json::Value) -> Result<ToolPayload, String> {
+    match arguments {
+        serde_json::Value::String(input) => Ok(ToolPayload::Custom { input }),
+        serde_json::Value::Object(arguments) => Ok(ToolPayload::Function {
+            arguments: serde_json::Value::Object(arguments).to_string(),
+        }),
+        _ => Err("tool_arguments_invalid".to_owned()),
+    }
+}
