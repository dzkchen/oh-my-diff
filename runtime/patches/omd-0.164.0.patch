+#[test]
+fn callback_budget_errors_fail_the_call_without_disabling_the_mod() {
+    let source = "export default api => api.command('run', arg => { if (arg === 'small') return 'ok'; if (arg === 'recover') { try { api.host.call('task.status'); } catch {} return api.host.call('task.status'); } api.host.call('task.status'); api.host.call('task.status'); return 'unreachable'; })";
+    let (temp, _, _) = fixture(source, &["commands", "agents"]);
+    let mut runtime = host(&temp);
+    let generation = runtime.generation();
+    let error = runtime
+        .invoke_with(
+            "fixture",
+            generation,
+            "command",
+            "run",
+            json!("large"),
+            || true,
+            |_| Ok(json!({"text": "x".repeat(1_100_000)})),
+        )
+        .unwrap_err();
+    assert!(
+        error.to_string().starts_with("Error: host_result_limit"),
+        "{error}"
+    );
+    let mut calls = 0;
+    let error = runtime
+        .invoke_with(
+            "fixture",
+            generation,
+            "command",
+            "run",
+            json!("cumulative"),
+            || true,
+            |_| {
+                calls += 1;
+                Ok(json!({"text": "x".repeat(600_000)}))
+            },
+        )
+        .unwrap_err();
+    assert_eq!(calls, 2);
+    assert!(
+        error.to_string().starts_with("Error: host_result_limit"),
+        "{error}"
+    );
+    let mut calls = 0;
+    let recovered = runtime
+        .invoke_with(
+            "fixture",
+            generation,
+            "command",
+            "run",
+            json!("recover"),
+            || true,
+            |_| {
+                calls += 1;
+                Ok(if calls == 1 {
+                    json!({"text": "x".repeat(1_100_000)})
+                } else {
+                    json!("recovered")
+                })
+            },
+        )
+        .unwrap();
+    assert_eq!(calls, 2);
+    assert_eq!(recovered, json!("recovered"));
+    assert_eq!(
+        runtime
+            .invoke_with(
+                "fixture",
+                generation,
+                "command",
+                "run",
+                json!("small"),
+                || true,
+                |_| { Ok(Value::Null) }
+            )
+            .unwrap(),
+        json!("ok")
+    );
+}
