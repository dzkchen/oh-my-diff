+    turn(&test, "turn two").await?;
+
+    let startup_requests = startup_log.requests();
+    assert_eq!(startup_requests.len(), 3);
+    assert_eq!(
+        startup_requests[2].inputs_of_type("compaction")[0]["encrypted_content"],
+        "OPENAI_ONLY_SUMMARY"
+    );
+    let other_requests = other_log.requests();
+    assert_eq!(other_requests.len(), 1);
+    let switched = other_requests[0].input();
+    assert!(mentions(&switched, "PLAINTEXT_SUMMARY") && mentions(&switched, "turn two"));
+    assert!(!mentions(&switched, "OPENAI_ONLY_SUMMARY"));
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_failed_compaction_carry_runs_the_turn_without_the_summary() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let startup = start_mock_server().await;
+    let other = start_mock_server().await;
+    let compaction = sse(vec![
+        json!({
+            "type": "response.output_item.done",
+            "item": {"type": "compaction", "encrypted_content": "OPENAI_ONLY_SUMMARY"},
+        }),
+        ev_completed("a2"),
+    ]);
+    let startup_log = mount_response_sequence(
+        &startup,
+        vec![
+            sse_response(reply("a1", "FIRST")),
+            sse_response(compaction),
+            wiremock::ResponseTemplate::new(400),
+        ],
+    )
+    .await;
+    let other_log =
+        mount_sse_sequence(&other, vec![reply("b1", "SECOND"), reply("b2", "THIRD")]).await;
+    runtime_provider("carry_failure", "carry-failure-model", &other);
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .build(&startup)
+        .await?;
+
+    turn(&test, "turn one").await?;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    switch(&test, "carry_failure", "carry-failure-model").await?;
+    turn(&test, "turn two").await?;
+    turn(&test, "turn three").await?;
+
+    assert_eq!(startup_log.requests().len(), 3);
+    let other_requests = other_log.requests();
+    assert_eq!(other_requests.len(), 2);
+    assert!(mentions(&other_requests[0].input(), "turn two"));
+    assert!(!mentions(&other_requests[0].input(), "OPENAI_ONLY_SUMMARY"));
+    Ok(())
+}
