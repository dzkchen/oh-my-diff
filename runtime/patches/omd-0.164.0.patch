index 0000000000000000000000000000000000000000..fe9f4ff31a9409f81d5f9b0c221407009af9ee05
--- /dev/null
+++ b/codex-rs/omd/src/watch_filter.rs
@@ -0,0 +1,23 @@
+use ignore::gitignore::{Gitignore, GitignoreBuilder};
+use std::path::Path;
+
+pub struct WatchFilter(Gitignore);
+
+impl WatchFilter {
+    pub fn new(root: &Path) -> Self {
+        let mut builder = GitignoreBuilder::new(root);
+        for file in [root.join(".gitignore"), root.join(".git/info/exclude")] {
+            if file.is_file() {
+                let _ = builder.add(file);
+            }
+        }
+        Self(builder.build().unwrap_or_else(|_| Gitignore::empty()))
+    }
+
+    pub fn ignored(&self, root: &Path, relative: &str) -> bool {
+        let path = root.join(relative);
+        self.0
+            .matched_path_or_any_parents(&path, path.is_dir())
+            .is_ignore()
+    }
+}
diff --git a/codex-rs/omd/src/workspace.rs b/codex-rs/omd/src/workspace.rs
