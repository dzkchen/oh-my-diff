+    async fn ensure_rewrite_idle(&self, thread_id: ThreadId) -> Result<(), JSONRPCErrorError> {
+        if matches!(
+            self.thread_watch_manager
+                .loaded_status_for_thread(&thread_id.to_string())
+                .await,
+            ThreadStatus::Active { .. }
+        ) {
+            return Err(rewrite_busy_error(thread_id));
+        }
+        Ok(())
+    }
+
+    async fn read_history_rows(
+        &self,
+        thread_id: ThreadId,
+        author: String,
+    ) -> Result<codex_thread_store::ThreadRewrite, JSONRPCErrorError> {
+        self.thread_store
+            .rewrite_thread(codex_thread_store::RewriteThreadParams {
+                thread_id,
+                expected_revision: None,
+                edits: Vec::new(),
+                undo: false,
+                author,
+                multi_agent_version: None,
+                witness: None,
+                dry_run: false,
+            })
+            .await
+            .map_err(|err| thread_store_mutation_error("read", err))
+    }
+
+    async fn unload_for_history_replacement(
+        &self,
+        request_id: &ConnectionRequestId,
+        thread_id: ThreadId,
+        thread: &Arc<CodexThread>,
+        outcome: &str,
+        only_if_idle: bool,
+    ) -> Result<ThreadRevertRuntimeSnapshot, JSONRPCErrorError> {
+        let mut config = thread.config().await.as_ref().clone();
+        // Give the replacement its own pending lifetime before removal revokes the old runtime.
+        let ema_cancellation = config
+            .config_layer_stack
+            .mcp_ema_cancellation()
+            .for_startup();
+        config.config_layer_stack = config
+            .config_layer_stack
+            .with_mcp_ema_cancellation(ema_cancellation);
+        let runtime_snapshot = ThreadRevertRuntimeSnapshot {
+            config,
+            settings: thread.restorable_thread_settings().await,
+            client_mcp_extensions: thread.client_mcp_extensions(),
+        };
+
+        // Subscribe before shutdown so a pending idle unload either rejects this request or can
+        // no longer race the replacement runtime. The same listener then drains Core's shutdown
+        // events before we replace it.
+        let was_subscribed = self
+            .thread_state_manager
+            .subscribed_connection_ids(thread_id)
+            .await
+            .contains(&request_id.connection_id);
+        if matches!(
+            self.ensure_conversation_listener(
+                thread_id,
+                request_id.connection_id,
+                /*raw_events_enabled*/ false,
+            )
+            .await?,
+            EnsureConversationListenerResult::ConnectionClosed
+        ) {
+            return Err(internal_error(format!(
+                "connection closed before thread {thread_id} could be {outcome}"
+            )));
+        }
+        let thread_state = self.thread_state_manager.thread_state(thread_id).await;
+        let shutdown_drain_rx = thread_state.lock().await.register_shutdown_drain_waiter();
+
+        let shutdown = if only_if_idle {
+            let Some(shutdown) = wait_for_thread_shutdown_if_idle(thread).await else {
+                thread_state.lock().await.take_shutdown_drain_waiter();
+                if !was_subscribed {
+                    self.thread_state_manager
+                        .unsubscribe_connection_from_thread(thread_id, request_id.connection_id)
+                        .await;
+                }
+                return Err(rewrite_busy_error(thread_id));
+            };
+            shutdown
+        } else {
+            wait_for_thread_shutdown(thread).await
+        };
+        match shutdown {
+            ThreadShutdownResult::Complete => {}
+            ThreadShutdownResult::SubmitFailed => {
+                thread_state.lock().await.take_shutdown_drain_waiter();
+                return Err(internal_error(format!(
+                    "failed to shut down thread {thread_id} before it was {outcome}"
+                )));
+            }
+            ThreadShutdownResult::TimedOut => {
+                thread_state.lock().await.take_shutdown_drain_waiter();
+                return Err(internal_error(format!(
+                    "timed out shutting down thread {thread_id} before it was {outcome}"
+                )));
+            }
+        }
+        let drain_result = tokio::time::timeout(Duration::from_secs(10), shutdown_drain_rx)
+            .await
+            .map_err(|_| {
+                internal_error(format!(
+                    "timed out waiting for thread {thread_id} listener to drain shutdown events"
+                ))
+            })
+            .and_then(|result| {
+                result.map_err(|_| {
+                    internal_error(format!(
+                        "thread {thread_id} listener stopped before draining shutdown events"
+                    ))
+                })
+            });
+        if let Err(err) = drain_result {
+            thread_state.lock().await.take_shutdown_drain_waiter();
+            return Err(err);
+        }
+        if self
+            .thread_manager
+            .remove_thread(&thread_id)
+            .await
+            .is_none()
+        {
+            return Err(internal_error(format!(
+                "thread {thread_id} disappeared before it was {outcome}"
+            )));
+        }
+        // Keep thread state and subscriptions across the internal reload. Full teardown would
+        // force clients to call thread/resume after the history is replaced.
+        self.outgoing
+            .cancel_requests_for_thread(thread_id, /*error*/ None)
+            .await;
+        Ok(runtime_snapshot)
+    }
