+use crate::keymap::RuntimeKeymap;
+use crate::keymap::keymap_action_id;
+use codex_config::types::TuiKeymap;
+use serde_json::Value;
+
+pub(crate) fn key_spec(name: &str) -> Option<String> {
+    let (modifier, key) = match name.split_once('+') {
+        Some((modifier, key)) => (Some(modifier), key),
+        None => (None, name),
+    };
+    let key = key.to_ascii_lowercase();
+    let letter = key.len() == 1 && key.as_bytes()[0].is_ascii_lowercase();
+    let function = key
+        .strip_prefix('f')
+        .and_then(|n| n.parse::<u8>().ok())
+        .is_some_and(|n| (2..=12).contains(&n));
+    match modifier {
+        None if function => Some(key),
+        Some("Ctrl") if letter && !"cdzhijm".contains(key.as_str()) => Some(format!("ctrl-{key}")),
+        Some("Alt") if letter => Some(format!("alt-{key}")),
+        _ => None,
+    }
+}
+
+const APPROVAL_NAVIGATION: &[&str] = &["approval.open_fullscreen", "approval.open_thread"];
+
+fn refused(action: &str) -> bool {
+    action.starts_with("approval.") && !APPROVAL_NAVIGATION.contains(&action)
+}
+
+pub(crate) fn action_key(
+    runtime: &RuntimeKeymap,
+    action: &str,
+) -> Result<crossterm::event::KeyEvent, String> {
+    let (context, name) = action
+        .split_once('.')
+        .ok_or_else(|| format!("keymap_action_unknown: {action}"))?;
+    if refused(action)
+        || context == "list"
+        || matches!(name, "previous_permission_mode" | "next_permission_mode")
+    {
+        return Err(format!("keymap_action_refused: {action}"));
+    }
+    if keymap_action_id(context, name).is_none() {
+        return Err(format!("keymap_action_unknown: {action}"));
+    }
+    runtime
+        .action_bindings(context, name)
+        .first()
+        .map(|binding| binding.key_event())
+        .ok_or_else(|| format!("keymap_action_unbound: {action}"))
+}
+
+pub(crate) fn overlay(
+    base: &TuiKeymap,
+    keys: &[(String, Option<String>)],
+) -> Result<(TuiKeymap, RuntimeKeymap), String> {
+    let mut value =
+        serde_json::to_value(base).map_err(|error| format!("keymap_overlay_invalid: {error}"))?;
+    for (action, key) in keys {
+        let (context, name) = action
+            .split_once('.')
+            .ok_or_else(|| format!("keymap_action_unknown: {action}"))?;
+        if refused(action) {
+            return Err(format!("keymap_action_refused: {action}"));
+        }
+        if keymap_action_id(context, name).is_none() {
+            return Err(format!("keymap_action_unknown: {action}"));
+        }
+        let spec = match key {
+            Some(key) => {
+                Value::String(key_spec(key).ok_or_else(|| format!("keymap_key_invalid: {key}"))?)
+            }
+            None => Value::Array(Vec::new()),
+        };
+        let scope = value
+            .get_mut(context)
+            .and_then(Value::as_object_mut)
+            .ok_or_else(|| format!("keymap_action_unknown: {action}"))?;
+        scope.insert(name.to_owned(), spec);
+    }
+    let config: TuiKeymap = serde_json::from_value(value)
+        .map_err(|error| format!("keymap_overlay_invalid: {error}"))?;
+    let runtime = RuntimeKeymap::from_config(&config)?;
+    Ok((config, runtime))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn keys(entries: &[(&str, Option<&str>)]) -> Vec<(String, Option<String>)> {
+        entries
+            .iter()
+            .map(|(a, k)| (a.to_string(), k.map(str::to_string)))
+            .collect()
+    }
+
+    #[test]
+    fn overlay_refuses_authority_unknown_and_invalid_keys() {
+        let base = TuiKeymap::default();
+        let error =
+            |entries: &[(&str, Option<&str>)]| overlay(&base, &keys(entries)).err().unwrap();
+        assert!(error(&[("approval.approve", Some("F8"))]).starts_with("keymap_action_refused"));
+        assert!(
+            error(&[("global.no_such_action", Some("F8"))]).starts_with("keymap_action_unknown")
+        );
+        assert!(error(&[("nonsense", Some("F8"))]).starts_with("keymap_action_unknown"));
+        assert!(error(&[("global.copy", Some("Ctrl+c"))]).starts_with("keymap_key_invalid"));
+    }
+
+    #[test]
+    fn overlay_rejects_conflicts_through_upstream_validation() {
+        let base = TuiKeymap::default();
+        assert!(
+            overlay(
+                &base,
+                &keys(&[
+                    ("global.open_transcript", Some("F8")),
+                    ("global.open_agents", Some("F8"))
+                ])
+            )
+            .is_err()
+        );
+    }
+}
