+    let current = builtins().removed_features();
+    let mut last = LAST.locked();
+    let changed: Vec<_> = last.symmetric_difference(&current).copied().collect();
+    if !changed.is_empty() {
+        codex_features::set_removed("tui", current.clone());
+    }
+    *last = current;
+    changed
+}
