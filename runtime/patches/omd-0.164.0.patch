+pub(crate) fn keys_changed(keys: &[(String, Option<String>)]) -> bool {
+    with(|state| {
+        let changed =
+            state.keys.as_deref() != Some(keys) && (state.keys.is_some() || !keys.is_empty());
+        state.keys = Some(keys.to_vec());
+        changed
+    })
+}
