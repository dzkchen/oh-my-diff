+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use codex_app_server_protocol::JSONRPCMessage;
+use codex_app_server_protocol::JSONRPCRequest;
+use codex_app_server_protocol::OmdSurfaceCallParams;
+use codex_app_server_protocol::RequestId;
+use codex_omd::client_surface;
+use codex_omd::client_surface::ClientSurface;
+use codex_omd::client_surface::NoticeRequest;
+use codex_omd::client_surface::SurfaceCall;
+use serde_json::Value;
+use serde_json::json;
+use tokio::sync::OnceCell;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+
+use crate::omd_clients::OmdClients;
+use crate::outgoing_message::ConnectionId;
+use crate::transport::CHANNEL_CAPACITY;
+use crate::transport::ConnectionOrigin;
+use crate::transport::OutgoingMessage;
+use crate::transport::QueuedOutgoingMessage;
+use crate::transport::TransportEvent;
+use crate::transport::next_connection_id;
+
+type Replies = Arc<Mutex<HashMap<RequestId, oneshot::Sender<Result<Value, String>>>>>;
+
+/// Registers the headless primary surface when mods run and nothing else serves them.
+pub(crate) fn register(
+    clients: Arc<OmdClients>,
+    transport: mpsc::WeakSender<TransportEvent>,
+) -> Option<client_surface::Registration> {
+    let enabled = codex_omd::effective_mode().is_ok_and(codex_omd::RuntimeMode::mod_host_enabled);
+    let store = std::env::var_os(codex_omd::MOD_STORE_ENV).map(PathBuf::from)?;
+    let repository = std::env::current_dir()
+        .and_then(|directory| directory.canonicalize())
+        .ok()?;
+    if !enabled || client_surface::surface_available() {
+        return None;
+    }
+    clients.set_headless();
+    Some(client_surface::register(Arc::new(AppServerSurface(
+        Arc::new(Host {
+            clients,
+            store,
+            repository,
+            transport,
+            runtime: tokio::runtime::Handle::current(),
+            connection: OnceCell::new(),
+            next: AtomicU64::new(0),
+            frames: Frames::default(),
+        }),
+    ))))
+}
+
+struct AppServerSurface(Arc<Host>);
+
+struct Host {
+    clients: Arc<OmdClients>,
+    store: PathBuf,
+    repository: PathBuf,
+    transport: mpsc::WeakSender<TransportEvent>,
+    runtime: tokio::runtime::Handle,
+    connection: OnceCell<(ConnectionId, Replies)>,
+    next: AtomicU64,
+    frames: Frames,
+}
+
+fn closed() -> String {
+    "client_surface_closed".to_string()
+}
+
+impl Host {
+    async fn send(&self, event: TransportEvent) -> Result<(), String> {
+        let transport = self.transport.upgrade().ok_or_else(closed)?;
+        transport.send(event).await.map_err(|_| closed())
+    }
+
+    /// One internal connection, never attached, carries every `app.request`.
+    async fn open(&self) -> Result<(ConnectionId, Replies), String> {
+        let connection_id = next_connection_id();
+        self.clients.set_internal(connection_id);
+        let (writer, mut outgoing) = mpsc::channel::<QueuedOutgoingMessage>(CHANNEL_CAPACITY);
+        self.send(TransportEvent::ConnectionOpened {
+            connection_id,
+            origin: ConnectionOrigin::InProcess,
+            auth: None,
+            writer,
+            disconnect_sender: None,
+        })
+        .await?;
+        let replies = Replies::default();
+        let routes = Arc::clone(&replies);
+        tokio::spawn(async move {
+            while let Some(queued) = outgoing.recv().await {
+                if let Some(written) = queued.write_complete_tx {
+                    let _ = written.send(());
+                }
+                let (id, result) = match queued.message {
+                    OutgoingMessage::Response(response) => (
+                        response.id,
+                        serde_json::to_value(&response.result).map_err(|error| error.to_string()),
+                    ),
+                    OutgoingMessage::Error(error) => (error.id, Err(error.error.message)),
+                    OutgoingMessage::Request(_) | OutgoingMessage::AppServerNotification(_) => {
+                        continue;
+                    }
+                };
+                let reply = routes
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner)
+                    .remove(&id);
+                if let Some(reply) = reply {
+                    let _ = reply.send(result);
+                }
+            }
+        });
+        let connection = (connection_id, replies);
+        self.request(
+            &connection,
+            "initialize",
+            json!({"clientInfo": {"name": "omd-host", "version": env!("CARGO_PKG_VERSION")},
+                "capabilities": {"experimentalApi": true}}),
+        )
+        .await?;
+        Ok(connection)
+    }
+
+    async fn request(
+        &self,
+        (connection_id, replies): &(ConnectionId, Replies),
+        method: &str,
+        params: Value,
+    ) -> Result<Value, String> {
+        let id = RequestId::String(format!(
+            "omd-{}",
+            self.next.fetch_add(1, Ordering::Relaxed) + 1
+        ));
+        let (reply, answer) = oneshot::channel();
+        replies
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .insert(id.clone(), reply);
+        self.send(TransportEvent::IncomingMessage {
+            connection_id: *connection_id,
+            message: JSONRPCMessage::Request(JSONRPCRequest {
+                id,
+                method: method.to_string(),
+                params: Some(params),
+                trace: None,
+            }),
+        })
+        .await?;
+        answer.await.map_err(|_| closed())?
+    }
+
+    async fn app_request(&self, call: &SurfaceCall) -> Result<Value, String> {
+        if let Some(confirm) = &call.confirm {
+            let confirmers = self.clients.serving("terminal.prompt");
+            if confirmers.is_empty() {
+                return Ok(json!({"status": "declined"}));
+            }
+            let answer = self
+                .clients
+                .surface_call(
+                    confirmers,
+                    OmdSurfaceCallParams {
+                        caller: call.caller.clone(),
+                        operation: "terminal.prompt".to_string(),
+                        arguments: json!({"kind": "confirm",
+                            "title": format!("Confirm request from mod {}", call.caller),
+                            "message": confirm}),
+                        confirm: None,
+                    },
+                    || call.lifetime.active(),
+                )
+                .await?;
+            if answer["status"] != "accepted" {
+                return Ok(json!({"status": "declined"}));
+            }
+        }
+        let method = call.arguments["method"]
+            .as_str()
+            .ok_or("app_params_invalid: method")?;
+        let mut params = call.arguments["params"].clone();
+        client_surface::translate_images(
+            &self.store,
+            &self.repository,
+            &call.caller,
+            call.thread.as_deref(),
+            &mut params,
+        )?;
+        let connection = self.connection.get_or_try_init(|| self.open()).await?;
+        self.request(connection, method, params).await
+    }
+}
+
+/// `terminal.notice` without a terminal: attached clients see the mirrored call; a model notice is queued.
+fn notice(call: &SurfaceCall) -> Result<Value, String> {
+    match client_surface::notice_request(&call.arguments)? {
+        NoticeRequest::Clear { .. } => Ok(json!({"cleared": false})),
+        NoticeRequest::Transcript {
+            text, model: true, ..
+        } => {
+            let thread = call
+                .thread
+                .as_deref()
+                .ok_or("terminal_notice_thread_unavailable")?;
+            codex_omd::model_request::queue_section(thread, &call.caller, text)?;
+            Ok(json!({"shown": true, "model": true}))
+        }
+        _ => Ok(json!({"shown": true})),
+    }
+}
+
+type FrameState = Arc<Mutex<(u64, Instant, bool)>>;
+
+/// Paces mirrored `terminal.blit` frames like a drawing surface's queue: one frame per interval, cells sent before a pending cells frame joining it.
+#[derive(Default)]
+struct Frames(Mutex<HashMap<String, FrameState>>);
+
+impl Frames {
+    fn blit(&self, call: &SurfaceCall, now: Instant) -> Result<Value, client_surface::BlitError> {
+        let caller = &call.caller;
+        let arguments = &call.arguments;
+        let key = arguments["key"].as_str().unwrap_or_default();
+        let published = codex_omd_extension::clients::published();
+        let owner = published
+            .as_ref()
+            .and_then(|snapshot| snapshot.component_owners.get(key))
+            .map(String::as_str);
+        let size = published
+            .as_ref()
+            .and_then(|snapshot| snapshot.view.raster_size(key));
+        let blit = client_surface::blit_request(caller, owner, size, arguments)?;
+        let key = blit.key.clone();
+        let cells = matches!(blit.content, client_surface::BlitContent::Cells { .. });
+        self.admit(&key, now, cells, |next| {
+            blit.checked(|source| call.snapshot_pixels(source, next))
+                .map(|_| ())
+        })
+    }
+
+    fn admit(
+        &self,
+        key: &str,
+        now: Instant,
+        cells: bool,
+        snapshot: impl FnOnce(Instant) -> Result<(), client_surface::BlitError>,
+    ) -> Result<Value, client_surface::BlitError> {
+        let state = self
+            .0
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .entry(key.to_owned())
+            .or_insert_with(|| Arc::new(Mutex::new((0, now, false))))
+            .clone();
+        let mut state = state.lock().unwrap_or_else(PoisonError::into_inner);
+        if cells && state.2 && state.1 > now {
+            return Ok(Self::reply(
+                state.0,
+                Self::backlog(state.1 - client_surface::BLIT_FRAME, now) + 1,
+            ));
+        }
+        if let Some(reply) = Self::backpressure(&state, now) {
+            return Ok(reply);
+        }
+        snapshot(state.1.max(now) + client_surface::BLIT_FRAME)?;
+        state.2 = cells;
+        Ok(Self::accept(&mut state, now))
+    }
+
+    #[cfg(test)]
+    fn pace(&self, key: String, now: Instant, cells: bool) -> Value {
+        self.admit(&key, now, cells, |_| Ok(())).unwrap()
+    }
+
+    fn backlog(drained: Instant, now: Instant) -> u128 {
+        drained.saturating_duration_since(now).as_millis() / client_surface::BLIT_FRAME.as_millis()
+    }
+
+    fn reply(frame: u64, queued: u128) -> Value {
+        json!({
+            "frame": frame,
+            "queued": queued,
+            "frame_ms": client_surface::BLIT_FRAME.as_millis() as u64,
+        })
+    }
+
+    fn backpressure((_, drained, _): &(u64, Instant, bool), now: Instant) -> Option<Value> {
+        if Self::backlog(*drained, now) >= client_surface::BLIT_QUEUE_UPDATES as u128 {
+            let wait = drained.saturating_duration_since(now)
+                - client_surface::BLIT_FRAME * (client_surface::BLIT_QUEUE_UPDATES as u32 - 1);
+            return Some(json!({"status": "backpressure",
+                "retry_after_ms": wait.as_millis().max(1) as u64}));
+        }
+        None
+    }
+
+    fn accept((frame, drained, _): &mut (u64, Instant, bool), now: Instant) -> Value {
+        let queued = Self::backlog(*drained, now) + 1;
+        *drained = (*drained).max(now) + client_surface::BLIT_FRAME;
+        *frame += 1;
+        Self::reply(*frame, queued)
+    }
+}
+
+impl ClientSurface for AppServerSurface {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        let operation = call.operation.as_str();
+        let answer = match operation {
+            "terminal.notify" => {
+                Ok(json!({"delivered": false, "method": "none", "reason": "headless"}))
+            }
+            "terminal.notice" => notice(&call),
+            "terminal.blit" => {
+                call.reply_blit(self.0.frames.blit(&call, Instant::now()));
+                return Ok(());
+            }
+            _ if client_surface::USER_ONLY_OPERATIONS.contains(&operation)
+                || matches!(operation, "prompts.consent" | "app.respond") =>
+            {
+                return Err(client_surface::needs_terminal_error(operation));
+            }
+            "terminal.pty"
+                if call.arguments["action"] == "start"
+                    && call.context != codex_omd::app_routes::InvocationContext::User =>
+            {
+                return Err("host_operation_user_only: terminal.pty start".to_string());
+            }
+            "app.request" => {
+                let host = Arc::clone(&self.0);
+                self.0.runtime.spawn(async move {
+                    let _ = call.reply.send(host.app_request(&call).await);
+                });
+                return Ok(());
+            }
+            _ => {
+                let targets = self.0.clients.serving(operation);
+                if targets.is_empty() {
+                    return Err(format!(
+                        "client_surface_operation_unavailable: no attached client serves {operation}"
+                    ));
+                }
+                let clients = Arc::clone(&self.0.clients);
+                let params = OmdSurfaceCallParams {
+                    caller: call.caller,
+                    operation: call.operation,
+                    arguments: call.arguments,
+                    confirm: call.confirm,
+                };
+                let (reply, lifetime) = (call.reply, call.lifetime);
+                self.0.runtime.spawn(async move {
+                    let answer = clients
+                        .surface_call(targets, params, || lifetime.active())
+                        .await;
+                    let _ = reply.send(answer);
+                });
+                return Ok(());
+            }
+        };
+        let _ = call.reply.send(answer);
+        Ok(())
+    }
+}
