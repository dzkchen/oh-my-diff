+#[test]
+fn compaction_replacements_keep_calls_and_reasoning_whole() {
+    let items = items();
+    let compact_with = |value: Value| compact(&items, serde_json::from_value(value).unwrap());
+    let kept = compact_with(json!({"keep": [1, 2, 3, 5],
