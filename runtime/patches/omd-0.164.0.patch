+//! Draft revisions, one mod's ghost suggestion and mod-attached images beside the native draft.
+
+use std::cell::Cell;
+use std::hash::Hash;
+use std::hash::Hasher;
+use std::path::PathBuf;
+
+use crate::key_hint::KeyBindingListExt;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Style;
+use serde_json::Value;
+use serde_json::json;
+use unicode_width::UnicodeWidthStr;
+
+use super::ActivePopup;
+use super::ChatComposer;
+
+#[derive(Default)]
+pub(crate) struct ModDraft {
+    revision: u64,
+    fingerprint: u64,
+    /// Fingerprint of the attached images and the revision that advances when they change.
+    attachments: (u64, u64),
+    origin: Option<String>,
+    suggestion: Option<Suggestion>,
+    ghost: Cell<Option<Rect>>,
+    /// Images a mod attached: path, owner and the owner's source digest when attached.
+    owned: Vec<(PathBuf, String, String)>,
+    /// `(owner, payload)` notifications; no owner means every `composer` subscriber.
+    events: Vec<(Option<String>, Value)>,
+}
+
+struct Suggestion {
+    owner: String,
+    /// The owner's source digest when it suggested; a reload clears the suggestion.
+    source: String,
+    id: String,
+    text: String,
+}
+
+impl ChatComposer {
+    fn mod_fingerprint(&self) -> (u64, u64) {
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        self.attachments.local_image_paths().hash(&mut hasher);
+        self.attachments.remote_image_urls.hash(&mut hasher);
+        let attachments = hasher.finish();
+        self.draft.textarea.text().hash(&mut hasher);
+        (hasher.finish(), attachments)
+    }
+
+    /// Advances the revision after any draft change and clears a suggestion made for the old one.
+    pub(crate) fn mod_draft_sync(&mut self) -> u64 {
+        let (fingerprint, attachments) = self.mod_fingerprint();
+        if fingerprint != self.draft.mod_draft.fingerprint {
+            let draft = &mut self.draft.mod_draft;
+            draft.fingerprint = fingerprint;
+            draft.revision += 1;
+            if attachments != draft.attachments.0 {
+                draft.attachments = (attachments, draft.attachments.1 + 1);
+            }
+            let origin = draft.origin.take().unwrap_or_else(|| "user".into());
+            let change = json!({"kind": "change", "revision": draft.revision, "attachments_revision": draft.attachments.1, "origin": origin});
+            draft.events.push((None, change));
+            self.mod_suggestion_clear("edit");
+        }
+        let images = self.attachments.local_image_paths();
+        self.draft
+            .mod_draft
+            .owned
+            .retain(|(path, ..)| images.contains(path));
+        self.draft.mod_draft.revision
+    }
+
+    pub(crate) fn mod_draft_origin(&mut self, origin: &str) {
+        self.draft.mod_draft.origin = Some(origin.to_owned());
+    }
+
+    pub(crate) fn mod_draft_owned(&mut self, path: PathBuf, owner: &str, source: &str) {
+        self.draft
+            .mod_draft
+            .owned
+            .push((path, owner.to_owned(), source.to_owned()));
+    }
+
+    pub(crate) fn mod_draft_owner(&self, path: &PathBuf) -> Option<(String, String)> {
+        self.draft
+            .mod_draft
+            .owned
+            .iter()
+            .find(|(owned, ..)| owned == path)
+            .map(|(_, owner, source)| (owner.clone(), source.clone()))
+    }
+
+    pub(crate) fn mod_suggestion_clear(&mut self, reason: &str) {
+        if let Some(suggestion) = self.draft.mod_draft.suggestion.take() {
+            self.draft.mod_draft.events.push((
+                Some(suggestion.owner),
+                json!({"kind": "suggestion", "id": suggestion.id, "status": "cleared", "reason": reason}),
+            ));
+        }
+    }
+
+    pub(crate) fn mod_suggestion_owner(&self) -> Option<(&str, &str)> {
+        self.draft
+            .mod_draft
+            .suggestion
+            .as_ref()
+            .map(|suggestion| (suggestion.owner.as_str(), suggestion.id.as_str()))
+    }
+
+    pub(crate) fn mod_suggest(
+        &mut self,
+        owner: &str,
+        source: &str,
+        revision: u64,
+        id: String,
+        text: String,
+    ) -> Result<(), String> {
+        if revision != self.mod_draft_sync() {
+            return Err("stale_revision".into());
+        }
+        self.mod_suggestion_clear("replaced");
+        self.draft.mod_draft.suggestion = Some(Suggestion {
+            owner: owner.to_owned(),
+            source: source.to_owned(),
+            id,
+            text,
+        });
+        Ok(())
+    }
+
+    /// Passes a typed key through `composer_key` interceptors; `None` when one dropped it. Paste bursts and IME text pass untouched.
+    pub(super) fn mod_composer_key(&mut self, key: KeyEvent) -> Option<KeyEvent> {
+        if self.is_in_paste_burst() || matches!(key.code, KeyCode::Char(c) if !c.is_ascii()) {
+            return Some(key);
+        }
+        let Some((name, text)) = crate::mod_ui::composer_key_name(key) else {
+            return Some(key);
+        };
+        let effective = crate::mod_runtime::composer_key(&name, || {
+            let text = text.filter(|_| !self.draft.textarea.is_vim_normal_mode());
+            json!({"key": name, "text": text, "revision": self.mod_draft_sync(), "cursor": self.draft.textarea.cursor()})
+        });
+        match effective {
+            Ok(Some(effective)) if effective == name => Some(key),
+            Ok(Some(effective)) => Some(crate::mod_ui::composer_key_event(&effective).map_or(
+                key,
+                |rewritten| KeyEvent {
+                    kind: key.kind,
+                    ..rewritten
+                },
+            )),
+            Ok(None) => None,
+            Err(error) => {
+                crate::mod_ui::notice(
+                    "omd",
+                    Some("composer_key"),
+                    "warning",
+                    crate::mod_ui::NoticePlacement::Status,
+                    &format!("Key interception skipped: {error}"),
+                    std::time::Duration::from_secs(5),
+                );
+                Some(key)
+            }
+        }
+    }
+
+    pub(super) fn mod_native_fill(&mut self, source: &str, edit: Value) -> Option<String> {
+        let original = edit["text"].as_str().unwrap_or_default().to_owned();
+        match crate::mod_runtime::composer_edit(source, "user", self.draft.mod_draft.revision, edit)
+        {
+            Ok(effective) => Some(effective["text"].as_str().map_or(original, str::to_owned)),
+            Err(error) => {
+                self.app_event_tx
+                    .send(crate::app_event::AppEvent::InsertHistoryCell(Box::new(
+                        crate::history_cell::new_info_event(error, /*hint*/ None),
+                    )));
+                None
+            }
+        }
+    }
+
+    /// Applies one compare-and-write edit from `owner` and returns the new revision.
+    #[cfg(test)]
+    pub(crate) fn mod_edit(
+        &mut self,
+        owner: &str,
+        revision: u64,
+        edit: &Value,
+        cursor: Option<usize>,
+        selection: Option<std::ops::Range<usize>>,
+    ) -> Result<u64, String> {
+        self.mod_edit_detach(owner, revision, edit, cursor, selection, &[])
+    }
+
+    pub(crate) fn mod_edit_detach(
+        &mut self,
+        owner: &str,
+        revision: u64,
+        edit: &Value,
+        cursor: Option<usize>,
+        selection: Option<std::ops::Range<usize>>,
+        detach: &[&str],
+    ) -> Result<u64, String> {
+        if revision != self.mod_draft_sync() {
+            return Err("stale_revision".into());
+        }
+        let current = self.draft.textarea.text().to_owned();
+        let boundary = |at: usize| at <= current.len() && current.is_char_boundary(at);
+        let index = |key: &str| edit[key].as_u64().map(|at| at as usize);
+        let text = edit["text"].as_str().unwrap_or_default();
+        let range = match edit["kind"].as_str() {
+            Some("fill") => 0..current.len(),
+            Some("insert") => {
+                let at = self.draft.textarea.cursor();
+                at..at
+            }
+            Some("append") => current.len()..current.len(),
+            Some("splice") => match (index("start"), index("end")) {
+                (Some(start), Some(end)) if start <= end && boundary(start) && boundary(end) => {
+                    start..end
+                }
+                _ => return Err("composer_range_invalid".into()),
+            },
+            _ => return Err("composer_edit_invalid".into()),
+        };
+        let mut prospective = crate::bottom_pane::textarea::TextArea::new();
+        prospective.set_text_with_elements(&current, &self.draft.textarea.text_elements());
+        prospective.replace_range(range.clone(), text);
+        let fits =
+            |at: usize| at <= prospective.text().len() && prospective.text().is_char_boundary(at);
+        if let Some(selection) = &selection
+            && (selection.start > selection.end || !fits(selection.start) || !fits(selection.end))
+        {
+            return Err("composer_selection_invalid".into());
+        }
+        if cursor.is_some_and(|at| !fits(at)) {
+            return Err("composer_cursor_invalid".into());
+        }
+        let mut placeholders = prospective.text_element_snapshots();
+        for placeholder in detach {
+            let Some(index) = placeholders
+                .iter()
+                .position(|element| element.text == *placeholder)
+            else {
+                return Err(format!("composer_attachment_missing: {placeholder}"));
+            };
+            placeholders.remove(index);
+        }
+        let elements_before = self.draft.textarea.element_payloads();
+        self.draft.textarea.replace_range(range.clone(), text);
+        self.reconcile_deleted_elements(elements_before);
+        match (selection, cursor) {
+            (Some(selection), _) => {
+                self.draft.textarea.set_selection(selection);
+            }
+            (None, Some(at)) => self.draft.textarea.set_cursor(at),
+            (None, None) => self.draft.textarea.set_cursor(range.start + text.len()),
+        }
+        for placeholder in detach {
+            self.mod_detach(placeholder);
+        }
+        self.sync_bash_mode_from_text();
+        self.sync_popups();
+        self.mod_draft_origin(owner);
+        Ok(self.mod_draft_sync())
+    }
+
+    pub(crate) fn mod_detach(&mut self, placeholder: &str) -> bool {
+        let Some(range) = self
+            .draft
+            .textarea
+            .text_element_snapshots()
+            .into_iter()
+            .find(|element| element.text == placeholder)
+            .map(|element| element.range)
+        else {
+            return false;
+        };
+        let elements_before = self.draft.textarea.element_payloads();
+        self.draft.textarea.replace_range(range, "");
+        self.reconcile_deleted_elements(elements_before);
+        true
+    }
+
+    pub(crate) fn mod_draft_revoke(&mut self, active: impl Fn(&str, &str) -> bool) {
+        let revoked = self
+            .draft
+            .mod_draft
+            .owned
+            .iter()
+            .filter(|(_, owner, source)| !active(owner, source))
+            .map(|(path, ..)| path.clone())
+            .collect::<Vec<_>>();
+        for image in self.local_images() {
+            if revoked.contains(&image.path) {
+                self.mod_detach(&image.placeholder);
+            }
+        }
+        if self
+            .draft
+            .mod_draft
+            .suggestion
+            .as_ref()
+            .is_some_and(|suggestion| !active(&suggestion.owner, &suggestion.source))
+        {
+            self.mod_suggestion_clear("reload");
+        }
+        self.mod_draft_sync();
+    }
+
+    pub(crate) fn mod_revision(&self) -> u64 {
+        self.draft.mod_draft.revision
+    }
+
+    pub(crate) fn mod_draft_holds_mods(&self) -> bool {
+        !self.draft.mod_draft.owned.is_empty() || self.draft.mod_draft.suggestion.is_some()
+    }
+
+    pub(crate) fn mod_selection(&self) -> Option<std::ops::Range<usize>> {
+        self.draft.textarea.mouse_selection_range()
+    }
+
+    pub(crate) fn mod_draft_take_events(&mut self) -> Vec<(Option<String>, Value)> {
+        std::mem::take(&mut self.draft.mod_draft.events)
+    }
+
+    /// The welcome site's composer state, where an open slash, file or mention popup is a draft.
+    pub(crate) fn mod_welcome_composer(
+        &self,
+    ) -> Option<crate::empty_state_animation::ComposerState> {
+        self.empty_state_composer().or_else(|| {
+            (!matches!(self.popups.active, ActivePopup::None) && self.history_search.is_none())
+                .then_some(crate::empty_state_animation::ComposerState::Draft)
+        })
+    }
+
+    fn mod_suggestion_visible(&self) -> Option<&str> {
+        let suggestion = self.draft.mod_draft.suggestion.as_ref()?;
+        let text = self.draft.textarea.text();
+        (self.draft.input_enabled
+            && !self.draft.is_bash_mode
+            && matches!(self.popups.active, ActivePopup::None)
+            && self.history_search.is_none()
+            && self.draft.textarea.cursor() == text.len())
+        .then_some(suggestion.text.as_str())
+    }
+
+    fn mod_suggestion_resolve(&mut self, accept: bool) {
+        let Some(suggestion) = self.draft.mod_draft.suggestion.take() else {
+            return;
+        };
+        let status = if accept {
+            self.draft.mod_draft.origin = Some(suggestion.owner.clone());
+            self.insert_str(&suggestion.text);
+            "accepted"
+        } else {
+            "dismissed"
+        };
+        self.draft.mod_draft.events.push((
+            Some(suggestion.owner),
+            json!({"kind": "suggestion", "id": suggestion.id, "status": status}),
+        ));
+    }
+
+    /// Accepts on the move-right binding at the end of the draft, dismisses on Esc.
+    pub(super) fn mod_suggestion_key(&mut self, key: &KeyEvent) -> bool {
+        if self.mod_suggestion_visible().is_none() {
+            return false;
+        }
+        if self.editor_keymap.move_right.is_pressed(*key) {
+            self.mod_suggestion_resolve(true);
+            return true;
+        }
+        if key.code == KeyCode::Esc {
+            self.mod_suggestion_resolve(false);
+            return true;
+        }
+        false
+    }
+
+    pub(super) fn mod_suggestion_mouse(&mut self, event: MouseEvent) -> bool {
+        let Some(ghost) = self.draft.mod_draft.ghost.get() else {
+            return false;
+        };
+        let inside =
+            event.row == ghost.y && event.column >= ghost.x && event.column < ghost.right();
+        if matches!(event.kind, MouseEventKind::Down(_)) && inside {
+            self.mod_suggestion_resolve(true);
+            return true;
+        }
+        false
+    }
+
+    pub(super) fn render_mod_suggestion(
+        &self,
+        textarea: Rect,
+        cursor: Option<(u16, u16)>,
+        buf: &mut Buffer,
+    ) {
+        self.draft.mod_draft.ghost.set(None);
+        let (Some(text), Some((x, y))) = (self.mod_suggestion_visible(), cursor) else {
+            return;
+        };
+        let width = textarea.right().saturating_sub(x);
+        let line = text.lines().next().unwrap_or_default();
+        if width == 0 || line.is_empty() || y >= textarea.bottom() {
+            return;
+        }
+        let shown = if text.contains('\n') {
+            format!("{line}…")
+        } else {
+            line.to_owned()
+        };
+        let span = Rect::new(x, y, width.min(shown.width() as u16), 1);
+        buf.set_stringn(x, y, &shown, width as usize, Style::default().dim());
+        self.draft.mod_draft.ghost.set(Some(span));
+    }
+}
