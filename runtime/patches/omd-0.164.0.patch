+    task.start_worker("second".into(), "lead".into(), 1, worker())
+        .unwrap();
+    assert!(task.admit("second", "openai", "gpt-5.6-sol", 41).is_err());
+    assert_eq!(task.remaining().unwrap().2, 40);
