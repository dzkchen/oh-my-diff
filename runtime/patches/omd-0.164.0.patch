+                plugin_id: None,
+                server_name: "docs".to_string(),
+                tool_name: "lookup".to_string(),
+                first_turn_id: "turn-1".to_string(),
+            }],
+            ..Default::default()
+        }),
+        ..Default::default()
+    });
+    RolloutItem::ResponseItem(envelope)
+}
+
+fn function_call(call_id: &str) -> RolloutItem {
+    let item: ResponseItem = serde_json::from_value(json!({
+        "type": "function_call", "id": "fc_1", "call_id": call_id, "name": "shell", "arguments": "{}"
+    }))
+    .expect("function call");
+    RolloutItem::ResponseItem(item.into())
+}
+
+fn function_output(call_id: &str, output: &str) -> RolloutItem {
+    let item: ResponseItem = serde_json::from_value(json!({
+        "type": "function_call_output", "id": "fco_1", "call_id": call_id, "output": output
+    }))
+    .expect("function call output");
+    RolloutItem::ResponseItem(item.into())
+}
+
+fn completed(thread_id: ThreadId, turn_id: &str, item: TurnItem) -> RolloutItem {
+    RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+        thread_id,
+        turn_id: turn_id.to_string(),
+        item,
+        started_at_ms: Some(0),
+        completed_at_ms: 1,
+    }))
+}
+
+fn user_item(id: &str, text: &str) -> TurnItem {
+    TurnItem::UserMessage(UserMessageItem {
+        id: id.to_string(),
+        client_id: None,
+        content: vec![UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }],
+    })
+}
+
+fn agent_item(id: &str, text: &str) -> TurnItem {
+    TurnItem::AgentMessage(AgentMessageItem {
+        id: id.to_string(),
+        content: vec![AgentMessageContent::Text {
+            text: text.to_string(),
+        }],
+        phase: None,
+        memory_citation: None,
+        delivery: None,
+        questions: None,
+    })
+}
+
+fn raw(value: Value) -> RolloutItem {
+    let item: ResponseItem = serde_json::from_value(value).expect("response item");
+    RolloutItem::ResponseItem(item.into())
+}
+
+fn transcript(thread_id: ThreadId, turns: usize) -> Vec<Entry> {
+    let mut items = Vec::new();
+    for turn in 0..turns {
+        let turn_id = format!("turn-{turn}");
+        let text = format!("question {turn}");
+        let answer = format!("answer {turn}");
+        items.push(turn_started(&turn_id));
+        items.push(message(&format!("u{turn}"), "user", &text));
+        items.push(completed(
+            thread_id,
+            &turn_id,
+            user_item(&format!("du{turn}"), &text),
+        ));
+        items.push(function_call(&format!("c{turn}")));
+        if turn % 11 != 5 {
+            items.push(function_output(&format!("c{turn}"), "ok"));
+        }
+        if turn % 11 == 7 {
+            items.push(function_output(&format!("c{}", turn - 2), "late"));
+        }
+        if turn % 5 == 2 {
+            items.push(raw(json!({
+                "type": "reasoning", "id": format!("rs{turn}"), "summary": [], "encrypted_content": null
+            })));
+        }
+        items.push(message(&format!("a{turn}"), "assistant", &answer));
+        items.push(completed(
+            thread_id,
+            &turn_id,
+            agent_item(&format!("a{turn}"), &answer),
+        ));
+        if turn % 13 == 7 {
+            items.push(message("dup", "assistant", "dup"));
+        }
+        if turn % 17 == 3 {
+            items.push(completed(
+                thread_id,
+                &turn_id,
+                agent_item(&format!("orphan-{turn}"), "orphan"),
+            ));
+        }
+        if turn % 19 == 4 {
+            items.push(completed(
+                thread_id,
+                &turn_id,
+                agent_item(&format!("a{turn}"), "again"),
+            ));
+        }
+        if turn == turns / 4 {
+            items.push(raw(
+                json!({"type": "compaction", "id": "cmp", "encrypted_content": "x"}),
+            ));
+        }
+        items.push(turn_completed(&turn_id));
+    }
+    let mut entries: Vec<Entry> = items
+        .into_iter()
+        .enumerate()
+        .map(|(ordinal, item)| Entry::new(item, Some(ordinal as u64)))
+        .collect();
+    renumber(&mut entries);
+    entries
+}
+
+fn message_json(role: &str, text: &str) -> Value {
+    let part = if role == "assistant" {
+        "output_text"
+    } else {
+        "input_text"
+    };
+    json!({"type": "message", "role": role, "content": [{"type": part, "text": text}]})
+}
+
+fn tool_json(call_id: &str, output: &str) -> Vec<Value> {
+    vec![
+        json!({"type": "function_call", "call_id": call_id, "name": "shell", "arguments": "{}"}),
+        json!({"type": "function_call_output", "call_id": call_id, "output": output}),
+    ]
+}
+
+fn pick(seed: &mut u64, len: usize) -> usize {
+    *seed = seed
+        .wrapping_mul(6364136223846793005)
+        .wrapping_add(1442695040888963407);
+    (*seed >> 33) as usize % len
+}
+
+fn next_edit(rows: &[Row], step: usize, seed: &mut u64) -> HistoryRowEdit {
+    let anchor = |seed: &mut u64, except: &str, unfrozen: bool| {
+        let others: Vec<&Row> = rows
+            .iter()
+            .filter(|row| row.id != except && (!unfrozen || row.access != HistoryRowAccess::Frozen))
+            .collect();
+        let id = others[pick(seed, others.len())].id.clone();
+        if pick(seed, 2) == 0 {
+            (Some(id), None)
+        } else {
+            (None, Some(id))
+        }
+    };
+    match step % 8 {
+        0 => {
+            let (before, after) = anchor(seed, "", true);
+            HistoryRowEdit::Insert {
+                before,
+                after,
+                items: tool_json(&format!("ins-{step}"), "first"),
+            }
+        }
+        1 => HistoryRowEdit::Replace {
+            id: format!("ins-{}", step - 1),
+            items: tool_json(&format!("ins-{}", step - 1), "second"),
+        },
+        2 => {
+            let id = format!("ins-{}", step - 2);
+            let (before, after) = anchor(seed, &id, false);
+            HistoryRowEdit::Move { id, before, after }
+        }
+        3 => {
+            let (before, after) = anchor(seed, "", false);
+            let role = ["user", "assistant", "developer"][step / 8 % 3];
+            HistoryRowEdit::Insert {
+                before,
+                after,
+                items: vec![message_json(role, &format!("inserted {step}"))],
+            }
+        }
+        4 => {
+            let editable: Vec<&Row> = rows
+                .iter()
+                .filter(|row| row.access == HistoryRowAccess::Edit)
+                .collect();
+            let row = editable[pick(seed, editable.len())];
+            let items = match row.kind.strip_prefix("message.") {
+                Some(role) => vec![message_json(role, &format!("replaced {step}"))],
+                None => tool_json(&row.id, &format!("replaced {step}")),
+            };
+            HistoryRowEdit::Replace {
+                id: row.id.clone(),
+                items,
+            }
+        }
+        5 => {
+            let deletable: Vec<&Row> = rows
+                .iter()
+                .filter(|row| row.access != HistoryRowAccess::Frozen && !row.id.starts_with("ins-"))
+                .collect();
+            HistoryRowEdit::Delete {
+                id: deletable[pick(seed, deletable.len())].id.clone(),
+            }
+        }
+        6 => {
+            let editable: Vec<&Row> = rows
+                .iter()
+                .filter(|row| row.access == HistoryRowAccess::Edit)
+                .collect();
+            let id = editable[pick(seed, editable.len())].id.clone();
+            let (before, after) = anchor(seed, &id, false);
+            HistoryRowEdit::Move { id, before, after }
+        }
+        _ => HistoryRowEdit::Insert {
+            before: None,
+            after: None,
+            items: vec![message_json("assistant", &format!("appended {step}"))],
+        },
+    }
+}
+
+fn assert_synced(step: usize, view: &View, entries: &[Entry]) {
+    let fresh = View::new(entries);
+    let owners = |view: &View| {
+        view.owners
+            .iter()
+            .map(|(key, segments)| {
+                let mut segments = segments.clone();
+                segments.sort_unstable();
+                (key.clone(), segments)
+            })
+            .collect::<std::collections::BTreeMap<_, _>>()
+    };
+    assert_eq!(view.rows, fresh.rows, "rows after edit {step}");
+    assert_eq!(view.starts, fresh.starts, "starts after edit {step}");
+    assert_eq!(
+        view.compaction, fresh.compaction,
+        "compaction after edit {step}"
+    );
+    assert_eq!(view.keys, fresh.keys, "keys after edit {step}");
+    assert_eq!(owners(view), owners(&fresh), "owners after edit {step}");
+    assert_eq!(view.names, fresh.names, "names after edit {step}");
+    assert_eq!(view.calls, fresh.calls, "calls after edit {step}");
+}
+
+fn run_batch(turns: usize, check_each_edit: bool) -> (usize, usize) {
+    let thread_id = ThreadId::new();
+    let mut entries = transcript(thread_id, turns);
+    let length = entries.len();
+    let edit = Edit {
+        thread_id,
+        revision: "revision".to_string(),
+        author: "test",
+    };
+    FULL_BUILDS.with(|builds| builds.set(0));
+    let mut view = View::new(&entries);
+    let mut seed = 7;
+    for step in 0..256 {
+        let change = next_edit(&view.rows, step, &mut seed);
+        apply(&mut view, &mut entries, &change, &edit)
+            .unwrap_or_else(|err| panic!("edit {step} {change:?}: {err:?}"));
+        if check_each_edit {
+            assert_synced(step, &view, &entries);
+        }
+    }
+    let builds = FULL_BUILDS.with(std::cell::Cell::get);
+    assert_synced(256, &view, &entries);
+    (length, builds)
+}
+
+#[test]
+fn the_incremental_row_view_equals_a_fresh_build_after_every_edit() {
+    run_batch(30, true);
+}
diff --git a/codex-rs/tui/src/app/mod_credentials.rs b/codex-rs/tui/src/app/mod_credentials.rs
new file mode 100644
index 0000000000000000000000000000000000000000..09b7a26fcac15a7e585a93741e4c727a2e78b6e6
--- /dev/null
+++ b/codex-rs/tui/src/app/mod_credentials.rs
@@ -0,0 +1,332 @@
+use super::App;
+use crate::bottom_pane::SecretPromptView;
+use codex_omd::client_surface::SurfaceCall;
+use codex_omd::credentials::CredentialProfile;
+use codex_omd::credentials::CredentialProfiles;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    action: String,
+    #[serde(default)]
+    kind: Option<String>,
+    #[serde(default)]
+    label: Option<String>,
+    #[serde(default)]
+    provider: Option<String>,
+    #[serde(default)]
+    profile: Option<String>,
+    #[serde(default)]
+    origin: Option<String>,
+}
+
+fn parse(call: &SurfaceCall) -> Result<Request, String> {
+    let request: Request =
+        serde_json::from_value(call.arguments.clone()).map_err(|error| error.to_string())?;
+    match request.action.as_str() {
+        "enroll"
+            if request.label.is_some()
+                && match request.kind.as_deref() {
+                    Some("secret" | "provider") => request.origin.is_some(),
+                    Some(_) => request.origin.is_none(),
+                    None => false,
+                } =>
+        {
+            Ok(request)
+        }
+        "remove" | "refresh" if request.profile.is_some() => Ok(request),
+        _ => Err("credentials_request_invalid".into()),
+    }
+}
+
+pub(super) fn prompt(call: &SurfaceCall) -> Result<String, String> {
+    let request = parse(call)?;
+    let caller = &call.caller;
+    Ok(match request.action.as_str() {
+        "enroll" if request.kind.as_deref() == Some("secret") => format!(
+            "Mod {caller} wants to store a secret \"{}\" for {}. You enter it here; only that mod's sidecars receive it, never the mod or the model.",
+            request.label.unwrap_or_default(),
+            request.origin.unwrap_or_default()
+        ),
+        "enroll" => format!(
+            "Mod {caller} wants to add a {} credential profile \"{}\"{}. You sign in or enter the key here; the mod never sees it, and OMD sends it only to that site.",
+            request.kind.unwrap_or_default(),
+            request.label.unwrap_or_default(),
+            request
+                .origin
+                .map(|origin| format!(" for {origin}"))
+                .unwrap_or_default()
+        ),
+        "remove" => {
+            let id = request.profile.unwrap_or_default();
+            let profile = profiles()?
+                .profile(&id)
+                .map_err(|error| error.to_string())?;
+            format!(
+                "Mod {caller} wants to remove the {} credential profile \"{}\" ({id}).",
+                profile.kind, profile.label
+            )
+        }
+        _ => format!(
+            "Mod {caller} wants to refresh credential profile {}.",
+            request.profile.unwrap_or_default()
+        ),
+    })
+}
+
+fn completed(profile: &CredentialProfile) -> Value {
+    let public = profiles()
+        .ok()
+        .and_then(|profiles| profiles.public(profile).ok())
+        .unwrap_or(Value::Null);
+    json!({"status": "completed", "profile": public})
+}
+
+fn profiles() -> Result<CredentialProfiles, String> {
+    let store = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .ok_or("mod store is not configured")?;
+    CredentialProfiles::open(&store).map_err(|error| error.to_string())
+}
+
+fn discard(profiles: &CredentialProfiles, id: &str) {
+    let _ = profiles.remove(id);
+}
+
+fn finish(
+    reply: &codex_omd::client_surface::Reply,
+    profile: &CredentialProfile,
+    fresh: bool,
+    result: Result<Value, String>,
+) {
+    if fresh
+        && !result
+            .as_ref()
+            .is_ok_and(|value| value["status"] == "completed")
+        && let Ok(profiles) = profiles()
+    {
+        discard(&profiles, &profile.id);
+    }
+    let _ = reply.send(result);
+}
+
+fn enrollment_home(profile: &CredentialProfile) -> std::path::PathBuf {
+    std::env::temp_dir().join(format!("omd-credential-enrollment-{}", profile.id))
+}
+
+fn enrolled(
+    profile: &CredentialProfile,
+    home: &std::path::Path,
+    keyring: codex_login::AuthKeyringBackendKind,
+) -> Result<Value, String> {
+    let mode = codex_login::AuthCredentialsStoreMode::Ephemeral;
+    let auth = codex_login::load_auth_dot_json(home, mode, keyring)
+        .map_err(|error| error.to_string())?
+        .ok_or("credentials_sign_in_incomplete")?;
+    let _ = codex_login::logout(home, mode, keyring);
+    profiles()?
+        .store_auth(
+            &profile.id,
+            &serde_json::to_string(&auth).map_err(|error| error.to_string())?,
+        )
+        .map_err(|error| error.to_string())?;
+    Ok(completed(profile))
+}
+
+impl App {
+    pub(super) fn run_mod_credentials(&mut self, call: SurfaceCall) {
+        let result = (|| {
+            let request = parse(&call)?;
+            let profiles = profiles()?;
+            match request.action.as_str() {
+                "remove" => {
+                    let id = request.profile.unwrap_or_default();
+                    let profile = profiles.profile(&id).map_err(|error| error.to_string())?;
+                    if profile.kind == "secret"
+                        && profile.owner.as_deref() != Some(call.caller.as_str())
+                    {
+                        return Err(format!("credential_secret_not_owned: {id}"));
+                    }
+                    let reply = call.reply.clone();
+                    tokio::task::spawn_blocking(move || {
+                        let _ = reply.send(
+                            profiles
+                                .remove(&id)
+                                .map(|_| json!({"status": "completed", "profile": null}))
+                                .map_err(|error| error.to_string()),
+                        );
+                    });
+                    Ok(None)
+                }
+                _ => {
+                    let fresh = request.action == "enroll";
+                    let profile = if fresh && request.kind.as_deref() == Some("secret") {
+                        profiles
+                            .create_secret(
+                                request.label.as_deref().unwrap_or_default(),
+                                request.origin.as_deref().unwrap_or_default(),
+                                &call.caller,
+                            )
+                            .map_err(|error| error.to_string())?
+                    } else if fresh {
+                        profiles
+                            .create(
+                                request.label.as_deref().unwrap_or_default(),
+                                request.kind.as_deref().unwrap_or_default(),
+                                request.provider.as_deref(),
+                                request.origin.as_deref(),
+                            )
+                            .map_err(|error| error.to_string())?
+                    } else {
+                        profiles
+                            .profile(request.profile.as_deref().unwrap_or_default())
+                            .map_err(|error| error.to_string())?
+                    };
+                    let home = enrollment_home(&profile);
+                    match profile.kind.as_str() {
+                        "api_key" | "provider" => {
+                            self.prompt_for_key(call.reply.clone(), profile, home, fresh);
+                            Ok(None)
+                        }
+                        "chatgpt" => {
+                            self.sign_in(call.reply.clone(), profile, home, fresh)?;
+                            Ok(None)
+                        }
+                        "secret" if profile.owner.as_deref() == Some(call.caller.as_str()) => {
+                            self.prompt_for_secret(call.reply.clone(), profile, fresh);
+                            Ok(None)
+                        }
+                        _ => {
+                            if fresh {
+                                discard(&profiles, &profile.id);
+                            }
+                            Err(format!("credential_secret_not_owned: {}", profile.id))
+                        }
+                    }
+                }
+            }
+        })();
+        match result {
+            Ok(Some(value)) => {
+                let _ = call.reply.send(Ok(value));
+            }
+            Ok(None) => {}
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
+    fn prompt_for_key(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        home: std::path::PathBuf,
+        fresh: bool,
+    ) {
+        let keyring = self.config.auth_keyring_backend_kind();
+        let title = format!("Key for credential profile \"{}\"", profile.label);
+        self.chat_widget
+            .show_mod_secret_prompt(SecretPromptView::new(
+                title,
+                "Stored in OMD's credential store. Mods never see it.".to_owned(),
+                Box::new(move |key| {
+                    tokio::task::spawn_blocking(move || {
+                        let result = match key {
+                            Some(key) => codex_login::login_with_api_key(
+                                &home,
+                                &key,
+                                codex_login::AuthCredentialsStoreMode::Ephemeral,
+                                keyring,
+                            )
+                            .map_err(|error| error.to_string())
+                            .and_then(|()| enrolled(&profile, &home, keyring)),
+                            None => Ok(json!({"status": "declined", "profile": null})),
+                        };
+                        finish(&reply, &profile, fresh, result);
+                    });
+                }),
+            ));
+    }
+
+    fn prompt_for_secret(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        fresh: bool,
+    ) {
+        let title = format!(
+            "Secret \"{}\" for {}",
+            profile.label,
+            profile.origin.as_deref().unwrap_or_default()
+        );
+        self.chat_widget
+            .show_mod_secret_prompt(SecretPromptView::new(
+                title,
+                "Stored in OMD's credential store and given only to this mod's sidecars."
+                    .to_owned(),
+                Box::new(move |value| {
+                    tokio::task::spawn_blocking(move || {
+                        let result = match (value, profiles()) {
+                            (Some(value), Ok(profiles)) => profiles
+                                .store_secret(&profile.id, &value)
+                                .map(|()| completed(&profile))
+                                .map_err(|error| error.to_string()),
+                            (None, _) => Ok(json!({"status": "declined", "profile": null})),
+                            (_, Err(error)) => Err(error),
+                        };
+                        finish(&reply, &profile, fresh, result);
+                    });
+                }),
+            ));
+    }
+
+    fn sign_in(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        home: std::path::PathBuf,
+        fresh: bool,
+    ) -> Result<(), String> {
+        let keyring = self.config.auth_keyring_backend_kind();
+        let options = codex_login::ServerOptions {
+            open_browser: true,
+            ..codex_login::ServerOptions::new(
+                home.clone(),
+                codex_login::oauth_client_id(),
+                None,
+                codex_login::AuthCredentialsStoreMode::Ephemeral,
+                keyring,
+                self.config.auth_route_config(),
+            )
+        };
+        let server = codex_login::run_login_server(options).map_err(|error| {
+            if fresh && let Ok(profiles) = profiles() {
+                discard(&profiles, &profile.id);
+            }
+            format!("credentials_sign_in_unavailable: {error}")
+        })?;
+        self.chat_widget.add_info_message(
+            format!(
+                "Sign in for credential profile \"{}\": {}",
+                profile.label, server.auth_url
+            ),
+            None,
+        );
+        tokio::spawn(async move {
+            let result = server
+                .block_until_done()
+                .await
+                .map_err(|error| error.to_string());
+            let _ = tokio::task::spawn_blocking(move || {
+                let result = result.and_then(|()| enrolled(&profile, &home, keyring));
+                finish(&reply, &profile, fresh, result);
+            })
+            .await;
+        });
+        Ok(())
+    }
+}
diff --git a/codex-rs/tui/src/app/mod_surface.rs b/codex-rs/tui/src/app/mod_surface.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1dd5b2814acf75230f100ffe6d7c969d651c276
--- /dev/null
+++ b/codex-rs/tui/src/app/mod_surface.rs
@@ -0,0 +1,2242 @@
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::omd::LockExt;
+use crate::tui;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ServerRequest;
+use codex_omd::client_surface::NoticeRequest;
+use codex_omd::client_surface::SurfaceCall;
+use codex_omd::client_surface::notice_request;
+use serde_json::Value;
+use serde_json::json;
+
+const IMPORT_BYTES: u64 = 8 * 1024 * 1024;
+const STANDARD_CONTEXT_WINDOW: u64 = 272_000;
+
+fn selection_result(mut text: Option<String>) -> Value {
+    let mut truncated = false;
+    if let Some(text) = text.as_mut() {
+        // Reserve both receipt envelopes and the text repeated in terminal.copy arguments.
+        let limit = 65_536 - 256;
+        let (mut end, mut encoded) = (0, 2);
+        for character in text.chars() {
+            let bytes = match character {
+                '"' | '\\' | '\n' | '\r' | '\t' | '\u{8}' | '\u{c}' => 2,
+                '\u{0}'..='\u{1f}' => 6,
+                _ => character.len_utf8(),
+            };
+            if encoded + bytes > limit {
+                break;
+            }
+            encoded += bytes;
+            end += character.len_utf8();
+        }
+        truncated = end < text.len();
+        text.truncate(end);
+    }
+    json!({"text": text, "truncated": truncated})
+}
+
+fn copy_text(arguments: &Value) -> Result<&str, String> {
+    arguments["text"]
+        .as_str()
+        .filter(|text| text.len() <= 65_536)
+        .filter(|_| arguments.as_object().is_some_and(|args| args.len() == 1))
+        .ok_or_else(|| "terminal_copy_arguments_invalid".into())
+}
+
+fn store_paths() -> Result<(std::path::PathBuf, std::path::PathBuf), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store.ok_or("mod store is not configured")?;
+    Ok((store, paths.repository))
+}
+
+fn materialize(
+    caller: &str,
+    thread: Option<&str>,
+    reference: &Value,
+) -> Result<std::path::PathBuf, String> {
+    let (store, repository) = store_paths()?;
+    codex_omd::client_surface::materialize(&store, &repository, caller, thread, reference)
+}
+
+impl App {
+    /// User-captured prompts: a user action grants a single-use consent that any context may spend.
+    fn prompts(&mut self, call: &SurfaceCall) -> Result<Value, String> {
+        let root = crate::omd::mod_paths()
+            .and_then(|paths| paths.store)
+            .ok_or("mod store is not configured")?;
+        let thread = call
+            .thread
+            .clone()
+            .or_else(crate::mod_surface::current_thread)
+            .ok_or("thread_unavailable")?;
+        let arguments = &call.arguments;
+        let consent = arguments["consent"].as_str().unwrap_or_default();
+        let content = || -> Result<(String, Vec<codex_omd::resource_data::ResourceRef>), String> {
+            let text = arguments["text"]
+                .as_str()
+                .filter(|text| !text.trim().is_empty() && text.len() <= 61_440)
+                .ok_or("prompt_text_invalid")?;
+            let attachments = match arguments.get("attachments") {
+                None | Some(Value::Null) => Vec::new(),
+                Some(value) => serde_json::from_value::<Vec<_>>(value.clone())
+                    .ok()
+                    .filter(|items| items.len() <= 8)
+                    .ok_or("prompt_attachments_invalid")?,
+            };
+            Ok((text.to_owned(), attachments))
+        };
+        let active = |owner: &str| caller_source(owner).is_some();
+        let io = |error: std::io::Error| error.to_string();
+        match call.operation.as_str() {
+            "prompts.consent" => {
+                if call.context != codex_omd::app_routes::InvocationContext::User {
+                    return Err("host_operation_user_only: prompts.consent".into());
+                }
+                let (text, attachments) = content()?;
+                let sha256 = codex_omd::consents::digest(&text, &attachments);
+                let id = uuid::Uuid::new_v4().to_string();
+                codex_omd::consents::retain(&root, &thread, |consent| active(&consent.owner))
+                    .map_err(io)?;
+                codex_omd::consents::grant(&root, &thread, &call.caller, &sha256, &id)
+                    .map_err(io)?;
+                Ok(json!({"consent": id, "sha256": sha256}))
+            }
+            "prompts.submit" => {
+                let (text, attachments) = content()?;
+                let steer = match arguments["mode"].as_str() {
+                    Some("turn") => false,
+                    Some("steer") => true,
+                    _ => return Err("prompt_mode_invalid".into()),
+                };
+                let client_id = arguments["client_id"]
+                    .as_str()
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| uuid::Uuid::new_v4().to_string());
+                if let Some(reason) = self.chat_widget.mod_prompt_blocked(steer) {
+                    return Ok(json!({"status": "not_submitted", "reason": reason}));
+                }
+                let images = attachments
+                    .iter()
+                    .map(|reference| {
+                        materialize(
+                            &call.caller,
+                            Some(&thread),
+                            &serde_json::to_value(reference).unwrap_or_default(),
+                        )
+                    })
+                    .collect::<Result<Vec<_>, _>>()?;
+                let sha256 = codex_omd::consents::digest(&text, &attachments);
+                codex_omd::consents::consume(
+                    &root,
+                    &thread,
+                    &call.caller,
+                    consent,
+                    &sha256,
+                    &client_id,
+                )
+                .map_err(io)?;
+                match self
+                    .chat_widget
+                    .mod_submit_prompt(text, images, client_id.clone(), steer)
+                {
+                    Ok(status) => Ok(json!({"status": status, "client_id": client_id})),
+                    Err(reason) => {
+                        codex_omd::consents::restore(&root, &thread, consent).map_err(io)?;
+                        Ok(json!({"status": "not_submitted", "reason": reason}))
+                    }
+                }
+            }
+            "prompts.status" => {
+                let found = codex_omd::consents::status(&root, &thread, &call.caller, consent)
+                    .map_err(io)?;
+                Ok(match found {
+                    None => json!({"state": "missing"}),
+                    Some(found) => match (found.client_id, found.turn_id) {
+                        (None, _) => json!({"state": "pending"}),
+                        (Some(client_id), Some(turn_id)) => {
+                            json!({"state": "delivered", "client_id": client_id, "turn_id": turn_id})
+                        }
+                        (Some(client_id), None) => {
+                            json!({"state": "unconfirmed", "client_id": client_id})
+                        }
+                    },
+                })
+            }
+            _ => {
+                let dropped = codex_omd::consents::retain(&root, &thread, |found| {
+                    found.owner != call.caller || found.id != consent
+                })
+                .map_err(io)?;
+                Ok(json!({"revoked": dropped}))
+            }
+        }
+    }
+}
+
+fn caller_source(caller: &str) -> Option<String> {
+    crate::omd::mod_status()?["mods"]
+        .as_array()?
+        .iter()
+        .find(|item| item["id"] == caller)?["sha256"]
+        .as_str()
+        .map(str::to_owned)
+}
+
+/// An attachment's resource for one reader, by file identity: `(sha256, dimensions, resource)`.
+type DraftResource = (String, Option<(u32, u32)>, Value);
+/// The reader's resource binding, then the file's path, label, length, inode and change time.
+type DraftKey = (Value, std::path::PathBuf, Value, u64, u64, (i64, i64));
+static DRAFT_RESOURCES: std::sync::Mutex<Vec<(DraftKey, DraftResource)>> =
+    std::sync::Mutex::new(Vec::new());
+
+/// Replaces each attachment path with an immutable image resource bound to the reading mod.
+fn draft_resources(caller: &str, thread: Option<&str>, draft: &mut Value) -> Result<(), String> {
+    let Some(attachments) = draft["attachments"].as_array_mut() else {
+        return Ok(());
+    };
+    let mut seen = std::collections::BTreeMap::<String, usize>::new();
+    for attachment in attachments {
+        let path = attachment
+            .as_object_mut()
+            .and_then(|object| object.remove("path"))
+            .and_then(|path| path.as_str().map(std::path::PathBuf::from));
+        let metadata = path.as_ref().and_then(|path| std::fs::metadata(path).ok());
+        let image = |path: &std::path::Path| {
+            let mut magic = [0; 8];
+            std::fs::File::open(path)
+                .and_then(|mut file| std::io::Read::read_exact(&mut file, &mut magic))
+                .is_ok_and(|()| {
+                    magic.starts_with(b"\x89PNG\r\n\x1a\n")
+                        || magic.starts_with(&[0xFF, 0xD8, 0xFF])
+                })
+        };
+        let resolved = match path.zip(metadata).filter(|(path, metadata)| {
+            metadata.is_file() && metadata.len() <= IMPORT_BYTES && image(path)
+        }) {
+            None => None,
+            Some((path, metadata)) => {
+                let (mut host, _) = crate::mod_surface::resource_binding(caller, thread)?;
+                host.binding.thread = "package".into();
+                host.binding.generation = 0;
+                let binding =
+                    serde_json::to_value(&host.binding).map_err(|error| error.to_string())?;
+                use std::os::unix::fs::MetadataExt;
+                let key = (
+                    binding,
+                    path,
+                    attachment["label"].clone(),
+                    metadata.len(),
+                    metadata.ino(),
+                    (metadata.ctime(), metadata.ctime_nsec()),
+                );
+                let cached = DRAFT_RESOURCES.lock().ok().and_then(|cache| {
+                    cache
+                        .iter()
+                        .find(|(known, _)| *known == key)
+                        .map(|(_, found)| found.clone())
+                });
+                match cached {
+                    Some(found) => Some(found),
+                    None => draft_resource(&host, &key.1, &key.2)?.inspect(|found| {
+                        if let Ok(mut cache) = DRAFT_RESOURCES.lock() {
+                            if cache.len() >= 32 {
+                                cache.remove(0);
+                            }
+                            cache.push((key, found.clone()));
+                        }
+                    }),
+                }
+            }
+        };
+        let Some((sha256, dimensions, resource)) = resolved else {
+            attachment["id"] = json!(attachment["label"]);
+            attachment["resource"] = Value::Null;
+            continue;
+        };
+        let count = seen.entry(sha256.clone()).or_default();
+        *count += 1;
+        attachment["id"] = json!(format!("img-{}-{count}", &sha256[..12]));
+        if let Some((width, height)) = dimensions {
+            attachment["width"] = json!(width);
+            attachment["height"] = json!(height);
+        }
+        attachment["resource"] = resource;
+    }
+    Ok(())
+}
+
+/// Saves an attached PNG or JPEG as an evidence resource; `None` for anything else.
+fn draft_resource(
+    host: &codex_omd::scoped_data::ScopedDataHost,
+    path: &std::path::Path,
+    label: &Value,
+) -> Result<Option<DraftResource>, String> {
+    let mut bytes = Vec::new();
+    if std::fs::File::open(path)
+        .and_then(|file| {
+            std::io::Read::read_to_end(&mut std::io::Read::take(file, IMPORT_BYTES + 1), &mut bytes)
+        })
+        .is_err()
+        || bytes.len() as u64 > IMPORT_BYTES
+    {
+        return Ok(None);
+    }
+    let media = match bytes.as_slice() {
+        bytes if bytes.starts_with(b"\x89PNG\r\n\x1a\n") => "image/png",
+        [0xFF, 0xD8, 0xFF, ..] => "image/jpeg",
+        _ => return Ok(None),
+    };
+    let resources = host.resources();
+    use base64::Engine;
+    let record = resources
+        .evidence_record(json!({"media_type": media,
+            "base64": base64::engine::general_purpose::STANDARD.encode(&bytes),
+            "label": label}))
+        .map_err(|error| error.to_string())?;
+    let reference = resources
+        .save("evidence", record)
+        .map_err(|error| error.to_string())?;
+    Ok(Some((
+        codex_omd::resource_data::hash(&bytes),
+        crate::mod_components::dimensions(&bytes),
+        serde_json::to_value(reference).map_err(|error| error.to_string())?,
+    )))
+}
+
+fn translate_images(caller: &str, thread: Option<&str>, value: &mut Value) -> Result<(), String> {
+    let (store, repository) = store_paths()?;
+    codex_omd::client_surface::translate_images(&store, &repository, caller, thread, value)
+}
+
+pub(crate) fn spawn_app_request(
+    call: SurfaceCall,
+    handle: codex_app_server_client::AppServerRequestHandle,
+    id: codex_app_server_protocol::RequestId,
+) {
+    let method = call.arguments["method"]
+        .as_str()
+        .unwrap_or_default()
+        .to_owned();
+    let mut params = call.arguments["params"].clone();
+    if let Err(error) = translate_images(&call.caller, call.thread.as_deref(), &mut params) {
+        let _ = call.reply.send(Err(error));
+        return;
+    }
+    let request = json!({"method": method, "id": id, "params": params});
+    let request = match serde_json::from_value::<codex_app_server_protocol::ClientRequest>(request)
+    {
+        Ok(request) => request,
+        Err(error) => {
+            let _ = call.reply.send(Err(format!("app_params_invalid: {error}")));
+            return;
+        }
+    };
+    tokio::spawn(async move {
+        if let Err(error) = crate::mod_surface::validate_call(&call) {
+            let _ = call.reply.send(Err(error));
+            return;
+        }
+        let result = handle
+            .request_typed::<Value>(request)
+            .await
+            .map_err(|error| error.to_string());
+        let _ = call.reply.send(result);
+    });
+}
+
+type PackageControl = codex_omd::package_controls::PackageControl;
+
+enum Confirmed {
+    Package(Box<PackageControl>),
+    Route(Box<codex_omd::plan_routes::PlanRoute>),
+    RouteWrite(Box<codex_omd::route_writes::RouteWrite>),
+    Contract(Option<String>),
+    Pty(crate::mod_pty::Binding),
+}
+
+static CONFIRMED: std::sync::Mutex<std::collections::BTreeMap<u64, Confirmed>> =
+    std::sync::Mutex::new(std::collections::BTreeMap::new());
+
+type Confirmation = (Option<String>, String, Option<Confirmed>);
+
+fn confirmation(call: &SurfaceCall) -> Result<Option<Confirmation>, String> {
+    let invoked = call.arguments["command"]
+        .as_str()
+        .unwrap_or_default()
+        .trim_start_matches('/');
+    let prompt = match call.operation.as_str() {
+        "terminal.import_file" => Some(format!(
+            "Mod {} wants to import {}.",
+            call.caller,
+            import_target(&call.arguments)?.display()
+        )),
+        "packages.apply" => {
+            let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+            let store =
+                codex_omd::ModStore::open(paths.store.ok_or("mod store is not configured")?)
+                    .map_err(|error| error.to_string())?;
+            let preview = codex_omd::package_controls::preview(&store, call.arguments.clone())
+                .map_err(|error| error.to_string())?;
+            if !call.arguments["expected_generation"].is_u64() {
+                return Err("expected_generation_required".into());
+            }
+            let title = format!(
+                "Allow {} to {} {}?",
+                call.caller,
+                call.arguments["action"].as_str().unwrap_or("change"),
+                preview.public["id"]
+                    .as_str()
+                    .or_else(|| call.arguments["id"].as_str())
+                    .unwrap_or("a mod"),
+            );
+            let grants = preview.public["grants_added"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_str)
+                .map(|capability| format!("• {}", codex_omd::capability_phrase(capability)))
+                .collect::<Vec<_>>();
+            let added = preview.public["grants_added"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_str)
+                .map(str::to_owned)
+                .collect::<Vec<_>>();
+            let mut prompt = if grants.is_empty() {
+                "It gets no new permissions.".to_owned()
+            } else {
+                format!("It would be allowed to:\n{}", grants.join("\n"))
+            };
+            for exposure in codex_omd::authority_exposure(&added) {
+                prompt.push_str("\n\n");
+                prompt.push_str(exposure);
+            }
+            return Ok(Some((
+                Some(title),
+                prompt,
+                Some(Confirmed::Package(Box::new(preview.control))),
+            )));
+        }
+        "contract.select" => {
+            let (documents, store, repository, key) = contract_inputs(&call.arguments)?;
+            let plan = codex_omd::contract_cli::plan(&documents, &store, &repository, &key)
+                .map_err(|error| error.to_string())?;
+            let mut prompt = format!(
+                "{}\nIt applies from the next session.",
+                plan["after"]["description"].as_str().unwrap_or(&key)
+            );
+            if plan["weakens"] == true {
+                prompt.push_str(&format!(
+                    "\nThis lowers assurance from {} to {}.",
+                    plan["before"]["contract"]["assurance"]
+                        .as_str()
+                        .unwrap_or("the current contract"),
+                    plan["after"]["assurance"].as_str().unwrap_or(&key)
+                ));
+            }
+            return Ok(Some((
+                Some(format!(
+                    "Select workflow contract {key} for this repository?"
+                )),
+                prompt,
+                Some(Confirmed::Contract(
+                    plan["confirmation"].as_str().map(str::to_owned),
+                )),
+            )));
+        }
+        "credentials.request" => Some(super::mod_credentials::prompt(call)?),
+        "config.set"
+            if !call.arguments["key"]
+                .as_str()
+                .is_some_and(|key| key.starts_with(&format!("mods.{}.", call.caller))) =>
+        {
+            Some(format!(
+                "Mod {} wants to set {} to {}.",
+                call.caller,
+                call.arguments["key"].as_str().unwrap_or_default(),
+                prompt_text(&Value::String(call.arguments["value"].to_string()), 2000)?
+            ))
+        }
+        "commands.invoke"
+            if crate::mod_runtime::find(invoked)
+                .is_some_and(|command| command.target.id != call.caller) =>
+        {
+            let args = call.arguments["args"].as_str().unwrap_or_default();
+            Some(format!(
+                "Mod {} wants to run another mod's command {}.",
+                call.caller,
+                prompt_text(
+                    &Value::String(format!("/{invoked} {args}").trim_end().to_owned()),
+                    2000
+                )?
+            ))
+        }
+        "terminal.open" => Some(format!(
+            "Mod {} wants to open {} outside the terminal.",
+            call.caller,
+            open_target(&call.arguments)?
+        )),
+        "terminal.pty"
+            if call.arguments["action"] == "start" && call.arguments["sandbox"] == "none" =>
+        {
+            None
+        }
+        "terminal.pty" if call.arguments["action"] == "start" => {
+            Some(crate::mod_pty::start_prompt(&call.caller, &call.arguments)?)
+        }
+        "terminal.prompt" if call.arguments["kind"] == "confirm" => Some(format!(
+            "{}\n{}",
+            prompt_text(&call.arguments["title"], 120)?,
+            prompt_text(&call.arguments["message"], 2000)?
+        )),
+        _ => call.confirm.clone(),
+    };
+    Ok(prompt.map(|prompt| (None, prompt, None)))
+}
+
+fn prompt_text(value: &Value, limit: usize) -> Result<String, String> {
+    value
+        .as_str()
+        .filter(|text| !text.is_empty() && text.len() <= limit)
+        .map(|text| {
+            text.chars()
+                .filter(|c| !c.is_control() || *c == '\n')
+                .collect()
+        })
+        .ok_or_else(|| "terminal_prompt_invalid".to_owned())
+}
+
+const OPEN_EXTENSIONS: &[&str] = &[
+    "html", "htm", "md", "txt", "pdf", "png", "jpg", "jpeg", "gif", "svg",
+];
+
+fn editor_target(arguments: &Value) -> Result<(std::path::PathBuf, u64), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let path = std::fs::canonicalize(
+        arguments["path"]
+            .as_str()
+            .ok_or("terminal_open_target_invalid")?,
+    )
+    .map_err(|_| "terminal_open_path_unavailable")?;
+    let line = match &arguments["line"] {
+        Value::Null => 1,
+        line => line
+            .as_u64()
+            .filter(|line| (1..=10_000_000).contains(line))
+            .ok_or("terminal_open_line_invalid")?,
+    };
+    let inside = path.starts_with(&paths.repository)
+        && !paths.protected.iter().any(|root| path.starts_with(root))
+        && std::fs::metadata(&path).is_ok_and(|metadata| metadata.is_file());
+    inside
+        .then_some((path, line))
+        .ok_or_else(|| "terminal_open_path_refused".to_owned())
+}
+
+fn configured_editor() -> Result<Vec<String>, String> {
+    let store = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .ok_or("mod store is not configured")?;
+    let config: Value = std::fs::read(store.join("host.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+        .unwrap_or(Value::Null);
+    config["editor"]
+        .as_array()
+        .filter(|argv| (1..=16).contains(&argv.len()))
+        .and_then(|argv| {
+            argv.iter()
+                .map(|arg| arg.as_str().map(str::to_owned))
+                .collect::<Option<Vec<_>>>()
+        })
+        .ok_or_else(|| "terminal_open_editor_unconfigured: set \"editor\" in host.json".to_owned())
+}
+
+fn open_target(arguments: &Value) -> Result<String, String> {
+    if arguments["editor"] == true {
+        let (path, line) = editor_target(arguments)?;
+        return Ok(format!("{}:{line} in your editor", path.display()));
+    }
+    match (arguments["url"].as_str(), arguments["path"].as_str()) {
+        (Some(url), None)
+            if (url.starts_with("https://") || url.starts_with("http://"))
+                && url.len() <= 2048
+                && !url.chars().any(|c| c.is_control() || c.is_whitespace()) =>
+        {
+            Ok(url.to_owned())
+        }
+        (None, Some(path)) => {
+            let path = std::fs::canonicalize(path).map_err(|_| "terminal_open_path_unavailable")?;
+            let allowed = std::fs::metadata(&path).is_ok_and(|metadata| metadata.is_file())
+                && path
+                    .extension()
+                    .and_then(|extension| extension.to_str())
+                    .is_some_and(|extension| {
+                        OPEN_EXTENSIONS.contains(&extension.to_ascii_lowercase().as_str())
+                    });
+            allowed
+                .then(|| path.to_string_lossy().into_owned())
+                .ok_or_else(|| "terminal_open_type_refused".to_owned())
+        }
+        _ => Err("terminal_open_target_invalid".into()),
+    }
+}
+
+fn open(arguments: &Value) -> Result<Value, String> {
+    if arguments["editor"] == true {
+        let (path, line) = editor_target(arguments)?;
+        let mut argv = configured_editor()?.into_iter().map(|arg| {
+            arg.replace("{path}", &path.to_string_lossy())
+                .replace("{line}", &line.to_string())
+        });
+        let program = argv.next().ok_or("terminal_open_editor_unconfigured")?;
+        return std::process::Command::new(program)
+            .args(argv)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .map(|_| json!({"opened": true}))
+            .map_err(|error| format!("terminal_open_failed: {error}"));
+    }
+    let target = open_target(arguments)?;
+    let program = if cfg!(target_os = "macos") {
+        "open"
+    } else {
+        "xdg-open"
+    };
+    std::process::Command::new(program)
+        .arg(&target)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .map(|_| json!({"opened": true}))
+        .map_err(|error| format!("terminal_open_failed: {error}"))
+}
+
+fn import_target(arguments: &Value) -> Result<std::path::PathBuf, String> {
+    std::path::Path::new(arguments["path"].as_str().ok_or("import_path_required")?)
+        .canonicalize()
+        .map_err(|error| error.to_string())
+}
+
+fn svg(bytes: &[u8]) -> bool {
+    let mut rest = bytes.strip_prefix(b"\xef\xbb\xbf").unwrap_or(bytes);
+    loop {
+        rest = rest.trim_ascii_start();
+        let close: &[u8] = if rest.starts_with(b"<?xml") {
+            b"?>"
+        } else if rest.starts_with(b"<!--") {
+            b"-->"
+        } else {
+            break;
+        };
+        let Some(end) = rest.windows(close.len()).position(|window| window == close) else {
+            return false;
+        };
+        rest = &rest[end + close.len()..];
+    }
+    rest.starts_with(b"<svg")
+        && rest
+            .get(4)
+            .is_some_and(|byte| byte.is_ascii_whitespace() || matches!(byte, b'/' | b'>'))
+}
+
+fn read_import(path: &std::path::Path, limit: u64) -> Result<Vec<u8>, String> {
+    use std::io::Read;
+    use std::os::unix::fs::OpenOptionsExt;
+    let regular = std::fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if !regular.is_file() {
+        return Err("import_file_invalid_or_too_large".into());
+    }
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|error| error.to_string())?;
+    let metadata = file.metadata().map_err(|error| error.to_string())?;
+    if !metadata.is_file() || metadata.len() > limit {
+        return Err("import_file_invalid_or_too_large".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(limit)
+        .read_to_end(&mut bytes)
+        .map_err(|error| error.to_string())?;
+    Ok(bytes)
+}
+
+fn import_file(call: &SurfaceCall) -> Result<Value, String> {
+    let lifetime = match call.arguments["lifetime"].as_str() {
+        None | Some("thread") => false,
+        Some("package") => true,
+        _ => return Err("import_file_lifetime_invalid".into()),
+    };
+    let limit = call.arguments["max_bytes"]
+        .as_u64()
+        .unwrap_or(IMPORT_BYTES)
+        .min(IMPORT_BYTES);
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let canonical = import_target(&call.arguments)?;
+    if paths
+        .protected
+        .iter()
+        .any(|root| canonical.starts_with(root))
+        || paths
+            .store
+            .as_ref()
+            .is_some_and(|store| canonical.starts_with(store))
+    {
+        return Err("import_file_protected".into());
+    }
+    let bytes = read_import(&canonical, limit)?;
+    let media_type = if bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        "image/png"
+    } else if bytes.starts_with(&[0xff, 0xd8, 0xff]) {
+        "image/jpeg"
+    } else if svg(&bytes) {
+        "image/svg+xml"
+    } else {
+        "application/octet-stream"
+    };
+    let (mut host, _) = crate::mod_surface::resource_binding(&call.caller, call.thread.as_deref())?;
+    if lifetime {
+        host.binding.thread = "package".into();
+        host.binding.generation = 0;
+    }
+    let resources = host.resources();
+    use base64::Engine;
+    let record = resources
+        .evidence_record(json!({"media_type": media_type,
+            "base64": base64::engine::general_purpose::STANDARD.encode(&bytes),
+            "label": canonical.file_name().map(|name| name.to_string_lossy().into_owned())}))
+        .map_err(|error| error.to_string())?;
+    let reference = resources
+        .save("evidence", record)
+        .map_err(|error| error.to_string())?;
+    serde_json::to_value(reference).map_err(|error| error.to_string())
+}
+
+fn image_sample_dimensions(arguments: &Value) -> Result<(u32, u32), String> {
+    let columns = arguments["columns"]
+        .as_u64()
+        .filter(|value| (1..=120).contains(value))
+        .ok_or("image_sample_columns_invalid")? as u32;
+    let rows = arguments["rows"]
+        .as_u64()
+        .filter(|value| (1..=60).contains(value))
+        .ok_or("image_sample_rows_invalid")? as u32;
+    Ok((columns, rows))
+}
+
+fn image_sample(call: &SurfaceCall) -> Result<Value, String> {
+    let reference: codex_omd::resource_data::ResourceRef =
+        serde_json::from_value(call.arguments["resource"].clone())
+            .map_err(|_| "image_resource_invalid".to_owned())?;
+    let (columns, rows) = image_sample_dimensions(&call.arguments)?;
+    let (host, _) = crate::mod_surface::resource_binding(&call.caller, call.thread.as_deref())?;
+    let resources = host.resources();
+    let record = resources
+        .load(&reference, "evidence")
+        .map_err(|error| error.to_string())?;
+    let bytes = resources
+        .blob(record["blob"].as_str().ok_or("image_blob_missing")?)
+        .map_err(|error| error.to_string())?;
+    let image = codex_omd::client_surface::decode_image(&bytes)?;
+    let rgba = image
+        .resize_exact(columns, rows, image::imageops::FilterType::Triangle)
+        .to_rgba8()
+        .into_raw();
+    Ok(json!({"width":columns, "height":rows, "rgba":rgba}))
+}
+
+type ContractInputs = (
+    Vec<(codex_omd::ContractDocument, codex_omd::PolicyOwner)>,
+    std::path::PathBuf,
+    std::path::PathBuf,
+    String,
+);
+
+fn contract_inputs(arguments: &Value) -> Result<ContractInputs, String> {
+    let key = arguments["contract"]
+        .as_str()
+        .filter(|key| !key.is_empty() && key.len() <= 128)
+        .ok_or("contract_key_required")?
+        .to_owned();
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store.ok_or("mod store is not configured")?;
+    let documents = crate::mod_runtime::contract_documents().ok_or("mod runtime unavailable")?;
+    Ok((documents, store, paths.repository, key))
+}
+
+// The confirmation comes from the plan the user saw, so a selection that changed since then is refused.
+fn select_contract(arguments: &Value, confirmed: Option<Confirmed>) -> Result<Value, String> {
+    let Some(Confirmed::Contract(confirmation)) = confirmed else {
+        return Err("contract_confirmation_missing".into());
+    };
+    let (documents, store, repository, key) = contract_inputs(arguments)?;
+    codex_omd::contract_cli::select(&documents, &store, &repository, &key, confirmation)
+        .map(|selected| json!({"selected": selected["selected"], "applies": "next_session"}))
+        .map_err(|error| error.to_string())
+}
+
+/// `config.describe` and `config.set` against one `config/read` result; `write` saves a Codex key.
+fn config_call(
+    call: &SurfaceCall,
+    read: &Value,
+    write: impl Fn(&str, &Value, &Value) -> Result<Value, String>,
+) -> Result<Value, String> {
+    if call.operation == "config.describe" {
+        return crate::mod_runtime::describe_config(read).map(|rows| json!({"rows": rows}));
+    }
+    let key = call.arguments["key"]
+        .as_str()
+        .ok_or("config_key_required")?;
+    let value = call
+        .arguments
+        .get("value")
+        .cloned()
+        .ok_or("config_value_required")?;
+    let row = crate::mod_runtime::config_row(read, key)?;
+    let effective = crate::mod_runtime::set_config(
+        &row,
+        value,
+        call.arguments.get("expected"),
+        &call.caller,
+        |value| match key
+            .strip_prefix("mods.")
+            .and_then(|rest| rest.split_once('.'))
+        {
+            Some((id, name)) => {
+                let store = crate::omd::mod_paths()
+                    .and_then(|paths| paths.store)
+                    .ok_or("mod store is not configured")?;
+                codex_omd::ModStore::open(store)
+                    .and_then(|store| codex_omd::write_settings(&store, id, &json!({name: value})))
+                    .map_err(|error| error.to_string())
+            }
+            None => write(key, value, &row["version"]),
+        },
+    )?;
+    Ok(json!({"key": key, "effective": effective}))
+}
+
+fn apply_package(call: &SurfaceCall, confirmed: Option<Confirmed>) -> Result<Value, String> {
+    let Some(Confirmed::Package(control)) = confirmed else {
+        return Err("package_confirmation_missing".into());
+    };
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = codex_omd::ModStore::open(paths.store.ok_or("mod store is not configured")?)
+        .map_err(|error| error.to_string())?;
+    crate::mod_surface::validate_call(call)?;
+    call.lifetime.begin_execution()?;
+    codex_omd::package_controls::apply(&store, &control).map_err(|error| error.to_string())
+}
