+#[test]
+fn only_user_rule_denials_are_overridable() {
+    let mut parser = PolicyParser::new();
+    parser
+        .parse(
+            "user.rules",
+            r#"prefix_rule(pattern=["rm"], decision="forbidden")
+prefix_rule(pattern=["git", "push"], decision="forbidden")"#,
+        )
+        .expect("parse policy");
+    let manager = ExecPolicyManager::new(Arc::new(parser.build()));
+    let mut managed = Policy::empty();
+    managed
+        .add_prefix_rule(
+            &["git".to_string(), "push".to_string()],
+            Decision::Forbidden,
+        )
+        .expect("add prefix rule");
+    let managed = RequirementsExecPolicy::new(managed);
+    let command = |text: &str| vec!["bash".to_string(), "-lc".to_string(), text.to_string()];
+    assert!(manager.forbidden_only_by_user_rules(&command("rm -rf build"), Some(&managed)));
+    assert!(!manager.forbidden_only_by_user_rules(&command("git push"), Some(&managed)));
+    assert!(!manager.forbidden_only_by_user_rules(&command("ls && git push"), Some(&managed)));
+    assert!(!manager.forbidden_only_by_user_rules(&command("ls"), None));
+}
