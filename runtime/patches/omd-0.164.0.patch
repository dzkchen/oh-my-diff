+    assert_eq!(listed["tools"][1]["effective"], Value::Null);
+    assert_eq!(listed["tools"][2]["effective"]["deferred"], true);
+    assert_eq!(listed["tools"][3]["original"]["freeform"], true);
+    let stored = fixture.lead.host.root.join("tool-inventory.json");
