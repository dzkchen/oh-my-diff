+pub(crate) fn replaceable_tool_output(
+    invocation: &ToolInvocation,
+    output: &dyn ToolOutput,
+) -> Option<String> {
+    let thread_store = &invocation.session.services.thread_extension_data;
+    if !invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+        .iter()
+        .any(|contributor| contributor.replacing(thread_store))
+    {
+        return None;
+    }
+    response_text(output.to_response_item(&invocation.call_id, &invocation.payload))
+}
+
+pub(crate) fn response_text(item: ResponseInputItem) -> Option<String> {
+    match item {
+        ResponseInputItem::FunctionCallOutput { output, .. }
+        | ResponseInputItem::CustomToolCallOutput { output, .. } => match output.body {
+            codex_protocol::models::FunctionCallOutputBody::Text(text) => Some(text),
+            codex_protocol::models::FunctionCallOutputBody::ContentItems(items) => {
+                use codex_protocol::models::FunctionCallOutputContentItem as Item;
+                let mut parts = Vec::new();
+                for item in items {
+                    match item {
+                        Item::InputText { text } => parts.push(text),
+                        Item::InputImage { .. } | Item::InputAudio { .. } => return None,
+                        Item::EncryptedContent { .. } => {}
+                    }
+                }
+                (!parts.is_empty()).then(|| parts.join("\n"))
+            }
+        },
+        ResponseInputItem::McpToolCallOutput { output, .. } => {
+            serde_json::to_string(&output.content).ok()
+        }
+        _ => None,
+    }
+}
