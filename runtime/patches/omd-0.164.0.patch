+pub(crate) fn shared_host() -> Result<Arc<Mutex<ModHost>>, String> {
+    shared_host_active(&|| true)
+}
+
+fn try_lock_until<T>(
+    mutex: &Mutex<T>,
+    retry: impl Fn() -> bool,
+) -> Option<std::sync::MutexGuard<'_, T>> {
+    loop {
+        match mutex.try_lock() {
+            Ok(guard) => return Some(guard),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => return Some(poisoned.into_inner()),
+            Err(std::sync::TryLockError::WouldBlock) if retry() => {
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            Err(std::sync::TryLockError::WouldBlock) => return None,
+        }
+    }
+}
+
+fn shared_host_active(active: &dyn Fn() -> bool) -> Result<Arc<Mutex<ModHost>>, String> {
+    let mut host = try_lock_until(&HOST, active).ok_or("callback_cancelled")?;
+    if host.is_none() {
+        let paths = crate::omd::mod_paths().ok_or("mods are off in this directory")?;
+        let store = paths.store.ok_or("mod store is not configured")?;
+        let runtime = ModHost::open_in_guarded(store, |_| Ok(()), &paths.repository, active)
+            .map_err(|e| e.to_string())?;
+        if !active() {
+            return Err("callback_cancelled".to_owned());
+        }
+        *host = Some(Arc::new(Mutex::new(runtime)));
+    }
+    host.clone()
+        .ok_or_else(|| "mod runtime unavailable".to_owned())
+}
