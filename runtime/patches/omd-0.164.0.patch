+use super::*;
+use pretty_assertions::assert_eq;
+
+fn text(item: ResponseInputItem) -> (String, Option<bool>) {
+    let ResponseInputItem::FunctionCallOutput { output, .. } = item else {
+        panic!("expected a function call output");
+    };
+    (output.body.to_text().unwrap_or_default(), output.success)
+}
+
+#[test]
+fn merged_results_fan_out_by_call_id_and_missing_results_fail() {
+    let merged = Ok((r#"{"a":"alpha","b":{"n":2}}"#.to_owned(), true));
+    assert_eq!(
+        text(fan_out("a", &merged, false)),
+        ("alpha".to_owned(), Some(true))
+    );
+    assert_eq!(
+        text(fan_out("b", &merged, false)),
+        (r#"{"n":2}"#.to_owned(), Some(true))
+    );
+    let (missing, success) = text(fan_out("c", &merged, false));
+    assert!(missing.contains("no result for c"));
+    assert_eq!(success, Some(false));
+    let (failed, success) = text(fan_out("a", &Err("denied".to_owned()), false));
+    assert!(failed.contains("denied"));
+    assert_eq!(success, Some(false));
+    let (unparsed, _) = text(fan_out("a", &Ok(("plain".to_owned(), true)), false));
+    assert!(unparsed.contains("no result for a"));
+}
+
+#[test]
+fn merged_results_may_carry_a_success_flag_per_call_when_the_merge_asks() {
+    let merged = Ok((
+        r#"{"a":{"output":"read","success":true},"b":{"output":"missing","success":false},"c":{"output":"x","success":true,"extra":1}}"#
+            .to_owned(),
+        true,
+    ));
+    assert_eq!(
+        text(fan_out("a", &merged, true)),
+        ("read".to_owned(), Some(true))
+    );
+    assert_eq!(
+        text(fan_out("b", &merged, true)),
+        ("missing".to_owned(), Some(false))
+    );
+    assert_eq!(
+        text(fan_out("c", &merged, true)),
+        (
+            r#"{"extra":1,"output":"x","success":true}"#.to_owned(),
+            Some(true)
+        )
+    );
+    assert_eq!(
+        text(fan_out("b", &merged, false)),
+        (
+            r#"{"output":"missing","success":false}"#.to_owned(),
+            Some(true)
+        ),
+        "without the flag the value stays text, as before"
+    );
+    let failed = Ok((
+        r#"{"a":{"output":"read","success":true}}"#.to_owned(),
+        false,
+    ));
+    assert_eq!(
+        text(fan_out("a", &failed, true)),
+        ("read".to_owned(), Some(false))
+    );
+}
