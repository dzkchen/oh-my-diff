+#[test]
+#[serial_test::serial]
+fn cell_and_packed_blits_between_frames_merge_into_the_next_frame_in_order() {
+    let start = Instant::now();
+    let key = "raster-queue";
+    let at = |ms| start + Duration::from_millis(ms);
+    let draw = |width, no_color, now| {
+        super::rows(
+            key,
+            Some("owner"),
+            "chart",
+            width,
+            (4, 2),
+            no_color,
+            "",
+            now,
+        )
+    };
+    let cells = |rect: Value, cells: Value, now| {
+        blit_at(key, "owner", json!({"rect": rect, "cells": cells}), now).expect("queued")
+    };
+    let first = cells(
+        json!({"x": 1, "y": 0, "width": 2, "height": 1}),
+        json!(["a", "a"]),
+        start,
+    );
+    assert_eq!(first, json!({"frame": 1, "queued": 1, "frame_ms": 16}));
+    let (rows, next) = draw(10, false, start);
+    assert_eq!(
+        (text(&rows), next),
+        (vec![" aa ".into(), "    ".into()], None)
+    );
+    let merged = [
+        cells(
+            json!({"x": 1, "y": 0, "width": 2, "height": 1}),
+            json!(["b", ["b", "#ff0000", null]]),
+            at(1),
+        ),
+        blit(
+            "owner",
+            Some("owner".into()),
+            Some((4, 2)),
+            &json!({"key": key, "rect": {"x": 2, "y": 1, "width": 2, "height": 1},
+                "packed": packed(&[('c', 0x00ff_0000, 0x0100_0000), ('d', 0x0100_0000, 0x0200_0004)])}),
+            at(2),
+            |_, _| unreachable!(),
+        )
+        .expect("packed queued"),
+        cells(
+            json!({"x": 1, "y": 0, "width": 1, "height": 1}),
+            json!(["e"]),
+            at(3),
+        ),
+    ];
+    assert!(
+        merged
+            .iter()
+            .all(|reply| *reply == json!({"frame": 2, "queued": 1, "frame_ms": 16}))
+    );
+    let (rows, next) = draw(10, false, at(5));
+    assert_eq!(text(&rows), vec![" aa ", "    "]);
+    assert_eq!(next, Some(Duration::from_millis(11)));
+    assert_eq!(pending_delay(key, at(5)), Some(Duration::from_millis(11)));
+    let (rows, next) = draw(3, false, start + FRAME);
+    assert_eq!(
+        text(&rows),
+        vec![" eb", "  c"],
+        "one frame shows every merged update, later cells winning; narrow components clip"
+    );
+    assert_eq!(next, None);
+    let red = Some(crate::mod_ui::color(ModColor::Rgb(255, 0, 0)));
+    assert_eq!(rows[0].spans[3].style.fg, red);
+    assert_eq!(rows[1].spans[3].style.fg, red);
+    let (rows, _) = draw(10, false, start + FRAME);
+    assert_eq!(
+        rows[1].spans[4].style.bg,
+        Some(crate::mod_ui::color(ModColor::Indexed(4)))
+    );
+    let (rows, _) = draw(10, true, start + FRAME);
+    assert!(
+        rows.iter()
+            .flat_map(|row| &row.spans)
+            .all(|span| span.style == Style::default()),
+        "NO_COLOR drops packed and cell colors"
+    );
+    retain(&BTreeSet::new());
+}
