+#[cfg(test)]
+mod mock_boundary_tests {
+    use super::*;
+
+    fn call(operation: &str, arguments: Value) -> ModHostCall {
+        ModHostCall {
+            operation: operation.into(),
+            arguments,
+        }
+    }
+
+    #[test]
+    fn offline_mock_boundary_rejects_bad_requests_results_and_arguments() {
+        assert!(
+            OfflineHost::from_scenario(
+                &json!({"host_operations": {
+                    "store.delete": [{"result":{"deleted":"yes"}}]
+                }}),
+                0
+            )
+            .is_err()
+        );
+        let mut host = OfflineHost::from_scenario(
+            &json!({"host_operations": {
+                "store.put": [{"result":{"revision":1}}],
+                "store.get": [{"arguments":{"key":"expected"},"result":null}]
+            }}),
+            0,
+        )
+        .unwrap();
+        assert!(
+            host.call(
+                "test",
+                call(
+                    "store.put",
+                    json!({"key":"k","value":null,"expected_revision":null})
+                )
+            )
+            .is_err()
+        );
+        assert!(
+            host.call("test", call("store.get", json!({"key":"other"})))
+                .is_err()
+        );
+        assert!(
+            host.finish()
+                .unwrap_err()
+                .to_string()
+                .contains("offline_mock_violation")
+        );
+    }
+
+    #[test]
+    fn diagnostic_redaction_matches_the_shared_secret_rules() {
+        let mut bundle = json!({
+            "telemetry": {"last_error": "failed with gho_abc123\nkey AKIAABCDEFGHIJKLMNOP\n-----BEGIN RSA PRIVATE KEY-----\nMIIEsecretbody\n-----END RSA PRIVATE KEY-----\nat /store/x"},
+            "settings": {"apiKey": "k1", "privateKey": "k2", "authorization": "k3", "enabled": true},
+            "settings_keys": ["theme"],
+        });
+        redact_value(&mut bundle, None, &[("/store".into(), "$STORE".into())]);
+        let encoded = bundle.to_string();
+        for secret in [
+            "gho_abc123",
+            "AKIAABCDEFGHIJKLMNOP",
+            "MIIEsecretbody",
+            "k1",
+            "k2",
+            "k3",
+        ] {
+            assert!(!encoded.contains(secret), "{encoded}");
+        }
+        assert!(encoded.contains("at $STORE/x"), "{encoded}");
+        assert_eq!(bundle["settings"]["enabled"], true);
+        assert_eq!(bundle["settings_keys"], json!(["theme"]));
+    }
+}
