+        let make = |thread: &'static str| {
+            let seen = seen.clone();
+            bind(
+                Some(thread),
+                "same-owner",
+                vec![
+                    ("same-frame".into(), Role::Raster),
+                    ("same-keys".into(), Role::Keys),
+                ],
+                Arc::new(move |value| {
+                    seen.lock().unwrap().push((thread, value));
+                    true
