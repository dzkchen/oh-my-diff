+    } = mods
+        .intercept_tool(start("call-answered", &ANSWERED))
+        .await
+        .unwrap()
+    else {
+        panic!("the answered call must respond");
+    };
+    assert!(
+        answered.starts_with("tool_original_unavailable"),
+        "{answered}"
+    );
+}
