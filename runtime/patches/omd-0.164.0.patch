+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn pty_output_renders_and_sessions_stay_owner_scoped() {
+        let _restore = test_scope();
+        let owners = BTreeMap::from([
+            ("m".to_owned(), "source".to_owned()),
+            ("other".to_owned(), "other-source".to_owned()),
+        ]);
+        context(1, Some("a".into()));
+        retain(1, "admitted", &owners, &Default::default());
+        let authority = codex_omd::client_surface::Authority {
+            epoch: 1,
+            admission: codex_omd::client_surface::admission(),
+            configuration: "admitted".into(),
+            source: "source".into(),
+        };
+        let a = binding("m", Some("a"), &authority).unwrap();
+        let other = binding(
+            "other",
+            Some("a"),
+            &codex_omd::client_surface::Authority {
+                source: "other-source".into(),
+                ..authority.clone()
+            },
+        )
+        .unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let mut command = std::process::Command::new("/bin/sh");
+        command
+            .args(["-c", "printf 'hello pane'; sleep 5"])
+            .current_dir(dir.path());
+        let arguments = json!({"session": "t1"});
+        start(
+            &a,
+            &arguments,
+            command,
+            dir.path(),
+            crate::tui::FrameRequester::test_dummy(),
+        )
+        .await
+        .unwrap();
+        let mut text = String::new();
+        for _ in 0..100 {
+            text = rows(Some(&a), "t1", 40, 4, "")
+                .iter()
+                .map(ToString::to_string)
+                .collect();
+            if text.contains("hello pane") {
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        }
+        assert!(text.contains("hello pane"));
+        assert!(call(&other, &json!({"session": "t1", "action": "read"})).is_err());
+        assert!(
+            rows(Some(&other), "t1", 40, 4, "")
+                .iter()
+                .any(|line| line.to_string().contains("not running"))
+        );
+        assert!(
+            call(&a, &json!({"session": "t1", "action": "read"})).unwrap()["text"]
+                .as_str()
+                .unwrap()
+                .contains("hello pane")
+        );
+        context(1, Some("a".into()));
+        retain(1, "admitted", &owners, &Default::default());
+        assert!(call(&a, &json!({"session": "t1", "action": "read"})).is_ok());
+        context(2, Some("b".into()));
+        assert!(binding("m", Some("b"), &authority).is_err());
+        assert!(!current(&a));
+        assert!(call(&a, &json!({"session": "t1", "action": "read"})).is_err());
+        context(3, Some("a".into()));
+        assert!(binding("m", Some("a"), &authority).is_err());
+        assert!(view_binding("m", Some("a"), 1, authority.admission, "admitted").is_err());
+        let fresh = codex_omd::client_surface::Authority {
+            epoch: 3,
+            ..authority.clone()
+        };
+        let b = binding("m", Some("a"), &fresh).unwrap();
+        let mut command = std::process::Command::new("/bin/sh");
+        command.args(["-c", "sleep 5"]).current_dir(dir.path());
+        start(
+            &b,
+            &arguments,
+            command,
+            dir.path(),
+            crate::tui::FrameRequester::test_dummy(),
+        )
+        .await
+        .unwrap();
+        for action in ["read", "write", "stop"] {
+            assert!(
+                call(
+                    &a,
+                    &json!({"session": "t1", "action": action, "text": "unsafe"})
+                )
+                .is_err()
+            );
+        }
+        assert!(!key(
+            Some(&a),
+            "t1",
+            KeyEvent::new(KeyCode::Char('x'), KeyModifiers::NONE)
+        ));
+        paste(Some(&a), "t1", "unsafe");
+        assert!(
+            rows(Some(&a), "t1", 40, 4, "")[0]
+                .to_string()
+                .contains("not running")
+        );
+        assert!(call(&b, &json!({"session": "t1", "action": "read"})).is_ok());
+        retain(2, "readmitted", &owners, &Default::default());
+        assert!(!current(&b));
+        assert!(binding("m", Some("a"), &fresh).is_err());
+        assert!(view_binding("m", Some("a"), 3, fresh.admission, "admitted").is_err());
+        retain(3, "admitted", &owners, &Default::default());
+        assert!(binding("m", Some("a"), &fresh).is_err());
+        assert!(view_binding("m", Some("a"), 3, fresh.admission, "admitted").is_err());
+        assert!(sessions().panes.is_empty());
+    }
+}
