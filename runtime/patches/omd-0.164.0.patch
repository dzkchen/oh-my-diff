+    pub fn retryable(message: impl Into<String>) -> Self {
+        Self::new(BlitErrorKind::Retryable, message)
+    }
+    pub fn fatal(message: impl Into<String>) -> Self {
+        Self::new(BlitErrorKind::Fatal, message)
