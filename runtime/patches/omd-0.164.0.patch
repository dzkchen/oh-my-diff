+        .unwrap_err()
+        .contains("user_or_event_only")
+    );
+    for origin in [Origin::UserCommand, Origin::Event] {
+        for arguments in [
+            json!({}),
+            json!({"turn_id": ""}),
+            json!({"turn_id": "x".repeat(129)}),
+            json!({"turn_id": "stale", "thread_id": ThreadId::new().to_string()}),
