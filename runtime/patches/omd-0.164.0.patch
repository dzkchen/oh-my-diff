+
+fn runtime_provider(id: &str, slug: &str, server: &MockServer) {
+    codex_model_provider_info::set_runtime_provider(
+        id,
+        Some(ModelProviderInfo {
+            name: id.to_string(),
+            base_url: Some(format!("{}/v1", server.uri())),
+            request_max_retries: Some(0),
+            stream_max_retries: Some(0),
+            ..Default::default()
+        }),
+    );
+    let mut model = codex_models_manager::model_info::model_info_from_slug(slug);
+    model.used_fallback_model_metadata = false;
+    codex_models_manager::runtime_models::set(id, vec![model]);
+}
+
+fn reply(id: &str, text: &str) -> String {
+    sse(vec![
+        ev_reasoning_item(&format!("{id}-reasoning"), &[text], &[]),
+        ev_assistant_message(&format!("{id}-message"), text),
+        ev_completed(id),
+    ])
+}
+
+async fn turn(test: &TestCodex, text: &str) -> Result<()> {
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    Ok(())
+}
+
+async fn switch(test: &TestCodex, provider: &str, model: &str) -> Result<()> {
+    core_test_support::submit_thread_settings(
+        &test.codex,
+        ThreadSettingsOverrides {
+            model: Some(model.to_string()),
+            model_provider: Some(provider.to_string()),
+            ..Default::default()
+        },
+    )
+    .await
+}
+
+fn reasoning_summaries(input: &[Value]) -> Vec<String> {
+    input
+        .iter()
+        .filter(|item| item["type"] == "reasoning")
+        .filter_map(|item| item["summary"][0]["text"].as_str().map(str::to_string))
+        .collect()
+}
+
+fn mentions(input: &[Value], text: &str) -> bool {
+    input.iter().any(|item| item.to_string().contains(text))
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn provider_switch_carries_history_and_keeps_reasoning_with_its_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let startup = start_mock_server().await;
+    let other = start_mock_server().await;
+    let startup_log =
+        mount_sse_sequence(&startup, vec![reply("a1", "FIRST"), reply("a3", "THIRD")]).await;
+    let other_log = mount_sse_sequence(&other, vec![reply("b2", "SECOND")]).await;
+    runtime_provider("switch_carry", "switch-carry-model", &other);
+    let test = test_codex().build(&startup).await?;
+    let startup_provider = test.config.model_provider_id.clone();
+    let startup_model = test.session_configured.model.clone();
+
+    turn(&test, "turn one").await?;
+    switch(&test, "switch_carry", "switch-carry-model").await?;
+    turn(&test, "turn two").await?;
+    switch(&test, &startup_provider, &startup_model).await?;
+    turn(&test, "turn three").await?;
+
+    let other_requests = other_log.requests();
+    assert_eq!(other_requests.len(), 1);
+    assert_eq!(other_requests[0].body_json()["model"], "switch-carry-model");
+    let switched = other_requests[0].input();
+    assert!(mentions(&switched, "turn one") && mentions(&switched, "FIRST"));
+    assert_eq!(reasoning_summaries(&switched), Vec::<String>::new());
+
+    let startup_requests = startup_log.requests();
+    assert_eq!(startup_requests.len(), 2);
+    assert_eq!(
+        startup_requests[1].body_json()["model"],
+        startup_model.as_str()
+    );
+    let back = startup_requests[1].input();
+    assert!(mentions(&back, "turn two") && mentions(&back, "SECOND"));
+    assert_eq!(reasoning_summaries(&back), vec!["FIRST".to_string()]);
+
+    test.codex.ensure_rollout_materialized().await;
+    test.codex.flush_rollout().await?;
+    let providers = std::fs::read_to_string(test.codex.rollout_path().expect("rollout path"))?
+        .lines()
+        .map(codex_rollout::parse_rollout_line)
+        .collect::<serde_json::Result<Vec<_>>>()?
+        .into_iter()
+        .filter_map(|line| match line.item {
+            RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(applied)) => {
+                Some(applied.thread_settings.model_provider_id)
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert!(
+        providers
+            .windows(2)
+            .any(|pair| pair == ["switch_carry".to_string(), startup_provider.clone()]),
+        "resume reads the last applied provider: {providers:?}"
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn compaction_after_provider_switch_runs_on_the_new_provider() -> Result<()> {
+    skip_if_no_network!(Ok(()));
