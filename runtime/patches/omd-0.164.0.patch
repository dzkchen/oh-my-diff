+const KEY_BUDGET: std::time::Duration = std::time::Duration::from_millis(50);
+
+/// Runs `surface` interceptors on the UI thread within the keystroke budget; `Ok(None)` when none apply or the runtime is closed.
+fn intercept_within(
+    surface: &str,
+    input: impl FnOnce() -> Value,
+    origin: Value,
+    core: &mut dyn FnMut(Value) -> std::io::Result<Value>,
+) -> Result<Option<Value>, String> {
+    let deadline = std::time::Instant::now() + KEY_BUDGET;
+    let Some(runtime) = lock_within(&HOST, std::time::Duration::ZERO).and_then(|host| host.clone())
+    else {
+        return Ok(None);
+    };
+    let mut host = match lock_within(&runtime, std::time::Duration::ZERO) {
+        Some(host) => host,
+        None if remembered_intercept(surface, None).is_none() => return Ok(None),
+        None => lock_within(&runtime, deadline.saturating_duration_since(std::time::Instant::now()))
+            .ok_or("mod_runtime_busy: another mod callback held the runtime for the whole keystroke budget")?,
+    };
+    if remembered_intercept(surface, Some(host.intercepts(surface))).is_none() {
+        return Ok(None);
+    }
+    host.intercept_held(
+        surface,
+        input(),
+        origin,
+        &|| std::time::Instant::now() < deadline,
+        core,
+    )
+    .map_err(|error| error.to_string())
+}
+
+/// Runs `composer_key` interceptors within the keystroke budget: `Ok(None)` drops the key, a busy or slow chain keeps it.
+pub(crate) fn composer_key(
+    key: &str,
+    input: impl FnOnce() -> Value,
+) -> Result<Option<String>, String> {
+    let thread = crate::mod_surface::current_thread();
+    match intercept_within(
+        "composer_key",
+        input,
+        serde_json::json!({"caller": "user", "thread_id": thread}),
+        &mut |effective| Ok(serde_json::json!({"key": effective["key"]})),
+    )? {
+        None => Ok(Some(key.to_owned())),
+        Some(result) if result["deny"].is_string() => Ok(None),
+        Some(result) => Ok(result["key"].as_str().map(str::to_owned)),
+    }
+}
+
+/// Asks the owner's `component_change` interceptors about a focus or scroll change; only a denial is an error.
+pub(crate) fn component_change(owner: &str, change: Value) -> Result<Value, String> {
+    let key = if change["kind"] == "focus" {
+        "focus"
+    } else {
+        "scroll"
+    };
+    let unchanged = serde_json::json!({ key: change["to"] });
+    let thread = crate::mod_surface::current_thread();
+    match intercept_within(
+        "component_change",
+        || change,
+        serde_json::json!({"owner": owner, "thread_id": thread}),
+        &mut |effective| Ok(serde_json::json!({ key: effective["to"] })),
+    ) {
+        Ok(Some(result)) => match result["deny"].as_str() {
+            Some(reason) => Err(format!("component_change_denied: {reason}")),
+            None => Ok(result),
+        },
+        Ok(None) | Err(_) => Ok(unchanged),
+    }
+}
+
+/// Runs `config_set` interceptors for one row, writes the effective value and announces `config_change` to other mods.
+pub(crate) fn set_config(
+    row: &Value,
+    value: Value,
+    expected: Option<&Value>,
+    caller: &str,
+    mut write: impl FnMut(&Value) -> Result<Value, String>,
+) -> Result<Value, String> {
+    let key = row["key"].as_str().unwrap_or_default();
+    if row["editable"] != true {
+        return Err(format!("config_not_editable: {key}"));
+    }
+    if expected.is_some_and(|expected| *expected != row["value"]) {
+        return Err(format!("config_stale: {key} changed since it was read"));
+    }
+    // A masked read never overwrites a Codex value; mod settings may hold the literal text.
+    let masked =
+        |value: &Value| !key.starts_with("mods.") && codex_omd::app_routes::redacted(value);
+    if masked(&value) {
+        return Err(format!("app_config_value_redacted: {key}"));
+    }
+    let paths = crate::omd::mod_paths().ok_or("mods are not configured for this session")?;
+    let runtime = shared_host()?;
+    let grants = {
+        let mut runtime = runtime.locked();
+        reload(&mut runtime);
+        owner_grants(&runtime)
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let thread = crate::mod_surface::current_thread();
+    let (epoch, active) = context_unchanged();
+    let scope = CallScope {
+        epoch,
+        context: codex_omd::app_routes::InvocationContext::Event,
+        thread: thread.as_deref(),
+        active: Arc::new(active),
+    };
+    let input = serde_json::json!({"key": key, "value": value, "original": row["value"],
+        "source": row["source"], "scope": row["scope"]});
+    let result = codex_omd::continue_operation(
+        &runtime,
+        "config_set",
+        input,
+        serde_json::json!({"caller": caller, "thread_id": thread}),
+        || true,
+        |caller, call| {
+            crate::mod_surface::host_call(
+                &paths,
+                &policy,
+                grants.get(caller).cloned(),
+                caller,
+                call,
+                &scope,
+            )
+        },
+        |effective| {
+            if masked(&effective["value"]) {
+                return Err(std::io::Error::other(format!(
+                    "app_config_value_redacted: {key}"
+                )));
+            }
+            write(&effective["value"]).map_err(std::io::Error::other)?;
+            Ok(serde_json::json!({"value": effective["value"]}))
+        },
+    )
+    .map_err(|error| error.to_string())?;
+    broadcast_event_except(
+        "config_change",
+        serde_json::json!({"key": key, "original": row["value"], "effective": result["value"],
+            "source": row["source"], "scope": row["scope"], "caller": caller}),
+        caller,
+    );
+    Ok(result["value"].clone())
+}
+
+pub(crate) fn write_settings(
+    store: &codex_omd::ModStore,
+    id: &str,
+    values: &Value,
+    caller: &str,
+) -> std::io::Result<Value> {
+    let values = values
+        .as_object()
+        .ok_or_else(|| std::io::Error::other("settings_values_must_be_object"))?;
+    for (name, value) in values {
+        let key = format!("mods.{id}.{name}");
+        let single = |value: &Value| {
+            codex_omd::write_settings(store, id, &serde_json::json!({name: value}))
+                .map_err(|error| error.to_string())
+        };
+        match config_row(&Value::Null, &key) {
+            Ok(row) => set_config(&row, value.clone(), None, caller, single),
+            Err(_) => single(value),
+        }
+        .map_err(std::io::Error::other)?;
+    }
+    codex_omd::write_settings(store, id, &serde_json::json!({}))
+}
