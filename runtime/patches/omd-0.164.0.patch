+                    .iter()
+                    .map(|&capability| capability.into())
+                    .collect(),
+                "user",
+            )
+            .unwrap();
+        let environment = crate::omd::tests::omd_environment(&store_path);
+        store.enable(&package, true).unwrap();
+        let runtime = shared_host().unwrap();
+        runtime.lock().unwrap().reload().unwrap();
+        Self {
+            runtime,
+            _environment: environment,
+            _temp: temp,
+            _host: host,
+        }
+    }
+
+    fn hold(&self, held: std::time::Duration) -> std::thread::JoinHandle<()> {
+        let runtime = self.runtime.clone();
+        let (locked, wait) = std::sync::mpsc::channel();
+        let holder = std::thread::spawn(move || {
+            let _held = runtime.lock().unwrap();
+            locked.send(()).unwrap();
+            std::thread::sleep(held);
+        });
+        wait.recv().unwrap();
+        holder
+    }
+}
