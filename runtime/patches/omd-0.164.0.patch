+            active,
+            &mut |effective| Ok(json!({"key": effective["key"]})),
+        )
+    };
+    assert_eq!(run("a", &|| true).unwrap().unwrap()["key"], "Left");
+    assert_eq!(run("w", &|| true).unwrap().unwrap()["key"], "Ctrl+w");
+    assert_eq!(run("b", &|| true).unwrap().unwrap()["key"], "b");
