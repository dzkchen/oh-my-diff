+        assert!(restored.restore_value(weakened).is_err());
+        for scoped in [
+            json!([{"operation":"unknown","when":{"/write":true}}]),
+            json!([{"operation":"exec.run","when":{}}]),
+            json!([{"operation":"exec.run","when":{"/argv":[]}}]),
+        ] {
