+/// Runs before the provisional composer has a live thread; the observer path rejects native-task operations at the host boundary.
+pub(crate) fn prepare_startup(repository: &Path, phase: &str) {
+    prepare_startup_active(repository, phase, &|| true);
+}
+
+pub(crate) fn prepare_startup_active(repository: &Path, phase: &str, active: &dyn Fn() -> bool) {
+    if !crate::omd::is_active() || !active() {
+        return;
+    }
+    if crate::mod_ui::startup_context_matches(repository, phase) {
+        return;
+    }
+    let snapshot = (|| {
+        crate::omd::mod_paths_for(repository)?;
+        let runtime = shared_host_active(active).ok()?;
+        let mut runtime = try_lock_until(&runtime, active)?;
+        if !active() {
+            return None;
+        }
+        reload_active(&mut runtime, active);
+        let mut input = serde_json::json!({
+            "event": "startup", "ledger": null,
+            "identity": runtime.identity(crate::version::CODEX_CLI_VERSION,
+                std::env::var(crate::omd::INSTALL_PROFILE_ENV).ok().as_deref(), "omd"),
+            "presentation": codex_omd::client_surface::presented(
+                serde_json::json!({"thread_id": null, "phase": phase})),
+            "client": crate::mod_client::value(),
+        });
+        let pty_scope = serde_json::json!({"epoch": codex_omd::client_surface::epoch(), "admission": codex_omd::client_surface::admission(), "configuration": runtime.configuration_sha256()});
+        let terminal = runtime.terminal_view(input.clone(), active);
+        input["pty_scope"] = pty_scope;
+        Some(ModViewSnapshot {
+            view: terminal.view,
+            contributors: terminal.contributors,
+            conflicts: terminal.conflicts,
+            component_owners: terminal.component_owners,
+            layout_owner: terminal.layout_owner,
+            diagnostics: terminal.diagnostics,
+            input,
+            ..ModViewSnapshot::default()
+        })
+    })();
+    if active() {
+        let prepared = snapshot.is_some();
+        crate::mod_ui::startup_preview(snapshot, repository);
+        if prepared
+            && let Some(store) = crate::omd::mod_paths_for(repository).and_then(|paths| paths.store)
+        {
+            warm_listing(store);
+        }
+    }
+}
+
+pub(crate) fn warm_listing(store: PathBuf) {
+    static WARM: Mutex<(bool, Option<PathBuf>)> = Mutex::new((false, None));
+    let mut warm = WARM.locked();
+    warm.1 = Some(store);
+    if std::mem::replace(&mut warm.0, true) {
+        return;
+    }
+    drop(warm);
+    std::thread::spawn(|| {
+        loop {
+            let next = {
+                let mut warm = WARM.locked();
+                let next = warm.1.take();
+                warm.0 = next.is_some();
+                next
+            };
+            let Some(store) = next else {
+                break;
+            };
+            let _ = codex_omd::ModStore::open(store).and_then(|store| {
+                store.verify_selections()?;
+                codex_omd::package_controls::list(&store, crate::omd::mod_status().as_deref())
+            });
+        }
+    });
+}
