+        assert!(readable.identity(&approved, 1024).unwrap().is_some());
+        assert_eq!(readable.identity(&approved, 4), Ok(None));
+        assert_eq!(
+            authority(root.clone(), FileSystemAccessMode::Deny).identity(&approved, 1024),
