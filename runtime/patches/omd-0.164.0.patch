+#[test]
+#[serial_test::serial]
+fn pty_requests_keep_their_original_authority_while_queued() {
+    let _scope = crate::mod_pty::test_scope();
+    let previous_thread = with(|state| state.thread.replace("a".into()));
+    let (sender, mut events) = tokio::sync::mpsc::unbounded_channel();
+    let _registration =
+        codex_omd::client_surface::register(Arc::new(TuiSurface(AppEventSender::new(sender))));
+    let owners = BTreeMap::from([("m".to_owned(), "source".to_owned())]);
+    crate::mod_pty::context(1, Some("a".into()));
+    crate::mod_pty::retain(1, "admitted", &owners, &Default::default());
+    let authority = codex_omd::client_surface::Authority {
+        epoch: 1,
+        admission: codex_omd::client_surface::admission(),
+        configuration: "admitted".into(),
+        source: "source".into(),
+    };
+    for context in [InvocationContext::User, InvocationContext::Event] {
+        let _guard = authority.clone().enter();
+        let _reply = codex_omd::client_surface::submit(
+            "m",
+            "terminal.pty",
+            json!({"action": "read", "session": "p1"}),
+            context,
+            false,
+            Some("a"),
+            None,
+        )
+        .unwrap();
+        let AppEvent::ModSurfaceCall(call, Some(binding)) = events.try_recv().unwrap() else {
+            panic!("PTY binding missing")
+        };
+        assert!((call.validity.0)());
+        assert!(crate::mod_pty::current(&binding));
+        crate::mod_pty::context(2, Some("b".into()));
+        with(|state| state.thread = Some("b".into()));
+        assert!(!(call.validity.0)());
+        crate::mod_pty::context(3, Some("a".into()));
+        with(|state| state.thread = Some("a".into()));
+        assert!(!crate::mod_pty::current(&binding));
+        assert!(
+            codex_omd::client_surface::submit(
+                "m",
+                "terminal.pty",
+                json!({"action": "read", "session": "p1"}),
+                context,
+                false,
+                Some("a"),
+                None
+            )
+            .is_err()
+        );
+        crate::mod_pty::context(1, Some("a".into()));
+    }
+    crate::mod_pty::retain(2, "changed", &owners, &Default::default());
+    crate::mod_pty::retain(3, "admitted", &owners, &Default::default());
+    let _guard = authority.enter();
+    assert!(
+        codex_omd::client_surface::submit(
+            "m",
+            "terminal.pty",
+            json!({"action": "read", "session": "p1"}),
+            InvocationContext::Event,
+            false,
+            Some("a"),
+            None
+        )
+        .is_err()
+    );
+    with(|state| state.thread = previous_thread);
+}
