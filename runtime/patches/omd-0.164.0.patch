+}
+
+const DIALOG_LAYER: u16 = u16::MAX;
+
+#[derive(Default)]
+struct Interaction {
+    thread: Option<String>,
+    focused: Option<String>,
+    ids: BTreeSet<String>,
+    targets: BTreeMap<String, ComponentTarget>,
