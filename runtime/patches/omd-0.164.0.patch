+        let mut buffer = Buffer::empty(area);
+        let composer = Rect::new(chat.x, chat.bottom() - 3, chat.width, 3);
+        buffer[(composer.x + 1, composer.y + 1)].set_char('I');
+        paint_named("composer", composer, &mut buffer, None);
+        render(area, chat, &mut buffer, &current);
+        assert_eq!(buffer[(composer.x + 1, composer.y + 1)].symbol(), "I");
+        assert_eq!(buffer[(composer.x, composer.y)].symbol(), "-");
+        assert_eq!(
+            buffer[(composer.x + composer.width - 1, composer.y)].symbol(),
+            "-"
+        );
+        assert_ne!(buffer[(composer.x + 1, composer.y + 1)].bg, Color::Reset);
+        assert!(rows(&buffer, area).contains("status retained"));
+
+        let mut dialog = current;
+        dialog.component_owners.extend(
+            [("theme_apply", "theme"), ("theme_close", "theme")]
+                .map(|(id, owner)| (id.to_owned(), owner.to_owned())),
+        );
+        dialog.view.sites.insert("dialog".into(), serde_json::from_value(serde_json::json!({
+            "components":[{"type":"dialog","id":"theme","label":"Theme","title":"Theme","children":[
+                {"type":"button","id":"theme_apply","label":"Apply","text":"Apply","action":{"command":"theme:apply"}},
+                {"type":"button","id":"theme_close","label":"Close","text":"Close","action":{"command":"theme:close"}}
+            ]}]
+        })).unwrap());
+        preview(dialog);
+        let current = super::snapshot();
+        assert!(dialog_visible(&current));
+        render(area, chat, &mut buffer, &current);
+        assert!(focus("theme_close"));
+        assert!(
+            matches!(input(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE), true),
+            Some(ModInput::Interaction(_, ModKeyAction::Command { command, .. })) if command == "theme:close")
+        );
+        INTERACTION.lock().unwrap().dismissed = None;
+        assert!(focus("theme_close"));
+        reopen_dialogs();
+        render(area, chat, &mut buffer, &current);
+        assert_eq!(
+            INTERACTION.lock().unwrap().focused.as_deref(),
+            Some("theme_close"),
+            "a command run from an open dialog keeps the dialog's focus"
+        );
+        assert!(matches!(
+            input(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE), true),
+            Some(ModInput::Consumed)
+        ));
+        assert!(
+            !dialog_visible(&current),
+            "a dismissed dialog no longer holds the inline viewport"
+        );
+        reopen_dialogs();
+        assert!(
+            dialog_visible(&current),
+            "a mod command reopens a dismissed dialog"
+        );
+        render(area, chat, &mut buffer, &current);
+        assert!(focus("theme_close"));
+        let mut closed = current.clone();
+        closed.view.sites.remove("dialog");
+        render(area, chat, &mut buffer, &closed);
+        reopen_dialogs();
+        render(area, chat, &mut buffer, &current);
+        assert_eq!(
+            INTERACTION.lock().unwrap().focused.as_deref(),
+            Some("theme_apply"),
+            "a dialog the mod closed and shows again starts at its first control"
+        );
+
+        preview(ModViewSnapshot::default());
+        let mut native = Buffer::empty(area);
+        paint_named("composer", composer, &mut native, None);
+        render(area, area, &mut native, &super::snapshot());
+        assert_eq!(rows(&native, area).trim(), "");
+        assert_eq!(native[(1, 1)].bg, Color::Reset);
+    });
+}
