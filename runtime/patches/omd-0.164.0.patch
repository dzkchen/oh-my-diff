+#[expect(clippy::too_many_arguments)]
+async fn serve_bridge(
+    listener: Arc<TcpListener>,
+    token: String,
+    cell_id: CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: Vec<ToolDefinition>,
+    cancellation: CancellationToken,
+) {
+    let tools = Arc::new(enabled_tools);
+    let count = Arc::new(AtomicUsize::new(0));
+    loop {
+        let socket = tokio::select! {
+            _ = cancellation.cancelled() => break,
+            accepted = listener.accept() => match accepted {
+                Ok((socket, _)) => socket,
+                Err(_) => break,
+            },
+        };
+        let task_token = token.clone();
+        let task_cell = cell_id.clone();
+        let task_session = Arc::clone(&session);
+        let task_step = Arc::clone(&step_context);
+        let task_runtime = runtime.clone();
+        let task_tools = Arc::clone(&tools);
+        let task_count = Arc::clone(&count);
+        let task_cancel = cancellation.clone();
+        tokio::spawn(async move {
+            handle_connection(
+                socket,
+                task_token,
+                task_cell,
+                task_session,
+                task_step,
+                task_runtime,
+                task_tools,
+                task_count,
+                task_cancel,
+            )
+            .await;
+        });
+    }
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn handle_connection(
+    socket: TcpStream,
+    token: String,
+    cell_id: CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: Arc<Vec<ToolDefinition>>,
+    count: Arc<AtomicUsize>,
+    cancellation: CancellationToken,
+) {
+    let mut socket = socket;
+    let mut bytes = Vec::new();
+    let result = tokio::time::timeout(Duration::from_secs(5), async {
+        let mut chunk = [0_u8; 4096];
+        loop {
+            let size = socket.read(&mut chunk).await?;
+            if size == 0 {
+                break;
+            }
+            bytes.extend_from_slice(&chunk[..size]);
+            if bytes.ends_with(b"\n") || bytes.len() as u64 > MAX_BRIDGE_REQUEST_BYTES {
+                break;
+            }
+        }
+        Ok::<(), std::io::Error>(())
+    })
+    .await;
+    let response = match result {
+        Ok(Ok(_)) if bytes.ends_with(b"\n") && bytes.len() as u64 <= MAX_BRIDGE_REQUEST_BYTES => {
+            dispatch_bridge(
+                &bytes,
+                &token,
+                &cell_id,
+                session,
+                step_context,
+                runtime,
+                &enabled_tools,
+                &count,
+                cancellation,
+            )
+            .await
+        }
+        _ => Err("invalid or oversized bridge request".into()),
+    };
+    let message = match response {
+        Ok(value) => json!({"ok": true, "result": value}),
+        Err(error) => json!({"ok": false, "error": error}),
+    };
+    let mut payload = serde_json::to_vec(&message)
+        .ok()
+        .filter(|payload| payload.len() < MAX_BRIDGE_RESPONSE_BYTES)
+        .unwrap_or_else(|| br#"{"ok":false,"error":"tool response limit exceeded"}"#.to_vec());
+    payload.push(b'\n');
+    let _ = socket.write_all(&payload).await;
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn dispatch_bridge(
+    bytes: &[u8],
+    token: &str,
+    cell_id: &CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: &[ToolDefinition],
+    count: &AtomicUsize,
+    cancellation: CancellationToken,
+) -> Result<Value, String> {
+    let (definition, arguments) = authorize_bridge_request(bytes, token, enabled_tools, count)?;
+    let call = CodeModeNestedToolCall {
+        cell_id: cell_id.clone(),
+        runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+        tool_name: definition.tool_name.clone(),
+        tool_kind: definition.kind,
+        input: Some(arguments),
+    };
+    let future = submit_nested_tool(
+        session,
+        step_context,
+        runtime,
+        call,
+        uuid::Uuid::new_v4().to_string(),
+        cancellation,
+        None,
+    )
+    .map_err(|error| error.to_string())?;
+    future.await.map_err(|error| error.to_string())
+}
+
+fn authorize_bridge_request(
+    bytes: &[u8],
+    token: &str,
+    enabled_tools: &[ToolDefinition],
+    count: &AtomicUsize,
+) -> Result<(ToolDefinition, Value), String> {
+    let request: BridgeRequest =
+        serde_json::from_slice(bytes).map_err(|_| "invalid bridge request".to_string())?;
+    if request.token != token {
+        return Err("bridge authentication failed".into());
+    }
+    let definition = enabled_tools
+        .iter()
+        .find(|tool| tool.name == request.name)
+        .ok_or("tool was not enabled for this cell")?;
+    if matches!(definition.name.as_str(), TOOL_NAME | "exec" | "wait") {
+        return Err("recursive kernel and code-mode calls are forbidden".into());
+    }
+    if count.fetch_add(1, Ordering::AcqRel) >= MAX_BRIDGE_CALLS {
+        return Err("kernel nested tool call limit exceeded".into());
+    }
+    Ok((definition.clone(), request.arguments))
+}
