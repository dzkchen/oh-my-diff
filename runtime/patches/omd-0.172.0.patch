+    chat.handle_user_turn_submission_result(&failed(new));
+    assert!(chat.input_queue.user_turn_pending_start);
+    let follow_up = next_submit_op(&mut ops);
+    let AppCommand::UserTurn {
+        client_user_message_id,
+        ..
