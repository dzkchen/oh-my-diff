+}
+
+pub fn apply_removed_features() {
+    codex_features::set_removed("tui", builtins().removed_features());
+}
+
+pub(crate) fn removed_features_changed() -> Vec<codex_features::Feature> {
+    static LAST: std::sync::Mutex<std::collections::BTreeSet<codex_features::Feature>> =
+        std::sync::Mutex::new(std::collections::BTreeSet::new());
+    let current = builtins().removed_features();
+    let mut last = LAST.locked();
+    let changed: Vec<_> = last.symmetric_difference(&current).copied().collect();
+    if !changed.is_empty() {
+        codex_features::set_removed("tui", current.clone());
+    }
+    *last = current;
+    changed
+}
+
+static CONTEXT_INDICATOR_DISABLED: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn context_indicator_disabled() -> bool {
+    CONTEXT_INDICATOR_DISABLED.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn disabled_surfaces_changed() -> bool {
+    static STATUS_LINE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    let status_line = status_line_disabled();
+    let context = builtins().surface_disabled("context_indicator");
+    let status_line_changed =
+        STATUS_LINE.swap(status_line, std::sync::atomic::Ordering::Relaxed) != status_line;
+    let context_changed =
+        CONTEXT_INDICATOR_DISABLED.swap(context, std::sync::atomic::Ordering::Relaxed) != context;
+    status_line_changed || context_changed
+}
