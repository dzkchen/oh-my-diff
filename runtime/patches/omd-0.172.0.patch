+        reject(command, "denied while detached");
+        let completion = fixture.completion().await;
+        let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+        fixture
+            .app
+            .handle_event(
+                &mut tui,
+                &mut fixture.server,
+                AppEvent::UserTurnSubmissionFinished {
+                    backend_id: crate::backend_id::BackendId::new(),
+                    thread_id: fixture.thread_id,
+                    completion: completion.clone(),
+                    receipt: unhandled(),
+                },
+            )
+            .await
+            .unwrap();
+        assert!(
+            fixture.app.thread_event_channels[&fixture.thread_id]
+                .store
+                .lock()
+                .await
+                .buffer
+                .is_empty()
+        );
+        let backend_id = fixture.server.backend_id();
+        fixture
+            .app
+            .handle_event(
+                &mut tui,
+                &mut fixture.server,
+                AppEvent::UserTurnSubmissionFinished {
+                    backend_id,
+                    thread_id: fixture.thread_id,
+                    completion,
+                    receipt: unhandled(),
+                },
