+pub(crate) fn configuration_listing(listed: Value) -> std::io::Result<Value> {
+    if let Some(result) = remote_configuration(serde_json::json!({"action":"read"})) {
+        return result;
+    }
+    try_with_host(|host, _| Some(host.configuration_listing(listed)))
+        .unwrap_or_else(|| Err(std::io::Error::other("terminal_configuration_unavailable")))
+}
+
+pub(crate) fn selection_status(mut status: Value) -> std::io::Result<Value> {
+    let listed = serde_json::json!({"packages":status["selections"]});
+    let projected = configuration_listing(listed)?;
+    status["selections"] = projected["packages"].clone();
+    for row in status["selections"].as_array_mut().into_iter().flatten() {
+        if let Some(enabled) = row.get("enabled").cloned() {
+            row["selected"] = enabled;
+        }
+    }
+    Ok(status)
+}
+
+pub(crate) fn protective(id: &str) -> bool {
+    try_with_host(|host, _| Some(host.protective(id))).unwrap_or(true)
+}
+
+pub(crate) fn os_access(owner: &str) -> Option<codex_omd::ModOsAccess> {
+    try_with_host(|runtime, _| runtime.grants(owner).and_then(|grants| grants.os_access))
+}
