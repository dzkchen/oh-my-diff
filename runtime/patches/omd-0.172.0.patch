+struct BusyFixture {
+    runtime: Arc<Mutex<ModHost>>,
+    _environment: (crate::omd::tests::EnvGuard, crate::omd::tests::EnvGuard),
+    _temp: tempfile::TempDir,
+    _host: Box<dyn std::any::Any>,
+}
+
+impl BusyFixture {
+    fn new(source: &str, capabilities: &[&str]) -> Self {
+        let host = Box::new(test_fresh_host());
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let store_path = root.join("store");
+        let store = codex_omd::ModStore::create(store_path.clone()).unwrap();
+        let package = root.join("guard");
+        std::fs::create_dir(&package).unwrap();
+        std::fs::write(
+            package.join("mod.json"),
+            serde_json::json!({"schema": 1, "id": "guard", "version": "1.0.0",
+                "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": capabilities})
+            .to_string(),
+        )
+        .unwrap();
+        std::fs::write(package.join("index.ts"), source).unwrap();
+        let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+        store
+            .trust(
+                package.clone(),
+                inspected["sha256"].as_str().unwrap(),
+                capabilities
+                    .iter()
+                    .map(|&capability| capability.into())
+                    .collect(),
+                "user",
+            )
+            .unwrap();
+        store.enable(&package, true).unwrap();
+        let environment = crate::omd::tests::omd_environment(&store_path);
+        let runtime = shared_host().unwrap();
+        runtime.lock().unwrap().reload().unwrap();
+        Self {
+            runtime,
+            _environment: environment,
+            _temp: temp,
+            _host: host,
+        }
+    }
+
+    fn hold(&self, held: std::time::Duration) -> Holder {
+        let runtime = self.runtime.clone();
+        let (locked, wait) = std::sync::mpsc::channel();
+        let (release, released) = std::sync::mpsc::channel::<()>();
+        let thread = std::thread::spawn(move || {
+            let _held = runtime.lock().unwrap();
+            locked.send(()).unwrap();
+            let _ = released.recv_timeout(held);
+        });
+        wait.recv().unwrap();
+        Holder { release, thread }
+    }
+}
+
+struct Holder {
+    release: std::sync::mpsc::Sender<()>,
+    thread: std::thread::JoinHandle<()>,
+}
+
+impl Holder {
+    fn join(self) -> std::thread::Result<()> {
+        drop(self.release);
+        self.thread.join()
+    }
+}
