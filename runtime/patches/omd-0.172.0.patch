+pub(crate) fn set_surface(fullscreen: bool, columns: u16, rows: u16) {
+    ROWS.with(|rows_state| {
+        COLUMNS.with(|columns_state| {
+            FULLSCREEN.with(|fullscreen_state| {
+                fullscreen_state.store(fullscreen, Ordering::Relaxed);
+                columns_state.store(columns, Ordering::Relaxed);
+                rows_state.store(rows, Ordering::Relaxed);
+            })
+        })
+    });
+    frame_started();
+}
+
+fn frame_started() {
+    engine(|engine| {
+        engine.drawn_from = engine.frame_from;
+        engine.frame_from = engine.asks;
+        let drawn_from = engine.drawn_from;
+        engine.asked.retain(|_, (_, _, ask)| *ask > drawn_from);
+    });
+}
