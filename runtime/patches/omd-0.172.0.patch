+pub(crate) use codex_omd::client_surface::NoticePlacement;
+
+#[derive(Clone)]
+pub(crate) struct Notice {
+    owner: String,
+    id: Option<String>,
+    kind: &'static str,
+    placement: NoticePlacement,
+    text: String,
+    expires: std::time::Instant,
+}
+
+crate::omd::isolated_static! { NOTICES: Mutex<(Vec<Notice>, u64)> = Mutex::new((Vec::new(), 0)) }
+crate::omd::isolated_static! { SEEN_NOTICES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0) }
+
+/// Shows a toast or status notice until its lifetime ends; the same owner and id replace it.
+pub(crate) fn notice(
+    owner: &str,
+    id: Option<&str>,
+    kind: &str,
+    placement: NoticePlacement,
+    text: &str,
+    ttl: std::time::Duration,
+) {
+    NOTICES.with(|notices_state| {
+        let mut notices = notices_state.locked();
+        notices
+            .0
+            .retain(|notice| id.is_none() || notice.owner != owner || notice.id.as_deref() != id);
+        if notices
+            .0
+            .iter()
+            .filter(|notice| notice.owner == owner)
+            .count()
+            >= 4
+        {
+            let oldest = notices.0.iter().position(|notice| notice.owner == owner);
+            if let Some(oldest) = oldest {
+                notices.0.remove(oldest);
+            }
+        }
+        notices.0.push(Notice {
+            owner: owner.to_owned(),
+            id: id.map(str::to_owned),
+            kind: crate::history_cell::notice_kind(kind),
+            placement,
+            text: text.to_owned(),
+            expires: std::time::Instant::now() + ttl,
+        });
+        notices.1 += 1;
+    })
+}
+
+pub(crate) fn clear_notice(owner: &str, id: &str) -> bool {
+    NOTICES.with(|notices_state| {
+        let mut notices = notices_state.locked();
+        let count = notices.0.len();
+        notices
+            .0
+            .retain(|notice| notice.owner != owner || notice.id.as_deref() != Some(id));
+        let cleared = notices.0.len() != count;
+        if cleared {
+            notices.1 += 1;
+        }
+        cleared
+    })
+}
+
+fn live_notices(placement: NoticePlacement) -> Vec<Notice> {
+    NOTICES.with(|notices_state| {
+        let mut notices = notices_state.locked();
+        let now = std::time::Instant::now();
+        let count = notices.0.len();
+        notices.0.retain(|notice| notice.expires > now);
+        if notices.0.len() != count {
+            notices.1 += 1;
+        }
+        let ui_mods = (placement == NoticePlacement::Status)
+            .then(codex_omd::mod_ui_allowlist)
+            .flatten();
+        notices
+            .0
+            .iter()
+            .filter(|notice| notice.placement == placement)
+            .filter(|notice| {
+                ui_mods
+                    .as_ref()
+                    .is_none_or(|ids| ids.contains(&notice.owner))
+            })
+            .rev()
+            .take(3)
+            .cloned()
+            .collect()
+    })
+}
+
+/// True once after notices were added, cleared or expired.
+pub(crate) fn notices_changed() -> bool {
+    NOTICES.with(|notices_state| {
+        SEEN_NOTICES.with(|seen_notices_state| {
+            live_notices(NoticePlacement::Status);
+            let revision = notices_state.locked().1;
+            seen_notices_state.swap(revision, std::sync::atomic::Ordering::Relaxed) != revision
+        })
+    })
+}
+
+pub(crate) fn key_name(key: KeyEvent) -> Option<String> {
+    if key.kind != KeyEventKind::Press {
+        return None;
+    }
+    let mut modifiers = key.modifiers;
+    let base = match key.code {
+        KeyCode::F(number) => format!("F{number}"),
+        KeyCode::Char(' ') => "Space".to_owned(),
+        KeyCode::Char(character) if character.is_ascii_alphanumeric() => {
+            character.to_ascii_lowercase().to_string()
+        }
+        KeyCode::BackTab => {
+            modifiers |= KeyModifiers::SHIFT;
+            "Tab".to_owned()
+        }
+        KeyCode::Up => "Up".to_owned(),
+        KeyCode::Down => "Down".to_owned(),
+        KeyCode::Left => "Left".to_owned(),
+        KeyCode::Right => "Right".to_owned(),
+        KeyCode::Home => "Home".to_owned(),
+        KeyCode::End => "End".to_owned(),
+        KeyCode::PageUp => "PageUp".to_owned(),
+        KeyCode::PageDown => "PageDown".to_owned(),
+        KeyCode::Delete => "Delete".to_owned(),
+        KeyCode::Insert => "Insert".to_owned(),
+        KeyCode::Tab => "Tab".to_owned(),
+        KeyCode::Enter => "Enter".to_owned(),
+        KeyCode::Esc => "Esc".to_owned(),
+        KeyCode::Backspace => "Backspace".to_owned(),
+        _ => return None,
+    };
+    let mut name = String::new();
+    for (modifier, label) in [
+        (KeyModifiers::CONTROL, "Ctrl+"),
+        (KeyModifiers::ALT, "Alt+"),
+        (KeyModifiers::SHIFT, "Shift+"),
+    ] {
+        if modifiers.contains(modifier) {
+            name.push_str(label);
+        }
+    }
+    name.push_str(&base);
+    Some(name)
+}
+
+/// Names a key for `composer_key`: a printable character as typed (also its text), any other key by its mod key name.
+pub(crate) fn composer_key_name(key: KeyEvent) -> Option<(String, Option<String>)> {
+    match key.code {
+        KeyCode::Char(character)
+            if !key
+                .modifiers
+                .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT) =>
+        {
+            Some((character.to_string(), Some(character.to_string())))
+        }
+        _ => key_name(KeyEvent {
+            kind: KeyEventKind::Press,
+            ..key
+        })
+        .map(|name| (name, None)),
+    }
+}
+
+pub(crate) fn composer_key_event(name: &str) -> Option<KeyEvent> {
+    let mut characters = name.chars();
+    if let (Some(character), None) = (characters.next(), characters.next()) {
+        return Some(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+    let mut parts = name.split('+').collect::<Vec<_>>();
+    let base = parts.pop()?;
+    let mut modifiers = KeyModifiers::NONE;
+    for part in parts {
+        modifiers |= match part {
+            "Ctrl" => KeyModifiers::CONTROL,
+            "Alt" => KeyModifiers::ALT,
+            "Shift" => KeyModifiers::SHIFT,
+            _ => return None,
+        };
+    }
+    let code = match base {
+        "Space" => KeyCode::Char(' '),
+        "Up" => KeyCode::Up,
+        "Down" => KeyCode::Down,
+        "Left" => KeyCode::Left,
+        "Right" => KeyCode::Right,
+        "Home" => KeyCode::Home,
+        "End" => KeyCode::End,
+        "PageUp" => KeyCode::PageUp,
+        "PageDown" => KeyCode::PageDown,
+        "Delete" => KeyCode::Delete,
+        "Insert" => KeyCode::Insert,
+        "Tab" if modifiers.contains(KeyModifiers::SHIFT) => KeyCode::BackTab,
+        "Tab" => KeyCode::Tab,
+        "Enter" => KeyCode::Enter,
+        "Esc" => KeyCode::Esc,
+        "Backspace" => KeyCode::Backspace,
+        function if function.starts_with('F') => KeyCode::F(function[1..].parse().ok()?),
+        character => {
+            let mut characters = character.chars();
+            match (characters.next(), characters.next()) {
+                (Some(character), None) => KeyCode::Char(character),
+                _ => return None,
+            }
+        }
+    };
+    Some(KeyEvent::new(code, modifiers))
+}
+
+pub(crate) fn action_for(view: &ModView, key: KeyEvent) -> Option<(String, ModKeyAction)> {
+    let name = key_name(key)?;
+    if !codex_omd::mod_key_name(&name) {
+        return None;
+    }
+    let action = view.keybindings.get(&name).cloned()?;
+    Some((name, action))
+}
