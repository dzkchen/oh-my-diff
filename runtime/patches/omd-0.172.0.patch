+        tokio::task::yield_now().await;
+        frames.schedule_frame();
+        tokio::time::timeout(Duration::from_millis(5), draws.recv())
+            .await
+            .expect("first hidden draw")
+            .expect("draw channel remains open");
+        frames.schedule_frame();
+        frames.schedule_frame_in(Duration::from_millis(16));
+        assert!(
+            tokio::time::timeout(Duration::from_millis(500), draws.recv())
+                .await
+                .is_err(),
+            "hidden draws wait for the throttle interval"
+        );
+        assert!(!frames.is_awake());
+        tokio::time::timeout(Duration::from_millis(600), draws.recv())
+            .await
+            .expect("throttled hidden draw")
+            .expect("draw channel remains open");
+        assert!(draws.try_recv().is_err());
+        frames.note_activity(true);
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_millis(20)).await;
+        assert!(frames.is_awake());
+        assert!(draws.try_recv().is_ok());
