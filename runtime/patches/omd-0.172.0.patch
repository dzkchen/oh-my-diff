+impl Agent {
+    fn finished(&self) -> bool {
+        self.job
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    fn completed(&self) -> Result<bool, String> {
+        Ok(self.finished()
+            && self
+                .result
+                .lock()
+                .map_err(|_| "agent_result_poisoned")?
+                .as_ref()
+                .is_some_and(Result::is_ok))
+    }
+
+    async fn shutdown(&mut self) -> Option<Workspace> {
+        let job = self.job.take();
+        if let Some(job) = &job {
+            job.abort();
+        }
+        let cleanup = execution::stop_dropped(
+            &self.runtime,
+            self.thread.clone(),
+            self.task.clone(),
+            self.worker.clone(),
+            !self.consumed,
+            job,
+            self.workspace.take(),
+        );
+        cleanup.await.ok().flatten()
+    }
+}
+
+impl Drop for Agent {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            execution::stop_dropped(
+                &self.runtime,
+                self.thread.clone(),
+                self.task.clone(),
+                self.worker.clone(),
+                !self.consumed,
+                Some(job),
+                self.workspace.take(),
+            );
+        } else if !self.consumed {
+            let _ = self.task.discard_worker_result(&self.worker);
+        }
+    }
+}
