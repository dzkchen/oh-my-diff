+            "guard",
+            "export default api => { api.intercept('input', (e, next) => e.text.includes('secret') ? {deny: 'contains secret'} : next({...e, text: e.text.toUpperCase()})); api.intercept('model_request', (e, next) => next({...e, route: 'cheap'})); }",
