+#[cfg(target_os = "macos")]
+fn sandboxed_seatbelt(
+    executable: &Path,
+    mut args: Vec<String>,
+    protected: &[std::path::PathBuf],
+    cwd: &Path,
+) -> Result<std::process::Command, String> {
+    if args.first().map(String::as_str) != Some("-p") || args.len() < 2 {
+        return Err("exec_sandbox_unavailable".to_owned());
+    }
+    codex_omd::host::deny_protected(&mut args[1], protected)?;
+    let mut command = std::process::Command::new(executable);
+    command.args(args).current_dir(cwd);
+    Ok(command)
+}
+
+fn entries(status: Option<Arc<Value>>) -> Vec<Entry> {
+    let mut entries = Vec::new();
+    if let Some(status) = status {
+        for item in status["mods"].as_array().into_iter().flatten() {
+            let Some(id) = item["id"].as_str() else {
+                continue;
+            };
+            if !item["error"].is_null()
+                || !item["capabilities"]
+                    .as_array()
+                    .is_some_and(|c| c.iter().any(|c| c == "commands"))
+            {
+                continue;
+            }
+            for command in item["registrations"]["commands"]
+                .as_array()
+                .into_iter()
+                .flatten()
+            {
+                let Some(name) = command["name"].as_str() else {
+                    continue;
+                };
+                let description = command["description"]
+                    .as_str()
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| format!("{id} mod command"));
+                entries.push(Entry {
+                    namespaced: format!("{id}:{name}"),
+                    bare: name.to_owned(),
+                    description,
+                    args_hint: command["args_hint"].as_str().map(str::to_owned),
+                    immediate: command["immediate"] != false,
+                    target: ModSlashTarget {
+                        id: id.to_owned(),
+                        command: name.to_owned(),
+                    },
+                });
+            }
+        }
+    }
+    entries
+}
+
+pub(crate) fn build(entries: Vec<Entry>) -> Vec<ModSlashCommand> {
+    let mut counts: BTreeMap<&str, usize> = BTreeMap::new();
+    for entry in &entries {
+        *counts.entry(entry.bare.as_str()).or_default() += 1;
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut commands = Vec::new();
+    for entry in &entries {
+        if !seen.insert(entry.namespaced.clone()) {
+            continue;
+        }
+        let conflict = if builtin(&entry.bare) {
+            Some(format!("conflicts with built-in /{}", entry.bare))
+        } else if counts[entry.bare.as_str()] > 1 {
+            Some("defined by more than one mod".to_owned())
+        } else {
+            None
+        };
+        let description = match &conflict {
+            Some(reason) => format!(
+                "{} · bare /{} unavailable: {reason}",
+                entry.description, entry.bare
+            ),
+            None => entry.description.clone(),
+        };
+        commands.push(ModSlashCommand {
+            invocation: entry.namespaced.clone(),
+            description: description.clone(),
+            args_hint: entry.args_hint.clone(),
+            immediate: entry.immediate,
+            target: entry.target.clone(),
+            namespaced: true,
+        });
+        if conflict.is_none() && seen.insert(entry.bare.clone()) {
+            commands.push(ModSlashCommand {
+                invocation: entry.bare.clone(),
+                description: entry.description.clone(),
+                args_hint: entry.args_hint.clone(),
+                immediate: entry.immediate,
+                target: entry.target.clone(),
+                namespaced: false,
+            });
+        }
+    }
+    commands
+}
+
+pub(crate) fn slash_commands() -> Vec<ModSlashCommand> {
+    #[cfg(test)]
+    if let Some(commands) = TEST_CATALOG.with_borrow(Clone::clone) {
+        return commands;
+    }
+    if !remote_frontend_active() && crate::omd::mod_paths().is_none() {
+        return Vec::new();
+    }
+    let cached = CATALOG.locked().clone();
+    match cached {
+        Some((loaded, commands)) => {
+            if loaded.elapsed() >= CATALOG_TTL {
+                refresh_catalog();
+            }
+            commands
+        }
+        None => {
+            refresh_catalog();
+            if remote_frontend_active() {
+                Vec::new()
+            } else {
+                build(entries(crate::omd::mod_status()))
+            }
+        }
+    }
+}
+
+/// The terminal host reloads a changed mods.json at once, so enabled mods' commands appear before the next turn.
+fn refresh_catalog() {
+    static PENDING: Mutex<(bool, Option<()>)> = Mutex::new((false, None));
+    in_background(&PENDING, (), |()| {
+        let binding = FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire);
+        let status = if remote_frontend_active() {
+            remote_configuration_at(serde_json::json!({"action":"catalog"}), binding)
+                .and_then(Result::ok)
+                .and_then(|value| {
+                    let _binding = FRONTEND_APPLY.locked();
+                    if binding != FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire) {
+                        return None;
+                    }
+                    Some(cache_remote_catalog(&value))
+                })
+        } else {
+            shared_host()
+                .ok()
+                .map(|runtime| {
+                    let mut runtime = runtime.locked();
+                    reload(&mut runtime);
+                    Arc::new(runtime.status())
+                })
+                .or_else(crate::omd::mod_status)
+        };
+        let _binding = FRONTEND_APPLY.locked();
+        if binding != FRONTEND_GENERATION.load(std::sync::atomic::Ordering::Acquire) {
+            return;
+        }
+        let commands = build(entries(status));
+        let previous = CATALOG.locked().replace((Instant::now(), commands.clone()));
+        if previous.is_none_or(|(_, previous)| previous != commands) {
+            codex_omd::client_surface::redraw();
+        }
+    });
+}
+
+/// Runs `work` on one background thread at a time; requests made meanwhile collapse into the latest one.
+fn in_background<T: Send + 'static>(
+    pending: &'static Mutex<(bool, Option<T>)>,
+    request: T,
+    work: fn(T),
+) {
+    let mut slot = pending.locked();
+    slot.1 = Some(request);
+    if std::mem::replace(&mut slot.0, true) {
+        return;
+    }
+    drop(slot);
+    std::thread::spawn(move || {
+        loop {
+            let next = {
+                let mut slot = pending.locked();
+                let next = slot.1.take();
+                slot.0 = next.is_some();
+                next
+            };
+            let Some(request) = next else {
+                break;
+            };
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| work(request)));
+        }
+    });
+}
+
+pub(crate) fn find(invocation: &str) -> Option<ModSlashCommand> {
+    slash_commands()
+        .into_iter()
+        .find(|command| command.invocation == invocation)
+}
+
+struct CommandAuthority<'a> {
+    repository: &'a Path,
+    protected: &'a [std::path::PathBuf],
+    policy: &'a codex_protocol::permissions::FileSystemSandboxPolicy,
+}
+
+impl codex_omd::host::Authority for CommandAuthority<'_> {
+    fn repository(&self) -> &Path {
+        self.repository
+    }
+
+    fn readable(&self, path: &Path) -> bool {
+        !protected(path, self.protected)
+            && self
+                .policy
+                .can_read_local_path_with_cwd(path, self.repository)
+    }
+
+    fn writable(&self, path: &Path) -> bool {
+        self.readable(path)
+            && self
+                .policy
+                .can_write_local_path_with_cwd(path, self.repository)
+    }
+
+    fn command(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        if access.loopback {
+            return Err("exec_network_unavailable_in_commands".to_owned());
+        }
+        self.seatbelt(argv, access)
+    }
+
+    fn protected(&self) -> &[std::path::PathBuf] {
+        self.protected
+    }
+}
+
+impl CommandAuthority<'_> {
+    fn seatbelt(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        #[cfg(target_os = "macos")]
+        {
+            use codex_protocol::config_types::WindowsSandboxLevel;
+            use codex_protocol::permissions::FileSystemAccessMode;
+            use codex_protocol::permissions::FileSystemPath;
+            use codex_protocol::permissions::FileSystemSandboxEntry;
+            use codex_protocol::permissions::FileSystemSandboxKind;
+            use codex_protocol::permissions::FileSystemSandboxPolicy;
+            use codex_sandboxing::SandboxCommand;
+            use codex_sandboxing::SandboxManager;
+            use codex_sandboxing::SandboxNetwork;
+            use codex_sandboxing::SandboxSelection;
+            use codex_sandboxing::SandboxTransformRequest;
+            use codex_sandboxing::SandboxType;
+            use codex_sandboxing::seatbelt::MACOS_PATH_TO_SEATBELT_EXECUTABLE;
+            if self.policy.kind == FileSystemSandboxKind::ExternalSandbox {
+                return Err("exec_requires_native_sandbox".to_owned());
+            }
+            let mut scope = if access.write {
+                self.policy.clone()
+            } else if self.policy.kind == FileSystemSandboxKind::Unrestricted {
+                FileSystemSandboxPolicy::read_only()
+            } else {
+                FileSystemSandboxPolicy::restricted(
+                    self.policy
+                        .entries
+                        .iter()
+                        .cloned()
+                        .map(|mut entry| {
+                            if entry.access == FileSystemAccessMode::Write {
+                                entry.access = FileSystemAccessMode::Read;
+                            }
+                            entry
+                        })
+                        .collect(),
+                )
+            };
+            let scratch = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(
+                access.scratch,
+            )
+            .map_err(|error| error.to_string())?;
+            scope.entries.push(FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: scratch.into(),
+                },
+                FileSystemAccessMode::Write,
+            ));
+            let managed = access.loopback || !access.unix_sockets.is_empty();
+            let managed_network =
+                managed.then(|| codex_network_proxy::ManagedNetworkSandboxContext {
+                    allow_local_binding: access.loopback,
+                    allow_unix_sockets: access
+                        .unix_sockets
+                        .iter()
+                        .map(|path| path.display().to_string())
+                        .collect(),
+                    ..Default::default()
+                });
+            let (program, arguments) = argv.split_first().ok_or("exec_command_empty")?;
+            let cwd = codex_utils_path_uri::PathUri::from_host_native_path(self.repository)
+                .map_err(|error| error.to_string())?;
+            let permissions = codex_protocol::models::PermissionProfile::from_runtime_permissions(
+                &scope,
+                codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+            );
+            let mut args = SandboxManager::new()
+                .transform(SandboxTransformRequest {
+                    command: SandboxCommand {
+                        program: program.into(),
+                        args: arguments.to_vec(),
+                        cwd: cwd.clone(),
+                        env: Default::default(),
+                        managed_network,
+                        additional_permissions: None,
+                    },
+                    permissions: &permissions,
+                    workspace_roots: Some(&[]),
+                    selection: SandboxSelection::Explicit(SandboxType::MacosSeatbelt),
+                    network: SandboxNetwork::new(access.loopback, None, None),
+                    sandbox_policy_cwd: &cwd,
+                    executables: codex_sandboxing::SandboxExecutables::Launcher(None),
+                    use_legacy_landlock: false,
+                    windows_sandbox_level: WindowsSandboxLevel::Disabled,
+                })
+                .map_err(|error| error.to_string())?
+                .into_command_request()
+                .map_err(|error| error.to_string())?
+                .command;
+            if args.first().map(String::as_str) != Some(MACOS_PATH_TO_SEATBELT_EXECUTABLE) {
+                return Err("exec_sandbox_unavailable".to_owned());
+            }
+            args.remove(0);
+            sandboxed_seatbelt(
+                Path::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE),
+                args,
+                self.protected,
+                self.repository,
+            )
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (argv, access);
+            Err("exec_sandbox_unavailable".to_owned())
+        }
+    }
+}
