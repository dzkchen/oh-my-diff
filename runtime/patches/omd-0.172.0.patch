+static FRONTEND_APPLY: Mutex<()> = Mutex::new(());
+static FRONTEND_GENERATION: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static REMOTE_FRONTEND: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
