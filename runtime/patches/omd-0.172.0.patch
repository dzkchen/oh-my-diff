+use super::*;
+use crate::session::tests::make_session_and_context_with_rx;
+use anyhow::Context;
+
+struct Gate(ApprovalGate);
+
+impl codex_extension_api::ApprovalGateContributor for Gate {
+    fn gate_approval<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalGateInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ApprovalGate> {
+        assert!(input.assessment);
+        Box::pin(std::future::ready(self.0.clone()))
+    }
+}
+
+#[tokio::test]
+async fn mod_gate_denial_is_a_review_denial() -> anyhow::Result<()> {
+    for (gate, expected) in [
+        (ApprovalGate::Deny("blocked".into()), "blocked"),
+        (
+            ApprovalGate::Ask("confirm".into()),
+            "A mod requires human approval for this call: confirm",
+        ),
+    ] {
+        let error = review_with_gate(gate).await?;
+        assert!(matches!(
+            error.details(),
+            codex_protocol::error::CodexErrorDetails::InvalidRequest(reason) if reason == expected
+        ));
+    }
+    Ok(())
+}
+
+async fn review_with_gate(gate: ApprovalGate) -> anyhow::Result<CodexErr> {
+    let (mut session, _turn, _events) = make_session_and_context_with_rx().await;
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_gate_contributor(Arc::new(Gate(gate)));
+    Arc::get_mut(&mut session)
+        .context("session is uniquely owned")?
+        .services
+        .extensions = Arc::new(extensions.build());
+    let call: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "function_call",
+        "name": "exec_command",
+        "call_id": "exec-review",
+        "arguments": r#"{"cmd":"echo reviewed"}"#,
+    }))?;
+    let result = review_tool_call(
+        &session,
+        ContextManager::new(Session::new_item_id_generator()),
+        &call,
+        &CancellationToken::new(),
+    )
+    .await;
+    let Err(error) = result else {
+        panic!("a mod gate verdict must stop the review");
+    };
+    Ok(error)
+}
+
+struct DenyingGate(std::sync::Mutex<Vec<String>>);
+
+impl codex_extension_api::ApprovalGateContributor for DenyingGate {
+    fn gate_approval<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalGateInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ApprovalGate> {
+        self.0
+            .lock()
+            .expect("gate log")
+            .push(input.host_decision.to_owned());
+        Box::pin(std::future::ready(ApprovalGate::Deny("blocked".into())))
+    }
+}
+
+#[tokio::test]
+async fn unprompted_review_still_runs_the_mod_gate() -> anyhow::Result<()> {
+    let (mut session, _turn, _events) = make_session_and_context_with_rx().await;
+    let gate = Arc::new(DenyingGate(Default::default()));
+    let owned = Arc::get_mut(&mut session).context("session is uniquely owned")?;
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_gate_contributor(gate.clone());
+    owned.services.extensions = Arc::new(extensions.build());
+    session
+        .enable_feature_for_test(Feature::RequestPermissionsTool)
+        .await;
+    session
+        .update_settings(crate::session::session::SessionSettingsUpdate {
+            step_settings: crate::session::step_settings::StepSettingsUpdate {
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await?;
+    let call: ResponseItem = serde_json::from_value(serde_json::json!({
+        "type": "function_call",
+        "name": "request_permissions",
+        "call_id": "permissions-review",
+        "arguments": r#"{"permissions":{"network":{"enabled":true}}}"#,
+    }))?;
+    let result = review_tool_call(
+        &session,
+        ContextManager::new(Session::new_item_id_generator()),
+        &call,
+        &CancellationToken::new(),
+    )
+    .await;
+    let Err(error) = result else {
+        panic!("a mod gate denial must stop a review that needs no prompt");
+    };
+    assert!(
+        matches!(
+            error.details(),
+            codex_protocol::error::CodexErrorDetails::InvalidRequest(reason) if reason == "blocked"
+        ),
+        "{error:?}"
+    );
+    assert_eq!(*gate.0.lock().expect("gate log"), ["skip"]);
+    Ok(())
+}
diff --git a/codex-rs/core/src/session/persisted_text.rs b/codex-rs/core/src/session/persisted_text.rs
