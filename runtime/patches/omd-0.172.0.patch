+        .packages
+        .get_mut("dependency")
+        .unwrap()
+        .dependencies = true;
+    assert!(
+        store
+            .package_plan(install)
+            .unwrap_err()
+            .to_string()
+            .contains("dependency_cycle")
+    );
+}
