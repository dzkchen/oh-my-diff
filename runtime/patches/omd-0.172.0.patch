+        ),
+    ];
+    for (method, result) in allowed {
+        assert_eq!(response_allowed(method, &result), Ok(()), "{method}");
+    }
+    let refused = [
+        (
+            "item/commandExecution/requestApproval",
+            json!({"decision": "accept"}),
