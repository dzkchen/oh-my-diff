+use super::*;
+use crate::credentials::CredentialProfiles;
+
+fn check(_: &Path, host: &Value) -> Result<(), String> {
+    match host["routes"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .any(|route| route["name"] == "invalid")
+    {
+        true => Err("route invalid is invalid".into()),
+        false => Ok(()),
+    }
+}
+
+fn route(name: &str, provider: &str, subscription: bool) -> Value {
+    json!({"name": name, "roles": ["lead"], "provider": provider, "model": name, "reasoning_effort": "medium",
+        "responses_url": "http://127.0.0.1:9/v1/responses", "data": {"upstream": "gpt-6.1"},
+        "rates": {"input_microusd_per_million": 1, "cached_microusd_per_million": 1, "output_microusd_per_million": 1,
+            "reservation_microusd": if subscription { 0 } else { 5 }, "max_output_tokens": 10, "input_token_ceiling": 100,
+            "included_subscription": subscription}})
+}
+
+fn store() -> (tempfile::TempDir, std::path::PathBuf, String, String) {
+    set_host_check(check);
+    let temp = tempfile::tempdir().unwrap();
+    let store = temp.path().canonicalize().unwrap();
+    let profiles = CredentialProfiles::local(&store).unwrap();
+    let work = profiles.create("work", "chatgpt", None, None).unwrap().id;
+    let home = profiles.create("home", "chatgpt", None, None).unwrap().id;
+    std::fs::write(
+        store.join("host.json"),
+        json!({"schema": 1, "secret_refs": {"token": "/private/tmp/token"},
+            "routes": [route("old", "fixture_router", true), route("theirs", "other", true)],
+            "services": [
+                {"id": "router", "mod_id": "fixture_router", "program": "/bin/node", "program_sha256": "a",
+                    "secrets": {"TOKEN": "token"}, "network": true, "credentials": [work]},
+                {"id": "spare", "mod_id": "fixture_router", "program": "/bin/node", "program_sha256": "a"},
+                {"id": "foreign", "mod_id": "other", "program": "/bin/node", "program_sha256": "a"}]})
+        .to_string(),
+    )
+    .unwrap();
+    (temp, store, work, home)
+}
+
+#[test]
+fn a_write_replaces_only_the_callers_routes_and_merges_its_services() {
+    let (_temp, store, work, home) = store();
+    let arguments = json!({"routes": [route("work", "fixture_router", true), route("home", "fixture_router", true)],
+        "services": [{"id": "router", "credentials": [work, home]}]});
+    let (write, changes) = plan(&store, Path::new("/repo"), "fixture_router", &arguments).unwrap();
+    assert!(
+        changes.contains(&"Route home responses_url: http://127.0.0.1:9/v1/responses".to_owned())
+    );
+    assert_eq!(
+        changes
+            .iter()
+            .filter(|line| !line.starts_with("Route "))
+            .collect::<Vec<_>>(),
+        [
+            "Add model route home: home, subscription",
+            "Add model route work: work, subscription",
+            "Remove model route old",
+            "Let service router use home (chatgpt)",
+        ]
+    );
+    assert_eq!(
+        apply(&store, Path::new("/repo"), &write).unwrap(),
+        json!({"routes": ["work", "home"], "services": ["router", "spare"]})
+    );
+    let host: Value =
+        serde_json::from_slice(&std::fs::read(store.join("host.json")).unwrap()).unwrap();
+    let names = host["routes"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| r["name"].clone())
+        .collect::<Vec<_>>();
+    assert_eq!(names, [json!("theirs"), json!("work"), json!("home")]);
+    assert_eq!(host["routes"][1]["data"], json!({"upstream": "gpt-6.1"}));
+    let services = host["services"].as_array().unwrap();
+    assert_eq!(services.len(), 3);
+    assert_eq!(services[0]["program"], "/bin/node");
+    assert_eq!(services[0]["secrets"], json!({"TOKEN": "token"}));
+    assert_eq!(services[0]["credentials"], json!([work, home]));
+}
+
+#[test]
+fn a_write_refuses_what_the_caller_does_not_own_or_cannot_pay_for() {
+    let (_temp, store, work, _) = store();
+    let refused = |arguments: Value| {
+        plan(&store, Path::new("/repo"), "fixture_router", &arguments)
+            .err()
+            .unwrap()
+    };
+    let mut worker = route("w", "fixture_router", true);
+    worker["roles"] = json!(["worker"]);
+    for (arguments, code) in [
+        (
+            json!({"routes": [route("x", "other", true)]}),
+            "routes_write_provider_mismatch: x",
+        ),
+        (json!({"routes": [worker]}), "routes_write_lead_only: w"),
+        (
+            json!({"routes": [route("paid", "fixture_router", false)]}),
+            "routes_write_allowance_required: paid",
+        ),
+        (
+            json!({"routes": [route("invalid", "fixture_router", true)]}),
+            "routes_write_invalid: route invalid is invalid",
+        ),
+        (
+            json!({"routes": [], "services": [{"id": "foreign", "credentials": []}]}),
+            "routes_write_service_unknown: foreign",
+        ),
+        (
+            json!({"routes": [], "services": [{"id": "new", "credentials": [work]}]}),
+            "routes_write_service_unknown: new",
+        ),
+        (
+            json!({"routes": [], "services": [{"id": "router", "secrets": {"TOKEN": "token"}}]}),
+            "routes_write_service_field: router",
+        ),
+        (
+            json!({"routes": [], "services": [{"id": "router", "program": "/bin/sh"}]}),
+            "routes_write_service_field: router",
+        ),
+        (
+            json!({"routes": [], "services": [{"id": "router", "credentials": [work, "p404"]}]}),
+            "routes_write_credential_unknown: router",
+        ),
+        (
+            json!({"routes": [], "extra": true}),
+            "routes_write_arguments_invalid",
+        ),
+    ] {
+        assert_eq!(refused(arguments), code);
+    }
+}
+
+#[test]
+fn a_grant_route_change_is_shown_and_a_changed_host_refuses_the_confirmed_write() {
+    let (_temp, store, work, _) = store();
+    let arguments = json!({"routes": [route("old", "fixture_router", true)],
+        "services": [{"id": "spare", "credentials": [work], "route": route("old", "fixture_router", true)}]});
+    let (write, changes) = plan(&store, Path::new("/repo"), "fixture_router", &arguments).unwrap();
+    assert_eq!(
+        changes,
+        [
+            "Let service spare use work (chatgpt)",
+            "Service spare route: old (old)",
+        ]
+    );
+    let mut host: Value =
+        serde_json::from_slice(&std::fs::read(store.join("host.json")).unwrap()).unwrap();
+    host["routes"]
+        .as_array_mut()
+        .unwrap()
+        .push(route("late", "fixture_router", true));
+    std::fs::write(store.join("host.json"), host.to_string()).unwrap();
+    assert_eq!(
+        apply(&store, Path::new("/repo"), &write).unwrap_err(),
+        "routes_write_changed: host.json changed after the confirmation; try again"
+    );
+}
+
+#[test]
+fn a_changed_route_shows_each_field_it_changes() {
+    let (_temp, store, _, _) = store();
+    let mut moved = route("old", "fixture_router", true);
+    moved["responses_url"] = json!("https://elsewhere.example/v1/responses");
+    moved["rates"]["input_token_ceiling"] = json!(50);
+    let (_, changes) = plan(
+        &store,
+        Path::new("/repo"),
+        "fixture_router",
+        &json!({"routes": [moved]}),
+    )
+    .unwrap();
+    assert_eq!(changes.len(), 3);
+    assert_eq!(changes[0], "Change model route old: old, subscription");
+    assert_eq!(changes[1], "Route old rates: input_token_ceiling=50");
+    assert_eq!(
+        changes[2],
+        "Route old responses_url: https://elsewhere.example/v1/responses"
+    );
+}
diff --git a/codex-rs/omd/src/scoped_data.rs b/codex-rs/omd/src/scoped_data.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b459a6ad666573ee2279731b254e1e014404ab9
--- /dev/null
+++ b/codex-rs/omd/src/scoped_data.rs
@@ -0,0 +1,245 @@
+use crate::resource_data::{ResourceBinding, ResourceStore};
+use crate::sessions::SessionIndex;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::io;
+use std::path::PathBuf;
+
+#[cfg(test)]
+#[path = "scoped_data_tests.rs"]
+mod tests;
+
+pub struct ScopedDataHost {
+    store: crate::ModStore,
+    pub root: PathBuf,
+    pub repository: PathBuf,
+    pub session_root: Option<PathBuf>,
+    pub session_database: Option<PathBuf>,
+    pub binding: ResourceBinding,
+}
+
+pub fn operation(name: &str) -> bool {
+    matches!(
+        name,
+        "evidence.read" | "evidence.write" | "sessions.list" | "sessions.read"
+    )
+}
+
+impl ScopedDataHost {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        owner: String,
+        thread: String,
+        source_sha256: String,
+    ) -> io::Result<Self> {
+        Self::with_store(
+            crate::ModStore::open(root)?,
+            repository,
+            session_root,
+            session_database,
+            owner,
+            thread,
+            source_sha256,
+        )
+    }
+
+    fn with_store(
+        store: crate::ModStore,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        owner: String,
+        thread: String,
+        source_sha256: String,
+    ) -> io::Result<Self> {
+        let root = store.root().to_path_buf();
+        if repository.canonicalize()? != repository
+            || root.canonicalize()? != root
+            || crate::inside_repository(&root, &repository)
+        {
+            return Err(io::Error::other("data_scope_invalid"));
+        }
+        let (generation, _) = store.data_selection(&repository, &owner, &source_sha256)?;
+        let binding = ResourceBinding {
+            repository: crate::sha256_hex(repository.as_os_str().as_encoded_bytes()),
+            owner,
+            thread,
+            generation,
+            source_sha256,
+        };
+        binding.validate()?;
+        Ok(Self {
+            store,
+            root,
+            repository,
+            session_root,
+            session_database,
+            binding,
+        })
+    }
+
+    fn authorize(&mut self, name: &str) -> io::Result<crate::mods::ModSelection> {
+        let (generation, selection) = self.store.data_selection(
+            &self.repository,
+            &self.binding.owner,
+            &self.binding.source_sha256,
+        )?;
+        let required = crate::ModHostCall {
+            operation: name.into(),
+            arguments: Value::Null,
+        }
+        .capability()
+        .map_err(|error| io::Error::other(error.to_string()))?;
+        if !selection.capabilities.iter().any(|cap| cap == required) {
+            return Err(io::Error::other("data_selection_changed_or_revoked"));
+        }
+        self.binding.generation = generation;
+        Ok(selection)
+    }
+
+    pub fn call(
+        &mut self,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        if !active() {
+            return Err(io::Error::other("data_operation_cancelled"));
+        }
+        let selection = self.authorize(name)?;
+        if name == "evidence.read" {
+            #[derive(serde::Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Input {
+                reference: crate::resource_data::ResourceRef,
+                cursor: Option<usize>,
+                max_bytes: Option<usize>,
+            }
+            let input: Input = serde_json::from_value(arguments)?;
+            let mut last = io::Error::other("resource_unavailable");
+            for kind in ["turn", "evidence"] {
+                match self.resources().page(
+                    &input.reference,
+                    kind,
+                    input.cursor.unwrap_or(0),
+                    input.max_bytes.unwrap_or(crate::resource_data::PAGE_BYTES),
+                ) {
+                    Ok(page) => return Ok(page),
+                    Err(error) => last = error,
+                }
+            }
+            return Err(last);
+        }
+        if name == "evidence.write" {
+            let resources = self.resources();
+            let reference = resources.save("evidence", resources.evidence_record(arguments)?)?;
+            return Ok(serde_json::to_value(reference)?);
+        }
+        if name.starts_with("sessions.") {
+            let root = self
+                .session_root
+                .as_ref()
+                .ok_or_else(|| io::Error::other("session_access_unavailable"))?;
+            let result = SessionIndex {
+                root,
+                database: self.session_database.as_deref(),
+                repository: &self.repository,
+                enabled: true,
+                tools: selection
+                    .capabilities
+                    .iter()
+                    .any(|cap| cap == "sessions_tools"),
+            }
+            .call(name, arguments, active)?;
+            if serde_json::to_vec(&result)?.len() > 1_048_576 {
+                return Err(io::Error::other("session_invocation_limit"));
+            }
+            return Ok(result);
+        }
+        Err(io::Error::other("data_operation_unavailable"))
+    }
+
+    pub fn resources(&self) -> ResourceStore<'_> {
+        ResourceStore {
+            root: &self.root,
+            binding: &self.binding,
+        }
+    }
+}
+
+pub struct ScopedDataHosts {
+    root: PathBuf,
+    repository: PathBuf,
+    session_root: Option<PathBuf>,
+    session_database: Option<PathBuf>,
+    thread: String,
+    hosts: BTreeMap<String, ScopedDataHost>,
+}
+
+impl ScopedDataHosts {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        thread: String,
+    ) -> Self {
+        Self {
+            root,
+            repository,
+            session_root,
+            session_database,
+            thread,
+            hosts: BTreeMap::new(),
+        }
+    }
+
+    pub fn call(
+        &mut self,
+        owner: &str,
+        source_sha256: &str,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        self.host(owner, source_sha256)?
+            .call(name, arguments, active)
+    }
+
+    pub fn text_evidence(
+        &mut self,
+        owner: &str,
+        source_sha256: &str,
+        label: &str,
+        text: &str,
+    ) -> io::Result<crate::resource_data::ResourceRef> {
+        let host = self.host(owner, source_sha256)?;
+        host.authorize("evidence.write")?;
+        host.resources().text_evidence(label, text)
+    }
+
+    fn host(&mut self, owner: &str, source_sha256: &str) -> io::Result<&mut ScopedDataHost> {
+        if self
+            .hosts
+            .get(owner)
+            .is_some_and(|host| host.binding.source_sha256 != source_sha256)
+        {
+            self.hosts.remove(owner);
+        }
+        Ok(match self.hosts.entry(owner.to_owned()) {
+            std::collections::btree_map::Entry::Occupied(entry) => entry.into_mut(),
+            std::collections::btree_map::Entry::Vacant(entry) => entry.insert(ScopedDataHost::new(
+                self.root.clone(),
+                self.repository.clone(),
+                self.session_root.clone(),
+                self.session_database.clone(),
+                owner.to_owned(),
+                self.thread.clone(),
+                source_sha256.to_owned(),
+            )?),
+        })
+    }
+}
