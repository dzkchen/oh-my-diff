+/// Attaches a mod notice beneath the drawn transcript cell of one tool call; false, storing nothing, when no drawn cell claims the call.
+pub(crate) fn tool_notice(call_id: &str, kind: &str, text: &str, owner: &str) -> bool {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            EPOCH.with(|epoch_state| {
+                if !drawn_calls_state.locked().contains(call_id) {
+                    return false;
+                }
+                let mut notices = tool_notices_state.locked();
+                if notices.len() >= 256 {
+                    notices.pop_front();
+                }
+                notices.push_back(ToolNotice {
+                    call_id: call_id.to_owned(),
+                    kind: crate::history_cell::notice_kind(kind),
+                    text: text.to_owned(),
+                    owner: owner.to_owned(),
+                });
+                epoch_state.fetch_add(1, Ordering::Relaxed);
+                schedule_frame(Duration::ZERO);
+                true
+            })
+        })
+    })
+}
+
+pub(crate) fn tool_notice_lines(target: &RenderTarget) -> Vec<HyperlinkLine> {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            let calls = target.props["calls"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|call| call["call_id"].as_str())
+                .chain([target.id.as_str()])
+                .chain(target.props["call_id"].as_str())
+                .collect::<Vec<_>>();
+            if target.component.starts_with("tool_") {
+                let mut drawn = drawn_calls_state.locked();
+                if drawn.len() >= DONE_LIMIT {
+                    drawn.clear();
+                }
+                drawn.extend(calls.iter().map(|call| (*call).to_owned()));
+            }
+            let notices = tool_notices_state.locked();
+            if notices.is_empty() {
+                return Vec::new();
+            }
+            notices
+                .iter()
+                .filter(|notice| calls.contains(&notice.call_id.as_str()))
+                .map(|notice| {
+                    let mut spans = vec![crate::mod_ui::glyph("  ↳ ", "  -> ").dim()];
+                    spans.extend(crate::history_cell::notice_spans(notice.kind, &notice.text));
+                    spans.push(format!(" ({})", notice.owner).dark_gray());
+                    HyperlinkLine {
+                        line: Line::from(spans),
+                        ..HyperlinkLine::default()
+                    }
+                })
+                .collect()
+        })
+    })
+}
+
+type Instance = (String, String);
+type Answers = Vec<(Instance, u64)>;
+
+thread_local! {
+    static WAITING: Cell<bool> = const { Cell::new(false) };
+    static TRACKED: std::cell::RefCell<Option<Option<Answers>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// The hook answers one layout drew from, so a cache keeps it until one of them changes or a view refresh asks them again.
+#[derive(Clone, Default)]
+pub(crate) struct Stamp(Option<(u64, Answers)>);
+
+impl Stamp {
+    pub(crate) fn is_current(&self) -> bool {
+        let Some((refreshes, answers)) = &self.0 else {
+            return true;
+        };
+        *refreshes == REFRESHES.with(|state| state.load(Ordering::Relaxed))
+            && (answers.is_empty()
+                || engine(|engine| {
+                    answers.iter().all(|(instance, generation)| {
+                        engine
+                            .generations
+                            .get(instance)
+                            .copied()
+                            .unwrap_or_default()
+                            == *generation
+                    })
+                }))
+    }
+}
+
+pub(crate) fn track<T>(run: impl FnOnce() -> T) -> (T, Stamp) {
+    let refreshes = REFRESHES.with(|state| state.load(Ordering::Relaxed));
+    let outer = TRACKED.with(|tracked| tracked.replace(Some(None)));
+    let value = run();
+    let answers = TRACKED.with(|tracked| tracked.replace(outer)).flatten();
+    if let Some(answers) = &answers {
+        touch();
+        answers.iter().for_each(|(instance, _)| record(instance));
+    }
+    (value, Stamp(answers.map(|answers| (refreshes, answers))))
+}
+
+fn record(instance: &Instance) {
+    TRACKED.with(|tracked| {
+        if let Some(answers) = tracked.borrow_mut().as_mut() {
+            let generation =
+                engine(|engine| engine.generations.get(instance).copied()).unwrap_or_default();
+            answers
+                .get_or_insert_default()
+                .push((instance.clone(), generation));
+        }
+    });
+}
+
+fn touch() {
+    TRACKED.with(|tracked| {
+        if let Some(answers) = tracked.borrow_mut().as_mut() {
+            answers.get_or_insert_default();
+        }
+    });
+}
+
+fn engine<T>(run: impl FnOnce(&mut Engine) -> T) -> T {
+    ENGINE.with(|engine_state| {
+        let mut engine = engine_state.locked();
+        run(engine.get_or_insert_with(Engine::default))
+    })
+}
