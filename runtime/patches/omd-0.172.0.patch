+    assert_eq!(
+        command_host_guarded(
+            &paths,
+            &policy,
+            Some(denied),
+            "fixture",
+            request(
+                "environment.read",
+                serde_json::json!({"names": ["FIXTURE_VALUE"]})
+            ),
+            &scope
+        )
+        .unwrap_err()
+        .to_string(),
+        "capability_denied: exec"
+    );
+    let cancelled = CallScope {
+        terminal_owner: None,
+        epoch: scope.epoch,
+        context: scope.context,
+        thread: scope.thread,
+        active: Arc::new(|| false),
+    };
+    assert_eq!(
+        invoke(
+            &cancelled,
+            "environment.read",
+            serde_json::json!({"names": ["FIXTURE_VALUE"]})
+        )
+        .unwrap_err()
+        .to_string(),
+        "host_operation_cancelled"
+    );
+    let local = CallScope {
+        terminal_owner: None,
+        thread: None,
+        ..scope
+    };
+    assert!(
+        invoke(
+            &local,
