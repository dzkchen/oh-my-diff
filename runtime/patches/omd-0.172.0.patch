+#[test]
+fn a_picked_context_window_applies_up_to_the_model_maximum() {
+    let slug = "omd-picked-window";
+    let remote = ModelInfo {
+        context_window: Some(272_000),
+        max_context_window: Some(872_000),
+        ..model_info::model_info_from_slug(slug)
+    };
+    let window = |tokens: i64, remote: &ModelInfo, config: &ModelsManagerConfig| {
+        crate::runtime_models::set_context_windows(vec![(slug.to_string(), tokens)]);
+        let remote = CatalogModel {
+            model: Arc::new(remote.clone()),
+            origin: ModelOrigin::Provider,
+        };
+        construct_model_info(slug, Some(remote), config).context_window
+    };
+    let config = ModelsManagerConfig::default();
+    assert_eq!(window(400_000, &remote, &config), Some(400_000));
+    assert_eq!(window(1_000_000, &remote, &config), Some(872_000));
+    assert_eq!(window(128_000, &remote, &config), Some(128_000));
+    let fixed = ModelInfo {
+        max_context_window: None,
+        ..remote.clone()
+    };
+    assert_eq!(window(400_000, &fixed, &config), Some(272_000));
+    let explicit = ModelsManagerConfig {
+        model_context_window: Some(200_000),
+        ..config.clone()
+    };
+    assert_eq!(window(400_000, &remote, &explicit), Some(200_000));
+    let unknown = ModelInfo {
+        context_window: None,
+        max_context_window: None,
+        ..remote.clone()
+    };
+    assert_eq!(window(400_000, &unknown, &config), None);
+    crate::runtime_models::set_context_windows(Vec::new());
+}
