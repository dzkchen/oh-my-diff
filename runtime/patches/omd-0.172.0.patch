+pub(crate) use codex_omd::client_surface::BLIT_FRAME as FRAME;
+use codex_omd::client_surface::Blit as Update;
+use codex_omd::client_surface::BlitCell as Cell;
+use codex_omd::client_surface::BlitContent;
+const RASTERS_PER_MOD: usize = 16;
+const HIDDEN_RETRY: Duration = Duration::from_millis(250);
+
+type LinesKey = (u64, usize, u16, bool, Option<StdoutColorLevel>, String);
+type RasterScope = (String, Option<String>);
+
+struct Raster {
+    owner: String,
+    scope: Option<RasterScope>,
+    binding: Option<u64>,
+    width: u16,
+    height: u16,
+    cells: Vec<Cell>,
+    retained: bool,
+    frame: Option<BlitContent>,
+    drawn: bool,
+    picture: Option<BlitContent>,
+    staged: Vec<Option<Cell>>,
+    dirty: Option<Instant>,
+    applied: Option<Instant>,
+    frames: u64,
+    shown: u64,
+    placed: Option<((u32, u32), (u16, u16))>,
+    lines: Option<(LinesKey, Vec<Line<'static>>)>,
+}
+
+impl Raster {
+    fn new(owner: &str, width: u16, height: u16) -> Self {
+        Self {
+            owner: owner.to_owned(),
+            scope: None,
+            binding: None,
+            width,
+            height,
+            cells: vec![Cell::default(); usize::from(width) * usize::from(height)],
+            retained: false,
+            frame: None,
+            drawn: false,
+            picture: None,
+            staged: Vec::new(),
+            dirty: None,
+            applied: None,
+            frames: 0,
+            shown: 0,
+            placed: None,
+            lines: None,
+        }
+    }
+
+    fn pending(&self) -> usize {
+        usize::from(self.picture.is_some()) + usize::from(self.dirty.is_some())
+    }
+
+    fn resized_underlay(&self, width: u16, height: u16) -> Self {
+        let mut next = Self::new(&self.owner, width, height);
+        next.scope = self.scope.clone();
+        next.retained = self.frames > 0 || self.retained;
+        for y in 0..height {
+            for x in 0..width {
+                let source = &self.cells[usize::from(y.min(self.height - 1))
+                    * usize::from(self.width)
+                    + usize::from(x.min(self.width - 1))];
+                let cell = &mut next.cells[usize::from(y) * usize::from(width) + usize::from(x)];
+                if x < self.width && y < self.height {
+                    *cell = source.clone();
+                } else {
+                    cell.bg = source.bg;
+                }
+            }
+        }
+        next
+    }
+
+    fn stage(&mut self, update: Update, now: Instant) {
+        match update.content {
+            BlitContent::Cells { rect, cells } => {
+                if self.staged.is_empty() {
+                    self.staged = vec![None; self.cells.len()];
+                }
+                let mut cells = cells.into_iter();
+                // A pending picture clears the cells when it applies, so cells after it compare against blanks.
+                let after_picture = self.picture.is_some();
+                let mut changed = self.frame.is_some() || after_picture || self.retained;
+                let blank = Cell::default();
+                for row in rect.y..rect.y + rect.height {
+                    for column in rect.x..rect.x + rect.width {
+                        let at = usize::from(row) * usize::from(self.width) + usize::from(column);
+                        let shown = if after_picture {
+                            &blank
+                        } else {
+                            &self.cells[at]
+                        };
+                        if let Some(cell) = cells.next()
+                            && (self.staged[at].is_some() || *shown != cell)
+                        {
+                            self.staged[at] = Some(cell);
+                            changed = true;
+                        }
+                    }
+                }
+                if changed {
+                    self.dirty.get_or_insert(now);
+                }
+            }
+            picture @ (BlitContent::Image { .. } | BlitContent::Pixels(_)) => {
+                if self.dirty.take().is_some() {
+                    self.staged.fill(None);
+                }
+                self.picture = Some(picture);
+            }
+            BlitContent::Encoded { .. } | BlitContent::Source(_) => {}
+        }
+    }
+
+    fn apply(&mut self) {
+        let _stage = codex_omd::frame_metrics::stage("raster_apply");
+        self.retained = false;
+        if let Some(picture) = self.picture.take() {
+            self.cells.fill(Cell::default());
+            self.frame = Some(picture);
+        } else {
+            self.frame = None;
+            for (cell, staged) in self.cells.iter_mut().zip(&mut self.staged) {
+                if let Some(staged) = staged.take() {
+                    *cell = staged;
+                }
+            }
+            self.dirty = None;
+        }
+        self.frames += 1;
+    }
+
+    /// Applies at most one pending frame per interval, the picture before the cells merged after it; returns the wait for the next one.
+    fn advance(&mut self, now: Instant) -> Option<Duration> {
+        if self.pending() == 0 {
+            return None;
+        }
+        let due = self.applied.map_or(Duration::ZERO, |applied| {
+            FRAME.saturating_sub(now - applied)
+        });
+        if !due.is_zero() {
+            return Some(due);
+        }
+        self.apply();
+        let applied = self.next_tick(now);
+        self.applied = Some(applied);
+        (self.pending() > 0).then(|| FRAME.saturating_sub(now - applied))
+    }
+
+    fn next_tick(&self, now: Instant) -> Instant {
+        self.applied
+            .filter(|applied| now.saturating_duration_since(*applied) < FRAME * 2)
+            .map_or(now, |applied| applied + FRAME)
+    }
+
+    fn hidden(&self, now: Instant) -> bool {
+        let stale = |since: Instant| now.saturating_duration_since(since) >= FRAME * 4;
+        (self.frames != self.shown && self.applied.is_some_and(stale))
+            || self.dirty.is_some_and(stale)
+    }
+}
+
+static RASTERS: Mutex<BTreeMap<String, Raster>> = Mutex::new(BTreeMap::new());
+static SUSPENDED: Mutex<VecDeque<(String, Raster)>> = Mutex::new(VecDeque::new());
+
+pub(crate) fn suspend(id: &str) {
+    let Some(raster) = rasters().remove(id) else {
+        return;
+    };
+    if raster.scope.is_none() {
+        return;
+    }
+    let mut suspended = SUSPENDED.locked();
+    suspended.retain(|(key, cached)| {
+        key != id || cached.owner != raster.owner || cached.scope != raster.scope
+    });
+    suspended.push_back((id.to_owned(), raster));
+    while suspended.len() > 4 {
+        suspended.pop_front();
+    }
+}
+
+fn rasters() -> std::sync::MutexGuard<'static, BTreeMap<String, Raster>> {
+    RASTERS.locked()
+}
+
+type Told = (u64, (u16, u16), (u16, u16));
+
+#[derive(Default)]
+struct Layout {
+    size: (u16, u16),
+    told: Option<Told>,
+}
+
+static LAYOUTS: Mutex<BTreeMap<String, Layout>> = Mutex::new(BTreeMap::new());
+
+fn layouts() -> std::sync::MutexGuard<'static, BTreeMap<String, Layout>> {
+    LAYOUTS.locked()
+}
+
+pub(crate) fn rendered(id: &str) -> Option<(u16, u16)> {
+    layouts().get(id).map(|layout| layout.size)
+}
+
+/// Records the rendered size and, for a process-bound raster, tells the process when its drawable box or the client cell changes; the write happens off the render thread, in order.
+pub(crate) fn track(
+    id: &str,
+    thread: Option<&str>,
+    owner: Option<&str>,
+    columns: u16,
+    size: (u16, u16),
+) {
+    let mut layouts = layouts();
+    let layout = layouts.entry(id.to_owned()).or_default();
+    layout.size = size;
+    let Some((_, serial, sink)) =
+        owner.and_then(|owner| codex_omd::process_raster::target(thread, owner, id))
+    else {
+        layout.told = None;
+        return;
+    };
+    let cell = crate::mod_client::facts()
+        .cell
+        .unwrap_or(crate::mod_client::DEFAULT_CELL);
+    let told = (serial, (columns, size.1), cell);
+    if layout.told.replace(told) == Some(told) {
+        return;
+    }
+    let message = json!({"box": {"columns": columns, "rows": size.1,
+        "cell_px": {"width": cell.0, "height": cell.1}}});
+    sink(message);
+}
+
+/// `terminal.blit`: queues a partial update of the caller's own raster under the frame budget.
+pub(crate) fn blit(
+    caller: &str,
+    owner: Option<String>,
+    size: Option<(u16, u16)>,
+    arguments: &Value,
+    now: Instant,
+    snapshot: impl FnOnce(
+        &codex_omd::process_raster::PixelSource,
+        Instant,
+    ) -> Result<
+        std::sync::Arc<codex_omd::process_raster::PixelFrame>,
+        codex_omd::client_surface::BlitError,
+    >,
+) -> Result<Value, codex_omd::client_surface::BlitError> {
+    let mut update =
+        codex_omd::client_surface::blit_request(caller, owner.as_deref(), size, arguments)?;
+    if let BlitContent::Cells { cells, .. } = &update.content
+        && !cells
+            .iter()
+            .all(|cell| cell.symbol.graphemes(true).count() == 1 && cell.symbol.width() == 1)
+    {
+        return Err("terminal_blit_invalid".into());
+    }
+    let (width, height) = size
+        .filter(|(width, height)| *width > 0 && *height > 0)
+        .ok_or_else(|| codex_omd::client_surface::BlitError::retryable("terminal_blit_unknown"))?;
+    let key = std::mem::take(&mut update.key);
+    let binding = codex_omd::process_raster::serial(
+        crate::mod_surface::current_thread().as_deref(),
+        caller,
+        &key,
+    );
+    let limited = |rasters: &BTreeMap<String, Raster>| {
+        !rasters.contains_key(&key)
+            && rasters
+                .values()
+                .filter(|raster| raster.owner == caller)
+                .count()
+                >= RASTERS_PER_MOD
+    };
+    let reusable = |raster: &Raster| {
+        (raster.width, raster.height) == (width, height)
+            && raster.owner == caller
+            && raster.binding == binding
+    };
+    let mut next = now + FRAME;
+    if matches!(update.content, BlitContent::Source(_)) {
+        let mut rasters = rasters();
+        if limited(&rasters) {
+            return Err(codex_omd::client_surface::BlitError::retryable(
+                "terminal_blit_limit",
+            ));
+        }
+        if let Some(raster) = rasters.get_mut(&key).filter(|raster| reusable(raster)) {
+            if raster.hidden(now) {
+                return Ok(
+                    json!({"status": "backpressure", "retry_after_ms": HIDDEN_RETRY.as_millis() as u64}),
+                );
+            }
+            raster.advance(now);
+            if raster.pending() > 0 {
+                return Ok(backpressure(raster, now));
+            }
+            next = raster.next_tick(now) + FRAME;
+        }
+    }
+    let update = update.checked(|source| snapshot(source, next))?;
+    let mut rasters = rasters();
+    if limited(&rasters) {
+        return Err(codex_omd::client_surface::BlitError::retryable(
+            "terminal_blit_limit",
+        ));
+    }
+    let raster = rasters
+        .entry(key.clone())
+        .and_modify(|raster| {
+            if !reusable(raster) {
+                if raster.drawn {
+                    crate::mod_client::forget(&key);
+                }
+                *raster = if raster.owner == caller
+                    && raster.binding == binding
+                    && raster.scope.is_some()
+                    && raster.frame.is_none()
+                {
+                    raster.resized_underlay(width, height)
+                } else {
+                    Raster::new(caller, width, height)
+                };
+            }
+        })
+        .or_insert_with(|| Raster::new(caller, width, height));
+    raster.binding = binding;
+    if matches!(update.content, BlitContent::Cells { .. }) && raster.hidden(now) {
+        return Ok(
+            json!({"status": "backpressure", "retry_after_ms": HIDDEN_RETRY.as_millis() as u64}),
+        );
+    }
+    raster.stage(update, now);
+    Ok(json!({
+        "frame": raster.frames + raster.pending() as u64,
+        "queued": raster.pending(),
+        "frame_ms": FRAME.as_millis() as u64,
+    }))
+}
+
+fn backpressure(raster: &Raster, now: Instant) -> Value {
+    let wait = raster.applied.map_or(FRAME, |applied| {
+        FRAME
+            .saturating_sub(now - applied)
+            .max(Duration::from_millis(1))
+    });
+    json!({"status": "backpressure", "retry_after_ms": wait.as_millis() as u64})
+}
+
+pub(crate) fn span(cell: &Cell, no_color: bool, level: Option<StdoutColorLevel>) -> Span<'static> {
+    let mut style = Style::default();
+    if !no_color {
+        if let Some(fg) = cell.fg {
+            style = style.fg(crate::mod_ui::color_at(fg, level));
+        }
+        if let Some(bg) = cell.bg {
+            style = style.bg(crate::mod_ui::color_at(bg, level));
+        }
+    }
+    let symbol = if cell.symbol.is_empty() {
+        " "
+    } else {
+        &cell.symbol
+    };
+    Span::styled(interned(symbol), style)
+}
+
+const INTERNED_LIMIT: usize = 4096;
+
+static INTERNED: Mutex<BTreeSet<&'static str>> = Mutex::new(BTreeSet::new());
+
+/// Cell glyphs as shared static text, so cached raster lines clone without copying a string per cell; the table is bounded, then glyphs are owned.
+fn interned(symbol: &str) -> std::borrow::Cow<'static, str> {
+    let mut table = INTERNED.locked();
+    if let Some(found) = table.get(symbol) {
+        return std::borrow::Cow::Borrowed(found);
+    }
+    if table.len() >= INTERNED_LIMIT {
+        return std::borrow::Cow::Owned(symbol.to_owned());
+    }
+    let leaked: &'static str = Box::leak(symbol.to_owned().into_boxed_str());
+    table.insert(leaked);
+    std::borrow::Cow::Borrowed(leaked)
+}
+
+pub(crate) fn pending_delay(key: &str, now: Instant) -> Option<Duration> {
+    let rasters = rasters();
+    let raster = rasters.get(key)?;
+    if raster.frames != raster.shown {
+        return Some(Duration::ZERO);
+    }
+    (raster.pending() > 0).then(|| {
+        raster.applied.map_or(Duration::ZERO, |applied| {
+            FRAME.saturating_sub(now.saturating_duration_since(applied))
+        })
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rows(
+    id: &str,
+    owner: Option<&str>,
+    alt: &str,
+    width: u16,
+    size: (u16, u16),
+    no_color: bool,
+    prefix: &str,
+    now: Instant,
+) -> (Vec<Line<'static>>, Option<Duration>) {
+    let binding = layouts()
+        .get(id)
+        .and_then(|layout| layout.told.map(|(serial, _, _)| serial));
+    let mut rasters = rasters();
+    if rasters
+        .get(id)
+        .is_some_and(|raster| Some(raster.owner.as_str()) != owner || raster.binding != binding)
+        && rasters.remove(id).is_some_and(|raster| raster.drawn)
+    {
+        crate::mod_client::forget(id);
+    }
+    let Some(raster) = rasters.get_mut(id) else {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], None);
+    };
+    let next = raster.advance(now);
+    raster.shown = raster.frames;
+    if std::mem::replace(&mut raster.drawn, raster.frame.is_some()) && raster.frame.is_none() {
+        crate::mod_client::forget(id);
+    }
+    if raster.frames == 0 {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], next);
+    }
+    if let Some(frame) = &raster.frame {
+        let (sha256, bytes, pixels, dimensions) = match frame {
+            BlitContent::Image { sha256, bytes } => (
+                sha256.as_str(),
+                Some(bytes),
+                None,
+                crate::mod_components::dimensions(bytes),
+            ),
+            BlitContent::Pixels(frame) => (
+                frame.id.as_str(),
+                None,
+                Some(&frame.image),
+                Some((frame.image.width(), frame.image.height())),
+            ),
+            _ => unreachable!(),
+        };
+        if no_color {
+            return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], next);
+        }
+        let (columns, high) = (width.min(size.0), size.1);
+        let key = format!("{sha256}:{columns}:{high}:{prefix}");
+        let load = || bytes.map(|bytes| bytes.to_vec());
+        let rows = crate::mod_components::picture_rows(
+            id, sha256, &key, columns, high, prefix, &load, pixels,
+        );
+        raster.placed = rows.as_ref().zip(dimensions).map(|(rows, size)| {
+            let wide = rows.first().map_or(0, |row| row.width() - prefix.width());
+            (
+                size,
+                (u16::try_from(wide).unwrap_or(u16::MAX), rows.len() as u16),
+            )
+        });
+        return (
+            rows.unwrap_or_else(|| vec![Line::from(format!("{prefix}[{alt}]")).dim()]),
+            next,
+        );
+    }
+    raster.placed = None;
+    let visible = usize::from(width.min(raster.width).min(size.0));
+    let key = (
+        raster.frames,
+        visible,
+        size.1,
+        no_color,
+        crate::mod_ui::color_level(),
+        prefix.to_owned(),
+    );
+    if let Some((cached, rows)) = &raster.lines
+        && *cached == key
+    {
+        return (rows.clone(), next);
+    }
+    let rows: Vec<Line<'static>> = raster
+        .cells
+        .chunks(usize::from(raster.width))
+        .take(usize::from(size.1))
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend(
+                row.iter()
+                    .take(visible)
+                    .map(|cell| span(cell, no_color, key.4)),
+            );
+            Line::from(spans)
+        })
+        .collect();
+    raster.lines = Some((key, rows.clone()));
+    (rows, next)
+}
+
+const UNDERLAY_GUTTER: u16 = 2;
+const UNDERLAY_MIN_COLUMNS: u16 = 60;
+
+fn underlay_blank(cell: &ratatui::buffer::Cell) -> bool {
+    cell.symbol() == " " && cell.bg == Color::Reset && cell.modifier.is_empty()
+}
+
+/// The underlay raster's cells in screen order, applying its next frame once per draw; None when nothing draws.
+fn underlay_frame<T>(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    level: Option<StdoutColorLevel>,
+    advance: bool,
+    now: Instant,
+    paint: impl FnOnce(&Raster) -> T,
+) -> Option<T> {
+    let id = &snapshot.view.underlay.as_ref()?.raster;
+    let owner = snapshot.component_owners.get(id).map(String::as_str);
+    let scope = snapshot.input["ledger"]["cwd"].as_str().map(|repository| {
+        (
+            repository.to_owned(),
+            snapshot.input["ledger"]["thread_id"]
+                .as_str()
+                .map(str::to_owned),
+        )
+    });
+    if !matches!(
+        level,
+        Some(StdoutColorLevel::TrueColor | StdoutColorLevel::Ansi256)
+    ) || screen.width < UNDERLAY_MIN_COLUMNS
+        || screen.is_empty()
+    {
+        return None;
+    }
+    if advance {
+        let size = (screen.width.min(512), screen.height.min(256));
+        track(
+            id,
+            crate::mod_surface::current_thread().as_deref(),
+            owner,
+            size.0,
+            size,
+        );
+    }
+    let mut rasters = rasters();
+    if !rasters.contains_key(id) {
+        let mut suspended = SUSPENDED.locked();
+        if let Some(index) = suspended.iter().position(|(key, raster)| {
+            key == id
+                && Some(raster.owner.as_str()) == owner
+                && scope.is_some()
+                && raster.scope == scope
+        }) && let Some((key, raster)) = suspended.remove(index)
+        {
+            rasters.insert(key, raster);
+        }
+    }
+    if rasters.get(id).is_some_and(|raster| {
+        Some(raster.owner.as_str()) != owner || raster.scope.is_some() && raster.scope != scope
+    }) {
+        rasters.remove(id);
+    }
+    let raster = rasters.get_mut(id)?;
+    raster.scope = scope;
+    if advance {
+        if let Some(next) = raster.advance(now) {
+            crate::mod_render::schedule_frame(next.saturating_sub(now.elapsed()));
+        }
+        raster.shown = raster.frames;
+    }
+    ((raster.frames > 0 || raster.retained) && raster.frame.is_none()).then(|| paint(raster))
+}
+
+/// Underlay glyphs, drawn before the bottom pane so its popups clear them: only blank cells of `glyphs` past each row's text and a gutter, never inside `kept`.
+pub(crate) fn underlay_glyphs(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    glyphs: Rect,
+    kept: &[Rect],
+    buffer: &mut Buffer,
+    level: Option<StdoutColorLevel>,
+    now: Instant,
+) {
+    let grid = buffer.area;
+    underlay_frame(snapshot, grid, level, true, now, |raster| {
+        let glyphs = glyphs.intersection(screen).intersection(grid);
+        for y in glyphs.top()..glyphs.bottom().min(grid.y.saturating_add(raster.height)) {
+            let from = (glyphs.left()..glyphs.right())
+                .rev()
+                .find(|x| !underlay_blank(&buffer[(*x, y)]))
+                .map_or(glyphs.left(), |x| x + 1 + UNDERLAY_GUTTER);
+            for x in from..glyphs.right().min(grid.x.saturating_add(raster.width)) {
+                let source = &raster.cells
+                    [usize::from(y - grid.y) * usize::from(raster.width) + usize::from(x - grid.x)];
+                if source.symbol.is_empty()
+                    || source.symbol == " "
+                    || kept.iter().any(|area| area.contains((x, y).into()))
+                {
+                    continue;
+                }
+                buffer[(x, y)].set_symbol(&source.symbol).set_fg(
+                    source
+                        .fg
+                        .map_or(Color::Reset, |fg| crate::mod_ui::color_at(fg, level)),
+                );
+            }
+        }
+    });
+}
+
+pub(crate) fn underlay_tint(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    kept: &[Rect],
+    buffer: &mut Buffer,
+    level: Option<StdoutColorLevel>,
+) {
+    let grid = buffer.area;
+    let screen = screen.intersection(grid);
+    underlay_frame(snapshot, grid, level, false, Instant::now(), |raster| {
+        let foreground = crate::terminal_palette::default_fg()
+            .map_or(ModColor::Rgb(255, 255, 255), |(r, g, b)| {
+                ModColor::Rgb(r, g, b)
+            });
+        let light = crate::terminal_palette::default_bg().is_some_and(crate::color::is_light);
+        let empty = |cell: &ratatui::buffer::Cell| cell.symbol() == " " && cell.modifier.is_empty();
+        for y in screen.top()..screen.bottom() {
+            let row = y - grid.y;
+            for x in screen.left()..screen.right() {
+                let column = x - grid.x;
+                let source = &raster.cells[usize::from(row.min(raster.height - 1))
+                    * usize::from(raster.width)
+                    + usize::from(column.min(raster.width - 1))];
+                let Some(background) = source.bg else {
+                    continue;
+                };
+                if kept.iter().any(|area| area.contains((x, y).into())) {
+                    continue;
+                }
+                let cell = &mut buffer[(x, y)];
+                if cell.bg != Color::Reset {
+                    continue;
+                }
+                let behind = crate::mod_ui::rgb(background);
+                cell.set_bg(crate::mod_ui::color_at(background, level));
+                if empty(cell) {
+                    continue;
+                }
+                let fg = match cell.fg {
+                    Color::Reset => Some(foreground),
+                    Color::Rgb(r, g, b) if light => Some(ModColor::Rgb(r, g, b)),
+                    Color::Indexed(index) if light => Some(ModColor::Indexed(index)),
+                    _ => None,
+                };
+                if let Some(fg) = fg {
+                    cell.set_fg(crate::mod_ui::color_at(
+                        crate::mod_ui::readable(fg, behind),
+                        level,
+                    ));
+                }
+            }
+        }
+    });
+}
+
+/// A pointer cell on a framed raster in frame pixels, with whether it lies on the picture; `fraction` is the pointer's offset inside the cell, else the cell's centre or half is used.
+pub(crate) fn pixel(
+    id: &str,
+    column: i64,
+    row: i64,
+    half: Option<u64>,
+    fraction: Option<(f64, f64)>,
+) -> Option<(f64, f64, bool)> {
+    let ((width, height), (columns, rows)) = rasters().get(id)?.placed?;
+    if columns == 0 || rows == 0 {
+        return None;
+    }
+    let along = |cell: f64, cells: u16, pixels: u32| {
+        (cell * f64::from(pixels) / f64::from(cells)).clamp(0.0, f64::from(pixels.max(1) - 1))
+    };
+    let (fx, fy) = fraction.unwrap_or((
+        0.5,
+        half.map_or(0.5, |half| half.min(1) as f64 / 2.0 + 0.25),
+    ));
+    Some((
+        along(column as f64 + fx, columns, width),
+        along(row as f64 + fy, rows, height),
+        (0..i64::from(columns)).contains(&column) && (0..i64::from(rows)).contains(&row),
+    ))
+}
+
+/// Keeps the rasters in view and those a live process draws, so a context change doesn't drop a still page's only frame.
+pub(crate) fn retain(ids: &BTreeSet<String>) {
+    let thread = crate::mod_surface::current_thread();
+    let mut rasters = rasters();
+    rasters.retain(|id, raster| {
+        let kept = ids.contains(id)
+            || raster.binding.is_some_and(|binding| {
+                Some(binding)
+                    == codex_omd::process_raster::serial(thread.as_deref(), &raster.owner, id)
+            });
+        if !kept && raster.drawn {
+            crate::mod_client::forget(id);
+        }
+        kept
+    });
+    layouts().retain(|id, _| ids.contains(id) || rasters.contains_key(id));
+}
