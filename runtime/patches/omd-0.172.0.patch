+impl codex_extension_api::ApprovalGateContributor for RecordingGate {
+    fn gate_approval<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalGateInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, codex_extension_api::ApprovalGate> {
+        assert_eq!((input.kind, input.host_decision), ("exec", "ask"));
+        assert_eq!(
+            input.details["command"],
+            serde_json::json!(["npm", "install"])
+        );
+        Box::pin(std::future::ready(self.verdict.clone()))
+    }
+
+    fn on_approval_result<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalResultInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        self.results
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .push((
+                input.call_id.to_owned(),
+                input.decision.to_owned(),
+                input.source.to_owned(),
+            ));
+        Box::pin(std::future::ready(()))
+    }
+}
