+#[test]
+#[serial_test::serial]
+fn background_timers_use_the_session_dispatcher_with_captured_authority() {
+    let directory = tempfile::tempdir().unwrap();
+    let paths = paths(directory.path());
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let registration = codex_omd::host::install_session_dispatcher(Arc::new(
+        |owner, thread, caller, source, policy, call, active| {
+            assert!(owner.is_none());
+            assert_eq!(thread, "captured-thread");
+            assert_eq!(caller, "background_fixture");
+            assert_eq!(source, Some("0".repeat(64).as_str()));
+            assert!(policy.is_none());
+            assert!(active());
+            Ok(json!({"operation":call.operation,"arguments":call.arguments}))
+        },
+    ))
+    .unwrap();
+    let scope = crate::mod_runtime::CallScope {
+        thread: Some("captured-thread"),
+        ..scope(InvocationContext::User)
