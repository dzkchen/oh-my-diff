+impl BlitError {
+    pub fn new(kind: BlitErrorKind, message: impl Into<String>) -> Self {
+        Self {
+            kind,
+            message: message.into(),
+        }
+    }
+    pub fn retryable(message: impl Into<String>) -> Self {
