+#[serial_test::serial]
+fn an_owner_snapshot_supersedes_a_pending_resize_render() {
+    with_owner_render(|context, _runtime| {
+        let initial = serde_json::json!({
+            "epoch": 1, "revision": 40,
+            "input": {"event":"idle","client":{"columns":100}},
+            "progress": {"title":"Running", "lines":["Waiting for operation"]},
+            "native_diagnostics": ["before completion"]
+        });
+        crate::mod_ui::preview(serde_json::from_value(initial).unwrap());
+        let latest = serde_json::json!({
+            "epoch": 1, "revision": 41,
+            "input": {"event":"idle","client":{"columns":100}},
+            "activity": [{"sequence":1,"mod_id":"hooked","tool":"task","label":"Finished","status":"completed"}],
+            "native_diagnostics": ["after completion"]
+        });
+        let checks = std::sync::atomic::AtomicUsize::new(0);
+        render_for(context, &|| {
+            if checks.fetch_add(1, Ordering::SeqCst) == 1 {
+                owner_snapshot(latest.clone()).unwrap();
+                assert!(crate::mod_ui::shared_snapshot().progress.is_none());
+            }
+            true
+        });
+        assert!(checks.load(Ordering::SeqCst) > 1);
+        wait_until(
+            "the latest owner snapshot and viewport were not rendered",
+            || {
+                let drawn = crate::mod_ui::shared_snapshot();
+                drawn.progress.is_none()
+                    && drawn.activity.len() == 1
+                    && drawn.view.title == Some(crate::mod_client::value()["columns"].to_string())
+            },
+        );
+        drop(_runtime.locked());
+        let drawn = crate::mod_ui::shared_snapshot();
+        assert!(
+            drawn.progress.is_none(),
+            "resize restored completed native progress"
+        );
+        assert_eq!(
+            drawn.activity.len(),
+            1,
+            "resize lost native completion activity"
+        );
+        assert_eq!(
+            drawn.native_diagnostics,
+            vec!["after completion".to_owned()]
+        );
+        assert_eq!(
+            drawn.view.title,
+            Some(crate::mod_client::value()["columns"].to_string()),
+            "the current viewport must still be rendered"
+        );
+    });
+}
