+/// Lets a test drive a fresh render engine with its own frames, restoring the previous ones after.
+#[cfg(test)]
+pub(crate) fn test_engine(frames: crate::tui::FrameRequester) -> impl Drop {
+    struct Restore(bool, Option<Engine>, Option<crate::tui::FrameRequester>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            HOOKED.with(|hooked| hooked.store(self.0, Ordering::Relaxed));
+            ENGINE.with(|engine| *engine.locked() = self.1.take());
+            FRAMES.with(|stored| *stored.locked() = self.2.take());
+        }
+    }
+    Restore(
+        HOOKED.with(|hooked| hooked.swap(true, Ordering::Relaxed)),
+        ENGINE.with(|engine| engine.locked().take()),
+        FRAMES.with(|stored| stored.locked().replace(frames)),
+    )
+}
