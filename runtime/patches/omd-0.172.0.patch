+        let mut encoded = Some(EncodedJsonBody::encode(&body).unwrap());
+        accounts.prepare(&mut request, &mut encoded).unwrap();
+        let prepared: Value = serde_json::from_slice(encoded.unwrap().as_bytes()).unwrap();
