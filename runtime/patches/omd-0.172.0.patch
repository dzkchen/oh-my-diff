+        let sh = codex_omd::host::unrestricted_program(&access, "sh", &repository).unwrap();
+        let sha256 = codex_omd::sha256_hex(fs::read(&sh).unwrap());
+        let pidfile = repository.join("child.pid");
+        let start = |owner: ProcessOwner<'_>, session: &str| {
