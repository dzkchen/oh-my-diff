+    assert_eq!(client.call("policy.get", json!({"key": "k"})).unwrap(), 1);
+    assert_eq!(
+        error(client.authorized("policy.rollback", json!({"key": "other"}))),
+        "authority_policy_previous_missing"
+    );
+    assert_eq!(
