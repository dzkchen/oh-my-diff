+static TERMINAL_TOKEN: Mutex<Option<String>> = Mutex::new(None);
+
+pub(crate) fn configuration_owner_id() -> Option<String> {
+    TERMINAL_TOKEN.locked().clone()
+}
+
+static TERMINAL_OWNER: std::sync::LazyLock<Mutex<Arc<Mutex<codex_omd::ConfigurationOverrides>>>> =
+    std::sync::LazyLock::new(|| Mutex::new(Arc::default()));
+
+fn shared_host_active(active: &dyn Fn() -> bool) -> Result<Arc<Mutex<ModHost>>, String> {
+    let mut host = try_lock_until(&HOST, active).ok_or("callback_cancelled")?;
+    if host.is_none() {
+        let paths = crate::omd::mod_paths().ok_or("Oh My Diff mods are not active")?;
+        let store = paths.store;
+        let owner = TERMINAL_OWNER
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let runtime = ModHost::open(
+            store,
+            ModOpenOptions {
+                repository: Some(&paths.repository),
+                active,
+                configuration_overrides: owner,
+                ..ModOpenOptions::default()
+            },
+        )
+        .map_err(|e| e.to_string())?;
+        if !active() {
+            return Err("callback_cancelled".to_owned());
+        }
+        *host = Some(Arc::new(Mutex::new(runtime)));
+    }
+    host.clone()
+        .ok_or_else(|| "mod runtime unavailable".to_owned())
+}
