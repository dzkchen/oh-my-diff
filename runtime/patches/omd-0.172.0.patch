+            .description
+            .as_deref()
+            .unwrap()
+            .contains("only this terminal")
+    );
+    assert!(matches!(
+        sent(&own_default[0]),
+        AppEvent::OmdModToggle { terminal: true, .. }
+    ));
+    assert!(matches!(
+        sent(&own[0]),
+        AppEvent::OmdModToggle {
+            terminal: false,
+            ..
+        }
+    ));
+    assert!(
+        matches!(sent(&own_default[3]), AppEvent::OmdConfiguration { action, .. } if action == "reset")
+    );
+    assert!(
+        matches!(sent(&own_default[4]), AppEvent::OmdConfiguration { action, .. } if action == "save-defaults")
+    );
+}
