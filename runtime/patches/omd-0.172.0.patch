+) -> std::io::Result<std::collections::BTreeSet<std::path::PathBuf>> {
+    let mut paths = std::collections::BTreeSet::new();
+    for selection in selections {
+        let environment = manager
+            .get_environment(&selection.environment_id)
+            .ok_or_else(|| std::io::Error::other("workspace_environment_unavailable"))?;
+        if environment.is_remote() {
+            continue;
+        }
+        for path in std::iter::once(&selection.cwd).chain(&selection.workspace_roots) {
+            if let Ok(local) = path.to_abs_path() {
+                paths.extend(existing_workspace_path(&local)?);
+            }
+        }
+    }
+    Ok(paths)
+}
+
+fn existing_workspace_path(path: &std::path::Path) -> std::io::Result<Option<std::path::PathBuf>> {
+    match path.canonicalize() {
+        Ok(path) => Ok(Some(path)),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(std::io::Error::new(
+            error.kind(),
+            format!("Cannot initialize workspace {}: {error}", path.display()),
+        )),
+    }
+}
+
+async fn prompt_expansion_items<F, Fut>(
+    input: &[codex_protocol::user_input::UserInput],
+    read: F,
+) -> Vec<serde_json::Value>
+where
+    F: Fn(PathBuf) -> Fut,
+    Fut: std::future::Future<Output = std::io::Result<Vec<u8>>>,
+{
+    use codex_protocol::user_input::UserInput;
+    let read = &read;
+    let mut expansions = std::pin::pin!(
+        futures::stream::iter(0..input.len())
+            .map(|index| async move {
+                use sha2::Digest;
+                let item = &input[index];
+                let digest = |bytes: &[u8]| format!("{:x}", sha2::Sha256::digest(bytes));
+                let mut items = Vec::new();
+                match item {
+                    UserInput::Skill { name, path } => {
+                        let content = read(path.clone()).await.unwrap_or_default();
+                        items.push(serde_json::json!({"kind": "skill", "name": name,
+                        "source": path.display().to_string(), "sha256": digest(&content)}));
+                    }
+                    UserInput::Mention { name, path } => {
+                        items.push(
+                            serde_json::json!({"kind": "mention", "name": name, "source": path}),
+                        );
+                    }
+                    UserInput::LocalImage { path, .. } => {
+                        items.push(
+                        serde_json::json!({"kind": "image", "source": path.display().to_string()}),
+                    );
+                    }
+                    UserInput::Text {
+                        text,
+                        text_elements,
+                    } => {
+                        for element in text_elements {
+                            let range = element.byte_range.start..element.byte_range.end;
+                            let Some(content) = text.get(range.clone()) else {
+                                continue;
+                            };
+                            let kind = if element
+                                .placeholder(text)
+                                .is_some_and(|placeholder| placeholder.starts_with("[Image"))
+                            {
+                                "image"
+                            } else {
+                                "paste"
+                            };
+                            items.push(serde_json::json!({"kind": kind, "start": range.start,
+                            "end": range.end, "bytes": content.len(),
+                            "sha256": digest(content.as_bytes())}));
+                        }
+                    }
+                    _ => {}
+                }
+
+                items
+            })
+            .buffered(4)
+    );
+    let mut items = Vec::new();
+    while let Some(expansion) = expansions.next().await {
+        items.extend(expansion);
+    }
+    items
+}
