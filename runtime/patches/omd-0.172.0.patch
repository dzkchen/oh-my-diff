+struct Password;
+
+impl ClientSurface for Password {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        let host_prompt = call.caller == crate::broker::HOST_CALLER
+            && call.operation == "terminal.prompt"
+            && call.arguments["masked"] == true;
