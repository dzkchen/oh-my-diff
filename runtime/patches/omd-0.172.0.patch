+            &grant.sha256,
+            &codex_omd::sha256_hex(repository.as_os_str().as_encoded_bytes()),
+            &route.provider,
+            &route.model,
+            &route.responses_url,
+            route.rates.included_subscription,
+        )
+    };
+    assert!(allowed(&repository) && allowed(&other));
