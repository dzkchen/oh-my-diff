+        source: "fixture".into(),
+        sha256: "0".repeat(64),
+    }
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values
+        .iter()
+        .map(std::string::ToString::to_string)
+        .collect()
+}
+
+#[test]
+fn exec_output_artifact_is_paged_and_bound_to_the_caller() {
+    let _exec = exec_slot();
+    let (_temp, repository, data, authority) = setup();
+    let active = || true;
+    let host = Host {
+        authority: &authority,
+        data_root: &data,
+        environment: None,
+        active: &active,
+        record_changes: false,
