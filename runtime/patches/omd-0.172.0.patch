+impl ModStore {
+    pub fn create(root: PathBuf) -> Result<Self> {
+        std::fs::DirBuilder::new().mode(0o700).create(&root)?;
+        let store = Self::open(root.canonicalize()?)?;
+        let config = ModConfiguration {
+            schema: 1,
+            revision: 0,
+            node: None,
+            mods: Vec::new(),
+        };
+        store.write_granting(
+            "mods.json",
+            &serde_json::to_value(config)?,
+            &runner_approval()?,
+        )?;
+        Ok(store)
+    }
+
+    /// Grants the runner beside this binary, after an install or update replaced it, when the broker is deployed.
+    pub fn authorize_runner(&self) -> Result<()> {
+        let _lock = self.transaction()?;
+        let Some((_, grants)) = brokered_grants(&self.root)? else {
+            return Ok(());
+        };
+        if verify_runner(&super::process::runner_path()?, Some(&grants)).is_ok() {
+            return Ok(());
+        }
+        let mut config = self.configuration()?;
+        next_revision(&mut config.revision)?;
+        self.write_granting(
+            "mods.json",
+            &serde_json::to_value(config)?,
+            &runner_approval()?,
+        )
+    }
+
+    /// The runner beside this binary, refused when the broker holds no runner grant for it.
+    pub(super) fn verified_runner(&self) -> Result<()> {
+        verify_runner(
+            &super::process::runner_path()?,
+            brokered_grants(&self.root)?
+                .as_ref()
+                .map(|(_, grants)| grants),
+        )
+    }
+
+    /// Moves a corrupt store file aside; a reset `mods.json` keeps no mods selected and a reset `packages.lock.json` leaves its packages as plain trusted selections.
+    pub fn reset(&self, name: &str) -> Result<PathBuf> {
+        if !matches!(
+            name,
+            "mods.json" | "host.json" | "packages.lock.json" | "managed.json"
+        ) {
+            return Err(failure("store_file_not_resettable"));
+        }
+        let path = self.root.join(name);
+        if !path.try_exists()? {
+            return Err(failure(format!(
+                "store_file_absent: {} does not exist; nothing to reset",
+                path.display()
+            )));
+        }
+        let aside = (0u32..)
+            .map(|copy| match copy {
+                0 => self.root.join(format!("{name}.corrupt")),
+                copy => self.root.join(format!("{name}.corrupt.{copy}")),
+            })
+            .find(|aside| !aside.exists())
+            .ok_or_else(|| failure("store_file_not_resettable"))?;
+        let empty = match name {
+            "mods.json" => Some(serde_json::to_value(ModConfiguration {
+                schema: 1,
+                revision: 0,
+                node: None,
+                mods: Vec::new(),
+            })?),
+            _ => None,
+        };
+        std::fs::rename(&path, &aside)?;
+        if let Some(config) = empty
+            && let Err(error) = self.write(name, &config)
+        {
+            let _ = std::fs::rename(&aside, &path);
+            return Err(error);
+        }
+        Ok(aside)
+    }
+
+    pub fn open(root: PathBuf) -> Result<Self> {
+        if !root.is_absolute() || root.canonicalize()? != root || !root.is_dir() {
