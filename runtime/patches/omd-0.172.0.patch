+        let directory = tempfile::tempdir().unwrap();
+        let repository = directory.path().canonicalize().unwrap();
+        let processes = ManagedProcesses::default();
+        let policy = FileSystemSandboxPolicy::read_only();
+        let owner = ProcessOwner {
+            thread: None,
+            id: "fixture",
+            generation: 1,
+            repository: &repository,
+            policy: &policy,
+            protected: &[],
+            environment: None,
+            os_access: None,
+            blit: None,
+        };
+        let found = processes
+            .call(owner, "process.which", json!({"names":["sleep"]}), || true)
+            .unwrap();
+        let sleep = found["found"].as_array().unwrap().first().unwrap();
+        processes
+            .call(
+                 owner,
+                "process.start",
+                json!({"session":"blocked","name":"sleep","path":sleep["path"],"sha256":sleep["sha256"],"arguments":["20"]}),
+                || true,
+            )
+            .unwrap();
+        let started = Instant::now();
+        let error = processes
+            .call(
+                owner,
+                "process.exchange",
+                json!({"session":"blocked","send":[{"data":"x".repeat(256 * 1024)}],"wait_ms":0}),
+                || started.elapsed() < Duration::from_millis(100),
+            )
+            .unwrap_err();
+        assert_eq!(error, "process_cancelled");
+        assert!(started.elapsed() < Duration::from_secs(2));
+        assert_eq!(
+            processes
+                .call(
+                    owner,
+                    "process.status",
+                    json!({"session":"blocked"}),
+                    || true,
+                )
+                .unwrap_err(),
+            "process_session_unavailable"
+        );
+    }
+
+    #[test]
+    fn dropping_a_session_kills_what_its_exited_leader_left_in_the_group() {
+        let mut child = Command::new("sh")
+            .args(["-c", "sleep 30 & echo $!"])
+            .stdout(Stdio::piped())
+            .process_group(0)
+            .spawn()
+            .unwrap();
+        let mut line = String::new();
+        BufReader::new(child.stdout.take().unwrap())
+            .read_line(&mut line)
+            .unwrap();
+        let orphan: libc::pid_t = line.trim().parse().unwrap();
+        let process = ManagedProcess {
+            child,
+            unrestricted: false,
+            sender: mpsc::sync_channel(1).0,
+            receiver: mpsc::sync_channel(1).1,
+            queued: Default::default(),
+            pending: None,
+            exited_at: None,
+            stdin: true,
+            scratch: PathBuf::from("/nonexistent/omd-reaped"),
+            last_used: Instant::now(),
+            reaped: Arc::default(),
+            _raster: None,
+        };
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !process.exited().unwrap() {
+            assert!(Instant::now() < deadline, "the leader never exited");
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let reaped = Arc::clone(&process.reaped);
+        drop(process);
+        assert!(*reaped.lock().unwrap());
+        while unsafe { libc::kill(orphan, 0) } == 0 {
+            assert!(Instant::now() < deadline, "the background child survived");
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+
+    #[test]
+    fn process_environment_rejects_host_overrides() {
+        let directory = tempfile::tempdir().unwrap();
+        let repository = directory.path().canonicalize().unwrap();
+        let processes = ManagedProcesses::default();
+        let policy = FileSystemSandboxPolicy::read_only();
+        let owner = ProcessOwner {
+            thread: None,
+            id: "fixture",
+            generation: 1,
+            repository: &repository,
+            policy: &policy,
+            protected: &[],
+            environment: None,
+            os_access: None,
+            blit: None,
+        };
+        let found = processes
+            .call(owner, "process.which", json!({"names":["cat"]}), || true)
+            .unwrap();
+        let cat = found["found"].as_array().unwrap().first().unwrap();
+        for environment in [
+            json!({"HOME":"/tmp"}),
+            json!({"DYLD_INSERT_LIBRARIES":"/tmp/injected.dylib"}),
+            json!({"NODE_OPTIONS":"--require=/tmp/injected.js"}),
+            json!({"GIT_CONFIG_GLOBAL":"/tmp/injected"}),
+            json!({"BASH_ENV":"/tmp/injected.sh"}),
+            json!({"CUSTOM_PATH":"line\nbreak"}),
+        ] {
+            assert_eq!(
+                processes
+                    .call(
+                         owner,
+                        "process.start",
+                        json!({"session":"rejected","name":"cat","path":cat["path"],"sha256":cat["sha256"],"environment":environment}),
+                        || true,
+                    )
+                    .unwrap_err(),
+                "process_program_or_arguments_invalid"
+            );
+        }
+    }
+}
diff --git a/codex-rs/ext/omd/src/model_windows.rs b/codex-rs/ext/omd/src/model_windows.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6b0a5752af6c305a0d217e207e121538b8591963
--- /dev/null
+++ b/codex-rs/ext/omd/src/model_windows.rs
@@ -0,0 +1,146 @@
+use codex_models_manager::runtime_models;
+use codex_omd::fsio::Durability;
+use codex_omd::fsio::write_bytes;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+use std::time::SystemTime;
+
+const FILE: &str = "model-windows.json";
+const MAX_MODELS: usize = 64;
+const MAX_SLUG_BYTES: usize = 128;
+const MAX_TOKENS: i64 = 10_000_000;
+
+type Stamp = Option<(u64, SystemTime)>;
+
+static SEEN: Mutex<Option<Stamp>> = Mutex::new(None);
+
+fn stamp(root: &Path) -> Stamp {
+    let metadata = std::fs::metadata(root.join(FILE)).ok()?;
+    Some((metadata.len(), metadata.modified().ok()?))
+}
+
+fn read(root: &Path) -> BTreeMap<String, i64> {
+    std::fs::read(root.join(FILE))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+        .unwrap_or_default()
+}
+
+pub(crate) fn load(root: &Path) {
+    let current = stamp(root);
+    let mut seen = SEEN.lock().unwrap_or_else(PoisonError::into_inner);
+    if seen.as_ref() != Some(&current) {
+        runtime_models::set_context_windows(read(root).into_iter().collect());
+        *seen = Some(current);
+    }
+}
+
+pub(crate) fn call(root: &Path, arguments: Value) -> Result<Value, String> {
+    let Value::Object(mut input) = arguments else {
+        return Err("model_context_window_invalid: expected {model, tokens?}".into());
+    };
+    let model = match input.remove("model") {
+        Some(Value::String(model)) if !model.is_empty() && model.len() <= MAX_SLUG_BYTES => model,
+        _ => return Err("model_context_window_invalid: model is a slug of 1 to 128 bytes".into()),
+    };
+    let tokens = input.remove("tokens");
+    if let Some(field) = input.keys().next() {
+        return Err(format!(
+            "model_context_window_invalid: unknown field {field}"
+        ));
+    }
+    let mut seen = SEEN.lock().unwrap_or_else(PoisonError::into_inner);
+    let mut windows = read(root);
+    let changed = tokens.is_some();
+    match tokens {
+        None => {}
+        Some(Value::Null) => {
+            windows.remove(&model);
+        }
+        Some(value) => {
+            let tokens = value
+                .as_i64()
+                .filter(|tokens| (1..=MAX_TOKENS).contains(tokens))
+                .ok_or(
+                    "model_context_window_invalid: tokens is a whole number from 1 to 10000000",
+                )?;
+            if !windows.contains_key(&model) && windows.len() >= MAX_MODELS {
+                return Err(format!(
+                    "model_context_window_limit: at most {MAX_MODELS} models"
+                ));
+            }
+            windows.insert(model.clone(), tokens);
+        }
+    }
+    if changed {
+        let bytes = serde_json::to_vec(&windows).map_err(|error| error.to_string())?;
+        write_bytes(&root.join(FILE), &bytes, Durability::Volatile)
+            .map_err(|error| error.to_string())?;
+        *seen = Some(stamp(root));
+    }
+    runtime_models::set_context_windows(
+        windows
+            .iter()
+            .map(|(slug, tokens)| (slug.clone(), *tokens))
+            .collect(),
+    );
+    let max = runtime_models::find(&model)
+        .and_then(|(_, info)| info.max_context_window.or(info.context_window));
+    Ok(json!({"model": model, "tokens": windows.get(&model), "max": max}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn picked_windows_persist_clear_and_validate() {
+        let root = tempfile::tempdir().expect("root");
+        let stored = || -> BTreeMap<String, i64> {
+            serde_json::from_slice(&std::fs::read(root.path().join(FILE)).expect("file"))
+                .expect("json")
+        };
+        let set = call(
+            root.path(),
+            json!({"model": "omd-window-test", "tokens": 400_000}),
+        )
+        .expect("set");
+        assert_eq!(
+            set,
+            json!({"model": "omd-window-test", "tokens": 400_000, "max": null})
+        );
+        assert_eq!(
+            stored(),
+            BTreeMap::from([("omd-window-test".to_string(), 400_000)])
+        );
+        assert_eq!(
+            call(root.path(), json!({"model": "omd-window-test"})).expect("read")["tokens"],
+            400_000
+        );
+        assert_eq!(
+            call(
+                root.path(),
+                json!({"model": "omd-window-test", "tokens": null})
+            )
+            .expect("clear")["tokens"],
+            Value::Null
+        );
+        assert_eq!(stored(), BTreeMap::new());
+        for bad in [
+            json!({"model": "", "tokens": 1}),
+            json!({"model": "m", "tokens": 0}),
+            json!({"model": "m", "tokens": 2.5}),
+            json!({"model": "m", "extra": 1}),
+        ] {
+            assert!(
+                call(root.path(), bad)
+                    .unwrap_err()
+                    .starts_with("model_context_window_invalid")
+            );
+        }
+    }
+}
