+pub(crate) fn write_settings(
+    id: &str,
+    values: &Value,
+    target: &str,
+    reset: &[String],
+    scope: Option<&str>,
+    caller: &str,
+    invocation: &CallScope<'_>,
+) -> std::io::Result<Value> {
+    if !(invocation.active)() {
+        return Err(std::io::Error::other("callback_cancelled"));
+    }
+    let context = configuration_context_for(
+        configuration_binding(),
+        invocation.terminal_owner.clone(),
+        invocation.thread.map(str::to_owned),
+    )
+    .map_err(std::io::Error::other)?;
+    let grants = {
+        let runtime = context.runtime.locked();
+        owner_grants(&runtime)
+    };
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let call_scope = CallScope {
+        terminal_owner: context.owner.clone(),
+        epoch: context.epoch,
+        context: codex_omd::app_routes::InvocationContext::Event,
+        thread: context.thread.as_deref(),
+        active: Arc::new({
+            let binding = context.binding;
+            let continued = invocation.active.clone();
+            move || continued() && configuration_binding_current(binding)
+        }),
+    };
+    codex_omd::write_settings_shared(
+        &context.runtime,
+        id,
+        values,
+        target,
+        reset,
+        scope,
+        caller,
+        context.thread.as_deref(),
+        call_scope.active.as_ref(),
+        |caller, call| {
+            crate::mod_surface::host_call(
+                &context.paths,
+                &policy,
+                grants.get(caller).cloned(),
+                caller,
+                call,
+                &call_scope,
+            )
+        },
+    )
+}
