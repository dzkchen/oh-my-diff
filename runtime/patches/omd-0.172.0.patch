+
+struct Silent;
+
+#[derive(Default)]
+struct Queued(Mutex<Vec<SurfaceCall>>);
+
+impl ClientSurface for Queued {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        self.0.lock().unwrap().push(call);
+        Ok(())
+    }
+}
+
+impl ClientSurface for Silent {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        std::mem::forget(call.reply);
