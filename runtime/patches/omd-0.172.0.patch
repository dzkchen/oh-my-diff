+                        .next()
+                        .and_then(|value| value.parse().ok())
+                        .ok_or_else(|| io::Error::other("--expires needs SECONDS"))?;
+                    expires_at = Some(
+                        std::time::SystemTime::now()
+                            .duration_since(std::time::UNIX_EPOCH)
+                            .map_err(io::Error::other)?
+                            .as_secs()
+                            .checked_add(seconds)
+                            .ok_or_else(|| io::Error::other("--expires is too large"))?,
+                    );
+                } else {
+                    scope = argument.clone();
+                }
+            }
+            let capabilities: Vec<String> = capabilities
+                .split(',')
+                .filter(|s| !s.is_empty())
+                .map(str::to_string)
+                .collect();
+            let exposure = codex_omd::authority_exposure(&capabilities);
+            open(root)?.trust_all(vec![codex_omd::Trust {
+                path: PathBuf::from(path).canonicalize()?,
+                sha256: sha.clone(),
+                capabilities,
+                scope: scope.clone(),
+                secret_environment: secrets,
+                expires_at,
+            }])?;
+            Ok(json!({
+                "status": format!("trusted in the {scope} scope; disabled until explicitly enabled"),
+                "expires_at": expires_at,
+                "exposure": exposure,
+            }))
+        }
+        [command, root, target] if command == "revoke" => {
+            let target = match PathBuf::from(target).canonicalize() {
+                Ok(path) if target.contains('/') => path.display().to_string(),
+                _ => target.clone(),
+            };
+            open(root)?.revoke(&target)?;
+            Ok(Value::String(
+                "disabled and every grant dropped; owned work stops at the next reload; trust or install again to renew".into(),
+            ))
+        }
+        [command, root, id, reason @ ..] if command == "package-quarantine" => open(root)?
+            .package_quarantine(id, &reason.join(" "))
+            .and_then(json),
+        [command, root, id] if command == "package-unblock" => {
+            open(root)?.package_unblock(id).and_then(json)
+        }
+        [command, root] if command == "security-events" => {
+            Ok(Value::Array(open(root)?.security_events()?))
+        }
+        [command, root, packages] if command == "trust-all" => {
+            let packages: Vec<Value> = serde_json::from_str(packages)?;
+            let packages = packages
+                .iter()
+                .map(|package| {
+                    let text = |key: &str| {
+                        package[key]
+                            .as_str()
+                            .map(str::to_owned)
+                            .ok_or_else(|| io::Error::other(format!("trust-all needs {key}")))
+                    };
+                    Ok(codex_omd::Trust {
+                        path: PathBuf::from(text("path")?).canonicalize()?,
+                        sha256: text("sha256")?,
+                        capabilities: serde_json::from_value(package["capabilities"].clone())?,
+                        scope: package["scope"].as_str().unwrap_or("user").to_owned(),
+                        secret_environment: Vec::new(),
+                        expires_at: None,
+                    })
+                })
+                .collect::<io::Result<Vec<_>>>()?;
+            let count = packages.len();
+            open(root)?.trust_all(packages)?;
+            Ok(Value::String(format!(
+                "trusted {count} packages; disabled until explicitly enabled"
+            )))
+        }
+        [command, root, rest @ ..] if command == "broker-grants-import" && rest.len() <= 1 => {
+            open(root)?.broker_grants_import(
+                rest.first()
+                    .map(|snapshot| serde_json::from_str(snapshot))
+                    .transpose()?,
+            )
+        }
+        [command, root, path] if command == "require" => {
+            let path = PathBuf::from(path);
+            open(root)?.require(&path.canonicalize().unwrap_or(path))?;
+            Ok(Value::String(
+                "selection required; in-app mod screens keep it on".into(),
+            ))
+        }
+        [command, root, path] if command == "enable" || command == "disable" => {
+            let path = PathBuf::from(path);
+            open(root)?.enable(&path.canonicalize().unwrap_or(path), command == "enable")?;
+            Ok(Value::String(
+                "selection saved; takes effect at the next turn boundary".into(),
+            ))
+        }
+        [command, root, action, owner, label, origin]
+            if command == "credentials" && action == "add-secret" =>
+        {
+            let mut value = String::new();
+            io::Read::read_to_string(&mut io::stdin(), &mut value)?;
+            let value = value.trim_end_matches(['\n', '\r']);
+            let profiles = codex_omd::credentials::CredentialProfiles::open(&store(root)?)?;
+            let existing = profiles.visible(owner)?.into_iter().find(|profile| {
+                profile["kind"] == "secret"
+                    && profile["label"] == label.as_str()
+                    && profile["origin"] == origin.as_str()
+            });
+            let id = match existing {
+                Some(profile) => profile["id"].as_str().unwrap_or_default().to_owned(),
+                None => profiles.create_secret(label, origin, owner)?.id,
+            };
+            profiles.store_secret(&id, value)?;
+            profiles.public(&profiles.profile(&id)?)
+        }
+        [command, root] if command == "credentials" => Ok(Value::Array(
+            codex_omd::credentials::CredentialProfiles::open(&store(root)?)?.visible("")?,
+        )),
+        [command, root] if command == "reload" => {
+            open(root)?.reload()?;
+            Ok(Value::String(
+                "reload queued for the next turn boundary".into(),
+            ))
+        }
+        [command, root, name] if command == "reset" => {
+            let aside = open(root)?.reset(name)?;
+            Ok(json!({"reset": name, "aside": aside}))
+        }
+        [command, root] if command == "status" => {
+            let mut host = open_host(root, true)?;
+            let terminal = host.terminal_view(
+                serde_json::json!({"event": "status", "ledger": null}),
+                || true,
+            );
+            let mut status = host.status();
+            status["terminal"] = serde_json::json!({"contributors": terminal.contributors,
+                "conflicts": terminal.conflicts, "diagnostics": terminal.diagnostics});
+            Ok(status)
+        }
+        [command, root] if command == "selection-status" => open(root)?.selection_status(),
+        [command, action, rest @ ..] if command == "policy" => policy(action, rest),
+        [command, root, flags @ ..] if command == "package-sync" && flags.len() <= 1 => {
+            let store = open(root)?;
+            match flags {
+                [] => store.package_sync(false),
+                [flag] if flag == "--offline" => store.package_sync(true),
+                [flag] if flag == "--rollback" => store.package_sync_rollback(),
+                _ => Err(io::Error::other(
+                    "usage: omd-mod package-sync STORE [--offline|--rollback]",
+                )),
+            }
+        }
+        [command, root] if command == "report" => {
+            let status = open_host(root, false)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"mods":status["mods"].as_array()
+                .into_iter().flatten().map(|item| serde_json::json!({
+                    "id":item["id"],"declared":{"capabilities":item["capabilities"],
+                        "services":item["services"]},"used":item["source_use"],
+                    "unused_grants":item["unused_grants"],
+                    "unused_environment":item["unused_environment"],"error":item["error"]
+                })).collect::<Vec<_>>() }),
+            )
+        }
+        [command, root] if command == "events" => Ok(open_host(root, false)?.author_inspection()),
+        [command, root] if command == "declarations" => {
+            let status = open_host(root, false)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"active_host":status["active_host_types"],
+                "installed_contracts":status["installed_contract_types"],
+                "tool_types":status["tool_types"]}),
+            )
+        }
+        [command, root, scenario, thread @ ..] if command == "test" && thread.len() <= 1 => {
+            let scenario: Value = serde_json::from_slice(&std::fs::read(scenario)?)?;
+            let mut host = open_host(root, true)?;
+            let _thread = codex_omd::StateThread::enter(thread.first().cloned());
+            host.offline_test(scenario)
+        }
+        [command, root, output] if command == "diagnostics" => {
+            let bundle = open_host(root, false)?.diagnostic_bundle();
+            let output = PathBuf::from(output);
+            std::fs::write(&output, serde_json::to_vec_pretty(&bundle)?)?;
+            Ok(serde_json::json!({"bundle":output,"redacted":true}))
+        }
+        [command, denial] if command == "explain" => Ok(ModHost::capability_explanation(denial)),
+        [command, root, id, runs, call @ ..] if command == "cost" && call.len() <= 2 => {
+            let runs = runs
+                .parse::<usize>()
+                .ok()
+                .filter(|runs| (1..=100).contains(runs))
+                .ok_or_else(bad)?;
+            let call = match call {
+                [] => None,
+                [name] => Some((name.as_str(), Value::String(String::new()))),
+                [name, payload, ..] => Some((name.as_str(), serde_json::from_str(payload)?)),
+            };
+            ModHost::cost(
+                store(root)?,
+                validate_tool_schema,
+                &std::env::current_dir()?,
+                id,
+                call,
+                runs,
+            )
+        }
+        [command, root, id, name, payload, thread @ ..]
+            if command == "command" && thread.len() <= 1 =>
+        {
+            let mut host = open_host(root, true)?;
+            let _thread = codex_omd::StateThread::enter(thread.first().cloned());
+            host.invoke(
+                id,
+                host.generation(),
+                "command",
+                name,
+                serde_json::from_str(payload)?,
+                ModInvokeOptions::default(),
+            )
+        }
+        _ => Err(bad()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => {
+            codex_omd::print_output(&serde_json::to_string_pretty(&value).unwrap_or_default())
+        }
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/ext/omd/src/clients.rs b/codex-rs/ext/omd/src/clients.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9c553af8c10138b85f78e3d5e5978781269a76b5
--- /dev/null
+++ b/codex-rs/ext/omd/src/clients.rs
@@ -0,0 +1,1543 @@
+use super::*;
+use codex_omd::ModCommand;
+use codex_omd::ModComponent;
+use codex_omd::ModComponentAction;
+use codex_omd::ModKeyAction;
+use codex_omd::ModView;
+use codex_omd::ModViewSnapshot;
+use codex_omd::data_store::Origin;
+use codex_omd::resource_data::ResourceRef;
+
+static OWNERS: Mutex<BTreeMap<String, Arc<Mods>>> = Mutex::new(BTreeMap::new());
+static SESSION_OWNERS: Mutex<BTreeMap<String, std::sync::Weak<Mods>>> = Mutex::new(BTreeMap::new());
+static CLIENT_OWNERS: Mutex<BTreeMap<String, String>> = Mutex::new(BTreeMap::new());
+static NATIVE_HOLDERS: Mutex<std::collections::BTreeSet<(String, String)>> =
+    Mutex::new(std::collections::BTreeSet::new());
+
+pub fn configuration(client: &str, request: Value) -> Result<Value, String> {
+    let action = request["action"]
+        .as_str()
+        .ok_or("configuration_action_invalid")?;
+    let allowed: &[&str] = match action {
+        "read" | "catalog" => &["action"],
+        "command" => &["action", "command", "args"],
+        "write" => &["action", "id", "values", "target", "reset", "scope"],
+        "package" => &["action", "request"],
+        _ => return Err("configuration_action_invalid".into()),
+    };
+    let object = request
+        .as_object()
+        .ok_or("configuration_arguments_invalid")?;
+    if object.keys().any(|key| !allowed.contains(&key.as_str())) {
+        return Err("configuration_arguments_invalid".into());
+    }
+    if request
+        .get("target")
+        .is_some_and(|target| !matches!(target.as_str(), Some("terminal" | "shared")))
+    {
+        return Err("configuration_target_invalid".into());
+    }
+    if request.get("scope").is_some_and(|scope| {
+        !scope.is_null() && !matches!(scope.as_str(), Some("user" | "project"))
+    }) {
+        return Err("configuration_scope_invalid".into());
+    }
+    let core = client_core(client)?;
+    if action == "command" {
+        let command = request["command"].as_str().ok_or("command_required")?;
+        let args = request["args"].as_str().ok_or("command_args_required")?;
+        return user_command(core, command.to_owned(), args.to_owned());
+    }
+    let mut runtime = core
+        .input_runtime
+        .lock()
+        .map_err(|_| "mod_runtime_poisoned")?;
+    runtime.refresh(&|| true).map_err(|e| e.to_string())?;
+    let result = match action {
+        "catalog" => {
+            let store = codex_omd::ModStore::open(core.host.root.clone()).map_err(|error| error.to_string())?;
+            let packages = runtime.configuration_listing(codex_omd::package_controls::list_fields(&store, Some(&runtime.status()), Value::Null, Some(&core.host.repository), core.terminal_owner.as_deref()).map_err(|error| error.to_string())?).map_err(|error| error.to_string())?;
+            Ok(json!({"status": runtime.status(), "view":core.views.published().as_deref(), "packages":packages,"builtins":codex_omd::BuiltinSnapshot::from_controls(&runtime.builtin_controls())}))
+        }
+        "read" => {
+            let store = codex_omd::ModStore::open(core.host.root.clone()).map_err(|e| e.to_string())?;
+            let listed = codex_omd::package_controls::list_fields(&store, Some(&runtime.status()), Value::Null, Some(&core.host.repository), core.terminal_owner.as_deref()).map_err(|e| e.to_string())?;
+            runtime.configuration_listing(listed)
+        }
+        "write" => {
+            let id = request["id"].as_str().ok_or("mod_id_required")?;
+            let reset: Vec<String> = serde_json::from_value(request.get("reset").cloned().unwrap_or_else(|| json!([]))).map_err(|e| e.to_string())?;
+            runtime.write_configuration_in(id, &request["values"], request["target"].as_str().unwrap_or("shared"), &reset, request["scope"].as_str())
+        }
+        "package" => {
+            let arguments = &request["request"];
+            let object = arguments.as_object().ok_or("package_arguments_invalid")?;
+            if object.keys().any(|key| !["action", "id", "scope", "target", "expected_generation"].contains(&key.as_str())) { return Err("package_arguments_invalid".into()); }
+            let action = arguments["action"].as_str().ok_or("package_action_required")?;
+            if !["enable", "disable", "reset", "save-defaults"].contains(&action) { return Err("package_action_requires_confirmation".into()); }
+            let preview = runtime.preview_configuration(arguments.clone()).map_err(|e| e.to_string())?;
+            runtime.apply_configuration(&preview.control)
+        }
+        _ => return Err("configuration_action_invalid".into()),
+    }.map_err(|e| e.to_string())?;
+    drop(runtime);
+    if matches!(action, "write" | "package") {
+        if let Ok(mut runtime) = core.runtime.lock() {
+            runtime.turn_boundary(&|| true);
+        }
+        republish(&core);
+    }
+    Ok(result)
+}
+
+pub fn terminal_package_preview(
+    owner: &str,
+    arguments: Value,
+) -> Result<codex_omd::package_controls::PackagePreview, String> {
+    let owner = codex_protocol::turn_input::TerminalOwner(
+        owner.parse().map_err(|_| "terminal_owner_invalid")?,
+    );
+    let mods = for_owner(&owner).ok_or("terminal_owner_unavailable")?;
+    if !arguments["expected_generation"].is_u64() {
+        return Err("expected_generation_required".into());
+    }
+    if codex_omd::package_controls::target(
+        arguments["target"].as_str(),
+        arguments["action"].as_str().unwrap_or_default(),
+    ) != "terminal"
+        || !matches!(
+            arguments["action"].as_str(),
+            Some("enable" | "disable" | "reset" | "save-defaults")
+        )
+    {
+        return Err("package_action_requires_local_terminal".into());
+    }
+    mods.input_runtime
+        .lock()
+        .map_err(|_| "mod_runtime_poisoned")?
+        .preview_configuration(arguments)
+        .map_err(|e| e.to_string())
+}
+
+pub fn terminal_package_protective(owner: &str, id: &str) -> bool {
+    owner
+        .parse()
+        .ok()
+        .and_then(|owner| for_owner(&codex_protocol::turn_input::TerminalOwner(owner)))
+        .and_then(|mods| Some(mods.input_runtime.lock().ok()?.protective(id)))
+        .unwrap_or(true)
+}
+
+pub fn terminal_package_apply(
+    owner: &str,
+    control: &codex_omd::package_controls::PackageControl,
+) -> Result<Value, String> {
+    let owner = codex_protocol::turn_input::TerminalOwner(
+        owner.parse().map_err(|_| "terminal_owner_invalid")?,
+    );
+    let mods = for_owner(&owner).ok_or("terminal_owner_unavailable")?;
+    let mut runtime = mods
+        .input_runtime
+        .lock()
+        .map_err(|_| "mod_runtime_poisoned")?;
+    runtime
+        .apply_configuration(control)
+        .map_err(|e| e.to_string())
+}
+
+pub(crate) fn request_runtime(
+    store: &codex_extension_api::ExtensionData,
+) -> Result<Option<crate::accounting::RuntimeBinding>, String> {
+    if store
+        .get::<codex_protocol::turn_input::TerminalOwner>()
+        .is_none()
+    {
+        return Ok(None);
+    }
+    let mods = for_store(store).ok_or("terminal_owner_unavailable")?;
+    Ok(Some(crate::accounting::RuntimeBinding {
+        terminal_owner: mods.terminal_owner.clone(),
+        runtime: mods.runtime.clone(),
+        required: mods.runtime_required.clone(),
+    }))
+}
+
+pub(super) fn hold_native_owner(
+    owner: &codex_protocol::turn_input::TerminalOwner,
+    thread: Option<&str>,
+) -> Result<(Arc<Mods>, bool), String> {
+    let key = owner.0.to_string();
+    let mut holders = NATIVE_HOLDERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let first = !holders.iter().any(|(held, _)| held == &key);
+    let mods = ensure_owner(owner)?;
+    if let Some(thread) = thread {
+        holders.insert((key, thread.to_owned()));
+    }
+    Ok((mods, first))
+}
+
+pub(super) fn running_owner(
+    owner: &codex_protocol::turn_input::TerminalOwner,
+    thread_store: &ExtensionData,
+) -> Result<Arc<Mods>, String> {
+    if thread_store
+        .get::<codex_extension_api::ThreadOwnedTerminal>()
+        .is_some()
+    {
+        return for_owner(owner).ok_or_else(|| "terminal_owner_released".into());
+    }
+    ensure_owner(owner)
+}
+
+pub(super) fn release_native_owner(
+    owner: &codex_protocol::turn_input::TerminalOwner,
+    thread: Option<&str>,
+) {
+    let key = owner.0.to_string();
+    let mut holders = NATIVE_HOLDERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    holders.retain(|(held, holder)| held != &key || thread.is_some_and(|thread| thread != holder));
+    if holders.iter().any(|(held, _)| held == &key) {
+        return;
+    }
+    let mut owners = OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let clients = CLIENT_OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let removed = (!clients.values().any(|value| value == &key))
+        .then(|| owners.remove(&key))
+        .flatten();
+    drop((clients, owners, holders));
+    drop(removed);
+}
+
+pub fn release_owner(owner: codex_protocol::turn_input::TerminalOwner) {
+    let key = owner.0.to_string();
+    let released = OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .remove(&key);
+    CLIENT_OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .retain(|_, value| value != &key);
+    drop(released);
+}
+
+pub fn bind(client: &str, owner: codex_protocol::turn_input::TerminalOwner) -> Result<(), String> {
+    let key = owner.0.to_string();
+    let mut owners = OWNERS.lock().map_err(|_| "terminal_owner_poisoned")?;
+    if !owners.contains_key(&key)
+        && let Ok(base) = core()
+    {
+        let runtime_owner = codex_omd::terminal_configuration_owner(&key);
+        owners.insert(
+            key.clone(),
+            create_owner(base.host.clone(), runtime_owner, Some(key.clone()))?,
+        );
+    }
+    if let Some(owner) = owners.get(&key) {
+        SESSION_OWNERS
+            .lock()
+            .map_err(|_| "terminal_owner_poisoned")?
+            .insert(key.clone(), Arc::downgrade(owner));
+    }
+    CLIENT_OWNERS
+        .lock()
+        .map_err(|_| "terminal_owner_poisoned")?
+        .insert(client.into(), key);
+    Ok(())
+}
+
+pub(super) fn ensure_owner(
+    owner: &codex_protocol::turn_input::TerminalOwner,
+) -> Result<Arc<Mods>, String> {
+    let key = owner.0.to_string();
+    let mut owners = OWNERS.lock().map_err(|_| "terminal_owner_poisoned")?;
+    if let Some(mods) = owners.get(&key) {
+        return Ok(mods.clone());
+    }
+    let base = core()?;
+    let mods = create_owner(
+        base.host.clone(),
+        codex_omd::terminal_configuration_owner(&key),
+        Some(key.clone()),
+    )?;
+    {
+        let mut sessions = SESSION_OWNERS
+            .lock()
+            .map_err(|_| "terminal_owner_poisoned")?;
+        sessions.retain(|_, owner| owner.strong_count() > 0);
+        sessions.insert(key.clone(), Arc::downgrade(&mods));
+    }
+    owners.insert(key, mods.clone());
+    Ok(mods)
+}
+
+pub(super) fn for_owner(owner: &codex_protocol::turn_input::TerminalOwner) -> Option<Arc<Mods>> {
+    OWNERS.lock().ok()?.get(&owner.0.to_string()).cloned()
+}
+
+pub(super) fn session_owner(
+    owner: &codex_protocol::turn_input::TerminalOwner,
+) -> Option<Arc<Mods>> {
+    for_owner(owner).or_else(|| {
+        SESSION_OWNERS
+            .lock()
+            .ok()?
+            .get(&owner.0.to_string())?
+            .upgrade()
+    })
+}
+
+pub(super) fn for_store(store: &codex_extension_api::ExtensionData) -> Option<Arc<Mods>> {
+    if let Some(owner) = store.get::<Mods>() {
+        return Some(owner);
+    }
+    for_owner(
+        store
+            .get::<codex_protocol::turn_input::TerminalOwner>()?
+            .as_ref(),
+    )
+}
+
+pub(super) fn client_facts(owner: Option<&str>) -> Value {
+    let Some(owner) = owner else {
+        return codex_omd::client_surface::client();
+    };
+    let bound = CLIENT_OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone();
+    codex_omd::client_surface::client_of(|client| bound.get(client).is_some_and(|key| key == owner))
+}
+
+fn client_core(client: &str) -> Result<Arc<Core>, String> {
+    let key = CLIENT_OWNERS
+        .lock()
+        .map_err(|_| "terminal_owner_poisoned")?
+        .get(client)
+        .cloned()
+        .ok_or("terminal_owner_missing")?;
+    let owner = codex_protocol::turn_input::TerminalOwner(
+        key.parse().map_err(|_| "terminal_owner_invalid")?,
+    );
+    ensure_owner(&owner).map(|mods| mods.core.clone())
+}
+
+pub async fn select_thread(
+    owner: codex_protocol::turn_input::TerminalOwner,
+    thread: &str,
+) -> Result<(), String> {
+    let Ok(base) = core() else {
+        return Ok(());
+    };
+    let thread = ThreadId::from_string(thread).map_err(|error| error.to_string())?;
+    let sources: Vec<_> = OWNERS
+        .lock()
+        .map_err(|_| "terminal_owner_poisoned")?
+        .values()
+        .map(|mods| mods.core.clone())
+        .chain(std::iter::once(base))
+        .collect();
+    let lead = sources
+        .iter()
+        .find_map(|core| core.expansion.thread(thread))
+        .ok_or("session_unavailable")?;
+    let target = ensure_owner(&owner)?;
+    let owns = target.expansion.thread(thread).is_some();
+    let changed = target
+        .expansion
+        .current()
+        .is_none_or(|current| current.thread != thread);
+    let first = owns
+        && target
+            .initialized_threads
+            .lock()
+            .map_err(|_| "terminal_owner_poisoned")?
+            .insert(thread.to_string());
+    target.expansion.select_thread(&target.core, &lead);
+    target
+        .sessions
+        .lock()
+        .map_err(|_| "terminal_owner_poisoned")?
+        .insert(thread.to_string(), Arc::downgrade(&lead.session));
+    if changed || first {
+        let store = ExtensionData::new(thread.to_string());
+        store.insert(lead.clone());
+        store.insert_arc(target.clone());
+        target.views.start_thread(&store);
+    }
+    if first {
+        target
+            .event(
+                "session",
+                json!({"phase":"start","thread_id":thread.to_string()}),
+                None,
+            )
+            .await;
+        target.event("start", Value::Null, Some(&lead)).await;
+        peering::start(&target.core, thread);
+    }
+    if changed {
+        target
+            .views
+            .presentation(&thread.to_string(), Some("resumed"));
+    }
+    if changed && owns {
+        target
+            .event(
+                "session",
+                json!({"phase":"resume","thread_id":thread.to_string()}),
+                None,
+            )
+            .await;
+        let payload = expansion::resume_payload(&target.core, &lead).await;
+        target.event("resume", payload, Some(&lead)).await;
+    }
+    Ok(())
+}
+
+pub(super) fn cores_for_thread(thread: ThreadId) -> Vec<Arc<Core>> {
+    OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .values()
+        .filter(|owner| owner.expansion.thread(thread).is_some())
+        .map(|owner| owner.core.clone())
+        .collect()
+}
