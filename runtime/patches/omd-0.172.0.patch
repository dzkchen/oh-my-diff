+use super::prepend_status_prefix;
+use crate::bottom_pane::StatusLine;
+use crate::bottom_pane::StatusLineFocus;
+use crate::terminal_hyperlinks::HyperlinkLine;
+use crate::ui_tree::UiNode;
+use crate::ui_tree::UiTree;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Modifier;
+use ratatui::style::Stylize;
+
+#[test]
+fn status_prefix_shifts_link_columns() {
+    let url = "https://example.com/pr/42";
+    let mut line = HyperlinkLine::from("main · ");
+    line.push_span("PR #42".into(), Some(url));
+    assert_eq!(
+        prepend_status_prefix(Vec::new(), Some(line.clone())),
+        Some(line.clone())
+    );
+    let line = prepend_status_prefix(vec!["OMD".bold()], Some(line)).unwrap();
+    assert_eq!(line.line.to_string(), "OMD · main · PR #42");
+    assert_eq!(line.hyperlinks[0].columns, 13..19);
+    assert_eq!(line.hyperlinks[0].destination, url);
+}
+
+#[test]
+fn status_prefix_leads_an_extension_status_line() {
+    let tree = UiTree(Some(UiNode::String("main · PR #42".into())));
+    let status = StatusLine::prefixed(tree, vec!["OMD".bold(), " · ".dim()].into());
+    let area = Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 24, /*height*/ 1,
+    );
+    assert_eq!(status.height(area.as_size()), 1);
+    let mut buf = Buffer::empty(area);
+    status.render(area, &mut buf, StatusLineFocus::Focused);
+    let text = (0..19).map(|x| buf[(x, 0)].symbol()).collect::<String>();
+    assert_eq!(text, "OMD · main · PR #42");
+    assert!(buf[(0, 0)].modifier.contains(Modifier::BOLD));
+}
diff --git a/codex-rs/tui/src/history_cell/tool_run.rs b/codex-rs/tui/src/history_cell/tool_run.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4e3a98dbc4e5cd87ef9320df264670db147c07e3
--- /dev/null
+++ b/codex-rs/tui/src/history_cell/tool_run.rs
@@ -0,0 +1,350 @@
+//! Adjacent agent tool calls between two messages, kept as one cell a render hook can draw as a run.
+//! Without a hook each member draws natively, in order, as separate cells would.
+
+use super::*;
+use std::sync::Arc;
+
+const RUN_STEPS: usize = 64;
+
+#[derive(Debug)]
+pub(crate) struct ToolRunCell {
+    pub(crate) group: ActivityGroup<Arc<dyn HistoryCell>>,
+}
+
+/// Agent tool activity joins a run; user shell commands and all other content end it.
+pub(crate) fn is_tool_member(cell: &dyn HistoryCell) -> bool {
+    cell.as_any().is::<ComputerActivityCell>()
+        || cell.render_target().is_some_and(|target| {
+            target.component == "tool_call"
+                && target.props["kind"] != "run"
+                && target.props["user_shell"] != true
+        })
+}
+
+/// Folds adjacent tool cells, and hidden reasoning between them, into runs as live grouping does.
+pub(crate) fn group_tool_runs(cells: Vec<Arc<dyn HistoryCell>>) -> Vec<Arc<dyn HistoryCell>> {
+    let mut out: Vec<Arc<dyn HistoryCell>> = Vec::new();
+    let mut run: Option<ToolRunCell> = None;
+    for cell in cells {
+        if is_tool_member(cell.as_ref()) {
+            match &mut run {
+                Some(run) => run.push(cell),
+                None => run = Some(ToolRunCell::new(cell)),
+            }
+        } else if let Some(group) = &mut run
+            && crate::thread_transcript::is_hidden_activity_detail(&cell)
+        {
+            group.group.push_detail(cell);
+        } else {
+            if let Some(run) = run.take() {
+                out.push(Arc::new(run));
+            }
+            out.push(cell);
+        }
+    }
+    if let Some(run) = run {
+        out.push(Arc::new(run));
+    }
+    out
+}
+
+impl ToolRunCell {
+    pub(crate) fn new(first: Arc<dyn HistoryCell>) -> Self {
+        Self {
+            group: ActivityGroup::new(vec![first]),
+        }
+    }
+
+    pub(crate) fn push(&mut self, cell: Arc<dyn HistoryCell>) {
+        self.group.calls.push(cell);
+    }
+
+    pub(crate) fn last(&self) -> Option<&dyn HistoryCell> {
+        self.group.calls.last().map(Arc::as_ref)
+    }
+
+    pub(crate) fn last_mut(&mut self) -> Option<&mut dyn HistoryCell> {
+        Arc::get_mut(self.group.calls.last_mut()?)
+    }
+
+    pub(crate) fn members(&self) -> impl DoubleEndedIterator<Item = &dyn HistoryCell> {
+        self.group.calls.iter().map(Arc::as_ref)
+    }
+
+    pub(crate) fn members_mut(&mut self) -> impl DoubleEndedIterator<Item = &mut dyn HistoryCell> {
+        self.group.calls.iter_mut().filter_map(Arc::get_mut)
+    }
+
+    /// The member carrying `activity_id`, for replacing it in place.
+    pub(crate) fn position(&self, activity_id: &str) -> Option<usize> {
+        self.group
+            .calls
+            .iter()
+            .rposition(|member| member.activity_ids().iter().any(|id| id == activity_id))
+    }
+
+    pub(crate) fn remove(&mut self, index: usize) {
+        self.group.calls.remove(index);
+        self.group.details.remove_call(index);
+    }
+
+    /// The run's cells with the member carrying `activity_id` replaced by `cell`, which isn't a step.
+    pub(crate) fn split_around(
+        &self,
+        activity_id: &str,
+        cell: Arc<dyn HistoryCell>,
+    ) -> Option<Vec<Arc<dyn HistoryCell>>> {
+        let index = self.position(activity_id)?;
+        let (before, after) = self.group.details.split_around(index);
+        let part = |calls: &[Arc<dyn HistoryCell>], details| {
+            (!calls.is_empty()).then(|| {
+                Arc::new(Self {
+                    group: ActivityGroup {
+                        calls: calls.to_vec(),
+                        details,
+                    },
+                }) as Arc<dyn HistoryCell>
+            })
+        };
+        let first = part(&self.group.calls[..index], before);
+        let last = part(&self.group.calls[index + 1..], after);
+        Some(first.into_iter().chain([cell]).chain(last).collect())
+    }
+
+    /// A copy with the member carrying `activity_id` replaced, for runs already in history.
+    pub(crate) fn with_member(
+        &self,
+        activity_id: &str,
+        cell: Arc<dyn HistoryCell>,
+    ) -> Option<Self> {
+        let index = self.position(activity_id)?;
+        let mut calls = self.group.calls.clone();
+        calls[index] = cell;
+        Some(Self {
+            group: ActivityGroup {
+                calls,
+                details: self.group.details.clone(),
+            },
+        })
+    }
+
+    pub(crate) fn is_active(&self) -> bool {
+        self.steps()
+            .iter()
+            .any(|step| step.target.props["status"] == "running")
+    }
+
+    fn id(&self) -> String {
+        let first = self
+            .group
+            .calls
+            .first()
+            .and_then(|cell| cell.activity_ids().into_iter().next())
+            .unwrap_or_default();
+        format!("run:{first}")
+    }
+
+    /// One member per tool call, exploration groups included, in call order.
+    fn steps(&self) -> Vec<RenderMember<'_>> {
+        self.group
+            .calls
+            .iter()
+            .enumerate()
+            .flat_map(|(index, cell)| {
+                let mut members = match cell.as_any().downcast_ref::<crate::exec_cell::ExecCell>() {
+                    Some(exec) => exec.call_members(),
+                    None => cell.render_members(u16::MAX),
+                };
+                if members.is_empty() {
+                    members.extend(Self::target_member(cell));
+                }
+                // Details folded in after this cell open with its last step.
+                if let Some(last) = members.last_mut() {
+                    let native = std::mem::replace(&mut last.native, Box::new(|_, _| Vec::new()));
+                    let details = &self.group.details;
+                    last.native = Box::new(move |width, expanded| {
+                        let mut lines = native(width, expanded);
+                        if expanded {
+                            lines.extend(details.lines_after(
+                                index + 1,
+                                width,
+                                HistoryRenderMode::Rich,
+                            ));
+                        }
+                        lines
+                    });
+                }
+                members
+            })
+            .collect()
+    }
+
+    fn target_member(cell: &Arc<dyn HistoryCell>) -> Option<RenderMember<'_>> {
+        cell.render_target().map(|target| RenderMember {
+            id: cell
+                .activity_ids()
+                .into_iter()
+                .next()
+                .unwrap_or_else(|| target.id.clone()),
+            target,
+            native: Box::new(move |width, expanded| {
+                if expanded {
+                    cell.expanded_hyperlink_lines(width)
+                } else {
+                    cell.display_hyperlink_lines(width)
+                }
+            }),
+        })
+    }
+
+    fn joined(
+        &self,
+        details: Option<(u16, HistoryRenderMode)>,
+        draw: impl Fn(&dyn HistoryCell) -> Vec<HyperlinkLine>,
+    ) -> Vec<HyperlinkLine> {
+        let mut out = Vec::new();
+        for (index, cell) in self.group.calls.iter().enumerate() {
+            let lines = draw(cell.as_ref());
+            if !lines.is_empty() {
+                if !out.is_empty() {
+                    out.push(HyperlinkLine::from(""));
+                }
+                out.extend(lines);
+            }
+            if let Some((width, mode)) = details {
+                out.extend(self.group.details.lines_after(index + 1, width, mode));
+            }
+        }
+        out
+    }
+}
+
+impl HistoryCell for ToolRunCell {
+    fn render_members(&self, _width: u16) -> Vec<RenderMember<'_>> {
+        self.steps()
+    }
+
+    fn render_target(&self) -> Option<crate::mod_render::RenderTarget> {
+        let steps = self.steps();
+        let has = |status: &str| {
+            steps
+                .iter()
+                .any(|step| step.target.props["status"] == status)
+        };
+        let running = has("running");
+        let status = if running {
+            "running"
+        } else if has("failed") {
+            "failed"
+        } else if has("interrupted") {
+            "interrupted"
+        } else {
+            "completed"
+        };
+        let duration = (!running).then(|| {
+            steps
+                .iter()
+                .filter_map(|step| step.target.props["duration_ms"].as_u64())
+                .sum::<u64>()
+        });
+        let call_id = steps.first()?.target.props["call_id"].clone();
+        let call_count = steps.len();
+        let calls = steps
+            .into_iter()
+            .skip(call_count.saturating_sub(RUN_STEPS))
+            .map(|step| {
+                let mut props = step.target.props;
+                if let Some(props) = props.as_object_mut() {
+                    props.remove("expanded");
+                    props.remove("presentation");
+                }
+                props
+            })
+            .collect::<Vec<_>>();
+        Some(crate::mod_render::RenderTarget::new(
+            "tool_call",
+            self.id(),
+            running,
+            serde_json::json!({"call_id": call_id, "kind": "run", "status": status,
+                "duration_ms": duration, "call_count": call_count, "calls": calls}),
+        ))
+    }
+
+    fn activity_ids(&self) -> Vec<String> {
+        std::iter::once(self.id())
+            .chain(self.group.calls.iter().flat_map(|cell| cell.activity_ids()))
+            .collect()
+    }
+
+    fn tool_call_labels(&self) -> Vec<String> {
+        self.group
+            .calls
+            .iter()
+            .flat_map(|cell| cell.tool_call_labels())
+            .collect()
+    }
+
+    fn append_reasoning(&mut self, cell: Box<dyn HistoryCell>) -> Result<(), Box<dyn HistoryCell>> {
+        self.group.push_detail(Arc::from(cell));
+        Ok(())
+    }
+
+    fn display_lines(&self, width: u16) -> Vec<Line<'static>> {
+        visible_lines(self.display_hyperlink_lines(width))
+    }
+
+    fn display_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.joined(None, |cell| cell.display_hyperlink_lines(width))
+    }
+
+    fn compact_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.joined(None, |cell| cell.compact_hyperlink_lines(width))
+    }
+
+    fn expanded_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.joined(Some((width, HistoryRenderMode::Rich)), |cell| {
+            cell.expanded_hyperlink_lines(width)
+        })
+    }
+
+    fn transcript_lines(&self, width: u16) -> Vec<Line<'static>> {
+        visible_lines(self.transcript_hyperlink_lines(width))
+    }
+
+    fn transcript_hyperlink_lines(&self, width: u16) -> Vec<HyperlinkLine> {
+        self.joined(Some((width, HistoryRenderMode::Rich)), |cell| {
+            cell.transcript_hyperlink_lines(width)
+        })
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        visible_lines(
+            self.joined(Some((u16::MAX, HistoryRenderMode::Raw)), |cell| {
+                plain_hyperlink_lines(cell.raw_lines())
+            }),
+        )
+    }
+
+    fn live_raw_lines(&self) -> Vec<Line<'static>> {
+        visible_lines(self.joined(None, |cell| plain_hyperlink_lines(cell.live_raw_lines())))
+    }
+
+    fn has_stable_transcript_height(&self) -> bool {
+        self.group
+            .calls
+            .iter()
+            .all(|cell| cell.has_stable_transcript_height())
+    }
+
+    fn transcript_animation_tick(&self) -> Option<u64> {
+        self.group
+            .calls
+            .iter()
+            .filter_map(|cell| cell.transcript_animation_tick())
+            .max()
+    }
+}
+
+#[cfg(test)]
+#[path = "tool_run_tests.rs"]
+mod tests;
