+async fn channel_events_reach_subscribers_in_order() {
+    let Some(fixture) = fixture(&[
+        Package {
+            id: "herald",
+            capabilities: &["events"],
+            manifest: Value::Null,
+            source: "export default function () {}\n",
+        },
