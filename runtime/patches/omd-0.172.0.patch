+        &input
+    ));
+    assert!(!valid_send_result(
+        &edits(vec![edit("/a", 0, 1)]),
+        &inner,
+        &input
+    ));
+    assert!(!valid_send_result(
+        &edits(vec![edit("/a", 2, 3)]),
+        &none,
+        &input
+    ));
+    assert!(!valid_send_result(
+        &edits(vec![edit("/a", 4, 12)]),
+        &none,
+        &input
+    ));
+    assert!(!valid_send_result(
+        &edits(vec![edit("/a", 0, 6), edit("/a", 5, 7)]),
+        &none,
+        &input
+    ));
+    assert!(!valid_send_result(
