+#[derive(Clone, Debug, Serialize)]
+pub struct ClientEntry {
+    pub id: String,
+    pub name: String,
+    pub renderer: Value,
+    pub viewport: Value,
+    pub operations: Vec<String>,
+    pub attached_ms: u64,
+    pub focused: bool,
+    #[serde(skip)]
+    pub terminal: Value,
+}
+
+#[derive(Clone, Debug)]
+pub enum Observed {
+    Redraw,
+    Roster,
+    Client,
+    Mirrored {
+        terminal_owner: Option<String>,
+        caller: String,
+        operation: String,
+        arguments: Value,
+        pixels: Option<Arc<crate::process_raster::PixelFrame>>,
+    },
+    State {
+        mod_id: String,
+        terminal: u64,
+    },
+}
