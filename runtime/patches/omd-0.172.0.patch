+struct Delivery {
+    task: tokio::task::JoinHandle<()>,
+    _wake: codex_omd::client_surface::Registration,
+    _activity: codex_omd::turn_activity::ReaderRegistration,
+}
+
+impl Drop for Delivery {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
