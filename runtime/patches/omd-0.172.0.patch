+        }
+        [command, root, request] if command == "package-plan" => open(root)?
+            .package_plan(serde_json::from_str::<ModInstallRequest>(request)?)
+            .and_then(json),
+        [command, root, request, confirmation] if command == "package-apply" => open(root)?
+            .package_apply(
