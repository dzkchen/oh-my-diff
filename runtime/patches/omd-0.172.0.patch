+            json!(count),
+            ModInvokeOptions {
+                host: ModHostCallback::Own(&mut |call| {
+                    assert_eq!(call.operation, "events.schedule");
+                    timer = call.arguments;
+                    Ok(json!({"key":timer["key"],"delay_ms":timer["delay_ms"]}))
+                }),
+                ..ModInvokeOptions::default()
+            },
+        )
+        .unwrap();
+        native
+            .invoke(
+                "jobs",
+                native.generation(),
+                "timer",
+                "",
+                json!({"key":timer["key"],"data":timer["data"]}),
+                ModInvokeOptions::default(),
+            )
+            .unwrap();
+        let status = ui
+            .invoke(
+                "jobs",
+                ui.generation(),
+                "command",
+                "status",
+                Value::Null,
+                ModInvokeOptions::default(),
+            )
+            .unwrap();
+        assert_eq!(status["status"], "completed");
+        assert_eq!(status["result"], json!({"input":count,"calls":count}));
+    }
+    std::thread::scope(|scope| {
+        let (scheduled, delivered) = std::sync::mpsc::channel();
+        let (release, released) = std::sync::mpsc::channel();
+        let ui = &mut ui;
+        let command = scope.spawn(move || {
+            let _thread = codex_omd::StateThread::enter(Some("jobs-thread".into()));
+            ui.invoke("jobs", ui.generation(), "command", "start", json!(3), ModInvokeOptions { host: ModHostCallback::Own(&mut |call| {
+                    scheduled.send(call.arguments.clone()).unwrap();
+                    released
+                        .recv_timeout(std::time::Duration::from_secs(5))
+                        .unwrap();
+                    Ok(json!({"key":call.arguments["key"], "delay_ms":call.arguments["delay_ms"]}))
+                }), ..ModInvokeOptions::default() })
+            .unwrap();
+        });
+        let timer = delivered
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        let (waiting, waited) = std::sync::mpsc::channel();
+        let native = &mut native;
+        let delivery = scope.spawn(move || {
+            let _thread = codex_omd::StateThread::enter(Some("jobs-thread".into()));
+            let checks = AtomicUsize::new(0);
+            native
+                .invoke(
+                    "jobs",
+                    native.generation(),
+                    "timer",
+                    "",
+                    json!({"key":timer["key"],"data":timer["data"]}),
+                    ModInvokeOptions {
+                        active: &|| {
+                            if checks.fetch_add(1, Ordering::Relaxed) == 1 {
+                                waiting.send(()).unwrap();
+                            }
+                            true
+                        },
+                        ..ModInvokeOptions::default()
+                    },
+                )
+                .unwrap();
+        });
+        waited
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        release.send(()).unwrap();
+        command.join().unwrap();
+        delivery.join().unwrap();
+    });
+    assert_eq!(
+        ui.invoke(
+            "jobs",
+            ui.generation(),
+            "command",
+            "status",
+            Value::Null,
+            ModInvokeOptions::default()
+        )
+        .unwrap()["result"],
+        json!({"input":3,"calls":3})
+    );
+    std::thread::scope(|scope| {
+        let (scheduled, delivered) = std::sync::mpsc::channel();
+        let (release, released) = std::sync::mpsc::channel();
+        let ui = &mut ui;
+        let command = scope.spawn(move || {
+            let _thread = codex_omd::StateThread::enter(Some("jobs-thread".into()));
+            ui.invoke("jobs", ui.generation(), "command", "start", json!(4), ModInvokeOptions { host: ModHostCallback::Own(&mut |call| {
+                    scheduled.send(()).unwrap();
+                    released
+                        .recv_timeout(std::time::Duration::from_secs(5))
+                        .unwrap();
+                    Ok(json!({"key":call.arguments["key"],"delay_ms":call.arguments["delay_ms"]}))
+                }), ..ModInvokeOptions::default() })
+        });
+        delivered
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .unwrap();
+        native.reload().unwrap();
+        release.send(()).unwrap();
+        assert!(
+            command
+                .join()
+                .unwrap()
+                .unwrap_err()
+                .to_string()
+                .contains("callback_cancelled")
+        );
+    });
+    ui.reload().unwrap();
+    assert_eq!(
+        ui.invoke(
+            "jobs",
+            ui.generation(),
+            "command",
+            "status",
+            Value::Null,
+            ModInvokeOptions::default()
+        )
+        .unwrap()["status"],
+        "idle"
+    );
+    let mut old_timer = Value::Null;
+    ui.invoke(
+        "jobs",
+        ui.generation(),
+        "command",
+        "start",
+        json!("stale"),
+        ModInvokeOptions {
+            host: ModHostCallback::Own(&mut |call| {
+                old_timer = call.arguments;
+                Ok(json!({"key":old_timer["key"],"delay_ms":old_timer["delay_ms"]}))
+            }),
+            ..ModInvokeOptions::default()
+        },
+    )
+    .unwrap();
+    ui.reload().unwrap();
+    let mut current_timer = Value::Null;
+    ui.invoke(
+        "jobs",
+        ui.generation(),
+        "command",
+        "start",
+        json!("current"),
+        ModInvokeOptions {
+            host: ModHostCallback::Own(&mut |call| {
+                current_timer = call.arguments;
+                Ok(json!({"key":current_timer["key"],"delay_ms":current_timer["delay_ms"]}))
+            }),
+            ..ModInvokeOptions::default()
+        },
+    )
+    .unwrap();
+    native
+        .invoke(
+            "jobs",
+            native.generation(),
+            "timer",
+            "",
+            json!({"key":old_timer["key"],"data":old_timer["data"]}),
+            ModInvokeOptions::default(),
+        )
+        .unwrap();
+    assert_eq!(
+        ui.invoke(
+            "jobs",
+            ui.generation(),
+            "command",
+            "status",
+            Value::Null,
+            ModInvokeOptions::default()
+        )
+        .unwrap()["status"],
+        "pending"
+    );
+    native
+        .invoke(
+            "jobs",
+            native.generation(),
+            "timer",
+            "",
+            json!({"key":current_timer["key"],"data":current_timer["data"]}),
+            ModInvokeOptions::default(),
+        )
+        .unwrap();
+    assert_eq!(
+        ui.invoke(
+            "jobs",
+            ui.generation(),
+            "command",
+            "status",
+            Value::Null,
+            ModInvokeOptions::default()
+        )
+        .unwrap()["result"],
+        json!({"input":"current","calls":1})
+    );
+    ui.release_thread_activations("jobs-thread");
+}
