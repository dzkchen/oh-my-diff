+#[test]
+fn a_process_sweeps_a_directory_first_then_every_sixteen_writes_or_large_bytes() {
+    let directory = tempfile::tempdir().unwrap();
+    let due = |bytes| prune_due(directory.path(), bytes);
+    assert!(due(1));
+    assert_eq!(
+        (0..16).map(|_| due(1)).collect::<Vec<_>>(),
