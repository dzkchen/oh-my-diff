+crate::omd::isolated_static! { ENGINE: Mutex<Option<Engine>> = Mutex::new(None) }
+crate::omd::isolated_static! { HOOKED: AtomicBool = AtomicBool::new(false) }
+crate::omd::isolated_static! { FULLSCREEN: AtomicBool = AtomicBool::new(false) }
+crate::omd::isolated_static! { COLUMNS: AtomicU16 = AtomicU16::new(0) }
+crate::omd::isolated_static! { ROWS: AtomicU16 = AtomicU16::new(0) }
+crate::omd::isolated_static! { EPOCH: AtomicU64 = AtomicU64::new(0) }
+crate::omd::isolated_static! { LIVE_EPOCH: AtomicU64 = AtomicU64::new(0) }
+crate::omd::isolated_static! { FRAMES: Mutex<Option<crate::tui::FrameRequester>> = Mutex::new(None) }
+crate::omd::isolated_static! { TOOL_NOTICES: Mutex<VecDeque<ToolNotice>> = Mutex::new(VecDeque::new()) }
+crate::omd::isolated_static! { DRAWN_CALLS: Mutex<std::collections::BTreeSet<String>> =
+Mutex::new(std::collections::BTreeSet::new()) }
+crate::omd::isolated_static! { REFRESHES: AtomicU64 = AtomicU64::new(0) }
