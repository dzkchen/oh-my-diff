+fn terminal_owner_native_admission_preserves_explicit_owners_and_rejects_mismatch() {
+    use codex_protocol::turn_input::TerminalOwner;
+    let supplied = TerminalOwner(uuid::Uuid::new_v4());
+    for supplied_to_thread in [true, false] {
+        let mut thread = ExtensionDataInit::default();
+        let mut turn = ExtensionDataInit::default();
+        if supplied_to_thread {
+            thread.insert(supplied.clone());
+        } else {
+            turn.insert(supplied.clone());
+        }
+        admit_terminal_owner(&mut thread, &mut turn).unwrap();
+        assert_eq!(thread.get::<TerminalOwner>().as_deref(), Some(&supplied));
+        assert_eq!(turn.get::<TerminalOwner>().as_deref(), Some(&supplied));
+        assert!(
+            thread
+                .get::<codex_extension_api::ThreadOwnedTerminal>()
+                .is_none()
+        );
+    }
+    let mut thread = ExtensionDataInit::default();
+    let mut turn = ExtensionDataInit::default();
+    admit_terminal_owner(&mut thread, &mut turn).unwrap();
+    assert_eq!(thread.get::<TerminalOwner>(), turn.get::<TerminalOwner>());
+    assert!(
+        thread
+            .get::<codex_extension_api::ThreadOwnedTerminal>()
+            .is_some()
+    );
+    turn.insert(supplied);
+    assert!(admit_terminal_owner(&mut thread, &mut turn).is_err());
