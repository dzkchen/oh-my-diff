+#[cfg(test)]
+thread_local! {
+    static TEST_HOOK: std::cell::RefCell<Option<TestHook>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Answers every render on this thread synchronously with `hook`'s tree, `None` passing it on.
+#[cfg(test)]
+pub(crate) fn test_hook(hook: impl Fn(&RenderTarget) -> Option<Value> + 'static) -> impl Drop {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            TEST_HOOK.with(|hook| hook.borrow_mut().take());
+            HOOKED.with(|hooked| hooked.store(self.0, Ordering::Relaxed));
+        }
+    }
+    TEST_HOOK.with(|stored| *stored.borrow_mut() = Some(Box::new(hook)));
+    Restore(HOOKED.with(|hooked| hooked.swap(true, Ordering::Relaxed)))
+}
