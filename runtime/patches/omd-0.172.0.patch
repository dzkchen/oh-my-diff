+            id: "patch-declined".into(),
+            changes: vec![FileUpdateChange {
+                path: "declined.txt".into(),
+                kind: PatchChangeKind::Add,
+                diff: "hello\n".into(),
+            }],
+            status: AppServerPatchApplyStatus::InProgress,
+        };
+        chat.handle_server_notification(
+            ServerNotification::ItemStarted(ItemStartedNotification::new(
+                "thread-1".into(),
+                "turn-1".into(),
+                started.clone(),
+                0,
+            )),
+            None,
+        );
+        assert!(drain_insert_history(&mut rx).is_empty());
+        if flush != "immediate" {
+            chat.interrupts.push_item_started(started.clone());
+        }
+        let AppServerThreadItemPayload::FileChange { id, changes, .. } = started else {
+            unreachable!()
+        };
+        let declined = AppServerThreadItemPayload::FileChange {
+            id,
+            changes,
+            status: AppServerPatchApplyStatus::Declined,
+        };
+        chat.handle_server_notification(
+            ServerNotification::ItemCompleted(ItemCompletedNotification::new(
+                "thread-1".into(),
+                "turn-1".into(),
+                declined.clone(),
+                Some(0),
+                73,
+            )),
+            None,
+        );
+        if flush != "immediate" {
+            assert!(drain_insert_history(&mut rx).is_empty());
+            let mut queue = std::mem::take(&mut chat.interrupts);
+            if flush == "all" {
+                queue.flush_all(&mut chat);
+            } else {
+                queue.flush_activity(&mut chat);
+            }
+            chat.interrupts = queue;
+        }
+        let live = drain_insert_history(&mut rx);
+        assert_eq!(live.len(), 1, "{flush}: declined patch needs one final row");
+        let live = lines_to_single_string(&live[0]);
+        assert!(live.contains("Patch application declined"), "{live}");
+        chat.replay_thread_item(declined, "turn-1".into(), ReplayKind::ResumeInitialMessages);
+        let replay = drain_insert_history(&mut rx);
+        assert_eq!(replay.len(), 1);
+        assert_eq!(lines_to_single_string(&replay[0]), live, "{flush}");
+    }
