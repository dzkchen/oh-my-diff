+#[tokio::test]
+async fn terminal_owners_are_connection_scoped_and_reconnect_requires_the_capability() {
+    let (sender, _outgoing) = mpsc::channel(8);
+    let clients = OmdClients::new(Arc::new(OutgoingMessageSender::new(
+        sender,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    )));
+    let a = clients.terminal_owner(ConnectionId(1));
+    assert_eq!(a, clients.terminal_owner(ConnectionId(1)));
+    let b = clients.terminal_owner(ConnectionId(2));
+    assert_ne!(a, b);
+    attach(&clients, 1, &["terminal.panel", "terminal.prompt"]);
+    attach(&clients, 2, &["terminal.panel", "terminal.prompt"]);
+    assert_eq!(
+        clients.serving("terminal.panel", Some(&a.0.to_string())),
+        vec![ConnectionId(1)]
+    );
+    assert_eq!(
+        clients.serving("terminal.prompt", Some(&b.0.to_string())),
+        vec![ConnectionId(2)]
+    );
+    assert!(clients.serving("terminal.panel", None).is_empty());
+    let (token, owner, _) = clients.attach_owner(ConnectionId(1), None).unwrap();
+    assert_eq!(owner, a);
+    clients.connection_closed(ConnectionId(1)).await;
+    assert_eq!(
+        clients
+            .attach_owner(ConnectionId(3), Some(&token))
+            .unwrap()
+            .1,
+        a
+    );
+    assert_ne!(clients.attach_owner(ConnectionId(4), None).unwrap().1, a);
+    assert!(
+        clients
+            .attach_owner(ConnectionId(5), Some("unknown"))
+            .is_err()
+    );
+    let anonymous = clients.terminal_owner(ConnectionId(6));
+    clients.connection_closed(ConnectionId(6)).await;
+    assert!(
+        !clients
+            .terminal_owners
+            .lock()
+            .unwrap()
+            .contains_key(&ConnectionId(6))
+    );
+    assert!(
+        !clients
+            .terminal_tokens
+            .lock()
+            .unwrap()
+            .values()
+            .any(|owner| owner == &anonymous)
+    );
+    assert!(
+        clients
+            .terminal_tokens
+            .lock()
+            .unwrap()
+            .values()
+            .any(|owner| owner == &a)
+    );
+    let (unpublished, abandoned, created) = clients.attach_owner(ConnectionId(7), None).unwrap();
+    assert!(created);
+    clients.failed_attach(
+        ConnectionId(7),
+        "abandoned",
+        &unpublished,
+        &abandoned,
+        created,
+    );
+    assert!(
+        !clients
+            .terminal_tokens
+            .lock()
+            .unwrap()
+            .contains_key(&unpublished)
+    );
+    let (reconnected, retained, created) =
+        clients.attach_owner(ConnectionId(8), Some(&token)).unwrap();
+    assert!(!created);
+    clients.failed_attach(
+        ConnectionId(8),
+        "abandoned-reconnect",
+        &reconnected,
+        &retained,
+        created,
+    );
+    assert!(clients.terminal_tokens.lock().unwrap().contains_key(&token));
+}
