+
+#[test]
+fn raw_raster_snapshot_does_not_serialize_other_rasters() {
+    let frames = Arc::new(Frames::default());
+    let now = Instant::now();
+    let copying = frames.clone();
+    let (started, wait) = std::sync::mpsc::channel();
+    let (release, released) = std::sync::mpsc::channel();
+    let copy = std::thread::spawn(move || {
+        copying
+            .admit("copying", now, false, |_| {
+                started.send(()).unwrap();
+                released.recv().unwrap();
+                Ok(())
+            })
+            .unwrap()
+    });
+    wait.recv_timeout(std::time::Duration::from_secs(1))
+        .unwrap();
+    let other = frames;
+    let (sender, receiver) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        sender
+            .send(other.pace("independent".into(), now, false))
+            .unwrap()
+    });
+    let reply = receiver.recv_timeout(std::time::Duration::from_secs(1));
+    release.send(()).unwrap();
+    worker.join().unwrap();
+    copy.join().unwrap();
+    assert_eq!(reply.unwrap()["frame"], 1);
+}
+
+#[test]
+fn cells_sent_before_a_pending_cells_frame_join_it() {
+    let frames = Frames::default();
+    let now = Instant::now();
+    let at = |ms| now + std::time::Duration::from_millis(ms);
+    let reply = |frame: u64, queued: u64| json!({"frame": frame, "queued": queued, "frame_ms": 16});
+    assert_eq!(frames.pace("art".into(), now, true), reply(1, 1));
+    assert_eq!(frames.pace("art".into(), at(5), true), reply(1, 1));
+    assert_eq!(frames.pace("art".into(), at(6), false), reply(2, 1));
+    assert_eq!(frames.pace("art".into(), at(7), true), reply(3, 2));
+    assert_eq!(frames.pace("art".into(), at(8), true), reply(3, 2));
+    assert_eq!(frames.pace("art".into(), at(48), true), reply(4, 1));
+}
+
+fn surface(transport: &mpsc::Sender<TransportEvent>) -> AppServerSurface {
+    let (sender, _outgoing) = mpsc::channel(8);
+    AppServerSurface(Arc::new(Host {
+        clients: OmdClients::new(Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ))),
+        store: PathBuf::from("/nonexistent-store"),
+        repository: PathBuf::from("/nonexistent-repository"),
+        transport: transport.downgrade(),
+        runtime: tokio::runtime::Handle::current(),
+        connection: OnceCell::new(),
+        next: AtomicU64::new(0),
+        frames: Frames::default(),
+    }))
+}
+
+fn call(
+    operation: &str,
+    arguments: Value,
+    confirm: Option<&str>,
+) -> (
+    SurfaceCall,
+    std::sync::mpsc::Receiver<Result<Value, String>>,
+) {
+    let (reply, answer) = std::sync::mpsc::sync_channel(1);
+    let call = SurfaceCall {
+        terminal_user: false,
+        terminal_owner: None,
+        validity: client_surface::Validity(Arc::new(|| true)),
+        authority: None,
+        lifetime: client_surface::CallLifetime::default(),
+        depth: 0,
+        caller: "demo".to_string(),
+        operation: operation.to_string(),
+        arguments,
+        context: InvocationContext::User,
+        remote: false,
+        thread: None,
+        confirm: confirm.map(str::to_owned),
+        reply,
+    };
+    (call, answer)
+}
+
+async fn answer(answer: std::sync::mpsc::Receiver<Result<Value, String>>) -> Result<Value, String> {
+    tokio::task::spawn_blocking(move || answer.recv().unwrap())
+        .await
+        .unwrap()
+}
+
+#[tokio::test]
+async fn user_only_operations_and_consent_are_never_delegated() {
+    let (transport, _events) = mpsc::channel(1);
+    let surface = surface(&transport);
+    for operation in ["config.set", "prompts.consent"] {
+        let (call, _answer) = call(operation, Value::Null, None);
+        assert_eq!(
+            surface.submit(call),
+            Err(format!(
+                "client_surface_operation_unavailable: {operation} needs the terminal (/omd) or omd-mod"
+            ))
+        );
+    }
+    let (mut timer, _answer) = call("terminal.pty", json!({"action": "start"}), None);
+    timer.context = InvocationContext::Event;
+    assert_eq!(
+        surface.submit(timer),
+        Err("host_operation_user_only: terminal.pty start".to_string())
+    );
+}
