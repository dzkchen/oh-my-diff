+    #[expect(
+        clippy::too_many_arguments,
+        reason = "Mirrors the fields of AppEvent::OmdEditSetting"
+    )]
+    pub(crate) fn open_omd_setting(
+        &mut self,
+        id: String,
+        scope: String,
+        name: String,
+        schema: serde_json::Value,
+        current: serde_json::Value,
+        terminal: bool,
+        binding: crate::mod_runtime::ConfigurationBinding,
+    ) {
+        if !crate::mod_runtime::configuration_binding_current(binding) {
+            return;
+        }
+        let kind = setting_type(&schema).unwrap_or("string").to_owned();
+        let selected = format!("{id} · {name}");
+        let choices = schema["enum"].as_array().cloned().or_else(|| {
+            (kind == "boolean").then(|| vec![serde_json::json!(true), serde_json::json!(false)])
+        });
+        if let Some(choices) = choices {
+            let items = choices
+                .into_iter()
+                .map(|value| {
+                    let (id, scope, name) = (id.clone(), scope.clone(), name.clone());
+                    SelectionItem {
+                        name: shown(&value),
+                        actions: vec![Box::new(move |tx| {
+                            tx.send(AppEvent::OmdWriteSetting {
+                                id: id.clone(),
+                                scope: scope.clone(),
+                                name: name.clone(),
+                                value: Some(value.clone()),
+                                terminal,
+                                binding,
+                            })
+                        })],
+                        dismiss_on_select: true,
+                        ..Default::default()
+                    }
+                })
+                .collect();
+            self.bottom_pane.show_selection_view(SelectionViewParams {
+                title: Some(format!("{id} · {name}")),
+                subtitle: Some(format!("Now: {}", shown(&current))),
+                items,
+                on_cancel: Some(Box::new(move |tx| {
+                    tx.send(AppEvent::OmdOpenAllMods {
+                        selected: Some(selected.clone()),
+                    })
+                })),
+                ..SelectionViewParams::picker()
+            });
+        } else {
+            let tx = self.app_event_tx.clone();
+            let view = crate::bottom_pane::SecretPromptView::new(
+                format!("{id} · {name}"),
+                format!(
+                    "Now: {}. Enter a new {}",
+                    shown(&current),
+                    if kind == "string" { "value" } else { "number" }
+                ),
+                Box::new(move |value| {
+                    let Some(value) = value else {
+                        tx.send(AppEvent::OmdOpenAllMods {
+                            selected: Some(selected.clone()),
+                        });
+                        return;
+                    };
+                    match setting_value(&kind, value) {
+                        Ok(value) => tx.send(AppEvent::OmdWriteSetting {
+                            id: id.clone(),
+                            scope: scope.clone(),
+                            name: name.clone(),
+                            value: Some(value),
+                            terminal,
+                            binding,
+                        }),
+                        Err(error) => tx.send(AppEvent::OmdSettingFinished {
+                            result: Err(error),
+                            binding,
+                            selected: selected.clone(),
+                        }),
+                    }
+                }),
+            )
+            .plain();
+            self.bottom_pane.show_view(Box::new(view));
+        }
+        self.request_redraw();
+    }
+
+    pub(crate) fn open_omd_additions(&mut self) {
+        let entries = crate::omd::store_root()
+            .or_else(|| crate::mod_runtime::remote_frontend_active().then(PathBuf::new))
+            .map_or(Ok(Vec::new()), mod_entries);
+        let (items, header) = match entries {
+            Ok(entries) => {
+                let items = addition_items(entries, &self.mod_command_rows());
+                let header = if items.is_empty() {
+                    "No mods are on."
+                } else {
+                    "Mods that are on and the commands and keys they add."
+                };
+                (items, header.to_string())
+            }
+            Err(error) => (Vec::new(), format!("Mods are unavailable: {error}")),
+        };
+        let params = searchable(
+            "omd-additions",
+            "What Oh My Diff adds",
+            vec![Line::from(header)],
+            items,
+            &self.bottom_pane.list_keymap(),
+        );
+        self.bottom_pane.show_selection_view(params);
+        self.request_redraw();
+    }
+
+    pub(crate) fn open_omd_all_mods(&mut self, selected: Option<String>) {
+        let Some(root) = crate::omd::store_root()
+            .or_else(|| crate::mod_runtime::remote_frontend_active().then(PathBuf::new))
+        else {
+            return;
+        };
+        let (items, header) = match mod_entries(root) {
+            Ok(entries) => (
+                entries
+                    .into_iter()
+                    .flat_map(mod_items)
+                    .collect::<Vec<_>>(),
+                "Changes apply at the next turn, for every terminal unless a mod is set to only this terminal."
+                    .to_string(),
+            ),
+            Err(error) => (Vec::new(), format!("Mods are unavailable: {error}")),
+        };
+        let initial = selected.and_then(|selected| {
+            items
+                .iter()
+                .position(|item| row_key(&item.name) == row_key(&selected))
+        });
+        let mut params = searchable(
+            "omd-all-mods",
+            "All mods",
+            vec![Line::from(header)],
+            items,
+            &self.bottom_pane.list_keymap(),
+        );
+        params.initial_selected_idx = initial;
+        self.bottom_pane.show_selection_view(params);
+        self.request_redraw();
+    }
+
+    pub(crate) fn finish_omd_mod_toggle(
+        &mut self,
+        result: Result<String, String>,
+        all_mods: bool,
+        selected: Option<String>,
+    ) {
+        match result {
+            Ok(message) => self.add_info_message(message, None),
+            Err(error) => self.add_error_message(format!("Mod change failed: {error}")),
+        }
+        if all_mods {
+            self.open_omd_all_mods(selected);
+        } else {
+            self.open_omd_extensions();
+        }
+    }
+}
