+#[tokio::test]
+async fn terminal_owner_pending_attach_cleanup_preserves_live_clients_and_reconnect_tokens() {
+    let (sender, _outgoing) = mpsc::channel(8);
+    let clients = OmdClients::new(Arc::new(OutgoingMessageSender::new(
+        sender,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    )));
+    let existing = clients.terminal_owner(ConnectionId(41));
+    attach(&clients, 41, &["terminal.panel"]);
+    let (token, owner, created_token) = clients.attach_owner(ConnectionId(41), None).unwrap();
+    assert!(created_token);
+    {
+        let _pending = PendingAttach {
+            clients: &clients,
+            connection: ConnectionId(41),
+            client: "failed-replacement".into(),
+            token: token.clone(),
+            owner,
+            created_token,
+            completed: false,
+        };
+    }
+    assert_eq!(
+        clients.attached().get(&ConnectionId(41)).unwrap().client_id,
+        "test-41"
+    );
+    assert_eq!(clients.terminal_owner(ConnectionId(41)), existing);
+    assert!(!clients.terminal_tokens.lock().unwrap().contains_key(&token));
+
+    let (retained, _, _) = clients.attach_owner(ConnectionId(41), None).unwrap();
+    let gate = ConnectionRpcGate::new();
+    let (token, owner, created_token) = clients
+        .attach_owner(ConnectionId(42), Some(&retained))
+        .unwrap();
+    assert!(!created_token);
+    let pending = PendingAttach {
+        clients: &clients,
+        connection: ConnectionId(42),
+        client: "closed-reconnect".into(),
+        token,
+        owner,
+        created_token,
+        completed: false,
+    };
+    gate.close().await;
+    clients.connection_closed(ConnectionId(42)).await;
+    assert!(gate.is_closed());
+    drop(pending);
+    assert!(
+        clients
+            .terminal_tokens
+            .lock()
+            .unwrap()
+            .contains_key(&retained)
+    );
+    assert_eq!(
+        clients.attached().get(&ConnectionId(41)).unwrap().client_id,
+        "test-41"
+    );
+
+    let (token, abandoned, created_token) = clients.attach_owner(ConnectionId(43), None).unwrap();
+    let pending = PendingAttach {
+        clients: &clients,
+        connection: ConnectionId(43),
+        client: "closed-new".into(),
+        token: token.clone(),
+        owner: abandoned,
+        created_token,
+        completed: false,
+    };
+    clients.connection_closed(ConnectionId(43)).await;
+    drop(pending);
+    assert!(!clients.terminal_tokens.lock().unwrap().contains_key(&token));
+    assert!(
+        !clients
+            .terminal_owners
+            .lock()
+            .unwrap()
+            .contains_key(&ConnectionId(43))
+    );
+    assert_eq!(clients.terminal_owner(ConnectionId(41)), existing);
+}
