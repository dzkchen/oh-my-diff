+type Listed = (Value, Vec<(PathBuf, crate::FileStamp)>, Arc<Selections>);
+
+static LISTED: Mutex<Option<Listed>> = Mutex::new(None);
+
+const LISTING_RUNTIME_FIELDS: [&str; 7] = [
+    "id",
+    "scope",
+    "sha256",
+    "error",
+    "version",
+    "api",
+    "capabilities",
+];
