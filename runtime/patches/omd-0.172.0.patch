+        false,
+        Some("a"),
+        Some("confirm".into()),
+        Arc::new(move || check.load(Ordering::Acquire)),
+    )
+    .unwrap();
+    let held = queue.0.lock().unwrap().pop().unwrap();
+    authority.store(false, Ordering::Release);
+    assert!(
+        !(held.validity.0)(),
+        "revocation is checked before the waiter polls"
+    );
+    drop(receiver);
+
+    let woken = Arc::new(AtomicUsize::new(0));
+    let counter = woken.clone();
+    let registrations = [1, 10].map(|step| {
+        let counter = counter.clone();
+        register_wake(Arc::new(move || {
+            counter.fetch_add(step, Ordering::SeqCst);
+        }))
+    });
+    wake();
+    drop(registrations);
+    wake();
+    assert_eq!(
+        woken.load(Ordering::SeqCst),
+        11,
+        "every registered wake runs"
+    );
+}
