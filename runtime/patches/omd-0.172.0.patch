+use super::*;
+use std::collections::BTreeMap;
+use std::sync::mpsc;
+
+fn fixture() -> (tempfile::TempDir, WorkspaceWatches) {
+    let dir = tempfile::tempdir().unwrap();
+    for sub in ["src", ".git", "store"] {
+        std::fs::create_dir_all(dir.path().join(sub)).unwrap();
+    }
+    let root = dir.path().canonicalize().unwrap();
+    let watches = WorkspaceWatches::new(
+        Arc::new(FileWatcher::new().unwrap()),
+        root.clone(),
+        vec![root.join("store")],
+        Default::default(),
+    )
+    .unwrap();
+    (dir, watches)
+}
+
+fn channel_sink() -> (ChangeSink, mpsc::Receiver<(String, Vec<String>)>) {
+    let (tx, rx) = mpsc::channel();
+    let tx = Mutex::new(tx);
+    (
+        Arc::new(move |id: &str, paths: Vec<String>| {
+            let _ = tx.lock().unwrap().send((id.to_owned(), paths));
+        }),
+        rx,
+    )
+}
+
+#[tokio::test]
+async fn failed_registrations_do_not_consume_watch_slots_or_keys() {
+    let dir = tempfile::tempdir().unwrap();
+    let limits = codex_omd::mod_limits::ModLimits {
+        watches_per_mod: 2,
+        ..Default::default()
+    };
+    let watches = WorkspaceWatches::new(
+        Arc::new(FileWatcher::noop()),
+        dir.path().to_path_buf(),
+        Vec::new(),
+        limits,
+    )
+    .unwrap();
+    for attempt in 0..=limits.watches_per_mod {
+        let key = format!("key-{attempt}");
+        let (sink, _rx) = channel_sink();
