+        enabled: true,
+        required,
+        blocked: None,
+        failure: None,
+        configuration: serde_json::json!({"settings_schema":{"properties":{"mode":{"type":"string"}}}}),
+    };
+    let managed = mod_items(entry(false, "managed"));
+    assert!(managed.iter().all(|item| item.is_disabled
+        && item.disabled_reason.as_deref() == Some("Your administrator manages this mod")));
+    assert!(
+        !managed
+            .iter()
