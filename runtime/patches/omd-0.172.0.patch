+        json!({"kind": "pointer", "pointer": {"column": 1, "row": 2, "half": 2, "action": "down", "button": null}}),
+        json!({"kind": "change", "value": "x".repeat(EVENT_BYTES)}),
+        json!("change"),
+    ] {
+        assert!(
+            event_payload(&event)
+                .unwrap_err()
+                .starts_with("component_event_invalid:"),
