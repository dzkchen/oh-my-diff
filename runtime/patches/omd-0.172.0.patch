+#[test]
+#[serial_test::serial]
+fn preview_and_context_are_isolated_between_parallel_and_sequential_tests() {
+    for _ in 0..2 {
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(2));
+        let threads = ["left", "right"].map(|name| {
+            let barrier = barrier.clone();
+            std::thread::spawn(move || {
+                assert!(crate::mod_ui::session_title_suffix().is_none());
+                assert!(crate::mod_runtime::active_context().is_none());
+                let repository = std::path::PathBuf::from(name);
+                crate::mod_runtime::synchronize_context(crate::mod_runtime::ModContext {
+                    thread_id: None,
+                    repository: repository.clone(),
+                    policy: codex_protocol::permissions::FileSystemSandboxPolicy::unrestricted(),
+                });
+                let mut snapshot = codex_omd::ModViewSnapshot::default();
+                snapshot.view.session_title_suffix = Some(name.into());
+                crate::mod_ui::preview(snapshot);
+                barrier.wait();
+                assert_eq!(crate::mod_ui::session_title_suffix().as_deref(), Some(name));
+                assert_eq!(
+                    crate::mod_runtime::active_context().unwrap().repository,
+                    repository
+                );
+            })
+        });
+        for thread in threads {
+            thread.join().unwrap();
+        }
+    }
+}
