+            .get(&fixture.thread_id)
+            .unwrap();
+        let mut snapshot = channel.store.lock().await.snapshot();
+        assert!(snapshot.events.iter_mut().any(|event| matches!(
+            event,
+            ThreadBufferedEvent::UserTurnSubmission(_)
