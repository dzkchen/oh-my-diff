@@ -0,0 +1,274 @@
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use unicode_width::UnicodeWidthChar;
+use unicode_width::UnicodeWidthStr;
+
+use super::CancellationEvent;
+use super::bottom_pane_view::BottomPaneView;
+use super::bottom_pane_view::ViewCompletion;
+use crate::mod_ui::glyph;
+use crate::render::renderable::Renderable;
+use crate::wrapping::word_wrap_lines;
+
+const SECRET_CHARS: usize = 512;
+
+pub(crate) type SecretSubmitted = Box<dyn FnOnce(Option<String>) + Send + Sync>;
+
+pub(crate) struct SecretPromptView {
+    title: String,
+    note: String,
+    value: String,
+    masked: bool,
+    completion: Option<ViewCompletion>,
+    on_done: Option<SecretSubmitted>,
+}
+
+impl SecretPromptView {
+    pub(crate) fn new(title: String, note: String, on_done: SecretSubmitted) -> Self {
+        Self {
+            title,
+            note,
+            value: String::new(),
+            masked: true,
+            completion: None,
+            on_done: Some(on_done),
+        }
+    }
+
+    pub(crate) fn plain(mut self) -> Self {
+        self.masked = false;
+        self
+    }
+
+    fn finish(&mut self, value: Option<String>) {
+        self.completion = Some(if value.is_some() {
+            ViewCompletion::Accepted
+        } else {
+            ViewCompletion::Cancelled
+        });
+        if let Some(on_done) = self.on_done.take() {
+            on_done(value);
+        }
+    }
+
+    fn header(&self, width: u16) -> Vec<Line<'static>> {
+        let width = usize::from(width.max(1));
+        let title = self
+            .title
+            .split('\n')
+            .map(|line| Line::from(line.to_owned()).bold());
+        let note = self
+            .note
+            .split('\n')
+            .map(|line| Line::from(line.to_owned()).dim());
+        word_wrap_lines(title.chain(note), width)
+    }
+
+    fn push(&mut self, text: &str) {
+        if !self.masked {
+            self.value.push_str(text);
+            return;
+        }
+        for character in text.chars().filter(|c| !c.is_control()) {
+            if self.value.chars().count() >= SECRET_CHARS {
+                break;
+            }
+            self.value.push(character);
+        }
+    }
+}
+
+impl Drop for SecretPromptView {
+    fn drop(&mut self) {
+        if let Some(on_done) = self.on_done.take() {
+            on_done(None);
+        }
+    }
+}
+
+impl BottomPaneView for SecretPromptView {
+    fn handle_key_event(&mut self, key_event: KeyEvent) {
+        if key_event.kind == KeyEventKind::Release {
+            return;
+        }
+        match (key_event.code, key_event.modifiers) {
+            (KeyCode::Enter, KeyModifiers::SHIFT) if !self.masked => self.push("\n"),
+            (KeyCode::Tab, KeyModifiers::NONE) if !self.masked => self.push("\t"),
+            (KeyCode::Enter, _) => {
+                let value = std::mem::take(&mut self.value);
+                if self.masked {
+                    let value = value.trim().to_owned();
+                    self.finish((!value.is_empty()).then_some(value));
+                } else {
+                    self.finish(Some(value));
+                }
+            }
+            (KeyCode::Esc, _) => self.finish(None),
+            (KeyCode::Backspace, _) => {
+                self.value.pop();
+            }
+            (KeyCode::Char(character), KeyModifiers::NONE | KeyModifiers::SHIFT) => {
+                self.push(&character.to_string());
+            }
+            _ => {}
+        }
+    }
+
+    fn is_complete(&self) -> bool {
+        self.completion.is_some()
+    }
+
+    fn completion(&self) -> Option<ViewCompletion> {
+        self.completion
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.finish(None);
+        CancellationEvent::Handled
+    }
+
+    fn prefer_esc_to_handle_key_event(&self) -> bool {
+        true
+    }
+
+    fn handle_paste(&mut self, pasted: String) -> bool {
+        if self.masked {
+            self.push(pasted.trim());
+        } else {
+            self.push(&pasted);
+        }
+        true
+    }
+}
+
+impl Renderable for SecretPromptView {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let value = if self.masked {
+            glyph("•", "*").repeat(self.value.chars().count().min(64))
+        } else {
+            self.value.chars().flat_map(char::escape_debug).collect()
+        };
+        let prompt = glyph("› ", "> ");
+        // The input keeps its end, where typing happens, in view.
+        let mut room = usize::from(area.width).saturating_sub(prompt.width());
+        let start = value
+            .char_indices()
+            .rev()
+            .take_while(|(_, character)| {
+                let width = character.width().unwrap_or(0);
+                let fits = width <= room;
+                room = room.saturating_sub(width);
+                fits
+            })
+            .last()
+            .map_or(value.len(), |(start, _)| start);
+        let mut lines = self.header(area.width);
+        lines.truncate(usize::from(area.height.saturating_sub(2)));
+        lines.push(Line::from(format!("{prompt}{}", &value[start..])));
+        let hint = if self.masked {
+            format!("enter to save {} esc to cancel", glyph("·", "-"))
+        } else {
+            format!(
+                "enter to save {} shift+enter newline {} esc to cancel",
+                glyph("·", "-"),
+                glyph("·", "-")
+            )
+        };
+        lines.push(Line::from(hint).dim());
+        Paragraph::new(lines).render(area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        u16::try_from(self.header(width).len())
+            .unwrap_or(u16::MAX)
+            .saturating_add(2)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+
+    #[test]
+    fn plain_text_preserves_empty_whitespace_and_long_pasted_values() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        for value in [String::new(), "  text \n\t ".into(), "x".repeat(1024)] {
+            let result = seen.clone();
+            let mut view = SecretPromptView::new(
+                "Setting".into(),
+                String::new(),
+                Box::new(move |value| result.lock().unwrap().push(value)),
+            )
+            .plain();
+            view.handle_paste(value.clone());
+            view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+            assert_eq!(seen.lock().unwrap().last(), Some(&Some(value)));
+        }
+    }
+
+    #[test]
+    fn secrets_are_masked_trimmed_and_cancel_reports_none() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let record = |seen: &Arc<Mutex<Vec<Option<String>>>>| {
+            let seen = seen.clone();
+            Box::new(move |value| seen.lock().unwrap().push(value)) as SecretSubmitted
+        };
+        let mut view = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        view.handle_paste(" sk-test ".into());
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 40, 4));
+        view.render(Rect::new(0, 0, 40, 4), &mut buffer);
+        let screen = (0..40)
+            .map(|x| buffer[(x, 2)].symbol().to_owned())
+            .collect::<String>();
+        assert!(!screen.contains("sk-test"));
+        view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        assert!(view.is_complete());
+        let mut cancelled = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        cancelled.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        drop(SecretPromptView::new(
+            "Key".into(),
+            "note".into(),
+            record(&seen),
+        ));
+        assert_eq!(
+            *seen.lock().unwrap(),
+            vec![Some("sk-test".to_owned()), None, None]
+        );
+    }
+
+    #[test]
+    fn long_messages_wrap_and_the_input_keeps_its_end_in_view() {
+        let words = (0..50).map(|n| format!("word{n:02}")).collect::<Vec<_>>();
+        let message = [&words[..17], &words[17..34], &words[34..]]
+            .map(|line| line.join(" "))
+            .join("\n");
+        let mut view = SecretPromptView::new("Title".into(), message, Box::new(|_| {})).plain();
+        view.handle_paste(format!("{}tail", "x".repeat(60)));
+        let height = view.desired_height(40);
+        let area = Rect::new(0, 0, 40, height);
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer);
+        let rows = (0..height)
+            .map(|y| (0..40).map(|x| buffer[(x, y)].symbol()).collect::<String>())
+            .collect::<Vec<_>>();
+        let screen = rows.join("\n");
+        assert!(
+            words.iter().all(|word| screen.contains(word.as_str())),
+            "{screen}"
+        );
+        assert!(
+            rows[usize::from(height) - 2].trim_end().ends_with("xtail"),
+            "{screen}"
+        );
+    }
+}
