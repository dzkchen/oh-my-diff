+struct ToolNotice {
+    call_id: String,
+    kind: &'static str,
+    text: String,
+    owner: String,
+}
+
+pub(crate) fn clear_tool_notices() {
+    DRAWN_CALLS.with(|drawn_calls_state| {
+        TOOL_NOTICES.with(|tool_notices_state| {
+            EPOCH.with(|epoch_state| {
+                drawn_calls_state.locked().clear();
+                tool_notices_state.locked().clear();
+                epoch_state.fetch_add(1, Ordering::Relaxed);
+            })
+        })
+    })
+}
