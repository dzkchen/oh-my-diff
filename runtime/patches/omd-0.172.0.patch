+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct File {
+    /// The contents, or the link text of a symlink.
+    pub bytes: Vec<u8>,
+    pub executable: bool,
+    pub symlink: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct Snapshot {
