+/// Changes whenever a tool notice changes what a retained layout drew.
+pub(crate) fn epoch() -> u64 {
+    EPOCH.with(|epoch_state| epoch_state.load(Ordering::Relaxed))
+}
+
+/// Advances whenever a hook answer changes, so layouts cached for the live cell redraw.
+pub(crate) fn live_epoch() -> u64 {
+    LIVE_EPOCH.with(|live_epoch_state| live_epoch_state.load(Ordering::Relaxed))
+}
+
+/// A new view revision may follow a state change, so finished renders are asked again; each instance's last tree stands until its answer arrives.
+pub(crate) fn refresh(revision: (u64, u64)) {
+    LIVE_EPOCH.with(|live_epoch_state| {
+        HOOKED.with(|hooked_state| {
+            let changed = engine(|engine| {
+                let changed = engine.revision != Some(revision);
+                engine.revision = Some(revision);
+                changed
+            });
+            if !changed {
+                return;
+            }
+            crate::mod_module::refresh();
+            match crate::mod_runtime::render_hooked() {
+                Some(hooked) => {
+                    forget();
+                    hooked_state.store(hooked, Ordering::Relaxed);
+                    REFRESHES.with(|state| state.fetch_add(1, Ordering::Relaxed));
+                    live_epoch_state.fetch_add(1, Ordering::Relaxed);
+                }
+                // A busy runtime leaves the flag and finished renders as they were and asks again next frame; forgetting them now would only queue renders needing the same busy runtime.
+                None => engine(|engine| engine.revision = None),
+            }
+        })
+    })
+}
+
+/// Ids of the components the latest hook trees draw, whose images and documents must outlive a view sync.
+pub(crate) fn component_ids() -> std::collections::BTreeSet<String> {
+    engine(|engine| {
+        engine
+            .latest
+            .values()
+            .flatten()
+            .flat_map(|rendered| codex_omd::component_ids_of(&rendered.tree))
+            .collect()
+    })
+}
+
+/// State a TUI-side callback wrote may change what hooks draw, so finished renders are asked again.
+pub(crate) fn forget() {
+    engine(|engine| {
+        engine.done.clear();
+        engine.cleared += 1;
+    });
+}
+
+/// State only hooks read may change under an identical view, so the instances asked since the previous frame began are asked again off-frame.
+pub(crate) fn reask() {
+    if !enabled() {
+        return;
+    }
+    let start = engine(|engine| {
+        let cleared = engine.cleared;
+        let mut recent = engine
+            .asked
+            .iter()
+            .map(|(instance, (key, input, ask))| {
+                let job = Job {
+                    key: *key,
+                    instance: instance.clone(),
+                    input: input.clone(),
+                    cleared,
+                    context: engine.context,
+                    background: true,
+                };
+                (*ask, job)
+            })
+            .collect::<Vec<_>>();
+        recent.sort_unstable_by_key(|(ask, _)| std::cmp::Reverse(*ask));
+        recent.truncate(PENDING_LIMIT);
+        let mut start = false;
+        for (_, job) in recent.into_iter().rev() {
+            start |= engine.queue(job);
+        }
+        start
+    });
+    if start {
+        spawn_work();
+    }
+}
+
+fn spawn_work() {
+    #[cfg(test)]
+    let work = inherit_test_state(crate::mod_runtime::inherit_test_context(work));
+    std::thread::spawn(work);
+}
+
+/// Cells asked for another context never draw again.
+pub(crate) fn clear_asked() {
+    engine(|engine| {
+        engine.asked.clear();
+        engine.done.clear();
+        engine.latest.clear();
+        engine.generations.clear();
+        engine.pending.clear();
+        engine.revision = None;
+        engine.cleared += 1;
+        engine.context += 1;
+    });
+    REFRESHES.with(|state| state.fetch_add(1, Ordering::Relaxed));
+}
