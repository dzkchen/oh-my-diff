+#[serial_test::serial]
+fn configuration_activation_publishes_owner_host_and_generation_atomically() {
+    struct Reset(Option<Arc<Mutex<ModHost>>>);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            activate_configuration(false, None, None);
+            *HOST.locked() = self.0.take();
+        }
+    }
+    let temp = tempfile::tempdir().unwrap();
+    let store = codex_omd::ModStore::create(temp.path().join("store")).unwrap();
+    let _environment = crate::omd::tests::omd_environment(store.root());
+    let _reset = Reset(HOST.locked().take());
+    activate_configuration(false, Some("old-owner"), None);
+    let old = configuration_context(configuration_binding()).unwrap();
+    let held = TERMINAL_TOKEN.locked();
+    let publisher = std::thread::spawn(|| activate_configuration(true, Some("new-owner"), None));
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(3);
+    loop {
+        if FRONTEND_APPLY.try_lock().is_err() {
+            break;
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "publisher did not begin"
+        );
+        std::thread::yield_now();
+    }
+    let pending = configuration_binding();
+    assert_eq!(pending.0, old.binding.0);
+    let (tx, rx) = std::sync::mpsc::channel();
+    let reader = std::thread::spawn(move || {
+        tx.send(
+            configuration_context_for(pending, Some("old-owner".into()), None)
+                .map(|context| context.owner),
+        )
+        .unwrap();
+    });
+    assert!(matches!(
+        rx.try_recv(),
+        Err(std::sync::mpsc::TryRecvError::Empty)
+    ));
+    drop(held);
+    publisher.join().unwrap();
+    assert_eq!(rx.recv().unwrap().unwrap_err(), "terminal_context_changed");
+    reader.join().unwrap();
+    let new = configuration_context(configuration_binding()).unwrap();
+    assert_ne!(new.binding.0, old.binding.0);
+    assert_eq!(new.owner.as_deref(), Some("new-owner"));
+    assert!(new.remote);
+    assert!(!Arc::ptr_eq(&new.runtime, &old.runtime));
+}
