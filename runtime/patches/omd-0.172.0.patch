+    pub(super) fn write(&self, name: &str, value: &Value) -> Result<()> {
+        self.write_granting(name, value, &BTreeSet::new())
+    }
+
+    /// Adds broker grants only for `approved` selections; dropped selections lose theirs without authorization.
+    pub(super) fn write_granting(
+        &self,
+        name: &str,
+        value: &Value,
+        approved: &BTreeSet<String>,
+    ) -> Result<()> {
+        let stripped;
+        let value = if name == "mods.json" {
+            stripped = self.write_epochs(value)?;
+            &stripped
+        } else {
+            value
+        };
+        let bytes = serde_json::to_vec_pretty(value)?;
+        let brokered = match name {
+            "mods.json" => brokered_grants(&self.root)?,
+            _ => None,
+        };
+        let Some((generation, current)) = brokered else {
+            return self.write_staged(name, &bytes, || Ok(()));
+        };
+        let selected = value["mods"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(grant)
+            .collect::<BTreeSet<_>>();
+        let selected_record = |record: &String| kept_grant(record, &selected, value);
+        let added = approved
+            .iter()
+            .filter(|grant| selected_record(grant) && !current.contains(*grant))
+            .cloned()
+            .collect::<BTreeSet<_>>();
+        let kept = current
+            .union(&added)
+            .filter(|grant| selected_record(grant))
+            .cloned()
+            .collect::<BTreeSet<_>>();
+        self.write_staged(name, &bytes, || {
+            if kept != current {
+                let put = if added.is_empty() {
+                    crate::broker::call
+                } else {
+                    crate::broker::authorized
+                };
+                put(
+                    "grants.put",
+                    json!({"store": self.root, "generation": generation, "grants": kept}),
+                )?;
+            }
+            Ok(())
+        })
+    }
+
+    fn write_epochs(&self, config: &Value) -> Result<Value> {
+        let mut config = config.clone();
+        let epochs: Vec<_> = config["mods"]
+            .as_array_mut()
+            .into_iter()
+            .flatten()
+            .filter_map(|selection| {
+                let epoch = selection.as_object_mut()?.remove("configuration_epoch")?;
+                Some(json!([selection["scope"], selection["path"], epoch]))
+            })
+            .collect();
+        let bytes = serde_json::to_vec(&json!({"revision": config["revision"], "epochs": epochs}))?;
+        if read(&self.root.join(CONFIGURATION_EPOCHS), 65_536)
+            .ok()
+            .as_deref()
+            != Some(bytes.as_slice())
+        {
+            self.write_staged(CONFIGURATION_EPOCHS, &bytes, || Ok(()))?;
+        }
+        Ok(config)
+    }
+
+    pub(super) fn write_staged(
+        &self,
+        name: &str,
+        bytes: &[u8],
+        commit: impl FnOnce() -> Result<()>,
+    ) -> Result<()> {
+        let state = name.starts_with("state-");
+        let limit = match name {
+            "packages.lock.json" => 524_288,
+            "package-transaction.json" => 1_048_576,
+            _ if state => STATE_LIMIT,
+            _ => 65_536,
+        };
+        if bytes.len() > limit {
+            return Err(failure("state_or_configuration_limit"));
+        }
+        // Mod state commits often and needs crash consistency, not durability; configuration and locks stay durable.
+        let durability = if state {
+            crate::fsio::Durability::Ordered
+        } else {
+            crate::fsio::Durability::Durable
+        };
+        crate::fsio::write_bytes_before(&self.root.join(name), bytes, durability, commit)
+    }
+
+    pub fn configuration(&self) -> Result<ModConfiguration> {
+        let path = self.root.join("mods.json");
+        ModConfiguration::parse(&read(&path, 65_536)?, &path)
+    }
+
+    pub(super) fn record_security_event(&self, event: &str, detail: Value) -> Result<()> {
+        let at = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_err(failure)?
+            .as_secs();
+        let mut entry = json!({"at": at, "event": event});
+        if let (Some(entry), Value::Object(detail)) = (entry.as_object_mut(), detail) {
+            entry.extend(detail);
+        }
+        let mut line = serde_json::to_vec(&entry)?;
+        line.push(b'\n');
+        let mut bytes = self.security_event_bytes()?;
+        if bytes.len() + line.len() > SECURITY_EVENT_LIMIT {
+            let start = bytes.len() / 2;
+            let keep = bytes[start..]
+                .iter()
+                .position(|byte| *byte == b'\n')
+                .map_or(bytes.len(), |offset| start + offset + 1);
+            bytes.drain(..keep);
+        }
+        bytes.extend_from_slice(&line);
+        self.write_staged(SECURITY_EVENTS, &bytes, || Ok(()))
+    }
+
+    pub fn security_events(&self) -> Result<Vec<Value>> {
+        self.security_event_bytes()?
+            .split(|byte| *byte == b'\n')
+            .filter(|line| !line.is_empty())
+            .map(|line| serde_json::from_slice(line).map_err(Into::into))
+            .collect()
+    }
+
+    fn security_event_bytes(&self) -> Result<Vec<u8>> {
+        match read(
+            &self.root.join(SECURITY_EVENTS),
+            SECURITY_EVENT_LIMIT as u64,
+        ) {
+            Ok(bytes) => Ok(bytes),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(Vec::new()),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub fn managed_deployment(&self) -> Result<super::policy::ManagedDeployment> {
+        match read(&self.root.join("managed.json"), 524_288) {
+            Ok(bytes) => serde_json::from_slice(&bytes).map_err(|error| {
+                failure(format!(
+                    "managed_deployment_unreadable: {error}; run omd-mod reset STORE managed.json, then omd-mod package-sync"
+                ))
+            }),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(Default::default()),
+            Err(error) => Err(error),
+        }
+    }
+
