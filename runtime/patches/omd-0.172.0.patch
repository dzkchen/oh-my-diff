+#[tokio::test]
+async fn interleaved_tool_notifications_preserve_one_complete_message() -> Result<()> {
+    let fixtures = [
+        (
+            serde_json::json!({"type":"webSearch","id":"web","query":"fixture query","action":null}),
+            false,
+        ),
+        (
+            serde_json::json!({"type":"webSearch","id":"web","query":"fixture query","action":null}),
+            true,
+        ),
+        (
+            serde_json::json!({"type":"commandExecution","id":"exec","command":"echo fixture","cwd":"/tmp","status":"inProgress","commandActions":[]}),
+            true,
+        ),
+        (
+            serde_json::json!({"type":"imageView","id":"image","path":"/tmp/fixture.png"}),
+            false,
+        ),
+        (
+            serde_json::json!({"type":"imageGeneration","id":"image","status":"completed","result":""}),
+            false,
+        ),
+        (
+            serde_json::json!({"type":"collabAgentToolCall","id":"collab","tool":"wait","status":"completed","senderThreadId":"parent","receiverThreadIds":[],"agentsStates":{}}),
+            false,
+        ),
+    ];
+    let mut app_server = {
+        let app = crate::app::test_support::make_test_app().await;
+        Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?
+    };
+    let answer =
+        "The process is the strongest suspect.\n\nIts footprint includes compressed memory.";
+    for (fixture, started) in fixtures {
+        for (prefix, suffix) in [
+            ("The process is the strongest suspect.", ""),
+            (
+                "The process is the strongest suspect.",
+                "\n\nIts footprint includes compressed memory.",
+            ),
+            (answer, ""),
+        ] {
+            for owned in [false, true] {
+                let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+                let mut tui = crate::tui::test_support::make_test_tui()?;
+                tui.set_owned_screen(owned)?;
+                let thread_id = ThreadId::new().to_string();
+                let notify_delta = |app: &mut App, text: &str| {
+                    app.chat_widget.handle_server_notification(
+                        ServerNotification::AgentMessageDelta(
+                            codex_app_server_protocol::AgentMessageDeltaNotification {
+                                thread_id: thread_id.clone(),
+                                turn_id: "turn".into(),
+                                item_id: "message".into(),
+                                delta: text.into(),
+                            },
+                        ),
+                        None,
+                    );
+                };
+                notify_delta(&mut app, prefix);
+                app.chat_widget.on_commit_tick();
+                let item = serde_json::from_value(fixture.clone())?;
+                let notification = if started {
+                    ServerNotification::ItemStarted(
+                        codex_app_server_protocol::ItemStartedNotification::new(
+                            thread_id.clone(),
+                            "turn".into(),
+                            item,
+                            0,
+                        ),
+                    )
+                } else {
+                    ServerNotification::ItemCompleted(
+                        codex_app_server_protocol::ItemCompletedNotification::new(
+                            thread_id.clone(),
+                            "turn".into(),
+                            item,
+                            None,
+                            1250,
+                        ),
+                    )
+                };
+                app.chat_widget
+                    .handle_server_notification(notification, None);
+                if started {
+                    let mut completed = fixture.clone();
+                    if completed["type"] == "commandExecution" {
+                        completed["status"] = "completed".into();
+                    }
+                    app.chat_widget.handle_server_notification(
+                        ServerNotification::ItemCompleted(
+                            codex_app_server_protocol::ItemCompletedNotification::new(
+                                thread_id.clone(),
+                                "turn".into(),
+                                serde_json::from_value(completed)?,
+                                None,
+                                2500,
+                            ),
+                        ),
+                        None,
+                    );
+                }
+                if !suffix.is_empty() {
+                    notify_delta(&mut app, suffix);
+                    app.chat_widget.on_commit_tick();
+                }
+                app.chat_widget.handle_server_notification(
+                    ServerNotification::ItemCompleted(
+                        codex_app_server_protocol::ItemCompletedNotification::new(
+                            thread_id.clone(),
+                            "turn".into(),
+                            ThreadItemPayload::AgentMessage {
+                                moderation: None,
+                                id: "message".into(),
+                                text: answer.into(),
+                                phase: Some(codex_protocol::models::MessagePhase::Commentary),
+                                memory_citation: None,
+                                delivery: None,
+                                questions: None,
+                            },
+                            None,
+                            2000,
+                        ),
+                    ),
+                    None,
+                );
+                while let Ok(event) = events.try_recv() {
+                    app.handle_event(&mut tui, &mut app_server, event).await?;
+                }
+                let text = app
+                    .transcript_cells
+                    .iter()
+                    .flat_map(|cell| cell.display_lines(100))
+                    .map(|line| line.to_string())
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                assert_eq!(
+                    text.matches("The process is the strongest suspect.")
+                        .count(),
+                    1,
+                    "{fixture}: {text}"
+                );
+                assert_eq!(
+                    text.matches("Its footprint includes compressed memory.")
+                        .count(),
+                    1,
+                    "{fixture}: {text}"
+                );
+                assert!(
+                    app.transcript_cells
+                        .iter()
+                        .any(|cell| cell.copy_source() == Some(answer)),
+                    "{fixture}: {text}"
+                );
+                assert!(
+                    app.transcript_cells.len() > 1,
+                    "tool activity was lost: {fixture}: {text}"
+                );
+                tui.set_owned_screen(false)?;
+            }
+        }
+    }
+    app_server.shutdown().await?;
+    Ok(())
+}
