+static CONFIGURATION_TRANSPORT: std::sync::LazyLock<
+    Mutex<
+        Option<(
+            codex_app_server_client::AppServerRequestHandle,
+            tokio::runtime::Handle,
+        )>,
+    >,
+> = std::sync::LazyLock::new(|| Mutex::new(None));
