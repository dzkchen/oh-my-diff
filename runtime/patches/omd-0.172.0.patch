+pub fn confirmation_optional(preview: &Value) -> bool {
+    preview["identity_warning"].is_null()
+        && match preview["action"].as_str() {
+            Some("disable") => true,
+            Some("enable") => preview["grants_added"]
+                .as_array()
+                .is_some_and(Vec::is_empty),
+            _ => false,
+        }
+}
