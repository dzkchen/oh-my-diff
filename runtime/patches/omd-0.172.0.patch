+struct Agent {
+    mod_id: String,
+    generation: u64,
+    thread: Arc<CodexThread>,
+    result: Arc<Mutex<Option<Result<String, String>>>>,
+    failure: Arc<Mutex<Option<Value>>>,
+    job: Option<tokio::task::JoinHandle<()>>,
+    runtime: tokio::runtime::Handle,
+    consumed: bool,
+    task: Arc<Task>,
+    worker: String,
+    workspace: Option<Workspace>,
