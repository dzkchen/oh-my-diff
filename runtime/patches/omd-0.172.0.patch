+#[cfg(test)]
+thread_local!(static FULL_BUILDS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) });
+
+fn compaction(entries: &[Entry]) -> Option<usize> {
+    entries.iter().rposition(|entry| match &entry.item {
+        RolloutItem::Compacted(_) => true,
+        RolloutItem::ResponseItem(_) => entry
+            .info
+            .as_ref()
+            .is_some_and(|info| matches!(info.kind.as_str(), "compaction" | "context_compaction")),
+        _ => false,
+    })
+}
+
+fn entry_key(entry: &Entry) -> Option<String> {
+    let info = entry.info.as_ref()?;
+    info.call_id
+        .clone()
+        .or_else(|| info.id.clone())
+        .filter(|key| !key.is_empty())
+        .or_else(|| (info.kind == "message").then(|| format!("line-{}", entry.key)))
+}
+
+fn keys_of(entries: &[Entry]) -> Vec<String> {
+    let mut keys: Vec<String> = entries
+        .iter()
+        .filter_map(|entry| match &entry.item {
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => Some(event.item.id()),
+            _ => entry_key(entry),
+        })
+        .collect();
+    keys.sort_unstable();
+    keys.dedup();
+    keys
+}
+
+fn rows(entries: &[Entry]) -> Vec<Row> {
+    #[cfg(test)]
+    FULL_BUILDS.with(|builds| builds.set(builds.get() + 1));
+    build(
+        entries,
+        std::iter::once(0..entries.len()),
+        compaction(entries),
+    )
+}
+
+fn build(
+    entries: &[Entry],
+    ranges: impl IntoIterator<Item = Range<usize>>,
+    compaction: Option<usize>,
+) -> Vec<Row> {
+    let mut rows: Vec<Row> = Vec::new();
+    let mut keys: HashMap<String, usize> = HashMap::new();
+    let mut unpaired_users: Vec<(usize, String)> = Vec::new();
+    let mut turn: Option<String> = None;
+    for index in ranges.into_iter().flatten() {
+        let entry = &entries[index];
+        match &entry.item {
+            RolloutItem::EventMsg(EventMsg::TurnStarted(event)) => {
+                turn = Some(event.turn_id.clone());
+                unpaired_users.clear();
+            }
+            RolloutItem::ResponseItem(_) => {
+                let Some(info) = &entry.info else { continue };
+                let kind = info.kind.clone();
+                let Some(key) = entry_key(entry) else {
+                    continue;
+                };
+                let access = if EDITABLE.contains(&kind.as_str()) {
+                    HistoryRowAccess::Edit
+                } else if DELETABLE.contains(&kind.as_str()) {
+                    HistoryRowAccess::Delete
+                } else {
+                    HistoryRowAccess::Frozen
+                };
+                let label = match info.role.as_deref() {
+                    Some(role) if kind == "message" => format!("message.{role}"),
+                    _ => kind.clone(),
+                };
+                let row_index = match keys.get(&key) {
+                    Some(&row_index) => {
+                        let ambiguous = rows[row_index].entries.iter().any(|&other| {
+                            entries[other]
+                                .info
+                                .as_ref()
+                                .is_some_and(|other| other.kind == info.kind)
+                        });
+                        let row = &mut rows[row_index];
+                        row.frozen |= ambiguous;
+                        if row.model.is_none() {
+                            row.kind = label;
+                        }
+                        row.model = Some(row.model.map_or(access, |model| model.min(access)));
+                        row_index
+                    }
+                    None => {
+                        rows.push(Row {
+                            id: key.clone(),
+                            alias: None,
+                            turn_id: turn.clone(),
+                            kind: label,
+                            entries: Vec::new(),
+                            access,
+                            model: Some(access),
+                            frozen: false,
+                        });
+                        keys.insert(key, rows.len() - 1);
+                        rows.len() - 1
+                    }
+                };
+                rows[row_index].entries.push(index);
+                if kind == "message" && info.role.as_deref() == Some("user") {
+                    unpaired_users.push((row_index, info.text.clone()));
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                let id = event.item.id();
+                let paired = if let TurnItem::UserMessage(message) = &event.item {
+                    let text: String = message
+                        .content
+                        .iter()
+                        .filter_map(|input| match input {
+                            UserInput::Text { text, .. } => Some(text.as_str()),
+                            _ => None,
+                        })
+                        .collect();
+                    let position = unpaired_users
+                        .iter()
+                        .rposition(|(_, model)| *model == text)
+                        .or_else(|| unpaired_users.len().checked_sub(1));
+                    position.map(|position| unpaired_users.remove(position).0)
+                } else {
+                    keys.get(&id).copied()
+                };
+                match paired {
+                    Some(row_index) => {
+                        let displayed = rows[row_index].entries.iter().any(|&other| {
+                            matches!(
+                                entries[other].item,
+                                RolloutItem::EventMsg(EventMsg::ItemCompleted(_))
+                            )
+                        });
+                        let row = &mut rows[row_index];
+                        row.frozen |= displayed;
+                        if row.id != id {
+                            row.alias = Some(std::mem::replace(&mut row.id, id.clone()));
+                            keys.insert(id, row_index);
+                        }
+                        row.entries.push(index);
+                    }
+                    None => {
+                        let kind = serde_json::to_value(&event.item)
+                            .ok()
+                            .and_then(|value| value["type"].as_str().map(str::to_string))
+                            .unwrap_or_default();
+                        rows.push(Row {
+                            id: id.clone(),
+                            alias: None,
+                            turn_id: Some(event.turn_id.clone()),
+                            kind,
+                            entries: vec![index],
+                            access: HistoryRowAccess::Delete,
+                            model: None,
+                            frozen: false,
+                        });
+                        keys.insert(id, rows.len() - 1);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    for row in &mut rows {
+        row.access =
+            if row.frozen || compaction.is_some_and(|compaction| row.entries[0] < compaction) {
+                HistoryRowAccess::Frozen
+            } else {
+                row.model.unwrap_or(HistoryRowAccess::Delete)
+            };
+    }
+    rows
+}
+
+fn segment_range(starts: &[usize], segment: usize, len: usize) -> Range<usize> {
+    let begin = segment
+        .checked_sub(1)
+        .map_or(0, |previous| starts[previous]);
+    begin..starts.get(segment).copied().unwrap_or(len)
+}
+
+fn tally(counts: &mut HashMap<String, usize>, key: &str, added: bool) {
+    if added {
+        *counts.entry(key.to_string()).or_default() += 1;
+    } else if let Some(count) = counts.get_mut(key) {
+        *count -= 1;
+        if *count == 0 {
+            counts.remove(key);
+        }
+    }
+}
+
+fn tally_names(names: &mut HashMap<String, usize>, rows: &[Row], added: bool) {
+    for row in rows {
+        for name in std::iter::once(&row.id).chain(&row.alias) {
+            tally(names, name, added);
+        }
+    }
+}
+
+fn tally_calls(calls: &mut HashMap<String, usize>, entries: &[Entry], added: bool) {
+    for call_id in entries
+        .iter()
+        .filter_map(|entry| entry.info.as_ref()?.call_id.as_deref())
+    {
+        tally(calls, call_id, added);
+    }
+}
+
+/// Rows interact only through shared keys, so an edit rebuilds just the turn segments linked to the ones it touches.
+struct View {
+    rows: Vec<Row>,
+    starts: Vec<usize>,
+    compaction: Option<usize>,
+    keys: Vec<Vec<String>>,
+    owners: HashMap<String, Vec<usize>>,
+    names: HashMap<String, usize>,
+    calls: HashMap<String, usize>,
+}
+
+impl View {
+    fn new(entries: &[Entry]) -> Self {
+        let starts: Vec<usize> = entries
+            .iter()
+            .enumerate()
+            .filter(|(_, entry)| {
+                matches!(entry.item, RolloutItem::EventMsg(EventMsg::TurnStarted(_)))
+            })
+            .map(|(index, _)| index)
+            .collect();
+        let mut view = Self {
+            rows: rows(entries),
+            keys: vec![Vec::new(); starts.len() + 1],
+            starts,
+            compaction: compaction(entries),
+            owners: HashMap::new(),
+            names: HashMap::new(),
+            calls: HashMap::new(),
+        };
+        for segment in 0..=view.starts.len() {
+            let range = segment_range(&view.starts, segment, entries.len());
+            view.set_keys(segment, keys_of(&entries[range]));
+        }
+        tally_names(&mut view.names, &view.rows, true);
+        tally_calls(&mut view.calls, entries, true);
+        view
+    }
+
+    fn set_keys(&mut self, segment: usize, keys: Vec<String>) {
+        for key in std::mem::replace(&mut self.keys[segment], keys) {
+            if let Some(owners) = self.owners.get_mut(&key) {
+                owners.retain(|&owner| owner != segment);
+                if owners.is_empty() {
+                    self.owners.remove(&key);
+                }
+            }
+        }
+        for key in &self.keys[segment] {
+            self.owners.entry(key.clone()).or_default().push(segment);
+        }
+    }
+
+    /// `removed` is ascending and `at` is an index after the removals; returns the removed entries.
+    fn edit(
+        &mut self,
+        entries: &mut Vec<Entry>,
+        removed: &[usize],
+        at: usize,
+        inserted: Vec<Entry>,
+    ) -> Vec<Entry> {
+        debug_assert!(removed.is_sorted(), "row entries stay ascending");
+        let mut seeds: Vec<usize> = removed
+            .iter()
+            .map(|&index| self.starts.partition_point(|&start| start <= index))
+            .collect();
+        let mut taken: Vec<Entry> = removed
+            .iter()
+            .rev()
+            .map(|&index| entries.remove(index))
+            .collect();
+        taken.reverse();
+        let count = inserted.len();
+        tally_calls(&mut self.calls, &taken, false);
+        tally_calls(&mut self.calls, &inserted, true);
+        entries.splice(at..at, inserted);
+        let shift = |index: usize| {
+            let kept = index - removed.partition_point(|&gone| gone < index);
+            if kept >= at { kept + count } else { kept }
+        };
+        let starts = self.starts.iter().map(|&start| shift(start)).collect();
+        let old_starts = std::mem::replace(&mut self.starts, starts);
+        if count > 0 {
+            seeds.push(self.starts.partition_point(|&start| start < at));
+        }
+        let len = entries.len();
+        let mut touched = BTreeSet::new();
+        let mut fresh = Vec::new();
+        while let Some(segment) = seeds.pop() {
+            if !touched.insert(segment) {
+                continue;
+            }
+            let keys = keys_of(&entries[segment_range(&self.starts, segment, len)]);
+            for key in keys.iter().chain(&self.keys[segment]) {
+                seeds.extend(self.owners.get(key).into_iter().flatten());
+            }
+            fresh.push((segment, keys));
+        }
+        self.compaction = self.compaction.map(shift);
+        let (dropped, mut kept): (Vec<Row>, Vec<Row>) =
+            std::mem::take(&mut self.rows).into_iter().partition(|row| {
+                touched.contains(&old_starts.partition_point(|&start| start <= row.entries[0]))
+            });
+        tally_names(&mut self.names, &dropped, false);
+        for index in kept.iter_mut().flat_map(|row| &mut row.entries) {
+            *index = shift(*index);
+        }
+        let rebuilt = build(
+            entries,
+            touched
+                .iter()
+                .map(|&segment| segment_range(&self.starts, segment, len)),
+            self.compaction,
+        );
+        tally_names(&mut self.names, &rebuilt, true);
+        kept.extend(rebuilt);
+        kept.sort_by_key(|row| row.entries[0]);
+        self.rows = kept;
+        for (segment, keys) in fresh {
+            self.set_keys(segment, keys);
+        }
+        taken
+    }
+}
+
+fn find<'a>(rows: &'a [Row], id: &str) -> ThreadStoreResult<&'a Row> {
+    rows.iter()
+        .find(|row| row.id == id)
+        .or_else(|| rows.iter().find(|row| row.alias.as_deref() == Some(id)))
+        .ok_or_else(|| invalid(format!("history_row_unknown: {id}")))
+}
+
+fn require(row: &Row, access: HistoryRowAccess) -> ThreadStoreResult<()> {
+    if row.access < access {
+        return Err(invalid(format!(
+            "history_row_{}: {} ({})",
+            if row.access == HistoryRowAccess::Frozen {
+                "frozen"
+            } else {
+                "delete_only"
+            },
+            row.id,
+            row.kind
+        )));
+    }
+    Ok(())
+}
+
+fn apply(
+    view: &mut View,
+    entries: &mut Vec<Entry>,
+    change: &HistoryRowEdit,
+    edit: &Edit<'_>,
+) -> ThreadStoreResult<()> {
+    match change {
+        HistoryRowEdit::Delete { id } => {
+            let row = find(&view.rows, id)?.clone();
+            require(&row, HistoryRowAccess::Delete)?;
+            let checkpoint = checkpoint(entries, &row);
+            let at = row.entries[0];
+            view.edit(entries, &row.entries, at, Vec::new());
+            if let Some(checkpoint) = checkpoint {
+                let target = entries[..at]
+                    .iter()
+                    .rposition(|entry| matches!(entry.item, RolloutItem::ResponseItem(_)))
+                    .or_else(|| {
+                        entries[at..]
+                            .iter()
+                            .position(|entry| matches!(entry.item, RolloutItem::ResponseItem(_)))
+                            .map(|offset| at + offset)
+                    });
+                if let Some(target) = target
+                    && let RolloutItem::ResponseItem(envelope) = &mut entries[target].item
+                {
+                    envelope
+                        .metadata
+                        .get_or_insert_with(CodexHarnessMetadata::default)
+                        .mcp_attribution = Some(checkpoint);
+                }
+            }
+        }
+        HistoryRowEdit::Replace { id, items } => {
+            let row = find(&view.rows, id)?.clone();
+            require(&row, HistoryRowAccess::Edit)?;
+            let (shape, mut items) = new_items(items, row.turn_id.as_deref())?;
+            let mut original_id = None;
+            let mut original_key = 0;
+            let mut completed = None;
+            let mut completed_first = false;
+            for &index in &row.entries {
+                match &entries[index].item {
+                    RolloutItem::ResponseItem(envelope) => {
+                        let value = item_value(&envelope.item);
+                        if original_id.is_none() {
+                            original_id = Some((value.clone(), envelope.item.id().cloned()));
+                            original_key = entries[index].key;
+                        }
+                    }
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                        completed_first = original_id.is_none();
+                        completed = Some(event.clone());
+                    }
+                    _ => {}
+                }
+            }
+            let Some((original, response_id)) = original_id else {
+                return Err(invalid(format!(
+                    "history_row_frozen: {} ({})",
+                    row.id, row.kind
+                )));
+            };
+            match &shape {
+                Shape::Message(role) if original["type"] == "message" => {
+                    if original["role"].as_str() != Some(role.as_str()) {
+                        return Err(invalid(format!(
+                            "history_role_changed: {} stays {}",
+                            row.id, original["role"]
+                        )));
+                    }
+                    items[0].set_id(response_id);
+                }
+                Shape::Tool(call_id) if Some(call_id.as_str()) == original["call_id"].as_str() => {}
+                _ => {
+                    return Err(invalid(format!(
+                        "history_row_shape_changed: {} ({})",
+                        row.id, row.kind
+                    )));
+                }
+            }
+            let mut replacement = model_entries(
+                items.clone(),
+                "replace",
+                Some(&row.id),
+                edit,
+                checkpoint(entries, &row),
+            );
+            for entry in &mut replacement {
+                entry.key = original_key;
+            }
+            let display = completed.and_then(|mut event| {
+                let item = display_item(&items[0], &row.id, Some(&event.item))?;
+                event.item = item;
+                Some(Entry::new(
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(event)),
+                    None,
+                ))
+            });
+            if let Some(display) = display {
+                if completed_first {
+                    replacement.insert(0, display);
+                } else {
+                    replacement.push(display);
+                }
+            }
+            let at = row.entries[0];
+            view.edit(entries, &row.entries, at, replacement);
+        }
+        HistoryRowEdit::Insert {
+            before,
+            after,
+            items,
+        } => {
+            let (at, turn_id) = position(entries, &view.rows, before.as_deref(), after.as_deref())?;
+            let (shape, items) = new_items(items, turn_id.as_deref())?;
+            if let Shape::Tool(call_id) = &shape
+                && (view.names.contains_key(call_id) || view.calls.contains_key(call_id))
+            {
+                return Err(invalid(format!("history_call_id_reused: {call_id}")));
+            }
+            let mut inserted = model_entries(items.clone(), "insert", None, edit, None);
+            if let (Some(turn_id), Some(id)) = (turn_id, items[0].id().map(ToString::to_string))
+                && let Some(item) = display_item(&items[0], &id, None)
+            {
+                inserted.push(Entry::new(
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+                        thread_id: edit.thread_id,
+                        turn_id,
+                        item,
+                        content_token_count: None,
+                        started_at_ms: None,
+                        completed_at_ms: chrono::Utc::now().timestamp_millis(),
+                    })),
+                    None,
+                ));
+            }
+            view.edit(entries, &[], at, inserted);
+        }
+        HistoryRowEdit::Move { id, before, after } => {
+            let row = find(&view.rows, id)?.clone();
+            require(&row, HistoryRowAccess::Edit)?;
+            if [before, after]
+                .into_iter()
+                .flatten()
+                .any(|anchor| anchor == &row.id || row.alias.as_ref() == Some(anchor))
+            {
+                return Err(invalid(format!(
+                    "history_move_invalid: {id} cannot move relative to itself"
+                )));
+            }
+            let source = row.id.clone();
+            let mut moved = view.edit(entries, &row.entries, 0, Vec::new());
+            let (at, turn_id) = position(entries, &view.rows, before.as_deref(), after.as_deref())?;
+            for entry in &mut moved {
+                entry.source = None;
+                match &mut entry.item {
+                    RolloutItem::ResponseItem(envelope) => {
+                        envelope
+                            .metadata
+                            .get_or_insert_with(CodexHarnessMetadata::default)
+                            .rewritten = Some(provenance("move", Some(&source), edit));
+                    }
+                    RolloutItem::EventMsg(EventMsg::ItemCompleted(event)) => {
+                        if let Some(turn_id) = &turn_id {
+                            event.turn_id = turn_id.clone();
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            view.edit(entries, &[], at, moved);
+        }
+    }
+    Ok(())
+}
+
+enum Shape {
+    Message(String),
+    Tool(String),
+}
+
+fn new_items(
+    values: &[Value],
+    turn_id: Option<&str>,
+) -> ThreadStoreResult<(Shape, Vec<ResponseItem>)> {
+    if values.is_empty() || values.len() > 2 {
+        return Err(invalid(
+            "history_items_invalid: pass one message or one tool call with its output",
+        ));
+    }
+    let mut items = Vec::with_capacity(values.len());
+    let mut kinds = Vec::with_capacity(values.len());
+    for value in values {
+        let mut value = value.clone();
+        let Some(object) = value.as_object_mut() else {
+            return Err(invalid("history_items_invalid: items must be objects"));
+        };
+        object.remove(PASSTHROUGH);
+        object.remove("id");
+        let kind = object
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or_default()
+            .to_string();
+        if !EDITABLE.contains(&kind.as_str()) {
+            return Err(invalid(format!("history_item_refused: {kind}")));
+        }
+        if kind == "message"
+            && !matches!(
+                object.get("role").and_then(Value::as_str),
+                Some("user" | "assistant" | "developer")
+            )
+        {
+            return Err(invalid(
+                "history_item_refused: message role must be user, assistant or developer",
+            ));
+        }
+        let call_id = object
+            .get("call_id")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let role = object
+            .get("role")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let mut item: ResponseItem = serde_json::from_value(value)
+            .map_err(|err| invalid(format!("history_items_invalid: {err}")))?;
+        if let Some(prefix) = item.id_prefix() {
+            item.set_id(Some(ResponseItemId::with_suffix(
+                prefix,
+                uuid::Uuid::now_v7(),
+            )));
+        }
+        if let Some(turn_id) = turn_id {
+            item.set_turn_id_if_missing(turn_id);
+        }
+        kinds.push((kind, call_id, role));
+        items.push(item);
+    }
+    let shape = match kinds.as_slice() {
+        [(kind, _, Some(role))] if kind == "message" => Shape::Message(role.clone()),
+        [(call, Some(call_id), _), (output, Some(output_id), _)]
+            if call_id == output_id
+                && matches!(
+                    (call.as_str(), output.as_str()),
+                    ("function_call" | "local_shell_call", "function_call_output")
+                        | ("custom_tool_call", "custom_tool_call_output")
+                        | ("tool_search_call", "tool_search_output")
+                ) =>
+        {
+            Shape::Tool(call_id.clone())
+        }
+        _ => {
+            return Err(invalid(
+                "history_items_unpaired: a tool row is one call followed by its output",
+            ));
+        }
+    };
+    Ok((shape, items))
+}
+
+fn provenance(op: &str, source: Option<&str>, edit: &Edit<'_>) -> Box<HistoryRewriteProvenance> {
+    Box::new(HistoryRewriteProvenance {
+        revision: edit.revision.clone(),
+        op: op.to_string(),
+        source: source.map(str::to_string),
+        by: edit.author.to_string(),
+    })
+}
+
+fn model_entries(
+    items: Vec<ResponseItem>,
+    op: &str,
+    source: Option<&str>,
+    edit: &Edit<'_>,
+    checkpoint: Option<codex_protocol::mcp::McpAttribution>,
+) -> Vec<Entry> {
+    let mut checkpoint = checkpoint;
+    items
+        .into_iter()
+        .map(|item| {
+            Entry::new(
+                RolloutItem::ResponseItem(ResponseItemEnvelope {
+                    item,
+                    metadata: Some(CodexHarnessMetadata {
+                        rewritten: Some(provenance(op, source, edit)),
+                        mcp_attribution: checkpoint.take(),
+                        ..Default::default()
+                    }),
+                }),
+                None,
+            )
+        })
+        .collect()
+}
+
+fn checkpoint(entries: &[Entry], row: &Row) -> Option<codex_protocol::mcp::McpAttribution> {
+    row.entries
+        .iter()
+        .find_map(|&index| match &entries[index].item {
+            RolloutItem::ResponseItem(envelope) => envelope
+                .metadata
+                .as_ref()
+                .and_then(|metadata| metadata.mcp_attribution.clone()),
+            _ => None,
+        })
+}
+
+fn position(
+    entries: &[Entry],
+    rows: &[Row],
+    before: Option<&str>,
+    after: Option<&str>,
+) -> ThreadStoreResult<(usize, Option<String>)> {
+    let (row, after) = match (before, after) {
+        (Some(_), Some(_)) => {
+            return Err(invalid(
+                "history_position_invalid: pass before or after, not both",
+            ));
+        }
+        (Some(before), None) => (find(rows, before)?, false),
+        (None, Some(after)) => (find(rows, after)?, true),
+        (None, None) => (
+            rows.last()
+                .ok_or_else(|| invalid("history_position_invalid: the thread has no rows"))?,
+            true,
+        ),
+    };
+    let at = if after {
+        row.entries
+            .iter()
+            .max()
+            .map_or(entries.len(), |index| index + 1)
+    } else {
+        row.entries.iter().min().copied().unwrap_or(0)
+    };
+    Ok((at, row.turn_id.clone()))
+}
+
+fn display_item(item: &ResponseItem, id: &str, existing: Option<&TurnItem>) -> Option<TurnItem> {
+    let value = item_value(item);
+    let parts = value["content"].as_array()?;
+    let (kind, content) = match value["role"].as_str()? {
+        "user" => (
+            "UserMessage",
+            parts
+                .iter()
+                .filter_map(|part| match part["type"].as_str()? {
+                    "input_text" => {
+                        Some(json!({"type": "text", "text": part["text"], "text_elements": []}))
+                    }
+                    "input_image" => {
+                        let mut image = part.clone();
+                        image["type"] = json!("image");
+                        Some(image)
+                    }
+                    "input_audio" => Some(json!({"type": "audio", "audio_url": part["audio_url"]})),
+                    _ => None,
+                })
+                .collect::<Vec<_>>(),
+        ),
+        "assistant" => (
+            "AgentMessage",
+            parts
+                .iter()
+                .filter_map(|part| part["text"].as_str())
+                .map(|text| json!({"type": "Text", "text": text}))
+                .collect(),
+        ),
+        _ => return None,
+    };
+    let mut display = existing
+        .and_then(|existing| serde_json::to_value(existing).ok())
+        .filter(|existing| existing["type"] == kind)
+        .unwrap_or_else(|| json!({"type": kind, "id": id}));
+    display["content"] = Value::Array(content);
+    if kind == "AgentMessage" {
+        display["phase"] = value["phase"].clone();
+    }
+    serde_json::from_value(display).ok()
+}
