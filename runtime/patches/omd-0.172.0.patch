@@ -0,0 +1,781 @@
+use super::*;
+use crate::app_event::AppEvent;
+use crate::bottom_pane::SearchMode;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::popup_consts::picker_hint_line_for_keymap;
+use crate::bottom_pane::popup_consts::standard_popup_hint_line;
+use crate::keymap::ListKeymap;
+use crate::omd::LockExt;
+use codex_omd::ModStore;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+
+struct ModEntry {
+    id: String,
+    scope: String,
+    enabled: bool,
+    required: bool,
+    blocked: Option<String>,
+    failure: Option<String>,
+    configuration: serde_json::Value,
+}
+
+fn first_line(text: &str) -> String {
+    text.lines()
+        .next()
+        .unwrap_or_default()
+        .chars()
+        .take(120)
+        .collect()
+}
+
+fn searchable(
+    view_id: &'static str,
+    title: &str,
+    header: Vec<Line<'static>>,
+    mut items: Vec<SelectionItem>,
+    keymap: &ListKeymap,
+) -> SelectionViewParams {
+    for item in &mut items {
+        item.search_value = Some(format!(
+            "{} {}",
+            item.name,
+            item.description.as_deref().unwrap_or_default()
+        ));
+    }
+    let mut footer = picker_hint_line_for_keymap(keymap);
+    footer
+        .spans
+        .extend([" · ".into(), "/".into(), " to search".into()]);
+    SelectionViewParams {
+        view_id: Some(view_id),
+        title: Some(title.to_string()),
+        header: Box::new(Paragraph::new(header)),
+        header_gap: 1,
+        footer_hint: Some(footer),
+        items,
+        is_searchable: true,
+        fuzzy_search: true,
+        search_mode: SearchMode::OnDemand(crate::key_hint::plain(KeyCode::Char('/'))),
+        search_placeholder: Some("Type to search".to_string()),
+        ..Default::default()
+    }
+}
+
+fn mod_entries(root: PathBuf) -> Result<Vec<ModEntry>, String> {
+    if let Some(listed) = crate::mod_runtime::remote_packages() {
+        return Ok(listed["packages"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .map(|row| ModEntry {
+                id: row["id"].as_str().unwrap_or_default().to_owned(),
+                scope: row["scope"].as_str().unwrap_or("user").to_owned(),
+                enabled: row["enabled"] == true,
+                required: row["required"] == true,
+                configuration: row.clone(),
+                blocked: row["blocked"].as_str().map(first_line),
+                failure: row["failed"].as_str().map(first_line),
+            })
+            .collect());
+    }
+    let store = ModStore::open(root.clone()).map_err(|error| error.to_string())?;
+    let configuration = crate::mod_runtime::configuration_listing(
+        codex_omd::package_controls::list(&store, None).map_err(|error| error.to_string())?,
+    )
+    .map_err(|error| error.to_string())?;
+    let runtime = crate::omd::mod_status();
+    let terminal = crate::mod_runtime::terminal_failures();
+    let status = ModStore::open(root)
+        .and_then(|store| store.selection_status())
+        .and_then(crate::mod_runtime::selection_status)
+        .map_err(|error| error.to_string())?;
+    Ok(status["selections"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|selection| {
+            selection["path"].as_str()?;
+            let failure = runtime
+                .as_ref()
+                .and_then(|runtime| {
+                    runtime["rejected"]
+                        .as_array()
+                        .into_iter()
+                        .flatten()
+                        .find(|item| item["path"] == selection["path"])
+                        .and_then(|item| item["reason"].as_str())
+                        .or_else(|| {
+                            runtime["mods"]
+                                .as_array()
+                                .into_iter()
+                                .flatten()
+                                .find(|item| item["id"] == selection["id"])
+                                .and_then(|item| item["error"].as_str())
+                        })
+                })
+                .or_else(|| terminal.get(selection["id"].as_str()?).map(String::as_str))
+                .map(first_line);
+            Some(ModEntry {
+                id: selection["id"]
+                    .as_str()
+                    .unwrap_or("unreadable_mod")
+                    .to_owned(),
+                scope: selection["scope"].as_str().unwrap_or("user").to_owned(),
+                enabled: selection["selected"] == true,
+                required: selection["required"] == true,
+                blocked: selection["error"].as_str().map(first_line),
+                failure,
+                configuration: configuration["packages"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .find(|row| {
+                        row["path"] == selection["path"] && row["scope"] == selection["scope"]
+                    })
+                    .cloned()
+                    .unwrap_or_default(),
+            })
+        })
+        .collect())
+}
+
+const ADMIN_REASON: &str = "Your administrator manages this mod";
+
+static TERMINAL_ONLY: std::sync::LazyLock<
+    std::sync::Mutex<std::collections::HashMap<(String, String), bool>>,
+> = std::sync::LazyLock::new(Default::default);
+
+fn terminal_only(entry: &ModEntry) -> bool {
+    TERMINAL_ONLY
+        .locked()
+        .get(&(entry.id.clone(), entry.scope.clone()))
+        .copied()
+        .unwrap_or_else(|| has_overrides(entry))
+}
+
+fn target_item(entry: &ModEntry) -> SelectionItem {
+    let terminal = terminal_only(entry);
+    let key = (entry.id.clone(), entry.scope.clone());
+    let name = format!("Changes apply to: {}", entry.id);
+    let selected = name.clone();
+    SelectionItem {
+        name,
+        description: Some(
+            if terminal {
+                "Only this terminal · Enter switches to every terminal"
+            } else {
+                "Every terminal · Enter switches to only this terminal"
+            }
+            .into(),
+        ),
+        actions: vec![Box::new(move |tx| {
+            TERMINAL_ONLY.locked().insert(key.clone(), !terminal);
+            tx.send(AppEvent::OmdOpenAllMods {
+                selected: Some(selected.clone()),
+            });
+        })],
+        dismiss_on_select: true,
+        ..Default::default()
+    }
+}
+
+fn shown(value: &serde_json::Value) -> String {
+    match value {
+        serde_json::Value::Null => "not set".into(),
+        serde_json::Value::String(text) => text.clone(),
+        value => value.to_string(),
+    }
+}
+
+fn setting_type(schema: &serde_json::Value) -> Option<&str> {
+    let mut types: Vec<&str> = match &schema["type"] {
+        serde_json::Value::String(kind) => vec![kind.as_str()],
+        serde_json::Value::Array(kinds) => kinds.iter().filter_map(|kind| kind.as_str()).collect(),
+        _ => Vec::new(),
+    };
+    types.retain(|kind| *kind != "null");
+    match types.as_slice() {
+        [kind @ ("string" | "number" | "integer" | "boolean")] => Some(kind),
+        _ => None,
+    }
+}
+
+fn setting_value(kind: &str, value: String) -> Result<serde_json::Value, String> {
+    let number = || "Enter a number, like 5".to_string();
+    match kind {
+        "integer" => value
+            .trim()
+            .parse::<i64>()
+            .map(serde_json::Value::from)
+            .map_err(|_| number()),
+        "number" => serde_json::from_str::<serde_json::Value>(&value)
+            .ok()
+            .filter(|value| value.is_number() && value.as_f64().is_some_and(f64::is_finite))
+            .ok_or_else(number),
+        _ => Ok(serde_json::Value::String(value)),
+    }
+}
+
+fn row_key(name: &str) -> &str {
+    name.strip_prefix("Turn on ")
+        .or_else(|| name.strip_prefix("Turn off "))
+        .unwrap_or(name)
+}
+
+fn has_overrides(entry: &ModEntry) -> bool {
+    let overrides = &entry.configuration["overrides"];
+    overrides
+        .get("enabled")
+        .is_some_and(|enabled| !enabled.is_null())
+        || overrides["settings"]
+            .as_object()
+            .is_some_and(|settings| !settings.is_empty())
+}
+
+fn setting_items(entry: &ModEntry) -> Vec<SelectionItem> {
+    let binding = crate::mod_runtime::configuration_binding();
+    let readonly = entry.scope == "managed";
+    let reason = readonly.then(|| ADMIN_REASON.to_string());
+    let terminal = terminal_only(entry);
+    let mut items = Vec::new();
+    for (name, schema) in entry.configuration["settings_schema"]["properties"]
+        .as_object()
+        .into_iter()
+        .flatten()
+    {
+        if setting_type(schema).is_none()
+            && !schema["enum"].as_array().is_some_and(|values| {
+                !values.is_empty()
+                    && values
+                        .iter()
+                        .all(|value| value.is_string() || value.is_number() || value.is_boolean())
+            })
+        {
+            continue;
+        }
+        let id = entry.id.clone();
+        let scope = entry.scope.clone();
+        let name = name.clone();
+        let current = entry.configuration["settings"][&name].clone();
+        let local = entry.configuration["overrides"]["settings"]
+            .get(&name)
+            .is_some();
+        let mut description = format!(
+            "Now: {} · Saved: {}",
+            shown(&current),
+            shown(&entry.configuration["inherited_settings"][&name])
+        );
+        if local {
+            description.push_str(" · Only this terminal");
+        }
+        let schema = schema.clone();
+        let (edit_id, edit_scope, edit_name) = (id.clone(), scope.clone(), name.clone());
+        items.push(SelectionItem {
+            name: format!("{id} · {name}"),
+            description: Some(description),
+            is_disabled: readonly,
+            disabled_reason: reason.clone(),
+            actions: vec![Box::new(move |tx| {
+                tx.send(AppEvent::OmdEditSetting {
+                    id: edit_id.clone(),
+                    scope: edit_scope.clone(),
+                    name: edit_name.clone(),
+                    schema: schema.clone(),
+                    current: current.clone(),
+                    terminal,
+                    binding,
+                })
+            })],
+            dismiss_on_select: true,
+            ..Default::default()
+        });
+        if local {
+            items.push(SelectionItem {
+                name: format!("Use saved value: {id} · {name}"),
+                description: Some("Undo this terminal's change".into()),
+                is_disabled: readonly,
+                disabled_reason: reason.clone(),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::OmdWriteSetting {
+                        id: id.clone(),
+                        scope: scope.clone(),
+                        name: name.clone(),
+                        value: None,
+                        terminal: true,
+                        binding,
+                    })
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+    }
+    items
+}
+
+fn toggle_item(entry: ModEntry, all_mods: bool) -> SelectionItem {
+    let binding = crate::mod_runtime::configuration_binding();
+    let terminal = terminal_only(&entry);
+    let state = if entry.enabled { "on" } else { "off" };
+    let mut description = format!("{state} · {} scope", entry.scope);
+    if entry.configuration["overrides"]
+        .get("enabled")
+        .is_some_and(|enabled| !enabled.is_null())
+    {
+        description.push_str(" · only this terminal");
+    }
+    if let Some(reason) = entry.failure.as_ref().or(entry.blocked.as_ref()) {
+        description.push_str(&format!(" · {reason}"));
+    }
+    let blocked = !entry.enabled && entry.blocked.is_some();
+    let required = entry.enabled && entry.required;
+    let policy = entry.scope == "managed";
+    let name = format!(
+        "{} {}",
+        if entry.enabled { "Turn off" } else { "Turn on" },
+        entry.id
+    );
+    let selected = name.clone();
+    SelectionItem {
+        name,
+        description: Some(description),
+        is_disabled: blocked || required || policy,
+        disabled_reason: if policy {
+            Some(ADMIN_REASON.into())
+        } else if required {
+            Some(format!(
+                "Oh My Diff needs this mod; turn it off from a shell with omd mods disable {}",
+                entry.id
+            ))
+        } else {
+            blocked.then(|| entry.blocked.clone().unwrap_or_default())
+        },
+        require_explicit_confirmation: true,
+        actions: vec![Box::new(move |tx| {
+            tx.send(AppEvent::OmdModToggle {
+                binding,
+                id: entry.id.clone(),
+                scope: entry.scope.clone(),
+                enabled: !entry.enabled,
+                terminal,
+                all_mods,
+                selected: selected.clone(),
+            });
+        })],
+        dismiss_on_select: true,
+        ..Default::default()
+    }
+}
+
+fn mod_items(entry: ModEntry) -> Vec<SelectionItem> {
+    let mut items = setting_items(&entry);
+    if entry.scope != "managed" && !(entry.enabled && entry.required && items.is_empty()) {
+        items.insert(0, target_item(&entry));
+    }
+    let binding = crate::mod_runtime::configuration_binding();
+    if has_overrides(&entry) {
+        let policy = entry.scope == "managed";
+        for (action, label, description) in [
+            (
+                "reset",
+                "Use saved settings",
+                "Drop the choices made only for this terminal",
+            ),
+            (
+                "save-defaults",
+                "Keep these for every terminal",
+                "Every terminal and future launches use them",
+            ),
+        ] {
+            let id = entry.id.clone();
+            let scope = entry.scope.clone();
+            items.push(SelectionItem {
+                name: format!("{label}: {id}"),
+                description: Some(description.into()),
+                require_explicit_confirmation: true,
+                is_disabled: policy,
+                disabled_reason: policy.then(|| ADMIN_REASON.into()),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::OmdConfiguration {
+                        id: id.clone(),
+                        scope: scope.clone(),
+                        action: action.into(),
+                        binding,
+                    })
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+    }
+    items.insert(0, toggle_item(entry, true));
+    items
+}
+
+fn addition_items(entries: Vec<ModEntry>, live: &[serde_json::Value]) -> Vec<SelectionItem> {
+    entries
+        .into_iter()
+        .filter(|entry| entry.enabled && entry.failure.is_none())
+        .map(|entry| {
+            let id = entry.id.as_str();
+            let owned = |hidden: bool| {
+                live.iter()
+                    .filter(move |row| row["owner"] == id && (row["hidden"] == true) == hidden)
+                    .filter_map(|row| row["command"].as_str())
+            };
+            let hidden: Vec<&str> = owned(true).collect();
+            let mut commands: Vec<&str> = owned(false).collect();
+            for declared in entry.configuration["contributes"]["commands"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|command| command["name"].as_str())
+            {
+                if !hidden.contains(&declared) && !commands.contains(&declared) {
+                    commands.push(declared);
+                }
+            }
+            let commands: Vec<&str> = commands
+                .iter()
+                .copied()
+                .filter(|name| {
+                    !name
+                        .strip_prefix(id)
+                        .and_then(|rest| rest.strip_prefix(':'))
+                        .is_some_and(|bare| commands.contains(&bare))
+                })
+                .collect();
+            let keys: Vec<&str> = entry.configuration["contributes"]["keys"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|binding| binding["key"].as_str())
+                .collect();
+            let mut parts = Vec::new();
+            if !commands.is_empty() {
+                let commands: Vec<String> =
+                    commands.iter().map(|name| format!("/{name}")).collect();
+                parts.push(format!("Commands: {}", commands.join(" ")));
+            }
+            if !keys.is_empty() {
+                parts.push(format!("Keys: {}", keys.join(" ")));
+            }
+            SelectionItem {
+                name: entry.id.clone(),
+                description: Some(if parts.is_empty() {
+                    "Works in the background".to_string()
+                } else {
+                    parts.join(" · ")
+                }),
+                ..Default::default()
+            }
+        })
+        .collect()
+}
