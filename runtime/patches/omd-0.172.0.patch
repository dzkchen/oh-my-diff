+    let manifest = json!({
+        "schema": 1, "id": id, "version": "1.0.0", "api": crate::MOD_API_VERSION, "entrypoint": "main.ts",
+        "state_version": 1, "license": "Apache-2.0", "provenance": {"maintainer": "Fixture Author", "source": "fixture"},
