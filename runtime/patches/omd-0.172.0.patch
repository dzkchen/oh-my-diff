+#[tokio::test]
+async fn terminal_interaction_during_stream_retains_context_after_process_exit() {
+    for stdin in ["input\n", ""] {
+        for complete_turn in [false, true] {
+            let (mut chat, mut events, _ops) = make_chatwidget_manual(None).await;
+            handle_turn_started(&mut chat, "turn-1");
+            let command = begin_unified_exec_startup(&mut chat, "command", "process", "cat");
+            handle_agent_message_delta(&mut chat, "Answer in progress.");
+            terminal_interaction(&mut chat, "interaction", "process", stdin);
+            end_exec(&mut chat, command, "", "", 0);
+            assert!(chat.unified_exec_processes.is_empty());
+            assert!(chat.stream_controller.is_some());
+
+            if complete_turn {
+                handle_turn_completed(&mut chat, "turn-1", None);
+            } else {
+                complete_assistant_message(
+                    &mut chat,
+                    "message",
+                    "Answer in progress. Complete.",
+                    Some(MessagePhase::Commentary),
+                );
+            }
+            assert_ne!(
+                chat.status_state.current_status.header,
+                "Waiting for background terminal"
+            );
+            chat.flush_active_cell();
+            let history = drain_insert_history_with(&mut events, |cell| {
+                let mut lines = cell.raw_lines();
+                lines.extend(cell.transcript_lines(120));
+                lines
+            });
+            let text = history
+                .iter()
+                .map(|lines| lines_to_single_string(lines))
+                .collect::<String>();
+            let action = if stdin.is_empty() {
+                "Waited for"
+            } else {
+                "Interacted with"
+            };
+            assert!(
+                text.contains(&format!("{action} background terminal: cat")),
+                "stdin={stdin:?}, complete_turn={complete_turn}: {text}"
+            );
+            assert!(
+                text.contains(&format!("{action} background terminal · cat")),
+                "stdin={stdin:?}, complete_turn={complete_turn}: {text}"
+            );
+            if !stdin.is_empty() {
+                assert!(text.contains("input"), "{text}");
+            }
+        }
+    }
+}
