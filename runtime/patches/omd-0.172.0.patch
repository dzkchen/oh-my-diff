+#[derive(Default)]
+struct BusScope(Option<String>);
+
+impl Drop for BusScope {
+    fn drop(&mut self) {
+        if let Some(scope) = &self.0
+            && let Ok(mut bus) = codex_omd::event_bus::global().lock()
+        {
+            bus.release_scope(scope);
+        }
+    }
+}
