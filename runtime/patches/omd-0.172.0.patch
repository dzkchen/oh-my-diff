+fn admit_terminal_owner(
+    thread: &mut ExtensionDataInit,
+    turn: &mut ExtensionDataInit,
+) -> CodexResult<()> {
+    let thread_owner = thread.get::<codex_protocol::turn_input::TerminalOwner>();
+    let turn_owner = turn.get::<codex_protocol::turn_input::TerminalOwner>();
+    if let (Some(thread_owner), Some(turn_owner)) = (&thread_owner, &turn_owner)
+        && thread_owner != turn_owner
+    {
+        return Err(CodexErr::InvalidRequest(
+            "terminal owner differs between thread and turn initialization".into(),
+        ));
+    }
+    let owner = thread_owner
+        .or(turn_owner)
+        .map(|owner| (*owner).clone())
+        .unwrap_or_else(|| {
+            thread.insert(codex_extension_api::ThreadOwnedTerminal::default());
+            codex_protocol::turn_input::TerminalOwner(uuid::Uuid::new_v4())
+        });
+    thread.insert(owner.clone());
+    turn.insert(owner);
+    Ok(())
+}
