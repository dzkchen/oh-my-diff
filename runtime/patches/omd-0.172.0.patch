+            serde_json::json!({"sites": {"above_composer": {"components": [
+            {"type": "button", "id": "thumb", "label": "Thumb", "text": "Open thumbnail", "action": {"command": "fixture:open"}}]}}}),
+        )?,
+        contributors: vec!["fixture".into()],
+        component_owners: [("thumb".to_string(), "fixture".to_string())].into(),
+        ..Default::default()
+    });
+    let outcome = futures::FutureExt::catch_unwind(std::panic::AssertUnwindSafe(
+        tab_stays_with_the_composer(&mut app, &mut tui, &mut app_server, thread_id),
+    ))
+    .await;
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
