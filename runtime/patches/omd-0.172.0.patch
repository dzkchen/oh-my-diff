+    pub(super) async fn enqueue_user_turn_submission(
+        &mut self,
+        thread_id: ThreadId,
+        event: Arc<crate::app_event::UserTurnSubmissionResult>,
+    ) {
+        let (sender, store) = {
+            let Some(channel) = self.thread_event_channels.get(&thread_id) else {
+                return;
+            };
+            (channel.sender.clone(), Arc::clone(&channel.store))
+        };
+
+        let should_send = {
+            let mut guard = store.lock().await;
+            if !guard.active {
+                guard.push_buffered_event(ThreadBufferedEvent::UserTurnSubmission(event.clone()));
+            }
+            guard.active
+        };
+
+        if should_send {
+            match sender.try_send(ThreadBufferedEvent::UserTurnSubmission(event)) {
+                Ok(()) => {}
+                Err(TrySendError::Full(event)) => {
+                    tokio::spawn(async move {
+                        if let Err(err) = sender.send(event).await {
+                            tracing::warn!("thread {thread_id} event channel closed: {err}");
+                        }
+                    });
+                }
+                Err(TrySendError::Closed(_)) => {
+                    tracing::warn!("thread {thread_id} event channel closed");
+                }
+            }
+        }
+    }
