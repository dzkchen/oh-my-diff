+    std::fs::set_permissions(&admin.policy, std::fs::Permissions::from_mode(0o666)).unwrap();
+    let tampered = host
+        .set_managed_policy(admin.policy.clone(), admin.owner, "alice")
+        .unwrap_err()
+        .to_string();
+    assert!(
+        tampered.starts_with("managed_policy_untrusted"),
