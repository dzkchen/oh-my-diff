+use super::*;
+use codex_omd::ModOpenOptions;
+use pretty_assertions::assert_eq;
+
+#[test]
+#[serial_test::serial]
+fn terminal_publication_excludes_context_transition_and_invalidation() {
+    let active_context = ACTIVE_CONTEXT.capture();
+    let root = tempfile::tempdir().unwrap();
+    let context = ModContext {
+        thread_id: Some(ThreadId::new()),
+        repository: root.path().to_path_buf(),
+        policy: FileSystemSandboxPolicy::unrestricted(),
+    };
+    active_context.locked().synchronize(context.clone());
+    let invocation = active_context.locked().join(context.clone());
+    let mut next = context.clone();
+    next.thread_id = Some(ThreadId::new());
+    let actions = Mutex::new(Vec::new());
+    let (ready, started) = std::sync::mpsc::channel();
+    let (release, released) = std::sync::mpsc::channel();
+    let (changing, attempted) = std::sync::mpsc::channel();
+    let blocked = std::thread::scope(|scope| {
+        let active_context = &active_context;
+        let actions = &actions;
+        let invocation = &invocation;
+        let publisher_context = active_context.clone();
+        let publisher = scope.spawn(move || {
+            ACTIVE_CONTEXT.replace(publisher_context);
+            assert!(publish_for_context(invocation, || {
+                ready.send(()).unwrap();
+                released.recv().unwrap();
+                actions.locked().push("old preview");
+            }));
+        });
+        started.recv_timeout(Duration::from_secs(5)).unwrap();
+        let blocked = active_context.try_lock().is_err();
+        let updater = scope.spawn(move || {
+            changing.send(()).unwrap();
+            active_context.locked().synchronize(next);
+            actions.locked().push("new context");
+            actions.locked().push("invalidation");
+        });
+        attempted.recv_timeout(Duration::from_secs(5)).unwrap();
+        release.send(()).unwrap();
+        publisher.join().unwrap();
+        updater.join().unwrap();
+        blocked
+    });
+    assert!(blocked);
+    assert_eq!(
+        *actions.locked(),
+        ["old preview", "new context", "invalidation"]
+    );
+    assert!(!publish_for_context(&invocation, || panic!(
+        "stale publication"
+    )));
+    active_context.locked().synchronize(context.clone());
+    let previous = active_context.locked().join(context.clone());
+    active_context.locked().begin(context);
+    assert!(!publish_for_context(&previous, || panic!(
+        "superseded publication"
+    )));
+}
