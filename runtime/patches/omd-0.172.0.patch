+            .unwrap()
+            .file_system_sandbox_policy();
+        assert!(policy.include_platform_defaults());
+        assert!(policy.entries.contains(&denial));
+        assert!(!policy.can_read_local_path_with_cwd(&denied, &root));
+        let output = crate::generic_host::sandboxed_command(
+            &policy,
+            &root,
+            &[],
+            vec![
+                "/bin/sh".into(),
+                "-c".into(),
+                "if cat \"$1\"; then exit 19; fi; printf sandbox-ok".into(),
+                "check".into(),
+                outside_file.display().to_string(),
+            ],
+            &codex_omd::host::ExecAccess {
+                write: true,
+                loopback: false,
+                unix_sockets: &[],
+                scratch: &root,
+            },
+        )
+        .unwrap()
+        .output()
+        .unwrap();
+        assert!(output.status.success(), "{output:?}");
+        assert_eq!(output.stdout, b"sandbox-ok");
+    }
+
+    #[test]
+    fn protected_host_paths_stay_unreadable_even_under_an_unrestricted_session() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let repository = root.join("repo");
+        let protected = root.join("omd-data");
+        std::fs::create_dir(&repository).unwrap();
+        std::fs::create_dir(&protected).unwrap();
+        std::fs::write(protected.join("secret"), "host-only").unwrap();
+        let output = crate::generic_host::sandboxed_command(
+            &FileSystemSandboxPolicy::unrestricted(),
+            &repository,
+            std::slice::from_ref(&protected),
+            vec![
+                "/bin/sh".into(),
+                "-c".into(),
+                "if cat \"$1\"; then exit 19; fi; printf sandbox-ok".into(),
+                "check".into(),
+                protected.join("secret").display().to_string(),
+            ],
+            &codex_omd::host::ExecAccess {
+                write: false,
+                loopback: false,
+                unix_sockets: &[],
+                scratch: &repository,
+            },
+        )
+        .unwrap()
+        .output()
+        .unwrap();
+        assert!(output.status.success(), "{output:?}");
+        assert_eq!(output.stdout, b"sandbox-ok");
+    }
+
+    #[test]
+    fn sandboxed_commands_reach_only_granted_unix_sockets() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let socket = root.join("integration.sock");
+        let _listener = std::os::unix::net::UnixListener::bind(&socket).unwrap();
+        for granted in [false, true] {
+            let sockets = if granted {
+                vec![socket.clone()]
+            } else {
+                Vec::new()
+            };
+            let status = crate::generic_host::sandboxed_command(
+                &FileSystemSandboxPolicy::unrestricted(),
+                &root,
+                &[],
+                vec![
+                    "/usr/bin/perl".into(),
+                    "-MIO::Socket::UNIX".into(),
+                    "-e".into(),
+                    "exit !IO::Socket::UNIX->new(Peer => shift)".into(),
+                    socket.display().to_string(),
+                ],
+                &codex_omd::host::ExecAccess {
+                    write: false,
+                    loopback: false,
+                    unix_sockets: &sockets,
+                    scratch: &root,
+                },
+            )
+            .unwrap()
+            .status()
+            .unwrap();
+            assert_eq!(status.success(), granted);
+        }
+    }
+}
+
+#[cfg(test)]
+mod shutdown_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn owned_shutdown_finishes_after_its_waiter_is_cancelled() {
+        let resource = tempfile::tempdir().unwrap();
+        let path = resource.path().to_path_buf();
+        let (release_job, wait_job) = std::sync::mpsc::channel();
+        let (job_started, job_start) = tokio::sync::oneshot::channel();
+        let job = tokio::task::spawn_blocking(move || {
+            job_started.send(()).unwrap();
+            let _ = wait_job.recv();
+        });
+        job_start.await.unwrap();
+        job.abort();
+        let (stop_started, mut stop_start) = tokio::sync::oneshot::channel();
+        let (release_stop, wait_stop) = tokio::sync::oneshot::channel();
+        let (stopped, stop_done) = tokio::sync::oneshot::channel();
+        let cleanup = owned_shutdown(
+            &tokio::runtime::Handle::current(),
+            Some(job),
+            async move {
+                stop_started.send(()).unwrap();
+                wait_stop.await.unwrap();
+                stopped.send(()).unwrap();
+            },
+            resource,
+        );
+        let waiter = tokio::spawn(cleanup);
+        waiter.abort();
+        assert!(waiter.await.unwrap_err().is_cancelled());
+        assert!(path.exists());
+        assert!(stop_start.try_recv().is_err());
+        release_job.send(()).unwrap();
+        stop_start.await.unwrap();
+        assert!(path.exists());
+        release_stop.send(()).unwrap();
+        stop_done.await.unwrap();
+        tokio::time::timeout(Duration::from_secs(5), async {
+            while path.exists() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+}
