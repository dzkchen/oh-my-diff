+        sent(&shared[0]),
+        AppEvent::OmdModToggle {
+            terminal: false,
+            ..
+        }
+    ));
+    assert!(matches!(
+        sent(&shared[2]),
+        AppEvent::OmdEditSetting {
+            terminal: false,
+            ..
+        }
+    ));
+    assert!(
+        matches!(sent(&shared[1]), AppEvent::OmdOpenAllMods { selected: Some(selected) } if selected == "Changes apply to: target_fixture")
+    );
+    let terminal = mod_items(entry(serde_json::json!({"settings":{}})));
+    assert!(matches!(
+        sent(&terminal[0]),
+        AppEvent::OmdModToggle { terminal: true, .. }
+    ));
+    assert!(matches!(
+        sent(&terminal[2]),
+        AppEvent::OmdEditSetting { terminal: true, .. }
+    ));
+    sent(&terminal[1]);
+
+    let own = mod_items(entry(serde_json::json!({"enabled":false,"settings":{}})));
+    TERMINAL_ONLY.locked().clear();
+    let own_default = mod_items(entry(serde_json::json!({"enabled":false,"settings":{}})));
+    assert_eq!(
+        names(&own_default)[3..],
+        [
+            "Use saved settings: target_fixture",
+            "Keep these for every terminal: target_fixture"
+        ]
+    );
+    assert!(
