+static COMMANDS_RUNNING: Mutex<usize> = Mutex::new(0);
+static COMMANDS_SETTLED: Condvar = Condvar::new();
+static RERENDER_DEFERRED: AtomicBool = AtomicBool::new(false);
+const COMMAND_RENDER_DEFERRAL: Duration = Duration::from_millis(250);
+
+pub(crate) struct RunningCommand;
+
+impl RunningCommand {
+    pub(crate) fn enter() -> Self {
+        *COMMANDS_RUNNING.locked() += 1;
+        Self
+    }
+}
+
+impl Drop for RunningCommand {
+    fn drop(&mut self) {
+        let mut running = COMMANDS_RUNNING.locked();
+        *running = running.saturating_sub(1);
+        if *running == 0 {
+            COMMANDS_SETTLED.notify_all();
+        }
+    }
+}
+
+/// A view render requested while a command runs is coalesced until the command settles or a bound passes, so the two never compete for runners.
+fn defer_while_command_runs() -> bool {
+    if *COMMANDS_RUNNING.locked() == 0 {
+        return false;
+    }
+    if !RERENDER_DEFERRED.swap(true, Ordering::AcqRel) {
+        std::thread::spawn(|| {
+            let deadline = Instant::now() + COMMAND_RENDER_DEFERRAL;
+            let mut running = COMMANDS_RUNNING.locked();
+            while *running > 0 {
+                let left = deadline.saturating_duration_since(Instant::now());
+                if left.is_zero() {
+                    break;
+                }
+                running = match COMMANDS_SETTLED.wait_timeout(running, left) {
+                    Ok((running, _)) => running,
+                    Err(poisoned) => poisoned.into_inner().0,
+                };
+            }
+            drop(running);
+            RERENDER_DEFERRED.store(false, Ordering::Release);
+            if let Some(context) = active_context() {
+                render_for(context, &|| true);
+            }
+        });
+    }
+    true
+}
+
+impl ActiveContext {
+    fn synchronize(&mut self, context: ModContext) -> bool {
+        if self.context.as_ref() == Some(&context) {
+            return false;
+        }
+        self.context = Some(context);
+        self.epoch = self.epoch.saturating_add(1);
+        self.sequence = 0;
+        true
+    }
+
+    fn begin(&mut self, context: ModContext) -> ModInvocation {
+        self.synchronize(context.clone());
+        self.sequence = self.sequence.saturating_add(1);
+        ModInvocation {
+            context,
+            epoch: self.epoch,
+            sequence: self.sequence,
+        }
+    }
+
+    fn join(&mut self, context: ModContext) -> ModInvocation {
+        self.synchronize(context.clone());
+        ModInvocation {
+            context,
+            epoch: self.epoch,
+            sequence: self.sequence,
+        }
+    }
+
+    fn current(&self, invocation: &ModInvocation) -> bool {
+        self.epoch == invocation.epoch
+            && self.sequence == invocation.sequence
+            && self.context.as_ref() == Some(&invocation.context)
+    }
+}
+
+pub(crate) fn synchronize_context(context: ModContext) -> bool {
+    ACTIVE_CONTEXT.with(|active_context_state| {
+        let mut active = active_context_state.locked();
+        let changed = active.synchronize(context);
+        sync_pty_context(&active);
+        changed
+    })
+}
+
+pub(crate) fn begin(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT.with(|active_context_state| {
+        let mut active = active_context_state.locked();
+        let invocation = active.begin(context);
+        sync_pty_context(&active);
+        invocation
+    })
+}
+
+/// Shares the current invocation, so a nested or intercepted command never supersedes the command running it.
+pub(crate) fn join(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT.with(|active_context_state| {
+        let mut active = active_context_state.locked();
+        let invocation = active.join(context);
+        sync_pty_context(&active);
+        invocation
+    })
+}
+
+fn sync_pty_context(active: &ActiveContext) {
+    codex_omd::client_surface::set_epoch(active.epoch);
+    crate::mod_pty::context(
+        active.epoch,
+        active
+            .context
+            .as_ref()
+            .and_then(|context| context.thread_id.map(|id| id.to_string())),
+    );
+}
+
+pub(crate) fn current(invocation: &ModInvocation) -> bool {
+    ACTIVE_CONTEXT.with(|active_context_state| active_context_state.locked().current(invocation))
+}
+
+pub(crate) fn context_unchanged() -> (u64, impl Fn() -> bool + Send + Sync + 'static) {
+    #[cfg(test)]
+    {
+        let context = ACTIVE_CONTEXT.capture();
+        let epoch = context.locked().epoch;
+        (epoch, move || context.locked().epoch == epoch)
+    }
+    #[cfg(not(test))]
+    {
+        let epoch = ACTIVE_CONTEXT.with(|state| state.locked().epoch);
+        (epoch, move || {
+            ACTIVE_CONTEXT.with(|state| state.locked().epoch == epoch)
+        })
+    }
+}
+
+pub(crate) fn active_context() -> Option<ModContext> {
+    ACTIVE_CONTEXT.with(|active_context_state| active_context_state.locked().context.clone())
+}
