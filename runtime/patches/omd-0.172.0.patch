+/// The completion is replayed when its thread is displayed again; the receipt applies only now.
+fn split_submission_result(
+    op: AppCommand,
+    ordinary: bool,
+    result: std::result::Result<
+        (UserMessageAdmission, Option<CloudTurnSettings>),
+        UserMessageSubmissionFailure,
+    >,
+) -> (UserTurnSubmissionResult, UserTurnSubmissionReceipt) {
+    let (result, kind) = match result {
+        Ok((admission, selection)) => {
+            let outcome = match &admission {
+                UserMessageAdmission::Started(id) | UserMessageAdmission::StartResponse(id) => {
+                    UserTurnSubmissionOutcome::Started(id.clone())
+                }
+                UserMessageAdmission::Steered(_) | UserMessageAdmission::Duplicate => {
+                    UserTurnSubmissionOutcome::Steered
+                }
+                UserMessageAdmission::Queued(message) => {
+                    UserTurnSubmissionOutcome::RejectedSteer(codex_app_server_protocol::TurnError {
+                        message: message.clone(),
+                        codex_error_info: None,
+                        additional_details: None,
+                        misalignment: None,
+                    })
+                }
+            };
+            (
+                Ok(outcome),
+                UserTurnSubmissionReceiptKind::Admitted(admission, selection),
+            )
+        }
+        Err(UserMessageSubmissionFailure::Preflight(message)) => (
+            Err(Arc::new(color_eyre::eyre::eyre!(message.clone()))),
+            UserTurnSubmissionReceiptKind::Preflight(message),
+        ),
+        Err(UserMessageSubmissionFailure::Rejected(error)) => (
+            Err(Arc::new(error)),
+            UserTurnSubmissionReceiptKind::Rejected,
+        ),
+        Err(UserMessageSubmissionFailure::Unconfirmed { error, reconnect }) => (
+            Err(Arc::new(error)),
+            UserTurnSubmissionReceiptKind::Unconfirmed { reconnect },
+        ),
+        Err(UserMessageSubmissionFailure::Unhandled(error)) => (
+            Err(Arc::new(error)),
+            UserTurnSubmissionReceiptKind::Unhandled,
+        ),
+    };
+    (
+        UserTurnSubmissionResult { op, result },
+        UserTurnSubmissionReceipt { ordinary, kind },
+    )
+}
