+                .call(
+                    ProcessOwner {
+                        os_access: None,
+                        blit: None,
+                        ..owner
+                    },
+                    "process.status",
+                    json!({"session":"tree"}),
+                    || true
+                )
+                .unwrap_err(),
+            "grant_expired: os"
+        );
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while alive() && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        assert!(!alive(), "revoking the grant kills the whole process group");
+    }
