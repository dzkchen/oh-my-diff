+pub(crate) fn configuration_context_for(
+    binding: ConfigurationBinding,
+    owner: Option<String>,
+    thread: Option<String>,
+) -> Result<ConfigurationContext, String> {
+    let _binding = FRONTEND_APPLY.locked();
+    if !configuration_binding_current(binding) {
+        return Err("terminal_context_changed".into());
+    }
+    if owner.is_some() && owner != configuration_owner_id() {
+        return Err("terminal_context_changed".into());
+    }
+    Ok(ConfigurationContext {
+        binding,
+        runtime: shared_host()?,
+        paths: crate::omd::mod_paths().ok_or("mods are not configured for this session")?,
+        owner,
+        thread,
+        epoch: codex_omd::client_surface::epoch(),
+        remote: remote_frontend_active(),
+    })
+}
