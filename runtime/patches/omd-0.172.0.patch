+const RESETTABLE: &[&str] = &["host.json", "mods.json"];
+
+struct Installed {
+    owner: Arc<()>,
+    core: std::sync::Weak<Core>,
+    _roster: codex_omd::client_surface::Registration,
+}
+
+static INSTALLED: Mutex<Option<Installed>> = Mutex::new(None);
+
+pub(super) struct Registration {
+    owner: Arc<()>,
+    _dispatcher: codex_omd::host::SessionRegistration,
+}
+
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let mut installed = INSTALLED
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if installed
+            .as_ref()
+            .is_some_and(|current| Arc::ptr_eq(&current.owner, &self.owner))
+        {
+            *installed = None;
+            drop(installed);
+            OWNERS
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clear();
+            CLIENT_OWNERS
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clear();
+            SESSION_OWNERS
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clear();
+        }
+    }
+}
+
+/// Runs requested work on one thread at a time; requests during a run cause one trailing run.
+struct Coalesce {
+    running: AtomicBool,
+    dirty: AtomicBool,
+}
+
+impl Coalesce {
+    const fn new() -> Self {
+        Self {
+            running: AtomicBool::new(false),
+            dirty: AtomicBool::new(false),
+        }
+    }
+
+    fn request(&'static self, work: impl Fn() + Send + 'static) {
+        self.dirty.store(true, Ordering::Release);
+        if !self.running.swap(true, Ordering::AcqRel) {
+            std::thread::spawn(move || self.drain(work));
+        }
+    }
+
+    fn drain(&self, work: impl Fn()) {
+        loop {
+            while self.dirty.swap(false, Ordering::AcqRel) {
+                work();
+            }
+            self.running.store(false, Ordering::Release);
+            if !self.dirty.load(Ordering::Acquire) || self.running.swap(true, Ordering::AcqRel) {
+                return;
+            }
+        }
+    }
+}
+
+static REPUBLISH: Coalesce = Coalesce::new();
+static STATE_REPUBLISH: Coalesce = Coalesce::new();
+static STATE_WRITES: Mutex<std::collections::BTreeSet<(String, u64)>> =
+    Mutex::new(std::collections::BTreeSet::new());
+
+fn all_cores() -> Vec<Arc<Core>> {
+    let mut cores = OWNERS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .values()
+        .map(|owner| owner.core.clone())
+        .collect::<Vec<_>>();
+    if let Ok(core) = self::core() {
+        cores.push(core);
+    }
+    cores
+}
+
+/// Redraws every other terminal owner running a mod whose saved state changed.
+fn republish_state_writes() {
+    let writes = std::mem::take(
+        &mut *STATE_WRITES
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner),
+    );
+    for core in all_cores() {
+        let stale = core.runtime.lock().is_ok_and(|runtime| {
+            writes.iter().any(|(id, terminal)| {
+                *terminal != runtime.terminal() && runtime.grants(id).is_some()
+            })
+        });
+        if stale {
+            republish(&core);
+        }
+    }
+}
+
+pub(super) fn install(
+    core: &Arc<Core>,
+    dispatcher: codex_omd::host::SessionRegistration,
+) -> Result<Registration, String> {
+    let mut installed = INSTALLED.lock().map_err(|_| "host_installation_poisoned")?;
+    if installed.is_some() {
+        return Err("host_already_installed".into());
+    }
+    let owner = Arc::new(());
+    let roster =
+        codex_omd::client_surface::register_observer(Arc::new(|observed| match observed {
+            codex_omd::client_surface::Observed::Roster
+            | codex_omd::client_surface::Observed::Client => REPUBLISH.request(|| {
+                for core in all_cores() {
+                    republish(&core);
+                }
+            }),
+            codex_omd::client_surface::Observed::State { mod_id, terminal } => {
+                STATE_WRITES
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .insert((mod_id, terminal));
+                STATE_REPUBLISH.request(republish_state_writes);
+            }
+            _ => {}
+        }));
+    *installed = Some(Installed {
+        owner: owner.clone(),
+        core: Arc::downgrade(core),
+        _roster: roster,
+    });
+    Ok(Registration {
+        owner,
+        _dispatcher: dispatcher,
+    })
+}
+
+/// Renders the view again so mods see the changed roster, keeping the last published event.
+fn republish(core: &Core) {
+    let Some(snapshot) = core.views.published() else {
+        return;
+    };
+    let event = snapshot.input["event"].as_str().unwrap_or("start");
+    let lead = core.expansion.current();
+    let _thread = codex_omd::StateThread::enter(lead.as_ref().map(|lead| lead.thread.to_string()));
+    let ledger = lead.as_ref().map_or(Value::Null, Lead::ledger);
+    if let Ok(mut runtime) = core.runtime.lock() {
+        publish(
+            &mut runtime,
+            &core.host,
+            &core.views,
+            core.terminal_owner.as_deref(),
+            event,
+            ledger,
+            || true,
+        );
+    }
+}
