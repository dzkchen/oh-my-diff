+        pending.recv_timeout(std::time::Duration::from_secs(10))
+    })
+    .await
+    .unwrap();
+    assert!(reply.unwrap().unwrap()["config"].is_object());
+    assert!(rx.try_recv().is_err());
+    drop(parked);
+    let _queued = submit();
+    assert!(matches!(rx.try_recv(), Ok(AppEvent::ModSurfaceCall(..))));
+}
+
+#[tokio::test(flavor = "multi_thread")]
+#[serial_test::serial]
+async fn package_surface_authority_probe_does_not_cancel_its_own_generation() {
+    let (_directory, store, _) = surface_package();
+    let _environment = crate::omd::tests::omd_environment(store.root());
+    let _host = crate::mod_runtime::test_fresh_host();
+    let previous = STATE.locked().take();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    attach(&AppEventSender::new(tx), Some("surface-thread".into()));
+    let paths = crate::omd::mod_paths().unwrap();
+    let runtime = crate::mod_runtime::shared_host().unwrap();
+    let generation = runtime.locked().generation();
+    let grants = runtime.locked().grants("surface_fixture").unwrap();
+    let revision = store.configuration().unwrap().revision;
+    let worker = std::thread::spawn(move || {
+        let scope = crate::mod_runtime::CallScope {
+            terminal_owner: None,
+            epoch: codex_omd::client_surface::epoch(),
+            context: InvocationContext::User,
+            thread: None,
+            active: Arc::new(|| true),
+        };
+        host_call(
+            &paths,
+            &codex_protocol::permissions::FileSystemSandboxPolicy::read_only(),
+            Some(grants),
+            "surface_fixture",
+            codex_omd::ModHostCall {
+                operation: "packages.apply".into(),
+                arguments: json!({"id":"surface_fixture","action":"disable","target":"terminal","expected_generation":revision}),
+            },
+            &scope,
+        )
+    });
+    let event = tokio::time::timeout(std::time::Duration::from_secs(3), rx.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    let AppEvent::ModSurfaceCall(call, _) = event else {
+        panic!("package surface call");
+    };
+    assert!(call.lifetime.active());
+    assert_eq!(runtime.locked().generation(), generation);
+    call.reply.send(Ok(json!({"status":"applied"}))).unwrap();
+    assert_eq!(worker.join().unwrap().unwrap()["status"], "applied");
+    *STATE.locked() = previous;
+}
