+struct ContributedReviewer(
+    codex_utils_absolute_path::AbsolutePathBuf,
+    codex_utils_absolute_path::AbsolutePathBuf,
+    codex_protocol::turn_input::TerminalOwner,
+    Arc<std::sync::atomic::AtomicBool>,
+);
+
+impl codex_extension_api::AgentRoleContributor for ContributedReviewer {
+    fn offered_agent_roles(
+        &self,
+        _thread_store: &codex_extension_api::ExtensionData,
+        _turn_store: &codex_extension_api::ExtensionData,
+    ) -> Vec<codex_extension_api::ContributedAgentRole> {
+        Vec::new()
+    }
+
+    fn resolve_agent_role(
+        &self,
+        _thread_store: &codex_extension_api::ExtensionData,
+        turn_store: Option<&codex_extension_api::ExtensionData>,
+        name: &str,
+    ) -> Option<codex_extension_api::ContributedAgentRole> {
+        (self.3.load(std::sync::atomic::Ordering::Acquire)
+            && name == "ext/reviewer"
+            && turn_store
+                .and_then(
+                    codex_extension_api::ExtensionData::get::<
+                        codex_protocol::turn_input::TerminalOwner,
+                    >,
+                )
+                .as_deref()
+                == Some(&self.2))
+        .then(|| codex_extension_api::ContributedAgentRole {
+            name: name.to_owned(),
+            description: "Reviews diffs".into(),
+            config_file: self.0.to_path_buf(),
+            cwd: Some(self.1.clone()),
+        })
+    }
+}
