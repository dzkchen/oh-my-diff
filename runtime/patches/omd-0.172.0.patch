+#[cfg(target_os = "macos")]
+#[cfg(target_os = "macos")]
+pub(crate) fn seatbelt_command(
+    manager: codex_sandboxing::SandboxManager,
+    permissions: &codex_protocol::models::PermissionProfile,
+    argv: Vec<String>,
+    cwd: &Path,
+    managed_network: Option<ManagedNetworkSandboxContext>,
+) -> Result<Vec<String>, String> {
+    use codex_protocol::config_types::WindowsSandboxLevel;
+    use codex_sandboxing::SandboxCommand;
+    use codex_sandboxing::SandboxNetwork;
+    use codex_sandboxing::SandboxSelection;
+    use codex_sandboxing::SandboxTransformRequest;
+    use codex_sandboxing::SandboxType;
+    let (program, args) = argv.split_first().ok_or("exec_command_empty")?;
+    let cwd = codex_utils_path_uri::PathUri::from_host_native_path(cwd)
+        .map_err(|error| error.to_string())?;
+    let enforce_managed_network = managed_network.is_some();
+    let wrapped = manager
+        .transform(SandboxTransformRequest {
+            command: SandboxCommand {
+                program: program.into(),
+                args: args.to_vec(),
+                cwd: cwd.clone(),
+                env: Default::default(),
+                managed_network,
+                additional_permissions: None,
+            },
+            permissions,
+            workspace_roots: Some(&[]),
+            selection: SandboxSelection::Explicit(SandboxType::MacosSeatbelt),
+            network: SandboxNetwork::new(enforce_managed_network, None, None),
+            sandbox_policy_cwd: &cwd,
+            executables: codex_sandboxing::SandboxExecutables::Launcher(None),
+            use_legacy_landlock: false,
+            windows_sandbox_level: WindowsSandboxLevel::Disabled,
+        })
+        .map_err(|error| error.to_string())?;
+    Ok(wrapped
+        .into_command_request()
+        .map_err(|error| error.to_string())?
+        .command)
+}
+
+pub(crate) fn read_policy(
+    policy: &FileSystemSandboxPolicy,
+    scratch: &Path,
+) -> Result<FileSystemSandboxPolicy, String> {
+    if policy.kind == FileSystemSandboxKind::ExternalSandbox {
+        return Err("managed_process_requires_native_sandbox".into());
+    }
+    let mut result = if policy.kind == FileSystemSandboxKind::Unrestricted {
+        FileSystemSandboxPolicy::read_only()
+    } else {
+        FileSystemSandboxPolicy::restricted(
+            policy
+                .entries
+                .iter()
+                .cloned()
+                .map(|mut entry| {
+                    if entry.access == FileSystemAccessMode::Write {
+                        entry.access = FileSystemAccessMode::Read;
+                    }
+                    entry
+                })
+                .collect(),
+        )
+    };
+    let path =
+        AbsolutePathBuf::from_absolute_path_checked(scratch).map_err(|error| error.to_string())?;
+    result.entries.push(FileSystemSandboxEntry::new(
+        FileSystemPath::Path { path: path.into() },
+        FileSystemAccessMode::Write,
+    ));
+    Ok(result)
+}
+
+fn program(name: &str, repository: &Path) -> Option<PathBuf> {
+    if name.is_empty()
+        || name.len() > 64
+        || !name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return None;
+    }
+    std::env::split_paths(&std::env::var_os("PATH")?).find_map(|directory| {
+        let candidate = directory.join(name).canonicalize().ok()?;
+        (candidate.is_file() && !codex_omd::agent_writable(&candidate, repository))
+            .then_some(candidate)
+    })
+}
