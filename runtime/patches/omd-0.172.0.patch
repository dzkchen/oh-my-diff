+#[cfg(test)]
+pub(crate) fn remote_frontend(remote: bool) {
+    let _binding = FRONTEND_APPLY.locked();
+    reset_frontend(remote);
+    FRONTEND_GENERATION.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
