+struct Knobs {
+    ascii: bool,
+    mouse_off: bool,
+    header_off: bool,
+    plain_composer: bool,
+}
+
+/// The launcher's `OMD_TUI_*` knobs, read once: they are consulted on every frame.
+fn knobs() -> &'static Knobs {
+    static KNOBS: std::sync::OnceLock<Knobs> = std::sync::OnceLock::new();
+    KNOBS.get_or_init(|| {
+        let is = |name: &str, value: &str| std::env::var(name).as_deref() == Ok(value);
+        Knobs {
+            ascii: is("OMD_TUI_ASCII", "1"),
+            mouse_off: is("OMD_TUI_MOUSE", "off"),
+            header_off: is("OMD_TUI_HEADER", "off"),
+            plain_composer: is("OMD_TUI_COMPOSER", "plain"),
+        }
+    })
+}
+
+pub(crate) fn unicode_supported() -> bool {
+    !knobs().ascii && locale_supports_unicode()
+}
+
+pub(crate) fn mouse_enabled() -> bool {
+    terminal_active() && !knobs().mouse_off
+}
+
+pub(crate) fn session_header_shown() -> bool {
+    !knobs().header_off
+}
+
+pub(crate) fn plain_composer() -> bool {
+    knobs().plain_composer
+}
+
+fn locale_supports_unicode() -> bool {
+    ["LC_ALL", "LC_CTYPE", "LANG"]
+        .into_iter()
+        .filter_map(|name| std::env::var(name).ok())
+        .find(|value| !value.is_empty())
+        .is_none_or(|value| {
+            let normalized = value.to_ascii_lowercase();
+            normalized.contains("utf-8") || normalized.contains("utf8")
+        })
+}
+
+pub(crate) fn visual_input(text: &str) -> Cow<'_, str> {
+    let glyphs = crate::mod_ui::glyphs();
+    mod_glyphs(text, &glyphs)
+}
+
+fn mod_glyphs<'a>(
+    text: &'a str,
+    glyphs: &std::collections::BTreeMap<String, String>,
+) -> Cow<'a, str> {
+    if !glyphs.keys().any(|source| text.contains(source.as_str())) {
+        return Cow::Borrowed(text);
+    }
+    let mut ordered = glyphs.iter().collect::<Vec<_>>();
+    ordered.sort_by_key(|(source, _)| std::cmp::Reverse(source.len()));
+    let mut rendered = String::with_capacity(text.len());
+    let mut remaining = text;
+    'outer: while !remaining.is_empty() {
+        for (source, display) in &ordered {
+            if let Some(rest) = remaining.strip_prefix(source.as_str()) {
+                rendered.push_str(display);
+                remaining = rest;
+                continue 'outer;
+            }
+        }
+        if let Some(character) = remaining.chars().next() {
+            rendered.push(character);
+            remaining = &remaining[character.len_utf8()..];
+        }
+    }
+    Cow::Owned(rendered)
+}
+
+/// The newest session directory, rescanned only when `sessions/` gains or loses an entry.
+fn latest_session(root: &Path) -> Option<PathBuf> {
+    type Cached = (PathBuf, FileStamp, Option<PathBuf>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let sessions = root.join("sessions");
+    let stamp = file_stamp(&sessions)?;
+    let mut cache = CACHE.locked();
+    if let Some((cached_root, cached, latest)) = cache.as_ref()
+        && *cached_root == sessions
+        && *cached == stamp
+    {
+        return latest.clone();
+    }
+    let latest = std::fs::read_dir(&sessions)
+        .ok()?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path);
+    *cache = Some((sessions, stamp, latest.clone()));
+    latest
+}
+
+/// The label of `session`'s `contract.json`, re-read only when its stamp changes.
+fn contract_label(session: &Path) -> Option<String> {
+    type Cached = (PathBuf, Option<FileStamp>, Option<String>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let path = session.join("contract.json");
+    let stamp = file_stamp(&path);
+    let mut cache = CACHE.locked();
+    if let Some((cached_path, cached, label)) = cache.as_ref()
+        && *cached_path == path
+        && *cached == stamp
+    {
+        return label.clone();
+    }
+    let contract = bounded_read(&path, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or(Value::Null);
+    let label = match (contract["status"].as_str(), contract["active"].as_object()) {
+        (Some("active"), Some(active)) => Some(format!(
+            "{}@{} ({})",
+            active
+                .get("id")
+                .and_then(Value::as_str)
+                .unwrap_or("unknown"),
+            active
+                .get("version")
+                .and_then(Value::as_u64)
+                .unwrap_or_default(),
+            active
+                .get("assurance")
+                .and_then(Value::as_str)
+                .unwrap_or("unlabelled")
+        )),
+        (Some(status), _) if status != "none" => Some(status.to_string()),
+        _ => None,
+    };
+    *cache = Some((path, stamp, label.clone()));
+    label
+}
+
+fn snapshot_with_status(status: &Value) -> Result<Snapshot, String> {
+    let (active_mods, failed_mods) = codex_omd::mod_counts(status);
+    let contract = if crate::mod_runtime::remote_frontend_active() {
+        None
+    } else {
+        let paths = mod_paths().ok_or_else(|| "Oh My Diff mod host is not active".to_string())?;
+        latest_session(&paths.store).and_then(|session| contract_label(&session))
+    };
+    Ok(Snapshot {
+        active_mods,
+        failed_mods,
+        contract,
+    })
+}
+
+pub(crate) fn session_agents(thread: &str) -> Vec<Value> {
+    let Some(root) = store_root() else {
+        return Vec::new();
+    };
+    let mut agents: Vec<Value> = bounded_read(
+        &root.join("agents").join(format!("{thread}.json")),
+        1_048_576,
+    )
+    .ok()
+    .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+    .unwrap_or_default();
+    agents.sort_by_key(|agent| agent["started_at_ms"].as_u64());
+    agents
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, String> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if metadata.file_type().is_symlink() || metadata.len() > limit as u64 {
+        return Err(format!(
+            "unsafe or oversized Oh My Diff file: {}",
+            path.display()
+        ));
+    }
+    std::fs::read(path).map_err(|error| error.to_string())
+}
+
+pub(crate) fn compact_status() -> Option<String> {
+    let mode = if crate::mod_runtime::remote_frontend_active() {
+        Ok(codex_omd::RuntimeMode::Omd)
+    } else {
+        effective_mode()
+    };
+    Some(match mode {
+        Ok(codex_omd::RuntimeMode::UpstreamDirect) => return None,
+        Ok(_) => {
+            let status = mod_status();
+            match snapshot_with_status(status.as_deref().unwrap_or(&Value::Null)) {
+                _ if status
+                    .as_ref()
+                    .is_some_and(|status| status["activation_error"].is_string()) =>
+                {
+                    "Oh My Diff · mods inactive · see /omd".to_string()
+                }
+                Ok(snapshot)
+                    if snapshot.failed_mods == 0 && codex_omd::mod_ui_allowlist().is_some() =>
+                {
+                    return None;
+                }
+                Ok(snapshot) if status.is_some() => format!(
+                    "Oh My Diff · {} mod{} on{}{}",
+                    snapshot.active_mods,
+                    if snapshot.active_mods == 1 { "" } else { "s" },
+                    if snapshot.failed_mods == 0 {
+                        String::new()
+                    } else {
+                        format!(" · {} failed", snapshot.failed_mods)
+                    },
+                    snapshot
+                        .contract
+                        .map(|contract| format!(" · contract {contract}"))
+                        .unwrap_or_default()
+                ),
+                _ => "Oh My Diff · mod status unavailable".to_string(),
+            }
+        }
+        Err(error) => format!("Oh My Diff · invalid mode · {error}"),
+    })
+}
