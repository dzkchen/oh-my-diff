@@ -0,0 +1,7386 @@
+use super::*;
+use crate::mods::DISPATCHER_TEST;
+use codex_extension_api::ToolLifecycleContributor as _;
+use codex_extension_api::ToolOutputContributor;
+use codex_omd::ModHostCallback;
+use codex_omd::ModInvokeOptions;
+use codex_omd::ModOpenOptions;
+use codex_omd::ModStore;
+use std::path::Path;
+
+struct Fixture {
+    _dir: tempfile::TempDir,
+    core: Arc<Core>,
+    lead: Lead,
+}
+
+struct Package<'a> {
+    id: &'a str,
+    capabilities: &'a [&'a str],
+    manifest: Value,
+    source: &'a str,
+}
+
+fn install(store: &ModStore, dir: &Path, package: &Package<'_>) {
+    let path = dir.join(package.id);
+    std::fs::create_dir(&path).unwrap();
+    let mut manifest = json!({"schema": 1, "id": package.id, "version": "1.0.0",
+        "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": package.capabilities});
+    if let Some(extra) = package.manifest.as_object() {
+        manifest.as_object_mut().unwrap().extend(extra.clone());
+    }
+    std::fs::write(
+        path.join("mod.json"),
+        serde_json::to_vec(&manifest).unwrap(),
+    )
+    .unwrap();
+    std::fs::write(path.join("index.ts"), package.source).unwrap();
+    let path = path.canonicalize().unwrap();
+    let inspected = ModStore::inspect_package(&path).unwrap();
+    store
+        .trust_with_secrets(
+            path.clone(),
+            inspected["sha256"].as_str().unwrap(),
+            package
+                .capabilities
+                .iter()
+                .map(|c| (*c).to_owned())
+                .collect(),
+            "user",
+            manifest["exec_environment"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_str)
+                .filter(|name| codex_omd::host::secret_like(name))
+                .map(str::to_owned)
+                .collect(),
+        )
+        .unwrap();
+    store.enable(&path, true).unwrap();
+}
+
+fn fixture(packages: &[Package<'_>]) -> Option<Fixture> {
+    fixture_with_registry(packages, None)
+}
+
+fn fixture_with_registry(
+    packages: &[Package<'_>],
+    registry: Option<&mut ExtensionRegistryBuilder<Config>>,
+) -> Option<Fixture> {
+    fixture_in(packages, registry, true)
+}
+
+fn fixture_in(
+    packages: &[Package<'_>],
+    registry: Option<&mut ExtensionRegistryBuilder<Config>>,
+    git: bool,
+) -> Option<Fixture> {
+    let dir = tempfile::tempdir().unwrap();
+    let base = dir.path().canonicalize().unwrap();
+    let repository = if git { base.join("repo") } else { base.clone() };
+    if git {
+        std::fs::create_dir(&repository).unwrap();
+        std::fs::create_dir(repository.join(".git")).unwrap();
+    }
+    let store = ModStore::create(base.join("store")).unwrap();
+    let sources = base.join("packages");
+    std::fs::create_dir(&sources).unwrap();
+    for package in packages {
+        install(&store, &sources, package);
+    }
+    let root = base.join("store").canonicalize().unwrap();
+    let host = Arc::new(Host {
+        root: root.clone(),
+        repository,
+        repository_identity: "fixture".into(),
+        config: config::HostConfig::default(),
+        routes: Mutex::new(crate::RouteTable {
+            stamp: None,
+            config: Arc::new(config::HostConfig::default()),
+            error: None,
+        }),
+        route_status: Arc::default(),
+        accounts: Arc::new(accounting::Accounts::default()),
+        manager: std::sync::Weak::new(),
+        epoch: 1,
+    });
+    let core = if let Some(registry) = registry {
+        initialize(registry, host.clone()).unwrap().core.clone()
+    } else {
+        let runtime = ModHost::open(root.clone(), ModOpenOptions::default()).unwrap();
+        let environment = runtime.environment();
+        let runtime = Arc::new(Mutex::new(runtime));
+        let input_runtime = Arc::new(Mutex::new(
+            ModHost::open(root.clone(), ModOpenOptions::default()).unwrap(),
+        ));
+        let persist_runtime = Arc::new(Mutex::new(
+            ModHost::open(root, ModOpenOptions::default()).unwrap(),
+        ));
+        let persist_required = persist_runtime.lock().unwrap().required_surfaces();
+        let views = Arc::new(view::Views::new(true));
+        let runtime_required = runtime.lock().unwrap().required_surfaces();
+        Arc::new_cyclic(|core| Core {
+            sessions: Arc::default(),
+            turns: Arc::default(),
+            provider_switches: Arc::default(),
+            terminal_owner: None,
+            session_runtime: tokio::runtime::Handle::try_current().ok(),
+            agents: agents::Agents::new(core.clone(), runtime.clone(), views.clone(), host.clone()),
+            host: host.clone(),
+            runtime_required,
+            runtime,
+            input_runtime,
