+pub(super) struct Child {
+    pub(super) thread: Arc<codex_core::CodexThread>,
+    pub(super) task: Arc<Task>,
+    pub(super) owner: String,
+    pub(super) active: bool,
+    pub(super) runtime: tokio::runtime::Handle,
+}
+
+impl Drop for Child {
+    fn drop(&mut self) {
+        if self.active {
+            stop_dropped(
+                &self.runtime,
+                self.thread.clone(),
+                self.task.clone(),
+                self.owner.clone(),
+                false,
+                None,
+                (),
+            );
+        }
+    }
+}
