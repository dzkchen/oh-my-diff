+pub trait Gate: Send + Sync {
+    fn peer(&self, stream: &UnixStream) -> io::Result<()>;
+    fn authorize(
+        &self,
+        stream: &UnixStream,
+        right: &str,
+        authorization: &str,
+        password: Option<&str>,
+    ) -> bool;
+}
