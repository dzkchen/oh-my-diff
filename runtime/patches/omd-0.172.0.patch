+struct Entry {
+    item: RolloutItem,
+    source: Option<u64>,
+    /// Position when the revision was read, so `line-N` ids survive the edits of one batch.
+    key: usize,
+    info: Option<Info>,
+}
+
+/// What row building reads from a response item, serialized once instead of on every edit.
+struct Info {
+    kind: String,
+    call_id: Option<String>,
+    id: Option<String>,
+    role: Option<String>,
+    text: String,
+}
+
+impl Entry {
+    fn new(item: RolloutItem, source: Option<u64>) -> Self {
+        let info = match &item {
+            RolloutItem::ResponseItem(envelope) => {
+                let value = item_value(&envelope.item);
+                let kind = value["type"].as_str().unwrap_or_default().to_string();
+                let text = if kind == "message" && value["role"] == "user" {
+                    value["content"]
+                        .as_array()
+                        .into_iter()
+                        .flatten()
+                        .filter_map(|part| part["text"].as_str())
+                        .collect()
+                } else {
+                    String::new()
+                };
+                Some(Info {
+                    call_id: value["call_id"].as_str().map(str::to_string),
+                    id: envelope.item.id().map(ToString::to_string),
+                    role: value["role"].as_str().map(str::to_string),
+                    kind,
+                    text,
+                })
+            }
+            _ => None,
+        };
+        Self {
+            item,
+            source,
+            key: 0,
+            info,
+        }
+    }
+}
+
+fn renumber(entries: &mut [Entry]) {
+    for (index, entry) in entries.iter_mut().enumerate() {
+        entry.key = index;
+    }
+}
