+            )
+            .unwrap_err(),
+            "capability_denied: os"
+        );
+        start(owner, "tree").unwrap();
+        let answer = processes
+            .call(
+                owner,
+                "process.exchange",
+                json!({"session":"tree","send":[{"id":1}],"wait_ms":2000}),
+                || true,
+            )
+            .unwrap();
+        assert_eq!(answer["messages"][0]["id"], 1);
+        let child = fs::read_to_string(&pidfile).unwrap().trim().to_owned();
+        let alive = || {
+            Command::new("kill")
+                .args(["-0", &child])
+                .stderr(Stdio::null())
+                .status()
+                .unwrap()
+                .success()
+        };
+        assert!(alive());
+        assert_eq!(
