+        return Err(NEEDS_CHATGPT_CATALOG.into());
+    }
+    let provider = config
+        .model_providers
+        .get(codex_model_provider_info::OPENAI_PROVIDER_ID)
+        .cloned()
+        .unwrap_or_else(|| {
+            codex_model_provider_info::ModelProviderInfo::create_openai_provider(None)
+        });
+    let manager = codex_model_provider::create_model_provider(provider, Some(auth)).models_manager(
+        config.codex_home.to_path_buf(),
+        /*config_model_catalog*/ None,
+    );
+    let infos = manager
+        .raw_model_catalog(
+            codex_models_manager::manager::RefreshStrategy::OnlineIfUncached,
+            config.http_client_factory(),
+        )
+        .await
+        .models;
+    let models = manager
+        .build_available_models(infos.clone())
+        .into_iter()
+        .filter(|preset| preset.model_provider.is_none())
+        .collect();
+    Ok(ChatgptModelCatalog {
+        models,
+        infos,
+        configured: config.model.clone().zip(config.model_context_window),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_login::AuthManager;
+    use codex_login::CodexAuth;
+    use codex_protocol::openai_models::ModelInfo;
+    use codex_protocol::openai_models::ModelVisibility;
+
+    fn info(slug: &str, context_window: Option<i64>, max_context_window: Option<i64>) -> ModelInfo {
+        let base = codex_models_manager::bundled_models_response()
+            .unwrap()
+            .models
+            .remove(0);
+        ModelInfo {
+            slug: slug.into(),
+            display_name: slug.into(),
+            context_window,
+            max_context_window,
+            effective_context_window_percent: 90,
+            visibility: ModelVisibility::List,
+            ..base
+        }
+    }
+
+    async fn config(home: &std::path::Path) -> codex_core::config::Config {
+        let mut config = codex_core::config::ConfigBuilder::default()
+            .codex_home(home.to_path_buf())
+            .build()
+            .await
+            .unwrap();
+        config.model_provider_id = "fixture-local".into();
+        config
+    }
+
+    #[tokio::test]
+    async fn a_cached_chatgpt_catalog_serves_live_only_models_while_another_provider_starts() {
+        let home = tempfile::tempdir().unwrap();
+        let config = config(home.path()).await;
+        let auth = AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            home.path().to_path_buf(),
+        );
+        let provider =
+            config.model_providers[codex_model_provider_info::OPENAI_PROVIDER_ID].clone();
+        let mut hidden = info("fixture-hidden", Some(200_000), None);
+        hidden.visibility = ModelVisibility::Hide;
+        let entry = codex_model_provider::test_support::models_cache_entry(
+            &provider,
+            auth.auth_cached().as_ref(),
+            vec![info("fixture-live-only", Some(333_000), None), hidden],
+        );
+        std::fs::write(
+            home.path().join("models_cache.json"),
+            serde_json::to_vec(&entry).unwrap(),
+        )
+        .unwrap();
+        let catalog = load_chatgpt_catalog(&config, auth).await.unwrap();
+        assert!(
+            catalog
+                .models
+                .iter()
+                .any(|model| model.model == "fixture-live-only")
+        );
+        assert!(
+            catalog
+                .infos
+                .iter()
+                .any(|model| model.slug == "fixture-live-only")
+        );
+        assert!(
+            !catalog
+                .models
+                .iter()
+                .any(|model| model.model == "fixture-hidden" && model.show_in_picker)
+        );
+    }
+
+    #[tokio::test]
+    async fn choosing_a_model_needs_chatgpt_auth_not_an_api_key() {
+        let home = tempfile::tempdir().unwrap();
+        let config = config(home.path()).await;
+        let auth = AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::from_api_key("sk-fixture"),
+            home.path().to_path_buf(),
+        );
+        assert_eq!(
+            load_chatgpt_catalog(&config, auth).await.err(),
+            Some(NEEDS_CHATGPT_CATALOG.to_owned())
+        );
+    }
+}
