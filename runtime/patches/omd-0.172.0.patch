+pub fn resolve_program(name: &str, repository: &Path) -> Option<PathBuf> {
+    let path = Path::new(name);
+    if path.is_absolute() {
+        let canonical = path.canonicalize().ok()?;
+        return (canonical == path
+            && canonical.is_file()
+            && !crate::agent_writable(&canonical, repository))
+        .then_some(canonical);
+    }
+    if name.is_empty()
+        || name.len() > 64
+        || !name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return None;
+    }
+    std::env::split_paths(&std::env::var_os("PATH")?).find_map(|directory| {
+        let candidate = directory.join(name).canonicalize().ok()?;
+        (candidate.is_file() && !crate::agent_writable(&candidate, repository)).then_some(candidate)
+    })
+}
+
+/// The agent can write the repository, so programs there need an `os_access` path; outside links run as the link so multicall shims dispatch.
+pub fn unrestricted_program(
+    access: &crate::ModOsAccess,
+    name: &str,
+    repository: &Path,
+) -> Result<PathBuf, String> {
+    let path = Path::new(name);
+    let link = |found: &Path| {
+        let launch = found
+            .parent()?
+            .canonicalize()
+            .ok()?
+            .join(found.file_name()?);
+        Some((launch, found.canonicalize().ok()?))
+    };
+    let (launch, resolved) = if path.is_absolute() {
+        link(path)
+    } else if !name.is_empty() && !name.contains('/') && !name.contains('\0') {
+        std::env::var_os("PATH").and_then(|paths| {
+            std::env::split_paths(&paths).find_map(|directory| {
+                link(&directory.join(name))
+                    .filter(|(_, target)| !crate::agent_writable(target, repository))
+            })
+        })
+    } else {
+        None
+    }
+    .filter(|(_, target)| target.is_file())
+    .ok_or("exec_program_unavailable")?;
+    let listed = access
+        .programs
+        .iter()
+        .any(|allowed| Path::new(allowed) == resolved || Path::new(allowed) == path);
+    if crate::agent_writable(&resolved, repository) && !listed
+        || !access.allows(name, &resolved) && !access.allows(name, path)
+    {
+        return Err(format!("os_access_denied: {name}"));
+    }
+    Ok(if crate::agent_writable(&launch, repository) {
+        resolved
+    } else {
+        launch
+    })
+}
+
+/// The command for an unsandboxed program: no Seatbelt with network, otherwise a macOS Seatbelt denying only IP networking.
+pub fn unrestricted_command(
+    access: &crate::ModOsAccess,
+    program: &Path,
+    exec_environment: &[String],
+) -> Result<Command, String> {
+    unrestricted_command_from(access, program, exec_environment, |name| {
+        std::env::var_os(name)
+    })
+}
+
+fn unrestricted_command_from(
+    access: &crate::ModOsAccess,
+    program: &Path,
+    exec_environment: &[String],
+    environment: impl Fn(&str) -> Option<std::ffi::OsString>,
+) -> Result<Command, String> {
+    let mut command = if access.network {
+        Command::new(program)
+    } else if !cfg!(target_os = "macos") {
+        return Err("exec_sandbox_unavailable".to_owned());
+    } else {
+        let mut command = Command::new("/usr/bin/sandbox-exec");
+        command
+            .args([
+                "-p",
+                "(version 1)(allow default)(deny network*)(allow network* (remote unix-socket))(allow network* (local unix-socket))",
+            ])
+            .arg(program);
+        command
+    };
+    command
+        .env_clear()
+        .env("PATH", environment("PATH").unwrap_or_default());
+    for name in [
+        "HOME",
+        "USER",
+        "LOGNAME",
+        "SHELL",
+        "LANG",
+        "LC_ALL",
+        "LC_CTYPE",
+        "SSH_AUTH_SOCK",
+    ]
+    .into_iter()
+    .chain(exec_environment.iter().map(String::as_str))
+    {
+        if let Some(value) = environment(name) {
+            command.env(name, value);
+        }
+    }
+    Ok(command)
+}
+
+fn inherited_socket(name: &str, repository: &Path) -> Option<PathBuf> {
+    use std::os::unix::fs::FileTypeExt;
+    use std::os::unix::fs::MetadataExt;
+    let path = PathBuf::from(std::env::var_os(name)?);
+    let metadata = fs::symlink_metadata(&path).ok()?;
+    (path.is_absolute()
+        && path.canonicalize().ok()? == path
+        && !crate::agent_writable(&path, repository)
+        && metadata.file_type().is_socket()
+        && metadata.uid() == rustix::process::geteuid().as_raw())
+    .then_some(path)
+}
+
+const EXEC_ARTIFACT_BLOCK_BYTES: usize = 64 * 1024;
+
+struct VerifiedOutput {
+    stamp: crate::FileStamp,
+    len: usize,
+    blocks: Vec<[u8; 32]>,
+}
+
+static VERIFIED_OUTPUTS: LazyLock<Mutex<BTreeMap<PathBuf, Arc<VerifiedOutput>>>> =
+    LazyLock::new(Default::default);
+
+fn remember_output(path: &Path, stamp: crate::FileStamp, bytes: &[u8]) -> Arc<VerifiedOutput> {
+    let verified = Arc::new(VerifiedOutput {
+        stamp,
+        len: bytes.len(),
+        blocks: bytes
+            .chunks(EXEC_ARTIFACT_BLOCK_BYTES)
+            .map(|block| Sha256::digest(block).into())
+            .collect(),
+    });
+    let mut outputs = VERIFIED_OUTPUTS
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner);
+    if outputs.len() >= 1024 {
+        outputs.clear();
+    }
+    outputs.insert(path.to_path_buf(), verified.clone());
+    verified
+}
+
+/// An exec output artifact's block hashes, rehashed in full only when its file stamp changes.
+fn verified_output(
+    path: &Path,
+    file: &mut fs::File,
+    digest: &str,
+) -> Result<Arc<VerifiedOutput>, String> {
+    let metadata = file.metadata().map_err(|error| error.to_string())?;
+    let stamp = crate::file_stamp(&metadata);
+    if let Some(verified) = VERIFIED_OUTPUTS
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(path)
+        .filter(|verified| verified.stamp == stamp)
+    {
+        return Ok(verified.clone());
+    }
+    let mut bytes = Vec::new();
+    Read::by_ref(file)
+        .take((EXEC_ARTIFACT_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|error| error.to_string())?;
+    if bytes.len() > EXEC_ARTIFACT_BYTES
+        || crate::sha256_hex(&bytes) != digest
+        || std::str::from_utf8(&bytes).is_err()
+    {
+        return Err("exec_output_integrity_failed".into());
+    }
+    Ok(remember_output(path, stamp, &bytes))
+}
+
+fn verified_page(
+    file: &mut fs::File,
+    verified: &VerifiedOutput,
+    cursor: usize,
+    max: usize,
+) -> Result<Vec<u8>, String> {
+    let end = (cursor + max + 3).min(verified.len);
+    let first = cursor / EXEC_ARTIFACT_BLOCK_BYTES;
+    let start = first * EXEC_ARTIFACT_BLOCK_BYTES;
+    let span = (end.div_ceil(EXEC_ARTIFACT_BLOCK_BYTES) * EXEC_ARTIFACT_BLOCK_BYTES)
+        .min(verified.len)
+        .saturating_sub(start);
+    file.seek(SeekFrom::Start(start as u64))
+        .map_err(|error| error.to_string())?;
+    let mut window = Vec::with_capacity(span);
+    Read::by_ref(file)
+        .take(span as u64)
+        .read_to_end(&mut window)
+        .map_err(|error| error.to_string())?;
+    if window.len() != span
+        || window
+            .chunks(EXEC_ARTIFACT_BLOCK_BYTES)
+            .zip(&verified.blocks[first..])
+            .any(|(block, hash)| Sha256::digest(block)[..] != hash[..])
+    {
+        return Err("exec_output_integrity_failed".into());
+    }
+    window.truncate(end - start);
+    Ok(window.split_off(cursor - start))
+}
+
+/// A program's SHA-256, rehashed only when its file stamp changes.
+pub fn program_hash(path: &Path) -> Result<String, String> {
+    static HASHES: LazyLock<Mutex<BTreeMap<PathBuf, (crate::FileStamp, String)>>> =
+        LazyLock::new(Default::default);
+    let mut file = fs::File::open(path).map_err(|error| error.to_string())?;
+    let metadata = file.metadata().map_err(|error| error.to_string())?;
+    if metadata.len() > 128 * 1024 * 1024 {
+        return Err("exec_program_too_large".into());
+    }
+    let stamp = crate::file_stamp(&metadata);
+    if let Some((known, digest)) = HASHES
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(path)
+        && *known == stamp
+    {
+        return Ok(digest.clone());
+    }
+    let mut hasher = Sha256::new();
+    let mut chunk = vec![0_u8; 64 * 1024];
+    loop {
+        let read = file.read(&mut chunk).map_err(|error| error.to_string())?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&chunk[..read]);
+    }
+    let digest = format!("{:x}", hasher.finalize());
+    let mut hashes = HASHES.lock().unwrap_or_else(PoisonError::into_inner);
+    if hashes.len() >= 1024 {
+        hashes.clear();
+    }
+    hashes.insert(path.to_path_buf(), (stamp, digest.clone()));
+    Ok(digest)
+}
+
+fn stored_outputs(owner: &Path) -> Result<Vec<(std::time::SystemTime, PathBuf, u64)>, String> {
+    let mut stored = Vec::new();
+    let mut directories = vec![(owner.to_path_buf(), 0)];
+    while let Some((directory, depth)) = directories.pop() {
+        for entry in fs::read_dir(&directory).map_err(|error| error.to_string())? {
+            let entry = entry.map_err(|error| error.to_string())?;
+            let metadata = entry.metadata().map_err(|error| error.to_string())?;
+            if metadata.file_type().is_symlink() {
+                return Err("exec_output_directory_invalid".into());
+            }
+            if metadata.is_dir() && depth < 2 {
+                directories.push((entry.path(), depth + 1));
+            } else if depth == 2
+                && metadata.is_file()
+                && entry
+                    .path()
+                    .extension()
+                    .is_some_and(|extension| extension == "txt")
+            {
+                let modified = metadata.modified().map_err(|error| error.to_string())?;
+                stored.push((modified, entry.path(), metadata.len()));
+            }
+        }
+    }
+    Ok(stored)
+}
