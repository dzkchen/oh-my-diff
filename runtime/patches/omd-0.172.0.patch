+                owner,
+                "process.start",
+                json!({"session": session, "name": "sh", "path": sh, "sha256": sha256, "sandbox": "none",
+                    "arguments": ["-c", format!("sleep 300 & echo $! > {}; exec cat", pidfile.display())]}),
+                || true,
+            )
+        };
+        assert_eq!(
+            start(
+                ProcessOwner {
+                    os_access: None,
+                    blit: None,
+                    ..owner
+                },
