+        &mut self,
+        access: &mut Access<'_>,
+        host: &mut HostFn<'_>,
+        input: &Value,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+    ) -> Result<Value> {
+        match self {
+            Core::Call(run) => run(input.clone()),
+            Core::Host { caller, generation } => {
