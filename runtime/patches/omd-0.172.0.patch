+pub type Wake = Arc<dyn Fn() + Send + Sync>;
+
+pub type Observer = Arc<dyn Fn(Observed) + Send + Sync>;
+
+const MIRRORED_OPERATIONS: &[&str] = &["terminal.notify", "terminal.notice", "terminal.blit"];
