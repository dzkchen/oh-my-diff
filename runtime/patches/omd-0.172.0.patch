+) -> Option<String> {
+    let thread_store = &invocation.session.services.thread_extension_data;
+    if !invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+        .iter()
+        .any(|contributor| {
+            contributor.replacing(thread_store, invocation.turn.extension_data.as_ref())
