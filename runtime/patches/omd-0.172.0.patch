+#[test]
+fn terminal_package_changes_skip_the_prompt_only_without_grants_or_identity_warning() {
+    let skips = |preview: Value, context, id: &str| {
+        let (mut call, _answer) = call(
+            "packages.apply",
+            json!({"action": preview["action"], "id": id}),
+            None,
+        );
+        call.context = context;
+        let optional = codex_omd::package_controls::confirmation_optional(&preview);
+        unprompted(&call, optional, &|id| id == "guard")
+    };
+    let user = InvocationContext::User;
+    let preview = |action: &str, grants: Value, warning: Value| json!({"action": action, "grants_added": grants, "identity_warning": warning});
+    assert!(skips(
+        preview("disable", json!([]), Value::Null),
+        user,
+        "other"
+    ));
+    for action in ["reset", "save-defaults"] {
+        assert!(!skips(
+            preview(action, json!([]), Value::Null),
+            user,
+            "other"
+        ));
+    }
+    {
+        let action = "enable";
+        assert!(skips(
+            preview(action, json!([]), Value::Null),
+            user,
+            "other"
+        ));
+        assert!(!skips(
+            preview(action, json!(["os"]), Value::Null),
+            user,
+            "other"
+        ));
+        assert!(!skips(
+            preview(action, json!([]), json!("Mod ID x is already installed")),
+            user,
+            "other"
+        ));
+    }
+    assert!(!skips(
+        preview("disable", json!([]), json!("Mod ID x is already installed")),
+        user,
+        "other"
+    ));
+    assert!(!skips(
+        preview("disable", json!([]), Value::Null),
+        InvocationContext::Event,
+        "other"
+    ));
+    assert!(!skips(
+        preview("disable", json!([]), Value::Null),
+        user,
+        "guard"
+    ));
+    assert!(!skips(
+        preview("trust", json!([]), Value::Null),
+        user,
+        "other"
+    ));
+}
