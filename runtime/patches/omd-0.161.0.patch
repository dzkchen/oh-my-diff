+
+pub const SECTION_PREVIEW_BYTES: usize = 4096;
+pub const SECTIONS_PREVIEW_BYTES: usize = 49_152;
+pub const SECTION_LIMIT: usize = 256;
+pub const SECTION_TEXT_BYTES: usize = 65_536;
