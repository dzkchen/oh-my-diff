+pub(crate) fn contract_documents()
+-> Option<Vec<(codex_omd::ContractDocument, codex_omd::PolicyOwner)>> {
+    with_host(|runtime, _| Some(runtime.contract_documents()))
+}
+
+fn reload(runtime: &mut ModHost) {
+    static CHECKOUT: Mutex<Option<std::path::PathBuf>> = Mutex::new(None);
+    if let Some(paths) = crate::omd::mod_paths() {
+        let mut checkout = CHECKOUT
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if checkout.as_ref() != Some(&paths.repository) {
+            runtime.set_checkout(&paths.repository);
+            *checkout = Some(paths.repository);
+        }
+    }
+    runtime.turn_boundary();
+    let owners = runtime
+        .owners()
+        .into_iter()
+        .map(|(id, owner)| (id, owner.sha256))
+        .collect::<std::collections::BTreeMap<_, _>>();
+    let unrestricted = owners
+        .keys()
+        .filter(|id| {
+            runtime
+                .grants(id)
+                .is_some_and(|grants| grants.os_access.is_some())
+        })
+        .cloned()
+        .collect();
+    crate::mod_pty::retain(
+        runtime.generation(),
+        runtime.configuration_sha256(),
+        &owners,
+        &unrestricted,
+    );
+}
+
+fn with_host<T>(run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let runtime = shared_host(paths.store.clone()?).ok()?;
+    let mut runtime = runtime
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    reload(&mut runtime);
+    let result = run(&mut runtime, &paths);
+    record_status(&runtime, &paths);
+    result
+}
+
+/// How long a caller off the draw path waits for a busy lock before giving up.
+const LOCK_WAIT: std::time::Duration = std::time::Duration::from_millis(100);
+
+/// Waits up to `wait` for a busy lock instead of silently giving up on the first contention.
+fn lock_within<T>(
+    mutex: &Mutex<T>,
+    wait: std::time::Duration,
+) -> Option<std::sync::MutexGuard<'_, T>> {
+    let deadline = std::time::Instant::now() + wait;
+    loop {
+        match mutex.try_lock() {
+            Ok(guard) => return Some(guard),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => return Some(poisoned.into_inner()),
+            Err(std::sync::TryLockError::WouldBlock) if std::time::Instant::now() < deadline => {
+                std::thread::sleep(std::time::Duration::from_millis(2));
+            }
+            Err(std::sync::TryLockError::WouldBlock) => return None,
+        }
+    }
+}
+
+fn try_with_host<T>(
+    run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>,
+) -> Option<T> {
+    try_with_host_within(LOCK_WAIT, run)
+}
+
+fn try_with_host_within<T>(
+    wait: std::time::Duration,
+    run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>,
+) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let opened = lock_within(&HOST, wait)?.clone();
+    let runtime = match opened {
+        Some(runtime) => runtime,
+        None => shared_host(paths.store.clone()?).ok()?,
+    };
+    let mut runtime = lock_within(&runtime, wait)?;
+    reload(&mut runtime);
+    let result = run(&mut runtime, &paths);
+    record_status(&runtime, &paths);
+    result
+}
+
+fn record_status(runtime: &ModHost, paths: &crate::omd::ModPaths) {
+    let status = runtime.status();
+    if status["mods"]
+        .as_array()
+        .is_some_and(|mods| mods.iter().any(|item| item["error"].is_string()))
+        && let Ok(bytes) = serde_json::to_vec(&status)
+        && bytes.len() <= 262_144
+        && let Ok(mut file) = tempfile::NamedTempFile::new_in(&paths.evidence)
+        && file.write_all(&bytes).is_ok()
+    {
+        let _ = file.persist(paths.evidence.join("mod-status.json"));
+    }
+}
