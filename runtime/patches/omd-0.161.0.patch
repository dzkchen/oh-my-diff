+fn ascii_inline_preserves_native_text_whitespace_and_overlay_fields() {
+    let area = Rect::new(0, 0, 80, 8);
+    let mut buffer = Buffer::empty(area);
+    Paragraph::new(vec![
+        Line::from("  >_ OpenAI Codex (v<VERSION>) | External profile"),
+        Line::from("  model: gpt-test    status: ready"),
+        Line::from("    + let value = 1;    // diff spacing"),
+        Line::from("  Error: permission denied    Retry?"),
+        Line::from("  Approval: run command?    (y/n)"),
+    ])
+    .render(Rect { height: 5, ..area }, &mut buffer);
+    Paragraph::new("> draft   with   spaces").render(
+        Rect {
+            y: 7,
+            height: 1,
+            ..area
+        },
+        &mut buffer,
+    );
+    let before = rows(&buffer, area);
+    let native = buffer;
+    let mut snapshot = snapshot(serde_json::json!({"surface_styles":{"backdrop":{
+        "top":"#ffffff","bottom":"#eeeeee","foreground":"#1c1c1c","border":"#888888","opacity":0.85
+    }}}));
+    let mut frames = Vec::new();
+    for art in [None, Some("ART")] {
+        let mut buffer = native.clone();
+        snapshot.view.backdrop = art.map(|text| {
+            serde_json::from_value(serde_json::json!({"ascii":{"text":text,"position":"tile"}}))
+                .unwrap()
+        });
+        render_inline(area, area, &mut buffer, &snapshot);
+        let after = rows(&buffer, area);
+        assert_eq!(
+            after.lines().take(5).collect::<Vec<_>>(),
+            before.lines().take(5).collect::<Vec<_>>()
+        );
+        assert_eq!(after.lines().last(), before.lines().last());
+        if art.is_some() {
+            assert!(after.lines().nth(5).unwrap().starts_with("ARTART"));
+        } else {
+            assert_eq!(buffer[(0, 5)].symbol(), "|");
+            assert_eq!(buffer[(79, 5)].symbol(), "|");
+        }
+        frames.push(format!(
+            "border with ASCII {art:?}\n{}",
+            after
+                .lines()
+                .map(str::trim_end)
+                .collect::<Vec<_>>()
+                .join("\n")
+        ));
+    }
+    insta::assert_snapshot!("ascii_inline_native_whitespace", frames.join("\n\n"));
+}
