+    pub fn merge_settings(
+        &self,
+        path: &Path,
+        values: &serde_json::Map<String, Value>,
+    ) -> Result<BTreeMap<String, Value>> {
+        self.update_settings(path, |settings| {
+            for (name, value) in values {
+                if value.is_null() {
+                    settings.remove(name);
+                } else {
+                    settings.insert(name.clone(), value.clone());
+                }
+            }
+        })
+    }
