+/// Returns whether this message completed the connection's initialize handshake.
+pub(crate) async fn process_connection_message(
+    processor: &Arc<MessageProcessor>,
+    connection_id: ConnectionId,
+    connection_state: &ConnectionState,
+    message: JSONRPCMessage,
+    transport: &AppServerTransport,
+) -> bool {
+    if connection_state.session.rpc_gate.is_closed() {
+        return false;
+    }
+    match message {
+        JSONRPCMessage::Request(request) => {
+            let was_initialized = connection_state.session.initialized();
+            processor
+                .process_request(
+                    connection_id,
+                    request,
+                    transport,
+                    Arc::clone(&connection_state.session),
+                )
+                .await;
+            connection_state.sync_outbound();
+            let initialized = !was_initialized && connection_state.session.initialized();
+            if initialized {
+                processor
+                    .send_initialize_notifications_to_connection(connection_id)
+                    .await;
+            }
+            initialized
+        }
+        JSONRPCMessage::Response(response) => {
+            processor.process_response(connection_id, response).await;
+            false
+        }
+        JSONRPCMessage::Notification(notification) => {
+            processor.process_notification(notification).await;
+            false
+        }
+        JSONRPCMessage::Error(err) => {
+            processor.process_error(connection_id, err).await;
+            false
+        }
+    }
+}
+
+/// Control-plane messages from the processor side to the outbound router task, which must know
+/// when a connection opens or closes to route messages correctly.
+pub(crate) enum OutboundControlEvent {
+    /// Register a new writer for an opened connection.
+    Opened {
+        connection_id: ConnectionId,
+        writer: mpsc::Sender<QueuedOutgoingMessage>,
+        disconnect_sender: Option<CancellationToken>,
+        initialized: Arc<AtomicBool>,
+        experimental_api_enabled: Arc<AtomicBool>,
+        opted_out_notification_methods: Arc<RwLock<HashSet<String>>>,
+    },
+    /// Remove state for a closed/disconnected connection.
+    Closed { connection_id: ConnectionId },
+    /// Disconnect all connection-oriented clients during graceful restart.
+    DisconnectAll,
+}
+
+impl OutboundControlEvent {
+    pub(crate) fn apply(self, connections: &mut HashMap<ConnectionId, OutboundConnectionState>) {
+        match self {
+            Self::Opened {
+                connection_id,
+                writer,
+                disconnect_sender,
+                initialized,
+                experimental_api_enabled,
+                opted_out_notification_methods,
+            } => {
+                connections.insert(
+                    connection_id,
+                    OutboundConnectionState::new(
+                        writer,
+                        initialized,
+                        experimental_api_enabled,
+                        opted_out_notification_methods,
+                        disconnect_sender,
+                    ),
+                );
+            }
+            Self::Closed { connection_id } => {
+                connections.remove(&connection_id);
+            }
+            Self::DisconnectAll => {
+                info!(
+                    "disconnecting {} outbound websocket connection(s) for graceful restart",
+                    connections.len()
+                );
+                for connection_state in connections.values() {
+                    connection_state.request_disconnect();
+                }
+                connections.clear();
+            }
+        }
+    }
 }

