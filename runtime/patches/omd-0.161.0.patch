+use super::*;
+
+struct Tool {
+    core: Arc<Core>,
+    lead: Arc<Lead>,
+    id: String,
+    generation: u64,
+    definition: ModTool,
+    parameters: JsonSchema,
+}
+
+impl ToolContributor for Mods {
+    fn tools(
+        &self,
+        _: &ExtensionData,
+        thread: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(lead) = thread.get::<Lead>().filter(|lead| lead.owner == "lead") else {
+            return Vec::new();
+        };
+        let Ok(runtime) = self.runtime.lock() else {
+            return Vec::new();
+        };
+        self.tool_executors(lead, runtime.tools())
+    }
+
+    fn tools_for_step(
+        &self,
+        _: &ExtensionData,
+        thread: &ExtensionData,
+        _: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let Some(lead) = thread.get::<Lead>().filter(|lead| lead.owner == "lead") else {
+            return Vec::new();
+        };
+        let Ok(mut runtime) = self.runtime.lock() else {
+            return Vec::new();
+        };
+        if !runtime.has_task_scoped_tools() {
+            return self.tool_executors(lead, runtime.tools());
+        }
+        let task = lead.session.task.clone();
+        if task.check_active().is_err() {
+            return self.tool_executors(
+                lead,
+                runtime
+                    .tools()
+                    .into_iter()
+                    .filter(|(_, _, tool)| !tool.task_scoped)
+                    .collect(),
+            );
+        }
+        let ledger = lead.ledger();
+        let tools =
+            runtime.tools_for_step(thread_id(thread), ledger, || task.check_active().is_ok());
+        self.tool_executors(lead, tools)
+    }
+}
+
+impl Mods {
+    fn tool_executors(
+        &self,
+        lead: Arc<Lead>,
+        tools: Vec<(String, u64, ModTool)>,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        tools
+            .into_iter()
+            .filter_map(|(id, generation, definition)| {
+                let parameters =
+                    codex_extension_api::parse_tool_input_schema(&definition.parameters).ok()?;
+                Some(Arc::new(Tool {
+                    core: self.core.clone(),
+                    lead: lead.clone(),
+                    id,
+                    generation,
+                    definition,
+                    parameters,
+                })
+                    as Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>)
+            })
+            .collect()
+    }
+}
+
+impl Tool {
+    fn label(&self) -> String {
+        self.definition
+            .label
+            .clone()
+            .unwrap_or_else(|| self.definition.name.clone())
+    }
+
+    fn name(&self) -> String {
+        if self.id.is_empty() {
+            self.definition.name.clone()
+        } else {
+            format!("mod_{}_{}", self.id, self.definition.name)
+        }
+    }
+}
+
+impl<'call> ToolExecutor<ToolCall<'call>> for Tool {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain(self.name())
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(ResponsesApiTool {
+            name: self.name(),
+            description: self.definition.description.clone(),
+            strict: false,
+            defer_loading: None,
+            output_schema: None,
+            parameters: self.parameters.clone(),
+        })
+    }
+
+    fn exposure(&self) -> ToolExposure {
+        ToolExposure::Deferred
+    }
+
+    fn search_info(&self) -> Option<codex_tools::ToolSearchInfo> {
+        let source = (!self.id.is_empty()).then(|| codex_tools::ToolSearchSourceInfo {
+            name: format!("{} mod tools", self.id),
+            description: Some(format!("Tools of the enabled {} mod", self.id)),
+        });
+        codex_tools::ToolSearchInfo::from_tool_spec(self.spec(), source)
+    }
+
+    fn handle<'a>(&'a self, call: ToolCall<'call>) -> ToolExecutorFuture<'a>
+    where
+        'call: 'a,
+    {
+        Box::pin(async move {
+            let payload: Value = serde_json::from_str(call.function_arguments()?)
+                .map_err(|e| FunctionCallError::RespondToModel(e.to_string()))?;
+            let core = &self.core;
+            let runtime = core.runtime.clone();
+            let (id, name, generation) = (
+                self.id.clone(),
+                self.definition.name.clone(),
+                self.generation,
+            );
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let (label, tool_name) = (self.label(), self.name());
+            core.views.progress(&core.host, &label, "Running");
+            let (views, host_info, progress_label) =
+                (core.views.clone(), core.host.clone(), label.clone());
+            let (requests, mut receiver) = tokio::sync::mpsc::channel::<HostRequest>(1);
+            let flag = cancelled.clone();
+            let thread = self.lead.thread.to_string();
+            let job = tokio::task::spawn_blocking(move || {
+                let _thread = codex_omd::StateThread::enter(Some(thread));
+                let poisoned = || std::io::Error::other("mod runtime poisoned");
+                let facts = facts(&*runtime.lock().map_err(|_| poisoned())?);
+                let active = || !flag.load(Ordering::Acquire);
+                let host =
+                    |caller: &str, request| forward(&requests, &facts, caller, request, &active);
+                let progress =
+                    |update: String| views.progress(&host_info, &progress_label, &update);
+                if id.is_empty() {
+                    return runtime
+                        .lock()
+                        .map_err(|_| poisoned())?
+                        .invoke_tool(&id, generation, &name, payload, active, host, progress);
+                }
+                codex_omd::invoke_shared(
+                    &runtime, &id, generation, "tool", &name, payload, active, host, progress,
+                )
+            });
+            let mut ordinal = 0u32;
+            while let Some(host_call) = receiver.recv().await {
+                ordinal += 1;
+                let mut nested = call.clone();
+                nested.call_id = format!("{}/mod/{}/{generation}/{ordinal}", call.call_id, self.id);
+                let value = operations::dispatch(
+                    core,
+                    &self.lead,
+                    operations::Caller {
+                        id: &host_call.caller,
+                        source: &host_call.source,
+                        grants: host_call.grants,
+                        generation,
+                        origin: codex_omd::data_store::Origin::Tool,
+                        record_changes: false,
+                    },
+                    Some(&nested),
+                    host_call.request,
+                    &cancelled,
+                )
+                .await;
+                let _ = host_call.reply.send(value.map_err(std::io::Error::other));
+            }
+            let result = job
+                .await
+                .map_err(|e| e.to_string())
+                .and_then(|result| result.map_err(|e| e.to_string()));
+            match result {
+                Ok(value) => {
+                    core.views
+                        .finish(&core.host, &self.id, &tool_name, &label, "completed");
+                    Ok(Box::new(JsonToolOutput::new(value)) as Box<dyn ToolOutput>)
+                }
+                Err(error) => {
+                    core.views
+                        .finish(&core.host, &self.id, &tool_name, &label, "failed");
+                    core.agents.cleanup_owned(&self.id, generation).await;
+                    core.services.cleanup_owned(&self.id, generation).await;
+                    self.lead
+                        .session
+                        .processes
+                        .cleanup_owned(&self.id, generation);
+                    super::access::release_servers(&self.lead, generation, Some(&self.id)).await;
+                    Err(FunctionCallError::RespondToModel(error))
+                }
+            }
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/view.rs b/codex-rs/ext/omd/src/mods/view.rs
new file mode 100644
index 000000000..738976d38
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/view.rs
@@ -0,0 +1,258 @@
+use super::*;
+use codex_omd::ModActivity;
+use codex_omd::ModPanel;
+use codex_omd::ModTerminalView;
+use codex_omd::ModViewSnapshot;
+
+#[derive(Default)]
+struct State {
+    snapshot: ModViewSnapshot,
+    presentation: Value,
+    sequence: u64,
+    diagnostics: BTreeMap<String, String>,
+}
+
+pub(super) struct Views {
+    state: Mutex<State>,
+    /// The snapshot as last persisted; `None` until the first publish.
+    published: Mutex<Option<Arc<ModViewSnapshot>>>,
+    /// Set while re-rendering for a roster change: an unchanged view keeps its revision.
+    pub(super) quiet: AtomicBool,
+}
+
+/// Keeps at most `limit` UTF-8 bytes, matching `ModViewSnapshot::read`.
+fn visible(text: &str, limit: usize) -> String {
+    let mut output = String::new();
+    for character in text.chars().filter(|c| !c.is_control()) {
+        if output.len() + character.len_utf8() > limit {
+            break;
+        }
+        output.push(character);
+    }
+    output
+}
+
+impl Views {
+    pub(super) fn start_thread(&self, thread: &codex_extension_api::ExtensionData) -> Value {
+        let phase = if thread.get::<codex_extension_api::ResumedThread>().is_some()
+            || thread
+                .get::<codex_extension_api::ForkedFromThread>()
+                .is_some()
+        {
+            "resumed"
+        } else {
+            "fresh"
+        };
+        self.presentation(thread.level_id(), Some(phase))
+    }
+
+    pub(super) fn presentation(&self, thread: &str, phase: Option<&str>) -> Value {
+        let Ok(mut state) = self.state.lock() else {
+            return Value::Null;
+        };
+        if state.presentation["thread_id"].as_str() != Some(thread) {
+            state.presentation = json!({"thread_id": thread, "phase": "fresh"});
+        }
+        if let Some(phase) = phase {
+            state.presentation["phase"] = json!(phase);
+        }
+        state.presentation.clone()
+    }
+
+    pub(super) fn current_presentation(&self) -> Value {
+        self.state
+            .lock()
+            .map(|state| state.presentation.clone())
+            .unwrap_or(Value::Null)
+    }
+
+    pub(super) fn new() -> Self {
+        let epoch = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|elapsed| u64::try_from(elapsed.as_nanos()).unwrap_or(u64::MAX))
+            .unwrap_or_default();
+        Self {
+            state: Mutex::new(State {
+                snapshot: ModViewSnapshot {
+                    epoch,
+                    ..ModViewSnapshot::default()
+                },
+                ..State::default()
+            }),
+            published: Mutex::new(None),
+            quiet: AtomicBool::new(false),
+        }
+    }
+
+    pub(super) fn published(&self) -> Option<Arc<ModViewSnapshot>> {
+        self.published.lock().ok()?.clone()
+    }
+
+    fn update(&self, owner: &Host, change: impl FnOnce(&mut State)) {
+        let Ok(mut state) = self.state.lock() else {
+            return;
+        };
+        change(&mut state);
+        state.snapshot.diagnostics = state.diagnostics.values().take(16).cloned().collect();
+        let _ = owner.persist_json("mod-view.json", &state.snapshot);
+        if let Ok(mut published) = self.published.lock() {
+            *published = Some(Arc::new(state.snapshot.clone()));
+        }
+        codex_omd::client_surface::redraw();
+    }
+
+    pub(super) fn base(
+        &self,
+        owner: &Host,
+        terminal: ModTerminalView,
+        input: Value,
+        rendered_ms: u64,
+    ) {
+        let quiet = self.quiet.load(Ordering::Acquire);
+        self.update(owner, |state| {
+            let snapshot = &state.snapshot;
+            if !quiet
+                || snapshot.view != terminal.view
+                || snapshot.conflicts != terminal.conflicts
+                || snapshot.contributors != terminal.contributors
+                || snapshot.component_owners != terminal.component_owners
+            {
+                state.snapshot.revision = state.snapshot.revision.saturating_add(1);
+            }
+            state.snapshot.rendered_ms = rendered_ms;
+            state.snapshot.view = terminal.view;
+            state.snapshot.conflicts = terminal.conflicts;
+            state.snapshot.contributors = terminal.contributors;
+            state.snapshot.component_owners = terminal.component_owners;
+            state.snapshot.input = input;
+            state
+                .diagnostics
+                .retain(|key, _| !key.starts_with("terminal:"));
+            for (index, diagnostic) in terminal.diagnostics.into_iter().enumerate() {
+                state
+                    .diagnostics
+                    .insert(format!("terminal:{index}"), visible(&diagnostic, 512));
+            }
+        });
+    }
+
+    pub(super) fn diagnostic(&self, owner: &Host, key: &str, message: Option<String>) {
+        self.update(owner, |state| match message {
+            Some(message) => {
+                state
+                    .diagnostics
+                    .insert(key.to_owned(), visible(&message, 512));
+            }
+            None => {
+                state.diagnostics.remove(key);
+            }
+        });
+    }
+
+    pub(super) fn progress(&self, owner: &Host, label: &str, text: &str) {
+        let lines = text
+            .split('\n')
+            .map(|line| visible(line, 1024))
+            .filter(|line| !line.is_empty())
+            .collect::<Vec<_>>();
+        let start = lines.len().saturating_sub(8);
+        self.update(owner, |state| {
+            state.snapshot.progress = Some(ModPanel {
+                title: visible(label, 128),
+                lines: lines[start..].to_vec(),
+            });
+        });
+    }
+
+    pub(super) fn finish(&self, owner: &Host, mod_id: &str, tool: &str, label: &str, status: &str) {
+        self.update(owner, |state| {
+            state.snapshot.progress = None;
+            state.sequence += 1;
+            state.snapshot.activity.push(ModActivity {
+                sequence: state.sequence,
+                mod_id: mod_id.to_owned(),
+                tool: visible(tool, 128),
+                label: visible(label, 128),
+                status: status.to_owned(),
+            });
+            let excess = state.snapshot.activity.len().saturating_sub(32);
+            state.snapshot.activity.drain(..excess);
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Views, visible};
+
+    #[test]
+    fn welcome_phase_survives_ready_reload_and_rejected_input_until_accepted_start() {
+        let views = Views::new();
+        assert_eq!(
+            views.presentation("thread-a", Some("fresh"))["phase"],
+            "fresh"
+        );
+        // A view refresh, reload, or rejected submission does not supply an accepted phase.
+        assert_eq!(views.presentation("thread-a", None)["phase"], "fresh");
+        views.presentation("thread-a", Some("started"));
+        assert_eq!(views.presentation("thread-a", None)["phase"], "started");
+        assert_eq!(views.current_presentation()["phase"], "started");
+        views.presentation("thread-b", Some("resumed"));
+        assert_eq!(views.presentation("thread-b", None)["phase"], "resumed");
+        assert_eq!(views.presentation("thread-c", None)["phase"], "fresh");
+    }
+
+    #[test]
+    fn welcome_resume_and_fork_markers_are_latched_before_ready_publication() {
+        let views = Views::new();
+        let thread = codex_extension_api::ExtensionData::new("resumed");
+        thread.insert(codex_extension_api::ResumedThread);
+        views.start_thread(&thread);
+        assert_eq!(views.current_presentation()["phase"], "resumed");
+        assert_eq!(
+            views.presentation(thread.level_id(), None)["phase"],
+            "resumed"
+        );
+        let fork = codex_extension_api::ExtensionData::new("forked");
+        fork.insert(codex_extension_api::ForkedFromThread(
+            codex_protocol::ThreadId::new(),
+        ));
+        views.start_thread(&fork);
+        assert_eq!(views.current_presentation()["phase"], "resumed");
+        assert_eq!(views.current_presentation()["thread_id"], "forked");
+    }
+
+    #[test]
+    fn the_published_snapshot_is_served_from_memory_after_the_first_update() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let host = crate::Host {
+            root: root.clone(),
+            repository: root.clone(),
+            repository_identity: "fixture".into(),
+            config: crate::config::HostConfig::default(),
+            routes: std::sync::Mutex::new(crate::RouteTable {
+                stamp: None,
+                config: std::sync::Arc::new(crate::config::HostConfig::default()),
+                error: None,
+            }),
+            accounts: std::sync::Arc::new(crate::accounting::Accounts::default()),
+            manager: std::sync::Weak::new(),
+            epoch: 1,
+        };
+        let views = Views::new();
+        assert!(views.published().is_none());
+        views.diagnostic(&host, "k", Some("broken".into()));
+        std::fs::remove_file(root.join("mod-view.json")).unwrap();
+        let published = views.published().expect("published after an update");
+        assert_eq!(published.diagnostics, vec!["broken".to_owned()]);
+    }
+
+    #[test]
+    fn visible_bounds_bytes_on_a_character_boundary() {
+        let text = visible(&"💥".repeat(300), 512);
+        assert_eq!(text.len(), 512);
+        assert_eq!(text.chars().count(), 128);
+        assert_eq!(visible("a\u{7}é", 2), "a");
+    }
+}
diff --git a/codex-rs/ext/omd/src/workspace_operations.rs b/codex-rs/ext/omd/src/workspace_operations.rs
new file mode 100644
index 000000000..e7efb62b8
--- /dev/null
+++ b/codex-rs/ext/omd/src/workspace_operations.rs
@@ -0,0 +1,662 @@
+use codex_file_system::FileSystemSandboxContext;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use codex_protocol::permissions::FileSystemSandboxPolicyContext;
+use codex_protocol::permissions::ReadDenyMatcher;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+
+pub(super) struct WorkspaceAuthority {
+    pub repository: PathBuf,
+    pub session_root: Option<PathBuf>,
+    pub session_database: Option<PathBuf>,
+    pub policy: FileSystemSandboxPolicy,
+    pub context: FileSystemSandboxContext,
+}
+
+fn local_context(
+    profile: codex_protocol::models::PermissionProfile,
+    cwd: PathUri,
+) -> Result<FileSystemSandboxContext, String> {
+    let mut context = FileSystemSandboxContext::from_permission_profile(profile, cwd);
+    context.user_home_dir = PathUri::from_host_native_path("~").ok();
+    context.temporary_directories = Some(
+        match std::env::var_os("TMPDIR").filter(|path| !path.is_empty()) {
+            Some(path) => vec![PathUri::from(
+                AbsolutePathBuf::from_absolute_path(PathBuf::from(path))
+                    .map_err(|e| e.to_string())?,
+            )],
+            None => Vec::new(),
+        },
+    );
+    Ok(context)
+}
+
+pub(super) async fn workspace_snapshot(lead: &crate::Lead) -> Result<codex_omd::Snapshot, String> {
+    let authority = WorkspaceAuthority::for_lead(lead).await?;
+    let approved = lead
+        .host
+        .config
+        .approved_untracked
+        .iter()
+        .cloned()
+        .collect();
+    let limit = lead.host.config.snapshot_bytes;
+    tokio::task::spawn_blocking(move || {
+        let snapshot = codex_omd::capture_tracked(&authority.repository, &approved, limit)
+            .map_err(|error| error.to_string())?;
+        if snapshot
+            .files
+            .keys()
+            .any(|path| !authority.readable(&authority.repository.join(path)))
+        {
+            return Err("workspace_snapshot_permission_denied".to_owned());
+        }
+        Ok(snapshot)
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
+
+impl WorkspaceAuthority {
+    pub async fn for_call(lead: &crate::Lead, call: &crate::ToolCall<'_>) -> Result<Self, String> {
+        let host = &lead.host;
+        let manager = host
+            .manager
+            .upgrade()
+            .ok_or("native_thread_manager_stopped")?;
+        let config = manager
+            .get_thread(lead.thread)
+            .await
+            .map_err(|e| e.to_string())?
+            .config()
+            .await;
+        let environment = call.environments.as_slice();
+        if environment.len() != 1
+            || environment[0].environment_id != "local"
+            || environment[0].cwd != codex_utils_path_uri::PathUri::from_abs_path(&config.cwd)
+            || config.cwd.as_path() != host.repository
+        {
+            return Err("workspace_operation_requires_local_repository".into());
+        }
+        let context = environment[0]
+            .fs()
+            .cache_key()
+            .sandbox_context()
+            .cloned()
+            .ok_or("workspace_call_authority_unavailable")?;
+        let mut roots = context
+            .workspace_roots
+            .iter()
+            .map(codex_utils_path_uri::PathUri::to_abs_path)
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|e| e.to_string())?;
+        if roots.is_empty() {
+            roots.push(config.cwd.clone());
+        }
+        let configured = config
+            .permissions
+            .permission_profile()
+            .clone()
+            .materialize_project_roots_with_workspace_roots(&roots);
+        let actual = context
+            .permissions
+            .clone()
+            .materialize_project_roots_with_workspace_roots(&roots);
+        let effective = crate::execution::intersect(&configured, &actual, config.cwd.as_path())?;
+        let current = lead
+            .permission_profile
+            .lock()
+            .map_err(|_| "permission_profile_poisoned")?
+            .clone();
+        let effective = crate::execution::intersect(&effective, &current, config.cwd.as_path())?;
+        let mut context = context;
+        context.permissions = effective.clone();
+        Ok(Self {
+            repository: host.repository.clone(),
+            policy: effective.file_system_sandbox_policy(),
+            context,
+            session_root: Some(config.codex_home.join("sessions").to_path_buf()),
+            session_database: Some(config.sqlite.state_db_path()),
+        })
+    }
+
+    pub fn readable(&self, path: &std::path::Path) -> bool {
+        self.access(path, false)
+    }
+
+    pub fn writable(&self, path: &std::path::Path) -> bool {
+        self.access(path, true)
+    }
+
+    fn access(&self, path: &std::path::Path, write: bool) -> bool {
+        let Some(name) = path
+            .strip_prefix(&self.repository)
+            .ok()
+            .and_then(std::path::Path::to_str)
+        else {
+            return false;
+        };
+        if !name.is_empty() {
+            return self.paths(&[name.to_owned()], write).is_ok();
+        }
+        let Ok(absolute) = AbsolutePathBuf::from_absolute_path_checked(&self.repository) else {
+            return false;
+        };
+        let context = FileSystemSandboxPolicyContext {
+            cwd: &self.context.cwd,
+            workspace_roots: &self.context.workspace_roots,
+            user_home_dir: self.context.user_home_dir.as_ref(),
+            temporary_directories: self.context.temporary_directories.as_deref(),
+        };
+        let uri = PathUri::from_abs_path(&absolute);
+        self.policy.can_read_path(&uri, &context)
+            && (!write || self.policy.can_write_path(&uri, &context))
+    }
+
+    #[cfg(test)]
+    pub fn for_platform(
+        repository: &std::path::Path,
+        profile: codex_protocol::models::PermissionProfile,
+    ) -> Result<Self, String> {
+        let absolute = AbsolutePathBuf::from_absolute_path_checked(repository)
+            .map_err(|error| error.to_string())?;
+        let profile =
+            profile.materialize_project_roots_with_workspace_roots(std::slice::from_ref(&absolute));
+        let context = FileSystemSandboxContext::from_permission_profile(
+            profile.clone(),
+            PathUri::from_abs_path(&absolute),
+        );
+        Ok(Self {
+            repository: repository.to_path_buf(),
+            session_root: None,
+            session_database: None,
+            policy: profile.file_system_sandbox_policy(),
+            context,
+        })
+    }
+
+    pub fn visible_changes(
+        &self,
+        changes: Vec<codex_omd::WorkspaceChange>,
+    ) -> Result<Vec<codex_omd::WorkspaceChange>, String> {
+        for change in &changes {
+            if self
+                .paths(std::slice::from_ref(&change.path), false)
+                .is_err()
+            {
+                return Err("workspace_change_scope_unavailable".into());
+            }
+        }
+        Ok(changes)
+    }
+
+    pub fn rename_input(
+        &self,
+        old: &str,
+        new: &str,
+        active: impl Fn() -> bool,
+    ) -> Result<Value, String> {
+        self.paths(&[old.to_owned(), new.to_owned()], true)?;
+        let read = self.call("workspace.read", json!({"paths":[old,new]}), active)?;
+        let source = read["files"][old]["sha256"]
+            .as_str()
+            .ok_or("rename_source_missing")?;
+        if !read["files"][new].is_null() {
+            return Err("rename_destination_exists".into());
+        }
+        let mut expected = serde_json::Map::new();
+        expected.insert(old.to_owned(), Value::String(source.to_owned()));
+        expected.insert(new.to_owned(), Value::Null);
+        Ok(json!({"repository":self.repository,"old":old,"new":new,"expected":expected}))
+    }
+
+    pub fn apply_rename_plan(
+        &self,
+        input: &Value,
+        plan: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value, String> {
+        #[derive(Deserialize)]
+        #[serde(tag = "status", rename_all = "snake_case", deny_unknown_fields)]
+        enum Plan {
+            Ready {
+                expected: std::collections::BTreeMap<String, Option<String>>,
+                writes: std::collections::BTreeMap<String, String>,
+            },
+            Fallback {
+                reason: String,
+            },
+        }
+        let plan: Plan = serde_json::from_value(plan).map_err(|error| error.to_string())?;
+        let Plan::Ready { expected, writes } = plan else {
+            let Plan::Fallback { reason } = plan else {
+                unreachable!()
+            };
+            return Ok(
+                json!({"status":"fallback","reason":reason.chars().take(512).collect::<String>()}),
+            );
+        };
+        let old = input["old"].as_str().ok_or("rename_old_missing")?;
+        let new = input["new"].as_str().ok_or("rename_new_missing")?;
+        if expected
+            .get(old)
+            .and_then(Option::as_ref)
+            .map(String::as_str)
+            != input["expected"][old].as_str()
+            || expected.get(new) != Some(&None)
+        {
+            return Err("rename_plan_stale_or_unscoped".into());
+        }
+        let result = self.call(
+            "workspace.transaction",
+            json!({"expected":expected,"writes":writes,"renames":[{"old":old,"new":new}]}),
+            active,
+        )?;
+        Ok(json!({"status":"renamed","files":result["files"]}))
+    }
+
+    pub fn request_rename(
+        &self,
+        arguments: Value,
+        runtime: &mut codex_omd::ModHost,
+        processes: &crate::managed_process::ManagedProcesses,
+        protected: &[PathBuf],
+        generation: u64,
+        active: impl Fn() -> bool,
+    ) -> Result<Value, String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Input {
+            old: String,
+            new: String,
+        }
+        let request: Input =
+            serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+        let payload = self.rename_input(&request.old, &request.new, &active)?;
+        if !runtime.has_event("workspace_pre_rename") {
+            return Ok(json!({"status":"fallback","reason":"no_pre_rename_handler"}));
+        }
+        let proposals = runtime.event_guarded_with(
+            "workspace_pre_rename",
+            payload.clone(),
+            &active,
+            |id, call| {
+                let result = match call.operation.as_str() {
+                    "workspace.read" => self.call(&call.operation, call.arguments, &active),
+                    "process.start"
+                        if call
+                            .arguments
+                            .as_object()
+                            .is_some_and(|fields| fields.contains_key("network")) =>
+                    {
+                        Err("pre_rename_operation_unavailable".into())
+                    }
+                    operation if operation.starts_with("process.") => processes.call(
+                        crate::managed_process::ProcessOwner {
+                            id,
+                            generation,
+                            repository: &self.repository,
+                            policy: &self.policy,
+                            protected,
+                            os_access: None,
+                        },
+                        operation,
+                        call.arguments,
+                        &active,
+                    ),
+                    _ => Err("pre_rename_operation_unavailable".into()),
+                };
+                result.map_err(std::io::Error::other)
+            },
+        );
+        let mut ready = Vec::new();
+        let mut fallback = "server_rename_unavailable".to_owned();
+        for (_, proposal) in proposals {
+            match proposal {
+                Ok(value) if value["status"] == "ready" => ready.push(value),
+                Ok(value) if value["status"] == "fallback" => {
+                    fallback = value["reason"]
+                        .as_str()
+                        .unwrap_or("server_rename_unavailable")
+                        .chars()
+                        .take(512)
+                        .collect();
+                }
+                Ok(value) if value.is_null() => (),
+                Ok(_) => return Err("invalid_pre_rename_result".into()),
+                Err(error) => return Err(format!("pre_rename_handler_failed: {error}")),
+            }
+        }
+        match ready.len() {
+            0 => Ok(json!({"status":"fallback","reason":fallback})),
+            1 => self.apply_rename_plan(&payload, ready.remove(0), active),
+            _ => Err("pre_rename_handler_conflict".into()),
+        }
+    }
+
+    pub async fn for_lead(lead: &crate::Lead) -> Result<Self, String> {
+        let host = &lead.host;
+        let manager = host
+            .manager
+            .upgrade()
+            .ok_or("native_thread_manager_stopped")?;
+        let config = manager
+            .get_thread(lead.thread)
+            .await
+            .map_err(|error| error.to_string())?
+            .config()
+            .await;
+        if config.cwd.as_path() != host.repository {
+            return Err("workspace_operation_requires_local_repository".into());
+        }
+        let current = lead
+            .permission_profile
+            .lock()
+            .map_err(|_| "permission_profile_poisoned")?
+            .clone();
+        let profile = crate::execution::intersect(
+            &config.permissions.effective_permission_profile(),
+            &current,
+            config.cwd.as_path(),
+        )?
+        .materialize_project_roots_with_workspace_roots(std::slice::from_ref(&config.cwd));
+        let context = local_context(profile.clone(), PathUri::from_abs_path(&config.cwd))?;
+        Ok(Self {
+            repository: host.repository.clone(),
+            session_root: Some(config.codex_home.join("sessions").to_path_buf()),
+            session_database: Some(config.sqlite.state_db_path()),
+            policy: profile.file_system_sandbox_policy(),
+            context,
+        })
+    }
+
+    fn paths(&self, names: &[String], write: bool) -> Result<Vec<PathBuf>, String> {
+        if names.is_empty()
+            || names.len() > 128
+            || names.iter().collect::<BTreeSet<_>>().len() != names.len()
+        {
+            return Err("workspace_path_scope_invalid".into());
+        }
+        let context = FileSystemSandboxPolicyContext {
+            cwd: &self.context.cwd,
+            workspace_roots: &self.context.workspace_roots,
+            user_home_dir: self.context.user_home_dir.as_ref(),
+            temporary_directories: self.context.temporary_directories.as_deref(),
+        };
+        let deny_read = ReadDenyMatcher::try_new_with_context(&self.policy, &context)?;
+        let mut paths = Vec::with_capacity(names.len());
+        for name in names {
+            let path =
+                codex_omd::workspace_path(&self.repository, name).map_err(|e| e.to_string())?;
+            let absolute =
+                AbsolutePathBuf::from_absolute_path_checked(&path).map_err(|e| e.to_string())?;
+            let uri = PathUri::from_abs_path(&absolute);
+            let readable = self.policy.can_read_path(&uri, &context)
+                && !deny_read
+                    .as_ref()
+                    .is_some_and(|matcher| matcher.is_read_denied_uri(&uri, &context));
+            if !readable || write && !self.policy.can_write_path(&uri, &context) {
+                return Err(if write {
+                    "workspace_write_permission_denied"
+                } else {
+                    "workspace_read_permission_denied"
+                }
+                .into());
+            }
+            paths.push(path);
+        }
+        Ok(paths)
+    }
+
+    pub fn call(
+        &self,
+        operation: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value, String> {
+        if !active() {
+            return Err("workspace_operation_cancelled".into());
+        }
+        match operation {
+            "workspace.read" => {
+                #[derive(Deserialize)]
+                #[serde(deny_unknown_fields)]
+                struct Input {
+                    paths: Vec<String>,
+                }
+                let input: Input = serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+                self.paths(&input.paths, false)?;
+                let selected = input.paths.into_iter().collect::<BTreeSet<_>>();
+                let snapshot =
+                    codex_omd::Snapshot::capture(&self.repository, &selected, 4 * 1024 * 1024)
+                        .map_err(|e| e.to_string())?;
+                let mut files = serde_json::Map::new();
+                for name in selected {
+                    let value = match snapshot.files.get(&name) {
+                        Some(file) => json!({
+                            "text": String::from_utf8(file.bytes.clone()).map_err(|_| "workspace_text_not_utf8")?,
+                            "sha256": crate::execution::hash(&file.bytes),
+                        }),
+                        None => Value::Null,
+                    };
+                    files.insert(name, value);
+                }
+                Ok(json!({"files": files}))
+            }
+            "workspace.transaction" => {
+                let transaction: codex_omd::WorkspaceTransaction =
+                    serde_json::from_value(arguments).map_err(|e| e.to_string())?;
+                self.paths(
+                    &transaction.expected.keys().cloned().collect::<Vec<_>>(),
+                    true,
+                )?;
+                let result = transaction
+                    .apply(&self.repository, active)
+                    .map_err(|e| e.to_string())?;
+                serde_json::to_value(result).map_err(|e| e.to_string())
+            }
+            _ => Err("unsupported_workspace_operation".into()),
+        }
+    }
+}
+
