+    pub(super) async fn refresh_rewritten_thread(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+    ) -> Result<()> {
+        let Some(channel) = self.thread_event_channels.get_mut(&thread_id) else {
+            return Ok(());
+        };
+        if channel.attachment() != ThreadEventAttachment::Live {
+            return Ok(());
+        }
