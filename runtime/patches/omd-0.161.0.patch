+        .runtime
+        .lock()
+        .unwrap()
+        .state("observer")
+        .cloned()
+        .unwrap();
+    assert_eq!(
+        log[0]["calls"],
+        json!([{"call_id": "c1", "tool": "exec_command", "outcome": "failed"},
+            {"call_id": "c2", "tool": "", "outcome": ""}])
