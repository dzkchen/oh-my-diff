+fn api_support(value: &str) -> Option<(&'static str, &'static str)> {
+    SUPPORTED_MOD_APIS
+        .iter()
+        .find(|(candidate, ..)| *candidate == value)
+        .map(|(_, stability, support_until)| (*stability, *support_until))
+}
