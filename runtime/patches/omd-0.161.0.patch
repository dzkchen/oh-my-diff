+    fn update_settings(
+        &self,
+        path: &Path,
+        change: impl FnOnce(&mut BTreeMap<String, Value>),
+    ) -> Result<BTreeMap<String, Value>> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if hash != selection.sha256 {
+            return Err(failure("source_changed: inspect and trust the new digest"));
+        }
+        let mut settings = selection.settings.clone();
+        change(&mut settings);
+        validate_settings(&package, &settings)?;
+        selection.settings = settings.clone();
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.write("mods.json", &serde_json::to_value(config)?)?;
+        Ok(settings)
+    }
+
+    pub fn discover(user: &Path, project: &Path) -> Result<Value> {
+        let mut selected: BTreeMap<String, Value> = BTreeMap::new();
+        let mut errors = Vec::new();
+        for (scope, root) in [("user", user), ("project", project)] {
+            if !root.exists() {
+                continue;
+            }
+            let mut paths = std::fs::read_dir(root)?
+                .map(|e| e.map(|e| e.path()))
+                .collect::<std::io::Result<Vec<_>>>()?;
+            if paths.len() > 256 {
+                return Err(failure("discovery_limit"));
+            }
+            paths.sort();
+            for path in paths {
+                if !path.is_dir() {
+                    continue;
+                }
+                let result = path
+                    .canonicalize()
+                    .and_then(|path| Self::inspect_package(&path));
+                match result {
+                    Ok(mut value) => {
+                        let id = value["manifest"]["id"]
+                            .as_str()
+                            .ok_or_else(|| failure("missing_mod_id"))?
+                            .to_owned();
+                        value["scope"] = json!(scope);
+                        value["shadows"] = selected
+                            .get(&id)
+                            .map(|v| v["path"].clone())
+                            .unwrap_or(Value::Null);
+                        value["trusted"] = json!(false);
+                        selected.insert(id, value);
+                    }
+                    Err(error) => errors.push(json!({"path":path,"error":error.to_string()})),
+                }
+            }
+        }
+        Ok(
+            json!({"packages":selected.into_values().collect::<Vec<_>>(),"errors":errors,"precedence":"project over user; discovery never grants trust"}),
+        )
+    }
+
+    pub fn migrate(&self, path: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, source, hash) = store::package(path)?;
+        if hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package.capabilities.iter().any(|c| c == "store")
+        {
+            return Err(failure("migration_requires_trusted_store_capability"));
+        }
+        let name = ModStore::state_name(&package.id, &selection.scope);
+        let previous: Value =
+            serde_json::from_slice(&store::read(&self.root.join(&name), 65_536)?)?;
+        let from = previous["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if previous["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || from == u64::from(package.state_version)
+        {
+            return Err(failure("migration_requires_different_state_version"));
+        }
+        let to = package.state_version;
+        let mut loaded = Loaded {
+            package,
+            source,
+            assets: BTreeMap::new(),
+            selection: selection.clone(),
+            adapter: None,
+            state: previous["value"].clone(),
+            registrations: Registrations::default(),
+            source_use: ModSourceUse::default(),
+            unused_grants: Vec::new(),
+            unused_environment: Vec::new(),
+            withheld: Vec::new(),
+            error: None,
+            telemetry: ModTelemetry::default(),
+        };
+        let inspected = ModHost::run(&config.node, &loaded, "inspect", "", Value::Null, &|| true)?;
+        ModHost::validate_registrations(&loaded.package, &inspected.registrations)?;
+        if inspected.state != loaded.state
+            || !inspected
+                .registrations
+                .events
+                .iter()
+                .any(|e| e == "migrate")
+        {
+            return Err(failure("explicit_migration_handler_required"));
+        }
+        loaded.registrations = inspected.registrations.clone();
+        let reply = ModHost::run(
+            &config.node,
+            &loaded,
+            "migrate",
+            "",
+            json!({"from":from,"to":to}),
+            &|| true,
+        )?;
+        if reply.registrations != inspected.registrations {
+            return Err(failure("migration_changed_registration"));
+        }
+        let state_name = ModStore::state_name(&loaded.package.id, &selection.scope);
+        let backup = format!(
+            "{}-backup-{}",
+            state_name,
+            digest(&serde_json::to_vec(&previous)?)
+        );
+        self.write(&backup, &previous)?;
+        self.write(
+            &name,
+            &json!({"schema":MOD_STATE_STORAGE_SCHEMA_VERSION,"version":to,"value":reply.state}),
+        )?;
+        Ok(
+            json!({"id":loaded.package.id,"from":from,"to":to,"backup":self.root.join(backup),
+            "source_sha256":hash,"settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+
+    pub fn rollback(&self, path: &Path, backup: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter()
+            .find(|selection| selection.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if selection.enabled
+            || hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "store")
+        {
+            return Err(failure(
+                "rollback_requires_disabled_trusted_store_capability",
+            ));
+        }
+        let backup = backup.canonicalize()?;
+        if backup.parent() != Some(self.root.as_path()) {
+            return Err(failure("rollback_backup_must_be_in_store"));
+        }
+        let state_name = ModStore::state_name(&package.id, &selection.scope);
+        let prefix = format!("{state_name}-backup-");
+        let backup_name = backup
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| failure("rollback_backup_does_not_match_package_scope"))?;
+        let Some(expected_digest) = backup_name.strip_prefix(&prefix) else {
+            return Err(failure("rollback_backup_does_not_match_package_scope"));
+        };
+        let restored: Value = serde_json::from_slice(&store::read(&backup, 65_536)?)?;
+        if digest(&serde_json::to_vec(&restored)?) != expected_digest {
+            return Err(failure("rollback_backup_digest_mismatch"));
+        }
+        let restored_version = restored["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if restored["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION {
+            return Err(failure("incompatible_state_storage_schema"));
+        }
+        let current_path = self.root.join(&state_name);
+        let current: Value = serde_json::from_slice(&store::read(&current_path, 65_536)?)?;
+        if current["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || current["version"].as_u64().is_none()
+        {
+            return Err(failure("incompatible_current_state"));
+        }
+        let recovery = format!(
+            "{state_name}-rollback-{}",
+            digest(&serde_json::to_vec(&current)?)
+        );
+        self.write(&recovery, &current)?;
+        self.write(&state_name, &restored)?;
+        Ok(
+            json!({"id":package.id,"from":current["version"],"to":restored_version,
+            "restored":backup,"recovery":self.root.join(recovery),"source_sha256":hash,
+            "settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/mods/process.rs b/codex-rs/omd/src/mods/process.rs
new file mode 100644
index 000000000..33fa8b3b3
--- /dev/null
+++ b/codex-rs/omd/src/mods/process.rs
@@ -0,0 +1,342 @@
+use super::Result;
+use super::failure;
+use serde_json::Value;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Child;
+use std::process::ChildStdin;
+use std::process::ChildStdout;
+use std::process::Command;
+use std::process::Stdio;
+use std::sync::Mutex;
+use std::sync::mpsc;
+use std::time::Duration;
+use std::time::Instant;
+
+const RUNNER: &str = include_str!("runner.mjs");
+
+fn command(node: &Path) -> Result<Command> {
+    if !cfg!(target_os = "macos") {
+        return Err(failure("unsupported_platform: mods require macOS Seatbelt"));
+    }
+    let node = node.canonicalize()?;
+    let literal = serde_json::to_string(&node)?;
+    let profile = format!(
+        "(version 1)(deny default)(allow process-exec (literal {literal}))(allow process-info* (target self))(allow sysctl-read)(allow signal (target self))(allow file-read* (literal \"/\")(literal {literal})(subpath \"/System/Library\")(subpath \"/usr/lib\")(literal \"/dev/null\")(literal \"/dev/urandom\")(literal \"/dev/random\"))(allow file-write* (literal \"/dev/null\"))"
+    );
+    let mut command = Command::new("/usr/bin/sandbox-exec");
+    command
+        .args(["-p", &profile])
+        .arg(&node)
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .current_dir("/");
+    Ok(command)
+}
+
+type Spares = (Vec<(PathBuf, Child)>, Option<Instant>);
+
+static SPARES: Mutex<Spares> = Mutex::new((Vec::new(), None));
+const BUSY_RUNNERS: usize = 3;
+const IDLE_AFTER: Duration = Duration::from_secs(5);
+
+fn stop(mut child: Child) {
+    let _ = child.kill();
+    let _ = child.wait();
+}
+
+/// Trims the warm pool back to one runner once callbacks have been idle for five seconds, and
+/// stops render runners unused for a minute.
+fn reap() {
+    static REAPER: std::sync::Once = std::sync::Once::new();
+    REAPER.call_once(|| {
+        std::thread::spawn(|| {
+            loop {
+                std::thread::sleep(Duration::from_secs(1));
+                if let Ok(mut warm) = WARM.lock() {
+                    for runner in warm.extract_if(.., |runner| runner.used.elapsed() >= WARM_IDLE) {
+                        stop(runner.child);
+                    }
+                }
+                let Ok(mut spares) = SPARES.lock() else {
+                    return;
+                };
+                if spares.1.is_some_and(|last| last.elapsed() >= IDLE_AFTER) {
+                    while spares.0.len() > 1 {
+                        if let Some((_, child)) = spares.0.pop() {
+                            stop(child);
+                        }
+                    }
+                }
+            }
+        });
+    });
+}
+
+fn spawn(node: &Path) -> Result<Child> {
+    command(node)?
+        .args([
+            "--max-old-space-size=64",
+            "--enable-source-maps",
+            "--no-warnings",
+            "--experimental-vm-modules",
+            "--input-type=module",
+            "--eval",
+            RUNNER,
+        ])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+}
+
+fn runner(node: &Path) -> Result<Child> {
+    let mut spares = SPARES.lock().map_err(|_| failure("mod_runner_poisoned"))?;
+    let busy = spares.1.is_some_and(|last| last.elapsed() < IDLE_AFTER);
+    spares.1 = Some(Instant::now());
+    for (_, child) in spares.0.extract_if(.., |(path, child)| {
+        path != node || !matches!(child.try_wait(), Ok(None))
+    }) {
+        stop(child);
+    }
+    let warm = (!spares.0.is_empty()).then(|| spares.0.remove(0).1);
+    while spares.0.len() < if busy { BUSY_RUNNERS } else { 1 } {
+        match spawn(node) {
+            Ok(child) => spares.0.push((node.to_path_buf(), child)),
+            Err(_) => break,
+        }
+    }
+    reap();
+    warm.map_or_else(|| spawn(node), Ok)
+}
+
+fn request_line(request: &Value) -> Result<Vec<u8>> {
+    let mut bytes = serde_json::to_vec(request)?;
+    if bytes.len() > 524_288 {
+        return Err(failure("input_limit"));
+    }
+    bytes.push(b'\n');
+    Ok(bytes)
+}
+
+fn lines(stdout: ChildStdout) -> (mpsc::Receiver<Vec<u8>>, std::thread::JoinHandle<()>) {
+    let (sender, lines) = mpsc::channel();
+    let reader = std::thread::spawn(move || {
+        let mut stdout = BufReader::new(stdout);
+        loop {
+            let mut line = Vec::new();
+            match (&mut stdout).take(262_145).read_until(b'\n', &mut line) {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {
+                    if sender.send(line).is_err() {
+                        break;
+                    }
+                }
+            }
+        }
+    });
+    (lines, reader)
+}
+
+/// Sends one request and answers its host calls until the runner writes its result line.
+fn converse(
+    stdin: &mut ChildStdin,
+    lines: &mpsc::Receiver<Vec<u8>>,
+    bytes: &[u8],
+    budget: Duration,
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(Value) -> Result<Value>,
+) -> (Result<Vec<u8>>, Instant) {
+    let mut deadline = Instant::now() + budget + Duration::from_millis(250);
+    if let Err(error) = stdin.write_all(bytes) {
+        return (Err(error.into()), deadline);
+    }
+    let output = loop {
+        if !active() {
+            break Err(failure("callback_cancelled"));
+        }
+        let line = match lines.recv_timeout(Duration::from_millis(10)) {
+            Ok(line) => line,
+            Err(mpsc::RecvTimeoutError::Timeout) if Instant::now() < deadline => continue,
+            Err(mpsc::RecvTimeoutError::Timeout) => break Err(failure("callback_timeout")),
+            Err(mpsc::RecvTimeoutError::Disconnected) => break Ok(Vec::new()),
+        };
+        if line.len() > 262_144 {
+            break Err(failure("output_limit"));
+        }
+        let frame = match serde_json::from_slice::<Value>(&line) {
+            Ok(frame) if frame.get("call").is_some() => frame,
+            _ => break Ok(line),
+        };
+        let started = Instant::now();
+        let receipt = match host(frame) {
+            Ok(receipt) => receipt,
+            Err(error) => break Err(error),
+        };
+        deadline += started.elapsed();
+        let mut receipt = receipt.to_string().into_bytes();
+        receipt.push(b'\n');
+        if let Err(error) = stdin.write_all(&receipt) {
+            break Err(error.into());
+        }
+    };
+    (output, deadline)
+}
+
+struct Warm {
+    key: String,
+    child: Child,
+    stdin: ChildStdin,
+    lines: mpsc::Receiver<Vec<u8>>,
+    used: Instant,
+}
+
+static WARM: Mutex<Vec<Warm>> = Mutex::new(Vec::new());
+const WARM_RUNNERS: usize = 4;
+const WARM_IDLE: Duration = Duration::from_secs(60);
+
+fn warm_runner(node: &Path, key: &str) -> Result<Warm> {
+    let mut child = runner(node)?;
+    let stderr = child
+        .stderr
+        .take()
+        .ok_or_else(|| failure("missing_stderr"))?;
+    std::thread::spawn(move || std::io::copy(&mut { stderr }, &mut std::io::sink()));
+    let stdin = child.stdin.take().ok_or_else(|| failure("missing_stdin"))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| failure("missing_stdout"))?;
+    Ok(Warm {
+        key: key.to_owned(),
+        child,
+        stdin,
+        lines: lines(stdout).0,
+        used: Instant::now(),
+    })
+}
+
+/// Evaluates a render callback in a runner that stays activated for later renders with the same
+/// `key`: the package, its settings and state, everything except the render's own input.
+pub(super) fn evaluate_warm(
+    node: &Path,
+    key: &str,
+    request: &Value,
+    budget: Duration,
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(Value) -> Result<Value>,
+) -> Result<Value> {
+    let bytes = request_line(request)?;
+    let reused = WARM.lock().ok().and_then(|mut warm| {
+        let index = warm.iter().position(|runner| runner.key == key)?;
+        let mut runner = warm.swap_remove(index);
+        if matches!(runner.child.try_wait(), Ok(None)) {
+            Some(runner)
+        } else {
+            stop(runner.child);
+            None
+        }
+    });
+    let mut warm = match reused {
+        Some(warm) => warm,
+        None => warm_runner(node, key)?,
+    };
+    let (output, _) = converse(&mut warm.stdin, &warm.lines, &bytes, budget, active, host);
+    let value = output.and_then(|line| {
+        serde_json::from_slice::<Value>(&line)
+            .map_err(|_| failure("mod_process_failed: the render runner ended"))
+    });
+    match value {
+        Ok(value) if value.get("error").is_none() => {
+            warm.used = Instant::now();
+            if let Ok(mut runners) = WARM.lock() {
+                runners.push(warm);
+                while runners.len() > WARM_RUNNERS {
+                    if let Some(oldest) = runners
+                        .iter()
+                        .enumerate()
+                        .min_by_key(|(_, runner)| runner.used)
+                        .map(|(index, _)| index)
+                    {
+                        stop(runners.swap_remove(oldest).child);
+                    }
+                }
+            }
+            Ok(value)
+        }
+        Ok(value) => {
+            stop(warm.child);
+            Err(failure(
+                value["error"].as_str().unwrap_or("mod_process_failed"),
+            ))
+        }
+        Err(error) => {
+            stop(warm.child);
+            Err(error)
+        }
+    }
+}
+
+pub(super) fn evaluate(
+    node: &Path,
+    request: &Value,
+    budget: Duration,
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(Value) -> Result<Value>,
+) -> Result<Value> {
+    let bytes = request_line(request)?;
+    let mut child = runner(node)?;
+    let stderr = child
+        .stderr
+        .take()
+        .ok_or_else(|| failure("missing_stderr"))?;
+    let errors = std::thread::spawn(move || {
+        let mut output = Vec::new();
+        let _ = stderr.take(769).read_to_end(&mut output);
+        output
+    });
+    let mut stdin = child.stdin.take().ok_or_else(|| failure("missing_stdin"))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| failure("missing_stdout"))?;
+    let (lines, reader) = lines(stdout);
+    let (output, deadline) = converse(&mut stdin, &lines, &bytes, budget, active, host);
+    drop(stdin);
+    if output.is_ok() {
+        while matches!(child.try_wait(), Ok(None)) && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+    let _ = child.kill();
+    let status = child.wait();
+    let _ = reader.join();
+    let errors = errors.join().unwrap_or_default();
+    let output = output?;
+    let status = status?;
+    let value: Value = serde_json::from_slice(&output).map_err(|_| {
+        let errors = String::from_utf8_lossy(&errors);
+        if errors.contains("heap out of memory") || errors.contains("Reached heap limit") {
+            failure("mod_out_of_memory: the mod exceeded its 64 MB heap")
+        } else {
+            failure(format!(
+                "mod_process_failed: {}",
+                errors.lines().next().unwrap_or_default()
+            ))
+        }
+    })?;
+    if !status.success() || value.get("error").is_some() {
+        return Err(failure(
+            value["error"].as_str().unwrap_or("mod_process_failed"),
+        ));
+    }
+    Ok(value)
+}
+
+#[cfg(test)]
+#[path = "process_tests.rs"]
+mod tests;
