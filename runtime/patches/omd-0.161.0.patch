+/// Adds an extension-contributed role for a name no configured or built-in role defines.
+pub(crate) fn resolve_contributed_role(
+    session: &Session,
+    config: &mut Config,
+    role_name: Option<&str>,
+) -> Option<codex_utils_absolute_path::AbsolutePathBuf> {
+    let name = role_name?;
+    if crate::agent::role::resolve_role_config(config, name).is_some() {
+        return None;
+    }
+    let role = session
+        .services
+        .extensions
+        .agent_role_contributors()
+        .iter()
+        .find_map(|contributor| {
+            contributor.resolve_agent_role(&session.services.thread_extension_data, name)
+        })?;
+    config.agent_roles.insert(
+        name.to_owned(),
+        crate::config::AgentRoleConfig {
+            description: Some(role.description),
+            config_file: Some(role.config_file),
+            nickname_candidates: None,
+        },
+    );
+    role.cwd
+}
