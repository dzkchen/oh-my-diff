+    assert_eq!(change["model"]["after"], "b");
+    assert!(settings_change(&view("/r", json!([]), "a"), &view("/r", json!([]), "a")).is_none());
+
+    let core = &fixture.core;
+    *core.expansion.current.lock().unwrap() = Some(LeadHandle::new(&fixture.lead));
+    expansion::worktree(
