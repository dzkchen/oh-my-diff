+        .unwrap_err()
+        .starts_with("client_surface_unavailable")
+    );
+    let registration = register(Arc::new(Echo));
+    let authority = Authority {
+        epoch: 7,
+        admission: 11,
+        configuration: "configuration".into(),
+        source: "source".into(),
+    };
