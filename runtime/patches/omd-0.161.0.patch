+#[test]
+#[serial_test::serial]
+fn blits_queue_and_apply_one_update_per_frame_interval() {
+    let start = Instant::now();
+    let key = "raster-queue";
+    for glyph in ["a", "b"] {
+        let reply = blit_at(
+            key,
+            "owner",
+            json!({"rect": {"x": 1, "y": 0, "width": 2, "height": 1},
+                "cells": [glyph, [glyph, "#ff0000", null]]}),
+            start,
+        )
+        .expect("queued");
+        assert_eq!(reply["frame_ms"], 33);
+    }
+    let (rows, next) = super::rows(key, Some("owner"), "chart", 10, (4, 2), false, "", start);
+    assert_eq!(text(&rows), vec![" aa ", "    "]);
+    assert_eq!(next, Some(FRAME));
+    let (rows, next) = super::rows(
+        key,
+        Some("owner"),
+        "chart",
+        10,
+        (4, 2),
+        false,
+        "",
+        start + Duration::from_millis(5),
+    );
+    assert_eq!(text(&rows), vec![" aa ", "    "]);
+    assert_eq!(next, Some(Duration::from_millis(28)));
+    let (rows, next) = super::rows(
+        key,
+        Some("owner"),
+        "chart",
+        3,
+        (4, 2),
+        false,
+        "",
+        start + FRAME,
+    );
+    assert_eq!(
+        text(&rows),
+        vec![" bb", "   "],
+        "narrow components clip the canvas"
