+#[test]
+fn process_output_notices_coalesce_per_session_and_keep_exit_order() {
+    let state = State::default();
+    let thread = ThreadId::new();
+    let output = |session: &str, bytes| delivery::Pending::Process {
+        thread,
+        owner: "m".into(),
+        session: session.into(),
+        bytes,
+    };
+    for pending in [
+        output("a", Some(3)),
+        output("a", Some(4)),
+        output("b", Some(1)),
+        output("a", None),
+        output("a", Some(5)),
+    ] {
+        delivery::push(&state, pending);
+    }
+    let queue = state
+        .pending
+        .lock()
+        .unwrap()
+        .iter()
+        .map(|pending| match pending {
+            delivery::Pending::Process { session, bytes, .. } => (session.clone(), *bytes),
+            _ => unreachable!(),
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        queue,
+        vec![
+            ("a".to_owned(), Some(7)),
+            ("b".to_owned(), Some(1)),
+            ("a".to_owned(), None),
+            ("a".to_owned(), Some(5)),
+        ]
+    );
+}
