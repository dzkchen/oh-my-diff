+async fn shutdown_if_idle_refuses_an_active_turn_and_shuts_down_once_idle() -> anyhow::Result<()> {
+    let (release_response, response_gate) = oneshot::channel();
+    let (server, _completions) = start_streaming_sse_server(vec![vec![
+        chunk(ev_response_created("resp-1")),
+        chunk(ev_reasoning_item_added("reason-1", &["thinking"])),
+        gated_chunk(
+            response_gate,
+            vec![
+                ev_reasoning_item("reason-1", &["thinking"], &[]),
+                ev_completed("resp-1"),
+            ],
+        ),
+    ]])
+    .await;
+    let codex = build_codex(&server).await;
+    submit_user_input(&codex, "first prompt").await;
+    wait_for_reasoning_item_started(&codex).await;
+
+    assert!(!codex.shutdown_if_idle().await?);
+
+    release_response.send(()).expect("release model response");
+    wait_for_event(&codex, |event| {
+        assert!(!matches!(
+            event,
+            EventMsg::TurnAborted(_) | EventMsg::ShutdownComplete
+        ));
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert!(codex.shutdown_if_idle().await?);
+    wait_for_event(&codex, |event| matches!(event, EventMsg::ShutdownComplete)).await;
+    server.shutdown().await;
+    Ok(())
+}
