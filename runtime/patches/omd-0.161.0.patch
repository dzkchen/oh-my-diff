+fn fail(initial: bool, loaded: &mut Loaded, error: io::Error) -> Result<()> {
+    if !initial {
+        return Err(error);
+    }
+    if loaded.error.is_none() {
+        loaded.error = Some(error.to_string());
+    }
+    Ok(())
+}
