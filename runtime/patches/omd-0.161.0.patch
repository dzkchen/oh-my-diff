+// The confirmation comes from the plan the user saw, so a selection that changed since then is refused.
+fn select_contract(arguments: &Value, confirmed: Option<Confirmed>) -> Result<Value, String> {
+    let Some(Confirmed::Contract(confirmation)) = confirmed else {
+        return Err("contract_confirmation_missing".into());
+    };
+    let (documents, store, repository, key) = contract_inputs(arguments)?;
+    codex_omd::contract_cli::select(&documents, &store, &repository, &key, confirmation)
+        .map(|selected| json!({"selected": selected["selected"], "applies": "next_session"}))
+        .map_err(|error| error.to_string())
+}
+
+/// `config.describe` and `config.set` against one `config/read` result; `write` saves a Codex key.
+fn config_call(
+    call: &SurfaceCall,
+    read: &Value,
+    write: impl Fn(&str, &Value, &Value) -> Result<Value, String>,
+) -> Result<Value, String> {
+    if call.operation == "config.describe" {
+        return crate::mod_runtime::describe_config(read).map(|rows| json!({"rows": rows}));
+    }
+    let key = call.arguments["key"]
+        .as_str()
+        .ok_or("config_key_required")?;
+    let value = call
+        .arguments
+        .get("value")
+        .cloned()
+        .ok_or("config_value_required")?;
+    let row = crate::mod_runtime::config_row(read, key)?;
+    let effective = crate::mod_runtime::set_config(
+        &row,
+        value,
+        call.arguments.get("expected"),
+        &call.caller,
+        |value| match key
+            .strip_prefix("mods.")
+            .and_then(|rest| rest.split_once('.'))
+        {
+            Some((id, name)) => {
+                let store = crate::omd::mod_paths()
+                    .and_then(|paths| paths.store)
+                    .ok_or("mod store is not configured")?;
+                codex_omd::ModStore::open(store)
+                    .and_then(|store| codex_omd::write_settings(&store, id, &json!({name: value})))
+                    .map_err(|error| error.to_string())
+            }
+            None => write(key, value, &row["version"]),
+        },
+    )?;
+    Ok(json!({"key": key, "effective": effective}))
+}
+
+fn apply_package(call: &SurfaceCall, confirmed: Option<Confirmed>) -> Result<Value, String> {
+    let Some(Confirmed::Package(control)) = confirmed else {
+        return Err("package_confirmation_missing".into());
+    };
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = codex_omd::ModStore::open(paths.store.ok_or("mod store is not configured")?)
+        .map_err(|error| error.to_string())?;
+    crate::mod_surface::validate_call(call)?;
+    call.lifetime.begin_execution()?;
+    codex_omd::package_controls::apply(&store, &control).map_err(|error| error.to_string())
+}
+
+#[cfg(test)]
+pub(crate) fn apply_confirmed_package(
+    call: &SurfaceCall,
+    control: codex_omd::package_controls::PackageControl,
+) -> Result<Value, String> {
+    apply_package(call, Some(Confirmed::Package(Box::new(control))))
+}
