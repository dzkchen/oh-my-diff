+#[tokio::test]
+async fn closing_connections_cannot_attach() {
+    let (sender, _outgoing) = mpsc::channel(8);
+    let clients = OmdClients::new(Arc::new(OutgoingMessageSender::new(
+        sender,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    )));
+    let gate = ConnectionRpcGate::new();
+    gate.close().await;
+    let params = serde_json::from_value(json!({"name": "late",
+        "renderer": {"kind": "gui", "formats": ["svg"], "pointer": "pixel"}}))
+    .unwrap();
+    let refused = clients
+        .attach(
+            ConnectionRequestId {
+                connection_id: ConnectionId(93),
+                request_id: RequestId::Integer(1),
+            },
+            params,
+            &gate,
+        )
+        .await
+        .unwrap_err();
+    assert_eq!(
+        refused.message,
+        "client_surface_closed: the connection is closing"
+    );
