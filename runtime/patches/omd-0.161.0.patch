+    assert_eq!(
+        codex_omd::package_controls::list(&store, None).unwrap()["packages"][0]["enabled"],
+        false
+    );
+    let (release, receive) = std::sync::mpsc::channel();
+    let reply = std::thread::spawn(move || {
+        receive.recv().unwrap();
+        call.reply.send(Ok(committed)).unwrap();
+    });
+    let waiter =
+        std::thread::spawn(move || codex_omd::client_surface::wait(pending, &|| false, None));
+    release.send(()).unwrap();
+    let result = waiter.join().unwrap();
+    let _ = reply.join();
+    assert_eq!(result.unwrap()["status"], "applied");
+    *state() = previous;
+}
