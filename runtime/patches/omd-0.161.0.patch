+#[allow(clippy::await_holding_invalid_type)]
+async fn start_task_keeps_mailbox_mail_pending_until_it_owns_the_active_turn_lock() {
+    let (sess, tc, _rx) = make_session_and_context_with_rx().await;
+    sess.input_queue
+        .enqueue_mailbox_communication(
+            InterAgentCommunication::new(
+                AgentPath::try_from("/root/worker").expect("worker path should parse"),
+                AgentPath::root(),
+                Vec::new(),
+                "queued child update".to_string(),
+                /*trigger_turn*/ false,
+            ),
+            Default::default(),
+        )
+        .await;
+
+    let active = sess.active_turn.lock().await;
+    let starter = tokio::spawn({
+        let sess = Arc::clone(&sess);
+        async move {
+            sess.start_task(
+                tc,
+                Vec::new(),
+                NeverEndingTask {
+                    kind: TaskKind::Regular,
+                    listen_to_cancellation_token: true,
+                },
+            )
+            .await;
+        }
+    });
+    tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+    assert!(
+        sess.input_queue.has_pending_mailbox_items().await,
+        "an idle check must not see an empty mailbox before the turn is active"
+    );
+    drop(active);
+    starter.await.expect("start_task should finish");
+
+    assert!(!sess.input_queue.has_pending_mailbox_items().await);
+    assert!(sess.has_active_turn_or_pending_mailbox().await);
+    sess.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
