+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use codex_omd::ModAsciiBackdrop;
+use codex_omd::ModColor;
+use codex_omd::ModImageBackdrop;
+use codex_omd::ModSurfacePaint;
+use image::ImageFormat;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use std::io::Cursor;
+
+pub(crate) const BACKDROP_MIN_COLUMNS: u16 = 60;
+pub(crate) const BACKDROP_IMAGE_PIXELS: u32 = 4096;
+const KITTY_CHUNK: usize = 4096;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct BackdropEnvironment {
+    pub(crate) kitty_graphics: bool,
+    pub(crate) remote: bool,
+    pub(crate) no_color: bool,
+    pub(crate) reduced_motion: bool,
+    pub(crate) columns: u16,
+    pub(crate) owned_viewport: bool,
+}
+
+impl BackdropEnvironment {
+    pub(crate) fn graphics_eligible(self) -> bool {
+        self.owned_viewport
+            && self.kitty_graphics
+            && !self.remote
+            && !self.no_color
+            && !self.reduced_motion
+            && self.columns >= BACKDROP_MIN_COLUMNS
+    }
+}
+
+pub(crate) fn decode_image(bytes: &[u8]) -> Result<image::DynamicImage, String> {
+    if bytes.len() > 8 * 1024 * 1024 {
+        return Err("backdrop_image_too_large".into());
+    }
+    let format = image::guess_format(bytes).map_err(|_| "backdrop_format_unsupported")?;
+    if !matches!(format, ImageFormat::Png | ImageFormat::Jpeg) {
+        return Err("backdrop_format_unsupported".into());
+    }
+    let mut reader = image::ImageReader::with_format(Cursor::new(bytes), format);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(BACKDROP_IMAGE_PIXELS);
+    limits.max_image_height = Some(BACKDROP_IMAGE_PIXELS);
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    reader.limits(limits);
+    reader
+        .decode()
+        .map_err(|_| "backdrop_image_invalid_or_too_large".into())
+}
+
+pub(crate) fn rgb(color: ModColor) -> [u8; 3] {
+    match color {
+        ModColor::Rgb(r, g, b) => [r, g, b],
+        ModColor::Indexed(index) if index >= 232 => [8 + (index - 232) * 10; 3],
+        ModColor::Indexed(index) if index >= 16 => {
+            let levels = [0, 95, 135, 175, 215, 255];
+            let n = index - 16;
+            [
+                levels[usize::from(n / 36)],
+                levels[usize::from(n / 6 % 6)],
+                levels[usize::from(n % 6)],
+            ]
+        }
+        ModColor::Indexed(index) => [
+            [0, 0, 0],
+            [128, 0, 0],
+            [0, 128, 0],
+            [128, 128, 0],
+            [0, 0, 128],
+            [128, 0, 128],
+            [0, 128, 128],
+            [192, 192, 192],
+            [128, 128, 128],
+            [255, 0, 0],
+            [0, 255, 0],
+            [255, 255, 0],
+            [0, 0, 255],
+            [255, 0, 255],
+            [0, 255, 255],
+            [255, 255, 255],
+        ][usize::from(index)],
+    }
+}
+
+pub(crate) fn transformed_png(
+    bytes: &[u8],
+    settings: &ModImageBackdrop,
+    area: Rect,
+    paint: Option<&ModSurfacePaint>,
+) -> Result<Vec<u8>, String> {
+    let decoded = decode_image(bytes)?;
+    let width = (u32::from(area.width) * 8).clamp(1, 2048);
+    let height = (u32::from(area.height) * 16).clamp(1, 2048);
+    let position = settings.position.as_deref().unwrap_or("fit");
+    let scale = settings.scale.unwrap_or(1.0);
+    let fit = (width as f32 / decoded.width() as f32).min(height as f32 / decoded.height() as f32);
+    let fill = (width as f32 / decoded.width() as f32).max(height as f32 / decoded.height() as f32);
+    let factor = match position {
+        "fit" => fit,
+        "fill" => fill,
+        _ => 1.0,
+    } * scale;
+    // Bound the working bitmap, including user enlargement of a large source.
+    let scaled_width = (decoded.width() as f32 * factor).round().clamp(1.0, 8192.0) as u32;
+    let scaled_height = (decoded.height() as f32 * factor)
+        .round()
+        .clamp(1.0, 8192.0) as u32;
+    let source = decoded.to_rgba8();
+    let mut canvas = image::RgbaImage::new(width, height);
+    let offset = settings.offset.as_ref();
+    let left =
+        (i64::from(width) - i64::from(scaled_width)) / 2 + i64::from(offset.map_or(0, |p| p.x)) * 8;
+    let top = (i64::from(height) - i64::from(scaled_height)) / 2
+        + i64::from(offset.map_or(0, |p| p.y)) * 16;
+    let keep = 1.0 - settings.dim.unwrap_or(0.5);
+    let opacity = settings.opacity.unwrap_or(1.0);
+    let tint = settings.tint.map(rgb);
+    for (x, y, pixel) in canvas.enumerate_pixels_mut() {
+        let (sx, sy) = if position == "tile" {
+            (
+                (i64::from(x) - left).rem_euclid(i64::from(scaled_width)),
+                (i64::from(y) - top).rem_euclid(i64::from(scaled_height)),
+            )
+        } else {
+            (i64::from(x) - left, i64::from(y) - top)
+        };
+        if sx < 0 || sy < 0 || sx >= i64::from(scaled_width) || sy >= i64::from(scaled_height) {
+            continue;
+        }
+        let source_x = ((sx as f64 * f64::from(source.width()) / f64::from(scaled_width)) as u32)
+            .min(source.width() - 1);
+        let source_y = ((sy as f64 * f64::from(source.height()) / f64::from(scaled_height)) as u32)
+            .min(source.height() - 1);
+        *pixel = *source.get_pixel(source_x, source_y);
+        for i in 0..3 {
+            let channel = f32::from(pixel.0[i]) * keep;
+            pixel.0[i] =
+                (channel + tint.map_or(0.0, |t| f32::from(t[i]) * (1.0 - keep))).round() as u8;
+        }
+        pixel.0[3] = (f32::from(pixel.0[3]) * opacity).round() as u8;
+        if let Some(paint) = paint {
+            let a = paint.top.or(paint.bottom).map(rgb);
+            let b = paint.bottom.or(paint.top).map(rgb);
+            if let (Some(a), Some(b)) = (a, b) {
+                let gradient = y as f32 / height.saturating_sub(1).max(1) as f32;
+                let alpha = paint.opacity.unwrap_or(1.0);
+                for i in 0..3 {
+                    let overlay = f32::from(a[i]) * (1.0 - gradient) + f32::from(b[i]) * gradient;
+                    pixel.0[i] =
+                        (f32::from(pixel.0[i]) * (1.0 - alpha) + overlay * alpha).round() as u8;
+                }
+            }
+        }
+    }
+    let mut png = Vec::new();
+    image::DynamicImage::ImageRgba8(canvas)
+        .write_to(&mut Cursor::new(&mut png), ImageFormat::Png)
+        .map_err(|e| e.to_string())?;
+    Ok(png)
+}
+
+pub(crate) fn kitty_place_below_text(png: &[u8], columns: u16, rows: u16, image_id: u32) -> String {
+    format!(
+        "\x1b7\x1b[1;1H{}\x1b8",
+        kitty_transmit(
+            png,
+            &format!("a=T,t=d,f=100,i={image_id},c={columns},r={rows},z=-1,C=1,q=2")
+        )
+    )
+}
+
+pub(crate) fn kitty_transmit(png: &[u8], header: &str) -> String {
+    let payload = STANDARD.encode(png);
+    let chunks: Vec<&[u8]> = payload.as_bytes().chunks(KITTY_CHUNK).collect();
+    let mut command = String::new();
+    for (index, chunk) in chunks.iter().enumerate() {
+        let more = u8::from(index + 1 < chunks.len());
+        let chunk = std::str::from_utf8(chunk).unwrap_or_default();
+        if index == 0 {
+            command.push_str(&format!("\x1b_G{header},m={more};{chunk}\x1b\\"));
+        } else {
+            command.push_str(&format!("\x1b_Gm={more};{chunk}\x1b\\"));
+        }
+    }
+    command
+}
+
+pub(crate) fn kitty_remove(image_id: u32) -> String {
+    format!("\x1b_Ga=d,d=I,i={image_id},q=2;\x1b\\")
+}
+
+#[cfg(test)]
+pub(crate) fn fill_ascii(buffer: &mut Buffer, area: Rect, art: &str) {
+    let settings: ModAsciiBackdrop =
+        serde_json::from_value(serde_json::json!({"text":art, "position":"tile"}))
+            .expect("static ASCII settings");
+    fill_ascii_configured(buffer, area, area, &settings);
+}
+
+pub(crate) fn fill_ascii_configured(
+    buffer: &mut Buffer,
+    area: Rect,
+    clip: Rect,
+    settings: &ModAsciiBackdrop,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let rows: Vec<Vec<char>> = settings
+        .text
+        .lines()
+        .map(|line| line.chars().filter(|c| !c.is_control()).collect())
+        .collect();
+    let art_width = rows.iter().map(Vec::len).max().unwrap_or(0);
+    if rows.is_empty() || art_width == 0 {
+        return;
+    }
+    let position = settings.position.as_deref().unwrap_or("tile");
+    let fit =
+        (f32::from(area.width) / art_width as f32).min(f32::from(area.height) / rows.len() as f32);
+    let fill =
+        (f32::from(area.width) / art_width as f32).max(f32::from(area.height) / rows.len() as f32);
+    let scale = settings.scale.unwrap_or(1.0)
+        * match position {
+            "fit" => fit,
+            "fill" => fill,
+            _ => 1.0,
+        };
+    let width = (art_width as f32 * scale).round().max(1.0) as i32;
+    let height = (rows.len() as f32 * scale).round().max(1.0) as i32;
+    let offset = settings.offset.as_ref();
+    let left = if position == "tile" {
+        0
+    } else {
+        (i32::from(area.width) - width) / 2
+    } + i32::from(offset.map_or(0, |p| p.x));
+    let top = if position == "tile" {
+        0
+    } else {
+        (i32::from(area.height) - height) / 2
+    } + i32::from(offset.map_or(0, |p| p.y));
+    let channels = settings.tint.map(rgb).unwrap_or([128; 3]);
+    let amount = (1.0 - settings.dim.unwrap_or(0.5)) * settings.opacity.unwrap_or(1.0);
+    let channels = channels.map(|c| (f32::from(c) * amount).round() as u8);
+    let style = Style::default()
+        .fg(crate::terminal_palette::best_color((
+            channels[0],
+            channels[1],
+            channels[2],
+        )))
+        .add_modifier(Modifier::DIM);
+    let clip = area.intersection(clip);
+    for y in clip.top()..clip.bottom() {
+        // Native text owns its entire row, including unstyled spaces and indentation.
+        if (area.left()..area.right()).any(|x| {
+            let cell = &buffer[(x, y)];
+            cell.symbol() != " "
+                || cell.bg != Color::Reset
+                || cell.fg != Color::Reset
+                || !cell.modifier.is_empty()
+        }) {
+            continue;
+        }
+        for x in clip.left()..clip.right() {
+            let cell = &mut buffer[(x, y)];
+            let mut sx = i32::from(x - area.x) - left;
+            let mut sy = i32::from(y - area.y) - top;
+            if position == "tile" {
+                sx = sx.rem_euclid(width);
+                sy = sy.rem_euclid(height);
+            }
+            if sx < 0 || sy < 0 || sx >= width || sy >= height {
+                continue;
+            }
+            let row = &rows[((sy as f32 / scale) as usize).min(rows.len() - 1)];
+            let glyph = row
+                .get((sx as f32 / scale) as usize)
+                .copied()
+                .unwrap_or(' ');
+            if glyph != ' ' && unicode_width::UnicodeWidthChar::width(glyph) == Some(1) {
+                cell.set_char(glyph).set_style(style);
+            }
+        }
+    }
+}
