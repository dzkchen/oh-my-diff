+#[test]
+#[serial_test::serial]
+fn autofocus_in_an_overlay_without_a_drawn_anchor_is_released() {
+    let view = |anchor: &str| {
+        snapshot(serde_json::json!({"sites":{
+            "sidebar":{"components":[
+                {"type":"text","id":anchor,"label":"Body","text":"x"},
+                {"type":"input","id":"other","label":"Other","action":{"command":"fixture:other"}}
+            ]},
+            "fixture/tip":{"overlay":{"anchor":{"component":"gone"},"width":20,"height":3},"components":[
+                {"type":"input","id":"tip_query","label":"Query","autofocus":true,"action":{"command":"fixture:search"}},
+                {"type":"input","id":"tip_note","label":"Note","action":{"command":"fixture:note"}}
+            ]}
+        },"sidebar_width":30}))
+    };
+    let (snapshot, anchored) = (view("body"), view("gone"));
+    let area = Rect::new(0, 0, 80, 24);
+    preview(ModViewSnapshot::default());
+    sync_interaction(&ModView::default());
+    sync_interaction(&snapshot.view);
+    let focused = || {
+        INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused
+            .clone()
+    };
+    assert_eq!(focused().as_deref(), Some("tip_query"));
+    render(area, area, &mut Buffer::empty(area), &snapshot);
+    assert_eq!(focused(), None);
+    let set = |id: Option<&str>| {
+        INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused = id.map(str::to_owned);
+    };
+    let draw = |view: &ModViewSnapshot| {
+        sync_interaction(&view.view);
+        render(area, area, &mut Buffer::empty(area), view);
+    };
+    draw(&anchored);
+    assert_eq!(
+        focused().as_deref(),
+        Some("tip_query"),
+        "the returning anchor restores focus nobody has taken"
+    );
+    set(Some("tip_note"));
+    draw(&snapshot);
+    assert_eq!(focused(), None);
+    draw(&anchored);
+    assert_eq!(
+        focused().as_deref(),
+        Some("tip_note"),
+        "the control that held focus returns, not the autofocus one"
+    );
+    set(Some("tip_query"));
+    draw(&snapshot);
+    assert_eq!(focused(), None);
+    set(Some("other"));
+    draw(&anchored);
+    assert_eq!(
+        focused().as_deref(),
+        Some("other"),
+        "focus the user moved is not taken back"
+    );
+    set(None);
+    draw(&anchored);
+    assert_eq!(
+        focused(),
+        None,
+        "a restore is spent once the anchor is back"
+    );
+    preview(ModViewSnapshot::default());
+}
