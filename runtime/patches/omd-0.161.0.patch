+use super::*;
+use crate::outgoing_message::OutgoingMessageSender;
+use codex_app_server_protocol::OmdRecoveryReadResponse;
+use codex_app_server_transport::OutgoingResponse;
+use codex_omd::app_routes::InvocationContext;
+use pretty_assertions::assert_eq;
+
+fn surface(transport: &mpsc::Sender<TransportEvent>) -> AppServerSurface {
+    let (sender, _outgoing) = mpsc::channel(8);
+    AppServerSurface(Arc::new(Host {
+        clients: OmdClients::new(Arc::new(OutgoingMessageSender::new(
+            sender,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ))),
+        store: PathBuf::from("/nonexistent-store"),
+        repository: PathBuf::from("/nonexistent-repository"),
+        transport: transport.downgrade(),
+        runtime: tokio::runtime::Handle::current(),
+        connection: OnceCell::new(),
+        next: AtomicU64::new(0),
+        frames: Frames::default(),
+    }))
+}
+
+fn call(
+    operation: &str,
+    arguments: Value,
+    confirm: Option<&str>,
+) -> (
+    SurfaceCall,
+    std::sync::mpsc::Receiver<Result<Value, String>>,
+) {
+    let (reply, answer) = std::sync::mpsc::sync_channel(1);
+    let call = SurfaceCall {
+        validity: client_surface::Validity(Arc::new(|| true)),
+        authority: None,
+        lifetime: client_surface::CallLifetime::default(),
+        caller: "demo".to_string(),
+        operation: operation.to_string(),
+        arguments,
+        context: InvocationContext::User,
+        remote: false,
+        thread: None,
+        confirm: confirm.map(str::to_owned),
+        reply,
+    };
+    (call, answer)
+}
+
+async fn answer(answer: std::sync::mpsc::Receiver<Result<Value, String>>) -> Result<Value, String> {
+    tokio::task::spawn_blocking(move || answer.recv().unwrap())
+        .await
+        .unwrap()
+}
+
+#[tokio::test]
+async fn user_only_operations_and_consent_are_never_delegated() {
+    let (transport, _events) = mpsc::channel(1);
+    let surface = surface(&transport);
+    for operation in ["config.set", "prompts.consent"] {
+        let (call, _answer) = call(operation, Value::Null, None);
+        assert_eq!(
+            surface.submit(call),
+            Err(format!(
+                "client_surface_operation_unavailable: {operation} needs the terminal (/omd) or omd-mod"
+            ))
+        );
+    }
+    let (mut timer, _answer) = call("terminal.pty", json!({"action": "start"}), None);
+    timer.context = InvocationContext::Event;
+    assert_eq!(
+        surface.submit(timer),
+        Err("host_operation_user_only: terminal.pty start".to_string())
+    );
+}
+
+#[tokio::test]
+async fn app_requests_go_through_one_internal_connection_and_unconfirmed_ones_decline() {
+    let (transport, mut events) = mpsc::channel(8);
+    let surface = surface(&transport);
+    let server = tokio::spawn(async move {
+        let mut writer = None;
+        let mut methods = Vec::new();
+        while let Some(event) = events.recv().await {
+            match event {
+                TransportEvent::ConnectionOpened {
+                    connection_id,
+                    origin,
+                    writer: opened,
+                    ..
+                } => {
+                    assert_eq!(origin, ConnectionOrigin::InProcess);
+                    writer = Some((connection_id, opened));
+                }
+                TransportEvent::IncomingMessage {
+                    message: JSONRPCMessage::Request(request),
+                    ..
+                } => {
+                    methods.push(request.method.clone());
+                    let (connection_id, writer) = writer.as_ref().unwrap();
+                    writer
+                        .send(QueuedOutgoingMessage::new(OutgoingMessage::Response(
+                            OutgoingResponse {
+                                id: request.id,
+                                result: Box::new(
+                                    OmdRecoveryReadResponse(json!({"method": request.method}))
+                                        .into(),
+                                ),
+                            },
+                        )))
+                        .await
+                        .unwrap();
+                    if methods.len() == 2 {
+                        return (*connection_id, methods);
+                    }
+                }
+                _ => {}
+            }
+        }
+        unreachable!("transport closed")
+    });
+
+    let (declined, unconfirmed) = call(
+        "app.request",
+        json!({"method": "thread/rewrite", "params": {}}),
+        Some("Mod demo requests thread/rewrite."),
+    );
+    surface.submit(declined).unwrap();
+    assert_eq!(answer(unconfirmed).await, Ok(json!({"status": "declined"})));
+
+    let (listed, list) = call(
+        "app.request",
+        json!({"method": "thread/list", "params": {}}),
+        None,
+    );
+    surface.submit(listed).unwrap();
+    assert_eq!(answer(list).await, Ok(json!({"method": "thread/list"})));
+    let (connection_id, methods) = server.await.unwrap();
+    assert_eq!(methods, vec!["initialize", "thread/list"]);
+    assert!(surface.0.clients.is_internal(connection_id));
+}
+
+#[tokio::test]
+async fn headless_notices_and_blits_are_validated_and_paced() {
+    let (transport, _events) = mpsc::channel(1);
+    let surface = surface(&transport);
+    for (arguments, expected) in [
+        (json!({"text": "saved"}), Ok(json!({"shown": true}))),
+        (
+            json!({"text": "x".repeat(513)}),
+            Err("terminal_notice_invalid".to_string()),
+        ),
+        (
+            json!({"text": "x", "kind": "fatal"}),
+            Err("terminal_notice_invalid".to_string()),
+        ),
+    ] {
+        let (notice, reply) = call("terminal.notice", arguments, None);
+        surface.submit(notice).unwrap();
+        assert_eq!(answer(reply).await, expected);
+    }
+    let (blit, reply) = call(
+        "terminal.blit",
+        json!({"key": "canvas", "rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]}),
+        None,
+    );
+    surface.submit(blit).unwrap();
+    assert_eq!(
+        answer(reply).await,
+        Err("terminal_blit_unknown".to_string())
+    );
+
+    let frames = Frames::default();
+    let start = Instant::now();
+    for frame in 1..=client_surface::BLIT_QUEUE_UPDATES as u64 {
+        assert_eq!(frames.pace("canvas".into(), start)["frame"], frame);
+    }
+    assert_eq!(
+        frames.pace("canvas".into(), start)["status"],
+        "backpressure"
+    );
+    assert_eq!(
+        frames.pace("canvas".into(), start + client_surface::BLIT_FRAME)["frame"],
+        client_surface::BLIT_QUEUE_UPDATES as u64 + 1
+    );
+}
