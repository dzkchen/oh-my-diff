+use super::*;
+use std::collections::VecDeque;
+
+#[derive(Default)]
+struct OfflineHost {
+    replies: BTreeMap<String, VecDeque<Value>>,
+    calls: Vec<Value>,
+    now_ms: u64,
+    timers: BTreeMap<(String, String), u64>,
+}
+
+impl OfflineHost {
+    fn from_scenario(scenario: &Value, now_ms: u64) -> Result<Self> {
+        let mut host = Self {
+            now_ms,
+            ..Self::default()
+        };
+        let Some(operations) = scenario.get("host_operations") else {
+            return Ok(host);
+        };
+        let operations = operations
+            .as_object()
+            .ok_or_else(|| failure("offline_host_operations_must_be_an_object"))?;
+        for (operation, values) in operations {
+            if !MOD_HOST_OPERATIONS.contains(&operation.as_str()) {
+                return Err(failure(format!(
+                    "offline_unknown_host_operation: {operation}"
+                )));
+            }
+            let values = values
+                .as_array()
+                .cloned()
+                .unwrap_or_else(|| vec![values.clone()]);
+            host.replies
+                .insert(operation.clone(), VecDeque::from(values));
+        }
+        Ok(host)
+    }
+
+    fn call(&mut self, caller: &str, call: ModHostCall) -> Result<Value> {
+        self.calls.push(
+            json!({"at_ms":self.now_ms,"caller":caller,"operation":call.operation,
+            "arguments":call.arguments}),
+        );
+        let key = call.arguments["key"]
+            .as_str()
+            .unwrap_or_default()
+            .to_owned();
+        match call.operation.as_str() {
+            "events.schedule" => {
+                let delay = call.arguments["delay_ms"]
+                    .as_u64()
+                    .filter(|delay| (1000..=86_400_000).contains(delay))
+                    .ok_or_else(|| failure("timer_delay_invalid"))?;
+                self.timers
+                    .insert((caller.to_owned(), key.clone()), self.now_ms + delay);
+                return Ok(json!({"key": key, "delay_ms": delay}));
+            }
+            "events.cancel" => {
+                let cancelled = self.timers.remove(&(caller.to_owned(), key)).is_some();
+                return Ok(json!({"cancelled": cancelled}));
+            }
+            _ => {}
+        }
+        let response = self
+            .replies
+            .get_mut(&call.operation)
+            .and_then(VecDeque::pop_front)
+            .ok_or_else(|| {
+                failure(format!(
+                    "offline_unmocked_host_operation: {}; add a deterministic host_operations fixture",
+                    call.operation
+                ))
+            })?;
+        if let Some(error) = response.get("error").and_then(Value::as_str) {
+            return Err(failure(error));
+        }
+        Ok(response.get("result").cloned().unwrap_or(response))
+    }
+}
+
+impl ModHost {
+    pub fn author_inspection(&self) -> Value {
+        json!({
+            "api":MOD_API_VERSION,
+            "generation":self.generation,
+            "precedence":"dependencies first, then lexical mod ID; project scope shadows user scope; exclusive replacements fail closed on conflict",
+            "order":self.order,
+            "events":self.loaded.iter().map(|(id, loaded)| json!({
+                "id":id,
+                "scope":loaded.selection.scope,
+                "requires":loaded.package.requires,
+                "events":loaded.registrations.events,
+                "replacements":loaded.registrations.replacements,
+                "error":loaded.error,
+            })).collect::<Vec<_>>(),
+            "rejected":self.rejected,
+        })
+    }
+
+    pub fn capability_explanation(code: &str) -> Value {
+        let (cause, fix) = if code.starts_with("capability_denied") {
+            (
+                "The package requested authority that the manifest or explicit trust grant does not include.",
+                "Declare the exact capability in mod.json, inspect the source-use report, then have the user approve the new digest and exact grant.",
+            )
+        } else if code.starts_with("undeclared_operation_use") {
+            (
+                "Source analysis found a literal host operation whose capability is not declared.",
+                "Add the operation's documented capability or remove the call; rerun check before asking for trust.",
+            )
+        } else if code.starts_with("undeclared_service_use") {
+            (
+                "Source analysis found a service call without a matching manifest import.",
+                "Declare the service name and compatible version under services.imports or remove the call.",
+            )
+        } else if code.starts_with("undeclared_environment_use") {
+            (
+                "Source analysis found environment access outside the manifest declaration.",
+                "Remove the access or declare an admitted environment feature; network, filesystem, process and DOM access are intentionally unavailable.",
+            )
+        } else if code.starts_with("state_capability_denied") {
+            (
+                "The callback changed persistent state without the state capability.",
+                "Declare state or keep the callback stateless, then re-inspect and re-approve the source digest.",
+            )
+        } else if code.starts_with("host_operation_unavailable") {
+            (
+                "The callback ran without an active native task capable of servicing that host operation.",
+                "Run it inside a task/tool callback or supply an explicit offline host-operation mock in tests.",
+            )
+        } else {
+            (
+                "The host denied or could not classify the requested authority.",
+                "Use omd-mod report and omd-mod events, then compare the literal operation, manifest declaration and user-approved grant.",
+            )
+        };
+        json!({"code":code,"cause":cause,"fix":fix,
+            "guarantee":"Author tooling can explain a denial but cannot grant authority, change trust, or bypass host enforcement."})
+    }
+
+    pub fn diagnostic_bundle(&self) -> Value {
+        let mut bundle = json!({
+            "schema":1,
+            "host":{"codex":CODEX_HOST_RELEASE,"omd":OMD_HOST_RELEASE,"api":MOD_API_VERSION},
+            "configuration_sha256":self.configuration_sha256,
+            "status":self.status(),
+            "inspection":self.author_inspection(),
+            "redaction":{"paths":true,"settings":true,"environment":true,"credentials":true},
+        });
+        let mut paths = vec![(self.store.root.display().to_string(), "$STORE".to_owned())];
+        paths.extend(self.loaded.iter().map(|(id, loaded)| {
+            (
+                loaded.selection.path.display().to_string(),
+                format!("$MOD/{id}"),
+            )
+        }));
+        redact_value(&mut bundle, None, &paths);
+        bundle
+    }
+
+    pub fn offline_test(&mut self, scenario: Value) -> Result<Value> {
+        if scenario.get("schema").and_then(Value::as_u64) != Some(1) {
+            return Err(failure("offline_scenario_schema_1_required"));
+        }
+        let mut now_ms = scenario
+            .get("virtual_time_ms")
+            .and_then(Value::as_u64)
+            .unwrap_or(0);
+        let mut host = OfflineHost::from_scenario(&scenario, now_ms)?;
+        let steps = scenario
+            .get("steps")
+            .and_then(Value::as_array)
+            .ok_or_else(|| failure("offline_steps_required"))?;
+        if steps.len() > 256 {
+            return Err(failure("offline_step_limit"));
+        }
+        let mut outputs = Vec::new();
+        for (index, step) in steps.iter().enumerate() {
+            let kind = step
+                .get("type")
+                .and_then(Value::as_str)
+                .ok_or_else(|| failure("offline_step_type_required"))?;
+            let cancelled = step
+                .get("cancelled")
+                .and_then(Value::as_bool)
+                .unwrap_or(false);
+            self.virtual_time_ms = Some(now_ms);
+            host.now_ms = now_ms;
+            let result = self.offline_step(kind, step, !cancelled, &mut host, &mut now_ms);
+            let output = match result {
+                Ok(value) => {
+                    if let Some(expected) = step.get("expect")
+                        && &value != expected
+                    {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_expectation_failed at step {index}: expected {expected}, got {value}"
+                        )));
+                    }
+                    if step.get("expect_error").is_some() {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_expected_error_missing at step {index}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":now_ms,"value":value})
+                }
+                Err(error) => {
+                    let text = error.to_string();
+                    let Some(expected) = step.get("expect_error").and_then(Value::as_str) else {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_step_failed at step {index}: {text}"
+                        )));
+                    };
+                    if !text.contains(expected) {
+                        self.virtual_time_ms = None;
+                        return Err(failure(format!(
+                            "offline_error_mismatch at step {index}: expected {expected}, got {text}"
+                        )));
+                    }
+                    json!({"index":index,"type":kind,"at_ms":now_ms,"error":text})
+                }
+            };
+            outputs.push(output);
+        }
+        self.virtual_time_ms = None;
+        let remaining = host
+            .replies
+            .iter()
+            .filter(|(_, replies)| !replies.is_empty())
+            .map(|(operation, replies)| json!({"operation":operation,"remaining":replies.len()}))
+            .collect::<Vec<_>>();
+        Ok(
+            json!({"schema":1,"offline":true,"paid_requests":0,"virtual_time_ms":now_ms,
+            "steps":outputs,"host_calls":host.calls,"unused_mock_replies":remaining,
+            "status":self.status()}),
+        )
+    }
+
+    fn offline_step(
+        &mut self,
+        kind: &str,
+        step: &Value,
+        active: bool,
+        host: &mut OfflineHost,
+        now_ms: &mut u64,
+    ) -> Result<Value> {
+        let payload = step.get("payload").cloned().unwrap_or(Value::Null);
+        match kind {
+            "advance_time" => {
+                let delta = step
+                    .get("ms")
+                    .and_then(Value::as_u64)
+                    .ok_or_else(|| failure("offline_advance_ms_required"))?;
+                let until = now_ms
+                    .checked_add(delta)
+                    .ok_or_else(|| failure("offline_virtual_time_overflow"))?;
+                let mut fired = Vec::new();
+                // Due timers fire in due order at their own virtual time; a handler may reschedule.
+                while let Some(((owner, key), due)) = host
+                    .timers
+                    .iter()
+                    .filter(|(_, due)| **due <= until)
+                    .min_by_key(|(_, due)| **due)
+                    .map(|(timer, due)| (timer.clone(), *due))
+                {
+                    if fired.len() >= 256 {
+                        return Err(failure("offline_timer_limit"));
+                    }
+                    host.timers.remove(&(owner.clone(), key.clone()));
+                    (*now_ms, host.now_ms) = (due, due);
+                    self.virtual_time_ms = Some(due);
+                    let value = self.invoke_scoped_with(
+                        &owner,
+                        self.generation,
+                        "timer",
+                        "",
+                        json!({"key": key}),
+                        || active,
+                        |caller, call| host.call(caller, call),
+                    );
+                    fired.push(match value {
+                        Ok(_) => json!({"mod": owner, "key": key, "at_ms": due}),
+                        Err(error) => json!({"mod": owner, "key": key, "at_ms": due, "error": error.to_string()}),
+                    });
+                }
+                *now_ms = until;
+                let mut value = json!({"now_ms": now_ms});
+                if !fired.is_empty() {
+                    value["timers"] = json!(fired);
+                }
+                Ok(value)
+            }
+            "status" => Ok(self.status()),
+            "reload" => {
+                self.store.reload()?;
+                self.turn_boundary();
+                if let Some(error) = &self.reload_error {
+                    return Err(failure(error));
+                }
+                Ok(json!({"generation":self.generation,"reload_error":self.reload_error}))
+            }
+            "tool_exposure" => {
+                let thread_id = step
+                    .get("thread_id")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned);
+                let tools = self.tools_for_step(thread_id, payload, || active);
+                Ok(json!(
+                    tools
+                        .into_iter()
+                        .map(|(id, _, tool)| format!("mod_{id}_{}", tool.name))
+                        .collect::<Vec<_>>()
+                ))
+            }
+            "intercept" => {
+                let surface = required_string(step, "surface")?;
+                let mut replies = step
+                    .get("core")
+                    .and_then(Value::as_array)
+                    .cloned()
+                    .unwrap_or_default()
+                    .into_iter();
+                let mut core_calls = Vec::new();
+                let mut core = |input: Value| {
+                    core_calls.push(input);
+                    let reply = replies
+                        .next()
+                        .ok_or_else(|| failure("offline_core_reply_missing"))?;
+                    match reply.get("error").and_then(Value::as_str) {
+                        Some(error) => Err(failure(error)),
+                        None => Ok(reply.get("value").cloned().unwrap_or(Value::Null)),
+                    }
+                };
+                let origin = step
+                    .get("origin")
+                    .cloned()
+                    .unwrap_or_else(|| json!({"caller": "offline"}));
+                let chain = chain::intercept(
+                    &mut Access::Held(self),
+                    &mut |caller, call| host.call(caller, call),
+                    &mut chain::Core::Call(&mut core),
+                    surface,
+                    true,
+                    payload,
+                    origin,
+                    &|| active,
+                    &InvocationScope::default(),
+                )?;
+                let mut value = serde_json::to_value(chain)?;
+                for entry in value["trace"].as_array_mut().into_iter().flatten() {
+                    entry.as_object_mut().map(|entry| entry.remove("ms"));
+                }
+                value["core_calls"] = Value::Array(core_calls);
+                Ok(value)
+            }
+            "event" | "tool_outcome" | "agent" => {
+                let event = match kind {
+                    "tool_outcome" => "tool_result",
+                    "agent" => "agent",
+                    _ => step
+                        .get("event")
+                        .and_then(Value::as_str)
+                        .ok_or_else(|| failure("offline_event_name_required"))?,
+                };
+                let ids = self.event_ids(event);
+                let mut values = Vec::new();
+                for id in ids {
+                    let generation = self.generation;
+                    let value = self.invoke_scoped_with(
+                        &id,
+                        generation,
+                        event,
+                        "",
+                        payload.clone(),
+                        || active,
+                        |caller, call| host.call(caller, call),
+                    )?;
+                    values.push(json!({"mod":id,"value":value}));
+                }
+                Ok(Value::Array(values))
+            }
+            "invoke" => {
+                let id = required_string(step, "mod")?;
+                let event = required_string(step, "event")?;
+                let name = required_string(step, "name")?;
+                self.invoke_scoped_with(
+                    id,
+                    self.generation,
+                    event,
+                    name,
+                    payload,
+                    || active,
+                    |caller, call| host.call(caller, call),
+                )
+            }
+            "terminal_mount" | "terminal_interact" => {
+                let id = required_string(step, "mod")?;
+                let view = self.invoke_scoped_with(
+                    id,
+                    self.generation,
+                    "terminal",
+                    "",
+                    payload,
+                    || active,
+                    |caller, call| host.call(caller, call),
+                )?;
+                let parsed = ModView::parse(view.clone())?;
+                if kind == "terminal_mount" {
+                    return Ok(view);
+                }
+                let action = if let Some(component) = step.get("component").and_then(Value::as_str)
+                {
+                    terminal_component_action(
+                        &parsed,
+                        component,
+                        step.get("value").and_then(Value::as_str),
+                    )?
+                } else {
+                    let key = required_string(step, "key")?;
+                    serde_json::to_value(
+                        parsed
+                            .keybindings
+                            .get(key)
+                            .ok_or_else(|| failure("offline_terminal_key_not_mounted"))?,
+                    )?
+                };
+                if let Some(command) = action.get("command").and_then(Value::as_str) {
+                    let (owner, name) = command.split_once(':').unwrap_or((id, command));
+                    let args = action.get("args").cloned().unwrap_or_else(|| json!(""));
+                    let result = self.invoke_scoped_with(
+                        owner,
+                        self.generation,
+                        "command",
+                        name,
+                        args,
+                        || active,
+                        |caller, call| host.call(caller, call),
+                    )?;
+                    Ok(json!({"action":action,"result":result}))
+                } else {
+                    Ok(json!({"action":action}))
+                }
+            }
+            _ => Err(failure(format!("offline_unknown_step_type: {kind}"))),
+        }
+    }
+}
+
+fn required_string<'a>(value: &'a Value, key: &str) -> Result<&'a str> {
+    value
+        .get(key)
+        .and_then(Value::as_str)
+        .ok_or_else(|| failure(format!("offline_{key}_required")))
+}
+
+fn terminal_component<'a>(components: &'a [ModComponent], id: &str) -> Option<&'a ModComponent> {
+    components.iter().find_map(|component| {
+        let (component_id, children) = match component {
+            ModComponent::Box { id, children, .. }
+            | ModComponent::Pane { id, children, .. }
+            | ModComponent::Dialog { id, children, .. } => (Some(id.as_str()), children.as_slice()),
+            ModComponent::Text { id, .. }
+            | ModComponent::Line { id, .. }
+            | ModComponent::Button { id, .. }
+            | ModComponent::Input { id, .. }
+            | ModComponent::Select { id, .. }
+            | ModComponent::Multiselect { id, .. }
+            | ModComponent::Markdown { id, .. }
+            | ModComponent::Code { id, .. }
+            | ModComponent::List { id, .. }
+            | ModComponent::Document { id, .. }
+            | ModComponent::Diff { id, .. }
+            | ModComponent::Terminal { id, .. }
+            | ModComponent::Image { id, .. }
+            | ModComponent::Raster { id, .. } => (Some(id.as_str()), &[][..]),
+            ModComponent::Slot | ModComponent::Native { .. } => (None, &[][..]),
+        };
+        if component_id == Some(id) {
+            Some(component)
+        } else {
+            terminal_component(children, id)
+        }
+    })
+}
+
+fn terminal_component_action(view: &ModView, id: &str, value: Option<&str>) -> Result<Value> {
+    let component = view
+        .sites
+        .values()
+        .find_map(|site| terminal_component(&site.components, id))
+        .ok_or_else(|| failure("offline_terminal_component_not_mounted"))?;
+    let command = |action: &ModCommandAction, value: Option<&str>| {
+        let args = match value {
+            Some(value) if action.args.is_empty() => value.to_owned(),
+            Some(value) => format!("{} {value}", action.args),
+            None => action.args.clone(),
+        };
+        serde_json::to_value(ModKeyAction::Command {
+            command: action.command.clone(),
+            args,
+        })
+        .map_err(failure)
+    };
+    match component {
+        ModComponent::Button { action, .. } => serde_json::to_value(action).map_err(failure),
+        ModComponent::Input {
+            action,
+            value: current,
+            ..
+        } => command(action, value.or(Some(current))),
+        ModComponent::Select {
+            action,
+            value: current,
+            options,
+            ..
+        } => {
+            let selected = value.unwrap_or(current);
+            if !options.iter().any(|option| option.value == selected) {
+                return Err(failure("offline_terminal_select_value_not_mounted"));
+            }
+            command(action, Some(selected))
+        }
+        ModComponent::Multiselect {
+            action,
+            value: current,
+            options,
+            ..
+        } => {
+            let selected = match value {
+                Some(value) => serde_json::from_str::<Vec<String>>(value)
+                    .map_err(|_| failure("offline_terminal_multiselect_value_invalid"))?,
+                None => current.clone(),
+            };
+            if selected
+                .iter()
+                .collect::<std::collections::BTreeSet<_>>()
+                .len()
+                != selected.len()
+                || !selected
+                    .iter()
+                    .all(|value| options.iter().any(|option| option.value == *value))
+            {
+                return Err(failure("offline_terminal_select_value_not_mounted"));
+            }
+            let ordered = options
+                .iter()
+                .filter(|option| selected.contains(&option.value))
+                .map(|option| &option.value)
+                .collect::<Vec<_>>();
+            command(
+                action,
+                Some(&serde_json::to_string(&ordered).map_err(failure)?),
+            )
+        }
+        ModComponent::List {
+            action,
+            rows,
+            selected: current,
+            ..
+        } => {
+            let selected = value
+                .or(current.as_deref())
+                .ok_or_else(|| failure("offline_terminal_list_value_required"))?;
+            if !rows.iter().any(|row| row.value == selected) {
+                return Err(failure("offline_terminal_list_value_not_mounted"));
+            }
+            command(action, Some(selected))
+        }
+        _ => Err(failure("offline_terminal_component_not_interactive")),
+    }
+}
+
+fn redact_value(value: &mut Value, key: Option<&str>, paths: &[(String, String)]) {
+    let sensitive = key.is_some_and(|key| {
+        let key = key.to_ascii_lowercase();
+        ["secret", "token", "password", "credential", "api_key"]
+            .iter()
+            .any(|needle| key.contains(needle))
+    });
+    if sensitive && !value.is_boolean() {
+        *value = Value::String("[REDACTED]".to_owned());
+        return;
+    }
+    match value {
+        Value::String(text) => {
+            for (path, replacement) in paths {
+                *text = text.replace(path, replacement);
+            }
+            *text = redact_text(text);
+        }
+        Value::Array(values) => {
+            for value in values {
+                redact_value(value, None, paths);
+            }
+        }
+        Value::Object(object) => {
+            for (key, value) in object {
+                redact_value(value, Some(key), paths);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn redact_text(text: &str) -> String {
+    let mut output = text.to_owned();
+    for prefix in ["sk-", "ghp_", "github_pat_", "Bearer "] {
+        let mut from = 0;
+        while let Some(offset) = output[from..].find(prefix) {
+            let start = from + offset;
+            let tail = &output[start + prefix.len()..];
+            let length = tail
+                .find(|character: char| {
+                    character.is_whitespace()
+                        || matches!(character, '\'' | '"' | ',' | ']' | '}' | ')')
+                })
+                .unwrap_or(tail.len());
+            if length == 0 {
+                from = start + prefix.len();
+                continue;
+            }
+            output.replace_range(start..start + prefix.len() + length, "[REDACTED]");
+            from = start + "[REDACTED]".len();
+        }
+    }
+    output
+}
diff --git a/codex-rs/omd/src/mods/bridge.rs b/codex-rs/omd/src/mods/bridge.rs
new file mode 100644
index 000000000..6699776c7
--- /dev/null
+++ b/codex-rs/omd/src/mods/bridge.rs
@@ -0,0 +1,356 @@
+use super::*;
+use std::time::Duration;
+use std::time::Instant;
+
+/// Host calls that end the callback's process; it replays from its receipts once they settle.
+pub(super) const SUSPENDING: &[&str] = &["continuation.next", "time.sleep"];
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModHostCall {
+    pub operation: String,
+    pub arguments: Value,
+}
+
+impl ModHostCall {
+    pub fn capability(&self) -> Result<&'static str> {
+        let operation = self.operation.as_str();
+        match operation {
+            "exec.run" | "exec.output_page" => Ok("exec"),
+            "workspace.read"
+            | "workspace.list"
+            | "workspace.stat"
+            | "workspace.snapshot"
+            | "workspace.fingerprint" => Ok("fs.read"),
+            "workspace.check_access" => Ok(if self.arguments["write"] == true {
+                "fs.write"
+            } else {
+                "fs.read"
+            }),
+            "workspace.transaction"
+            | "workspace.backup"
+            | "workspace.restore"
+            | "workspace.request_rename" => Ok("fs.write"),
+            "store.get" | "store.put" | "store.delete" | "store.list" | "store.export"
+            | "store.reset" | "evidence.write" | "evidence.read" => Ok("store"),
+            "sessions.list" | "sessions.read" | "sessions.snapshot" | "sessions.ports" => {
+                Ok("sessions")
+            }
+            "routes.list" | "providers.register" | "providers.unregister" | "ledger.settle" => {
+                Ok("model")
+            }
+            "task.status" | "workspace.integrate" => Ok("agents"),
+            "task.complete" | "receipts.submit" | "contract.status" | "contract.restrict"
+            | "contract.select" => Ok("contracts"),
+            "mods.service" => Ok("services"),
+            "app.request" => self.arguments["method"]
+                .as_str()
+                .and_then(crate::app_routes::route)
+                .map(|route| route.class.as_str())
+                .ok_or_else(|| failure("app_method_unrouted")),
+            "app.routes" | "session.info" => Ok("inventory"),
+            "time.sleep" => Ok("events"),
+            "workspace.watch" | "workspace.unwatch" => Ok("fs.read"),
+            "events.publish" | "events.schedule" | "events.cancel" => Ok("events"),
+            "credentials.list" | "credentials.request" => Ok("credentials"),
+            "routes.select" => Ok("model"),
+            "turns.activity" => Ok("sessions"),
+            "terminal.notify"
+            | "terminal.show_thread"
+            | "commands.list"
+            | "commands.describe"
+            | "terminal.import_file"
+            | "terminal.image_sample"
+            | "terminal.open"
+            | "terminal.prompt"
+            | "terminal.pane"
+            | "terminal.panes"
+            | "terminal.notice"
+            | "terminal.blit" => Ok("terminal"),
+            "terminal.pty" => Ok("pty"),
+            "model.complete" | "model.fork" => Ok("agents"),
+            "tools.define" | "tools.undefine" => Ok("tools"),
+            "tools.invoke" | "tools.check" => Ok("interception"),
+            "composer.read" | "composer.write" | "composer.suggest" => Ok("composer"),
+            "prompts.consent" | "prompts.submit" | "prompts.status" | "prompts.revoke" => {
+                Ok("composer")
+            }
+            "builtins.invoke" | "commands.invoke" => Ok("builtins"),
+            "config.describe" => Ok("config"),
+            "config.set" => Ok("config.write"),
+            "packages.list" | "packages.index" | "packages.preview" | "packages.apply"
+            | "packages.reload" => Ok("packages"),
+            "settings.write" if self.arguments["id"].is_string() => Ok("packages"),
+            "settings.write" => Ok("commands"),
+            "http.request" | "http.open" | "http.read" | "http.close" => Ok("http"),
+            "mcp.connect" | "mcp.disconnect" => Ok("mcp"),
+            "environment.read" => Ok("exec"),
+            "peers.list" | "peers.send" => Ok("peers"),
+            "turns.queue" | "turns.queued" | "turns.dequeue" => Ok("autonomous"),
+            _ if operation.starts_with("agents.") && MOD_HOST_OPERATIONS.contains(&operation) => {
+                Ok("agents")
+            }
+            _ if (operation.starts_with("process.") || operation.starts_with("sidecars."))
+                && MOD_HOST_OPERATIONS.contains(&operation) =>
+            {
+                Ok("exec")
+            }
+            _ => Err(failure(format!(
+                "unsupported_host_operation: {}",
+                self.operation
+            ))),
+        }
+    }
+
+    pub fn capabilities(&self) -> Result<Vec<&'static str>> {
+        let mut capabilities = vec![self.capability()?];
+        if self.operation == "model.fork" {
+            capabilities.push("sessions");
+        }
+        if self.operation == "terminal.pty" {
+            if self.arguments["write"] == true {
+                capabilities.push("fs.write");
+            }
+            if self.arguments["network"] == "loopback" {
+                capabilities.push("network");
+            }
+        }
+        if matches!(
+            self.operation.as_str(),
+            "exec.run" | "process.start" | "terminal.pty"
+        ) && self.arguments["sandbox"] == "none"
+        {
+            capabilities.push("os");
+        }
+        if matches!(
+            self.operation.as_str(),
+            "workspace.read" | "workspace.list" | "workspace.stat" | "workspace.transaction"
+        ) && self.arguments.get("root").is_some()
+        {
+            capabilities.push("fs.external");
+        }
+        if self.operation == "exec.run"
+            && self.arguments["unix_sockets"]
+                .as_array()
+                .is_some_and(|sockets| !sockets.is_empty())
+        {
+            capabilities.push("unix_sockets");
+        }
+        Ok(capabilities)
+    }
+}
+
+fn authorize(loaded: &Loaded, call: &ModHostCall) -> Result<()> {
+    let capabilities = call.capabilities()?;
+    if call.operation.starts_with("context.")
+        && !loaded
+            .package
+            .capabilities
+            .iter()
+            .any(|cap| cap == "context")
+    {
+        return Err(failure("capability_denied: context"));
+    }
+    if let Some(missing) = capabilities
+        .iter()
+        .find(|capability| !loaded.package.capabilities.iter().any(|c| c == *capability))
+    {
+        return Err(failure(format!("capability_denied: {missing}")));
+    }
+    if let Some(expired) = capabilities.iter().find(|capability| {
+        AUTHORITY_CAPABILITIES.contains(capability) && !loaded.selection.authority_current()
+    }) {
+        return Err(failure(format!("grant_expired: {expired}")));
+    }
+    let namespace = host_namespace(&call.operation, &call.arguments);
+    if loaded
+        .withheld
+        .iter()
+        .any(|pattern| namespace_matches(pattern, &namespace))
+    {
+        return Err(failure(format!("capability_withheld: {namespace}")));
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn run(
+    node: &Path,
+    loaded: &Loaded,
+    event: &str,
+    name: &str,
+    payload: Value,
+    replay: &[Value],
+    active: &dyn Fn() -> bool,
+    host: &mut dyn FnMut(ModHostCall) -> Result<Value>,
+    progress: &mut dyn FnMut(String),
+    virtual_time_ms: Option<u64>,
+    scope: &InvocationScope,
+) -> Result<Reply> {
+    let mut receipts = replay.to_vec();
+    let mut expected = replay
+        .iter()
+        .map(|receipt| serde_json::from_value::<ModHostCall>(receipt["call"].clone()))
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    let mut forwarded = 0;
+    let mut waited = Duration::ZERO;
+    let mut request = json!({"source": loaded.source, "filename": loaded.selection.path.join("index.ts"),
+        "api": MOD_API_VERSION,
+        "assets": loaded.assets,
+        "entrypoint": loaded.package.entrypoint,
+        "entrypoint_sha256": digest(loaded.source.as_bytes()),
+        "package": {"id": loaded.package.id, "version": loaded.package.version},
+        "capabilities": loaded.package.capabilities, "adapter": loaded.package.adapter, "settings": effective_settings(loaded.package.settings_schema.as_ref(), &loaded.selection.settings),
+        "state": loaded.state, "event": event, "name": name, "payload": payload, "interactive": true,
+        "hook_budget_ms": loaded.package.hook_budget_ms,"environment":loaded.package.environment});
+    request["field_policies"] = ModHost::field_policies();
+    request["surface"] = json!({
+        "events": MOD_EVENTS.iter().map(|(event, capability)| (event.to_string(), json!(capability))).collect::<serde_json::Map<_, _>>(),
+        "replacements": MOD_REPLACEMENT_POINTS,
+        "middleware": MOD_MIDDLEWARE_EVENTS,
+        "intercept": MOD_INTERCEPT_SURFACES.iter().map(|(surface, capability)| (surface.to_string(), json!(capability))).collect::<serde_json::Map<_, _>>(),
+        "state": "store",
+        "contracts": "contracts",
+        "adapter": loaded.adapter,
+    });
+    request["virtual_time_ms"] = virtual_time_ms.map_or(Value::Null, Value::from);
+    // Renders cannot call the host or write state, so one activated runner serves every render of
+    // this package revision, settings and state.
+    let warm = (event == "intercept" && request["payload"]["surface"] == "render").then(|| {
+        request["serve"] = Value::Bool(true);
+        let mut key = request.clone();
+        if let Some(fields) = key.as_object_mut() {
+            for field in ["name", "payload", "receipts"] {
+                fields.remove(field);
+            }
+        }
+        format!("{}:{}", node.display(), digest(key.to_string().as_bytes()))
+    });
+    let started = Instant::now();
+    let budget = Duration::from_millis(loaded.package.hook_budget_ms);
+    // A continuation suspends the callback; it replays from its receipts once the downstream chain settles.
+    let mut reply: Reply = loop {
+        request["receipts"] = Value::Array(receipts.clone());
+        let mut answer = |frame: Value| -> Result<Value> {
+            if event == "inspect" {
+                return Err(failure("invalid_host_call_sequence"));
+            }
+            let frame: Frame = serde_json::from_value(frame)?;
+            forward(event, &frame.updates, &mut forwarded, progress)?;
+            let call = frame.call;
+            if expected.len() >= 32 {
+                return Err(failure("host_call_limit"));
+            }
+            authorize(loaded, &call)?;
+            if !active() {
+                return Err(failure("callback_cancelled"));
+            }
+            let call_started = Instant::now();
+            let exempt = !crate::client_surface::SURFACE_OPERATIONS
+                .contains(&call.operation.as_str())
+                || crate::client_surface::awaits_user(&call.operation, &call.arguments);
+            scope.charge_call()?;
+            let result = host(call.clone());
+            let mut receipt = match result {
+                Ok(value) => json!({"call": call, "value": value}),
+                Err(error) => {
+                    json!({"call": call, "error": error.to_string().chars().take(768).collect::<String>()})
+                }
+            };
+            let bytes = serde_json::to_vec(&receipt)?.len();
+            let room = scope
+                .receipt_room()
+                .min(HOST_RECEIPT_BYTES.saturating_sub(serde_json::to_vec(&receipts)?.len()));
+            if bytes > room {
+                receipt = json!({"call": call, "error": format!(
+                "host_result_limit: the {bytes}-byte result exceeds the {room} bytes left in this callback; the operation ran, request a smaller page or an artifact")});
+            }
+            expected.push(call);
+            receipts.push(receipt.clone());
+            if serde_json::to_vec(&receipts)?.len() > HOST_RECEIPT_BYTES {
+                return Err(failure("host_receipt_limit"));
+            }
+            scope.charge_receipt(serde_json::to_vec(&receipt)?.len())?;
+            if exempt {
+                waited += call_started.elapsed();
+            }
+            scope.check_execution(started.elapsed().saturating_sub(waited))?;
+            Ok(receipt)
+        };
+        let evaluated = match &warm {
+            Some(key) => process::evaluate_warm(node, key, &request, budget, active, &mut answer),
+            None => process::evaluate(node, &request, budget, active, &mut answer),
+        };
+        let reply: Reply = serde_json::from_value(evaluated?)?;
+        let Some(call) = reply
+            .host_call
+            .clone()
+            .filter(|call| SUSPENDING.contains(&call.operation.as_str()))
+            .filter(|call| reply.calls.split_last() == Some((call, &expected[..])))
+        else {
+            break reply;
+        };
+        if call.operation == "continuation.next" && event != "intercept" {
+            return Err(failure("continuation_outside_interceptor"));
+        }
+        if call.operation == "time.sleep" {
+            authorize(loaded, &call)?;
+        }
+        if expected.len() >= 32 {
+            return Err(failure("host_call_limit"));
+        }
+        scope.charge_call()?;
+        let call_started = Instant::now();
+        let receipt = match host(call.clone()) {
+            Ok(value) => json!({"call": call, "value": value}),
+            Err(error) => {
+                json!({"call": call, "error": error.to_string().chars().take(768).collect::<String>()})
+            }
+        };
+        waited += call_started.elapsed();
+        expected.push(call);
+        receipts.push(receipt);
+        if serde_json::to_vec(&receipts)?.len() > HOST_RECEIPT_BYTES {
+            return Err(failure("host_receipt_limit"));
+        }
+    };
+    let execution = started.elapsed().saturating_sub(waited);
+    scope.charge_execution(execution)?;
+    if event != "inspect" && reply.registrations != loaded.registrations {
+        return Err(failure("registration_changed_during_callback"));
+    }
+    if reply.host_call.is_some() || reply.calls != expected {
+        return Err(failure("invalid_host_call_receipts"));
+    }
+    forward(event, &reply.updates, &mut forwarded, progress)?;
+    reply.receipts = receipts;
+    Ok(reply)
+}
+
+#[derive(Deserialize)]
+struct Frame {
+    call: ModHostCall,
+    updates: Vec<String>,
+}
+
+fn forward(
+    event: &str,
+    updates: &[String],
+    forwarded: &mut usize,
+    progress: &mut dyn FnMut(String),
+) -> Result<()> {
+    if updates.len() > 32
+        || updates
+            .iter()
+            .any(|update| update.is_empty() || update.len() > 1024)
+    {
+        return Err(failure("invalid_progress"));
+    }
+    if event == "tool" {
+        for update in updates.iter().skip(*forwarded) {
+            progress(update.clone());
+        }
+        *forwarded = (*forwarded).max(updates.len());
+    }
+    Ok(())
+}
diff --git a/codex-rs/omd/src/mods/chain.rs b/codex-rs/omd/src/mods/chain.rs
new file mode 100644
index 000000000..3a10f40bf
--- /dev/null
+++ b/codex-rs/omd/src/mods/chain.rs
@@ -0,0 +1,1787 @@
+use super::*;
+use std::time::Duration;
+
+const INTERCEPTOR_LIMIT: usize = 16;
+const ATTEMPT_LIMIT: usize = 3;
+const TRACE_LIMIT: usize = 64;
+const RESULT_BYTES: usize = 65_536;
+const CHAIN_LOG: usize = 16;
+pub(super) const REQUIRED_WAIT: Duration = Duration::from_secs(5);
+const OPTIONAL_WAIT: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModInterceptor {
+    pub pattern: String,
+    #[serde(rename = "match", default)]
+    pub matcher: Value,
+    #[serde(default)]
+    pub required: bool,
+    #[serde(default)]
+    pub before: Vec<String>,
+    #[serde(default)]
+    pub after: Vec<String>,
+    #[serde(default)]
+    pub catch: bool,
+    #[serde(default)]
+    pub location: String,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct ModChain {
+    pub result: Value,
+    pub input: Value,
+    pub answered_by: Option<String>,
+    pub trace: Vec<Value>,
+    #[serde(skip)]
+    pub reads: BTreeMap<String, BTreeSet<String>>,
+}
+
+#[derive(Clone)]
+struct Link {
+    id: String,
+    index: usize,
+    required: bool,
+    catch: bool,
+    location: String,
+    matcher: Value,
+    generation: u64,
+}
+
+pub(super) enum Core<'c> {
+    Call(&'c mut dyn FnMut(Value) -> Result<Value>),
+    Host {
+        caller: String,
+        generation: u64,
+    },
+    Spawn {
+        caller: String,
+        arguments: Value,
+        spawned: Option<Value>,
+    },
+    Peer {
+        caller: String,
+        arguments: Value,
+    },
+}
+
+impl Core<'_> {
+    fn run(
+        &mut self,
+        access: &mut Access<'_>,
+        host: &mut HostFn<'_>,
+        input: &Value,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+    ) -> Result<Value> {
+        match self {
+            Core::Call(run) => run(input.clone()),
+            Core::Host { caller, generation } => {
+                effective_call(access, host, caller, *generation, input, active, scope)
+            }
+            Core::Spawn {
+                caller,
+                arguments,
+                spawned,
+            } => {
+                let value = spawn_call(access, host, caller, arguments, input)?;
+                let result = json!({"agent_id": value["handle"], "output": value.to_string(), "success": true});
+                *spawned = Some(value);
+                Ok(result)
+            }
+            Core::Peer { caller, arguments } => {
+                let mut arguments = arguments.clone();
+                arguments["data"] = input["data"].clone();
+                let call = ModHostCall {
+                    operation: "peers.send".into(),
+                    arguments,
+                };
+                forward(access, host, caller, call).map(|receipt| json!({"receipt": receipt}))
+            }
+        }
+    }
+}
+
+type HostFn<'h> = dyn FnMut(&str, ModHostCall) -> Result<Value> + 'h;
+
+fn glob(pattern: &str, text: &str) -> bool {
+    let parts = pattern.split('*').collect::<Vec<_>>();
+    let [first, .., last] = parts.as_slice() else {
+        return pattern == text;
+    };
+    if text.len() < first.len() + last.len() || !text.starts_with(first) || !text.ends_with(last) {
+        return false;
+    }
+    let (mut at, end) = (first.len(), text.len() - last.len());
+    parts[1..parts.len() - 1].iter().all(|part| {
+        let found = text[at..end].find(part);
+        if let Some(found) = found {
+            at += found + part.len();
+        }
+        found.is_some()
+    })
+}
+
+pub struct SendPolicy {
+    pub required: bool,
+    pub unavailable: Option<String>,
+    pub fingerprint: String,
+}
+
+/// Like `selects`, but an expired grant no longer entitles authority surfaces.
+fn granted(loaded: &Loaded, pattern: &str, surface: &str) -> bool {
+    selects(pattern, surface, &loaded.package.capabilities)
+        && (loaded.selection.authority_current()
+            || !MOD_INTERCEPT_SURFACES.iter().any(|(name, capability)| {
+                *name == surface && AUTHORITY_CAPABILITIES.contains(capability)
+            }))
+}
+
+pub(super) fn selects(pattern: &str, surface: &str, capabilities: &[String]) -> bool {
+    let entitled = MOD_INTERCEPT_SURFACES.iter().any(|(name, capability)| {
+        *name == surface && capabilities.iter().any(|granted| granted == capability)
+    });
+    let (selector, negated) = pattern
+        .strip_prefix('!')
+        .map_or((pattern, false), |rest| (rest, true));
+    entitled && pattern != "!*" && glob(selector, surface) != negated
+}
+
+/// RegExp and negated leaves can only be decided by the runner, so they pass this filter.
+fn may_match(matcher: &Value, value: &Value) -> bool {
+    match (matcher, value) {
+        (Value::Array(alternatives), _) => alternatives.iter().any(|item| may_match(item, value)),
+        (_, Value::Array(items)) => items.iter().any(|item| may_match(matcher, item)),
+        (Value::Object(object), _) if object.contains_key("$regex") => {
+            !value.is_object() && !value.is_null()
+        }
+        (Value::Object(object), _) if object.contains_key("$not") => true,
+        (Value::Object(object), Value::String(text)) if object.contains_key("$glob") => {
+            object["$glob"]
+                .as_str()
+                .is_some_and(|pattern| glob(pattern, text))
+        }
+        (Value::Object(object), Value::Object(value)) => object
+            .iter()
+            .all(|(key, item)| value.get(key).is_some_and(|value| may_match(item, value))),
+        (Value::Object(_), _) => false,
+        (Value::Number(left), Value::Number(right)) => left.as_f64() == right.as_f64(),
+        _ => matcher == value,
+    }
+}
+
+pub(super) fn validate(interceptors: &[ModInterceptor], capabilities: &[String]) -> Result<()> {
+    if interceptors.len() > INTERCEPTOR_LIMIT {
+        return Err(failure("interceptor_limit"));
+    }
+    for interceptor in interceptors {
+        let entitled = MOD_INTERCEPT_SURFACES
+            .iter()
+            .any(|(surface, _)| selects(&interceptor.pattern, surface, capabilities));
+        let ordered = interceptor.before.iter().chain(&interceptor.after);
+        if !entitled
+            || interceptor.pattern.len() > 64
+            || serde_json::to_vec(&interceptor.matcher)?.len() > 4096
+            || interceptor.before.len() + interceptor.after.len() > 16
+            || !ordered.into_iter().all(|id| identifier(id))
+            || interceptor.location.len() > 256
+        {
+            return Err(failure("invalid_interceptor_registration"));
+        }
+    }
+    Ok(())
+}
+
+/// Outermost first: explicit `before`/`after`, then consumers outside their dependencies, then ID.
+pub(super) fn order(
+    loaded: &BTreeMap<String, Loaded>,
+) -> std::result::Result<Vec<String>, Vec<String>> {
+    let ids = loaded
+        .iter()
+        .filter(|(_, m)| m.error.is_none() && !m.registrations.interceptors.is_empty())
+        .map(|(id, _)| id.clone())
+        .collect::<Vec<_>>();
+    fn height(loaded: &BTreeMap<String, Loaded>, id: &str, depth: usize) -> usize {
+        let Some(m) = loaded.get(id).filter(|_| depth < 32) else {
+            return 0;
+        };
+        m.package
+            .dependencies
+            .iter()
+            .map(|dependency| height(loaded, &dependency.id, depth + 1) + 1)
+            .max()
+            .unwrap_or(0)
+    }
+    let mut edges = BTreeSet::new();
+    for id in &ids {
+        for interceptor in &loaded[id].registrations.interceptors {
+            for other in interceptor
+                .before
+                .iter()
+                .filter(|other| ids.contains(other))
+            {
+                edges.insert((id.clone(), other.clone()));
+            }
+            for other in interceptor.after.iter().filter(|other| ids.contains(other)) {
+                edges.insert((other.clone(), id.clone()));
+            }
+        }
+    }
+    let mut remaining = ids;
+    let mut sorted = Vec::new();
+    while !remaining.is_empty() {
+        let next = remaining
+            .iter()
+            .filter(|id| {
+                !edges
+                    .iter()
+                    .any(|(from, to)| to == *id && remaining.contains(from))
+            })
+            .min_by_key(|id| (std::cmp::Reverse(height(loaded, id, 0)), (*id).clone()))
+            .cloned();
+        let Some(next) = next else {
+            return Err(remaining);
+        };
+        remaining.retain(|id| *id != next);
+        sorted.push(next);
+    }
+    Ok(sorted)
+}
+
+fn validate_input(surface: &str, before: &Value, input: &Value) -> Result<()> {
+    let mutable: &[&str] = match surface {
+        "tool" => &["tool", "arguments"],
+        "host_operation" => &["arguments"],
+        "input" => &["text"],
+        "model_request" => &["route", "effort", "sections"],
+        "response_stream" => &["text", "tool", "arguments"],
+        "tool_specs" => &["tools"],
+        "command_list" => &["commands"],
+        "command" => &["args"],
+        "config_list" => &["rows"],
+        "config_set" => &["value"],
+        "render" => &["props"],
+        "agent_offers" => &["offers"],
+        "agent_spawn" => &["definition", "prompt", "model", "effort", "cwd", "tools"],
+        "peer_send" | "peer_receive" => &["data"],
+        "compaction" => &["summary_prompt"],
+        "composer_edit" => &["edit"],
+        "component_change" => &["to"],
+        _ => &[],
+    };
+    let (Some(original), Some(object)) = (before.as_object(), input.as_object()) else {
+        return Err(failure(format!("invalid_continuation_input: {surface}")));
+    };
+    let unchanged = original
+        .iter()
+        .all(|(key, value)| mutable.contains(&key.as_str()) || object.get(key) == Some(value))
+        && object.keys().all(|key| original.contains_key(key));
+    let typed = match surface {
+        "tool" => {
+            input["tool"]
+                .as_str()
+                .is_some_and(|tool| !tool.is_empty() && tool.len() <= 128)
+                && (input["arguments"].is_object() || input["arguments"].is_string())
+        }
+        "input" => input["text"]
+            .as_str()
+            .is_some_and(|text| !text.trim().is_empty() && text.len() <= 61_440),
+        "model_request" => {
+            input["routes"].as_array().is_some_and(|routes| {
+                routes
+                    .iter()
+                    .any(|route| route["name"] == input["route"] && route["name"].is_string())
+            }) && (input["effort"] == before["effort"]
+                || !before["effort"].is_null()
+                    && input["effort"]
+                        .as_str()
+                        .is_some_and(|effort| crate::model_request::EFFORTS.contains(&effort)))
+                && (input["sections"] == before["sections"]
+                    || crate::model_request::valid_sections(
+                        &input["sections"],
+                        &before["sections"],
+                    ))
+        }
+        "response_stream" => {
+            crate::model_request::valid_stream_result(&json!({"chunks": [input]}), before)
+        }
+        "tool_specs" => tool_specs(&input["tools"], &original["tools"]),
+        "command_list" => rows(&input["commands"], &original["commands"], "command"),
+        "config_list" => rows(&input["rows"], &original["rows"], "key"),
+        "command" => input["args"]
+            .as_str()
+            .is_some_and(|args| args.len() <= 8192),
+        "config_set" => serde_json::to_vec(&input["value"])?.len() <= 65_536,
+        "render" => render::valid_input(before, input),
+        "host_operation" => {
+            input["operation"] != "turns.queue"
+                || input["arguments"]["event"] == before["arguments"]["event"]
+        }
+        "agent_offers" => offers(&input["offers"], &original["offers"]),
+        "agent_spawn" => spawn_request(input, before),
+        "peer_send" | "peer_receive" => serde_json::to_vec(&input["data"])?.len() <= 65_536,
+        "composer_edit" => composer_edit(&input["edit"], &before["edit"]),
+        "component_change" => component_change(&input["kind"], &input["to"]),
+        "compaction" => {
+            input["summary_prompt"] == before["summary_prompt"]
+                || before["summary_prompt"].is_string()
+                    && input["summary_prompt"]
+                        .as_str()
+                        .is_some_and(|text| !text.trim().is_empty() && text.len() <= 32_768)
+        }
+        _ => true,
+    };
+    if unchanged && typed {
+        Ok(())
+    } else {
+        Err(failure(format!("invalid_continuation_input: {surface}")))
+    }
+}
+
+fn component_change(kind: &Value, to: &Value) -> bool {
+    match kind.as_str() {
+        Some("focus") => to.is_null() || to.as_str().is_some_and(super::view::mod_component_id),
+        Some("scroll") => to
+            .as_u64()
+            .is_some_and(|offset| offset <= u64::from(u16::MAX)),
+        _ => false,
+    }
+}
+
+/// A draft edit may change only its text.
+fn composer_edit(edit: &Value, given: &Value) -> bool {
+    edit.as_object()
+        .zip(given.as_object())
+        .is_some_and(|(edit, given)| {
+            edit.len() == given.len()
+                && edit
+                    .iter()
+                    .all(|(key, value)| key == "text" || given.get(key) == Some(value))
+        })
+        && edit["text"]
+            .as_str()
+            .is_some_and(|text| text.len() <= 65_536)
+}
+
+/// Tool specs may drop, defer or re-describe tools they were given, never add or rename one.
+fn tool_specs(tools: &Value, given: &Value) -> bool {
+    let given = given
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|tool| tool["name"].as_str())
+        .collect::<BTreeSet<_>>();
+    let Some(tools) = tools.as_array() else {
+        return false;
+    };
+    let names = tools
+        .iter()
+        .filter_map(|tool| tool["name"].as_str())
+        .collect::<BTreeSet<_>>();
+    names.len() == tools.len()
+        && names.is_subset(&given)
+        && tools.iter().all(|tool| {
+            tool.as_object().is_some_and(|object| {
+                object.keys().all(|key| {
+                    ["name", "description", "parameters", "deferred"].contains(&key.as_str())
+                })
+            }) && tool["description"]
+                .as_str()
+                .is_some_and(|text| text.chars().count() <= 4096)
+                && (tool["parameters"].is_object() || tool["parameters"].is_null())
+                && tool["deferred"].is_boolean()
+        })
+}
+
+/// Agent offers may be dropped or re-described, never added, renamed or reassigned.
+fn offers(offers: &Value, given: &Value) -> bool {
+    let given = given
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|offer| Some((offer["name"].as_str()?, offer)))
+        .collect::<BTreeMap<_, _>>();
+    let Some(offers) = offers.as_array() else {
+        return false;
+    };
+    let names = offers
+        .iter()
+        .filter_map(|offer| offer["name"].as_str())
+        .collect::<BTreeSet<_>>();
+    names.len() == offers.len()
+        && offers.iter().all(|offer| {
+            offer["name"]
+                .as_str()
+                .and_then(|name| given.get(name))
+                .is_some_and(|original| {
+                    offer.as_object().is_some_and(|object| object.len() == 3)
+                        && offer["owner"] == original["owner"]
+                        && offer["description"].as_str().is_some_and(|text| {
+                            !text.trim().is_empty() && text.chars().count() <= 512
+                        })
+                })
+        })
+}
+
+/// Spawn requests keep their shape; tool lists may only narrow.
+fn spawn_request(input: &Value, before: &Value) -> bool {
+    let text = |value: &Value, limit: usize| {
+        value
+            .as_str()
+            .is_some_and(|text| !text.is_empty() && text.len() <= limit)
+    };
+    fn names(value: &Value) -> Option<BTreeSet<&str>> {
+        value
+            .as_array()
+            .map(|tools| tools.iter().filter_map(Value::as_str).collect())
+    }
+    text(&input["prompt"], 61_440)
+        && (input["definition"].is_null() || text(&input["definition"], 128))
+        && (input["model"].is_null() || text(&input["model"], 128))
+        && (input["effort"].is_null()
+            || input["effort"]
+                .as_str()
+                .is_some_and(|effort| crate::model_request::EFFORTS.contains(&effort)))
+        && (input["cwd"] == before["cwd"]
+            || text(&input["cwd"], 4096)
+                && Path::new(input["cwd"].as_str().unwrap_or("")).is_absolute())
+        && match (names(&input["tools"]), names(&before["tools"])) {
+            (None, None) => input["tools"].is_null(),
+            (Some(tools), None) => {
+                tools.len() <= 32
+                    && input["tools"]
+                        .as_array()
+                        .is_some_and(|t| t.len() == tools.len())
+            }
+            (Some(tools), Some(given)) => tools.is_subset(&given),
+            (None, Some(_)) => false,
+        }
+}
+
+/// List rows may be hidden, re-described or hinted, never added, renamed or changed when protected, managed or secret.
+fn rows(rows: &Value, given: &Value, key: &str) -> bool {
+    let given = given
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|row| Some((row[key].as_str()?, row)))
+        .collect::<BTreeMap<_, _>>();
+    let Some(rows) = rows.as_array() else {
+        return false;
+    };
+    let names = rows
+        .iter()
+        .filter_map(|row| row[key].as_str())
+        .collect::<BTreeSet<_>>();
+    let text = |value: &Value, limit: usize| {
+        value
+            .as_str()
+            .is_some_and(|text| text.chars().count() <= limit)
+    };
+    names.len() == rows.len()
+        && given.iter().all(|(name, row)| {
+            names.contains(name)
+                || !(row["protected"] == true || row["managed"] == true || row["secret"] == true)
+        })
+        && rows.iter().all(|row| {
+            let Some(original) = row[key].as_str().and_then(|name| given.get(name)) else {
+                return false;
+            };
+            let fixed = original["protected"] == true
+                || original["managed"] == true
+                || original["secret"] == true;
+            row.as_object()
+                .zip(original.as_object())
+                .is_some_and(|(row, original)| {
+                    row.len() == original.len()
+                        && row.iter().all(|(field, value)| match field.as_str() {
+                            _ if fixed || original.get(field.as_str()) == Some(value) => {
+                                original.get(field.as_str()) == Some(value)
+                            }
+                            "description" | "label" => text(value, 160),
+                            "args_hint" => value.is_null() || text(value, 64),
+                            "hidden" => value.is_boolean(),
+                            _ => false,
+                        })
+                })
+        })
+}
+
+fn validate_result(
+    surface: &str,
+    result: &Value,
+    last: Option<&Value>,
+    input: &Value,
+    executed: bool,
+    required_beneath: bool,
+) -> Result<()> {
+    if last == Some(result) {
+        return Ok(());
+    }
+    let text = |key: &str, limit: usize| {
+        result[key]
+            .as_str()
+            .is_some_and(|text| !text.is_empty() && text.len() <= limit)
+    };
+    let object = result.as_object();
+    // A refusal after the native executor ran would misreport an effect that already happened.
+    let deny = object.is_some_and(|object| object.len() == 1)
+        && text("deny", 512)
+        && !(executed
+            && matches!(
+                surface,
+                "command" | "config_set" | "peer_send" | "agent_spawn"
+            ));
+    let valid = match surface {
+        "tool" => {
+            deny || object.is_some_and(|object| {
+                result["output"]
+                    .as_str()
+                    .is_some_and(|output| output.len() <= RESULT_BYTES)
+                    && result["success"].is_boolean()
+                    && object.keys().all(|key| {
+                        ["output", "success", "truncated", "call_id"].contains(&key.as_str())
+                    })
+            })
+        }
+        "host_operation" => {
+            object.is_some_and(|object| object.len() == 1)
+                && (result.get("value").is_some() || text("error", 768))
+                && serde_json::to_vec(result)?.len() <= RESULT_BYTES
+        }
+        "tool_specs" => {
+            object.is_some_and(|object| object.len() == 1)
+                && last.is_some_and(|last| tool_specs(&result["tools"], &last["tools"]))
+        }
+        "command_list" => {
+            object.is_some_and(|object| object.len() == 1)
+                && last.is_some_and(|last| rows(&result["commands"], &last["commands"], "command"))
+        }
+        "config_list" => {
+            object.is_some_and(|object| object.len() == 1)
+                && last.is_some_and(|last| rows(&result["rows"], &last["rows"], "key"))
+        }
+        "command" => {
+            deny || object.is_some_and(|object| object.len() == 1)
+                && result.get("result").is_some()
+                && serde_json::to_vec(result)?.len() <= RESULT_BYTES
+        }
+        "admission" => {
+            let withheld = |value: &Value| {
+                value["withhold"].as_array().map(|items| {
+                    items
+                        .iter()
+                        .filter_map(Value::as_str)
+                        .map(str::to_owned)
+                        .collect::<BTreeSet<_>>()
+                })
+            };
+            let shaped = deny
+                || object.is_some_and(|object| object.len() == 1)
+                    && result["withhold"].as_array().is_some_and(|items| {
+                        items.len() <= 16
+                            && items.iter().all(|item| {
+                                item.as_str()
+                                    .is_some_and(|item| !item.is_empty() && item.len() <= 64)
+                            })
+                    });
+            // An outer handler may only tighten what the chain beneath it decided.
+            shaped
+                && match last {
+                    Some(last) if last.get("deny").is_some() => deny,
+                    Some(last) => match withheld(last) {
+                        Some(inner) => {
+                            deny || withheld(result).is_some_and(|outer| outer.is_superset(&inner))
+                        }
+                        None => true,
+                    },
+                    None => deny || !required_beneath,
+                }
+        }
+        "render" => render::valid_result(result),
+        "agent_offers" => {
+            object.is_some_and(|object| object.len() == 1)
+                && last.is_some_and(|last| offers(&result["offers"], &last["offers"]))
+        }
+        "agent_spawn" => {
+            deny || last.is_some_and(|last| {
+                object.is_some_and(|object| {
+                    object
+                        .keys()
+                        .all(|key| ["agent_id", "output", "success"].contains(&key.as_str()))
+                }) && result["agent_id"] == last["agent_id"]
+                    && result["success"] == last["success"]
+                    && result["output"]
+                        .as_str()
+                        .is_some_and(|output| output.len() <= RESULT_BYTES)
+            })
+        }
+        "peer_send" | "peer_receive" => deny,
+        "composer_edit" => {
+            deny || object.is_some_and(|object| object.len() == 1)
+                && composer_edit(&result["edit"], &input["edit"])
+        }
+        "component_change" => {
+            let key = if input["kind"] == "focus" {
+                "focus"
+            } else {
+                "scroll"
+            };
+            deny || object.is_some_and(|object| object.len() == 1)
+                && result.get(key).is_some()
+                && component_change(&input["kind"], &result[key])
+        }
+        "elicitation" => {
+            object.is_some_and(|object| object.len() == 1)
+                && (result["accept"].is_object()
+                    && serde_json::to_vec(&result["accept"])?.len() <= 65_536
+                    || text("decline", 512)
+                    || text("cancel", 512))
+        }
+        "compaction" => {
+            let reason = |key: &str| {
+                object.is_some_and(|object| object.len() == 1)
+                    && result[key]
+                        .as_str()
+                        .is_some_and(|text| !text.trim().is_empty() && text.len() <= 512)
+            };
+            let summary = object.is_some_and(|object| object.len() == 1)
+                && result["summary"]
+                    .as_str()
+                    .is_some_and(|text| !text.trim().is_empty() && text.len() <= 65_536);
+            let history = object.is_some_and(|object| object.len() == 1)
+                && result["history"]["keep"].is_array()
+                && serde_json::to_vec(&result["history"])?.len() <= 262_144;
+            summary || history || last.is_none() && (reason("skip") || reason("defer"))
+        }
+        "turn_stop" => {
+            object.is_some_and(|object| object.len() == 1)
+                && result["continue"]
+                    .as_str()
+                    .is_some_and(|text| !text.trim().is_empty() && text.len() <= 8192)
+        }
+        "model_request" => deny || last.is_none() && crate::model_request::valid_answer(result),
+        "response_stream" => crate::model_request::valid_stream_result(result, input),
+        "model_send" => {
+            deny || last
+                .is_some_and(|last| crate::model_request::valid_send_result(result, last, input))
+        }
+        _ => deny,
+    };
+    if valid {
+        Ok(())
+    } else {
+        Err(failure(format!("invalid_interceptor_result: {surface}")))
+    }
+}
+
+use crate::model_request::bounded;
+
+/// Final-request pages carry provider-bound text, so their records keep only digests.
+fn recorded(surface: &str, value: &Value) -> Value {
+    if surface == "model_send" {
+        let bytes = serde_json::to_vec(value).unwrap_or_default();
+        return json!({"sha256": crate::mods::digest(&bytes), "bytes": bytes.len()});
+    }
+    bounded(value)
+}
+
+#[derive(Default)]
+struct Attempts {
+    count: usize,
+    last: Option<std::result::Result<Value, String>>,
+    downstream: Duration,
+}
+
+struct Chain {
+    surface: String,
+    links: Vec<Link>,
+    original: Value,
+    origin: Value,
+    effective: Value,
+    executed: bool,
+    answered_by: Option<String>,
+    trace: Vec<Value>,
+    reads: BTreeMap<String, BTreeSet<String>>,
+}
+
+impl Chain {
+    #[allow(clippy::too_many_arguments)]
+    fn entry(
+        &mut self,
+        index: usize,
+        link: Option<&Link>,
+        outcome: &str,
+        attempts: &Attempts,
+        elapsed: Duration,
+        received: &Value,
+        returned: Option<&Value>,
+        reason: Option<&str>,
+    ) {
+        if self.trace.len() >= TRACE_LIMIT {
+            return;
+        }
+        let own = elapsed.saturating_sub(attempts.downstream);
+        let mut entry = json!({"index": index, "mod": link.map_or("engine", |link| link.id.as_str()),
+            "outcome": outcome, "attempts": attempts.count, "ms": own.as_millis() as u64,
+            "received": recorded(&self.surface, received)});
+        if let Some(link) = link {
+            entry["location"] = json!(link.location);
+            entry["required"] = json!(link.required);
+        }
+        if let Some(returned) = returned {
+            entry["returned"] = recorded(&self.surface, returned);
+        }
+        if let Some(reason) = reason {
+            entry["reason"] = json!(reason.chars().take(256).collect::<String>());
+        }
+        self.trace.push(entry);
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn call(
+        &mut self,
+        access: &mut Access<'_>,
+        host: &mut HostFn<'_>,
+        core: &mut Core<'_>,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+        k: usize,
+        link: &Link,
+        payload: Value,
+        attempts: &mut Attempts,
+    ) -> Result<Value> {
+        let wait = if link.required {
+            REQUIRED_WAIT
+        } else {
+            OPTIONAL_WAIT
+        };
+        invoke(
+            &mut access.bounded(wait),
+            &link.id,
+            link.generation,
+            "intercept",
+            &link.index.to_string(),
+            payload,
+            active,
+            host,
+            &mut |_| {},
+            &scope.child(),
+            Some(
+                &mut |access: &mut Access<'_>, host: &mut HostFn<'_>, input: Value| {
+                    attempts.count += 1;
+                    if attempts.count > ATTEMPT_LIMIT {
+                        return Err(failure("continuation_attempt_limit"));
+                    }
+                    let (mark, started) = (self.trace.len(), Instant::now());
+                    let result = self.link(access, host, core, active, scope, k + 1, input);
+                    attempts.downstream += started.elapsed();
+                    attempts.last = Some(
+                        result
+                            .as_ref()
+                            .map(Value::clone)
+                            .map_err(ToString::to_string),
+                    );
+                    let trace = self.trace[mark..].to_vec();
+                    result.map(|result| json!({"result": result, "trace": trace}))
+                },
+            ),
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn link(
+        &mut self,
+        access: &mut Access<'_>,
+        host: &mut HostFn<'_>,
+        core: &mut Core<'_>,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+        k: usize,
+        input: Value,
+    ) -> Result<Value> {
+        if !active() {
+            return Err(failure("callback_cancelled"));
+        }
+        if k > 0 {
+            validate_input(&self.surface, &self.original, &input)?;
+        }
+        let started = Instant::now();
+        let Some(link) = self.links.get(k).cloned() else {
+            self.effective = input.clone();
+            let result = core.run(access, host, &input, active, scope);
+            self.executed |= result.is_ok();
+            let (outcome, error) = match &result {
+                Ok(_) => ("returned", None),
+                Err(error) => ("rejected", Some(error.to_string())),
+            };
+            let once = Attempts {
+                count: 1,
+                ..Attempts::default()
+            };
+            self.entry(
+                k,
+                None,
+                outcome,
+                &once,
+                started.elapsed(),
+                &input,
+                result.as_ref().ok(),
+                error.as_deref(),
+            );
+            return result;
+        };
+        if !link.matcher.is_null() && !may_match(&link.matcher, &input)
+            || self.surface == "component_change"
+                && self.origin["owner"].as_str() != Some(link.id.as_str())
+        {
+            return self.link(access, host, core, active, scope, k + 1, input);
+        }
+        let mut attempts = Attempts::default();
+        if scope.contains(&link.id) || self.origin["caller"] == link.id.as_str() {
+            self.entry(
+                k,
+                Some(&link),
+                "skipped",
+                &attempts,
+                Duration::ZERO,
+                &input,
+                None,
+                Some("reentrant"),
+            );
+            return self.link(access, host, core, active, scope, k + 1, input);
+        }
+        // A final-request page is read-only, so its original would only repeat the input.
+        let original = match self.surface.as_str() {
+            "model_send" => Value::Null,
+            _ => self.original.clone(),
+        };
+        let payload = json!({"surface": self.surface, "input": input, "original": original,
+            "origin": self.origin});
+        let reply = self.call(
+            access,
+            host,
+            core,
+            active,
+            scope,
+            k,
+            &link,
+            payload.clone(),
+            &mut attempts,
+        );
+        let reads = self.reads.entry(link.id.clone()).or_default();
+        if let Ok(reply) = &reply {
+            reads.extend(
+                reply["reads"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter_map(|key| key.as_str().map(str::to_owned)),
+            );
+        }
+        if reply
+            .as_ref()
+            .is_ok_and(|reply| reply.get("unmatched") == Some(&Value::Bool(true)))
+        {
+            return self.link(access, host, core, active, scope, k + 1, input);
+        }
+        let last = |attempts: &Attempts| attempts.last.clone().and_then(std::result::Result::ok);
+        let required_beneath = self.links[k + 1..].iter().any(|link| link.required);
+        let settled = |reply: Result<Value>, attempts: &Attempts, surface: &str, executed: bool| {
+            reply.and_then(|reply| {
+                let result = reply.get("result").cloned().unwrap_or(Value::Null);
+                validate_result(
+                    surface,
+                    &result,
+                    last(attempts).as_ref(),
+                    &input,
+                    executed,
+                    required_beneath,
+                )?;
+                Ok(result)
+            })
+        };
+        let error = match settled(reply, &attempts, &self.surface, self.executed) {
+            Ok(result) => {
+                let outcome = match &attempts.last {
+                    Some(Ok(last)) if *last == result => "passed",
+                    Some(Ok(_)) => "returned",
+                    _ => {
+                        self.answered_by.get_or_insert_with(|| link.id.clone());
+                        "returned"
+                    }
+                };
+                self.entry(
+                    k,
+                    Some(&link),
+                    outcome,
+                    &attempts,
+                    started.elapsed(),
+                    &input,
+                    Some(&result),
+                    None,
+                );
+                return Ok(result);
+            }
+            Err(error) => error.to_string(),
+        };
+        if error.starts_with("callback_cancelled") {
+            self.entry(
+                k,
+                Some(&link),
+                "rejected",
+                &attempts,
+                started.elapsed(),
+                &input,
+                None,
+                Some(&error),
+            );
+            return Err(failure(error));
+        }
+        let unavailable = [
+            "stale_mod_generation",
+            "mod_disabled",
+            "mod_failed",
+            "mod_runtime_busy",
+        ]
+        .iter()
+        .any(|prefix| error.starts_with(prefix));
+        if link.catch && !unavailable {
+            let mut payload = payload;
+            payload["caught"] = json!({
+                "error": {"kind": if error.contains("callback_timeout") {"timeout"} else {"throw"}, "message": error},
+                "called": attempts.count > 0,
+                "result": last(&attempts),
+                "error_after_next": attempts.last.clone().and_then(std::result::Result::err),
+            });
+            let reply = self.call(
+                access,
+                host,
+                core,
+                active,
+                scope,
+                k,
+                &link,
+                payload,
+                &mut attempts,
+            );
+            if let Ok(result) = settled(reply, &attempts, &self.surface, self.executed) {
+                if !matches!(attempts.last, Some(Ok(_))) {
+                    self.answered_by.get_or_insert_with(|| link.id.clone());
+                }
+                self.entry(
+                    k,
+                    Some(&link),
+                    "caught",
+                    &attempts,
+                    started.elapsed(),
+                    &input,
+                    Some(&result),
+                    Some(&error),
+                );
+                return Ok(result);
+            }
+        }
+        if link.required {
+            self.entry(
+                k,
+                Some(&link),
+                "rejected",
+                &attempts,
+                started.elapsed(),
+                &input,
+                None,
+                Some(&error),
+            );
+            return Err(failure(format!(
+                "intercept_required_failed: {}: {error}",
+                link.id
+            )));
+        }
+        match attempts.last.clone() {
+            Some(Ok(result)) => {
+                self.entry(
+                    k,
+                    Some(&link),
+                    "kept",
+                    &attempts,
+                    started.elapsed(),
+                    &input,
+                    Some(&result),
+                    Some(&error),
+                );
+                Ok(result)
+            }
+            // A render hook that passed `next` invalid props falls back to what it received.
+            Some(Err(downstream))
+                if self.surface != "render"
+                    || !downstream.starts_with("invalid_continuation_input") =>
+            {
+                self.entry(
+                    k,
+                    Some(&link),
+                    "rejected",
+                    &attempts,
+                    started.elapsed(),
+                    &input,
+                    None,
+                    Some(&error),
+                );
+                Err(failure(downstream))
+            }
+            _ => {
+                self.entry(
+                    k,
+                    Some(&link),
+                    "skipped",
+                    &attempts,
+                    started.elapsed(),
+                    &input,
+                    None,
+                    Some(&error),
+                );
+                self.link(access, host, core, active, scope, k + 1, input)
+            }
+        }
+    }
+}
+
+fn effective_call(
+    access: &mut Access<'_>,
+    host: &mut HostFn<'_>,
+    caller: &str,
+    generation: u64,
+    input: &Value,
+    active: &dyn Fn() -> bool,
+    scope: &InvocationScope,
+) -> Result<Value> {
+    let call = ModHostCall {
+        operation: input["operation"].as_str().unwrap_or_default().to_owned(),
+        arguments: input["arguments"].clone(),
+    };
+    let (granted, withheld) = access.with(|runtime| {
+        Ok(runtime
+            .loaded
+            .get(caller)
+            .map(|loaded| (loaded.package.capabilities.clone(), loaded.withheld.clone()))
+            .unwrap_or_default())
+    })?;
+    let namespace = crate::mods::host_namespace(&call.operation, &call.arguments);
+    if withheld
+        .iter()
+        .any(|pattern| crate::mods::namespace_matches(pattern, &namespace))
+    {
+        return Err(failure(format!("capability_withheld: {namespace}")));
+    }
+    if let Some(missing) = call
+        .capabilities()?
+        .into_iter()
+        .find(|capability| !granted.iter().any(|granted| granted == capability))
+    {
+        return Err(failure(format!("capability_denied: {missing}")));
+    }
+    dispatch(access, host, caller, generation, call, active, scope)
+        .map(|value| json!({"value": value}))
+}
+
+/// A redacted receipt for structured access: origin and path without query, root, server or names, never bodies or values.
+pub fn access_receipt(
+    caller: &str,
+    call: &ModHostCall,
+    result: std::result::Result<&Value, String>,
+) -> Option<Value> {
+    let arguments = &call.arguments;
+    let at = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_millis() as u64)
+        .unwrap_or_default();
+    let mut receipt = json!({"mod": caller, "operation": call.operation, "at": at});
+    match call.operation.as_str() {
+        "http.request" | "http.open" => {
+            let url = arguments["url"].as_str().unwrap_or_default();
+            let origin = crate::url_origin(url);
+            let path = url
+                .split_once("://")
+                .and_then(|(_, rest)| rest.find(['/', '?', '#']).map(|start| &rest[start..]))
+                .filter(|_| origin.is_some())
+                .unwrap_or_default()
+                .split(['?', '#'])
+                .next()
+                .unwrap_or_default();
+            receipt["origin"] = json!(origin);
+            receipt["path"] = json!(path.chars().take(256).collect::<String>());
+            receipt["method"] = arguments.get("method").cloned().unwrap_or(json!("GET"));
+            receipt["credential"] = arguments.get("credential").cloned().unwrap_or(Value::Null);
+        }
+        "mcp.connect" | "mcp.disconnect" => receipt["server"] = arguments["server"].clone(),
+        "environment.read" => receipt["names"] = arguments["names"].clone(),
+        "workspace.read" | "workspace.list" | "workspace.stat" | "workspace.transaction"
+            if arguments.get("root").is_some() =>
+        {
+            receipt["root"] = arguments["root"].clone();
+        }
+        _ => return None,
+    }
+    match result {
+        Ok(value) => {
+            for field in ["status", "redirects"] {
+                if let Some(value) = value.get(field) {
+                    receipt[field] = value.clone();
+                }
+            }
+        }
+        Err(error) => receipt["error"] = json!(error.chars().take(200).collect::<String>()),
+    }
+    Some(receipt)
+}
+
+/// Runs a mod's `agents.spawn` with the request its `agent_spawn` chain settled on.
+fn spawn_call(
+    access: &mut Access<'_>,
+    host: &mut HostFn<'_>,
+    caller: &str,
+    original: &Value,
+    input: &Value,
+) -> Result<Value> {
+    if !input["cwd"].is_null() || !input["effort"].is_null() {
+        return Err(failure(
+            "agent_spawn_unsupported: mod spawns choose their workspace and route, not cwd or effort",
+        ));
+    }
+    let mut arguments = original.clone();
+    for (field, key) in [
+        ("definition", "definition"),
+        ("prompt", "prompt"),
+        ("model", "route"),
+        ("tools", "tools"),
+    ] {
+        match &input[field] {
+            Value::Null => {
+                if let Some(object) = arguments.as_object_mut() {
+                    object.remove(key);
+                }
+            }
+            value => arguments[key] = value.clone(),
+        }
+    }
+    let call = ModHostCall {
+        operation: "agents.spawn".into(),
+        arguments,
+    };
+    forward(access, host, caller, call)
+}
+
+fn forward(
+    access: &mut Access<'_>,
+    host: &mut HostFn<'_>,
+    caller: &str,
+    call: ModHostCall,
+) -> Result<Value> {
+    let request = call.clone();
+    let result = host(caller, call);
+    if let Some(receipt) = access_receipt(
+        caller,
+        &request,
+        result.as_ref().map_err(ToString::to_string),
+    ) {
+        let _ = access.with(|runtime| {
+            runtime.record_access(receipt);
+            Ok(())
+        });
+    }
+    result
+}
+
+/// Runs a host call for `caller`, routing service calls to their provider.
+pub(super) fn dispatch(
+    access: &mut Access<'_>,
+    host: &mut HostFn<'_>,
+    caller: &str,
+    generation: u64,
+    call: ModHostCall,
+    active: &dyn Fn() -> bool,
+    scope: &InvocationScope,
+) -> Result<Value> {
+    if call.operation == "agents.spawn"
+        && call.arguments.is_object()
+        && let Some(required) = access
+            .with(|runtime| Ok(runtime.intercepts("agent_spawn")))
+            .ok()
+            .flatten()
+    {
+        let field = |key: &str| call.arguments.get(key).cloned().unwrap_or(Value::Null);
+        let input = json!({"origin": "mod", "caller": caller, "thread_id": bound_thread(),
+            "agent_id": null, "definition": field("definition"), "prompt": field("prompt"),
+            "model": field("route"), "effort": null, "cwd": null, "tools": field("tools")});
+        let origin = json!({"caller": caller, "thread_id": bound_thread()});
+        let mut core = Core::Spawn {
+            caller: caller.to_owned(),
+            arguments: call.arguments,
+            spawned: None,
+        };
+        let chain = intercept(
+            access,
+            host,
+            &mut core,
+            "agent_spawn",
+            required,
+            input,
+            origin,
+            active,
+            scope,
+        )?;
+        if let Some(reason) = chain.result["deny"].as_str() {
+            return Err(failure(format!("agent_spawn_denied: {reason}")));
+        }
+        return match core {
+            Core::Spawn {
+                spawned: Some(value),
+                ..
+            } if value["handle"] == chain.result["agent_id"] => Ok(value),
+            _ => Err(failure("agent_spawn_result_unavailable")),
+        };
+    }
+    if call.operation == "peers.send"
+        && call.arguments.is_object()
+        && let Some(required) = access
+            .with(|runtime| Ok(runtime.intercepts("peer_send")))
+            .ok()
+            .flatten()
+    {
+        let input = json!({"to": {"session": call.arguments["to"], "package": call.arguments.get("package").cloned().unwrap_or(json!(caller))},
+            "correlation": call.arguments.get("correlation").cloned().unwrap_or(Value::Null),
+            "data": call.arguments.get("data").cloned().unwrap_or(Value::Null)});
+        let origin = json!({"caller": caller, "thread_id": bound_thread()});
+        let chain = intercept(
+            access,
+            host,
+            &mut Core::Peer {
+                caller: caller.to_owned(),
+                arguments: call.arguments,
+            },
+            "peer_send",
+            required,
+            input,
+            origin,
+            active,
+            scope,
+        )?;
+        if let Some(reason) = chain.result["deny"].as_str() {
+            return Err(failure(format!("peer_send_denied: {reason}")));
+        }
+        return Ok(chain.result["receipt"].clone());
+    }
+    if call.operation != "mods.service" {
+        return forward(access, host, caller, call);
+    }
+    let mut guarded = |caller: &str, call: ModHostCall| {
+        if matches!(call.operation.as_str(), "tools.define" | "tools.undefine") {
+            return Err(failure(format!(
+                "host_operation_unavailable: {} is not available inside a service call",
+                call.operation
+            )));
+        }
+        host(caller, call)
+    };
+    access.with(|runtime| {
+        runtime.call_service(
+            caller,
+            generation,
+            call.arguments,
+            active,
+            &mut guarded,
+            scope,
+        )
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn intercept(
+    access: &mut Access<'_>,
+    host: &mut HostFn<'_>,
+    core: &mut Core<'_>,
+    surface: &str,
+    required: bool,
+    input: Value,
+    origin: Value,
+    active: &dyn Fn() -> bool,
+    scope: &InvocationScope,
+) -> Result<ModChain> {
+    let wait = if required {
+        REQUIRED_WAIT
+    } else {
+        OPTIONAL_WAIT
+    };
+    let links = match access
+        .bounded(wait)
+        .with(|runtime| Ok(runtime.links(surface)))
+    {
+        Err(error) if !required && error.to_string().starts_with("mod_runtime_busy") => Vec::new(),
+        links => links?,
+    };
+    if links
+        .iter()
+        .all(|link| !link.matcher.is_null() && !may_match(&link.matcher, &input))
+    {
+        let result = core.run(access, host, &input, active, scope)?;
+        return Ok(ModChain {
+            result,
+            input,
+            answered_by: None,
+            trace: Vec::new(),
+            reads: BTreeMap::new(),
+        });
+    }
+    let mut chain = Chain {
+        surface: surface.to_owned(),
+        links,
+        original: input.clone(),
+        origin,
+        effective: input.clone(),
+        executed: false,
+        answered_by: None,
+        trace: Vec::new(),
+        reads: BTreeMap::new(),
+    };
+    let result = chain.link(access, host, core, active, scope, 0, input);
+    let record = ModChain {
+        result: result.as_ref().map_or(Value::Null, Value::clone),
+        input: chain.effective,
+        answered_by: chain.answered_by.filter(|_| !chain.executed),
+        trace: chain.trace,
+        reads: chain.reads,
+    };
+    let logged = json!({"result": recorded(surface, &record.result), "input": recorded(surface, &record.input),
+        "answered_by": record.answered_by, "trace": record.trace});
+    let entry = json!({"surface": surface, "origin": chain.origin, "error": result.as_ref().err().map(ToString::to_string), "chain": logged});
+    // Renders repeat per frame, so only failed ones join the chain log.
+    let failed = result.is_err() || record.trace.iter().any(|entry| entry["reason"].is_string());
+    let _ = (surface != "render" || failed).then(|| {
+        access.with(|runtime| {
+            runtime.chains.push(entry);
+            if runtime.chains.len() > CHAIN_LOG {
+                runtime.chains.remove(0);
+            }
+            Ok(())
+        })
+    });
+    result.map(|_| record)
+}
+
+impl ModHost {
+    /// Refuses or restricts packages through `admission` interceptors; policy mods and their dependencies are not judged.
+    pub(super) fn admit(&mut self) {
+        for loaded in self.loaded.values_mut() {
+            loaded.withheld.clear();
+        }
+        let Some(required) = self.intercepts("admission") else {
+            return;
+        };
+        let mut exempt = BTreeSet::new();
+        let mut pending = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .any(|interceptor| granted(loaded, &interceptor.pattern, "admission"))
+            })
+            .map(|(id, _)| id.clone())
+            .collect::<Vec<_>>();
+        while let Some(id) = pending.pop() {
+            if exempt.insert(id.clone())
+                && let Some(loaded) = self.loaded.get(&id)
+            {
+                pending.extend(
+                    loaded
+                        .package
+                        .dependencies
+                        .iter()
+                        .map(|dependency| dependency.id.clone()),
+                );
+                pending.extend(loaded.package.requires.iter().cloned());
+            }
+        }
+        let scope = exempt
+            .iter()
+            .filter_map(|id| self.loaded.get(id)?.package.policy.as_ref())
+            .flat_map(|policy| policy.namespaces.clone())
+            .collect::<Vec<_>>();
+        let policy = crate::mods::digest(
+            &serde_json::to_vec(
+                &exempt
+                    .iter()
+                    .filter_map(|id| {
+                        let selection = &self.loaded.get(id)?.selection;
+                        Some(json!([id, selection.sha256, selection.settings]))
+                    })
+                    .collect::<Vec<_>>(),
+            )
+            .unwrap_or_default(),
+        );
+        let candidates = self
+            .order
+            .iter()
+            .filter(|id| !exempt.contains(*id))
+            .filter(|id| {
+                self.loaded
+                    .get(*id)
+                    .is_some_and(|loaded| loaded.error.is_none())
+            })
+            .cloned()
+            .collect::<Vec<_>>();
+        let mut refused = BTreeMap::new();
+        for id in candidates {
+            let Some(loaded) = self.loaded.get(&id) else {
+                continue;
+            };
+            let key = format!("{}:{policy}", loaded.selection.sha256);
+            let decision = match self.admissions.get(&key) {
+                Some(decision) => decision.clone(),
+                None => {
+                    let package = &loaded.package;
+                    let input = json!({"package": {"id": id, "version": package.version,
+                        "sha256": loaded.selection.sha256, "source": loaded.selection.path,
+                        "scope": loaded.selection.scope, "capabilities": package.capabilities,
+                        "dependencies": package.dependencies, "requires": package.requires,
+                        "services": package.services, "registrations": loaded.registrations,
+                        "source_use": loaded.source_use}, "reason": "load"});
+                    let chain = intercept(
+                        &mut Access::Held(self),
+                        &mut |_, _| {
+                            Err(failure(
+                                "host_operation_unavailable: admission runs without host operations",
+                            ))
+                        },
+                        &mut Core::Call(&mut |_| Ok(json!({"admit": true}))),
+                        "admission",
+                        required,
+                        input,
+                        json!({"caller": "engine"}),
+                        &|| true,
+                        &InvocationScope::default(),
+                    );
+                    match chain {
+                        Ok(chain) => {
+                            let decision = admission(&chain.result, &scope);
+                            if chain.trace.iter().all(|entry| entry["reason"].is_null()) {
+                                if self.admissions.len() >= 256 {
+                                    self.admissions.clear();
+                                }
+                                self.admissions.insert(key, decision.clone());
+                            }
+                            decision
+                        }
+                        Err(error) => Err(format!("admission_policy_unavailable: {error}")),
+                    }
+                }
+            };
+            match decision {
+                Ok(withheld) => {
+                    if let Some(loaded) = self.loaded.get_mut(&id) {
+                        loaded.withheld = withheld;
+                    }
+                }
+                Err(reason) => {
+                    refused.insert(id, reason);
+                }
+            }
+        }
+        loop {
+            let services = refused
+                .keys()
+                .filter_map(|id| self.loaded.get(id))
+                .flat_map(|loaded| &loaded.registrations.services)
+                .map(|contract| &contract.name)
+                .collect::<BTreeSet<_>>();
+            let dependents = self
+                .loaded
+                .iter()
+                .filter(|(id, _)| !refused.contains_key(*id) && !exempt.contains(*id))
+                .filter_map(|(id, loaded)| {
+                    let refusal = loaded
+                        .package
+                        .dependencies
+                        .iter()
+                        .map(|dependency| &dependency.id)
+                        .chain(&loaded.package.requires)
+                        .find(|dependency| refused.contains_key(*dependency))
+                        .or_else(|| {
+                            loaded
+                                .package
+                                .services
+                                .imports
+                                .iter()
+                                .find(|import| !import.optional && services.contains(&import.name))
+                                .map(|import| &import.name)
+                        })?;
+                    Some((id.clone(), format!("dependency_not_admitted: {refusal}")))
+                })
+                .collect::<Vec<_>>();
+            if dependents.is_empty() {
+                break;
+            }
+            refused.extend(dependents);
+        }
+        for (id, reason) in refused {
+            if let Some(loaded) = self.loaded.remove(&id) {
+                self.order.retain(|item| *item != id);
+                self.rejected.push(ModRejection {
+                    path: loaded.selection.path,
+                    id: Some(id),
+                    scope: loaded.selection.scope,
+                    reason,
+                });
+            }
+        }
+    }
+
+    /// The final-request stage, absent without `model_send` interceptors or an enabled `request_policy` selection.
+    pub fn send_policy(&self) -> Option<SendPolicy> {
+        let required = self.intercepts("model_send");
+        if required.is_none() && self.policies.is_empty() {
+            return None;
+        }
+        let unavailable = self.policies.iter().find_map(|path| {
+            let shadowed = |rejection: &ModRejection| {
+                (&rejection.path == path
+                    && rejection.reason.starts_with("shadowed_by_project_scope"))
+                .then(|| self.loaded.get(rejection.id.as_deref()?))
+                .flatten()
+            };
+            let Some(loaded) = self
+                .loaded
+                .values()
+                .find(|loaded| &loaded.selection.path == path)
+                .or_else(|| self.rejected.iter().find_map(shadowed))
+            else {
+                let rejection = self
+                    .rejected
+                    .iter()
+                    .find(|rejection| &rejection.path == path);
+                return Some(match rejection {
+                    Some(rejection) => format!(
+                        "{}: {}",
+                        rejection.id.as_deref().unwrap_or("mod"),
+                        rejection.reason
+                    ),
+                    None => format!("{} is not loaded", path.display()),
+                });
+            };
+            let id = &loaded.package.id;
+            if let Some(error) = &loaded.error {
+                return Some(format!("{id}: {error}"));
+            }
+            (!loaded.registrations.interceptors.iter().any(|interceptor| {
+                interceptor.required && granted(loaded, &interceptor.pattern, "model_send")
+            }))
+            .then(|| format!("{id} registers no required model_send interceptor"))
+        });
+        let policies = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .any(|interceptor| granted(loaded, &interceptor.pattern, "model_send"))
+            })
+            .map(|(id, loaded)| json!([id, loaded.selection.sha256, loaded.selection.settings]))
+            .collect::<Vec<_>>();
+        let fingerprint = crate::mods::digest(
+            &serde_json::to_vec(&json!([self.generation, policies])).unwrap_or_default(),
+        );
+        Some(SendPolicy {
+            required: required == Some(true) || !self.policies.is_empty(),
+            unavailable,
+            fingerprint,
+        })
+    }
+
+    /// `Some(true)` when a required interceptor, including a faulted mod's, selects `surface`.
+    pub fn intercepts(&self, surface: &str) -> Option<bool> {
+        self.loaded
+            .values()
+            .flat_map(|loaded| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .filter(|interceptor| {
+                        (loaded.error.is_none() || interceptor.required)
+                            && granted(loaded, &interceptor.pattern, surface)
+                    })
+                    .map(|interceptor| interceptor.required)
+            })
+            .max()
+    }
+
+    pub(super) fn may_intercept(&self, surface: &str, input: &Value) -> bool {
+        self.links(surface)
+            .iter()
+            .any(|link| link.matcher.is_null() || may_match(&link.matcher, input))
+    }
+
+    /// Ordinary links wrap required ones; a faulted mod's required links stay and fail closed.
+    fn links(&self, surface: &str) -> Vec<Link> {
+        let order = order(&self.loaded).unwrap_or_default();
+        let faulted = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_some())
+            .map(|(id, _)| id.clone());
+        let required_order = order.iter().cloned().chain(faulted).collect::<Vec<_>>();
+        let mut links = Vec::new();
+        for (required, order) in [(false, &order), (true, &required_order)] {
+            for id in order {
+                let Some(loaded) = self.loaded.get(id) else {
+                    continue;
+                };
+                for (index, interceptor) in loaded.registrations.interceptors.iter().enumerate() {
+                    if interceptor.required == required
+                        && granted(loaded, &interceptor.pattern, surface)
+                    {
+                        links.push(Link {
+                            id: id.clone(),
+                            index,
+                            required,
+                            catch: interceptor.catch,
+                            location: interceptor.location.clone(),
+                            matcher: interceptor.matcher.clone(),
+                            generation: self.generation,
+                        });
+                    }
+                }
+            }
+        }
+        links
+    }
+}
+
+/// An admission result: the withheld namespaces, which must fall inside a policy mod's `policy.namespaces`, or the refusal.
+fn admission(result: &Value, scope: &[String]) -> std::result::Result<Vec<String>, String> {
+    if let Some(reason) = result.get("deny") {
+        return Err(format!(
+            "admission_denied: {}",
+            reason.as_str().unwrap_or_default()
+        ));
+    }
+    let withheld = result["withhold"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(Value::as_str)
+        .map(str::to_owned)
+        .collect::<Vec<_>>();
+    match withheld.iter().find(|namespace| {
+        !scope
+            .iter()
+            .any(|pattern| crate::mods::namespace_matches(pattern, namespace))
+    }) {
+        Some(namespace) => Err(format!(
+            "admission_policy_invalid: {namespace} is outside policy.namespaces"
+        )),
+        None => Ok(withheld),
+    }
+}
+
+/// Composes command or config rows without host operations; a row a handler drops becomes hidden.
+pub fn compose_rows(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    field: &str,
+    key: &str,
+    rows: Vec<Value>,
+) -> Result<Vec<Value>> {
+    let required = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?
+        .intercepts(surface);
+    let Some(required) = required else {
+        return Ok(rows);
+    };
+    let chain = intercept_shared(
+        runtime,
+        surface,
+        required,
+        json!({field: rows}),
+        json!({"caller": "user"}),
+        || true,
+        |_, _| {
+            Err(failure(format!(
+                "host_operation_unavailable: {surface} runs without host operations"
+            )))
+        },
+        |effective| Ok(json!({field: effective[field]})),
+    )?;
+    let composed = chain.result[field].as_array().cloned().unwrap_or_default();
+    Ok(rows
+        .into_iter()
+        .map(
+            |mut row| match composed.iter().find(|item| item[key] == row[key]) {
+                Some(item) => item.clone(),
+                None => {
+                    row["hidden"] = json!(true);
+                    row
+                }
+            },
+        )
+        .collect())
+}
+
+/// Runs `core` behind the surface's interceptors, or directly when none is registered.
+pub fn continue_operation(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    input: Value,
+    origin: Value,
+    active: impl Fn() -> bool,
+    host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    mut core: impl FnMut(Value) -> Result<Value>,
+) -> Result<Value> {
+    let required = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?
+        .intercepts(surface);
+    let result = match required {
+        Some(required) => {
+            intercept_shared(
+                runtime, surface, required, input, origin, active, host, core,
+            )?
+            .result
+        }
+        None if !active() => return Err(failure("callback_cancelled")),
+        None => core(input)?,
+    };
+    match result.get("deny").and_then(Value::as_str) {
+        Some(reason) => Err(failure(format!("{surface}_denied: {reason}"))),
+        None => Ok(result),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn intercept_shared(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    required: bool,
+    input: Value,
+    origin: Value,
+    active: impl Fn() -> bool,
+    mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    mut core: impl FnMut(Value) -> Result<Value>,
+) -> Result<ModChain> {
+    intercept(
+        &mut Access::Bounded(runtime, REQUIRED_WAIT),
+        &mut host,
+        &mut Core::Call(&mut core),
+        surface,
+        required,
+        input,
+        origin,
+        &active,
+        &InvocationScope::default(),
+    )
+}
diff --git a/codex-rs/omd/src/mods/outcome.rs b/codex-rs/omd/src/mods/outcome.rs
new file mode 100644
index 000000000..4973a2bbb
--- /dev/null
+++ b/codex-rs/omd/src/mods/outcome.rs
@@ -0,0 +1,79 @@
+use super::*;
+
+const TEXT_LIMIT: usize = 16_384;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ModCommandOutcome {
+    pub display: Option<String>,
+    pub insert: Option<String>,
+    pub submit: Option<String>,
+}
+
+fn text(value: &Value, limit: usize) -> Result<String> {
+    let text = value
+        .as_str()
+        .ok_or_else(|| failure("invalid_outcome_text"))?;
+    if text.is_empty()
+        || text.len() > limit
+        || text
+            .chars()
+            .any(|c| c.is_control() && c != '\n' && c != '\t')
+    {
+        return Err(failure("invalid_outcome_text"));
+    }
+    Ok(text.to_owned())
+}
+
+fn truncated(mut text: String) -> String {
+    if text.len() > TEXT_LIMIT {
+        let mut end = TEXT_LIMIT;
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        text.truncate(end);
+    }
+    text.chars()
+        .filter(|c| !c.is_control() || *c == '\n' || *c == '\t')
+        .collect()
+}
+
+impl ModCommandOutcome {
+    pub fn parse(value: &Value) -> Result<Self> {
+        match value {
+            Value::Null => Ok(Self::default()),
+            Value::String(display) => Ok(Self {
+                display: Some(truncated(display.clone())).filter(|s| !s.is_empty()),
+                ..Self::default()
+            }),
+            Value::Object(object)
+                if !object.is_empty()
+                    && object
+                        .keys()
+                        .all(|key| ["display", "insert", "submit"].contains(&key.as_str())) =>
+            {
+                let outcome = Self {
+                    display: object
+                        .get("display")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    insert: object
+                        .get("insert")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                    submit: object
+                        .get("submit")
+                        .map(|v| text(v, TEXT_LIMIT))
+                        .transpose()?,
+                };
+                if outcome.insert.is_some() && outcome.submit.is_some() {
+                    return Err(failure("command_outcome_conflict: insert or submit"));
+                }
+                Ok(outcome)
+            }
+            other => Ok(Self {
+                display: Some(truncated(serde_json::to_string_pretty(other)?)),
+                ..Self::default()
+            }),
+        }
+    }
+}
diff --git a/codex-rs/omd/src/mods/package_manager.rs b/codex-rs/omd/src/mods/package_manager.rs
new file mode 100644
index 000000000..8527b1056
--- /dev/null
+++ b/codex-rs/omd/src/mods/package_manager.rs
@@ -0,0 +1,2204 @@
+use super::*;
+use serde_json::Map;
+use std::io::Read;
+use std::process::Command;
+
+const PACKAGE_LOCK_SCHEMA: u32 = 1;
+const PACKAGE_HISTORY_LIMIT: usize = 8;
+const NPM_METADATA_LIMIT: usize = 16 * 1024 * 1024;
+const NPM_TARBALL_LIMIT: usize = 4 * 1024 * 1024;
+const NPM_UNPACKED_LIMIT: usize = 16 * 1024 * 1024;
+const NPM_ARCHIVE_ENTRIES: usize = 1024;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ModPackageSource {
+    Local {
+        path: PathBuf,
+    },
+    Repository {
+        repository: String,
+        revision: String,
+        #[serde(default)]
+        subdirectory: String,
+    },
+    Package {
+        index: PathBuf,
+        id: String,
+        version: String,
+    },
+    Npm {
+        package: String,
+        #[serde(default)]
+        version: String,
+        #[serde(default)]
+        registry: String,
+        #[serde(default, skip_serializing_if = "String::is_empty")]
+        integrity: String,
+    },
+}
+
+/// The registry and token settings npm and pnpm read from the user's `.npmrc`.
+#[derive(Default)]
+struct NpmConfig {
+    registry: Option<String>,
+    scopes: BTreeMap<String, String>,
+    tokens: Vec<(String, String)>,
+}
+
+impl NpmConfig {
+    fn load() -> Self {
+        let path = std::env::var_os("NPM_CONFIG_USERCONFIG")
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".npmrc")));
+        let text = path
+            .filter(|path| {
+                std::fs::metadata(path).is_ok_and(|meta| meta.is_file() && meta.len() <= 65_536)
+            })
+            .and_then(|path| std::fs::read_to_string(path).ok())
+            .unwrap_or_default();
+        let expand = |value: &str| {
+            let mut expanded = value.trim().trim_matches('"').to_owned();
+            while let Some(start) = expanded.find("${") {
+                let Some(length) = expanded[start..].find('}') else {
+                    break;
+                };
+                let name = expanded[start + 2..start + length].to_owned();
+                let replacement = std::env::var(&name).unwrap_or_default();
+                expanded.replace_range(start..=start + length, &replacement);
+            }
+            expanded
+        };
+        let mut config = Self::default();
+        for line in text.lines().map(str::trim) {
+            let Some((key, value)) = line
+                .split_once('=')
+                .filter(|_| !line.starts_with(['#', ';']))
+            else {
+                continue;
+            };
+            let (key, value) = (key.trim(), expand(value));
+            if key == "registry" {
+                config.registry = Some(value);
+            } else if let Some(scope) = key
+                .strip_suffix(":registry")
+                .filter(|scope| scope.starts_with('@'))
+            {
+                config.scopes.insert(scope.to_owned(), value);
+            } else if let Some(prefix) = key
+                .strip_suffix(":_authToken")
+                .filter(|prefix| prefix.starts_with("//"))
+            {
+                config
+                    .tokens
+                    .push((format!("{}/", prefix.trim_end_matches('/')), value));
+            }
+        }
+        config
+    }
+
+    fn registry(&self, package: &str) -> String {
+        package
+            .split_once('/')
+            .and_then(|(scope, _)| self.scopes.get(scope))
+            .or(self.registry.as_ref())
+            .map_or("https://registry.npmjs.org", String::as_str)
+            .trim_end_matches('/')
+            .to_owned()
+    }
+
+    fn token(&self, url: &str) -> Option<&str> {
+        let target = format!("//{}", url.split_once("://")?.1);
+        self.tokens
+            .iter()
+            .filter(|(prefix, _)| target.starts_with(prefix.as_str()))
+            .max_by_key(|(prefix, _)| prefix.len())
+            .map(|(_, token)| token.as_str())
+            .filter(|token| !token.is_empty())
+    }
+}
+
+impl ModPackageSource {
+    /// Parses `npm:NAME[@VERSION]`, `git+URL[#REF[:SUBDIRECTORY]]`, an absolute folder, or `ID[@VERSION]` from `index`.
+    pub fn parse(reference: &str, index: Option<PathBuf>) -> Result<Self> {
+        let reference = reference.trim();
+        let versioned = |value: &str| match value.get(1..).and_then(|rest| rest.rfind('@')) {
+            Some(at) => (value[..=at].to_owned(), value[at + 2..].to_owned()),
+            None => (value.to_owned(), String::new()),
+        };
+        if let Some(npm) = reference.strip_prefix("npm:") {
+            let (package, version) = versioned(npm);
+            return Ok(Self::Npm {
+                package,
+                version,
+                registry: String::new(),
+                integrity: String::new(),
+            });
+        }
+        if let Some(git) = reference.strip_prefix("git+") {
+            let (repository, fragment) = git.split_once('#').unwrap_or((git, "HEAD"));
+            let (revision, subdirectory) = fragment.split_once(':').unwrap_or((fragment, ""));
+            return Ok(Self::Repository {
+                repository: repository
+                    .strip_prefix("file://")
+                    .unwrap_or(repository)
+                    .to_owned(),
+                revision: revision.to_owned(),
+                subdirectory: subdirectory.to_owned(),
+            });
+        }
+        if reference.starts_with('/') {
+            return Ok(Self::Local {
+                path: reference.into(),
+            });
+        }
+        let (id, version) = versioned(reference);
+        if !identifier(&id) || !version_selector(&version) {
+            return Err(failure(
+                "package_reference_invalid: use ID[@VERSION], npm:NAME[@VERSION], git+URL[#REF[:DIRECTORY]] or an absolute folder",
+            ));
+        }
+        Ok(Self::Package {
+            index: index.ok_or_else(|| {
+                failure("package_index_unavailable: install from npm:, git+ or a folder instead")
+            })?,
+            id,
+            version,
+        })
+    }
+
+    /// Replaces the requested version of a package or npm source.
+    pub fn with_version(self, requested: &str) -> Result<Self> {
+        match self {
+            Self::Package { index, id, .. } => Ok(Self::Package {
+                index,
+                id,
+                version: requested.to_owned(),
+            }),
+            Self::Npm {
+                package, registry, ..
+            } => Ok(Self::Npm {
+                package,
+                version: requested.to_owned(),
+                registry,
+                integrity: String::new(),
+            }),
+            _ => Err(failure(
+                "package_version_unsupported: pin a Git source with #REF; folders have no versions",
+            )),
+        }
+    }
+
+    /// The source an update resolves: newer compatible index and npm releases; pinned commits and local folders as is.
+    pub fn updatable(&self) -> Self {
+        let compatible = |version: &str| match SemanticVersion::parse(version) {
+            Some(_) => format!("^{version}"),
+            None => String::new(),
+        };
+        match self {
+            Self::Package { index, id, version } => Self::Package {
+                index: index.clone(),
+                id: id.clone(),
+                version: compatible(version),
+            },
+            Self::Npm {
+                package,
+                version,
+                registry,
+                ..
+            } => Self::Npm {
+                package: package.clone(),
+                version: compatible(version),
+                registry: registry.clone(),
+                integrity: String::new(),
+            },
+            source => source.clone(),
+        }
+    }
+}
+
