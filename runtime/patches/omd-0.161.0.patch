+#[tokio::test(flavor = "multi_thread")]
+async fn lifecycle_seams_report_batches_loads_failures_and_elicitations() {
+    let Some(fixture) = fixture(&[Package {
+        id: "observer",
+        capabilities: &["lifecycle", "approvals", "autonomous", "store"],
