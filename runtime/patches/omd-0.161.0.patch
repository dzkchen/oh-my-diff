+pub(super) async fn parent_config(lead: &Lead) -> Result<Arc<Config>, String> {
+    let manager = lead
+        .host
+        .manager
+        .upgrade()
+        .ok_or("native_thread_manager_stopped")?;
+    let parent = manager
+        .get_thread(lead.thread)
+        .await
+        .map_err(|e| e.to_string())?
+        .config()
