+#[test]
+fn surface_routes_enforces_user_context_cancels_and_unregisters() {
+    let _serial = hub_test();
+    let active = || true;
+    let event = InvocationContext::Event;
+    assert!(
+        call(
+            "m",
+            "composer.read",
+            Value::Null,
+            event,
+            false,
+            None,
+            None,
