+pub(crate) fn session_title_suffix() -> Option<String> {
+    with_cache(|cache| cache.snapshot.view.session_title_suffix.clone()).flatten()
+}
+
+pub(crate) fn greeting() -> Option<String> {
+    with_cache(|cache| cache.snapshot.view.greeting.clone()).flatten()
+}
+
+pub(crate) fn presentation_revision() -> u64 {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let mut revision = std::collections::hash_map::DefaultHasher::new();
+    with_cache(|cache| {
+        // Hash presentation content, not the lifecycle revision: ordinary terminal events
+        // should not invalidate retained transcript layouts.
+        let view = &cache.snapshot.view;
+        serde_json::to_vec(&(
+            &view.theme,
+            &view.surface_styles,
+            &view.session_title_suffix,
+            &view.greeting,
+            view.foreground,
+            view.background,
+            crate::mod_render::epoch(),
+        ))
+        .unwrap_or_default()
+        .hash(&mut revision);
+    });
+    revision.finish()
+}
