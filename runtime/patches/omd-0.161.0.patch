+    fn on_turn_start<'a>(&'a self, input: TurnStartInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            let Some(lead) = input
+                .thread_store
+                .get::<Lead>()
+                .filter(|lead| lead.owner == "lead")
+            else {
