+    assert!(
+        begin(fixtures[0].1.clone())
+            .recv_timeout(WAIT)
+            .unwrap()
+            .is_err()
+    );
+    drop(fixtures);
+    for request in pending {
+        assert!(request.recv_timeout(WAIT).unwrap().is_err());
+    }
+    for mut upstream in upstreams {
+        closed(&mut upstream);
+    }
+}
