+/// Parameters for reading or rewriting a paginated thread's durable transcript rows.
+#[derive(Clone)]
+pub struct RewriteThreadParams {
+    /// Stable logical thread to rewrite.
+    pub thread_id: ThreadId,
+    /// Revision the edits were made against. `None` only reads the current revision and rows.
+    pub expected_revision: Option<String>,
+    /// Row edits applied in order, as one atomic revision.
+    pub edits: Vec<HistoryRowEdit>,
+    /// Restore the transcript the latest revision replaced, keeping rows appended since.
+    pub undo: bool,
+    /// Recorded as edit provenance.
+    pub author: String,
+    /// Resolved runtime version to keep in the replacement session metadata.
+    pub multi_agent_version: Option<MultiAgentVersion>,
+    /// Anchors and verifies the per-thread revision log.
+    pub witness: Option<Arc<dyn HistoryWitness>>,
+    /// Validates the revision and edits against the current rows without locking or writing anything.
+    pub dry_run: bool,
+}
+
+/// One row edit. Rows are addressed by the ids `ThreadRewrite::rows` reports.
+#[derive(Clone, Debug, PartialEq, Deserialize, Serialize)]
+#[serde(tag = "op", rename_all = "camelCase", deny_unknown_fields)]
+pub enum HistoryRowEdit {
+    Delete {
+        id: String,
+    },
+    Replace {
+        id: String,
+        items: Vec<serde_json::Value>,
+    },
+    /// Inserts before or after a row; with neither, appends after the last row.
+    Insert {
+        #[serde(default)]
+        before: Option<String>,
+        #[serde(default)]
+        after: Option<String>,
+        items: Vec<serde_json::Value>,
+    },
+    Move {
+        id: String,
+        #[serde(default)]
+        before: Option<String>,
+        #[serde(default)]
+        after: Option<String>,
+    },
+}
+
+/// What a rewrite may do to a row.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum HistoryRowAccess {
+    Frozen,
+    Delete,
+    Edit,
+}
+
+/// One addressable transcript row: a display item and the model items paired with it.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HistoryRow {
+    pub id: String,
+    pub turn_id: Option<String>,
+    pub kind: String,
+    pub access: HistoryRowAccess,
+}
+
+/// Current revision and rows after a read or rewrite.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ThreadRewrite {
+    pub revision: String,
+    pub previous_revision: Option<String>,
+    pub rows: Vec<HistoryRow>,
+}
+
+/// Tamper evidence for a thread's revision log, e.g. a hash chain held outside the user's files.
+pub trait HistoryWitness: Send + Sync {
+    fn append(&self, stream: &std::path::Path, sha256: &str) -> std::io::Result<()>;
+    /// Fails with `InvalidData` when the log differs from its anchors; any other error means unverifiable.
+    fn verify(&self, stream: &std::path::Path, sha256s: &[String]) -> std::io::Result<()>;
+}
