+    expansion::broadcast(&core.expansion, "thread_settings", change);
+    assert!(!delivery::deliver(core).await);
+    let log = core
+        .runtime
+        .lock()
+        .unwrap()
+        .state("observer")
+        .cloned()
+        .unwrap();
+    assert_eq!(
+        log[5],
+        json!({"phase": "created", "path": "/scratch/agent", "owner": "agent"})
