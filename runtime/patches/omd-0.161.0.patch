+    pub(crate) evidence: Option<PathBuf>,
+    pub(crate) active_mods: usize,
+    pub(crate) failed_mods: usize,
+    pub(crate) rejected_selections: usize,
+    pub(crate) observed_requests: usize,
+    pub(crate) raw_usage_attempts: u64,
+    pub(crate) settled_task_charge_microusd: u64,
+    pub(crate) retained_exposure_upper_bound_microusd: u64,
+    pub(crate) contract: String,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct ModPaths {
+    pub(crate) evidence: PathBuf,
+    pub(crate) repository: PathBuf,
+    pub(crate) store: Option<PathBuf>,
+    pub(crate) protected: Vec<PathBuf>,
+}
+
+pub(crate) fn is_active() -> bool {
+    effective_mode().is_ok_and(|mode| mode.mode.mod_host_enabled())
+}
+
+/// Every frame asks for this, so the parsed view is reused until `mod-view.json` or `mod-status.json` changes.
+pub(crate) fn mod_snapshot() -> (bool, codex_omd::ModViewSnapshot) {
+    type Cached = (PathBuf, [Option<FileStamp>; 2], codex_omd::ModViewSnapshot);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let Some(root) = store_root() else {
+        return (false, codex_omd::ModViewSnapshot::default());
+    };
+    let (view, status) = (root.join("mod-view.json"), root.join("mod-status.json"));
+    let stamps = [file_stamp(&view), file_stamp(&status)];
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached_root, cached, snapshot)) = cache.as_ref()
+        && *cached_root == root
+        && *cached == stamps
+    {
+        return (true, snapshot.clone());
+    }
+    let snapshot = read_mod_snapshot(&view, &status);
+    *cache = Some((root, stamps, snapshot.clone()));
+    (true, snapshot)
+}
+
+/// Modification time, length and (on Unix) inode, so a same-tick rename-over still reads as a change.
+type FileStamp = (std::time::SystemTime, u64, u64);
+
+fn file_stamp(path: &Path) -> Option<FileStamp> {
+    let metadata = std::fs::symlink_metadata(path).ok()?;
+    #[cfg(unix)]
+    let inode = std::os::unix::fs::MetadataExt::ino(&metadata);
+    #[cfg(not(unix))]
+    let inode = 0;
+    Some((metadata.modified().ok()?, metadata.len(), inode))
+}
+
+fn read_mod_snapshot(view: &Path, status: &Path) -> codex_omd::ModViewSnapshot {
+    let mut snapshot = codex_omd::ModViewSnapshot::read(view).unwrap_or_default();
+    if let Some(status) = bounded_read(status, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+    {
+        let errors = status["mods"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|item| {
+                item["error"].as_str().map(|error| {
+                    format!("{}: {error}", item["id"].as_str().unwrap_or("mod"))
+                        .chars()
+                        .filter(|character| !character.is_control())
+                        .take(180)
+                        .collect::<String>()
+                })
+            })
+            .take(16)
+            .collect::<Vec<_>>();
+        if !errors.is_empty()
+            && !snapshot
+                .view
+                .panels
+                .iter()
+                .any(|panel| panel.title == "Mod errors")
+        {
+            snapshot.view.panels.insert(
+                0,
+                codex_omd::ModPanel {
+                    title: "Mod errors".into(),
+                    lines: errors,
+                },
+            );
+        }
+    }
+    snapshot
+}
+
+pub(crate) fn mod_paths() -> Option<ModPaths> {
+    let repository = crate::mod_runtime::active_context()
+        .map(|context| context.repository)
+        .or_else(|| std::env::current_dir().ok())?;
+    mod_paths_for(&repository)
+}
+
+pub(crate) fn mod_paths_for(repository: &Path) -> Option<ModPaths> {
+    let root = store_root()?;
+    let repository = repository.canonicalize().ok()?;
+    if codex_omd::app_routes::unscoped_directory(&repository) {
+        return None;
+    }
+    let protected = host_protected_paths(&root);
+    Some(ModPaths {
+        evidence: root.clone(),
+        repository,
+        store: Some(root),
+        protected,
+    })
+}
+
+pub(crate) fn store_root() -> Option<PathBuf> {
+    if !is_active() {
+        return None;
+    }
+    let root = PathBuf::from(std::env::var_os(codex_omd::MOD_STORE_ENV)?);
+    (root.is_absolute() && root.canonicalize().ok()? == root).then_some(root)
+}
+
+/// The store plus `host.json` protected and secret paths, re-read only when the file changes.
+fn host_protected_paths(root: &Path) -> Vec<PathBuf> {
+    type Cached = (PathBuf, Option<(std::time::SystemTime, u64)>, Vec<PathBuf>);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let path = root.join(HOST_CONFIG);
+    let stamp = std::fs::symlink_metadata(&path)
+        .ok()
+        .and_then(|metadata| Some((metadata.modified().ok()?, metadata.len())));
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached_root, cached_stamp, protected)) = cache.as_ref()
+        && cached_root == root
+        && *cached_stamp == stamp
+    {
+        return protected.clone();
+    }
+    let config = bounded_read(&path, 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or(Value::Null);
+    let paths = |value: &Value| -> Vec<PathBuf> {
+        match value {
+            Value::Array(items) => items
+                .iter()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            Value::Object(items) => items
+                .values()
+                .filter_map(Value::as_str)
+                .map(PathBuf::from)
+                .collect(),
+            _ => Vec::new(),
+        }
+    };
+    let mut protected = vec![root.to_path_buf()];
+    protected.extend(paths(&config["protected"]));
+    protected.extend(paths(&config["secret_refs"]));
+    *cache = Some((root.to_path_buf(), stamp, protected.clone()));
+    protected
+}
+
+pub(crate) fn mod_status() -> Option<Value> {
+    serde_json::from_slice(&bounded_read(&store_root()?.join("mod-status.json"), 262_144).ok()?)
+        .ok()
+}
+
+pub(crate) fn builtins() -> codex_omd::BuiltinSnapshot {
+    type Cached = (
+        Option<PathBuf>,
+        std::time::Instant,
+        codex_omd::BuiltinSnapshot,
+    );
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let root = mod_paths().and_then(|paths| paths.store);
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached, loaded, snapshot)) = cache.as_ref()
+        && *cached == root
+        && loaded.elapsed() < std::time::Duration::from_secs(2)
+    {
+        return snapshot.clone();
+    }
+    let snapshot = root
+        .as_deref()
+        .map(codex_omd::BuiltinSnapshot::read)
+        .unwrap_or_default();
+    *cache = Some((root, std::time::Instant::now(), snapshot.clone()));
+    snapshot
+}
+
+pub(crate) fn command_replacement(command: &str) -> Option<crate::mod_runtime::ModSlashCommand> {
