index 000000000..b55507e0f
--- /dev/null
+++ b/codex-rs/core/src/tools/batch.rs
@@ -0,0 +1,258 @@
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+use codex_extension_api::ToolBatchCall;
+use codex_extension_api::ToolBatchInput;
+use codex_extension_api::ToolBatchMerge;
+use codex_extension_api::ToolBatchPosition;
+use codex_extension_api::ToolCallFacts;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ResponseInputItem;
+use codex_protocol::models::ResponseItem;
+use codex_tools::ToolName;
+use codex_tools::ToolPayload;
+use futures::FutureExt;
+use tokio_util::sync::CancellationToken;
+
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::stream_events_utils::InFlightFuture;
+use crate::stream_events_utils::record_completed_response_item;
+use crate::tools::call_trace;
+use crate::tools::parallel::ToolCallRuntime;
+use crate::tools::router::ToolCall;
+use crate::tools::router::ToolRouter;
+
+pub(crate) fn batching(session: &Session) -> bool {
+    session
+        .services
+        .extensions
+        .tool_batch_contributors()
+        .iter()
+        .any(|contributor| contributor.batching(&session.services.thread_extension_data))
+}
+
+pub(crate) fn deferrable(step_context: &StepContext, item: &ResponseItem) -> Option<ToolCall> {
+    ToolRouter::build_tool_call(item.clone())
+        .ok()
+        .flatten()
+        .filter(|call| {
+            matches!(call.payload, ToolPayload::Function { .. })
+                && step_context.tool_router.tool_supports_parallel(call)
+        })
+}
+
+pub(crate) async fn defer(
+    session: &Session,
+    step_context: &StepContext,
+    item: &ResponseItem,
+    call: &ToolCall,
+) {
+    call_trace::received(
+        session.thread_id,
+        &call.tool_name,
+        &call.call_id,
+        call_trace::Receipt::ModelTurn(&step_context.turn.sub_id),
+    );
+    session
+        .input_queue
+        .accept_mailbox_delivery_for_current_turn(&session.active_turn, &step_context.turn.sub_id)
+        .await;
+    record_completed_response_item(session, step_context, item).await;
+}
+
+fn arguments(call: &ToolCall) -> &str {
+    match &call.payload {
+        ToolPayload::Function { arguments } => arguments,
+        _ => "",
+    }
+}
+
+pub(crate) fn valid(
+    merges: Vec<ToolBatchMerge>,
+    calls: &[ToolCall],
+    router: &ToolRouter,
+) -> Vec<ToolBatchMerge> {
+    let known = calls
+        .iter()
+        .map(|call| call.call_id.as_str())
+        .collect::<BTreeSet<_>>();
+    let mut used = BTreeSet::new();
+    merges
+        .into_iter()
+        .filter(|merge| {
+            let ok = merge.call_ids.len() >= 2
+                && merge
+                    .call_ids
+                    .iter()
+                    .all(|id| known.contains(id.as_str()) && !used.contains(id))
+                && router
+                    .tool_runtime(&ToolName::plain(merge.tool.as_str()))
+                    .is_some()
+                && serde_json::from_str::<serde_json::Value>(&merge.arguments)
+                    .is_ok_and(|value| value.is_object());
+            if ok {
+                used.extend(merge.call_ids.iter().cloned());
+            }
+            ok
+        })
+        .collect()
+}
+
+pub(crate) fn fan_out(call_id: &str, merged: &Result<(String, bool), String>) -> ResponseInputItem {
+    let (text, success) = match merged {
+        Ok((text, success)) => match serde_json::from_str::<serde_json::Value>(text)
+            .ok()
+            .and_then(|value| value.get(call_id).cloned())
+        {
+            Some(serde_json::Value::String(text)) => (text, *success),
+            Some(value) => (value.to_string(), *success),
+            None => (
+                format!("error: the batched call returned no result for {call_id}"),
+                false,
+            ),
+        },
+        Err(error) => (format!("error: the batched call failed: {error}"), false),
+    };
+    ResponseInputItem::FunctionCallOutput {
+        call_id: call_id.to_owned(),
+        output: FunctionCallOutputPayload {
+            body: FunctionCallOutputBody::Text(text),
+            success: Some(success),
+        },
+    }
+}
+
+fn merged_output(envelope: &ResponseItemEnvelope) -> Option<(String, bool)> {
+    match &envelope.item {
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            Some((output.body.to_text()?, output.success.unwrap_or(true)))
+        }
+        _ => None,
+    }
+}
+
+fn record_positions(step_context: &StepContext, batch_id: &str, calls: &[(String, usize, usize)]) {
+    let facts = step_context
+        .turn
+        .extension_data
+        .get_or_init(ToolCallFacts::default);
+    if let Ok(mut facts) = facts.0.lock() {
+        for (call_id, index, size) in calls {
+            facts.entry(call_id.clone()).or_default().batch = Some(ToolBatchPosition {
+                id: batch_id.to_owned(),
+                index: *index,
+                size: *size,
+            });
+        }
+    }
+}
+
+pub(crate) async fn dispatch(
+    session: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    calls: Vec<ToolCall>,
+    cancellation_token: CancellationToken,
+) -> Vec<InFlightFuture<'static>> {
+    let batch_id = format!(
+        "batch-{}",
+        calls.first().map_or("", |call| call.call_id.as_str())
+    );
+    let offered = calls
+        .iter()
+        .map(|call| ToolBatchCall {
+            call_id: call.call_id.clone(),
+            tool: call.tool_name.to_string(),
+            arguments: arguments(call).to_owned(),
+            parallel_safe: true,
+        })
+        .collect::<Vec<_>>();
+    let mut merges = Vec::new();
+    for contributor in session.services.extensions.tool_batch_contributors() {
+        if !contributor.batching(&session.services.thread_extension_data) {
+            continue;
+        }
+        merges = contributor
+            .merge_tool_batch(ToolBatchInput {
+                thread_store: &session.services.thread_extension_data,
+                turn_id: &step_context.turn.sub_id,
+                batch_id: &batch_id,
+                calls: &offered,
+            })
+            .await;
+        if !merges.is_empty() {
+            break;
+        }
+    }
+    let merges = valid(merges, &calls, &step_context.tool_router);
+    let size = calls.len();
+    record_positions(
+        step_context,
+        &batch_id,
+        &calls
+            .iter()
+            .enumerate()
+            .map(|(index, call)| (call.call_id.clone(), index, size))
+            .collect::<Vec<_>>(),
+    );
+    let mut shared = Vec::new();
+    for (ordinal, merge) in merges.iter().enumerate() {
+        let synthetic = ToolCall {
+            tool_name: ToolName::plain(merge.tool.as_str()),
+            call_id: format!("{batch_id}-merge-{ordinal}"),
+            payload: ToolPayload::Function {
+                arguments: merge.arguments.clone(),
+            },
+            encrypted_function_args: None,
+        };
+        record_positions(
+            step_context,
+            &batch_id,
+            &[(synthetic.call_id.clone(), ordinal, merges.len())],
+        );
+        let future = runtime
+            .clone()
+            .handle_tool_call(synthetic, cancellation_token.child_token());
+        let output = async move {
+            match future.await {
+                Ok(envelope) => merged_output(&envelope)
+                    .ok_or_else(|| "the batched call returned no text output".to_owned()),
+                Err(error) => Err(error.to_string()),
+            }
+        }
+        .boxed()
+        .shared();
+        shared.push((merge.call_ids.clone(), output));
+    }
+    calls
+        .into_iter()
+        .map(|call| {
+            match shared
+                .iter()
+                .find(|(ids, _)| ids.contains(&call.call_id))
+                .map(|(_, output)| output.clone())
+            {
+                Some(output) => {
+                    let call_id = call.call_id;
+                    Box::pin(async move {
+                        let merged = output.await;
+                        Ok(ResponseItemEnvelope::new(fan_out(&call_id, &merged).into()))
+                    }) as InFlightFuture<'static>
+                }
+                None => Box::pin(
+                    runtime
+                        .clone()
+                        .handle_tool_call(call, cancellation_token.child_token()),
+                ) as InFlightFuture<'static>,
+            }
+        })
+        .collect()
+}
