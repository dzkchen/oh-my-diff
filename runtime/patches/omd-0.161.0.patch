--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
@@ -0,0 +1,69 @@
+use super::*;
+
+pub(crate) struct ModListRequest {
+    pub(crate) view_id: &'static str,
+    pub(crate) title: String,
+    pub(crate) subtitle: Option<String>,
+}
+
+impl ModListRequest {
+    pub(crate) fn new(
+        view_id: &'static str,
+        title: &str,
+        subtitle: Option<String>,
+    ) -> Option<Self> {
+        crate::omd::terminal_active().then(|| Self {
+            view_id,
+            title: title.to_owned(),
+            subtitle,
+        })
+    }
+}
+
+impl ListSelectionView {
+    pub(super) fn mod_list_lines(
+        &self,
+        request: &ModListRequest,
+        width: u16,
+    ) -> Option<Vec<Line<'static>>> {
+        if self.is_searchable && !self.search_query.is_empty() {
+            return None;
+        }
+        let items = self
+            .active_items()
+            .iter()
+            .enumerate()
+            .map(|(order, item)| {
+                serde_json::json!({"label": item.name, "description": item.description,
+                    "current": item.is_current, "disabled": !Self::item_is_enabled(item), "order": order})
+            })
+            .collect::<Vec<_>>();
+        let target = crate::mod_render::RenderTarget::new(
+            "list",
+            request.view_id,
+            true,
+            serde_json::json!({"view_id": request.view_id, "title": request.title,
+                "subtitle": request.subtitle, "items": items, "selected": self.selected_actual_idx()}),
+        );
+        let rendered = crate::mod_render::resolve(&target, width)?;
+        let inner = crate::mod_render::native_width(&rendered.tree, width);
+        let native =
+            crate::mod_render::widget_lines(inner, self.native_height(inner), |area, cells| {
+                self.render_native(area, cells)
+            });
+        let selected = self.selected_actual_idx().map(|index| index.to_string());
+        let lines: Vec<Line<'static>> =
+            crate::mod_render::compose_lines(&rendered.tree, width, selected.as_deref(), native)
+                .into_iter()
+                .map(|line| line.line)
+                .collect();
+        self.rendered_item_count
+            .set(lines.len().min(self.filtered_indices.len()).max(1));
+        Some(lines)
+    }
+
+    pub(super) fn render_mod_list(&self, lines: Vec<Line<'static>>, area: Rect, buf: &mut Buffer) {
+        Self::clear_to_terminal_bg(buf, area);
+        Paragraph::new(lines).render(area, buf);
+    }
+}
diff --git a/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs b/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs
new file mode 100644
index 000000000..bd0ab3622
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/secret_prompt_view.rs
@@ -0,0 +1,177 @@
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+
+use super::CancellationEvent;
+use super::bottom_pane_view::BottomPaneView;
+use super::bottom_pane_view::ViewCompletion;
+use crate::render::renderable::Renderable;
+
+const SECRET_CHARS: usize = 512;
+
+pub(crate) type SecretSubmitted = Box<dyn FnOnce(Option<String>) + Send + Sync>;
+
+pub(crate) struct SecretPromptView {
+    title: String,
+    note: String,
+    value: String,
+    masked: bool,
+    completion: Option<ViewCompletion>,
+    on_done: Option<SecretSubmitted>,
+}
+
+impl SecretPromptView {
+    pub(crate) fn new(title: String, note: String, on_done: SecretSubmitted) -> Self {
+        Self {
+            title,
+            note,
+            value: String::new(),
+            masked: true,
+            completion: None,
+            on_done: Some(on_done),
+        }
+    }
+
+    pub(crate) fn plain(mut self) -> Self {
+        self.masked = false;
+        self
+    }
+
+    fn finish(&mut self, value: Option<String>) {
+        self.completion = Some(if value.is_some() {
+            ViewCompletion::Accepted
+        } else {
+            ViewCompletion::Cancelled
+        });
+        if let Some(on_done) = self.on_done.take() {
+            on_done(value);
+        }
+    }
+
+    fn push(&mut self, text: &str) {
+        for character in text.chars().filter(|c| !c.is_control()) {
+            if self.value.chars().count() >= SECRET_CHARS {
+                break;
+            }
+            self.value.push(character);
+        }
+    }
+}
+
+impl Drop for SecretPromptView {
+    fn drop(&mut self) {
+        if let Some(on_done) = self.on_done.take() {
+            on_done(None);
+        }
+    }
+}
+
+impl BottomPaneView for SecretPromptView {
+    fn handle_key_event(&mut self, key_event: KeyEvent) {
+        if key_event.kind == KeyEventKind::Release {
+            return;
+        }
+        match (key_event.code, key_event.modifiers) {
+            (KeyCode::Enter, _) => {
+                let value = std::mem::take(&mut self.value);
+                let value = value.trim().to_owned();
+                self.finish((!value.is_empty()).then_some(value));
+            }
+            (KeyCode::Esc, _) => self.finish(None),
+            (KeyCode::Backspace, _) => {
+                self.value.pop();
+            }
+            (KeyCode::Char(character), KeyModifiers::NONE | KeyModifiers::SHIFT) => {
+                self.push(&character.to_string());
+            }
+            _ => {}
+        }
+    }
+
+    fn is_complete(&self) -> bool {
+        self.completion.is_some()
+    }
+
+    fn completion(&self) -> Option<ViewCompletion> {
+        self.completion
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.finish(None);
+        CancellationEvent::Handled
+    }
+
+    fn prefer_esc_to_handle_key_event(&self) -> bool {
+        true
+    }
+
+    fn handle_paste(&mut self, pasted: String) -> bool {
+        self.push(pasted.trim());
+        true
+    }
+}
+
+impl Renderable for SecretPromptView {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let masked = if self.masked {
+            "•".repeat(self.value.chars().count().min(64))
+        } else {
+            self.value.clone()
+        };
+        Paragraph::new(vec![
+            Line::from(self.title.clone()).bold(),
+            Line::from(self.note.clone()).dim(),
+            Line::from(format!("› {masked}")),
+            Line::from("enter to save · esc to cancel").dim(),
+        ])
+        .render(area, buf);
+    }
+
+    fn desired_height(&self, _width: u16) -> u16 {
+        4
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+
+    #[test]
+    fn secrets_are_masked_trimmed_and_cancel_reports_none() {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let record = |seen: &Arc<Mutex<Vec<Option<String>>>>| {
+            let seen = seen.clone();
+            Box::new(move |value| seen.lock().unwrap().push(value)) as SecretSubmitted
+        };
+        let mut view = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        view.handle_paste(" sk-test ".into());
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 40, 4));
+        view.render(Rect::new(0, 0, 40, 4), &mut buffer);
+        let screen = (0..40)
+            .map(|x| buffer[(x, 2)].symbol().to_owned())
+            .collect::<String>();
+        assert!(!screen.contains("sk-test"));
+        view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        assert!(view.is_complete());
+        let mut cancelled = SecretPromptView::new("Key".into(), "note".into(), record(&seen));
+        cancelled.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        drop(SecretPromptView::new(
+            "Key".into(),
+            "note".into(),
+            record(&seen),
+        ));
+        assert_eq!(
+            *seen.lock().unwrap(),
+            vec![Some("sk-test".to_owned()), None, None]
+        );
+    }
+}
diff --git a/codex-rs/tui/src/chatwidget/mod_commands.rs b/codex-rs/tui/src/chatwidget/mod_commands.rs
