+    assert_eq!(log[1]["kind"], "skill");
+    assert_eq!(log[1]["reason"], "explicit");
+    assert_eq!(log[2]["content"], json!({"token": "[redacted]"}));
+    assert_eq!(log[2]["by"], Value::Null);
+    assert_eq!(
