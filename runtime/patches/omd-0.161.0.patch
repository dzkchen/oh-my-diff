diff --git a/codex-rs/omd/src/consents.rs b/codex-rs/omd/src/consents.rs
new file mode 100644
index 000000000..ae02ea56f
--- /dev/null
+++ b/codex-rs/omd/src/consents.rs
@@ -0,0 +1,176 @@
+//! Single-use user consents for prompts a mod captured, kept per thread outside mod state.
+
+use crate::resource_data::ResourceRef;
+use crate::resource_data::hash;
+use serde::Deserialize;
+use serde::Serialize;
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+
+const OWNER_LIMIT: usize = 64;
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq)]
+pub struct Consent {
+    pub id: String,
+    pub owner: String,
+    pub sha256: String,
+    /// Set when the consent was spent on a submission.
+    pub client_id: Option<String>,
+    /// Set when the submitted message was committed to the thread.
+    pub turn_id: Option<String>,
+}
+
+pub fn digest(text: &str, attachments: &[ResourceRef]) -> String {
+    hash(&serde_json::to_vec(&(text, attachments)).unwrap_or_default())
+}
+
+fn token(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+}
+
+/// Runs `change` on the thread's consents under an exclusive file lock.
+fn with<T>(
+    root: &Path,
+    thread: &str,
+    change: impl FnOnce(&mut Vec<Consent>) -> io::Result<T>,
+) -> io::Result<T> {
+    if !token(thread) {
+        return Err(io::Error::other("consent_thread_invalid"));
+    }
+    let directory = root.join("consents");
+    fs::create_dir_all(&directory)?;
+    let file = fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .mode(0o600)
+        .open(directory.join(format!("{thread}.lock")))?;
+    file.lock()?;
+    let path = directory.join(format!("{thread}.json"));
+    let mut consents = read(&path)?;
+    let before = consents.clone();
+    let result = change(&mut consents)?;
+    if consents != before {
+        let bytes = serde_json::to_vec(&consents)?;
+        let mut temporary = tempfile::NamedTempFile::new_in(&directory)?;
+        temporary.write_all(&bytes)?;
+        temporary.as_file().sync_all()?;
+        temporary.persist(path).map_err(|error| error.error)?;
+        fs::File::open(directory)?.sync_all()?;
+    }
+    Ok(result)
+}
+
+fn read(path: &Path) -> io::Result<Vec<Consent>> {
+    match fs::read(path) {
+        Ok(bytes) => serde_json::from_slice(&bytes).map_err(io::Error::other),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(Vec::new()),
+        Err(error) => Err(error),
+    }
+}
+
+pub fn grant(root: &Path, thread: &str, owner: &str, sha256: &str, id: &str) -> io::Result<()> {
+    with(root, thread, |consents| {
+        if consents
+            .iter()
+            .filter(|consent| consent.owner == owner && consent.client_id.is_none())
+            .count()
+            >= OWNER_LIMIT
+        {
+            return Err(io::Error::other("consent_limit"));
+        }
+        consents.push(Consent {
+            id: id.to_owned(),
+            owner: owner.to_owned(),
+            sha256: sha256.to_owned(),
+            ..Consent::default()
+        });
+        Ok(())
+    })
+}
+
+/// Spends a pending consent on exactly this content and client message id.
+pub fn consume(
+    root: &Path,
+    thread: &str,
+    owner: &str,
+    id: &str,
+    sha256: &str,
+    client_id: &str,
+) -> io::Result<()> {
+    with(root, thread, |consents| {
+        let consent = consents
+            .iter_mut()
+            .find(|consent| consent.id == id && consent.owner == owner)
+            .ok_or_else(|| io::Error::other("consent_missing"))?;
+        if consent.client_id.is_some() {
+            return Err(io::Error::other("consent_spent"));
+        }
+        if consent.sha256 != sha256 {
+            return Err(io::Error::other("consent_content_changed"));
+        }
+        consent.client_id = Some(client_id.to_owned());
+        Ok(())
+    })
+}
+
+/// Returns a consent to pending after the host established nothing was submitted.
+pub fn restore(root: &Path, thread: &str, id: &str) -> io::Result<()> {
+    with(root, thread, |consents| {
+        if let Some(consent) = consents.iter_mut().find(|consent| consent.id == id) {
+            consent.client_id = None;
+        }
+        Ok(())
+    })
+}
+
+/// Marks the consent spent on `client_id` as delivered once its message is committed.
+pub fn delivered(root: &Path, thread: &str, client_id: &str, turn_id: &str) -> io::Result<()> {
+    if !token(thread)
+        || !root
+            .join("consents")
+            .join(format!("{thread}.json"))
+            .exists()
+    {
+        return Ok(());
+    }
+    with(root, thread, |consents| {
+        if let Some(consent) = consents
+            .iter_mut()
+            .find(|consent| consent.client_id.as_deref() == Some(client_id))
+        {
+            consent.turn_id = Some(turn_id.to_owned());
+        }
+        Ok(())
+    })
+}
+
+pub fn status(root: &Path, thread: &str, owner: &str, id: &str) -> io::Result<Option<Consent>> {
+    if !token(thread) {
+        return Err(io::Error::other("consent_thread_invalid"));
+    }
+    Ok(read(&root.join("consents").join(format!("{thread}.json")))?
+        .into_iter()
+        .find(|consent| consent.id == id && consent.owner == owner))
+}
+
+/// Keeps only the consents `keep` accepts and returns how many were dropped.
+pub fn retain(root: &Path, thread: &str, keep: impl Fn(&Consent) -> bool) -> io::Result<usize> {
+    with(root, thread, |consents| {
+        let before = consents.len();
+        consents.retain(|consent| keep(consent));
+        Ok(before - consents.len())
+    })
+}
+
+#[cfg(test)]
+#[path = "consents_tests.rs"]
+mod tests;
diff --git a/codex-rs/omd/src/consents_tests.rs b/codex-rs/omd/src/consents_tests.rs
new file mode 100644
index 000000000..02aa4565d
--- /dev/null
+++ b/codex-rs/omd/src/consents_tests.rs
@@ -0,0 +1,157 @@
+use super::*;
+
+#[test]
+fn status_does_not_create_or_rewrite_consent_documents() {
+    let root = tempfile::tempdir().unwrap();
+    assert!(
+        status(root.path(), "empty", "owner", "id")
+            .unwrap()
+            .is_none()
+    );
+    assert!(!root.path().join("consents/empty.json").exists());
+    grant(root.path(), "t1", "owner", "digest", "id").unwrap();
+    let path = root.path().join("consents/t1.json");
+    let original = format!("{}\n", fs::read_to_string(&path).unwrap());
+    fs::write(&path, &original).unwrap();
+    assert!(status(root.path(), "t1", "owner", "id").unwrap().is_some());
+    assert_eq!(fs::read_to_string(&path).unwrap(), original);
+}
+
+#[test]
+fn failed_replacement_preserves_the_previous_consent_document() {
+    use std::os::unix::fs::PermissionsExt;
+    let root = tempfile::tempdir().unwrap();
+    grant(root.path(), "thread", "owner", "digest", "id").unwrap();
+    let directory = root.path().join("consents");
+    let path = directory.join("thread.json");
+    let original = fs::read(&path).unwrap();
+    let result = with(root.path(), "thread", |consents| {
+        consents.clear();
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o500))
+    });
+    fs::set_permissions(&directory, fs::Permissions::from_mode(0o700)).unwrap();
+    assert!(result.is_err());
+    assert_eq!(fs::read(path).unwrap(), original);
+    assert!(
+        status(root.path(), "thread", "owner", "id")
+            .unwrap()
+            .is_some()
+    );
+}
+
+#[test]
+fn concurrent_status_reads_observe_complete_atomic_documents() {
+    let root = tempfile::tempdir().unwrap();
+    std::thread::scope(|scope| {
+        let writers: Vec<_> = (0..2)
+            .map(|writer| {
+                let root = root.path();
+                scope.spawn(move || {
+                    for number in 0..20 {
+                        grant(
+                            root,
+                            "thread",
+                            &format!("owner{writer}"),
+                            "digest",
+                            &format!("{writer}-{number}"),
+                        )
+                        .unwrap();
+                    }
+                })
+            })
+            .collect();
+        while writers.iter().any(|writer| !writer.is_finished()) {
+            status(root.path(), "thread", "owner0", "0-0").unwrap();
+        }
+        for writer in writers {
+            writer.join().unwrap();
+        }
+    });
+    assert_eq!(
+        read(&root.path().join("consents/thread.json"))
+            .unwrap()
+            .len(),
+        40
+    );
+}
+
+#[test]
+fn consent_status_preserves_the_recovery_document() {
+    use std::os::unix::fs::MetadataExt;
+    let root = tempfile::tempdir().unwrap();
+    grant(root.path(), "thread", "owner", "hash", "id").unwrap();
+    let path = root.path().join("consents/thread.json");
+    let bytes = fs::read(&path).unwrap();
+    let before = fs::metadata(&path).unwrap();
+    status(root.path(), "thread", "owner", "id").unwrap();
+    let after = fs::metadata(&path).unwrap();
+    assert_eq!(fs::read(&path).unwrap(), bytes);
+    assert_eq!(
+        (before.ino(), before.mtime_nsec()),
+        (after.ino(), after.mtime_nsec())
+    );
+    consume(root.path(), "thread", "owner", "id", "hash", "client").unwrap();
+    assert_ne!(fs::metadata(&path).unwrap().ino(), before.ino());
+    assert_eq!(
+        serde_json::from_slice::<Vec<Consent>>(&bytes).unwrap()[0].client_id,
+        None
+    );
+}
+
+#[test]
+fn consents_are_single_use_content_bound_and_reconciled_by_client_id() {
+    let root = tempfile::tempdir().unwrap();
+    let root = root.path();
+    let sha = digest("ship it", &[]);
+    grant(root, "t1", "queue", &sha, "c1").unwrap();
+    let spend = |sha: &str, client: &str| consume(root, "t1", "queue", "c1", sha, client);
+    assert_eq!(
+        spend(&digest("ship it now", &[]), "m1")
+            .unwrap_err()
+            .to_string(),
+        "consent_content_changed"
+    );
+    assert!(
+        consume(root, "t1", "other", "c1", &sha, "m1").is_err(),
+        "consents bind their owner"
+    );
+    spend(&sha, "m1").unwrap();
+    assert_eq!(spend(&sha, "m2").unwrap_err().to_string(), "consent_spent");
+    assert_eq!(
+        status(root, "t2", "queue", "c1").unwrap(),
+        None,
+        "consents stay on their thread"
+    );
+    delivered(root, "t1", "m1", "turn-9").unwrap();
+    let consent = status(root, "t1", "queue", "c1").unwrap().unwrap();
+    assert_eq!(
+        (consent.client_id.as_deref(), consent.turn_id.as_deref()),
+        (Some("m1"), Some("turn-9"))
+    );
+    grant(root, "t1", "queue", &sha, "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m3").unwrap();
+    restore(root, "t1", "c2").unwrap();
+    consume(root, "t1", "queue", "c2", &sha, "m4").unwrap();
+    assert_eq!(retain(root, "t1", |consent| consent.id != "c1").unwrap(), 1);
+    assert_eq!(
+        retain(root, "t1", |consent| consent.owner != "queue").unwrap(),
+        1
+    );
+    assert!(grant(root, "../escape", "queue", &sha, "c3").is_err());
+}
+
+#[test]
+fn reads_and_unmatched_deliveries_leave_the_file_untouched() {
+    let root = tempfile::tempdir().unwrap();
+    let root = root.path();
+    grant(root, "t1", "queue", &digest("ship it", &[]), "c1").unwrap();
+    let path = root.join("consents").join("t1.json");
+    let modified = || fs::metadata(&path).unwrap().modified().unwrap();
+    let before = modified();
+    std::thread::sleep(std::time::Duration::from_millis(20));
+    status(root, "t1", "queue", "c1").unwrap();
+    delivered(root, "t1", "no-such-message", "turn-1").unwrap();
+    assert_eq!(modified(), before);
+    grant(root, "t1", "queue", &digest("again", &[]), "c2").unwrap();
+    assert_ne!(modified(), before, "a real change is still written");
+}
