+    pub fn invoke(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+    ) -> Result<Value> {
+        self.invoke_guarded(id, generation, event, name, payload, || true)
+    }
+
+    pub fn invoke_guarded(
+        &mut self,
+        id: &str,
+        generation: u64,
+        event: &str,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+    ) -> Result<Value> {
+        self.invoke_with(id, generation, event, name, payload, active, |_| {
+            Err(failure(
+                "host_operation_unavailable: requires a native task",
+            ))
+        })
+    }
