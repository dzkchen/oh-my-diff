+            "Oh My Diff · 1 mod on · contract reviewed@1 (separately_reviewed)"
+        );
+        assert!(terminal_active());
+        assert_eq!(mod_paths().unwrap().store, Some(store));
+    }
+
+    #[test]
+    #[serial]
+    fn explicit_direct_mode_is_visible_and_disables_omd_presentation_hooks() {
+        let _mode = EnvGuard::set(MODE_ENV, Some("upstream_direct"));
+        let _locale = EnvGuard::set("LC_ALL", Some("en_CA.UTF-8"));
+
+        assert!(!is_active());
+        assert!(!ligatures_enabled());
+        assert!(!mouse_enabled());
+        assert_eq!(visual_input("=== -> <=").as_ref(), "=== -> <=");
+        assert_eq!(
+            compact_status(),
+            "Oh My Diff · upstream-style direct · hooks off"
+        );
+    }
+
+    #[test]
+    #[serial]
+    fn builtin_controls_hide_commands_and_disable_modes_but_never_recovery() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        std::fs::write(
+            store.join(codex_omd::BUILTINS_SNAPSHOT),
+            serde_json::json!({"schema":1,"hidden_commands":{"plan":["fixture"]},
+                "disabled_modes":{"plan":["fixture"]},
+                "replaced_commands":{"review":["fixture","review"]}})
+            .to_string(),
+        )
+        .unwrap();
+        let _omd = omd_environment(&store);
+        assert!(command_hidden("plan"));
+        assert!(!command_hidden("omd"));
+        assert!(!command_hidden("model"));
+        assert!(mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+        assert!(!mode_disabled(
+            codex_protocol::config_types::ModeKind::Default
+        ));
+        assert!(command_replacement("review").is_some());
+        {
+            let _home = EnvGuard::set("HOME", store.to_str());
+            assert!(!command_hidden("plan"));
+            assert!(!mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+            assert!(command_replacement("review").is_none());
+        }
+        assert!(command_hidden("plan"));
+        let _direct = EnvGuard::set(MODE_ENV, Some("upstream_direct"));
+        assert!(!command_hidden("plan"));
+        assert!(!mode_disabled(codex_protocol::config_types::ModeKind::Plan));
+    }
+
+    #[test]
+    #[serial]
+    fn mods_stay_off_in_the_home_directory_with_a_notice() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _omd = omd_environment(&store);
+        assert!(mod_paths().is_some());
+        let _home = EnvGuard::set("HOME", store.to_str());
+        assert!(mod_paths().is_none());
+        assert!(!terminal_active());
+        assert!(mod_status().is_some());
+        assert_eq!(
+            compact_status(),
+            "Oh My Diff · mods off in this directory · see /omd"
+        );
+    }
+
+    #[test]
+    #[serial]
+    fn removed_modes_disable_presentation_and_report_the_replacement() {
+        let root = TempDir::new().unwrap();
+        let store = store_fixture(&root);
+        let _store = EnvGuard::set(codex_omd::MOD_STORE_ENV, store.to_str());
+        for removed in ["platform", "enabled"] {
+            let _mode = EnvGuard::set(MODE_ENV, Some(removed));
+            assert!(!is_active());
+            assert!(!terminal_active());
+            assert!(mod_paths().is_none());
+            assert!(compact_status().contains("OMD_MODE=omd"));
+        }
+    }
+}
