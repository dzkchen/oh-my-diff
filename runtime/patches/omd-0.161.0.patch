+const ROUTE_HEADER: &str = "x-omd-route";
+const REQUEST_HEADER: &str = "x-omd-request-id";
+const SYNTHETIC_HEADER: &str = "x-omd-synthetic";
+const SUMMARY_TEXT_BYTES: usize = 4096;
+const COLLECTED_TEXT_BYTES: usize = 32_768;
