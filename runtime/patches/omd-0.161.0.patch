+        .await;
+    }
+    for id in ["64", "00"] {
+        mods.on_elicitation_result(codex_extension_api::ElicitationResultInput {
+            server: "bulk",
+            request_id: id,
+            action: "accept",
+            content: Some(&json!({"token": "hunter2"})),
