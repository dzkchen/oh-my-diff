+type ContractInputs = (
+    Vec<(codex_omd::ContractDocument, codex_omd::PolicyOwner)>,
+    std::path::PathBuf,
+    std::path::PathBuf,
+    String,
+);
+
+fn contract_inputs(arguments: &Value) -> Result<ContractInputs, String> {
+    let key = arguments["contract"]
+        .as_str()
+        .filter(|key| !key.is_empty() && key.len() <= 128)
+        .ok_or("contract_key_required")?
+        .to_owned();
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = paths.store.ok_or("mod store is not configured")?;
+    let documents = crate::mod_runtime::contract_documents().ok_or("mod runtime unavailable")?;
+    Ok((documents, store, paths.repository, key))
+}
