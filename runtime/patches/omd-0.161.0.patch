+                mod_id: mod_id.into(),
+                generation,
+                // A provider becomes routable only after its readiness handshake succeeds.
+                route: None,
+                job: Some(job),
+                task: lead.session.task.clone(),
+                worker: worker.clone(),
+                _gateway: gateway,
+                _snapshot: snapshot,
