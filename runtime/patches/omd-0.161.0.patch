+use super::*;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseEventKind;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+
+#[test]
+#[serial_test::serial]
+#[allow(clippy::disallowed_methods)]
+fn placeholder_rows_encode_the_image_id_row_and_column_in_every_cell() {
+    let rows = placeholder_rows(0x4f_4d_07, 3, 2, " ");
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 6, 2));
+    Paragraph::new(rows).render(buffer.area, &mut buffer);
+    assert_eq!(buffer[(1, 0)].symbol(), "\u{10EEEE}\u{0305}\u{0305}");
+    assert_eq!(buffer[(2, 0)].symbol(), "\u{10EEEE}\u{0305}\u{030D}");
+    assert_eq!(buffer[(3, 0)].symbol(), "\u{10EEEE}\u{0305}\u{030E}");
+    assert_eq!(buffer[(4, 0)].symbol(), " ", "three cells wide");
+    assert_eq!(buffer[(1, 1)].symbol(), "\u{10EEEE}\u{030D}\u{0305}");
+    assert_eq!(buffer[(1, 0)].fg, Color::Rgb(0x4f, 0x4d, 0x07));
+}
+
+#[test]
+#[serial_test::serial]
+fn kitty_images_transmit_once_replace_per_component_and_tear_down() {
+    let png = || Some((vec![1, 2, 3], 4, 2));
+    let (id, columns, rows) = kitty_image("thumb", "a", png).expect("placed");
+    assert_eq!((columns, rows), (4, 2));
+    assert_eq!(kitty_image("thumb", "a", || None), Some((id, 4, 2)));
+    let pending = std::mem::take(&mut images().pending);
+    assert_eq!(pending.len(), 1);
+    assert!(pending[0].starts_with(&format!("\x1b_Ga=T,U=1,t=d,f=100,i={id},c=4,r=2,q=2,m=0;")));
+    let (next, _, _) = kitty_image("thumb", "b", png).expect("replaced");
+    assert_ne!(next, id);
+    let pending = std::mem::take(&mut images().pending);
+    assert_eq!(pending[0], crate::mod_backdrop::kitty_remove(id));
+    retain(&BTreeSet::new());
+    assert_eq!(
+        std::mem::take(&mut images().pending),
+        vec![crate::mod_backdrop::kitty_remove(next)]
+    );
+    kitty_image("other", "c", png).expect("placed");
+    let removed = images().placed["other"].1;
+    teardown();
+    assert!(images().placed.is_empty() && images().pending.is_empty());
+    assert_eq!(
+        kitty_image("other", "c", png).map(|(id, _, _)| id == removed),
+        Some(false)
+    );
+    retain(&BTreeSet::new());
+    images().pending.clear();
+}
+
+#[test]
+#[serial_test::serial]
+fn pixel_reports_convert_to_cells_with_the_half_row() {
+    *FACTS.lock().unwrap() = Some(Facts {
+        pixel_pointer: true,
+        cell: Some((10, 20)),
+        ..Facts::default()
+    });
+    assert!(enable_pixel_pointer());
+    let event = |column, row| MouseEvent {
+        kind: MouseEventKind::Moved,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    };
+    let converted = to_cells(event(35, 49)).expect("first motion");
+    assert_eq!(
+        (converted.column, converted.row, last_half()),
+        (3, 2, Some(0))
+    );
+    assert_eq!(to_cells(event(38, 41)), None, "same half cell");
+    let converted = to_cells(event(35, 51)).expect("next half row");
+    assert_eq!(
+        (converted.column, converted.row, last_half()),
+        (3, 2, Some(1))
+    );
+    let press = MouseEvent {
+        kind: MouseEventKind::Down(crossterm::event::MouseButton::Left),
+        ..event(35, 51)
+    };
+    assert!(to_cells(press).is_some(), "presses always pass");
+    assert!(to_cells(event(35, 51)).is_some());
+    assert!(disable_pixel_pointer());
+    assert_eq!(to_cells(event(35, 51)).map(|event| event.column), Some(35));
+    assert_eq!(last_half(), None);
+    let value = facts().value();
+    assert_eq!(value["pointer"], "none");
+    assert_eq!(value["cell_px"], json!({"width": 10, "height": 20}));
+    *FACTS.lock().unwrap() = None;
+}
+
+#[test]
+fn only_reported_facts_and_pixel_mode_changes_re_render() {
+    let facts = Facts {
+        pointer: true,
+        cell: Some((10, 20)),
+        ..Facts::default()
+    };
+    let resized = Facts {
+        size: (120, 40),
+        ..facts
+    };
+    assert!(!reports_differ((facts, false), (facts, false)));
+    assert!(reports_differ((facts, false), (resized, false)));
+    assert_eq!(
+        (
+            resized.value()["columns"].clone(),
+            resized.value()["rows"].clone()
+        ),
+        (json!(120), json!(40))
+    );
+    assert!(reports_differ((facts, false), (facts, true)));
+    assert!(reports_differ(
+        (facts, false),
+        (
+            Facts {
+                pointer: false,
+                ..resized
+            },
+            false
+        )
+    ));
+    assert!(reports_differ(
+        (facts, true),
+        (
+            Facts {
+                cell: Some((8, 16)),
+                ..facts
+            },
+            true
+        )
+    ));
+}
+
+#[test]
+fn a_failed_or_pixel_less_measurement_keeps_the_last_cell_size() {
+    let window = |width, height| crossterm::terminal::WindowSize {
+        rows: 10,
+        columns: 20,
+        width,
+        height,
+    };
+    let mut facts = Facts::default();
+    facts.apply(Some(window(200, 200)));
+    assert_eq!(facts.cell, Some((10, 20)));
+    facts.apply(None);
+    facts.apply(Some(window(0, 0)));
+    assert_eq!(facts.cell, Some((10, 20)));
+    facts.apply(Some(window(400, 300)));
+    assert_eq!(facts.cell, Some((20, 30)));
+}
