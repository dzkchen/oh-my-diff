+fn read_index(path: &Path) -> Result<PackageIndex> {
+    let index: PackageIndex = serde_json::from_slice(&store::read(path, 524_288)?)?;
+    if index.schema != 1 {
+        return Err(failure("unsupported_package_index_schema"));
+    }
+    Ok(index)
