+            .call("workspace.transaction", edit, || true)
+            .unwrap();
+        assert_eq!(result["files"]["a.py"], crate::execution::hash(b"new\n"));
+        assert_eq!(std::fs::read_to_string(root.join("a.py")).unwrap(), "new\n");
