+pub(super) fn package_read(root: &Path, relative: &str, limit: u64) -> Result<Vec<u8>> {
+    let path = root.join(relative);
+    if !path
+        .parent()
+        .ok_or_else(|| failure("package_path_escape"))?
+        .canonicalize()?
+        .starts_with(root)
+    {
+        return Err(failure(format!("package_path_escape: {relative}")));
+    }
+    read(&path, limit)
+}
