+}
+
+pub(crate) fn component_lines(
+    components: &[ModComponent],
+    width: u16,
+    list_selected: Option<&str>,
+) -> Vec<Line<'static>> {
+    let mut interaction = Interaction::default();
+    fn select(components: &[ModComponent], value: Option<&str>, interaction: &mut Interaction) {
+        for component in components {
+            match component {
+                ModComponent::List { id, rows, .. } => {
+                    if let Some(index) =
+                        value.and_then(|value| rows.iter().position(|row| row.value == value))
+                    {
+                        interaction.selected.insert(id.clone(), index);
+                    }
+                }
+                ModComponent::Box { children, .. }
+                | ModComponent::Pane { children, .. }
+                | ModComponent::Dialog { children, .. } => select(children, value, interaction),
+                _ => {}
+            }
+        }
+    }
+    select(components, list_selected, &mut interaction);
+    component_rows(components, width, &mut interaction, 0)
+        .into_iter()
+        .map(|row| row.line)
+        .collect()
+}
+
+fn push_region_rows(
+    rows: &mut Vec<ComponentRow>,
+    id: &str,
+    label: &str,
+    lines: Vec<Line<'static>>,
+    pointer: bool,
+    indent: usize,
+) {
+    let indent = u16::try_from(indent).unwrap_or(u16::MAX);
+    rows.extend(
+        lines
+            .into_iter()
+            .enumerate()
+            .map(|(row, line)| ComponentRow {
+                id: Some(id.to_owned()),
+                label: Some(label.to_owned()),
+                links: Vec::new(),
+                line,
+                target: None,
+                regions: if pointer {
+                    vec![(
+                        id.to_owned(),
+                        indent,
+                        u16::try_from(row).unwrap_or(u16::MAX),
+                        true,
+                    )]
+                } else {
+                    Vec::new()
+                },
+                indent,
+            }),
+    );
+}
+
+fn component_rows(
+    components: &[ModComponent],
+    width: u16,
+    interaction: &mut Interaction,
+    indent: usize,
+) -> Vec<ComponentRow> {
+    let mut rows = Vec::new();
+    let prefix = " ".repeat(indent);
+    for component in components {
+        match component {
+            ModComponent::Box { .. } if !component.fits(width) => {}
+            ModComponent::Box {
+                id,
+                title,
+                children,
+                pointer,
+                ..
+            } => {
+                let start = rows.len();
+                if let Some(title) = title {
+                    rows.push(ComponentRow {
+                        id: None,
+                        label: None,
+                        links: Vec::new(),
+                        line: Line::from(format!("{prefix}{title}")).bold(),
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+                rows.extend(component_rows(children, width, interaction, indent + 1));
+                for (offset, row) in rows[start..].iter_mut().enumerate() {
+                    let offset = u16::try_from(offset).unwrap_or(u16::MAX);
+                    row.regions
+                        .insert(0, (id.clone(), cells(indent), offset, *pointer));
+                }
+            }
+            ModComponent::Text {
+                id,
+                label,
+                text,
+                tone,
+            } => {
+                for (index, text) in text.lines().enumerate() {
+                    rows.push(ComponentRow {
+                        id: (index == 0).then(|| id.clone()),
+                        label: (index == 0).then(|| label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(format!("{prefix}{text}")).patch_style(tone_style(*tone)),
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Line { id, label, spans } => {
+                let (line, links) = span_line(prefix.clone(), spans);
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links,
+                    line,
+                    target: None,
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+            }
+            ModComponent::Button {
+                id,
+                label,
+                text,
+                action,
+                ..
+            } => rows.push(ComponentRow {
+                id: Some(id.clone()),
+                label: Some(label.clone()),
+                links: Vec::new(),
+                line: Line::from(format!("{prefix}[ {text} ]")),
+                target: Some(ComponentTarget::Button(action.clone())),
+                regions: Vec::new(),
+                indent: cells(indent),
+            }),
+            ModComponent::Input {
+                id,
+                label,
+                value,
+                placeholder,
+                action,
+                ..
+            } => {
+                let current = interaction
+                    .input_values
+                    .entry(id.clone())
+                    .or_insert_with(|| value.clone())
+                    .clone();
+                let shown = if interaction.focused.as_ref() == Some(id) {
+                    let cursor = interaction.input_cursor.get(id).copied();
+                    let at = cursor
+                        .and_then(|cursor| current.char_indices().nth(cursor))
+                        .map_or(current.len(), |(byte, _)| byte);
+                    format!("{}▏{}", &current[..at], &current[at..])
+                } else if current.is_empty() {
+                    placeholder.clone()
+                } else {
+                    current
+                };
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links: Vec::new(),
+                    line: Line::from(format!("{prefix}{label}: {shown}")),
+                    target: Some(ComponentTarget::Input(action.clone())),
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+            }
+            ModComponent::Select {
+                id,
+                label,
+                value,
+                options,
+                action,
+                ..
+            } => {
+                let fallback = options
+                    .iter()
+                    .position(|option| option.value == *value)
+                    .unwrap_or_default();
+                let selected = interaction.selected.entry(id.clone()).or_insert(fallback);
+                *selected = (*selected).min(options.len().saturating_sub(1));
+                let shown = options
+                    .get(*selected)
+                    .map(|option| option.label.as_str())
+                    .unwrap_or("—");
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links: Vec::new(),
+                    line: Line::from(format!("{prefix}{label}: ‹ {shown} ›")),
+                    target: Some(ComponentTarget::Select {
+                        action: action.clone(),
+                        options: options
+                            .iter()
+                            .map(|option| (option.value.clone(), option.label.clone()))
+                            .collect(),
+                    }),
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+            }
+            ModComponent::Multiselect {
+                id,
+                label,
+                value,
+                options,
+                action,
+                ..
+            } => {
+                let checked = interaction
+                    .checked
+                    .entry(id.clone())
+                    .or_insert_with(|| value.iter().cloned().collect())
+                    .clone();
+                let current = interaction.selected.entry(id.clone()).or_insert(0);
+                *current = (*current).min(options.len().saturating_sub(1));
+                let (current, focused) = (*current, interaction.focused.as_ref() == Some(id));
+                let values = options
+                    .iter()
+                    .map(|option| (option.value.clone(), option.label.clone()))
+                    .collect::<Vec<_>>();
+                rows.push(ComponentRow {
+                    id: None,
+                    label: None,
+                    links: Vec::new(),
+                    line: Line::from(format!("{prefix}{label}:")),
+                    target: None,
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+                for (index, option) in options.iter().enumerate() {
+                    let mark = if checked.contains(&option.value) {
+                        "[x]"
+                    } else {
+                        "[ ]"
+                    };
+                    let line = Line::from(format!("{prefix}  {mark} {}", option.label));
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: if focused && index == current {
+                            line.bold()
+                        } else {
+                            line
+                        },
+                        target: Some(ComponentTarget::Multiselect {
+                            action: action.clone(),
+                            options: values.clone(),
+                            index,
+                        }),
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Markdown { id, label, text } => {
+                let rendered = crate::markdown::render_markdown_agent_with_list_spacing(
+                    text,
+                    Some(usize::from(
+                        width.saturating_sub(u16::try_from(indent).unwrap_or(0)),
+                    )),
+                    None,
+                    None,
+                    crate::markdown_render::ListSpacing::AfterMultiline,
+                );
+                for (index, line) in rendered.into_iter().enumerate() {
+                    rows.push(ComponentRow {
+                        id: (index == 0).then(|| id.clone()),
+                        label: (index == 0).then(|| label.clone()),
+                        links: line.hyperlinks,
+                        line: line.line,
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Code {
+                id,
+                label,
+                text,
+                language,
+            } => {
+                if let Some(language) = language {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(format!("{prefix}{language}")).dim(),
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+                for line in text.lines() {
+                    rows.push(ComponentRow {
+                        id: None,
+                        label: None,
+                        links: Vec::new(),
+                        line: Line::from(format!("{prefix}{line}")).cyan(),
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Pane {
+                id,
+                label,
+                title,
+                collapsed,
+                scroll,
+                keys,
+                children,
+            } => {
+                if *keys {
+                    interaction.key_panes.insert(id.clone());
+                }
+                let collapsed = interaction
+                    .collapsed
+                    .entry(id.clone())
+                    .or_insert(*collapsed);
+                let marker = if *collapsed {
+                    if crate::omd::ligatures_enabled() {
+                        "▸"
+                    } else {
+                        ">"
+                    }
+                } else if crate::omd::ligatures_enabled() {
+                    "▾"
+                } else {
+                    "v"
+                };
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links: Vec::new(),
+                    line: Line::from(format!(
+                        "{prefix}{marker} {}",
+                        title.as_deref().unwrap_or(label)
+                    ))
+                    .bold(),
+                    target: Some(ComponentTarget::Pane),
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+                if !*collapsed {
+                    let nested = component_rows(children, width, interaction, indent + 1);
+                    let offset =
+                        usize::from(*interaction.scroll.entry(id.clone()).or_insert(*scroll))
+                            .min(nested.len().saturating_sub(1));
+                    rows.extend(nested.into_iter().skip(offset).take(8));
+                }
+            }
+            ModComponent::Dialog {
+                title, children, ..
+            } => {
+                rows.push(ComponentRow {
+                    id: None,
+                    label: None,
+                    links: Vec::new(),
+                    line: Line::from(format!("{prefix}{title}")).bold(),
+                    target: None,
+                    regions: Vec::new(),
+                    indent: cells(indent),
+                });
+                rows.extend(component_rows(children, width, interaction, indent));
+            }
+            ModComponent::List {
+                id,
+                label,
+                rows: items,
+                selected,
+                height,
+                action,
+                ..
+            } => {
+                if items.is_empty() {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(format!("{prefix}{label}: (empty)")).dim(),
+                        target: None,
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                    continue;
+                }
+                let options = items
+                    .iter()
+                    .map(|row| (row.value.clone(), row.label.clone()))
+                    .collect::<Vec<_>>();
+                let fallback = selected
+                    .as_ref()
+                    .and_then(|value| items.iter().position(|row| row.value == *value))
+                    .unwrap_or_default();
+                let current = interaction.selected.entry(id.clone()).or_insert(fallback);
+                *current = (*current).min(items.len() - 1);
+                let current = *current;
+                let window = usize::from(height.unwrap_or(8)).max(1);
+                let start = (current + 1)
+                    .saturating_sub(window)
+                    .min(items.len().saturating_sub(window));
+                let marker = if crate::omd::ligatures_enabled() {
+                    "› "
+                } else {
+                    "> "
+                };
+                for (index, item) in items.iter().enumerate().skip(start).take(window) {
+                    let chosen = index == current;
+                    let lead = format!("{prefix}{}", if chosen { marker } else { "  " });
+                    let (line, links) = if item.spans.is_empty() {
+                        (Line::from(format!("{lead}{}", item.label)), Vec::new())
+                    } else {
+                        span_line(lead, &item.spans)
+                    };
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links,
+                        line: if chosen { line.bold() } else { line },
+                        target: Some(ComponentTarget::ListRow {
+                            action: action.clone(),
+                            options: options.clone(),
+                            index,
+                        }),
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Document {
+                id,
+                label,
+                lines,
+                source,
+                anchors,
+                selected,
+                find,
+                height,
+                action,
+                keys,
+            } => {
+                let content = match source {
+                    Some(source) => crate::mod_components::Content::Source(source),
+                    None => crate::mod_components::Content::Spans(lines),
+                };
+                if *keys {
+                    interaction.key_panes.insert(id.clone());
+                }
+                let focused = interaction.focused.as_deref() == Some(id.as_str());
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                for line in crate::mod_components::rows(
+                    id,
+                    content,
+                    anchors,
+                    *selected,
+                    find.as_ref(),
+                    *height,
+                    &owners,
+                    focused,
+                    *keys,
+                    &prefix,
+                ) {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line,
+                        target: Some(ComponentTarget::Document(action.clone())),
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Diff {
+                id,
+                label,
+                unified,
+                selected,
+                height,
+                action,
+            } => {
+                let focused = interaction.focused.as_deref() == Some(id.as_str());
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                for line in crate::mod_components::rows(
+                    id,
+                    crate::mod_components::Content::Diff(unified),
+                    &[],
+                    *selected,
+                    None,
+                    *height,
+                    &owners,
+                    focused,
+                    false,
+                    &prefix,
+                ) {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line,
+                        target: Some(ComponentTarget::Document(action.clone())),
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Terminal {
+                id,
+                label,
+                session,
+                height,
+            } => {
+                let binding = interaction
+                    .component_owners
+                    .get(id)
+                    .and_then(|owner| interaction.pty_bindings.get(owner))
+                    .cloned();
+                for line in crate::mod_pty::rows(
+                    binding.as_ref(),
+                    session,
+                    width.saturating_sub(u16::try_from(prefix.len()).unwrap_or(u16::MAX)),
+                    height.unwrap_or(16),
+                    &prefix,
+                ) {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line,
+                        target: Some(ComponentTarget::Terminal(session.clone(), binding.clone())),
+                        regions: Vec::new(),
+                        indent: cells(indent),
+                    });
+                }
+            }
+            ModComponent::Image {
+                id,
+                label,
+                image,
+                alt,
+                height,
+                pointer,
+            } => {
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                let lines = crate::mod_components::image_rows(
+                    id,
+                    image,
+                    alt,
+                    width.saturating_sub(u16::try_from(prefix.len()).unwrap_or(u16::MAX)),
+                    height.unwrap_or(12),
+                    &owners,
+                    &prefix,
+                );
+                push_region_rows(&mut rows, id, label, lines, *pointer, indent);
+            }
+            ModComponent::Raster {
+                id,
+                label,
+                alt,
+                width: columns,
+                height: rows_high,
+                pointer,
+            } => {
+                let (lines, next) = crate::mod_raster::rows(
+                    id,
+                    interaction.component_owners.get(id).map(String::as_str),
+                    alt,
+                    width.saturating_sub(u16::try_from(prefix.len()).unwrap_or(u16::MAX)),
+                    (*columns, *rows_high),
+                    crate::mod_client::facts().no_color,
+                    &prefix,
+                    std::time::Instant::now(),
+                );
+                if let Some(next) = next {
+                    crate::mod_render::schedule_frame(next);
+                }
+                push_region_rows(&mut rows, id, label, lines, *pointer, indent);
+            }
+            ModComponent::Slot | ModComponent::Native { .. } => {}
+        }
+    }
+    rows
+}
+
+fn render_site(
+    area: Rect,
+    components: &[ModComponent],
+    style: Style,
+    buffer: &mut Buffer,
+    interaction: &mut Interaction,
+    block: Option<Block<'static>>,
+    comfortable_spacing: bool,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let inner = block
+        .as_ref()
+        .map(|block| block.inner(area))
+        .unwrap_or(area);
+    let rows = component_rows(components, inner.width.max(1), interaction, 0);
+    let rows = if comfortable_spacing
+        && with_cache(|cache| cache.snapshot.view.theme.density) == Some(ModDensity::Comfortable)
+    {
+        let mut spaced = Vec::new();
+        let mut rows = rows.into_iter().peekable();
+        while let Some(row) = rows.next() {
+            // Picture rows (images, rasters) of one component stay contiguous.
+            let picture = row.target.is_none()
+                && row.id.is_some()
+                && rows.peek().is_some_and(|next| next.id == row.id);
+            spaced.push(row);
+            if !picture {
+                spaced.push(ComponentRow {
+                    id: None,
+                    label: None,
+                    links: Vec::new(),
+                    line: Line::from(""),
+                    target: None,
+                    regions: Vec::new(),
+                    indent: 0,
+                });
+            }
+        }
+        spaced
+    } else {
+        rows
+    };
+    let focused_row = interaction.focused.as_ref().and_then(|focused| {
+        let cursor = interaction.selected.get(focused).copied();
+        let mut own = rows
+            .iter()
+            .enumerate()
+            .filter(|(_, row)| row.target.is_some() && row.id.as_ref() == Some(focused));
+        let first = own.next();
+        std::iter::once(first)
+            .flatten()
+            .chain(own)
+            .find(|(_, row)| match &row.target {
+                Some(
+                    ComponentTarget::Multiselect { index, .. }
+                    | ComponentTarget::ListRow { index, .. },
+                ) => Some(*index) == cursor,
+                _ => true,
+            })
+            .or(first)
+            .map(|(row, _)| row)
+    });
+    let scroll = focused_row.map_or(0, |row| (row + 1).saturating_sub(usize::from(inner.height)));
+    let lines = rows
+        .iter()
+        .skip(scroll)
+        .map(|row| row.line.clone())
+        .collect::<Vec<_>>();
+    let paragraph = Paragraph::new(lines).style(style);
+    match block {
+        Some(block) => paragraph.block(block).render(area, buffer),
+        None => paragraph.render(area, buffer),
+    }
+    mark_links(buffer, inner, &rows[scroll.min(rows.len())..]);
+    register_component_targets(inner, rows, scroll, interaction);
+}
+
+/// Every target joins the focus order; only rows scrolled into view get a hitbox.
+fn register_component_targets(
+    inner: Rect,
+    rows: Vec<ComponentRow>,
+    scroll: usize,
+    interaction: &mut Interaction,
+) {
+    for (index, row) in rows.into_iter().enumerate() {
+        let row_top = index
+            .checked_sub(scroll)
+            .and_then(|offset| u16::try_from(offset).ok())
+            .filter(|offset| *offset < inner.height)
+            .map(|offset| inner.y + offset);
+        let area = row_top.map(|y| Rect::new(inner.x, y, inner.width, 1));
+        let beside = |indent: u16, width: u16| {
+            let room = inner.width.saturating_sub(indent);
+            row_top.map(|y| Rect::new(inner.x + indent, y, width.clamp(1, room.max(1)), 1))
+        };
+        let own = beside(
+            row.indent,
+            u16::try_from(row.line.width())
+                .unwrap_or(u16::MAX)
+                .saturating_sub(row.indent),
+        );
+        for (id, indent, top, pointer) in row.regions {
+            let Some(area) = beside(indent, u16::MAX)
+                .map(|held| own.filter(|_| row.id.as_ref() == Some(&id)).unwrap_or(held))
+            else {
+                continue;
+            };
+            interaction
+                .anchors
+                .entry(id.clone())
+                .and_modify(|anchor| *anchor = anchor.union(area))
+                .or_insert(area);
+            if !pointer {
+                continue;
+            }
+            let layer = interaction.layer;
+            match interaction
+                .regions
+                .iter_mut()
+                .find(|region| region.id == id && region.layer == layer)
+            {
+                Some(region) => region.area = region.area.union(area),
+                None => interaction.regions.push(Region {
+                    id,
+                    area,
+                    top,
+                    layer,
+                }),
+            }
+        }
+        if let (Some(id), Some(area)) = (&row.id, own) {
+            interaction
+                .anchors
+                .entry(id.clone())
+                .and_modify(|anchor| *anchor = anchor.union(area))
+                .or_insert(area);
+        }
+        let Some(target) = row.target else {
+            continue;
+        };
+        let id = row.id.unwrap_or_default();
+        let label = row.label.unwrap_or_else(|| id.clone());
+        interaction.targets.insert(id.clone(), target.clone());
+        if !interaction.order.contains(&id) {
+            interaction.order.push(id.clone());
+        }
+        let Some(area) = area else {
+            continue;
+        };
+        interaction.hitboxes.push(HitBox {
+            id,
+            label,
+            area,
+            target,
+            layer: interaction.layer,
+        });
+    }
+}
