+#[test]
+#[serial_test::serial]
+fn terminal_bindings_refresh_when_scope_changes_without_a_view_revision() {
+    let _scope = crate::mod_pty::test_scope();
+    let owners = BTreeMap::from([
+        ("m".to_owned(), "source".to_owned()),
+        ("other".to_owned(), "other-source".to_owned()),
+    ]);
+    crate::mod_pty::context(1, Some("a".into()));
+    crate::mod_pty::retain(1, "admitted", &owners, &Default::default());
+    let mut snapshot = ModViewSnapshot {
+        epoch: 7,
+        revision: 9,
+        contributors: vec!["m".into()],
+        input: serde_json::json!({"ledger": {"thread_id": "a"}, "pty_scope": {
+            "epoch": 1, "admission": codex_omd::client_surface::admission(), "configuration": "admitted"
+        }}),
+        ..Default::default()
+    };
+    let mut interaction = Interaction::default();
+    bind_terminals(&mut interaction, &snapshot);
+    let original = interaction.pty_bindings["m"].clone();
+    assert!(crate::mod_pty::current(&original));
+    crate::mod_pty::context(2, Some("b".into()));
+    snapshot.input["ledger"]["thread_id"] = serde_json::json!("b");
+    snapshot.input["pty_scope"]["epoch"] = serde_json::json!(2);
+    bind_terminals(&mut interaction, &snapshot);
+    assert!(!crate::mod_pty::current(&original));
+    assert!(crate::mod_pty::current(&interaction.pty_bindings["m"]));
+    let previous = interaction.pty_bindings["m"].clone();
+    let stale = snapshot.clone();
+    crate::mod_pty::retain(2, "admitted", &owners, &Default::default());
+    snapshot.input["pty_scope"]["admission"] =
+        serde_json::json!(codex_omd::client_surface::admission());
+    bind_terminals(&mut interaction, &snapshot);
+    assert!(!crate::mod_pty::current(&previous));
+    assert!(crate::mod_pty::current(&interaction.pty_bindings["m"]));
+    snapshot.contributors = vec!["other".into()];
+    bind_terminals(&mut interaction, &snapshot);
+    assert!(!interaction.pty_bindings.contains_key("m"));
+    assert!(crate::mod_pty::current(&interaction.pty_bindings["other"]));
+    bind_terminals(&mut interaction, &stale);
+    assert!(interaction.pty_bindings.is_empty());
+}
