+pub(crate) fn status_segments() -> Vec<String> {
+    let mut segments = with_cache(|cache| cache.snapshot.view.status.clone()).unwrap_or_default();
+    segments.extend(
+        live_notices(NoticePlacement::Status)
+            .into_iter()
+            .map(|notice| notice.text.chars().take(40).collect()),
+    );
+    segments
+}
