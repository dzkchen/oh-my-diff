+#[test]
+fn one_suggestion_shows_at_the_end_and_resolves_explicitly() {
+    let (mut composer, _rx) = new_test_composer();
+    composer.insert_str("git sta");
+    let revision = composer.mod_draft_sync();
+    statuses(&mut composer);
+    assert_eq!(
+        composer.mod_suggest("a", "s", revision - 1, "s0".into(), "x".into()),
+        Err("stale_revision".to_owned())
+    );
+    composer
+        .mod_suggest("a", "s", revision, "s1".into(), "tus".into())
+        .unwrap();
+    composer
+        .mod_suggest("b", "s", revision, "s2".into(), "sh".into())
+        .unwrap();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "cleared".into())]
+    );
+    assert_eq!(composer.mod_suggestion_owner(), Some(("b", "s2")));
+
+    let mut terminal = Terminal::new(TestBackend::new(40, 6)).unwrap();
+    terminal
+        .draw(|frame| composer.render(frame.area(), frame.buffer_mut()))
+        .unwrap();
+    let screen = format!("{:?}", terminal.backend().buffer());
+    assert!(screen.contains("git stash"), "the ghost follows the draft");
+
+    composer.handle_key_event(KeyEvent::from(KeyCode::Left));
+    assert!(!composer.mod_suggestion_key(&KeyEvent::from(KeyCode::Right)));
+    composer.handle_key_event(KeyEvent::from(KeyCode::Right));
+    composer.handle_key_event(KeyEvent::from(KeyCode::Right));
+    assert_eq!(composer.current_text(), "git stash");
+    composer.mod_draft_sync();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("b".into()), "accepted".into()), (None, "b".into())]
+    );
+
+    let revision = composer.mod_draft_sync();
+    composer
+        .mod_suggest("a", "s", revision, "s3".into(), " pop".into())
+        .unwrap();
+    composer.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "dismissed".into())]
+    );
+    composer
+        .mod_suggest("a", "s", revision, "s4".into(), " pop".into())
+        .unwrap();
+    composer.insert_str("x");
+    composer.mod_draft_sync();
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(None, "user".into()), (Some("a".into()), "cleared".into())]
+    );
+    assert_eq!(composer.current_text(), "git stashx");
+
+    let revision = composer.mod_draft_sync();
+    composer
+        .mod_suggest("a", "s", revision, "s5".into(), "!".into())
+        .unwrap();
+    composer.mod_draft_revoke(|_, source| source == "s");
+    assert_eq!(composer.mod_suggestion_owner(), Some(("a", "s5")));
+    composer.mod_draft_revoke(|_, source| source == "s2");
+    assert_eq!(
+        statuses(&mut composer),
+        vec![(Some("a".into()), "cleared".into())]
+    );
+}
+
+#[test]
+fn mod_attachments_leave_with_their_owner() {
+    let (mut composer, _rx) = new_test_composer();
+    let path = PathBuf::from("/tmp/preview.png");
+    composer.attach_image(path.clone());
+    composer.mod_draft_owned(path.clone(), "preview", "sha-1");
+    composer.mod_draft_sync();
+    assert_eq!(
+        composer.mod_draft_owner(&path),
+        Some(("preview".into(), "sha-1".into()))
+    );
+    composer.mod_draft_revoke(|owner, source| owner == "preview" && source == "sha-1");
+    assert_eq!(
+        composer.local_images().len(),
+        1,
+        "a loaded owner keeps its image"
+    );
+    composer.mod_draft_revoke(|_, _| false);
+    assert!(
+        composer.local_images().is_empty(),
+        "a reloaded owner loses its image"
+    );
+    assert_eq!(composer.mod_draft_owner(&path), None);
+}
diff --git a/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
