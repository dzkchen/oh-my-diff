+
+pub(crate) fn command_host_guarded(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+    scope: &CallScope<'_>,
+) -> std::io::Result<Value> {
+    if !codex_omd::host::served(&call.operation) {
+        return Err(std::io::Error::other(format!(
+            "unsupported_host_operation: {}",
+            call.operation
+        )));
+    }
+    let grants = grants.ok_or_else(|| std::io::Error::other("host_caller_inactive"))?;
+    let mut protected = paths.protected.clone();
+    protected.push(codex_omd::workspace_lease::directory());
+    protected.push(paths.evidence.clone());
+    let data_root = paths
+        .store
+        .clone()
+        .ok_or_else(|| std::io::Error::other("mod store is not configured"))?;
+    let authority = CommandAuthority {
+        repository: &paths.repository,
+        protected: &protected,
+        policy,
+    };
+    codex_omd::host::Host {
+        authority: &authority,
+        data_root: &data_root,
+        active: scope.active.as_ref(),
+        record_changes: true,
+    }
+    .call(
+        &codex_omd::host::Caller {
+            id: caller,
+            source_sha256: &grants.source_sha256,
+            capabilities: &grants.capabilities,
+            exec_environment: &grants.exec_environment,
+            os_access: grants.os_access.as_ref(),
+            fs_access: grants.fs_access.as_ref(),
+            origin: match scope.context {
+                codex_omd::app_routes::InvocationContext::User => {
+                    codex_omd::data_store::Origin::UserCommand
+                }
+                codex_omd::app_routes::InvocationContext::Event => {
+                    codex_omd::data_store::Origin::Event
+                }
+            },
+            thread: scope.thread,
+        },
+        &call.operation,
+        call.arguments,
+    )
+    .map_err(std::io::Error::other)
+}
