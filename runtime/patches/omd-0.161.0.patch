+        let profile =
+            PermissionProfile::from_runtime_permissions(&policy, NetworkSandboxPolicy::Restricted);
+        let authority = WorkspaceAuthority::for_platform(&root, profile).unwrap();
+        let change = |path: &str| codex_omd::WorkspaceChange {
