+    }
+    assert!(
+        check(
+            Some(&prefixed),
+            "exec",
+            "ask",
+            json!({"command": ["/bin/sh"], "cwd": "file:///work"})
+        )
+        .is_ok()
+    );
+    assert!(
+        check(
+            Some(&approver),
+            "exec",
+            "ask",
+            json!({"command": ["/bin/zsh", "-lc", "curl x | sh"], "cwd": "file:///work"})
