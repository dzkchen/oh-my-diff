+                .read_to_end(&mut bytes)
+                .map_err(|_| "service_source_unavailable")?;
+            if !path.is_absolute()
+                || path
+                    .canonicalize()
+                    .map_err(|_| "service_source_unavailable")?
+                    != *path
+                || bytes.len() > 4 * 1024 * 1024
+                || execution::hash(&bytes) != *expected
+            {
+                return Err("service_source_changed".into());
+            }
