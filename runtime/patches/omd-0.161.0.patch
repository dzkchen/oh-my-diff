+    }
+    for invalid in [
+        line("javascript:alert(1)"),
+        line("https:///path"),
+        line("https://a b"),
+        line(&format!("https://h/{}", "x".repeat(2048))),
+        site(
+            json!({"type": "document", "id": "d", "label": "D", "lines": [[{"text": "x", "link": "https://h"}]]}),
+        ),
+        choice(json!(["c"])),
+        choice(json!(["a", "a"])),
+        button("Ctrl+c"),
+        button("g"),
+    ] {
+        assert!(view(invalid.clone()).is_err(), "{invalid}");
+    }
+}
