+    assert!(tool_notice_lines(&target("call_seen")).is_empty());
+    assert!(tool_notice("call_seen", "info", "new thread", "checks"));
+    let shown = texts(&tool_notice_lines(&target("call_seen")));
+    assert_eq!(shown.len(), 1);
