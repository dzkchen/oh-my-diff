+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::step_context::StepContext;
+    use crate::session::tests::make_session_and_context;
+    use crate::tools::context::{FunctionToolOutput, ToolInvocation, ToolOutput};
+    use crate::tools::registry::{CoreToolRuntime, ToolExecutor, ToolRegistry};
+    use crate::tools::router::{ToolCallSource, ToolRouter};
+    use crate::turn_diff_tracker::TurnDiffTracker;
+    use codex_tools::ToolSpec;
+
+    fn tool(name: &str) -> ToolDefinition {
+        ToolDefinition {
+            name: name.into(),
+            tool_name: ToolName::plain(name),
+            description: String::new(),
+            kind: CodeModeToolKind::Function,
+            input_schema: None,
+            input_schema_max_bytes: None,
+            output_schema: None,
+        }
+    }
+
+    #[test]
+    fn bridge_requires_current_cell_token_and_tool_surface() {
+        let count = AtomicUsize::new(0);
+        let tools = [tool("read_file"), tool("kernel"), tool("exec")];
+        let request = |token: &str, name: &str| {
+            json!({"token": token, "name": name, "arguments": {"path": "safe.csv"}}).to_string()
+        };
+        assert!(
+            authorize_bridge_request(
+                request("wrong", "read_file").as_bytes(),
+                "secret",
+                &tools,
+                &count
+            )
+            .unwrap_err()
+            .contains("authentication")
+        );
+        assert_eq!(count.load(Ordering::Relaxed), 0);
+        assert!(
+            authorize_bridge_request(
+                request("secret", "unlisted").as_bytes(),
+                "secret",
+                &tools,
+                &count
+            )
+            .unwrap_err()
+            .contains("not enabled")
+        );
+        assert!(
+            authorize_bridge_request(
+                request("secret", "kernel").as_bytes(),
+                "secret",
+                &tools,
+                &count
+            )
+            .unwrap_err()
+            .contains("recursive")
+        );
+        assert!(
+            authorize_bridge_request(
+                request("secret", "exec").as_bytes(),
+                "secret",
+                &tools,
+                &count
+            )
+            .unwrap_err()
+            .contains("recursive")
+        );
+        let (allowed, args) = authorize_bridge_request(
+            request("secret", "read_file").as_bytes(),
+            "secret",
+            &tools,
+            &count,
+        )
+        .unwrap();
+        assert_eq!(allowed.name, "read_file");
+        assert_eq!(args["path"], "safe.csv");
+    }
+
+    #[test]
+    fn bridge_limits_calls_and_rejects_extra_fields() {
+        let count = AtomicUsize::new(MAX_BRIDGE_CALLS);
+        let tools = [tool("read_file")];
+        let valid = br#"{"token":"secret","name":"read_file","arguments":{}}"#;
+        assert!(
+            authorize_bridge_request(valid, "secret", &tools, &count)
+                .unwrap_err()
+                .contains("limit")
+        );
+        let unknown = br#"{"token":"secret","name":"missing","arguments":{}}"#;
+        let fresh = AtomicUsize::new(0);
+        assert!(authorize_bridge_request(unknown, "secret", &tools, &fresh).is_err());
+        assert_eq!(fresh.load(Ordering::Acquire), 0);
+        let extra = br#"{"token":"secret","name":"read_file","arguments":{},"ignore":"this"}"#;
+        assert!(
+            authorize_bridge_request(extra, "secret", &tools, &AtomicUsize::new(0))
+                .unwrap_err()
+                .contains("invalid")
+        );
+    }
+
+    #[test]
+    fn kernel_command_requires_an_unchanged_bounded_driver() {
+        let directory = tempfile::tempdir().unwrap();
+        let driver = directory.path().join("driver.sh");
+        std::fs::write(&driver, "echo ready").unwrap();
+        let digest = format!(
+            "{:x}",
+            <sha2::Sha256 as sha2::Digest>::digest(std::fs::read(&driver).unwrap())
+        );
+        let kernel = codex_features::CodeModeKernelToml {
+            name: "shell".into(),
+            command: vec!["sh".into(), "-c".into()],
+            driver: driver.clone(),
+            driver_sha256: digest,
+        };
+        assert_eq!(
+            kernel_command(&kernel).unwrap(),
+            "stty raw -echo; 'sh' '-c' 'echo ready'"
+        );
+        std::fs::write(&driver, "echo changed").unwrap();
+        assert!(kernel_command(&kernel).unwrap_err().contains("changed"));
+        let invalid = codex_features::CodeModeKernelToml {
+            name: "Bad Name".into(),
+            ..kernel.clone()
+        };
+        assert!(kernel_command(&invalid).unwrap_err().contains("invalid"));
+        let relative = codex_features::CodeModeKernelToml {
+            driver: "driver.sh".into(),
+            ..kernel
+        };
+        assert!(kernel_command(&relative).unwrap_err().contains("invalid"));
+    }
+
+    #[test]
+    fn worker_result_requires_complete_frame() {
+        assert!(parse_worker_result("other output").unwrap().is_none());
+        assert!(
+            parse_worker_result("CODE_KERNEL_RESULT:{\"ok\":true")
+                .unwrap()
+                .is_none()
+        );
+        let result = parse_worker_result("CODE_KERNEL_RESULT:{\"ok\":true,\"output\":\"42\\n\"}\n")
+            .unwrap()
+            .unwrap();
+        assert!(result.ok);
+        assert_eq!(result.output, "42\n");
+    }
+
+    struct Probe;
+
+    impl ToolExecutor<ToolInvocation> for Probe {
+        fn tool_name(&self) -> ToolName {
+            ToolName::plain("audit_probe").with_default_namespace()
+        }
+
+        fn spec(&self) -> ToolSpec {
+            ToolSpec::Function(codex_tools::ResponsesApiTool {
+                name: "audit_probe".into(),
+                description: "Return dispatch identity".into(),
+                strict: false,
+                defer_loading: None,
+                parameters: codex_tools::JsonSchema::default(),
+                output_schema: None,
+            })
+        }
+
+        fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+        where
+            ToolInvocation: 'a,
+        {
+            Box::pin(async move {
+                let cell = match invocation.source {
+                    ToolCallSource::CodeMode { cell_id, .. } => cell_id,
+                    _ => "wrong source".into(),
+                };
+                Ok(Box::new(FunctionToolOutput::from_text(
+                    json!({
+                        "thread": invocation.session.thread_id.to_string(),
+                        "turn": invocation.turn.sub_id,
+                        "cell": cell,
+                        "csv": "month,total\nJan,2\nFeb,4\nMar,3\n"
+                    })
+                    .to_string(),
+                    Some(true),
+                )) as Box<dyn ToolOutput>)
+            })
+        }
+    }
+
+    impl CoreToolRuntime for Probe {}
