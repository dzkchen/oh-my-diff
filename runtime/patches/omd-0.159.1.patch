+    #[serde(default)]
+    read_hashes: BTreeMap<PathBuf, String>,
+    #[serde(default)]
+    credentials: BTreeMap<String, String>,
+}
+
+#[derive(Default)]
+pub(super) struct Services {
+    records: tokio::sync::Mutex<BTreeMap<String, Service>>,
+}
+
+struct Service {
+    mod_id: String,
+    generation: u64,
+    route: Option<Route>,
+    job: Option<tokio::task::JoinHandle<Result<Value, String>>>,
+    task: Arc<Task>,
+    worker: String,
+}
+
+impl Drop for Service {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+        }
+        let _ = self.task.finish_worker(&self.worker);
+    }
+}
+
+impl Service {
+    fn finished(&self) -> bool {
+        self.job
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    async fn stop(mut self) {
+        if let Some(job) = self.job.take() {
+            job.abort();
+            let _ = job.await;
+        }
+    }
+}
+
+impl Services {
+    pub(super) async fn cleanup_owned(&self, mod_id: &str, generation: u64) {
+        let owned = {
+            let mut records = self.records.lock().await;
+            let keys = records
+                .iter()
+                .filter(|(_, agent)| agent.mod_id == mod_id && agent.generation == generation)
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>();
+            keys.into_iter()
+                .filter_map(|key| records.remove(&key))
+                .collect::<Vec<_>>()
+        };
+        for agent in owned {
+            agent.stop().await;
+        }
+    }
+
+    pub(super) async fn cleanup_session(&self, session: &Session) {
+        let owned = {
+            let mut records = self.records.lock().await;
+            let keys = records
+                .iter()
+                .filter(|(_, service)| Arc::ptr_eq(&service.task, &session.task))
+                .map(|(id, _)| id.clone())
+                .collect::<Vec<_>>();
+            keys.into_iter()
+                .filter_map(|key| records.remove(&key))
+                .collect::<Vec<_>>()
+        };
+        for service in owned {
+            service.stop().await;
+        }
+    }
+
+    pub(super) async fn route(
+        &self,
+        mod_id: &str,
+        generation: u64,
+        id: &str,
+    ) -> Result<Route, String> {
+        self.records
+            .lock()
+            .await
+            .get(id)
+            .filter(|s| s.mod_id == mod_id && s.generation == generation && !s.finished())
+            .and_then(|s| s.route.clone())
+            .ok_or_else(|| "provider_not_registered_or_stopped".into())
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "Keep service registration atomic with cleanup ownership"
+    )]
+    pub(super) async fn call(
+        &self,
+        lead: &Lead,
+        mod_id: &str,
+        generation: u64,
+        request: codex_omd::ModHostCall,
+    ) -> Result<Value, String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Selection {
+            id: String,
+            #[serde(default)]
+            input: Option<Value>,
+            #[serde(default)]
+            credential: Option<String>,
+            #[serde(default)]
+            secrets: Vec<String>,
+        }
+        let selection: Selection =
+            serde_json::from_value(request.arguments).map_err(|e| e.to_string())?;
+        if (selection.credential.is_some() || !selection.secrets.is_empty())
+            && !matches!(
+                request.operation.as_str(),
+                "sidecars.start" | "providers.register"
+            )
+            || selection.secrets.len() > 16
+        {
+            return Err("credential_requires_service_start".into());
+        }
+        let invoke = request.operation == "sidecars.invoke";
+        if invoke != selection.input.is_some()
+            || selection.input.as_ref().is_some_and(|input| {
+                serde_json::to_vec(input).map_or(true, |bytes| bytes.len() > 16384)
+            })
+        {
+            return Err("service_request_input_invalid".into());
+        }
+        let mut records = self.records.lock().await;
+        if matches!(
+            request.operation.as_str(),
+            "sidecars.stop" | "providers.unregister"
+        ) {
+            if records
+                .get(&selection.id)
+                .is_none_or(|r| r.mod_id != mod_id || r.generation != generation)
+            {
+                return Err("unknown_or_foreign_sidecar".into());
+            }
+            let service = records.remove(&selection.id);
+            drop(records);
+            if let Some(service) = service {
+                service.stop().await;
+            }
+            return Ok(json!({"stopped":true}));
+        }
+        if request.operation == "sidecars.status" {
+            let record = records
+                .get(&selection.id)
+                .filter(|r| r.mod_id == mod_id && r.generation == generation)
+                .ok_or("unknown_or_foreign_sidecar")?;
+            return Ok(json!({"id":selection.id,"running":!record.finished()}));
+        }
+        if records.contains_key(&selection.id) {
+            return Err("service_already_registered".into());
+        }
+        let host = &lead.host;
+        let grant = host
+            .config
+            .services
+            .iter()
+            .find(|g| g.id == selection.id && g.mod_id == mod_id)
+            .cloned()
+            .ok_or("service_not_host_approved")?;
+        if records.len() >= 8 || grant.id.is_empty() || grant.id.len() > 32 {
+            return Err("service_limit".into());
+        }
+        if request.operation == "providers.register" && grant.route.is_none() {
+            return Err("provider_grant_required".into());
+        }
+        if request.operation == "sidecars.start" && grant.route.is_some() {
+            return Err("provider_registration_required".into());
+        }
+        if invoke && (!grant.requests || grant.route.is_some() || grant.read_hashes.is_empty()) {
+            return Err("service_request_not_host_approved".into());
+        }
+        if grant.read_hashes.len() > 32 {
+            return Err("service_source_limit".into());
+        }
+        for (path, expected) in &grant.read_hashes {
+            if !path.is_absolute()
+                || path
+                    .canonicalize()
+                    .map_err(|_| "service_source_unavailable")?
+                    != *path
+                || std::fs::metadata(path)
+                    .map_err(|_| "service_source_unavailable")?
+                    .len()
+                    > 4 * 1024 * 1024
+                || execution::hash(&std::fs::read(path).map_err(|_| "service_source_unavailable")?)
+                    != *expected
+            {
+                return Err("service_source_changed".into());
+            }
+        }
+        if grant.program.starts_with(&host.repository)
+            || grant.program.canonicalize().map_err(|e| e.to_string())? != grant.program
+        {
+            return Err("service_executable_must_be_canonical_and_outside_repository".into());
+        }
+        let metadata = std::fs::metadata(&grant.program).map_err(|e| e.to_string())?;
+        if !metadata.is_file() || metadata.len() > 134_217_728 {
+            return Err("service_executable_limit".into());
+        }
+        if execution::hash(&std::fs::read(&grant.program).map_err(|e| e.to_string())?)
+            != grant.program_sha256
+        {
+            return Err("service_executable_changed".into());
+        }
+        let manager = host
+            .manager
+            .upgrade()
+            .ok_or("native_thread_manager_stopped")?;
+        let parent = manager
+            .get_thread(lead.thread)
+            .await
+            .map_err(|e| e.to_string())?
+            .config()
+            .await;
+        if grant.read_paths.len() > 16 {
+            return Err("service_read_path_limit".into());
+        }
+        let mut reads = host.config.toolchain_reads.clone();
+        reads.push(grant.program.clone());
+        let supervisor = std::env::current_exe()
+            .map_err(|e| e.to_string())?
+            .canonicalize()
+            .map_err(|e| e.to_string())?;
+        reads.push(supervisor.clone());
+        reads.extend(grant.read_paths.iter().cloned());
+        let mut denied = host
+            .protected_paths()
+            .into_iter()
+            .filter(|path| *path != host.root)
+            .collect::<Vec<_>>();
+        let mut parent = (*parent).clone();
+        let inherited = execution::intersect(
+            &parent.permissions.effective_permission_profile(),
+            &lead
+                .permission_profile
+                .lock()
+                .map_err(|_| "permission_profile_poisoned")?
+                .clone(),
+            parent.cwd.as_path(),
+        )?;
+        let source = Some(host.root.join("sources").join(mod_id));
+        for entry in inherited.file_system_sandbox_policy().entries {
+            if entry.access != FileSystemAccessMode::Deny {
+                continue;
+            }
+            let FileSystemPath::Path { path } = entry.path else {
+                return Err("service_parent_denial_unsupported".into());
+            };
+            let path = path.to_path_buf();
+            if path == Path::new("/")
+                || host.root == path
+                || (source.as_ref() == Some(&path) && grant.read_paths.contains(&path))
+            {
+                continue;
+            }
+            if !denied.contains(&path) {
+                denied.push(path);
+            }
+        }
+        let scope = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::unrestricted(),
+            inherited.network_sandbox_policy(),
+        );
+        parent
+            .permissions
+            .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(scope))
+            .map_err(|e| e.to_string())?;
+        let mut config = execution::isolated(&parent, &host.repository, &reads, &denied, false)?;
+        if grant.network {
+            let service_profile = config.permissions.effective_permission_profile();
+            let profile = codex_protocol::models::PermissionProfile::from_runtime_permissions(
+                &service_profile.file_system_sandbox_policy(),
+                codex_protocol::permissions::NetworkSandboxPolicy::Enabled,
+            );
+            config
+                .permissions
+                .set_permission_profile_from_session_snapshot(
+                    codex_protocol::models::PermissionProfileSnapshot::legacy(profile),
+                )
+                .map_err(|e| e.to_string())?;
+        }
+        config.permissions.shell_environment_policy.r#set.clear();
+        for (environment, reference) in &grant.secrets {
+            if environment == "OMD_READY_TOKEN"
+                || environment.is_empty()
+                || environment.len() > 64
+                || !environment
+                    .bytes()
+                    .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == b'_')
+            {
+                return Err("invalid_secret_environment_key".into());
+            }
+            let path = host
+                .config
+                .secret_refs
+                .get(reference)
+                .ok_or("unknown_secret_reference")?;
+            if path.starts_with(&host.repository)
+                || !path.is_absolute()
+                || std::fs::symlink_metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .file_type()
+                    .is_symlink()
+                || !std::fs::metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .is_file()
+                || std::fs::metadata(path)
+                    .map_err(|_| "secret_reference_unavailable")?
+                    .len()
+                    > 8192
+            {
+                return Err("secret_reference_unavailable".into());
+            }
+            let value =
+                std::fs::read_to_string(path).map_err(|_| "secret_reference_unavailable")?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert(environment.clone(), value.trim_end().to_string());
+        }
+        if let Some(profile) = &selection.credential {
+            let environment = grant
+                .credentials
+                .iter()
+                .find(|(_, approved)| *approved == profile)
+                .map(|(environment, _)| environment.clone())
+                .ok_or("credential_not_host_approved")?;
+            if environment == "OMD_READY_TOKEN"
+                || environment.is_empty()
+                || environment.len() > 64
+                || !environment
+                    .bytes()
+                    .all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == b'_')
+            {
+                return Err("invalid_credential_environment_key".into());
+            }
+            let secret = codex_omd::credentials::CredentialProfiles::open(&host.root)
+                .and_then(|profiles| profiles.secret(profile))
+                .map_err(|error| error.to_string())?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert(environment, secret.token);
+        }
+        if !selection.secrets.is_empty() {
+            let profiles = codex_omd::credentials::CredentialProfiles::open(&host.root)
+                .map_err(|error| error.to_string())?;
+            let secrets = selection
+                .secrets
+                .iter()
+                .map(|id| profiles.owned_secret(id, mod_id))
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|error| error.to_string())?;
+            config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .insert("OMD_SECRETS".to_owned(), Value::Array(secrets).to_string());
+        }
+        if let Some(route) = &grant.route {
+            if route.model.is_empty() || route.model.len() > 128 {
+                return Err("unsupported_adapter_model".into());
+            }
+            if !config.model_providers.contains_key(&route.provider)
+                || !route.responses_url.starts_with("http://127.0.0.1:")
+            {
+                return Err("configured_loopback_provider_required".into());
+            }
+        }
+        if invoke {
+            let worker = format!(
+                "service-request-{}-{}",
+                grant.id,
+                manager.reserve_thread_id()
+            );
+            lead.session
+                .task
+                .start_worker(
+                    worker.clone(),
+                    lead.owner.clone(),
+                    lead.depth.saturating_add(1),
+                    host.config.worker_limits.clone(),
+                )
+                .map_err(|e| e.to_string())?;
+            struct RequestGuard {
+                task: Arc<Task>,
+                worker: String,
+            }
+            impl Drop for RequestGuard {
+                fn drop(&mut self) {
+                    let _ = self.task.finish_worker(&self.worker);
+                }
+            }
+            let _guard = RequestGuard {
+                task: lead.session.task.clone(),
+                worker,
+            };
+            let mut argv = vec![grant.program.to_string_lossy().into_owned()];
+            argv.extend(grant.arguments.clone());
+            argv.push("--omd-request-json".into());
+            argv.push(serde_json::to_string(&selection.input).map_err(|e| e.to_string())?);
+            if argv.len() > 128 || argv.iter().map(String::len).sum::<usize>() > 24576 {
+                return Err("service_argument_limit".into());
+            }
+            let timeout = lead
+                .session
+                .task
+                .remaining()
+                .map_err(|e| e.to_string())?
+                .0
+                .min(Duration::from_secs(30));
+            let mut supervised = vec![
+                supervisor.to_string_lossy().into_owned(),
+                "--omd-managed-request-v1".into(),
+                std::process::id().to_string(),
+                timeout.as_secs().saturating_add(1).to_string(),
+            ];
+            supervised.extend(argv);
+            drop(records);
+            let output = tokio::time::timeout(timeout, request_output(&config, supervised))
+                .await
+                .map_err(|_| "service_request_deadline")??;
+            lead.session
+                .task
+                .check_active()
+                .map_err(|e| e.to_string())?;
+            if output["exit_code"] != 0 {
+                return Err("service_request_failed".into());
+            }
+            let text = output["stdout"]
+                .as_str()
+                .filter(|text| text.len() <= 32768)
+                .ok_or("service_response_limit")?;
+            if config
+                .permissions
+                .shell_environment_policy
+                .r#set
+                .values()
+                .filter(|value| value.len() >= 4)
+                .any(|secret| text.contains(secret))
+            {
+                return Err("service_response_secret_excluded".into());
+            }
+            let value: Value =
+                serde_json::from_str(text).map_err(|_| "service_response_not_json")?;
+            return Ok(
+                json!({"provider":grant.id,"program_sha256":grant.program_sha256,"source_hashes":grant.read_hashes,"result":value,"untrusted":true}),
+            );
+        }
+        let nonce = manager.reserve_thread_id().to_string();
+        config
+            .permissions
+            .shell_environment_policy
+            .r#set
+            .insert("OMD_READY_TOKEN".into(), nonce.clone());
+        let port = grant
+            .route
+            .as_ref()
+            .map(|route| {
+                let uri: http::Uri = route
+                    .responses_url
+                    .parse()
+                    .map_err(|_| "invalid_provider_url")?;
+                if uri.scheme_str() != Some("http") || uri.host() != Some("127.0.0.1") {
+                    return Err("configured_loopback_provider_required");
+                }
+                uri.port_u16().ok_or("explicit_provider_port_required")
+            })
+            .transpose()?;
+        let worker = format!("sidecar-{}-{}", grant.id, manager.reserve_thread_id());
+        lead.session
+            .task
+            .start_worker(
+                worker.clone(),
+                lead.owner.clone(),
+                lead.depth.saturating_add(1),
+                host.config.worker_limits.clone(),
+            )
+            .map_err(|e| e.to_string())?;
+        let mut argv = vec![grant.program.to_string_lossy().into_owned()];
+        argv.extend(grant.arguments);
+        if argv.len() > 128 || argv.iter().map(String::len).sum::<usize>() > 8192 {
+            let _ = lead.session.task.finish_worker(&worker);
+            return Err("service_argument_limit".into());
+        }
+        let task = lead.session.task.clone();
+        let output_bytes = host.config.snapshot_bytes;
+        let timeout = lead
+            .session
+            .task
+            .remaining()
+            .map_err(|e| e.to_string())?
+            .0
+            .min(Duration::from_secs(host.config.worker_limits.seconds));
+        let mut supervised = vec![
+            supervisor.to_string_lossy().into_owned(),
+            "--omd-managed-service-v1".into(),
+            std::process::id().to_string(),
+            timeout.as_secs().saturating_add(1).min(86400).to_string(),
+        ];
+        supervised.extend(argv);
+        let job = tokio::spawn(async move {
+            let result = tokio::time::timeout(
+                timeout,
+                execution::command(&task, output_bytes, &config, supervised),
+            )
+            .await
+            .map_err(|_| "sidecar_deadline".to_string())??;
+            Ok(json!({"exit_code":result["exit_code"],"timed_out":result["timed_out"]}))
+        });
+        records.insert(
+            grant.id.clone(),
+            Service {
+                mod_id: mod_id.into(),
+                generation,
+                // A provider becomes routable only after its readiness handshake succeeds.
+                route: None,
+                job: Some(job),
+                task: lead.session.task.clone(),
+                worker: worker.clone(),
+            },
+        );
+        // Every mod shares these records, so wait for readiness without holding the lock.
+        drop(records);
+        if let (Some(port), Some(route)) = (port, grant.route) {
+            let ready = tokio::time::timeout(Duration::from_secs(3), async {
+                loop {
+                    lead.session
+                        .task
+                        .check_active()
+                        .map_err(|e| e.to_string())?;
+                    if self
+                        .records
+                        .lock()
+                        .await
+                        .get(&grant.id)
+                        .is_none_or(|s| s.worker != worker || s.finished())
+                    {
+                        return Err("provider_sidecar_stopped".to_string());
+                    }
+                    if let Ok(mut stream) =
+                        tokio::net::TcpStream::connect((std::net::Ipv4Addr::LOCALHOST, port)).await
+                    {
+                        use tokio::io::AsyncReadExt;
+                        use tokio::io::AsyncWriteExt;
+                        let attempt = async {
+                            stream
+                                .write_all(b"GET /_omd/ready HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n")
+                                .await?;
+                            let mut response = Vec::new();
+                            stream.take(4096).read_to_end(&mut response).await?;
+                            Ok::<_, std::io::Error>(
+                                response.ends_with(format!("OMD_READY:{nonce}").as_bytes()),
+                            )
+                        };
+                        if tokio::time::timeout(Duration::from_millis(200), attempt)
+                            .await
+                            .is_ok_and(|r| r.unwrap_or(false))
+                        {
+                            return Ok(());
+                        }
+                    }
+                    tokio::time::sleep(Duration::from_millis(20)).await;
+                }
+            })
+            .await;
+            let mut records = self.records.lock().await;
+            match records.get_mut(&grant.id) {
+                Some(service) if service.worker == worker && matches!(ready, Ok(Ok(()))) => {
+                    service.route = Some(route);
+                }
+                current => {
+                    let stale = current
+                        .is_some_and(|s| s.worker == worker)
+                        .then(|| records.remove(&grant.id))
+                        .flatten();
+                    drop(records);
+                    if let Some(service) = stale {
+                        service.stop().await;
+                    }
+                    return Err("provider_readiness_failed".into());
+                }
+            }
+        }
+        Ok(
+            json!({"id":grant.id,"status":if port.is_some() {"ready"} else {"starting"},"secret_references":grant.secrets.values().collect::<Vec<_>>(),"credential":selection.credential}),
+        )
+    }
+}
+
+async fn request_output(config: &Config, command: Vec<String>) -> Result<Value, String> {
+    use codex_sandboxing::seatbelt::{
+        CreateSeatbeltCommandArgsParams, MACOS_PATH_TO_SEATBELT_EXECUTABLE,
+        create_seatbelt_command_args,
+    };
+    use tokio::io::{AsyncBufReadExt, AsyncReadExt};
+    let profile = config.permissions.effective_permission_profile();
+    let argv = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+        command,
+        file_system_sandbox_policy: &profile.file_system_sandbox_policy(),
+        network_sandbox_policy: profile.network_sandbox_policy(),
+        sandbox_policy_cwd: config.cwd.as_path(),
+        enforce_managed_network: false,
+        managed_network: None,
+        environment_id: None,
+        network: None,
+        extra_allow_unix_sockets: &[],
+    })?;
+    let mut child = tokio::process::Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(argv)
+        .current_dir(&config.cwd)
+        .env_clear()
+        .envs(config.permissions.shell_environment_policy.r#set.iter())
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .process_group(0)
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|error| error.to_string())?;
+    struct Group(u32);
+    impl Drop for Group {
+        fn drop(&mut self) {
+            let _ = codex_utils_pty::process_group::kill_process_group(self.0);
+        }
+    }
+    let group = Group(child.id().ok_or("service_process_id_missing")?);
+    let stdout = child.stdout.take().ok_or("service_stdout_missing")?;
+    let mut line = Vec::new();
+    tokio::io::BufReader::new(stdout)
+        .take(196_609)
+        .read_until(b'\n', &mut line)
+        .await
+        .map_err(|error| error.to_string())?;
+    drop(group);
+    let _ = child.wait().await;
+    if line.len() > 196_608 || line.last() != Some(&b'\n') {
+        return Err("service_response_limit_or_incomplete".into());
+    }
+    serde_json::from_slice(&line).map_err(|_| "service_response_invalid".into())
+}
diff --git a/codex-rs/ext/omd/src/mods/snapshots.rs b/codex-rs/ext/omd/src/mods/snapshots.rs
new file mode 100644
index 000000000..4945b07ef
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/snapshots.rs
@@ -0,0 +1,669 @@
+use super::*;
+use codex_omd::Snapshot;
+use codex_omd::resource_data::ResourceRef;
+use std::collections::BTreeSet;
+
+const SNAPSHOT_LIMIT: usize = 8;
+const SNAPSHOT_BYTES: usize = 64 * 1024 * 1024;
+const SNAPSHOT_TOTAL_LIMIT: usize = 32;
+const SNAPSHOT_TOTAL_BYTES: usize = 256 * 1024 * 1024;
+const EXECUTION_LIMIT: usize = 64;
+const EXECUTION_TOTAL_LIMIT: usize = 256;
+
+#[derive(Clone, PartialEq)]
+struct Scope {
+    owner: String,
+    generation: u64,
+    thread: ThreadId,
+}
+
+impl Scope {
+    fn of(caller: &operations::Caller<'_>, thread: ThreadId) -> Self {
+        Self {
+            owner: caller.id.into(),
+            generation: caller.generation,
+            thread,
+        }
+    }
+}
+
+fn evict_oldest<T>(
+    entries: &mut BTreeMap<String, T>,
+    select: impl Fn(&T) -> bool,
+    sequence: impl Fn(&T) -> u64,
+) {
+    if let Some(oldest) = entries
+        .iter()
+        .filter(|(_, entry)| select(entry))
+        .min_by_key(|(_, entry)| sequence(entry))
+        .map(|(key, _)| key.clone())
+    {
+        entries.remove(&oldest);
+    }
+}
+
+fn heaviest<T>(
+    entries: &BTreeMap<String, T>,
+    scope: impl Fn(&T) -> &Scope,
+    weight: impl Fn(&T) -> usize,
+) -> Option<Scope> {
+    entries
+        .values()
+        .map(|entry| {
+            let owned = scope(entry);
+            let total = entries
+                .values()
+                .filter(|other| scope(other) == owned)
+                .map(&weight)
+                .sum::<usize>();
+            (total, owned)
+        })
+        .max_by_key(|(total, _)| *total)
+        .map(|(_, owned)| owned.clone())
+}
+
+struct Stored {
+    scope: Scope,
+    source: String,
+    snapshot: Arc<Snapshot>,
+    digest: String,
+    bytes: usize,
+    sequence: u64,
+}
+
+#[derive(Default)]
+pub(super) struct Snapshots {
+    entries: BTreeMap<String, Stored>,
+    executions: BTreeMap<String, Execution>,
+    sequence: u64,
+}
+
+struct Execution {
+    scope: Scope,
+    source: String,
+    candidate: String,
+    evidence: ResourceRef,
+    passed: bool,
+    sequence: u64,
+}
+
+impl Snapshots {
+    fn next(&mut self) -> u64 {
+        self.sequence += 1;
+        self.sequence
+    }
+
+    pub(super) fn record_execution(
+        &mut self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        candidate: String,
+        evidence: ResourceRef,
+        result: &Value,
+    ) {
+        let scope = Scope::of(caller, thread);
+        self.executions.remove(&evidence.reference);
+        while self
+            .executions
+            .values()
+            .filter(|entry| entry.scope == scope)
+            .count()
+            >= EXECUTION_LIMIT
+        {
+            evict_oldest(
+                &mut self.executions,
+                |entry| entry.scope == scope,
+                |entry| entry.sequence,
+            );
+        }
+        while self.executions.len() >= EXECUTION_TOTAL_LIMIT {
+            let Some(heaviest) = heaviest(&self.executions, |entry| &entry.scope, |_| 1) else {
+                break;
+            };
+            evict_oldest(
+                &mut self.executions,
+                |entry| entry.scope == heaviest,
+                |entry| entry.sequence,
+            );
+        }
+        let sequence = self.next();
+        self.executions.insert(
+            evidence.reference.clone(),
+            Execution {
+                scope,
+                source: caller.source.into(),
+                candidate,
+                evidence,
+                passed: result["exit_code"] == 0
+                    && result["signal"].is_null()
+                    && result["timed_out"] == false
+                    && result["stdout_truncated"] == false
+                    && result["stderr_truncated"] == false,
+                sequence,
+            },
+        );
+    }
+
+    pub(super) fn attest_execution(
+        &self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        candidate: &str,
+        evidence: &ResourceRef,
+        outcome: codex_omd::ReceiptOutcome,
+    ) -> Result<(), String> {
+        let record = self
+            .executions
+            .get(&evidence.reference)
+            .filter(|record| {
+                record.scope == Scope::of(caller, thread)
+                    && record.source == caller.source
+                    && record.candidate == candidate
+                    && record.evidence.sha256 == evidence.sha256
+            })
+            .ok_or("unknown_or_foreign_execution")?;
+        if outcome == codex_omd::ReceiptOutcome::Pass && !record.passed {
+            return Err("execution_did_not_pass".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn insert(
+        &mut self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        snapshot: Snapshot,
+        digest: String,
+    ) -> Result<Value, String> {
+        let reference = format!(
+            "snapshot:{}",
+            execution::hash(
+                &serde_json::to_vec(&(
+                    caller.id,
+                    caller.generation,
+                    thread,
+                    caller.source,
+                    &digest
+                ))
+                .map_err(|error| error.to_string())?
+            )
+        );
+        if !self.entries.contains_key(&reference) {
+            let bytes = snapshot
+                .files
+                .iter()
+                .try_fold(0usize, |total, (name, file)| {
+                    total
+                        .checked_add(name.len())
+                        .and_then(|n| n.checked_add(file.bytes.len()))
+                })
+                .ok_or("snapshot_byte_limit")?;
+            if bytes > SNAPSHOT_BYTES {
+                return Err("snapshot_limit".into());
+            }
+            let scope = Scope::of(caller, thread);
+            let usage = |entries: &BTreeMap<String, Stored>, select: &dyn Fn(&Stored) -> bool| {
+                entries
+                    .values()
+                    .filter(|entry| select(entry))
+                    .fold((0usize, 0usize), |(count, total), entry| {
+                        (count + 1, total + entry.bytes)
+                    })
+            };
+            loop {
+                let (count, used) = usage(&self.entries, &|entry| entry.scope == scope);
+                if count < SNAPSHOT_LIMIT && used + bytes <= SNAPSHOT_BYTES {
+                    break;
+                }
+                evict_oldest(
+                    &mut self.entries,
+                    |entry| entry.scope == scope,
+                    |entry| entry.sequence,
+                );
+            }
+            loop {
+                let (count, used) = usage(&self.entries, &|_| true);
+                if count < SNAPSHOT_TOTAL_LIMIT && used + bytes <= SNAPSHOT_TOTAL_BYTES {
+                    break;
+                }
+                let Some(heaviest) = heaviest(
+                    &self.entries,
+                    |entry| &entry.scope,
+                    |entry| entry.bytes.max(1),
+                ) else {
+                    break;
+                };
+                evict_oldest(
+                    &mut self.entries,
+                    |entry| entry.scope == heaviest,
+                    |entry| entry.sequence,
+                );
+            }
+            let sequence = self.next();
+            self.entries.insert(
+                reference.clone(),
+                Stored {
+                    scope,
+                    source: caller.source.into(),
+                    snapshot: Arc::new(snapshot),
+                    digest: digest.clone(),
+                    bytes,
+                    sequence,
+                },
+            );
+        }
+        Ok(
+            json!({"snapshot": {"reference": reference, "sha256": digest},
+            "candidate_sha256": digest}),
+        )
+    }
+
+    pub(super) fn get(
+        &self,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        reference: &ResourceRef,
+    ) -> Result<Arc<Snapshot>, String> {
+        let stored = self
+            .entries
+            .get(&reference.reference)
+            .filter(|entry| {
+                entry.scope == Scope::of(caller, thread) && entry.source == caller.source
+            })
+            .ok_or("unknown_or_foreign_snapshot")?;
+        if stored.digest != reference.sha256 {
+            return Err("snapshot_digest_mismatch".into());
+        }
+        Ok(stored.snapshot.clone())
+    }
+
+    pub(super) fn remove_owner(&mut self, owner: &str, generation: u64) {
+        let owned = |scope: &Scope| scope.owner == owner && scope.generation == generation;
+        self.entries.retain(|_, entry| !owned(&entry.scope));
+        self.executions.retain(|_, entry| !owned(&entry.scope));
+    }
+
+    pub(super) fn remove_thread(&mut self, thread: ThreadId) {
+        self.entries.retain(|_, entry| entry.scope.thread != thread);
+        self.executions
+            .retain(|_, entry| entry.scope.thread != thread);
+    }
+}
+
+pub(super) fn permitted(
+    snapshot: &Snapshot,
+    authority: &crate::workspace_operations::WorkspaceAuthority,
+    protected: &[PathBuf],
+) -> Result<(), String> {
+    for name in snapshot.files.keys() {
+        let path = codex_omd::workspace_path(&authority.repository, name)
+            .map_err(|error| error.to_string())?;
+        if !authority.readable(&path) || protected.iter().any(|root| path.starts_with(root)) {
+            return Err("snapshot_permission_denied".into());
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn capture(
+    authority: &crate::workspace_operations::WorkspaceAuthority,
+    protected: &[PathBuf],
+    approved: &BTreeSet<String>,
+    limit: usize,
+    active: &dyn Fn() -> bool,
+) -> Result<Snapshot, String> {
+    if !active() {
+        return Err("snapshot_cancelled".into());
+    }
+    let paths = codex_omd::tracked_paths(&authority.repository, approved)
+        .map_err(|error| error.to_string())?;
+    for name in &paths {
+        let path = codex_omd::workspace_path(&authority.repository, name)
+            .map_err(|error| error.to_string())?;
+        if !authority.readable(&path) || protected.iter().any(|root| path.starts_with(root)) {
+            return Err("snapshot_permission_denied".into());
+        }
+    }
+    let snapshot = Snapshot::capture(&authority.repository, &paths, limit)
+        .map_err(|error| error.to_string())?;
+    if !active() {
+        return Err("snapshot_cancelled".into());
+    }
+    if codex_omd::tracked_paths(&authority.repository, approved)
+        .map_err(|error| error.to_string())?
+        != paths
+    {
+        return Err("snapshot_source_changed".into());
+    }
+    permitted(&snapshot, authority, protected)?;
+    Ok(snapshot)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Capture {
+    pub agent: Option<String>,
+    pub expected: Option<String>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_file_system::FileSystemSandboxContext;
+    use codex_protocol::models::PermissionProfile;
+    use codex_protocol::permissions::{
+        FileSystemAccessMode, FileSystemPath, FileSystemSandboxEntry, FileSystemSandboxPolicy,
+        NetworkSandboxPolicy,
+    };
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use codex_utils_path_uri::PathUri;
+
+    fn authority(
+        repository: PathBuf,
+        access: FileSystemAccessMode,
+    ) -> crate::workspace_operations::WorkspaceAuthority {
+        let absolute = AbsolutePathBuf::from_absolute_path_checked(&repository).unwrap();
+        let cwd = PathUri::from_abs_path(&absolute);
+        let policy = FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry::new(
+            FileSystemPath::Path { path: cwd.clone() },
+            access,
+        )]);
+        let profile =
+            PermissionProfile::from_runtime_permissions(&policy, NetworkSandboxPolicy::Restricted);
+        crate::workspace_operations::WorkspaceAuthority {
+            repository,
+            session_root: None,
+            session_database: None,
+            policy,
+            context: FileSystemSandboxContext::from_permission_profile(profile, cwd),
+        }
+    }
+
+    fn insert(
+        store: &mut Snapshots,
+        caller: &operations::Caller<'_>,
+        thread: ThreadId,
+        snapshot: Snapshot,
+    ) -> Result<Value, String> {
+        let digest = snapshot.hash().unwrap();
+        store.insert(caller, thread, snapshot, digest)
+    }
+
+    fn caller(id: &str, source: &str, generation: u64) -> operations::Caller<'static> {
+        operations::Caller {
+            id: if id == "one" { "one" } else { "two" },
+            source: if source == "a" { "a" } else { "b" },
+            generation,
+            grants: None,
+            origin: codex_omd::data_store::Origin::Event,
+            record_changes: false,
+        }
+    }
+
+    #[test]
+    fn snapshots_are_owner_source_generation_thread_and_digest_bound() {
+        let mut store = Snapshots::default();
+        let thread = ThreadId::new();
+        let owner = caller("one", "a", 1);
+        let snapshot = Snapshot {
+            files: BTreeMap::new(),
+        };
+        let value = insert(&mut store, &owner, thread, snapshot.clone()).unwrap();
+        let reference: ResourceRef = serde_json::from_value(value["snapshot"].clone()).unwrap();
+        assert_eq!(*store.get(&owner, thread, &reference).unwrap(), snapshot);
+        for stranger in [
+            caller("two", "a", 1),
+            caller("one", "b", 1),
+            caller("one", "a", 2),
+        ] {
+            assert!(store.get(&stranger, thread, &reference).is_err());
+        }
+        assert!(store.get(&owner, ThreadId::new(), &reference).is_err());
+        let changed = ResourceRef {
+            sha256: "0".repeat(64),
+            ..reference.clone()
+        };
+        assert!(store.get(&owner, thread, &changed).is_err());
+        store.remove_owner("one", 1);
+        assert!(store.get(&owner, thread, &reference).is_err());
+    }
+
+    #[test]
+    fn snapshots_deduplicate_and_evict_the_oldest_until_session_cleanup() {
+        let mut store = Snapshots::default();
+        let owner = caller("one", "a", 1);
+        let thread = ThreadId::new();
+        let mut first = None;
+        for number in 0..SNAPSHOT_LIMIT {
+            let snapshot = Snapshot {
+                files: BTreeMap::from([(
+                    "file".into(),
+                    codex_omd::File {
+                        bytes: vec![number as u8],
+                        executable: false,
+                    },
+                )]),
+            };
+            let inserted = insert(&mut store, &owner, thread, snapshot.clone()).unwrap();
+            assert_eq!(
+                insert(&mut store, &owner, thread, snapshot).unwrap(),
+                inserted
+            );
+            first.get_or_insert(inserted);
+        }
+        let first: ResourceRef =
+            serde_json::from_value(first.unwrap()["snapshot"].clone()).unwrap();
+        assert!(store.get(&owner, thread, &first).is_ok());
+        let empty = Snapshot {
+            files: BTreeMap::new(),
+        };
+        assert!(insert(&mut store, &owner, thread, empty).is_ok());
+        assert_eq!(store.entries.len(), SNAPSHOT_LIMIT);
+        assert!(store.get(&owner, thread, &first).is_err());
+        store.remove_thread(thread);
+        assert!(store.entries.is_empty());
+    }
+
+    #[test]
+    fn one_owner_filling_its_quota_never_evicts_another_owners_snapshot_or_execution() {
+        let mut store = Snapshots::default();
+        let quiet = caller("one", "a", 1);
+        let busy = caller("two", "a", 1);
+        let thread = ThreadId::new();
+        let file = |number: usize| Snapshot {
+            files: BTreeMap::from([(
+                "file".into(),
+                codex_omd::File {
+                    bytes: number.to_le_bytes().to_vec(),
+                    executable: false,
+                },
+            )]),
+        };
+        let kept: ResourceRef = serde_json::from_value(
+            insert(&mut store, &quiet, thread, file(usize::MAX)).unwrap()["snapshot"].clone(),
+        )
+        .unwrap();
+        let candidate = "a".repeat(64);
+        let evidence = ResourceRef {
+            reference: "execution:quiet".into(),
+            sha256: "b".repeat(64),
+        };
+        let passed = json!({"exit_code":0,"signal":null,"timed_out":false,"stdout_truncated":false,"stderr_truncated":false});
+        store.record_execution(&quiet, thread, candidate.clone(), evidence.clone(), &passed);
+        let threads = [
+            thread,
+            ThreadId::new(),
+            ThreadId::new(),
+            ThreadId::new(),
+            ThreadId::new(),
+        ];
+        for number in 0..64 {
+            let busy_thread = threads[number % threads.len()];
+            insert(&mut store, &busy, busy_thread, file(number)).unwrap();
+            for index in 0..8 {
+                let other = ResourceRef {
+                    reference: format!("execution:busy-{number}-{index}"),
+                    sha256: "d".repeat(64),
+                };
+                store.record_execution(&busy, busy_thread, candidate.clone(), other, &passed);
+            }
+        }
+        assert!(store.entries.len() <= SNAPSHOT_TOTAL_LIMIT);
+        assert!(store.executions.len() <= EXECUTION_TOTAL_LIMIT);
+        assert!(store.get(&quiet, thread, &kept).is_ok());
+        assert!(
+            store
+                .attest_execution(
+                    &quiet,
+                    thread,
+                    &candidate,
+                    &evidence,
+                    codex_omd::ReceiptOutcome::Pass
+                )
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn capture_requires_current_permissions_and_preserves_frozen_bytes() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        assert!(
+            std::process::Command::new("git")
+                .args(["init", "--quiet"])
+                .current_dir(&root)
+                .status()
+                .unwrap()
+                .success()
+        );
+        std::fs::write(root.join("source"), "before").unwrap();
+        let paths = BTreeSet::from(["source".into()]);
+        let readable = authority(root.clone(), FileSystemAccessMode::Read);
+        let captured = capture(&readable, &[], &paths, 128, &|| true).unwrap();
+        std::fs::write(root.join("source"), "after").unwrap();
+        assert_eq!(captured.files["source"].bytes, b"before");
+        assert_ne!(
+            captured.hash().unwrap(),
+            capture(&readable, &[], &paths, 128, &|| true)
+                .unwrap()
+                .hash()
+                .unwrap()
+        );
+        assert!(capture(&readable, &[], &paths, 1, &|| true).is_err());
+        assert!(capture(&readable, &[], &paths, 128, &|| false).is_err());
+        assert!(capture(&readable, &[root.join("source")], &paths, 128, &|| true).is_err());
+        let denied = authority(root.clone(), FileSystemAccessMode::Deny);
+        assert!(capture(&denied, &[], &paths, 128, &|| true).is_err());
+        assert!(permitted(&captured, &denied, &[]).is_err());
+        std::fs::remove_file(root.join("source")).unwrap();
+        std::os::unix::fs::symlink("elsewhere", root.join("source")).unwrap();
+        assert!(capture(&readable, &[], &paths, 128, &|| true).is_err());
+    }
+
+    #[test]
+    fn execution_receipts_reject_forged_bindings_and_false_success() {
+        let mut store = Snapshots::default();
+        let owner = caller("one", "a", 1);
+        let thread = ThreadId::new();
+        let candidate = "a".repeat(64);
+        let evidence = ResourceRef {
+            reference: "execution:one".into(),
+            sha256: "b".repeat(64),
+        };
+        let passed = json!({"exit_code":0,"signal":null,"timed_out":false,"stdout_truncated":false,"stderr_truncated":false});
+        store.record_execution(&owner, thread, candidate.clone(), evidence.clone(), &passed);
+        let attest = |store: &Snapshots,
+                      caller: &operations::Caller<'_>,
+                      thread,
+                      candidate: &str,
+                      evidence: &ResourceRef| {
+            store.attest_execution(
+                caller,
+                thread,
+                candidate,
+                evidence,
+                codex_omd::ReceiptOutcome::Pass,
+            )
+        };
+        assert!(attest(&store, &owner, thread, &candidate, &evidence).is_ok());
+        assert!(
+            attest(
+                &store,
+                &caller("two", "a", 1),
+                thread,
+                &candidate,
+                &evidence
+            )
+            .is_err()
+        );
+        assert!(
+            attest(
+                &store,
+                &caller("one", "b", 1),
+                thread,
+                &candidate,
+                &evidence
+            )
+            .is_err()
+        );
+        assert!(
+            attest(
+                &store,
+                &caller("one", "a", 2),
+                thread,
+                &candidate,
+                &evidence
+            )
+            .is_err()
+        );
+        assert!(attest(&store, &owner, ThreadId::new(), &candidate, &evidence).is_err());
+        assert!(attest(&store, &owner, thread, &"c".repeat(64), &evidence).is_err());
+        assert!(
+            attest(
+                &store,
+                &owner,
+                thread,
+                &candidate,
+                &ResourceRef {
+                    sha256: "c".repeat(64),
+                    ..evidence.clone()
+                }
+            )
+            .is_err()
+        );
+        for (key, value) in [
+            ("exit_code", json!(1)),
+            ("timed_out", json!(true)),
+            ("stdout_truncated", json!(true)),
+            ("signal", json!("9")),
+        ] {
+            let mut failed = passed.clone();
+            failed[key] = value;
+            store.record_execution(&owner, thread, candidate.clone(), evidence.clone(), &failed);
+            assert!(attest(&store, &owner, thread, &candidate, &evidence).is_err());
+            assert!(
+                store
+                    .attest_execution(
+                        &owner,
+                        thread,
+                        &candidate,
+                        &evidence,
+                        codex_omd::ReceiptOutcome::Fail
+                    )
+                    .is_ok()
+            );
+        }
+        store.record_execution(&owner, thread, candidate.clone(), evidence.clone(), &passed);
+        for index in 0..EXECUTION_LIMIT {
+            let other = ResourceRef {
+                reference: format!("execution:other-{index}"),
+                sha256: "d".repeat(64),
+            };
+            store.record_execution(&owner, thread, candidate.clone(), other, &passed);
+        }
+        assert_eq!(store.executions.len(), EXECUTION_LIMIT);
+        assert!(attest(&store, &owner, thread, &candidate, &evidence).is_err());
+        store.remove_thread(thread);
+        assert!(store.executions.is_empty());
+    }
+}
