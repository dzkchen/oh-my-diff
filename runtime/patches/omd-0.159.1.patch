+pub(crate) const LIFECYCLE_EVENTS: &[&str] = &[
+    "start",
+    "resume",
+    "idle",
+    "stop",
+    "turn_start",
+    "turn_end",
+    "tool_result",
+    "workspace_change",
+    "workspace_write",
+    "compaction_start",
+    "compaction_end",
+    "agent_end",
+];
+
+pub(crate) fn event_allows(event: &str, operation: &str) -> bool {
+    LIFECYCLE_EVENTS.contains(&event)
+        || event == "workspace_pre_rename"
+            && matches!(
+                operation,
+                "workspace.read" | "workspace.stat" | "workspace.list"
+            )
+}
