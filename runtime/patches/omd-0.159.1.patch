+/// Components without a height share the rows a layout region leaves after its fixed components.
+fn fill_heights(components: &mut [ModComponent], width: u16, rows: u16) {
+    let fills = |component: &ModComponent| {
+        matches!(
+            component,
+            ModComponent::Terminal { height: None, .. }
+                | ModComponent::Document { height: None, .. }
+                | ModComponent::Diff { height: None, .. }
+                | ModComponent::List { height: None, .. }
+        )
+    };
+    let count = components
+        .iter()
+        .filter(|component| fills(component))
+        .count();
+    if count == 0 {
+        return;
+    }
+    let fixed = components
+        .iter()
+        .filter(|component| !fills(component))
+        .cloned()
+        .collect::<Vec<_>>();
+    let share = rows.saturating_sub(component_height(&fixed, width))
+        / u16::try_from(count).unwrap_or(u16::MAX);
+    for component in components {
+        match component {
+            ModComponent::Terminal { height, .. } if height.is_none() => {
+                *height = Some(share.saturating_sub(1).max(2));
+            }
+            ModComponent::Document { height, .. }
+            | ModComponent::Diff { height, .. }
+            | ModComponent::List { height, .. }
+                if height.is_none() =>
+            {
+                *height = Some(share.max(1));
+            }
+            _ => {}
+        }
+    }
+}
+
+pub(crate) fn render_owned(
+    screen: Rect,
+    chat: Rect,
+    transcript: Rect,
+    empty_transcript: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+) {
+    render_backdrop(
+        transcript,
+        empty_transcript,
+        buffer,
+        snapshot,
+        crate::mod_backdrop_sync::image_active(),
+    );
+    let Some(placement) = placement(screen, snapshot) else {
+        render(screen, chat, buffer, snapshot);
+        return;
+    };
+    let style = panel_style(&snapshot.view);
+    let mut interaction = INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    interaction.targets.clear();
+    interaction.key_panes.clear();
+    interaction.order.clear();
+    interaction.hitboxes.clear();
+    interaction.owners = snapshot
+        .owner
+        .iter()
+        .chain(snapshot.contributors.iter())
+        .cloned()
+        .collect();
+    for region in &placement.regions {
+        let Some(name) = region.content.strip_prefix("site:") else {
+            continue;
+        };
+        let mut components = site(&snapshot.view, name)
+            .map(|site| site.components.clone())
+            .unwrap_or_default();
+        fill_heights(
+            &mut components,
+            region.area.width.saturating_sub(2),
+            region.area.height.saturating_sub(2),
+        );
+        render_site(
+            region.area,
+            &components,
+            style,
+            buffer,
+            &mut interaction,
+            Some(
+                Block::default()
+                    .borders(Borders::ALL)
+                    .border_type(border_type(&snapshot.view.theme))
+                    .title(name.to_owned()),
+            ),
+            false,
+        );
+    }
+    for bar in &placement.tabs {
+        let spans = crate::mod_layout::tab_line(bar)
+            .into_iter()
+            .map(|(title, active)| {
+                if active {
+                    ratatui::text::Span::styled(title, crate::style::accent_style().bold())
+                } else {
+                    ratatui::text::Span::styled(title, style.dim())
+                }
+            })
+            .collect::<Vec<_>>();
+        Paragraph::new(Line::from(spans)).render(bar.area, buffer);
+    }
+    render_dialog(screen, snapshot, style, buffer, &mut interaction);
+    highlight_focus(buffer, &interaction);
+}
+
+pub(crate) fn footer_lines(width: u16) -> Vec<Line<'static>> {
+    let snapshot = snapshot();
+    let style = panel_style(&snapshot.view);
+    if let Some(site) = site(&snapshot.view, "above_composer") {
+        let mut interaction = INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        return component_rows(&site.components, width, &mut interaction, 0)
+            .into_iter()
+            .map(|row| row.line.patch_style(style))
+            .collect();
+    }
+    let Some(footer) = &snapshot.view.footer else {
+        return Vec::new();
+    };
+    panel_lines(footer)
+        .into_iter()
+        .map(|line| line.patch_style(style))
+        .collect()
+}
