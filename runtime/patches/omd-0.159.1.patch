+        buffer[(1, 0)].set_char('X');
+        buffer[(2, 1)].set_bg(Color::Blue);
+        fill_ascii(&mut buffer, area, "ab\ncd");
+        let symbols: Vec<String> = (0..3)
+            .map(|y| {
+                (0..4)
+                    .map(|x| buffer[(x, y)].symbol().to_string())
+                    .collect()
+            })
+            .collect();
+        assert_eq!(symbols, [" X  ", "    ", "abab"]);
+        assert!(buffer[(0, 2)].modifier.contains(Modifier::DIM));
+    }
+    #[test]
+    fn transforms_place_tile_tint_and_gloss_without_mutating_source() {
+        let settings = |value| serde_json::from_value::<ModImageBackdrop>(value).unwrap();
+        let reference = serde_json::json!({"reference":"r","sha256":"0".repeat(64)});
+        let area = Rect::new(0, 0, 4, 2);
+        let centered =
+            settings(serde_json::json!({"resource":reference,"position":"center","dim":0}));
+        let image =
+            image::load_from_memory(&transformed_png(&png(), &centered, area, None).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0[3], 0);
+        assert_eq!(image.get_pixel(15, 15).0, [200, 100, 50, 255]);
+        let tile = settings(
+            serde_json::json!({"resource":reference,"position":"tile","dim":0.5,"tint":"#ffffff","opacity":0.5}),
+        );
+        let image = image::load_from_memory(&transformed_png(&png(), &tile, area, None).unwrap())
+            .unwrap()
+            .to_rgba8();
+        assert_eq!(image.get_pixel(0, 0).0, [228, 178, 153, 128]);
+        let paint = serde_json::from_value::<ModSurfacePaint>(
+            serde_json::json!({"top":"#ffffff","bottom":"#000000","opacity":0.5}),
+        )
+        .unwrap();
+        let gloss =
+            image::load_from_memory(&transformed_png(&png(), &tile, area, Some(&paint)).unwrap())
+                .unwrap()
+                .to_rgba8();
+        assert!(gloss.get_pixel(0, 0).0[0] > gloss.get_pixel(0, 31).0[0]);
+        assert_eq!(
+            image::load_from_memory(&png())
+                .unwrap()
+                .to_rgba8()
+                .get_pixel(0, 0)
+                .0,
+            [200, 100, 50, 255]
+        );
+    }
+
+    #[test]
+    fn decoder_rejects_oversized_dimensions_before_pixel_allocation() {
+        let image = image::RgbaImage::new(BACKDROP_IMAGE_PIXELS + 1, 1);
+        let mut bytes = Vec::new();
+        image
+            .write_to(&mut Cursor::new(&mut bytes), ImageFormat::Png)
+            .unwrap();
+        assert!(decode_image(&bytes).is_err());
+        assert!(decode_image(b"GIF89a").is_err());
+        assert!(decode_image(&vec![0; 8 * 1024 * 1024 + 1]).is_err());
+    }
+
+    #[test]
+    fn ascii_positions_scale_and_preserve_styled_rows() {
+        let area = Rect::new(0, 0, 6, 6);
+        let mut buffer = Buffer::empty(area);
+        buffer[(1, 1)].set_char('X');
+        buffer[(2, 2)].set_bg(Color::Blue);
+        let settings = serde_json::from_value(
+            serde_json::json!({"text":"ab\ncd","position":"center","dim":0.2}),
+        )
+        .unwrap();
+        fill_ascii_configured(&mut buffer, area, area, &settings);
+        assert_eq!(buffer[(0, 0)].symbol(), " ");
+        assert_eq!(buffer[(1, 1)].symbol(), "X");
+        assert_eq!(buffer[(2, 1)].symbol(), " ");
+        assert_eq!(buffer[(2, 3)].symbol(), "c");
+        assert_eq!(buffer[(3, 3)].symbol(), "d");
+        assert_eq!(buffer[(2, 2)].symbol(), " ");
+    }
+
+    #[test]
+    fn ascii_clip_preserves_full_area_placement_and_protected_blank_rows() {
+        let area = Rect::new(0, 0, 4, 4);
+        let clip = Rect::new(0, 2, 4, 2);
+        for position in ["tile", "center"] {
+            let mut buffer = Buffer::empty(area);
+            let settings =
+                serde_json::from_value(serde_json::json!({"text":"ab\ncd","position":position}))
+                    .unwrap();
+            fill_ascii_configured(&mut buffer, area, clip, &settings);
+            let rows = (area.top()..area.bottom())
+                .map(|y| {
+                    (area.left()..area.right())
+                        .map(|x| buffer[(x, y)].symbol())
+                        .collect::<String>()
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(
+                rows,
+                if position == "tile" {
+                    ["    ", "    ", "abab", "cdcd"]
+                } else {
+                    ["    ", "    ", " cd ", "    "]
+                }
+            );
+        }
+    }
+}
diff --git a/codex-rs/tui/src/mod_backdrop_sync.rs b/codex-rs/tui/src/mod_backdrop_sync.rs
new file mode 100644
index 000000000..03ce15a97
--- /dev/null
+++ b/codex-rs/tui/src/mod_backdrop_sync.rs
@@ -0,0 +1,165 @@
+use crate::mod_backdrop::BackdropEnvironment;
+use codex_omd::ModBackdrop;
+use codex_omd::ModViewSnapshot;
+use codex_terminal_detection::TerminalName;
+use ratatui::layout::Rect;
+use std::io::Write;
+use std::sync::Mutex;
+
+const IMAGE_ID: u32 = 7_314;
+
+struct Placed {
+    key: Option<(String, Rect)>,
+    decided: Option<(String, Option<Vec<u8>>)>,
+}
+
+static PLACED: Mutex<Placed> = Mutex::new(Placed {
+    key: None,
+    decided: None,
+});
+
+fn placed() -> std::sync::MutexGuard<'static, Placed> {
+    PLACED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+pub(crate) fn image_active() -> bool {
+    placed().key.is_some()
+}
+
+fn environment(columns: u16, animations: bool, owned_viewport: bool) -> BackdropEnvironment {
+    let terminal = codex_terminal_detection::terminal_info();
+    BackdropEnvironment {
+        kitty_graphics: matches!(
+            terminal.name,
+            TerminalName::Kitty | TerminalName::Ghostty | TerminalName::WezTerm
+        ),
+        remote: terminal.multiplexer.is_some()
+            || ["SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY"]
+                .iter()
+                .any(|name| std::env::var_os(name).is_some()),
+        no_color: std::env::var_os("NO_COLOR").is_some(),
+        reduced_motion: !animations,
+        columns,
+        owned_viewport,
+    }
+}
+
+fn load(
+    snapshot: &ModViewSnapshot,
+    reference: &codex_omd::resource_data::ResourceRef,
+) -> Option<Vec<u8>> {
+    let thread = crate::mod_surface::current_thread();
+    snapshot
+        .owner
+        .iter()
+        .chain(snapshot.contributors.iter())
+        .find_map(|owner| {
+            let (host, _) = crate::mod_surface::resource_binding(owner, thread.as_deref()).ok()?;
+            let resources = host.resources();
+            let record = resources.load(reference, "evidence").ok()?;
+            resources.blob(record["blob"].as_str()?).ok()
+        })
+}
+
+fn write(sequence: &str) {
+    let mut stdout = std::io::stdout();
+    let _ = stdout.write_all(sequence.as_bytes());
+    let _ = stdout.flush();
+}
+
+fn clear(placed: &mut Placed) {
+    if placed.key.take().is_some() {
+        write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    }
+}
+
+pub(crate) fn sync(snapshot: &ModViewSnapshot, area: Rect, animations: bool, owned_viewport: bool) {
+    let mut placed = placed();
+    let Some(ModBackdrop::Image { image, .. }) = snapshot.view.backdrop.as_ref() else {
+        clear(&mut placed);
+        return;
+    };
+    let environment = environment(area.width, animations, owned_viewport);
+    let paint = image.overlay.as_ref();
+    let key = format!(
+        "{}:{}:{area:?}:{environment:?}:{paint:?}",
+        snapshot.epoch,
+        serde_json::to_string(image).unwrap_or_default()
+    );
+    if placed.key.as_ref() == Some(&(key.clone(), area)) {
+        return;
+    }
+    let png = match placed.decided.as_ref() {
+        Some((decided, png)) if *decided == key => png.clone(),
+        _ => {
+            let png = (environment.graphics_eligible() && !area.is_empty())
+                .then(|| load(snapshot, &image.resource))
+                .flatten()
+                .and_then(|bytes| {
+                    crate::mod_backdrop::transformed_png(&bytes, image, area, paint).ok()
+                });
+            placed.decided = Some((key.clone(), png.clone()));
+            png
+        }
+    };
+    let Some(png) = png.filter(|_| area.width >= crate::mod_backdrop::BACKDROP_MIN_COLUMNS) else {
+        clear(&mut placed);
+        return;
+    };
+    let sequence =
+        crate::mod_backdrop::kitty_place_below_text(&png, area.width, area.height, IMAGE_ID)
+            .replacen(
+                "\x1b[1;1H",
+                &format!("\x1b[{};{}H", area.y + 1, area.x + 1),
+                1,
+            );
+    write(&crate::mod_backdrop::kitty_remove(IMAGE_ID));
+    write(&sequence);
+    placed.key = Some((key, area));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn graphics_eligibility_uses_production_protocol_remote_motion_color_and_ownership() {
+        let local = BackdropEnvironment {
+            kitty_graphics: true,
+            columns: 80,
+            owned_viewport: true,
+            ..Default::default()
+        };
+        assert!(local.graphics_eligible());
+        for fallback in [
+            BackdropEnvironment {
+                kitty_graphics: false,
+                ..local
+            },
+            BackdropEnvironment {
+                remote: true,
+                ..local
+            }, // SSH and multiplexers share the remote gate.
+            BackdropEnvironment {
+                no_color: true,
+                ..local
+            },
+            BackdropEnvironment {
+                reduced_motion: true,
+                ..local
+            },
+            BackdropEnvironment {
+                columns: 40,
+                ..local
+            },
+            BackdropEnvironment {
+                owned_viewport: false,
+                ..local
+            },
+        ] {
+            assert!(!fallback.graphics_eligible(), "{fallback:?}");
+        }
+    }
+}
diff --git a/codex-rs/tui/src/mod_components.rs b/codex-rs/tui/src/mod_components.rs
new file mode 100644
index 000000000..c13c1efb3
--- /dev/null
+++ b/codex-rs/tui/src/mod_components.rs
@@ -0,0 +1,374 @@
+use crate::mod_document::DiffKind;
+use crate::mod_document::DocumentEvent;
+use crate::mod_document::DocumentKey;
+use crate::mod_document::DocumentView;
+use codex_omd::ModFind;
+use codex_omd::ModRange;
+use codex_omd::ModSpan;
+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+const DEFAULT_HEIGHT: usize = 12;
+
+pub(crate) enum Content<'a> {
+    Spans(&'a [Vec<ModSpan>]),
+    Source(&'a codex_omd::resource_data::ResourceRef),
+    Diff(&'a str),
+}
+
+#[derive(Default)]
+struct Document {
+    view: DocumentView,
+    key: String,
+    lines: Arc<Vec<String>>,
+    styles: Arc<Vec<Style>>,
+    anchors: Arc<Vec<Option<String>>>,
+    applied_find: Option<ModFind>,
+    applied_selection: Option<ModRange>,
+    height: usize,
+}
+
+static DOCUMENTS: Mutex<BTreeMap<String, Document>> = Mutex::new(BTreeMap::new());
+
+fn documents() -> std::sync::MutexGuard<'static, BTreeMap<String, Document>> {
+    DOCUMENTS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn span_text(spans: &[ModSpan]) -> String {
+    spans.iter().map(|span| span.text.as_str()).collect()
+}
+
+fn resolve(
+    reference: &codex_omd::resource_data::ResourceRef,
+    owners: &[String],
+) -> Result<Vec<String>, String> {
+    let thread = crate::mod_surface::current_thread();
+    let mut last = "resource_unavailable".to_owned();
+    for owner in owners {
+        let host = match crate::mod_surface::resource_binding(owner, thread.as_deref()) {
+            Ok((host, _)) => host,
+            Err(error) => {
+                last = error;
+                continue;
+            }
+        };
+        let resources = host.resources();
+        let record = match resources.load(reference, "evidence") {
+            Ok(record) => record,
+            Err(error) => {
+                last = error.to_string();
+                continue;
+            }
+        };
+        let text = match (record["blob"].as_str(), &record["content"]) {
+            (Some(blob), _) => {
+                String::from_utf8_lossy(&resources.blob(blob).map_err(|error| error.to_string())?)
+                    .into_owned()
+            }
+            (None, Value::String(text)) => text.clone(),
+            (None, value) => serde_json::to_string_pretty(value).unwrap_or_default(),
+        };
+        return Ok(text
+            .lines()
+            .take(crate::mod_document::DOCUMENT_LINES)
+            .map(str::to_owned)
+            .collect());
+    }
+    Err(last)
+}
+
+fn diff_style(kind: DiffKind) -> Style {
+    match kind {
+        DiffKind::File => Style::default().bold(),
+        DiffKind::Hunk => Style::default().cyan(),
+        DiffKind::Added => Style::default().green(),
+        DiffKind::Removed => Style::default().red(),
+        DiffKind::Context => Style::default(),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn load_blob(
+    reference: &codex_omd::resource_data::ResourceRef,
+    owners: &[String],
+) -> Option<Vec<u8>> {
+    let thread = crate::mod_surface::current_thread();
+    owners.iter().find_map(|owner| {
+        let (host, _) = crate::mod_surface::resource_binding(owner, thread.as_deref()).ok()?;
+        let resources = host.resources();
+        let record = resources.load(reference, "evidence").ok()?;
+        resources.blob(record["blob"].as_str()?).ok()
+    })
+}
+
+static IMAGES: Mutex<BTreeMap<String, Vec<Line<'static>>>> = Mutex::new(BTreeMap::new());
+
+pub(crate) fn image_rows(
+    reference: &codex_omd::resource_data::ResourceRef,
+    alt: &str,
+    width: u16,
+    height: u16,
+    owners: &[String],
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    if std::env::var_os("NO_COLOR").is_some() || width < 4 {
+        return vec![Line::from(format!("{prefix}[image: {alt}]")).dim()];
+    }
+    let key = format!("{}:{width}:{height}", reference.sha256);
+    let mut images = IMAGES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(rows) = images.get(&key) {
+        return rows.clone();
+    }
+    let decoded = load_blob(reference, owners)
+        .and_then(|bytes| image::load_from_memory(&bytes).ok())
+        .filter(|image| image.width() <= 8192 && image.height() <= 8192);
+    let Some(decoded) = decoded else {
+        return vec![Line::from(format!("{prefix}[image unavailable: {alt}]")).dim()];
+    };
+    let pixels = decoded
+        .resize(
+            u32::from(width),
+            u32::from(height) * 2,
+            image::imageops::FilterType::Triangle,
+        )
+        .to_rgb8();
+    #[allow(clippy::disallowed_methods)]
+    let color = |x: u32, y: u32| {
+        let [r, g, b] = pixels
+            .get_pixel_checked(x, y)
+            .map_or([0, 0, 0], |pixel| pixel.0);
+        ratatui::style::Color::Rgb(r, g, b)
+    };
+    let rows = (0..pixels.height().div_ceil(2))
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend((0..pixels.width()).map(|x| {
+                Span::styled(
+                    "▀",
+                    Style::default()
+                        .fg(color(x, row * 2))
+                        .bg(color(x, row * 2 + 1)),
+                )
+            }));
+            Line::from(spans)
+        })
+        .collect::<Vec<_>>();
+    if images.len() >= 32 {
+        images.clear();
+    }
+    images.insert(key, rows.clone());
+    rows
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rows(
+    id: &str,
+    content: Content<'_>,
+    anchors: &[String],
+    selected: Option<ModRange>,
+    find: Option<&ModFind>,
+    height: Option<u16>,
+    owners: &[String],
+    focused: bool,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let key = match &content {
+        Content::Spans(lines) => {
+            format!("spans:{}", lines.len())
+                + &lines.iter().map(|line| span_text(line)).collect::<String>()
+        }
+        Content::Source(reference) => format!("source:{}", reference.sha256),
+        Content::Diff(unified) => format!("diff:{unified}"),
+    };
+    let mut documents = documents();
+    let document = documents.entry(id.to_owned()).or_default();
+    if document.key != key {
+        let (lines, styles, parsed_anchors) = match content {
+            Content::Spans(lines) => (
+                lines.iter().map(|line| span_text(line)).collect::<Vec<_>>(),
+                vec![Style::default(); lines.len()],
+                (0..lines.len())
+                    .map(|index| anchors.get(index).cloned())
+                    .collect::<Vec<_>>(),
+            ),
+            Content::Source(reference) => match resolve(reference, owners) {
+                Ok(lines) => {
+                    let count = lines.len();
+                    (
+                        lines,
+                        vec![Style::default(); count],
+                        (0..count)
+                            .map(|index| anchors.get(index).cloned())
+                            .collect(),
+                    )
+                }
+                Err(error) => (
+                    vec![format!("unavailable: {error}")],
+                    vec![Style::default().dim()],
+                    vec![None],
+                ),
+            },
+            Content::Diff(unified) => {
+                let parsed = crate::mod_document::diff_lines(unified);
+                (
+                    parsed.iter().map(|(_, text, _)| text.clone()).collect(),
+                    parsed
+                        .iter()
+                        .map(|(kind, _, _)| diff_style(*kind))
+                        .collect(),
+                    parsed.into_iter().map(|(_, _, anchor)| anchor).collect(),
+                )
+            }
+        };
+        *document = Document {
+            key,
+            lines: Arc::new(lines),
+            styles: Arc::new(styles),
+            anchors: Arc::new(parsed_anchors),
+            ..Document::default()
+        };
+    }
+    if selected != document.applied_selection {
+        document.applied_selection = selected;
+        if let Some(range) = selected {
+            document.view.anchor = Some(range.start);
+            document.view.cursor = range.end;
+        }
+    }
+    if find != document.applied_find.as_ref() {
+        document.applied_find = find.cloned();
+        let count = match find {
+            Some(find) => {
+                document
+                    .view
+                    .set_find(&document.lines, &find.query, find.regex, find.case)
+            }
+            None => {
+                document.view.find = None;
+                Ok(0)
+            }
+        };
+        let payload = match count {
+            Ok(matches) => json!({"component": id, "kind": "find", "matches": matches}),
+            Err(error) => json!({"component": id, "kind": "find", "matches": 0, "error": error}),
+        };
+        crate::mod_surface::terminal_event("component_event", payload);
+    }
+    let height = height.map_or(DEFAULT_HEIGHT, usize::from);
+    document.height = height;
+    let total = document.lines.len();
+    if total == 0 {
+        return vec![Line::from(format!("{prefix}(empty)")).dim()];
+    }
+    let window = document.view.window(total, height);
+    let selection = document.view.selection();
+    let marker = if crate::omd::ligatures_enabled() {
+        "› "
+    } else {
+        "> "
+    };
+    let matches = document
+        .view
+        .find
+        .as_ref()
+        .map(|find| {
+            find.matches
+                .iter()
+                .map(|(line, _, _)| *line)
+                .collect::<std::collections::BTreeSet<_>>()
+        })
+        .unwrap_or_default();
+    window
+        .map(|index| {
+            let cursor = index == document.view.cursor;
+            let lead = if focused && cursor { marker } else { "  " };
+            let mut style = document.styles[index];
+            if selection.contains(&index) && (document.view.anchor.is_some() || focused && cursor) {
+                style = style.reversed();
+            }
+            if matches.contains(&index) {
+                style = style.underlined();
+            }
+            Line::from(vec![
+                Span::raw(format!("{prefix}{lead}")),
+                Span::styled(document.lines[index].clone(), style),
+            ])
+        })
+        .collect()
+}
+
+pub(crate) fn height(id: &str, total_hint: usize, height: Option<u16>) -> usize {
+    let height = height.map_or(DEFAULT_HEIGHT, usize::from);
+    let total = documents()
+        .get(id)
+        .map(|document| document.lines.len())
+        .unwrap_or(total_hint);
+    total.clamp(1, height)
+}
+
+pub(crate) fn key(
+    code: crossterm::event::KeyCode,
+    modifiers: crossterm::event::KeyModifiers,
+) -> Option<DocumentKey> {
+    use crossterm::event::KeyCode;
+    use crossterm::event::KeyModifiers;
+    Some(match (code, modifiers) {
+        (KeyCode::Up, KeyModifiers::NONE) => DocumentKey::Up,
+        (KeyCode::Down, KeyModifiers::NONE) => DocumentKey::Down,
+        (KeyCode::Up, KeyModifiers::SHIFT) => DocumentKey::ExtendUp,
+        (KeyCode::Down, KeyModifiers::SHIFT) => DocumentKey::ExtendDown,
+        (KeyCode::PageUp, _) => DocumentKey::PageUp,
+        (KeyCode::PageDown, _) => DocumentKey::PageDown,
+        (KeyCode::Home, _) => DocumentKey::Top,
+        (KeyCode::End, _) => DocumentKey::Bottom,
+        (KeyCode::Enter, KeyModifiers::NONE) => DocumentKey::Activate,
+        (KeyCode::Char('n'), KeyModifiers::NONE) => DocumentKey::FindNext,
+        (KeyCode::Char('N'), KeyModifiers::SHIFT | KeyModifiers::NONE) => DocumentKey::FindPrevious,
+        (KeyCode::Esc, _) => DocumentKey::Escape,
+        _ => return None,
+    })
+}
+
+pub(crate) fn handle(id: &str, key: DocumentKey) -> Option<(String, Option<String>)> {
+    let mut documents = documents();
+    let document = documents.get_mut(id)?;
+    let total = document.lines.len();
+    let height = document.height;
+    let event = document.view.handle(key, total, height)?;
+    let anchor = |line: usize| document.anchors.get(line).cloned().flatten();
+    let (payload, argument) = match event {
+        DocumentEvent::Select { start, end } => (
+            json!({"component": id, "kind": "select", "range": {"start": start, "end": end}, "anchor": anchor(start)}),
+            None,
+        ),
+        DocumentEvent::Activate { line } => {
+            let anchor = anchor(line);
+            (
+                json!({"component": id, "kind": "activate", "range": {"start": line, "end": line}, "anchor": anchor}),
+                Some(anchor.unwrap_or_else(|| (line + 1).to_string())),
+            )
+        }
+    };
+    drop(documents);
+    crate::mod_surface::terminal_event("component_event", payload);
+    Some((id.to_owned(), argument))
+}
+
+pub(crate) fn retain(ids: &std::collections::BTreeSet<String>) {
+    documents().retain(|id, _| ids.contains(id));
+}
