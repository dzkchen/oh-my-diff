+#[test]
+fn approval_decisions_deny_first_and_fail_closed_to_ask() {
+    use codex_extension_api::ApprovalGate;
+    let ok = |id: &str, value: Value| (id.to_owned(), Ok(value));
+    assert_eq!(
+        approvals::decide(vec![ok("a", Value::Null)]),
+        (ApprovalGate::Continue, None)
