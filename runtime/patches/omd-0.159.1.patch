+enum Access<'a> {
+    Held(&'a mut ModHost),
+    Shared(&'a Mutex<ModHost>),
+}
+
+impl Access<'_> {
+    fn with<T>(&mut self, run: impl FnOnce(&mut ModHost) -> Result<T>) -> Result<T> {
+        match self {
+            Access::Held(runtime) => run(runtime),
+            Access::Shared(runtime) => run(&mut *runtime
+                .lock()
+                .map_err(|_| failure("mod_runtime_poisoned"))?),
+        }
+    }
+}
