diff --git a/codex-rs/tui/src/chatwidget/mod_commands.rs b/codex-rs/tui/src/chatwidget/mod_commands.rs
new file mode 100644
index 000000000..60e14484a
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/mod_commands.rs
@@ -0,0 +1,197 @@
+use super::*;
+use crate::mod_runtime::ModCommandResult;
+use crate::mod_runtime::ModSlashCommand;
+use ratatui::text::Line;
+
+impl ChatWidget {
+    pub(crate) fn mod_context(&self) -> crate::mod_runtime::ModContext {
+        let policy = self
+            .config
+            .permissions
+            .effective_permission_profile()
+            .materialize_project_roots_with_workspace_roots(std::slice::from_ref(&self.config.cwd))
+            .file_system_sandbox_policy();
+        crate::mod_runtime::ModContext {
+            thread_id: self.thread_id,
+            repository: self.config.cwd.to_path_buf(),
+            policy,
+        }
+    }
+
+    pub(crate) fn run_mod_command(&mut self, command: ModSlashCommand, args: String) {
+        let tx = self.app_event_tx.clone();
+        let invocation = command.invocation.clone();
+        let context = self.mod_context();
+        let changed = crate::mod_runtime::synchronize_context(context.clone());
+        if changed {
+            crate::mod_ui::invalidate_context();
+        }
+        let token = crate::mod_runtime::begin(context);
+        self.add_info_message(format!("Running /{invocation}"), None);
+        std::thread::spawn(move || {
+            let result = crate::mod_runtime::run(&command.target, &args, &token);
+            tx.send(AppEvent::ModCommandFinished {
+                invocation,
+                token,
+                result,
+            });
+        });
+    }
+
+    pub(crate) fn on_mod_command_finished(
+        &mut self,
+        invocation: String,
+        result: Result<ModCommandResult, String>,
+    ) {
+        let ModCommandResult { outcome, preview } = match result {
+            Ok(result) => result,
+            Err(error) => {
+                self.add_error_message(format!("/{invocation} failed: {error}"));
+                return;
+            }
+        };
+        if let Some(display) = outcome.display {
+            let mut lines = vec![Line::from(format!("• /{invocation}")).bold()];
+            lines.extend(display.lines().map(|line| Line::from(format!("  {line}"))));
+            self.add_plain_history_lines(lines);
+        }
+        if let Some(insert) = outcome.insert {
+            if !self.bottom_pane.composer_is_empty() {
+                self.insert_str("\n");
+            }
+            self.insert_str(&insert);
+        }
+        if let Some(submit) = outcome.submit {
+            self.submit_mod_text(submit);
+        }
+        if let Some(preview) = preview {
+            crate::mod_ui::preview(preview);
+            self.refresh_status_line();
+        }
+        self.request_redraw();
+    }
+
+    pub(crate) fn show_mod_secret_prompt(&mut self, view: crate::bottom_pane::SecretPromptView) {
+        self.bottom_pane.show_view(Box::new(view));
+        self.request_redraw();
+    }
+
+    pub(crate) fn mod_view_state(&self) -> (usize, Option<&'static str>) {
+        self.bottom_pane.view_stack_state()
+    }
+
+    pub(crate) fn mod_composer_read(&self) -> serde_json::Value {
+        let attachments = self
+            .bottom_pane
+            .composer_local_image_paths()
+            .into_iter()
+            .map(|path| {
+                serde_json::json!({"kind": "image", "label": path
+                    .file_name()
+                    .map(|name| name.to_string_lossy().into_owned())
+                    .unwrap_or_default()})
+            })
+            .collect::<Vec<_>>();
+        serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor(), "attachments": attachments})
+    }
+
+    pub(crate) fn mod_composer_write(
+        &mut self,
+        arguments: &serde_json::Value,
+        attachments: Vec<std::path::PathBuf>,
+    ) -> Result<serde_json::Value, String> {
+        let object = arguments
+            .as_object()
+            .filter(|object| {
+                object
+                    .keys()
+                    .all(|key| matches!(key.as_str(), "text" | "insert" | "attach"))
+            })
+            .ok_or("composer_write_arguments_invalid")?;
+        let text = |key: &str| match object.get(key) {
+            None => Ok(None),
+            Some(serde_json::Value::String(text)) if text.len() <= 65_536 => Ok(Some(text.clone())),
+            Some(_) => Err(format!("composer_write_{key}_invalid")),
+        };
+        let (replace, insert) = (text("text")?, text("insert")?);
+        if let Some(replace) = replace {
+            let images = self.bottom_pane.composer_local_image_paths();
+            self.bottom_pane
+                .set_composer_text(replace, Vec::new(), images);
+        }
+        if let Some(insert) = insert {
+            self.insert_str(&insert);
+        }
+        for path in attachments {
+            self.attach_image(path);
+        }
+        self.request_redraw();
+        Ok(serde_json::json!({"text": self.bottom_pane.composer_text(),
+            "cursor": self.bottom_pane.composer_current_cursor()}))
+    }
+
+    pub(crate) fn mod_invoke_builtin(
+        &mut self,
+        arguments: &serde_json::Value,
+    ) -> Result<serde_json::Value, String> {
+        let name = arguments["command"]
+            .as_str()
+            .ok_or("builtins_command_required")?
+            .trim_start_matches('/');
+        let command = <crate::slash_command::SlashCommand as std::str::FromStr>::from_str(name)
+            .map_err(|_| format!("builtins_command_unknown: {name}"))?;
+        use crate::slash_command::SlashCommand;
+        if matches!(
+            command,
+            SlashCommand::Permissions
+                | SlashCommand::ElevateSandbox
+                | SlashCommand::Logout
+                | SlashCommand::Quit
+                | SlashCommand::Exit
+                | SlashCommand::TestApproval
+                | SlashCommand::Feedback
+        ) {
+            return Err(format!("builtins_command_refused: {name}"));
+        }
+        match arguments["args"].as_str().filter(|args| !args.is_empty()) {
+            Some(args) => self.dispatch_command_with_args(command, args.to_owned(), Vec::new()),
+            None => self.dispatch_command(command),
+        }
+        Ok(serde_json::json!({"invoked": true}))
+    }
+
+    pub(crate) fn add_mod_activity(&mut self, activity: codex_omd::ModActivity) {
+        let line = match activity.status.as_str() {
+            "completed" => format!("• Ran {} ({})", activity.label, activity.tool),
+            status => format!("• {} {status} ({})", activity.label, activity.tool),
+        };
+        self.add_plain_history_lines(vec![Line::from(line).dim()]);
+    }
+
+    pub(crate) fn apply_mod_placeholder(&mut self, placeholder: Option<String>) {
+        self.normal_placeholder_text = placeholder.unwrap_or_else(|| {
+            if crate::omd::terminal_active() {
+                "Ask Oh My Diff to do anything".to_string()
+            } else {
+                super::PLACEHOLDER.to_string()
+            }
+        });
+        if !self.active_side_conversation && !self.blocks_direct_input {
+            self.bottom_pane
+                .set_placeholder_text(self.normal_placeholder_text.clone());
+        }
+    }
+
+    pub(crate) fn submit_mod_text(&mut self, text: String) {
+        let user_message = UserMessage::from(text);
+        if self.is_session_configured() && !self.turn_lifecycle.agent_turn_running {
+            let _ = self.submit_user_message_with_shell_escape_policy(
+                user_message,
+                ShellEscapePolicy::Disallow,
+            );
+        } else {
+            self.queue_user_message(user_message);
+        }
+    }
+}
