+        let records = Arc::new(std::sync::Mutex::new(Vec::new()));
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.tool_lifecycle_contributor(Arc::new(ModInterceptionFixture { deny }));
+        builder.tool_lifecycle_contributor(Arc::new(ToolLifecycleRecorder {
+            records: records.clone(),
+        }));
+        session.services.extensions = Arc::new(builder.build());
+        let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
+            tool_name: codex_tools::ToolName::plain("replacement"),
+            result: LifecycleTestResult::Ok { success: true },
+        }) as Arc<dyn CoreToolRuntime>]);
+        let result = registry
+            .dispatch_any_with_state(
+                test_invocation(
+                    Arc::new(session),
+                    Arc::new(turn),
+                    "mod-call",
+                    codex_tools::ToolName::plain("original"),
+                ),
+                None,
+            )
+            .await;
+        let records = records.lock().unwrap();
+        if deny {
+            assert_eq!(result.err().unwrap().to_string(), "mod_fixture_denial");
+            assert_eq!(
+                *records,
+                vec![RecordedToolLifecycle::Finish {
+                    call_id: "mod-call".into(),
+                    tool_name: codex_tools::ToolName::plain("original"),
+                    outcome: ToolCallOutcome::Blocked
+                }]
+            );
+        } else {
+            let output = result.unwrap();
+            assert_eq!(
+                output.payload,
+                ToolPayload::Function {
+                    arguments: "{\"changed\":true}".into()
+                }
+            );
+            assert_eq!(records.len(), 2);
+            assert!(
+                matches!(&records[0], RecordedToolLifecycle::Start {tool_name,..} if tool_name.name == "replacement")
+            );
+        }
+    }
+}
+
+struct OutputReplacer {
+    replacement: Option<String>,
+}
+
+impl codex_extension_api::ToolOutputContributor for OutputReplacer {
+    fn replace_tool_output<'a>(
+        &'a self,
+        input: codex_extension_api::ToolOutputInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<String>> {
+        Box::pin(async move {
+            assert_eq!(
+                (input.call_id, input.text, input.success),
+                ("out-call", "ok", true)
+            );
+            self.replacement.clone()
+        })
+    }
+}
+
+#[tokio::test]
+async fn tool_output_contributor_replaces_model_visible_text_within_limit() {
+    let oversize = "x".repeat(codex_extension_api::tool_output_limit("ok".len()) + 1);
+    for (replacement, expected) in [
+        (Some("short".to_string()), "short"),
+        (Some(oversize), "ok"),
+        (None, "ok"),
+    ] {
+        let (mut session, turn) = crate::session::tests::make_session_and_context().await;
+        let mut builder =
+            codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+        builder.tool_output_contributor(Arc::new(OutputReplacer { replacement }));
+        session.services.extensions = Arc::new(builder.build());
+        let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
+            tool_name: codex_tools::ToolName::plain("tool"),
+            result: LifecycleTestResult::Ok { success: true },
+        }) as Arc<dyn CoreToolRuntime>]);
+        let result = registry
+            .dispatch_any_with_state(
+                test_invocation(
+                    Arc::new(session),
+                    Arc::new(turn),
+                    "out-call",
+                    codex_tools::ToolName::namespaced(DEFAULT_FUNCTION_NAMESPACE, "tool"),
+                ),
+                None,
+            )
+            .await
+            .unwrap();
+        let item = result
+            .result
+            .to_response_item(&result.call_id, &result.payload);
+        let codex_protocol::models::ResponseInputItem::FunctionCallOutput { output, .. } = item
+        else {
+            panic!("expected a function call output");
+        };
+        assert_eq!(output.body.to_text().as_deref(), Some(expected));
+        assert!(result.result.success_for_logging());
+    }
+}
