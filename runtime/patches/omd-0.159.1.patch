+impl ContextContributor for Mods {
+    fn contribute_turn_context<'a>(
+        &'a self,
+        input: TurnContextContributionInput<'a>,
+    ) -> ExtensionFuture<'a, Vec<PromptFragment>> {
+        Box::pin(async move {
+            let Some(lead) = input
+                .thread_store
+                .get::<Lead>()
+                .filter(|lead| lead.owner == "lead")
