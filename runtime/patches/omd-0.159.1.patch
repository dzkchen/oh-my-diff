+
+    #[tokio::test]
+    #[ignore = "requires local loopback access"]
+    async fn managed_python_and_bun_complete_csv_chart_without_model_reentry() {
+        let drivers = std::path::PathBuf::from(
+            std::env::var_os("CODEX_KERNEL_TEST_DRIVERS")
+                .expect("set CODEX_KERNEL_TEST_DRIVERS to a directory with python.py and bun.mjs"),
+        );
+        let configured = |name: &str, command: &[&str], file: &str| {
+            let driver = drivers.join(file);
+            let digest = format!(
+                "{:x}",
+                <sha2::Sha256 as sha2::Digest>::digest(std::fs::read(&driver).unwrap())
+            );
+            codex_features::CodeModeKernelToml {
+                name: name.into(),
+                command: command.iter().map(|arg| (*arg).to_owned()).collect(),
+                driver,
+                driver_sha256: digest,
+            }
+        };
+        let kernels = vec![
+            configured("python", &["python3", "-u", "-c"], "python.py"),
+            configured("bun", &["bun", "-e"], "bun.mjs"),
+        ];
+        let configured_kernels = kernels.clone();
+        let (session, turn, _events) =
+            crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                codex_login::CodexAuth::from_api_key("Test API Key"),
+                Vec::new(),
+                |config| {
+                    config.code_mode.kernels = configured_kernels.clone();
+                    config
+                        .set_legacy_sandbox_policy(
+                            codex_protocol::protocol::SandboxPolicy::WorkspaceWrite {
+                                writable_roots: Vec::new(),
+                                network_access: false,
+                                exclude_tmpdir_env_var: false,
+                                exclude_slash_tmp: false,
+                            },
+                        )
+                        .unwrap();
+                },
+            )
+            .await;
+        let mut registry = ToolRegistry::empty_for_test();
+        registry.add(crate::tools::handlers::ExecCommandHandler::default());
+        registry.add(crate::tools::handlers::WriteStdinHandler);
+        registry.add(Probe);
+        let router = Arc::new(ToolRouter::from_registry(
+            &turn,
+            turn.model_info(),
+            registry,
+            Vec::new(),
+            &Default::default(),
+        ));
+        let step = StepContext::for_test(Arc::clone(&turn)).with_tool_router_for_test(router);
+        let runtime = ToolCallRuntime::new(
+            Arc::clone(&session),
+            Arc::clone(&step),
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+        );
+        let manager = KernelManager::new();
+        let cell_id = CellId::new("csv-chart-cell".into());
+        let tools = vec![
+            tool("exec_command"),
+            tool("write_stdin"),
+            tool("audit_probe"),
+            definition(&kernels),
+        ];
+        let call = |language: &str, code: &str| CodeModeNestedToolCall {
+            cell_id: cell_id.clone(),
+            runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+            tool_name: ToolName::plain("kernel"),
+            tool_kind: CodeModeToolKind::Function,
+            input: Some(json!({"kernel": language, "code": code})),
+        };
+        let first = manager.run(
+            Arc::clone(&session), Arc::clone(&step), runtime.clone(),
+            call("python", "import csv, io, json\nr = json.loads(tool('audit_probe', {}))\nvalues = [int(row['total']) for row in csv.DictReader(io.StringIO(r['csv']))]\nprint(json.dumps(values))"),
+            tools.clone(), CancellationToken::new(),
+        ).await.unwrap();
+        assert_eq!(first["ok"], true);
+        assert_eq!(first["output"], "[2, 4, 3]\n");
+        let second = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call(
+                    "python",
+                    "json.loads(tool('audit_probe', {})); print(sum(values))",
+                ),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(second["ok"], true);
+        assert_eq!(second["output"], "9\n");
+        let bun_code = format!(
+            "globalThis.values={}; console.log('<svg>'+values.map(v=>'<rect height=\\\"'+(v*10)+'\\\"/>').join('')+'</svg>')",
+            first["output"].as_str().unwrap().trim(),
+        );
+        let chart = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call("bun", &bun_code),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(chart["ok"], true);
+        assert_eq!(
+            chart["output"].as_str().unwrap().matches("<rect").count(),
+            3
+        );
+        let bun_state = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime.clone(),
+                call("bun", "JSON.parse(await tool('audit_probe', {})); console.log(values.reduce((a,b)=>a+b,0))"),
+                tools.clone(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(bun_state["output"], "9\n");
+        let cancellation = CancellationToken::new();
+        let stop = cancellation.clone();
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            stop.cancel();
+        });
+        let interrupted = manager
+            .run(
+                Arc::clone(&session),
+                Arc::clone(&step),
+                runtime,
+                call("python", "import time; time.sleep(10)"),
+                tools,
+                cancellation,
+            )
+            .await;
+        assert!(interrupted.is_err());
+        assert!(!manager.live.lock().unwrap().contains_key("python"));
+        manager.shutdown(&session).await;
+        assert!(!manager.has_workers());
+    }
+}
