+struct Echo;
+
+impl ClientSurface for Echo {
+    fn submit(&self, call: SurfaceCall) -> Result<(), String> {
+        let value = json!({"operation": call.operation, "context": format!("{:?}", call.context),
+            "thread": call.thread, "confirm": call.confirm, "arguments": call.arguments});
+        call.reply
+            .send(Ok(value))
+            .map_err(|error| error.to_string())
+    }
+}
+
+fn paths(root: &std::path::Path) -> crate::omd::ModPaths {
+    crate::omd::ModPaths {
+        evidence: root.join("evidence"),
+        repository: root.to_path_buf(),
+        store: None,
+        protected: Vec::new(),
+    }
+}
+
+fn scope(context: InvocationContext) -> crate::mod_runtime::CallScope<'static> {
+    fn active() -> bool {
+        true
+    }
+    crate::mod_runtime::CallScope {
+        context,
+        thread: None,
+        active: &active,
+    }
+}
+
+fn grants(capabilities: &[&str]) -> Option<codex_omd::ModGrants> {
+    Some(codex_omd::ModGrants {
+        api: codex_omd::MOD_API_VERSION.into(),
+        source_sha256: "0".repeat(64),
+        capabilities: capabilities.iter().map(|c| (*c).to_owned()).collect(),
+        exec_environment: Vec::new(),
+    })
+}
+
+fn request(method: &str, params: Value) -> codex_omd::ModHostCall {
+    codex_omd::ModHostCall {
+        operation: "app.request".into(),
+        arguments: json!({"method": method, "params": params}),
+    }
+}
+
+#[test]
+fn user_commands_authorize_app_requests_before_the_app_loop() {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path().canonicalize().unwrap();
+    let paths = paths(&root);
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let _registration = codex_omd::client_surface::register(Arc::new(Echo));
+    with(|state| state.thread = Some("thread-1".into()));
+    let user = InvocationContext::User;
+
+    let listed = host_call(
+        &paths,
+        &policy,
+        grants(&["sessions"]),
+        "m",
+        request("thread/list", json!({})),
+        &scope(user),
+    )
+    .unwrap();
+    assert_eq!(listed["operation"], "app.request");
+    assert_eq!(listed["thread"], "thread-1");
+    assert_eq!(listed["confirm"], Value::Null);
+
+    let missing = host_call(
+        &paths,
+        &policy,
+        grants(&[]),
+        "m",
+        request("thread/list", json!({})),
+        &scope(user),
+    )
+    .unwrap_err()
+    .to_string();
+    assert!(missing.starts_with("app_capability_missing"), "{missing}");
+
+    let unconfigured = host_call(
+        &paths,
+        &policy,
+        grants(&["threads"]),
+        "m",
+        request(
+            "turn/start",
+            json!({"threadId": "thread-1", "model": "other", "input": []}),
+        ),
+        &scope(user),
+    )
+    .unwrap_err()
+    .to_string();
+    assert!(
+        unconfigured.starts_with("app_route_unconfigured"),
+        "{unconfigured}"
+    );
+
+    let foreign = host_call(
+        &paths,
+        &policy,
+        grants(&["threads"]),
+        "m",
+        request("turn/start", json!({"threadId": "thread-2", "input": []})),
+        &scope(user),
+    )
+    .unwrap_err()
+    .to_string();
+    assert!(foreign.starts_with("app_thread_out_of_scope"), "{foreign}");
+
+    let from_event = host_call(
+        &paths,
+        &policy,
+        grants(&["threads"]),
+        "m",
+        request("turn/start", json!({"threadId": "thread-1", "input": []})),
+        &scope(InvocationContext::Event),
+    )
+    .unwrap_err()
+    .to_string();
+    assert!(
+        from_event.starts_with("app_context_user_only"),
+        "{from_event}"
+    );
+
+    let refused = host_call(
+        &paths,
+        &policy,
+        grants(&["packages"]),
+        "m",
+        codex_omd::ModHostCall {
+            operation: "packages.apply".into(),
+            arguments: json!({"action": "enable", "id": "x", "expected_generation": 1}),
+        },
+        &scope(InvocationContext::Event),
+    )
+    .unwrap_err()
+    .to_string();
+    assert_eq!(refused, "host_operation_user_only: packages.apply");
+
+    let routes = host_call(
+        &paths,
+        &policy,
+        grants(&["inventory"]),
+        "m",
+        codex_omd::ModHostCall {
+            operation: "app.routes".into(),
+            arguments: Value::Null,
+        },
+        &scope(user),
+    )
+    .unwrap();
+    assert!(
+        routes
+            .as_array()
+            .is_some_and(|routes| routes.iter().any(|route| route["method"] == "thread/list"))
+    );
+}
+
+#[test]
+fn user_commands_read_turn_activity_through_the_session_host() {
+    let dir = tempfile::tempdir().unwrap();
+    let paths = paths(dir.path());
+    let policy = codex_protocol::permissions::FileSystemSandboxPolicy::read_only();
+    let call = || codex_omd::ModHostCall {
+        operation: "turns.activity".into(),
+        arguments: json!({"last": 1}),
+    };
+    let scope = crate::mod_runtime::CallScope {
+        thread: Some("thread-2"),
+        ..scope(InvocationContext::User)
+    };
+    let registration = codex_omd::turn_activity::register_reader(Arc::new(|thread, arguments| {
+        Ok(json!({"thread": thread, "arguments": arguments}))
+    }));
+    let read = host_call(&paths, &policy, grants(&["sessions"]), "m", call(), &scope).unwrap();
+    assert_eq!(
+        read,
+        json!({"thread": "thread-2", "arguments": {"last": 1}})
+    );
+    drop(registration);
+    let unavailable = host_call(&paths, &policy, grants(&["sessions"]), "m", call(), &scope);
+    assert_eq!(
+        unavailable.unwrap_err().to_string(),
+        "turn_activity_unavailable"
+    );
+}
