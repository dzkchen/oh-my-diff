new file mode 100644
index 000000000..db4b39272
--- /dev/null
+++ b/codex-rs/core/src/tools/approval_gate.rs
@@ -0,0 +1,112 @@
+use std::sync::Arc;
+
+use codex_extension_api::ApprovalGate;
+use codex_extension_api::ApprovalGateInput;
+use codex_extension_api::ApprovalResultInput;
+use codex_protocol::protocol::ReviewDecision;
+
+use crate::session::session::Session;
+use crate::tools::approvals::ApprovalAction;
+use crate::tools::approvals::ApprovalContext;
+
+const DETAIL_BYTES: usize = 64 * 1024;
+
+pub(crate) fn kind(action: &ApprovalAction) -> &'static str {
+    match action {
+        ApprovalAction::ExecCommand { .. } => "exec",
+        ApprovalAction::WriteStdin { .. } => "stdin",
+        #[cfg(unix)]
+        ApprovalAction::Execve { .. } => "execve",
+        ApprovalAction::ApplyPatch { .. } => "patch",
+        ApprovalAction::McpToolCall { .. } => "mcp_tool",
+        ApprovalAction::NetworkAccess { .. } => "network",
+        ApprovalAction::RequestPermissions { .. } => "permissions",
+    }
+}
+
+fn details(action: &ApprovalAction) -> serde_json::Value {
+    let mut value = serde_json::to_value(action).unwrap_or(serde_json::Value::Null);
+    if value.to_string().len() > DETAIL_BYTES
+        && let Some(object) = value.as_object_mut()
+    {
+        for field in ["patch", "arguments", "input", "tool_description"] {
+            object.remove(field);
+        }
+        object.insert("truncated".into(), serde_json::Value::Bool(true));
+    }
+    value
+}
+
+pub(crate) fn decision_name(decision: &ReviewDecision) -> &'static str {
+    match decision {
+        ReviewDecision::Approved => "approved",
+        ReviewDecision::ApprovedForSession => "approved_for_session",
+        ReviewDecision::ApprovedExecpolicyAmendment { .. }
+        | ReviewDecision::ApprovedMcpPolicyAmendment
+        | ReviewDecision::NetworkPolicyAmendment { .. } => "amended",
+        ReviewDecision::Denied { .. } => "denied",
+        ReviewDecision::TimedOut => "timed_out",
+        ReviewDecision::Abort => "aborted",
+    }
+}
+
+pub(crate) async fn gate(
+    session: &Arc<Session>,
+    action: &ApprovalAction,
+    ctx: &ApprovalContext,
+    host_decision: &str,
+) -> ApprovalGate {
+    let contributors = session.services.extensions.approval_gate_contributors();
+    if contributors.is_empty() {
+        return ApprovalGate::Continue;
+    }
+    let turn = ctx.review_context.turn();
+    let policy = serde_json::to_value(turn.approval_policy())
+        .ok()
+        .and_then(|value| value.as_str().map(str::to_owned))
+        .unwrap_or_default();
+    let details = details(action);
+    let mut ask = None;
+    for contributor in contributors {
+        match contributor
+            .gate_approval(ApprovalGateInput {
+                session_store: &session.services.session_extension_data,
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                turn_id: Some(turn.sub_id.as_str()),
+                kind: kind(action),
+                host_decision,
+                policy: &policy,
+                details: details.clone(),
+            })
+            .await
+        {
+            ApprovalGate::Continue => {}
+            ApprovalGate::Deny(reason) => return ApprovalGate::Deny(reason),
+            ApprovalGate::Ask(reason) => {
+                ask.get_or_insert(reason);
+            }
+        }
+    }
+    ask.map_or(ApprovalGate::Continue, ApprovalGate::Ask)
+}
+
+pub(crate) async fn report(
+    session: &Arc<Session>,
+    kind: &str,
+    ctx: &ApprovalContext,
+    decision: &str,
+    source: &str,
+) {
+    for contributor in session.services.extensions.approval_gate_contributors() {
+        contributor
+            .on_approval_result(ApprovalResultInput {
+                thread_store: &session.services.thread_extension_data,
+                call_id: &ctx.call_id,
+                kind,
+                decision,
+                source,
+            })
+            .await;
+    }
+}
