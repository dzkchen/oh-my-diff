+#[test]
+fn session_roots_include_linked_worktrees() {
+    let dir = tempfile::tempdir().unwrap();
+    let base = dir.path().canonicalize().unwrap();
+    let repository = base.join("repo");
+    std::fs::create_dir(&repository).unwrap();
+    let git = |args: &[&str]| {
+        let status = std::process::Command::new("git")
+            .args(["-c", "user.name=t", "-c", "user.email=t@example.com"])
+            .args(args)
+            .current_dir(&repository)
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .unwrap();
+        assert!(status.success(), "git {args:?}");
+    };
+    git(&["init", "-q"]);
+    git(&["commit", "-q", "--allow-empty", "-m", "init"]);
+    git(&["worktree", "add", "-q", "../linked"]);
+    let roots = session_roots(&repository);
+    assert_eq!(roots[0], repository);
+    assert!(roots.contains(&base.join("linked")));
+    assert_eq!(session_roots(&base), vec![base.clone()]);
+}
diff --git a/codex-rs/omd/src/bin/omd-contract.rs b/codex-rs/omd/src/bin/omd-contract.rs
new file mode 100644
index 000000000..0ec327579
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-contract.rs
@@ -0,0 +1,211 @@
+use codex_omd::ContractDocument;
+use codex_omd::ContractResolution;
+use codex_omd::ContractSelection;
+use codex_omd::ModHost;
+use codex_omd::PolicyOwner;
+use serde_json::Value;
+use serde_json::json;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+fn usage() -> io::Error {
+    io::Error::other(
+        "usage: omd-contract list STORE | status STORE REPOSITORY | plan STORE REPOSITORY ID@VERSION | select STORE REPOSITORY ID@VERSION [CONFIRMATION] | require STORE REPOSITORY ID@VERSION | clear STORE REPOSITORY user|project",
+    )
+}
+
+fn documents(store: &Path) -> io::Result<Vec<(ContractDocument, PolicyOwner)>> {
+    let root = store.canonicalize()?;
+    Ok(ModHost::open(root)?.contract_documents())
+}
+
+fn user_path(store: &Path) -> io::Result<PathBuf> {
+    let config = store.join("host.json");
+    let configured = match std::fs::read(&config) {
+        Ok(bytes) => serde_json::from_slice::<Value>(&bytes)?["contract"]["user"]
+            .as_str()
+            .map(PathBuf::from),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error),
+    };
+    Ok(configured.unwrap_or_else(|| store.join(codex_omd::USER_CONTRACT_SELECTION)))
+}
+
+fn project_path(repository: &Path) -> PathBuf {
+    repository.join(codex_omd::PROJECT_CONTRACT_SELECTION)
+}
+
+fn read(path: &Path) -> io::Result<Option<ContractSelection>> {
+    ContractSelection::read(path).map_err(io::Error::other)
+}
+
+fn summary(document: &ContractDocument, owner: &PolicyOwner) -> Value {
+    json!({"key": document.key(), "description": document.description, "assurance": document.assurance,
+        "gates": document.gates, "restrict": document.restrict, "digest": document.digest(), "owner": owner})
+}
+
+fn effective(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+) -> io::Result<ContractResolution> {
+    let user = read(&user_path(store)?)?;
+    let project = read(&project_path(repository))?;
+    Ok(codex_omd::resolve_contract(
+        documents,
+        user.as_ref(),
+        project.as_ref(),
+    ))
+}
+
+fn describe(resolution: &ContractResolution) -> Value {
+    match resolution {
+        ContractResolution::None => {
+            json!({"status": "none", "note": "no contract is selected; completion and integration are not gated"})
+        }
+        ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode,
+        } => json!({"status": "active", "contract": summary(document, owner), "source": source,
+            "overrode": overrode}),
+        ContractResolution::Unavailable(error) => json!({"status": "unavailable", "error": error,
+            "note": "completion and integration fail closed until the selection is fixed"}),
+    }
+}
+
+fn find(
+    documents: &[(ContractDocument, PolicyOwner)],
+    key: &str,
+) -> io::Result<(ContractDocument, PolicyOwner)> {
+    documents
+        .iter()
+        .find(|(document, _)| document.key() == key)
+        .cloned()
+        .ok_or_else(|| io::Error::other(format!("no active mod registers contract {key}")))
+}
+
+fn current(resolution: &ContractResolution) -> Option<&ContractDocument> {
+    match resolution {
+        ContractResolution::Active { document, .. } => Some(document),
+        _ => None,
+    }
+}
+
+fn plan(store: &Path, repository: &Path, key: &str) -> io::Result<Value> {
+    let documents = documents(store)?;
+    let (next, owner) = find(&documents, key)?;
+    let resolution = effective(&documents, store, repository)?;
+    let before = current(&resolution);
+    let weakens = before.is_some_and(|before| next.weaker_than(before));
+    Ok(
+        json!({"schema": 2, "before": describe(&resolution), "after": summary(&next, &owner),
+        "weakens": weakens,
+        "confirmation": weakens.then(|| codex_omd::contract_confirmation(before, &next)),
+        "note": if weakens {
+            "this selection reduces assurance; pass the confirmation to omd-contract select"
+        } else {
+            "this selection does not reduce assurance"
+        }}),
+    )
+}
+
+fn run(args: &[String]) -> io::Result<Value> {
+    match args {
+        [command, store] if command == "list" => {
+            let documents = documents(Path::new(store))?;
+            Ok(json!({"schema": 2, "contracts": documents
+                .iter()
+                .map(|(document, owner)| summary(document, owner))
+                .collect::<Vec<_>>()}))
+        }
+        [command, store, repository] if command == "status" => {
+            let (store, repository) = (Path::new(store), Path::new(repository));
+            let documents = documents(store)?;
+            let mut value = describe(&effective(&documents, store, repository)?);
+            value["schema"] = json!(2);
+            value["user_selection"] = json!(user_path(store)?);
+            value["project_selection"] = json!(project_path(repository));
+            Ok(value)
+        }
+        [command, store, repository, key] if command == "plan" => {
+            plan(Path::new(store), Path::new(repository), key)
+        }
+        [command, store, repository, key] | [command, store, repository, key, _]
+            if command == "select" =>
+        {
+            let confirmation = args.get(4).cloned();
+            let (store, repository) = (Path::new(store), Path::new(repository));
+            let documents = documents(store)?;
+            let (next, owner) = find(&documents, key)?;
+            let resolution = effective(&documents, store, repository)?;
+            let before = current(&resolution);
+            if before.is_some_and(|before| next.weaker_than(before))
+                && confirmation.as_deref()
+                    != Some(codex_omd::contract_confirmation(before, &next).as_str())
+            {
+                return Err(io::Error::other(
+                    "this selection reduces assurance; run omd-contract plan and pass its confirmation",
+                ));
+            }
+            let path = user_path(store)?;
+            ContractSelection {
+                schema: 2,
+                contract: Some(next.key()),
+                contract_digest: Some(next.digest()),
+                confirmation,
+                ..ContractSelection::default()
+            }
+            .write(&path)?;
+            Ok(
+                json!({"schema": 2, "selected": summary(&next, &owner), "path": path,
+                "note": "the selection applies to the next session"}),
+            )
+        }
+        [command, store, repository, key] if command == "require" => {
+            let documents = documents(Path::new(store))?;
+            let (floor, owner) = find(&documents, key)?;
+            let path = project_path(Path::new(repository));
+            let mut selection = read(&path)?.unwrap_or(ContractSelection {
+                schema: 2,
+                ..ContractSelection::default()
+            });
+            selection.floor = Some(floor.key());
+            selection.floor_digest = Some(floor.digest());
+            selection.write(&path)?;
+            Ok(
+                json!({"schema": 2, "floor": summary(&floor, &owner), "path": path,
+                "note": "weaker selections now resolve to this floor"}),
+            )
+        }
+        [command, store, repository, scope] if command == "clear" => {
+            let path = match scope.as_str() {
+                "user" => user_path(Path::new(store))?,
+                "project" => project_path(Path::new(repository)),
+                _ => return Err(usage()),
+            };
+            match std::fs::remove_file(&path) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+            Ok(json!({"schema": 2, "cleared": path}))
+        }
+        _ => Err(usage()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => println!(
+            "{}",
+            serde_json::to_string_pretty(&value).unwrap_or_default()
+        ),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-mod.rs b/codex-rs/omd/src/bin/omd-mod.rs
new file mode 100644
index 000000000..48a0e06ba
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-mod.rs
@@ -0,0 +1,317 @@
+use codex_omd::ModHost;
+use codex_omd::ModInstallRequest;
+use codex_omd::ModStore;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn plugin_files(root: &std::path::Path) -> io::Result<BTreeMap<String, String>> {
+    let mut files = BTreeMap::new();
+    let mut pending = vec![root.to_path_buf()];
+    let mut total = 0_u64;
+    while let Some(directory) = pending.pop() {
+        for entry in fs::read_dir(&directory)? {
+            let entry = entry?;
+            let kind = entry.file_type()?;
+            if kind.is_symlink() {
+                return Err(io::Error::other("plugin_preview_symlink_refused"));
+            }
+            if kind.is_dir() {
+                pending.push(entry.path());
+                continue;
+            }
+            if !kind.is_file() || files.len() >= 512 {
+                return Err(io::Error::other("plugin_preview_file_limit"));
+            }
+            let entry_path = entry.path();
+            let bytes = fs::read(&entry_path)?;
+            total += bytes.len() as u64;
+            if total > 16_777_216 {
+                return Err(io::Error::other("plugin_preview_size_limit"));
+            }
+            let path = entry_path.strip_prefix(root).map_err(io::Error::other)?;
+            files.insert(
+                path.to_string_lossy().into_owned(),
+                format!("{:x}", Sha256::digest(bytes)),
+            );
+        }
+    }
+    Ok(files)
+}
+
+fn plugin_preview(codex: &str, home: &str, id: &str, candidate: &str) -> io::Result<Value> {
+    let (name, marketplace) = id
+        .split_once('@')
+        .ok_or_else(|| io::Error::other("plugin_id_requires_name_at_marketplace"))?;
+    if [name, marketplace].iter().any(|part| {
+        part.is_empty()
+            || !part
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+    }) {
+        return Err(io::Error::other("invalid_plugin_id"));
+    }
+    let home = PathBuf::from(home).canonicalize()?;
+    let candidate = PathBuf::from(candidate).canonicalize()?;
+    let output = Command::new(codex)
+        .env("CODEX_HOME", &home)
+        .args(["plugin", "list", "--json", "--marketplace", marketplace])
+        .output()?;
+    if !output.status.success() {
+        return Err(io::Error::other(
+            String::from_utf8_lossy(&output.stderr).into_owned(),
+        ));
+    }
+    let listing: Value = serde_json::from_slice(&output.stdout)?;
+    let installed = listing["installed"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .find(|entry| entry["pluginId"] == id)
+        .ok_or_else(|| io::Error::other("plugin_not_installed"))?;
+    if installed["source"]["source"] != "local" {
+        return Err(io::Error::other("plugin_preview_requires_local_source"));
+    }
+    let version = installed["version"]
+        .as_str()
+        .ok_or_else(|| io::Error::other("installed_plugin_version_missing"))?;
+    if !version
+        .bytes()
+        .all(|byte| byte.is_ascii_alphanumeric() || byte == b'.' || byte == b'-' || byte == b'_')
+    {
+        return Err(io::Error::other("invalid_installed_plugin_version"));
+    }
+    let installed_path = home
+        .join("plugins/cache")
+        .join(marketplace)
+        .join(name)
+        .join(version);
+    let manifest: Value =
+        serde_json::from_slice(&fs::read(candidate.join(".codex-plugin/plugin.json"))?)?;
+    if manifest["name"] != name || !manifest["version"].is_string() {
+        return Err(io::Error::other("candidate_plugin_manifest_mismatch"));
+    }
+    let current = plugin_files(&installed_path)?;
+    let proposed = plugin_files(&candidate)?;
+    let paths = current
+        .keys()
+        .chain(proposed.keys())
+        .collect::<std::collections::BTreeSet<_>>();
+    let changes = paths
+        .into_iter()
+        .filter_map(|path| {
+            let before = current.get(path);
+            let after = proposed.get(path);
+            (before != after).then(
+                || serde_json::json!({"path":path,"before_sha256":before,"after_sha256":after}),
+            )
+        })
+        .collect::<Vec<_>>();
+    Ok(serde_json::json!({
+        "plugin": id,
+        "installed_version": version,
+        "candidate_version": manifest["version"],
+        "installed_enabled": installed["enabled"],
+        "installed_path": installed_path,
+        "candidate_path": candidate,
+        "changes": changes,
+        "same_version_changed": manifest["version"] == version && current != proposed,
+        "applied": false,
+        "note": "This is a read-only local file preview. Codex still owns plugin installation and hook trust."
+    }))
+}
+
+fn run(args: &[String]) -> io::Result<Value> {
+    let bad = || {
+        io::Error::other(
+            "usage: omd-mod init STORE NODE | plugin-component PLUGIN_ROOT | inspect PACKAGE | trust STORE PACKAGE SHA256 CAPABILITIES_CSV [user|project] | enable/disable STORE PACKAGE | package-plan STORE REQUEST_JSON | package-apply STORE REQUEST_JSON CONFIRMATION | package-lock STORE | package-enable/package-disable STORE ID | package-rollback-plan/package-uninstall-plan STORE ID | package-rollback/package-uninstall STORE ID CONFIRMATION | plugin-preview CODEX_BIN CODEX_HOME NAME@MARKETPLACE CANDIDATE | status/selection-status/reload/report/events/declarations STORE | test STORE SCENARIO_JSON | diagnostics STORE OUTPUT_JSON | explain DENIAL | discover USER_DIR PROJECT_DIR | settings STORE PACKAGE JSON | migrate STORE PACKAGE | rollback STORE PACKAGE BACKUP | command STORE MOD NAME JSON",
+        )
+    };
+    match args {
+        [command, root] if command == "plugin-component" => {
+            codex_omd::plugin_component::inspect(&PathBuf::from(root).canonicalize()?)
+        }
+        [command, codex, home, id, candidate] if command == "plugin-preview" => {
+            plugin_preview(codex, home, id, candidate)
+        }
+        [command, root, request] if command == "package-plan" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_plan(serde_json::from_str::<ModInstallRequest>(request)?)
+                .and_then(|plan| serde_json::to_value(plan).map_err(io::Error::other))
+        }
+        [command, root, request, confirmation] if command == "package-apply" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_apply(
+                    serde_json::from_str::<ModInstallRequest>(request)?,
+                    confirmation,
+                )
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root] if command == "package-lock" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_lock()
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_disable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-enable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_enable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id]
+            if command == "package-rollback-plan" || command == "package-uninstall-plan" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let plan = if command == "package-rollback-plan" {
+                store.package_rollback_plan(id)?
+            } else {
+                store.package_uninstall_plan(id)?
+            };
+            serde_json::to_value(plan).map_err(io::Error::other)
+        }
+        [command, root, id, confirmation]
+            if command == "package-rollback" || command == "package-uninstall" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let lock = if command == "package-rollback" {
+                store.package_rollback(id, confirmation)?
+            } else {
+                store.package_uninstall(id, confirmation)?
+            };
+            serde_json::to_value(lock).map_err(io::Error::other)
+        }
+        [command, user, project] if command == "discover" => {
+            ModStore::discover(&PathBuf::from(user), &PathBuf::from(project))
+        }
+        [command, root, path, settings] if command == "settings" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.settings(
+                &PathBuf::from(path).canonicalize()?,
+                serde_json::from_str(settings)?,
+            )?;
+            Ok(Value::String(
+                "settings saved for next turn boundary".into(),
+            ))
+        }
+        [command, root, path] if command == "migrate" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .migrate(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, backup] if command == "rollback" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .rollback(&PathBuf::from(path).canonicalize()?, &PathBuf::from(backup))
+        }
+        [command, root, node] if command == "init" => {
+            ModStore::create(PathBuf::from(root), PathBuf::from(node))?;
+            Ok(Value::String("created".into()))
+        }
+        [command, path] if command == "inspect" => {
+            ModStore::inspect_package(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, sha, capabilities] | [command, root, path, sha, capabilities, _]
+            if command == "trust" =>
+        {
+            let scope = match args {
+                [.., scope] if args.len() == 6 => scope.as_str(),
+                _ => "user",
+            };
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.trust(
+                PathBuf::from(path).canonicalize()?,
+                sha,
+                capabilities
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(str::to_string)
+                    .collect(),
+                scope,
+            )?;
+            Ok(Value::String(format!(
+                "trusted in the {scope} scope; disabled until explicitly enabled"
+            )))
+        }
+        [command, root, path] if command == "enable" || command == "disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .enable(&PathBuf::from(path), command == "enable")?;
+            Ok(Value::String(
+                "selection saved; takes effect at the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "reload" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.reload()?;
+            Ok(Value::String(
+                "reload queued for the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "status" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.status())
+        }
+        [command, root] if command == "selection-status" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.selection_status()
+        }
+        [command, root] if command == "report" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"mods":status["mods"].as_array()
+                .into_iter().flatten().map(|item| serde_json::json!({
+                    "id":item["id"],"declared":{"capabilities":item["capabilities"],
+                        "services":item["services"]},"used":item["source_use"],
+                    "unused_grants":item["unused_grants"],
+                    "unused_environment":item["unused_environment"],"error":item["error"]
+                })).collect::<Vec<_>>() }),
+            )
+        }
+        [command, root] if command == "events" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.author_inspection())
+        }
+        [command, root] if command == "declarations" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"active_host":status["active_host_types"],
+                "installed_contracts":status["installed_contract_types"]}),
+            )
+        }
+        [command, root, scenario] if command == "test" => {
+            let scenario: Value = serde_json::from_slice(&std::fs::read(scenario)?)?;
+            ModHost::open(PathBuf::from(root).canonicalize()?)?.offline_test(scenario)
+        }
+        [command, root, output] if command == "diagnostics" => {
+            let bundle = ModHost::open(PathBuf::from(root).canonicalize()?)?.diagnostic_bundle();
+            let output = PathBuf::from(output);
+            std::fs::write(&output, serde_json::to_vec_pretty(&bundle)?)?;
+            Ok(serde_json::json!({"bundle":output,"redacted":true}))
+        }
+        [command, denial] if command == "explain" => Ok(ModHost::capability_explanation(denial)),
+        [command, root, id, name, payload] if command == "command" => {
+            let mut host = ModHost::open(PathBuf::from(root).canonicalize()?)?;
+            host.invoke(
+                id,
+                host.generation(),
+                "command",
+                name,
+                serde_json::from_str(payload)?,
+            )
+        }
+        _ => Err(bad()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => println!(
+            "{}",
+            serde_json::to_string_pretty(&value).unwrap_or_default()
+        ),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd.rs b/codex-rs/omd/src/bin/omd.rs
new file mode 100644
index 000000000..1b7dad306
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd.rs
@@ -0,0 +1,413 @@
+use codex_omd::{ModHost, scoped_data::ScopedDataHost};
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+fn configuration(path: &Path) -> io::Result<toml::Value> {
+    if !path.try_exists()? {
+        return Ok(toml::Value::Table(Default::default()));
+    }
+    let metadata = std::fs::metadata(path)?;
+    if !metadata.is_file() || metadata.len() > 262144 {
+        return Err(io::Error::other("session_configuration_limit"));
+    }
+    toml::from_str(&std::fs::read_to_string(path)?)
+        .map_err(|_| io::Error::other("session_configuration_invalid"))
+}
+
+fn database(
+    home: &Path,
+    repository: &Path,
+    explicit: Option<PathBuf>,
+    environment: Option<PathBuf>,
+) -> io::Result<PathBuf> {
+    let sqlite = if let Some(path) = explicit {
+        path
+    } else {
+        let custom = |value: &toml::Value| -> bool { value.to_string().contains("sqlite_home") };
+        if custom(&configuration(&repository.join(".codex/config.toml"))?)
+            || custom(&configuration(Path::new("/etc/codex/config.toml"))?)
+        {
+            return Err(io::Error::other(
+                "explicit_sqlite_home_required_for_layered_configuration",
+            ));
+        }
+        let config = configuration(&home.join("config.toml"))?;
+        let profile = config
+            .get("profile")
+            .and_then(toml::Value::as_str)
+            .and_then(|name| config.get("profiles")?.get(name));
+        let selected = profile
+            .and_then(|value| value.get("sqlite_home"))
+            .or_else(|| config.get("sqlite_home"));
+        match selected {
+            Some(value) => PathBuf::from(
+                value
+                    .as_str()
+                    .ok_or_else(|| io::Error::other("session_database_scope_invalid"))?,
+            ),
+            None => environment.unwrap_or_else(|| home.to_path_buf()),
+        }
+    };
+    if !sqlite.is_absolute() {
+        return Err(io::Error::other("absolute_sqlite_home_required"));
+    }
+    Ok(sqlite.join("state_5.sqlite"))
+}
+
+fn store(args: &[String]) -> io::Result<Value> {
+    let usage = || {
+        io::Error::other(
+            "usage: omd store export|reset --mod ID [--repo PATH] [--store PATH] [--scope repository|user]",
+        )
+    };
+    let (action, rest) = args.split_first().ok_or_else(usage)?;
+    if action != "export" && action != "reset" {
+        return Err(usage());
+    }
+    let mut id = None;
+    let mut repository = None;
+    let mut root = std::env::var_os(codex_omd::MOD_STORE_ENV).map(PathBuf::from);
+    let mut scope = "repository".to_owned();
+    let mut remaining = rest.iter();
+    while let Some(argument) = remaining.next() {
+        let value = remaining.next().ok_or_else(usage)?;
+        match argument.as_str() {
+            "--mod" => id = Some(value.clone()),
+            "--repo" => repository = Some(PathBuf::from(value).canonicalize()?),
+            "--store" => root = Some(PathBuf::from(value)),
+            "--scope" => scope = value.clone(),
+            _ => return Err(usage()),
+        }
+    }
+    let id = id.ok_or_else(usage)?;
+    let root = root
+        .ok_or_else(|| io::Error::other("explicit_mod_store_required"))?
+        .canonicalize()?;
+    let key = match (&repository, scope.as_str()) {
+        (Some(repository), "repository") => codex_omd::host::repository_key(repository),
+        (None, "repository") => return Err(io::Error::other("explicit_repository_required")),
+        _ => String::new(),
+    };
+    let data = codex_omd::data_store::DataStore {
+        root: &root,
+        repository_key: &key,
+        owner: &id,
+        provenance: codex_omd::data_store::StoreProvenance {
+            r#mod: id.clone(),
+            source_sha256: String::new(),
+            thread_id: None,
+            origin: codex_omd::data_store::Origin::Cli,
+            at: 0,
+        },
+    };
+    let mut exported = data.call("store.export", json!({"scope": scope}))?;
+    while !exported["cursor"].is_null() {
+        let page = data.call(
+            "store.export",
+            json!({"scope": scope, "cursor": exported["cursor"]}),
+        )?;
+        if let (Some(entries), Some(more)) = (
+            exported["entries"].as_object_mut(),
+            page["entries"].as_object(),
+        ) {
+            entries.extend(more.clone());
+        }
+        exported["cursor"] = page["cursor"].clone();
+    }
+    if let Some(exported) = exported.as_object_mut() {
+        exported.remove("cursor");
+    }
+    if action == "export" {
+        return Ok(exported);
+    }
+    data.call(
+        "store.reset",
+        json!({"scope": scope, "expected_generation": exported["generation"]}),
+    )
+}
+
+fn run(args: Vec<String>) -> io::Result<Value> {
+    if args.is_empty() || args[0] == "--help" {
+        return Ok(
+            json!({"usage":"omd COMMAND --repo PATH [--store PATH] [--home PATH] [--sqlite-home PATH] [ARGS] | omd store export|reset --mod ID [--repo PATH] [--store PATH] [--scope repository|user]","commands":"Only explicitly enabled extensions with a CLI export may run. Model requests and process execution are unavailable here. `omd store` exports or resets one mod's namespaced store without running mod code."}),
+        );
+    }
+    if args[0] == "store" {
+        return store(&args[1..]);
+    }
+    if args.len() > 128 || args.iter().map(String::len).sum::<usize>() > 8192 {
+        return Err(io::Error::other("command_argument_limit"));
+    }
+    let command = &args[0];
+    let mut repository = None;
+    let mut store = std::env::var_os(codex_omd::MOD_STORE_ENV).map(PathBuf::from);
+    let mut home = std::env::var_os("CODEX_HOME").map(PathBuf::from);
+    let mut sqlite = None;
+    let mut payload = Vec::new();
+    let mut remaining = args[1..].iter();
+    while let Some(argument) = remaining.next() {
+        match argument.as_str() {
+            "--repo" => {
+                if repository.is_some() {
+                    return Err(io::Error::other("duplicate_repository"));
+                }
+                repository = Some(
+                    PathBuf::from(
+                        remaining
+                            .next()
+                            .ok_or_else(|| io::Error::other("repository_required"))?,
+                    )
+                    .canonicalize()?,
+                );
+            }
+            "--store" => {
+                store = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("store_required"))?,
+                ));
+            }
+            "--home" => {
+                home = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("home_required"))?,
+                ));
+            }
+            "--sqlite-home" => {
+                if sqlite.is_some() {
+                    return Err(io::Error::other("duplicate_sqlite_home"));
+                }
+                sqlite = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("sqlite_home_required"))?,
+                ));
+            }
+            _ => payload.push(argument.clone()),
+        }
+    }
+    let repository = repository.ok_or_else(|| io::Error::other("explicit_repository_required"))?;
+    let root = store
+        .ok_or_else(|| io::Error::other("explicit_mod_store_required"))?
+        .canonicalize()?;
+    let home =
+        home.or_else(|| std::env::var_os("HOME").map(|path| PathBuf::from(path).join(".codex")));
+    let sessions = home.as_ref().map(|path| path.join("sessions"));
+    let mut runtime = ModHost::open(root.clone())?;
+    let exports: Vec<_> = runtime
+        .commands()
+        .into_iter()
+        .filter(|(_, export)| export.cli.as_deref() == Some(command))
+        .collect();
+    if exports.len() != 1 {
+        return Err(io::Error::other(if exports.is_empty() {
+            "plugin_command_unavailable"
+        } else {
+            "plugin_command_collision"
+        }));
+    }
+    let (owner, export) = &exports[0];
+    let sources: BTreeMap<String, String> = runtime
+        .owners()
+        .into_iter()
+        .map(|(id, owner)| (id, owner.sha256))
+        .collect();
+    let mut providers = BTreeMap::<String, ScopedDataHost>::new();
+    let mut data = ScopedDataHost::new(
+        root.clone(),
+        repository.clone(),
+        sessions.clone(),
+        None,
+        owner.clone(),
+        "user-command".into(),
+        sources
+            .get(owner)
+            .cloned()
+            .ok_or_else(|| io::Error::other("command_owner_missing"))?,
+    )?;
+    let deadline = Instant::now() + Duration::from_secs(30);
+    runtime.invoke_scoped_with(
+        owner,
+        runtime.generation(),
+        "command",
+        &export.name,
+        json!(payload),
+        || Instant::now() < deadline,
+        |caller, request| {
+            if !codex_omd::scoped_data::operation(&request.operation) {
+                return Err(io::Error::other("standalone_host_operation_unavailable"));
+            }
+            let needs_sessions = request.operation.starts_with("sessions.");
+            let session_database = if needs_sessions {
+                Some(database(
+                    home.as_deref()
+                        .ok_or_else(|| io::Error::other("session_home_required"))?,
+                    &repository,
+                    sqlite.clone(),
+                    std::env::var_os("CODEX_SQLITE_HOME").map(PathBuf::from),
+                )?)
+            } else {
+                None
+            };
+            if caller == owner {
+                if needs_sessions {
+                    data.session_database = session_database;
+                }
+                return data.call(&request.operation, request.arguments, || {
+                    Instant::now() < deadline
+                });
+            }
+            let source = sources
+                .get(caller)
+                .ok_or_else(|| io::Error::other("service_provider_missing"))?;
+            let provider = match providers.entry(caller.to_owned()) {
+                std::collections::btree_map::Entry::Occupied(entry) => entry.into_mut(),
+                std::collections::btree_map::Entry::Vacant(entry) => {
+                    entry.insert(ScopedDataHost::new(
+                        root.clone(),
+                        repository.clone(),
+                        sessions.clone(),
+                        session_database.clone(),
+                        caller.to_owned(),
+                        "user-command".into(),
+                        source.clone(),
+                    )?)
+                }
+            };
+            if provider.binding.source_sha256 != *source {
+                return Err(io::Error::other("data_selection_changed_or_revoked"));
+            }
+            if needs_sessions {
+                provider.session_database = session_database;
+            }
+            provider.call(&request.operation, request.arguments, || {
+                Instant::now() < deadline
+            })
+        },
+    )
+}
+
+fn main() {
+    match run(std::env::args().skip(1).collect()) {
+        Ok(value) => {
+            if let Some(display) = value.get("display").and_then(Value::as_str) {
+                println!(
+                    "{}",
+                    display
+                        .chars()
+                        .filter(
+                            |character| !character.is_control() || matches!(character, '\n' | '\t')
+                        )
+                        .collect::<String>()
+                );
+            } else {
+                println!(
+                    "{}",
+                    serde_json::to_string_pretty(&value).unwrap_or_default()
+                );
+            }
+        }
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn store_recovery_exports_and_resets_one_mod_without_running_it() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let repository = root.join("repo");
+        std::fs::create_dir(&repository).unwrap();
+        let key = codex_omd::host::repository_key(&repository);
+        codex_omd::data_store::DataStore {
+            root: &root,
+            repository_key: &key,
+            owner: "stuck",
+            provenance: codex_omd::data_store::StoreProvenance {
+                r#mod: "stuck".into(),
+                source_sha256: "a".repeat(64),
+                thread_id: None,
+                origin: codex_omd::data_store::Origin::Tool,
+                at: 0,
+            },
+        }
+        .call(
+            "store.put",
+            json!({"key":"state","value":"x".repeat(40_000),"expected_revision":null}),
+        )
+        .unwrap();
+        let args = |action: &str| {
+            [
+                "store",
+                action,
+                "--mod",
+                "stuck",
+                "--repo",
+                repository.to_str().unwrap(),
+                "--store",
+                root.to_str().unwrap(),
+            ]
+            .map(str::to_owned)
+            .to_vec()
+        };
+        let exported = run(args("export")).unwrap();
+        assert_eq!(exported["entries"]["state"]["revision"], 1);
+        assert!(exported.get("cursor").is_none());
+        assert_eq!(run(args("reset")).unwrap()["generation"], 2);
+        assert!(
+            run(args("export")).unwrap()["entries"]
+                .as_object()
+                .unwrap()
+                .is_empty()
+        );
+    }
+
+    #[test]
+    fn session_database_selection_honors_config_profile_and_explicit_scope() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let home = root.join("home");
+        let repository = root.join("repo");
+        std::fs::create_dir_all(&home).unwrap();
+        std::fs::create_dir_all(repository.join(".codex")).unwrap();
+        let environment = root.join("environment");
+        assert_eq!(
+            database(&home, &repository, None, Some(environment.clone())).unwrap(),
+            environment.join("state_5.sqlite")
+        );
+        let configured = root.join("configured");
+        std::fs::write(
+            home.join("config.toml"),
+            format!(
+                "profile='selected'\n[profiles.selected]\nsqlite_home='{}'\n",
+                configured.display()
+            ),
+        )
+        .unwrap();
+        assert_eq!(
+            database(&home, &repository, None, Some(environment.clone())).unwrap(),
+            configured.join("state_5.sqlite")
+        );
+        std::fs::write(
+            repository.join(".codex/config.toml"),
+            "\"\\u0073qlite_home\"='/unknown'\n",
+        )
+        .unwrap();
+        assert!(database(&home, &repository, None, None).is_err());
+        assert_eq!(
+            database(&home, &repository, Some(environment.clone()), None).unwrap(),
+            environment.join("state_5.sqlite")
+        );
+        assert!(database(&home, &repository, Some(PathBuf::from("relative")), None).is_err());
+    }
+}
diff --git a/codex-rs/omd/src/blob_store.rs b/codex-rs/omd/src/blob_store.rs
new file mode 100644
index 000000000..a614d352c
--- /dev/null
+++ b/codex-rs/omd/src/blob_store.rs
@@ -0,0 +1,260 @@
+use crate::resource_data::{ResourceStore, hash};
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD;
+use serde_json::{Value, json};
+use std::fs;
+use std::io::{self, Read, Write};
+use std::os::unix::fs::{DirBuilderExt, OpenOptionsExt};
+use std::path::PathBuf;
+
+pub const BLOB_BYTES: usize = 16 * 1024 * 1024;
+pub const IMAGE_BYTES: usize = 8 * 1024 * 1024;
+pub const BLOB_TOTAL_BYTES: u64 = 256 * 1024 * 1024;
+pub const BLOB_ENTRIES: usize = 4096;
+pub const ROTATING_RECORDS: usize = 256;
+const ROTATING_KEEP: usize = 192;
+
+fn sha(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+}
+
+impl ResourceStore<'_> {
+    fn blob_directory(&self) -> io::Result<PathBuf> {
+        private_directory(self.directory()?.join("blobs"))
+    }
+
+    pub(crate) fn rotating_directory(&self) -> io::Result<PathBuf> {
+        private_directory(self.directory()?.join("rotating"))
+    }
+}
+
+fn private_directory(path: PathBuf) -> io::Result<PathBuf> {
+    match fs::DirBuilder::new().mode(0o700).create(&path) {
+        Ok(()) => (),
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (),
+        Err(error) => return Err(error),
+    }
+    let metadata = fs::symlink_metadata(&path)?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err(io::Error::other("blob_directory_invalid"));
+    }
+    Ok(path)
+}
+
+fn write_new(path: &std::path::Path, bytes: &[u8]) -> io::Result<()> {
+    match fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+    {
+        Ok(mut file) => file
+            .write_all(bytes)
+            .and_then(|()| file.sync_all())
+            .inspect_err(|_| {
+                let _ = fs::remove_file(path);
+            }),
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => Ok(()),
+        Err(error) => Err(error),
+    }
+}
+
+fn prune_rotating(directory: &std::path::Path) -> io::Result<()> {
+    let mut records = fs::read_dir(directory)?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.path().extension().is_some_and(|e| e == "json"))
+        .map(|entry| Ok((entry.metadata()?.modified()?, entry.path())))
+        .collect::<io::Result<Vec<_>>>()?;
+    if records.len() <= ROTATING_RECORDS {
+        return Ok(());
+    }
+    records.sort();
+    let (evicted, kept) = records.split_at(records.len() - ROTATING_KEEP);
+    let blob = |path: &std::path::Path| {
+        fs::read(path)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+            .and_then(|record| record["payload"]["blob"].as_str().map(str::to_owned))
+    };
+    let live = kept
+        .iter()
+        .filter_map(|(_, path)| blob(path))
+        .collect::<std::collections::BTreeSet<_>>();
+    for (_, path) in evicted {
+        if let Some(digest) = blob(path).filter(|digest| !live.contains(digest)) {
+            let _ = fs::remove_file(directory.join(format!("{digest}.bin")));
+        }
+        let _ = fs::remove_file(path);
+    }
+    Ok(())
+}
+
+impl ResourceStore<'_> {
+    pub fn put_blob(&self, bytes: &[u8]) -> io::Result<String> {
+        if bytes.len() > BLOB_BYTES {
+            return Err(io::Error::other("blob_too_large"));
+        }
+        let digest = hash(bytes);
+        let directory = self.blob_directory()?;
+        let path = directory.join(format!("{digest}.bin"));
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(directory.join(".blobs.lock"))?;
+        lock.lock()?;
+        if path.try_exists()? {
+            return self.blob(&digest).map(|_| digest);
+        }
+        let (mut total, mut entries) = (0u64, 0usize);
+        for entry in fs::read_dir(&directory)? {
+            let entry = entry?;
+            if entry.path().extension().is_some_and(|e| e == "bin") {
+                entries += 1;
+                total = total.saturating_add(entry.metadata()?.len());
+            }
+        }
+        if entries >= BLOB_ENTRIES || total.saturating_add(bytes.len() as u64) > BLOB_TOTAL_BYTES {
+            return Err(io::Error::other("blob_store_quota"));
+        }
+        let temporary = directory.join(format!(".{digest}.{}", std::process::id()));
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&temporary)?;
+        if let Err(error) = file
+            .write_all(bytes)
+            .and_then(|()| file.sync_all())
+            .and_then(|()| fs::rename(&temporary, &path))
+        {
+            let _ = fs::remove_file(&temporary);
+            return Err(error);
+        }
+        Ok(digest)
+    }
+
+    pub fn blob_path(&self, digest: &str) -> io::Result<PathBuf> {
+        if !sha(digest) {
+            return Err(io::Error::other("blob_reference_invalid"));
+        }
+        let mut path = self.blob_directory()?.join(format!("{digest}.bin"));
+        if !path.try_exists()? {
+            path = self.rotating_directory()?.join(format!("{digest}.bin"));
+        }
+        let metadata =
+            fs::symlink_metadata(&path).map_err(|_| io::Error::other("blob_unavailable"))?;
+        if !metadata.is_file() || metadata.len() > BLOB_BYTES as u64 {
+            return Err(io::Error::other("blob_invalid"));
+        }
+        Ok(path)
+    }
+
+    pub fn blob(&self, digest: &str) -> io::Result<Vec<u8>> {
+        let path = self.blob_path(digest)?;
+        let mut bytes = Vec::new();
+        fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(path)?
+            .take(BLOB_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)?;
+        if hash(&bytes) != digest {
+            return Err(io::Error::other("blob_integrity_failed"));
+        }
+        Ok(bytes)
+    }
+
+    pub fn blob_text(&self, payload: &Value) -> io::Result<Option<String>> {
+        match payload.get("blob") {
+            Some(Value::String(digest)) => Ok(Some(
+                String::from_utf8_lossy(&self.blob(digest)?).into_owned(),
+            )),
+            Some(_) => Err(io::Error::other("blob_reference_invalid")),
+            None => Ok(None),
+        }
+    }
+
+    pub fn evidence_record(&self, arguments: Value) -> io::Result<Value> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Input {
+            media_type: String,
+            #[serde(default)]
+            content: Option<Value>,
+            #[serde(default)]
+            base64: Option<String>,
+            #[serde(default)]
+            label: Option<String>,
+        }
+        let input: Input = serde_json::from_value(arguments)?;
+        let invalid = || io::Error::other("evidence_record_invalid");
+        if input.label.as_deref().is_some_and(|label| {
+            label.is_empty() || label.len() > 128 || label.chars().any(char::is_control)
+        }) {
+            return Err(invalid());
+        }
+        match (input.media_type.as_str(), input.content, input.base64) {
+            ("application/json", Some(content), None) => Ok(
+                json!({"media_type": input.media_type, "label": input.label, "content": content}),
+            ),
+            ("text/plain", Some(Value::String(text)), None) => {
+                Ok(json!({"media_type": input.media_type, "label": input.label, "content": text}))
+            }
+            (
+                media @ ("image/png" | "image/jpeg" | "application/octet-stream"),
+                None,
+                Some(encoded),
+            ) => {
+                let bytes = STANDARD.decode(encoded.as_bytes()).map_err(|_| invalid())?;
+                let signature = match media {
+                    "image/png" => bytes.starts_with(b"\x89PNG\r\n\x1a\n"),
+                    "image/jpeg" => bytes.starts_with(&[0xFF, 0xD8, 0xFF]),
+                    _ => true,
+                };
+                if !signature || media.starts_with("image/") && bytes.len() > IMAGE_BYTES {
+                    return Err(invalid());
+                }
+                let blob = self.put_blob(&bytes)?;
+                Ok(
+                    json!({"media_type": media, "label": input.label, "blob": blob, "bytes": bytes.len()}),
+                )
+            }
+            _ => Err(invalid()),
+        }
+    }
+
+    pub fn text_evidence(
+        &self,
+        label: &str,
+        text: &str,
+    ) -> io::Result<crate::resource_data::ResourceRef> {
+        if text.len() > BLOB_BYTES {
+            return Err(io::Error::other("blob_too_large"));
+        }
+        let directory = self.rotating_directory()?;
+        let blob = hash(text.as_bytes());
+        write_new(&directory.join(format!("{blob}.bin")), text.as_bytes())?;
+        let record = self.record(
+            "evidence",
+            json!({"media_type": "text/plain", "label": label, "blob": blob, "bytes": text.len()}),
+        )?;
+        let sha256 = hash(&record);
+        write_new(&directory.join(format!("{sha256}.json")), &record)?;
+        prune_rotating(&directory)?;
+        Ok(crate::resource_data::ResourceRef {
+            reference: sha256.clone(),
+            sha256,
+        })
+    }
+}
+
