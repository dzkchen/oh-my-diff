+    let status = host(&temp).status();
+    assert!(status["mods"].as_array().unwrap().iter().all(|entry| {
+        entry["error"]
+            .as_str()
+            .is_some_and(|error| error.contains("dependency_cycle"))
+    }));
+    let own = service_package(
