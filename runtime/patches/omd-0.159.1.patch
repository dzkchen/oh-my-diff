+        let runtime = ToolCallRuntime::new(
+            Arc::clone(&session),
+            Arc::clone(&step),
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+        );
+        let manager = KernelManager::new();
+        let call = CodeModeNestedToolCall {
+            cell_id: CellId::new("disabled-cell".into()),
+            runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+            tool_name: ToolName::plain("kernel"),
+            tool_kind: CodeModeToolKind::Function,
+            input: Some(json!({"kernel":"python","code":"print(1)"})),
+        };
+        let result = manager
