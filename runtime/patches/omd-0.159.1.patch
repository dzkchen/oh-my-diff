new file mode 100644
index 000000000..c6e7242a7
--- /dev/null
+++ b/codex-rs/tui/src/app/mod_credentials.rs
@@ -0,0 +1,294 @@
+use super::App;
+use crate::bottom_pane::SecretPromptView;
+use codex_omd::client_surface::SurfaceCall;
+use codex_omd::credentials::CredentialProfile;
+use codex_omd::credentials::CredentialProfiles;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    action: String,
+    #[serde(default)]
+    kind: Option<String>,
+    #[serde(default)]
+    label: Option<String>,
+    #[serde(default)]
+    provider: Option<String>,
+    #[serde(default)]
+    profile: Option<String>,
+    #[serde(default)]
+    origin: Option<String>,
+}
+
+fn parse(call: &SurfaceCall) -> Result<Request, String> {
+    let request: Request =
+        serde_json::from_value(call.arguments.clone()).map_err(|error| error.to_string())?;
+    match request.action.as_str() {
+        "enroll"
+            if request.label.is_some()
+                && match request.kind.as_deref() {
+                    Some("secret") => request.origin.is_some(),
+                    Some(_) => request.origin.is_none(),
+                    None => false,
+                } =>
+        {
+            Ok(request)
+        }
+        "remove" | "refresh" if request.profile.is_some() => Ok(request),
+        _ => Err("credentials_request_invalid".into()),
+    }
+}
+
+pub(super) fn prompt(call: &SurfaceCall) -> Result<String, String> {
+    let request = parse(call)?;
+    let caller = &call.caller;
+    Ok(match request.action.as_str() {
+        "enroll" if request.kind.as_deref() == Some("secret") => format!(
+            "Mod {caller} wants to store a secret \"{}\" for {}. You enter it here; only that mod's sidecars receive it, never the mod or the model.",
+            request.label.unwrap_or_default(),
+            request.origin.unwrap_or_default()
+        ),
+        "enroll" => format!(
+            "Mod {caller} wants to add a {} credential profile \"{}\". You sign in or enter the key here; the mod never sees it.",
+            request.kind.unwrap_or_default(),
+            request.label.unwrap_or_default()
+        ),
+        "remove" => {
+            let id = request.profile.unwrap_or_default();
+            let profile = profiles()?
+                .profile(&id)
+                .map_err(|error| error.to_string())?;
+            format!(
+                "Mod {caller} wants to remove the {} credential profile \"{}\" ({id}).",
+                profile.kind, profile.label
+            )
+        }
+        _ => format!(
+            "Mod {caller} wants to refresh credential profile {}.",
+            request.profile.unwrap_or_default()
+        ),
+    })
+}
+
+fn completed(profile: &CredentialProfile) -> Value {
+    let public = profiles().map_or(Value::Null, |profiles| profiles.public(profile));
+    json!({"status": "completed", "profile": public})
+}
+
+fn profiles() -> Result<CredentialProfiles, String> {
+    let store = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .ok_or("mod store is not configured")?;
+    CredentialProfiles::open(&store).map_err(|error| error.to_string())
+}
+
+fn discard(profiles: &CredentialProfiles, id: &str) {
+    if let Ok(Some(home)) = profiles.remove(id) {
+        let _ = std::fs::remove_dir_all(home);
+    }
+}
+
+impl App {
+    pub(super) fn run_mod_credentials(&mut self, call: SurfaceCall) {
+        let result = (|| {
+            let request = parse(&call)?;
+            let profiles = profiles()?;
+            match request.action.as_str() {
+                "remove" => {
+                    let id = request.profile.unwrap_or_default();
+                    let profile = profiles.profile(&id).map_err(|error| error.to_string())?;
+                    if profile.kind == "secret"
+                        && profile.owner.as_deref() != Some(call.caller.as_str())
+                    {
+                        return Err(format!("credential_secret_not_owned: {id}"));
+                    }
+                    discard(&profiles, &id);
+                    Ok(Some(json!({"status": "completed", "profile": null})))
+                }
+                _ => {
+                    let fresh = request.action == "enroll";
+                    let profile = if fresh && request.kind.as_deref() == Some("secret") {
+                        profiles
+                            .create_secret(
+                                request.label.as_deref().unwrap_or_default(),
+                                request.origin.as_deref().unwrap_or_default(),
+                                &call.caller,
+                            )
+                            .map_err(|error| error.to_string())?
+                    } else if fresh {
+                        profiles
+                            .create(
+                                request.label.as_deref().unwrap_or_default(),
+                                request.kind.as_deref().unwrap_or_default(),
+                                request.provider.as_deref(),
+                            )
+                            .map_err(|error| error.to_string())?
+                    } else {
+                        profiles
+                            .profile(request.profile.as_deref().unwrap_or_default())
+                            .map_err(|error| error.to_string())?
+                    };
+                    let home = profiles
+                        .home(&profile.id)
+                        .map_err(|error| error.to_string())?;
+                    match profile.kind.as_str() {
+                        "api_key" | "provider" => {
+                            self.prompt_for_key(call.reply.clone(), profile, home, fresh);
+                            Ok(None)
+                        }
+                        "chatgpt" => {
+                            self.sign_in(call.reply.clone(), profile, home, fresh)?;
+                            Ok(None)
+                        }
+                        "secret" if profile.owner.as_deref() == Some(call.caller.as_str()) => {
+                            self.prompt_for_secret(call.reply.clone(), profile, fresh);
+                            Ok(None)
+                        }
+                        _ => {
+                            if fresh {
+                                discard(&profiles, &profile.id);
+                            }
+                            Err(format!("credential_secret_not_owned: {}", profile.id))
+                        }
+                    }
+                }
+            }
+        })();
+        match result {
+            Ok(Some(value)) => {
+                let _ = call.reply.send(Ok(value));
+            }
+            Ok(None) => {}
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
+    fn prompt_for_key(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        home: std::path::PathBuf,
+        fresh: bool,
+    ) {
+        let keyring = self.config.auth_keyring_backend_kind();
+        let title = format!("Key for credential profile \"{}\"", profile.label);
+        self.chat_widget
+            .show_mod_secret_prompt(SecretPromptView::new(
+                title,
+                "Stored in the profile's private home. Mods never see it.".to_owned(),
+                Box::new(move |key| {
+                    let result = match key {
+                        Some(key) => codex_login::login_with_api_key(
+                            &home,
+                            &key,
+                            codex_login::AuthCredentialsStoreMode::File,
+                            keyring,
+                        )
+                        .map(|()| completed(&profile))
+                        .map_err(|error| error.to_string()),
+                        None => Ok(json!({"status": "declined", "profile": null})),
+                    };
+                    if fresh
+                        && !result
+                            .as_ref()
+                            .is_ok_and(|value| value["status"] == "completed")
+                        && let Ok(profiles) = profiles()
+                    {
+                        discard(&profiles, &profile.id);
+                    }
+                    let _ = reply.send(result);
+                }),
+            ));
+    }
+
+    fn prompt_for_secret(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        fresh: bool,
+    ) {
+        let title = format!(
+            "Secret \"{}\" for {}",
+            profile.label,
+            profile.origin.as_deref().unwrap_or_default()
+        );
+        self.chat_widget
+            .show_mod_secret_prompt(SecretPromptView::new(
+                title,
+                "Stored in a private profile home and given only to this mod's sidecars."
+                    .to_owned(),
+                Box::new(move |value| {
+                    let result = match (value, profiles()) {
+                        (Some(value), Ok(profiles)) => profiles
+                            .store_secret(&profile.id, &value)
+                            .map(|()| completed(&profile))
+                            .map_err(|error| error.to_string()),
+                        (None, _) => Ok(json!({"status": "declined", "profile": null})),
+                        (_, Err(error)) => Err(error),
+                    };
+                    if fresh
+                        && !result
+                            .as_ref()
+                            .is_ok_and(|value| value["status"] == "completed")
+                        && let Ok(profiles) = profiles()
+                    {
+                        discard(&profiles, &profile.id);
+                    }
+                    let _ = reply.send(result);
+                }),
+            ));
+    }
+
+    fn sign_in(
+        &mut self,
+        reply: codex_omd::client_surface::Reply,
+        profile: CredentialProfile,
+        home: std::path::PathBuf,
+        fresh: bool,
+    ) -> Result<(), String> {
+        let options = codex_login::ServerOptions {
+            open_browser: true,
+            ..codex_login::ServerOptions::new(
+                home,
+                codex_login::oauth_client_id(),
+                None,
+                codex_login::AuthCredentialsStoreMode::File,
+                self.config.auth_keyring_backend_kind(),
+                self.config.auth_route_config(),
+            )
+        };
+        let server = codex_login::run_login_server(options).map_err(|error| {
+            if fresh && let Ok(profiles) = profiles() {
+                discard(&profiles, &profile.id);
+            }
+            format!("credentials_sign_in_unavailable: {error}")
+        })?;
+        self.chat_widget.add_info_message(
+            format!(
+                "Sign in for credential profile \"{}\": {}",
+                profile.label, server.auth_url
+            ),
+            None,
+        );
+        tokio::spawn(async move {
+            let result = server
+                .block_until_done()
+                .await
+                .map(|()| completed(&profile))
+                .map_err(|error| error.to_string());
+            if fresh
+                && result.is_err()
+                && let Ok(profiles) = profiles()
+            {
+                discard(&profiles, &profile.id);
+            }
+            let _ = reply.send(result);
+        });
+        Ok(())
+    }
+}
