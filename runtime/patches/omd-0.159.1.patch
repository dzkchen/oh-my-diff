+use super::*;
+use codex_omd::turn_activity::ActivityRecord;
+use codex_omd::turn_activity::TurnActivityLog;
+
+const EXEC_TOOLS: &[&str] = &["shell", "shell_command", "local_shell", "exec_command"];
+const LIVE_COMMANDS: usize = 1024;
+const HASH_BYTES: u64 = 8 * 1024 * 1024;
+
+pub(in crate::mods) fn now() -> String {
+    chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)
+}
+
+fn log(lead: &Lead) -> Option<TurnActivityLog> {
+    TurnActivityLog::open(
+        &lead.host.root.join("turn-activity"),
+        &lead.thread.to_string(),
+    )
+    .ok()
+}
+
+fn running_turn(core: &Core, lead: &Lead) -> Option<String> {
+    core.expansion
+        .running
+        .lock()
+        .ok()?
+        .get(&lead.thread.to_string())
+        .cloned()
+}
+
+pub(in crate::mods) fn record(core: &Core, lead: &Lead, make: impl FnOnce(&str) -> ActivityRecord) {
+    if lead.owner != "lead" || !core.expansion.recording.load(Ordering::Acquire) {
+        return;
+    }
+    let Some(turn) = running_turn(core, lead) else {
+        return;
+    };
+    if let Some(log) = log(lead)
+        && let Err(error) = log.append(&make(&turn))
+    {
+        core.views
+            .diagnostic(&core.host, "turn_activity", Some(error.to_string()));
+    }
+}
+
+pub(in crate::mods) async fn turn_started(core: &Arc<Core>, lead: &Lead, turn_id: &str) {
+    let refreshed = core.clone();
+    let stopped = tokio::task::spawn_blocking(move || {
+        refreshed
+            .runtime
+            .lock()
+            .ok()
+            .map(|runtime| refreshed.expansion.refresh(&runtime))
+    })
+    .await
+    .ok()
+    .flatten()
+    .unwrap_or(false);
+    let thread = lead.thread.to_string();
+    if stopped && let Some(log) = log(lead) {
+        let _ = log.append(&ActivityRecord::Paused { at: now() });
+    }
+    if let Ok(mut running) = core.expansion.running.lock() {
+        running.insert(thread, turn_id.to_owned());
+    }
+    if let Ok(mut current) = core.expansion.current.lock() {
+        *current = Some(LeadHandle::new(lead));
+    }
+    record(core, lead, |turn| ActivityRecord::TurnStarted {
+        turn_id: turn.to_owned(),
+        at: now(),
+    });
+}
+
+pub(in crate::mods) fn turn_ended(core: &Core, lead: &Lead, outcome: &str, reason: Option<String>) {
+    record(core, lead, |turn| ActivityRecord::TurnEnded {
+        turn_id: turn.to_owned(),
+        at: now(),
+        outcome: outcome.to_owned(),
+        reason,
+    });
+    if let Ok(mut running) = core.expansion.running.lock() {
+        running.remove(&lead.thread.to_string());
+    }
+}
+
+fn command(arguments: &Value) -> String {
+    let value = arguments
+        .get("cmd")
+        .or_else(|| arguments.get("command"))
+        .unwrap_or(&Value::Null);
+    let text = match value {
+        Value::String(text) => text.clone(),
+        Value::Array(parts) => parts
+            .iter()
+            .filter_map(Value::as_str)
+            .collect::<Vec<_>>()
+            .join(" "),
+        _ => String::new(),
+    };
+    text.chars().take(512).collect()
+}
+
+pub(in crate::mods) fn tool_started(
+    core: &Core,
+    lead: &Lead,
+    call_id: &str,
+    tool: &str,
+    arguments: Option<&str>,
+) {
+    record(core, lead, |turn| ActivityRecord::ToolStarted {
+        turn_id: turn.to_owned(),
+        call_id: call_id.to_owned(),
+        tool: tool.to_owned(),
+        at: now(),
+    });
+    if EXEC_TOOLS.contains(&tool) && core.expansion.recording.load(Ordering::Acquire) {
+        if let Ok(mut commands) = core.expansion.commands.lock()
+            && commands.len() < LIVE_COMMANDS
+        {
+            commands.insert(call_id.to_owned());
+        }
+        let arguments = arguments
+            .and_then(|raw| serde_json::from_str::<Value>(raw).ok())
+            .unwrap_or(Value::Null);
+        record(core, lead, |turn| ActivityRecord::ProcessStarted {
+            turn_id: turn.to_owned(),
+            id: call_id.to_owned(),
+            kind: "exec".to_owned(),
+            command: command(&arguments),
+            at: now(),
+        });
+    }
+}
+
+pub(in crate::mods) fn tool_finished(
+    core: &Core,
+    lead: &Lead,
+    call_id: &str,
+    tool: &str,
+    outcome: &str,
+) {
+    record(core, lead, |turn| ActivityRecord::ToolFinished {
+        turn_id: turn.to_owned(),
+        call_id: call_id.to_owned(),
+        at: now(),
+        outcome: outcome.to_owned(),
+    });
+    if (tool != "exec_command" || outcome != "succeeded")
+        && let Ok(mut commands) = core.expansion.commands.lock()
+    {
+        commands.remove(call_id);
+    }
+}
+
+pub(in crate::mods) fn command_ended(core: &Core, lead: &Lead, call_id: &str, exit_code: i32) {
+    if let Ok(mut commands) = core.expansion.commands.lock() {
+        commands.remove(call_id);
+    }
+    if lead.owner != "lead" || !core.expansion.recording.load(Ordering::Acquire) {
+        return;
+    }
+    if let Some(log) = log(lead) {
+        let _ = log.append(&ActivityRecord::ProcessExited {
+            id: call_id.to_owned(),
+            exit_code: Some(exit_code),
+            at: now(),
+        });
+    }
+}
+
+pub(in crate::mods) fn files(core: &Core, lead: &Lead, changes: &[Value], source: &str) {
+    for change in changes
+        .iter()
+        .take(codex_omd::turn_activity::ACTIVITY_FILES)
+    {
+        let Some(path) = change["path"].as_str() else {
+            continue;
+        };
+        let hash = |key: &str| change[key].as_str().map(str::to_owned);
+        record(core, lead, |turn| ActivityRecord::FileChanged {
+            turn_id: turn.to_owned(),
+            path: path.to_owned(),
+            before: hash("before"),
+            after: hash("after"),
+            source: source.to_owned(),
+        });
+    }
+}
+
+pub(in crate::mods) fn process_exited(core: &Core, lead: &Lead, owner: &str, session: &str) {
+    if lead.owner != "lead" || !core.expansion.recording.load(Ordering::Acquire) {
+        return;
+    }
+    if let Some(log) = log(lead) {
+        let _ = log.append(&ActivityRecord::ProcessExited {
+            id: format!("{owner}/{session}"),
+            exit_code: None,
+            at: now(),
+        });
+    }
+}
+
+pub(in crate::mods) fn output_replaced(
+    core: &Core,
+    lead: &Lead,
+    call_id: &str,
+    owner: &str,
+    original: &str,
+    replacement: &str,
+) {
+    record(core, lead, |turn| ActivityRecord::ToolOutputReplaced {
+        turn_id: turn.to_owned(),
+        call_id: call_id.to_owned(),
+        r#mod: owner.to_owned(),
+        original_sha256: crate::execution::hash(original.as_bytes()),
+        replacement_sha256: crate::execution::hash(replacement.as_bytes()),
+    });
+}
+
+pub(in crate::mods) async fn external_changes(
+    core: &Core,
+    lead: &Lead,
+    paths: &[String],
+) -> Vec<Value> {
+    let Ok(authority) = crate::workspace_operations::WorkspaceAuthority::for_lead(lead).await
+    else {
+        return Vec::new();
+    };
+    let root = lead.host.repository.clone();
+    let paths = paths.to_vec();
+    let changes = tokio::task::spawn_blocking(move || {
+        let filter = codex_omd::watch_filter::WatchFilter::new(&root);
+        paths
+            .into_iter()
+            .filter(|path| !filter.ignored(&root, path))
+            .filter(|path| authority.readable(&root.join(path)))
+            .take(128)
+            .map(|path| {
+                let full = root.join(&path);
+                let after = std::fs::symlink_metadata(&full)
+                    .ok()
+                    .filter(|metadata| metadata.is_file() && metadata.len() <= HASH_BYTES)
+                    .and_then(|_| std::fs::read(&full).ok())
+                    .map(|bytes| crate::execution::hash(&bytes));
+                json!({"path": path, "before": null, "after": after})
+            })
+            .collect::<Vec<_>>()
+    })
+    .await
+    .unwrap_or_default();
+    files(core, lead, &changes, "external");
+    changes
+}
+
+pub(in crate::mods) async fn read(
+    core: &Core,
+    lead: &Lead,
+    arguments: Value,
+) -> Result<Value, String> {
+    tokio::task::spawn_blocking(prepare(core, lead, arguments)?)
+        .await
+        .map_err(|error| error.to_string())?
+}
+
+pub(in crate::mods) fn prepare(
+    core: &Core,
+    lead: &Lead,
+    arguments: Value,
+) -> Result<impl FnOnce() -> Result<Value, String> + Send + 'static, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        #[serde(default)]
+        thread_id: Option<String>,
+        #[serde(default)]
+        turn_id: Option<String>,
+        #[serde(default)]
+        last: Option<usize>,
+    }
+    let input: Input = serde_json::from_value(if arguments.is_null() {
+        json!({})
+    } else {
+        arguments
+    })
+    .map_err(|error| error.to_string())?;
+    let thread = lead.thread.to_string();
+    if input
+        .thread_id
+        .as_ref()
+        .is_some_and(|requested| *requested != thread)
+    {
+        return Err("turn_activity_thread_out_of_scope".into());
+    }
+    let last = input.last.unwrap_or(1).clamp(1, 50);
+    let log = log(lead).ok_or("turn_activity_unavailable")?;
+    let running = running_turn(core, lead);
+    let recording = core.expansion.recording.load(Ordering::Acquire);
+    let processes = lead.session.processes.clone();
+    let commands = core
+        .expansion
+        .commands
+        .lock()
+        .map(|commands| commands.clone())
+        .unwrap_or_default();
+    Ok(move || {
+        let live = |id: &str| match id.split_once('/') {
+            Some((owner, session)) => processes.running(owner, session),
+            None => Some(commands.contains(id)),
+        };
+        let mut value = log
+            .read(input.turn_id.as_deref(), last, running.as_deref(), &live)
+            .map_err(|error| error.to_string())?;
+        value["recording"] = Value::Bool(recording);
+        Ok(value)
+    })
+}
+
+pub(in crate::mods) async fn resume_payload(core: &Core, lead: &Lead) -> Value {
+    let thread = lead.thread.to_string();
+    let restarted = core
+        .expansion
+        .restarted
+        .lock()
+        .ok()
+        .and_then(|restarted| restarted.get(&thread).copied())
+        .unwrap_or(true);
+    let last_turn = match log(lead) {
+        Some(log) => tokio::task::spawn_blocking(move || {
+            let value = log.read(None, 1, None, &|_| None).ok()?;
+            let turn = value["turns"].as_array()?.last()?.clone();
+            let status = match turn["outcome"].as_str()? {
+                "completed" => "completed",
+                "error" => "failed",
+                "running" => "in_progress",
+                _ => "interrupted",
+            };
+            Some(json!({"turn_id": turn["turn_id"], "status": status}))
+        })
+        .await
+        .ok()
+        .flatten(),
+        None => None,
+    };
+    json!({"thread_id": thread, "last_turn": last_turn, "restarted": restarted})
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/approvals.rs b/codex-rs/ext/omd/src/mods/expansion/approvals.rs
new file mode 100644
index 000000000..41c09bf0c
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/approvals.rs
@@ -0,0 +1,130 @@
+use super::*;
+use codex_extension_api::ApprovalGate;
+use codex_extension_api::ApprovalGateContributor;
+use codex_extension_api::ApprovalGateInput;
+use codex_extension_api::ApprovalResultInput;
+
+fn reason(text: &str) -> String {
+    text.chars().filter(|c| !c.is_control()).take(512).collect()
+}
+
+pub(super) fn decide(
+    results: Vec<(String, std::io::Result<Value>)>,
+) -> (ApprovalGate, Option<String>) {
+    let mut ask: Option<(String, String)> = None;
+    for (id, result) in results {
+        let value = match result {
+            Ok(Value::Null) => continue,
+            Ok(value) => value,
+            Err(error) => {
+                ask.get_or_insert((
+                    id.clone(),
+                    format!(
+                        "Mod {id} approval check failed: {}",
+                        reason(&error.to_string())
+                    ),
+                ));
+                continue;
+            }
+        };
+        let single = value.as_object().filter(|object| object.len() == 1);
+        match single.and_then(|object| object.iter().next()) {
+            Some((key, Value::String(text))) if key == "deny" => {
+                return (
+                    ApprovalGate::Deny(format!("Mod {id} denied this action: {}", reason(text))),
+                    Some(id),
+                );
+            }
+            Some((key, Value::String(text))) if key == "ask" => {
+                ask.get_or_insert((
+                    id.clone(),
+                    format!("Mod {id} requires approval: {}", reason(text)),
+                ));
+            }
+            _ => {
+                ask.get_or_insert((
+                    id.clone(),
+                    format!("Mod {id} returned an invalid approval decision"),
+                ));
+            }
+        }
+    }
+    match ask {
+        Some((id, text)) => (ApprovalGate::Ask(text), Some(id)),
+        None => (ApprovalGate::Continue, None),
+    }
+}
+
+impl ApprovalGateContributor for Mods {
+    fn gate_approval<'a>(
+        &'a self,
+        input: ApprovalGateInput<'a>,
+    ) -> ExtensionFuture<'a, ApprovalGate> {
+        Box::pin(async move {
+            if !self.expansion.approval.load(Ordering::Acquire) {
+                return ApprovalGate::Continue;
+            }
+            let Some(lead) = input.thread_store.get::<Lead>() else {
+                return ApprovalGate::Continue;
+            };
+            let payload = json!({"id": input.call_id, "kind": input.kind,
+                "thread_id": lead.thread.to_string(), "turn_id": input.turn_id,
+                "agent_id": agent_id(input.thread_store), "host_decision": input.host_decision,
+                "policy": input.policy, "details": input.details});
+            let runtime = self.runtime.clone();
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let results = tokio::task::spawn_blocking(move || {
+                let mut runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned")?;
+                Ok::<_, &str>(
+                    runtime
+                        .event_guarded("approval", payload, || !cancelled.load(Ordering::Acquire)),
+                )
+            })
+            .await;
+            let (gate, owner) = match results {
+                Ok(Ok(results)) => decide(results),
+                _ => (
+                    ApprovalGate::Ask("Mod approval checks were unavailable".into()),
+                    None,
+                ),
+            };
+            if let (Some(owner), Ok(mut gates)) = (owner, self.expansion.gates.lock()) {
+                gates.retain(|(call, _)| call != input.call_id);
+                if gates.len() >= 256 {
+                    gates.pop_front();
+                }
+                gates.push_back((input.call_id.to_owned(), owner));
+            }
+            self.cleanup_failed(Some(&lead)).await;
+            gate
+        })
+    }
+
+    fn on_approval_result<'a>(&'a self, input: ApprovalResultInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            let owner = self.expansion.gates.lock().ok().and_then(|mut gates| {
+                let index = gates.iter().position(|(call, _)| call == input.call_id)?;
+                gates.remove(index).map(|(_, owner)| owner)
+            });
+            if !self.expansion.approval_result.load(Ordering::Acquire) {
+                return;
+            }
+            if input.thread_store.get::<Lead>().is_none() {
+                return;
+            }
+            let mut payload = json!({"id": input.call_id, "kind": input.kind,
+                "decision": input.decision, "source": input.source});
+            if let Some(owner) = owner.filter(|_| input.source == "mod" || input.source == "user") {
+                payload["mod"] = Value::String(owner);
+            }
+            delivery::push(
+                &self.expansion,
+                delivery::Pending::Broadcast {
+                    event: "approval_result",
+                    payload,
+                },
+            );
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/delivery.rs b/codex-rs/ext/omd/src/mods/expansion/delivery.rs
new file mode 100644
index 000000000..eda74cf7d
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/delivery.rs
@@ -0,0 +1,526 @@
+use super::*;
+use crate::managed_process::ProcessNotice;
+
+const DELIVERIES_PER_ROUND: usize = 64;
+
+pub(in crate::mods) enum Pending {
+    Process {
+        thread: ThreadId,
+        owner: String,
+        session: String,
+        bytes: Option<usize>,
+    },
+    Watch {
+        thread: ThreadId,
+        owner: String,
+        watch: String,
+        paths: Vec<String>,
+    },
+    Broadcast {
+        event: &'static str,
+        payload: Value,
+    },
+    Timer {
+        thread: ThreadId,
+        owner: String,
+        key: String,
+    },
+}
+
+pub(super) fn push(state: &State, pending: Pending) {
+    if let Ok(mut queue) = state.pending.lock() {
+        if let (
+            Pending::Process {
+                thread,
+                owner,
+                session,
+                bytes: Some(bytes),
+            },
+            Some(Pending::Process {
+                thread: last_thread,
+                owner: last_owner,
+                session: last_session,
+                bytes: Some(total),
+            }),
+        ) = (&pending, queue.back_mut())
+            && thread == last_thread
+            && owner == last_owner
+            && session == last_session
+        {
+            *total = total.saturating_add(*bytes);
+        } else if queue.len() < 1024 {
+            queue.push_back(pending);
+        } else {
+            state.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    state.wake.notify_one();
+}
+
+pub(in crate::mods) fn lead_started(core: &Arc<Core>, lead: &Lead, forked: Option<ThreadId>) {
+    let state = &core.expansion;
+    let _ = state.core.set(Arc::downgrade(core));
+    let thread = lead.thread.to_string();
+    if let Ok(mut restarted) = state.restarted.lock() {
+        let seen = restarted.contains_key(&thread);
+        restarted.insert(thread.clone(), !seen);
+    }
+    if let Ok(mut current) = state.current.lock() {
+        *current = Some(LeadHandle::new(lead));
+    }
+    if let Ok(mut leads) = state.leads.lock() {
+        leads.retain(|_, handle| handle.session.strong_count() > 0);
+        leads.insert(lead.thread, LeadHandle::new(lead));
+    }
+    let weak = Arc::downgrade(core);
+    let handle = LeadHandle::new(lead);
+    lead.session
+        .processes
+        .set_notifier(Arc::new(move |notice: ProcessNotice| {
+            let Some(core) = weak.upgrade() else {
+                return;
+            };
+            if notice.exited
+                && let Some(lead) = handle.upgrade()
+            {
+                super::activity::process_exited(&core, &lead, &notice.owner, &notice.session);
+            }
+            if notice.deliver {
+                push(
+                    &core.expansion,
+                    Pending::Process {
+                        thread: handle.thread,
+                        owner: notice.owner,
+                        session: notice.session,
+                        bytes: notice.output_bytes,
+                    },
+                );
+            }
+        }));
+    if let Some(parent) = forked
+        && let Err(error) =
+            codex_omd::data_store::fork_thread_data(&lead.host.root, &parent.to_string(), &thread)
+    {
+        core.views.diagnostic(
+            &core.host,
+            "thread_store",
+            Some(format!("fork copy failed: {error}")),
+        );
+    }
+    let runtime = core.runtime.clone();
+    let refresh = Arc::downgrade(core);
+    tokio::spawn(async move {
+        let _ = tokio::task::spawn_blocking(move || {
+            if let (Some(core), Ok(runtime)) = (refresh.upgrade(), runtime.lock()) {
+                core.expansion.refresh(&runtime);
+            }
+        })
+        .await;
+    });
+    ensure_delivery(core);
+}
+
+fn ensure_delivery(core: &Arc<Core>) {
+    let Ok(mut delivery) = core.expansion.delivery.lock() else {
+        return;
+    };
+    if delivery
+        .as_ref()
+        .is_some_and(|current| !current.task.is_finished())
+    {
+        return;
+    }
+    let wake = core.expansion.wake.clone();
+    let signal = wake.clone();
+    let registration =
+        codex_omd::client_surface::register_wake(Arc::new(move || signal.notify_one()));
+    let reader = Arc::downgrade(core);
+    let activity = codex_omd::turn_activity::register_reader(Arc::new(move |thread, arguments| {
+        let core = reader.upgrade().ok_or("turn_activity_unavailable")?;
+        let lead = ThreadId::from_string(thread)
+            .ok()
+            .and_then(|thread| core.expansion.lead(thread))
+            .ok_or("turn_activity_unavailable")?;
+        super::activity::prepare(&core, &lead, arguments)?()
+    }));
+    let weak = Arc::downgrade(core);
+    let task = tokio::spawn(async move {
+        loop {
+            wake.notified().await;
+            let Some(core) = weak.upgrade() else {
+                return;
+            };
+            if deliver(&core).await {
+                tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+                core.expansion.wake.notify_one();
+            }
+        }
+    });
+    *delivery = Some(Delivery {
+        task,
+        _wake: registration,
+        _activity: activity,
+    });
+}
+
+pub(super) async fn deliver(core: &Arc<Core>) -> bool {
+    let dropped = core.expansion.dropped.swap(0, Ordering::Relaxed);
+    if dropped > 0 {
+        core.views.diagnostic(
+            &core.host,
+            "delivery",
+            Some(format!(
+                "{dropped} background events dropped at the queue limit"
+            )),
+        );
+    }
+    let current = core.expansion.current();
+    let mut budget = DELIVERIES_PER_ROUND;
+    while budget > 0 {
+        let next = core
+            .expansion
+            .pending
+            .lock()
+            .ok()
+            .and_then(|mut queue| queue.pop_front());
+        let Some(next) = next else {
+            break;
+        };
+        budget -= 1;
+        match next {
+            Pending::Process {
+                thread,
+                owner,
+                session,
+                bytes,
+            } => {
+                let Some(lead) = core.expansion.lead(thread) else {
+                    continue;
+                };
+                let payload = match bytes {
+                    Some(bytes) => json!({"session": session, "kind": "output", "bytes": bytes}),
+                    None => {
+                        json!({"session": session, "kind": "exit"})
+                    }
+                };
+                invoke_one(core, &lead, owner, "process_event", payload).await;
+            }
+            Pending::Watch {
+                thread,
+                owner,
+                watch,
+                paths,
+            } => {
+                let Some(lead) = core.expansion.lead(thread) else {
+                    continue;
+                };
+                let changes = super::activity::external_changes(core, &lead, &paths).await;
+                if changes.is_empty() {
+                    continue;
+                }
+                let payload = json!({"repository": lead.host.repository, "source": "external",
+                    "call_id": null, "watch_id": watch, "changes": changes, "status": "observed", "reason": null});
+                invoke_one(core, &lead, owner, "workspace_change", payload).await;
+            }
+            Pending::Broadcast { event, payload } => {
+                core.event(event, payload, current.as_ref()).await;
+            }
+            Pending::Timer { thread, owner, key } => {
+                let Some(lead) = core.expansion.lead(thread) else {
+                    continue;
+                };
+                invoke_one(core, &lead, owner, "timer", json!({"key": key})).await;
+            }
+        }
+    }
+    let Some(lead) = current else {
+        return budget == 0;
+    };
+    let ids = sync_bus(core);
+    for id in ids {
+        if budget == 0 {
+            break;
+        }
+        let events = codex_omd::event_bus::global()
+            .lock()
+            .map(|mut bus| bus.drain(&id, budget))
+            .unwrap_or_default();
+        for event in events {
+            budget -= 1;
+            let payload = json!({"publisher": event.publisher, "channel": event.channel,
+                "data": event.data, "correlation": event.correlation,
+                "sequence": event.sequence, "dropped": event.dropped});
+            invoke_one(core, &lead, id.clone(), "channel", payload).await;
+        }
+    }
+    budget == 0
+}
+
+fn sync_bus(core: &Core) -> Vec<String> {
+    let subscriptions = core
+        .expansion
+        .subscriptions
+        .lock()
+        .map(|subscriptions| subscriptions.clone())
+        .unwrap_or_default();
+    let current = subscriptions
+        .iter()
+        .filter(|(_, subscriptions)| !subscriptions.channels.is_empty())
+        .map(|(id, _)| id.clone())
+        .collect::<BTreeSet<_>>();
+    let (Ok(mut bus), Ok(mut subscribed)) = (
+        codex_omd::event_bus::global().lock(),
+        core.expansion.subscribed.lock(),
+    ) else {
+        return Vec::new();
+    };
+    for removed in subscribed.difference(&current) {
+        bus.unsubscribe(removed);
+    }
+    for (id, subscriptions) in &subscriptions {
+        if !subscriptions.channels.is_empty() {
+            bus.subscribe(id, subscriptions.channels.clone());
+        }
+    }
+    *subscribed = current.clone();
+    current
+        .into_iter()
+        .filter(|id| bus.pending(id) > 0)
+        .collect()
+}
+
+pub(in crate::mods) fn publish(
+    core: &Core,
+    caller: &str,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        channel: String,
+        data: Value,
+        #[serde(default)]
+        correlation: Option<String>,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+    sync_bus(core);
+    let delivery = codex_omd::event_bus::global()
+        .lock()
+        .map_err(|_| "event_bus_poisoned")?
+        .publish(caller, &input.channel, input.data, input.correlation)
+        .map_err(|error| error.to_string())?;
+    core.expansion.wake.notify_one();
+    Ok(json!({"delivered": delivery.delivered, "dropped": delivery.dropped}))
+}
+
+pub(in crate::mods) fn watch(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        paths: Vec<String>,
+        #[serde(default = "recursive")]
+        recursive: bool,
+        #[serde(default)]
+        debounce_ms: Option<u64>,
+    }
+    fn recursive() -> bool {
+        true
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+    let watches = {
+        let mut watches = core
+            .expansion
+            .watches
+            .lock()
+            .map_err(|_| "watch_state_poisoned")?;
+        match watches.as_ref() {
+            Some(watches) => watches.clone(),
+            None => {
+                let watcher = codex_file_watcher::FileWatcher::new()
+                    .map_err(|error| format!("watch_unavailable: {error}"))?;
+                let created = Arc::new(
+                    crate::workspace_watch::WorkspaceWatches::new(
+                        Arc::new(watcher),
+                        lead.host.repository.clone(),
+                        lead.host.protected_paths(),
+                        lead.host.config.mod_limits,
+                    )
+                    .map_err(|error| error.to_string())?,
+                );
+                *watches = Some(created.clone());
+                created
+            }
+        }
+    };
+    let weak = core
+        .expansion
+        .core
+        .get()
+        .cloned()
+        .ok_or("watch_unavailable: no session")?;
+    let (owner, thread) = (caller.id.to_owned(), lead.thread);
+    let sink: crate::workspace_watch::ChangeSink =
+        Arc::new(move |watch: &str, paths: Vec<String>| {
+            if let Some(core) = weak.upgrade() {
+                push(
+                    &core.expansion,
+                    Pending::Watch {
+                        thread,
+                        owner: owner.clone(),
+                        watch: watch.to_owned(),
+                        paths,
+                    },
+                );
+            }
+        });
+    let id = watches
+        .watch(
+            caller.id,
+            caller.source,
+            &input.paths,
+            input.recursive,
+            input.debounce_ms,
+            sink,
+        )
+        .map_err(|error| error.to_string())?;
+    Ok(json!({"watch_id": id}))
+}
+
+pub(in crate::mods) fn unwatch(
+    core: &Core,
+    caller: &str,
+    arguments: &Value,
+) -> Result<Value, String> {
+    let id = arguments["watch_id"]
+        .as_str()
+        .filter(|_| {
+            arguments
+                .as_object()
+                .is_some_and(|object| object.len() == 1)
+        })
+        .ok_or("watch_arguments_invalid")?;
+    let stopped = core
+        .expansion
+        .watches
+        .lock()
+        .map_err(|_| "watch_state_poisoned")?
+        .as_ref()
+        .is_some_and(|watches| watches.unwatch(caller, id));
+    Ok(json!({"stopped": stopped}))
+}
+
+pub(in crate::mods) fn schedule(
+    core: &Core,
+    lead: &Lead,
+    caller: &Caller<'_>,
+    arguments: Value,
+) -> Result<Value, String> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Input {
+        key: String,
+        delay_ms: u64,
+    }
+    let input: Input = serde_json::from_value(arguments).map_err(|error| error.to_string())?;
+    if input.key.is_empty()
+        || input.key.len() > 64
+        || !(1_000..=86_400_000).contains(&input.delay_ms)
+    {
+        return Err("timer_invalid".into());
+    }
+    let weak = core
+        .expansion
+        .core
+        .get()
+        .cloned()
+        .ok_or("timer_unavailable: no session")?;
+    let mut timers = core
+        .expansion
+        .timers
+        .lock()
+        .map_err(|_| "timer_state_poisoned")?;
+    timers.retain(|_, (_, task)| !task.is_finished());
+    let slot = (caller.id.to_owned(), input.key.clone());
+    if !timers.contains_key(&slot)
+        && timers
+            .keys()
+            .filter(|(owner, _)| owner == caller.id)
+            .count()
+            >= lead.host.config.mod_limits.bounded().timers_per_mod
+    {
+        return Err("timer_limit".into());
+    }
+    let (owner, key, thread) = (caller.id.to_owned(), input.key.clone(), lead.thread);
+    let task = tokio::spawn(async move {
+        tokio::time::sleep(std::time::Duration::from_millis(input.delay_ms)).await;
+        if let Some(core) = weak.upgrade() {
+            push(&core.expansion, Pending::Timer { thread, owner, key });
+        }
+    });
+    if let Some((_, previous)) = timers.insert(slot, (caller.source.to_owned(), task)) {
+        previous.abort();
+    }
+    Ok(json!({"key": input.key, "delay_ms": input.delay_ms}))
+}
+
+pub(in crate::mods) fn cancel(
+    core: &Core,
+    caller: &str,
+    arguments: &Value,
+) -> Result<Value, String> {
+    let key = arguments["key"].as_str().ok_or("timer_invalid")?;
+    let removed = core
+        .expansion
+        .timers
+        .lock()
+        .map_err(|_| "timer_state_poisoned")?
+        .remove(&(caller.to_owned(), key.to_owned()));
+    if let Some((_, task)) = &removed {
+        task.abort();
+    }
+    Ok(json!({"cancelled": removed.is_some()}))
+}
+
+pub(in crate::mods) fn retain_sources(core: &Core, sources: &BTreeMap<String, String>) {
+    if let Ok(mut timers) = core.expansion.timers.lock() {
+        timers.retain(|(owner, _), (source, task)| {
+            let keep = sources.get(owner) == Some(source);
+            if !keep {
+                task.abort();
+            }
+            keep
+        });
+    }
+    if let Ok(watches) = core.expansion.watches.lock()
+        && let Some(watches) = watches.as_ref()
+    {
+        watches.retain_sources(sources);
+    }
+}
+
+pub(in crate::mods) fn release_owner(core: &Core, owner: &str) {
+    if let Ok(watches) = core.expansion.watches.lock()
+        && let Some(watches) = watches.as_ref()
+    {
+        watches.unwatch_all(owner);
+    }
+}
+
+pub(in crate::mods) fn process_started(core: &Core, lead: &Lead, caller: &str, arguments: &Value) {
+    let session = arguments["session"].as_str().unwrap_or_default();
+    let command = arguments["name"].as_str().unwrap_or_default();
+    super::activity::record(core, lead, |turn| {
+        codex_omd::turn_activity::ActivityRecord::ProcessStarted {
+            turn_id: turn.to_owned(),
+            id: format!("{caller}/{session}"),
+            kind: "managed".into(),
+            command: command.to_owned(),
+            at: super::activity::now(),
+        }
+    });
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs b/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs
new file mode 100644
index 000000000..440571a15
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_batch.rs
@@ -0,0 +1,151 @@
+use super::*;
+use codex_extension_api::ToolBatchContributor;
+use codex_extension_api::ToolBatchInput;
+use codex_extension_api::ToolBatchMerge;
+
+const MERGES: usize = 32;
+
+pub(in crate::mods) fn tool_before_payload(
+    turn_store: &ExtensionData,
+    call_id: &str,
+    tool: &ToolName,
+    arguments: &Value,
+    raw: &str,
+) -> Value {
+    let facts = turn_store
+        .get::<codex_extension_api::ToolCallFacts>()
+        .and_then(|facts| facts.get(call_id))
+        .unwrap_or_default();
+    json!({"tool": tool.to_string(), "arguments": arguments, "call_id": call_id,
+        "schema": facts.schema, "raw_arguments": raw,
+        "batch": facts.batch.map(|batch| json!({"id": batch.id, "index": batch.index, "size": batch.size}))})
+}
+
+pub(super) fn parse(
+    owner: &str,
+    value: Value,
+    known: &[String],
+) -> Result<Vec<ToolBatchMerge>, String> {
+    let invalid = || "invalid_tool_batch_decision".to_owned();
+    let merges = match value {
+        Value::Null => return Ok(Vec::new()),
+        Value::Object(object) if object.len() == 1 => object
+            .get("merge")
+            .and_then(Value::as_array)
+            .cloned()
+            .ok_or_else(invalid)?,
+        _ => return Err(invalid()),
+    };
+    if merges.len() > MERGES {
+        return Err(invalid());
+    }
+    merges
+        .into_iter()
+        .map(|merge| {
+            let object = merge
+                .as_object()
+                .filter(|object| object.len() == 3)
+                .ok_or_else(invalid)?;
+            let call_ids = object
+                .get("call_ids")
+                .and_then(Value::as_array)
+                .ok_or_else(invalid)?
+                .iter()
+                .map(|id| {
+                    id.as_str()
+                        .filter(|id| known.iter().any(|known| known == id))
+                        .map(str::to_owned)
+                        .ok_or_else(invalid)
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+            let tool = object
+                .get("tool")
+                .and_then(Value::as_str)
+                .filter(|tool| !tool.is_empty() && tool.len() <= 64)
+                .ok_or_else(invalid)?;
+            let arguments = object
+                .get("arguments")
+                .filter(|arguments| arguments.is_object())
+                .ok_or_else(invalid)?;
+            Ok(ToolBatchMerge {
+                call_ids,
+                tool: format!("mod_{owner}_{tool}"),
+                arguments: arguments.to_string(),
+            })
+        })
+        .collect()
+}
+
+impl ToolBatchContributor for Mods {
+    fn batching(&self, thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_batch.load(Ordering::Acquire) && lead_thread(thread_store)
+    }
+
+    fn merge_tool_batch<'a>(
+        &'a self,
+        input: ToolBatchInput<'a>,
+    ) -> ExtensionFuture<'a, Vec<ToolBatchMerge>> {
+        Box::pin(async move {
+            let Some(lead) = input.thread_store.get::<Lead>() else {
+                return Vec::new();
+            };
+            let known = input
+                .calls
+                .iter()
+                .map(|call| call.call_id.clone())
+                .collect::<Vec<_>>();
+            let calls = input
+                .calls
+                .iter()
+                .map(|call| {
+                    let arguments = serde_json::from_str::<Value>(&call.arguments)
+                        .unwrap_or_else(|_| Value::String(call.arguments.clone()));
+                    json!({"call_id": call.call_id, "tool": call.tool, "arguments": arguments,
+                        "parallel_safe": call.parallel_safe})
+                })
+                .collect::<Vec<_>>();
+            let payload = json!({"batch_id": input.batch_id, "thread_id": lead.thread.to_string(), "calls": calls});
+            let runtime = self.runtime.clone();
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let _cancellation = Cancellation(cancelled.clone());
+            let result = tokio::task::spawn_blocking(move || {
+                let mut runtime = runtime.lock().map_err(|_| "mod_runtime_poisoned".to_owned())?;
+                let owner = runtime
+                    .replacement_owner("tool_batch")
+                    .ok_or("tool_batch_owner_unavailable")?;
+                let generation = runtime.generation();
+                let value = runtime
+                    .invoke_with(
+                        &owner,
+                        generation,
+                        "tool_batch",
+                        "",
+                        payload,
+                        || !cancelled.load(Ordering::Acquire),
+                        |_| {
+                            Err(std::io::Error::other(
+                                "host_operation_unavailable: tool_batch runs without host operations",
+                            ))
+                        },
+                    )
+                    .map_err(|error| error.to_string())?;
+                parse(&owner, value, &known).map_err(|error| format!("{owner}: {error}"))
+            })
+            .await
+            .map_err(|error| error.to_string())
+            .and_then(|result| result);
+            self.cleanup_failed(Some(&lead)).await;
+            match result {
+                Ok(merges) => merges,
+                Err(error) => {
+                    self.views.diagnostic(
+                        &self.host,
+                        "tool_batch",
+                        Some(format!("{error}; calls dispatched individually")),
+                    );
+                    Vec::new()
+                }
+            }
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_output.rs b/codex-rs/ext/omd/src/mods/expansion/tool_output.rs
new file mode 100644
index 000000000..66cc7e5c9
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_output.rs
@@ -0,0 +1,227 @@
+use super::*;
+use codex_extension_api::ToolOutputContributor;
+use codex_extension_api::ToolOutputInput;
+
+use codex_extension_api::TOOL_OUTPUT_FEEDBACK_BYTES;
+
+const HEAD_BYTES: usize = 48 * 1024;
+const TAIL_BYTES: usize = 16 * 1024;
+const APPEND_BYTES: usize = 4096;
+
+fn bounded(text: &str, limit: usize) -> &str {
+    if text.len() <= limit {
+        return text;
+    }
+    let mut end = limit;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    &text[..end]
+}
+
+fn tail(text: &str, limit: usize) -> Option<&str> {
+    if text.len() <= HEAD_BYTES {
+        return None;
+    }
+    let mut start = text.len() - limit;
+    while !text.is_char_boundary(start) {
+        start += 1;
+    }
+    Some(&text[start..])
+}
+
+async fn original(
+    lead: &Lead,
+    owner: &str,
+    source: &str,
+    call_id: &str,
+    text: &str,
+) -> Result<Value, String> {
+    let scope = lead.session.data.0.clone();
+    let initialized = scope.lock().map_err(|_| "data_scope_poisoned")?.is_some();
+    let authority = match initialized {
+        true => None,
+        false => Some(crate::workspace_operations::WorkspaceAuthority::for_lead(lead).await?),
+    };
+    let (root, thread) = (lead.host.root.clone(), lead.thread.to_string());
+    let (owner, source) = (owner.to_owned(), source.to_owned());
+    let (label, text) = (format!("tool_output:{call_id}"), text.to_owned());
+    tokio::task::spawn_blocking(move || {
+        let mut scope = scope.lock().map_err(|_| "data_scope_poisoned")?;
+        if scope.is_none() {
+            let authority = authority.ok_or("data_scope_unavailable")?;
+            *scope = Some(codex_omd::scoped_data::ScopedDataHosts::new(
+                root,
+                authority.repository,
+                authority.session_root,
+                authority.session_database,
+                thread,
+            ));
+        }
+        let hosts = scope.as_mut().ok_or("data_scope_unavailable")?;
+        let reference = hosts
+            .text_evidence(&owner, &source, &label, &text)
+            .map_err(|error| error.to_string())?;
+        serde_json::to_value(reference).map_err(|error| error.to_string())
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
+
+fn decision(value: Value) -> Result<Option<String>, String> {
+    match value {
+        Value::Null => Ok(None),
+        Value::Object(object) if object.len() == 1 => {
+            let text = object
+                .get("text")
+                .and_then(Value::as_str)
+                .ok_or("invalid_tool_output_decision")?;
+            if text.len() > codex_extension_api::TOOL_OUTPUT_REPLACEMENT_BYTES {
+                return Err("tool_output_replacement_too_large".into());
+            }
+            Ok(Some(text.to_owned()))
+        }
+        _ => Err("invalid_tool_output_decision".into()),
+    }
+}
+
+fn append(value: Value) -> Result<Option<String>, String> {
+    match value {
+        Value::Null => Ok(None),
+        Value::Object(object) if object.len() == 1 => match object.get("append") {
+            Some(Value::String(text)) if text.len() <= APPEND_BYTES => Ok(Some(text.clone())),
+            _ => Err("invalid_tool_output_feedback".into()),
+        },
+        _ => Err("invalid_tool_output_feedback".into()),
+    }
+}
+
+impl ToolOutputContributor for Mods {
+    fn replacing(&self, _thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_output_active()
+    }
+
+    fn replace_tool_output<'a>(
+        &'a self,
+        input: ToolOutputInput<'a>,
+    ) -> ExtensionFuture<'a, Option<String>> {
+        Box::pin(async move {
+            if !self.expansion.tool_output_active() {
+                return None;
+            }
+            let lead = input.thread_store.get::<Lead>()?;
+            let runtime = self.runtime.clone();
+            let (owner, observers) = tokio::task::spawn_blocking(move || {
+                let runtime = runtime.lock().ok()?;
+                let owner = runtime.replacement_owner("tool_output");
+                let observers = runtime
+                    .owners()
+                    .into_iter()
+                    .map(|(id, _)| id)
+                    .filter(|id| {
+                        runtime.registered(id, "tool_output") && owner.as_ref() != Some(id)
+                    })
+                    .collect::<Vec<_>>();
+                let owner = owner.and_then(|owner| {
+                    let source = runtime.grants(&owner)?.source_sha256;
+                    Some((owner, source))
+                });
+                Some((owner, observers))
+            })
+            .await
+            .ok()
+            .flatten()?;
+            let arguments = input
+                .arguments
+                .map(|raw| {
+                    serde_json::from_str::<Value>(raw)
+                        .unwrap_or_else(|_| Value::String(bounded(raw, HEAD_BYTES).to_owned()))
+                })
+                .unwrap_or(Value::Null);
+            let payload = |text: &str, original: Value| {
+                json!({"call_id": input.call_id, "tool": input.tool_name.to_string(),
+                    "arguments": arguments, "success": input.success,
+                    "text": bounded(text, HEAD_BYTES), "tail": tail(text, TAIL_BYTES),
+                    "bytes": text.len(), "original": original})
+            };
+            let diagnostic = |message: String| {
+                self.views
+                    .diagnostic(&self.host, "tool_output", Some(message));
+            };
+            let mut text = None;
+            let mut replaced_by = "feedback".to_owned();
+            if let Some((owner, source)) = owner {
+                match original(&lead, &owner, &source, input.call_id, input.text).await {
+                    Ok(reference) => {
+                        let result = invoke_one(
+                            &self.core,
+                            &lead,
+                            owner.clone(),
+                            "tool_output",
+                            payload(input.text, reference),
+                        )
+                        .await;
+                        match result.map(|result| result.and_then(decision)) {
+                            Some(Ok(Some(replacement))) => {
+                                text = Some(replacement);
+                                replaced_by = owner;
+                            }
+                            Some(Err(error)) => {
+                                diagnostic(format!("{owner}: {error}; output kept"))
+                            }
+                            _ => {}
+                        }
+                    }
+                    Err(error) => diagnostic(format!(
+                        "{owner}: original unavailable, output kept: {error}"
+                    )),
+                }
+            }
+            let mut appended = String::new();
+            for id in observers {
+                let current = text.as_deref().unwrap_or(input.text);
+                let Some(result) = invoke_one(
+                    &self.core,
+                    &lead,
+                    id.clone(),
+                    "tool_output",
+                    payload(current, Value::Null),
+                )
+                .await
+                else {
+                    continue;
+                };
+                match result.and_then(append) {
+                    Ok(Some(extra))
+                        if appended.len() + extra.len() + 2 <= TOOL_OUTPUT_FEEDBACK_BYTES =>
+                    {
+                        appended.push_str("\n\n");
+                        appended.push_str(&extra);
+                    }
+                    Ok(Some(_)) => diagnostic(format!(
+                        "{id}: feedback over the {TOOL_OUTPUT_FEEDBACK_BYTES}-byte budget dropped"
+                    )),
+                    Ok(None) => {}
+                    Err(error) => diagnostic(format!("{id}: {error}; feedback dropped")),
+                }
+            }
+            if !appended.is_empty() {
+                text = Some(format!(
+                    "{}{appended}",
+                    text.as_deref().unwrap_or(input.text)
+                ));
+            }
+            if let Some(text) = &text {
+                activity::output_replaced(
+                    &self.core,
+                    &lead,
+                    input.call_id,
+                    &replaced_by,
+                    input.text,
+                    text,
+                );
+            }
+            text
+        })
+    }
+}
diff --git a/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs b/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs
new file mode 100644
index 000000000..13341482d
--- /dev/null
+++ b/codex-rs/ext/omd/src/mods/expansion/tool_specs.rs
@@ -0,0 +1,134 @@
+use super::*;
+use codex_extension_api::ToolSpecAdjustment;
+use codex_extension_api::ToolSpecContributor;
+use codex_extension_api::ToolSpecView;
+
+const SPEC_TOOLS: usize = 512;
+const PARAMETER_BYTES: usize = 16 * 1024;
+
+pub(super) fn parse(value: Value) -> Result<Option<ToolSpecAdjustment>, String> {
+    let invalid = || "invalid_tool_specs_decision".to_owned();
+    let object = match value {
+        Value::Null => return Ok(None),
+        Value::Object(object) if object.keys().all(|key| key == "hide" || key == "describe") => {
+            object
+        }
+        _ => return Err(invalid()),
+    };
+    let mut adjustment = ToolSpecAdjustment::default();
+    if let Some(hide) = object.get("hide") {
+        let hide = hide
+            .as_array()
+            .filter(|hide| hide.len() <= 256)
+            .ok_or_else(invalid)?;
+        adjustment.hide = hide
+            .iter()
+            .map(|name| name.as_str().map(str::to_owned).ok_or_else(invalid))
+            .collect::<Result<_, _>>()?;
+    }
+    if let Some(describe) = object.get("describe") {
+        let describe = describe
+            .as_object()
+            .filter(|describe| describe.len() <= 128)
+            .ok_or_else(invalid)?;
+        for (name, entry) in describe {
+            let entry = entry
+                .as_object()
+                .filter(|entry| {
+                    entry
+                        .keys()
+                        .all(|key| key == "description" || key == "parameters")
+                })
+                .ok_or_else(invalid)?;
+            let description = match entry.get("description") {
+                None => None,
+                Some(Value::String(text)) => Some(text.clone()),
+                Some(_) => return Err(invalid()),
+            };
+            let parameters = match entry.get("parameters") {
+                None => None,
+                Some(schema @ Value::Object(_)) => Some(schema.clone()),
+                Some(_) => return Err(invalid()),
+            };
+            adjustment
+                .describe
+                .insert(name.clone(), (description, parameters));
+        }
+    }
+    Ok(Some(adjustment))
+}
+
+impl ToolSpecContributor for Mods {
+    fn adjusting(&self, thread_store: &ExtensionData) -> bool {
+        self.expansion.tool_specs.load(Ordering::Acquire) && lead_thread(thread_store)
+    }
+
+    fn adjust_tool_specs(
+        &self,
+        thread_store: &ExtensionData,
+        specs: &[ToolSpecView],
+    ) -> Option<ToolSpecAdjustment> {
+        if !self.adjusting(thread_store) {
+            return None;
+        }
+        let lead = thread_store.get::<Lead>()?;
+        let route = self
+            .host
+            .accounts
+            .0
+            .lock()
+            .ok()?
+            .get(&lead.thread.to_string())
+            .map(|account| {
+                json!({"name": account.route.clone().unwrap_or_else(|| "session".into()),
+                    "model": account.model, "provider": account.provider})
+            });
+        let tools = specs
+            .iter()
+            .take(SPEC_TOOLS)
+            .map(|spec| {
+                let parameters = if spec.parameters.to_string().len() <= PARAMETER_BYTES {
+                    spec.parameters.clone()
+                } else {
+                    Value::Null
+                };
+                json!({"name": spec.name, "description": spec.description, "parameters": parameters})
+            })
+            .collect::<Vec<_>>();
+        let payload = json!({"thread_id": lead.thread.to_string(), "route": route, "tools": tools});
+        let mut runtime = self.runtime.lock().ok()?;
+        let owner = runtime.replacement_owner("tool_specs")?;
+        let generation = runtime.generation();
+        let result = runtime
+            .invoke_with(
+                &owner,
+                generation,
+                "tool_specs",
+                "",
+                payload,
+                || true,
+                |_| {
+                    Err(std::io::Error::other(
+                        "host_operation_unavailable: tool_specs runs without host operations",
+                    ))
+                },
+            )
+            .map_err(|error| error.to_string())
+            .and_then(parse);
+        drop(runtime);
+        match result {
+            Ok(adjustment) => {
+                self.views.diagnostic(&self.host, "tool_specs", None);
+                adjustment
+            }
+            Err(error) => {
+                self.views.diagnostic(
+                    &self.host,
+                    "tool_specs",
+                    Some(format!("{owner}: {error}; native tool specs kept")),
+                );
+                None
+            }
+        }
+    }
+}
