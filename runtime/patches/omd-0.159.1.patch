+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::tui;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ServerRequest;
+use codex_omd::client_surface::SurfaceCall;
+use serde_json::Value;
+use serde_json::json;
+
+const IMPORT_BYTES: u64 = 8 * 1024 * 1024;
+
+fn materialize(
+    caller: &str,
+    thread: Option<&str>,
+    reference: &Value,
+) -> Result<std::path::PathBuf, String> {
+    let (host, store) = crate::mod_surface::resource_binding(caller, thread)?;
+    let resources = host.resources();
+    let reference: codex_omd::resource_data::ResourceRef =
+        serde_json::from_value(reference.clone()).map_err(|error| error.to_string())?;
+    let record = resources
+        .load(&reference, "evidence")
+        .map_err(|error| error.to_string())?;
+    let extension = match record["media_type"].as_str() {
+        Some("image/png") => "png",
+        Some("image/jpeg") => "jpg",
+        _ => return Err("resource_not_image".into()),
+    };
+    let digest = record["blob"].as_str().ok_or("resource_not_binary")?;
+    let bytes = resources.blob(digest).map_err(|error| error.to_string())?;
+    let directory = store.join("attachments");
+    std::fs::create_dir_all(&directory).map_err(|error| error.to_string())?;
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700))
+        .map_err(|error| error.to_string())?;
+    let path = directory.join(format!("{digest}.{extension}"));
+    if !path.exists() {
+        std::fs::write(&path, bytes).map_err(|error| error.to_string())?;
+    }
+    Ok(path)
+}
+
+fn translate_images(caller: &str, thread: Option<&str>, value: &mut Value) -> Result<(), String> {
+    match value {
+        Value::Object(object) => {
+            if matches!(
+                object.get("type").and_then(Value::as_str),
+                Some("localImage" | "localAudio")
+            ) && object.contains_key("path")
+            {
+                return Err("local_path_refused: attach a resource reference".into());
+            }
+            if let Some(resource) = object.remove("resource") {
+                if object.get("type").and_then(Value::as_str) != Some("localImage") {
+                    return Err("resource_field_requires_local_image".into());
+                }
+                let path = materialize(caller, thread, &resource)?;
+                object.insert(
+                    "path".into(),
+                    Value::String(path.to_string_lossy().into_owned()),
+                );
+            }
+            object
+                .values_mut()
+                .try_for_each(|value| translate_images(caller, thread, value))
+        }
+        Value::Array(items) => items
+            .iter_mut()
+            .try_for_each(|value| translate_images(caller, thread, value)),
+        _ => Ok(()),
+    }
+}
+
+type PackageControl = codex_omd::package_controls::PackageControl;
+
+static PACKAGE_CONTROLS: std::sync::Mutex<std::collections::BTreeMap<u64, PackageControl>> =
+    std::sync::Mutex::new(std::collections::BTreeMap::new());
+
+fn package_controls()
+-> std::sync::MutexGuard<'static, std::collections::BTreeMap<u64, PackageControl>> {
+    PACKAGE_CONTROLS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn confirmation(call: &SurfaceCall) -> Result<Option<(String, Option<PackageControl>)>, String> {
+    let prompt = match call.operation.as_str() {
+        "terminal.import_file" => Some(format!(
+            "Mod {} wants to import {}.",
+            call.caller,
+            import_target(&call.arguments)?.display()
+        )),
+        "packages.apply" => {
+            let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+            let store =
+                codex_omd::ModStore::open(paths.store.ok_or("mod store is not configured")?)
+                    .map_err(|error| error.to_string())?;
+            let preview = codex_omd::package_controls::preview(&store, call.arguments.clone())
+                .map_err(|error| error.to_string())?;
+            if !call.arguments["expected_generation"].is_u64() {
+                return Err("expected_generation_required".into());
+            }
+            let prompt = format!(
+                "Mod {} wants to {} {}. New grants: {}.",
+                call.caller,
+                call.arguments["action"].as_str().unwrap_or("change"),
+                call.arguments["id"].as_str().unwrap_or("a package"),
+                preview.public["grants_added"],
+            );
+            return Ok(Some((prompt, Some(preview.control))));
+        }
+        "credentials.request" => Some(super::mod_credentials::prompt(call)?),
+        "terminal.open" => Some(format!(
+            "Mod {} wants to open {} outside the terminal.",
+            call.caller,
+            open_target(&call.arguments)?
+        )),
+        "terminal.pty" if call.arguments["action"] == "start" => {
+            Some(crate::mod_pty::start_prompt(&call.caller, &call.arguments)?)
+        }
+        "terminal.prompt" if call.arguments["kind"] == "confirm" => Some(format!(
+            "{}\n{}",
+            prompt_text(&call.arguments["title"], 120)?,
+            prompt_text(&call.arguments["message"], 2000)?
+        )),
+        _ => call.confirm.clone(),
+    };
+    Ok(prompt.map(|prompt| (prompt, None)))
+}
+
+fn prompt_text(value: &Value, limit: usize) -> Result<String, String> {
+    value
+        .as_str()
+        .filter(|text| !text.is_empty() && text.len() <= limit)
+        .map(|text| {
+            text.chars()
+                .filter(|c| !c.is_control() || *c == '\n')
+                .collect()
+        })
+        .ok_or_else(|| "terminal_prompt_invalid".to_owned())
+}
+
+const OPEN_EXTENSIONS: &[&str] = &[
+    "html", "htm", "md", "txt", "pdf", "png", "jpg", "jpeg", "gif", "svg",
+];
+
+fn editor_target(arguments: &Value) -> Result<(std::path::PathBuf, u64), String> {
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let path = std::fs::canonicalize(
+        arguments["path"]
+            .as_str()
+            .ok_or("terminal_open_target_invalid")?,
+    )
+    .map_err(|_| "terminal_open_path_unavailable")?;
+    let line = match &arguments["line"] {
+        Value::Null => 1,
+        line => line
+            .as_u64()
+            .filter(|line| (1..=10_000_000).contains(line))
+            .ok_or("terminal_open_line_invalid")?,
+    };
+    let inside = path.starts_with(&paths.repository)
+        && !paths.protected.iter().any(|root| path.starts_with(root))
+        && std::fs::metadata(&path).is_ok_and(|metadata| metadata.is_file());
+    inside
+        .then_some((path, line))
+        .ok_or_else(|| "terminal_open_path_refused".to_owned())
+}
+
+fn configured_editor() -> Result<Vec<String>, String> {
+    let store = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .ok_or("mod store is not configured")?;
+    let config: Value = std::fs::read(store.join("host.json"))
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+        .unwrap_or(Value::Null);
+    config["editor"]
+        .as_array()
+        .filter(|argv| (1..=16).contains(&argv.len()))
+        .and_then(|argv| {
+            argv.iter()
+                .map(|arg| arg.as_str().map(str::to_owned))
+                .collect::<Option<Vec<_>>>()
+        })
+        .ok_or_else(|| "terminal_open_editor_unconfigured: set \"editor\" in host.json".to_owned())
+}
+
+fn open_target(arguments: &Value) -> Result<String, String> {
+    if arguments["editor"] == true {
+        let (path, line) = editor_target(arguments)?;
+        return Ok(format!("{}:{line} in your editor", path.display()));
+    }
+    match (arguments["url"].as_str(), arguments["path"].as_str()) {
+        (Some(url), None)
+            if (url.starts_with("https://") || url.starts_with("http://"))
+                && url.len() <= 2048
+                && !url.chars().any(|c| c.is_control() || c.is_whitespace()) =>
+        {
+            Ok(url.to_owned())
+        }
+        (None, Some(path)) => {
+            let path = std::fs::canonicalize(path).map_err(|_| "terminal_open_path_unavailable")?;
+            let allowed = std::fs::metadata(&path).is_ok_and(|metadata| metadata.is_file())
+                && path
+                    .extension()
+                    .and_then(|extension| extension.to_str())
+                    .is_some_and(|extension| {
+                        OPEN_EXTENSIONS.contains(&extension.to_ascii_lowercase().as_str())
+                    });
+            allowed
+                .then(|| path.to_string_lossy().into_owned())
+                .ok_or_else(|| "terminal_open_type_refused".to_owned())
+        }
+        _ => Err("terminal_open_target_invalid".into()),
+    }
+}
+
+fn open(arguments: &Value) -> Result<Value, String> {
+    if arguments["editor"] == true {
+        let (path, line) = editor_target(arguments)?;
+        let mut argv = configured_editor()?.into_iter().map(|arg| {
+            arg.replace("{path}", &path.to_string_lossy())
+                .replace("{line}", &line.to_string())
+        });
+        let program = argv.next().ok_or("terminal_open_editor_unconfigured")?;
+        return std::process::Command::new(program)
+            .args(argv)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .map(|_| json!({"opened": true}))
+            .map_err(|error| format!("terminal_open_failed: {error}"));
+    }
+    let target = open_target(arguments)?;
+    let program = if cfg!(target_os = "macos") {
+        "open"
+    } else {
+        "xdg-open"
+    };
+    std::process::Command::new(program)
+        .arg(&target)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .map(|_| json!({"opened": true}))
+        .map_err(|error| format!("terminal_open_failed: {error}"))
+}
+
+fn import_target(arguments: &Value) -> Result<std::path::PathBuf, String> {
+    std::path::Path::new(arguments["path"].as_str().ok_or("import_path_required")?)
+        .canonicalize()
+        .map_err(|error| error.to_string())
+}
+
+fn import_file(call: &SurfaceCall) -> Result<Value, String> {
+    use std::io::Read;
+    use std::os::unix::fs::OpenOptionsExt;
+    let lifetime = match call.arguments["lifetime"].as_str() {
+        None | Some("thread") => false,
+        Some("package") => true,
+        _ => return Err("import_file_lifetime_invalid".into()),
+    };
+    let limit = call.arguments["max_bytes"]
+        .as_u64()
+        .unwrap_or(IMPORT_BYTES)
+        .min(IMPORT_BYTES);
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let canonical = import_target(&call.arguments)?;
+    if paths
+        .protected
+        .iter()
+        .any(|root| canonical.starts_with(root))
+        || paths
+            .store
+            .as_ref()
+            .is_some_and(|store| canonical.starts_with(store))
+    {
+        return Err("import_file_protected".into());
+    }
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(&canonical)
+        .map_err(|error| error.to_string())?;
+    let metadata = file.metadata().map_err(|error| error.to_string())?;
+    if !metadata.is_file() || metadata.len() > limit {
+        return Err("import_file_invalid_or_too_large".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(limit)
+        .read_to_end(&mut bytes)
+        .map_err(|error| error.to_string())?;
+    let media_type = if bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        "image/png"
+    } else if bytes.starts_with(&[0xff, 0xd8, 0xff]) {
+        "image/jpeg"
+    } else {
+        "application/octet-stream"
+    };
+    let (mut host, _) = crate::mod_surface::resource_binding(&call.caller, call.thread.as_deref())?;
+    if lifetime {
+        host.binding.thread = "package".into();
+        host.binding.generation = 0;
+    }
+    let resources = host.resources();
+    use base64::Engine;
+    let record = resources
+        .evidence_record(json!({"media_type": media_type,
+            "base64": base64::engine::general_purpose::STANDARD.encode(&bytes),
+            "label": canonical.file_name().map(|name| name.to_string_lossy().into_owned())}))
+        .map_err(|error| error.to_string())?;
+    let reference = resources
+        .save("evidence", record)
+        .map_err(|error| error.to_string())?;
+    serde_json::to_value(reference).map_err(|error| error.to_string())
+}
+
+fn image_sample_dimensions(arguments: &Value) -> Result<(u32, u32), String> {
+    let columns = arguments["columns"]
+        .as_u64()
+        .filter(|value| (1..=120).contains(value))
+        .ok_or("image_sample_columns_invalid")? as u32;
+    let rows = arguments["rows"]
+        .as_u64()
+        .filter(|value| (1..=60).contains(value))
+        .ok_or("image_sample_rows_invalid")? as u32;
+    Ok((columns, rows))
+}
+
+fn image_sample(call: &SurfaceCall) -> Result<Value, String> {
+    let reference: codex_omd::resource_data::ResourceRef =
+        serde_json::from_value(call.arguments["resource"].clone())
+            .map_err(|_| "image_resource_invalid".to_owned())?;
+    let (columns, rows) = image_sample_dimensions(&call.arguments)?;
+    let (host, _) = crate::mod_surface::resource_binding(&call.caller, call.thread.as_deref())?;
+    let resources = host.resources();
+    let record = resources
+        .load(&reference, "evidence")
+        .map_err(|error| error.to_string())?;
+    let bytes = resources
+        .blob(record["blob"].as_str().ok_or("image_blob_missing")?)
+        .map_err(|error| error.to_string())?;
+    let image = crate::mod_backdrop::decode_image(&bytes)?;
+    let rgba = image
+        .resize_exact(columns, rows, image::imageops::FilterType::Triangle)
+        .to_rgba8()
+        .into_raw();
+    Ok(json!({"width":columns, "height":rows, "rgba":rgba}))
+}
+
+fn apply_package(control: Option<PackageControl>) -> Result<Value, String> {
+    let control = control.ok_or("package_confirmation_missing")?;
+    let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+    let store = codex_omd::ModStore::open(paths.store.ok_or("mod store is not configured")?)
+        .map_err(|error| error.to_string())?;
+    codex_omd::package_controls::apply(&store, &control).map_err(|error| error.to_string())
+}
+
+impl App {
+    pub(super) fn forward_mod_notification(&self, notification: &ServerNotification) {
+        match notification {
+            ServerNotification::ThreadDeleted(deleted) => {
+                if let Some(store) = crate::omd::mod_paths().and_then(|paths| paths.store) {
+                    let _ = codex_omd::data_store::remove_thread_data(&store, &deleted.thread_id);
+                }
+            }
+            ServerNotification::ServerRequestResolved(resolved) => {
+                if let Ok(request_id) = serde_json::to_value(&resolved.request_id) {
+                    crate::mod_surface::server_request_resolved(request_id);
+                }
+            }
+            _ => {}
+        }
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(notification)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::notification(
+                &method,
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    pub(super) fn forward_mod_server_request(&self, request: &ServerRequest) {
+        if !crate::mod_surface::wants_notifications() {
+            return;
+        }
+        if let Ok(Value::Object(mut value)) = serde_json::to_value(request)
+            && let Some(Value::String(method)) = value.remove("method")
+        {
+            crate::mod_surface::server_request(
+                &method,
+                value.remove("id").unwrap_or(Value::Null),
+                value.remove("params").unwrap_or(Value::Null),
+            );
+        }
+    }
+
+    fn mod_shell_command(
+        &self,
+        arguments: &Value,
+    ) -> Result<(std::process::Command, std::path::PathBuf), String> {
+        let paths = crate::omd::mod_paths().ok_or("mod store is not configured")?;
+        let policy = self.chat_widget.mod_context().policy;
+        let cwd = paths
+            .repository
+            .join(arguments["cwd"].as_str().unwrap_or("."))
+            .canonicalize()
+            .map_err(|_| "pty_cwd_invalid")?;
+        if !cwd.starts_with(&paths.repository) || !cwd.is_dir() {
+            return Err("pty_cwd_invalid".into());
+        }
+        let scratch = paths
+            .store
+            .clone()
+            .ok_or("mod store is not configured")?
+            .join("pty-scratch");
+        std::fs::create_dir_all(&scratch).map_err(|error| error.to_string())?;
+        let loopback = match arguments["network"].as_str() {
+            None if arguments["network"].is_null() => false,
+            Some("loopback") => true,
+            _ => return Err("pty_network_invalid".into()),
+        };
+        let mut argv = crate::mod_pty::argv(arguments)?;
+        let program = codex_omd::host::resolve_program(&argv[0], &paths.repository)
+            .ok_or("pty_program_unavailable")?;
+        if let Some(expected) = arguments["sha256"].as_str()
+            && codex_omd::host::program_hash(&program)? != expected
+        {
+            return Err("pty_program_changed".into());
+        }
+        argv[0] = program.to_string_lossy().into_owned();
+        let mut command = crate::mod_runtime::sandboxed_command(
+            &paths,
+            &policy,
+            argv,
+            &scratch,
+            arguments["write"] == true,
+            loopback,
+        )?;
+        command.current_dir(cwd);
+        Ok((command, scratch))
+    }
+
+    pub(super) async fn handle_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+    ) {
+        match confirmation(&call) {
+            Ok(Some((prompt, package))) => self.confirm_mod_surface_call(call, prompt, package),
+            Ok(None) => self.run_mod_surface_call(tui, app_server, call, None).await,
+            Err(error) => {
+                let _ = call.reply.send(Err(error));
+            }
+        }
+    }
+
+    fn confirm_mod_surface_call(
+        &mut self,
+        call: SurfaceCall,
+        prompt: String,
+        package: Option<PackageControl>,
+    ) {
+        let caller = call.caller.clone();
+        let id = crate::mod_surface::hold(call);
+        if let Some(package) = package {
+            package_controls().insert(id, package);
+        }
+        let item = |name: &str, approved: bool| SelectionItem {
+            name: name.to_owned(),
+            actions: vec![Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed { id, approved });
+                },
+            )],
+            dismiss_on_select: true,
+            ..Default::default()
+        };
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some(format!("Confirm request from mod {caller}")),
+            subtitle: Some(prompt),
+            items: vec![item("Allow once", true), item("Decline", false)],
+            on_cancel: Some(Box::new(
+                move |tx: &crate::app_event_sender::AppEventSender| {
+                    tx.send(AppEvent::ModSurfaceConfirmed {
+                        id,
+                        approved: false,
+                    });
+                },
+            )),
+            ..SelectionViewParams::picker()
+        });
+    }
+
+    pub(super) async fn handle_mod_surface_confirmed(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        id: u64,
+        approved: bool,
+    ) {
+        let package = package_controls().remove(&id);
+        let Some(call) = crate::mod_surface::release(id) else {
+            return;
+        };
+        if !approved {
+            let _ = call.reply.send(Ok(json!({"status": "declined"})));
+            return;
+        }
+        self.run_mod_surface_call(tui, app_server, call, package)
+            .await;
+    }
+
+    async fn run_mod_surface_call(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        call: SurfaceCall,
+        package: Option<PackageControl>,
+    ) {
+        let result = match call.operation.as_str() {
+            "app.request" => {
+                let method = call.arguments["method"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .to_owned();
+                let mut params = call.arguments["params"].clone();
+                if let Err(error) =
+                    translate_images(&call.caller, call.thread.as_deref(), &mut params)
+                {
+                    let _ = call.reply.send(Err(error));
+                    return;
+                }
+                let request =
+                    json!({"method": method, "id": app_server.next_request_id(), "params": params});
+                match serde_json::from_value::<codex_app_server_protocol::ClientRequest>(request) {
+                    Ok(request) => {
+                        let handle = app_server.request_handle();
+                        let reply = call.reply;
+                        tokio::spawn(async move {
+                            let result = handle
+                                .request_typed::<Value>(request)
+                                .await
+                                .map_err(|error| error.to_string());
+                            let _ = reply.send(result);
+                        });
+                        return;
+                    }
+                    Err(error) => Err(format!("app_params_invalid: {error}")),
+                }
+            }
+            "terminal.notify" => Ok(self.mod_notify(tui, &call.arguments)),
+            "terminal.show_thread" => match call.arguments["thread_id"]
+                .as_str()
+                .and_then(|thread| codex_protocol::ThreadId::from_string(thread).ok())
+            {
+                Some(thread) => {
+                    self.app_event_tx.send(AppEvent::SelectAgentThread(thread));
+                    Ok(json!({"shown": true}))
+                }
+                None => Err("thread_id_invalid".into()),
+            },
+            "terminal.import_file" => import_file(&call),
+            "terminal.image_sample" => image_sample(&call),
+            "terminal.open" => open(&call.arguments),
+            "terminal.pty" if call.arguments["action"] == "start" => {
+                let command = (call.context == codex_omd::app_routes::InvocationContext::User)
+                    .then_some(())
+                    .ok_or_else(|| "host_operation_user_only: terminal.pty start".to_owned())
+                    .and_then(|()| self.mod_shell_command(&call.arguments));
+                match command {
+                    Ok((command, home)) => {
+                        crate::mod_pty::start(
+                            &call.caller,
+                            &call.arguments,
+                            command,
+                            &home,
+                            tui.frame_requester(),
+                        )
+                        .await
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            "terminal.pty" => crate::mod_pty::call(&call.caller, &call.arguments),
+            "terminal.prompt" if call.arguments["kind"] == "confirm" => {
+                Ok(json!({"status": "accepted"}))
+            }
+            "terminal.prompt" => {
+                let title = match (
+                    prompt_text(&call.arguments["title"], 120),
+                    prompt_text(&call.arguments["message"], 2000),
+                ) {
+                    (Ok(title), Ok(message)) if call.arguments["kind"] == "text" => {
+                        (title, message)
+                    }
+                    _ => {
+                        let _ = call.reply.send(Err("terminal_prompt_invalid".into()));
+                        return;
+                    }
+                };
+                let reply = call.reply;
+                let view = crate::bottom_pane::SecretPromptView::new(
+                    format!("Mod {} asks: {}", call.caller, title.0),
+                    title.1,
+                    Box::new(move |value| {
+                        let _ = reply.send(Ok(match value {
+                            Some(value) => json!({"status": "accepted", "value": value}),
+                            None => json!({"status": "declined"}),
+                        }));
+                    }),
+                );
+                let view = if call.arguments["masked"] == true {
+                    view
+                } else {
+                    view.plain()
+                };
+                self.chat_widget.show_mod_secret_prompt(view);
+                return;
+            }
+            "packages.apply" => apply_package(package),
+            "composer.read" => Ok(self.chat_widget.mod_composer_read()),
+            "composer.write" => {
+                let attachments =
+                    call.arguments["attach"]
+                        .as_array()
+                        .map(Vec::as_slice)
+                        .unwrap_or_default()
+                        .iter()
+                        .take(8)
+                        .map(|item| {
+                            match item.as_object().map(|item| (item.len(), item.get("image"))) {
+                                Some((1, Some(image))) => {
+                                    materialize(&call.caller, call.thread.as_deref(), image)
+                                }
+                                _ => Err("composer_attach_invalid: attach a resource reference"
+                                    .to_owned()),
+                            }
+                        })
+                        .collect::<Result<Vec<_>, _>>();
+                match attachments {
+                    Ok(attachments) => {
+                        let mut arguments = call.arguments.clone();
+                        if let Some(object) = arguments.as_object_mut() {
+                            object.remove("attach");
+                        }
+                        self.chat_widget.mod_composer_write(&arguments, attachments)
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            "builtins.invoke" => match call.arguments["action"].as_str() {
+                Some(action) => {
+                    let keys = crate::omd::builtin_keys();
+                    let key =
+                        crate::keymap_overlay::overlay(&self.local_settings.tui.keymap, &keys)
+                            .and_then(|(_, runtime)| {
+                                crate::keymap_overlay::action_key(&runtime, action)
+                            });
+                    match key {
+                        Ok(key) => {
+                            let _ = call.reply.send(Ok(json!({"invoked": true})));
+                            self.handle_key_event(tui, app_server, key).await;
+                            tui.frame_requester().schedule_frame();
+                            return;
+                        }
+                        Err(error) => Err(error),
+                    }
+                }
+                None => self.chat_widget.mod_invoke_builtin(&call.arguments),
+            },
+            "credentials.request" => {
+                self.run_mod_credentials(call);
+                tui.frame_requester().schedule_frame();
+                return;
+            }
+            operation => Err(format!("unsupported_host_operation: {operation}")),
+        };
+        let _ = call.reply.send(result);
+        tui.frame_requester().schedule_frame();
+    }
+
+    fn mod_notify(&mut self, tui: &mut tui::Tui, arguments: &Value) -> Value {
+        let title = arguments["title"].as_str().unwrap_or_default();
+        let body = arguments["body"].as_str().unwrap_or_default();
+        if title.trim().is_empty() {
+            return json!({"delivered": false, "method": "none", "reason": "title_required"});
+        }
+        if !crate::mod_surface::notify_allowed() {
+            return json!({"delivered": false, "method": "none", "reason": "rate_limited"});
+        }
+        match tui.notify_titled(title, body) {
+            Ok(method) => json!({"delivered": true, "method": method}),
+            Err(reason) => json!({"delivered": false, "method": "none", "reason": reason}),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn open_targets_are_web_urls_or_inert_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let page = dir.path().join("page.html");
+        let script = dir.path().join("run.command");
+        std::fs::write(&page, "<p>hi</p>").unwrap();
+        std::fs::write(&script, "echo hi").unwrap();
+        assert!(open_target(&json!({"url": "https://example.com/a"})).is_ok());
+        assert!(open_target(&json!({"path": page})).is_ok());
+        for refused in [
+            json!({"url": "javascript:alert(1)"}),
+            json!({"url": "https://example.com/a b"}),
+            json!({"path": script}),
+            json!({"path": dir.path()}),
+            json!({"url": "https://example.com", "path": page}),
+        ] {
+            assert!(open_target(&refused).is_err());
+        }
+    }
+    #[test]
+    fn image_samples_reject_unbounded_fractional_or_missing_sizes() {
+        assert_eq!(
+            image_sample_dimensions(&json!({"columns":120,"rows":60})).unwrap(),
+            (120, 60)
+        );
+        for value in [
+            json!({"columns":121,"rows":1}),
+            json!({"columns":1,"rows":61}),
+            json!({"columns":0,"rows":1}),
+            json!({"columns":1.5,"rows":2}),
+            json!({"columns":-1,"rows":2}),
+            json!({"columns":1}),
+        ] {
+            assert!(image_sample_dimensions(&value).is_err(), "{value}");
+        }
+    }
+}
