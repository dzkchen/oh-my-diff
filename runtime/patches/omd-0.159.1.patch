+use super::*;
+
+fn profiles() -> (tempfile::TempDir, CredentialProfiles) {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let profiles = CredentialProfiles::open(&root).unwrap();
+    (temp, profiles)
+}
+
+#[test]
+fn profiles_get_private_homes_and_one_default() {
+    let (_temp, profiles) = profiles();
+    let work = profiles.create("work", "chatgpt", None).unwrap();
+    let key = profiles
+        .create("openrouter", "api_key", Some("openrouter"))
+        .unwrap();
+    assert_eq!(
+        (work.id.as_str(), work.default, key.default),
+        ("p1", true, false)
+    );
+    let home = profiles.home(&key.id).unwrap();
+    use std::os::unix::fs::PermissionsExt;
+    assert_eq!(
+        fs::metadata(&home).unwrap().permissions().mode() & 0o777,
+        0o700
+    );
+    assert_ne!(home, profiles.home(&work.id).unwrap());
+    profiles.set_default(&key.id).unwrap();
+    let listed = profiles.list().unwrap();
+    assert_eq!(
+        listed
+            .iter()
+            .filter(|p| p.default)
+            .map(|p| p.id.as_str())
+            .collect::<Vec<_>>(),
+        ["p2"]
+    );
+    assert!(!serde_json::to_string(&listed).unwrap().contains("token"));
+}
+
+#[test]
+fn removing_the_default_promotes_another_and_returns_the_home_to_clear() {
+    let (_temp, profiles) = profiles();
+    profiles.create("a", "chatgpt", None).unwrap();
+    profiles
+        .create_secret("site", "https://example.com", "vault")
+        .unwrap();
+    profiles.create("b", "chatgpt", None).unwrap();
+    let home = profiles.remove("p1").unwrap().unwrap();
+    assert!(home.ends_with("credentials/p1"));
+    let listed = profiles.list().unwrap();
+    assert_eq!(
+        listed
+            .iter()
+            .map(|p| (p.id.as_str(), p.default))
+            .collect::<Vec<_>>(),
+        [("p2", false), ("p3", true)]
+    );
+    assert_eq!(profiles.remove("p1").unwrap(), None);
+    assert!(profiles.home("p1").is_err());
+}
+
+#[test]
+fn invalid_profiles_and_limits_are_refused() {
+    let (_temp, profiles) = profiles();
+    assert!(profiles.create("", "chatgpt", None).is_err());
+    assert!(profiles.create("x\n", "chatgpt", None).is_err());
+    assert!(profiles.create("x", "oauth2", None).is_err());
+    profiles.create("x", "chatgpt", None).unwrap();
+    assert!(profiles.create("x", "chatgpt", None).is_err());
+    for n in 1..PROFILE_LIMIT {
+        profiles.create(&format!("p{n}"), "api_key", None).unwrap();
+    }
+    assert_eq!(
+        profiles
+            .create("overflow", "api_key", None)
+            .unwrap_err()
+            .to_string(),
+        "credential_profile_limit"
+    );
+    assert!(profiles.set_default("p999").is_err());
+}
+
+#[test]
+fn secrets_read_api_keys_and_refuse_expired_or_missing_tokens() {
+    use base64::Engine;
+    let (_temp, profiles) = profiles();
+    let key = profiles.create("key", "api_key", None).unwrap();
+    let chat = profiles.create("chat", "chatgpt", None).unwrap();
+    assert!(
+        profiles
+            .secret(&key.id)
+            .unwrap_err()
+            .to_string()
+            .starts_with("credential_not_enrolled")
+    );
+    fs::write(
+        profiles.home(&key.id).unwrap().join("auth.json"),
+        br#"{"OPENAI_API_KEY":"sk-test"}"#,
+    )
+    .unwrap();
+    let secret = profiles.secret(&key.id).unwrap();
+    assert_eq!(
+        (secret.token.as_str(), secret.account_id),
+        ("sk-test", None)
+    );
+    assert!(!format!("{:?}", profiles.secret(&key.id).unwrap()).contains("sk-test"));
+    let jwt = |exp: u64| {
+        let claims = base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .encode(serde_json::json!({"exp": exp}).to_string());
+        format!("h.{claims}.s")
+    };
+    let write = |token: String| {
+        fs::write(
+            profiles.home(&chat.id).unwrap().join("auth.json"),
+            serde_json::json!({"tokens": {"access_token": token, "account_id": "acct"}})
+                .to_string(),
+        )
+        .unwrap();
+    };
+    write(jwt(1));
+    assert!(
+        profiles
+            .secret(&chat.id)
+            .unwrap_err()
+            .to_string()
+            .starts_with("credential_expired")
+    );
+    write(jwt(u64::MAX / 2));
+    let secret = profiles.secret(&chat.id).unwrap();
+    assert_eq!(secret.account_id.as_deref(), Some("acct"));
+    assert!(profiles.secret("p99").is_err());
+}
+
+#[test]
+fn secrets_are_origin_bound_and_readable_only_by_their_owner() {
+    let (_temp, profiles) = profiles();
+    assert!(
+        profiles
+            .create_secret("site", "https://example.com/login", "vault")
+            .is_err()
+    );
+    assert!(
+        profiles
+            .create_secret("site", "ftp://example.com", "vault")
+            .is_err()
+    );
+    let secret = profiles
+        .create_secret("site", "https://example.com:8443", "vault")
+        .unwrap();
+    assert!(!secret.default);
+    assert!(profiles.owned_secret(&secret.id, "vault").is_err());
+    assert_eq!(
+        profiles.visible("vault").unwrap()[0]["status"],
+        "not_enrolled"
+    );
+    profiles.store_secret(&secret.id, "hunter2").unwrap();
+    assert_eq!(profiles.visible("vault").unwrap()[0]["status"], "ready");
+    assert!(profiles.visible("other").unwrap().is_empty());
+    assert_eq!(
+        profiles.owned_secret(&secret.id, "vault").unwrap()["value"],
+        "hunter2"
+    );
+    assert!(profiles.owned_secret(&secret.id, "other").is_err());
+    assert!(profiles.secret(&secret.id).is_err());
+}
diff --git a/codex-rs/omd/src/data_store.rs b/codex-rs/omd/src/data_store.rs
new file mode 100644
index 000000000..5b8fd311f
--- /dev/null
+++ b/codex-rs/omd/src/data_store.rs
@@ -0,0 +1,389 @@
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::os::unix::fs::DirBuilderExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub const KEY_BYTES: usize = 256;
+pub const VALUE_BYTES: usize = crate::mods::HOST_RECEIPT_BYTES / 2;
+pub const SCOPE_BYTES: usize = 16 * 1024 * 1024;
+pub const KEY_LIMIT: usize = 4096;
+const LIST_LIMIT: usize = 256;
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Origin {
+    UserCommand,
+    Tool,
+    Event,
+    Cli,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct StoreProvenance {
+    pub r#mod: String,
+    pub source_sha256: String,
+    pub thread_id: Option<String>,
+    pub origin: Origin,
+    pub at: u128,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Entry {
+    value: Value,
+    revision: u64,
+    provenance: StoreProvenance,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Document {
+    schema: u32,
+    generation: u64,
+    next_revision: u64,
+    entries: BTreeMap<String, Entry>,
+}
+
+pub struct DataStore<'a> {
+    pub root: &'a Path,
+    pub repository_key: &'a str,
+    pub owner: &'a str,
+    pub provenance: StoreProvenance,
+}
+
+fn failure(message: impl ToString) -> io::Error {
+    io::Error::other(message.to_string())
+}
+
+fn key(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= KEY_BYTES
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_graphic() && byte != b'\\')
+}
+
+fn now() -> u128 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_millis())
+        .unwrap_or_default()
+}
+
+fn thread_directory(root: &Path, thread: &str) -> io::Result<PathBuf> {
+    if !crate::resource_data::token(thread) || root.canonicalize()? != root {
+        return Err(failure("store_thread_invalid"));
+    }
+    Ok(root.join("data").join("threads").join(thread))
+}
+
+fn copy_regular_tree(from: &Path, to: &Path) -> io::Result<()> {
+    fs::DirBuilder::new()
+        .recursive(true)
+        .mode(0o700)
+        .create(to)?;
+    for entry in fs::read_dir(from)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        let target = to.join(entry.file_name());
+        if kind.is_dir() {
+            copy_regular_tree(&entry.path(), &target)?;
+        } else if kind.is_file() && !entry.file_name().to_string_lossy().starts_with('.') {
+            fs::copy(entry.path(), &target)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn fork_thread_data(root: &Path, from: &str, to: &str) -> io::Result<bool> {
+    let (source, target) = (thread_directory(root, from)?, thread_directory(root, to)?);
+    match fs::symlink_metadata(&source) {
+        Ok(metadata) if metadata.is_dir() => {
+            if target.try_exists()? {
+                return Err(failure("store_thread_exists"));
+            }
+            copy_regular_tree(&source, &target).map(|()| true)
+        }
+        Ok(_) => Err(failure("store_directory_invalid")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+pub fn remove_thread_data(root: &Path, thread: &str) -> io::Result<bool> {
+    crate::turn_activity::TurnActivityLog::open(&root.join("turn-activity"), thread)?.remove()?;
+    let directory = thread_directory(root, thread)?;
+    match fs::symlink_metadata(&directory) {
+        Ok(metadata) if metadata.is_dir() => fs::remove_dir_all(&directory).map(|()| true),
+        Ok(_) => Err(failure("store_directory_invalid")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+impl DataStore<'_> {
+    fn directory(&self, scope: &str) -> io::Result<PathBuf> {
+        let components = match scope {
+            "repository" => vec!["data", self.repository_key, self.owner],
+            "user" => vec!["data", "user", self.owner],
+            "thread" => {
+                let thread = self
+                    .provenance
+                    .thread_id
+                    .as_deref()
+                    .ok_or_else(|| failure("store_thread_unavailable"))?;
+                if !crate::resource_data::token(thread) {
+                    return Err(failure("store_thread_invalid"));
+                }
+                vec!["data", "threads", thread, self.owner]
+            }
+            _ => return Err(failure("store_scope_invalid")),
+        };
+        if !crate::resource_data::token(self.owner)
+            || !(scope != "repository"
+                || self.repository_key.len() == 64
+                    && self
+                        .repository_key
+                        .bytes()
+                        .all(|byte| byte.is_ascii_hexdigit()))
+            || self.root.canonicalize()? != self.root
+        {
+            return Err(failure("store_root_invalid"));
+        }
+        let mut path = self.root.to_path_buf();
+        for component in components {
+            path.push(component);
+            match fs::DirBuilder::new().mode(0o700).create(&path) {
+                Ok(()) => (),
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (),
+                Err(error) => return Err(error),
+            }
+            let metadata = fs::symlink_metadata(&path)?;
+            if !metadata.is_dir() || metadata.file_type().is_symlink() {
+                return Err(failure("store_directory_invalid"));
+            }
+        }
+        Ok(path)
+    }
+
+    fn with_document<T>(
+        &self,
+        scope: &str,
+        write: bool,
+        change: impl FnOnce(&mut Document) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let directory = self.directory(scope)?;
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(directory.join(".store.lock"))?;
+        lock.lock()?;
+        let path = directory.join("store.json");
+        let mut document = match fs::symlink_metadata(&path) {
+            Ok(metadata) if metadata.is_file() && metadata.len() <= (SCOPE_BYTES * 2) as u64 => {
+                serde_json::from_slice::<Document>(&fs::read(&path)?)?
+            }
+            Ok(_) => return Err(failure("store_document_invalid")),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Document {
+                schema: 1,
+                generation: 1,
+                next_revision: 1,
+                entries: BTreeMap::new(),
+            },
+            Err(error) => return Err(error),
+        };
+        if document.schema != 1 {
+            return Err(failure("store_schema_unsupported"));
+        }
+        let value = change(&mut document)?;
+        if write {
+            let bytes = serde_json::to_vec(&document)?;
+            if bytes.len() > SCOPE_BYTES || document.entries.len() > KEY_LIMIT {
+                return Err(failure("store_quota"));
+            }
+            let temporary = directory.join(format!(".store.json.{}", std::process::id()));
+            let mut file = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&temporary)?;
+            let written = file.write_all(&bytes).and_then(|()| file.sync_all());
+            if let Err(error) = written.and_then(|()| fs::rename(&temporary, &path)) {
+                let _ = fs::remove_file(&temporary);
+                return Err(error);
+            }
+        }
+        Ok(value)
+    }
+
+    pub fn call(&self, operation: &str, arguments: Value) -> io::Result<Value> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Input {
+            #[serde(default)]
+            key: Option<String>,
+            #[serde(default)]
+            value: Option<Value>,
+            #[serde(default)]
+            expected_revision: Option<u64>,
+            #[serde(default)]
+            expected_generation: Option<u64>,
+            #[serde(default)]
+            prefix: Option<String>,
+            #[serde(default)]
+            cursor: Option<String>,
+            #[serde(default)]
+            limit: Option<usize>,
+            #[serde(default = "repository_scope")]
+            scope: String,
+        }
+        fn repository_scope() -> String {
+            "repository".into()
+        }
+        let revision_supplied = arguments
+            .as_object()
+            .is_some_and(|object| object.contains_key("expected_revision"));
+        let input: Input = serde_json::from_value(arguments)?;
+        let checked_key = || {
+            input
+                .key
+                .as_deref()
+                .filter(|value| key(value))
+                .ok_or_else(|| failure("store_key_invalid"))
+        };
+        match operation {
+            "store.get" => {
+                let name = checked_key()?.to_owned();
+                self.with_document(&input.scope, false, |document| {
+                    Ok(document.entries.get(&name).map_or(Value::Null, |entry| {
+                        json!({"value": entry.value, "revision": entry.revision, "provenance": entry.provenance})
+                    }))
+                })
+            }
+            "store.put" => {
+                let name = checked_key()?.to_owned();
+                let value = input
+                    .value
+                    .clone()
+                    .ok_or_else(|| failure("store_value_required"))?;
+                if serde_json::to_vec(&value)?.len() > VALUE_BYTES {
+                    return Err(failure("store_value_limit"));
+                }
+                if !revision_supplied {
+                    return Err(failure("store_expected_revision_required"));
+                }
+                let expected = input.expected_revision;
+                let provenance = StoreProvenance {
+                    at: now(),
+                    ..self.provenance.clone()
+                };
+                self.with_document(&input.scope, true, |document| {
+                    let current = document.entries.get(&name).map(|entry| entry.revision);
+                    if current != expected {
+                        return Err(failure(format!(
+                            "store_revision_conflict: current {}",
+                            current.map_or("absent".to_owned(), |value| value.to_string())
+                        )));
+                    }
+                    let revision = document.next_revision;
+                    document.next_revision += 1;
+                    document.entries.insert(
+                        name,
+                        Entry {
+                            value,
+                            revision,
+                            provenance,
+                        },
+                    );
+                    Ok(json!({"revision": revision}))
+                })
+            }
+            "store.delete" => {
+                let name = checked_key()?.to_owned();
+                let expected = input
+                    .expected_revision
+                    .ok_or_else(|| failure("store_expected_revision_required"))?;
+                self.with_document(&input.scope, true, |document| {
+                    match document.entries.get(&name) {
+                        Some(entry) if entry.revision == expected => {
+                            document.entries.remove(&name);
+                            Ok(json!({"deleted": true}))
+                        }
+                        Some(_) => Err(failure("store_revision_conflict")),
+                        None => Ok(json!({"deleted": false})),
+                    }
+                })
+            }
+            "store.list" => {
+                let prefix = input.prefix.clone().unwrap_or_default();
+                let limit = input.limit.unwrap_or(LIST_LIMIT).clamp(1, LIST_LIMIT);
+                self.with_document(&input.scope, false, |document| {
+                    let keys = document
+                        .entries
+                        .iter()
+                        .filter(|(name, _)| name.starts_with(&prefix))
+                        .filter(|(name, _)| input.cursor.as_ref().is_none_or(|cursor| *name > cursor))
+                        .take(limit + 1)
+                        .map(|(name, entry)| {
+                            Ok(json!({"key": name, "revision": entry.revision,
+                                "bytes": serde_json::to_vec(&entry.value)?.len(), "provenance": entry.provenance}))
+                        })
+                        .collect::<io::Result<Vec<_>>>()?;
+                    let cursor = (keys.len() > limit).then(|| keys[limit - 1]["key"].clone());
+                    Ok(json!({"keys": &keys[..keys.len().min(limit)], "cursor": cursor.unwrap_or(Value::Null),
+                        "generation": document.generation}))
+                })
+            }
+            "store.export" => {
+                self.with_document(&input.scope, false, |document| {
+                    let mut entries = serde_json::Map::new();
+                    let mut bytes = 0;
+                    let mut cursor = Value::Null;
+                    for (name, entry) in document.entries.iter().filter(|(name, _)| {
+                        input.cursor.as_ref().is_none_or(|cursor| *name > cursor)
+                    }) {
+                        let value = serde_json::to_value(entry)?;
+                        let size = name.len() + serde_json::to_vec(&value)?.len();
+                        if !entries.is_empty() && bytes + size > VALUE_BYTES {
+                            cursor = json!(entries.keys().next_back());
+                            break;
+                        }
+                        bytes += size;
+                        entries.insert(name.clone(), value);
+                    }
+                    Ok(
+                        json!({"schema": 1, "owner": self.owner, "scope": input.scope,
+                    "generation": document.generation, "entries": entries, "cursor": cursor}),
+                    )
+                })
+            }
+            "store.reset" => {
+                let expected = input
+                    .expected_generation
+                    .ok_or_else(|| failure("store_expected_generation_required"))?;
+                self.with_document(&input.scope, true, |document| {
+                    if document.generation != expected {
+                        return Err(failure("store_generation_conflict"));
+                    }
+                    document.entries.clear();
+                    document.generation += 1;
+                    Ok(json!({"generation": document.generation}))
+                })
+            }
+            _ => Err(failure(format!("unsupported_host_operation: {operation}"))),
+        }
+    }
+}
diff --git a/codex-rs/omd/src/event_bus.rs b/codex-rs/omd/src/event_bus.rs
new file mode 100644
index 000000000..6dc2c07ae
--- /dev/null
+++ b/codex-rs/omd/src/event_bus.rs
@@ -0,0 +1,170 @@
+use crate::app_routes::subscribed;
+use serde_json::Value;
+use std::collections::{BTreeMap, VecDeque};
+use std::io;
+use std::sync::{LazyLock, Mutex};
+
+pub const CHANNEL_QUEUE_EVENTS: usize = 256;
+pub const CHANNEL_QUEUE_BYTES: usize = 1 << 20;
+pub const CHANNEL_EVENT_BYTES: usize = 64 * 1024;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChannelEvent {
+    pub publisher: String,
+    pub channel: String,
+    pub data: Value,
+    pub correlation: Option<String>,
+    pub sequence: u64,
+    pub dropped: u64,
+}
+
+#[derive(Debug, Default, PartialEq)]
+pub struct Delivery {
+    pub delivered: usize,
+    pub dropped: usize,
+}
+
+struct Subscriber {
+    patterns: Vec<String>,
+    queue: VecDeque<(ChannelEvent, usize)>,
+    bytes: usize,
+    dropped: u64,
+}
+
+pub struct EventBus {
+    subscribers: BTreeMap<String, Subscriber>,
+    sequences: BTreeMap<String, u64>,
+    max_events: usize,
+    max_bytes: usize,
+}
+
+static GLOBAL: LazyLock<Mutex<EventBus>> = LazyLock::new(|| Mutex::new(EventBus::default()));
+
+pub fn global() -> &'static Mutex<EventBus> {
+    &GLOBAL
+}
+
+impl Default for EventBus {
+    fn default() -> Self {
+        Self::new(CHANNEL_QUEUE_EVENTS, CHANNEL_QUEUE_BYTES)
+    }
+}
+
+fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 64
+        && name.bytes().all(|b| {
+            b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'_' | b'-' | b'.')
+        })
+}
+
+impl EventBus {
+    pub fn new(max_events: usize, max_bytes: usize) -> Self {
+        Self {
+            subscribers: BTreeMap::new(),
+            sequences: BTreeMap::new(),
+            max_events,
+            max_bytes,
+        }
+    }
+
+    pub fn subscribe(&mut self, subscriber: &str, patterns: Vec<String>) {
+        if patterns.is_empty() {
+            self.subscribers.remove(subscriber);
+            return;
+        }
+        let entry = self
+            .subscribers
+            .entry(subscriber.to_owned())
+            .or_insert_with(|| Subscriber {
+                patterns: Vec::new(),
+                queue: VecDeque::new(),
+                bytes: 0,
+                dropped: 0,
+            });
+        entry.patterns = patterns;
+    }
+
+    pub fn unsubscribe(&mut self, subscriber: &str) {
+        self.subscribers.remove(subscriber);
+    }
+
+    pub fn publish(
+        &mut self,
+        publisher: &str,
+        name: &str,
+        data: Value,
+        correlation: Option<String>,
+    ) -> io::Result<Delivery> {
+        if !valid_name(name) {
+            return Err(io::Error::other(format!("channel_name_invalid: {name}")));
+        }
+        let size = data.to_string().len();
+        if size > CHANNEL_EVENT_BYTES {
+            return Err(io::Error::other(format!("channel_event_too_large: {size}")));
+        }
+        if correlation.as_ref().is_some_and(|c| c.len() > 256) {
+            return Err(io::Error::other("channel_correlation_too_large"));
+        }
+        let channel = format!("{publisher}/{name}");
+        let sequence = self.sequences.entry(channel.clone()).or_default();
+        *sequence += 1;
+        let event = ChannelEvent {
+            publisher: publisher.to_owned(),
+            channel: channel.clone(),
+            data,
+            correlation,
+            sequence: *sequence,
+            dropped: 0,
+        };
+        let mut delivery = Delivery::default();
+        for subscriber in self
+            .subscribers
+            .values_mut()
+            .filter(|s| subscribed(&s.patterns, &channel))
+        {
+            subscriber.bytes += size;
+            subscriber.queue.push_back((event.clone(), size));
+            delivery.delivered += 1;
+            while subscriber.queue.len() > self.max_events
+                || (subscriber.bytes > self.max_bytes && subscriber.queue.len() > 1)
+            {
+                if let Some((_, old)) = subscriber.queue.pop_front() {
+                    subscriber.bytes -= old;
+                    subscriber.dropped += 1;
+                    delivery.dropped += 1;
+                }
+            }
+        }
+        Ok(delivery)
+    }
+
+    pub fn drain(&mut self, subscriber: &str, limit: usize) -> Vec<ChannelEvent> {
+        let Some(entry) = self.subscribers.get_mut(subscriber) else {
+            return Vec::new();
+        };
+        let count = limit.min(entry.queue.len());
+        let mut drained: Vec<_> = entry
+            .queue
+            .drain(..count)
+            .map(|(event, bytes)| {
+                entry.bytes -= bytes;
+                event
+            })
+            .collect();
+        if let Some(first) = drained.first_mut() {
+            first.dropped = std::mem::take(&mut entry.dropped);
+        }
+        drained
+    }
+
+    pub fn pending(&self, subscriber: &str) -> usize {
+        self.subscribers
+            .get(subscriber)
+            .map_or(0, |s| s.queue.len())
+    }
+}
+
