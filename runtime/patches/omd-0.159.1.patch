+});
+static APPLIED_SYNTAX: Mutex<Option<String>> = Mutex::new(None);
+static WARNED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+static BLOCKED_SNAPSHOT: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+
+static APPLIED_PLACEHOLDER: Mutex<Option<Option<String>>> = Mutex::new(None);
+
+pub(crate) fn sync_placeholder() -> Option<Option<String>> {
+    let current = with_cache(|cache| cache.snapshot.view.placeholder.clone()).flatten();
+    let mut applied = APPLIED_PLACEHOLDER
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if applied.as_ref() == Some(&current) {
+        return None;
+    }
+    *applied = Some(current.clone());
+    Some(current)
+}
+
+pub(crate) fn glyphs() -> BTreeMap<String, String> {
+    with_cache(|cache| cache.snapshot.view.theme.glyphs.clone())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|(source, display)| {
+            unicode_width::UnicodeWidthStr::width(source.as_str())
+                == unicode_width::UnicodeWidthStr::width(display.as_str())
+        })
+        .collect()
+}
+
+pub(crate) fn first_warning(key: &str) -> bool {
+    let mut warned = WARNED
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if warned.iter().any(|seen| seen == key) {
+        return false;
+    }
+    warned.push(key.to_owned());
+    true
+}
+
+pub(crate) fn sync_syntax_theme() -> Option<String> {
+    let requested = syntax_theme();
+    let mut applied = APPLIED_SYNTAX
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if *applied == requested {
+        return None;
+    }
+    let previous = std::mem::replace(&mut *applied, requested.clone());
+    match requested {
+        Some(name) => match crate::render::highlight::resolve_theme_with_configured_home(&name) {
+            Some(theme) => {
+                crate::render::highlight::set_syntax_theme(theme);
+                None
+            }
+            None => Some(format!(
+                "Mod syntax theme '{name}' is not installed; keeping the configured theme"
+            )),
+        },
+        None => {
+            if previous.is_some()
+                && let Some(theme) = crate::render::highlight::resolve_theme_with_configured_home(
+                    &crate::render::highlight::configured_theme_name(),
+                )
+            {
+                crate::render::highlight::set_syntax_theme(theme);
+            }
+            None
+        }
+    }
+}
