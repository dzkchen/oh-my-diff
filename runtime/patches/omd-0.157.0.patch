+    let mut dependency_manifest: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(dependency.join("mod.json")).unwrap()).unwrap();
+    dependency_manifest["dependencies"] = json!([{"id":"root_mod","version":"1.0.0"}]);
+    std::fs::write(
