+#[test]
+fn dependency_resolution_requires_separate_exact_trust_and_rejects_cycles() {
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let dependency = mod_package(&root, "dependency", "1.2.0", &["context"], json!([]));
