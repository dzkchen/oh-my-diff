+pub(super) fn isolated(
+    parent: &Config,
+    root: &Path,
+    reads: &[PathBuf],
+    denied: &[PathBuf],
+    writable: bool,
+) -> Result<Config, String> {
+    let cwd = AbsolutePathBuf::from_absolute_path_checked(root).map_err(error)?;
+    let mut entries = vec![Entry::new(
+        FileSystemPath::Path {
+            path: PathUri::from_abs_path(&cwd),
+        },
+        if writable {
+            Access::Write
+        } else {
+            Access::Read
+        },
+    )];
+    entries.push(Entry::new(
+        FileSystemPath::Special {
+            value: FileSystemSpecialPath::Minimal,
+        },
+        Access::Read,
+    ));
+    let metadata = root
+        .parent()
+        .map(|p| p.join("depot/.git"))
+        .filter(|p| p.is_dir());
+    let system_reads = [
+        "/usr/bin",
+        "/bin",
+        "/usr/sbin",
+        "/sbin",
+        "/Library/Developer/CommandLineTools/usr",
+    ]
+    .into_iter()
+    .map(PathBuf::from)
+    .filter(|p| p.exists());
+    let allowed_reads: Vec<_> = reads
+        .iter()
+        .cloned()
+        .chain(metadata)
+        .chain(system_reads)
+        .collect();
+    for path in &allowed_reads {
+        let path = AbsolutePathBuf::from_absolute_path_checked(path).map_err(error)?;
+        entries.push(Entry::new(
+            FileSystemPath::Path {
+                path: PathUri::from_abs_path(&path),
+            },
+            Access::Read,
+        ));
+    }
+    for path in denied
+        .iter()
+        .map(PathBuf::as_path)
+        .chain(std::iter::once(parent.codex_home.as_path()))
