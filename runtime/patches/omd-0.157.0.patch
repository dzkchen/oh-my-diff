+}
+
+impl ResourceStore<'_> {
+    pub(crate) fn directory(&self) -> io::Result<PathBuf> {
+        self.binding.validate()?;
+        if self.root.canonicalize()? != self.root || !fs::symlink_metadata(self.root)?.is_dir() {
+            return Err(io::Error::other("resource_root_invalid"));
+        }
+        let mut path = self.root.to_owned();
+        for component in ["resources", &self.binding.repository, &self.binding.owner] {
+            path.push(component);
+            match fs::DirBuilder::new().create(&path) {
+                Ok(()) => {
+                    use std::os::unix::fs::PermissionsExt;
+                    fs::set_permissions(&path, fs::Permissions::from_mode(0o700))?;
+                }
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (),
+                Err(error) => return Err(error),
+            }
+            if path.canonicalize()? != path || !fs::symlink_metadata(&path)?.is_dir() {
+                return Err(io::Error::other("resource_directory_invalid"));
+            }
+        }
+        Ok(path)
+    }
+
+    pub fn save(&self, kind: &str, payload: Value) -> io::Result<ResourceRef> {
+        if !token(kind) {
+            return Err(io::Error::other("resource_kind_invalid"));
+        }
+        let value = StoredResource {
+            binding: self.binding.clone(),
+            kind: kind.to_owned(),
+            payload,
+        };
+        let bytes = serde_json::to_vec(&value)?;
+        if bytes.len() > SNAPSHOT_BYTES {
+            return Err(io::Error::other("resource_snapshot_limit"));
+        }
+        let sha256 = hash(&bytes);
+        let name = format!("{sha256}.json");
+        let directory = self.directory()?;
+        let path = directory.join(&name);
+        let lock = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(rustix::fs::OFlags::NOFOLLOW.bits() as i32)
+            .open(directory.join(".resources.lock"))?;
+        lock.try_lock()
+            .map_err(|_| io::Error::other("resource_store_busy"))?;
+        if !path.try_exists()? {
+            let mut total = 0u64;
+            let mut entries = 0;
+            for entry in fs::read_dir(&directory)?.take(1025) {
+                let entry = entry?;
+                entries += 1;
+                if entry.file_type()?.is_symlink() {
+                    return Err(io::Error::other("resource_directory_invalid"));
+                }
+                if entry
+                    .path()
+                    .extension()
+                    .is_some_and(|extension| extension == "json")
+                {
+                    total = total.saturating_add(entry.metadata()?.len());
+                }
+            }
+            if entries >= 1024 || total.saturating_add(bytes.len() as u64) > 64 * 1024 * 1024 {
+                return Err(io::Error::other("resource_store_quota"));
+            }
+        }
+        match fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&path)
+        {
+            Ok(mut file) => {
+                if let Err(error) = file.write_all(&bytes).and_then(|()| file.sync_all()) {
+                    drop(file);
+                    let _ = fs::remove_file(&path);
+                    return Err(error);
+                }
+            }
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+                let snapshot = crate::Snapshot::capture(
+                    &directory,
+                    &BTreeSet::from([name.clone()]),
+                    SNAPSHOT_BYTES,
+                )?;
+                if snapshot
+                    .files
+                    .get(&name)
+                    .is_none_or(|file| file.bytes != bytes)
+                {
+                    return Err(io::Error::other("resource_integrity_failed"));
+                }
+            }
+            Err(error) => return Err(error),
+        }
+        Ok(ResourceRef {
+            reference: sha256.clone(),
+            sha256,
+        })
+    }
+
+    pub fn load(&self, reference: &ResourceRef, kind: &str) -> io::Result<Value> {
+        if reference.reference != reference.sha256
+            || reference.sha256.len() != 64
+            || !reference
+                .sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+        {
+            return Err(io::Error::other("resource_reference_invalid"));
+        }
+        let directory = self.directory()?;
+        let name = format!("{}.json", reference.reference);
+        let snapshot =
+            crate::Snapshot::capture(&directory, &BTreeSet::from([name.clone()]), SNAPSHOT_BYTES)?;
+        let bytes = &snapshot
+            .files
+            .get(&name)
+            .ok_or_else(|| io::Error::other("resource_unavailable"))?
+            .bytes;
+        if hash(bytes) != reference.sha256 {
+            return Err(io::Error::other("resource_integrity_failed"));
+        }
+        let value: StoredResource = serde_json::from_slice(bytes)?;
+        if value.binding != *self.binding || value.kind != kind {
+            return Err(io::Error::other("resource_scope_mismatch"));
+        }
+        Ok(value.payload)
+    }
+
+    pub fn page(
+        &self,
+        reference: &ResourceRef,
+        kind: &str,
+        cursor: usize,
+        max_bytes: usize,
+    ) -> io::Result<Value> {
+        if !(1..=PAGE_BYTES).contains(&max_bytes) {
+            return Err(io::Error::other("resource_page_limit"));
+        }
+        let payload = serde_json::to_string(&self.load(reference, kind)?)?;
+        if cursor > payload.len() || !payload.is_char_boundary(cursor) {
+            return Err(io::Error::other("resource_cursor_invalid"));
+        }
+        let mut end = cursor.saturating_add(max_bytes).min(payload.len());
+        while !payload.is_char_boundary(end) {
+            end -= 1;
+        }
+        if end == cursor && end < payload.len() {
+            return Err(io::Error::other("resource_page_too_small"));
+        }
+        Ok(
+            json!({"reference":reference,"text":&payload[cursor..end],"cursor":(end<payload.len()).then_some(end),"bytes":payload.len()}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/scoped_data.rs b/codex-rs/omd/src/scoped_data.rs
new file mode 100644
index 000000000..4b52a5e30
--- /dev/null
+++ b/codex-rs/omd/src/scoped_data.rs
@@ -0,0 +1,222 @@
+use crate::resource_data::{ResourceBinding, ResourceStore, hash};
+use crate::sessions::SessionIndex;
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::io;
+use std::path::PathBuf;
+
+pub struct ScopedDataHost {
+    pub root: PathBuf,
+    pub repository: PathBuf,
+    pub session_root: Option<PathBuf>,
+    pub session_database: Option<PathBuf>,
+    pub binding: ResourceBinding,
+    pub(crate) session_bytes: usize,
+}
+
+pub fn operation(name: &str) -> bool {
+    matches!(
+        name,
+        "evidence.read" | "evidence.write" | "sessions.list" | "sessions.read"
+    )
+}
+
+impl ScopedDataHost {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        owner: String,
+        thread: String,
+        source_sha256: String,
+    ) -> io::Result<Self> {
+        if repository.canonicalize()? != repository
+            || root.canonicalize()? != root
+            || root.starts_with(&repository)
+        {
+            return Err(io::Error::other("data_scope_invalid"));
+        }
+        let configuration = crate::ModStore::open(root.clone())?.configuration()?;
+        if !configuration
+            .mods
+            .iter()
+            .any(|selection| selection.enabled && selection.sha256 == source_sha256)
+        {
+            return Err(io::Error::other("data_source_not_selected"));
+        }
+        let binding = ResourceBinding {
+            repository: hash(repository.as_os_str().as_encoded_bytes()),
+            owner,
+            thread,
+            generation: configuration.revision,
+            source_sha256,
+        };
+        binding.validate()?;
+        Ok(Self {
+            root,
+            repository,
+            session_root,
+            session_database,
+            binding,
+            session_bytes: 0,
+        })
+    }
+
+    pub fn call(
+        &mut self,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        if !active() {
+            return Err(io::Error::other("data_operation_cancelled"));
+        }
+        let configuration = crate::ModStore::open(self.root.clone())?.configuration()?;
+        let selection = configuration
+            .mods
+            .iter()
+            .find(|selection| selection.enabled && selection.sha256 == self.binding.source_sha256)
+            .ok_or_else(|| io::Error::other("data_source_not_selected"))?;
+        let required = crate::ModHostCall {
+            operation: name.into(),
+            arguments: Value::Null,
+        }
+        .capability()
+        .map_err(|error| io::Error::other(error.to_string()))?;
+        if configuration.revision != self.binding.generation
+            || !selection.capabilities.iter().any(|cap| cap == required)
+        {
+            return Err(io::Error::other("data_selection_changed_or_revoked"));
+        }
+        if name == "evidence.read" {
+            #[derive(serde::Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Input {
+                reference: crate::resource_data::ResourceRef,
+                cursor: Option<usize>,
+                max_bytes: Option<usize>,
+            }
+            let input: Input = serde_json::from_value(arguments)?;
+            let mut last = io::Error::other("resource_unavailable");
+            for kind in ["turn", "evidence"] {
+                match self.resources().page(
+                    &input.reference,
+                    kind,
+                    input.cursor.unwrap_or(0),
+                    input.max_bytes.unwrap_or(crate::resource_data::PAGE_BYTES),
+                ) {
+                    Ok(page) => return Ok(page),
+                    Err(error) => last = error,
+                }
+            }
+            return Err(last);
+        }
+        if name == "evidence.write" {
+            #[derive(serde::Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct Input {
+                media_type: String,
+                content: Value,
+                #[serde(default)]
+                label: Option<String>,
+            }
+            let input: Input = serde_json::from_value(arguments)?;
+            if !matches!(input.media_type.as_str(), "application/json" | "text/plain")
+                || input.media_type == "text/plain" && !input.content.is_string()
+                || input.label.as_deref().is_some_and(|label| {
+                    label.is_empty() || label.len() > 128 || label.chars().any(char::is_control)
+                })
+            {
+                return Err(io::Error::other("evidence_record_invalid"));
+            }
+            let reference = self.resources().save(
+                "evidence",
+                json!({"media_type": input.media_type, "label": input.label, "content": input.content}),
+            )?;
+            return Ok(serde_json::to_value(reference)?);
+        }
+        if name.starts_with("sessions.") {
+            let root = self
+                .session_root
+                .as_ref()
+                .ok_or_else(|| io::Error::other("session_access_unavailable"))?;
+            let result = SessionIndex {
+                root,
+                database: self.session_database.as_deref(),
+                repository: &self.repository,
+                enabled: true,
+            }
+            .call(name, arguments, active)?;
+            self.session_bytes = self
+                .session_bytes
+                .saturating_add(serde_json::to_vec(&result)?.len());
+            if self.session_bytes > 1_048_576 {
+                return Err(io::Error::other("session_invocation_limit"));
+            }
+            return Ok(result);
+        }
+        Err(io::Error::other("data_operation_unavailable"))
+    }
+
+    pub fn resources(&self) -> ResourceStore<'_> {
+        ResourceStore {
+            root: &self.root,
+            binding: &self.binding,
+        }
+    }
+}
+
+pub struct ScopedDataHosts {
+    root: PathBuf,
+    repository: PathBuf,
+    session_root: Option<PathBuf>,
+    session_database: Option<PathBuf>,
+    thread: String,
+    hosts: BTreeMap<String, ScopedDataHost>,
+}
+
+impl ScopedDataHosts {
+    pub fn new(
+        root: PathBuf,
+        repository: PathBuf,
+        session_root: Option<PathBuf>,
+        session_database: Option<PathBuf>,
+        thread: String,
+    ) -> Self {
+        Self {
+            root,
+            repository,
+            session_root,
+            session_database,
+            thread,
+            hosts: BTreeMap::new(),
+        }
+    }
+
+    pub fn call(
+        &mut self,
+        owner: &str,
+        source_sha256: &str,
+        name: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        let host = match self.hosts.entry(owner.to_owned()) {
+            std::collections::btree_map::Entry::Occupied(entry) => entry.into_mut(),
+            std::collections::btree_map::Entry::Vacant(entry) => entry.insert(ScopedDataHost::new(
+                self.root.clone(),
+                self.repository.clone(),
+                self.session_root.clone(),
+                self.session_database.clone(),
+                owner.to_owned(),
+                self.thread.clone(),
+                source_sha256.to_owned(),
+            )?),
+        };
+        if host.binding.source_sha256 != source_sha256 {
+            return Err(io::Error::other("data_selection_changed_or_revoked"));
+        }
+        host.call(name, arguments, active)
+    }
+}
diff --git a/codex-rs/omd/src/session_policy.rs b/codex-rs/omd/src/session_policy.rs
new file mode 100644
index 000000000..a907c0ac1
--- /dev/null
+++ b/codex-rs/omd/src/session_policy.rs
@@ -0,0 +1,132 @@
+use serde_json::Value;
+use std::collections::BTreeSet;
+use std::io::{self, Read};
+use std::path::Path;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+pub(crate) fn permitted(
+    root: &Path,
+    repository: &Path,
+    configured_database: Option<&Path>,
+    active: &dyn Fn() -> bool,
+) -> io::Result<Option<BTreeSet<String>>> {
+    let database = configured_database.map(Path::to_path_buf).unwrap_or(
+        root.parent()
+            .ok_or_else(|| io::Error::other("session_home_missing"))?
+            .join("state_5.sqlite"),
+    );
+    let home = database
+        .parent()
+        .ok_or_else(|| io::Error::other("session_home_missing"))?;
+    if home.try_exists()? {
+        for (ordinal, entry) in std::fs::read_dir(home)?.enumerate() {
+            if ordinal >= 4096 || !active() {
+                return Err(io::Error::other("session_policy_scan_limit_or_cancelled"));
+            }
+            let name = entry?.file_name().to_string_lossy().into_owned();
+            if let Some(version) = name
+                .strip_prefix("state_")
+                .and_then(|value| value.strip_suffix(".sqlite"))
+                && version.parse::<u32>().map_or(true, |version| version > 5) {
+                    return Err(io::Error::other("session_policy_version_unsupported"));
+                }
+        }
+    }
+    if !database.try_exists()? {
+        return Ok(None);
+    }
+    if database.canonicalize()? != database || !std::fs::symlink_metadata(&database)?.is_file() {
+        return Err(io::Error::other("session_policy_scope_invalid"));
+    }
+    if !active() {
+        return Err(io::Error::other("session_read_cancelled"));
+    }
+    let hex: String = repository
+        .as_os_str()
+        .as_encoded_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect();
+    let query = format!(
+        "PRAGMA query_only=ON; PRAGMA trusted_schema=OFF; SELECT id,memory_mode FROM threads WHERE cwd=CAST(X'{hex}' AS TEXT) ORDER BY id LIMIT 4097;"
+    );
+    let mut child = Command::new("/usr/bin/sqlite3")
+        .args([
+            "-batch",
+            "-json",
+            "-init",
+            "/dev/null",
+            "-cmd",
+            ".timeout 100",
+        ])
+        .arg(&database)
+        .arg(query)
+        .env_clear()
+        .env("HOME", "/nonexistent")
+        .current_dir(root)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| io::Error::other("session_policy_backend_unavailable"))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| io::Error::other("session_policy_pipe_unavailable"))?;
+    let reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stdout
+            .take(1_048_577)
+            .read_to_end(&mut bytes)
+            .map(|_| bytes)
+    });
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let result = loop {
+        if !active() || Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            break Err(io::Error::other("session_policy_cancelled_or_timed_out"));
+        }
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                break if status.success() {
+                    Ok(())
+                } else {
+                    Err(io::Error::other("session_policy_unavailable"))
+                };
+            }
+            Ok(None) => std::thread::sleep(Duration::from_millis(10)),
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                break Err(error);
+            }
+        }
+    };
+    let bytes = reader
+        .join()
+        .map_err(|_| io::Error::other("session_policy_reader_failed"))??;
+    result?;
+    if bytes.len() > 1_048_576 {
+        return Err(io::Error::other("session_policy_limit"));
+    }
+    if bytes.is_empty() {
+        return Ok(Some(BTreeSet::new()));
+    }
+    let rows: Vec<Value> = serde_json::from_slice(&bytes)?;
+    if rows.len() > 4096 {
+        return Err(io::Error::other("session_policy_limit"));
+    }
+    let mut allowed = BTreeSet::new();
+    for row in rows {
+        let id = row["id"]
+            .as_str()
+            .filter(|id| crate::resource_data::token(id))
+            .ok_or_else(|| io::Error::other("session_policy_identity_invalid"))?;
+        if row["memory_mode"] == "enabled" {
+            allowed.insert(id.to_owned());
+        }
+    }
+    Ok(Some(allowed))
+}
diff --git a/codex-rs/omd/src/sessions.rs b/codex-rs/omd/src/sessions.rs
new file mode 100644
index 000000000..36487c71c
--- /dev/null
+++ b/codex-rs/omd/src/sessions.rs
@@ -0,0 +1,470 @@
+use crate::resource_data::{PAGE_BYTES, hash, redact, token};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+use std::fs;
+use std::io::{self, BufRead, Read};
+use std::path::{Path, PathBuf};
+
+const SOURCE_BYTES: usize = 32 * 1024 * 1024;
+const HEAD_BYTES: u64 = 1024 * 1024;
+const SCAN_FILES: usize = 4096;
+const SCAN_BYTES: u64 = 128 * 1024 * 1024;
+
+pub struct SessionIndex<'a> {
+    pub root: &'a Path,
+    pub database: Option<&'a Path>,
+    pub repository: &'a Path,
+    pub enabled: bool,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct SessionSummary {
+    pub session_id: String,
+    pub task_id: String,
+    pub parent_id: Option<String>,
+    pub timestamp: String,
+    pub revision: String,
+    pub handle: String,
+    pub history_mode: String,
+    pub inherited_history: bool,
+    pub incomplete_tail: bool,
+}
+
+struct Session {
+    summary: SessionSummary,
+    meta: Value,
+    bytes: Vec<u8>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ListRequest {
+    since: Option<String>,
+    until: Option<String>,
+    cursor: Option<String>,
+    limit: Option<usize>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReadRequest {
+    session_id: String,
+    revision: String,
+    handle: String,
+    cursor: Option<usize>,
+    max_bytes: Option<usize>,
+}
+
+fn date(value: &str) -> bool {
+    let b = value.as_bytes();
+    b.len() == 10
+        && b[4] == b'-'
+        && b[7] == b'-'
+        && b.iter()
+            .enumerate()
+            .all(|(i, byte)| matches!(i, 4 | 7) || byte.is_ascii_digit())
+        && value[5..7]
+            .parse::<u32>()
+            .is_ok_and(|month| (1..=12).contains(&month))
+        && value[8..10]
+            .parse::<u32>()
+            .is_ok_and(|day| (1..=31).contains(&day))
+}
+
+fn cancelled() -> io::Error {
+    io::Error::other("session_read_cancelled")
+}
+
+fn in_range(timestamp: Option<&str>, since: Option<&String>, until: Option<&String>) -> bool {
+    timestamp
+        .and_then(|value| value.get(..10))
+        .is_some_and(|day| {
+            since.is_none_or(|since| day >= since.as_str())
+                && until.is_none_or(|until| day < until.as_str())
+        })
+}
+
+impl SessionIndex<'_> {
+    fn paths(&self, active: &dyn Fn() -> bool) -> io::Result<(Vec<PathBuf>, bool)> {
+        if !self.enabled {
+            return Err(io::Error::other("session_access_disabled"));
+        }
+        if !active() {
+            return Err(cancelled());
+        }
+        if self.repository.canonicalize()? != self.repository
+            || self.root.canonicalize()? != self.root
+            || !fs::symlink_metadata(self.root)?.is_dir()
+        {
+            return Err(io::Error::other("session_scope_not_canonical"));
+        }
+        let mut pending = vec![(self.root.to_path_buf(), 0)];
+        let mut paths = Vec::new();
+        let mut seen = 0;
+        let mut truncated = false;
+        while let Some((directory, depth)) = pending.pop() {
+            if !active() {
+                return Err(cancelled());
+            }
+            let mut entries = fs::read_dir(directory)?
+                .take(SCAN_FILES + 1 - seen)
+                .collect::<Result<Vec<_>, _>>()?;
+            entries.sort_by_key(|entry| entry.file_name());
+            for entry in entries {
+                seen += 1;
+                if seen > SCAN_FILES {
+                    truncated = true;
+                    pending.clear();
+                    break;
+                }
+                let kind = entry.file_type()?;
+                if kind.is_dir() && depth < 3 {
+                    pending.push((entry.path(), depth + 1));
+                } else if kind.is_file()
+                    && entry
+                        .path()
+                        .extension()
+                        .is_some_and(|extension| extension == "jsonl")
+                {
+                    paths.push(entry.path());
+                }
+            }
+        }
+        paths.sort();
+        Ok((paths, truncated))
+    }
+
+    fn name<'p>(&self, path: &'p Path) -> io::Result<&'p str> {
+        path.strip_prefix(self.root)
+            .map_err(io::Error::other)?
+            .to_str()
+            .ok_or_else(|| io::Error::other("session_path_encoding"))
+    }
+
+    fn scoped(&self, meta: &Value) -> bool {
+        meta["cwd"]
+            .as_str()
+            .and_then(|path| Path::new(path).canonicalize().ok())
+            .as_deref()
+            == Some(self.repository)
+    }
+
+    fn head(&self, path: &Path) -> io::Result<Option<Value>> {
+        let mut line = Vec::new();
+        io::BufReader::new(crate::workspace::open_contained(
+            self.root,
+            self.name(path)?,
+        )?)
+        .take(HEAD_BYTES)
+        .read_until(b'\n', &mut line)?;
+        let first: Value = serde_json::from_slice(&line)?;
+        Ok((first["type"] == "session_meta").then(|| first["payload"].clone()))
+    }
+
+    fn load(&self, path: &Path, active: &dyn Fn() -> bool) -> io::Result<Option<Session>> {
+        if !active() {
+            return Err(cancelled());
+        }
+        let name = self.name(path)?;
+        let snapshot =
+            crate::Snapshot::capture(self.root, &BTreeSet::from([name.to_owned()]), SOURCE_BYTES)?;
+        let mut bytes = snapshot
+            .files
+            .get(name)
+            .ok_or_else(|| io::Error::other("session_missing"))?
+            .bytes
+            .clone();
+        let complete = bytes
+            .iter()
+            .rposition(|byte| *byte == b'\n')
+            .map_or(0, |index| index + 1);
+        let incomplete_tail = complete != bytes.len();
+        bytes.truncate(complete);
+        let mut lines = bytes
+            .split(|byte| *byte == b'\n')
+            .filter(|line| !line.is_empty());
+        let first: Value = serde_json::from_slice(
+            lines
+                .next()
+                .ok_or_else(|| io::Error::other("session_empty"))?,
+        )?;
+        if first["type"] != "session_meta" {
+            return Ok(None);
+        }
+        let initial = &first["payload"];
+        let mut meta = initial.clone();
+        for line in
+            lines.filter(|line| line.windows(14).any(|window| window == b"\"session_meta\""))
+        {
+            if !active() {
+                return Err(cancelled());
+            }
+            let record: Value = serde_json::from_slice(line)?;
+            if record["type"] == "session_meta" {
+                if record["payload"]["id"] != initial["id"]
+                    || record["payload"]["cwd"] != initial["cwd"]
+                {
+                    return Err(io::Error::other("session_metadata_changed_identity"));
+                }
+                meta = record["payload"].clone();
+            }
+        }
+        if !self.scoped(&meta)
+            || meta["memory_mode"]
+                .as_str()
+                .is_some_and(|mode| mode != "enabled")
+            || meta["session_review"] == false
+        {
+            return Ok(None);
+        }
+        let id = meta["id"]
+            .as_str()
+            .filter(|id| token(id))
+            .ok_or_else(|| io::Error::other("session_id_invalid"))?;
+        let timestamp = meta["timestamp"]
+            .as_str()
+            .filter(|value| value.len() <= 40 && value.get(..10).is_some_and(date))
+            .ok_or_else(|| io::Error::other("session_timestamp_invalid"))?;
+        let summary = SessionSummary {
+            session_id: id.to_owned(),
+            task_id: meta["session_id"]
+                .as_str()
+                .filter(|id| token(id))
+                .unwrap_or(id)
+                .to_owned(),
+            parent_id: meta["parent_thread_id"]
+                .as_str()
+                .filter(|id| token(id))
+                .map(str::to_owned),
+            timestamp: timestamp.to_owned(),
+            revision: hash(&bytes),
+            handle: hash(name.as_bytes()),
+            history_mode: meta["history_mode"].as_str().unwrap_or("legacy").to_owned(),
+            inherited_history: !meta["history_base"].is_null() || !meta["forked_from_id"].is_null(),
+            incomplete_tail,
+        };
+        Ok(Some(Session {
+            summary,
+            meta,
+            bytes,
+        }))
+    }
+
+    fn records(
+        &self,
+        session: &Session,
+        active: &dyn Fn() -> bool,
+    ) -> io::Result<(Vec<Value>, bool)> {
+        let id = &session.summary.session_id;
+        let mut records = Vec::new();
+        let mut turn = String::new();
+        let mut in_scope = false;
+        let lines = session
+            .bytes
+            .split(|byte| *byte == b'\n')
+            .filter(|line| !line.is_empty())
+            .skip(1);
+        for (index, line) in lines.enumerate() {
+            if !active() {
+                return Err(cancelled());
+            }
+            let value: Value = serde_json::from_slice(line)?;
+            let payload = &value["payload"];
+            if let Some(start) = session.meta["subagent_history_start_ordinal"].as_u64() {
+                let ordinal = value["ordinal"].as_u64().unwrap_or(index as u64 + 1);
+                if ordinal < start {
+                    continue;
+                }
+            }
+            if value["type"] == "turn_context" {
+                in_scope = self.scoped(payload);
+                turn = payload["turn_id"]
+                    .as_str()
+                    .filter(|id| token(id))
+                    .unwrap_or_default()
+                    .to_owned();
+                continue;
+            }
+            if !in_scope
+                || value["type"] != "response_item"
+                || payload["type"] != "message"
+                || !matches!(payload["role"].as_str(), Some("user" | "assistant"))
+                || payload["channel"] == "analysis"
+            {
+                continue;
+            }
+            let text = payload["content"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter(|item| matches!(item["type"].as_str(), Some("input_text" | "output_text")))
+                .filter_map(|item| item["text"].as_str())
+                .collect::<Vec<_>>()
+                .join("\n");
+            if text.is_empty() {
+                continue;
+            }
+            let redacted = redact(&text);
+            let limited: String = redacted.chars().take(2048).collect();
+            records.push(json!({"session_id":id,"turn_id":turn,"item":index+1,"role":payload["role"],"text":limited,"truncated":limited.len()<redacted.len(),"redacted":redacted!=text,"timestamp":value["timestamp"],"untrusted":true}));
+            if records.len() >= 4096 {
+                return Ok((records, true));
+            }
+        }
+        Ok((records, false))
+    }
+
+    pub fn call(
+        &self,
+        operation: &str,
+        arguments: Value,
+        active: impl Fn() -> bool,
+    ) -> io::Result<Value> {
+        if !self.enabled {
+            return Err(io::Error::other("session_access_disabled"));
+        }
+        let policy =
+            crate::session_policy::permitted(self.root, self.repository, self.database, &active)?;
+        let allowed = |id: &str| policy.as_ref().is_none_or(|ids| ids.contains(id));
+        let result = match operation {
+            "sessions.list" => {
+                let input: ListRequest = serde_json::from_value(arguments)?;
+                let limit = input.limit.unwrap_or(20);
+                if !(1..=100).contains(&limit)
+                    || input.since.as_ref().is_some_and(|value| !date(value))
+                    || input.until.as_ref().is_some_and(|value| !date(value))
+                    || matches!((&input.since, &input.until), (Some(since), Some(until)) if since >= until)
+                {
+                    return Err(io::Error::other("session_list_bounds"));
+                }
+                let (paths, mut truncated) = self.paths(&active)?;
+                let (since, until) = (input.since.as_ref(), input.until.as_ref());
+                let mut unavailable = 0;
+                let mut scanned = 0u64;
+                let mut rows = Vec::new();
+                let mut ids = BTreeSet::new();
+                for path in paths.iter().rev() {
+                    let head = match self.head(path) {
+                        Ok(Some(head)) => head,
+                        Ok(None) => continue,
+                        Err(_) if !active() => return Err(cancelled()),
+                        Err(_) => {
+                            unavailable += 1;
+                            continue;
+                        }
+                    };
+                    if !self.scoped(&head) || !in_range(head["timestamp"].as_str(), since, until) {
+                        continue;
+                    }
+                    scanned = scanned
+                        .saturating_add(fs::symlink_metadata(path).map_or(0, |meta| meta.len()));
+                    if scanned > SCAN_BYTES {
+                        truncated = true;
+                        break;
+                    }
+                    match self.load(path, &active) {
+                        Ok(Some(session))
+                            if allowed(&session.summary.session_id)
+                                && in_range(Some(&session.summary.timestamp), since, until) =>
+                        {
+                            if !ids.insert((
+                                session.summary.session_id.clone(),
+                                session.meta["history_base"].to_string(),
+                            )) {
+                                return Err(io::Error::other("session_identity_ambiguous"));
+                            }
+                            rows.push(session.summary);
+                        }
+                        Ok(_) => (),
+                        Err(error) if !active() => return Err(error),
+                        Err(_) => unavailable += 1,
+                    }
+                }
+                rows.sort_by(|a, b| {
+                    (&b.timestamp, &b.session_id).cmp(&(&a.timestamp, &a.session_id))
+                });
+                let revision = hash(&serde_json::to_vec(&rows)?);
+                let start = match input.cursor {
+                    Some(cursor) => {
+                        let (digest, offset) = cursor
+                            .split_once(':')
+                            .ok_or_else(|| io::Error::other("session_cursor_invalid"))?;
+                        if digest != revision {
+                            return Err(io::Error::other("session_index_changed"));
+                        }
+                        offset.parse::<usize>().map_err(io::Error::other)?
+                    }
+                    None => 0,
+                };
+                if start > rows.len() {
+                    return Err(io::Error::other("session_cursor_invalid"));
+                }
+                let end = start.saturating_add(limit).min(rows.len());
+                Ok(
+                    json!({"sessions":rows[start..end],"cursor":(end<rows.len()).then(||format!("{revision}:{end}")),"revision":revision,"scan_truncated":truncated,"unavailable":unavailable,"projection":"local_visible_message_records"}),
+                )
+            }
+            "sessions.read" => {
+                let input: ReadRequest = serde_json::from_value(arguments)?;
+                let limit = input.max_bytes.unwrap_or(PAGE_BYTES);
+                if !token(&input.session_id)
+                    || input.revision.len() != 64
+                    || input.handle.len() != 64
+                    || !(1024..=PAGE_BYTES).contains(&limit)
+                {
+                    return Err(io::Error::other("session_read_bounds"));
+                }
+                if !allowed(&input.session_id) {
+                    return Err(io::Error::other("session_opted_out_or_unavailable"));
+                }
+                let (paths, _) = self.paths(&active)?;
+                let path = paths
+                    .iter()
+                    .find(|path| {
+                        self.name(path)
+                            .is_ok_and(|name| hash(name.as_bytes()) == input.handle)
+                    })
+                    .ok_or_else(|| io::Error::other("session_unavailable"))?;
+                let session = self
+                    .load(path, &active)?
+                    .filter(|session| session.summary.session_id == input.session_id)
+                    .ok_or_else(|| io::Error::other("session_unavailable"))?;
+                if input.revision != session.summary.revision {
+                    return Err(io::Error::other("session_revision_changed"));
+                }
+                let (records, projection_truncated) = self.records(&session, &active)?;
+                let start = input.cursor.unwrap_or(0);
+                if start > records.len() {
+                    return Err(io::Error::other("session_cursor_invalid"));
+                }
+                let mut end = start;
+                let mut bytes = 0;
+                while let Some(record) = records.get(end) {
+                    let size = serde_json::to_vec(record)?.len();
+                    if bytes + size > limit {
+                        break;
+                    }
+                    bytes += size;
+                    end += 1;
+                }
+                if end == start && end < records.len() {
+                    return Err(io::Error::other("session_record_exceeds_page"));
+                }
+                Ok(
+                    json!({"session":session.summary,"records":records[start..end],"cursor":(end<records.len()).then_some(end),"bytes":bytes,"projection":"local_visible_message_records","projection_truncated":projection_truncated}),
+                )
+            }
+            _ => Err(io::Error::other("session_operation_unavailable")),
+        }?;
+        if !active() {
+            return Err(cancelled());
+        }
+        if policy
+            != crate::session_policy::permitted(self.root, self.repository, self.database, &active)?
+        {
+            return Err(io::Error::other("session_policy_changed"));
+        }
+        Ok(result)
+    }
+}
diff --git a/codex-rs/omd/src/turn_evidence.rs b/codex-rs/omd/src/turn_evidence.rs
new file mode 100644
index 000000000..2b4fccce5
--- /dev/null
+++ b/codex-rs/omd/src/turn_evidence.rs
@@ -0,0 +1,88 @@
+use crate::resource_data::{SNAPSHOT_BYTES, redact};
+use serde_json::{Value, json};
+use std::io;
+
+pub fn project(
+    items: impl Iterator<Item = Value>,
+    turn: &str,
+    history_revision: u64,
+) -> io::Result<Value> {
+    let mut records = Vec::new();
+    let mut bytes = 0;
+    let mut truncated = false;
+    for (ordinal, item) in items.enumerate() {
+        if ordinal >= 4096 {
+            truncated = true;
+            break;
+        }
+        let record = match item["type"].as_str() {
+            Some("message")
+                if matches!(item["role"].as_str(), Some("user" | "assistant"))
+                    && item["channel"] != "analysis" =>
+            {
+                let text = item["content"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter(|part| {
+                        matches!(part["type"].as_str(), Some("input_text" | "output_text"))
+                    })
+                    .filter_map(|part| part["text"].as_str())
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                if text.is_empty() {
+                    continue;
+                }
+                let safe = redact(&text);
+                let bounded: String = safe.chars().take(8192).collect();
+                json!({"item":ordinal,"role":item["role"],"text":bounded,"redacted":safe!=text,"truncated":bounded.len()<safe.len()})
+            }
+            Some("function_call" | "custom_tool_call") => {
+                json!({"item":ordinal,"type":"tool_call","name":item["name"].as_str().unwrap_or_default().chars().take(128).collect::<String>(),"call_id":item["call_id"].as_str().unwrap_or_default().chars().take(128).collect::<String>()})
+            }
+            Some("function_call_output" | "custom_tool_call_output") => {
+                json!({"item":ordinal,"type":"tool_result","call_id":item["call_id"].as_str().unwrap_or_default().chars().take(128).collect::<String>(),"output_included":false})
+            }
+            _ => continue,
+        };
+        bytes += serde_json::to_vec(&record)?.len();
+        if bytes > SNAPSHOT_BYTES / 2 {
+            truncated = true;
+            break;
+        }
+        records.push(record);
+    }
+    Ok(
+        json!({"turn_id":turn,"history_revision":history_revision,"records":records,"truncated":truncated,"untrusted":true,"projection":"visible_messages_and_tool_references"}),
+    )
+}
+
+pub fn combine(prefix: Option<Value>, mut packet: Value) -> io::Result<Value> {
+    let mut records = Vec::new();
+    let mut bytes = 0;
+    let mut truncated = false;
+    let mut compacted = false;
+    for source in prefix.iter().chain(std::iter::once(&packet)) {
+        compacted |= prefix.is_some();
+        truncated |= source["truncated"] == true;
+        for mut record in source["records"]
+            .as_array()
+            .ok_or_else(|| io::Error::other("evidence_records_missing"))?
+            .clone()
+        {
+            if record.get("history_revision").is_none() {
+                record["history_revision"] = source["history_revision"].clone();
+            }
+            bytes += serde_json::to_vec(&record)?.len();
+            if bytes > SNAPSHOT_BYTES / 2 || records.len() == 4096 {
+                truncated = true;
+                break;
+            }
+            records.push(record);
+        }
+    }
+    packet["records"] = json!(records);
+    packet["truncated"] = json!(truncated);
+    packet["compacted"] = json!(compacted);
+    Ok(packet)
+}
diff --git a/codex-rs/omd/src/workspace.rs b/codex-rs/omd/src/workspace.rs
new file mode 100644
index 000000000..ea1cb6377
--- /dev/null
+++ b/codex-rs/omd/src/workspace.rs
@@ -0,0 +1,1189 @@
+use rustix::fs::AtFlags;
+use rustix::fs::Mode;
+use rustix::fs::OFlags;
+use rustix::fs::RenameFlags;
+use rustix::fs::mkdirat;
+use rustix::fs::open;
+use rustix::fs::openat;
+use rustix::fs::renameat_with;
+use rustix::fs::unlinkat;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fs;
+use std::io::Read;
+use std::io::Write;
+use std::io::{self};
+use std::os::unix::fs::PermissionsExt;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct File {
+    pub bytes: Vec<u8>,
+    pub executable: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct Snapshot {
+    pub files: BTreeMap<String, File>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct WorkspaceRename {
+    pub old: String,
+    pub new: String,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct WorkspaceTransaction {
+    pub expected: BTreeMap<String, Option<Fingerprint>>,
+    #[serde(default)]
+    pub writes: BTreeMap<String, String>,
+    #[serde(default)]
+    pub deletes: Vec<String>,
+    #[serde(default)]
+    pub renames: Vec<WorkspaceRename>,
+    #[serde(default)]
+    pub backup: bool,
+    #[serde(skip)]
+    pub byte_writes: BTreeMap<String, Vec<u8>>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(untagged)]
+pub enum Fingerprint {
+    Hash(String),
+    Stat { size: u64, mtime_ms: u64 },
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct WorkspaceTransactionResult {
+    pub files: BTreeMap<String, Option<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub backup: Option<serde_json::Value>,
+}
+
+pub type BackupSink<'a> = dyn Fn(&BTreeMap<String, Option<Vec<u8>>>) -> io::Result<serde_json::Value> + 'a;
+
+fn fingerprint_matches(
+    expected: &Option<Fingerprint>,
+    entry: &Option<(Vec<u8>, fs::Permissions)>,
+    metadata: Option<(u64, u64)>,
+) -> bool {
+    match (expected, entry) {
+        (None, None) => true,
+        (Some(Fingerprint::Hash(hash)), Some((bytes, _))) => *hash == content_hash(bytes),
+        (Some(Fingerprint::Stat { size, mtime_ms }), Some(_)) => {
+            metadata == Some((*size, *mtime_ms))
+        }
+        _ => false,
+    }
+}
+
+fn stat_fingerprint(root: &Path, name: &str) -> io::Result<Option<(u64, u64)>> {
+    let path = safe_path(root, name)?;
+    match fs::symlink_metadata(&path) {
+        Ok(metadata) if metadata.is_file() => Ok(Some((
+            metadata.len(),
+            metadata
+                .modified()?
+                .duration_since(std::time::UNIX_EPOCH)
+                .map_err(io::Error::other)?
+                .as_millis() as u64,
+        ))),
+        Ok(_) => Err(invalid("workspace path is not a regular file")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error),
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct WorkspaceIndex {
+    pub files: BTreeMap<String, String>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct WorkspaceChange {
+    pub path: String,
+    pub before: Option<String>,
+    pub after: Option<String>,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::other(message)
+}
+
+fn content_hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn read_version(
+    root: &Path,
+    name: &str,
+    max_bytes: usize,
+) -> io::Result<Option<(Vec<u8>, fs::Permissions)>> {
+    safe_path(root, name)?;
+    let directory = open_directory(root)?;
+    match open_source(&directory, name) {
+        Ok(mut input) => {
+            let metadata = input.metadata()?;
+            if !metadata.is_file() {
+                return Err(invalid("workspace path is not a regular file"));
+            }
+            if metadata.len() > max_bytes as u64 {
+                return Err(invalid("workspace file exceeds limit"));
+            }
+            let mut bytes = Vec::new();
+            Read::take(&mut input, max_bytes as u64 + 1).read_to_end(&mut bytes)?;
+            if bytes.len() > max_bytes {
+                return Err(invalid("workspace file exceeds limit"));
+            }
+            let after = input.metadata()?;
+            if !same_file(&metadata, &after)? {
+                return Err(invalid("workspace file changed during read"));
+            }
+            Ok(Some((bytes, metadata.permissions())))
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error),
+    }
+}
+
+fn write_version(
+    root: &Path,
+    name: &str,
+    bytes: &[u8],
+    permissions: &fs::Permissions,
+) -> io::Result<()> {
+    safe_path(root, name)?;
+    let (parent, target) = open_parent(root, name)?;
+    let temporary = format!(
+        ".{}.omd-transaction-{}-{}",
+        target.to_string_lossy(),
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_err(io::Error::other)?
+            .as_nanos(),
+    );
+    let mut output = fs::File::from(openat(
+        &parent,
+        temporary.as_str(),
+        OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+        Mode::from_raw_mode(0o600),
+    )?);
+    let result = (|| {
+        output.write_all(bytes)?;
+        output.set_permissions(permissions.clone())?;
+        output.sync_all()?;
+        rustix::fs::renameat(&parent, temporary.as_str(), &parent, &target)?;
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = unlinkat(&parent, temporary.as_str(), AtFlags::empty());
+    }
+    result
+}
+
+impl WorkspaceTransaction {
+    pub fn apply(
+        &self,
+        repository: &Path,
+        active: impl Fn() -> bool,
+    ) -> io::Result<WorkspaceTransactionResult> {
+        self.apply_with_backup(repository, active, None)
+    }
+
+    pub fn apply_with_backup(
+        &self,
+        repository: &Path,
+        active: impl Fn() -> bool,
+        backup: Option<&BackupSink<'_>>,
+    ) -> io::Result<WorkspaceTransactionResult> {
+        if !repository.is_absolute() || repository.canonicalize()? != repository {
+            return Err(invalid("repository must be canonical"));
+        }
+        if self.backup && backup.is_none() {
+            return Err(invalid("transaction backup unavailable"));
+        }
+        let writes = self
+            .writes
+            .iter()
+            .map(|(name, text)| (name.clone(), text.as_bytes().to_vec()))
+            .chain(self.byte_writes.clone())
+            .collect::<BTreeMap<_, _>>();
+        if writes.len() != self.writes.len() + self.byte_writes.len() {
+            return Err(invalid("duplicate write"));
+        }
+        let deletes = self.deletes.iter().cloned().collect::<BTreeSet<_>>();
+        if deletes.len() != self.deletes.len() || deletes.iter().any(|name| writes.contains_key(name)) {
+            return Err(invalid("duplicate or overlapping delete"));
+        }
+        let mut affected = writes.keys().cloned().collect::<BTreeSet<_>>();
+        affected.extend(deletes.iter().cloned());
+        let mut rename_sources = BTreeSet::new();
+        let mut rename_destinations = BTreeSet::new();
+        for rename in &self.renames {
+            if rename.old == rename.new
+                || !rename_sources.insert(rename.old.clone())
+                || !rename_destinations.insert(rename.new.clone())
+            {
+                return Err(invalid("duplicate or overlapping rename"));
+            }
+            affected.insert(rename.old.clone());
+            affected.insert(rename.new.clone());
+        }
+        if affected.is_empty()
+            || affected.len() > 128
+            || affected.len() != self.expected.len()
+            || affected
+                .iter()
+                .any(|name| !self.expected.contains_key(name))
+            || writes.values().map(Vec::len).sum::<usize>() > 4 * 1024 * 1024
+            || rename_sources
+                .iter()
+                .any(|name| rename_destinations.contains(name) || deletes.contains(name))
+            || rename_destinations
+                .iter()
+                .any(|name| writes.contains_key(name) || deletes.contains(name))
+        {
+            return Err(invalid("transaction scope or size invalid"));
+        }
+        let mut before = BTreeMap::new();
+        let mut observed_bytes = 0_usize;
+        for name in &affected {
+            if !active() {
+                return Err(invalid("transaction cancelled"));
+            }
+            let entry = read_version(repository, name, 4 * 1024 * 1024)?;
+            observed_bytes =
+                observed_bytes.saturating_add(entry.as_ref().map_or(0, |(bytes, _)| bytes.len()));
+            if observed_bytes > 4 * 1024 * 1024 {
+                return Err(invalid("transaction source bytes exceed limit"));
+            }
+            let expected = self.expected.get(name).cloned().flatten();
+            if !fingerprint_matches(&expected, &entry, stat_fingerprint(repository, name)?) {
+                return Err(invalid(&format!("stale expected version for {name}")));
+            }
+            before.insert(name.clone(), entry);
+        }
+        for name in &deletes {
+            if before.get(name).is_none_or(Option::is_none) {
+                return Err(invalid("delete target must exist"));
+            }
+        }
+        let backup = match backup.filter(|_| self.backup) {
+            Some(sink) => Some(sink(
+                &before
+                    .iter()
+                    .map(|(name, entry)| (name.clone(), entry.as_ref().map(|(bytes, _)| bytes.clone())))
+                    .collect(),
+            )?),
+            None => None,
+        };
+        let current_hash = |name: &str| -> io::Result<Option<String>> {
+            Ok(read_version(repository, name, 4 * 1024 * 1024)?
+                .as_ref()
+                .map(|(bytes, _)| content_hash(bytes)))
+        };
+        let before_hash = |name: &str| {
+            before
+                .get(name)
+                .and_then(Option::as_ref)
+                .map(|(bytes, _)| content_hash(bytes))
+        };
+        for rename in &self.renames {
+            if before.get(&rename.old).is_none_or(Option::is_none)
+                || before.get(&rename.new).is_some_and(Option::is_some)
+            {
+                return Err(invalid(
+                    "rename source must exist and destination must be absent",
+                ));
+            }
+        }
+        let mut applied = BTreeMap::new();
+        let result = (|| -> io::Result<()> {
+            for (name, bytes) in &writes {
+                if !active() {
+                    return Err(invalid("transaction cancelled"));
+                }
+                let current = read_version(repository, name, 4 * 1024 * 1024)?;
+                if current.as_ref().map(|(bytes, _)| content_hash(bytes)) != before_hash(name) {
+                    return Err(invalid("workspace changed before write"));
+                }
+                let permissions = current
+                    .as_ref()
+                    .map(|(_, permissions)| permissions.clone())
+                    .unwrap_or_else(|| fs::Permissions::from_mode(0o644));
+                write_version(repository, name, bytes, &permissions)?;
+                applied.insert(name.clone(), Some(content_hash(bytes)));
+            }
+            for name in &deletes {
+                if !active() {
+                    return Err(invalid("transaction cancelled"));
+                }
+                if current_hash(name)? != before_hash(name) {
+                    return Err(invalid("workspace changed before delete"));
+                }
+                let (parent, target) = open_parent(repository, name)?;
+                unlinkat(&parent, &target, AtFlags::empty())?;
+                applied.insert(name.clone(), None);
+            }
+            for rename in &self.renames {
+                if !active() {
+                    return Err(invalid("transaction cancelled"));
+                }
+                safe_path(repository, &rename.old)?;
+                safe_path(repository, &rename.new)?;
+                let (old_parent, old_name) = open_parent(repository, &rename.old)?;
+                let (new_parent, new_name) = open_parent(repository, &rename.new)?;
+                let expected_old = applied
+                    .get(&rename.old)
+                    .cloned()
+                    .unwrap_or_else(|| before_hash(&rename.old));
+                if read_version(repository, &rename.old, 4 * 1024 * 1024)?
+                    .as_ref()
+                    .map(|(bytes, _)| content_hash(bytes))
+                    != expected_old
+                    || read_version(repository, &rename.new, 4 * 1024 * 1024)?.is_some()
+                {
+                    return Err(invalid("workspace changed before rename"));
+                }
+                renameat_with(
+                    &old_parent,
+                    &old_name,
+                    &new_parent,
+                    &new_name,
+                    RenameFlags::NOREPLACE,
+                )?;
+                applied.insert(rename.old.clone(), None);
+                applied.insert(rename.new.clone(), expected_old);
+            }
+            Ok(())
+        })();
+        if let Err(error) = result {
+            for (name, expected_after) in &applied {
+                let current = read_version(repository, name, 4 * 1024 * 1024)?
+                    .as_ref()
+                    .map(|(bytes, _)| content_hash(bytes));
+                if &current != expected_after {
+                    return Err(invalid(&format!(
+                        "transaction failed: {error}; rollback conflict at {name}"
+                    )));
+                }
+            }
+            for name in applied.keys() {
+                match &before[name] {
+                    None => {
+                        safe_path(repository, name)?;
+                        let (parent, target) = open_parent(repository, name)?;
+                        if read_version(repository, name, 4 * 1024 * 1024)?.is_some() {
+                            unlinkat(&parent, &target, AtFlags::empty())?;
+                        }
+                    }
+                    Some((bytes, permissions)) => {
+                        write_version(repository, name, bytes, permissions)?;
+                    }
+                }
+            }
+            return Err(error);
+        }
+        let mut files = BTreeMap::new();
+        for name in &affected {
+            files.insert(
+                name.clone(),
+                read_version(repository, name, 4 * 1024 * 1024)?
+                    .as_ref()
+                    .map(|(bytes, _)| content_hash(bytes)),
+            );
+        }
+        Ok(WorkspaceTransactionResult { files, backup })
+    }
+}
+
+impl WorkspaceIndex {
+    pub fn capture(repository: &Path, max_files: usize, max_bytes: usize) -> io::Result<Self> {
+        if !repository.is_absolute() || repository.canonicalize()? != repository {
+            return Err(invalid("repository must be canonical"));
+        }
+        let mut stack = vec![repository.to_path_buf()];
+        let mut files = BTreeMap::new();
+        let mut bytes = 0_usize;
+        while let Some(directory) = stack.pop() {
+            for entry in fs::read_dir(directory)? {
+                let entry = entry?;
+                let path = entry.path();
+                let metadata = fs::symlink_metadata(&path)?;
+                if metadata.file_type().is_symlink() {
+                    continue;
+                }
+                if metadata.is_dir() {
+                    if !matches!(
+                        entry.file_name().to_str(),
+                        Some(
+                            ".git"
+                                | ".omd"
+                                | ".docs"
+                                | ".pnpm-store"
+                                | ".pytest_cache"
+                                | ".ruff_cache"
+                                | ".mypy_cache"
+                                | ".tox"
+                                | ".gradle"
+                                | "__pycache__"
+                                | "target"
+                                | "node_modules"
+                                | ".venv"
+                                | "venv"
+                                | "build"
+                                | "dist"
+                        )
+                    ) {
+                        stack.push(path);
+                    }
+                } else if metadata.is_file() {
+                    bytes = bytes.saturating_add(metadata.len() as usize);
+                    if files.len() >= max_files || bytes > max_bytes {
+                        return Err(invalid("workspace index exceeds bounds"));
+                    }
+                    let name = path
+                        .strip_prefix(repository)
+                        .map_err(|_| invalid("workspace path escaped repository"))?
+                        .to_str()
+                        .ok_or_else(|| invalid("non-UTF8 workspace path"))?
+                        .to_owned();
+                    let (content, _) = read_version(repository, &name, max_bytes)?
+                        .ok_or_else(|| invalid("workspace file disappeared during index"))?;
+                    files.insert(name, content_hash(&content));
+                }
+            }
+        }
+        Ok(Self { files })
+    }
+
+    pub fn changed(&self, after: &Self) -> Vec<WorkspaceChange> {
+        self.files
+            .keys()
+            .chain(after.files.keys())
+            .collect::<BTreeSet<_>>()
+            .into_iter()
+            .filter_map(|path| {
+                let before_hash = self.files.get(path).cloned();
+                let after_hash = after.files.get(path).cloned();
+                (before_hash != after_hash).then(|| WorkspaceChange {
+                    path: path.clone(),
+                    before: before_hash,
+                    after: after_hash,
+                })
+            })
+            .collect()
+    }
+}
+
+pub const INDEX_FILES: usize = 20_000;
+pub const INDEX_BYTES: usize = 128 * 1024 * 1024;
+const RECORDED_CHANGES: usize = 64;
+
+pub struct RecordedChange {
+    pub source: &'static str,
+    pub changes: Result<Vec<WorkspaceChange>, String>,
+}
+
+static OBSERVED: std::sync::Mutex<BTreeSet<PathBuf>> = std::sync::Mutex::new(BTreeSet::new());
+static RECORDED: std::sync::Mutex<BTreeMap<PathBuf, Vec<RecordedChange>>> =
+    std::sync::Mutex::new(BTreeMap::new());
+
+pub fn observe_workspace_changes(repository: &Path, observed: bool) {
+    if let Ok(mut repositories) = OBSERVED.lock() {
+        if observed {
+            repositories.insert(repository.to_path_buf());
+        } else {
+            repositories.remove(repository);
+        }
+    }
+}
+
+pub fn change_baseline(repository: &Path) -> Option<io::Result<WorkspaceIndex>> {
+    OBSERVED
+        .lock()
+        .is_ok_and(|repositories| repositories.contains(repository))
+        .then(|| WorkspaceIndex::capture(repository, INDEX_FILES, INDEX_BYTES))
+}
+
+pub fn record_workspace_change(
+    repository: &Path,
+    source: &'static str,
+    before: io::Result<WorkspaceIndex>,
+) {
+    let changes = before
+        .and_then(|before| {
+            WorkspaceIndex::capture(repository, INDEX_FILES, INDEX_BYTES)
+                .map(|after| before.changed(&after))
+        })
+        .map_err(|error| error.to_string());
+    if changes.as_ref().is_ok_and(Vec::is_empty) {
+        return;
+    }
+    if let Ok(mut recorded) = RECORDED.lock() {
+        let queue = recorded.entry(repository.to_path_buf()).or_default();
+        if queue.len() < RECORDED_CHANGES {
+            queue.push(RecordedChange { source, changes });
+        } else {
+            *queue = vec![RecordedChange {
+                source: "rescan",
+                changes: Err("workspace_change_queue_limit".into()),
+            }];
+        }
+    }
+}
+
+pub fn take_workspace_changes(repository: &Path) -> Vec<RecordedChange> {
+    RECORDED
+        .lock()
+        .ok()
+        .and_then(|mut recorded| recorded.remove(repository))
+        .unwrap_or_default()
+}
+
+fn safe_path(root: &Path, name: &str) -> io::Result<PathBuf> {
+    let path = Path::new(name);
+    if name.is_empty()
+        || name.len() > 4096
+        || name.contains('\\')
+        || path
+            .components()
+            .any(|part| !matches!(part, Component::Normal(value) if !value.to_string_lossy().eq_ignore_ascii_case(".git")))
+        || path.to_string_lossy() != name
+        || name.split('/').any(|part| part.is_empty() || part == ".")
+    {
+        return Err(invalid("unsafe snapshot path"));
+    }
+    let mut resolved = root.to_path_buf();
+    for part in path.components() {
+        resolved.push(part);
+        match fs::symlink_metadata(&resolved) {
+            Ok(metadata) if metadata.file_type().is_symlink() => {
+                return Err(invalid("snapshot symlink rejected"));
+            }
+            Ok(_) => (),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => (),
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(resolved)
+}
+
+pub fn workspace_path(root: &Path, name: &str) -> io::Result<PathBuf> {
+    safe_path(root, name)
+}
+
+pub(crate) fn open_contained(root: &Path, name: &str) -> io::Result<fs::File> {
+    open_source(&open_directory(&root.canonicalize()?)?, name)
+}
+
+fn open_directory(path: &Path) -> io::Result<fs::File> {
+    let flags = OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC;
+    let mut directory = fs::File::from(open("/", flags, Mode::empty())?);
+    for component in path.components() {
+        if let Component::Normal(name) = component {
+            directory = fs::File::from(openat(&directory, name, flags, Mode::empty())?);
+        }
+    }
+    Ok(directory)
+}
+
+fn open_parent(root: &Path, name: &str) -> io::Result<(fs::File, std::ffi::OsString)> {
+    let mut directory = open_directory(root)?;
+    let mut parts = Path::new(name).components().peekable();
+    while let Some(Component::Normal(part)) = parts.next() {
+        if parts.peek().is_none() {
+            return Ok((directory, part.to_os_string()));
+        }
+        directory = fs::File::from(openat(
+            &directory,
+            part,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )?);
+    }
+    Err(invalid("workspace parent missing"))
+}
+
+fn open_source(root: &fs::File, name: &str) -> io::Result<fs::File> {
+    let mut directory = root.try_clone()?;
+    let mut parts = Path::new(name).components().peekable();
+    while let Some(Component::Normal(name)) = parts.next() {
+        let flags = OFlags::RDONLY
+            | OFlags::NOFOLLOW
+            | OFlags::CLOEXEC
+            | if parts.peek().is_some() {
+                OFlags::DIRECTORY
+            } else {
+                OFlags::NONBLOCK
+            };
+        directory = fs::File::from(openat(&directory, name, flags, Mode::empty())?);
+    }
+    Ok(directory)
+}
+
+fn same_file(before: &fs::Metadata, after: &fs::Metadata) -> io::Result<bool> {
+    use std::os::unix::fs::MetadataExt;
+    Ok(before.is_file()
+        && after.is_file()
+        && before.dev() == after.dev()
+        && before.ino() == after.ino()
+        && before.len() == after.len()
+        && before.modified()? == after.modified()?
+        && before.ctime() == after.ctime()
+        && before.ctime_nsec() == after.ctime_nsec()
+        && before.mode() == after.mode()
+        && before.nlink() == 1
+        && after.nlink() == 1)
+}
+
+impl Snapshot {
+    pub fn capture(root: &Path, paths: &BTreeSet<String>, max_bytes: usize) -> io::Result<Self> {
+        let root = root.canonicalize()?;
+        let directory = open_directory(&root)?;
+        let mut files = BTreeMap::new();
+        let mut observed = BTreeMap::new();
+        let mut remaining = max_bytes;
+        for name in paths {
+            let path = safe_path(&root, name)?;
+            let mut input = match open_source(&directory, name) {
+                Ok(input) => input,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    observed.insert(name.clone(), None);
+                    continue;
+                }
+                Err(error) => return Err(error),
+            };
+            let metadata = input.metadata()?;
+            if !metadata.is_file() {
+                return Err(invalid("snapshot requires regular files"));
+            }
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::MetadataExt;
+                if metadata.nlink() != 1 {
+                    return Err(invalid("snapshot hardlink rejected"));
+                }
+            }
+            let mut bytes = Vec::new();
+            (&mut input)
+                .take(remaining.saturating_add(1) as u64)
+                .read_to_end(&mut bytes)?;
+            let cost = bytes
+                .len()
+                .checked_add(name.len())
+                .ok_or_else(|| invalid("snapshot size overflow"))?;
+            remaining = remaining
+                .checked_sub(cost)
+                .ok_or_else(|| invalid("snapshot size limit"))?;
+            let after = fs::symlink_metadata(&path)?;
+            if !same_file(&metadata, &input.metadata()?)? || !same_file(&metadata, &after)? {
+                return Err(invalid("source changed during snapshot"));
+            }
+            #[cfg(unix)]
+            let executable = {
+                use std::os::unix::fs::PermissionsExt;
+                metadata.permissions().mode() & 0o111 != 0
+            };
+            #[cfg(not(unix))]
+            let executable = false;
+            files.insert(name.clone(), File { bytes, executable });
+            observed.insert(name.clone(), Some(metadata));
+        }
+        for (name, before) in observed {
+            match (before, open_source(&directory, &name)) {
+                (None, Err(error)) if error.kind() == io::ErrorKind::NotFound => (),
+                (Some(before), Ok(current)) if same_file(&before, &current.metadata()?)? => (),
+                _ => return Err(invalid("source tree changed during snapshot")),
+            }
+        }
+        Ok(Self { files })
+    }
+
+    pub fn hash(&self) -> io::Result<String> {
+        Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(self)?)))
+    }
+
+    pub fn write_new(&self, root: &Path, max_bytes: usize) -> io::Result<()> {
+        let mut total = 0usize;
+        for (name, file) in &self.files {
+            safe_path(root, name)?;
+            total = total
+                .checked_add(name.len())
+                .and_then(|total| total.checked_add(file.bytes.len()))
+                .ok_or_else(|| invalid("snapshot size overflow"))?;
+            if total > max_bytes {
+                return Err(invalid("snapshot size limit"));
+            }
+            if Path::new(name)
+                .ancestors()
+                .skip(1)
+                .any(|parent| self.files.contains_key(parent.to_string_lossy().as_ref()))
+            {
+                return Err(invalid("snapshot file/directory collision"));
+            }
+        }
+        let parent = root
+            .parent()
+            .ok_or_else(|| invalid("missing snapshot parent"))?
+            .canonicalize()?;
+        let parent = open_directory(&parent)?;
+        let name = root
+            .file_name()
+            .ok_or_else(|| invalid("missing snapshot directory"))?;
+        mkdirat(&parent, name, Mode::from_raw_mode(0o700))?;
+        let directory = fs::File::from(openat(
+            &parent,
+            name,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )?);
+        for (name, file) in &self.files {
+            let mut parent = directory.try_clone()?;
+            let mut parts = Path::new(name).components().peekable();
+            while let Some(Component::Normal(name)) = parts.next() {
+                if parts.peek().is_some() {
+                    match mkdirat(&parent, name, Mode::from_raw_mode(0o700)) {
+                        Ok(()) | Err(rustix::io::Errno::EXIST) => (),
+                        Err(error) => return Err(error.into()),
+                    }
+                    parent = fs::File::from(openat(
+                        &parent,
+                        name,
+                        OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+                        Mode::empty(),
+                    )?);
+                } else {
+                    parent = fs::File::from(openat(
+                        &parent,
+                        name,
+                        OFlags::WRONLY
+                            | OFlags::CREATE
+                            | OFlags::EXCL
+                            | OFlags::NOFOLLOW
+                            | OFlags::CLOEXEC,
+                        Mode::from_raw_mode(0o600),
+                    )?);
+                }
+            }
+            let mut output = parent;
+            output.write_all(&file.bytes)?;
+            output.sync_all()?;
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                output.set_permissions(fs::Permissions::from_mode(if file.executable {
+                    0o755
+                } else {
+                    0o644
+                }))?;
+            }
+        }
+        if Self::capture(root, &self.files.keys().cloned().collect(), max_bytes)? != *self {
+            return Err(invalid(
+                "snapshot destination changed during materialization",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn changed_paths(&self, candidate: &Self) -> BTreeSet<String> {
+        self.files
+            .keys()
+            .chain(candidate.files.keys())
+            .filter(|name| self.files.get(*name) != candidate.files.get(*name))
+            .cloned()
+            .collect()
+    }
+
+    pub fn merge_candidate(&self, candidate: &Self, current: &Self) -> io::Result<Self> {
+        let changed = self.changed_paths(candidate);
+        for name in &changed {
+            if self.files.get(name) != current.files.get(name) {
+                return Err(invalid(&format!("intervening edit conflicts: {name}")));
+            }
+        }
+        let mut merged = current.clone();
+        for name in changed {
+            match candidate.files.get(&name) {
+                Some(file) => {
+                    merged.files.insert(name, file.clone());
+                }
+                None => {
+                    merged.files.remove(&name);
+                }
+            }
+        }
+        for name in merged.files.keys() {
+            if Path::new(name)
+                .ancestors()
+                .skip(1)
+                .any(|parent| merged.files.contains_key(parent.to_string_lossy().as_ref()))
+            {
+                return Err(invalid("intervening file/directory conflict"));
+            }
+        }
+        Ok(merged)
+    }
+}
+
+pub fn tracked_paths(
+    root: &Path,
+    approved_untracked: &BTreeSet<String>,
+) -> io::Result<BTreeSet<String>> {
+    let output = git(root).args(["ls-files", "--cached", "-z"]).output()?;
+    if !output.status.success() {
+        return Err(invalid("cannot enumerate tracked source"));
+    }
+    let mut paths = approved_untracked.clone();
+    for path in output
+        .stdout
+        .split(|byte| *byte == 0)
+        .filter(|path| !path.is_empty())
+    {
+        paths.insert(
+            String::from_utf8(path.to_vec()).map_err(|_| invalid("non-UTF8 tracked path"))?,
+        );
+    }
+    Ok(paths)
+}
+
+pub fn capture_tracked(
+    root: &Path,
+    approved_untracked: &BTreeSet<String>,
+    max_bytes: usize,
+) -> io::Result<Snapshot> {
+    let paths = tracked_paths(root, approved_untracked)?;
+    let snapshot = Snapshot::capture(root, &paths, max_bytes)?;
+    if tracked_paths(root, approved_untracked)? != paths {
+        return Err(invalid("tracked path set changed during snapshot"));
+    }
+    Ok(snapshot)
+}
+
+fn git(root: &Path) -> Command {
+    let mut command = Command::new("git");
+    command
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .args([
+            "-c",
+            "core.hooksPath=/dev/null",
+            "-c",
+            "core.fsmonitor=false",
+            "-c",
+            "commit.gpgsign=false",
+            "-C",
+        ])
+        .arg(root);
+    command
+}
+
+pub fn create_worktree(
+    snapshot: &Snapshot,
+    directory: &Path,
+    max_bytes: usize,
+) -> io::Result<PathBuf> {
+    fs::create_dir(directory)?;
+    let directory = directory.canonicalize()?;
+    let depot = directory.join("depot");
+    snapshot.write_new(&depot, max_bytes)?;
+    let worker = directory.join("worker");
+    for arguments in [
+        vec!["init", "--quiet"],
+        vec!["add", "--all"],
+        vec![
+            "-c",
+            "user.name=Oh My Diff",
+            "-c",
+            "user.email=omd@localhost",
+            "commit",
+            "--quiet",
+            "--allow-empty",
+            "-m",
+            "Isolated task input",
+        ],
+        vec![
+            "worktree",
+            "add",
+            "--quiet",
+            "--detach",
+            worker
+                .to_str()
+                .ok_or_else(|| invalid("non-UTF8 workspace"))?,
+            "HEAD",
+        ],
+    ] {
+        let output = git(&depot).args(arguments).output()?;
+        if !output.status.success() {
+            return Err(invalid(
+                "isolated worktree preparation failed; retained depot for diagnosis",
+            ));
+        }
+        if !depot.join(".git/info/attributes").exists() {
+            fs::write(
+                depot.join(".git/info/attributes"),
+                "* -text -filter -ident -working-tree-encoding -eol\n",
+            )?;
+        }
+    }
+    let paths = snapshot.files.keys().cloned().collect();
+    if Snapshot::capture(&worker, &paths, max_bytes)? != *snapshot {
+        return Err(invalid("worktree bytes differ from captured input"));
+    }
+    Ok(worker)
+}
+
+pub fn cleanup_owned_directory(parent: &Path, directory: &Path) -> io::Result<()> {
+    if !directory.exists() {
+        return Ok(());
+    }
+    let parent = parent.canonicalize()?;
+    let directory_parent = directory
+        .parent()
+        .ok_or_else(|| invalid("owned directory parent missing"))?
+        .canonicalize()?;
+    if directory_parent != parent
+        || directory.file_name().is_none()
+        || fs::symlink_metadata(directory)?.file_type().is_symlink()
+    {
+        return Err(invalid("cleanup target is not a direct owned directory"));
+    }
+    fs::remove_dir_all(directory)
+}
