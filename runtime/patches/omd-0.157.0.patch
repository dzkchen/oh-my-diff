+    pub(crate) fn handle_mouse_copying_highlight(
+        &mut self,
+        event: MouseEvent,
+        cells: &[Arc<dyn HistoryCell>],
+        release: Option<codex_omd::ModSelectionSource>,
+    ) -> Option<ViewAction> {
+        let released_drag = release.is_some()
+            && event.kind == MouseEventKind::Up(MouseButton::Left)
+            && self
+                .selection
+                .as_ref()
+                .is_some_and(|selection| selection.dragging && selection.moved);
+        let action = self.handle_mouse(event, cells);
+        if released_drag
+            && matches!(action, Some(ViewAction::Changed))
+            && let Some(source) = release
+            && let Some(text) = self.selected_text(cells).filter(|text| !text.is_empty())
+            && let Some(counts) = crate::mod_ui::release_copy(source, &text)
+        {
+            self.release_copy = Some((source, counts));
+            return Some(ViewAction::Copy(text));
+        }
+        action
+    }
+
+    pub(crate) fn take_release_copy(
+        &mut self,
+    ) -> Option<(codex_omd::ModSelectionSource, (usize, usize))> {
+        self.release_copy.take()
+    }
