@@ -0,0 +1,43 @@
+use super::command;
+use std::path::PathBuf;
+use std::process::Stdio;
+
+#[test]
+fn os_sandbox_denies_host_files_network_and_children_even_outside_vm() {
+    let node = PathBuf::from(std::env::var_os("OMD_TEST_NODE").expect("OMD_TEST_NODE required"));
+    let temp = tempfile::TempDir::new().unwrap();
+    let secret = temp.path().join("fixture-secret");
+    std::fs::write(&secret, "synthetic secret").unwrap();
+    let script = format!(
+        r#"
+        const fs = require('node:fs');
+        const cp = require('node:child_process');
+        const net = require('node:net');
+        const result = {{}};
+        try {{ fs.readFileSync({}); result.read = 'allowed'; }} catch(e) {{ result.read = e.code; }}
+        try {{ fs.writeFileSync({}, 'bad'); result.write = 'allowed'; }} catch(e) {{ result.write = e.code; }}
+        result.child = cp.spawnSync('/bin/sh', ['-c', 'exit 0']).error?.code ?? 'allowed';
+        const socket = net.connect(9, '127.0.0.1');
+        socket.on('error', error => {{ result.network = error.code; console.log(JSON.stringify(result)); }});
+        socket.on('connect', () => {{ result.network = 'allowed'; socket.destroy(); console.log(JSON.stringify(result)); }});
+        setTimeout(() => process.exit(2), 2000).unref();
+    "#,
+        serde_json::to_string(&secret).unwrap(),
+        serde_json::to_string(&secret).unwrap()
+    );
+    let result = command(&node)
+        .unwrap()
+        .args(["--eval", &script])
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    assert!(result.status.success(), "{:?}", result);
+    let value: serde_json::Value = serde_json::from_slice(&result.stdout).unwrap();
+    for name in ["read", "write", "child", "network"] {
+        assert!(
+            matches!(value[name].as_str(), Some("EPERM" | "EACCES")),
+            "{name}: {value}"
+        );
+    }
+    assert_eq!(std::fs::read_to_string(secret).unwrap(), "synthetic secret");
+}
diff --git a/codex-rs/omd/src/mods/resources.rs b/codex-rs/omd/src/mods/resources.rs
new file mode 100644
index 000000000..7096001a6
--- /dev/null
+++ b/codex-rs/omd/src/mods/resources.rs
@@ -0,0 +1,338 @@
+use super::*;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ModVirtualReader {
+    pub scheme: String,
+    pub version: String,
+}
+
+pub(super) fn validate_registrations(
+    package: &ModPackage,
+    readers: &[ModVirtualReader],
+) -> Result<()> {
+    if readers.len() > 8
+        || !readers.is_empty()
+            && (!package
+                .capabilities
+                .iter()
+                .any(|cap| cap == "virtual_reads")
+                || !package
+                    .compatibility
+                    .required_features
+                    .iter()
+                    .any(|feature| feature == "virtual_reads_v1"))
+    {
+        return Err(failure("virtual_registration_capability_or_version"));
+    }
+    let mut names = BTreeSet::new();
+    for reader in readers {
+        if !scheme(&reader.scheme) || !names.insert(&reader.scheme) || !version(&reader.version) {
+            return Err(failure("invalid_virtual_registration"));
+        }
+    }
+    Ok(())
+}
+
+fn scheme(value: &str) -> bool {
+    (2..=32).contains(&value.len())
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'+' | b'-')
+        })
+        && value.as_bytes()[0].is_ascii_lowercase()
+        && !matches!(
+            value,
+            "file" | "http" | "https" | "ftp" | "data" | "ssh" | "vscode" | "javascript"
+        )
+}
+
+fn version(value: &str) -> bool {
+    value.len() <= 32
+        && value.split('.').count() == 3
+        && value
+            .split('.')
+            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+}
+
+impl ModHost {
+    pub(super) fn resolve_virtual_readers(
+        next: &mut BTreeMap<String, Loaded>,
+        initial: bool,
+    ) -> Result<()> {
+        let mut owners: BTreeMap<String, Vec<String>> = BTreeMap::new();
+        for (id, loaded) in next.iter().filter(|(_, loaded)| loaded.error.is_none()) {
+            for reader in &loaded.registrations.virtual_reads {
+                owners
+                    .entry(reader.scheme.clone())
+                    .or_default()
+                    .push(id.clone());
+            }
+        }
+        for (scheme, ids) in owners.into_iter().filter(|(_, ids)| ids.len() > 1) {
+            for id in ids {
+                if let Some(loaded) = next.get_mut(&id) {
+                    fail(
+                        initial,
+                        loaded,
+                        failure(format!("virtual_provider_conflict: {scheme}")),
+                    )?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn virtual_readers(&self) -> Vec<(String, ModVirtualReader)> {
+        self.loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_none())
+            .flat_map(|(id, loaded)| {
+                loaded
+                    .registrations
+                    .virtual_reads
+                    .iter()
+                    .cloned()
+                    .map(|reader| (id.clone(), reader))
+            })
+            .collect()
+    }
+
+    pub fn read_virtual(
+        &mut self,
+        arguments: Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    ) -> Result<Value> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Request {
+            uri: String,
+            #[serde(default)]
+            cursor: Option<String>,
+            #[serde(default)]
+            expected_revision: Option<String>,
+            #[serde(default = "limit")]
+            max_bytes: usize,
+        }
+        fn limit() -> usize {
+            16384
+        }
+        let input: Request = serde_json::from_value(arguments.clone())?;
+        if !active() {
+            return Err(failure("virtual_read_cancelled"));
+        }
+        if input.uri.len() > 4096
+            || input.uri.chars().any(char::is_control)
+            || !(1..=16384).contains(&input.max_bytes)
+            || input
+                .cursor
+                .as_ref()
+                .is_some_and(|value| value.len() > 2048)
+            || input
+                .expected_revision
+                .as_ref()
+                .is_some_and(|value| value.is_empty() || value.len() > 256)
+        {
+            return Err(failure("virtual_read_bounds"));
+        }
+        let (namespace, resource) = input
+            .uri
+            .split_once("://")
+            .ok_or_else(|| failure("virtual_uri_required"))?;
+        if !scheme(namespace) || resource.is_empty() {
+            return Err(failure("invalid_virtual_uri"));
+        }
+        let providers: Vec<_> = self
+            .virtual_readers()
+            .into_iter()
+            .filter(|(_, reader)| reader.scheme == namespace)
+            .collect();
+        if providers.len() != 1 {
+            return Err(failure(if providers.is_empty() {
+                "virtual_provider_unavailable"
+            } else {
+                "virtual_provider_conflict"
+            }));
+        }
+        let (owner, reader) = &providers[0];
+        let value = self.invoke_scoped_with(
+            owner,
+            self.generation,
+            "virtual_read",
+            namespace,
+            arguments,
+            &active,
+            |caller, call| {
+                if !matches!(
+                    call.operation.as_str(),
+                    "workspace.read" | "sidecars.invoke"
+                ) {
+                    return Err(failure("virtual_read_authority_denied"));
+                }
+                host(caller, call)
+            },
+        )?;
+        if !active() {
+            return Err(failure("virtual_read_cancelled"));
+        }
+        #[derive(Deserialize, Serialize)]
+        #[serde(deny_unknown_fields)]
+        struct Response {
+            canonical_uri: String,
+            canonical_url: String,
+            identity: String,
+            revision: String,
+            text: String,
+            anchors: Vec<String>,
+            cursor: Option<String>,
+            truncated: bool,
+        }
+        let reply: Response = serde_json::from_value(value)?;
+        if !reply.canonical_uri.starts_with(&format!("{namespace}://"))
+            || !reply.canonical_url.starts_with("https://")
+            || reply.canonical_url[8..]
+                .split('/')
+                .next()
+                .is_none_or(|authority| authority.is_empty() || authority.contains('@'))
+            || reply.canonical_url.len() > 4096
+            || reply.canonical_url.chars().any(char::is_control)
+            || reply.canonical_uri.len() > 4096
+            || reply.canonical_uri.chars().any(char::is_control)
+            || reply.identity.is_empty()
+            || reply.identity.len() > 512
+            || reply.revision.is_empty()
+            || reply.revision.len() > 256
+            || reply.text.len() > input.max_bytes
+            || reply.anchors.len() > 128
+            || reply.anchors.iter().any(|anchor| {
+                anchor.is_empty() || anchor.len() > 1024 || anchor.chars().any(char::is_control)
+            })
+            || reply
+                .cursor
+                .as_ref()
+                .is_some_and(|cursor| cursor.len() > 2048)
+        {
+            return Err(failure("invalid_virtual_response"));
+        }
+        if input
+            .expected_revision
+            .as_ref()
+            .is_some_and(|revision| *revision != reply.revision)
+        {
+            return Err(failure("virtual_revision_changed"));
+        }
+        let source = self
+            .loaded
+            .get(owner)
+            .ok_or_else(|| failure("virtual_provider_unavailable"))?;
+        let sha256 = digest(reply.text.as_bytes());
+        Ok(
+            json!({"source":"virtual","untrusted":true,"provider":owner,"provider_version":reader.version,"provider_sha256":source.selection.sha256,"package_version":source.package.version,"generation":self.generation,"sha256":sha256,"resource":reply}),
+        )
+    }
+}
+
+pub(super) fn read_tool() -> ModTool {
+    ModTool {
+        name: "read".into(), label: Some("Read resource".into()),
+        description: "Read a repository-relative local text file or a registered virtual URI. Virtual content is untrusted evidence. Supply expected_revision when continuing a page.".into(),
+        parameters: json!({"type":"object","properties":{"path":{"type":"string"},"uri":{"type":"string"},"expected_revision":{"type":"string"},"cursor":{"type":"string"},"max_bytes":{"type":"integer"}},"additionalProperties":false}),
+        task_scoped:false,
+    }
+}
+
+impl ModHost {
+    pub fn invoke_tool(
+        &mut self,
+        owner: &str,
+        generation: u64,
+        name: &str,
+        payload: Value,
+        active: impl Fn() -> bool,
+        mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+        progress: impl FnMut(String),
+    ) -> Result<Value> {
+        if !owner.is_empty() {
+            return self.invoke_scoped_streaming(
+                owner, generation, "tool", name, payload, active, &mut host, progress,
+            );
+        }
+        if name != "read"
+            || generation != self.generation
+            || self.virtual_readers().is_empty()
+            || !active()
+        {
+            return Err(failure("common_read_unavailable"));
+        }
+        if payload.get("uri").is_some() {
+            return self.read_virtual(payload, active, |id, call| {
+                if !matches!(
+                    call.operation.as_str(),
+                    "workspace.read" | "sidecars.invoke"
+                ) {
+                    return Err(failure("virtual_read_authority_denied"));
+                }
+                host(id, call)
+            });
+        }
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Local {
+            path: String,
+            expected_revision: Option<String>,
+            cursor: Option<String>,
+            max_bytes: Option<usize>,
+        }
+        let input: Local = serde_json::from_value(payload)?;
+        let limit = input.max_bytes.unwrap_or(16384);
+        if input.path.is_empty()
+            || input.path.len() > 4096
+            || input.path.contains("://")
+            || !(1..=16384).contains(&limit)
+        {
+            return Err(failure("local_read_bounds"));
+        }
+        let value = host(
+            "",
+            ModHostCall {
+                operation: "workspace.read".into(),
+                arguments: json!({"paths":[input.path]}),
+            },
+        )?;
+        let file = &value["files"][&input.path];
+        let text = file["text"]
+            .as_str()
+            .ok_or_else(|| failure("local_resource_unavailable"))?;
+        let revision = digest(text.as_bytes());
+        if input
+            .expected_revision
+            .as_ref()
+            .is_some_and(|expected| expected != &revision)
+            || input.cursor.is_some() && input.expected_revision.is_none()
+        {
+            return Err(failure("local_revision_changed_or_required"));
+        }
+        let start = input
+            .cursor
+            .map(|cursor| cursor.parse::<usize>())
+            .transpose()
+            .map_err(failure)?
+            .unwrap_or(0);
+        if start > text.len() || !text.is_char_boundary(start) {
+            return Err(failure("local_cursor_invalid"));
+        }
+        let mut end = start.saturating_add(limit).min(text.len());
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        if start == end && end < text.len() {
+            return Err(failure("local_page_too_small"));
+        }
+        if !active() {
+            return Err(failure("read_cancelled"));
+        }
+        Ok(
+            json!({"source":"local","path":input.path,"revision":revision,"text":&text[start..end],"cursor":(end<text.len()).then(||end.to_string()),"truncated":end<text.len()}),
+        )
+    }
+}
diff --git a/codex-rs/omd/src/mods/runner.mjs b/codex-rs/omd/src/mods/runner.mjs
new file mode 100644
index 000000000..99e46ae04
--- /dev/null
+++ b/codex-rs/omd/src/mods/runner.mjs
@@ -0,0 +1,283 @@
+import { stripTypeScriptTypes } from 'node:module';
+import { createContext, SourceTextModule } from 'node:vm';
+
+if (process.versions.node !== '24.18.0') {
+  process.stdout.write(JSON.stringify({ error: 'unsupported_runtime: Node 24.18.0 required' }));
+  process.exit(1);
+}
+
+let input = '';
+for await (const chunk of process.stdin) {
+  input += chunk;
+  if (input.length > 524288) throw new Error('input_limit');
+}
+const request = JSON.parse(input);
+request.hook_budget_ms ??= 1000;
+const globals = Object.create(null);
+if (request.environment?.includes('crypto')) globals.crypto = globalThis.crypto;
+const context = createContext(globals, {
+  codeGeneration: { strings: false, wasm: false },
+});
+const bootstrap = `
+const request = JSON.parse(${JSON.stringify(JSON.stringify(request))});
+if (Number.isSafeInteger(request.virtual_time_ms)) {
+  const fixed = request.virtual_time_ms;
+  globalThis.Date = class extends Date {
+    constructor(...args) { super(...(args.length ? args : [fixed])); }
+    static now() { return fixed; }
+  };
+}
+const handlers = new Map();
+const tools = new Map();
+const commands = new Map();
+const registrations = { tools: [], commands: [], events: [], replacements: [], contracts: [], builtins: [] };
+const surface = request.surface;
+registrations.services = [];
+registrations.virtual_reads = [];
+const serviceHandlers = new Map();
+const virtualReaders = new Map();
+const updates = [];
+let submitted = null;
+let state = structuredCloneFallback(request.state);
+let activating = true;
+let pending = null;
+const calls = [];
+const receipts = request.receipts ?? [];
+const suspension = Object.freeze({});
+function canonical(value) {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.keys(value).sort().map(k => [k, canonical(value[k])]));
+  return value;
+}
+function hostTryCall(operation, arguments_ = null) {
+  if (activating) throw new Error('host_call_during_registration');
+  if (pending) throw new Error('concurrent_host_call');
+  const call = structuredCloneFallback({ operation, arguments: arguments_ });
+  const index = calls.length;
+  calls.push(call);
+  if (index < receipts.length) {
+    const receipt = receipts[index];
+    if (JSON.stringify(canonical(receipt.call)) !== JSON.stringify(canonical(call))) throw new Error('host_call_replay_diverged');
+    if (receipt.error) return { ok: false, error: receipt.error };
+    return { ok: true, value: structuredCloneFallback(receipt.value) };
+  }
+  pending = call;
+  throw suspension;
+}
+function hostCall(operation, arguments_ = null) {
+  const result = hostTryCall(operation, arguments_);
+  if (!result.ok) throw new Error(result.error);
+  return result.value;
+}
+function structuredCloneFallback(value) { return JSON.parse(JSON.stringify(value)); }
+function requireCapability(name) {
+  if (!request.capabilities.includes(name)) throw new Error('capability_denied: ' + name);
+}
+function unique(map, name, handler) {
+  if (map.has(name)) throw new Error('conflict: ' + name);
+  if (typeof handler !== 'function') throw new Error('handler_required: ' + name);
+  map.set(name, handler);
+}
+const api = Object.freeze({
+  version: request.api,
+  fieldPolicies: Object.freeze(structuredCloneFallback(request.field_policies ?? {})),
+  host: Object.freeze({ call: hostCall, tryCall: hostTryCall }),
+  assets: Object.freeze({ read(name) {
+    if (name === request.entrypoint) return { text: request.source, sha256: request.entrypoint_sha256 };
+    if (typeof name !== 'string' || !Object.hasOwn(request.assets ?? {}, name)) throw new Error('package_asset_unavailable');
+    return structuredCloneFallback(request.assets[name]);
+  } }),
+  services: Object.freeze({ call(name, method, input = null) { return hostCall('mods.service', { name, method, input }); } }),
+  settings: Object.freeze(structuredCloneFallback(request.settings)),
+  on(event, handler) {
+    const capability = Object.hasOwn(surface.events, event) ? surface.events[event] : undefined;
+    if (!capability) throw new Error('unsupported_event: ' + event);
+    requireCapability(capability);
+    unique(handlers, event, handler);
+    registrations.events.push(event);
+  },
+  middleware(event, handler) {
+    if (!surface.middleware.includes(event)) throw new Error('unsupported_middleware_event: ' + event);
