+        &server,
+        "read a bounded CSV in Python and chart it in Bun",
+        &code,
+        |config| {
+            let drivers = std::path::PathBuf::from(
+                std::env::var_os("CODEX_KERNEL_TEST_DRIVERS")
+                    .expect("set CODEX_KERNEL_TEST_DRIVERS to a directory with python.py and bun.mjs"),
+            );
+            config.code_mode.kernels = [("python", vec!["python3", "-u", "-c"], "python.py"), ("bun", vec!["bun", "-e"], "bun.mjs")]
+                .into_iter()
+                .map(|(name, command, file)| {
+                    let driver = drivers.join(file);
+                    let digest = format!(
+                        "{:x}",
+                        <sha2::Sha256 as sha2::Digest>::digest(std::fs::read(&driver).unwrap())
+                    );
+                    codex_features::CodeModeKernelToml {
+                        name: name.into(),
+                        command: command.into_iter().map(str::to_owned).collect(),
+                        driver,
+                        driver_sha256: digest,
+                    }
+                })
