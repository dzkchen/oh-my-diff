+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct ModPaths {
+    pub(crate) evidence: PathBuf,
+    pub(crate) repository: PathBuf,
+    pub(crate) store: Option<PathBuf>,
+    pub(crate) protected: Vec<PathBuf>,
+}
+
+pub(crate) fn is_active() -> bool {
+    effective_mode().is_ok_and(|mode| mode.mode.mod_host_enabled())
+}
+
+pub(crate) fn mod_snapshot() -> (bool, codex_omd::ModViewSnapshot) {
+    mod_paths().map_or_else(
+        || (false, codex_omd::ModViewSnapshot::default()),
+        |paths| {
+            let mut snapshot = codex_omd::ModViewSnapshot::read(&paths.evidence.join("mod-view.json"))
+                .unwrap_or_default();
+            if let Some(status) = mod_status() {
+                let errors = status["mods"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter_map(|item| {
+                        item["error"].as_str().map(|error| {
+                            format!("{}: {error}", item["id"].as_str().unwrap_or("mod"))
+                                .chars()
+                                .filter(|character| !character.is_control())
+                                .take(180)
+                                .collect::<String>()
+                        })
+                    })
+                    .take(16)
+                    .collect::<Vec<_>>();
+                if !errors.is_empty()
+                    && !snapshot.view.panels.iter().any(|panel| panel.title == "Mod errors")
+                {
+                    snapshot.view.panels.insert(0, codex_omd::ModPanel {
+                        title: "Mod errors".into(),
+                        lines: errors,
+                    });
+                }
+            }
+            (true, snapshot)
+        },
+    )
+}
+
+pub(crate) fn mod_paths() -> Option<ModPaths> {
+    let repository = crate::mod_runtime::active_context()
+        .map(|context| context.repository)
+        .or_else(|| std::env::current_dir().ok())?;
+    mod_paths_for(&repository)
+}
+
+pub(crate) fn mod_paths_for(repository: &Path) -> Option<ModPaths> {
+    if !is_active() {
+        return None;
+    }
+    let root = PathBuf::from(std::env::var_os(codex_omd::MOD_STORE_ENV)?);
+    if !root.is_absolute() || root.canonicalize().ok()? != root {
+        return None;
+    }
+    let config = bounded_read(&root.join(HOST_CONFIG), 262_144)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or(Value::Null);
+    let paths = |value: &Value| -> Vec<PathBuf> {
+        match value {
+            Value::Array(items) => items.iter().filter_map(Value::as_str).map(PathBuf::from).collect(),
+            Value::Object(items) => items.values().filter_map(Value::as_str).map(PathBuf::from).collect(),
+            _ => Vec::new(),
+        }
+    };
+    let mut protected = vec![root.clone()];
+    protected.extend(paths(&config["protected"]));
+    protected.extend(paths(&config["secret_refs"]));
+    Some(ModPaths {
+        evidence: root.clone(),
+        repository: repository.canonicalize().ok()?,
+        store: Some(root),
+        protected,
+    })
+}
+
+pub(crate) fn mod_status() -> Option<Value> {
+    let paths = mod_paths()?;
+    serde_json::from_slice(&bounded_read(&paths.evidence.join("mod-status.json"), 262_144).ok()?)
+        .ok()
+}
+
+pub(crate) fn selection_subscribed() -> bool {
+    mod_status().is_some_and(|status| {
+        status["mods"].as_array().into_iter().flatten().any(|item| {
+            item["error"].is_null()
+                && item["registrations"]["events"]
+                    .as_array()
+                    .is_some_and(|events| {
+                        events
+                            .iter()
+                            .any(|event| event == "selection" || event == "selection_result")
+                    })
+        })
+    })
+}
+
+pub(crate) fn builtins() -> codex_omd::BuiltinSnapshot {
+    type Cached = (Option<PathBuf>, std::time::Instant, codex_omd::BuiltinSnapshot);
+    static CACHE: std::sync::Mutex<Option<Cached>> = std::sync::Mutex::new(None);
+    let root = mod_paths().map(|paths| paths.evidence);
+    let mut cache = CACHE
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((cached, loaded, snapshot)) = cache.as_ref()
+        && *cached == root
+        && loaded.elapsed() < std::time::Duration::from_secs(2)
+    {
+        return snapshot.clone();
+    }
+    let snapshot = root
+        .as_deref()
+        .map(codex_omd::BuiltinSnapshot::read)
+        .unwrap_or_default();
+    *cache = Some((root, std::time::Instant::now(), snapshot.clone()));
+    snapshot
+}
+
+pub(crate) fn command_hidden(command: &str) -> bool {
+    builtins().command_hidden(command)
+}
