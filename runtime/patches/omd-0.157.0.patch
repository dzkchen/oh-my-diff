@@ -0,0 +1,210 @@
+use codex_omd::{ModHost, ModStore};
+use serde_json::json;
+use std::fs;
+use std::path::PathBuf;
+
+fn fixture() -> (tempfile::TempDir, ModStore, PathBuf) {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let node = PathBuf::from(std::env::var_os("OMD_TEST_NODE").expect("OMD_TEST_NODE required"));
+    let store = ModStore::create(root.join("store"), node).unwrap();
+    let source =
+        PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../mods/examples/virtual_reader");
+    let package = root.join("provider");
+    fs::create_dir(&package).unwrap();
+    for file in ["mod.json", "index.ts"] {
+        fs::copy(source.join(file), package.join(file)).unwrap();
+    }
+    (temp, store, package)
+}
+
+fn enable(store: &ModStore, package: &std::path::Path) {
+    let inspected = ModStore::inspect_package(package).unwrap();
+    store
+        .trust(
+            package.to_owned(),
+            inspected["sha256"].as_str().unwrap(),
+            vec!["virtual_reads".into()],
+            "user",
+        )
+        .unwrap();
+    store.enable(package, true).unwrap();
+}
+
+#[test]
+fn independent_provider_revision_and_disabled_recovery() {
+    let (temp, store, package) = fixture();
+    enable(&store, &package);
+    let root = temp.path().canonicalize().unwrap().join("store");
+    let mut host = ModHost::open(root.clone()).unwrap();
+    assert_eq!(host.virtual_readers().len(), 1, "{}", host.status());
+    let result = host
+        .read_virtual(
+            json!({"uri":"fixture://manual/intro"}),
+            || true,
+            |_, _| panic!("unexpected authority"),
+        )
+        .unwrap();
+    assert_eq!(result["resource"]["revision"], "manual-v1");
+    assert_eq!(result["untrusted"], true);
+    assert_eq!(result["sha256"].as_str().unwrap().len(), 64);
+    assert!(
+        host.read_virtual(
+            json!({"uri":"fixture://manual/intro","expected_revision":"stale"}),
+            || true,
+            |_, _| panic!()
+        )
+        .unwrap_err()
+        .to_string()
+        .contains("revision_changed")
+    );
+    assert!(
+        host.read_virtual(
+            json!({"uri":"file:///etc/passwd"}),
+            || true,
+            |_, _| panic!()
+        )
+        .is_err()
+    );
+    assert!(
+        host.read_virtual(
+            json!({"uri":"fixture://manual/intro"}),
+            || false,
+            |_, _| panic!()
+        )
+        .is_err()
+    );
+    store.enable(&package, false).unwrap();
+    let mut host = ModHost::open(root).unwrap();
+    assert!(host.virtual_readers().is_empty());
+    assert!(
+        host.read_virtual(
+            json!({"uri":"fixture://manual/intro"}),
+            || true,
+            |_, _| panic!()
+        )
+        .unwrap_err()
+        .to_string()
+        .contains("unavailable")
+    );
+}
+
+#[test]
+fn colliding_and_reserved_namespaces_are_rejected() {
+    let (temp, store, package) = fixture();
+    enable(&store, &package);
+    let second = temp.path().canonicalize().unwrap().join("second");
+    fs::create_dir(&second).unwrap();
+    let mut manifest: serde_json::Value =
+        serde_json::from_slice(&fs::read(package.join("mod.json")).unwrap()).unwrap();
+    manifest["id"] = json!("second_provider");
+    fs::write(second.join("mod.json"), manifest.to_string()).unwrap();
+    fs::copy(package.join("index.ts"), second.join("index.ts")).unwrap();
+    enable(&store, &second);
+    let host = ModHost::open(temp.path().canonicalize().unwrap().join("store")).unwrap();
+    assert!(host.virtual_readers().is_empty());
+    assert!(
+        host.status()
+            .to_string()
+            .contains("virtual_provider_conflict")
+    );
+    store.enable(&second, false).unwrap();
+    store.enable(&package, false).unwrap();
+    let text = fs::read_to_string(package.join("index.ts"))
+        .unwrap()
+        .replace("'fixture'", "'file'");
+    fs::write(package.join("index.ts"), text).unwrap();
+    enable(&store, &package);
+    let host = ModHost::open(temp.path().canonicalize().unwrap().join("store")).unwrap();
+    assert!(host.virtual_readers().is_empty());
+    assert!(
+        host.status()
+            .to_string()
+            .contains("invalid_virtual_registration")
+    );
+}
+
+#[test]
+fn common_read_keeps_local_and_virtual_authority_separate() {
+    let (_temp, store, package) = fixture();
+    enable(&store, &package);
+    let mut host = ModHost::open(package.parent().unwrap().join("store")).unwrap();
+    assert!(
+        host.tools()
+            .iter()
+            .any(|(owner, _, tool)| owner.is_empty() && tool.name == "read")
+    );
+    let generation = host.generation();
+    let local = host
+        .invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"path":"a.txt","max_bytes":2}),
+            || true,
+            |owner, call| {
+                assert_eq!(owner, "");
+                assert_eq!(call.operation, "workspace.read");
+                assert_eq!(call.arguments, json!({"paths":["a.txt"]}));
+                Ok(json!({"files":{"a.txt":{"text":"abcd","sha256":"ignored-untrusted-field"}}}))
+            },
+            |_| {},
+        )
+        .unwrap();
+    assert_eq!(local["source"], "local");
+    assert_eq!(local["text"], "ab");
+    assert_eq!(local["cursor"], "2");
+    assert!(
+        host.invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"path":"a.txt","cursor":"2"}),
+            || true,
+            |_, _| Ok(json!({"files":{"a.txt":{"text":"abcd"}}})),
+            |_| {}
+        )
+        .unwrap_err()
+        .to_string()
+        .contains("revision")
+    );
+    let remote = host
+        .invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"uri":"fixture://manual/intro"}),
+            || true,
+            |_, _| panic!(),
+            |_| {},
+        )
+        .unwrap();
+    assert_eq!(remote["source"], "virtual");
+    assert!(
+        host.invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"path":"a.txt","uri":"fixture://manual/intro"}),
+            || true,
+            |_, _| panic!(),
+            |_| {}
+        )
+        .is_err()
+    );
+    store.enable(&package, false).unwrap();
+    host.turn_boundary();
+    assert!(!host.tools().iter().any(|(owner, _, _)| owner.is_empty()));
+    assert!(
+        host.invoke_tool(
+            "",
+            generation,
+            "read",
+            json!({"path":"a.txt"}),
+            || true,
+            |_, _| panic!(),
+            |_| {}
+        )
+        .is_err()
+    );
+}
diff --git a/codex-rs/omd/tests/workspace.rs b/codex-rs/omd/tests/workspace.rs
new file mode 100644
index 000000000..03463c997
--- /dev/null
+++ b/codex-rs/omd/tests/workspace.rs
@@ -0,0 +1,249 @@
+use codex_omd::File;
+use codex_omd::Snapshot;
+use codex_omd::capture_tracked;
+use codex_omd::cleanup_owned_directory;
+use codex_omd::create_worktree;
+use codex_omd::tracked_paths;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fs;
+
+fn snapshot() -> Snapshot {
+    Snapshot {
+        files: BTreeMap::from([(
+            "source.txt".into(),
+            File {
+                bytes: b"dirty tracked input".to_vec(),
+                executable: false,
+            },
+        )]),
+    }
+}
+
+#[test]
+fn worktree_contains_snapshot_without_touching_original_inputs() {
+    let temp = tempfile::tempdir().unwrap();
+    let input = snapshot();
+    let workspace = create_worktree(&input, &temp.path().join("isolated"), 4096).unwrap();
+    assert!(workspace.join(".git").is_file());
+    let paths = tracked_paths(&workspace, &BTreeSet::new()).unwrap();
+    assert_eq!(Snapshot::capture(&workspace, &paths, 4096).unwrap(), input);
+    fs::write(workspace.join("source.txt"), "worker edit").unwrap();
+    assert_eq!(
+        fs::read(temp.path().join("isolated/depot/source.txt")).unwrap(),
+        b"dirty tracked input"
+    );
+}
+
+#[test]
+fn cleanup_removes_only_a_direct_owned_directory() {
+    let temp = tempfile::tempdir().unwrap();
+    let owned = temp.path().join("owned");
+    fs::create_dir(&owned).unwrap();
+    fs::write(owned.join("artifact"), "data").unwrap();
+    cleanup_owned_directory(temp.path(), &owned).unwrap();
+    assert!(!owned.exists());
+    let nested_parent = temp.path().join("nested");
+    let nested = nested_parent.join("not-direct");
+    fs::create_dir_all(&nested).unwrap();
+    assert!(cleanup_owned_directory(temp.path(), &nested).is_err());
+    assert!(nested.exists());
+}
+
+#[test]
+fn captures_tracked_dirty_files_and_only_approved_untracked_files() {
+    let temp = tempfile::tempdir().unwrap();
+    let workspace = create_worktree(&snapshot(), &temp.path().join("isolated"), 4096).unwrap();
+    fs::write(workspace.join("source.txt"), "dirty").unwrap();
+    fs::write(workspace.join("approved.txt"), "approved").unwrap();
+    fs::write(workspace.join(".env"), "excluded-secret-fixture").unwrap();
+    let paths = tracked_paths(&workspace, &BTreeSet::from(["approved.txt".into()])).unwrap();
+    let captured =
+        capture_tracked(&workspace, &BTreeSet::from(["approved.txt".into()]), 4096).unwrap();
+    assert_eq!(paths, captured.files.keys().cloned().collect());
+    assert_eq!(
+        captured.files.keys().cloned().collect::<Vec<_>>(),
+        ["approved.txt", "source.txt"]
+    );
+    assert_eq!(captured.files["source.txt"].bytes, b"dirty");
+}
+
+#[test]
+fn integration_candidate_preserves_unrelated_edits_and_rejects_conflicts() {
+    let base = snapshot();
+    let mut candidate = base.clone();
+    candidate.files.get_mut("source.txt").unwrap().bytes = b"worker".to_vec();
+    let mut current = base.clone();
+    current.files.insert(
+        "unrelated.txt".into(),
+        File {
+            bytes: b"user".to_vec(),
+            executable: false,
+        },
+    );
+    let merged = base.merge_candidate(&candidate, &current).unwrap();
+    assert_eq!(
+        merged.files["unrelated.txt"],
+        current.files["unrelated.txt"]
+    );
+    assert_eq!(merged.files["source.txt"], candidate.files["source.txt"]);
+    current.files.get_mut("source.txt").unwrap().bytes = b"concurrent".to_vec();
+    assert!(base.merge_candidate(&candidate, &current).is_err());
+}
+
+#[test]
+fn ancestor_and_descendant_conflicts_are_rejected() {
+    let base = Snapshot {
+        files: BTreeMap::new(),
+    };
+    let file = File {
+        bytes: vec![],
+        executable: false,
+    };
+    let ancestor = Snapshot {
+        files: BTreeMap::from([("a".into(), file.clone())]),
+    };
+    let descendant = Snapshot {
+        files: BTreeMap::from([("a/b".into(), file)]),
+    };
+    assert!(base.merge_candidate(&ancestor, &descendant).is_err());
+    assert!(base.merge_candidate(&descendant, &ancestor).is_err());
+}
+
+#[test]
+fn worktree_preserves_bytes_despite_repository_attributes() {
+    let temp = tempfile::tempdir().unwrap();
+    let mut input = snapshot();
+    input.files.insert(
+        ".gitattributes".into(),
+        File {
+            bytes: b"*.txt text eol=lf working-tree-encoding=UTF-16\n".to_vec(),
+            executable: false,
+        },
+    );
+    input.files.get_mut("source.txt").unwrap().bytes = b"dirty\r\ninput\r\n".to_vec();
+    let workspace = create_worktree(&input, &temp.path().join("isolated"), 4096).unwrap();
+    assert_eq!(
+        Snapshot::capture(&workspace, &input.files.keys().cloned().collect(), 4096).unwrap(),
+        input
+    );
+}
+
+#[test]
+fn rejects_unsafe_names_size_overflow_and_existing_destinations() {
+    let temp = tempfile::tempdir().unwrap();
+    for name in [
+        "../outside",
+        "/absolute",
+        ".git/config",
+        ".GIT/config",
+        "a//b",
+        "a/./b",
+        "a\\b",
+    ] {
+        let mut input = snapshot();
+        input.files.insert(
+            name.into(),
+            File {
+                bytes: Vec::new(),
+                executable: false,
+            },
+        );
+        assert!(input.write_new(&temp.path().join("invalid"), 4096).is_err());
+        assert!(!temp.path().join("invalid").exists());
+    }
+    assert!(snapshot().write_new(&temp.path().join("large"), 1).is_err());
+    snapshot()
+        .write_new(&temp.path().join("existing"), 4096)
+        .unwrap();
+    assert!(
+        snapshot()
+            .write_new(&temp.path().join("existing"), 4096)
+            .is_err()
+    );
+}
