+async fn code_mode_python_csv_to_bun_chart_stays_in_one_cell() -> Result<()> {
+    let directory = tempdir()?;
+    let csv = directory.path().join("sample.csv");
+    std::fs::write(&csv, "month,total\nJan,2\nFeb,4\nMar,3\n")?;
+    let python = format!(
+        "import csv, io, json\nr = tool('exec_command', {{'cmd': 'head -n 50 {}', 'max_output_tokens': 2000}})\nassert r['exit_code'] == 0\nvalues = [int(row['total']) for row in csv.DictReader(io.StringIO(r['output']))]\nprint(json.dumps(values))",
+        csv.display()
+    );
+    let code = r#"
+const python = await tools.kernel({ kernel: "python", code: __PYTHON_CODE__ });
+if (!python.ok) throw new Error(python.error);
+const values = JSON.parse(python.output);
+const bun = await tools.kernel({ kernel: "bun", code: `globalThis.values=${JSON.stringify(values)}; console.log('<svg>' + values.map(v => '<rect height="' + (v * 10) + '"/>').join('') + '</svg>')` });
+text(JSON.stringify({ python, bun }));
+"#
+    .replace("__PYTHON_CODE__", &serde_json::to_string(&python)?);
+    let server = responses::start_mock_server().await;
