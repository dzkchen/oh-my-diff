+    #[serde(default)]
+    pub services: Vec<crate::mods::services::Grant>,
+    #[serde(default)]
+    pub secret_refs: BTreeMap<String, PathBuf>,
+    #[serde(default)]
+    pub protected: Vec<PathBuf>,
+    #[serde(default)]
+    pub toolchain_reads: Vec<PathBuf>,
+    #[serde(default = "snapshot_bytes")]
+    pub snapshot_bytes: usize,
