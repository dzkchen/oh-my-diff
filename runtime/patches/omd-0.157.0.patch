+    );
+
+    std::fs::remove_file(repository.join("guarded-output")).unwrap();
+    std::fs::write(&input, "changed").unwrap();
+    assert_eq!(
+        host.call(&writer, "exec.run", write(expected)).unwrap_err(),
+        "exec_guard_changed"
