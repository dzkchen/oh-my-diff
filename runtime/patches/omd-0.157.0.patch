+                "--mod",
+                "stuck",
+                "--repo",
+                repository.to_str().unwrap(),
+                "--store",
+                root.to_str().unwrap(),
+            ]
+            .map(str::to_owned)
+            .to_vec()
+        };
+        let exported = run(args("export")).unwrap();
+        assert_eq!(exported["entries"]["state"]["revision"], 1);
