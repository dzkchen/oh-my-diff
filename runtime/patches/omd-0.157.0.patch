+        );
+        let configured = |name: &str, command: &[&str], file: &str| {
+            let driver = drivers.join(file);
+            let digest = format!(
+                "{:x}",
+                <sha2::Sha256 as sha2::Digest>::digest(std::fs::read(&driver).unwrap())
+            );
+            codex_features::CodeModeKernelToml {
+                name: name.into(),
+                command: command.iter().map(|arg| (*arg).to_owned()).collect(),
+                driver,
+                driver_sha256: digest,
+            }
+        };
+        let kernels = vec![
+            configured("python", &["python3", "-u", "-c"], "python.py"),
+            configured("bun", &["bun", "-e"], "bun.mjs"),
+        ];
