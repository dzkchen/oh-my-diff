+
+    #[test]
+    fn framed_process_is_owned_bounded_and_stopped() {
+        let directory = tempfile::tempdir().unwrap();
+        let repository = directory.path().canonicalize().unwrap();
+        let processes = ManagedProcesses::default();
+        let policy = FileSystemSandboxPolicy::read_only();
+        let found = processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.which",
+                json!({"names":["cat"]}),
+                || true,
+            )
+            .unwrap();
+        let cat = found["found"].as_array().unwrap().first().unwrap();
+        let started = processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.start",
+                json!({"session":"framed","name":"cat","path":cat["path"],"sha256":cat["sha256"]}),
+                || true,
+            )
+            .unwrap();
+        assert_eq!(started["running"], true);
+        let scratch = processes
+            .session(&("fixture".into(), 1, "framed".into()))
+            .unwrap()
+            .lock()
+            .unwrap()
+            .scratch
+            .clone();
+        assert_eq!(
+            fs::metadata(&scratch).unwrap().permissions().mode() & 0o777,
+            0o700
+        );
+        let answer = processes
+            .call("fixture", 1, &repository, &policy, "process.exchange", json!({"session":"framed","send":[{"jsonrpc":"2.0","id":7,"method":"hello"}],"wait_ms":1000}), || true)
+            .unwrap();
+        assert_eq!(answer["messages"][0]["method"], "hello");
+        assert_eq!(
+            processes
+                .call(
+                    "other",
+                    1,
+                    &repository,
+                    &policy,
+                    "process.status",
+                    json!({"session":"framed"}),
+                    || true
+                )
+                .unwrap_err(),
+            "process_session_unavailable"
+        );
+        assert_eq!(
+            processes
+                .call(
+                    "fixture",
+                    1,
+                    &repository,
+                    &policy,
+                    "process.stop",
+                    json!({"session":"framed"}),
+                    || true
+                )
+                .unwrap()["stopped"],
+            true
+        );
+    }
+
+    #[test]
+    fn blocked_process_write_observes_cancellation() {
+        let directory = tempfile::tempdir().unwrap();
+        let repository = directory.path().canonicalize().unwrap();
+        let processes = ManagedProcesses::default();
+        let policy = FileSystemSandboxPolicy::read_only();
+        let found = processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.which",
+                json!({"names":["sleep"]}),
+                || true,
+            )
+            .unwrap();
+        let sleep = found["found"].as_array().unwrap().first().unwrap();
+        processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.start",
+                json!({"session":"blocked","name":"sleep","path":sleep["path"],"sha256":sleep["sha256"],"arguments":["20"]}),
+                || true,
+            )
+            .unwrap();
+        let started = Instant::now();
+        let error = processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.exchange",
+                json!({"session":"blocked","send":[{"data":"x".repeat(256 * 1024)}],"wait_ms":0}),
+                || started.elapsed() < Duration::from_millis(100),
+            )
+            .unwrap_err();
+        assert_eq!(error, "process_cancelled");
+        assert!(started.elapsed() < Duration::from_secs(2));
+        assert_eq!(
+            processes
+                .call(
+                    "fixture",
+                    1,
+                    &repository,
+                    &policy,
+                    "process.status",
+                    json!({"session":"blocked"}),
+                    || true,
+                )
+                .unwrap_err(),
+            "process_session_unavailable"
+        );
+    }
+
+    #[test]
+    fn process_environment_rejects_host_overrides() {
+        let directory = tempfile::tempdir().unwrap();
+        let repository = directory.path().canonicalize().unwrap();
+        let processes = ManagedProcesses::default();
+        let policy = FileSystemSandboxPolicy::read_only();
+        let found = processes
+            .call(
+                "fixture",
+                1,
+                &repository,
+                &policy,
+                "process.which",
+                json!({"names":["cat"]}),
+                || true,
+            )
+            .unwrap();
+        let cat = found["found"].as_array().unwrap().first().unwrap();
+        for environment in [
+            json!({"HOME":"/tmp"}),
