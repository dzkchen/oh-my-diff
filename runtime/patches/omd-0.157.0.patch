diff --git a/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
new file mode 100644
index 000000000..cec7181a3
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/list_selection_view/mod_list.rs
@@ -0,0 +1,63 @@
+use super::*;
+use codex_omd::ModComponent;
+use std::cell::RefCell;
+
+pub(crate) struct ModListRequest {
+    pub(crate) view_id: &'static str,
+    pub(crate) title: String,
+    pub(crate) subtitle: Option<String>,
+    pub(crate) rendered: RefCell<Option<(u16, Option<Vec<ModComponent>>)>>,
+}
+
+impl ModListRequest {
+    pub(crate) fn new(view_id: &'static str, title: &str, subtitle: Option<String>) -> Option<Self> {
+        crate::omd::list_replaced().then(|| Self {
+            view_id,
+            title: title.to_owned(),
+            subtitle,
+            rendered: RefCell::new(None),
+        })
+    }
+}
+
+impl ListSelectionView {
+    fn mod_list_components(&self, request: &ModListRequest, width: u16) -> Option<Vec<ModComponent>> {
+        if self.is_searchable && !self.search_query.is_empty() {
+            return None;
+        }
+        if let Some((cached, components)) = request.rendered.borrow().as_ref()
+            && *cached == width
+        {
+            return components.clone();
+        }
+        let items = self
+            .active_items()
+            .iter()
+            .enumerate()
+            .map(|(order, item)| {
+                serde_json::json!({"label": item.name, "description": item.description,
+                    "current": item.is_current, "disabled": !Self::item_is_enabled(item), "order": order})
+            })
+            .collect::<Vec<_>>();
+        let payload = serde_json::json!({"view_id": request.view_id, "title": request.title,
+            "subtitle": request.subtitle, "width": width, "items": items,
+            "selected": self.selected_actual_idx()});
+        let components = crate::mod_runtime::list_view(payload);
+        *request.rendered.borrow_mut() = Some((width, components.clone()));
+        components
+    }
+
+    pub(super) fn mod_list_lines(&self, request: &ModListRequest, width: u16) -> Option<Vec<Line<'static>>> {
+        let components = self.mod_list_components(request, width)?;
+        let selected = self.selected_actual_idx().map(|index| index.to_string());
+        let lines = crate::mod_ui::component_lines(&components, width, selected.as_deref());
+        self.rendered_item_count
+            .set(lines.len().min(self.filtered_indices.len()).max(1));
+        Some(lines)
+    }
+
+    pub(super) fn render_mod_list(&self, lines: Vec<Line<'static>>, area: Rect, buf: &mut Buffer) {
+        Self::clear_to_terminal_bg(buf, area);
+        Paragraph::new(lines).render(area, buf);
+    }
+}
