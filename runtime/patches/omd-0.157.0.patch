+use std::time::Duration;
+use std::time::Instant;
+
+const CATALOG_TTL: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct ModSlashTarget {
+    pub(crate) id: String,
+    pub(crate) command: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct ModSlashCommand {
+    pub(crate) invocation: String,
+    pub(crate) description: String,
+    pub(crate) target: ModSlashTarget,
+}
+
+#[derive(Debug)]
+pub(crate) struct ModCommandResult {
+    pub(crate) outcome: ModCommandOutcome,
+    pub(crate) preview: Option<ModViewSnapshot>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ModContext {
+    pub(crate) thread_id: Option<ThreadId>,
+    pub(crate) repository: PathBuf,
+    pub(crate) policy: FileSystemSandboxPolicy,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct ModInvocation {
+    pub(crate) context: ModContext,
+    epoch: u64,
+    sequence: u64,
+    preview: bool,
+}
+
+#[derive(Default)]
+struct ActiveContext {
+    context: Option<ModContext>,
+    epoch: u64,
+    sequence: u64,
+    preview_sequence: u64,
+}
+
+static ACTIVE_CONTEXT: Mutex<ActiveContext> = Mutex::new(ActiveContext {
+    context: None,
+    epoch: 0,
+    sequence: 0,
+    preview_sequence: 0,
+});
+
+impl ActiveContext {
+    fn synchronize(&mut self, context: ModContext) -> bool {
+        if self.context.as_ref() == Some(&context) {
+            return false;
+        }
+        self.context = Some(context);
+        self.epoch = self.epoch.saturating_add(1);
+        self.sequence = 0;
+        self.preview_sequence = 0;
+        true
+    }
+
+    fn begin(&mut self, context: ModContext, preview: bool) -> ModInvocation {
+        self.synchronize(context.clone());
+        if preview {
+            self.preview_sequence = self.preview_sequence.saturating_add(1);
+        } else {
+            self.sequence = self.sequence.saturating_add(1);
+            self.preview_sequence = self.preview_sequence.saturating_add(1);
+        }
+        ModInvocation {
+            context,
+            epoch: self.epoch,
+            sequence: if preview {
+                self.preview_sequence
+            } else {
+                self.sequence
+            },
+            preview,
+        }
+    }
+
+    fn current(&self, invocation: &ModInvocation) -> bool {
+        self.epoch == invocation.epoch
+            && (if invocation.preview {
+                self.preview_sequence
+            } else {
+                self.sequence
+            }) == invocation.sequence
+            && self.context.as_ref() == Some(&invocation.context)
+    }
+}
+
+pub(crate) fn synchronize_context(context: ModContext) -> bool {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .synchronize(context)
+}
+
+pub(crate) fn begin(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .begin(context, false)
+}
+
+pub(crate) fn begin_preview(context: ModContext) -> ModInvocation {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .begin(context, true)
+}
+
+pub(crate) fn current(invocation: &ModInvocation) -> bool {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .current(invocation)
+}
+
+pub(crate) fn active_context() -> Option<ModContext> {
+    ACTIVE_CONTEXT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .context
+        .clone()
+}
+
+pub(crate) struct Entry {
+    namespaced: String,
+    bare: String,
+    description: String,
+    target: ModSlashTarget,
+}
+
+static CATALOG: Mutex<Option<(Instant, Vec<ModSlashCommand>)>> = Mutex::new(None);
+static HOST: Mutex<Option<ModHost>> = Mutex::new(None);
+
+fn builtin(name: &str) -> bool {
+    SlashCommand::from_str(name).is_ok()
+}
+
+fn protected(path: &Path, roots: &[std::path::PathBuf]) -> bool {
+    roots.iter().any(|root| path.starts_with(root))
+}
+
+#[cfg(target_os = "macos")]
+fn sandboxed_seatbelt(
+    executable: &Path,
+    mut args: Vec<String>,
+    protected: &[std::path::PathBuf],
+    cwd: &Path,
+) -> Result<std::process::Command, String> {
+    if args.first().map(String::as_str) != Some("-p") || args.len() < 2 {
+        return Err("exec_sandbox_unavailable".to_owned());
+    }
+    for root in protected {
+        for path in std::iter::once(root.clone()).chain(root.canonicalize().ok()) {
+            let literal = serde_json::to_string(&path.to_string_lossy())
+                .map_err(|error| error.to_string())?;
+            args[1].push_str(&format!(
+                "\n(deny file-write* (literal {literal}) (subpath {literal}))"
+            ));
+        }
+    }
+    let mut command = std::process::Command::new(executable);
+    command.args(args).current_dir(cwd);
+    Ok(command)
+}
+
+fn entries() -> Vec<Entry> {
+    let Some(paths) = crate::omd::mod_paths() else {
+        return Vec::new();
+    };
+    let mut entries = Vec::new();
+    if paths.store.is_some()
+        && let Some(status) = crate::omd::mod_status()
+    {
+        for item in status["mods"].as_array().into_iter().flatten() {
+            let Some(id) = item["id"].as_str() else {
+                continue;
+            };
+            if !item["error"].is_null()
+                || !item["capabilities"]
+                    .as_array()
+                    .is_some_and(|c| c.iter().any(|c| c == "commands"))
+            {
+                continue;
+            }
+            for command in item["registrations"]["commands"]
+                .as_array()
+                .into_iter()
+                .flatten()
+            {
+                let Some(name) = command["name"].as_str() else {
+                    continue;
+                };
+                let description = command["description"]
+                    .as_str()
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| format!("{id} mod command"));
+                entries.push(Entry {
+                    namespaced: format!("{id}:{name}"),
+                    bare: name.to_owned(),
+                    description,
+                    target: ModSlashTarget {
+                        id: id.to_owned(),
+                        command: name.to_owned(),
+                    },
+                });
+            }
+        }
+    }
+    entries
+}
+
+pub(crate) fn build(entries: Vec<Entry>) -> Vec<ModSlashCommand> {
+    let mut counts: BTreeMap<&str, usize> = BTreeMap::new();
+    for entry in &entries {
+        *counts.entry(entry.bare.as_str()).or_default() += 1;
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut commands = Vec::new();
+    for entry in &entries {
+        if !seen.insert(entry.namespaced.clone()) {
+            continue;
+        }
+        let conflict = if builtin(&entry.bare) {
+            Some(format!("conflicts with built-in /{}", entry.bare))
+        } else if counts[entry.bare.as_str()] > 1 {
+            Some("defined by more than one mod".to_owned())
+        } else {
+            None
+        };
+        let description = match &conflict {
+            Some(reason) => format!(
+                "{} · bare /{} unavailable: {reason}",
+                entry.description, entry.bare
+            ),
+            None => entry.description.clone(),
+        };
+        commands.push(ModSlashCommand {
+            invocation: entry.namespaced.clone(),
+            description: description.clone(),
+            target: entry.target.clone(),
+        });
+        if conflict.is_none() && seen.insert(entry.bare.clone()) {
+            commands.push(ModSlashCommand {
+                invocation: entry.bare.clone(),
+                description: format!("{} (/{})", entry.description, entry.namespaced),
+                target: entry.target.clone(),
+            });
+        }
+    }
+    commands
+}
+
+pub(crate) fn slash_commands() -> Vec<ModSlashCommand> {
+    let mut cache = CATALOG
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some((loaded, commands)) = cache.as_ref()
+        && loaded.elapsed() < CATALOG_TTL
+    {
+        return commands.clone();
+    }
+    let commands = build(entries());
+    *cache = Some((Instant::now(), commands.clone()));
+    commands
+}
+
+pub(crate) fn find(invocation: &str) -> Option<ModSlashCommand> {
+    slash_commands()
+        .into_iter()
+        .find(|command| command.invocation == invocation)
+}
+
+struct CommandAuthority<'a> {
+    repository: &'a Path,
+    protected: &'a [std::path::PathBuf],
+    policy: &'a codex_protocol::permissions::FileSystemSandboxPolicy,
+}
+
+impl codex_omd::host::Authority for CommandAuthority<'_> {
+    fn repository(&self) -> &Path {
+        self.repository
+    }
+
+    fn readable(&self, path: &Path) -> bool {
+        !protected(path, self.protected)
+            && self
+                .policy
+                .can_read_local_path_with_cwd(path, self.repository)
+    }
+
+    fn writable(&self, path: &Path) -> bool {
+        self.readable(path)
+            && self
+                .policy
+                .can_write_local_path_with_cwd(path, self.repository)
+    }
+
+    fn command(
+        &self,
+        argv: Vec<String>,
+        access: &codex_omd::host::ExecAccess<'_>,
+    ) -> Result<std::process::Command, String> {
+        if access.loopback {
+            return Err("exec_network_unavailable_in_commands".to_owned());
+        }
+        #[cfg(target_os = "macos")]
+        {
+            use codex_protocol::permissions::FileSystemAccessMode;
+            use codex_protocol::permissions::FileSystemPath;
+            use codex_protocol::permissions::FileSystemSandboxEntry;
+            use codex_protocol::permissions::FileSystemSandboxKind;
+            use codex_protocol::permissions::FileSystemSandboxPolicy;
+            use codex_sandboxing::seatbelt::CreateSeatbeltCommandArgsParams;
+            use codex_sandboxing::seatbelt::MACOS_PATH_TO_SEATBELT_EXECUTABLE;
+            use codex_sandboxing::seatbelt::create_seatbelt_command_args;
+            if self.policy.kind == FileSystemSandboxKind::ExternalSandbox {
+                return Err("exec_requires_native_sandbox".to_owned());
+            }
+            let mut scope = if access.write {
+                self.policy.clone()
+            } else if self.policy.kind == FileSystemSandboxKind::Unrestricted {
+                FileSystemSandboxPolicy::read_only()
+            } else {
+                FileSystemSandboxPolicy::restricted(
+                    self.policy
+                        .entries
+                        .iter()
+                        .cloned()
+                        .map(|mut entry| {
+                            if entry.access == FileSystemAccessMode::Write {
+                                entry.access = FileSystemAccessMode::Read;
+                            }
+                            entry
+                        })
+                        .collect(),
+                )
+            };
+            let scratch = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path_checked(
+                access.scratch,
+            )
+            .map_err(|error| error.to_string())?;
+            scope.entries.push(FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: scratch.into(),
+                },
+                FileSystemAccessMode::Write,
+            ));
+            let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+                command: argv,
+                file_system_sandbox_policy: &scope,
+                network_sandbox_policy:
+                    codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+                sandbox_policy_cwd: self.repository,
+                enforce_managed_network: false,
+                managed_network: None,
+                environment_id: None,
+                network: None,
+                extra_allow_unix_sockets: &[],
+            })?;
+            sandboxed_seatbelt(
+                Path::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE),
+                args,
+                self.protected,
+                self.repository,
+            )
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (argv, access);
+            Err("exec_sandbox_unavailable".to_owned())
+        }
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn command_host(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+) -> std::io::Result<Value> {
+    command_host_guarded(paths, policy, grants, caller, call, None, &|| true)
+}
+
+fn command_host_guarded(
+    paths: &crate::omd::ModPaths,
+    policy: &codex_protocol::permissions::FileSystemSandboxPolicy,
+    grants: Option<codex_omd::ModGrants>,
+    caller: &str,
+    call: codex_omd::ModHostCall,
+    thread: Option<&str>,
+    active: &dyn Fn() -> bool,
+) -> std::io::Result<Value> {
+    if !codex_omd::host::served(&call.operation) {
+        return Err(std::io::Error::other(format!(
+            "unsupported_host_operation: {}",
+            call.operation
+        )));
+    }
+    let grants = grants.ok_or_else(|| std::io::Error::other("host_caller_inactive"))?;
+    let mut protected = paths.protected.clone();
+    protected.push(paths.evidence.clone());
+    let data_root = paths
+        .store
+        .clone()
+        .ok_or_else(|| std::io::Error::other("mod store is not configured"))?;
+    let authority = CommandAuthority {
+        repository: &paths.repository,
+        protected: &protected,
+        policy,
+    };
+    codex_omd::host::Host {
+        authority: &authority,
+        data_root: &data_root,
+        active,
+        record_changes: true,
+    }
+    .call(
+        &codex_omd::host::Caller {
+            id: caller,
+            source_sha256: &grants.source_sha256,
+            capabilities: &grants.capabilities,
+            exec_environment: &grants.exec_environment,
+            origin: codex_omd::data_store::Origin::UserCommand,
+            thread,
+        },
+        &call.operation,
+        call.arguments,
+    )
+    .map_err(std::io::Error::other)
+}
+
+fn preview(
+    runtime: &mut ModHost,
+    paths: &crate::omd::ModPaths,
+    invocation: &ModInvocation,
+) -> Option<ModViewSnapshot> {
+    let mut snapshot = ModViewSnapshot::read(&paths.evidence.join("mod-view.json")).ok()?;
+    let terminal = runtime.terminal_view(snapshot.input.clone(), || true);
+    snapshot.revision = snapshot.revision.saturating_add(1);
+    snapshot.view = terminal.view;
+    snapshot.owner = terminal.owner;
+    snapshot.contributors = terminal.contributors;
+    snapshot.diagnostics.extend(terminal.diagnostics);
+    snapshot.diagnostics.truncate(16);
+    snapshot.input["ledger"] = serde_json::json!({
+        "thread_id": invocation.context.thread_id.map(|id| id.to_string()),
+        "cwd": invocation.context.repository,
+    });
+    Some(snapshot)
+}
+
+fn with_host<T>(run: impl FnOnce(&mut ModHost, &crate::omd::ModPaths) -> Option<T>) -> Option<T> {
+    let paths = crate::omd::mod_paths()?;
+    let store = paths.store.clone()?;
+    let mut host = HOST
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    match host.as_mut() {
+        Some(runtime) => {
+            runtime.reload().ok()?;
+        }
+        None => *host = Some(ModHost::open(store).ok()?),
+    }
+    let runtime = host.as_mut()?;
+    let result = run(runtime, &paths);
+    let status = runtime.status();
+    if status["mods"]
+        .as_array()
+        .is_some_and(|mods| mods.iter().any(|item| item["error"].is_string()))
+        && let Ok(bytes) = serde_json::to_vec(&status)
+        && bytes.len() <= 262_144
+        && let Ok(mut file) = tempfile::NamedTempFile::new_in(&paths.evidence)
+        && file.write_all(&bytes).is_ok()
+    {
+        let _ = file.persist(paths.evidence.join("mod-status.json"));
+    }
+    result
+}
+
+pub(crate) fn selection(payload: Value, invocation: &ModInvocation) -> Option<ModViewSnapshot> {
+    with_host(|runtime, paths| {
+        if !current(invocation) {
+            return None;
+        }
+        if !runtime.has_event("selection_result") {
+            return None;
+        }
+        runtime.event_guarded("selection_result", payload, || current(invocation));
+        current(invocation)
+            .then(|| preview(runtime, paths, invocation))
+            .flatten()
+    })
+}
+
+pub(crate) fn list_view(payload: Value) -> Option<Vec<codex_omd::ModComponent>> {
+    with_host(|runtime, _| {
+        runtime
+            .list_view(payload, || true)
+            .map(|(_, components)| components)
+    })
+}
+
+pub(crate) fn selection_decision(payload: Value) -> Option<bool> {
+    with_host(|runtime, _| runtime.selection_decision(payload, || true))
+}
+
+pub(crate) fn run(
+    target: &ModSlashTarget,
+    args: &str,
+    invocation: &ModInvocation,
+) -> Result<ModCommandResult, String> {
+    let paths = crate::omd::mod_paths_for(&invocation.context.repository)
+        .ok_or("mods are not configured for this session")?;
+    let active = || current(invocation);
+    if !active() {
+        return Err("callback_cancelled".to_owned());
+    }
+    let ModSlashTarget { id, command } = target;
+    let store = paths.store.clone().ok_or("mod store is not configured")?;
+    let mut host = HOST
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    match host.as_mut() {
+        Some(runtime) => {
+            runtime.reload().map_err(|e| e.to_string())?;
+        }
+        None => *host = Some(ModHost::open(store).map_err(|e| e.to_string())?),
+    }
+    let runtime = host.as_mut().ok_or("mod runtime unavailable")?;
+    let generation = runtime.generation();
+    let grants: BTreeMap<_, _> = runtime
+        .owners()
+        .into_iter()
+        .filter_map(|(owner, _)| runtime.grants(&owner).map(|grant| (owner, grant)))
+        .collect();
+    let thread = invocation.context.thread_id.map(|id| id.to_string());
+    let value = runtime
+        .invoke_scoped_with(
+            id,
+            generation,
+            "command",
+            command,
+            Value::String(args.to_owned()),
+            &active,
+            |caller, call| {
+                command_host_guarded(
+                    &paths,
+                    &invocation.context.policy,
+                    grants.get(caller).cloned(),
+                    caller,
+                    call,
+                    thread.as_deref(),
+                    &active,
+                )
+            },
+        )
+        .map_err(|e| e.to_string())?;
+    if !active() {
+        return Err("callback_cancelled".to_owned());
+    }
+    let outcome = ModCommandOutcome::parse(&value).map_err(|e| e.to_string())?;
+    let preview = preview(runtime, &paths, invocation);
+    Ok(ModCommandResult { outcome, preview })
+}
