index 000000000..7629a4acb
--- /dev/null
+++ b/codex-rs/omd/src/admission.rs
@@ -0,0 +1,1380 @@
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fs::OpenOptions;
+use std::fs::{self};
+use std::io::Write;
+use std::io::{self};
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct Limits {
+    pub requests: u32,
+    pub exposure_microusd: u64,
+    pub seconds: u64,
+    pub concurrent_workers: u32,
+    pub max_depth: u32,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct WorkerLimits {
+    pub requests: u32,
+    pub exposure_microusd: u64,
+    pub seconds: u64,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, Ord, PartialEq, PartialOrd)]
+#[serde(deny_unknown_fields)]
+pub struct VersionMarker {
+    pub label: String,
+    pub sha256: String,
+    pub evidence: String,
+    pub evidence_sha256: String,
+}
+
+impl VersionMarker {
+    fn validate(&self) -> io::Result<()> {
+        let valid_hash = |value: &str| {
+            value.len() == 64
+                && value
+                    .bytes()
+                    .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        };
+        if self.label.trim().is_empty()
+            || self.label.len() > 256
+            || !valid_hash(&self.sha256)
+            || self.evidence.trim().is_empty()
+            || self.evidence.len() > 4096
+            || !valid_hash(&self.evidence_sha256)
+        {
+            return Err(io::Error::other("invalid version marker"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum WorkerStatus {
+    Active,
+    Stopped,
+    Completed,
+    Consumed,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct Attempt {
+    pub request: u32,
+    pub owner: String,
+    pub provider: String,
+    pub model: String,
+    pub reserved_microusd: u64,
+    pub status: String,
+    pub failure_reason: Option<String>,
+    pub raw_usage: Option<Value>,
+    pub settled_microusd: Option<u64>,
+    #[serde(default, skip_serializing_if = "is_false")]
+    pub external_subscription: bool,
+}
+
+fn is_false(value: &bool) -> bool {
+    !value
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct TaskCostCapture {
+    pub schema: u32,
+    pub attempts: Vec<Attempt>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub observed: Vec<Attempt>,
+    pub settled_task_charge_microusd: u64,
+    #[serde(default)]
+    pub subscription_list_equivalent_microusd: u64,
+    pub retained_exposure_upper_bound_microusd: u64,
+    pub raw_usage_attempts: u32,
+    pub uncertain_requests: Vec<u32>,
+}
+
+#[derive(Clone, Debug)]
+pub struct Admission {
+    request: u32,
+    task: PathBuf,
+}
+
+impl Admission {
+    pub fn request_id(&self) -> u32 {
+        self.request
+    }
+}
+
+struct Worker {
+    parent: String,
+    depth: u32,
+    limits: WorkerLimits,
+    started: Instant,
+    requests: u32,
+    exposure: u64,
+    status: WorkerStatus,
+    objective: Option<String>,
+    result: Option<VersionMarker>,
+}
+
+#[derive(Debug, Deserialize, Serialize, PartialEq)]
+struct ArchivedWorker {
+    id: String,
+    parent: String,
+    depth: u32,
+    limits: WorkerLimits,
+    requests: u32,
+    exposure_microusd: u64,
+    status: WorkerStatus,
+    objective: Option<String>,
+    result: Option<VersionMarker>,
+}
+
+impl ArchivedWorker {
+    fn from_worker(id: String, worker: &Worker) -> Self {
+        Self {
+            id,
+            parent: worker.parent.clone(),
+            depth: worker.depth,
+            limits: worker.limits.clone(),
+            requests: worker.requests,
+            exposure_microusd: worker.exposure,
+            status: worker.status,
+            objective: worker.objective.clone(),
+            result: worker.result.clone(),
+        }
+    }
+
+    fn matches_worker(&self, worker: &Worker) -> bool {
+        self.parent == worker.parent
+            && self.depth == worker.depth
+            && self.limits == worker.limits
+            && self.requests == worker.requests
+            && self.exposure_microusd == worker.exposure
+            && self.status == worker.status
+            && self.objective == worker.objective
+            && self.result == worker.result
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum TaskStatus {
+    Active,
+    Paused,
+    Stopped,
+}
+
+struct State {
+    status: TaskStatus,
+    requests: u32,
+    exposure: u64,
+    sequence: u64,
+    attempts: BTreeMap<u32, Attempt>,
+    seen_workers: BTreeSet<String>,
+    workers: BTreeMap<String, Worker>,
+    observed: Vec<Attempt>,
+}
+
+const MAX_OBSERVED_REQUESTS: usize = 10_000;
+const MAX_TASK_REQUESTS: u32 = 10_000;
+const MAX_LIVE_WORKERS: usize = 128;
+const MAX_TOTAL_WORKERS: usize = 1_024;
+
+pub struct Task {
+    limits: Limits,
+    started: Instant,
+    deadline_unix_millis: u128,
+    evidence: PathBuf,
+    state: Mutex<State>,
+    external_routes: Mutex<BTreeSet<(String, String)>>,
+    worker_routes: Mutex<BTreeMap<String, (String, String)>>,
+}
+
+fn denied(message: &str) -> io::Error {
+    io::Error::other(message)
+}
+
+fn unix_millis() -> io::Result<u128> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_millis())
+        .map_err(|_| denied("system clock precedes Unix epoch"))
+}
+
+impl Task {
+    fn validate_limits(limits: &Limits) -> io::Result<()> {
+        if limits.requests == 0
+            || limits.requests > MAX_TASK_REQUESTS
+            || limits.seconds == 0
+            || limits.concurrent_workers == 0
+            || limits.concurrent_workers as usize > MAX_LIVE_WORKERS
+            || limits.max_depth == 0
+        {
+            return Err(denied(
+                "task limits must be positive and within runtime ceilings",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn create(limits: Limits, evidence: PathBuf) -> io::Result<Self> {
+        Self::create_inner(limits, evidence)
+    }
+
+    fn create_inner(limits: Limits, evidence: PathBuf) -> io::Result<Self> {
+        Self::validate_limits(&limits)?;
+        fs::create_dir(&evidence)?;
+        let evidence = evidence.canonicalize()?;
+        let task = Self {
+            deadline_unix_millis: unix_millis()?
+                .checked_add(u128::from(limits.seconds) * 1000)
+                .ok_or_else(|| denied("task deadline overflow"))?,
+            limits,
+            started: Instant::now(),
+            evidence,
+            state: Mutex::new(State {
+                status: TaskStatus::Active,
+                requests: 0,
+                exposure: 0,
+                sequence: 0,
+                attempts: BTreeMap::new(),
+                seen_workers: BTreeSet::new(),
+                workers: BTreeMap::new(),
+                observed: Vec::new(),
+            }),
+            external_routes: Mutex::new(BTreeSet::new()),
+            worker_routes: Mutex::new(BTreeMap::new()),
+        };
+        let mut state = task
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        task.record(
+            &mut state,
+            &serde_json::json!({"event": "created", "limits": task.limits}),
+        )?;
+        drop(state);
+        Ok(task)
+    }
+
+    pub fn open(
+        limits: Limits,
+        evidence: PathBuf,
+        explicit_resume: Option<&str>,
+    ) -> io::Result<Self> {
+        Self::open_inner(limits, evidence, explicit_resume)
+    }
+
+    fn open_inner(
+        limits: Limits,
+        evidence: PathBuf,
+        explicit_resume: Option<&str>,
+    ) -> io::Result<Self> {
+        Self::validate_limits(&limits)?;
+        if !evidence.exists() {
+            if explicit_resume.is_some() {
+                return Err(denied("explicit resume has no prior task evidence"));
+            }
+            return Self::create_inner(limits, evidence);
+        }
+        let reference =
+            explicit_resume.ok_or_else(|| denied("existing task requires explicit resume"))?;
+        if reference.is_empty() || reference.len() > 4096 {
+            return Err(denied("explicit resume reference required"));
+        }
+        let evidence = evidence.canonicalize()?;
+        let mut records = fs::read_dir(&evidence)?
+            .filter_map(Result::ok)
+            .filter(|entry| {
+                entry.file_name().to_str().is_some_and(|name| {
+                    name.strip_suffix(".json").is_some_and(|stem| {
+                        stem.len() == 8 && stem.bytes().all(|byte| byte.is_ascii_digit())
+                    })
+                })
+            })
+            .collect::<Vec<_>>();
+        records.sort_by_key(fs::DirEntry::file_name);
+        if records.len() > 200_000 { return Err(denied("resume journal limit")); }
+        if records.is_empty() {
+            return Err(denied("resume evidence is empty"));
+        }
+        let mut state = State {
+            status: TaskStatus::Active,
+            requests: 0,
+            exposure: 0,
+            sequence: 0,
+            attempts: BTreeMap::new(),
+            seen_workers: BTreeSet::new(),
+            workers: BTreeMap::new(),
+            observed: Vec::new(),
+        };
+        let mut created_unix_millis = None;
+        for entry in records {
+            let metadata = entry.metadata()?;
+            if entry.file_type()?.is_symlink() || !metadata.is_file() || metadata.len() > 4 * 1024 * 1024 {
+                return Err(denied("resume evidence must be a bounded regular file"));
+            }
+            let value: Value = serde_json::from_slice(&fs::read(entry.path())?)?;
+            let sequence = value["sequence"]
+                .as_u64()
+                .ok_or_else(|| denied("resume evidence sequence missing"))?;
+            if state.sequence.checked_add(1) != Some(sequence) {
+                return Err(denied("resume evidence sequence is incomplete"));
+            }
+            state.sequence = sequence;
+            let timestamp = value["unix_millis"]
+                .as_u64()
+                .map(u128::from)
+                .ok_or_else(|| denied("resume evidence timestamp missing"))?;
+            created_unix_millis.get_or_insert(timestamp);
+            let record = &value["record"];
+            if state.sequence == 1 && record["event"] != "created" {
+                return Err(denied("resume evidence must begin with task creation"));
+            }
+            match record["event"].as_str() {
+                Some("created") => {
+                    let recorded: Limits = serde_json::from_value(record["limits"].clone())?;
+                    if state.sequence != 1 || recorded != limits {
+                        return Err(denied("resume limits differ from original task"));
+                    }
+                }
+                Some("worker_started") => {
+                    let id = record["worker"]
+                        .as_str()
+                        .ok_or_else(|| denied("worker identity missing"))?
+                        .to_owned();
+                    if !state.seen_workers.insert(id.clone())
+                        || state.seen_workers.len() > MAX_TOTAL_WORKERS
+                        || state.workers.len() >= MAX_LIVE_WORKERS
+                    {
+                        return Err(denied(
+                            "worker identity or live worker archive limit exceeded",
+                        ));
+                    }
+                    state.workers.insert(
+                        id,
+                        Worker {
+                            parent: record["parent"].as_str().unwrap_or("lead").to_owned(),
+                            depth: u32::try_from(record["depth"].as_u64().unwrap_or(1))
+                                .map_err(|_| denied("worker depth overflow"))?,
+                            limits: serde_json::from_value(record["limits"].clone())?,
+                            started: Instant::now(),
+                            requests: 0,
+                            exposure: 0,
+                            status: WorkerStatus::Active,
+                            objective: None,
+                            result: None,
+                        },
+                    );
+                }
+                Some("worker_stopped") => {
+                    if let Some(worker) = record["worker"]
+                        .as_str()
+                        .and_then(|id| state.workers.get_mut(id))
+                    {
+                        worker.status = WorkerStatus::Stopped;
+                    }
+                }
+                Some("worker_objective_claimed") => {
+                    let worker = record["worker"]
+                        .as_str()
+                        .and_then(|id| state.workers.get_mut(id))
+                        .ok_or_else(|| denied("objective worker missing"))?;
+                    worker.objective = Some(
+                        record["objective"]
+                            .as_str()
+                            .ok_or_else(|| denied("worker objective missing"))?
+                            .to_owned(),
+                    );
+                }
+                Some("worker_completed") => {
+                    let worker = record["worker"]
+                        .as_str()
+                        .and_then(|id| state.workers.get_mut(id))
+                        .ok_or_else(|| denied("completed worker missing"))?;
+                    let result: VersionMarker = serde_json::from_value(record["result"].clone())?;
+                    result.validate()?;
+                    worker.status = WorkerStatus::Completed;
+                    worker.result = Some(result);
+                }
+                Some("worker_result_consumed") => {
+                    let worker = record["worker"]
+                        .as_str()
+                        .and_then(|id| state.workers.get_mut(id))
+                        .ok_or_else(|| denied("consumed worker missing"))?;
+                    worker.status = WorkerStatus::Consumed;
+                }
+                Some("worker_result_discarded") => {
+                    let worker = record["worker"]
+                        .as_str()
+                        .and_then(|id| state.workers.get_mut(id))
+                        .ok_or_else(|| denied("discarded worker missing"))?;
+                    if worker.status != WorkerStatus::Completed {
+                        return Err(denied("discarded worker was not completed"));
+                    }
+                    worker.status = WorkerStatus::Stopped;
+                }
+                Some("worker_archived") => {
+                    let archived: ArchivedWorker =
+                        serde_json::from_value(record["archive"].clone())?;
+                    let worker = state
+                        .workers
+                        .get(&archived.id)
+                        .ok_or_else(|| denied("archived worker missing from live state"))?;
+                    if archived.status == WorkerStatus::Active || !archived.matches_worker(worker) {
+                        return Err(denied("archived worker evidence changed"));
+                    }
+                    state.workers.remove(&archived.id);
+                }
+                Some("request_admitted")
+                | Some("request_dispatched")
+                | Some("request_failed")
+                | Some("request_settled")
+                | Some("raw_usage_observed") => {
+                    let attempt: Attempt = serde_json::from_value(record["attempt"].clone())?;
+                    let prior = state.attempts.insert(attempt.request, attempt.clone());
+                    if let Some(worker) = state.workers.get_mut(&attempt.owner) {
+                        if prior.is_none() {
+                            worker.requests = worker
+                                .requests
+                                .checked_add(1)
+                                .ok_or_else(|| denied("resume worker request count overflow"))?;
+                        }
+                        let prior_exposure = prior.as_ref().map_or(0, |prior| {
+                            prior.settled_microusd.unwrap_or(prior.reserved_microusd)
+                        });
+                        let exposure = attempt
+                            .settled_microusd
+                            .unwrap_or(attempt.reserved_microusd);
+                        worker.exposure = worker
+                            .exposure
+                            .checked_sub(prior_exposure)
+                            .and_then(|value| value.checked_add(exposure))
+                            .ok_or_else(|| denied("resume worker exposure overflow"))?;
+                    }
+                }
+                Some("task_paused") => {
+                    let recorded = record["active_workers"]
+                        .as_array()
+                        .ok_or_else(|| denied("paused worker list missing"))?
+                        .iter()
+                        .map(|value| {
+                            value
+                                .as_str()
+                                .map(str::to_owned)
+                                .ok_or_else(|| denied("paused worker identity missing"))
+                        })
+                        .collect::<io::Result<BTreeSet<_>>>()?;
+                    let active = state
+                        .workers
+                        .iter()
+                        .filter(|(_, worker)| worker.status == WorkerStatus::Active)
+                        .map(|(id, _)| id.clone())
+                        .collect::<BTreeSet<_>>();
+                    if recorded != active {
+                        return Err(denied("paused worker list changed"));
+                    }
+                    for id in recorded {
+                        if let Some(worker) = state.workers.get_mut(&id) {
+                            worker.status = WorkerStatus::Stopped;
+                        }
+                    }
+                    state.status = TaskStatus::Paused;
+                }
+                Some("task_resumed") => state.status = TaskStatus::Active,
+                Some("reservation_violation") => {
+                    let attempt: Attempt = serde_json::from_value(record["attempt"].clone())?;
+                    state.attempts.insert(attempt.request, attempt);
+                    state.status = TaskStatus::Stopped;
+                }
+                Some("task_stopped") => {
+                    state.status = TaskStatus::Stopped;
+                }
+                Some("request_observed") => {
+                    let attempt: Attempt = serde_json::from_value(record["attempt"].clone())?;
+                    if state.observed.len() >= MAX_OBSERVED_REQUESTS
+                        || attempt.request as usize != state.observed.len() + 1
+                        || !attempt.status.starts_with("observed_")
+                        || attempt.reserved_microusd != 0 || attempt.settled_microusd.is_some() {
+                        return Err(denied("resume observed request invalid"));
+                    }
+                    state.observed.push(attempt);
+                }
+                Some("dispatch_callback_failed") => {}
+                Some(_) => return Err(denied("resume evidence event is unsupported")),
+                None => return Err(denied("resume evidence event missing")),
+            }
+        }
+        state.requests = u32::try_from(state.attempts.len())
+            .map_err(|_| denied("resume request count overflow"))?;
+        if state.attempts.keys().copied().ne(1..=state.requests) {
+            return Err(denied("resume request sequence is incomplete"));
+        }
+        state.exposure = state.attempts.values().try_fold(0u64, |total, attempt| {
+            total
+                .checked_add(
+                    attempt
+                        .settled_microusd
+                        .unwrap_or(attempt.reserved_microusd),
+                )
+                .ok_or_else(|| denied("resume exposure overflow"))
+        })?;
+        for worker in state.workers.values_mut() {
+            if worker.status == WorkerStatus::Active {
+                worker.status = WorkerStatus::Stopped;
+            }
+        }
+        state
+            .workers
+            .retain(|_, worker| worker.status == WorkerStatus::Completed);
+        if state.status == TaskStatus::Stopped {
+            return Err(denied("stopped task cannot resume"));
+        }
+        let deadline_unix_millis = created_unix_millis
+            .ok_or_else(|| denied("created timestamp missing"))?
+            .checked_add(u128::from(limits.seconds) * 1000)
+            .ok_or_else(|| denied("task deadline overflow"))?;
+        if unix_millis()? >= deadline_unix_millis {
+            return Err(denied("task expired before resume"));
+        }
+        let task = Self {
+            limits,
+            started: Instant::now(),
+            deadline_unix_millis,
+            evidence,
+            state: Mutex::new(state),
+            external_routes: Mutex::new(BTreeSet::new()),
+            worker_routes: Mutex::new(BTreeMap::new()),
+        };
+        let uncertain = task.uncertain_requests()?;
+        {
+            let mut state = task
+                .state
+                .lock()
+                .map_err(|_| denied("task lock poisoned"))?;
+            if state.status == TaskStatus::Active {
+                task.record(
+                    &mut state,
+                    &serde_json::json!({"event": "task_paused", "reason": "abrupt_client_loss", "active_workers": [], "uncertain_operations": uncertain}),
+                )?;
+                state.status = TaskStatus::Paused;
+            }
+        }
+        task.resume(reference)?;
+        Ok(task)
+    }
+
+    fn expired(&self) -> bool {
+        unix_millis().map_or(true, |now| now >= self.deadline_unix_millis)
+    }
+
+    fn record(&self, state: &mut State, event: &Value) -> io::Result<()> {
+        state.sequence = state
+            .sequence
+            .checked_add(1)
+            .ok_or_else(|| denied("evidence sequence overflow"))?;
+        let result = (|| {
+            let bytes = serde_json::to_vec(&serde_json::json!({
+                "sequence": state.sequence,
+                "elapsed_millis": self.started.elapsed().as_millis(),
+                "unix_millis": unix_millis()?,
+                "record": event,
+            }))?;
+            if bytes.len() > 1_048_576 {
+                return Err(denied("evidence event exceeds size limit"));
+            }
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(self.evidence.join(format!("{:08}.json", state.sequence)))?;
+            file.write_all(&bytes)?;
+            file.sync_all()
+        })();
+        if result.is_err() {
+            state.status = TaskStatus::Stopped;
+        }
+        result
+    }
+
+    fn archive_worker(&self, state: &mut State, id: &str) -> io::Result<()> {
+        self.worker_routes
+            .lock()
+            .map_err(|_| denied("worker route lock poisoned"))?
+            .remove(id);
+        let archived = ArchivedWorker::from_worker(
+            id.to_owned(),
+            state
+                .workers
+                .get(id)
+                .ok_or_else(|| denied("worker archive target missing"))?,
+        );
+        if archived.status == WorkerStatus::Active {
+            return Err(denied("active worker cannot be archived"));
+        }
+        self.record(
+            state,
+            &serde_json::json!({"event": "worker_archived", "archive": archived}),
+        )?;
+        state.workers.remove(id);
+        Ok(())
+    }
+
+    pub fn start_worker(
+        &self,
+        id: String,
+        parent: String,
+        depth: u32,
+        limits: WorkerLimits,
+    ) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if id.is_empty()
+            || id.len() > 128
+            || id == "lead"
+            || state.seen_workers.contains(&id)
+            || state.seen_workers.len() >= MAX_TOTAL_WORKERS
+            || state.workers.len() >= MAX_LIVE_WORKERS
+        {
+            return Err(denied("invalid or reused worker identity"));
+        }
+        if state.status != TaskStatus::Active || self.expired() {
+            return Err(denied("task stopped or expired"));
+        }
+        let valid_parent = if depth == 1 {
+            parent == "lead"
+        } else {
+            state.workers.get(&parent).is_some_and(|worker| {
+                worker.status == WorkerStatus::Active && worker.depth.checked_add(1) == Some(depth)
+            })
+        };
+        if limits.requests == 0
+            || limits.seconds == 0
+            || depth == 0
+            || depth > self.limits.max_depth
+            || !valid_parent
+            || limits.requests > self.limits.requests
+            || limits.seconds > self.limits.seconds
+            || limits.exposure_microusd > self.limits.exposure_microusd
+            || state
+                .workers
+                .values()
+                .filter(|worker| worker.status == WorkerStatus::Active)
+                .count()
+                >= self.limits.concurrent_workers as usize
+        {
+            return Err(denied("worker limits exceed task ceiling or capacity"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "worker_started", "worker": id, "parent": parent, "depth": depth, "limits": limits}),
+        )?;
+        state.seen_workers.insert(id.clone());
+        state.workers.insert(
+            id,
+            Worker {
+                parent,
+                depth,
+                limits,
+                started: Instant::now(),
+                requests: 0,
+                exposure: 0,
+                status: WorkerStatus::Active,
+                objective: None,
+                result: None,
+            },
+        );
+        Ok(())
+    }
+
+    pub fn claim_worker_objective(&self, id: &str, objective: &str) -> io::Result<()> {
+        let normalized = objective
+            .split_whitespace()
+            .map(str::to_lowercase)
+            .collect::<Vec<_>>()
+            .join(" ");
+        if normalized.is_empty() || normalized.len() > 4096 {
+            return Err(denied("bounded worker objective required"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if !state.workers.get(id).is_some_and(|worker| {
+            worker.status == WorkerStatus::Active && worker.objective.is_none()
+        }) || state.workers.iter().any(|(other_id, worker)| {
+            other_id != id
+                && worker.status == WorkerStatus::Active
+                && worker.objective.as_deref() == Some(normalized.as_str())
+        }) {
+            return Err(denied("duplicate or invalid active worker objective"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "worker_objective_claimed", "worker": id, "objective": normalized}),
+        )?;
+        state
+            .workers
+            .get_mut(id)
+            .ok_or_else(|| denied("worker disappeared"))?
+            .objective = Some(normalized);
+        Ok(())
+    }
+
+    pub fn complete_worker(&self, id: &str, result: VersionMarker) -> io::Result<()> {
+        result.validate()?;
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if !state
+            .workers
+            .get(id)
+            .is_some_and(|worker| worker.status == WorkerStatus::Active)
+            || state
+                .workers
+                .values()
+                .any(|worker| worker.status == WorkerStatus::Active && worker.parent == id)
+        {
+            return Err(denied("worker is not completable"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "worker_completed", "worker": id, "result": result}),
+        )?;
+        let worker = state
+            .workers
+            .get_mut(id)
+            .ok_or_else(|| denied("worker disappeared"))?;
+        worker.status = WorkerStatus::Completed;
+        worker.result = Some(result);
+        Ok(())
+    }
+
+    pub fn consume_worker_result(&self, id: &str) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if !state.workers.get(id).is_some_and(|worker| {
+            worker.status == WorkerStatus::Completed && worker.result.is_some()
+        }) {
+            return Err(denied("worker result is not consumable"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "worker_result_consumed", "worker": id}),
+        )?;
+        state
+            .workers
+            .get_mut(id)
+            .ok_or_else(|| denied("worker disappeared"))?
+            .status = WorkerStatus::Consumed;
+        self.archive_worker(&mut state, id)?;
+        Ok(())
+    }
+
+    pub fn discard_worker_result(&self, id: &str) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if !state
+            .workers
+            .get(id)
+            .is_some_and(|worker| worker.status == WorkerStatus::Completed)
+        {
+            return Err(denied("worker has no completed result to discard"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event":"worker_result_discarded","worker":id}),
+        )?;
+        state
+            .workers
+            .get_mut(id)
+            .ok_or_else(|| denied("worker disappeared"))?
+            .status = WorkerStatus::Stopped;
+        self.archive_worker(&mut state, id)?;
+        Ok(())
+    }
+
+    pub fn finish_worker(&self, id: &str) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if !state
+            .workers
+            .get(id)
+            .is_some_and(|worker| worker.status == WorkerStatus::Active)
+        {
+            return Err(denied("unknown or inactive worker"));
+        }
+        if state
+            .workers
+            .values()
+            .any(|worker| worker.status == WorkerStatus::Active && worker.parent == id)
+        {
+            return Err(denied("worker has active descendants"));
+        }
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "worker_stopped", "worker": id}),
+        )?;
+        state
+            .workers
+            .get_mut(id)
+            .ok_or_else(|| denied("worker disappeared"))?
+            .status = WorkerStatus::Stopped;
+        self.archive_worker(&mut state, id)?;
+        Ok(())
+    }
+
+    pub fn authorize_route(&self, provider: &str, model: &str) -> io::Result<()> {
+        if provider.is_empty()
+            || provider.len() > 64
+            || !provider
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+            || model.is_empty()
+            || model.len() > 128
+        {
+            return Err(denied("invalid provider route"));
+        }
+        self.external_routes
+            .lock()
+            .map_err(|_| denied("external route lock poisoned"))?
+            .insert((provider.to_owned(), model.to_owned()));
+        Ok(())
+    }
+
+    pub fn authorize_worker_route(
+        &self,
+        owner: &str,
+        provider: &str,
+        model: &str,
+    ) -> io::Result<()> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.status != TaskStatus::Active
+            || self.expired()
+            || owner == "lead"
+            || !state
+                .workers
+                .get(owner)
+                .is_some_and(|worker| worker.status == WorkerStatus::Active)
+            || provider.is_empty()
+            || provider.len() > 64
+            || !provider
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+            || model.is_empty()
+            || model.len() > 128
+        {
+            return Err(denied("invalid worker provider route"));
+        }
+        let mut routes = self
+            .worker_routes
+            .lock()
+            .map_err(|_| denied("worker route lock poisoned"))?;
+        let route = (provider.to_owned(), model.to_owned());
+        if routes.get(owner).is_some_and(|current| current != &route) {
+            return Err(denied("worker provider route already fixed"));
+        }
+        routes.insert(owner.to_owned(), route);
+        Ok(())
+    }
+
+    pub fn admit(
+        &self,
+        owner: &str,
+        provider: &str,
+        model: &str,
+        exposure_microusd: u64,
+    ) -> io::Result<Admission> {
+        self.admit_with_billing(owner, provider, model, exposure_microusd, false)
+    }
+
+    pub fn admit_with_billing(
+        &self,
+        owner: &str,
+        provider: &str,
+        model: &str,
+        exposure_microusd: u64,
+        external_subscription: bool,
+    ) -> io::Result<Admission> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.status != TaskStatus::Active || self.expired() {
+            return Err(denied("task stopped or expired"));
+        }
+        let allowed = self
+            .worker_routes
+            .lock()
+            .map_err(|_| denied("worker route lock poisoned"))?
+            .get(owner)
+            .is_some_and(|route| route == &(provider.to_owned(), model.to_owned()))
+            || self
+                .external_routes
+                .lock()
+                .map_err(|_| denied("external route lock poisoned"))?
+                .contains(&(provider.to_owned(), model.to_owned()));
+        if !allowed {
+            return Err(denied("provider/model route is not authorized"));
+        }
+        if external_subscription
+            && !self
+                .external_routes
+                .lock()
+                .map_err(|_| denied("external route lock poisoned"))?
+                .contains(&(provider.to_owned(), model.to_owned()))
+        {
+            return Err(denied("external subscription requires a granted route"));
+        }
+        let next_exposure = state
+            .exposure
+            .checked_add(exposure_microusd)
+            .ok_or_else(|| denied("exposure overflow"))?;
+        if state.requests >= self.limits.requests || next_exposure > self.limits.exposure_microusd {
+            return Err(denied("shared request or exposure limit"));
+        }
+        if owner != "lead" {
+            let worker = state
+                .workers
+                .get(owner)
+                .ok_or_else(|| denied("unregistered worker"))?;
+            if worker.status != WorkerStatus::Active
+                || worker.started.elapsed().as_secs() >= worker.limits.seconds
+                || worker.requests >= worker.limits.requests
+                || worker
+                    .exposure
+                    .checked_add(exposure_microusd)
+                    .is_none_or(|amount| amount > worker.limits.exposure_microusd)
+            {
+                return Err(denied("worker stopped or allowance exhausted"));
+            }
+        }
+        let attempt = Attempt {
+            request: state.requests + 1,
+            owner: owner.to_owned(),
+            provider: provider.to_owned(),
+            model: model.to_owned(),
+            reserved_microusd: exposure_microusd,
+            status: "unknown".to_owned(),
+            failure_reason: None,
+            raw_usage: None,
+            settled_microusd: None,
+            external_subscription,
+        };
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "request_admitted", "attempt": attempt}),
+        )?;
+        state.requests += 1;
+        state.exposure = next_exposure;
+        if let Some(worker) = state.workers.get_mut(owner) {
+            worker.requests += 1;
+            worker.exposure += exposure_microusd;
+        }
+        let admission = Admission {
+            request: attempt.request,
+            task: self.evidence.clone(),
+        };
+        state.attempts.insert(attempt.request, attempt);
+        Ok(admission)
+    }
+
+    pub fn dispatch<T>(
+        &self,
+        admission: &Admission,
+        send: impl FnOnce() -> io::Result<T>,
+    ) -> io::Result<T> {
+        if admission.task != self.evidence {
+            return Err(denied("request belongs to another task"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        let mut attempt = state
+            .attempts
+            .get(&admission.request)
+            .cloned()
+            .ok_or_else(|| denied("unknown request"))?;
+        if state.status != TaskStatus::Active
+            || self.expired()
+            || attempt.status != "unknown"
+        {
+            return Err(denied(
+                "request dispatch stopped, expired, revoked or already consumed",
+            ));
+        }
+        if attempt.owner != "lead"
+            && !state.workers.get(&attempt.owner).is_some_and(|worker| {
+                worker.status == WorkerStatus::Active
+                    && worker.started.elapsed().as_secs() < worker.limits.seconds
+            })
+        {
+            return Err(denied("worker stopped or expired before dispatch"));
+        }
+        attempt.status = "in_flight".to_owned();
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "request_dispatched", "attempt": attempt}),
+        )?;
+        state.attempts.insert(admission.request, attempt.clone());
+        drop(state);
+        match send() {
+            Ok(value) => Ok(value),
+            Err(error) => {
+                let mut state = self
+                    .state
+                    .lock()
+                    .map_err(|_| denied("task lock poisoned"))?;
+                let mut attempt = state
+                    .attempts
+                    .get(&admission.request)
+                    .cloned()
+                    .ok_or_else(|| denied("unknown dispatched request"))?;
+                if attempt.status == "in_flight" {
+                    attempt.status = "failed".to_owned();
+                    attempt.failure_reason = Some("dispatch_failed".to_owned());
+                } else {
+                    self.record(&mut state, &serde_json::json!({"event": "dispatch_callback_failed", "request": admission.request, "request_status": attempt.status}))?;
+                    return Err(error);
+                }
+                self.record(
+                    &mut state,
+                    &serde_json::json!({"event": "request_failed", "attempt": attempt}),
+                )?;
+                state.attempts.insert(admission.request, attempt);
+                Err(error)
+            }
+        }
+    }
+
+    pub fn settle(
+        &self,
+        admission: &Admission,
+        raw_usage: Value,
+        upper_microusd: u64,
+    ) -> io::Result<()> {
+        if admission.task != self.evidence {
+            return Err(denied("request belongs to another task"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        let mut attempt = state
+            .attempts
+            .get(&admission.request)
+            .cloned()
+            .ok_or_else(|| denied("unknown request"))?;
+        if attempt.status == "unknown"
+            || attempt.settled_microusd.is_some()
+            || !raw_usage.is_object()
+        {
+            return Err(denied("request settled or invalid raw usage"));
+        }
+        if upper_microusd > attempt.reserved_microusd {
+            state.status = TaskStatus::Stopped;
+            state.exposure = state
+                .exposure
+                .saturating_add(upper_microusd - attempt.reserved_microusd);
+            if let Some(worker) = state.workers.get_mut(&attempt.owner) {
+                worker.exposure = worker
+                    .exposure
+                    .saturating_add(upper_microusd - attempt.reserved_microusd);
+            }
+            attempt.raw_usage = Some(raw_usage);
+            attempt.settled_microusd = Some(upper_microusd);
+            attempt.status = "reservation_violation".to_owned();
+            state.attempts.insert(admission.request, attempt.clone());
+            self.record(
+                &mut state,
+                &serde_json::json!({"event": "reservation_violation", "attempt": attempt}),
+            )?;
+            return Err(denied(
+                "observed usage exceeded reservation; admission stopped",
+            ));
+        }
+        attempt.raw_usage = Some(raw_usage);
+        attempt.settled_microusd = Some(upper_microusd);
+        attempt.status = if attempt.failure_reason.is_some() {
+            "failed"
+        } else {
+            "completed"
+        }
+        .to_owned();
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "request_settled", "attempt": attempt}),
+        )?;
+        let released = attempt.reserved_microusd - upper_microusd;
+        state.exposure -= released;
+        if let Some(worker) = state.workers.get_mut(&attempt.owner) {
+            worker.exposure -= released;
+        }
+        state.attempts.insert(admission.request, attempt);
+        Ok(())
+    }
+
+    pub fn fail(&self, admission: &Admission, reason: &str) -> io::Result<()> {
+        if admission.task != self.evidence || reason.is_empty() || reason.len() > 4096 {
+            return Err(denied("invalid failure identity or reason"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        let mut attempt = state
+            .attempts
+            .get(&admission.request)
+            .cloned()
+            .ok_or_else(|| denied("unknown request"))?;
+        if !matches!(attempt.status.as_str(), "unknown" | "in_flight") {
+            return Err(denied("request already finalized"));
+        }
+        attempt.status = "failed".to_owned();
+        attempt.failure_reason = Some(reason.to_owned());
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "request_failed", "attempt": attempt}),
+        )?;
+        state.attempts.insert(admission.request, attempt);
+        Ok(())
+    }
+
+    pub fn retain_usage(&self, admission: &Admission, raw_usage: Value) -> io::Result<()> {
+        if admission.task != self.evidence || !raw_usage.is_object() {
+            return Err(denied("invalid raw usage identity or shape"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        let mut attempt = state
+            .attempts
+            .get(&admission.request)
+            .cloned()
+            .ok_or_else(|| denied("unknown request"))?;
+        if attempt.raw_usage.is_some() || attempt.settled_microusd.is_some() {
+            return Err(denied("raw usage already retained"));
+        }
+        attempt.raw_usage = Some(raw_usage);
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "raw_usage_observed", "attempt": attempt}),
+        )?;
+        state.attempts.insert(admission.request, attempt);
+        Ok(())
+    }
+
+    pub fn check_active(&self) -> io::Result<()> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.status != TaskStatus::Active || self.expired() {
+            return Err(denied("task stopped or expired"));
+        }
+        Ok(())
+    }
+
+    pub fn pause(&self, reason: &str, uncertain_operations: Vec<u32>) -> io::Result<()> {
+        if reason.is_empty() || reason.len() > 256 {
+            return Err(denied("pause reason required"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.status != TaskStatus::Active {
+            return Err(denied("only an active task can pause"));
+        }
+        let active_workers = state
+            .workers
+            .iter()
+            .filter(|(_, worker)| worker.status == WorkerStatus::Active)
+            .map(|(id, _)| id.clone())
+            .collect::<Vec<_>>();
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "task_paused", "reason": reason, "active_workers": active_workers, "uncertain_operations": uncertain_operations}),
+        )?;
+        state.status = TaskStatus::Paused;
+        for id in active_workers {
+            if let Some(worker) = state.workers.get_mut(&id) {
+                worker.status = WorkerStatus::Stopped;
+            }
+            self.archive_worker(&mut state, &id)?;
+        }
+        Ok(())
+    }
+
+    pub fn resume(&self, reference: &str) -> io::Result<()> {
+        if reference.is_empty() || reference.len() > 4096 {
+            return Err(denied("explicit resume reference required"));
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.status != TaskStatus::Paused || self.expired() {
+            return Err(denied("task is not resumable"));
+        }
+        let remaining_requests = self.limits.requests.saturating_sub(state.requests);
+        let remaining_exposure = self.limits.exposure_microusd.saturating_sub(state.exposure);
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "task_resumed", "reference": reference, "remaining": {"requests": remaining_requests, "exposure_microusd": remaining_exposure}}),
+        )?;
+        state.status = TaskStatus::Active;
+        Ok(())
+    }
+
+    pub fn uncertain_requests(&self) -> io::Result<Vec<u32>> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        Ok(state
+            .attempts
+            .values()
+            .filter(|attempt| matches!(attempt.status.as_str(), "unknown" | "in_flight"))
+            .map(|attempt| attempt.request)
+            .collect())
+    }
+
+    pub fn observe(
+        &self,
+        owner: &str,
+        provider: &str,
+        model: &str,
+        raw_usage: Option<Value>,
+        status: &str,
+    ) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        if state.observed.len() >= MAX_OBSERVED_REQUESTS {
+            return Ok(());
+        }
+        let attempt = Attempt {
+            request: u32::try_from(state.observed.len() + 1).unwrap_or(u32::MAX),
+            owner: owner.chars().take(128).collect(),
+            provider: provider.chars().take(64).collect(),
+            model: model.chars().take(128).collect(),
+            reserved_microusd: 0,
+            status: format!("observed_{}", status.chars().take(32).collect::<String>()),
+            failure_reason: None,
+            raw_usage,
+            settled_microusd: None,
+            external_subscription: false,
+        };
+        self.record(
+            &mut state,
+            &serde_json::json!({"event": "request_observed", "attempt": attempt}),
+        )?;
+        state.observed.push(attempt);
+        Ok(())
+    }
+
+    pub fn stop(&self) -> io::Result<()> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        state.status = TaskStatus::Stopped;
+        self.record(&mut state, &serde_json::json!({"event": "task_stopped"}))?;
+        Ok(())
+    }
+
+    pub fn remaining(&self) -> io::Result<(Duration, u32, u64)> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        Ok((
+            Duration::from_millis(
+                self.deadline_unix_millis
+                    .saturating_sub(unix_millis().unwrap_or(u128::MAX))
+                    .min(u128::from(u64::MAX)) as u64,
+            ),
+            self.limits.requests - state.requests,
+            self.limits.exposure_microusd.saturating_sub(state.exposure),
+        ))
+    }
+
+    pub fn attempts(&self) -> io::Result<Vec<Attempt>> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        Ok(state.attempts.values().cloned().collect())
+    }
+
+    pub fn cost_capture(&self) -> io::Result<TaskCostCapture> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| denied("task lock poisoned"))?;
+        let attempts = state.attempts.values().cloned().collect::<Vec<_>>();
+        let settled_task_charge_microusd = attempts
+            .iter()
+            .filter(|attempt| !attempt.external_subscription)
+            .filter_map(|attempt| attempt.settled_microusd)
+            .sum();
+        let subscription_list_equivalent_microusd = attempts
+            .iter()
+            .filter(|attempt| attempt.external_subscription)
+            .filter_map(|attempt| attempt.settled_microusd)
+            .sum();
+        let retained_exposure_upper_bound_microusd = attempts
+            .iter()
+            .map(|attempt| {
+                attempt
+                    .settled_microusd
+                    .unwrap_or(attempt.reserved_microusd)
+            })
+            .sum();
+        let raw_usage_attempts = attempts
+            .iter()
+            .filter(|attempt| attempt.raw_usage.is_some())
+            .count()
+            .try_into()
+            .map_err(|_| denied("raw usage attempt count overflow"))?;
+        let uncertain_requests = attempts
+            .iter()
+            .filter(|attempt| matches!(attempt.status.as_str(), "unknown" | "in_flight"))
+            .map(|attempt| attempt.request)
+            .collect();
+        Ok(TaskCostCapture {
+            schema: 1,
+            attempts,
+            observed: state.observed.clone(),
+            settled_task_charge_microusd,
+            subscription_list_equivalent_microusd,
+            retained_exposure_upper_bound_microusd,
+            raw_usage_attempts,
+            uncertain_requests,
+        })
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-contract.rs b/codex-rs/omd/src/bin/omd-contract.rs
new file mode 100644
index 000000000..0ec327579
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-contract.rs
@@ -0,0 +1,211 @@
+use codex_omd::ContractDocument;
+use codex_omd::ContractResolution;
+use codex_omd::ContractSelection;
+use codex_omd::ModHost;
+use codex_omd::PolicyOwner;
+use serde_json::Value;
+use serde_json::json;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+fn usage() -> io::Error {
+    io::Error::other(
+        "usage: omd-contract list STORE | status STORE REPOSITORY | plan STORE REPOSITORY ID@VERSION | select STORE REPOSITORY ID@VERSION [CONFIRMATION] | require STORE REPOSITORY ID@VERSION | clear STORE REPOSITORY user|project",
+    )
+}
+
+fn documents(store: &Path) -> io::Result<Vec<(ContractDocument, PolicyOwner)>> {
+    let root = store.canonicalize()?;
+    Ok(ModHost::open(root)?.contract_documents())
+}
+
+fn user_path(store: &Path) -> io::Result<PathBuf> {
+    let config = store.join("host.json");
+    let configured = match std::fs::read(&config) {
+        Ok(bytes) => serde_json::from_slice::<Value>(&bytes)?["contract"]["user"]
+            .as_str()
+            .map(PathBuf::from),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error),
+    };
+    Ok(configured.unwrap_or_else(|| store.join(codex_omd::USER_CONTRACT_SELECTION)))
+}
+
+fn project_path(repository: &Path) -> PathBuf {
+    repository.join(codex_omd::PROJECT_CONTRACT_SELECTION)
+}
+
+fn read(path: &Path) -> io::Result<Option<ContractSelection>> {
+    ContractSelection::read(path).map_err(io::Error::other)
+}
+
+fn summary(document: &ContractDocument, owner: &PolicyOwner) -> Value {
+    json!({"key": document.key(), "description": document.description, "assurance": document.assurance,
+        "gates": document.gates, "restrict": document.restrict, "digest": document.digest(), "owner": owner})
+}
+
+fn effective(
+    documents: &[(ContractDocument, PolicyOwner)],
+    store: &Path,
+    repository: &Path,
+) -> io::Result<ContractResolution> {
+    let user = read(&user_path(store)?)?;
+    let project = read(&project_path(repository))?;
+    Ok(codex_omd::resolve_contract(
+        documents,
+        user.as_ref(),
+        project.as_ref(),
+    ))
+}
+
+fn describe(resolution: &ContractResolution) -> Value {
+    match resolution {
+        ContractResolution::None => {
+            json!({"status": "none", "note": "no contract is selected; completion and integration are not gated"})
+        }
+        ContractResolution::Active {
+            document,
+            owner,
+            source,
+            overrode,
+        } => json!({"status": "active", "contract": summary(document, owner), "source": source,
+            "overrode": overrode}),
+        ContractResolution::Unavailable(error) => json!({"status": "unavailable", "error": error,
+            "note": "completion and integration fail closed until the selection is fixed"}),
+    }
+}
+
+fn find(
+    documents: &[(ContractDocument, PolicyOwner)],
+    key: &str,
+) -> io::Result<(ContractDocument, PolicyOwner)> {
+    documents
+        .iter()
+        .find(|(document, _)| document.key() == key)
+        .cloned()
+        .ok_or_else(|| io::Error::other(format!("no active mod registers contract {key}")))
+}
+
+fn current(resolution: &ContractResolution) -> Option<&ContractDocument> {
+    match resolution {
+        ContractResolution::Active { document, .. } => Some(document),
+        _ => None,
+    }
+}
+
+fn plan(store: &Path, repository: &Path, key: &str) -> io::Result<Value> {
+    let documents = documents(store)?;
+    let (next, owner) = find(&documents, key)?;
+    let resolution = effective(&documents, store, repository)?;
+    let before = current(&resolution);
+    let weakens = before.is_some_and(|before| next.weaker_than(before));
+    Ok(
+        json!({"schema": 2, "before": describe(&resolution), "after": summary(&next, &owner),
+        "weakens": weakens,
+        "confirmation": weakens.then(|| codex_omd::contract_confirmation(before, &next)),
+        "note": if weakens {
+            "this selection reduces assurance; pass the confirmation to omd-contract select"
+        } else {
+            "this selection does not reduce assurance"
+        }}),
+    )
+}
+
+fn run(args: &[String]) -> io::Result<Value> {
+    match args {
+        [command, store] if command == "list" => {
+            let documents = documents(Path::new(store))?;
+            Ok(json!({"schema": 2, "contracts": documents
+                .iter()
+                .map(|(document, owner)| summary(document, owner))
+                .collect::<Vec<_>>()}))
+        }
+        [command, store, repository] if command == "status" => {
+            let (store, repository) = (Path::new(store), Path::new(repository));
+            let documents = documents(store)?;
+            let mut value = describe(&effective(&documents, store, repository)?);
+            value["schema"] = json!(2);
+            value["user_selection"] = json!(user_path(store)?);
+            value["project_selection"] = json!(project_path(repository));
+            Ok(value)
+        }
+        [command, store, repository, key] if command == "plan" => {
+            plan(Path::new(store), Path::new(repository), key)
+        }
+        [command, store, repository, key] | [command, store, repository, key, _]
+            if command == "select" =>
+        {
+            let confirmation = args.get(4).cloned();
+            let (store, repository) = (Path::new(store), Path::new(repository));
+            let documents = documents(store)?;
+            let (next, owner) = find(&documents, key)?;
+            let resolution = effective(&documents, store, repository)?;
+            let before = current(&resolution);
+            if before.is_some_and(|before| next.weaker_than(before))
+                && confirmation.as_deref()
+                    != Some(codex_omd::contract_confirmation(before, &next).as_str())
+            {
+                return Err(io::Error::other(
+                    "this selection reduces assurance; run omd-contract plan and pass its confirmation",
+                ));
+            }
+            let path = user_path(store)?;
+            ContractSelection {
+                schema: 2,
+                contract: Some(next.key()),
+                contract_digest: Some(next.digest()),
+                confirmation,
+                ..ContractSelection::default()
+            }
+            .write(&path)?;
+            Ok(
+                json!({"schema": 2, "selected": summary(&next, &owner), "path": path,
+                "note": "the selection applies to the next session"}),
+            )
+        }
+        [command, store, repository, key] if command == "require" => {
+            let documents = documents(Path::new(store))?;
+            let (floor, owner) = find(&documents, key)?;
+            let path = project_path(Path::new(repository));
+            let mut selection = read(&path)?.unwrap_or(ContractSelection {
+                schema: 2,
+                ..ContractSelection::default()
+            });
+            selection.floor = Some(floor.key());
+            selection.floor_digest = Some(floor.digest());
+            selection.write(&path)?;
+            Ok(
+                json!({"schema": 2, "floor": summary(&floor, &owner), "path": path,
+                "note": "weaker selections now resolve to this floor"}),
+            )
+        }
+        [command, store, repository, scope] if command == "clear" => {
+            let path = match scope.as_str() {
+                "user" => user_path(Path::new(store))?,
+                "project" => project_path(Path::new(repository)),
+                _ => return Err(usage()),
+            };
+            match std::fs::remove_file(&path) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+            Ok(json!({"schema": 2, "cleared": path}))
+        }
+        _ => Err(usage()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => println!(
+            "{}",
+            serde_json::to_string_pretty(&value).unwrap_or_default()
+        ),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd-mod.rs b/codex-rs/omd/src/bin/omd-mod.rs
new file mode 100644
index 000000000..48a0e06ba
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd-mod.rs
@@ -0,0 +1,317 @@
+use codex_omd::ModHost;
+use codex_omd::ModInstallRequest;
+use codex_omd::ModStore;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn plugin_files(root: &std::path::Path) -> io::Result<BTreeMap<String, String>> {
+    let mut files = BTreeMap::new();
+    let mut pending = vec![root.to_path_buf()];
+    let mut total = 0_u64;
+    while let Some(directory) = pending.pop() {
+        for entry in fs::read_dir(&directory)? {
+            let entry = entry?;
+            let kind = entry.file_type()?;
+            if kind.is_symlink() {
+                return Err(io::Error::other("plugin_preview_symlink_refused"));
+            }
+            if kind.is_dir() {
+                pending.push(entry.path());
+                continue;
+            }
+            if !kind.is_file() || files.len() >= 512 {
+                return Err(io::Error::other("plugin_preview_file_limit"));
+            }
+            let entry_path = entry.path();
+            let bytes = fs::read(&entry_path)?;
+            total += bytes.len() as u64;
+            if total > 16_777_216 {
+                return Err(io::Error::other("plugin_preview_size_limit"));
+            }
+            let path = entry_path.strip_prefix(root).map_err(io::Error::other)?;
+            files.insert(
+                path.to_string_lossy().into_owned(),
+                format!("{:x}", Sha256::digest(bytes)),
+            );
+        }
+    }
+    Ok(files)
+}
+
+fn plugin_preview(codex: &str, home: &str, id: &str, candidate: &str) -> io::Result<Value> {
+    let (name, marketplace) = id
+        .split_once('@')
+        .ok_or_else(|| io::Error::other("plugin_id_requires_name_at_marketplace"))?;
+    if [name, marketplace].iter().any(|part| {
+        part.is_empty()
+            || !part
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+    }) {
+        return Err(io::Error::other("invalid_plugin_id"));
+    }
+    let home = PathBuf::from(home).canonicalize()?;
+    let candidate = PathBuf::from(candidate).canonicalize()?;
+    let output = Command::new(codex)
+        .env("CODEX_HOME", &home)
+        .args(["plugin", "list", "--json", "--marketplace", marketplace])
+        .output()?;
+    if !output.status.success() {
+        return Err(io::Error::other(
+            String::from_utf8_lossy(&output.stderr).into_owned(),
+        ));
+    }
+    let listing: Value = serde_json::from_slice(&output.stdout)?;
+    let installed = listing["installed"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .find(|entry| entry["pluginId"] == id)
+        .ok_or_else(|| io::Error::other("plugin_not_installed"))?;
+    if installed["source"]["source"] != "local" {
+        return Err(io::Error::other("plugin_preview_requires_local_source"));
+    }
+    let version = installed["version"]
+        .as_str()
+        .ok_or_else(|| io::Error::other("installed_plugin_version_missing"))?;
+    if !version
+        .bytes()
+        .all(|byte| byte.is_ascii_alphanumeric() || byte == b'.' || byte == b'-' || byte == b'_')
+    {
+        return Err(io::Error::other("invalid_installed_plugin_version"));
+    }
+    let installed_path = home
+        .join("plugins/cache")
+        .join(marketplace)
+        .join(name)
+        .join(version);
+    let manifest: Value =
+        serde_json::from_slice(&fs::read(candidate.join(".codex-plugin/plugin.json"))?)?;
+    if manifest["name"] != name || !manifest["version"].is_string() {
+        return Err(io::Error::other("candidate_plugin_manifest_mismatch"));
+    }
+    let current = plugin_files(&installed_path)?;
+    let proposed = plugin_files(&candidate)?;
+    let paths = current
+        .keys()
+        .chain(proposed.keys())
+        .collect::<std::collections::BTreeSet<_>>();
+    let changes = paths
+        .into_iter()
+        .filter_map(|path| {
+            let before = current.get(path);
+            let after = proposed.get(path);
+            (before != after).then(
+                || serde_json::json!({"path":path,"before_sha256":before,"after_sha256":after}),
+            )
+        })
+        .collect::<Vec<_>>();
+    Ok(serde_json::json!({
+        "plugin": id,
+        "installed_version": version,
+        "candidate_version": manifest["version"],
+        "installed_enabled": installed["enabled"],
+        "installed_path": installed_path,
+        "candidate_path": candidate,
+        "changes": changes,
+        "same_version_changed": manifest["version"] == version && current != proposed,
+        "applied": false,
+        "note": "This is a read-only local file preview. Codex still owns plugin installation and hook trust."
+    }))
+}
+
+fn run(args: &[String]) -> io::Result<Value> {
+    let bad = || {
+        io::Error::other(
+            "usage: omd-mod init STORE NODE | plugin-component PLUGIN_ROOT | inspect PACKAGE | trust STORE PACKAGE SHA256 CAPABILITIES_CSV [user|project] | enable/disable STORE PACKAGE | package-plan STORE REQUEST_JSON | package-apply STORE REQUEST_JSON CONFIRMATION | package-lock STORE | package-enable/package-disable STORE ID | package-rollback-plan/package-uninstall-plan STORE ID | package-rollback/package-uninstall STORE ID CONFIRMATION | plugin-preview CODEX_BIN CODEX_HOME NAME@MARKETPLACE CANDIDATE | status/selection-status/reload/report/events/declarations STORE | test STORE SCENARIO_JSON | diagnostics STORE OUTPUT_JSON | explain DENIAL | discover USER_DIR PROJECT_DIR | settings STORE PACKAGE JSON | migrate STORE PACKAGE | rollback STORE PACKAGE BACKUP | command STORE MOD NAME JSON",
+        )
+    };
+    match args {
+        [command, root] if command == "plugin-component" => {
+            codex_omd::plugin_component::inspect(&PathBuf::from(root).canonicalize()?)
+        }
+        [command, codex, home, id, candidate] if command == "plugin-preview" => {
+            plugin_preview(codex, home, id, candidate)
+        }
+        [command, root, request] if command == "package-plan" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_plan(serde_json::from_str::<ModInstallRequest>(request)?)
+                .and_then(|plan| serde_json::to_value(plan).map_err(io::Error::other))
+        }
+        [command, root, request, confirmation] if command == "package-apply" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_apply(
+                    serde_json::from_str::<ModInstallRequest>(request)?,
+                    confirmation,
+                )
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root] if command == "package-lock" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_lock()
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_disable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id] if command == "package-enable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .package_enable(id)
+                .and_then(|lock| serde_json::to_value(lock).map_err(io::Error::other))
+        }
+        [command, root, id]
+            if command == "package-rollback-plan" || command == "package-uninstall-plan" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let plan = if command == "package-rollback-plan" {
+                store.package_rollback_plan(id)?
+            } else {
+                store.package_uninstall_plan(id)?
+            };
+            serde_json::to_value(plan).map_err(io::Error::other)
+        }
+        [command, root, id, confirmation]
+            if command == "package-rollback" || command == "package-uninstall" =>
+        {
+            let store = ModStore::open(PathBuf::from(root).canonicalize()?)?;
+            let lock = if command == "package-rollback" {
+                store.package_rollback(id, confirmation)?
+            } else {
+                store.package_uninstall(id, confirmation)?
+            };
+            serde_json::to_value(lock).map_err(io::Error::other)
+        }
+        [command, user, project] if command == "discover" => {
+            ModStore::discover(&PathBuf::from(user), &PathBuf::from(project))
+        }
+        [command, root, path, settings] if command == "settings" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.settings(
+                &PathBuf::from(path).canonicalize()?,
+                serde_json::from_str(settings)?,
+            )?;
+            Ok(Value::String(
+                "settings saved for next turn boundary".into(),
+            ))
+        }
+        [command, root, path] if command == "migrate" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .migrate(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, backup] if command == "rollback" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .rollback(&PathBuf::from(path).canonicalize()?, &PathBuf::from(backup))
+        }
+        [command, root, node] if command == "init" => {
+            ModStore::create(PathBuf::from(root), PathBuf::from(node))?;
+            Ok(Value::String("created".into()))
+        }
+        [command, path] if command == "inspect" => {
+            ModStore::inspect_package(&PathBuf::from(path).canonicalize()?)
+        }
+        [command, root, path, sha, capabilities] | [command, root, path, sha, capabilities, _]
+            if command == "trust" =>
+        {
+            let scope = match args {
+                [.., scope] if args.len() == 6 => scope.as_str(),
+                _ => "user",
+            };
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.trust(
+                PathBuf::from(path).canonicalize()?,
+                sha,
+                capabilities
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(str::to_string)
+                    .collect(),
+                scope,
+            )?;
+            Ok(Value::String(format!(
+                "trusted in the {scope} scope; disabled until explicitly enabled"
+            )))
+        }
+        [command, root, path] if command == "enable" || command == "disable" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?
+                .enable(&PathBuf::from(path), command == "enable")?;
+            Ok(Value::String(
+                "selection saved; takes effect at the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "reload" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.reload()?;
+            Ok(Value::String(
+                "reload queued for the next turn boundary".into(),
+            ))
+        }
+        [command, root] if command == "status" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.status())
+        }
+        [command, root] if command == "selection-status" => {
+            ModStore::open(PathBuf::from(root).canonicalize()?)?.selection_status()
+        }
+        [command, root] if command == "report" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"mods":status["mods"].as_array()
+                .into_iter().flatten().map(|item| serde_json::json!({
+                    "id":item["id"],"declared":{"capabilities":item["capabilities"],
+                        "services":item["services"]},"used":item["source_use"],
+                    "unused_grants":item["unused_grants"],
+                    "unused_environment":item["unused_environment"],"error":item["error"]
+                })).collect::<Vec<_>>() }),
+            )
+        }
+        [command, root] if command == "events" => {
+            Ok(ModHost::open(PathBuf::from(root).canonicalize()?)?.author_inspection())
+        }
+        [command, root] if command == "declarations" => {
+            let status = ModHost::open(PathBuf::from(root).canonicalize()?)?.status();
+            Ok(
+                serde_json::json!({"api":status["api"],"active_host":status["active_host_types"],
+                "installed_contracts":status["installed_contract_types"]}),
+            )
+        }
+        [command, root, scenario] if command == "test" => {
+            let scenario: Value = serde_json::from_slice(&std::fs::read(scenario)?)?;
+            ModHost::open(PathBuf::from(root).canonicalize()?)?.offline_test(scenario)
+        }
+        [command, root, output] if command == "diagnostics" => {
+            let bundle = ModHost::open(PathBuf::from(root).canonicalize()?)?.diagnostic_bundle();
+            let output = PathBuf::from(output);
+            std::fs::write(&output, serde_json::to_vec_pretty(&bundle)?)?;
+            Ok(serde_json::json!({"bundle":output,"redacted":true}))
+        }
+        [command, denial] if command == "explain" => Ok(ModHost::capability_explanation(denial)),
+        [command, root, id, name, payload] if command == "command" => {
+            let mut host = ModHost::open(PathBuf::from(root).canonicalize()?)?;
+            host.invoke(
+                id,
+                host.generation(),
+                "command",
+                name,
+                serde_json::from_str(payload)?,
+            )
+        }
+        _ => Err(bad()),
+    }
+}
+
+fn main() {
+    match run(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(value) => println!(
+            "{}",
+            serde_json::to_string_pretty(&value).unwrap_or_default()
+        ),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/codex-rs/omd/src/bin/omd.rs b/codex-rs/omd/src/bin/omd.rs
new file mode 100644
index 000000000..1b7dad306
--- /dev/null
+++ b/codex-rs/omd/src/bin/omd.rs
@@ -0,0 +1,413 @@
+use codex_omd::{ModHost, scoped_data::ScopedDataHost};
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+fn configuration(path: &Path) -> io::Result<toml::Value> {
+    if !path.try_exists()? {
+        return Ok(toml::Value::Table(Default::default()));
+    }
+    let metadata = std::fs::metadata(path)?;
+    if !metadata.is_file() || metadata.len() > 262144 {
+        return Err(io::Error::other("session_configuration_limit"));
+    }
+    toml::from_str(&std::fs::read_to_string(path)?)
+        .map_err(|_| io::Error::other("session_configuration_invalid"))
+}
+
+fn database(
+    home: &Path,
+    repository: &Path,
+    explicit: Option<PathBuf>,
+    environment: Option<PathBuf>,
+) -> io::Result<PathBuf> {
+    let sqlite = if let Some(path) = explicit {
+        path
+    } else {
+        let custom = |value: &toml::Value| -> bool { value.to_string().contains("sqlite_home") };
+        if custom(&configuration(&repository.join(".codex/config.toml"))?)
+            || custom(&configuration(Path::new("/etc/codex/config.toml"))?)
+        {
+            return Err(io::Error::other(
+                "explicit_sqlite_home_required_for_layered_configuration",
+            ));
+        }
+        let config = configuration(&home.join("config.toml"))?;
+        let profile = config
+            .get("profile")
+            .and_then(toml::Value::as_str)
+            .and_then(|name| config.get("profiles")?.get(name));
+        let selected = profile
+            .and_then(|value| value.get("sqlite_home"))
+            .or_else(|| config.get("sqlite_home"));
+        match selected {
+            Some(value) => PathBuf::from(
+                value
+                    .as_str()
+                    .ok_or_else(|| io::Error::other("session_database_scope_invalid"))?,
+            ),
+            None => environment.unwrap_or_else(|| home.to_path_buf()),
+        }
+    };
+    if !sqlite.is_absolute() {
+        return Err(io::Error::other("absolute_sqlite_home_required"));
+    }
+    Ok(sqlite.join("state_5.sqlite"))
+}
+
+fn store(args: &[String]) -> io::Result<Value> {
+    let usage = || {
+        io::Error::other(
+            "usage: omd store export|reset --mod ID [--repo PATH] [--store PATH] [--scope repository|user]",
+        )
+    };
+    let (action, rest) = args.split_first().ok_or_else(usage)?;
+    if action != "export" && action != "reset" {
+        return Err(usage());
+    }
+    let mut id = None;
+    let mut repository = None;
+    let mut root = std::env::var_os(codex_omd::MOD_STORE_ENV).map(PathBuf::from);
+    let mut scope = "repository".to_owned();
+    let mut remaining = rest.iter();
+    while let Some(argument) = remaining.next() {
+        let value = remaining.next().ok_or_else(usage)?;
+        match argument.as_str() {
+            "--mod" => id = Some(value.clone()),
+            "--repo" => repository = Some(PathBuf::from(value).canonicalize()?),
+            "--store" => root = Some(PathBuf::from(value)),
+            "--scope" => scope = value.clone(),
+            _ => return Err(usage()),
+        }
+    }
+    let id = id.ok_or_else(usage)?;
+    let root = root
+        .ok_or_else(|| io::Error::other("explicit_mod_store_required"))?
+        .canonicalize()?;
+    let key = match (&repository, scope.as_str()) {
+        (Some(repository), "repository") => codex_omd::host::repository_key(repository),
+        (None, "repository") => return Err(io::Error::other("explicit_repository_required")),
+        _ => String::new(),
+    };
+    let data = codex_omd::data_store::DataStore {
+        root: &root,
+        repository_key: &key,
+        owner: &id,
+        provenance: codex_omd::data_store::StoreProvenance {
+            r#mod: id.clone(),
+            source_sha256: String::new(),
+            thread_id: None,
+            origin: codex_omd::data_store::Origin::Cli,
+            at: 0,
+        },
+    };
+    let mut exported = data.call("store.export", json!({"scope": scope}))?;
+    while !exported["cursor"].is_null() {
+        let page = data.call(
+            "store.export",
+            json!({"scope": scope, "cursor": exported["cursor"]}),
+        )?;
+        if let (Some(entries), Some(more)) = (
+            exported["entries"].as_object_mut(),
+            page["entries"].as_object(),
+        ) {
+            entries.extend(more.clone());
+        }
+        exported["cursor"] = page["cursor"].clone();
+    }
+    if let Some(exported) = exported.as_object_mut() {
+        exported.remove("cursor");
+    }
+    if action == "export" {
+        return Ok(exported);
+    }
+    data.call(
+        "store.reset",
+        json!({"scope": scope, "expected_generation": exported["generation"]}),
+    )
+}
+
+fn run(args: Vec<String>) -> io::Result<Value> {
+    if args.is_empty() || args[0] == "--help" {
+        return Ok(
+            json!({"usage":"omd COMMAND --repo PATH [--store PATH] [--home PATH] [--sqlite-home PATH] [ARGS] | omd store export|reset --mod ID [--repo PATH] [--store PATH] [--scope repository|user]","commands":"Only explicitly enabled extensions with a CLI export may run. Model requests and process execution are unavailable here. `omd store` exports or resets one mod's namespaced store without running mod code."}),
+        );
+    }
+    if args[0] == "store" {
+        return store(&args[1..]);
+    }
+    if args.len() > 128 || args.iter().map(String::len).sum::<usize>() > 8192 {
+        return Err(io::Error::other("command_argument_limit"));
+    }
+    let command = &args[0];
+    let mut repository = None;
+    let mut store = std::env::var_os(codex_omd::MOD_STORE_ENV).map(PathBuf::from);
+    let mut home = std::env::var_os("CODEX_HOME").map(PathBuf::from);
+    let mut sqlite = None;
+    let mut payload = Vec::new();
+    let mut remaining = args[1..].iter();
+    while let Some(argument) = remaining.next() {
+        match argument.as_str() {
+            "--repo" => {
+                if repository.is_some() {
+                    return Err(io::Error::other("duplicate_repository"));
+                }
+                repository = Some(
+                    PathBuf::from(
+                        remaining
+                            .next()
+                            .ok_or_else(|| io::Error::other("repository_required"))?,
+                    )
+                    .canonicalize()?,
+                );
+            }
+            "--store" => {
+                store = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("store_required"))?,
+                ));
+            }
+            "--home" => {
+                home = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("home_required"))?,
+                ));
+            }
+            "--sqlite-home" => {
+                if sqlite.is_some() {
+                    return Err(io::Error::other("duplicate_sqlite_home"));
+                }
+                sqlite = Some(PathBuf::from(
+                    remaining
+                        .next()
+                        .ok_or_else(|| io::Error::other("sqlite_home_required"))?,
+                ));
+            }
+            _ => payload.push(argument.clone()),
+        }
+    }
+    let repository = repository.ok_or_else(|| io::Error::other("explicit_repository_required"))?;
+    let root = store
+        .ok_or_else(|| io::Error::other("explicit_mod_store_required"))?
+        .canonicalize()?;
+    let home =
+        home.or_else(|| std::env::var_os("HOME").map(|path| PathBuf::from(path).join(".codex")));
+    let sessions = home.as_ref().map(|path| path.join("sessions"));
+    let mut runtime = ModHost::open(root.clone())?;
+    let exports: Vec<_> = runtime
+        .commands()
+        .into_iter()
+        .filter(|(_, export)| export.cli.as_deref() == Some(command))
+        .collect();
+    if exports.len() != 1 {
+        return Err(io::Error::other(if exports.is_empty() {
+            "plugin_command_unavailable"
+        } else {
+            "plugin_command_collision"
+        }));
+    }
+    let (owner, export) = &exports[0];
+    let sources: BTreeMap<String, String> = runtime
+        .owners()
+        .into_iter()
+        .map(|(id, owner)| (id, owner.sha256))
+        .collect();
+    let mut providers = BTreeMap::<String, ScopedDataHost>::new();
+    let mut data = ScopedDataHost::new(
+        root.clone(),
+        repository.clone(),
+        sessions.clone(),
+        None,
+        owner.clone(),
+        "user-command".into(),
+        sources
+            .get(owner)
+            .cloned()
+            .ok_or_else(|| io::Error::other("command_owner_missing"))?,
+    )?;
+    let deadline = Instant::now() + Duration::from_secs(30);
+    runtime.invoke_scoped_with(
+        owner,
+        runtime.generation(),
+        "command",
+        &export.name,
+        json!(payload),
+        || Instant::now() < deadline,
+        |caller, request| {
+            if !codex_omd::scoped_data::operation(&request.operation) {
+                return Err(io::Error::other("standalone_host_operation_unavailable"));
+            }
+            let needs_sessions = request.operation.starts_with("sessions.");
+            let session_database = if needs_sessions {
+                Some(database(
+                    home.as_deref()
+                        .ok_or_else(|| io::Error::other("session_home_required"))?,
+                    &repository,
+                    sqlite.clone(),
+                    std::env::var_os("CODEX_SQLITE_HOME").map(PathBuf::from),
+                )?)
+            } else {
+                None
+            };
+            if caller == owner {
+                if needs_sessions {
+                    data.session_database = session_database;
+                }
+                return data.call(&request.operation, request.arguments, || {
+                    Instant::now() < deadline
+                });
+            }
+            let source = sources
+                .get(caller)
+                .ok_or_else(|| io::Error::other("service_provider_missing"))?;
+            let provider = match providers.entry(caller.to_owned()) {
+                std::collections::btree_map::Entry::Occupied(entry) => entry.into_mut(),
+                std::collections::btree_map::Entry::Vacant(entry) => {
+                    entry.insert(ScopedDataHost::new(
+                        root.clone(),
+                        repository.clone(),
+                        sessions.clone(),
+                        session_database.clone(),
+                        caller.to_owned(),
+                        "user-command".into(),
+                        source.clone(),
+                    )?)
+                }
+            };
+            if provider.binding.source_sha256 != *source {
+                return Err(io::Error::other("data_selection_changed_or_revoked"));
+            }
+            if needs_sessions {
+                provider.session_database = session_database;
+            }
+            provider.call(&request.operation, request.arguments, || {
+                Instant::now() < deadline
+            })
+        },
+    )
+}
+
+fn main() {
+    match run(std::env::args().skip(1).collect()) {
+        Ok(value) => {
+            if let Some(display) = value.get("display").and_then(Value::as_str) {
+                println!(
+                    "{}",
+                    display
+                        .chars()
+                        .filter(
+                            |character| !character.is_control() || matches!(character, '\n' | '\t')
+                        )
+                        .collect::<String>()
+                );
+            } else {
+                println!(
+                    "{}",
+                    serde_json::to_string_pretty(&value).unwrap_or_default()
+                );
+            }
+        }
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
