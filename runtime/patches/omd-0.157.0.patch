+        Some(ViewAction::Changed) => "changed".to_string(),
+        Some(ViewAction::Copy(text)) => format!("copy {text}"),
+        Some(ViewAction::CopyAndFollow(text)) => format!("copy and follow {text}"),
+        Some(ViewAction::OpenLink(link)) => format!("open {link}"),
+        None => "none".to_string(),
+    }
+}
+
+fn gesture(
+    view: &mut TranscriptView,
+    cells: &[Arc<dyn HistoryCell>],
+    copy_on_release: bool,
+    events: &[(MouseEventKind, u16)],
+) -> Vec<String> {
+    events
+        .iter()
+        .map(|(kind, column)| {
+            view.handle_mouse_copying_highlight(
+                MouseEvent {
+                    kind: *kind,
+                    column: *column,
+                    row: 0,
+                    modifiers: KeyModifiers::NONE,
+                },
+                cells,
+                copy_on_release.then_some(codex_omd::ModSelectionSource::Transcript),
+            )
+        })
+        .map(label)
+        .collect()
+}
+
+#[test]
+#[serial_test::serial]
+fn released_drag_requests_one_native_copy_only_when_enabled() {
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot {
+        view: codex_omd::ModView::parse(serde_json::json!({"selection":{}})).unwrap(),
+        ..codex_omd::ModViewSnapshot::default()
+    });
+    let cells = vec![cell("highlight me please")];
+    let drag = [
+        (MouseEventKind::Down(MouseButton::Left), 0),
+        (MouseEventKind::Drag(MouseButton::Left), 9),
+        (MouseEventKind::Up(MouseButton::Left), 9),
+    ];
+    for (copy_on_release, expected) in [(true, "copy highlight"), (false, "changed")] {
+        let mut view = TranscriptView::default();
+        render(&mut view, &cells, /*width*/ 40, /*height*/ 3);
+        let actions = gesture(&mut view, &cells, copy_on_release, &drag);
+        let copies = actions
+            .iter()
+            .filter(|action| action.starts_with("copy"))
+            .count();
+        assert_eq!(
+            (actions.last().map(String::as_str), copies),
+            (Some(expected), usize::from(copy_on_release))
+        );
+        assert_eq!(view.selected_text(&cells).as_deref(), Some("highlight"));
+    }
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+}
+
+#[test]
+fn clicks_and_empty_drags_never_copy() {
+    let cells = vec![cell("highlight me please")];
+    for events in [
+        vec![
+            (MouseEventKind::Down(MouseButton::Left), 2),
+            (MouseEventKind::Up(MouseButton::Left), 2),
+        ],
+        vec![
+            (MouseEventKind::Down(MouseButton::Left), 2),
+            (MouseEventKind::Drag(MouseButton::Left), 5),
+            (MouseEventKind::Drag(MouseButton::Left), 2),
+            (MouseEventKind::Up(MouseButton::Left), 2),
+        ],
+    ] {
+        let mut view = TranscriptView::default();
+        render(&mut view, &cells, /*width*/ 40, /*height*/ 3);
+        let actions = gesture(&mut view, &cells, /*copy_on_release*/ true, &events);
+        assert!(!actions.iter().any(|action| action.starts_with("copy")));
+    }
+}
