+    std::fs::write(
+        &index,
+        serde_json::to_vec_pretty(&json!({"schema":1,"packages":{"dependency":[{
+            "version":"1.2.0","source":{"kind":"local","path":dependency},"integrity":dependency_integrity
+        }]}}))
