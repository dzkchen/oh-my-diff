+
+#[tokio::test]
+async fn fullscreen_mouse_reaches_upstream_selection_and_highlight_copy_keeps_literal_text()
+-> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(/*owned*/ true)?;
+    let size = tui.terminal.size()?;
+    app.transcript_cells = vec![user_cell("transcript text")];
+    app.chat_widget.apply_external_edit("a === b".into());
+    app.render_owned_transcript(&mut tui, size)?;
+    let end = tui.terminal.last_known_cursor_pos;
+    let (x, y) = (end.x - 7, end.y);
+    for event in [
+        mouse(Down(Left), x + 2, y),
+        mouse(Drag(Left), x + 5, y),
+        mouse(Up(Left), x + 5, y),
+    ] {
+        app.handle_tui_event(&mut tui, &mut server, event).await?;
+    }
+    let mut copied = Vec::new();
+    for _ in 0..2 {
+        let copy = app.chat_widget.copy_composer_highlight(|text| {
+            copied.push(text.to_string());
+            Ok(crate::clipboard_copy::CopyStatus::Confirmed)
+        });
+        assert_eq!(
+            copy,
+            Some((3, Ok(crate::clipboard_copy::CopyStatus::Confirmed)))
+        );
+    }
+    assert_eq!(copied, ["===", "==="]);
+    for event in [mouse(Down(Left), x, y), mouse(Up(Left), x, y)] {
+        app.handle_tui_event(&mut tui, &mut server, event).await?;
+    }
+    assert_eq!(
+        app.chat_widget
+            .copy_composer_highlight(|_| unreachable!("a click is not a highlight")),
+        None
+    );
+    assert_eq!(app.chat_widget.composer_text_with_pending(), "a === b");
+    tui.set_owned_screen(/*owned*/ false)?;
+    server.shutdown().await?;
+    Ok(())
+}
+
+#[tokio::test]
+#[serial_test::serial]
+async fn owned_fullscreen_draws_mod_header_and_sidebar_beside_the_transcript() -> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.transcript_cells = vec![user_cell("First prompt")];
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(/*owned*/ true)?;
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot {
+        view: codex_omd::ModView::parse(serde_json::json!({
+            "sidebar_side":"left","sidebar_width":24,
+            "sites":{"sidebar":{"components":[{"type":"text","id":"side","label":"Side","text":"Git main"}]},
+                     "header":{"components":[{"type":"text","id":"head","label":"Head","text":"± omd header"}]}}
+        }))?,
+        ..Default::default()
+    });
+    let size = Size::new(/*width*/ 90, /*height*/ 20);
+    tui.screen_size_for_event(&TuiEvent::Resize(size))?;
+    let bottom = app.render_owned_transcript(&mut tui, size)?;
+    let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal).clone();
+    let row = |y: u16| {
+        (0..size.width)
+            .map(|x| buffer[(x, y)].symbol())
+            .collect::<String>()
+    };
+    crate::mod_ui::preview(codex_omd::ModViewSnapshot::default());
+    tui.set_owned_screen(/*owned*/ false)?;
+    assert_eq!((bottom.x, bottom.width), (24, 66));
+    assert!(row(0).contains("± omd header"), "{}", row(0));
+    assert!(
+        row(0).starts_with("Mods") || row(1).contains("Git main"),
+        "{}\n{}",
+        row(0),
+        row(1)
+    );
+    let prompt = (0..size.height)
+        .find(|y| row(*y).contains("First prompt"))
+        .expect("transcript row");
+    assert!(
+        row(prompt)
+            .find("First prompt")
+            .is_some_and(|column| column > 24)
+    );
+    Ok(())
+}
