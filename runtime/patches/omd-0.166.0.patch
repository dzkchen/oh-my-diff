+        dragged,
+        events(&[("chart", "leave 40 10"), ("chart", "drag 40 10")]),
+        "capture keeps drags with the pressed component outside its rect"
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Up(MouseButton::Left), x + 40, y + 10),
+        (true, events(&[("chart", "up 40 10")]))
+    );
+    assert_eq!(
+        pointer_events(MouseEventKind::Drag(MouseButton::Left), x + 1, y),
+        (false, events(&[("chart", "enter 1 0")])),
+        "released capture forwards no drags"
+    );
+    let click = |kind| MouseEvent {
+        kind,
+        column: x + 1,
+        row: y,
+        modifiers: KeyModifiers::NONE,
+    };
+    INTERACTION
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .focused = Some("intro".to_owned());
+    assert!(matches!(
+        pointer(click(MouseEventKind::Down(MouseButton::Left))),
+        Some(ModPointer::Consumed)
+    ));
+    assert_eq!(
+        INTERACTION
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .focused,
+        None,
+        "pressing a pointer region takes focus from earlier controls"
+    );
+    pointer(click(MouseEventKind::Up(MouseButton::Left)));
+
+    let plain = snapshot(
+        serde_json::json!({"sidebar_width": 30, "sites": {"sidebar": {"components": [
+        {"type":"raster","id":"chart","label":"Chart","alt":"cpu chart","width":6,"height":3}]}}}),
+    );
