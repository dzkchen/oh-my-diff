+/// Rewrites another provider's opaque compaction checkpoint as a plaintext summary from that provider.
+async fn carry_compaction_across_providers(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    previous_model: String,
+    previous_provider: Option<String>,
+    previous_cyber_access_program: Option<codex_protocol::turn_input::CyberAccessProgram>,
+    cancellation_token: &CancellationToken,
