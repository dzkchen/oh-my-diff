+        )
+        .await
+        .unwrap();
+        assert!(
+            result
+                .as_str()
+                .unwrap()
+                .contains(&session.thread_id.to_string())
+        );
+        assert!(result.as_str().unwrap().contains(&turn.sub_id));
+        assert!(result.as_str().unwrap().contains("kernel-cell"));
+    }
+
+    #[tokio::test]
+    async fn disabled_kernel_does_not_start_a_worker() {
+        let (session, turn) = make_session_and_context().await;
+        let session = Arc::new(session);
