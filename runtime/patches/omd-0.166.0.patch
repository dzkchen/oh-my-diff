+struct Plan {
+    rollout_id: ThreadId,
+    previous_revision: String,
+    new_rollout_id: ThreadId,
+    source_meta: codex_rollout::SessionMeta,
+    sources: Vec<Segment>,
+    entries: Vec<Entry>,
