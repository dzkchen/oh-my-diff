+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[serial_test::serial]
+async fn app_requests_are_served_while_the_event_loop_awaits_a_lifecycle_request() {
+    struct Restore(Option<State>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            *STATE.locked() = self.0.take();
+        }
+    }
+    let _restore = Restore(STATE.locked().take());
+    let (chat_widget, _, _, _) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+    let mut config = chat_widget.config_ref().clone();
+    let codex_home = tempfile::tempdir().unwrap();
+    config.codex_home = codex_home.path().to_path_buf().abs();
+    config.sqlite =
+        codex_state::SqliteConfig::new_for_testing(codex_home.path().to_path_buf().abs());
+    let app_server = crate::start_embedded_app_server_for_picker(&config)
+        .await
+        .unwrap();
+    let store = codex_home.path().canonicalize().unwrap().join("store");
+    codex_omd::ModStore::create(store.clone()).unwrap();
+    let _environment = crate::omd::tests::omd_environment(&store);
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    attach(&AppEventSender::new(tx), Some("surface-a".to_owned()));
+    let submit = || {
+        codex_omd::client_surface::submit(
+            codex_omd::broker::HOST_CALLER,
+            "app.request",
+            json!({"method": "config/read", "params": {}}),
+            InvocationContext::User,
+            false,
+            Some("surface-a"),
+            None,
+        )
+        .unwrap()
+    };
+    let parked = ParkedLoop::new(app_server.request_handle());
+    let pending = submit();
+    let reply = tokio::task::spawn_blocking(move || {
+        pending.recv_timeout(std::time::Duration::from_secs(10))
+    })
+    .await
+    .unwrap();
+    assert!(reply.unwrap().unwrap()["config"].is_object());
+    assert!(rx.try_recv().is_err());
+    drop(parked);
+    let _queued = submit();
+    assert!(matches!(rx.try_recv(), Ok(AppEvent::ModSurfaceCall(..))));
+}
