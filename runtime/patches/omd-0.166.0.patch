+#[test]
+fn frozen_revision_rejects_append_and_ignores_partial_record() {
+    let (_temp, repo, sessions) = fixture();
+    let path = sessions.join("a.jsonl");
+    record(&path, &repo, "session-a", "enabled");
+    let index = SessionIndex {
+        database: None,
+        root: &sessions,
+        repository: &repo,
+        enabled: true,
+        tools: true,
+    };
