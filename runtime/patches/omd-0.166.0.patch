+        "export default api => api.on('component_event', e => { api.state.set([...(api.state.get() ?? []), { kind: e.kind, component: e.component, content: e.content, target: e.target, edge: e.edge, columns: e.columns, rows: e.rows }]); });",
+    )
+    .unwrap();
+    let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+    store
+        .trust(
+            package.clone(),
+            inspected["sha256"].as_str().unwrap(),
+            vec!["terminal".into(), "store".into()],
+            "user",
+        )
+        .unwrap();
+    store.enable(&package, true).unwrap();
+    std::fs::write(
+        data.join("mod-status.json"),
+        serde_json::to_vec(&codex_omd::ModHost::open(data.clone()).unwrap().status()).unwrap(),
+    )
+    .unwrap();
+    let _environment = crate::omd::tests::omd_environment(&data);
+    let _host = crate::mod_runtime::test_fresh_host();
+    crate::mod_surface::test_forget_subscribers();
+
+    place(&dock_layout(), Some("owner"), Rect::new(0, 0, 100, 40));
+    let source = (10, 0);
+    assert!(!pointer(mouse(
+        MouseEventKind::Down(MouseButton::Left),
+        source
+    )));
+    assert!(pointer(mouse(
+        MouseEventKind::Drag(MouseButton::Left),
+        (1, 30)
+    )));
+    assert!(cancel_dock());
+    assert!(pointer(mouse(
+        MouseEventKind::Up(MouseButton::Left),
+        (1, 30)
+    )));
+    dock_drag(source, (75, 38));
+    hide();
+
+    let expected = serde_json::json!([
+        {"kind": "dock", "component": "r.0.0", "content": "site:a/one", "target": "r.1", "edge": "bottom", "columns": 100, "rows": 40}
+    ]);
+    let state = || {
+        crate::mod_runtime::shared_host()
+            .unwrap()
+            .lock()
+            .unwrap()
+            .state("owner")
+            .cloned()
+            .unwrap_or_default()
+    };
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+    while state().as_array().map_or(0, Vec::len) < 1 && std::time::Instant::now() < deadline {
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    assert_eq!(state(), expected);
+}
+
+#[test]
