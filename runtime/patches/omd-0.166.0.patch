+        serde_json::json!({"type":"event_msg","payload":{"type":"mcp_tool_call_end","call_id":"c3","invocation":{"server":"s","tool":"t","arguments":{"q":"secret-sentinel"}},"duration":{"secs":0,"nanos":0},"result":{"Ok":{"content":[{"type":"text","text":"secret-sentinel"}],"structuredContent":{"k":"secret-sentinel"}}}}}),
