+/// `terminal.blit`: queues a partial update of the caller's own raster under the frame budget.
+pub(crate) fn blit(
+    caller: &str,
+    owner: Option<String>,
+    size: Option<(u16, u16)>,
+    arguments: &Value,
+    now: Instant,
+    snapshot: impl FnOnce(
+        &codex_omd::process_raster::PixelSource,
+        Instant,
+    ) -> Result<
+        std::sync::Arc<codex_omd::process_raster::PixelFrame>,
+        codex_omd::client_surface::BlitError,
+    >,
+) -> Result<Value, codex_omd::client_surface::BlitError> {
+    let mut update =
+        codex_omd::client_surface::blit_request(caller, owner.as_deref(), size, arguments)?;
+    if let BlitContent::Cells { cells, .. } = &update.content
+        && !cells
+            .iter()
+            .all(|cell| cell.symbol.graphemes(true).count() == 1 && cell.symbol.width() == 1)
+    {
+        return Err("terminal_blit_invalid".into());
+    }
+    let (width, height) = size
+        .filter(|(width, height)| *width > 0 && *height > 0)
+        .ok_or_else(|| codex_omd::client_surface::BlitError::retryable("terminal_blit_unknown"))?;
+    let key = std::mem::take(&mut update.key);
+    let binding = codex_omd::process_raster::serial(
+        crate::mod_surface::current_thread().as_deref(),
+        caller,
+        &key,
+    );
+    let limited = |rasters: &BTreeMap<String, Raster>| {
+        !rasters.contains_key(&key)
+            && rasters
+                .values()
+                .filter(|raster| raster.owner == caller)
+                .count()
+                >= RASTERS_PER_MOD
+    };
+    let reusable = |raster: &Raster| {
+        (raster.width, raster.height) == (width, height)
+            && raster.owner == caller
+            && raster.binding == binding
+    };
+    let mut next = now + FRAME;
+    if matches!(update.content, BlitContent::Source(_)) {
+        let mut rasters = rasters();
+        if limited(&rasters) {
+            return Err(codex_omd::client_surface::BlitError::retryable(
+                "terminal_blit_limit",
+            ));
+        }
+        if let Some(raster) = rasters.get_mut(&key).filter(|raster| reusable(raster)) {
+            if raster.hidden(now) {
+                return Ok(
+                    json!({"status": "backpressure", "retry_after_ms": HIDDEN_RETRY.as_millis() as u64}),
+                );
+            }
+            raster.advance(now);
+            if raster.pending() > 0 {
+                return Ok(backpressure(raster, now));
+            }
+            next = raster.next_tick(now) + FRAME;
+        }
+    }
+    let update = update.checked(|source| snapshot(source, next))?;
+    let mut rasters = rasters();
+    if limited(&rasters) {
+        return Err(codex_omd::client_surface::BlitError::retryable(
+            "terminal_blit_limit",
+        ));
+    }
+    let raster = rasters
+        .entry(key.clone())
+        .and_modify(|raster| {
+            if !reusable(raster) {
+                if raster.drawn {
+                    crate::mod_client::forget(&key);
+                }
+                *raster = Raster::new(caller, width, height);
+            }
+        })
+        .or_insert_with(|| Raster::new(caller, width, height));
+    raster.binding = binding;
+    if matches!(update.content, BlitContent::Cells { .. }) && raster.hidden(now) {
+        return Ok(
+            json!({"status": "backpressure", "retry_after_ms": HIDDEN_RETRY.as_millis() as u64}),
+        );
+    }
+    raster.stage(update, now);
+    Ok(json!({
+        "frame": raster.frames + raster.pending() as u64,
+        "queued": raster.pending(),
+        "frame_ms": FRAME.as_millis() as u64,
+    }))
+}
+
+fn backpressure(raster: &Raster, now: Instant) -> Value {
+    let wait = raster.applied.map_or(FRAME, |applied| {
+        FRAME
+            .saturating_sub(now - applied)
+            .max(Duration::from_millis(1))
+    });
+    json!({"status": "backpressure", "retry_after_ms": wait.as_millis() as u64})
+}
+
+pub(crate) fn span(cell: &Cell, no_color: bool, level: Option<StdoutColorLevel>) -> Span<'static> {
+    let mut style = Style::default();
+    if !no_color {
+        if let Some(fg) = cell.fg {
+            style = style.fg(crate::mod_ui::color_at(fg, level));
+        }
+        if let Some(bg) = cell.bg {
+            style = style.bg(crate::mod_ui::color_at(bg, level));
+        }
+    }
+    let symbol = if cell.symbol.is_empty() {
+        " "
+    } else {
+        &cell.symbol
+    };
+    Span::styled(interned(symbol), style)
+}
+
+const INTERNED_LIMIT: usize = 4096;
+
+static INTERNED: Mutex<BTreeSet<&'static str>> = Mutex::new(BTreeSet::new());
+
+/// Cell glyphs as shared static text, so cached raster lines clone without copying a string per cell; the table is bounded, then glyphs are owned.
+fn interned(symbol: &str) -> std::borrow::Cow<'static, str> {
+    let mut table = INTERNED.locked();
+    if let Some(found) = table.get(symbol) {
+        return std::borrow::Cow::Borrowed(found);
+    }
+    if table.len() >= INTERNED_LIMIT {
+        return std::borrow::Cow::Owned(symbol.to_owned());
+    }
+    let leaked: &'static str = Box::leak(symbol.to_owned().into_boxed_str());
+    table.insert(leaked);
+    std::borrow::Cow::Borrowed(leaked)
+}
+
+pub(crate) fn pending_delay(key: &str, now: Instant) -> Option<Duration> {
+    let rasters = rasters();
+    let raster = rasters.get(key)?;
+    if raster.frames != raster.shown {
+        return Some(Duration::ZERO);
+    }
+    (raster.pending() > 0).then(|| {
+        raster.applied.map_or(Duration::ZERO, |applied| {
+            FRAME.saturating_sub(now.saturating_duration_since(applied))
+        })
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rows(
+    id: &str,
+    owner: Option<&str>,
+    alt: &str,
+    width: u16,
+    size: (u16, u16),
+    no_color: bool,
+    prefix: &str,
+    now: Instant,
+) -> (Vec<Line<'static>>, Option<Duration>) {
+    let binding = layouts()
+        .get(id)
+        .and_then(|layout| layout.told.map(|(serial, _, _)| serial));
+    let mut rasters = rasters();
+    if rasters
+        .get(id)
+        .is_some_and(|raster| Some(raster.owner.as_str()) != owner || raster.binding != binding)
+        && rasters.remove(id).is_some_and(|raster| raster.drawn)
+    {
+        crate::mod_client::forget(id);
+    }
+    let Some(raster) = rasters.get_mut(id) else {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], None);
+    };
+    let next = raster.advance(now);
+    raster.shown = raster.frames;
+    if std::mem::replace(&mut raster.drawn, raster.frame.is_some()) && raster.frame.is_none() {
+        crate::mod_client::forget(id);
+    }
+    if raster.frames == 0 {
+        return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], next);
+    }
+    if let Some(frame) = &raster.frame {
+        let (sha256, bytes, pixels, dimensions) = match frame {
+            BlitContent::Image { sha256, bytes } => (
+                sha256.as_str(),
+                Some(bytes),
+                None,
+                crate::mod_components::dimensions(bytes),
+            ),
+            BlitContent::Pixels(frame) => (
+                frame.id.as_str(),
+                None,
+                Some(&frame.image),
+                Some((frame.image.width(), frame.image.height())),
+            ),
+            _ => unreachable!(),
+        };
+        if no_color {
+            return (vec![Line::from(format!("{prefix}[{alt}]")).dim()], next);
+        }
+        let (columns, high) = (width.min(size.0), size.1);
+        let key = format!("{sha256}:{columns}:{high}:{prefix}");
+        let load = || bytes.map(|bytes| bytes.to_vec());
+        let rows = crate::mod_components::picture_rows(
+            id, sha256, &key, columns, high, prefix, &load, pixels,
+        );
+        raster.placed = rows.as_ref().zip(dimensions).map(|(rows, size)| {
+            let wide = rows.first().map_or(0, |row| row.width() - prefix.width());
+            (
+                size,
+                (u16::try_from(wide).unwrap_or(u16::MAX), rows.len() as u16),
+            )
+        });
+        return (
+            rows.unwrap_or_else(|| vec![Line::from(format!("{prefix}[{alt}]")).dim()]),
+            next,
+        );
+    }
+    raster.placed = None;
+    let visible = usize::from(width.min(raster.width).min(size.0));
+    let key = (
+        raster.frames,
+        visible,
+        size.1,
+        no_color,
+        crate::mod_ui::color_level(),
+        prefix.to_owned(),
+    );
+    if let Some((cached, rows)) = &raster.lines
+        && *cached == key
+    {
+        return (rows.clone(), next);
+    }
+    let rows: Vec<Line<'static>> = raster
+        .cells
+        .chunks(usize::from(raster.width))
+        .take(usize::from(size.1))
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            spans.extend(
+                row.iter()
+                    .take(visible)
+                    .map(|cell| span(cell, no_color, key.4)),
+            );
+            Line::from(spans)
+        })
+        .collect();
+    raster.lines = Some((key, rows.clone()));
+    (rows, next)
+}
+
+const UNDERLAY_GUTTER: u16 = 2;
+const UNDERLAY_GLASS: f32 = 0.35;
+const UNDERLAY_MIN_COLUMNS: u16 = 60;
+
+fn underlay_blank(cell: &ratatui::buffer::Cell) -> bool {
+    cell.symbol() == " " && cell.bg == Color::Reset && cell.modifier.is_empty()
+}
+
+/// The underlay raster's cells in screen order, applying its next frame once per draw; None when nothing draws.
+fn underlay_frame<T>(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    level: Option<StdoutColorLevel>,
+    advance: bool,
+    now: Instant,
+    paint: impl FnOnce(&Raster) -> T,
+) -> Option<T> {
+    let id = &snapshot.view.underlay.as_ref()?.raster;
+    let owner = snapshot.component_owners.get(id).map(String::as_str);
+    if !matches!(
+        level,
+        Some(StdoutColorLevel::TrueColor | StdoutColorLevel::Ansi256)
+    ) || screen.width < UNDERLAY_MIN_COLUMNS
+        || screen.is_empty()
+    {
+        return None;
+    }
+    if advance {
+        let size = (screen.width.min(512), screen.height.min(256));
+        track(
+            id,
+            crate::mod_surface::current_thread().as_deref(),
+            owner,
+            size.0,
+            size,
+        );
+    }
+    let mut rasters = rasters();
+    if rasters
+        .get(id)
+        .is_some_and(|raster| Some(raster.owner.as_str()) != owner)
+    {
+        rasters.remove(id);
+    }
+    let raster = rasters.get_mut(id)?;
+    if advance {
+        if let Some(next) = raster.advance(now) {
+            crate::mod_render::schedule_frame(next.saturating_sub(now.elapsed()));
+        }
+        raster.shown = raster.frames;
+    }
+    (raster.frames > 0 && raster.frame.is_none()).then(|| paint(raster))
+}
+
+/// Underlay glyphs, drawn before the bottom pane so its popups clear them: only blank cells of `glyphs` past each row's text and a gutter, never inside `kept`.
+pub(crate) fn underlay_glyphs(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    glyphs: Rect,
+    kept: &[Rect],
+    buffer: &mut Buffer,
+    level: Option<StdoutColorLevel>,
+    now: Instant,
+) {
+    underlay_frame(snapshot, screen, level, true, now, |raster| {
+        let glyphs = glyphs.intersection(screen);
+        for y in glyphs.top()..glyphs.bottom().min(screen.y + raster.height) {
+            let from = (glyphs.left()..glyphs.right())
+                .rev()
+                .find(|x| !underlay_blank(&buffer[(*x, y)]))
+                .map_or(glyphs.left(), |x| x + 1 + UNDERLAY_GUTTER);
+            for x in from..glyphs.right().min(screen.x + raster.width) {
+                let source = &raster.cells[usize::from(y - screen.y) * usize::from(raster.width)
+                    + usize::from(x - screen.x)];
+                if source.symbol.is_empty()
+                    || source.symbol == " "
+                    || kept.iter().any(|area| area.contains((x, y).into()))
+                {
+                    continue;
+                }
+                buffer[(x, y)].set_symbol(&source.symbol).set_fg(
+                    source
+                        .fg
+                        .map_or(Color::Reset, |fg| crate::mod_ui::color_at(fg, level)),
+                );
+            }
+        }
+    });
+}
+
+/// Underlay colour, drawn after the native frame outside `kept`: the raster's background on every default-background cell and, lifted like Codex lifts it, on its raised surface (menus, prompts), where faint glyphs show past each row's text.
+pub(crate) fn underlay_tint(
+    snapshot: &codex_omd::ModViewSnapshot,
+    screen: Rect,
+    kept: &[Rect],
+    buffer: &mut Buffer,
+    level: Option<StdoutColorLevel>,
+) {
+    underlay_frame(snapshot, screen, level, false, Instant::now(), |raster| {
+        let foreground = crate::terminal_palette::default_fg()
+            .map_or(ModColor::Rgb(255, 255, 255), |(r, g, b)| {
+                ModColor::Rgb(r, g, b)
+            });
+        let light = crate::terminal_palette::default_bg().is_some_and(crate::color::is_light);
+        let raised = crate::style::user_message_style().bg;
+        let empty = |cell: &ratatui::buffer::Cell| cell.symbol() == " " && cell.modifier.is_empty();
+        for row in 0..screen.height.min(raster.height) {
+            let y = screen.y + row;
+            let columns = screen.width.min(raster.width);
+            let glass = (0..columns)
+                .rev()
+                .find(|column| {
+                    let cell = &buffer[(screen.x + column, y)];
+                    raised.is_some() && Some(cell.bg) == raised && !empty(cell)
+                })
+                .map_or(0, |column| column + 1 + UNDERLAY_GUTTER);
+            for column in 0..columns {
+                let x = screen.x + column;
+                let source = &raster.cells
+                    [usize::from(row) * usize::from(raster.width) + usize::from(column)];
+                let Some(mut background) = source.bg else {
+                    continue;
+                };
+                if kept.iter().any(|area| area.contains((x, y).into())) {
+                    continue;
+                }
+                let cell = &mut buffer[(x, y)];
+                let lifted = raised.is_some() && Some(cell.bg) == raised;
+                if lifted {
+                    let [r, g, b] = crate::mod_ui::rgb(background);
+                    let (r, g, b) = crate::style::user_message_bg_rgb((r, g, b));
+                    background = ModColor::Rgb(r, g, b);
+                } else if cell.bg != Color::Reset {
+                    continue;
+                }
+                let behind = crate::mod_ui::rgb(background);
+                cell.set_bg(crate::mod_ui::color_at(background, level));
+                if empty(cell) {
+                    if lifted
+                        && column >= glass
+                        && let Some(fg) = source.fg
+                        && !matches!(source.symbol.as_str(), "" | " ")
+                    {
+                        let [r, g, b] = crate::mod_ui::rgb(fg);
+                        let (r, g, b) = crate::color::blend(
+                            (r, g, b),
+                            (behind[0], behind[1], behind[2]),
+                            UNDERLAY_GLASS,
+                        );
+                        cell.set_symbol(&source.symbol)
+                            .set_fg(crate::mod_ui::color_at(ModColor::Rgb(r, g, b), level));
+                    }
+                    continue;
+                }
+                let fg = match cell.fg {
+                    Color::Reset => Some(foreground),
+                    Color::Rgb(r, g, b) if light => Some(ModColor::Rgb(r, g, b)),
+                    Color::Indexed(index) if light => Some(ModColor::Indexed(index)),
+                    _ => None,
+                };
+                if let Some(fg) = fg {
+                    cell.set_fg(crate::mod_ui::color_at(
+                        crate::mod_ui::readable(fg, behind),
+                        level,
+                    ));
+                }
+            }
+        }
+    });
+}
+
+/// A pointer cell on a framed raster in frame pixels, with whether it lies on the picture; `fraction` is the pointer's offset inside the cell, else the cell's centre or half is used.
+pub(crate) fn pixel(
+    id: &str,
+    column: i64,
+    row: i64,
+    half: Option<u64>,
+    fraction: Option<(f64, f64)>,
+) -> Option<(f64, f64, bool)> {
+    let ((width, height), (columns, rows)) = rasters().get(id)?.placed?;
+    if columns == 0 || rows == 0 {
+        return None;
+    }
+    let along = |cell: f64, cells: u16, pixels: u32| {
+        (cell * f64::from(pixels) / f64::from(cells)).clamp(0.0, f64::from(pixels.max(1) - 1))
+    };
+    let (fx, fy) = fraction.unwrap_or((
+        0.5,
+        half.map_or(0.5, |half| half.min(1) as f64 / 2.0 + 0.25),
+    ));
+    Some((
+        along(column as f64 + fx, columns, width),
+        along(row as f64 + fy, rows, height),
+        (0..i64::from(columns)).contains(&column) && (0..i64::from(rows)).contains(&row),
+    ))
+}
+
+/// Keeps the rasters in view and those a live process draws, so a context change doesn't drop a still page's only frame.
+pub(crate) fn retain(ids: &BTreeSet<String>) {
+    let thread = crate::mod_surface::current_thread();
+    let mut rasters = rasters();
+    rasters.retain(|id, raster| {
+        let kept = ids.contains(id)
+            || raster.binding.is_some_and(|binding| {
+                Some(binding)
+                    == codex_omd::process_raster::serial(thread.as_deref(), &raster.owner, id)
+            });
+        if !kept && raster.drawn {
+            crate::mod_client::forget(id);
+        }
+        kept
+    });
+    layouts().retain(|id, _| ids.contains(id) || rasters.contains_key(id));
+}
