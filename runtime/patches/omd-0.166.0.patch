+type Told = (u64, (u16, u16), (u16, u16));
+
+#[derive(Default)]
+struct Layout {
+    size: (u16, u16),
+    told: Option<Told>,
+}
+
+static LAYOUTS: Mutex<BTreeMap<String, Layout>> = Mutex::new(BTreeMap::new());
+
+fn layouts() -> std::sync::MutexGuard<'static, BTreeMap<String, Layout>> {
+    LAYOUTS.locked()
+}
+
+pub(crate) fn rendered(id: &str) -> Option<(u16, u16)> {
+    layouts().get(id).map(|layout| layout.size)
+}
+
+/// Records the rendered size and, for a process-bound raster, tells the process when its drawable box or the client cell changes; the write happens off the render thread, in order.
+pub(crate) fn track(
+    id: &str,
+    thread: Option<&str>,
+    owner: Option<&str>,
+    columns: u16,
+    size: (u16, u16),
+) {
+    let mut layouts = layouts();
+    let layout = layouts.entry(id.to_owned()).or_default();
+    layout.size = size;
+    let Some((_, serial, sink)) =
+        owner.and_then(|owner| codex_omd::process_raster::target(thread, owner, id))
+    else {
+        layout.told = None;
+        return;
+    };
+    let cell = crate::mod_client::facts()
+        .cell
+        .unwrap_or(crate::mod_client::DEFAULT_CELL);
+    let told = (serial, (columns, size.1), cell);
+    if layout.told.replace(told) == Some(told) {
+        return;
+    }
+    let message = json!({"box": {"columns": columns, "rows": size.1,
+        "cell_px": {"width": cell.0, "height": cell.1}}});
+    sink(message);
+}
