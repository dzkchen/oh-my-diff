+
+fn package_read_identified(
+    root: &Path,
+    relative: &str,
+    limit: u64,
+) -> Result<(Vec<u8>, FileStamp)> {
+    let path = root.join(relative);
+    if !path
+        .parent()
+        .ok_or_else(|| failure("package_path_escape"))?
+        .canonicalize()?
+        .starts_with(root)
+    {
+        return Err(failure(format!("package_path_escape: {relative}")));
+    }
+    read_identified(&path, limit)
