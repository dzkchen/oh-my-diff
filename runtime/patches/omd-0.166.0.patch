+        .unwrap()
+        .unwrap();
+        assert!(
+            sandboxed
+                .path
+                .starts_with(store.path().join("pty-scratch/sessions"))
+        );
+        for files in [
+            json!({"../x": "a"}),
+            json!({"a": 1}),
+            json!({"a": "x".repeat(FILE_BYTES + 1)}),
+        ] {
+            assert!(
