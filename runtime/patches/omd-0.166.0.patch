+    assert_eq!(
+        outcomes(&chain),
+        [
+            ("engine".to_owned(), "returned".to_owned()),
+            ("router".to_owned(), "passed".to_owned()),
+            ("prompter".to_owned(), "passed".to_owned())
+        ]
+    );
+}
