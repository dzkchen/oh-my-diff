+        .iter()
+        .find(|region| region.id == "bound_chart")
+        .cloned()
+        .expect("raster region");
+    let (sender, received) = std::sync::mpsc::channel();
+    let sender = std::sync::Mutex::new(sender);
+    let binding = codex_omd::process_raster::bind(
+        Some("displayed-thread"),
+        "demo",
+        vec![
+            (
+                "bound_chart".into(),
+                codex_omd::process_raster::Role::Raster,
+            ),
+            ("bound_keys".into(), codex_omd::process_raster::Role::Keys),
+        ],
+        std::sync::Arc::new(move |message| sender.lock().unwrap().send(message).is_ok()),
+    );
+    let other = codex_omd::process_raster::bind(
+        Some("hidden-thread"),
+        "demo",
+        vec![
+            (
+                "bound_chart".into(),
+                codex_omd::process_raster::Role::Raster,
+            ),
+            ("bound_keys".into(), codex_omd::process_raster::Role::Keys),
