+
+/// Also reports an unterminated last line: a crash inside `append_record`, written but never anchored.
+fn read_log(path: &Path) -> ThreadStoreResult<(Vec<Record>, Vec<String>, bool)> {
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => String::new(),
+        Err(err) => return Err(thread_store_io_error(err)),
+    };
+    let complete = text.rfind('\n').map_or(0, |at| at + 1);
+    let mut records = Vec::new();
+    let mut digests = Vec::new();
+    for line in text[..complete].lines().filter(|line| !line.is_empty()) {
+        records.push(serde_json::from_str(line).map_err(|err| {
+            invalid(format!(
+                "history_anchor_mismatch: unreadable revision log {}: {err}",
+                path.display()
+            ))
+        })?);
+        digests.push(sha256(line));
+    }
+    Ok((records, digests, complete < text.len()))
+}
+
+fn append_record(
+    path: &Path,
+    witness: Option<&dyn HistoryWitness>,
+    record: &Record,
+) -> ThreadStoreResult<()> {
+    let line = serde_json::to_string(record).map_err(|err| internal(err.to_string()))?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent).map_err(thread_store_io_error)?;
+    }
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(thread_store_io_error)?;
+    file.write_all(format!("{line}\n").as_bytes())
+        .and_then(|()| file.sync_all())
+        .map_err(thread_store_io_error)?;
+    if let Some(witness) = witness
+        && let Err(err) = witness.append(path, &sha256(&line))
+    {
+        return Err(internal(format!(
+            "failed to anchor revision log {}: {err}",
+            path.display()
+        )));
+    }
+    Ok(())
+}
+
+fn drop_last_record(path: &Path) -> ThreadStoreResult<()> {
+    let text = std::fs::read_to_string(path).map_err(thread_store_io_error)?;
+    let keep = text
+        .trim_end_matches('\n')
+        .rfind('\n')
+        .map_or(0, |at| at + 1);
+    std::fs::OpenOptions::new()
+        .write(true)
+        .open(path)
+        .and_then(|file| {
+            file.set_len(keep as u64)?;
+            file.sync_all()
+        })
+        .map_err(thread_store_io_error)
+}
+
+fn sha256(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+
+fn invalid(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::InvalidRequest {
+        message: message.into(),
+    }
+}
+
+fn internal(message: impl Into<String>) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: message.into(),
+    }
+}
