+#[test]
+fn subagent_rows_name_model_tokens_and_cost_basis() {
+    let agent = |billing: &str, basis: &str| {
+        serde_json::json!({"role": "researcher", "model": "claude-sonnet-5-5", "provider": "omd_claude_cli",
+            "billing": billing, "status": "completed",
+            "usage": {"input_tokens": 12_400, "output_tokens": 900, "microusd": 41_000, "basis": basis}})
+    };
+    assert_eq!(
+        super::card::subagent_summary(&agent("included_subscription", "settled")),
+        "researcher · claude-sonnet-5-5 (omd_claude_cli) · 12.4K in / 900 out · included · completed"
+    );
+    assert_eq!(
+        super::card::subagent_summary(&agent("provider_billed", "partial")),
+        "researcher · claude-sonnet-5-5 (omd_claude_cli) · 12.4K in / 900 out · $0.04 + unpriced · completed"
+    );
+    assert_eq!(
+        super::card::subagent_summary(&serde_json::json!({"role": "worker", "usage": {}})),
+        "worker · inherited model · 0 in / 0 out · unpriced · running"
+    );
+    assert_eq!(
+        super::card::subagent_summary(&serde_json::json!({"role": "worker", "status": "running",
+            "last_turn": {"outcome": "completed"}, "usage": {}})),
+        "worker · inherited model · 0 in / 0 out · unpriced · idle"
+    );
+}
