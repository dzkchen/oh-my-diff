+fn dock_drag(from: (u16, u16), to: (u16, u16)) {
+    assert!(!pointer(mouse(
+        MouseEventKind::Down(MouseButton::Left),
+        from
+    )));
+    pointer(mouse(MouseEventKind::Drag(MouseButton::Left), to));
+    pointer(mouse(MouseEventKind::Up(MouseButton::Left), to));
+}
