+pub fn session_call(
+    thread: &str,
+    caller: &str,
+    source: Option<&str>,
+    policy: Option<&Value>,
+    call: crate::ModHostCall,
+    active: &dyn Fn() -> bool,
+) -> std::io::Result<Value> {
+    let dispatcher = SESSION_DISPATCHER
+        .lock()
+        .ok()
+        .and_then(|installed| {
+            installed
+                .as_ref()
+                .and_then(|(_, dispatcher)| dispatcher.clone())
+        })
+        .ok_or_else(|| {
+            std::io::Error::other("host_operation_unavailable: no session in this process")
+        })?;
