+use codex_omd::sessions::SessionIndex;
+use serde_json::{Value, json};
+use std::fs;
+use std::path::Path;
+
+fn record(path: &Path, repo: &Path, id: &str, memory: &str) {
+    let rows = [
+        json!({"type":"session_meta","payload":{"id":id,"session_id":"task-a","cwd":repo,"timestamp":"2026-09-26T12:00:00Z","memory_mode":memory}}),
+        json!({"type":"turn_context","payload":{"turn_id":"turn-a","cwd":repo}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"Please preserve my changes."}]}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"assistant","channel":"analysis","content":[{"type":"output_text","text":"hidden-reasoning-sentinel"}]}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Done\nAuthorization: Bearer private-sentinel"}]}}),
+    ];
+    fs::write(
+        path,
+        rows.iter()
+            .map(|row| row.to_string() + "\n")
+            .collect::<String>(),
+    )
+    .unwrap();
+}
+
+fn fixture() -> (tempfile::TempDir, std::path::PathBuf, std::path::PathBuf) {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let repo = root.join("repo");
+    let sessions = root.join("sessions");
+    fs::create_dir(&repo).unwrap();
+    fs::create_dir(&sessions).unwrap();
+    (temp, repo, sessions)
+}
+
+#[test]
+fn repository_scope_opt_out_and_hidden_content_are_enforced() {
+    let (_temp, repo, sessions) = fixture();
+    let other = repo.parent().unwrap().join("other");
+    fs::create_dir(&other).unwrap();
+    record(&sessions.join("a.jsonl"), &repo, "session-a", "enabled");
+    record(&sessions.join("b.jsonl"), &other, "session-b", "enabled");
+    record(&sessions.join("c.jsonl"), &repo, "session-c", "disabled");
+    let index = SessionIndex {
+        database: None,
+        root: &sessions,
+        repository: &repo,
+        enabled: true,
+        tools: true,
+    };
+    let list = index
+        .call("sessions.list", json!({"since":"2026-09-01"}), || true)
+        .unwrap();
+    assert_eq!(list["sessions"].as_array().unwrap().len(), 1);
+    let summary = &list["sessions"][0];
+    let result = index
+        .call(
+            "sessions.read",
+            json!({"session_id":"session-a","revision":summary["revision"],"handle":summary["handle"]}),
+            || true,
+        )
+        .unwrap();
+    let rendered = result.to_string();
+    assert!(!rendered.contains("private-sentinel"));
+    assert!(!rendered.contains("hidden-reasoning-sentinel"));
+    assert_eq!(result["records"].as_array().unwrap().len(), 2);
+    assert_eq!(result["records"][0]["turn_id"], "turn-a");
+    assert_eq!(result["records"][1]["redacted"], true);
+    assert!(
+        index
+            .call(
+                "sessions.read",
+                json!({"session_id":"session-b","revision":summary["revision"],"handle":summary["handle"]}),
+                || true
+            )
+            .is_err()
+    );
+    assert!(
+        index
+            .call("sessions.list", json!({"repository":other}), || true)
+            .is_err()
+    );
+    assert!(index.call("sessions.list", json!({}), || false).is_err());
+    assert!(
+        SessionIndex {
+            database: None,
+            enabled: false,
+            ..index
+        }
+        .call("sessions.list", json!({}), || true)
+        .is_err()
+    );
+}
+
+#[test]
+fn tool_calls_and_results_are_read_beside_messages_with_bounded_payloads() {
+    let (_temp, repo, sessions) = fixture();
+    let rows = [
+        json!({"type":"session_meta","payload":{"id":"session-t","session_id":"task-t","cwd":repo,"timestamp":"2026-09-26T12:00:00Z","memory_mode":"enabled"}}),
+        json!({"type":"turn_context","payload":{"turn_id":"turn-t","cwd":repo}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"Run it."}]}}),
+        json!({"type":"response_item","payload":{"type":"function_call","name":"exec_command","call_id":"call-1","arguments":"{\"cmd\":\"ls\"}"}}),
+        json!({"type":"response_item","payload":{"type":"function_call_output","call_id":"call-1","output":"x".repeat(3000)}}),
+        json!({"type":"response_item","payload":{"type":"custom_tool_call","name":"apply_patch","call_id":"call-2","input":"*** Begin Patch\r\n*** End Patch\n"}}),
+        json!({"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call-2","output":[{"type":"input_text","text":"Authorization: Bearer private-sentinel"},{"type":"input_image","image_url":"data:image/png;base64,AAAA"}]}}),
+        json!({"type":"response_item","payload":{"type":"reasoning","summary":[{"type":"summary_text","text":"hidden-reasoning-sentinel"}]}}),
+    ];
+    fs::write(
+        sessions.join("t.jsonl"),
+        rows.iter()
+            .map(|row| row.to_string() + "\n")
+            .collect::<String>(),
+    )
+    .unwrap();
+    let index = SessionIndex {
+        database: None,
+        root: &sessions,
+        repository: &repo,
+        enabled: true,
+        tools: true,
+    };
+    let list = index.call("sessions.list", json!({}), || true).unwrap();
+    let summary = &list["sessions"][0];
+    let result = index
+        .call(
+            "sessions.read",
+            json!({"session_id":"session-t","revision":summary["revision"],"handle":summary["handle"]}),
+            || true,
+        )
+        .unwrap();
+    let records = result["records"].as_array().unwrap();
+    assert_eq!(result["projection"], "local_visible_records");
+    assert_eq!(
+        records
+            .iter()
+            .map(|record| record["kind"].clone())
+            .collect::<Vec<_>>(),
+        [
+            "message",
+            "tool_call",
+            "tool_result",
+            "tool_call",
+            "tool_result"
+        ]
+    );
+    assert_eq!(records[1]["name"], "exec_command");
+    assert_eq!(records[1]["call_id"], "call-1");
+    assert_eq!(records[1]["arguments"], "{\"cmd\":\"ls\"}");
+    assert_eq!(records[2]["output"].as_str().unwrap().len(), 2048);
+    assert_eq!(records[2]["truncated"], true);
+    assert_eq!(
+        records[3]["arguments"],
+        "*** Begin Patch\r\n*** End Patch\n"
+    );
+    assert_eq!(records[3]["redacted"], false);
+    assert_eq!(records[4]["redacted"], true);
+    assert!(!result.to_string().contains("private-sentinel"));
+    assert!(!result.to_string().contains("hidden-reasoning-sentinel"));
+    assert!(!result.to_string().contains("base64"));
+    let digests = SessionIndex {
+        tools: false,
+        ..index
+    }
+    .call(
+        "sessions.read",
+        json!({"session_id":"session-t","revision":summary["revision"],"handle":summary["handle"]}),
+        || true,
+    )
+    .unwrap();
+    assert_eq!(digests["records"][0]["text"], "Run it.");
+    assert_eq!(digests["records"][1]["name"], "exec_command");
+    assert_eq!(digests["records"][1]["bytes"], 12);
+    assert_eq!(digests["records"][2]["bytes"], 3000);
+    assert_eq!(digests["records"][2]["sha256"].as_str().unwrap().len(), 64);
+    assert!(!digests.to_string().contains("cmd"));
+    assert!(!digests.to_string().contains("xxx"));
+}
