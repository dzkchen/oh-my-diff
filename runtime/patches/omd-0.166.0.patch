+        assert_eq!(dock_preview(), None);
+        shade
+    };
+    for (at, shade) in [
+        ((1, 30), Some(Rect::new(0, 20, 25, 20))),
+        ((48, 30), Some(Rect::new(25, 20, 25, 20))),
+        ((25, 21), Some(Rect::new(0, 20, 50, 10))),
+        ((25, 38), Some(Rect::new(0, 30, 50, 10))),
+        ((25, 30), Some(Rect::new(0, 20, 50, 20))),
+        ((1, 21), Some(Rect::new(0, 20, 25, 20))),
+        ((10, 21), Some(Rect::new(0, 20, 50, 10))),
