+            Err("terminal_blit_invalid".into())
+        );
+    }
+    blit_at("raster-refuse", "owner", cell.clone(), now).expect("queued");
+    super::rows(
+        "raster-refuse",
+        Some("owner"),
+        "chart",
+        10,
+        (4, 2),
+        false,
+        "",
+        now,
+    );
+    assert_eq!(
+        blit_at("raster-refuse", "owner", cell.clone(), now).expect("unchanged"),
+        json!({"frame": 1, "queued": 0, "frame_ms": 16})
+    );
+    let changed = json!({"rect": cell["rect"], "cells": ["y"]});
+    for _ in 0..64 {
+        assert_eq!(
+            blit_at("raster-refuse", "owner", changed.clone(), now).expect("merged"),
+            json!({"frame": 2, "queued": 1, "frame_ms": 16})
+        );
+    }
+    assert_eq!(
+        blit_at("raster-refuse", "owner", changed, now + FRAME * 4).expect("hidden"),
+        json!({"status": "backpressure", "retry_after_ms": 250}),
+        "cells merged into a frame left undrawn for four ticks"
+    );
+}
