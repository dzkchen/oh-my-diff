+impl Drop for StreamRead<'_> {
+    fn drop(&mut self) {
+        if self.active
+            && let Ok(mut streams) = self.streams.lock()
+            && streams.get(&self.handle).is_some_and(|stream| {
+                stream.owner == self.owner
+                    && stream.generation == self.generation
+                    && stream.body.is_none()
+            })
+        {
+            streams.remove(&self.handle);
+        }
+    }
