+fn native_panels(snapshot: &ModViewSnapshot) -> Vec<ModPanel> {
+    let mut panels = Vec::new();
+    if !snapshot.errors.is_empty() {
+        panels.push(ModPanel {
+            title: "Mod errors".into(),
+            lines: snapshot
+                .errors
+                .iter()
+                .map(|(source, error)| format!("{source}: {error}"))
+                .collect(),
+        });
+    }
+    if let Some(progress) = &snapshot.progress {
+        panels.push(ModPanel {
+            title: format!("Progress {} {}", glyph("·", "-"), progress.title),
+            lines: progress.lines.clone(),
+        });
+    }
+    if !snapshot.diagnostics.is_empty() {
+        panels.push(ModPanel {
+            title: "Mod diagnostics".into(),
+            lines: snapshot.diagnostics.clone(),
+        });
+    }
+    panels
