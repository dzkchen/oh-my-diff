+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct Scope {
+    epoch: u64,
+    admission: u64,
+    generation: u64,
+    configuration: String,
+    thread: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Binding {
+    owner: String,
+    scope: Scope,
+}
+
+impl Binding {
+    pub(crate) fn owner(&self) -> &str {
+        &self.owner
+    }
+}
+
+#[derive(Default)]
+struct Sessions {
+    scope: Scope,
+    owners: BTreeMap<String, String>,
+    panes: BTreeMap<(String, String), Pane>,
+    missing: std::collections::BTreeSet<(String, String, String)>,
+}
+
+static SESSIONS: std::sync::LazyLock<Mutex<Sessions>> =
+    std::sync::LazyLock::new(|| Mutex::new(Sessions::default()));
+
+fn sessions() -> std::sync::MutexGuard<'static, Sessions> {
+    SESSIONS.locked()
+}
+
+fn owned<'a>(
+    sessions: &'a mut Sessions,
+    binding: &Binding,
+    session: &str,
+) -> Result<&'a mut Pane, String> {
+    validate(sessions, binding)?;
+    sessions
+        .panes
+        .get_mut(&(binding.owner.clone(), session.to_owned()))
+        .ok_or_else(|| format!("pty_session_unknown: {session}"))
+}
+
+fn validate(sessions: &Sessions, binding: &Binding) -> Result<(), String> {
+    if sessions.scope != binding.scope || !sessions.owners.contains_key(&binding.owner) {
+        return Err("pty_context_changed".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn binding(
+    owner: &str,
+    thread: Option<&str>,
+    authority: &codex_omd::client_surface::Authority,
+) -> Result<Binding, String> {
+    let sessions = sessions();
+    let binding = Binding {
+        owner: owner.to_owned(),
+        scope: sessions.scope.clone(),
+    };
+    validate(&sessions, &binding)?;
+    if thread != binding.scope.thread.as_deref()
+        || authority.epoch != binding.scope.epoch
+        || authority.admission != binding.scope.admission
+        || authority.configuration != binding.scope.configuration
+        || sessions.owners.get(owner) != Some(&authority.source)
+    {
+        return Err("pty_context_changed".into());
+    }
+    Ok(binding)
+}
+
+pub(crate) fn current(binding: &Binding) -> bool {
+    validate(&sessions(), binding).is_ok()
+}
+
+pub(crate) fn view_binding(
+    owner: &str,
+    thread: Option<&str>,
+    epoch: u64,
+    admission: u64,
+    configuration: &str,
+) -> Result<Binding, String> {
+    let source = sessions()
+        .owners
+        .get(owner)
+        .cloned()
+        .ok_or("pty_context_changed")?;
+    binding(
+        owner,
+        thread,
+        &codex_omd::client_surface::Authority {
+            epoch,
+            admission,
+            configuration: configuration.to_owned(),
+            source,
+        },
+    )
+}
+
+static HUNG_UP: Mutex<Vec<(std::time::Instant, codex_utils_pty::ProcessHandle)>> =
+    Mutex::new(Vec::new());
+
+fn prune_hung_up() -> bool {
+    let now = std::time::Instant::now();
+    let mut hung_up = HUNG_UP.locked();
+    hung_up.retain(|(deadline, handle)| !handle.has_exited() && *deadline > now);
+    hung_up.is_empty()
+}
+
+fn hang_up(handle: codex_utils_pty::ProcessHandle) {
+    if handle.has_exited()
+        || handle
+            .signal(codex_utils_pty::ProcessSignal::Hangup)
+            .is_err()
+    {
+        return;
+    }
+    let deadline = std::time::Instant::now() + HANGUP_GRACE;
+    HUNG_UP.locked().push((deadline, handle));
+    std::thread::spawn(move || {
+        while !prune_hung_up() && std::time::Instant::now() < deadline {
+            std::thread::sleep(std::time::Duration::from_millis(50));
+        }
+    });
+}
+
+fn clear(sessions: &mut Sessions) {
+    for pane in std::mem::take(&mut sessions.panes).into_values() {
+        hang_up(pane.handle);
+    }
+    sessions.missing.clear();
+}
+
+pub(crate) fn shutdown() {
+    clear(&mut sessions());
+    while !prune_hung_up() {
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    }
+}
+
+pub(crate) fn context(epoch: u64, thread: Option<String>) {
+    let mut sessions = sessions();
+    if sessions.scope.epoch != epoch || sessions.scope.thread != thread {
+        clear(&mut sessions);
+        sessions.scope.epoch = epoch;
+        sessions.scope.thread = thread;
+    }
+}
+
+pub(crate) fn retain(
+    generation: u64,
+    configuration: &str,
+    active: &BTreeMap<String, String>,
+    unrestricted: &std::collections::BTreeSet<String>,
+) {
+    let mut sessions = sessions();
+    if sessions.scope.generation != generation || sessions.scope.configuration != configuration {
+        clear(&mut sessions);
+        sessions.scope.generation = generation;
+        sessions.scope.admission = codex_omd::client_surface::advance_admission();
+        sessions.scope.configuration = configuration.to_owned();
+    }
+    sessions.owners = active.clone();
+    let (kept, stopped): (BTreeMap<_, _>, BTreeMap<_, _>) = std::mem::take(&mut sessions.panes)
+        .into_iter()
+        .partition(|((owner, _), pane)| {
+            active.contains_key(owner) && (!pane.unrestricted || unrestricted.contains(owner))
+        });
+    sessions.panes = kept;
+    for pane in stopped.into_values() {
+        hang_up(pane.handle);
+    }
+}
+
+pub(crate) fn argv(arguments: &Value) -> Result<Vec<String>, String> {
+    let Some(program) = arguments["program"].as_str() else {
+        if !arguments["argv"].is_null() || !arguments["sha256"].is_null() {
+            return Err("pty_program_required".into());
+        }
+        return Ok(vec![
+            std::env::var("SHELL").unwrap_or_else(|_| "/bin/zsh".to_owned()),
+            "-i".to_owned(),
+        ]);
+    };
+    let args = match &arguments["argv"] {
+        Value::Null => Vec::new(),
+        Value::Array(items) => items
+            .iter()
+            .map(|item| item.as_str().map(str::to_owned))
+            .collect::<Option<Vec<_>>>()
+            .ok_or("pty_argv_invalid")?,
+        _ => return Err("pty_argv_invalid".into()),
+    };
+    if program.is_empty()
+        || args.len() > 64
+        || args.iter().map(String::len).sum::<usize>() > 8192
+        || std::iter::once(program)
+            .chain(args.iter().map(String::as_str))
+            .any(|arg| arg.contains('\0'))
+    {
+        return Err("pty_argv_invalid".into());
+    }
+    Ok(std::iter::once(program.to_owned()).chain(args).collect())
+}
+
+fn session_name(value: &Value) -> Result<String, String> {
+    value
+        .as_str()
+        .filter(|name| {
+            !name.is_empty()
+                && name.len() <= 64
+                && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        })
+        .map(str::to_owned)
+        .ok_or_else(|| "pty_session_invalid".to_owned())
+}
+
+pub(crate) fn start_prompt(caller: &str, arguments: &Value) -> Result<String, String> {
+    session_name(&arguments["session"])?;
+    let argv = argv(arguments)?;
+    Ok(format!(
+        "Mod {caller} wants to open a terminal pane running `{}` in {}. It runs in the session sandbox {}, {}. The mod can type into it and read its screen.",
+        argv.join(" "),
+        arguments["cwd"].as_str().unwrap_or("."),
+        if arguments["network"] == "loopback" {
+            "with network limited to this computer (loopback)"
+        } else {
+            "without network"
+        },
+        if arguments["write"] == true {
+            "and can write to the workspace"
+        } else {
+            "read-only"
+        }
+    ))
+}
+pub(crate) fn prepare(
+    store: &Path,
+    unrestricted: bool,
+    arguments: &Value,
+    argv: &mut [String],
+) -> Result<Option<SessionDir>, String> {
+    let files = match &arguments["files"] {
+        Value::Null => Vec::new(),
+        Value::Object(files) if files.len() <= FILES => files
+            .iter()
+            .map(|(name, text)| {
+                text.as_str()
+                    .filter(|text| valid_file(name) && text.len() <= FILE_BYTES)
+                    .map(|text| (name.clone(), text.to_owned()))
+            })
+            .collect::<Option<Vec<_>>>()
+            .ok_or("pty_files_invalid")?,
+        _ => return Err("pty_files_invalid".into()),
+    };
+    if files.is_empty() && !argv.iter().skip(1).any(|arg| arg.contains("{dir}")) {
+        return Ok(None);
+    }
+    let roots = [
+        store.join("pty-sessions"),
+        store.join("pty-scratch").join("sessions"),
+    ];
+    static SWEPT: std::sync::Once = std::sync::Once::new();
+    SWEPT.call_once(|| roots.iter().for_each(|root| sweep(root)));
+    let root = &roots[usize::from(!unrestricted)];
+    let unique = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    let path = root.join(format!("{}-{unique}", std::process::id()));
+    let create = || -> std::io::Result<SessionDir> {
+        std::fs::create_dir_all(root)?;
+        if !std::fs::symlink_metadata(root)?.is_dir() {
+            return Err(std::io::Error::other("sessions is not a directory"));
+        }
+        std::fs::DirBuilder::new().mode(0o700).create(&path)?;
+        let metadata = std::fs::symlink_metadata(&path)?;
+        let dir = SessionDir {
+            path: path.clone(),
+            identity: (metadata.dev(), metadata.ino()),
+        };
+        for (name, text) in &files {
+            let mut file = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(path.join(name))?;
+            file.write_all(text.as_bytes())?;
+        }
+        Ok(dir)
+    };
+    let dir = create().map_err(|error| format!("pty_files_invalid: {error}"))?;
+    let shown = dir.path.to_string_lossy();
+    for arg in argv.iter_mut().skip(1) {
+        *arg = arg.replace("{dir}", &shown);
+    }
+    Ok(Some(dir))
+}
+
+fn sweep(root: &Path) {
+    if !std::fs::symlink_metadata(root).is_ok_and(|metadata| metadata.is_dir()) {
+        return;
+    }
+    for entry in std::fs::read_dir(root).into_iter().flatten().flatten() {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let Some((pid, unique)) = name.split_once('-') else {
+            continue;
+        };
+        let Ok(pid) = pid.parse::<libc::pid_t>() else {
+            continue;
+        };
+        if unique.is_empty() || !unique.bytes().all(|b| b.is_ascii_digit()) {
+            continue;
+        }
+        let gone = pid != std::process::id() as libc::pid_t
+            && unsafe { libc::kill(pid, 0) } != 0
+            && std::io::Error::last_os_error().raw_os_error() == Some(libc::ESRCH);
+        if gone {
+            let _ = std::fs::remove_dir_all(entry.path());
+        }
+    }
+}
+
+fn valid_file(name: &str) -> bool {
+    (1..=64).contains(&name.len())
+        && name != "."
+        && name != ".."
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
+}
+
+fn files(dir: Option<&SessionDir>) -> Option<Value> {
+    let dir = dir?;
+    let opened = dir.open()?;
+    let entries = std::fs::read_dir(&dir.path).ok()?;
+    let mut files = serde_json::Map::new();
+    let mut used = 0;
+    for entry in entries.flatten() {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let Ok(c_name) = std::ffi::CString::new(name.as_str()) else {
+            continue;
+        };
+        if !valid_file(&name) || used >= RESULT_BYTES {
+            continue;
+        }
+        let fd = unsafe {
+            libc::openat(
+                std::os::fd::AsRawFd::as_raw_fd(&opened),
+                c_name.as_ptr(),
+                libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+            )
+        };
+        if fd < 0 {
+            continue;
+        }
+        let file = unsafe { std::fs::File::from_raw_fd(fd) };
+        let Ok(metadata) = file.metadata() else {
+            continue;
+        };
+        if !metadata.is_file()
+            || metadata.nlink() != 1
+            || used + metadata.len() as usize > RESULT_BYTES
+        {
+            continue;
+        }
+        let mut bytes = Vec::new();
+        if std::io::Read::read_to_end(
+            &mut std::io::Read::take(file, (RESULT_BYTES - used) as u64),
+            &mut bytes,
+        )
+        .is_ok()
+        {
+            used += bytes.len();
+            files.insert(
+                name,
+                Value::String(String::from_utf8_lossy(&bytes).into_owned()),
+            );
+        }
+    }
+    Some(Value::Object(files))
+}
+
+pub(crate) async fn start(
+    binding: &Binding,
+    arguments: &Value,
+    command: std::process::Command,
+    home: &Path,
+    dir: Option<SessionDir>,
+    frames: crate::tui::FrameRequester,
+    events: crate::app_event_sender::AppEventSender,
+) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let owner = &binding.owner;
+    let key = (owner.clone(), session.clone());
+    let limit = crate::omd::mod_paths()
+        .and_then(|paths| paths.store)
+        .map_or_else(Default::default, |store| {
+            codex_omd::mod_limits::ModLimits::read(&store)
+        })
+        .pty_panes_per_mod;
+    let unavailable = |sessions: &Sessions| {
+        sessions.panes.contains_key(&key)
+            || sessions.panes.len() >= PANES
+            || sessions.panes.keys().filter(|(id, _)| id == owner).count() >= limit
+    };
+    {
+        let sessions = sessions();
+        validate(&sessions, binding)?;
+        if unavailable(&sessions) {
+            return Err("pty_session_exists_or_limit".into());
+        }
+    }
+    let program = command.get_program().to_string_lossy().into_owned();
+    let args = command
+        .get_args()
+        .map(|arg| arg.to_string_lossy().into_owned())
+        .collect::<Vec<_>>();
+    let cwd = command
+        .get_current_dir()
+        .map(Path::to_path_buf)
+        .ok_or("pty_cwd_invalid")?;
+    let unrestricted = arguments["sandbox"] == "none";
+    let mut environment = if unrestricted {
+        command
+            .get_envs()
+            .filter_map(|(name, value)| {
+                Some((
+                    name.to_string_lossy().into_owned(),
+                    value?.to_string_lossy().into_owned(),
+                ))
+            })
+            .chain(
+                std::env::var("SSH_AUTH_SOCK")
+                    .ok()
+                    .map(|socket| ("SSH_AUTH_SOCK".to_owned(), socket)),
+            )
+            .collect()
+    } else {
+        ["PATH", "LANG", "USER", "SHELL"]
+            .into_iter()
+            .filter_map(|name| Some((name.to_owned(), std::env::var(name).ok()?)))
+            .collect::<std::collections::HashMap<_, _>>()
+    };
+    environment.extend([
+        ("TERM".to_owned(), "xterm-256color".to_owned()),
+        ("HOME".to_owned(), home.to_string_lossy().into_owned()),
+    ]);
+    if crate::terminal_palette::effective_stdout_color_level() == StdoutColorLevel::TrueColor {
+        environment.insert("COLORTERM".to_owned(), "truecolor".to_owned());
+    }
+    for (name, value) in command.get_envs() {
+        if name == "SSH_AUTH_SOCK"
+            && let Some(value) = value
+        {
+            environment.insert(
+                "SSH_AUTH_SOCK".to_owned(),
+                value.to_string_lossy().into_owned(),
+            );
+        }
+    }
+    let size = codex_utils_pty::TerminalSize { rows: 24, cols: 80 };
+    let spawned = match codex_utils_pty::pty::spawn_process(
+        &program,
+        &args,
+        &cwd,
+        &environment,
+        &None,
+        size,
+        codex_utils_pty::ChildFds::Attached(&[]),
+    )
+    .await
+    {
+        Ok(spawned) => spawned,
+        Err(error) => return Err(format!("pty_start_failed: {error}")),
+    };
+    let screen = Arc::new(Mutex::new(vt100::Parser::new_with_callbacks(
+        size.rows,
+        size.cols,
+        SCROLLBACK,
+        Signals::default(),
+    )));
+    let exit = Arc::new(Mutex::new(None));
+    let (mut output, exited) = (spawned.stdout_rx, spawned.exit_rx);
+    let drawn = Arc::new(AtomicBool::new(true));
+    let (reader, reader_drawn, reader_frames) = (screen.clone(), drawn.clone(), frames.clone());
+    let copied = binding.clone();
+    let copied_session = session.clone();
+    let delivered = key.clone();
+    let replier = spawned.session.writer_sender();
+    tokio::spawn(async move {
+        while let Some(bytes) = output.recv().await {
+            let (copies, replies) = {
+                let mut parser = reader.locked();
+                parser.process(&bytes);
+                let alternate = parser.screen().alternate_screen();
+                let signals = parser.callbacks_mut();
+                if signals.alternate != alternate {
+                    signals.alternate = alternate;
+                    signals.links.clear();
+                }
+                (
+                    std::mem::take(&mut signals.copies),
+                    std::mem::take(&mut signals.replies),
+                )
+            };
+            if !replies.is_empty() {
+                let _ = replier.try_send(replies);
+            }
+            if !deliver(&delivered, &reader) {
+                break;
+            }
+            for text in copies {
+                events.send(crate::app_event::AppEvent::ModPtyClipboard {
+                    binding: copied.clone(),
+                    session: copied_session.clone(),
+                    text,
+                    decision: None,
+                });
+            }
+            if reader_drawn.swap(false, Ordering::Relaxed) {
+                reader_frames.schedule_frame();
+            }
+        }
+    });
+    let status = exit.clone();
+    let exited_key = key.clone();
+    let exited_screen = screen.clone();
+    tokio::spawn(async move {
+        let code = exited.await.unwrap_or(-1);
+        *status.locked() = Some(code);
+        deliver(&exited_key, &exited_screen);
+        frames.schedule_frame();
+    });
+    let mut sessions = sessions();
+    if let Err(error) = validate(&sessions, binding) {
+        spawned.session.terminate();
+        return Err(error);
+    }
+    if unavailable(&sessions) {
+        spawned.session.terminate();
+        return Err("pty_session_exists_or_limit".into());
+    }
+    sessions
+        .missing
+        .retain(|(id, name, _)| (id, name) != (&key.0, &key.1));
+    sessions.panes.insert(
+        key,
+        Pane {
+            writer: spawned.session.writer_sender(),
+            handle: spawned.session,
+            screen,
+            exit,
+            drawn,
+            hidden: false,
+            size: (size.rows, size.cols),
+            unrestricted,
+            dir,
+            component: None,
+            reported: false,
+            title: None,
+            clipboard: Clipboard::Ask,
+        },
+    );
+    Ok(json!({"session": session, "running": true}))
+}
+
+pub(crate) fn call(binding: &Binding, arguments: &Value) -> Result<Value, String> {
+    let session = session_name(&arguments["session"])?;
+    let mut sessions = sessions();
+    match arguments["action"].as_str() {
+        Some("write") => {
+            let text = arguments["text"]
+                .as_str()
+                .filter(|text| text.len() <= WRITE_BYTES)
+                .ok_or("pty_write_invalid")?;
+            owned(&mut sessions, binding, &session)?
+                .writer
+                .try_send(text.as_bytes().to_vec())
+                .map_err(|_| "pty_write_unavailable")?;
+            Ok(json!({"written": text.len()}))
+        }
+        Some("read") => {
+            let pane = owned(&mut sessions, binding, &session)?;
+            let text = pane.screen.locked().screen().contents();
+            let exit_code = *pane.exit.locked();
+            let mut result =
+                json!({"text": text, "running": exit_code.is_none(), "exit_code": exit_code});
+            if exit_code.is_some()
+                && let Some(files) = files(pane.dir.as_ref())
+            {
+                result["files"] = files;
+            }
+            Ok(result)
+        }
+        Some("stop") => {
+            owned(&mut sessions, binding, &session)?;
+            if let Some(pane) = sessions.panes.remove(&(binding.owner.clone(), session)) {
+                hang_up(pane.handle);
+            }
+            Ok(json!({"stopped": true}))
+        }
+        _ => Err("pty_action_invalid".into()),
+    }
+}
+
+fn drain(pane: &mut Pane, session: &str) -> Vec<Value> {
+    let Some(component) = pane.component.clone() else {
+        return Vec::new();
+    };
+    let mut events = Vec::new();
+    {
+        let mut parser = pane.screen.locked();
+        let signals = parser.callbacks_mut();
+        if let Some(title) = signals.title.take()
+            && pane.title.as_ref() != Some(&title)
+        {
+            pane.title = Some(title.clone());
+            events.push(json!({"kind": "title", "title": title}));
+        }
+        if std::mem::take(&mut signals.bell) {
+            events.push(json!({"kind": "bell"}));
+        }
+        for text in std::mem::take(&mut signals.notices) {
+            events.push(json!({"kind": "notify", "text": text}));
+        }
+    }
+    if !pane.reported
+        && let Some(code) = *pane.exit.locked()
+    {
+        pane.reported = true;
+        let mut exit = json!({"kind": "exit", "session": session, "exit_code": code});
+        if let Some(files) = files(pane.dir.as_ref()) {
+            exit["files"] = files;
+        }
+        events.push(exit);
+    }
+    for event in &mut events {
+        event["component"] = Value::String(component.clone());
+    }
+    events
+}
+
+fn deliver(key: &(String, String), screen: &Arc<Mutex<vt100::Parser<Signals>>>) -> bool {
+    let events = match sessions().panes.get_mut(key) {
+        Some(pane) if Arc::ptr_eq(&pane.screen, screen) => drain(pane, &key.1),
+        Some(_) => return false,
+        None => Vec::new(),
+    };
+    for event in events {
+        crate::mod_surface::component_event(event);
+    }
+    true
+}
+
+/// Moves a pane's clipboard permission from `Ask` to `Asking` for the caller that will prompt.
+pub(crate) fn clipboard(binding: &Binding, session: &str, decision: Option<bool>) -> Clipboard {
+    let mut sessions = sessions();
+    let Ok(pane) = owned(&mut sessions, binding, session) else {
+        return Clipboard::Declined;
+    };
+    let state = pane.clipboard;
+    pane.clipboard = match (decision, state) {
+        (Some(true), _) => Clipboard::Allowed,
+        (Some(false), _) => Clipboard::Declined,
+        (None, Clipboard::Ask) => Clipboard::Asking,
+        (None, state) => state,
+    };
+    if decision.is_some() {
+        pane.clipboard
+    } else {
+        state
+    }
+}
+
+fn color(color: vt100::Color, level: StdoutColorLevel) -> Option<Color> {
+    match color {
+        vt100::Color::Default => None,
+        vt100::Color::Idx(index) => Some(Color::Indexed(index)),
+        vt100::Color::Rgb(r, g, b) => Some(best_color_for_level((r, g, b), level)),
+    }
+}
+
+pub(crate) fn rows(
+    binding: Option<&Binding>,
+    session: &str,
+    component: &str,
+    width: u16,
+    height: u16,
+    prefix: &str,
+    focused: bool,
+) -> Vec<(Line<'static>, Vec<TerminalHyperlink>)> {
+    let mut sessions = sessions();
+    let Some(binding) = binding else {
+        return vec![(
+            Line::from(format!("{prefix}[{session} is not running]")),
+            Vec::new(),
+        )];
+    };
+    if validate(&sessions, binding).is_ok()
+        && !sessions
+            .panes
+            .contains_key(&(binding.owner.clone(), session.to_owned()))
+        && sessions.missing.insert((
+            binding.owner.clone(),
+            session.to_owned(),
+            component.to_owned(),
+        ))
+    {
+        crate::mod_surface::component_event(json!({
+            "kind": "exit", "session": session, "exit_code": null, "component": component,
+        }));
+    }
+    let Ok(pane) = owned(&mut sessions, binding, session) else {
+        return vec![(
+            Line::from(format!("{prefix}[{session} is not running]")),
+            Vec::new(),
+        )];
+    };
+    let (rows, cols) = (height.max(2), width.max(10));
+    if !pane.hidden {
+        pane.drawn.store(true, Ordering::Relaxed);
+    }
+    if pane.component.as_deref() != Some(component) {
+        pane.component = Some(component.to_owned());
+        for event in drain(pane, session) {
+            crate::mod_surface::component_event(event);
+        }
+    }
+    let mut parser = pane.screen.locked();
+    if pane.size != (rows, cols) {
+        pane.size = (rows, cols);
+        parser.screen_mut().set_size(rows, cols);
+        let _ = pane
+            .handle
+            .resize(codex_utils_pty::TerminalSize { rows, cols });
+    }
+    let exited = *pane.exit.locked();
+    let screen = parser.screen();
+    let live = screen.scrollback() == 0;
+    let cursor = (focused && live && exited.is_none() && !screen.hide_cursor())
+        .then(|| screen.cursor_position())
+        .map(|(row, column)| (row, column.min(cols - 1)));
+    let offset = prefix.width();
+    let links = &parser.callbacks().links;
+    let level = crate::terminal_palette::effective_stdout_color_level();
+    let mut lines = (0..rows)
+        .map(|row| {
+            let mut spans = vec![Span::raw(prefix.to_owned())];
+            let mut run = (String::new(), Style::default());
+            for column in 0..cols {
+                let Some(cell) = screen.cell(row, column) else {
+                    continue;
+                };
+                if cell.is_wide_continuation() {
+                    continue;
+                }
+                let mut style = Style::default();
+                if let Some(foreground) = color(cell.fgcolor(), level) {
+                    style = style.fg(foreground);
+                }
+                if let Some(background) = color(cell.bgcolor(), level) {
+                    style = style.bg(background);
+                }
+                for (on, modifier) in [
+                    (cell.bold(), Modifier::BOLD),
+                    (cell.dim(), Modifier::DIM),
+                    (cell.italic(), Modifier::ITALIC),
+                    (cell.underline(), Modifier::UNDERLINED),
+                    (
+                        cell.inverse() != (cursor == Some((row, column))),
+                        Modifier::REVERSED,
+                    ),
+                ] {
+                    if on {
+                        style = style.add_modifier(modifier);
+                    }
+                }
+                if style != run.1 && !run.0.is_empty() {
+                    let (text, style) = std::mem::take(&mut run);
+                    spans.push(Span::styled(text, style));
+                }
+                run.1 = style;
+                run.0.push_str(if cell.has_contents() {
+                    cell.contents()
+                } else {
+                    " "
+                });
+            }
+            if !run.0.is_empty() {
+                spans.push(Span::styled(run.0, run.1));
+            }
+            let row_links = links
+                .iter()
+                .filter(|link| {
+                    live && link.row == row
+                        && screen.contents_between(row, link.start, row, link.end) == link.text
+                })
+                .map(|link| {
+                    TerminalHyperlink::web(
+                        offset + usize::from(link.start)..offset + usize::from(link.end),
+                        link.url.clone(),
+                    )
+                })
+                .collect();
+            (Line::from(spans), row_links)
+        })
+        .collect::<Vec<_>>();
+    if let Some(code) = exited {
+        lines.push((
+            Line::from(format!("{prefix}[{session} exited with {code}]")),
+            Vec::new(),
+        ));
+    }
+    lines
+}
+
+fn key_bytes(key: KeyEvent, application_cursor: bool) -> Option<Vec<u8>> {
+    let (shift, alt, ctrl) = (
+        key.modifiers.contains(KeyModifiers::SHIFT),
+        key.modifiers.contains(KeyModifiers::ALT),
+        key.modifiers.contains(KeyModifiers::CONTROL),
+    );
+    let modifier = 1 + u8::from(shift) + 2 * u8::from(alt) + 4 * u8::from(ctrl);
+    let cursor = |end: char| {
+        if modifier > 1 {
+            format!("\x1b[1;{modifier}{end}")
+        } else if application_cursor {
+            format!("\x1bO{end}")
+        } else {
+            format!("\x1b[{end}")
+        }
+    };
+    let tilde = |number: u8| {
+        if modifier > 1 {
+            format!("\x1b[{number};{modifier}~")
+        } else {
+            format!("\x1b[{number}~")
+        }
+    };
+    let escaped = |bytes: Vec<u8>| {
+        if alt {
+            [vec![0x1b], bytes].concat()
+        } else {
+            bytes
+        }
+    };
+    let text = match key.code {
+        KeyCode::Up => cursor('A'),
+        KeyCode::Down => cursor('B'),
+        KeyCode::Right => cursor('C'),
+        KeyCode::Left => cursor('D'),
+        KeyCode::Home => cursor('H'),
+        KeyCode::End => cursor('F'),
+        KeyCode::Insert => tilde(2),
+        KeyCode::Delete => tilde(3),
+        KeyCode::PageUp => tilde(5),
+        KeyCode::PageDown => tilde(6),
+        KeyCode::F(number @ 1..=4) => {
+            let end = char::from(b'P' + number - 1);
+            if modifier > 1 {
+                format!("\x1b[1;{modifier}{end}")
+            } else {
+                format!("\x1bO{end}")
+            }
+        }
+        KeyCode::F(number @ 5..=12) => {
+            tilde([15, 17, 18, 19, 20, 21, 23, 24][usize::from(number - 5)])
+        }
+        KeyCode::BackTab => "\x1b[Z".to_owned(),
+        KeyCode::Tab if shift => "\x1b[Z".to_owned(),
+        KeyCode::Tab => return Some(escaped(vec![b'\t'])),
+        KeyCode::Enter => return Some(escaped(vec![b'\r'])),
+        KeyCode::Backspace => return Some(escaped(vec![if ctrl { 0x08 } else { 0x7f }])),
+        KeyCode::Esc => return Some(vec![0x1b]),
+        KeyCode::Char(c) if ctrl => {
+            let byte = match c {
+                'a'..='z' | 'A'..='Z' => (c.to_ascii_lowercase() as u8) & 0x1f,
+                ' ' | '@' | '2' => 0,
+                '[' | '3' => 0x1b,
+                '\\' | '4' => 0x1c,
+                ']' | '5' => 0x1d,
+                '^' | '6' => 0x1e,
+                '_' | '-' | '7' => 0x1f,
+                '?' | '8' => 0x7f,
+                _ => return None,
+            };
+            return Some(escaped(vec![byte]));
+        }
+        KeyCode::Char(c) => return Some(escaped(c.to_string().into_bytes())),
+        _ => return None,
+    };
+    Some(text.into_bytes())
+}
+
+/// Records whether the finished render showed the pane; only a shown pane's output requests frames.
+pub(crate) fn set_shown(binding: Option<&Binding>, session: &str, shown: bool) {
+    let mut sessions = sessions();
+    if let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) {
+        pane.hidden = !shown;
+        pane.drawn.store(shown, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn live(binding: Option<&Binding>, session: &str) -> bool {
+    let mut sessions = sessions();
+    binding
+        .and_then(|binding| owned(&mut sessions, binding, session).ok())
+        .is_some_and(|pane| pane.exit.locked().is_none())
+}
+
+pub(crate) fn key(binding: Option<&Binding>, session: &str, key: KeyEvent) -> bool {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return false;
+    };
+    let mut parser = pane.screen.locked();
+    let Some(bytes) = key_bytes(key, parser.screen().application_cursor()) else {
+        return false;
+    };
+    parser.screen_mut().set_scrollback(0);
+    pane.writer.try_send(bytes).is_ok()
+}
+
+pub(crate) fn reports_mouse(binding: Option<&Binding>, session: &str) -> bool {
+    let mut sessions = sessions();
+    binding
+        .and_then(|binding| owned(&mut sessions, binding, session).ok())
+        .is_some_and(|pane| {
+            pane.screen.locked().screen().mouse_protocol_mode() != vt100::MouseProtocolMode::None
+        })
+}
+
+pub(crate) fn mouse(
+    binding: Option<&Binding>,
+    session: &str,
+    event: MouseEvent,
+    column: u16,
+    row: u16,
+) -> bool {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return false;
+    };
+    let mut parser = pane.screen.locked();
+    let screen = parser.screen();
+    let mode = screen.mouse_protocol_mode();
+    let up = event.kind == MouseEventKind::ScrollUp;
+    if mode == vt100::MouseProtocolMode::None {
+        if !matches!(
+            event.kind,
+            MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+        ) {
+            return false;
+        }
+        if screen.alternate_screen() {
+            let arrow = key_bytes(
+                KeyEvent::new(
+                    if up { KeyCode::Up } else { KeyCode::Down },
+                    KeyModifiers::NONE,
+                ),
+                screen.application_cursor(),
+            )
+            .unwrap_or_default();
+            let _ = pane.writer.try_send(arrow.repeat(WHEEL_LINES));
+        } else {
+            let offset = screen.scrollback();
+            parser.screen_mut().set_scrollback(if up {
+                offset + WHEEL_LINES
+            } else {
+                offset.saturating_sub(WHEEL_LINES)
+            });
+        }
+        return true;
+    }
+    let button = |button: MouseButton| match button {
+        MouseButton::Left => 0,
+        MouseButton::Middle => 1,
+        MouseButton::Right => 2,
+    };
+    use vt100::MouseProtocolMode::*;
+    let (code, release) = match event.kind {
+        MouseEventKind::Down(pressed) => (button(pressed), false),
+        MouseEventKind::Up(pressed) if mode != Press => (button(pressed), true),
+        MouseEventKind::Drag(pressed) if matches!(mode, ButtonMotion | AnyMotion) => {
+            (button(pressed) + 32, false)
+        }
+        MouseEventKind::Moved if mode == AnyMotion => (35, false),
+        MouseEventKind::ScrollUp => (64, false),
+        MouseEventKind::ScrollDown => (65, false),
+        MouseEventKind::ScrollLeft => (66, false),
+        MouseEventKind::ScrollRight => (67, false),
+        _ => return true,
+    };
+    let modifiers = 4 * u16::from(event.modifiers.contains(KeyModifiers::SHIFT))
+        + 8 * u16::from(event.modifiers.contains(KeyModifiers::ALT))
+        + 16 * u16::from(event.modifiers.contains(KeyModifiers::CONTROL));
+    let (x, y) = (u32::from(column) + 1, u32::from(row) + 1);
+    let bytes = match screen.mouse_protocol_encoding() {
+        vt100::MouseProtocolEncoding::Sgr => format!(
+            "\x1b[<{};{x};{y}{}",
+            code + modifiers,
+            if release { 'm' } else { 'M' }
+        )
+        .into_bytes(),
+        encoding => {
+            let code = if release { 3 } else { code } + modifiers;
+            let mut bytes = b"\x1b[M".to_vec();
+            for value in [u32::from(code), x, y] {
+                let value = value + 32;
+                match encoding {
+                    vt100::MouseProtocolEncoding::Utf8 => match char::from_u32(value) {
+                        Some(c) if value < 2048 => {
+                            bytes.extend(c.to_string().into_bytes());
+                        }
+                        _ => return true,
+                    },
+                    _ if value <= 255 => bytes.push(value as u8),
+                    _ => return true,
+                }
+            }
+            bytes
+        }
+    };
+    let _ = pane.writer.try_send(bytes);
+    true
+}
+
+pub(crate) fn paste(binding: Option<&Binding>, session: &str, text: &str) {
+    let mut sessions = sessions();
+    let Some(pane) = binding.and_then(|binding| owned(&mut sessions, binding, session).ok()) else {
+        return;
+    };
+    let bracketed = pane.screen.locked().screen().bracketed_paste();
+    let bytes = if bracketed {
+        format!("\x1b[200~{text}\x1b[201~")
+    } else {
+        text.to_owned()
+    };
+    let _ = pane.writer.try_send(bytes.into_bytes());
+}
