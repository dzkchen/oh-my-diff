+use crate::omd::LockExt;
+use codex_omd::ModBoxBorder;
+use codex_omd::ModLayout;
+use codex_omd::ModSplit;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Rect;
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+const MIN_CELLS: u16 = 3;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Region {
+    pub(crate) path: String,
+    pub(crate) content: String,
+    pub(crate) area: Rect,
+    pub(crate) style: Option<codex_omd::ModBoxStyle>,
+    pub(crate) title: Option<String>,
+    pub(crate) tabs: Option<String>,
+}
+
+impl Region {
+    fn grab_row(&self) -> Option<u16> {
+        let style = self.style.unwrap_or_default();
+        let framed = style.border != Some(ModBoxBorder::None) || self.title.as_deref() != Some("");
+        let margin = style.margin.map_or(0, |margin| margin.axes().0);
+        framed.then(|| self.area.y.saturating_add(margin))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct TabBar {
+    pub(crate) path: String,
+    pub(crate) area: Rect,
+    pub(crate) titles: Vec<String>,
+    pub(crate) active: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Handle {
+    path: String,
+    index: usize,
+    split: ModSplit,
+    starts: Vec<u16>,
+    sizes: Vec<u16>,
+    span: (u16, u16),
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Placement {
+    pub(crate) regions: Vec<Region>,
+    pub(crate) tabs: Vec<TabBar>,
+    pub(crate) heading: Option<(Rect, String)>,
+    handles: Vec<Handle>,
+}
+
+impl Placement {
+    pub(crate) fn area(&self, content: &str) -> Option<Rect> {
+        self.regions
+            .iter()
+            .find(|region| region.content == content)
+            .map(|region| region.area)
+    }
+
+    pub(crate) fn chat(&self) -> Option<Rect> {
+        let transcript = self.area("transcript")?;
+        Some(match self.area("composer") {
+            Some(composer) => transcript.union(composer),
+            None => transcript,
+        })
+    }
+
+    fn chat_path(&self) -> Option<String> {
+        let path = |content: &str| {
+            self.regions
+                .iter()
+                .find(|region| region.content == content)
+                .map(|region| region.path.as_str())
+        };
+        let transcript = path("transcript")?;
+        let shared = |composer: &str| {
+            transcript
+                .split('.')
+                .zip(composer.split('.'))
+                .take_while(|(a, b)| a == b)
+                .map(|(segment, _)| segment)
+                .collect::<Vec<_>>()
+                .join(".")
+        };
+        Some(path("composer").map_or_else(|| transcript.to_owned(), shared))
+    }
+}
+
+struct Dock {
+    path: String,
+    content: String,
+    origin: (u16, u16),
+    at: (u16, u16),
+    active: bool,
+}
+
+struct Zone {
+    target: String,
+    edge: &'static str,
+    shade: Rect,
+}
+
+#[derive(Default)]
+struct State {
+    layout: Option<ModLayout>,
+    owner: Option<String>,
+    ratios: BTreeMap<String, Vec<u16>>,
+    active: BTreeMap<String, usize>,
+    drag: Option<(String, usize)>,
+    dock: Option<Dock>,
+    last: Placement,
+    screen: Rect,
+}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+static SWALLOW: AtomicBool = AtomicBool::new(false);
+
+fn with<T>(run: impl FnOnce(&mut State) -> T) -> T {
+    let mut guard = STATE.locked();
+    run(guard.get_or_insert_with(State::default))
+}
+
+pub(crate) fn distribute(total: u16, weights: &[u16]) -> Vec<u16> {
+    let sum = weights
+        .iter()
+        .map(|weight| u32::from(*weight))
+        .sum::<u32>()
+        .max(1);
+    let mut sizes = weights
+        .iter()
+        .map(|weight| u16::try_from(u32::from(total) * u32::from(*weight) / sum).unwrap_or(total))
+        .collect::<Vec<_>>();
+    let used = sizes.iter().sum::<u16>();
+    if let Some(last) = sizes.last_mut() {
+        *last += total.saturating_sub(used);
+    }
+    sizes
+}
+
+fn walk(
+    node: &ModLayout,
+    area: Rect,
+    (path, outer): (&str, Option<&str>),
+    state: &State,
+    out: &mut Placement,
+) {
+    match node {
+        ModLayout::Leaf(leaf) => {
+            let mut area = area;
+            if let Some(title) = leaf.title.as_ref().filter(|title| !title.is_empty())
+                && leaf.content == "transcript"
+                && area.height >= 2
+            {
+                out.heading = Some((Rect { height: 1, ..area }, title.clone()));
+                area.y += 1;
+                area.height -= 1;
+            }
+            out.regions.push(Region {
+                path: path.to_owned(),
+                content: leaf.content.clone(),
+                area,
+                style: leaf.style,
+                title: leaf.title.clone(),
+                tabs: outer.map(str::to_owned),
+            });
+        }
+        ModLayout::Split(split) => {
+            let count = split.children.len();
+            let weights = state
+                .ratios
+                .get(path)
+                .filter(|ratios| ratios.len() == count)
+                .cloned()
+                .or_else(|| (split.ratio.len() == count).then(|| split.ratio.clone()))
+                .unwrap_or_else(|| vec![1; count]);
+            let (origin, total) = match split.split {
+                ModSplit::Horizontal => (area.x, area.width),
+                ModSplit::Vertical => (area.y, area.height),
+            };
+            let gaps = u16::try_from(count - 1).unwrap_or(0);
+            let gap = u16::from(split.gap.unwrap_or(0))
+                .min(total.saturating_sub((gaps + 1) * MIN_CELLS) / gaps.max(1));
+            let sizes = distribute(total - gap * gaps, &weights);
+            let mut starts = Vec::with_capacity(count);
+            let mut cursor = origin;
+            for size in &sizes {
+                starts.push(cursor);
+                cursor = cursor.saturating_add(*size + gap);
+            }
+            for (index, child) in split.children.iter().enumerate() {
+                let rect = match split.split {
+                    ModSplit::Horizontal => {
+                        Rect::new(starts[index], area.y, sizes[index], area.height)
+                    }
+                    ModSplit::Vertical => {
+                        Rect::new(area.x, starts[index], area.width, sizes[index])
+                    }
+                };
+                walk(child, rect, (&format!("{path}.{index}"), outer), state, out);
+                if index + 1 < count {
+                    out.handles.push(Handle {
+                        path: path.to_owned(),
+                        index,
+                        split: split.split,
+                        starts: starts.clone(),
+                        sizes: sizes.clone(),
+                        span: match split.split {
+                            ModSplit::Horizontal => (area.y, area.bottom()),
+                            ModSplit::Vertical => (area.x, area.right()),
+                        },
+                    });
+                }
+            }
+        }
+        ModLayout::Tabs(tabs) => {
+            let active = state
+                .active
+                .get(path)
+                .copied()
+                .unwrap_or(tabs.active)
+                .min(tabs.tabs.len().saturating_sub(1));
+            let body = if area.height >= 2 {
+                out.tabs.push(TabBar {
+                    path: path.to_owned(),
+                    area: Rect { height: 1, ..area },
+                    titles: tabs.tabs.iter().map(|tab| tab.title.clone()).collect(),
+                    active,
+                });
+                Rect {
+                    y: area.y + 1,
+                    height: area.height - 1,
+                    ..area
+                }
+            } else {
+                area
+            };
+            if let Some(tab) = tabs.tabs.get(active) {
+                walk(
+                    &tab.node,
+                    body,
+                    (&format!("{path}.{active}"), outer.or(Some(path))),
+                    state,
+                    out,
+                );
+            }
+        }
+    }
+}
+
+pub(crate) fn place(layout: &ModLayout, owner: Option<&str>, area: Rect) -> Placement {
+    with(|state| {
+        if state.layout.as_ref() != Some(layout) {
+            if state.dock.as_ref().is_some_and(|dock| dock.active) {
+                SWALLOW.store(true, Ordering::Relaxed);
+            }
+            *state = State {
+                layout: Some(layout.clone()),
+                ..State::default()
+            };
+        }
+        state.owner = owner.map(str::to_owned);
+        state.screen = area;
+        let mut placement = Placement::default();
+        walk(layout, area, ("r", None), state, &mut placement);
+        state.last = placement.clone();
+        placement
+    })
+}
+
+pub(crate) fn hide() {
+    with(|state| state.last = Placement::default());
+}
+
+pub(crate) fn tab_line(bar: &TabBar) -> Vec<(String, bool)> {
+    bar.titles
+        .iter()
+        .enumerate()
+        .map(|(index, title)| (format!(" {title} "), index == bar.active))
+        .collect()
+}
+
+fn tab_at(bar: &TabBar, column: u16) -> Option<usize> {
+    let mut x = bar.area.x;
+    for (index, (title, _)) in tab_line(bar).into_iter().enumerate() {
+        let width = u16::try_from(unicode_width::UnicodeWidthStr::width(title.as_str()))
+            .unwrap_or(u16::MAX);
+        if column >= x && column < x.saturating_add(width) {
+            return Some(index);
+        }
+        x = x.saturating_add(width);
+    }
+    None
+}
+
+fn zone(last: &Placement, source: &str, column: u16, row: u16) -> Option<Zone> {
+    if last
+        .regions
+        .iter()
+        .any(|region| region.path == source && region.area.contains((column, row).into()))
+    {
+        return None;
+    }
+    let (target, area, centre) = last
+        .regions
+        .iter()
+        .find(|region| {
+            region.content.starts_with("site:") && region.area.contains((column, row).into())
+        })
+        .map(|region| (region.path.clone(), region.area, true))
+        .or_else(|| {
+            let chat = last
+                .chat()
+                .filter(|chat| chat.contains((column, row).into()))?;
+            Some((last.chat_path()?, chat, false))
+        })?;
+    let (left, top) = (u32::from(column - area.x), u32::from(row - area.y));
+    let (width, height) = (u32::from(area.width), u32::from(area.height));
+    let edge = [
+        ("left", left, width),
+        ("right", width - 1 - left, width),
+        ("top", top, height),
+        ("bottom", height - 1 - top, height),
+    ]
+    .into_iter()
+    .filter(|(_, distance, span)| distance * 4 < *span)
+    .min_by_key(|(_, distance, span)| distance * 1000 / span)
+    .map(|(edge, _, _)| edge)
+    .or(centre.then_some("center"))?;
+    let (half_width, half_height) = (area.width / 2, area.height / 2);
+    let shade = match edge {
+        "left" => Rect {
+            width: half_width,
+            ..area
+        },
+        "right" => Rect {
+            x: area.x + half_width,
+            width: area.width - half_width,
+            ..area
+        },
+        "top" => Rect {
+            height: half_height,
+            ..area
+        },
+        "bottom" => Rect {
+            y: area.y + half_height,
+            height: area.height - half_height,
+            ..area
+        },
+        _ => area,
+    };
+    Some(Zone {
+        target,
+        edge,
+        shade,
+    })
+}
+
+pub(crate) fn dock_preview() -> Option<Rect> {
+    with(|state| {
+        let dock = state.dock.as_ref().filter(|dock| dock.active)?;
+        zone(&state.last, &dock.path, dock.at.0, dock.at.1).map(|zone| zone.shade)
+    })
+}
+
+pub(crate) fn cancel_dock() -> bool {
+    with(|state| {
+        let cancelled = state.dock.take().is_some_and(|dock| dock.active);
+        if cancelled {
+            SWALLOW.store(true, Ordering::Relaxed);
+        }
+        cancelled
+    })
+}
+
+fn on_handle(handle: &Handle, column: u16, row: u16) -> bool {
+    let end = handle.starts[handle.index] + handle.sizes[handle.index];
+    let next = handle.starts[handle.index + 1];
+    let (along, across) = match handle.split {
+        ModSplit::Horizontal => (row, column),
+        ModSplit::Vertical => (column, row),
+    };
+    along >= handle.span.0 && along < handle.span.1 && across + 1 >= end && across <= next + 1
+}
+
+pub(crate) fn pointer(event: MouseEvent) -> bool {
+    with(|state| match event.kind {
+        MouseEventKind::Down(MouseButton::Left) => {
+            SWALLOW.store(false, Ordering::Relaxed);
+            state.dock = None;
+            state.drag = None;
+            if let Some((path, index)) = state.last.tabs.iter().find_map(|bar| {
+                (event.row == bar.area.y
+                    && event.column >= bar.area.x
+                    && event.column < bar.area.right())
+                .then(|| tab_at(bar, event.column).map(|index| (bar.path.clone(), index)))
+                .flatten()
+            }) {
+                if let Some(owner) = &state.owner {
+                    crate::mod_surface::layout_event(
+                        owner,
+                        serde_json::json!({"component": path, "kind": "select", "index": index}),
+                    );
+                }
+                state.active.insert(path, index);
+                return true;
+            }
+            state.drag = state
+                .last
+                .handles
+                .iter()
+                .find(|handle| on_handle(handle, event.column, event.row))
+                .map(|handle| (handle.path.clone(), handle.index));
+            state.dock = state
+                .last
+                .regions
+                .iter()
+                .find(|region| {
+                    region.content.starts_with("site:")
+                        && region.grab_row() == Some(event.row)
+                        && region.area.contains((event.column, event.row).into())
+                })
+                .filter(|_| state.drag.is_none())
+                .map(|region| Dock {
+                    path: region.path.clone(),
+                    content: region.content.clone(),
+                    origin: (event.column, event.row),
+                    at: (event.column, event.row),
+                    active: false,
+                });
+            state.drag.is_some()
+        }
+        MouseEventKind::Drag(MouseButton::Left) => {
+            if SWALLOW.load(Ordering::Relaxed) {
+                return true;
+            }
+            if let Some(dock) = &mut state.dock {
+                let at = (event.column, event.row);
+                if at == dock.origin && !dock.active {
+                    return false;
+                }
+                dock.active = true;
+                dock.at = at;
+                return true;
+            }
+            let Some((path, index)) = state.drag.clone() else {
+                return false;
+            };
+            let Some(handle) = state
+                .last
+                .handles
+                .iter()
+                .find(|handle| handle.path == path && handle.index == index)
+                .cloned()
+            else {
+                return false;
+            };
+            let position = match handle.split {
+                ModSplit::Horizontal => event.column,
+                ModSplit::Vertical => event.row,
+            };
+            let start = handle.starts[index];
+            let end = handle.starts[index + 1] + handle.sizes[index + 1];
+            let gap = handle.starts[index + 1].saturating_sub(start + handle.sizes[index]);
+            let boundary = position.clamp(
+                start + MIN_CELLS,
+                end.saturating_sub(MIN_CELLS + gap).max(start + MIN_CELLS),
+            );
+            let mut sizes = handle.sizes;
+            sizes[index] = boundary - start;
+            sizes[index + 1] = end.saturating_sub(boundary + gap);
+            state
+                .ratios
+                .insert(path, sizes.into_iter().map(|size| size.max(1)).collect());
+            true
+        }
+        MouseEventKind::Up(MouseButton::Left) => {
+            if SWALLOW.swap(false, Ordering::Relaxed) {
+                return true;
+            }
+            if let Some(dock) = state.dock.take() {
+                if !dock.active {
+                    return false;
+                }
+                if let (Some(zone), Some(owner)) = (
+                    zone(&state.last, &dock.path, event.column, event.row),
+                    &state.owner,
+                ) {
+                    crate::mod_surface::layout_event(
+                        owner,
+                        serde_json::json!({"component": dock.path, "kind": "dock", "content": dock.content, "target": zone.target, "edge": zone.edge, "columns": state.screen.width, "rows": state.screen.height}),
+                    );
+                }
+                return true;
+            }
+            let Some((path, _)) = state.drag.take() else {
+                return false;
+            };
+            if let Some(sizes) = state.ratios.get(&path) {
+                let total = sizes
+                    .iter()
+                    .map(|size| u32::from(*size))
+                    .sum::<u32>()
+                    .max(1);
+                let ratio = sizes
+                    .iter()
+                    .map(|size| (u32::from(*size) * 100 / total).clamp(1, 100))
+                    .collect::<Vec<_>>();
+                if let Some(owner) = &state.owner {
+                    crate::mod_surface::layout_event(
+                        owner,
+                        serde_json::json!({"component": path, "kind": "resize", "ratio": ratio}),
+                    );
+                }
+            }
+            true
+        }
+        _ => false,
+    })
+}
