+#[test]
+#[serial_test::serial]
+fn dialog_arrows_cross_controls_repeat_and_typing_reaches_a_leading_filter() {
+    let snapshot = snapshot(serde_json::json!({
+        "sites":{"dialog":{"components":[{
+            "type":"dialog","id":"picker","label":"Picker","title":"Picker","children":[
+                {"type":"input","id":"filter","label":"Filter","value":"","autofocus":true,"action":{"command":"m:c","args":"filter"}},
+                {"type":"list","id":"rows","label":"Rows","rows":[
+                    {"value":"a","label":"A","spans":[{"text":"A"}]},
+                    {"value":"b","label":"B","spans":[{"text":"B"}]},
+                    {"value":"c","label":"C","spans":[{"text":"C"}]}],"action":{"command":"m:c","args":"pick"}},
+                {"type":"select","id":"mode","label":"Mode","value":"x","options":[{"value":"x","label":"X"},{"value":"y","label":"Y"}],"action":{"command":"m:c","args":"mode"}},
+                {"type":"button","id":"go","label":"Go","text":"Go","action":{"command":"m:c","args":"go"}}
+            ]
+        }]}}
+    }));
+    sync_interaction(&snapshot.view);
+    let area = Rect::new(0, 0, 80, 24);
+    render(area, area, &mut Buffer::empty(area), &snapshot);
+    let key = |code| input(KeyEvent::new(code, KeyModifiers::NONE), true);
+    let state = || {
+        let interaction = INTERACTION.locked();
+        (
+            interaction.focused.clone().unwrap_or_default(),
+            interaction.selected.get("rows").copied(),
+            interaction.selected.get("mode").copied(),
+        )
+    };
+    assert_eq!(state().0, "filter");
+    key(KeyCode::Down);
+    assert_eq!((state().0, state().1), ("rows".into(), Some(0)));
+    let mut held = KeyEvent::new(KeyCode::Down, KeyModifiers::NONE);
+    held.kind = KeyEventKind::Repeat;
+    input(held, true);
+    input(held, true);
+    assert_eq!(state().1, Some(2), "a held arrow repeats");
+    key(KeyCode::Down);
+    assert_eq!(
+        state().0,
+        "mode",
+        "Down past a list's last row reaches the next control"
+    );
+    key(KeyCode::Up);
+    assert_eq!(
+        (state().0, state().1),
+        ("rows".into(), Some(2)),
+        "entering from below starts at the last row"
+    );
+    assert!(focus("mode"));
+    key(KeyCode::Right);
+    assert_eq!(state().2, Some(1));
+    key(KeyCode::Char(' '));
+    assert_eq!(state().2, Some(0), "Space steps a select");
+    key(KeyCode::Down);
+    assert_eq!(state().0, "go", "Up and Down never change a select");
+    assert!(matches!(
+        key(KeyCode::Char(' ')),
+        Some(ModInput::Interaction(_, ModKeyAction::Command { args, .. })) if args == "go"
+    ));
+    let mut held_enter = KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE);
+    held_enter.kind = KeyEventKind::Repeat;
+    assert!(
+        matches!(input(held_enter, true), Some(ModInput::Consumed)),
+        "a held Enter acts once"
+    );
+    assert!(focus("rows"));
+    key(KeyCode::Char('q'));
+    let interaction = INTERACTION.locked();
+    assert_eq!(interaction.focused.as_deref(), Some("filter"));
+    assert_eq!(interaction.input_values["filter"], "q");
+    drop(interaction);
+    preview(ModViewSnapshot::default());
+}
