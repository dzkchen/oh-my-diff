+struct AssessmentGate(std::sync::Mutex<Vec<(String, bool)>>);
+
+impl codex_extension_api::ApprovalGateContributor for AssessmentGate {
+    fn gate_approval<'a>(
+        &'a self,
+        input: codex_extension_api::ApprovalGateInput<'a>,
+    ) -> ExtensionFuture<'a, ApprovalGate> {
+        self.0
+            .lock()
+            .unwrap()
+            .push((input.host_decision.to_owned(), input.assessment));
+        let pushing = input.details["command"].as_array().is_some_and(|command| {
+            command
+                .iter()
+                .any(|part| part.as_str().is_some_and(|part| part.contains("git push")))
+        });
+        Box::pin(std::future::ready(if pushing {
+            ApprovalGate::Approve("delegate: pushes are fine".into())
+        } else {
+            ApprovalGate::Continue
+        }))
+    }
+
+    fn on_approval_result<'a>(
+        &'a self,
+        _input: codex_extension_api::ApprovalResultInput<'a>,
+    ) -> ExtensionFuture<'a, ()> {
+        Box::pin(std::future::ready(()))
+    }
+}
+
+#[tokio::test]
+async fn checks_assess_through_each_tool_runtime_and_the_approval_gate() -> anyhow::Result<()> {
+    let (mut session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).apply_patch_tool_type =
+            Some(codex_protocol::openai_models::ApplyPatchToolType::Freeform);
+    });
+    let turn = Arc::new(turn);
+    let gate = Arc::new(AssessmentGate(Default::default()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.approval_gate_contributor(gate.clone());
+    let mut parser = PolicyParser::new();
+    parser.parse(
+        "user.rules",
+        r#"prefix_rule(pattern=["rm"], decision="forbidden")
+prefix_rule(pattern=["git", "push"], decision="prompt")"#,
+    )?;
+    session.services.extensions = Arc::new(extensions.build());
+    session.services.exec_policy = Arc::new(crate::exec_policy::ExecPolicyManager::new(Arc::new(
+        parser.build(),
+    )));
+    let session = Arc::new(session);
+    let mut step_context = crate::session::step_context::StepContext::for_test(Arc::clone(&turn));
+    let mcp =
+        codex_mcp::McpBinding::empty(crate::session::tests::mcp_config_for_test(&turn.config));
+    let registry = crate::tools::spec_plan::build_core_tool_registry(
+        &turn,
+        turn.model_info(),
+        &turn.initial_environments,
+        &mcp,
+        /*tool_suggest_candidates*/ None,
+        /*wait_for_environment_tool_config*/ None,
+    );
+    Arc::get_mut(&mut step_context)
+        .expect("step context is uniquely owned")
+        .tool_router = Arc::new(ToolRouter::from_registry(
+        &turn,
+        turn.model_info(),
+        registry,
+        Vec::new(),
+        &Default::default(),
+    ));
+    let invoker = TurnToolInvoker {
+        session: Arc::downgrade(&session),
+        step_context,
+        tracker: Arc::new(tokio::sync::Mutex::new(
+            crate::turn_diff_tracker::TurnDiffTracker::new(),
+        )),
+        cancellation: CancellationToken::new(),
+        execution: Arc::default(),
+    };
+    let check = |tool: &'static str, cmd: &'static str| {
+        let invoker = &invoker;
+        async move {
+            invoker
+                .check(tool, serde_json::json!({"cmd": cmd}))
+                .await
+                .map(|outcome| (outcome.decision, outcome.authority))
+                .map_err(anyhow::Error::msg)
+        }
+    };
+    assert_eq!(check("no_such_tool", "ls").await?, ("deny", "host"));
+    assert_eq!(
+        check("exec_command", "rm -rf build").await?,
+        ("deny", "host")
+    );
+    assert_eq!(
+        check("exec_command", "git push origin main").await?,
+        ("allow", "mod")
+    );
+    assert_eq!(check("write_stdin", "").await?, ("allow", "host"));
+    let patch = invoker
+        .check(
+            "apply_patch",
+            serde_json::json!(
+                "*** Begin Patch\n*** Add File: checked.txt\n+hello\n*** End Patch\n"
+            ),
+        )
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(
+        (patch.decision, patch.authority),
+        ("ask", "host"),
+        "the fixture's default policy asks before patching: {:?}",
+        patch.reason
+    );
+    assert!(
+        gate.0
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|(_, assessment)| *assessment),
+        "checks reach mods as assessments"
+    );
+    assert!(
+        gate.0
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(decision, _)| decision == "ask")
+    );
+    Ok(())
+}
