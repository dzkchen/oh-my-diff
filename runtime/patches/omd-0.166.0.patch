+    let source = fixture
+        .core
+        .runtime
+        .lock()
+        .unwrap()
+        .grants("keeper")
+        .unwrap()
+        .source_sha256;
+    let (mut paged, mut cursor, mut pages) = (String::new(), 0, 0);
+    {
+        let mut scope = fixture.lead.session.data.0.lock().unwrap();
+        let hosts = scope.as_mut().unwrap();
+        loop {
+            let page = hosts
+                .call(
