+#[test]
+fn unverified_peers_get_nothing() {
+    let gate = Arc::new(TestGate {
+        refuse_peer: true,
+        ..TestGate::default()
+    });
+    let (_temp, socket, store) = serve(gate);
+    let mut client = Client::at(&socket).unwrap();
+    assert_eq!(
+        error(client.call("grants.get", json!({"store": store}))),
+        "authority_peer_unverified"
+    );
+}
