+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    fn events() -> crate::app_event_sender::AppEventSender {
+        crate::app_event_sender::AppEventSender::new(tokio::sync::mpsc::unbounded_channel().0)
+    }
+
+    fn encoded(code: KeyCode, modifiers: KeyModifiers, application: bool) -> String {
+        String::from_utf8(key_bytes(KeyEvent::new(code, modifiers), application).unwrap()).unwrap()
+    }
+
+    #[test]
+    fn keys_use_xterm_encodings() {
+        let none = KeyModifiers::NONE;
+        assert_eq!(encoded(KeyCode::Up, none, false), "\x1b[A");
+        assert_eq!(encoded(KeyCode::Up, none, true), "\x1bOA");
+        assert_eq!(
+            encoded(KeyCode::Left, KeyModifiers::CONTROL, true),
+            "\x1b[1;5D"
+        );
+        assert_eq!(
+            encoded(
+                KeyCode::Right,
+                KeyModifiers::SHIFT | KeyModifiers::ALT,
+                false
+            ),
+            "\x1b[1;4C"
+        );
+        assert_eq!(encoded(KeyCode::F(1), none, false), "\x1bOP");
+        assert_eq!(encoded(KeyCode::F(5), none, false), "\x1b[15~");
+        assert_eq!(
+            encoded(KeyCode::F(12), KeyModifiers::SHIFT, false),
+            "\x1b[24;2~"
+        );
+        assert_eq!(encoded(KeyCode::PageUp, none, false), "\x1b[5~");
+        assert_eq!(
+            encoded(KeyCode::PageDown, KeyModifiers::CONTROL, false),
+            "\x1b[6;5~"
