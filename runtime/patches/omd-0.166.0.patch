+    let holder = fixture.hold(std::time::Duration::from_millis(400));
+    let started = Instant::now();
+    assert_eq!(composed_commands(rows.clone()), rows);
+    assert!(started.elapsed() < std::time::Duration::from_millis(50));
+    holder.join().unwrap();
+    wait_until("the command list was never composed", || {
+        composed_commands(rows.clone())[1]["hidden"] == true
+    });
+    assert_eq!(composed_commands(rows)[0]["hidden"], false);
+    *COMPOSED.locked() = None;
+}
+
+#[test]
+#[serial_test::serial]
+fn slash_commands_never_wait_for_a_busy_runtime() {
+    let fixture = BusyFixture::new(
+        "export default api => api.command('hello', () => ({display: 'hi'}));",
+        &["commands"],
+    );
