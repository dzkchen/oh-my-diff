+#[test]
+#[serial_test::serial]
+fn raster_pointers_map_to_the_drawn_frame_pixels() {
+    *FACTS.lock().unwrap() = Some(Facts::default());
+    let mut png = Vec::new();
+    image::RgbImage::from_pixel(8, 4, image::Rgb([1, 2, 3]))
+        .write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png)
+        .expect("png");
+    let frame = json!({"key": "raster-pixels", "image": {"media_type": "image/png",
+        "base64": base64::engine::general_purpose::STANDARD.encode(png)}});
+    let start = std::time::Instant::now();
+    crate::mod_raster::blit(
+        "owner",
+        Some("owner".into()),
+        Some((4, 2)),
