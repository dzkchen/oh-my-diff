diff --git a/codex-rs/models-manager/src/runtime_models.rs b/codex-rs/models-manager/src/runtime_models.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cd8063618e261356a37aff6188a9d70789435685
--- /dev/null
+++ b/codex-rs/models-manager/src/runtime_models.rs
@@ -0,0 +1,54 @@
+//! Models that a runtime provider adds to this process's catalog.
+
+use codex_protocol::openai_models::ModelInfo;
+use std::sync::PoisonError;
+use std::sync::RwLock;
+
+static MODELS: RwLock<Vec<(String, ModelInfo)>> = RwLock::new(Vec::new());
+static NAMES: RwLock<Vec<(String, String)>> = RwLock::new(Vec::new());
+
+/// Replaces the models `provider` adds; an empty list removes them.
+pub fn set(provider: &str, models: Vec<ModelInfo>) {
+    let mut all = MODELS.write().unwrap_or_else(PoisonError::into_inner);
+    all.retain(|(owner, _)| owner != provider);
+    all.extend(
+        models
+            .into_iter()
+            .map(|model| (provider.to_string(), model)),
+    );
+}
+
+/// Names `provider` in the model picker; `None` falls back to its id.
+pub fn set_name(provider: &str, name: Option<String>) {
+    let mut names = NAMES.write().unwrap_or_else(PoisonError::into_inner);
+    names.retain(|(owner, _)| owner != provider);
+    names.extend(name.map(|name| (provider.to_string(), name)));
+}
+
+/// Returns the picker name of `provider`, if one was set.
+pub fn name(provider: &str) -> Option<String> {
+    NAMES
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(owner, _)| owner == provider)
+        .map(|(_, name)| name.clone())
+}
+
+/// Returns every runtime model with its provider id.
+pub fn all() -> Vec<(String, ModelInfo)> {
+    MODELS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .clone()
+}
+
+/// Returns the runtime model with this exact slug and its provider id.
+pub fn find(slug: &str) -> Option<(String, ModelInfo)> {
+    MODELS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .iter()
+        .find(|(_, model)| model.slug == slug)
+        .cloned()
+}
