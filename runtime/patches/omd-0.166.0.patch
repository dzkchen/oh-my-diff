+#[test]
+fn groups_collapse_letters_jump_keywords_match_and_close_reports_the_state() {
+    let arguments = json!({
+        "title": "Mods", "search": true, "selected": "lsp", "close_args": "closed",
+        "action": {"command": "panel", "args": "set"},
