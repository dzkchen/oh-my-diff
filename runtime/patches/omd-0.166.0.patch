+        })
+        .collect()
+}
+
+fn native_cards(snapshot: &ModViewSnapshot, width: u16) -> Option<ModComponent> {
+    const LINES: usize = 4;
+    let panels = native_panels(snapshot);
+    let count = u16::try_from(panels.len()).unwrap_or(u16::MAX).max(1);
+    let text_width = usize::from(
+        (width.saturating_sub(count - 1) / count)
+            .saturating_sub(4)
+            .max(8),
+    );
+    let cards = panels
+        .into_iter()
+        .enumerate()
+        .map(|(index, panel)| {
+            let mut lines = panel.lines;
+            let more = lines.len().saturating_sub(LINES);
+            lines.truncate(LINES);
+            if more > 0 {
+                lines.push(format!("+{more} more"));
+            }
+            let lines = lines
+                .iter()
+                .flat_map(|line| {
+                    let mut wrapped = textwrap::wrap(line, text_width)
+                        .into_iter()
+                        .map(std::borrow::Cow::into_owned)
+                        .collect::<Vec<_>>();
+                    if wrapped.len() > 6 {
+                        wrapped.truncate(6);
+                        wrapped[5].push('…');
+                    }
+                    wrapped
+                })
+                .collect();
+            ModComponent::Box {
+                id: format!("@native_card_{index}"),
+                label: panel.title.clone(),
+                title: Some(panel.title),
+                children: panel_text(&format!("@native_card_{index}"), lines),
+                min_width: None,
+                max_width: None,
+                pointer: false,
+                style: Some(card(snapshot.view.theme.border)),
+                flex: None,
+            }
+        })
+        .collect::<Vec<_>>();
+    (!cards.is_empty()).then(|| ModComponent::Box {
+        id: "@native_cards".into(),
+        label: "Mod status".into(),
+        title: None,
+        children: cards,
+        min_width: None,
+        max_width: None,
+        pointer: false,
+        style: Some(ModBoxStyle {
+            direction: Some(ModDirection::Row),
+            gap: Some(1),
+            ..ModBoxStyle::default()
+        }),
+        flex: None,
+    })
+}
+
+fn site<'a>(view: &'a ModView, name: &str) -> Option<&'a ModRenderSite> {
+    view.sites.get(name)
+}
+
+fn component_height(components: &[ModComponent], width: u16, look: (ModBorder, ModIcons)) -> u16 {
+    components
+        .iter()
+        .map(|component| match component {
+            ModComponent::Box { .. } | ModComponent::Pane { .. } if !component.fits(width) => 0,
+            ModComponent::Box {
+                title,
+                children,
+                style,
+                ..
+            } => {
+                let frame = Frame::new(style.unwrap_or_default(), look, false, false);
+                frame.rows(title.is_some()) + stack_height(children, frame.inner(width), &frame)
+            }
+            ModComponent::Dialog {
+                children, style, ..
+            } => {
+                let frame = Frame::card(*style, look, false, false);
+                frame.rows(true) + stack_height(children, frame.inner(width), &frame)
+            }
+            ModComponent::Pane {
+                collapsed,
+                children,
+                style,
+                ..
+            } => {
+                let mut frame = Frame::card(*style, look, false, false);
+                if *collapsed {
+                    frame.padding.0 = 0;
+                    frame.rows(true)
+                } else {
+                    frame.rows(true) + stack_height(children, frame.inner(width), &frame).min(8)
+                }
+            }
+            ModComponent::Line { .. } => 1,
+            ModComponent::Text { text, .. } | ModComponent::Markdown { text, .. } => {
+                u16::try_from(text.lines().count().max(1)).unwrap_or(u16::MAX)
+            }
+            ModComponent::Code { text, start, .. } => {
+                u16::try_from(text.lines().count().saturating_sub(*start).max(1))
+                    .unwrap_or(u16::MAX)
+            }
+            ModComponent::Button { .. }
+            | ModComponent::Input { .. }
+            | ModComponent::Select { .. } => 1,
+            ModComponent::Multiselect { options, .. } => {
+                u16::try_from(options.len() + 1).unwrap_or(u16::MAX)
+            }
+            ModComponent::List { rows, height, .. } => {
+                u16::try_from(rows.len().clamp(1, usize::from(height.unwrap_or(8))))
+                    .unwrap_or(u16::MAX)
+            }
+            ModComponent::Document {
+                id, lines, height, ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                lines.len().max(12),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Diff {
+                id,
+                unified,
+                height,
+                ..
+            } => u16::try_from(crate::mod_components::height(
+                id,
+                unified.lines().count(),
+                *height,
+            ))
+            .unwrap_or(u16::MAX),
+            ModComponent::Image { height, .. } => height.unwrap_or(12),
+            ModComponent::Raster { height, .. } => height.unwrap_or(RASTER_HEIGHT),
+            ModComponent::Module { id, height, .. } => {
+                height.unwrap_or_else(|| crate::mod_module::height(id))
+            }
+            ModComponent::Terminal { height, .. } => height.unwrap_or(16) + 1,
+            ModComponent::Slot | ModComponent::Native { .. } => 0,
+        })
+        .sum()
+}
+
+/// Leaves only dialogs, progress and diagnostics in the inline viewport once a mod hides its sites.
+pub(crate) fn inline_snapshot(mut snapshot: ModViewSnapshot) -> ModViewSnapshot {
+    if snapshot.view.inline_sites.is_some() {
+        snapshot
+            .view
+            .sites
+            .retain(|name, _| name != "sidebar" && name != "header" && !name.contains('/'));
+        snapshot.view.panels.clear();
+        snapshot.view.header = None;
+    }
+    snapshot
+}
+
+pub(crate) fn header_rows(screen: Rect, snapshot: &ModViewSnapshot) -> u16 {
+    if screen.height < 16 {
+        return 0;
+    }
+    if let Some(header) = site(&snapshot.view, "header") {
+        let width = column(screen, snapshot).width;
+        return component_height(
+            &header.components,
+            width,
+            (snapshot.view.theme.border, snapshot.view.theme.icons),
+        )
+        .clamp(1, 6)
+            + 1;
+    }
+    match &snapshot.view.header {
+        Some(header) => u16::try_from(header.lines.len()).unwrap_or(3).min(3) + 2,
+        None => 0,
+    }
+}
+
+fn named_sites(view: &ModView) -> impl Iterator<Item = &ModRenderSite> {
+    view.sites
+        .iter()
+        .filter(|(name, site)| name.contains('/') && site.overlay.is_none())
+        .map(|(_, site)| site)
+}
+
+fn has_sidebar(snapshot: &ModViewSnapshot) -> bool {
+    site(&snapshot.view, "sidebar").is_some_and(|site| !site.components.is_empty())
+        || named_sites(&snapshot.view).any(|site| !site.components.is_empty())
+        || !snapshot.view.panels.is_empty()
+}
+
+fn sidebar(area: Rect, snapshot: &ModViewSnapshot) -> Option<Rect> {
+    if area.width < 80 || !has_sidebar(snapshot) {
+        return None;
+    }
+    let width = snapshot
+        .view
+        .sidebar_width
+        .clamp(20, 60)
+        .min(area.width / 3);
+    Some(match snapshot.view.sidebar_side {
+        ModSidebarSide::Left => Rect { width, ..area },
+        ModSidebarSide::Right => Rect {
+            x: area.right() - width,
+            width,
+            ..area
+        },
+    })
+}
+
+fn column(area: Rect, snapshot: &ModViewSnapshot) -> Rect {
+    match sidebar(area, snapshot) {
+        Some(bar) if snapshot.view.sidebar_side == ModSidebarSide::Left => Rect {
+            x: bar.right(),
+            width: area.width - bar.width,
+            ..area
+        },
+        Some(bar) => Rect {
+            width: area.width - bar.width,
+            ..area
+        },
+        None => area,
+    }
+}
+
+pub(crate) fn chat_area(area: Rect, snapshot: &ModViewSnapshot, header: u16) -> Rect {
+    let column = column(area, snapshot);
+    let header = header.min(area.height.saturating_sub(1));
+    Rect {
+        y: column.y + header,
+        height: column.height.saturating_sub(header),
+        ..column
+    }
+}
+
+fn panel_style(view: &ModView) -> Style {
+    panel_style_with_colors(view, !crate::mod_client::facts().no_color)
+}
+
+fn panel_style_with_colors(view: &ModView, colors: bool) -> Style {
+    if !colors {
+        return Style::default();
+    }
+    let mut style = Style::default();
+    if let Some(index) = view.foreground {
+        style = style.fg(color(ModColor::Indexed(index)));
+    }
+    if let Some(index) = view.background {
+        style = style.bg(color(ModColor::Indexed(index)));
+    }
+    style
+}
+
+pub(crate) fn tone_style(tone: ModTone) -> Style {
+    tone_style_with_colors(tone, !crate::mod_client::facts().no_color)
+}
+
+fn tone_style_with_colors(tone: ModTone, colors: bool) -> Style {
+    if !colors {
+        return Style::default();
+    }
+    let slot = match tone {
+        ModTone::Normal => return Style::default(),
+        ModTone::Accent => ThemeSlot::Accent,
+        ModTone::Success => ThemeSlot::Success,
+        ModTone::Attention => ThemeSlot::Attention,
+        ModTone::Failure => ThemeSlot::Failure,
+        ModTone::Muted => ThemeSlot::Muted,
+    };
+    theme_color(slot)
+        .map(|color| Style::default().fg(color))
+        .unwrap_or_else(|| match tone {
+            ModTone::Accent => Style::default().fg(Color::Cyan),
+            ModTone::Success => Style::default().fg(Color::Green),
+            ModTone::Failure => Style::default().fg(Color::Red),
+            ModTone::Attention => Style::default().fg(Color::Yellow),
+            ModTone::Muted => Style::default().dim(),
+            _ => Style::default(),
+        })
+}
+
+fn panel_lines(panel: &ModPanel) -> Vec<Line<'static>> {
+    std::iter::once(Line::from(panel.title.clone()).bold())
+        .chain(panel.lines.iter().cloned().map(Line::from))
+        .collect()
+}
+
+/// A command component without a recorded owner, or naming another mod's command, gets no target.
+fn owned_target(mut target: ComponentTarget, owner: Option<&str>) -> Option<ComponentTarget> {
+    let (ComponentTarget::Button(ModComponentAction::Command(action))
+    | ComponentTarget::Input(action)
+    | ComponentTarget::Select { action, .. }
+    | ComponentTarget::ListRow { action, .. }
+    | ComponentTarget::Multiselect { action, .. }
+    | ComponentTarget::Document(Some(action))) = &mut target
+    else {
+        return Some(target);
+    };
+    action.command = codex_omd::owned_command(owner?, &action.command)?;
+    Some(target)
+}
+
+fn component_action(action: &ModComponentAction) -> ModKeyAction {
+    match action {
+        ModComponentAction::Command(action) => ModKeyAction::Command {
+            command: action.command.clone(),
+            args: action.args.clone(),
+        },
+        ModComponentAction::Copy { copy, label } => ModKeyAction::Copy {
+            copy: copy.clone(),
+            label: label.clone(),
+        },
+        ModComponentAction::Insert { insert } => ModKeyAction::Insert {
+            insert: insert.clone(),
+        },
+    }
+}
+
+pub(crate) fn component_lines(
+    components: &[ModComponent],
+    width: u16,
+    list_selected: Option<&str>,
+) -> Vec<Line<'static>> {
+    let mut interaction = Interaction::default();
+    fn select(components: &[ModComponent], value: Option<&str>, interaction: &mut Interaction) {
+        for component in components {
+            match component {
+                ModComponent::List { id, rows, .. } => {
+                    if let Some(index) =
+                        value.and_then(|value| rows.iter().position(|row| row.value == value))
+                    {
+                        interaction.selected.insert(id.clone(), index);
+                    }
+                }
+                ModComponent::Box { children, .. }
+                | ModComponent::Pane { children, .. }
+                | ModComponent::Dialog { children, .. } => select(children, value, interaction),
+                _ => {}
+            }
+        }
+    }
+    select(components, list_selected, &mut interaction);
+    component_rows(components, width, &mut interaction, look())
+        .into_iter()
+        .map(|row| row.line)
+        .collect()
+}
+
+fn push_region_rows(
+    rows: &mut Vec<ComponentRow>,
+    id: &str,
+    label: &str,
+    lines: Vec<Line<'static>>,
+    pointer: bool,
+) {
+    rows.extend(
+        lines
+            .into_iter()
+            .enumerate()
+            .map(|(row, line)| ComponentRow {
+                id: Some(id.to_owned()),
+                label: Some(label.to_owned()),
+                links: Vec::new(),
+                line,
+                target: None,
+                regions: if pointer {
+                    vec![Held {
+                        id: id.to_owned(),
+                        x: 0,
+                        top: u16::try_from(row).unwrap_or(u16::MAX),
+                        width: u16::MAX,
+                        events: true,
+                        hover: false,
+                    }]
+                } else {
+                    Vec::new()
+                },
+                ..ComponentRow::default()
+            }),
+    );
+}
+
+fn component_rows(
+    components: &[ModComponent],
+    width: u16,
+    interaction: &mut Interaction,
+    look: (ModBorder, ModIcons),
+) -> Vec<ComponentRow> {
+    let mut rows = Vec::new();
+    for component in components {
+        match component {
+            ModComponent::Box { .. } | ModComponent::Pane { .. } if !component.fits(width) => {}
+            ModComponent::Box {
+                id,
+                title,
+                children,
+                pointer,
+                style,
+                ..
+            } => {
+                let style = style.unwrap_or_default();
+                let frame = Frame::new(
+                    style,
+                    look,
+                    interaction.hovered.contains_key(id),
+                    focus_within(component, interaction),
+                );
+                let head = title.as_ref().map(|title| ComponentRow {
+                    line: Line::from(title.clone()).bold(),
+                    ..ComponentRow::default()
+                });
+                let body = stack(children, frame.inner(width), &frame, interaction);
+                let start = rows.len();
+                rows.extend(framed(&frame, width, head, body));
+                hold(
+                    &mut rows[start..],
+                    id,
+                    &frame,
+                    width,
+                    *pointer,
+                    style.hover.is_some(),
+                );
+            }
+            ModComponent::Text {
+                id,
+                label,
+                text,
+                tone,
+            } => {
+                for (index, text) in text.lines().enumerate() {
+                    rows.push(ComponentRow {
+                        id: (index == 0).then(|| id.clone()),
+                        label: (index == 0).then(|| label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(text.to_owned()).patch_style(tone_style(*tone)),
+                        target: None,
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Line { id, label, spans } => {
+                let (line, links) = span_line(String::new(), spans);
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links,
+                    line,
+                    target: None,
+                    regions: Vec::new(),
+                    ..ComponentRow::default()
+                });
+            }
+            ModComponent::Button {
+                id,
+                label,
+                text,
+                action,
+                ..
+            } => rows.push(ComponentRow {
+                id: Some(id.clone()),
+                label: Some(label.clone()),
+                links: Vec::new(),
+                line: Line::from(format!("[ {text} ]")),
+                target: Some(ComponentTarget::Button(action.clone())),
+                regions: Vec::new(),
+                ..ComponentRow::default()
+            }),
+            ModComponent::Input {
+                id,
+                label,
+                value,
+                placeholder,
+                action,
+                ..
+            } => {
+                let current = interaction
+                    .input_values
+                    .entry(id.clone())
+                    .or_insert_with(|| value.clone())
+                    .clone();
+                let shown = if interaction.focused.as_ref() == Some(id) {
+                    let cursor = interaction.input_cursor.get(id).copied();
+                    let at = cursor
+                        .and_then(|cursor| current.char_indices().nth(cursor))
+                        .map_or(current.len(), |(byte, _)| byte);
+                    format!(
+                        "{}{}{}",
+                        &current[..at],
+                        glyph_in(look, "▏", "|"),
+                        &current[at..]
+                    )
+                } else if current.is_empty() {
+                    placeholder.clone()
+                } else {
+                    current
+                };
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links: Vec::new(),
+                    line: Line::from(format!("{label}: {shown}")),
+                    target: Some(ComponentTarget::Input(action.clone())),
+                    regions: Vec::new(),
+                    ..ComponentRow::default()
+                });
+            }
+            ModComponent::Select {
+                id,
+                label,
+                value,
+                options,
+                action,
+                ..
+            } => {
+                let fallback = options
+                    .iter()
+                    .position(|option| option.value == *value)
+                    .unwrap_or_default();
+                let selected = interaction.selected.entry(id.clone()).or_insert(fallback);
+                *selected = (*selected).min(options.len().saturating_sub(1));
+                let shown = options
+                    .get(*selected)
+                    .map(|option| option.label.as_str())
+                    .unwrap_or(glyph_in(look, "—", "-"));
+                rows.push(ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    links: Vec::new(),
+                    line: Line::from(match unicode(look) {
+                        true => format!("{label}: ‹ {shown} ›"),
+                        false => format!("{label}: < {shown} >"),
+                    }),
+                    target: Some(ComponentTarget::Select {
+                        action: action.clone(),
+                        options: options
+                            .iter()
+                            .map(|option| (option.value.clone(), option.label.clone()))
+                            .collect(),
+                    }),
+                    regions: Vec::new(),
+                    ..ComponentRow::default()
+                });
+            }
+            ModComponent::Multiselect {
+                id,
+                label,
+                value,
+                options,
+                action,
+                ..
+            } => {
+                let checked = interaction
+                    .checked
+                    .entry(id.clone())
+                    .or_insert_with(|| value.iter().cloned().collect())
+                    .clone();
+                let current = interaction.selected.entry(id.clone()).or_insert(0);
+                *current = (*current).min(options.len().saturating_sub(1));
+                let (current, focused) = (*current, interaction.focused.as_ref() == Some(id));
+                let values = options
+                    .iter()
+                    .map(|option| (option.value.clone(), option.label.clone()))
+                    .collect::<Arc<[_]>>();
+                rows.push(ComponentRow {
+                    id: None,
+                    label: None,
+                    links: Vec::new(),
+                    line: Line::from(format!("{label}:")),
+                    target: None,
+                    regions: Vec::new(),
+                    ..ComponentRow::default()
+                });
+                for (index, option) in options.iter().enumerate() {
+                    let mark = if checked.contains(&option.value) {
+                        "[x]"
+                    } else {
+                        "[ ]"
+                    };
+                    let line = Line::from(format!("  {mark} {}", option.label));
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: if focused && index == current {
+                            line.bold()
+                        } else {
+                            line
+                        },
+                        target: Some(ComponentTarget::Multiselect {
+                            action: action.clone(),
+                            options: values.clone(),
+                            index,
+                        }),
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Markdown { id, label, text } => {
+                for (index, line) in markdown_lines(text, width).iter().enumerate() {
+                    rows.push(ComponentRow {
+                        id: (index == 0).then(|| id.clone()),
+                        label: (index == 0).then(|| label.clone()),
+                        links: line.hyperlinks.clone(),
+                        line: line.line.clone(),
+                        target: None,
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Code {
+                id,
+                label,
+                text,
+                language,
+                start,
+            } => {
+                if let Some(language) = language {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(language.clone()).dim(),
+                        target: None,
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+                for line in code_lines(text, language.as_deref().unwrap_or_default())
+                    .iter()
+                    .skip(*start)
+                {
+                    rows.push(ComponentRow {
+                        id: None,
+                        label: None,
+                        links: Vec::new(),
+                        line: line.line.clone(),
+                        target: None,
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Pane {
+                id,
+                label,
+                title,
+                collapsed,
+                scroll,
+                keys,
+                children,
+                pointer,
+                style,
+                ..
+            } => {
+                register_keys(interaction, id, *keys);
+                let collapsed = *interaction
+                    .collapsed
+                    .entry(id.clone())
+                    .or_insert(*collapsed);
+                let style = style.unwrap_or_default();
+                let mut frame = Frame::card(
+                    Some(style),
+                    look,
+                    interaction.hovered.contains_key(id),
+                    focus_within(component, interaction),
+                );
+                let marker = match (collapsed, unicode(look)) {
+                    (true, true) => "▸",
+                    (true, false) => ">",
+                    (false, true) => "▾",
+                    (false, false) => "v",
+                };
+                let mut head = ComponentRow {
+                    id: Some(id.clone()),
+                    label: Some(label.clone()),
+                    line: Line::from(format!("{marker} {}", title.as_deref().unwrap_or(label)))
+                        .bold(),
+                    target: Some(ComponentTarget::Pane),
+                    ..ComponentRow::default()
+                };
+                let body = if collapsed {
+                    frame.padding.0 = 0;
+                    Vec::new()
+                } else {
+                    let mut nested = stack(children, frame.inner(width), &frame, interaction);
+                    for row in &mut nested {
+                        row.take_columns(&mut head.columns);
+                    }
+                    let limit =
+                        u16::try_from(nested.len().saturating_sub(PANE_ROWS)).unwrap_or(u16::MAX);
+                    interaction.scroll_limits.insert(id.clone(), limit);
+                    let offset = interaction.scroll.entry(id.clone()).or_insert(*scroll);
+                    *offset = (*offset).min(limit);
+                    let window = usize::from(*offset)..usize::from(*offset) + PANE_ROWS;
+                    let mut kept = Vec::new();
+                    for (index, row) in nested.into_iter().enumerate() {
+                        if window.contains(&index) {
+                            kept.push(row);
+                        } else {
+                            note_terminals(&row, false, interaction);
+                        }
+                    }
+                    kept
+                };
+                let start = rows.len();
+                rows.extend(framed(&frame, width, Some(head), body));
+                hold(
+                    &mut rows[start..],
+                    id,
+                    &frame,
+                    width,
+                    *pointer,
+                    style.hover.is_some(),
+                );
+            }
+            ModComponent::Dialog {
+                title,
+                children,
+                style,
+                ..
+            } => {
+                let frame = Frame::card(*style, look, false, false);
+                let head = ComponentRow {
+                    line: Line::from(title.clone()).bold(),
+                    ..ComponentRow::default()
+                };
+                let body = stack(children, frame.inner(width), &frame, interaction);
+                rows.extend(framed(&frame, width, Some(head), body));
+            }
+            ModComponent::List {
+                id,
+                label,
+                rows: items,
+                selected,
+                height,
+                action,
+                ..
+            } => {
+                if items.is_empty() {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line: Line::from(format!("{label}: (empty)")).dim(),
+                        target: None,
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                    continue;
+                }
+                let options = items
+                    .iter()
+                    .map(|row| (row.value.clone(), row.label.clone()))
+                    .collect::<Arc<[_]>>();
+                let fallback = selected
+                    .as_ref()
+                    .and_then(|value| items.iter().position(|row| row.value == *value))
+                    .unwrap_or_default();
+                let current = interaction.selected.entry(id.clone()).or_insert(fallback);
+                *current = (*current).min(items.len() - 1);
+                let current = *current;
+                let window = usize::from(height.unwrap_or(8)).max(1);
+                let start = (current + 1)
+                    .saturating_sub(window)
+                    .min(items.len().saturating_sub(window));
+                let marker = glyph_in(look, "› ", "> ");
+                for (index, item) in items.iter().enumerate().skip(start).take(window) {
+                    let chosen = index == current;
+                    let lead = (if chosen { marker } else { "  " }).to_owned();
+                    let (line, links) = if item.spans.is_empty() {
+                        (Line::from(format!("{lead}{}", item.label)), Vec::new())
+                    } else {
+                        span_line(lead, &item.spans)
+                    };
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links,
+                        line: if chosen { line.bold() } else { line },
+                        target: Some(ComponentTarget::ListRow {
+                            action: action.clone(),
+                            options: options.clone(),
+                            index,
+                        }),
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Document {
+                id,
+                label,
+                lines,
+                source,
+                anchors,
+                selected,
+                find,
+                height,
+                action,
+                keys,
+            } => {
+                let content = match source {
+                    Some(source) => crate::mod_components::Content::Source(source),
+                    None => crate::mod_components::Content::Spans(lines),
+                };
+                register_keys(interaction, id, *keys);
+                let focused = interaction.focused.as_deref() == Some(id.as_str());
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                for line in crate::mod_components::rows(
+                    id,
+                    content,
+                    anchors,
+                    *selected,
+                    find.as_ref(),
+                    *height,
+                    &owners,
+                    focused,
+                    !keys.is_off(),
+                    "",
+                ) {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line,
+                        target: Some(ComponentTarget::Document(action.clone())),
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Diff {
+                id,
+                label,
+                unified,
+                selected,
+                height,
+                action,
+            } => {
+                let focused = interaction.focused.as_deref() == Some(id.as_str());
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                for line in crate::mod_components::rows(
+                    id,
+                    crate::mod_components::Content::Diff(unified),
+                    &[],
+                    *selected,
+                    None,
+                    *height,
+                    &owners,
+                    focused,
+                    false,
+                    "",
+                ) {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links: Vec::new(),
+                        line,
+                        target: Some(ComponentTarget::Document(action.clone())),
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Terminal {
+                id,
+                label,
+                session,
+                height,
+                ..
+            } => {
+                let binding = interaction
+                    .component_owners
+                    .get(id)
+                    .and_then(|owner| interaction.pty_bindings.get(owner))
+                    .cloned();
+                let focused = interaction.focused.as_deref() == Some(id.as_str());
+                for (row, (line, links)) in crate::mod_pty::rows(
+                    binding.as_ref(),
+                    session,
+                    id,
+                    width,
+                    height.unwrap_or(16),
+                    "",
+                    focused,
+                )
+                .into_iter()
+                .enumerate()
+                {
+                    rows.push(ComponentRow {
+                        id: Some(id.clone()),
+                        label: Some(label.clone()),
+                        links,
+                        line,
+                        target: Some(ComponentTarget::Terminal(
+                            session.clone(),
+                            binding.clone(),
+                            u16::try_from(row).unwrap_or(u16::MAX),
+                        )),
+                        regions: Vec::new(),
+                        ..ComponentRow::default()
+                    });
+                }
+            }
+            ModComponent::Image {
+                id,
+                label,
+                image,
+                alt,
+                height,
+                pointer,
+            } => {
+                let owners = interaction
+                    .component_owners
+                    .get(id)
+                    .cloned()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                let lines = crate::mod_components::image_rows(
+                    id,
+                    image,
+                    alt,
+                    width,
+                    height.unwrap_or(12),
+                    &owners,
+                    "",
+                );
+                push_region_rows(&mut rows, id, label, lines, *pointer);
+            }
+            ModComponent::Raster {
+                id,
+                label,
+                alt,
+                width: columns,
+                height: rows_high,
+                pointer,
+            } => {
+                let available = width.max(1);
+                crate::mod_raster::track(
+                    id,
+                    interaction.thread.as_deref(),
+                    interaction.component_owners.get(id).map(String::as_str),
+                    available.min(columns.unwrap_or(available)),
+                    (
+                        columns.unwrap_or(available),
+                        rows_high.unwrap_or(RASTER_HEIGHT),
+                    ),
+                );
+                let started = std::time::Instant::now();
+                let (lines, next) = crate::mod_raster::rows(
+                    id,
+                    interaction.component_owners.get(id).map(String::as_str),
+                    alt,
+                    available,
+                    (
+                        columns.unwrap_or(available),
+                        rows_high.unwrap_or(RASTER_HEIGHT),
+                    ),
+                    crate::mod_client::facts().no_color,
+                    "",
+                    started,
+                );
+                if let Some(next) = next {
+                    crate::mod_render::schedule_frame(next.saturating_sub(started.elapsed()));
+                }
+                push_region_rows(&mut rows, id, label, lines, *pointer);
+            }
+            ModComponent::Module {
+                id,
+                label,
+                module,
+                props,
+                height,
+                keys,
+                pointer,
+            } => {
+                register_keys(interaction, id, *keys);
+                let lines = crate::mod_module::rows(
+                    id,
+                    interaction.component_owners.get(id).map(String::as_str),
+                    module,
+                    props,
+                    width.max(1),
+                    *height,
+                );
+                push_region_rows(&mut rows, id, label, lines, *pointer || !keys.is_off());
+            }
+            ModComponent::Slot | ModComponent::Native { .. } => {}
+        }
+    }
+    rows
+}
+
+fn render_site(
+    area: Rect,
+    components: &[ModComponent],
+    style: Style,
+    buffer: &mut Buffer,
+    interaction: &mut Interaction,
+    frame: Frame,
+    title: Option<Line<'static>>,
+) -> Option<Rect> {
+    if area.is_empty() {
+        return None;
+    }
+    let inner = frame.draw(area, title, buffer);
+    let rows = stack(components, inner.width.max(1), &frame, interaction);
+    let scroll = focused_scroll(&rows, inner.height, interaction);
+    let window = scroll..scroll + usize::from(inner.height);
+    for (index, row) in rows.iter().enumerate() {
+        note_terminals(row, window.contains(&index), interaction);
+    }
+    let lines = rows
+        .iter()
+        .skip(scroll)
+        .take(usize::from(inner.height))
+        .map(|row| borrowed(&row.line))
+        .collect::<Vec<_>>();
+    Paragraph::new(lines)
+        .style(style.patch(frame.style()))
+        .render(inner, buffer);
+    mark_links(buffer, inner, &rows[scroll.min(rows.len())..]);
+    register_component_targets(inner, rows, scroll, interaction);
+    Some(inner)
+}
+
+fn note_terminals(row: &ComponentRow, shown: bool, interaction: &mut Interaction) {
+    if let (Some(ComponentTarget::Terminal(session, binding, _)), Some(id)) = (&row.target, &row.id)
+    {
+        let owner = interaction
+            .component_owners
+            .get(id)
+            .cloned()
+            .unwrap_or_default();
+        interaction
+            .terminal_draws
+            .entry((owner, session.clone()))
+            .or_insert_with(|| (false, binding.clone()))
+            .0 |= shown;
+    }
+    for beside in &row.beside {
+        note_terminals(beside, shown, interaction);
+    }
+}
+
+/// Returns the terminals it showed.
+fn settle_terminals(
+    interaction: &mut Interaction,
+) -> Vec<(String, Option<crate::mod_pty::Binding>)> {
+    let mut shown_terminals = Vec::new();
+    for ((_, session), (shown, binding)) in std::mem::take(&mut interaction.terminal_draws) {
+        crate::mod_pty::set_shown(binding.as_ref(), &session, shown);
+        if shown {
+            shown_terminals.push((session, binding));
+        }
+    }
+    shown_terminals
+}
+
+/// For sites drawn outside the full render, which show all of their rows or none.
+fn settle_drawn_terminals(
+    rows: &[ComponentRow],
+    shown: bool,
+    interaction: &mut Interaction,
+) -> Vec<(String, Option<crate::mod_pty::Binding>)> {
+    for row in rows {
+        note_terminals(row, shown, interaction);
+    }
+    settle_terminals(interaction)
+}
+
+/// For a frame that doesn't draw the welcome.
+pub(crate) fn hide_welcome_terminals() {
+    let shown = std::mem::take(&mut INTERACTION.locked().welcome_terminals);
+    for (session, binding) in shown {
+        crate::mod_pty::set_shown(binding.as_ref(), &session, false);
+    }
+}
+
+fn focused_scroll(rows: &[ComponentRow], height: u16, interaction: &Interaction) -> usize {
+    fn cells(row: &ComponentRow) -> Vec<&ComponentRow> {
+        std::iter::once(row)
+            .chain(row.beside.iter().flat_map(cells))
+            .collect()
+    }
+    let focused_row = interaction.focused.as_ref().and_then(|focused| {
+        let cursor = interaction.selected.get(focused).copied();
+        let mut own = rows
+            .iter()
+            .enumerate()
+            .flat_map(|(index, row)| cells(row).into_iter().map(move |row| (index, row)))
+            .filter(|(_, row)| row.target.is_some() && row.id.as_ref() == Some(focused));
+        let first = own.next();
+        std::iter::once(first)
+            .flatten()
+            .chain(own)
+            .find(|(_, row)| match &row.target {
+                Some(
+                    ComponentTarget::Multiselect { index, .. }
+                    | ComponentTarget::ListRow { index, .. },
+                ) => Some(*index) == cursor,
+                _ => true,
+            })
+            .or(first)
+            .map(|(row, _)| row)
+    });
+    focused_row.map_or(0, |row| (row + 1).saturating_sub(usize::from(height)))
+}
+
+/// Every target joins the focus order; only rows scrolled into view get a hitbox.
+fn register_component_targets(
+    inner: Rect,
+    rows: Vec<ComponentRow>,
+    scroll: usize,
+    interaction: &mut Interaction,
+) {
+    for (index, row) in rows.into_iter().enumerate() {
+        let row_top = index
+            .checked_sub(scroll)
+            .and_then(|offset| u16::try_from(offset).ok())
+            .filter(|offset| *offset < inner.height)
+            .map(|offset| inner.y + offset);
+        let whole = row.beside.is_empty();
+        register_row(inner, row_top, row, whole, interaction);
+    }
+    column_order(interaction);
+}
+
+/// A row sharing its line with columns gets a hitbox over its own cells, not the whole line.
+fn register_row(
+    inner: Rect,
+    row_top: Option<u16>,
+    mut row: ComponentRow,
+    whole: bool,
+    interaction: &mut Interaction,
+) {
+    interaction.columns.append(&mut row.columns);
+    let beside = |indent: u16, width: u16| {
+        let room = inner.width.saturating_sub(indent);
+        row_top
+            .filter(|_| room > 0 && width > 0)
+            .map(|y| Rect::new(inner.x + indent, y, width.min(room), 1))
+    };
+    let own = beside(row.indent, row.own());
+    let area = if whole {
+        row_top.map(|y| Rect::new(inner.x, y, inner.width, 1))
+    } else {
+        own
+    };
+    for held in std::mem::take(&mut row.regions) {
+        let Some(area) = beside(held.x, held.width).map(|box_area| {
+            own.filter(|_| row.id.as_ref() == Some(&held.id))
+                .unwrap_or(box_area)
+        }) else {
+            continue;
+        };
+        interaction
+            .anchors
+            .entry(held.id.clone())
+            .and_modify(|anchor| *anchor = anchor.union(area))
+            .or_insert(area);
+        if !held.events && !held.hover {
+            continue;
+        }
+        let layer = interaction.layer;
+        match interaction
+            .regions
+            .iter_mut()
+            .find(|region| region.id == held.id && region.layer == layer)
+        {
+            Some(region) => region.area = region.area.union(area),
+            None => interaction.regions.push(Region {
+                id: held.id,
+                area,
+                top: held.top,
+                layer,
+                events: held.events,
+                hover: held.hover,
+            }),
+        }
+    }
+    if let (Some(id), Some(area)) = (&row.id, own) {
+        interaction
+            .anchors
+            .entry(id.clone())
+            .and_modify(|anchor| *anchor = anchor.union(area))
+            .or_insert(area);
+    }
+    if let Some(id) = &row.id
+        && row.target.is_none()
+        && interaction.key_panes.contains(id)
+        && !interaction.order.contains(id)
+    {
+        interaction.order.push(id.clone());
+    }
+    let owner = row
+        .id
+        .as_ref()
+        .and_then(|id| interaction.component_owners.get(id))
+        .cloned();
+    if let Some(target) = row
+        .target
+        .and_then(|target| owned_target(target, owner.as_deref()))
+    {
+        let id = row.id.unwrap_or_default();
+        let label = row.label.unwrap_or_else(|| id.clone());
+        interaction.targets.insert(id.clone(), target.clone());
+        if !interaction.order.contains(&id) {
+            interaction.order.push(id.clone());
+        }
+        if let Some(area) = area {
+            interaction.hitboxes.push(HitBox {
+                id,
+                label,
+                area,
+                target,
+                layer: interaction.layer,
+            });
+        }
+    }
+    for column in row.beside {
+        register_row(inner, row_top, column, false, interaction);
+    }
+}
+
+fn borrowed<'a>(line: &'a Line<'_>) -> Line<'a> {
+    Line {
+        style: line.style,
+        alignment: line.alignment,
+        spans: line
+            .spans
+            .iter()
+            .map(|span| ratatui::text::Span::styled(span.content.as_ref(), span.style))
+            .collect(),
+    }
+}
+
+/// Paints only in the transcript's cleared remainder, never over transcript, prompt or modal cells; the caller gates this on native fresh-thread facts.
+pub(crate) fn render_welcome(available: Rect, buffer: &mut Buffer, snapshot: &ModViewSnapshot) {
+    let Some(welcome) = site(&snapshot.view, "welcome")
+        .filter(|_| !welcome_hidden(&snapshot.view) && !available.is_empty())
+    else {
+        return hide_welcome_terminals();
+    };
+    let mut interaction = INTERACTION.locked();
+    // The startup draft draws the welcome before any full render installs the owners.
+    interaction.component_owners = snapshot.component_owners.clone();
+    let rows = component_rows(
+        &welcome.components,
+        available.width,
+        &mut interaction,
+        (snapshot.view.theme.border, snapshot.view.theme.icons),
+    );
+    let height = u16::try_from(rows.len()).unwrap_or(u16::MAX);
+    let width = rows
+        .iter()
+        .map(|row| row.line.width())
+        .max()
+        .unwrap_or_default();
+    let width = u16::try_from(width)
+        .unwrap_or(u16::MAX)
+        .min(available.width);
+    let fits = width != 0 && height <= available.height;
+    interaction.welcome_terminals = settle_drawn_terminals(&rows, fits, &mut interaction);
+    if !fits {
+        interaction.columns.clear();
+        return;
+    }
+    let stage = Rect::new(
+        available.x + (available.width - width) / 2,
+        available.y + (available.height - height) / 2,
+        width,
+        height,
+    );
+    Paragraph::new(
+        rows.iter()
+            .map(|row| borrowed(&row.line))
+            .collect::<Vec<_>>(),
+    )
+    .style(panel_style(&snapshot.view))
+    .render(stage, buffer);
+    mark_links(buffer, stage, &rows);
+    register_component_targets(stage, rows, 0, &mut interaction);
+}
+
+fn bind_terminals(interaction: &mut Interaction, snapshot: &ModViewSnapshot) {
+    if interaction
+        .focused
+        .as_ref()
+        .is_none_or(|id| !interaction.terminals.contains(id))
+    {
+        interaction.prior_focus = (
+            interaction.focused.clone(),
+            interaction.focus_region.clone(),
+        );
+    }
+    let thread = snapshot.input["ledger"]["thread_id"].as_str();
+    interaction.thread = thread.map(str::to_owned);
+    let epoch = snapshot.input["pty_scope"]["epoch"].as_u64();
+    let admission = snapshot.input["pty_scope"]["admission"].as_u64();
+    let configuration = snapshot.input["pty_scope"]["configuration"].as_str();
+    interaction.pty_bindings = snapshot
+        .contributors
+        .iter()
+        .filter_map(|owner| {
+            crate::mod_pty::view_binding(owner, thread, epoch?, admission?, configuration?)
+                .ok()
+                .map(|binding| (owner.clone(), binding))
+        })
+        .collect();
+}
+
+/// Returns the content area of each `owner/name` site it drew, for `mod_client::record_sites`.
+pub(crate) fn render(
+    area: Rect,
+    chat: Rect,
+    buffer: &mut Buffer,
+    snapshot: &ModViewSnapshot,
+) -> BTreeMap<String, (u16, u16)> {
+    let style = panel_style(&snapshot.view);
+    let mut interaction = INTERACTION.locked();
+    begin_regions(&mut interaction, snapshot, Vec::new(), Vec::new());
+    interaction.targets.clear();
+    interaction.key_panes.clear();
+    interaction.order.clear();
+    interaction.columns.clear();
+    interaction.hitboxes.clear();
+    interaction.regions.clear();
+    interaction.layers.clear();
+    interaction.anchors.clear();
+    interaction.layer = 0;
+    interaction.owners = snapshot.contributors.clone();
+    interaction.component_owners = snapshot.component_owners.clone();
+    bind_terminals(&mut interaction, snapshot);
+    footer::register_footer(&mut interaction);
+    if let Some(bar) = sidebar(area, snapshot) {
+        let mut components = site(&snapshot.view, "sidebar")
+            .map(|site| site.components.clone())
+            .unwrap_or_default();
+        for named in named_sites(&snapshot.view) {
+            components.extend(named.components.iter().cloned());
+        }
+        for (index, panel) in snapshot.view.panels.iter().cloned().enumerate() {
+            components.push(ModComponent::Pane {
+                id: format!("@native_panel_{index}"),
+                label: panel.title.clone(),
+                title: Some(panel.title),
+                collapsed: false,
+                scroll: 0,
+                keys: ModKeys::Off,
+                children: panel_text(&format!("@native_panel_{index}"), panel.lines),
+                min_width: None,
+                max_width: None,
+                pointer: false,
+                style: None,
+                flex: None,
+            });
+        }
+        let theme = &snapshot.view.theme;
+        let frame = Frame::new(
+            snapshot
+                .view
+                .sidebar_style
+                .unwrap_or_default()
+                .over(ModBoxStyle {
+                    gap: Some(u8::from(theme.density == ModDensity::Comfortable)),
+                    ..ModBoxStyle::default()
+                }),
+            (theme.border, theme.icons),
+            false,
+            false,
+        );
+        let title = frame
+            .border
+            .map(|_| Line::from(snapshot.view.title.clone().unwrap_or_else(|| "Mods".into())));
+        render_site(
+            bar,
+            &components,
+            style,
+            buffer,
+            &mut interaction,
+            frame,
+            title,
+        );
+    }
+    let column = column(area, snapshot);
+    let height = chat.y.saturating_sub(column.y);
+    if height > 0 {
+        let look = (snapshot.view.theme.border, snapshot.view.theme.icons);
+        let rule = Block::default().borders(Borders::BOTTOM).border_set(
+            Frame::new(card(look.0), look, false, false)
+                .border
+                .unwrap_or_default(),
+        );
+        if let Some(header) = site(&snapshot.view, "header") {
+            let area = Rect { height, ..column };
+            rule.render(area, buffer);
+            render_site(
+                Rect {
+                    height: height - 1,
+                    ..area
+                },
+                &header.components,
+                style,
+                buffer,
+                &mut interaction,
+                Frame::new(ModBoxStyle::default(), look, false, false),
+                None,
+            );
+        } else if let Some(header) = &snapshot.view.header {
+            Paragraph::new(panel_lines(header))
+                .style(style)
+                .block(rule)
+                .render(Rect { height, ..column }, buffer);
+        }
+    }
+    let mut drawn = BTreeMap::new();
+    render_overlays(area, snapshot, style, buffer, &mut interaction, &mut drawn);
+    render_dialog(area, chat, snapshot, style, buffer, &mut interaction);
+    settle_terminals(&mut interaction);
+    highlight_focus(buffer, &mut interaction);
+    drawn
+}
+
+fn highlight_focus(buffer: &mut Buffer, interaction: &mut Interaction) {
+    if interaction.typed != interaction.focused {
+        interaction.typed = None;
+    }
+    if let Some(focused) = interaction.focused.clone()
+        && let Some(hitbox) = interaction
+            .hitboxes
+            .iter()
+            .find(|hitbox| hitbox.id == focused)
+    {
+        buffer.set_style(hitbox.area, crate::style::accent_style());
+        let terminal = interaction.terminals.contains(&focused);
+        let hint = if terminal && interaction.focus_region.is_some() {
+            " Ctrl+] twice for chat "
+        } else if terminal {
+            " Ctrl+] back to chat "
+        } else {
+            " Ctrl+] leaves, Ctrl+C cancels "
+        };
+        let width = hint.len() as u16;
+        let shown = if terminal {
+            interaction.typed.is_none()
+        } else {
+            interaction.key_panes.contains(&focused)
+        };
+        if shown && hitbox.area.width >= width + 8 {
+            buffer.set_string(
+                hitbox.area.right() - width,
+                hitbox.area.y,
+                hint,
+                crate::style::accent_style().reversed(),
+            );
+        }
+    }
+}
+
+fn overlay_area(
+    screen: Rect,
+    overlay: &codex_omd::ModOverlay,
+    anchors: &BTreeMap<String, Rect>,
+) -> Option<Rect> {
+    use codex_omd::ModAnchor;
+    use codex_omd::ModScreenAnchor;
+    let (width, height) = (i32::from(overlay.width), i32::from(overlay.height));
+    let (left, top) = (i32::from(screen.x), i32::from(screen.y));
+    let (right, bottom) = (i32::from(screen.right()), i32::from(screen.bottom()));
+    let (x, y, clip) = match &overlay.anchor {
+        ModAnchor::Screen(ModScreenAnchor::TopLeft) => (left, top, screen),
+        ModAnchor::Screen(ModScreenAnchor::TopRight) => (right - width, top, screen),
+        ModAnchor::Screen(ModScreenAnchor::BottomLeft) => (left, bottom - height, screen),
+        ModAnchor::Screen(ModScreenAnchor::BottomRight) => (right - width, bottom - height, screen),
+        ModAnchor::Screen(ModScreenAnchor::Center) => (
+            left + (right - left - width) / 2,
+            top + (bottom - top - height) / 2,
+            screen,
+        ),
+        ModAnchor::Component { component } => {
+            let anchor = *anchors.get(component)?;
+            let clip = match overlay.clip {
+                codex_omd::ModOverlayClip::Screen => screen,
+                codex_omd::ModOverlayClip::Anchor => anchor.intersection(screen),
+            };
+            (i32::from(anchor.x), i32::from(anchor.y), clip)
+        }
+    };
+    let (dx, dy) = overlay
+        .offset
+        .as_ref()
+        .map_or((0, 0), |offset| (i32::from(offset.x), i32::from(offset.y)));
+    let (x, y) = (x + dx, y + dy);
+    let x0 = x.max(i32::from(clip.x));
+    let y0 = y.max(i32::from(clip.y));
+    let x1 = (x + width).min(i32::from(clip.right()));
+    let y1 = (y + height).min(i32::from(clip.bottom()));
+    (x1 > x0 && y1 > y0).then(|| {
+        Rect::new(
+            u16::try_from(x0).unwrap_or_default(),
+            u16::try_from(y0).unwrap_or_default(),
+            u16::try_from(x1 - x0).unwrap_or_default(),
+            u16::try_from(y1 - y0).unwrap_or_default(),
+        )
+    })
+}
+
+fn render_overlays(
+    screen: Rect,
+    snapshot: &ModViewSnapshot,
+    style: Style,
+    buffer: &mut Buffer,
+    interaction: &mut Interaction,
+    drawn: &mut BTreeMap<String, (u16, u16)>,
+) {
+    let mut overlays = snapshot
+        .view
+        .sites
+        .iter()
+        .filter_map(|(name, site)| site.overlay.as_ref().map(|overlay| (overlay, name, site)))
+        .filter(|(_, _, site)| !site.components.is_empty())
+        .collect::<Vec<_>>();
+    overlays.sort_by_key(|(overlay, _, _)| overlay.z);
+    for (index, (overlay, name, site)) in overlays.into_iter().enumerate() {
+        let ids = codex_omd::component_ids_of(&site.components);
+        let Some(area) = overlay_area(screen, overlay, &interaction.anchors) else {
+            if let Some(held) = interaction
+                .focused
+                .take_if(|focused| ids.contains(&*focused))
+            {
+                interaction.parked.insert(held);
+            }
+            continue;
+        };
+        let parked = interaction
+            .parked
+            .iter()
+            .filter(|id| ids.contains(*id))
+            .cloned()
+            .collect::<Vec<_>>();
+        if interaction.focused.is_none() {
+            interaction.focused = parked.first().cloned();
+        }
+        for id in parked {
+            interaction.parked.remove(&id);
+        }
+        interaction.layer = u16::try_from(index + 1).unwrap_or(DIALOG_LAYER - 1);
+        interaction.layers.push((area, interaction.layer));
+        Clear.render(area, buffer);
+        let theme = &snapshot.view.theme;
+        if let Some(inner) = render_site(
+            area,
+            &site.components,
+            style,
+            buffer,
+            interaction,
+            Frame::new(
+                overlay.style.unwrap_or_default(),
+                (theme.border, theme.icons),
+                false,
+                false,
+            ),
+            None,
+        ) {
+            drawn.insert(name.clone(), (inner.width, inner.height));
+        }
+    }
+    interaction.layer = 0;
+}
+
+fn render_dialog(
+    area: Rect,
+    chat: Rect,
+    snapshot: &ModViewSnapshot,
+    style: Style,
+    buffer: &mut Buffer,
+    interaction: &mut Interaction,
+) {
+    let Some(dialog) =
+        site(&snapshot.view, "dialog").filter(|dialog| !dialog.components.is_empty())
+    else {
+        interaction.dialog = None;
+        interaction.dialog_area = None;
+        return;
+    };
+    let key = dialog_key(dialog);
+    if interaction.dismissed.as_ref() == Some(&key) {
+        interaction.dialog_area = None;
+        return;
+    }
+    if area.width < 48 || area.height < 14 {
+        let notice = Rect::new(
+            area.x,
+            area.bottom().saturating_sub(1),
+            area.width,
+            1.min(area.height),
+        );
+        Paragraph::new("Enlarge the terminal to at least 48×14 to see this dialog; Esc closes it.")
+            .style(style)
+            .render(notice, buffer);
+        interaction.dialog = Some(key);
+        interaction.dialog_area = None;
+        return;
+    }
+    {
+        let dialog_start = interaction.order.len();
+        let stage = if chat.width >= 48 && chat.height >= 14 {
+            chat
+        } else {
+            area
+        };
+        let (title, dialog_style, components) = match dialog.components.as_slice() {
+            [
+                ModComponent::Dialog {
+                    title,
+                    style,
+                    children,
+                    ..
+                },
+            ] => (
+                Some(Line::from(title.clone()).bold()),
+                *style,
+                children.as_slice(),
+            ),
+            components => (None, None, components),
+        };
+        let theme = &snapshot.view.theme;
+        let frame = Frame::card(dialog_style, (theme.border, theme.icons), false, false);
+        let width = stage.width.saturating_sub(4).min(76);
+        let height = (frame.rows(title.is_some())
+            + stack_height(components, frame.inner(width), &frame))
+        .min(stage.height.saturating_sub(2));
+        let dialog_area = Rect::new(
+            stage.x + (stage.width - width) / 2,
+            stage.y + (stage.height - height) / 2,
+            width,
+            height,
+        );
+        Clear.render(dialog_area, buffer);
+        interaction.layer = DIALOG_LAYER;
+        render_site(
+            dialog_area,
+            components,
+            style,
+            buffer,
+            interaction,
+            frame,
+            title,
+        );
+        interaction.layer = 0;
+        interaction
+            .regions
+            .retain(|region| region.layer == DIALOG_LAYER);
+        interaction.layers = vec![(area, DIALOG_LAYER)];
+        let dialog_order = interaction.order[dialog_start..].to_vec();
+        let dialog_ids = dialog_order.iter().cloned().collect::<BTreeSet<_>>();
+        interaction.order = dialog_order;
+        interaction.targets.retain(|id, _| dialog_ids.contains(id));
+        interaction
+            .hitboxes
+            .retain(|hitbox| dialog_ids.contains(&hitbox.id));
+        interaction.dialog_area = Some(dialog_area);
+        if interaction.dialog.as_ref() != Some(&key) {
+            // A changed dialog keeps its focused control; a newly shown one starts at its autofocus control or its first.
+            let kept = interaction.dialog.is_some()
+                && interaction
+                    .focused
+                    .as_ref()
+                    .is_some_and(|focused| dialog_ids.contains(focused));
+            interaction.dialog = Some(key);
+            if !kept {
+                interaction.focused = interaction
+                    .autofocus
+                    .iter()
+                    .find(|id| dialog_ids.contains(*id))
+                    .or(interaction.order.first())
+                    .cloned();
+            }
+        }
+    }
+}
+
+fn layout_fits(screen: Rect) -> bool {
+    screen.width >= 60 && screen.height >= 12
+}
+
+fn placement(screen: Rect, snapshot: &ModViewSnapshot) -> Option<crate::mod_layout::Placement> {
+    let Some(layout) = snapshot
+        .view
+        .layout
+        .as_ref()
+        .filter(|_| layout_fits(screen))
+    else {
+        crate::mod_layout::hide();
+        return None;
+    };
+    let placement = crate::mod_layout::place(layout, snapshot.layout_owner.as_deref(), screen);
+    placement
+        .chat()
+        .filter(|chat| chat.width >= 20 && chat.height >= 6)
+        .map(|_| placement)
+}
