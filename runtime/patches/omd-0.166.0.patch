+async fn approval_gates_deny_skipped_calls_and_lift_only_user_rule_forbids() -> anyhow::Result<()> {
+    use crate::tools::sandboxing::ExecApprovalRequirement;
+    use crate::tools::sandboxing::ToolError;
+
+    struct Gate(Arc<std::sync::Mutex<Vec<String>>>);
+
+    impl codex_extension_api::ApprovalGateContributor for Gate {
+        fn gate_approval<'a>(
+            &'a self,
+            input: codex_extension_api::ApprovalGateInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, codex_extension_api::ApprovalGate> {
+            self.0.lock().unwrap().push(input.host_decision.to_owned());
+            Box::pin(std::future::ready(match input.host_decision {
+                "skip" => codex_extension_api::ApprovalGate::Deny("gated".to_string()),
+                _ => codex_extension_api::ApprovalGate::Approve("lifted".to_string()),
+            }))
+        }
+    }
+
+    struct ProbeToolRuntime {
+        requirement: ExecApprovalRequirement,
+        command: &'static str,
+        runs: usize,
+    }
+
+    impl crate::tools::sandboxing::Approvable<TurnEnvironment> for ProbeToolRuntime {
+        fn exec_approval_requirement(
+            &self,
+            _req: &TurnEnvironment,
+        ) -> Option<ExecApprovalRequirement> {
+            Some(self.requirement.clone())
+        }
+
+        fn approval_action(
+            &self,
+            _req: &TurnEnvironment,
+            call_id: &str,
+        ) -> std::io::Result<crate::tools::sandboxing::ApprovalAction> {
+            Ok(crate::tools::sandboxing::ApprovalAction::ExecCommand {
+                id: call_id.to_string(),
+                environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+                command: vec![self.command.to_string()],
+                hook_command: self.command.to_string(),
+                cwd: PathUri::from_abs_path(&std::env::temp_dir().abs()),
+                sandbox_permissions: crate::sandboxing::SandboxPermissions::UseDefault,
+                additional_permissions: None,
+                justification: None,
+                tty: false,
+                proposed_execpolicy_amendment: None,
+            })
+        }
+    }
+
+    impl crate::tools::sandboxing::Sandboxable for ProbeToolRuntime {
+        fn sandbox_preference(&self) -> codex_sandboxing::SandboxablePreference {
+            codex_sandboxing::SandboxablePreference::Auto
+        }
+    }
+
+    impl crate::tools::sandboxing::ToolRuntime<TurnEnvironment, ()> for ProbeToolRuntime {
+        fn turn_environment<'a>(&self, req: &'a TurnEnvironment) -> &'a TurnEnvironment {
+            req
+        }
+
+        async fn run(
+            &mut self,
+            _req: &TurnEnvironment,
+            _attempt: &crate::tools::sandboxing::SandboxAttempt<'_>,
+            _ctx: &crate::tools::sandboxing::ToolCtx,
+        ) -> Result<(), ToolError> {
+            self.runs += 1;
+            Ok(())
+        }
+    }
+
+    let (mut session, _) = make_session_and_context().await;
+    let decisions = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let mut extensions =
+        codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    extensions.approval_gate_contributor(Arc::new(Gate(Arc::clone(&decisions))));
+    session.services.extensions = Arc::new(extensions.build());
+    let mut user_rules = codex_execpolicy::PolicyParser::new();
+    user_rules.parse(
+        "user.rules",
+        r#"prefix_rule(pattern=["rm"], decision="forbidden")"#,
+    )?;
+    session.services.exec_policy = Arc::new(crate::exec_policy::ExecPolicyManager::new(Arc::new(
+        user_rules.build(),
+    )));
+    let session = Arc::new(session);
+    let turn = session.new_default_turn().await;
+    let tool_ctx = crate::tools::sandboxing::ToolCtx {
+        cancellation_token: CancellationToken::new(),
+        session: Arc::clone(&session),
+        step_context: StepContext::for_test(Arc::clone(&turn)),
+        call_id: "gated-call".to_string(),
+        tool_name: codex_tools::ToolName::plain("probe"),
+    };
+    let forbidden = ExecApprovalRequirement::Forbidden {
+        reason: "policy".to_string(),
+    };
+    for (requirement, command, expected) in [
+        (
+            ExecApprovalRequirement::Skip {
+                bypass_sandbox: false,
+                proposed_execpolicy_amendment: None,
+            },
+            "ls",
+            Some("gated"),
+        ),
+        (forbidden.clone(), "ls", Some("policy")),
+        (forbidden, "rm", None),
+    ] {
+        let mut tool = ProbeToolRuntime {
+            requirement,
+            command,
+            runs: 0,
+        };
+        let result = crate::tools::orchestrator::ToolOrchestrator::new()
