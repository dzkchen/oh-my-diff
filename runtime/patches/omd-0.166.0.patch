+        serde_json::json!({"type":"response_item","payload":{"type":"reasoning","summary":[{"type":"summary_text","text":"secret-sentinel"}],"content":[{"type":"reasoning_text","text":"secret-sentinel"}],"encrypted_content":"opaque-kept"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"agent_reasoning","text":"secret-sentinel"}}),
+        serde_json::json!({"type":"event_msg","payload":{"type":"task_complete","turn_id":"t","last_agent_message":"secret-sentinel"}}),
