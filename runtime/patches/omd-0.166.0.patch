+struct OpenGate;
+
+impl broker::Gate for OpenGate {
+    fn peer(&self, _stream: &UnixStream) -> io::Result<()> {
+        Ok(())
+    }
+
+    fn authorize(&self, _: &UnixStream, _: &str, _: &str, _: Option<&str>) -> bool {
+        false
+    }
+}
