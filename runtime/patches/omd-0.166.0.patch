+        &'a self,
+        input: codex_extension_api::ToolOutputInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<codex_extension_api::ToolOutputReplacement>>
+    {
+        Box::pin(async move {
+            assert_eq!(
+                (input.call_id, input.text, input.success),
+                ("out-call", "ok", true)
+            );
+            self.replacement.clone().map(|(text, original_bytes)| {
+                codex_extension_api::ToolOutputReplacement {
+                    text,
+                    original_bytes,
+                }
+            })
+        })
+    }
