+pub fn call(op: &str, arguments: Value) -> io::Result<Value> {
+    Client::connect()?.call(op, arguments)
+}
+
+pub fn authorized(op: &str, arguments: Value) -> io::Result<Value> {
+    Client::connect()?.authorized(op, arguments)
