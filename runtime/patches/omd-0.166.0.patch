+static FACTS: Mutex<Option<Facts>> = Mutex::new(None);
+static PIXEL_MODE: AtomicBool = AtomicBool::new(false);
+static RERENDER: AtomicBool = AtomicBool::new(false);
+static HALF: AtomicU8 = AtomicU8::new(HALF_UNKNOWN);
+static FRACTION: Mutex<Option<(f64, f64)>> = Mutex::new(None);
+fn with<T>(run: impl FnOnce(&mut Facts) -> T) -> T {
+    let mut facts = FACTS.locked();
+    run(facts.get_or_insert_with(|| {
+        if cfg!(test) {
+            Facts::default()
+        } else {
+            Facts::detect()
+        }
+    }))
+}
+
+pub(crate) fn facts() -> Facts {
+    with(|facts| *facts)
+}
+
+pub(crate) fn value() -> Value {
+    let mut value = facts().value();
+    let sites = SITES.locked();
+    if !sites.drawn.is_empty() {
+        value["sites"] = sites
+            .drawn
+            .iter()
+            .map(|(name, (columns, rows))| {
+                (name.clone(), json!({"columns": columns, "rows": rows}))
+            })
+            .collect::<serde_json::Map<_, _>>()
+            .into();
+    }
+    value
+}
+
+type SiteAreas = BTreeMap<String, (u16, u16)>;
+
+#[derive(Default)]
+struct Sites {
+    drawn: SiteAreas,
+    before: Option<(SiteAreas, std::time::Instant)>,
+}
+
+static SITES: Mutex<Sites> = Mutex::new(Sites {
+    drawn: BTreeMap::new(),
+    before: None,
+});
+
+/// Called after each mod draw with each drawn `owner/name` site's content area; a change renders again unless the areas flip back within a second, which only a view sizing its own layout from them does.
+pub(crate) fn record_sites(drawn: SiteAreas) {
+    if note_sites(drawn) {
+        rerender();
+    }
+}
+
+fn note_sites(drawn: SiteAreas) -> bool {
+    let mut sites = SITES.locked();
+    if sites.drawn == drawn {
+        return false;
+    }
+    let flipped = sites.before.as_ref().is_some_and(|(before, at)| {
+        *before == drawn && at.elapsed() < std::time::Duration::from_secs(1)
+    });
+    let previous = std::mem::replace(&mut sites.drawn, drawn);
+    sites.before = Some((previous, std::time::Instant::now()));
+    !flipped
+}
+
+/// Called before each draw; measures cell pixels again only when the grid size changes.
+pub(crate) fn update(animations: bool, columns: u16, rows: u16, pointer: bool) {
+    let changed = with(|facts| {
+        let before = *facts;
+        facts.reduced_motion = !animations;
+        facts.pointer = pointer;
+        if facts.size != (columns, rows) {
+            facts.measure();
+            facts.size = (columns, rows);
+            SITES.locked().before = None;
+        }
+        *facts != before
+    });
+    if changed {
+        rerender();
+    }
+}
+
+pub(crate) fn note_welcome(area: Option<(u16, u16)>) {
+    if with(|facts| std::mem::replace(&mut facts.welcome, area) != area) {
+        rerender();
+    }
+}
+
+pub(crate) fn note_chat(area: ratatui::layout::Rect) {
+    let area = Some((area.x, area.y, area.width, area.height));
+    if with(|facts| std::mem::replace(&mut facts.chat, area) != area) {
+        rerender();
+    }
+}
+
+/// A burst of changes, such as a window drag, re-renders once per render in progress.
+fn rerender() {
+    if !RERENDER.swap(true, Ordering::AcqRel) {
+        std::thread::spawn(|| {
+            RERENDER.store(false, Ordering::Release);
+            crate::mod_runtime::rerender();
+        });
+    }
+}
+
+/// The startup probe's cell size stands in until the window reports pixels; it sizes pictures but never enables pixel pointer reports, since it goes stale on font zoom.
+#[cfg(unix)]
+pub(crate) fn set_probed_cell(cell: Option<(u16, u16)>) {
+    with(|facts| {
+        if facts.cell.is_none() && cell.is_some() {
+            facts.cell = cell;
+            facts.probed = true;
+        }
+    });
+}
+
+/// SGR-pixel reports are requested only where the terminal is known to honor them.
+pub(crate) fn enable_pixel_pointer() -> bool {
+    let enabled = with(|facts| facts.pixel_pointer && facts.cell.is_some() && !facts.probed);
+    set_pixel_mode(enabled);
+    enabled
+}
+
+pub(crate) fn disable_pixel_pointer() -> bool {
+    set_pixel_mode(false)
+}
+
+/// Returns the previous mode; the pointer fact the mod view reports follows it, so a flip re-renders.
+fn set_pixel_mode(on: bool) -> bool {
+    let was = PIXEL_MODE.swap(on, Ordering::Relaxed);
+    if was != on {
+        rerender();
+    }
+    was
+}
+
+/// Pixel reports become cell events; motion that stays in the same half cell is dropped.
+pub(crate) fn to_cells(mut event: MouseEvent) -> Option<MouseEvent> {
+    static LAST_MOTION: Mutex<Option<(u16, u16, u8)>> = Mutex::new(None);
+    let cell = PIXEL_MODE
+        .load(Ordering::Relaxed)
+        .then(|| with(|facts| facts.cell))
+        .flatten();
+    let Some((width, height)) = cell else {
+        HALF.store(HALF_UNKNOWN, Ordering::Relaxed);
+        *FRACTION.locked() = None;
+        return Some(event);
+    };
+    let half = u8::from(event.row % height >= height.div_ceil(2));
+    HALF.store(half, Ordering::Relaxed);
+    *FRACTION.locked() = Some((
+        f64::from(event.column % width) / f64::from(width),
+        f64::from(event.row % height) / f64::from(height),
+    ));
+    event.column /= width;
+    event.row /= height;
+    let position = Some((event.column, event.row, half));
+    let mut last = LAST_MOTION.locked();
+    if matches!(event.kind, MouseEventKind::Moved | MouseEventKind::Drag(_)) {
+        if *last == position {
+            return None;
+        }
+        *last = position;
+    } else {
+        *last = None;
+    }
+    Some(event)
+}
+
+pub(crate) fn last_half() -> Option<u8> {
+    let half = HALF.load(Ordering::Relaxed);
+    (half != HALF_UNKNOWN).then_some(half)
+}
+
+pub(crate) fn last_fraction() -> Option<(f64, f64)> {
+    *FRACTION.locked()
+}
+
+pub(crate) struct Pixels {
+    pub(crate) bytes: Vec<u8>,
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+    pub(crate) alpha: bool,
+}
+
+struct Inline {
+    bytes: Arc<[u8]>,
+    columns: u16,
+    rows: u16,
+    emitted: Option<(u16, u16)>,
+}
+
+struct Images {
+    placed: BTreeMap<String, (String, u32, u16, u16)>,
+    next: u32,
+    transmissions: Vec<(u32, Pixels, u16, u16)>,
+    inline: BTreeMap<u32, Inline>,
+    pending: Vec<String>,
+    directory: Option<tempfile::TempDir>,
+}
+
+static IMAGES: Mutex<Images> = Mutex::new(Images {
+    placed: BTreeMap::new(),
+    next: FIRST_IMAGE_ID,
+    transmissions: Vec::new(),
+    inline: BTreeMap::new(),
+    pending: Vec::new(),
+    directory: None,
+});
+
+fn images() -> std::sync::MutexGuard<'static, Images> {
+    IMAGES.locked()
+}
+
+impl Images {
+    /// Kitty images also lose a queued transmission and any shared memory or file the terminal never read.
+    fn drop_image(&mut self, id: u32) {
+        if self.inline.remove(&id).is_none() {
+            self.transmissions.retain(|(queued, ..)| *queued != id);
+            unlink_shared(id);
+            if let Some(directory) = &self.directory {
+                let _ = std::fs::remove_file(directory.path().join(file_name(id)));
+            }
+            self.pending.push(crate::mod_kitty::kitty_remove(id));
+        }
+    }
+
+    /// One image per component: a new key replaces the component's previous image.
+    fn place<T>(
+        &mut self,
+        component: &str,
+        key: &str,
+        payload: impl FnOnce() -> Option<(T, u16, u16)>,
+        store: impl FnOnce(&mut Self, u32, T, u16, u16),
+    ) -> Option<(u32, u16, u16)> {
+        if let Some((placed, id, columns, rows)) = self.placed.get(component)
+            && placed == key
+        {
+            return Some((*id, *columns, *rows));
+        }
+        let (payload, columns, rows) = payload()?;
+        let id = self.next;
+        self.next = if id >= 0xff_ff_ff {
+            FIRST_IMAGE_ID
+        } else {
+            id + 1
+        };
+        if let Some((_, previous, _, _)) = self
+            .placed
+            .insert(component.to_owned(), (key.to_owned(), id, columns, rows))
+        {
+            self.drop_image(previous);
+        }
+        store(self, id, payload, columns, rows);
+        Some((id, columns, rows))
+    }
+}
+
+pub(crate) fn kitty_image(
+    component: &str,
+    key: &str,
+    pixels: impl FnOnce() -> Option<(Pixels, u16, u16)>,
+) -> Option<(u32, u16, u16)> {
+    images().place(
+        component,
+        key,
+        pixels,
+        |images, id, pixels, columns, rows| {
+            images.transmissions.push((id, pixels, columns, rows));
+        },
+    )
+}
+
+pub(crate) fn iip_image(
+    component: &str,
+    key: &str,
+    bytes: impl FnOnce() -> Option<(Arc<[u8]>, u16, u16)>,
+) -> Option<(u32, u16, u16)> {
+    images().place(component, key, bytes, |images, id, bytes, columns, rows| {
+        images.inline.insert(
+            id,
+            Inline {
+                bytes,
+                columns,
+                rows,
+                emitted: None,
+            },
+        );
+    })
+}
+
+/// Raw pixels in a POSIX shared-memory object Kitty reads and unlinks; the name stays within macOS's 31 bytes.
+#[cfg(unix)]
+fn shared_memory(id: u32, bytes: &[u8]) -> Option<String> {
+    let name = std::ffi::CString::new(format!("/omd-{}-{id}", std::process::id())).ok()?;
+    // SAFETY: the descriptor and mapping are used only within this call and `bytes.len()` bytes are mapped.
+    unsafe {
+        let fd = libc::shm_open(
+            name.as_ptr(),
+            libc::O_CREAT | libc::O_EXCL | libc::O_RDWR,
+            0o600 as libc::c_uint,
+        );
+        if fd < 0 {
+            return None;
+        }
+        let mapped = if libc::ftruncate(fd, bytes.len() as libc::off_t) == 0 {
+            libc::mmap(
+                std::ptr::null_mut(),
+                bytes.len(),
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            )
+        } else {
+            libc::MAP_FAILED
+        };
+        libc::close(fd);
+        if mapped == libc::MAP_FAILED {
+            libc::shm_unlink(name.as_ptr());
+            return None;
+        }
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), mapped.cast::<u8>(), bytes.len());
+        libc::munmap(mapped, bytes.len());
+    }
+    Some(name.to_string_lossy().into_owned())
+}
+
+#[cfg(not(unix))]
+fn shared_memory(_id: u32, _bytes: &[u8]) -> Option<String> {
+    None
+}
+
+fn unlink_shared(id: u32) {
+    #[cfg(unix)]
+    if let Ok(name) = std::ffi::CString::new(format!("/omd-{}-{id}", std::process::id())) {
+        // SAFETY: `name` is a valid NUL-terminated string; unlinking a missing object only fails.
+        unsafe {
+            libc::shm_unlink(name.as_ptr());
+        }
+    }
+}
+
+fn file_name(id: u32) -> String {
+    format!("tty-graphics-protocol-{id}")
+}
+
+fn private_directory() -> Option<tempfile::TempDir> {
+    let mut builder = tempfile::Builder::new();
+    builder.prefix("omd-");
+    #[cfg(unix)]
+    builder.permissions(std::os::unix::fs::PermissionsExt::from_mode(0o700));
+    builder.tempdir().ok()
+}
+
+/// Raw pixels through shared memory or a file in a private temporary directory that the terminal reads and deletes; inline when neither can be written.
+fn transmission(
+    directory: Option<&std::path::Path>,
+    id: u32,
+    pixels: &Pixels,
+    columns: u16,
+    rows: u16,
+    shared: bool,
+) -> String {
+    let _stage = codex_omd::frame_metrics::stage("terminal_transmission");
+    let header = format!(
+        "a=T,U=1,f={},s={},v={},i={id},c={columns},r={rows},q=2",
+        if pixels.alpha { 32 } else { 24 },
+        pixels.width,
+        pixels.height,
+    );
+    if let Some(name) = shared.then(|| shared_memory(id, &pixels.bytes)).flatten() {
+        return crate::mod_kitty::kitty_transmit(name.as_bytes(), &format!("{header},t=s"));
+    }
+    match directory
+        .map(|directory| directory.join(file_name(id)))
+        .filter(|path| std::fs::write(path, &pixels.bytes).is_ok())
+    {
+        Some(path) => crate::mod_kitty::kitty_transmit(
+            path.to_string_lossy().as_bytes(),
+            &format!("{header},t=t"),
+        ),
+        None => crate::mod_kitty::kitty_transmit(&pixels.bytes, &format!("{header},t=d")),
+    }
+}
+
+/// Sends this frame's new images before its placeholder cells reach the terminal: Kitty never shows placeholders drawn before their image exists.
+pub(crate) fn transmit() {
+    let shared = facts().shared_memory;
+    let (transmissions, directory) = {
+        let mut images = images();
+        if images.transmissions.is_empty() {
+            return;
+        }
+        if images.directory.is_none() {
+            images.directory = private_directory();
+        }
+        (
+            std::mem::take(&mut images.transmissions),
+            images
+                .directory
+                .as_ref()
+                .map(|directory| directory.path().to_owned()),
+        )
+    };
+    write(
+        transmissions
+            .iter()
+            .map(|(id, pixels, columns, rows)| {
+                transmission(directory.as_deref(), *id, pixels, *columns, *rows, shared)
+            })
+            .collect(),
+    );
+}
+
+pub(crate) fn placeholder_rows(
+    id: u32,
+    columns: u16,
+    rows: u16,
+    prefix: &str,
+) -> Vec<Line<'static>> {
+    let [_, red, green, blue] = id.to_be_bytes();
+    #[allow(clippy::disallowed_methods)]
+    let style = Style::default().fg(Color::Rgb(red, green, blue));
+    DIACRITICS
+        .iter()
+        .take(usize::from(rows))
+        .map(|row| {
+            let cells = DIACRITICS
+                .iter()
+                .take(usize::from(columns))
+                .map(|column| format!("{PLACEHOLDER}{row}{column}"))
+                .collect::<String>();
+            Line::from(vec![
+                Span::raw(prefix.to_owned()),
+                Span::styled(cells, style),
+            ])
+        })
+        .collect()
+}
+
+pub(crate) fn max_placeholder_cells() -> u16 {
+    DIACRITICS.len() as u16
+}
+
+pub(crate) fn forget(component: &str) {
+    let mut images = images();
+    if let Some((_, id, _, _)) = images.placed.remove(component) {
+        images.drop_image(id);
+    }
+}
+
+pub(crate) fn retain(components: &BTreeSet<String>) {
+    let mut images = images();
+    let gone = images
+        .placed
+        .keys()
+        .filter(|component| !components.contains(*component))
+        .cloned()
+        .collect::<Vec<_>>();
+    for component in gone {
+        if let Some((_, id, _, _)) = images.placed.remove(&component) {
+            images.drop_image(id);
+        }
+    }
+}
+
+fn write(sequences: Vec<String>) {
+    let _stage = codex_omd::frame_metrics::stage("terminal_write");
+    if sequences.is_empty() {
+        return;
+    }
+    let mut stdout = std::io::stdout();
+    for sequence in sequences {
+        let _ = stdout.write_all(sequence.as_bytes());
+    }
+    let _ = stdout.flush();
+}
+
+pub(crate) fn flush() {
+    let pending = std::mem::take(&mut images().pending);
+    write(pending);
+}
+
+pub(crate) fn teardown() {
+    let mut images = images();
+    images.transmissions.clear();
+    for (_, id, _, _) in std::mem::take(&mut images.placed).into_values() {
+        images.drop_image(id);
+    }
+    let sequences = std::mem::take(&mut images.pending);
+    let directory = images.directory.take();
+    drop(images);
+    write(sequences);
+    drop(directory);
+}
+
+fn markers(buffer: &Buffer, inline: &BTreeMap<u32, Inline>) -> Vec<(u32, usize, usize, usize)> {
+    buffer
+        .content
+        .iter()
+        .enumerate()
+        .filter_map(|(index, cell)| {
+            let Color::Rgb(red, green, blue) = cell.fg else {
+                return None;
+            };
+            let id = u32::from_be_bytes([0, red, green, blue]);
+            let mut symbol = cell.symbol().chars();
+            if symbol.next() != Some(PLACEHOLDER) || !inline.contains_key(&id) {
+                return None;
+            }
+            let mut diacritic = || DIACRITICS.binary_search(&symbol.next()?).ok();
+            Some((id, index, diacritic()?, diacritic()?))
+        })
+        .collect()
+}
+
+/// Marker cells become skipped blanks so the diff never overwrites a picture; cells the picture leaves or newly covers are redrawn.
+fn mark(
+    previous: &Buffer,
+    current: &mut Buffer,
+    inline: &mut BTreeMap<u32, Inline>,
+) -> Vec<(u32, u16, u16)> {
+    let area = current.area;
+    let mut origins = BTreeMap::<u32, (i32, i32, Vec<usize>)>::new();
+    for (id, index, row, column) in markers(current, inline) {
+        let (x, y) = current.pos_of(index);
+        origins
+            .entry(id)
+            .or_insert_with(|| {
+                (
+                    i32::from(x) - column as i32,
+                    i32::from(y) - row as i32,
+                    Vec::new(),
+                )
+            })
+            .2
+            .push(index);
+    }
+    let mut emitted = Vec::new();
+    for (id, (x, y, cells)) in origins {
+        let Some(image) = inline.get_mut(&id) else {
+            continue;
+        };
+        let fits = x >= i32::from(area.left())
+            && y >= i32::from(area.top())
+            && x + i32::from(image.columns) <= i32::from(area.right())
+            && y + i32::from(image.rows) <= i32::from(area.bottom());
+        if !fits {
+            for index in cells {
+                current.content[index].reset();
+            }
+            continue;
+        }
+        let origin = (x as u16, y as u16);
+        let stale = image.emitted != Some(origin)
+            || cells
+                .iter()
+                .any(|index| previous.content[*index].diff_option != CellDiffOption::Skip);
+        for index in cells {
+            let cell = &mut current.content[index];
+            cell.set_symbol(" ");
+            cell.set_diff_option(CellDiffOption::Skip);
+        }
+        if stale {
+            image.emitted = Some(origin);
+            emitted.push((id, origin.0, origin.1));
+        }
+    }
+    for (id, x, y) in &emitted {
+        let image = &inline[id];
+        for row in *y..*y + image.rows {
+            for column in *x..*x + image.columns {
+                let cell = &mut current[(column, row)];
+                if cell.diff_option == CellDiffOption::None {
+                    cell.set_diff_option(CellDiffOption::AlwaysUpdate);
+                }
+            }
+        }
+    }
+    for (before, cell) in previous.content.iter().zip(&mut current.content) {
+        if before.diff_option == CellDiffOption::Skip && cell.diff_option == CellDiffOption::None {
+            cell.set_diff_option(CellDiffOption::AlwaysUpdate);
+        }
+    }
+    emitted
+}
+
+/// Draws this frame's inline images before the cell diff reaches the terminal; the diff leaves their cells alone.
+pub(crate) fn place(previous: &Buffer, current: &mut Buffer) {
+    use base64::Engine as _;
+    if !facts().iip {
+        return;
+    }
+    let stage = codex_omd::frame_metrics::stage("iip_transmission");
+    let mut images = images();
+    let emitted = mark(previous, current, &mut images.inline);
+    let sequences = emitted
+        .into_iter()
+        .map(|(id, x, y)| {
+            let image = &images.inline[&id];
+            format!(
+                "\x1b7\x1b[{};{}H\x1b]1337;File=inline=1;size={};width={};height={};preserveAspectRatio=0;doNotMoveCursor=1:{}\x07\x1b8",
+                y + 1,
+                x + 1,
+                image.bytes.len(),
+                image.columns,
+                image.rows,
+                base64::engine::general_purpose::STANDARD.encode(&image.bytes)
+            )
+        })
+        .collect();
+    drop(images);
+    drop(stage);
+    write(sequences);
+}
