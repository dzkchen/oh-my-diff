+            {"content": "site:a/two", "title": "", "style": {"border": "none", "margin": 1}},
+            {"content": "site:a/three", "style": {"border": "none"}},
+            {"content": "transcript"}
+        ]
+    }));
+    place(&frameless, Some("owner"), Rect::new(0, 0, 100, 40));
+    for (column, row) in [(10, 0), (35, 0), (35, 1)] {
+        assert!(!pointer(mouse(
+            MouseEventKind::Down(MouseButton::Left),
+            (column, row)
+        )));
+        assert!(!pointer(mouse(
+            MouseEventKind::Drag(MouseButton::Left),
+            (column, 20)
+        )));
+        assert_eq!(dock_preview(), None);
+        assert!(!cancel_dock());
+        assert!(!pointer(mouse(
+            MouseEventKind::Up(MouseButton::Left),
+            (column, 20)
+        )));
+    }
+    assert!(!pointer(mouse(
+        MouseEventKind::Down(MouseButton::Left),
+        (60, 0)
+    )));
+    assert!(pointer(mouse(
+        MouseEventKind::Drag(MouseButton::Left),
