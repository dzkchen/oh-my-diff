+    component_region: BTreeMap::new(),
+    region_tabs: Vec::new(),
+    follow_tab: false,
+    region_keys: false,
+    help: None,
+});
+static APPLIED_SYNTAX: Mutex<Option<String>> = Mutex::new(None);
+static WARNED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+type MarkdownKey = (
+    u64,
+    u16,
+    u64,
+    Option<(u8, u8, u8)>,
+    Option<(u8, u8, u8)>,
+    crate::terminal_palette::StdoutColorLevel,
+);
+type MarkdownEntry = (MarkdownKey, usize, Arc<[HyperlinkLine]>);
+static MARKDOWN: Mutex<Vec<MarkdownEntry>> = Mutex::new(Vec::new());
+const MARKDOWN_ENTRIES: usize = 256;
+const MARKDOWN_BYTES: usize = 1024 * 1024;
+
+fn markdown_weight(lines: &[HyperlinkLine]) -> usize {
+    lines
+        .iter()
+        .map(|line| {
+            let spans = line
+                .line
+                .spans
+                .iter()
+                .map(|span| 64 + span.content.len())
+                .sum::<usize>();
+            96 + spans + 96 * line.hyperlinks.len()
+        })
+        .sum()
+}
+
+fn markdown_lines(text: &str, width: u16) -> Arc<[HyperlinkLine]> {
+    rendered_lines(text, width, None)
+}
+
+fn code_lines(text: &str, language: &str) -> Arc<[HyperlinkLine]> {
+    rendered_lines(text, 0, Some(language))
+}
+
+/// The most recently drawn markdown and code renders, so a draw re-parses only changed or resized text.
+fn rendered_lines(text: &str, width: u16, language: Option<&str>) -> Arc<[HyperlinkLine]> {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    text.hash(&mut hasher);
+    language.hash(&mut hasher);
+    let key = (
+        hasher.finish(),
+        width,
+        crate::render::highlight::syntax_theme_revision(),
+        crate::terminal_palette::default_fg(),
+        crate::terminal_palette::default_bg(),
+        crate::terminal_palette::stdout_color_level(),
+    );
+    {
+        let mut cache = MARKDOWN.locked();
+        if let Some(index) = cache.iter().position(|(cached, _, _)| *cached == key) {
+            let entry = cache.remove(index);
+            let lines = Arc::clone(&entry.2);
+            cache.push(entry);
+            return lines;
+        }
+    }
+    let lines: Arc<[HyperlinkLine]> = match language {
+        Some(language) => {
+            match (!language.is_empty())
+                .then(|| crate::render::highlight::highlight_code_to_styled_spans(text, language))
+                .flatten()
+            {
+                Some(lines) => lines
+                    .into_iter()
+                    .map(|spans| HyperlinkLine::from(Line::from(spans)))
+                    .collect(),
+                None => text
+                    .lines()
+                    .map(|line| HyperlinkLine::from(Line::from(line.to_owned()).cyan()))
+                    .collect(),
+            }
+        }
+        None => crate::markdown::render_markdown_agent_with_list_spacing(
+            text,
+            Some(usize::from(width)),
+            None,
+            None,
+            crate::markdown_render::ListSpacing::AfterMultiline,
+        )
+        .into(),
+    };
+    let mut cache = MARKDOWN.locked();
+    cache.retain(|(cached, _, _)| *cached != key);
+    cache.push((key, markdown_weight(&lines), Arc::clone(&lines)));
+    let mut bytes = cache.iter().map(|(_, bytes, _)| bytes).sum::<usize>();
+    while cache.len() > MARKDOWN_ENTRIES || (cache.len() > 1 && bytes > MARKDOWN_BYTES) {
+        bytes -= cache.remove(0).1;
+    }
+    lines
+}
+static BLOCKED_SNAPSHOT: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+
+static APPLIED_PLACEHOLDER: Mutex<Option<Option<String>>> = Mutex::new(None);
+
+pub(crate) fn sync_placeholder() -> Option<Option<String>> {
+    let current = with_cache(|cache| cache.snapshot.view.placeholder.clone()).flatten();
+    let mut applied = APPLIED_PLACEHOLDER.locked();
+    if applied.as_ref() == Some(&current) {
+        return None;
+    }
+    *applied = Some(current.clone());
+    Some(current)
+}
+
+pub(crate) fn glyphs() -> BTreeMap<String, String> {
+    with_cache(|cache| cache.snapshot.view.theme.glyphs.clone())
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|(source, display)| {
+            unicode_width::UnicodeWidthStr::width(source.as_str())
+                == unicode_width::UnicodeWidthStr::width(display.as_str())
+        })
+        .collect()
+}
+
+pub(crate) fn first_warning(key: &str) -> bool {
+    let mut warned = WARNED.locked();
+    if warned.iter().any(|seen| seen == key) {
+        return false;
+    }
+    warned.push(key.to_owned());
+    true
+}
+
+pub(crate) fn sync_syntax_theme() -> Option<String> {
+    let requested = syntax_theme();
+    let mut applied = APPLIED_SYNTAX.locked();
+    if *applied == requested {
+        return None;
+    }
+    let previous = std::mem::replace(&mut *applied, requested.clone());
+    match requested {
+        Some(name) => match crate::render::highlight::resolve_theme_with_configured_home(&name) {
+            Some(theme) => {
+                crate::render::highlight::set_syntax_theme(theme);
+                None
+            }
+            None => Some(format!(
+                "Mod syntax theme '{name}' is not installed; keeping the configured theme"
+            )),
+        },
+        None => {
+            if previous.is_some()
+                && let Some(theme) = crate::render::highlight::resolve_theme_with_configured_home(
+                    &crate::render::highlight::configured_theme_name(),
+                )
+            {
+                crate::render::highlight::set_syntax_theme(theme);
+            }
+            None
+        }
+    }
+}
+
+pub(crate) fn span_style(span: &codex_omd::ModSpan) -> Style {
+    let mut style = tone_style(span.tone);
+    if let Some(fg) = span.fg {
+        style = style.fg(color(fg));
+    }
+    if let Some(bg) = span.bg {
+        style = style.bg(color(bg));
+    }
+    for (enabled, modifier) in [
+        (span.bold, Modifier::BOLD),
+        (span.italic, Modifier::ITALIC),
+        (span.underline, Modifier::UNDERLINED),
+    ] {
+        if enabled {
+            style = style.add_modifier(modifier);
+        }
+    }
+    style
+}
+
+#[expect(
+    clippy::disallowed_methods,
+    reason = "The mod theme contract explicitly selects 256-color palette indices"
+)]
+pub(crate) fn color_at(color: ModColor, level: Option<StdoutColorLevel>) -> Color {
+    match (color, level) {
+        (_, None) => Color::Reset,
+        (ModColor::Indexed(index), Some(_)) => Color::Indexed(index),
+        (ModColor::Rgb(red, green, blue), Some(level)) => {
+            crate::terminal_palette::best_color_for_level((red, green, blue), level)
+        }
+    }
+}
+
+pub(crate) fn color_level() -> Option<StdoutColorLevel> {
+    (!crate::mod_client::facts().no_color)
+        .then(crate::terminal_palette::effective_stdout_color_level)
+}
+
+pub(crate) fn color(color: ModColor) -> Color {
+    color_at(color, color_level())
+}
+
+fn slot_index(slot: ThemeSlot) -> usize {
+    match slot {
+        ThemeSlot::Accent => 0,
+        ThemeSlot::UserMessageBackground => 1,
+        ThemeSlot::Success => 2,
+        ThemeSlot::Attention => 3,
+        ThemeSlot::Failure => 4,
+        ThemeSlot::DiffAdded => 5,
+        ThemeSlot::DiffRemoved => 6,
+        ThemeSlot::Muted => 7,
+    }
+}
+
+pub(crate) fn colors(snapshot: &ModViewSnapshot) -> [Option<Color>; 8] {
+    let theme = &snapshot.view.theme;
+    [
+        theme.accent,
+        theme.user_message_background,
+        theme.success,
+        theme.attention,
+        theme.failure,
+        theme.diff_added,
+        theme.diff_removed,
+        theme.muted,
+    ]
+    .map(|slot| slot.map(color))
+}
+
+// Hashes presentation content, not the revision, so ordinary terminal events don't invalidate retained transcript layouts.
+fn presentation(snapshot: &ModViewSnapshot) -> u64 {
+    use std::hash::Hash;
+    use std::hash::Hasher;
+    let view = &snapshot.view;
+    let mut revision = std::collections::hash_map::DefaultHasher::new();
+    serde_json::to_vec(&(
+        &view.theme,
+        &view.surface_styles,
+        &view.session_title_suffix,
+        &view.greeting,
+        view.foreground,
+        view.background,
+    ))
+    .unwrap_or_default()
+    .hash(&mut revision);
+    revision.finish()
+}
+
+pub(crate) fn preserve_preview(preview: &ModViewSnapshot, incoming: &ModViewSnapshot) -> bool {
+    let bootstrap = incoming.input.is_null()
+        && incoming.diagnostics.is_empty()
+        && incoming.progress.is_none()
+        && incoming.activity.is_empty()
+        && incoming.errors.is_empty();
+    if preview.input["event"] == "startup" {
+        return bootstrap;
+    }
+    // A never-rendered host view (a fresh session's first write) has nothing to draw; the default snapshot (epoch 0) is not one.
+    if bootstrap && incoming.epoch != 0 && incoming.revision == 0 && incoming.rendered_ms == 0 {
+        return true;
+    }
+    // Only a failure of a mod that drew the preview replaces it; other failures wait for the next render.
+    let recovering = incoming
+        .errors
+        .iter()
+        .any(|(source, _)| preview.contributors.contains(source));
+    if preview.rendered_ms > 0 && incoming.rendered_ms > 0 {
+        return !recovering && incoming.rendered_ms <= preview.rendered_ms;
+    }
+    (preview.epoch == incoming.epoch && preview.revision > incoming.revision)
+        || (site(&preview.view, "dialog").is_some() && !recovering)
+}
+
+fn collect_component(component: &ModComponent, interaction: &mut Interaction) {
+    match component {
+        ModComponent::Box { id, children, .. } | ModComponent::Dialog { id, children, .. } => {
+            interaction.ids.insert(id.clone());
+            for child in children {
+                collect_component(child, interaction);
+            }
+        }
+        ModComponent::Pane {
+            id,
+            collapsed,
+            scroll,
+            children,
+            ..
+        } => {
+            interaction.ids.insert(id.clone());
+            interaction
+                .collapsed
+                .entry(id.clone())
+                .or_insert(*collapsed);
+            interaction.scroll.entry(id.clone()).or_insert(*scroll);
+            for child in children {
+                collect_component(child, interaction);
+            }
+        }
+        ModComponent::Input {
+            id,
+            value,
+            hotkey,
+            autofocus,
+            ..
+        } => {
+            control(interaction, id, hotkey, *autofocus);
+            if controlled(interaction, id, value) {
+                interaction.input_values.insert(id.clone(), value.clone());
+                interaction.input_cursor.remove(id);
+            }
+        }
+        ModComponent::Select {
+            id,
+            value,
+            options,
+            hotkey,
+            autofocus,
+            ..
+        } => {
+            control(interaction, id, hotkey, *autofocus);
+            let selected = options
+                .iter()
+                .position(|option| option.value == *value)
+                .unwrap_or_default();
+            if controlled(interaction, id, value) {
+                interaction.selected.insert(id.clone(), selected);
+            }
+        }
+        ModComponent::Multiselect {
+            id,
+            value,
+            hotkey,
+            autofocus,
+            ..
+        } => {
+            control(interaction, id, hotkey, *autofocus);
+            if controlled(interaction, id, &checked_value(value.iter())) {
+                interaction
+                    .checked
+                    .insert(id.clone(), value.iter().cloned().collect());
+            }
+        }
+        ModComponent::Button {
+            id,
+            hotkey,
+            autofocus,
+            ..
+        } => control(interaction, id, hotkey, *autofocus),
+        ModComponent::List {
+            id,
+            rows,
+            selected,
+            hotkey,
+            autofocus,
+            ..
+        } => {
+            control(interaction, id, hotkey, *autofocus);
+            let selected = selected
+                .as_ref()
+                .and_then(|value| rows.iter().position(|row| row.value == *value))
+                .unwrap_or_default();
+            interaction.selected.entry(id.clone()).or_insert(selected);
+        }
+        ModComponent::Text { id, .. }
+        | ModComponent::Line { id, .. }
+        | ModComponent::Markdown { id, .. }
+        | ModComponent::Code { id, .. }
+        | ModComponent::Document { id, .. }
+        | ModComponent::Diff { id, .. }
+        | ModComponent::Image { id, .. }
+        | ModComponent::Raster { id, .. }
+        | ModComponent::Module { id, .. } => {
+            interaction.ids.insert(id.clone());
+        }
+        ModComponent::Terminal { id, autofocus, .. } => {
+            interaction.ids.insert(id.clone());
+            interaction.terminals.insert(id.clone());
+            if *autofocus {
+                interaction.autofocus.push(id.to_owned());
+            }
+        }
+        ModComponent::Slot | ModComponent::Native { .. } => {}
+    }
+}
+
+fn control(interaction: &mut Interaction, id: &str, hotkey: &Option<String>, autofocus: bool) {
+    interaction.ids.insert(id.to_owned());
+    if let Some(key) = hotkey
+        && !interaction.hotkeys.iter().any(|(bound, _)| bound == key)
+    {
+        interaction.hotkeys.push((key.clone(), id.to_owned()));
+    }
+    if autofocus {
+        interaction.autofocus.push(id.to_owned());
+    }
+}
+
+fn checked_value<'a>(values: impl Iterator<Item = &'a String>) -> String {
+    let values = values.collect::<BTreeSet<_>>();
+    serde_json::to_string(&values).unwrap_or_default()
+}
+
+/// A view value changed by the mod, rather than echoing the user's own edit, resets the field.
+fn controlled(interaction: &mut Interaction, id: &str, value: &str) -> bool {
+    let previous = interaction.seeds.insert(id.to_owned(), value.to_owned());
+    previous.as_deref() != Some(value)
+        && !interaction
+            .echoes
+            .get(id)
+            .is_some_and(|echoes| echoes.iter().any(|echo| echo == value))
+}
+
+fn sync_interaction(view: &ModView) {
+    let mut interaction = INTERACTION.locked();
+    let previous = std::mem::take(&mut interaction.ids);
+    let terminals = std::mem::take(&mut interaction.terminals);
+    interaction.hotkeys.clear();
+    interaction.autofocus.clear();
+    for site in view.sites.values() {
+        for component in &site.components {
+            collect_component(component, &mut interaction);
+        }
+    }
+    if let Some(underlay) = &view.underlay {
+        interaction.ids.insert(underlay.raster.clone());
+    }
+    let ids = interaction.ids.clone();
+    interaction.input_values.retain(|id, _| ids.contains(id));
+    interaction.input_cursor.retain(|id, _| ids.contains(id));
+    interaction.selected.retain(|id, _| ids.contains(id));
+    interaction.checked.retain(|id, _| ids.contains(id));
+    interaction.collapsed.retain(|id, _| ids.contains(id));
+    interaction.scroll.retain(|id, _| ids.contains(id));
+    interaction.scroll_limits.retain(|id, _| ids.contains(id));
+    interaction.seeds.retain(|id, _| ids.contains(id));
+    interaction.echoes.retain(|id, _| ids.contains(id));
+    interaction.hovered.retain(|id, _| ids.contains(id));
+    interaction.parked.retain(|id| ids.contains(id));
+    if interaction
+        .captured
+        .as_ref()
+        .is_some_and(|id| !ids.contains(id))
+    {
+        interaction.captured = None;
+    }
+    crate::mod_components::retain(
+        &ids.union(&crate::mod_render::component_ids())
+            .cloned()
+            .collect(),
+    );
+    crate::mod_module::retain(&ids);
+    if let Some(id) = interaction.focused.clone()
+        && !ids.contains(&id)
+    {
+        interaction.focused = None;
+        if terminals.contains(&id) {
+            let (focused, region) = interaction.prior_focus.clone();
+            interaction.focused = focused.filter(|prior| ids.contains(prior));
+            interaction.focus_region = region;
+        }
+    }
+    if interaction.focused.is_none()
+        && let Some(id) = interaction
+            .autofocus
+            .iter()
+            .find(|id| !previous.contains(*id))
+            .cloned()
+    {
+        let before = observe(&interaction);
+        interaction.focused = Some(id);
+        let after = observe(&interaction);
+        report(&before, &after, &mut interaction, "mod");
+    }
+}
+
+fn matches_context(
+    snapshot: &ModViewSnapshot,
+    context: Option<&crate::mod_runtime::ModContext>,
+) -> bool {
+    context.is_some_and(|context| {
+        snapshot.input["ledger"]["thread_id"].as_str()
+            == context.thread_id.map(|id| id.to_string()).as_deref()
+            && snapshot.input["ledger"]["cwd"].as_str() == context.repository.to_str()
+    })
+}
+
+pub(crate) fn refresh() {
+    let (terminal, snapshot) = crate::omd::mod_snapshot();
+    let context = crate::mod_runtime::active_context();
+    let matches_context = matches_context(&snapshot, context.as_ref());
+    let mut blocked = BLOCKED_SNAPSHOT.locked();
+    if context.is_some() && !matches_context
+        || blocked.as_ref() == Some(&(snapshot.epoch, snapshot.revision))
+    {
+        return;
+    }
+    *blocked = None;
+    drop(blocked);
+    {
+        let cache = CACHE
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if cache.as_ref().is_some_and(|cache| {
+            (terminal && snapshot.epoch == 0)
+                || (cache.preview && preserve_preview(&cache.snapshot, &snapshot))
+        }) {
+            return;
+        }
+    }
+    sync_interaction(&snapshot.view);
+    let mut cache = CACHE
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let seen = cache.as_ref().and_then(|cache| cache.seen).or_else(|| {
+        Some((
+            snapshot.epoch,
+            snapshot
+                .activity
+                .iter()
+                .map(|activity| activity.sequence)
+                .max()
+                .unwrap_or_default(),
+        ))
+    });
+    crate::mod_render::refresh((snapshot.epoch, snapshot.revision));
+    *cache = Some(Cache {
+        colors: colors(&snapshot),
+        presentation: presentation(&snapshot),
+        snapshot: snapshot.into(),
+        terminal,
+        seen,
+        preview: false,
+        startup_repository: None,
+    });
+}
+
+pub(crate) fn invalidate_context() {
+    crate::mod_components::invalidate();
+    crate::mod_render::clear_tool_notices();
+    let (_, snapshot) = crate::omd::mod_snapshot();
+    let context = crate::mod_runtime::active_context();
+    let matches_context = matches_context(&snapshot, context.as_ref());
+    *BLOCKED_SNAPSHOT.locked() = (!matches_context).then_some((snapshot.epoch, snapshot.revision));
+    // `refresh` draws nothing until a publication matches the new context, so the same repository's startup preview stays up.
+    if !matches_context
+        && context.is_some_and(|context| {
+            with_cache(|cache| {
+                cache.startup_repository.as_deref() == Some(context.repository.as_path())
+            }) == Some(true)
+        })
+    {
+        return;
+    }
+    *CACHE
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
+    *INTERACTION.locked() = Interaction::default();
+}
+
+pub(crate) fn preview(snapshot: ModViewSnapshot) {
+    crate::mod_render::forget();
+    sync_interaction(&snapshot.view);
+    let mut cache = CACHE
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let seen = cache.as_ref().and_then(|cache| cache.seen);
+    *cache = Some(Cache {
+        colors: colors(&snapshot),
+        presentation: presentation(&snapshot),
+        snapshot: snapshot.into(),
+        terminal: true,
+        seen,
+        preview: true,
+        startup_repository: None,
+    });
+}
+
+pub(crate) fn startup_context_matches(repository: &std::path::Path, phase: &str) -> bool {
+    with_cache(|cache| {
+        cache.startup_repository.as_deref() == Some(repository)
+            && cache.snapshot.input["presentation"]["phase"] == phase
+    }) == Some(true)
+}
+
+pub(crate) fn startup_preview(snapshot: Option<ModViewSnapshot>, repository: &std::path::Path) {
+    *INTERACTION.locked() = Interaction::default();
+    if let Some(snapshot) = snapshot {
+        preview(snapshot);
+        if let Some(cache) = CACHE
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_mut()
+        {
+            cache.startup_repository = Some(repository.to_path_buf());
+        }
+    } else {
+        *CACHE
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = None;
+    }
+}
+
+fn with_cache<T>(read: impl FnOnce(&Cache) -> T) -> Option<T> {
+    let cache = CACHE
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    cache.as_ref().map(read)
+}
