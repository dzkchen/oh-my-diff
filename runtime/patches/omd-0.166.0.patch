+            &mut buffer,
+            &snapshot,
+        );
+        render_help(area, &snapshot, &mut buffer);
+        buffer
+    };
+    let press = |code, modifiers| input(KeyEvent::new(code, modifiers), true);
+    let region = || INTERACTION.lock().unwrap().focus_region.clone();
+    let focused = || INTERACTION.lock().unwrap().focused.clone();
+    draw();
+    assert!(press(KeyCode::Char('l'), KeyModifiers::NONE).is_none());
+    assert!(matches!(
+        press(KeyCode::Char(']'), KeyModifiers::CONTROL),
+        Some(ModInput::Consumed)
+    ));
+    assert_eq!(region().as_deref(), Some("demo/files"));
+    assert_eq!(focused().as_deref(), Some("files"));
+    let buffer = draw();
