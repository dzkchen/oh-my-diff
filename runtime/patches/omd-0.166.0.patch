+use super::*;
+use base64::Engine as _;
+use codex_omd::ModColor;
+use pretty_assertions::assert_eq;
+
+fn text(lines: &[Line<'static>]) -> Vec<String> {
+    lines
+        .iter()
+        .map(|line| {
+            line.spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect()
+        })
+        .collect()
+}
+
+fn blit_at(
+    key: &str,
+    caller: &str,
+    value: Value,
+    now: Instant,
+) -> Result<Value, codex_omd::client_surface::BlitError> {
+    blit(
+        caller,
+        Some("owner".into()),
+        Some((4, 2)),
+        &json!({"key": key, "rect": value["rect"], "cells": value["cells"]}),
+        now,
+        |_, _| unreachable!(),
+    )
+}
+
+fn packed(cells: &[(char, u32, u32)]) -> String {
+    base64::engine::general_purpose::STANDARD.encode(
+        cells
+            .iter()
+            .flat_map(|(glyph, fg, bg)| [*glyph as u32, *fg, *bg])
+            .flat_map(u32::to_le_bytes)
+            .collect::<Vec<_>>(),
+    )
+}
