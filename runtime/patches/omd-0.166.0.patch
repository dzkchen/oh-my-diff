+        assert!(send(Some("second"), "same-owner", "same-keys", json!(2)));
+        assert!(!send(None, "same-owner", "same-keys", json!(3)));
+        drop(first);
+        assert_eq!(role(Some("first"), "same-owner", "same-frame"), None);
+        assert!(send(Some("second"), "same-owner", "same-frame", json!(4)));
+        drop(second);
+        assert_eq!(
+            *seen.lock().unwrap(),
