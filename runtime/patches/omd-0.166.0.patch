+#[tokio::test]
+async fn rewrite_replaces_deletes_inserts_and_moves_rows_durably() {
+    let fixture = fixture().await;
+    let before = fixture.read().await;
+    let rows: Vec<(&str, &str, HistoryRowAccess)> = before
+        .rows
+        .iter()
+        .map(|row| (row.id.as_str(), row.kind.as_str(), row.access))
+        .collect();
+    assert_eq!(
+        rows,
+        vec![
+            ("user-1", "message.user", HistoryRowAccess::Edit),
+            ("call-1", "function_call", HistoryRowAccess::Edit),
+            ("msg_a1", "message.assistant", HistoryRowAccess::Edit),
+            ("user-2", "message.user", HistoryRowAccess::Edit),
+        ]
+    );
+
+    let after = fixture
+        .rewrite(
+            Some(before.revision.clone()),
+            vec![
+                HistoryRowEdit::Replace {
+                    id: "user-1".to_string(),
+                    items: vec![json!({
+                        "type": "message",
+                        "role": "user",
+                        "content": [{"type": "input_text", "text": "deploy with token [redacted]"}],
+                    })],
+                },
+                HistoryRowEdit::Delete {
+                    id: "call-1".to_string(),
+                },
+                HistoryRowEdit::Insert {
+                    before: None,
+                    after: Some("msg_a1".to_string()),
+                    items: vec![json!({
+                        "type": "message",
+                        "role": "assistant",
+                        "content": [{"type": "output_text", "text": "Note: token redacted."}],
+                    })],
+                },
+                HistoryRowEdit::Move {
+                    id: "user-2".to_string(),
+                    before: Some("msg_a1".to_string()),
+                    after: None,
+                },
+            ],
+            false,
+            None,
+        )
+        .await
+        .expect("rewrite");
+    assert_eq!(after.previous_revision, Some(before.revision.clone()));
+    assert_ne!(after.revision, before.revision);
+    let ids: Vec<&str> = after.rows.iter().map(|row| row.id.as_str()).collect();
+    assert_eq!(ids[0], "user-1");
+    assert_eq!(ids[1], "user-2");
+    assert_eq!(ids[2], "msg_a1");
+    assert_eq!(ids.len(), 4);
+
+    let current = fixture.current_path().await;
+    assert_ne!(current, fixture.original);
+    let rewritten = std::fs::read_to_string(&current).expect("read rewritten rollout");
+    assert!(!rewritten.contains("SECRET-1"));
+    assert!(!rewritten.contains("call-1"));
+    assert!(rewritten.contains(r#""rewritten":{"revision""#));
+    assert!(rewritten.contains(r#""op":"insert""#));
+    assert!(rewritten.contains(r#""by":"mod:redactor""#));
+    let original = std::fs::read_to_string(&fixture.original).expect("read original rollout");
+    assert!(original.contains("SECRET-1"));
+
+    let model = fixture.model_text().await;
+    assert!(!model.contains("SECRET-1"));
+    assert!(model.contains("[redacted]"));
+    assert!(model.contains("Note: token redacted."));
+    let display = fixture.display_text().await;
+    assert!(!display.contains("SECRET-1"));
+    assert!(display.contains("[redacted]"), "{display}");
+    assert!(display.contains("Note: token redacted."));
+    assert_eq!(fixture.read().await.revision, after.revision);
+}
