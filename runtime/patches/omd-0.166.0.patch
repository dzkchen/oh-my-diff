+struct ContinueOnce;
+
+impl codex_extension_api::TurnLifecycleContributor for ContinueOnce {
+    fn continue_turn<'a>(
+        &'a self,
+        input: codex_extension_api::TurnContinueInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<codex_extension_api::TurnContinuation>>
+    {
+        let continuation = (input.continued == 0).then(|| codex_extension_api::TurnContinuation {
+            source: "extension:test".into(),
+            prompt: "verify once more".into(),
+        });
+        Box::pin(std::future::ready(continuation))
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn extension_continuation_keeps_the_turn_sampling_until_it_declines() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_assistant_message("msg-1", "draft"),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-2"),
+                ev_assistant_message("msg-2", "verified"),
+                ev_completed("resp-2"),
+            ]),
+        ],
+    )
+    .await;
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.turn_lifecycle_contributor(std::sync::Arc::new(ContinueOnce));
+    let test = test_codex()
+        .with_extensions(std::sync::Arc::new(extensions.build()))
+        .build(&server)
+        .await?;
+
+    test.submit_turn("check the build").await?;
+
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 2);
+    assert_eq!(
+        request_hook_prompt_texts(&requests[1]),
+        vec!["verify once more".to_string()]
+    );
+    Ok(())
+}
