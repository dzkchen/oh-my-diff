+    fn mod_invocation(
+        &self,
+        start: fn(crate::mod_runtime::ModContext) -> crate::mod_runtime::ModInvocation,
+    ) -> crate::mod_runtime::ModInvocation {
+        let context = self.mod_context();
+        if crate::mod_runtime::synchronize_context(context.clone()) {
+            crate::mod_ui::invalidate_context();
+        }
+        start(context)
+    }
+
+    fn start_mod_command(&mut self, command: ModSlashCommand, args: String, quiet: bool) {
+        if self.thread_id.is_none() {
+            self.held_mod_commands.push((command, args, quiet));
+            return;
+        }
+        crate::mod_ui::reopen_dialogs();
+        let token = self.mod_token();
+        self.spawn_mod_commands(vec![(command, args)], token, quiet, true);
+    }
+
+    pub(crate) fn run_held_mod_commands(&mut self) {
+        for (command, args, quiet) in std::mem::take(&mut self.held_mod_commands) {
+            self.start_mod_command(command, args, quiet);
+        }
+    }
+
+    pub(crate) fn refresh_mod_panels(&mut self) {
+        let commands = self
+            .bottom_pane
+            .mod_panel_actions()
+            .into_iter()
+            .filter_map(|(command, args)| {
+                crate::mod_runtime::find(&command).map(|command| (command, args))
+            })
+            .collect::<Vec<_>>();
+        if !commands.is_empty() {
+            let token = self.mod_invocation(crate::mod_runtime::join);
+            self.spawn_mod_commands(commands, token, true, false);
+        }
+    }
+
+    fn spawn_mod_commands(
+        &mut self,
+        commands: Vec<(ModSlashCommand, String)>,
+        token: crate::mod_runtime::ModInvocation,
+        quiet: bool,
+        refresh_panels: bool,
+    ) {
+        let tx = self.app_event_tx.clone();
+        let running = self.turn_lifecycle.agent_turn_running;
+        std::thread::spawn(move || {
+            for (command, args) in commands {
+                let result = crate::mod_runtime::run_command(
+                    &command.invocation,
+                    &args,
+                    Some(&command.target),
+                    command.immediate,
+                    running,
+                    "user",
+                    &token,
+                    |_| Err("builtin_unavailable".to_owned()),
+                );
+                tx.send(AppEvent::ModCommandFinished {
+                    invocation: command.invocation,
+                    token: token.clone(),
+                    result,
+                    quiet,
+                });
+            }
+            if crate::mod_runtime::reloaded() && refresh_panels {
+                tx.send(AppEvent::ModPanelsReloaded);
+            }
+        });
+    }
+
+    pub(crate) fn on_mod_command_finished(
+        &mut self,
+        invocation: String,
+        result: Result<ModCommandResult, String>,
+        quiet: bool,
+    ) -> Option<crate::mod_runtime::ModInvocation> {
+        let ModCommandResult {
+            outcome,
+            preview,
+            refresh,
+            ..
+        } = match result {
+            Ok(result) => result,
+            Err(error) => {
+                self.add_error_message(format!("/{invocation} failed: {error}"));
+                return None;
+            }
+        };
+        if let Some(display) = outcome.display.filter(|_| !quiet) {
+            let mut lines = vec![Line::from(format!("• /{invocation}")).bold()];
+            lines.extend(display.lines().map(|line| Line::from(format!("  {line}"))));
+            self.add_plain_history_lines(lines);
+        }
+        if let Some(insert) = outcome.insert {
+            if !self.bottom_pane.composer_is_empty() {
+                self.insert_str("\n");
+            }
+            self.insert_str(&insert);
+        }
+        if let Some(submit) = outcome.submit {
+            self.submit_mod_text(submit);
+        }
+        if let Some(preview) = preview {
+            crate::mod_ui::preview(preview);
+            self.refresh_status_line();
+        }
+        self.request_redraw();
+        refresh
+    }
+
