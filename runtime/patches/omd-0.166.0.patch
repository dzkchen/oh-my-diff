+use super::*;
+
+pub const SETTINGS_FILE_EXTENSIONS: [&str; 3] = ["json", "yaml", "yml"];
+
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct SettingsFile {
+    pub path: String,
+    pub status: &'static str,
+    pub error: Option<String>,
+}
+
+impl ModStore {
+    pub fn settings_file(
+        &self,
+        package: &ModPackage,
+        selection: &ModSelection,
+    ) -> (SettingsFile, BTreeMap<String, Value>) {
+        let path = |extension: &str| {
+            self.root
+                .join("settings")
+                .join(format!("{}.{extension}", package.id))
+        };
+        let present: Vec<PathBuf> = SETTINGS_FILE_EXTENSIONS
+            .iter()
+            .map(|extension| path(extension))
+            .filter(|path| std::fs::symlink_metadata(path).is_ok())
+            .collect();
+        let chosen = present.first().cloned().unwrap_or_else(|| path("json"));
+        let mut file = SettingsFile {
+            path: chosen.to_string_lossy().into_owned(),
+            status: "missing",
+            error: None,
+        };
+        if present.is_empty() {
+            return (file, BTreeMap::new());
+        }
+        if selection.scope == MANAGED_SCOPE {
+            file.status = "ignored";
+            return (file, BTreeMap::new());
+        }
+        let values = (|| {
+            if present.len() > 1 {
+                return Err(failure("more_than_one_settings_file"));
+            }
+            let bytes = store::read(&chosen, 65_536)?;
+            let parsed: Value = match chosen.extension().and_then(|name| name.to_str()) {
+                Some("json") => serde_json::from_slice(&bytes).map_err(failure)?,
+                _ => serde_yaml::from_slice(&bytes).map_err(failure)?,
+            };
+            let Value::Object(object) = parsed else {
+                return Err(failure("settings_file_must_be_object"));
+            };
+            let values: BTreeMap<String, Value> = object.into_iter().collect();
+            let mut merged =
+                declared_settings(package.settings_schema.as_ref(), &selection.settings);
+            merged.extend(values.clone());
+            validate_settings(package, &merged)?;
+            Ok(values)
+        })();
+        match values {
+            Ok(values) => {
+                file.status = "loaded";
+                (file, values)
+            }
+            Err(error) => {
+                file.status = "invalid";
+                file.error = Some(error.to_string());
+                (file, BTreeMap::new())
+            }
+        }
+    }
+
+    pub fn settings(&self, path: &Path, settings: BTreeMap<String, Value>) -> Result<()> {
+        self.update_settings(path, |current| *current = settings)
+            .map(drop)
+    }
+
+    pub fn merge_settings(
+        &self,
+        path: &Path,
+        values: &serde_json::Map<String, Value>,
+    ) -> Result<BTreeMap<String, Value>> {
+        self.update_settings(path, |settings| {
+            for (name, value) in values {
+                if value.is_null() {
+                    settings.remove(name);
+                } else {
+                    settings.insert(name.clone(), value.clone());
+                }
+            }
+        })
+    }
+
+    fn update_settings(
+        &self,
+        path: &Path,
+        change: impl FnOnce(&mut BTreeMap<String, Value>),
+    ) -> Result<BTreeMap<String, Value>> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let mut config = self.configuration()?;
+        let selection = config
+            .mods
+            .iter_mut()
+            .find(|m| m.path == path)
+            .ok_or_else(|| failure("package_not_trusted"))?;
+        let (package, _, hash) = store::package(path)?;
+        if hash != selection.sha256 {
+            return Err(failure("source_changed: inspect and trust the new digest"));
+        }
+        let mut settings = declared_settings(package.settings_schema.as_ref(), &selection.settings);
+        change(&mut settings);
+        validate_settings(&package, &settings)?;
+        if settings == selection.settings {
+            return Ok(settings);
+        }
+        selection.settings = settings.clone();
+        config.revision = config
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| failure("revision_overflow"))?;
+        self.write("mods.json", &serde_json::to_value(config)?)?;
+        Ok(settings)
+    }
+
+    pub fn discover(user: &Path, project: &Path) -> Result<Value> {
+        let mut selected: BTreeMap<String, Value> = BTreeMap::new();
+        let mut errors = Vec::new();
+        for (scope, root) in [("user", user), ("project", project)] {
+            if !root.exists() {
+                continue;
+            }
+            let mut paths = std::fs::read_dir(root)?
+                .map(|e| e.map(|e| e.path()))
+                .collect::<std::io::Result<Vec<_>>>()?;
+            if paths.len() > 256 {
+                return Err(failure("discovery_limit"));
+            }
+            paths.sort();
+            for path in paths {
+                if !path.is_dir() {
+                    continue;
+                }
+                let result = path
+                    .canonicalize()
+                    .and_then(|path| Self::inspect_package(&path));
+                match result {
+                    Ok(mut value) => {
+                        let id = value["manifest"]["id"]
+                            .as_str()
+                            .ok_or_else(|| failure("missing_mod_id"))?
+                            .to_owned();
+                        value["scope"] = json!(scope);
+                        value["shadows"] = selected
+                            .get(&id)
+                            .map(|v| v["path"].clone())
+                            .unwrap_or(Value::Null);
+                        value["trusted"] = json!(false);
+                        selected.insert(id, value);
+                    }
+                    Err(error) => errors.push(json!({"path":path,"error":error.to_string()})),
+                }
+            }
+        }
+        Ok(
+            json!({"packages":selected.into_values().collect::<Vec<_>>(),"errors":errors,"precedence":"project over user; discovery never grants trust"}),
+        )
+    }
+
+    pub fn migrate(&self, target: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = selected(&config, target)?;
+        let (package, source, hash, assets) = store::package_with_assets(&selection.path)?;
+        if hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package.capabilities.iter().any(|c| c == "store")
+        {
+            return Err(failure("migration_requires_trusted_store_capability"));
+        }
+        let name = ModStore::state_name(&package.id, &selection.scope);
+        let previous: Value = serde_json::from_slice(
+            &store::read(&self.root.join(&name), store::STATE_LIMIT as u64).map_err(|error| {
+                if error.kind() == io::ErrorKind::NotFound {
+                    failure("migration_requires_saved_state")
+                } else {
+                    error
+                }
+            })?,
+        )?;
+        let from = previous["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if previous["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || from == u64::from(package.state_version)
+        {
+            return Err(failure("migration_requires_different_state_version"));
+        }
+        let to = package.state_version;
+        let mut loaded = detached(
+            package,
+            source,
+            assets,
+            selection.clone(),
+            previous["value"].clone(),
+        );
+        self.verified_runner()?;
+        loaded.registrations = migration_registrations(&loaded)?;
+        let state = run_migration(&loaded, from, &|| true)?;
+        let backup = format!("{name}-backup-{}", digest(&serde_json::to_vec(&previous)?));
+        self.write(&backup, &previous)?;
+        self.write(
+            &name,
+            &json!({"schema":MOD_STATE_STORAGE_SCHEMA_VERSION,"version":to,"value":state}),
+        )?;
+        Ok(
+            json!({"id":loaded.package.id,"from":from,"to":to,"backup":self.root.join(backup),
+            "source_sha256":hash,"settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+
+    pub fn rollback(&self, target: &Path, backup: &Path) -> Result<Value> {
+        let _lock = self.lock()?;
+        self.recover_package_transaction()?;
+        let config = self.configuration()?;
+        let selection = selected(&config, target)?;
+        let (package, _, hash) = store::package(&selection.path)?;
+        if selection.enabled
+            || hash != selection.sha256
+            || selection.capabilities != package.capabilities
+            || !package
+                .capabilities
+                .iter()
+                .any(|capability| capability == "store")
+        {
+            return Err(failure(
+                "rollback_requires_disabled_trusted_store_capability",
+            ));
+        }
+        let backup = backup.canonicalize()?;
+        if backup.parent() != Some(self.root.as_path()) {
+            return Err(failure("rollback_backup_must_be_in_store"));
+        }
+        let state_name = ModStore::state_name(&package.id, &selection.scope);
+        let prefix = format!("{state_name}-backup-");
+        let backup_name = backup
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| failure("rollback_backup_does_not_match_package_scope"))?;
+        let Some(expected_digest) = backup_name.strip_prefix(&prefix) else {
+            return Err(failure("rollback_backup_does_not_match_package_scope"));
+        };
+        let restored: Value =
+            serde_json::from_slice(&store::read(&backup, store::STATE_LIMIT as u64)?)?;
+        if digest(&serde_json::to_vec(&restored)?) != expected_digest {
+            return Err(failure("rollback_backup_digest_mismatch"));
+        }
+        let restored_version = restored["version"]
+            .as_u64()
+            .ok_or_else(|| failure("invalid_state_version"))?;
+        if restored["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION {
+            return Err(failure("incompatible_state_storage_schema"));
+        }
+        let current_path = self.root.join(&state_name);
+        let current: Value =
+            serde_json::from_slice(&store::read(&current_path, store::STATE_LIMIT as u64)?)?;
+        if current["schema"] != MOD_STATE_STORAGE_SCHEMA_VERSION
+            || current["version"].as_u64().is_none()
+        {
+            return Err(failure("incompatible_current_state"));
+        }
+        let recovery = format!(
+            "{state_name}-rollback-{}",
+            digest(&serde_json::to_vec(&current)?)
+        );
+        self.write(&recovery, &current)?;
+        self.write(&state_name, &restored)?;
+        Ok(
+            json!({"id":package.id,"from":current["version"],"to":restored_version,
+            "restored":backup,"recovery":self.root.join(recovery),"source_sha256":hash,
+            "settings_sha256":digest(&serde_json::to_vec(&selection.settings)?)}),
+        )
+    }
+}
+
+/// The selection for a package folder or, given a bare name, the one selected copy with that mod id.
+fn selected<'a>(config: &'a ModConfiguration, target: &Path) -> Result<&'a ModSelection> {
+    let id = (target.components().count() == 1 && target.is_relative())
+        .then(|| target.to_str())
+        .flatten();
+    let mut matches = config.mods.iter().filter(|selection| match id {
+        Some(id) => store::package(&selection.path).is_ok_and(|(package, _, _)| package.id == id),
+        None => selection.path == target,
+    });
+    match (matches.next(), matches.next()) {
+        (Some(selection), None) => Ok(selection),
+        (Some(_), Some(_)) => Err(failure(
+            "mod_ambiguous: more than one selected copy has this id; pass its package folder",
+        )),
+        _ => Err(failure("package_not_trusted")),
+    }
+}
+
+/// Whether a state read failed on thread or checkout state stored at another version that the mod can migrate; store-scope state migrates only through `ModStore::migrate`.
+pub(super) fn migratable(
+    loaded: &Loaded,
+    location: &store::StateLocation,
+    error: &io::Error,
+) -> bool {
+    matches!(location, store::StateLocation::Directory(..))
+        && error.to_string().starts_with("state_migration_required")
+        && loaded.package.capabilities.iter().any(|c| c == "store")
+        && loaded.registrations.events.iter().any(|e| e == "migrate")
+}
+
+pub(super) fn migrate_state(
+    loaded: &Loaded,
+    location: &store::StateLocation,
+    active: &dyn Fn() -> bool,
+) -> Result<Value> {
+    let store::StateLocation::Directory(directory, name) = location else {
+        return Err(failure(
+            "state_migration_required: previous state preserved",
+        ));
+    };
+    store::migrate_directory_state(
+        directory,
+        name,
+        loaded.package.state_version,
+        |from, value| {
+            let mut previous = loaded.clone();
+            previous.state = value;
+            previous.registrations = migration_registrations(&previous)?;
+            run_migration(&previous, from, active)
+        },
+    )
+}
+
+pub(super) fn detached(
+    package: ModPackage,
+    source: String,
+    assets: BTreeMap<String, String>,
+    selection: ModSelection,
+    state: Value,
+) -> Loaded {
+    Loaded {
+        package,
+        source: source.into(),
+        assets: Arc::new(store::asset_map(assets)),
+        request_metadata: Arc::new(OnceLock::new()),
+        code_cache: None,
+        selection,
+        adapter: None,
+        state,
+        registered_state: std::sync::Arc::default(),
+        ui: None,
+        ui_state: Value::Null,
+        ui_revision: 0,
+        ui_clears: 0,
+        command_view: None,
+        registrations: Registrations::default(),
+        source_use: ModSourceUse::default(),
+        unused_grants: Vec::new(),
+        unused_environment: Vec::new(),
+        withheld: Vec::new(),
+        settings_file: SettingsFile {
+            path: String::new(),
+            status: "missing",
+            error: None,
+        },
+        error: None,
+        telemetry: ModTelemetry::default(),
+    }
+}
+
+pub(super) fn migration_registrations(loaded: &Loaded) -> Result<Registrations> {
+    let inspected = ModHost::run(loaded, "inspect", "", Value::Null, &|| true)?;
+    ModHost::validate_registrations(&loaded.package, &inspected.registrations)?;
+    if inspected.state != loaded.state
+        || !inspected
+            .registrations
+            .events
+            .iter()
+            .any(|e| e == "migrate")
+    {
+        return Err(failure("explicit_migration_handler_required"));
+    }
+    Ok(inspected.registrations)
+}
+
+fn run_migration(loaded: &Loaded, from: u64, active: &dyn Fn() -> bool) -> Result<Value> {
+    let to = loaded.package.state_version;
+    let reply = ModHost::run(loaded, "migrate", "", json!({"from":from,"to":to}), active)?;
+    if reply.registrations != loaded.registrations {
+        return Err(failure("migration_changed_registration"));
+    }
+    Ok(reply.state)
+}
diff --git a/codex-rs/omd/src/mods/persisted.rs b/codex-rs/omd/src/mods/persisted.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb228f8813ecf358864e76057fe3345344b41d27
--- /dev/null
+++ b/codex-rs/omd/src/mods/persisted.rs
@@ -0,0 +1,194 @@
+use super::*;
+
+/// JSON bytes of entries per callback; the payload carries them twice (`input` and `original`).
+pub const PERSIST_CHUNK_BYTES: usize = 49_152;
+pub const PERSIST_WITHHELD: &str = "[withheld: a required history_persist interceptor failed]";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PersistedRewrite {
+    pub texts: Vec<String>,
+    pub by: String,
+}
+
+fn escaped(c: char) -> usize {
+    match c {
+        '"' | '\\' | '\n' | '\r' | '\t' | '\u{8}' | '\u{c}' => 2,
+        c if u32::from(c) < 0x20 => 6,
+        c => c.len_utf8(),
+    }
+}
+
+/// Where a chunk of `text` ends: within `budget` JSON-escaped bytes, after the last whitespace there so a token stays whole, and after at least one character.
+pub fn persist_cut(text: &str, budget: usize) -> usize {
+    let mut size = 0;
+    let end = text
+        .char_indices()
+        .find(|(_, c)| {
+            size += escaped(*c);
+            size > budget
+        })
+        .map_or(
+            text.len(),
+            |(at, c)| if at == 0 { c.len_utf8() } else { at },
+        );
+    if end == text.len() {
+        return end;
+    }
+    text[..end]
+        .rfind(|c: char| c.is_ascii_whitespace())
+        .map_or(end, |at| at + 1)
+}
+
+/// Entries (`{kind, role, call_id, text}`) in callbacks of at most `PERSIST_CHUNK_BYTES` of JSON; a longer text arrives as consecutive entries with the same index.
+pub fn persist_chunks(entries: &[Value]) -> Vec<Vec<(usize, Value)>> {
+    let mut chunks: Vec<Vec<(usize, Value)>> = vec![Vec::new()];
+    let mut size = 0;
+    for (index, entry) in entries.iter().enumerate() {
+        let mut rest = entry["text"].as_str().unwrap_or_default();
+        let value = |text: &str| {
+            json!({"index":index,"kind":entry["kind"],"role":entry["role"],
+                "call_id":entry["call_id"],"text":text})
+        };
+        let overhead = value("").to_string().len();
+        loop {
+            let cut = persist_cut(rest, PERSIST_CHUNK_BYTES.saturating_sub(overhead));
+            let piece = value(&rest[..cut]);
+            let bytes = piece.to_string().len();
+            if size + bytes > PERSIST_CHUNK_BYTES {
+                chunks.push(Vec::new());
+                size = 0;
+            }
+            size += bytes;
+            if let Some(chunk) = chunks.last_mut() {
+                chunk.push((index, piece));
+            }
+            rest = &rest[cut..];
+            if rest.is_empty() {
+                break;
+            }
+        }
+    }
+    chunks
+}
+
+/// Mods whose link changed the entries: what it passed down or returned differs from its downstream's, or, answering alone, its result differs from its input; every mod that ran when a truncated trace shows no such link.
+pub fn persist_changed_by(trace: &[Value]) -> Vec<String> {
+    let ran = |entry: &&Value| entry.get("returned").is_some();
+    let links = trace
+        .iter()
+        .filter(ran)
+        .filter(|entry| entry["mod"] != "engine")
+        .collect::<Vec<_>>();
+    let changed = links
+        .iter()
+        .copied()
+        .filter(|link| {
+            match trace
+                .iter()
+                .filter(ran)
+                .filter(|entry| entry["index"].as_u64() > link["index"].as_u64())
+                .min_by_key(|entry| entry["index"].as_u64())
+            {
+                Some(next) => {
+                    link["received"] != next["received"] || link["returned"] != next["returned"]
+                }
+                None => link["received"] != link["returned"],
+            }
+        })
+        .collect::<Vec<_>>();
+    if changed.is_empty() { links } else { changed }
+        .into_iter()
+        .filter_map(|link| link["mod"].as_str())
+        .map(|id| format!("mod:{id}"))
+        .collect()
+}
+
+/// `None` when no interceptor is installed or nothing changed; a required interceptor's failure withholds its entries. `Err` means the runtime itself was unusable, so the caller decides from the published requirement.
+pub fn persist_texts(
+    runtime: &Mutex<ModHost>,
+    thread: &str,
+    entries: &[Value],
+    active: impl Fn() -> bool,
+) -> std::result::Result<Option<PersistedRewrite>, &'static str> {
+    if !active() {
+        return Err("persist_runtime_unavailable");
+    }
+    let _thread = StateThread::enter(Some(thread.to_owned()));
+    let mut runtime = runtime.lock().map_err(|_| "persist_runtime_unavailable")?;
+    runtime
+        .refresh_guarded(&active)
+        .map_err(|_| "persist_runtime_unavailable")?;
+    let required = match runtime.intercepts("history_persist") {
+        Some(required) => required,
+        None => return Ok(None),
+    };
+    let mut texts = vec![String::new(); entries.len()];
+    let mut withheld = vec![false; entries.len()];
+    let mut by = Vec::new();
+    for chunk in persist_chunks(entries) {
+        if !active() {
+            return Err("persist_runtime_unavailable");
+        }
+        let values = chunk
+            .iter()
+            .map(|(_, entry)| entry.clone())
+            .collect::<Vec<_>>();
+        let chain = chain::intercept(
+            &mut Access::Held(&mut runtime),
+            &mut |_, call| {
+                Err(std::io::Error::other(format!(
+                    "host_operation_unavailable: history_persist interceptors run while history is persisted ({})",
+                    call.operation
+                )))
+            },
+            &mut chain::Core::Call(&mut |input| Ok(json!({"entries": input["entries"]}))),
+            "history_persist",
+            required,
+            json!({"thread_id":thread,"entries":values}),
+            json!({"caller":"host","thread_id":thread}),
+            &active,
+            &InvocationScope::default(),
+        )
+        .ok();
+        let rewritten = chain
+            .as_ref()
+            .and_then(|chain| chain.result["entries"].as_array());
+        let mut changed = false;
+        for (position, (index, original)) in chunk.iter().enumerate() {
+            let given = original["text"].as_str().unwrap_or_default();
+            let text = rewritten
+                .and_then(|entries| entries.get(position))
+                .and_then(|entry| entry["text"].as_str());
+            match text {
+                Some(text) => {
+                    changed |= text != given;
+                    texts[*index].push_str(text);
+                }
+                None => {
+                    withheld[*index] |= required;
+                    texts[*index].push_str(given);
+                }
+            }
+        }
+        if changed && let Some(chain) = &chain {
+            by.extend(persist_changed_by(&chain.trace));
+        }
+    }
+    if !active() {
+        return Err("persist_runtime_unavailable");
+    }
+    for (text, withheld) in texts.iter_mut().zip(&withheld) {
+        if *withheld {
+            *text = PERSIST_WITHHELD.to_owned();
+        }
+    }
+    if withheld.contains(&true) {
+        by.push("host".to_owned());
+    }
+    by.sort();
+    by.dedup();
+    Ok((!by.is_empty()).then(|| PersistedRewrite {
+        texts,
+        by: by.join(", "),
+    }))
+}
diff --git a/codex-rs/omd/src/mods/policy.rs b/codex-rs/omd/src/mods/policy.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d857ab935658103c7dae9ee2050c4756910076d5
--- /dev/null
+++ b/codex-rs/omd/src/mods/policy.rs
@@ -0,0 +1,493 @@
+use super::*;
+use std::os::unix::fs::MetadataExt;
+
+#[cfg(target_os = "macos")]
+pub const MANAGED_POLICY_FILE: &str = "/Library/Application Support/OhMyDiff/policy.json";
+#[cfg(not(target_os = "macos"))]
+pub const MANAGED_POLICY_FILE: &str = "/etc/oh-my-diff/policy.json";
+pub const MANAGED_POLICY_KEY: &str = "mods";
+pub const MANAGED_SCOPE: &str = "managed";
+const MANAGED_POLICY_BYTES: u64 = 65_536;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ManagedUpdates {
+    #[default]
+    User,
+    Managed,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum ManagedTier {
+    Prepend,
+    Append,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedPackage {
+    pub id: String,
+    pub source: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    pub version: String,
+    pub sha256: String,
+    pub capabilities: Vec<String>,
+    #[serde(default)]
+    pub dependencies: bool,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub secret_environment: Vec<String>,
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub settings: BTreeMap<String, Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub tier: Option<ManagedTier>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub users: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub projects: Option<Vec<PathBuf>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub percent: Option<u8>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub mirrors: Vec<String>,
+}
+
+/// An immutable package index: the first location holding exactly `sha256` is used.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedIndex {
+    pub sha256: String,
+    pub locations: Vec<PathBuf>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedPolicy {
+    pub schema: u32,
+    #[serde(default)]
+    pub managed_only: bool,
+    #[serde(default = "allowed")]
+    pub sideload: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub sources: Option<Vec<String>>,
+    #[serde(default)]
+    pub updates: ManagedUpdates,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub deny: Vec<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub capabilities: Option<Vec<String>>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub packages: Vec<ManagedPackage>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub index: Option<ManagedIndex>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub registry: Option<String>,
+}
+
+fn allowed() -> bool {
+    true
+}
+
+impl ManagedIndex {
+    pub fn location(&self) -> Result<PathBuf> {
+        self.locations
+            .iter()
+            .find(|location| {
+                store::read(location, 524_288).is_ok_and(|bytes| digest(&bytes) == self.sha256)
+            })
+            .cloned()
+            .ok_or_else(|| {
+                failure(format!(
+                    "managed_index_unavailable: no location holds index {}",
+                    self.sha256
+                ))
+            })
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Managed {
+    pub origin: String,
+    pub sha256: String,
+    pub policy: ManagedPolicy,
+}
+
+impl ManagedPolicy {
+    pub fn parse(value: Value) -> Result<Self> {
+        let policy: Self = serde_json::from_value(value)
+            .map_err(|error| failure(format!("managed_policy_invalid: {error}")))?;
+        let invalid = |reason: &str| failure(format!("managed_policy_invalid: {reason}"));
+        let capabilities = |list: &[String]| {
+            list.iter()
+                .all(|capability| MOD_CAPABILITIES.contains(&capability.as_str()))
+        };
+        let sha256 = crate::contract_document::sha256_hex;
+        if policy.schema != 1 {
+            return Err(invalid("schema must be 1"));
+        }
+        if policy.index.as_ref().is_some_and(|index| {
+            !sha256(&index.sha256)
+                || index.locations.is_empty()
+                || !index
+                    .locations
+                    .iter()
+                    .all(|location| location.is_absolute())
+        }) {
+            return Err(invalid("index needs a sha256 and absolute locations"));
+        }
+        if !policy.deny.iter().all(|id| identifier(id)) {
+            return Err(invalid("deny lists mod IDs"));
+        }
+        if policy
+            .sources
+            .iter()
+            .flatten()
+            .any(|source| source.trim().is_empty())
+        {
+            return Err(invalid("sources are non-empty reference prefixes"));
+        }
+        if policy
+            .capabilities
+            .as_ref()
+            .is_some_and(|ceiling| !capabilities(ceiling))
+        {
+            return Err(invalid("capabilities lists host capabilities"));
+        }
+        for package in &policy.packages {
+            if !identifier(&package.id)
+                || !sha256(&package.sha256)
+                || !capabilities(&package.capabilities)
+                || package
+                    .percent
+                    .is_some_and(|percent| !(1..=100).contains(&percent))
+                || package
+                    .projects
+                    .iter()
+                    .flatten()
+                    .any(|project| !project.is_absolute())
+            {
+                return Err(invalid(&format!(
+                    "package {} needs an ID, a sha256, host capabilities, absolute projects and percent 1-100",
+                    package.id
+                )));
+            }
+        }
+        Ok(policy)
+    }
+
+    pub fn refusal(
+        &self,
+        id: &str,
+        capabilities: &[String],
+        source: Option<&str>,
+    ) -> Option<String> {
+        if self.deny.iter().any(|denied| denied == id) {
+            return Some(format!(
+                "managed_denied: {id} is revoked by administrator policy"
+            ));
+        }
+        if self.managed_only {
+            return Some(format!(
+                "managed_only: administrator policy loads only managed mods, not {id}"
+            ));
+        }
+        if let Some(capability) = self.capabilities.as_ref().and_then(|ceiling| {
+            capabilities
+                .iter()
+                .find(|capability| !ceiling.contains(capability))
+        }) {
+            return Some(format!(
+                "managed_capability_denied: administrator policy withholds {capability} from {id}"
+            ));
+        }
+        match source {
+            None if self.sources.is_some() => Some(format!(
+                "managed_source_unverified: {id} needs broker-protected package provenance; reinstall from a verified source"
+            )),
+            None if !self.sideload => Some(format!(
+                "managed_sideload_denied: administrator policy loads {id} only from an installed package"
+            )),
+            Some(source) if !self.source_allowed(source) => Some(format!(
+                "managed_source_denied: administrator policy does not allow {source}"
+            )),
+            _ => None,
+        }
+    }
+
+    pub fn install_refusal(
+        &self,
+        id: &str,
+        capabilities: &[String],
+        source: &str,
+        update: bool,
+    ) -> Option<String> {
+        if update && self.updates == ManagedUpdates::Managed {
+            return Some(format!(
+                "managed_updates_denied: administrator policy manages package versions; {id} stays as installed"
+            ));
+        }
+        self.refusal(id, capabilities, Some(source))
+    }
+
+    pub fn source_allowed(&self, reference: &str) -> bool {
+        if reference.split('/').any(|segment| {
+            let segment = segment.to_ascii_lowercase().replace("%2e", ".");
+            segment == "."
+                || segment == ".."
+                || segment.contains("%2f")
+                || segment.contains("%5c")
+                || segment.contains('\\')
+        }) {
+            return false;
+        }
+        self.sources.as_ref().is_none_or(|allowed| {
+            allowed.iter().any(|prefix| {
+                reference == prefix
+                    || reference
+                        .strip_prefix(prefix.trim_end_matches('/'))
+                        .is_some_and(|rest| rest.starts_with('/') || rest.starts_with('#'))
+            })
+        })
+    }
+}
+
+pub fn managed(value: Value, origin: String) -> Result<Managed> {
+    let sha256 = digest(crate::broker::canonical(&value).as_bytes());
+    Ok(Managed {
+        origin,
+        sha256,
+        policy: ManagedPolicy::parse(value)?,
+    })
+}
+
+/// The administrator policy: the broker's when deployed and set, otherwise the root-owned policy file.
+pub fn load_managed() -> Result<Option<Managed>> {
+    load_managed_from(Path::new(MANAGED_POLICY_FILE), 0)
+}
+
+pub fn load_managed_from(file: &Path, owner: u32) -> Result<Option<Managed>> {
+    if crate::broker::deployed() {
+        let value = crate::broker::call("policy.get", json!({"key": MANAGED_POLICY_KEY}))?;
+        if !value.is_null() {
+            return managed(value, "broker".to_owned()).map(Some);
+        }
+    }
+    let canonical = match file.canonicalize() {
+        Ok(canonical) => canonical,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error),
+    };
+    let trusted = |path: &Path, folder: bool| {
+        std::fs::symlink_metadata(path).is_ok_and(|metadata| {
+            (metadata.uid() == 0 || metadata.uid() == owner)
+                && (metadata.mode() & 0o022 == 0 || folder && metadata.mode() & 0o1000 != 0)
+        })
+    };
+    if !trusted(&canonical, false)
+        || !canonical
+            .ancestors()
+            .skip(1)
+            .all(|folder| trusted(folder, true))
+    {
+        return Err(failure(format!(
+            "managed_policy_untrusted: {} and its folders must be owned by root and writable only by their owner",
+            file.display()
+        )));
+    }
+    let value = serde_json::from_slice(&store::read(&canonical, MANAGED_POLICY_BYTES)?)
+        .map_err(|error| failure(format!("managed_policy_invalid: {error}")))?;
+    managed(value, canonical.display().to_string()).map(Some)
+}
+
+pub fn login() -> String {
+    let mut entry: libc::passwd = unsafe { std::mem::zeroed() };
+    let mut buffer = vec![0 as libc::c_char; 4096];
+    let mut found = std::ptr::null_mut();
+    let status = unsafe {
+        libc::getpwuid_r(
+            libc::getuid(),
+            &mut entry,
+            buffer.as_mut_ptr(),
+            buffer.len(),
+            &mut found,
+        )
+    };
+    if status != 0 || found.is_null() {
+        return format!("uid:{}", rustix::process::getuid().as_raw());
+    }
+    unsafe { std::ffi::CStr::from_ptr(entry.pw_name) }
+        .to_string_lossy()
+        .into_owned()
+}
+
+fn cohort(user: &str, id: &str) -> u8 {
+    let hash = digest(format!("{user}\0{id}").as_bytes());
+    (u64::from_str_radix(&hash[..8], 16).unwrap_or_default() % 100) as u8
+}
+
+impl ManagedPackage {
+    pub fn assigned(&self, user: &str) -> bool {
+        self.users
+            .as_ref()
+            .is_none_or(|users| users.iter().any(|name| name == user))
+            && self
+                .percent
+                .is_none_or(|percent| cohort(user, &self.id) < percent)
+    }
+
+    pub fn applies(&self, user: &str, project: Option<&Path>) -> bool {
+        self.assigned(user)
+            && self.projects.as_ref().is_none_or(|projects| {
+                project.is_some_and(|project| {
+                    projects.iter().any(|root| {
+                        project.starts_with(root.canonicalize().as_deref().unwrap_or(root))
+                    })
+                })
+            })
+    }
+}
+
+/// What `package-sync` last deployed to a store; only fully installed generations are recorded.
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedDeployment {
+    pub generation: u64,
+    pub policy_sha256: String,
+    pub packages: Vec<DeployedPackage>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub previous: Option<Box<ManagedDeployment>>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct DeployedPackage {
+    pub id: String,
+    pub version: String,
+    pub sha256: String,
+    pub path: PathBuf,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub dependencies: Vec<String>,
+}
+
+impl Managed {
+    /// The first applicable entry per ID is the target; later entries are fallbacks outside a rollout.
+    pub fn targets(&self, user: &str, project: Option<&Path>) -> Vec<&ManagedPackage> {
+        let mut seen = BTreeSet::new();
+        self.policy
+            .packages
+            .iter()
+            .filter(|package| package.applies(user, project) && seen.insert(package.id.clone()))
+            .collect()
+    }
+
+    pub fn deployable(&self, user: &str) -> Vec<&ManagedPackage> {
+        let mut seen = BTreeSet::new();
+        self.policy
+            .packages
+            .iter()
+            .filter(|package| {
+                package.assigned(user) && seen.insert((package.id.clone(), package.sha256.clone()))
+            })
+            .collect()
+    }
+
+    /// Each target loads when deployed; otherwise the first applicable deployed entry keeps running until the next sync; deployed dependencies of running entries load under their own policy entry; content the policy no longer lists never loads.
+    pub(super) fn selections(
+        &self,
+        deployment: &ManagedDeployment,
+        user: &str,
+        project: Option<&Path>,
+    ) -> (Vec<ModSelection>, Vec<ModRejection>) {
+        let (mut selections, mut pending) = (Vec::new(), Vec::new());
+        let selection = |package: &ManagedPackage, deployed: &DeployedPackage| ModSelection {
+            path: deployed.path.clone(),
+            sha256: deployed.sha256.clone(),
+            enabled: true,
+            capabilities: package.capabilities.clone(),
+            settings: package.settings.clone(),
+            scope: MANAGED_SCOPE.to_owned(),
+            secret_environment: package.secret_environment.clone(),
+            expires_at: None,
+            tier: package.tier,
+            required: false,
+        };
+        let targets = self.targets(user, project);
+        let mut loading: BTreeSet<&str> = targets.iter().map(|target| target.id.as_str()).collect();
+        let mut dependencies = Vec::new();
+        let verified_dependencies = |package: &ManagedPackage, deployed: &DeployedPackage| {
+            store::package(&deployed.path)
+                .ok()
+                .filter(|(manifest, _, hash)| {
+                    package.dependencies && *hash == package.sha256 && manifest.id == package.id
+                })
+                .map(|(manifest, _, _)| manifest.dependencies)
+                .unwrap_or_default()
+        };
+        for target in targets {
+            let chosen = self
+                .policy
+                .packages
+                .iter()
+                .filter(|package| package.id == target.id && package.applies(user, project))
+                .find_map(|package| {
+                    let deployed = deployment.packages.iter().find(|deployed| {
+                        deployed.id == package.id && deployed.sha256 == package.sha256
+                    })?;
+                    Some((package, deployed))
+                });
+            if chosen.is_none_or(|(package, _)| package.sha256 != target.sha256) {
+                pending.push(ModRejection {
+                    path: PathBuf::from(&target.source),
+                    id: Some(target.id.clone()),
+                    scope: MANAGED_SCOPE.to_owned(),
+                    reason: format!(
+                        "managed_pending_sync: {} {} is not deployed to this store; run omd-mod package-sync",
+                        target.id, target.sha256
+                    ),
+                });
+            }
+            if let Some((package, deployed)) = chosen {
+                selections.push(selection(package, deployed));
+                dependencies.extend(verified_dependencies(package, deployed));
+            }
+        }
+        while let Some(dependency) = dependencies.pop() {
+            let Some((package, deployed)) = self.policy.packages.iter().find_map(|package| {
+                if package.id != dependency.id {
+                    return None;
+                }
+                let deployed = deployment.packages.iter().find(|deployed| {
+                    deployed.id == package.id
+                        && deployed.sha256 == package.sha256
+                        && store::package(&deployed.path).is_ok_and(|(manifest, _, hash)| {
+                            hash == package.sha256
+                                && manifest.id == package.id
+                                && service_version_satisfies(&dependency.version, &manifest.version)
+                        })
+                })?;
+                Some((package, deployed))
+            }) else {
+                continue;
+            };
+            if loading.insert(&package.id) {
+                selections.push(selection(package, deployed));
+                dependencies.extend(verified_dependencies(package, deployed));
+            }
+        }
+        (selections, pending)
+    }
+}
+
+pub fn source_reference(source: &package_manager::ModPackageSource) -> String {
+    match source {
+        package_manager::ModPackageSource::Local { path } => path.display().to_string(),
+        package_manager::ModPackageSource::Repository { repository, .. } => {
+            format!("git+{repository}")
+        }
+        package_manager::ModPackageSource::Package { index, id, .. } => {
+            format!("index:{}#{id}", index.display())
+        }
+        package_manager::ModPackageSource::Npm {
+            package, registry, ..
+        } => format!("npm:{registry}/{package}"),
+    }
+}
