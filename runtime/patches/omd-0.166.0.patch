+fn packed(cells: &[[u32; 3]]) -> String {
+    STANDARD.encode(
+        cells
+            .iter()
+            .flatten()
+            .flat_map(|word| word.to_le_bytes())
+            .collect::<Vec<_>>(),
+    )
+}
