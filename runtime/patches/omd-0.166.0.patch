+        assert_eq!(role(None, "other", "pr-frame"), None);
+        assert!(!send(None, "other", "pr-frame", json!(1)));
+        assert!(send(None, "owner", "pr-frame", json!(2)));
+        drop(binding);
+        assert!(!send(None, "owner", "pr-frame", json!(3)));
+        assert_eq!(*seen.lock().unwrap(), vec![json!(2)]);
