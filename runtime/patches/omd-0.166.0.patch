+fn kill_group_if_alive(group: u32, reaped: &Mutex<bool>) {
+    let reaped = reaped.lock().unwrap_or_else(PoisonError::into_inner);
+    if !*reaped {
+        let _ = kill_process_group(group);
+    }
+}
