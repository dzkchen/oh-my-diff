+        blit_at(
+            &"k".repeat(codex_omd::client_surface::BLIT_CALL_BYTES),
+            "owner",
+            cell.clone(),
+            now
+        ),
+        Err("terminal_blit_too_large".into())
+    );
+    for invalid in [
+        json!({"rect": {"x": 4, "y": 0, "width": 1, "height": 1}, "cells": ["x"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 2, "height": 1}, "cells": ["x"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["xy"]}),
+        json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["\u{7}"]}),
+    ] {
