+                if batch.1.iter().any(|p| p == "src/a.txt") {
+                    return batch;
+                }
+                seen.push(batch);
+            }
+        }
+        panic!("{seen:?}")
+    })
+    .await
+    .unwrap();
+    assert_eq!(watch_id, id);
+    assert!(paths.iter().any(|p| p == "src/a.txt"), "{paths:?}");
