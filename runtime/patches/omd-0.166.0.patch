+        assert_eq!(buffer[(1, 0)].symbol(), "E");
+        assert_eq!(buffer[(1, 11)].symbol(), ">");
+        assert!(rows(&buffer, screen).contains("Create project"));
+        let interaction = INTERACTION.lock().unwrap();
+        assert!(interaction.order.iter().any(|id| id == "recipe"));
+        let hitbox = interaction
+            .hitboxes
+            .iter()
+            .find(|hitbox| hitbox.id == "recipe")
