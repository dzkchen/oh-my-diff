+                r#"<svg><rect fill="url(http://e/p)"/></svg>"#,
+                "svg_url_external",
+            ),
+            (
+                r#"<svg><rect style="fill:-WebKit-Image-Set(&quot;x&quot; 1x)"/></svg>"#,
+                "svg_url_external",
+            ),
