+impl ModHost {
+    /// Refuses or restricts packages through `admission` interceptors; policy mods and their dependencies are not judged.
+    pub(super) fn admit(&mut self, active: &dyn Fn() -> bool) {
+        for loaded in self.loaded.values_mut() {
+            loaded.withheld.clear();
+        }
+        let Some(required) = self.intercepts("admission") else {
+            return;
+        };
+        let mut exempt = BTreeSet::new();
+        let mut pending = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .any(|interceptor| granted(loaded, &interceptor.pattern, "admission"))
+            })
+            .map(|(id, _)| id.clone())
+            .collect::<Vec<_>>();
+        while let Some(id) = pending.pop() {
+            if exempt.insert(id.clone())
+                && let Some(loaded) = self.loaded.get(&id)
+            {
+                pending.extend(
+                    loaded
+                        .package
+                        .dependencies
+                        .iter()
+                        .map(|dependency| dependency.id.clone()),
+                );
+                pending.extend(loaded.package.requires.iter().cloned());
+            }
+        }
+        let scope = exempt
+            .iter()
+            .filter_map(|id| self.loaded.get(id)?.package.policy.as_ref())
+            .flat_map(|policy| policy.namespaces.clone())
+            .collect::<Vec<_>>();
+        let policy = crate::mods::digest(
+            &serde_json::to_vec(
+                &exempt
+                    .iter()
+                    .filter_map(|id| {
+                        let selection = &self.loaded.get(id)?.selection;
+                        Some(json!([id, selection.sha256, selection.settings]))
+                    })
+                    .collect::<Vec<_>>(),
+            )
+            .unwrap_or_default(),
+        );
+        let candidates = self
+            .order
+            .iter()
+            .filter(|id| !exempt.contains(*id))
+            .filter(|id| {
+                self.loaded
+                    .get(*id)
+                    .is_some_and(|loaded| loaded.error.is_none())
+            })
+            .cloned()
+            .collect::<Vec<_>>();
+        let mut refused = BTreeMap::new();
+        for id in candidates {
+            if !active() {
+                return;
+            }
+            let Some(loaded) = self.loaded.get(&id) else {
+                continue;
+            };
+            let key = format!("{}:{policy}", loaded.selection.sha256);
+            let decision = match self.admissions.get(&key) {
+                Some(decision) => decision.clone(),
+                None => {
+                    let package = &loaded.package;
+                    let input = json!({"package": {"id": id, "version": package.version,
+                        "sha256": loaded.selection.sha256, "source": loaded.selection.path,
+                        "scope": loaded.selection.scope, "capabilities": package.capabilities,
+                        "dependencies": package.dependencies, "requires": package.requires,
+                        "services": package.services, "registrations": loaded.registrations,
+                        "source_use": loaded.source_use}, "reason": "load"});
+                    let chain = intercept(
+                        &mut Access::Held(self),
+                        &mut |_, _| {
+                            Err(failure(
+                                "host_operation_unavailable: admission runs without host operations",
+                            ))
+                        },
+                        &mut Core::Call(&mut |_| Ok(json!({"admit": true}))),
+                        "admission",
+                        required,
+                        input,
+                        json!({"caller": "engine"}),
+                        active,
+                        &InvocationScope::default(),
+                    );
+                    match chain {
+                        Ok(chain) => {
+                            let decision = admission(&chain.result, &scope);
+                            if chain.trace.iter().all(|entry| entry["reason"].is_null()) {
+                                if self.admissions.len() >= 256 {
+                                    self.admissions.clear();
+                                }
+                                self.admissions.insert(key, decision.clone());
+                            }
+                            decision
+                        }
+                        Err(error) => Err(format!("admission_policy_unavailable: {error}")),
+                    }
+                }
+            };
+            match decision {
+                Ok(withheld) => {
+                    if let Some(loaded) = self.loaded.get_mut(&id) {
+                        loaded.withheld = withheld;
+                    }
+                }
+                Err(reason) => {
+                    refused.insert(id, reason);
+                }
+            }
+        }
+        loop {
+            let services = refused
+                .keys()
+                .filter_map(|id| self.loaded.get(id))
+                .flat_map(|loaded| &loaded.registrations.services)
+                .map(|contract| &contract.name)
+                .collect::<BTreeSet<_>>();
+            let dependents = self
+                .loaded
+                .iter()
+                .filter(|(id, _)| !refused.contains_key(*id) && !exempt.contains(*id))
+                .filter_map(|(id, loaded)| {
+                    let refusal = loaded
+                        .package
+                        .dependencies
+                        .iter()
+                        .map(|dependency| &dependency.id)
+                        .chain(&loaded.package.requires)
+                        .find(|dependency| refused.contains_key(*dependency))
+                        .or_else(|| {
+                            loaded
+                                .package
+                                .services
+                                .imports
+                                .iter()
+                                .find(|import| !import.optional && services.contains(&import.name))
+                                .map(|import| &import.name)
+                        })?;
+                    Some((id.clone(), format!("dependency_not_admitted: {refusal}")))
+                })
+                .collect::<Vec<_>>();
+            if dependents.is_empty() {
+                break;
+            }
+            refused.extend(dependents);
+        }
+        for (id, reason) in refused {
+            if let Some(loaded) = self.loaded.remove(&id) {
+                self.order.retain(|item| *item != id);
+                self.rejected.push(ModRejection {
+                    path: loaded.selection.path,
+                    id: Some(id),
+                    scope: loaded.selection.scope,
+                    reason,
+                });
+            }
+        }
+    }
+
+    pub fn policy_owners(&self) -> Vec<String> {
+        self.loaded
+            .iter()
+            .filter(|(_, loaded)| {
+                self.policies.contains(&loaded.selection.path)
+                    || loaded.registrations.interceptors.iter().any(|interceptor| {
+                        interceptor.required && granted(loaded, &interceptor.pattern, "model_send")
+                    })
+            })
+            .map(|(id, _)| id.clone())
+            .collect()
+    }
+
+    pub fn send_policy(&self) -> Option<SendPolicy> {
+        let required = self.intercepts("model_send");
+        if required.is_none() && self.policies.is_empty() {
+            return None;
+        }
+        let unavailable = self.policies.iter().find_map(|path| {
+            let shadowed = |rejection: &ModRejection| {
+                (&rejection.path == path && rejection.reason.starts_with("shadowed_by_"))
+                    .then(|| self.loaded.get(rejection.id.as_deref()?))
+                    .flatten()
+            };
+            let Some(loaded) = self
+                .loaded
+                .values()
+                .find(|loaded| &loaded.selection.path == path)
+                .or_else(|| self.rejected.iter().find_map(shadowed))
+            else {
+                let rejection = self
+                    .rejected
+                    .iter()
+                    .find(|rejection| &rejection.path == path);
+                return Some(match rejection {
+                    Some(rejection) => format!(
+                        "{}: {}",
+                        rejection.id.as_deref().unwrap_or("mod"),
+                        rejection.reason
+                    ),
+                    None => format!("{} is not loaded", path.display()),
+                });
+            };
+            let id = &loaded.package.id;
+            if let Some(error) = &loaded.error {
+                return Some(format!("{id}: {error}"));
+            }
+            (!loaded.registrations.interceptors.iter().any(|interceptor| {
+                interceptor.required && granted(loaded, &interceptor.pattern, "model_send")
+            }))
+            .then(|| format!("{id} registers no required model_send interceptor"))
+        });
+        let policies = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .any(|interceptor| granted(loaded, &interceptor.pattern, "model_send"))
+            })
+            .map(|(id, loaded)| json!([id, loaded.selection.sha256, loaded.selection.settings]))
+            .collect::<Vec<_>>();
+        let fingerprint = crate::mods::digest(
+            &serde_json::to_vec(&json!([self.generation, policies])).unwrap_or_default(),
+        );
+        Some(SendPolicy {
+            required: required == Some(true) || !self.policies.is_empty(),
+            unavailable,
+            fingerprint,
+        })
+    }
+
+    fn unserved_on(&self, surface: &str) -> Option<&(String, Vec<String>, String)> {
+        self.unserved
+            .iter()
+            .find(|(_, capabilities, _)| selects("*", surface, capabilities))
+    }
+
+    /// `Some(true)` when a required interceptor, including a faulted mod's, or a managed target that isn't running selects `surface`.
+    pub fn intercepts(&self, surface: &str) -> Option<bool> {
+        if self.unserved_on(surface).is_some() {
+            return Some(true);
+        }
+        self.loaded
+            .values()
+            .flat_map(|loaded| {
+                loaded
+                    .registrations
+                    .interceptors
+                    .iter()
+                    .filter(|interceptor| {
+                        (loaded.error.is_none() || interceptor.required)
+                            && granted(loaded, &interceptor.pattern, surface)
+                    })
+                    .map(|interceptor| interceptor.required)
+            })
+            .max()
+    }
+
+    pub fn intercepts_with(&self, surface: &str, feature: &str) -> bool {
+        self.loaded.values().any(|loaded| {
+            loaded
+                .package
+                .compatibility
+                .required_features
+                .iter()
+                .any(|required| required == feature)
+                && loaded.registrations.interceptors.iter().any(|interceptor| {
+                    (loaded.error.is_none() || interceptor.required)
+                        && granted(loaded, &interceptor.pattern, surface)
+                })
+        })
+    }
+
+    /// Runs a hostless surface's chain on the held runtime, so no link waits for the lock; `None` when nothing intercepts it.
+    pub fn intercept_held(
+        &mut self,
+        surface: &str,
+        input: Value,
+        origin: Value,
+        active: &dyn Fn() -> bool,
+        core: &mut dyn FnMut(Value) -> Result<Value>,
+    ) -> Result<Option<Value>> {
+        let Some(required) = self.intercepts(surface) else {
+            return Ok(None);
+        };
+        let chain = intercept(
+            &mut Access::Held(self),
+            &mut |_, call| {
+                Err(failure(format!(
+                    "host_operation_unavailable: {surface} interceptors run without host operations ({})",
+                    call.operation
+                )))
+            },
+            &mut Core::Call(core),
+            surface,
+            required,
+            input,
+            origin,
+            active,
+            &InvocationScope::default(),
+        )?;
+        Ok(Some(chain.result))
+    }
+
+    pub(super) fn may_intercept(&self, surface: &str, input: &Value) -> bool {
+        self.links(surface)
+            .iter()
+            .any(|link| link.matcher.is_null() || may_match(&link.matcher, input))
+    }
+
+    /// Managed prepend, ordinary and managed append tiers; in each, ordinary links wrap required ones and a faulted mod's required links stay and fail closed.
+    fn links(&self, surface: &str) -> Vec<Link> {
+        let order = order(&self.loaded).unwrap_or_default();
+        let faulted = self
+            .loaded
+            .iter()
+            .filter(|(_, loaded)| loaded.error.is_some())
+            .map(|(id, _)| id.clone());
+        let required_order = order.iter().cloned().chain(faulted).collect::<Vec<_>>();
+        let tier = |loaded: &Loaded| match (loaded.selection.scope == MANAGED_SCOPE)
+            .then_some(loaded.selection.tier)
+            .flatten()
+        {
+            Some(ManagedTier::Prepend) => 0,
+            None => 1,
+            Some(ManagedTier::Append) => 2,
+        };
+        let mut links = Vec::new();
+        for position in 0..3 {
+            for (required, order) in [(false, &order), (true, &required_order)] {
+                for id in order {
+                    let Some(loaded) = self
+                        .loaded
+                        .get(id)
+                        .filter(|loaded| tier(loaded) == position)
+                    else {
+                        continue;
+                    };
+                    for (index, interceptor) in loaded.registrations.interceptors.iter().enumerate()
+                    {
+                        if interceptor.required == required
+                            && granted(loaded, &interceptor.pattern, surface)
+                        {
+                            links.push(Link {
+                                id: id.clone(),
+                                index,
+                                required,
+                                guard: required && loaded.selection.scope == MANAGED_SCOPE,
+                                catch: interceptor.catch,
+                                location: interceptor.location.clone(),
+                                matcher: interceptor.matcher.clone(),
+                                generation: self.generation,
+                            });
+                        }
+                    }
+                }
+            }
+        }
+        links
+    }
+}
+
+/// An admission result: the withheld namespaces, which must fall inside a policy mod's `policy.namespaces`, or the refusal.
+fn admission(result: &Value, scope: &[String]) -> std::result::Result<Vec<String>, String> {
+    if let Some(reason) = result.get("deny") {
+        return Err(format!(
+            "admission_denied: {}",
+            reason.as_str().unwrap_or_default()
+        ));
+    }
+    let withheld = result["withhold"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(Value::as_str)
+        .map(str::to_owned)
+        .collect::<Vec<_>>();
+    match withheld.iter().find(|namespace| {
+        !scope
+            .iter()
+            .any(|pattern| crate::mods::namespace_matches(pattern, namespace))
+    }) {
+        Some(namespace) => Err(format!(
+            "admission_policy_invalid: {namespace} is outside policy.namespaces"
+        )),
+        None => Ok(withheld),
+    }
+}
+
+pub fn compose_rows(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    field: &str,
+    key: &str,
+    rows: Vec<Value>,
+) -> Result<Vec<Value>> {
+    let required = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?
+        .intercepts(surface);
+    let Some(required) = required else {
+        return Ok(rows);
+    };
+    let chain = intercept_shared(
+        runtime,
+        surface,
+        required,
+        json!({field: rows}),
+        json!({"caller": "user"}),
+        || true,
+        |_, _| {
+            Err(failure(format!(
+                "host_operation_unavailable: {surface} runs without host operations"
+            )))
+        },
+        |effective| Ok(json!({field: effective[field]})),
+    )?;
+    let composed = chain.result[field].as_array().cloned().unwrap_or_default();
+    Ok(rows
+        .into_iter()
+        .map(
+            |mut row| match composed.iter().find(|item| item[key] == row[key]) {
+                Some(item) => item.clone(),
+                None => {
+                    row["hidden"] = json!(true);
+                    row
+                }
+            },
+        )
+        .collect())
+}
+
+pub fn continue_operation(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    input: Value,
+    origin: Value,
+    active: impl Fn() -> bool,
+    host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    mut core: impl FnMut(Value) -> Result<Value>,
+) -> Result<Value> {
+    let required = runtime
+        .lock()
+        .map_err(|_| failure("mod_runtime_poisoned"))?
+        .intercepts(surface);
+    let result = match required {
+        Some(required) => {
+            intercept_shared(
+                runtime, surface, required, input, origin, active, host, core,
+            )?
+            .result
+        }
+        None if !active() => return Err(failure("callback_cancelled")),
+        None => core(input)?,
+    };
+    match result.get("deny").and_then(Value::as_str) {
+        Some(reason) => Err(failure(format!("{surface}_denied: {reason}"))),
+        None => Ok(result),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn intercept_shared(
+    runtime: &Mutex<ModHost>,
+    surface: &str,
+    required: bool,
+    input: Value,
+    origin: Value,
+    active: impl Fn() -> bool,
+    mut host: impl FnMut(&str, ModHostCall) -> Result<Value>,
+    mut core: impl FnMut(Value) -> Result<Value>,
+) -> Result<ModChain> {
+    intercept(
+        &mut Access::Bounded(runtime, REQUIRED_WAIT),
+        &mut host,
+        &mut Core::Call(&mut core),
+        surface,
+        required,
+        input,
+        origin,
+        &active,
+        &InvocationScope::default(),
+    )
+}
diff --git a/codex-rs/omd/src/mods/code_cache.rs b/codex-rs/omd/src/mods/code_cache.rs
new file mode 100644
index 0000000000000000000000000000000000000000..69480d23f5108cc0e92ca3f5bce897694badcb17
--- /dev/null
+++ b/codex-rs/omd/src/mods/code_cache.rs
@@ -0,0 +1,242 @@
+//! V8 bytecode of package modules kept across runner processes, by module source and runner build.
+//!
+//! Entries hold bytecode only: the runner always compiles the request's trusted source, so the cache can't supply code.
+
+use super::Result;
+use serde_json::Map;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeSet;
+use std::os::unix::fs::DirBuilderExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+
+const LIMIT: u64 = 32 << 20;
+/// Bytes written to a cache root between prunes.
+const PRUNE_EVERY: u64 = LIMIT / 8;
+
+/// The runner's key for a module: the hex SHA-256 of `"{typescript}:{source}"`.
+fn key(typescript: bool, source: &str) -> String {
+    format!("{:x}", Sha256::digest(format!("{typescript}:{source}")))
+}
+
+/// Every module a runner may compile for `request`, as the runner keys them.
+fn keys<R>(request: &R) -> BTreeSet<String>
+where
+    R: for<'a> std::ops::Index<&'a str, Output = Value>,
+{
+    let mut modules = vec![(true, &request["source"])];
+    for (name, asset) in request["assets"].as_object().into_iter().flatten() {
+        if !name.ends_with(".json") {
+            modules.push((name.ends_with(".ts"), &asset["text"]));
+        }
+    }
+    let adapter = &request["surface"]["adapter"];
+    modules.push((true, &adapter["source"]));
+    for alias in adapter["aliases"]
+        .as_object()
+        .into_iter()
+        .flatten()
+        .map(|(_, alias)| alias)
+    {
+        let typescript = alias["filename"]
+            .as_str()
+            .is_some_and(|name| name.ends_with(".ts"));
+        modules.push((typescript, &alias["source"]));
+    }
+    modules
+        .into_iter()
+        .filter_map(|(typescript, source)| Some(key(typescript, source.as_str()?)))
+        .collect()
+}
+
+/// A mod's cache root and, once computed, the modules its requests may compile.
+pub(super) struct CacheRoot {
+    root: PathBuf,
+    expected: OnceLock<BTreeSet<String>>,
+}
+
+impl CacheRoot {
+    pub(super) fn new(root: PathBuf) -> Self {
+        Self {
+            root,
+            expected: OnceLock::new(),
+        }
+    }
+}
+
+pub(super) struct CodeCache {
+    directory: PathBuf,
+    expected: BTreeSet<String>,
+}
+
+impl CodeCache {
+    /// The cache for `request` under `cache`, keyed by the runner's file stamp; `None` without a runner.
+    pub(super) fn open<R>(cache: &CacheRoot, request: &R) -> Option<Self>
+    where
+        R: for<'a> std::ops::Index<&'a str, Output = Value>,
+    {
+        let runner = super::process::runner_path().ok()?;
+        let stamp = super::file_stamp(&std::fs::metadata(runner).ok()?);
+        let name = format!("{:x}", Sha256::digest(format!("{stamp:?}")));
+        Some(Self {
+            directory: cache.root.join(&name[..16]),
+            expected: cache.expected.get_or_init(|| keys(request)).clone(),
+        })
+    }
+
+    /// The line offering a fresh runner the intact cached bytecode within `budget` bytes. It lists every expected
+    /// module (`null` where none is cached), so the runner reports exactly those it compiles fresh.
+    pub(super) fn line(&self, budget: usize) -> Option<Vec<u8>> {
+        let mut entries = Map::new();
+        // `{"code_cache":{}}` plus a newline, then per entry its quoted name, colon and comma.
+        let mut size = 20;
+        for name in &self.expected {
+            let cached = self
+                .read(name)
+                .filter(|entry| size + entry.to_string().len() + name.len() + 4 <= budget);
+            size += cached.as_ref().map_or(4, |entry| entry.to_string().len()) + name.len() + 4;
+            entries.insert(name.clone(), cached.unwrap_or(Value::Null));
+        }
+        let mut line = serde_json::to_vec(&json!({"code_cache": entries})).ok()?;
+        line.push(b'\n');
+        Some(line)
+    }
+
+    /// An intact entry: its SHA-256 then a JSON body holding the bytecode.
+    fn read(&self, name: &str) -> Option<Value> {
+        let bytes = std::fs::read(self.directory.join(name)).ok()?;
+        let (sum, body) = bytes.split_at_checked(32)?;
+        let entry = serde_json::from_slice::<Value>(body).ok()?;
+        (Sha256::digest(body).as_slice() == sum && entry["data"].is_string()).then_some(entry)
+    }
+
+    /// Keeps bytecode the runner compiled for this request; anything else it reports is ignored.
+    pub(super) fn keep(&self, reported: &Value) {
+        let Some(name) = reported["key"]
+            .as_str()
+            .filter(|name| self.expected.contains(*name))
+        else {
+            return;
+        };
+        let Some(data) = reported["data"].as_str() else {
+            return;
+        };
+        let _ = self.write(name, &json!({"data": data}));
+    }
+
+    fn write(&self, name: &str, entry: &Value) -> Result<()> {
+        std::fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(&self.directory)?;
+        let body = serde_json::to_vec(entry)?;
+        let mut bytes = Sha256::digest(&body).to_vec();
+        bytes.extend_from_slice(&body);
+        crate::fsio::write_bytes(
+            &self.directory.join(name),
+            &bytes,
+            crate::fsio::Durability::Volatile,
+        )?;
+        static WRITTEN: Mutex<Vec<(PathBuf, u64)>> = Mutex::new(Vec::new());
+        let due = {
+            let mut written = WRITTEN
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let root = self
+                .directory
+                .parent()
+                .map(Path::to_path_buf)
+                .unwrap_or_default();
+            let index = match written.iter().position(|(seen, _)| *seen == root) {
+                Some(index) => index,
+                // A process prunes a root at its first write there, then every `PRUNE_EVERY` bytes.
+                None => {
+                    written.push((root, PRUNE_EVERY));
+                    written.len() - 1
+                }
+            };
+            let since = &mut written[index].1;
+            *since += bytes.len() as u64;
+            let due = *since >= PRUNE_EVERY;
+            if due {
+                *since = 0;
+            }
+            due
+        };
+        if due {
+            self.prune();
+        }
+        Ok(())
+    }
+
+    /// Drops the oldest entries of every runner build beyond `LIMIT`, then emptied directories.
+    fn prune(&self) {
+        let Some(root) = self.directory.parent() else {
+            return;
+        };
+        let directories: Vec<_> = std::fs::read_dir(root)
+            .into_iter()
+            .flatten()
+            .flatten()
+            .map(|directory| directory.path())
+            .collect();
+        let mut entries: Vec<_> = directories
+            .iter()
+            .flat_map(|directory| std::fs::read_dir(directory).into_iter().flatten().flatten())
+            .filter_map(|entry| {
+                let metadata = entry.metadata().ok()?;
+                Some((metadata.modified().ok()?, metadata.len(), entry.path()))
+            })
+            .collect();
+        let mut total: u64 = entries.iter().map(|(_, size, _)| size).sum();
+        entries.sort();
+        for (_, size, path) in entries {
+            if total <= LIMIT {
+                break;
+            }
+            if std::fs::remove_file(path).is_ok() {
+                total -= size;
+            }
+        }
+        for directory in directories {
+            if directory != self.directory {
+                let _ = std::fs::remove_dir(directory);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_corrupt_entry_is_not_offered() {
+        let temp = tempfile::tempdir().unwrap();
+        let cache = CodeCache {
+            directory: temp.path().join("runner"),
+            expected: ["a", "b"].map(String::from).into(),
+        };
+        for name in ["a", "b"] {
+            cache.keep(&json!({"key": name, "code": "c", "data": "d"}));
+        }
+        assert_eq!(
+            std::fs::read(cache.directory.join("a")).unwrap()[32..],
+            *br#"{"data":"d"}"#
+        );
+        let path = cache.directory.join("b");
+        let bytes = std::fs::read(&path).unwrap();
+        let at = bytes.len() - 3;
+        assert_eq!(&bytes[at..], b"d\"}");
+        let mut corrupt = bytes;
+        corrupt[at] = b'e';
+        std::fs::write(&path, corrupt).unwrap();
+        let line: Value = serde_json::from_slice(&cache.line(1 << 20).unwrap()).unwrap();
+        assert_eq!(line, json!({"code_cache": {"a": {"data": "d"}, "b": null}}));
+    }
+}
