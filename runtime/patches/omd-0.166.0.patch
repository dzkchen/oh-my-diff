+        invocation: "probe".to_string(),
+        description: String::new(),
+        args_hint: None,
+        immediate: false,
+        target: crate::mod_runtime::ModSlashTarget {
+            id: "probe_fixture".to_string(),
+            command: "probe".to_string(),
+        },
+        namespaced: false,
+    };
+    chat.run_mod_command(command, String::new());
+    assert_eq!(chat.held_mod_commands.len(), 1);
+
+    let thread_id = ThreadId::new();
+    chat.handle_thread_session(configured_thread_session(thread_id));
+    assert!(chat.held_mod_commands.is_empty());
+    let token = tokio::time::timeout(std::time::Duration::from_secs(10), async {
