+#[test]
+#[serial_test::serial]
+fn focused_key_documents_take_keys_and_paste_until_released() {
+    let colors = crate::terminal_probe::DefaultColors {
+        fg: (240, 240, 240),
+        bg: (0, 0, 0),
+    };
+    crate::terminal_palette::with_test_default_colors(colors, || {
+        let snapshot = snapshot(
+            serde_json::json!({"sidebar_width":30,"sites":{"sidebar":{"components":[
+                {"type":"document","id":"buffer","label":"Buffer","keys":true,"lines":[[{"text":"ab"},{"text":"c","bg":"#00ff00"}]]},
+                {"type":"document","id":"viewer","label":"Viewer","lines":[[{"text":"plain"}]]}
+            ]}}}),
+        );
+        preview(snapshot.clone());
+        let area = Rect::new(0, 0, 100, 24);
+        let mut buffer = Buffer::empty(area);
+        render(area, area, &mut buffer, &snapshot);
+        let cell = (0..area.height)
+            .flat_map(|y| (0..area.width).map(move |x| (x, y)))
+            .find(|&(x, y)| buffer[(x, y)].symbol() == "c")
+            .unwrap();
+        assert_ne!(buffer[cell].bg, Color::Reset);
+        assert!(focus("buffer"));
+        let press = |code, modifiers| input(KeyEvent::new(code, modifiers), true);
+        assert!(matches!(
+            press(KeyCode::Tab, KeyModifiers::NONE),
+            Some(ModInput::Consumed)
+        ));
+        assert_eq!(
+            INTERACTION.lock().unwrap().focused.as_deref(),
+            Some("buffer")
+        );
