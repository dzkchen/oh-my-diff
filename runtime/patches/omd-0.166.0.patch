@@ -0,0 +1,69 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn text(item: ResponseInputItem) -> (String, Option<bool>) {
+    let ResponseInputItem::FunctionCallOutput { output, .. } = item else {
+        panic!("expected a function call output");
+    };
+    (output.body.to_text().unwrap_or_default(), output.success)
+}
+
+#[test]
+fn merged_results_fan_out_by_call_id_and_missing_results_fail() {
+    let merged = Ok((r#"{"a":"alpha","b":{"n":2}}"#.to_owned(), true));
+    assert_eq!(
+        text(fan_out("a", &merged, false)),
+        ("alpha".to_owned(), Some(true))
+    );
+    assert_eq!(
+        text(fan_out("b", &merged, false)),
+        (r#"{"n":2}"#.to_owned(), Some(true))
+    );
+    let (missing, success) = text(fan_out("c", &merged, false));
+    assert!(missing.contains("no result for c"));
+    assert_eq!(success, Some(false));
+    let (failed, success) = text(fan_out("a", &Err("denied".to_owned()), false));
+    assert!(failed.contains("denied"));
+    assert_eq!(success, Some(false));
+    let (unparsed, _) = text(fan_out("a", &Ok(("plain".to_owned(), true)), false));
+    assert!(unparsed.contains("no result for a"));
+}
+
+#[test]
+fn merged_results_may_carry_a_success_flag_per_call_when_the_merge_asks() {
+    let merged = Ok((
+        r#"{"a":{"output":"read","success":true},"b":{"output":"missing","success":false},"c":{"output":"x","success":true,"extra":1}}"#
+            .to_owned(),
+        true,
+    ));
+    assert_eq!(
+        text(fan_out("a", &merged, true)),
+        ("read".to_owned(), Some(true))
+    );
+    assert_eq!(
+        text(fan_out("b", &merged, true)),
+        ("missing".to_owned(), Some(false))
+    );
+    let (extra, success) = text(fan_out("c", &merged, true));
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&extra).ok(),
+        Some(serde_json::json!({"extra": 1, "output": "x", "success": true}))
+    );
+    assert_eq!(success, Some(true));
+    assert_eq!(
+        text(fan_out("b", &merged, false)),
+        (
+            r#"{"output":"missing","success":false}"#.to_owned(),
+            Some(true)
+        ),
+        "without the flag the value stays text, as before"
+    );
+    let failed = Ok((
+        r#"{"a":{"output":"read","success":true}}"#.to_owned(),
+        false,
+    ));
+    assert_eq!(
+        text(fan_out("a", &failed, true)),
+        ("read".to_owned(), Some(false))
+    );
+}
diff --git a/codex-rs/core/src/tools/code_mode/kernels.rs b/codex-rs/core/src/tools/code_mode/kernels.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ddb24413679a1c2827b6eeee636d42cbb5d50110
--- /dev/null
+++ b/codex-rs/core/src/tools/code_mode/kernels.rs
@@ -0,0 +1,835 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::time::Duration;
+
+use codex_code_mode::CellId;
+use codex_code_mode::CodeModeNestedToolCall;
+use codex_code_mode::CodeModeToolKind;
+use codex_code_mode::ToolDefinition;
+use codex_tools::ToolName;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+use super::submit_nested_tool;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::tools::parallel::ToolCallRuntime;
+
+const MAX_CODE_BYTES: usize = 32768;
+const MAX_BRIDGE_CALLS: usize = 32;
+const MAX_BRIDGE_REQUEST_BYTES: u64 = 65536;
+const MAX_BRIDGE_RESPONSE_BYTES: usize = 262144;
+const MAX_CELL_DURATION: Duration = Duration::from_secs(120);
+const RESULT_PREFIX: &str = "CODE_KERNEL_RESULT:";
+const MAX_DRIVER_BYTES: u64 = 262144;
+pub(crate) const TOOL_NAME: &str = "kernel";
+
+fn kernel_name(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 32
+        && value.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_' || byte == b'-'
+        })
+}
+
+fn shell_word(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn kernel_command(kernel: &codex_features::CodeModeKernelToml) -> Result<String, String> {
+    if !kernel_name(&kernel.name)
+        || kernel.command.is_empty()
+        || kernel.command.len() > 16
+        || kernel
+            .command
+            .iter()
+            .any(|arg| arg.is_empty() || arg.contains('\0'))
+        || !kernel.driver.is_absolute()
+        || kernel.driver_sha256.len() != 64
+    {
+        return Err(format!("kernel {} configuration is invalid", kernel.name));
+    }
+    let metadata = std::fs::symlink_metadata(&kernel.driver)
+        .map_err(|error| format!("kernel {} driver unavailable: {error}", kernel.name))?;
+    if !metadata.is_file() || metadata.len() > MAX_DRIVER_BYTES {
+        return Err(format!(
+            "kernel {} driver is not a bounded regular file",
+            kernel.name
+        ));
+    }
+    let bytes = std::fs::read(&kernel.driver).map_err(|error| error.to_string())?;
+    let digest = format!("{:x}", <sha2::Sha256 as sha2::Digest>::digest(&bytes));
+    if !digest.eq_ignore_ascii_case(&kernel.driver_sha256) {
+        return Err(format!("kernel {} driver changed", kernel.name));
+    }
+    let driver = String::from_utf8(bytes).map_err(|_| "kernel driver must be UTF-8".to_string())?;
+    let words = kernel
+        .command
+        .iter()
+        .map(|arg| shell_word(arg))
+        .chain(std::iter::once(shell_word(&driver)))
+        .collect::<Vec<_>>();
+    Ok(format!("stty raw -echo; {}", words.join(" ")))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct KernelRequest {
+    kernel: String,
+    code: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BridgeRequest {
+    token: String,
+    name: String,
+    arguments: Value,
+}
+
+#[derive(Deserialize)]
+struct WorkerResult {
+    ok: bool,
+    output: String,
+    error: Option<String>,
+    #[serde(default)]
+    bridge_failed: bool,
+}
+
+pub(crate) fn definition(kernels: &[codex_features::CodeModeKernelToml]) -> ToolDefinition {
+    let names = kernels
+        .iter()
+        .map(|kernel| kernel.name.as_str())
+        .collect::<Vec<_>>()
+        .join("', '");
+    ToolDefinition {
+        name: TOOL_NAME.into(),
+        tool_name: ToolName::plain(TOOL_NAME),
+        description: format!(
+            "Run a cell in a persistent configured interpreter kernel. Within the cell, tool(name, arguments) calls the currently authorized agent tools through the loopback bridge. Input: {{kernel: '{names}', code: string}}. Output is bounded."
+        ),
+        kind: CodeModeToolKind::Function,
+        input_schema: None,
+        input_schema_max_bytes: None,
+        output_schema: None,
+    }
+}
+
+type WorkerSlot = Arc<Mutex<Option<WorkerState>>>;
+
+pub(super) struct KernelManager {
+    workers: std::sync::Mutex<HashMap<String, WorkerSlot>>,
+    live: std::sync::Mutex<HashMap<String, i32>>,
+    active: AtomicBool,
+}
+
+struct WorkerState {
+    process_id: i32,
+    listener: Arc<TcpListener>,
+    port: u16,
+    scope: String,
+}
+
+impl KernelManager {
+    pub(super) fn new() -> Self {
+        Self {
+            workers: std::sync::Mutex::new(HashMap::new()),
+            live: std::sync::Mutex::new(HashMap::new()),
+            active: AtomicBool::new(false),
+        }
+    }
+
+    pub(super) fn has_workers(&self) -> bool {
+        self.active.load(Ordering::Acquire)
+    }
+
+    fn track(&self, language: &str, process_id: Option<i32>) {
+        if let Ok(mut live) = self.live.lock() {
+            match process_id {
+                Some(process_id) => live.insert(language.to_owned(), process_id),
+                None => live.remove(language),
+            };
+            self.active.store(!live.is_empty(), Ordering::Release);
+        }
+    }
+
+    async fn retire(&self, session: &Arc<Session>, language: &str, worker: WorkerState) {
+        self.track(language, None);
+        session
+            .services
+            .unified_exec_manager
+            .terminate_process(worker.process_id)
+            .await;
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "one cell at a time per language worker"
+    )]
+    pub(super) async fn run(
+        &self,
+        session: Arc<Session>,
+        step_context: Arc<StepContext>,
+        runtime: ToolCallRuntime,
+        invocation: CodeModeNestedToolCall,
+        enabled_tools: Vec<ToolDefinition>,
+        cancellation: CancellationToken,
+    ) -> Result<Value, String> {
+        let kernels = &step_context.turn.config.code_mode.kernels;
+        if kernels.is_empty() {
+            return Err("no code-mode kernels are configured".into());
+        }
+        let input = invocation.input.ok_or("kernel input is required")?;
+        let request: KernelRequest =
+            serde_json::from_value(input).map_err(|error| error.to_string())?;
+        let kernel = kernels
+            .iter()
+            .find(|kernel| kernel.name == request.kernel)
+            .ok_or_else(|| format!("kernel {} is not configured", request.kernel))?;
+        let language = kernel.name.as_str();
+        if request.code.len() > MAX_CODE_BYTES {
+            return Err("kernel code limit exceeded".into());
+        }
+        if !enabled_tools.iter().any(|tool| tool.name == "exec_command")
+            || !enabled_tools.iter().any(|tool| tool.name == "write_stdin")
+        {
+            return Err("managed process tools are unavailable in this cell".into());
+        }
+        let cell_cancel = cancellation.child_token();
+        let slot = Arc::clone(
+            self.workers
+                .lock()
+                .map_err(|_| "kernel workers poisoned")?
+                .entry(language.to_owned())
+                .or_default(),
+        );
+        let mut worker = slot.lock().await;
+        let environment = step_context
+            .environments
+            .primary()
+            .ok_or("kernel workers require a turn environment")?;
+        let cwd = environment
+            .cwd()
+            .to_abs_path()
+            .map_err(|error| error.to_string())?;
+        let scope = serde_json::to_string(&(cwd.as_path(), environment.permission_profile()))
+            .map_err(|error| error.to_string())?;
+        if let Some(stale) = worker.take_if(|worker| worker.scope != scope) {
+            self.retire(&session, language, stale).await;
+        }
+        let (process_id, listener, port) = if let Some(worker) = worker.as_ref() {
+            (worker.process_id, Arc::clone(&worker.listener), worker.port)
+        } else {
+            let listener = Arc::new(
+                TcpListener::bind("127.0.0.1:0")
+                    .await
+                    .map_err(|error| format!("kernel loopback bridge unavailable: {error}"))?,
+            );
+            let port = listener
+                .local_addr()
+                .map_err(|error| error.to_string())?
+                .port();
+            let result = native_call(
+                Arc::clone(&session),
+                Arc::clone(&step_context),
+                runtime.clone(),
+                &invocation.cell_id,
+                "exec_command",
+                json!({
+                    "cmd": kernel_command(kernel)?,
+                    "workdir": cwd.as_path().to_string_lossy(),
+                    "tty": true,
+                    "yield_time_ms": 1000,
+                    "max_output_tokens": 256
+                }),
+                cell_cancel.clone(),
+                Some(port),
+            )
+            .await?;
+            let process_id = result["session_id"]
+                .as_i64()
+                .and_then(|value| i32::try_from(value).ok())
+                .ok_or_else(|| {
+                    format!("{language} worker failed to start: {}", result["output"])
+                })?;
+            *worker = Some(WorkerState {
+                process_id,
+                listener: Arc::clone(&listener),
+                port,
+                scope,
+            });
+            self.track(language, Some(process_id));
+            (process_id, listener, port)
+        };
+
+        let token = uuid::Uuid::new_v4().to_string();
+        let bridge_cancel = cell_cancel.child_token();
+        let bridge = tokio::spawn(serve_bridge(
+            listener,
+            token.clone(),
+            invocation.cell_id.clone(),
+            Arc::clone(&session),
+            Arc::clone(&step_context),
+            runtime.clone(),
+            enabled_tools,
+            bridge_cancel.clone(),
+        ));
+        let payload =
+            json!({"code": request.code, "port": port, "token": token}).to_string() + "\n";
+        let result = tokio::time::timeout(MAX_CELL_DURATION, async {
+            let mut buffer = String::new();
+            let mut chars = payload;
+            loop {
+                let result = native_call(
+                    Arc::clone(&session),
+                    Arc::clone(&step_context),
+                    runtime.clone(),
+                    &invocation.cell_id,
+                    "write_stdin",
+                    json!({
+                        "session_id": process_id,
+                        "chars": chars,
+                        "yield_time_ms": if chars.is_empty() { 5000 } else { 1000 },
+                        "max_output_tokens": MAX_BRIDGE_RESPONSE_BYTES
+                    }),
+                    cell_cancel.clone(),
+                    None,
+                )
+                .await?;
+                chars.clear();
+                if let Some(output) = result["output"].as_str() {
+                    buffer.push_str(output);
+                }
+                if buffer.len() > MAX_BRIDGE_RESPONSE_BYTES {
+                    return Err("kernel output limit exceeded".into());
+                }
+                if let Some(result) = parse_worker_result(&buffer)? {
+                    return Ok(result);
+                }
+                if result["session_id"].is_null() {
+                    return Err("kernel worker disconnected".into());
+                }
+            }
+        })
+        .await
+        .unwrap_or_else(|_| Err("kernel cell timed out".to_string()));
+        cell_cancel.cancel();
+        bridge_cancel.cancel();
+        bridge.abort();
+        if (result.as_ref().map_or(true, |worker| worker.bridge_failed)
+            || cancellation.is_cancelled())
+            && let Some(failed) = worker.take()
+        {
+            self.retire(&session, language, failed).await;
+        }
+        let result = result?;
+        Ok(
+            json!({"kernel": language, "ok": result.ok, "output": result.output, "error": result.error}),
+        )
+    }
+
+    pub(super) async fn shutdown(&self, session: &Arc<Session>) {
+        if let Ok(mut workers) = self.workers.lock() {
+            workers.clear();
+        }
+        let live = self
+            .live
+            .lock()
+            .map(|mut live| {
+                live.drain()
+                    .map(|(_, process_id)| process_id)
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        self.active.store(false, Ordering::Release);
+        for process_id in live {
+            session
+                .services
+                .unified_exec_manager
+                .terminate_process(process_id)
+                .await;
+        }
+    }
+}
+
+fn parse_worker_result(buffer: &str) -> Result<Option<WorkerResult>, String> {
+    let Some(start) = buffer.find(RESULT_PREFIX) else {
+        return Ok(None);
+    };
+    let body = &buffer[start + RESULT_PREFIX.len()..];
+    let Some(end) = body.find('\n') else {
+        return Ok(None);
+    };
+    serde_json::from_str(&body[..end])
+        .map(Some)
+        .map_err(|error| format!("invalid kernel result: {error}"))
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn native_call(
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    cell_id: &CellId,
+    name: &str,
+    arguments: Value,
+    cancellation: CancellationToken,
+    native_loopback_port: Option<u16>,
+) -> Result<Value, String> {
+    let call = CodeModeNestedToolCall {
+        cell_id: cell_id.clone(),
+        runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+        tool_name: ToolName::plain(name),
+        tool_kind: CodeModeToolKind::Function,
+        input: Some(arguments),
+    };
+    let future = submit_nested_tool(
+        session,
+        step_context,
+        runtime,
+        call,
+        uuid::Uuid::new_v4().to_string(),
+        cancellation,
+        native_loopback_port,
+    )
+    .map_err(|error| error.to_string())?;
+    future.await.map_err(|error| error.to_string())
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn serve_bridge(
+    listener: Arc<TcpListener>,
+    token: String,
+    cell_id: CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: Vec<ToolDefinition>,
+    cancellation: CancellationToken,
+) {
+    let tools = Arc::new(enabled_tools);
+    let count = Arc::new(AtomicUsize::new(0));
+    loop {
+        let socket = tokio::select! {
+            _ = cancellation.cancelled() => break,
+            accepted = listener.accept() => match accepted {
+                Ok((socket, _)) => socket,
+                Err(_) => break,
+            },
+        };
+        let task_token = token.clone();
+        let task_cell = cell_id.clone();
+        let task_session = Arc::clone(&session);
+        let task_step = Arc::clone(&step_context);
+        let task_runtime = runtime.clone();
+        let task_tools = Arc::clone(&tools);
+        let task_count = Arc::clone(&count);
+        let task_cancel = cancellation.clone();
+        tokio::spawn(async move {
+            handle_connection(
+                socket,
+                task_token,
+                task_cell,
+                task_session,
+                task_step,
+                task_runtime,
+                task_tools,
+                task_count,
+                task_cancel,
+            )
+            .await;
+        });
+    }
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn handle_connection(
+    socket: TcpStream,
+    token: String,
+    cell_id: CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: Arc<Vec<ToolDefinition>>,
+    count: Arc<AtomicUsize>,
+    cancellation: CancellationToken,
+) {
+    let mut socket = socket;
+    let mut bytes = Vec::new();
+    let result = tokio::time::timeout(Duration::from_secs(5), async {
+        let mut chunk = [0_u8; 4096];
+        loop {
+            let size = socket.read(&mut chunk).await?;
+            if size == 0 {
+                break;
+            }
+            bytes.extend_from_slice(&chunk[..size]);
+            if bytes.ends_with(b"\n") || bytes.len() as u64 > MAX_BRIDGE_REQUEST_BYTES {
+                break;
+            }
+        }
+        Ok::<(), std::io::Error>(())
+    })
+    .await;
+    let response = match result {
+        Ok(Ok(_)) if bytes.ends_with(b"\n") && bytes.len() as u64 <= MAX_BRIDGE_REQUEST_BYTES => {
+            dispatch_bridge(
+                &bytes,
+                &token,
+                &cell_id,
+                session,
+                step_context,
+                runtime,
+                &enabled_tools,
+                &count,
+                cancellation,
+            )
+            .await
+        }
+        _ => Err("invalid or oversized bridge request".into()),
+    };
+    let message = match response {
+        Ok(value) => json!({"ok": true, "result": value}),
+        Err(error) => json!({"ok": false, "error": error}),
+    };
+    let mut payload = serde_json::to_vec(&message)
+        .ok()
+        .filter(|payload| payload.len() < MAX_BRIDGE_RESPONSE_BYTES)
+        .unwrap_or_else(|| br#"{"ok":false,"error":"tool response limit exceeded"}"#.to_vec());
+    payload.push(b'\n');
+    let _ = socket.write_all(&payload).await;
+}
+
+#[expect(clippy::too_many_arguments)]
+async fn dispatch_bridge(
+    bytes: &[u8],
+    token: &str,
+    cell_id: &CellId,
+    session: Arc<Session>,
+    step_context: Arc<StepContext>,
+    runtime: ToolCallRuntime,
+    enabled_tools: &[ToolDefinition],
+    count: &AtomicUsize,
+    cancellation: CancellationToken,
+) -> Result<Value, String> {
+    let (definition, arguments) = authorize_bridge_request(bytes, token, enabled_tools, count)?;
+    let call = CodeModeNestedToolCall {
+        cell_id: cell_id.clone(),
+        runtime_tool_call_id: uuid::Uuid::new_v4().to_string(),
+        tool_name: definition.tool_name.clone(),
+        tool_kind: definition.kind,
+        input: Some(arguments),
+    };
+    let future = submit_nested_tool(
+        session,
+        step_context,
+        runtime,
+        call,
+        uuid::Uuid::new_v4().to_string(),
+        cancellation,
+        None,
+    )
+    .map_err(|error| error.to_string())?;
+    future.await.map_err(|error| error.to_string())
+}
+
+fn authorize_bridge_request(
+    bytes: &[u8],
+    token: &str,
+    enabled_tools: &[ToolDefinition],
+    count: &AtomicUsize,
+) -> Result<(ToolDefinition, Value), String> {
+    let request: BridgeRequest =
+        serde_json::from_slice(bytes).map_err(|_| "invalid bridge request".to_string())?;
+    if request.token != token {
+        return Err("bridge authentication failed".into());
+    }
+    let definition = enabled_tools
+        .iter()
+        .find(|tool| tool.name == request.name)
+        .ok_or("tool was not enabled for this cell")?;
+    if matches!(definition.name.as_str(), TOOL_NAME | "exec" | "wait") {
+        return Err("recursive kernel and code-mode calls are forbidden".into());
+    }
+    if count.fetch_add(1, Ordering::AcqRel) >= MAX_BRIDGE_CALLS {
+        return Err("kernel nested tool call limit exceeded".into());
+    }
+    Ok((definition.clone(), request.arguments))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::step_context::StepContext;
+    use crate::session::tests::make_session_and_context;
+    use crate::tools::context::{FunctionToolOutput, ToolInvocation, ToolOutput};
+    use crate::tools::registry::{CoreToolRuntime, ToolExecutor, ToolRegistry};
+    use crate::tools::router::{ToolCallSource, ToolRouter};
