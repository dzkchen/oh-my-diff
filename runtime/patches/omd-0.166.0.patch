+        run(&strings(&["exec", "network"]), name).unwrap_err(),
+        "capability_denied: unix_sockets"
+    );
+    assert_eq!(
+        run(&capabilities, "UNDECLARED").unwrap_err(),
+        "exec_arguments_invalid"
+    );
