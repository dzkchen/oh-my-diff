+fn with_store(test: impl FnOnce(&ResourceStore)) {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path().canonicalize().unwrap();
+    let binding = binding();
+    test(&ResourceStore {
+        root: &root,
+        binding: &binding,
+    });
+}
