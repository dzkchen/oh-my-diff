+#[test]
+#[serial_test::serial]
+fn underlay_tints_default_cells_and_puts_glyphs_past_text_and_faintly_on_raised_glass() {
+    let now = Instant::now();
+    let key = "underlay_scene";
+    let mut snapshot = codex_omd::ModViewSnapshot::default();
+    snapshot.view.underlay = serde_json::from_value(json!({"raster": key})).expect("underlay");
+    snapshot.component_owners.insert(key.into(), "owner".into());
+    let level = Some(StdoutColorLevel::TrueColor);
+    let glyphs = Rect::new(0, 0, 64, 2);
+    let kept = [Rect::new(10, 1, 4, 1)];
+    let narrow = Rect::new(0, 0, 59, 3);
+    let mut buffer = Buffer::empty(narrow);
+    underlay_glyphs(&snapshot, narrow, glyphs, &kept, &mut buffer, level, now);
+    underlay_tint(&snapshot, narrow, &kept, &mut buffer, level);
+    assert_eq!(buffer, Buffer::empty(narrow));
+    let few = Some(StdoutColorLevel::Ansi16);
+    let screen = Rect::new(0, 0, 64, 3);
+    underlay_glyphs(
+        &snapshot,
+        screen,
+        glyphs,
+        &kept,
+        &mut Buffer::empty(screen),
+        level,
+        now,
+    );
+    blit(
+        "owner",
+        Some("owner".into()),
+        Some((64, 3)),
+        &json!({"key": key, "rect": {"x": 0, "y": 0, "width": 64, "height": 3},
+            "packed": packed(&[('x', 0x11_22_33, 0x44_55_66); 64 * 3])}),
+        now,
+        |_, _| unreachable!(),
+    )
+    .expect("queued");
+    let mut plain = Buffer::empty(screen);
+    underlay_glyphs(&snapshot, screen, glyphs, &kept, &mut plain, few, now);
+    underlay_tint(&snapshot, screen, &kept, &mut plain, few);
+    assert_eq!(plain, Buffer::empty(screen));
+    let mut buffer = Buffer::empty(screen);
+    buffer.set_string(0, 0, "hello", Style::default());
+    underlay_glyphs(&snapshot, screen, glyphs, &kept, &mut buffer, level, now);
+    let again = blit(
+        "owner",
+        Some("owner".into()),
+        Some((64, 3)),
+        &json!({"key": key, "rect": {"x": 0, "y": 0, "width": 1, "height": 1},
+            "packed": packed(&[('x', 0x11_22_33, 0x44_55_66)])}),
+        now,
+        |_, _| unreachable!(),
+    )
+    .expect("unchanged");
+    assert_eq!(
+        (again["frame"].clone(), again["queued"].clone()),
+        (json!(1), json!(0))
+    );
+    assert_eq!(
+        pending_delay(key, now),
+        None,
+        "an unchanged cell draws no frame"
+    );
+    buffer.set_string(0, 2, "prompt", Style::default());
+    buffer.set_string(20, 1, "    ", Style::default());
+    buffer[(63, 2)].set_bg(Color::Red);
+    underlay_tint(&snapshot, screen, &kept, &mut buffer, level);
+    let row = |y: u16| (0..64).map(|x| buffer[(x, y)].symbol()).collect::<String>();
+    assert_eq!(row(0), format!("hello  {}", "x".repeat(57)));
+    assert_eq!(
+        row(1),
+        format!(
+            "{}    {}    {}",
+            "x".repeat(10),
+            "x".repeat(6),
+            "x".repeat(40)
+        )
+    );
+    assert_eq!(row(2), format!("prompt{}", " ".repeat(58)));
+    let tinted = Color::Rgb(0x44, 0x55, 0x66);
+    assert_eq!(buffer[(63, 2)].bg, Color::Red);
+    assert!((0..64).all(|x| buffer[(x, 0)].bg == tinted));
+    assert_eq!(buffer[(10, 1)].bg, Color::Reset, "pictures stay untouched");
+    assert!((0..63).all(|x| buffer[(x, 2)].bg == tinted));
+    assert!((0..5).all(|x| buffer[(x, 0)].fg != Color::Reset));
+    assert_eq!(buffer[(5, 0)].fg, Color::Reset);
+    assert_eq!(buffer[(7, 0)].fg, Color::Rgb(0x11, 0x22, 0x33));
+    let colors = crate::terminal_probe::DefaultColors {
+        fg: (230, 230, 230),
+        bg: (10, 10, 10),
+    };
+    let menu = crate::terminal_palette::with_test_default_colors(colors, || {
+        let mut menu = Buffer::empty(screen);
+        let raised = crate::style::user_message_style()
+            .bg
+            .expect("raised surface");
+        menu.set_style(Rect::new(0, 2, 64, 1), Style::default().bg(raised));
+        menu.set_string(0, 2, "menu", Style::default().bg(raised));
+        underlay_tint(&snapshot, screen, &[], &mut menu, level);
+        menu
+    });
+    let lifted = crate::style::user_message_bg_rgb((0x44, 0x55, 0x66));
+    assert_eq!(
+        menu[(0, 2)].bg,
+        crate::mod_ui::color_at(ModColor::Rgb(lifted.0, lifted.1, lifted.2), level)
+    );
+    let glass = (0..64).map(|x| menu[(x, 2)].symbol()).collect::<String>();
+    assert_eq!(glass, format!("menu  {}", "x".repeat(58)));
+    let (r, g, b) = crate::color::blend((0x11, 0x22, 0x33), lifted, 0.35);
+    assert_eq!(menu[(10, 2)].fg, Color::Rgb(r, g, b));
+    let light = crate::terminal_probe::DefaultColors {
+        fg: (20, 20, 20),
+        bg: (240, 240, 240),
+    };
+    let code = crate::terminal_palette::with_test_default_colors(light, || {
+        let mut code = Buffer::empty(screen);
+        code.set_string(0, 0, "fn", Style::default().fg(Color::Rgb(30, 30, 30)));
+        underlay_tint(&snapshot, screen, &[], &mut code, level);
+        code
+    });
+    assert_eq!(
+        code[(0, 0)].fg,
+        Color::Rgb(255, 255, 255),
+        "dark text set for a light terminal stays readable"
+    );
+    retain(&BTreeSet::new());
+}
