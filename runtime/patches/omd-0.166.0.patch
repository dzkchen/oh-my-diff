+            "demo/git": {"components": [{"type": "text", "id": "git", "label": "Git", "text": "clean"}]}},
+        "key_contexts": [{"when": {"focus": "site"}, "owner": "demo", "keys": {
+            "1": {"region": 1}, "2": {"region": 2}, "j": {"region": "down"}, "l": {"region": "right"},
+            "?": {"action": {"help": true}, "label": "Show keys"}}}]
+    }));
+    preview(snapshot.clone());
+    let area = Rect::new(0, 0, 120, 40);
+    let draw = || {
+        let mut buffer = Buffer::empty(area);
+        render_owned(
+            area,
