+    let cell = json!({"rect": {"x": 0, "y": 0, "width": 1, "height": 1}, "cells": ["x"]});
+    for arguments in [
+        json!({"key": key, "image": png, "rect": cell["rect"], "cells": cell["cells"]}),
+        json!({"key": key}),
+        json!({"key": key, "rect": cell["rect"], "image": png}),
