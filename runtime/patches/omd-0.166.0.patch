+pub(crate) fn normalize_workspace_snapshot(
+    text: impl Into<String>,
+    cwd: &std::path::Path,
+) -> String {
+    let mut text = text.into();
+    if !cwd
+        .parent()
+        .and_then(std::path::Path::file_name)
+        .is_some_and(|name| name.to_string_lossy().starts_with("chatwidget-tests-"))
+    {
+        return text;
+    }
+    let expected = "/tmp/project";
+    let replace_path = |text: &mut String, from: &str, to: &str| {
+        let mut normalized = String::with_capacity(text.len());
+        let mut start = 0;
+        for (offset, _) in text.match_indices(from) {
+            if text[..offset].chars().next_back().is_some_and(|character| {
+                character.is_alphanumeric()
+                    || "/._-~".contains(character)
+                    || character == std::path::MAIN_SEPARATOR
+            }) {
+                continue;
+            }
+            normalized.push_str(&text[start..offset]);
+            normalized.push_str(to);
+            start = offset + from.len();
+        }
+        normalized.push_str(&text[start..]);
+        *text = normalized;
+    };
+    for path in [
+        cwd.canonicalize().unwrap_or_else(|_| cwd.to_path_buf()),
+        cwd.to_path_buf(),
+    ] {
+        let path = path.to_string_lossy();
+        replace_path(&mut text, path.as_ref(), expected);
+        for width in 1..path.chars().count() {
+            let truncated = crate::text_formatting::center_truncate_path(&path, width);
+            if truncated.contains('…') {
+                replace_path(
+                    &mut text,
+                    &truncated,
+                    &crate::text_formatting::center_truncate_path(expected, width),
+                );
+            }
+        }
+        for prefix in truncated_path_variants(&path).into_iter().rev() {
+            let length = prefix.chars().count();
+            let replacement: String = expected.chars().take(length).collect();
+            replace_path(
+                &mut text,
+                &format!("{prefix}…"),
+                &format!(
+                    "{replacement}{}",
+                    if length < expected.len() { "…" } else { "" }
+                ),
+            );
+        }
+    }
+    text
+}
