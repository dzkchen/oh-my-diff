+    );
+    crate::mod_raster::retain(&BTreeSet::new());
+    *FACTS.lock().unwrap() = None;
+}
+
+#[cfg(unix)]
+#[test]
+fn shared_memory_holds_the_pixels_under_a_short_name() {
+    let bytes = [7_u8, 8, 9, 10, 11];
+    let name = shared_memory(0xff_ff_ff, &bytes).expect("shared memory");
+    assert!(name.len() <= 31, "{name}");
+    let c_name = std::ffi::CString::new(name.clone()).expect("name");
+    let mut read = [0_u8; 5];
+    // SAFETY: the mapping covers the five bytes written above and is unmapped before the object is unlinked.
+    unsafe {
+        let fd = libc::shm_open(c_name.as_ptr(), libc::O_RDONLY, 0);
+        assert!(fd >= 0, "open {name}");
+        let mapped = libc::mmap(
+            std::ptr::null_mut(),
+            read.len(),
+            libc::PROT_READ,
+            libc::MAP_SHARED,
+            fd,
+            0,
+        );
+        assert_ne!(mapped, libc::MAP_FAILED);
+        std::ptr::copy_nonoverlapping(mapped.cast::<u8>(), read.as_mut_ptr(), read.len());
+        libc::munmap(mapped, read.len());
+        libc::close(fd);
+        libc::shm_unlink(c_name.as_ptr());
+    }
+    assert_eq!(read, bytes);
+}
+
+#[test]
+#[serial_test::serial]
+fn drawn_site_areas_join_the_client_and_a_flip_back_renders_once() {
+    let files = |columns| BTreeMap::from([("demo/files".to_owned(), (columns, 20))]);
+    assert!(note_sites(files(40)));
+    assert_eq!(
+        value()["sites"],
+        json!({"demo/files": {"columns": 40, "rows": 20}})
+    );
+    assert!(!note_sites(files(40)));
+    assert!(note_sites(files(30)));
+    assert!(!note_sites(files(40)), "a view that flips its own layout");
+    let (columns, rows) = facts().size;
+    update(true, columns.wrapping_add(1), rows, false);
+    assert!(note_sites(files(30)), "a resize renders again");
+    assert!(note_sites(BTreeMap::new()));
+    assert!(value().get("sites").is_none());
+}
