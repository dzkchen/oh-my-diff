+        std::os::unix::fs::symlink(store.path(), &dir.path).unwrap();
+        assert_eq!(files(Some(&dir)), None);
+        std::fs::remove_file(&dir.path).unwrap();
+        std::fs::rename(&moved, &dir.path).unwrap();
+        let path = dir.path.clone();
+        drop(dir);
+        assert!(!path.exists());
+        let sandboxed = prepare(
+            store.path(),
+            false,
+            &json!({"files": {"a": ""}}),
+            &mut argv.clone(),
