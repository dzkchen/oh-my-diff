+impl Core<'_> {
+    fn run(
+        &mut self,
+        access: &mut Access<'_>,
+        host: &mut HostFn<'_>,
+        input: &Value,
+        active: &dyn Fn() -> bool,
+        scope: &InvocationScope,
+    ) -> Result<Value> {
