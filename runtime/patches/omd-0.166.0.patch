+    let Some(producer) = sess
+        .clone_history()
+        .await
+        .foreign_compaction_provider(&turn_context.config.model_provider_id)
+        .filter(|producer| previous_provider.is_none_or(|previous| previous == *producer))
+    else {
+        return Ok(());
+    };
+    let Some(info) = turn_context
+        .config
+        .model_providers
+        .get(&producer)
+        .cloned()
+        .or_else(|| codex_model_provider_info::runtime_provider(&producer))
+    else {
+        return Ok(());
+    };
+    let mut compactor = turn_context
+        .with_model(previous_model, &sess.services.models_manager)
+        .await;
+    let mut config = (*compactor.config).clone();
+    config.model_provider_id = producer.clone();
+    config.model_provider = info.clone();
+    compactor.cyber_access_program = cyber_access_program::for_provider(
+        &config.model_provider_id,
+        previous_cyber_access_program,
+    );
+    compactor.config = Arc::new(config);
+    compactor.provider = codex_model_provider::create_model_provider(
+        info,
+        Some(Arc::clone(&sess.services.auth_manager)),
+    );
+    let replacement_step_context = sess
+        .capture_speculative_step_context(Arc::clone(turn_context), cancellation_token)
+        .await?;
+    let world_state = Arc::new(
+        sess.build_world_state_for_step(&replacement_step_context, /*new_window*/ true)
+            .await?,
+    );
+    match run_inline_auto_compact_task(
+        Arc::clone(sess),
+        Arc::new(compactor),
+        replacement_step_context,
+        world_state,
+        CompactionReason::CompHashChanged,
+        CompactionPhase::PreTurn,
+    )
+    .await
+    {
+        Err(err) if !matches!(err.details(), CodexErrorDetails::TurnAborted) => {
+            let message = format!(
+                "Could not summarize the context compacted on {producer}; continuing without it: {err}"
+            );
+            sess.send_event(
+                turn_context.as_ref(),
+                EventMsg::Warning(WarningEvent { message }),
+            )
+            .await;
+            Ok(())
+        }
+        result => result,
+    }
