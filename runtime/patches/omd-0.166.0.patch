+    let snapshot = snapshot(serde_json::json!({"welcome":{"show_while_composing":true},
+        "sites":{"welcome":{"components":[{"type":"button","id":"recipe","label":"Recipe","text":"Create project","action":{"command":"starter:create"}}]}}}));
+    assert!(welcome_visible(&snapshot, Some(ComposerState::Draft)));
