+use super::*;
+use pretty_assertions::assert_eq;
+
+fn rows(buffer: &Buffer, area: Rect) -> String {
+    (0..area.height)
+        .map(|y| {
+            (0..area.width)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn snapshot(value: serde_json::Value) -> ModViewSnapshot {
+    ModViewSnapshot {
+        component_owners: owners(&value),
+        view: ModView::parse(value).unwrap(),
+        ..ModViewSnapshot::default()
+    }
+}
+
+/// Records each commanding component's owner as composition does, here from its command's mod prefix.
+fn owners(value: &serde_json::Value) -> std::collections::BTreeMap<String, String> {
+    fn walk(value: &serde_json::Value, found: &mut std::collections::BTreeMap<String, String>) {
+        match value {
+            serde_json::Value::Object(object) => {
+                let command = object
+                    .get("action")
+                    .and_then(|action| action["command"].as_str());
+                if let (Some(id), Some((owner, _))) = (
+                    object.get("id").and_then(serde_json::Value::as_str),
+                    command.and_then(|command| command.split_once(':')),
+                ) {
+                    found.insert(id.to_owned(), owner.to_owned());
+                }
+                object.values().for_each(|value| walk(value, found));
+            }
+            serde_json::Value::Array(items) => items.iter().for_each(|value| walk(value, found)),
+            _ => {}
+        }
+    }
+    let mut found = std::collections::BTreeMap::new();
+    walk(value, &mut found);
+    found
+}
