+struct BusyFixture {
+    runtime: Arc<Mutex<ModHost>>,
+    _environment: (crate::omd::tests::EnvGuard, crate::omd::tests::EnvGuard),
+    _temp: tempfile::TempDir,
+    _host: Box<dyn std::any::Any>,
+}
