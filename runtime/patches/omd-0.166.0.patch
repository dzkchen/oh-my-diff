+/// A mod id stays a bare name; anything with a `/` is a package folder.
+fn package_target(target: &str) -> io::Result<PathBuf> {
+    if target.contains('/') || matches!(target, "." | "..") {
+        PathBuf::from(target).canonicalize()
+    } else {
+        Ok(PathBuf::from(target))
+    }
+}
