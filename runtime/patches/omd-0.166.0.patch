+const PANES: usize = 16;
+const WRITE_BYTES: usize = 4096;
+const SCROLLBACK: usize = 2000;
+const WHEEL_LINES: usize = 3;
+const FILES: usize = 4;
+const FILE_BYTES: usize = 16 * 1024;
+const RESULT_BYTES: usize = 64 * 1024;
+const LINKS: usize = 64;
+const NOTICE_BYTES: usize = 1024;
+const NOTICES_PER_SECOND: u32 = 10;
+const COPY_BYTES: usize = 64 * 1024;
+const NOTICES: usize = 32;
+const REPLY_BYTES: usize = 1024;
+const HANGUP_GRACE: std::time::Duration = std::time::Duration::from_secs(2);
