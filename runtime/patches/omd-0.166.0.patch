+    .unwrap_err();
+    assert!(
+        partial
+            .to_string()
+            .contains("invalid_continuation_input: tool"),
+        "{partial}"
+    );
+    let status = runtime.lock().unwrap().status();
+    assert_eq!(status["chains"].as_array().unwrap().len(), 3);
+    let registration = &status["mods"][1]["registrations"]["interceptors"][0];
