+#[cfg(test)]
+pub(crate) fn test_command_catalog(commands: Vec<ModSlashCommand>) -> impl Drop {
+    struct Restore(Option<Vec<ModSlashCommand>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            TEST_CATALOG.set(self.0.take());
+        }
