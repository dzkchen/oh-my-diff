+/// The agent can write the repository, so programs there need an `os_access` path; outside links run as the link so multicall shims dispatch.
+pub fn unrestricted_program(
+    access: &crate::ModOsAccess,
+    name: &str,
+    repository: &Path,
+) -> Result<PathBuf, String> {
+    let path = Path::new(name);
+    let link = |found: &Path| {
+        let launch = found
+            .parent()?
+            .canonicalize()
+            .ok()?
+            .join(found.file_name()?);
+        Some((launch, found.canonicalize().ok()?))
+    };
+    let (launch, resolved) = if path.is_absolute() {
+        link(path)
+    } else if !name.is_empty() && !name.contains('/') && !name.contains('\0') {
+        std::env::var_os("PATH").and_then(|paths| {
+            std::env::split_paths(&paths).find_map(|directory| {
+                link(&directory.join(name)).filter(|(_, target)| !target.starts_with(repository))
+            })
+        })
+    } else {
+        None
+    }
+    .filter(|(_, target)| target.is_file())
+    .ok_or("exec_program_unavailable")?;
+    let listed = access
+        .programs
+        .iter()
+        .any(|allowed| Path::new(allowed) == resolved || Path::new(allowed) == path);
+    if resolved.starts_with(repository) && !listed
+        || !access.allows(name, &resolved) && !access.allows(name, path)
+    {
+        return Err(format!("os_access_denied: {name}"));
+    }
+    Ok(if launch.starts_with(repository) {
+        resolved
+    } else {
+        launch
+    })
+}
