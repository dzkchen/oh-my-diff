+pub(crate) fn replaceable_tool_output(
+    invocation: &ToolInvocation,
+    output: &dyn ToolOutput,
+) -> Option<String> {
+    let thread_store = &invocation.session.services.thread_extension_data;
+    if !invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+        .iter()
+        .any(|contributor| contributor.replacing(thread_store))
+    {
+        return None;
+    }
+    response_text(output.to_response_item(&invocation.call_id, &invocation.payload))
+}
+
+pub(crate) fn response_text(item: ResponseInputItem) -> Option<String> {
+    match item {
+        ResponseInputItem::FunctionCallOutput { output, .. }
+        | ResponseInputItem::CustomToolCallOutput { output, .. } => match output.body {
+            codex_protocol::models::FunctionCallOutputBody::Text(text) => Some(text),
+            codex_protocol::models::FunctionCallOutputBody::ContentItems(items) => {
+                use codex_protocol::models::FunctionCallOutputContentItem as Item;
+                let mut parts = Vec::new();
+                for item in items {
+                    match item {
+                        Item::InputText { text } => parts.push(text),
+                        Item::InputImage { .. } | Item::InputAudio { .. } => return None,
+                        Item::EncryptedContent { .. } => {}
+                    }
+                }
+                (!parts.is_empty()).then(|| parts.join("\n"))
+            }
+        },
+        ResponseInputItem::McpToolCallOutput { output, .. } => {
+            serde_json::to_string(&output.content).ok()
+        }
+        _ => None,
+    }
+}
+
+pub(crate) async fn replace_tool_output(
+    invocation: &ToolInvocation,
+    text: &str,
+    success: bool,
+    value: Option<&serde_json::Value>,
+) -> Option<String> {
+    for contributor in invocation
+        .session
+        .services
+        .extensions
+        .tool_output_contributors()
+    {
+        let replacement = contributor
+            .replace_tool_output(ToolOutputInput {
+                session_store: &invocation.session.services.session_extension_data,
+                thread_store: &invocation.session.services.thread_extension_data,
+                turn_store: invocation.turn.extension_data.as_ref(),
+                turn_id: invocation.turn.sub_id.as_str(),
+                call_id: invocation.call_id.as_str(),
+                tool_name: &invocation.tool_name,
+                arguments: match &invocation.payload {
+                    codex_tools::ToolPayload::Function { arguments } => Some(arguments.as_str()),
+                    codex_tools::ToolPayload::Custom { input } => Some(input.as_str()),
+                    _ => None,
+                },
+                success,
+                text,
+                value,
+            })
+            .await;
+        if let Some(replacement) = replacement {
+            let original_bytes = replacement.original_bytes.max(text.len());
+            return (replacement.text.len()
+                <= codex_extension_api::tool_output_limit(original_bytes))
+            .then_some(replacement.text);
+        }
+    }
+    None
+}
