+fn latest_session(root: &Path) -> Option<PathBuf> {
+    std::fs::read_dir(root.join("sessions"))
+        .ok()?
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry.path())))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path)
+}
+
+fn snapshot_with_status(status: &Value, accounting: bool) -> Result<Snapshot, String> {
+    let paths = mod_paths().ok_or_else(|| "Oh My Diff mod host is not active".to_string())?;
+    let count = |key: &str| status[key].as_array().map_or(0, Vec::len);
+    let (active_mods, failed_mods) = codex_omd::mod_counts(status);
+    let mut snapshot = Snapshot {
+        active_mods,
+        failed_mods,
+        rejected_selections: count("rejected"),
+        contract: "none".to_string(),
+        ..Snapshot::default()
+    };
+    let Some(session) = latest_session(&paths.evidence) else {
+        return Ok(snapshot);
+    };
+    let read = |name: &str, limit: usize| {
+        bounded_read(&session.join(name), limit)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+            .unwrap_or(Value::Null)
+    };
+    if accounting {
+        let cost = read("task-cost.json", 8_388_608);
+        let number = |key: &str| cost[key].as_u64().unwrap_or_default();
+        snapshot.observed_requests = cost["observed"].as_array().map_or(0, Vec::len);
+        snapshot.raw_usage_attempts = number("raw_usage_attempts");
+        snapshot.settled_task_charge_microusd = number("settled_task_charge_microusd");
+        snapshot.retained_exposure_upper_bound_microusd =
+            number("retained_exposure_upper_bound_microusd");
+    }
+    let contract = read("contract.json", 262_144);
+    snapshot.contract = match (contract["status"].as_str(), contract["active"].as_object()) {
+        (Some("active"), Some(active)) => format!(
+            "{}@{} ({})",
+            active
+                .get("id")
+                .and_then(Value::as_str)
+                .unwrap_or("unknown"),
+            active
+                .get("version")
+                .and_then(Value::as_u64)
+                .unwrap_or_default(),
+            active
+                .get("assurance")
+                .and_then(Value::as_str)
+                .unwrap_or("unlabelled")
+        ),
+        (Some(status), _) => status.to_string(),
+        _ => "none".to_string(),
+    };
+    snapshot.evidence = Some(session);
+    Ok(snapshot)
+}
+
+pub(crate) fn session_agents(thread: &str) -> Vec<Value> {
+    let Some(root) = store_root() else {
+        return Vec::new();
+    };
+    let mut agents: Vec<Value> = bounded_read(
+        &root.join("agents").join(format!("{thread}.json")),
+        1_048_576,
+    )
+    .ok()
+    .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+    .unwrap_or_default();
+    agents.sort_by_key(|agent| agent["started_at_ms"].as_u64());
+    agents
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, String> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if metadata.file_type().is_symlink() || metadata.len() > limit as u64 {
+        return Err(format!(
+            "unsafe or oversized Oh My Diff file: {}",
+            path.display()
+        ));
+    }
+    std::fs::read(path).map_err(|error| error.to_string())
+}
+
+pub(crate) fn compact_status() -> Option<String> {
+    Some(match effective_mode() {
+        Ok(codex_omd::RuntimeMode::UpstreamDirect) => return None,
+        Ok(_) => {
+            let status = mod_status();
+            match snapshot_with_status(status.as_deref().unwrap_or(&Value::Null), false) {
+                Err(_) if store_root().is_some() => {
+                    "Oh My Diff · mods off in this directory · run codex in a project".to_string()
+                }
+                _ if status
+                    .as_ref()
+                    .is_some_and(|status| status["activation_error"].is_string()) =>
+                {
+                    "Oh My Diff · mods inactive · see /omd".to_string()
+                }
+                Ok(snapshot)
+                    if snapshot.failed_mods == 0 && codex_omd::mod_ui_allowlist().is_some() =>
+                {
+                    return None;
+                }
+                Ok(snapshot) if status.is_some() => format!(
+                    "Oh My Diff · {} mod{} on{}{}",
+                    snapshot.active_mods,
+                    if snapshot.active_mods == 1 { "" } else { "s" },
+                    if snapshot.failed_mods == 0 {
+                        String::new()
+                    } else {
+                        format!(" · {} failed", snapshot.failed_mods)
+                    },
+                    if snapshot.contract == "none" {
+                        String::new()
+                    } else {
+                        format!(" · contract {}", snapshot.contract)
+                    }
+                ),
+                _ => "Oh My Diff · mod status unavailable".to_string(),
+            }
+        }
+        Err(error) => format!("Oh My Diff · invalid mode · {error}"),
+    })
+}
