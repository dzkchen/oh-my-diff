+#[derive(Default)]
+struct Flaky {
+    chain: Chain,
+    appends: AtomicUsize,
+    fail_at: AtomicUsize,
+    record_failed: AtomicBool,
+}
+
+impl Flaky {
+    fn fail_append(&self, nth: usize, record: bool) {
+        self.fail_at
+            .store(self.appends.load(Ordering::SeqCst) + nth, Ordering::SeqCst);
+        self.record_failed.store(record, Ordering::SeqCst);
+    }
+}
+
+impl HistoryWitness for Flaky {
+    fn append(&self, stream: &Path, sha256: &str) -> std::io::Result<()> {
+        let count = self.appends.fetch_add(1, Ordering::SeqCst) + 1;
+        if count != self.fail_at.load(Ordering::SeqCst) {
+            return self.chain.append(stream, sha256);
+        }
+        if self.record_failed.load(Ordering::SeqCst) {
+            self.chain.append(stream, sha256)?;
+        }
+        Err(std::io::Error::other("broker unreachable"))
+    }
+
+    fn verify(&self, stream: &Path, sha256s: &[String]) -> std::io::Result<()> {
+        self.chain.verify(stream, sha256s)
+    }
+}
