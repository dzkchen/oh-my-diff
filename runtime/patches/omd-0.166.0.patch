+struct Link {
+    row: u16,
+    start: u16,
+    end: u16,
+    url: String,
+    text: String,
+}
+
+#[derive(Default)]
+struct Signals {
+    title: Option<String>,
+    bell: bool,
+    notices: Vec<String>,
+    copies: Vec<String>,
+    links: VecDeque<Link>,
+    open: Option<(u16, u16, String)>,
+    window: Option<(std::time::Instant, u32)>,
+    alternate: bool,
+    replies: Vec<u8>,
+}
+
+fn clean(bytes: &[u8], limit: usize) -> String {
+    let text = String::from_utf8_lossy(bytes)
+        .chars()
+        .filter(|c| !c.is_control())
+        .collect::<String>();
+    text[..text.floor_char_boundary(limit)].to_owned()
+}
+
+impl Signals {
+    fn close(&mut self, screen: &vt100::Screen) {
+        let Some((row, column, url)) = self.open.take() else {
+            return;
+        };
+        let (end_row, end_column) = screen.cursor_position();
+        let width = screen.size().1;
+        for line in row..=end_row.max(row) {
+            let start = if line == row { column } else { 0 };
+            let end = if line == end_row { end_column } else { width };
+            let text = screen.contents_between(line, start, line, end);
+            if end <= start || text.trim().is_empty() {
+                continue;
+            }
+            if self.links.len() >= LINKS {
+                self.links.pop_front();
+            }
+            self.links
+                .retain(|link| link.row != line || link.end <= start || link.start >= end);
+            self.links.push_back(Link {
+                row: line,
+                start,
+                end,
+                url: url.clone(),
+                text,
+            });
+        }
+    }
+
+    fn notice(&mut self, parts: &[&[u8]]) {
+        let now = std::time::Instant::now();
+        let window = match self.window {
+            Some((started, count)) if now.duration_since(started).as_secs() < 1 => (started, count),
+            _ => (now, 0),
+        };
+        if window.1 >= NOTICES_PER_SECOND || self.notices.len() >= NOTICES {
+            return;
+        }
+        self.window = Some((window.0, window.1 + 1));
+        self.notices.push(clean(&parts.join(&b';'), NOTICE_BYTES));
+    }
+}
+
+impl vt100::Callbacks for Signals {
+    fn audible_bell(&mut self, _: &mut vt100::Screen) {
+        self.bell = true;
+    }
+
+    fn set_window_title(&mut self, _: &mut vt100::Screen, title: &[u8]) {
+        self.title = Some(clean(title, 256));
+    }
+
+    fn copy_to_clipboard(&mut self, _: &mut vt100::Screen, _: &[u8], data: &[u8]) {
+        if data.len() <= COPY_BYTES * 4 / 3 + 4
+            && let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(data)
+            && let Ok(text) = String::from_utf8(bytes)
+        {
+            self.copies.push(text);
+        }
+    }
+
+    fn unhandled_osc(&mut self, screen: &mut vt100::Screen, params: &[&[u8]]) {
+        match params {
+            [b"8", _, url @ ..] => {
+                self.close(screen);
+                let url = String::from_utf8_lossy(&url.join(&b';')).into_owned();
+                if let Some(url) = crate::terminal_hyperlinks::web_destination(&url) {
+                    let (row, column) = screen.cursor_position();
+                    self.open = Some((row, column, url));
+                }
+            }
+            [b"9", first, ..] if *first == b"4" => {}
+            [b"9", rest @ ..] if !rest.is_empty() => self.notice(rest),
+            [b"777", b"notify", rest @ ..] if !rest.is_empty() => self.notice(rest),
+            _ => {}
+        }
+    }
+
+    fn unhandled_csi(
+        &mut self,
+        screen: &mut vt100::Screen,
+        first: Option<u8>,
+        second: Option<u8>,
+        params: &[&[u16]],
+        c: char,
+    ) {
+        if first.is_some() || second.is_some() || self.replies.len() >= REPLY_BYTES {
+            return;
+        }
+        let reply = match (params, c) {
+            ([] | [[0]], 'c') => "\x1b[?62;22c".to_owned(),
+            ([[5]], 'n') => "\x1b[0n".to_owned(),
+            ([[6]], 'n') => {
+                let (row, column) = screen.cursor_position();
+                format!("\x1b[{};{}R", row + 1, column + 1)
+            }
+            _ => return,
+        };
+        self.replies.extend_from_slice(reply.as_bytes());
+    }
+}
