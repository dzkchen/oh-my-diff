+impl BusyFixture {
+    fn new(source: &str, capabilities: &[&str]) -> Self {
+        let host = Box::new(test_fresh_host());
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let store_path = root.join("store");
+        let store = codex_omd::ModStore::create(store_path.clone()).unwrap();
+        let package = root.join("guard");
+        std::fs::create_dir(&package).unwrap();
+        std::fs::write(
+            package.join("mod.json"),
+            serde_json::json!({"schema": 1, "id": "guard", "version": "1.0.0",
+                "api": codex_omd::MOD_API_VERSION, "state_version": 1, "capabilities": capabilities})
+            .to_string(),
+        )
+        .unwrap();
+        std::fs::write(package.join("index.ts"), source).unwrap();
+        let inspected = codex_omd::ModStore::inspect_package(&package).unwrap();
+        store
+            .trust(
+                package.clone(),
+                inspected["sha256"].as_str().unwrap(),
+                capabilities
+                    .iter()
+                    .map(|&capability| capability.into())
+                    .collect(),
+                "user",
