+#[tokio::test]
+async fn spec_contributors_observe_original_and_effective_tools_with_hidden_and_deferred_state() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).supports_search_tool = true;
+    });
+    let observer = Arc::new(InventoryObserver::default());
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.tool_spec_contributor(observer.clone());
+    session.services.extensions = Arc::new(extensions.build());
+    let mcp = codex_mcp::McpBinding::empty(mcp_config_for_test(&turn.config));
+    let mut registry = build_core_tool_registry(
+        &turn,
+        turn.model_info(),
+        &turn.initial_environments,
+        &mcp,
+        /*tool_suggest_candidates*/ None,
+        /*wait_for_environment_tool_config*/ None,
+    );
+    for (name, exposure) in [
+        ("lookup", ToolExposure::Direct),
+        ("hidden", ToolExposure::Direct),
+        ("late", ToolExposure::Deferred),
+    ] {
+        let tool = mcp_runtime("srv", "mcp__srv__", name, exposure);
+        registry.register_external_with_exposure(tool.runtime, tool.exposure);
+    }
+    crate::tools::spec_adjust::plan(&session, &mut registry, /*search_available*/ true);
+    let inventory = observer.0.lock().unwrap().clone();
+    let find = |name: &str| inventory.iter().find(|tool| tool.name == name).unwrap();
+    let lookup = find("mcp__srv__lookup");
+    assert_eq!(
+        (lookup.kind, lookup.server.as_deref()),
+        ("mcp", Some("srv"))
+    );
+    assert_eq!(lookup.description, "lookup test tool");
+    let effective = lookup.effective.as_ref().unwrap();
+    assert_eq!(
+        (effective.description.as_str(), effective.deferred),
+        ("changed", true)
+    );
+    assert_eq!(find("mcp__srv__hidden").effective, None);
+    assert!(find("mcp__srv__late").effective.as_ref().unwrap().deferred);
+    let builtin = inventory
+        .iter()
+        .find(|tool| tool.server.is_none() && tool.kind == "builtin")
+        .unwrap();
+    assert!(!builtin.effective.as_ref().unwrap().deferred);
+}
