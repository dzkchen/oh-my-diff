+pub(crate) fn hooked_member_lines<C: HistoryCell + ?Sized>(
+    cell: &C,
+    width: u16,
+    expanded: &std::collections::HashSet<String>,
+) -> Option<Vec<MemberLines>> {
+    if !crate::mod_render::enabled() {
+        return None;
+    }
+    let mut members = cell.render_members();
+    for member in &mut members {
+        member.target.props["expanded"] = false.into();
+    }
+    // A group stays per-member while any compact row is hooked; expanded rows are probed compact only as a last resort, since their drawn render must be the last one queued.
+    let hooked =
+        |member: &RenderMember| crate::mod_render::resolve(&member.target, width).is_some();
+    let (open, compact): (Vec<_>, Vec<_>) = members
+        .iter()
+        .partition(|member| expanded.contains(&member.id));
+    if !compact.into_iter().any(hooked) && !open.into_iter().any(hooked) {
+        return None;
+    }
+    Some(
+        members
+            .into_iter()
+            .map(|mut member| {
+                let open = expanded.contains(&member.id);
+                member.target.props["expanded"] = open.into();
+                let (mut lines, _) =
+                    crate::mod_render::hyperlink_lines(&member.target, width, |_, width| {
+                        (member.native)(width, open)
+                    });
+                lines.extend(crate::mod_render::tool_notice_lines(&member.target));
+                MemberLines {
+                    id: member.id,
+                    lines,
+                }
+            })
+            .collect(),
+    )
+}
