+pub(super) fn subagent_summary(agent: &serde_json::Value) -> String {
+    let usage = &agent["usage"];
+    let tokens =
+        |key: &str| super::helpers::format_tokens_compact(usage[key].as_i64().unwrap_or_default());
+    let cost = match (usage["basis"].as_str(), usage["microusd"].as_u64()) {
+        _ if agent["billing"] == "included_subscription" => "included".to_string(),
+        (Some("settled"), Some(microusd)) => format!("${:.2}", microusd as f64 / 1_000_000.0),
+        (Some("partial"), Some(microusd)) => {
+            format!("${:.2} + unpriced", microusd as f64 / 1_000_000.0)
+        }
+        _ => "unpriced".to_string(),
+    };
+    let role = agent["role"].as_str().unwrap_or("agent");
+    let model = match (agent["model"].as_str(), agent["provider"].as_str()) {
+        (Some(model), Some(provider)) => format!("{model} ({provider})"),
+        (Some(model), None) => model.to_string(),
+        _ => "inherited model".to_string(),
+    };
+    let status = match agent["status"].as_str().unwrap_or("running") {
+        "running" if agent["last_turn"]["outcome"] == "completed" => "idle",
+        status => status,
+    };
+    format!(
+        "{role} · {model} · {} in / {} out · {cost} · {status}",
+        tokens("input_tokens"),
+        tokens("output_tokens")
+    )
+}
