{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_bridge_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Loading OMD application bridge context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_bridge_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Closing OMD application bridge context"
          }
        ]
      }
    ]
  }
}
