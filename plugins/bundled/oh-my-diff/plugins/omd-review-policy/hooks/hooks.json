{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_review_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Recording OMD review cadence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_review_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Checking selected OMD review cadence"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_review_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Clearing OMD review reminders"
          }
        ]
      }
    ]
  }
}
