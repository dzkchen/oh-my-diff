{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Observing OMD reactive rule event"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/omd_lifecycle.py\"",
            "timeout": 5,
            "statusMessage": "Validating OMD worker report"
          }
        ]
      }
    ]
  }
}
