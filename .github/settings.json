{
  "labels": [
    {"name": "type: bug", "color": "d73a4a", "description": "Something is broken"},
    {"name": "type: feature", "color": "a2eeef", "description": "New capability or improvement"},
    {"name": "type: mod-api", "color": "5319e7", "description": "Mod API, SDK or host primitive request"},
    {"name": "type: docs", "color": "0075ca", "description": "Documentation"},
    {"name": "area: installer", "color": "c5def5", "description": "curl installer, updates, profiles"},
    {"name": "area: runtime", "color": "c5def5", "description": "Patched Codex host and native code"},
    {"name": "area: mods", "color": "c5def5", "description": "First-party mods, SDK and author tools"},
    {"name": "area: plugins", "color": "c5def5", "description": "Bundled plugins and skills"},
    {"name": "status: triage", "color": "fbca04", "description": "Needs a maintainer decision"},
    {"name": "status: accepted", "color": "0e8a16", "description": "Will be worked on"},
    {"name": "status: blocked", "color": "b60205", "description": "Waiting on something external"},
    {"name": "status: needs-info", "color": "d4c5f9", "description": "Waiting for the reporter to answer"},
    {"name": "status: needs-repro", "color": "bfdadc", "description": "No reliable reproduction yet"},
    {"name": "status: upstream", "color": "d4c5f9", "description": "Belongs to upstream Codex or another tool"},
    {"name": "resolution: duplicate", "color": "cfd3d7", "description": "Already reported"},
    {"name": "resolution: wontfix", "color": "ffffff", "description": "Out of scope or working as intended"}
  ],
  "branch_protection": {
    "branch": "main",
    "required_status_checks": {"strict": true, "contexts": ["PR gate"]},
    "enforce_admins": false,
    "required_pull_request_reviews": {"required_approving_review_count": 0},
    "restrictions": null,
    "required_linear_history": false,
    "allow_force_pushes": false,
    "allow_deletions": false
  },
  "environments": [{"name": "release", "branches": ["main"], "tags": ["v*"]}],
  "rulesets": [
    {"name": "Release tags", "target": "tag", "enforcement": "active",
     "conditions": {"ref_name": {"include": ["refs/tags/v*"], "exclude": ["refs/tags/v*-nightly.*"]}},
     "rules": [{"type": "creation"}, {"type": "update"}, {"type": "deletion"}],
     "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}]},
    {"name": "Mod bundle tags", "target": "tag", "enforcement": "active",
     "conditions": {"ref_name": {"include": ["refs/tags/mods-*"], "exclude": []}},
     "rules": [{"type": "update"}, {"type": "deletion"}],
     "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}]}
  ],
  "repository": {
    "allow_squash_merge": true,
    "allow_merge_commit": true,
    "allow_rebase_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "delete_branch_on_merge": false
  }
}
